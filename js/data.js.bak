window.FMA_DATA = {"app":"french-master-academy","version":1,"generated":"2026-10-12T17:19:28.413Z","levels":[{"code":"A0","ar":"المبتدئ التام","fr":"Grand Débutant","desc":"تأسيس أكاديمي شامل من الصفر: الأبجدية، العلامات التشكيلية، الفونولوجيا وحركات الفم، الأصوات الأنفية، التحية واللباقة، الأرقام حتى 100، وأول جملك وبناء الهوية.","color":"#0d9488","order":1,"tracks":[{"id":"a0-t1","slug":"l-alphabet-et-les-lettres","icon":"book","color":"#0D9488","fr":"L'alphabet et les lettres","ar":"الحروف الفرنسية والرسم الصوتي","desc":"الأساس الأكاديمي الشامل: الأبجدية اللاتينية بصيغتها الفرنسية (26 حرفاً)، العلامات التشكيلية وتأثيرها الصوتي، والتهجئة الرسمية والرموز الإدارية دون حشو أو تكرار.","lessons":[{"id":"A0-t1-l1","fr":"L'alphabet français et les 26 graphèmes","ar":"الأبجدية الفرنسية والتأسيس الصوتي: 26 حرفاً","objectives":["إدراك البنية الألفبائية اللاتينية الفرنسية (26 حرفاً كتابياً) والتمييز بين اسم الحرف وصوته الفونيمي.","التمييز الصوتي الدقيق بين الصوامت المتقاربة غير المألوفة في العربية (/p/ مقابل /b/، و /v/ مقابل /f/).","ضبط مخرج الحرف الصامت الحلقي الفرنسي /ʁ/ ومقارنته بالراء العربية المكررة.","فهم السلوك المزدوج للحرفين C و G وفقاً للحرف الصوتي التالي (صوت صلب مقابل صوت رخو).","تطبيق مهارة التهجئة الأولية (Épellation) على أسماء وكلمات فرنسية متداولة."],"sections":[{"h":"البنية الألفبائية: التمييز بين اسم الحرف وقيمته الصوتية","p":["تتألف الأبجدية الفرنسية المعيارية من 26 حرفاً كتابياً (Graphèmes) مستمدة من الأبجدية اللاتينية. من الضروري أكاديمياً التمييز منذ اليوم الأول بين «اسم الحرف» (Le nom de la lettre) الذي يُستخدم عند التهجئة الرسمية، وبين «القيمة الصوتية» (La valeur phonétique / le phonème) التي يؤديها الحرف داخل الكلمة.","تنقسم الحروف إلى فئتين رئيسيتين: 6 حروف علّة كتابية تُعرف باسم les voyelles وهي (A, E, I, O, U, Y)، و20 حرفاً صامتاً تُعرف باسم les consonnes. يُعدّ حرف Y حالة فريدة؛ فاسمه بالفرنسية هو «i grec» (أي: الإي اليونانية)، ويُصنّف رسماً مع حروف العلة بينما يتقلّب صوتياً بين حركة صامتة وحركة نصف صامتة (Semi-voyelle).","تتميز الفرنسية بوجود حروف صامتة في كتابتها لا تنطق مطلقاً في نهاية معظم الكلمات (Consonnes muettes)، إضافة إلى حرف H الذي لا يمتلك أي قيمة صوتية في النظام الصوتي الفرنسي الحديث إطلاقاً (فهو صامت دائماً سواء كان H muet أو H aspiré).","الجدول الصوتي الكامل للأبجدية: A /ɑ/, B /be/, C /se/, D /de/, E /ə/, F /ɛf/, G /ʒe/, H /aʃ/, I /i/, J /ʒi/, K /ka/, L /ɛl/, M /ɛm/, N /ɛn/, O /o/, P /pe/, Q /ky/, R /ɛʁ/, S /ɛs/, T /te/, U /y/, V /ve/, W /dubləve/, X /iks/, Y /iɡʁɛk/, Z /zɛd/."],"video":{"id":"a5WVeSuZpOs","title":"تعلم اللغة الفرنسية من الصفر للمبتدئين: الحروف الفرنسية والحروف المركبة","channel":"Le français avec Nabila — الفرنسية مع نبيلة","why":"تأسيس صوتي واضح يقدم الحروف مفردة مع النطق الصوتي الصحيح.","dur":18,"lang":"ar","main":true},"sub":[{"h":"الفروق الصوتية الحيوية للناطق بالعربية (P/B و V/F)","p":["لا تحتوي اللغة العربية الفصحى على الصوت الانفجاري الشفوي المهموس /p/، بل تقتصر على /b/. في الفرنسية، الخلط بينهما يغير المعنى جذرياً: pain (خبز) مقابل bain (حمام)، poisson (سمك) مقابل boisson (مشروب). يتحقق نطق /p/ بحبس الهواء خلف الشفتين ثم إطلاقه بقوة دون اهتزاز الحبال الصوتية (Sourde).","المقابلة ذاتها تنطبق على الصامت الشفوي-الأسنان المجهور /v/ (المقابل لـ V)؛ حيث تحتك الأسنان العليا بالشفة السفلى مع اهتزاز مسموع للحبال الصوتية (Sonore)، على النقيض من /f/ المهموس: vous (أنتم) مقابل fou (مجنون)، vent (ريح) مقابل faim (جوع)."]},{"h":"السلوك الصوتي للحرفين C و G (القاعدة الصلبة والرخوة)","p":["حرف C يمتلك قيمتين صوتيتين دقيقتين: يُنطق رخواً كصوت السين /s/ إذا جاء بعده أحد الحروف (E, I, Y) مثل: ceci, citron, cycle. ويُنطق صلباً كصوت الكاف /k/ إذا جاء بعده (A, O, U) أو أي حرف ساكن: café, chocolat, cuisine.","حرف G يتبع القانون المماثل تماماً: يُنطق رخواً كالجيم الفرنسية المجهورة /ʒ/ أمام (E, I, Y) مثل: geste, girafe, gymnastique. ويُنطق صلباً كالجيم القاهرية /ɡ/ أمام (A, O, U) أو أي ساكن: gare, gomme, guide."]}]},{"h":"مخرج الراء الفرنسية /ʁ/ والحرف المحايد U /y/","p":["الراء الفرنسية المعيارية ليست راءً لسانية مكررة كالراء العربية، بل هي صامت احتكاكي لهوي مجهور يُرمز له صوتياً بـ /ʁ/. يخرج الصوت من تضييق مجرى الهواء بين ظهر اللسان واللهاة في أقصى الحلق (قريب من موضع حرف الغين العربي ولكنه احتكاكي لغوي نقي).","حرف U يمثل التحدي الصوتي الأبرز للمبتدئين؛ رمزه الصوتي الدولي هو /y/. لتأدية الصوت بدقة علمية: انطق صوت الكسرة الممتدة /i/ (إي)، وثبّت لسانك في مكانه تماماً ملتصقاً بالأسنان السفلية، ثم قم بضم شفتيك للأمام بإحكام كأنك تنطق ضمة أو تصفر. الصوت الناتج هو /y/ النقي، وهو يختلف تماماً عن /u/ المماثل للواو والمكتوب دائماً بتركيب OU."],"video":{"id":"W_N7v29Zf6M","title":"L'alphabet français — Prononciation avec une professeure native","channel":"Français avec Pierre","why":"نطق فرنسي أصيل يركز على حركات الشفاه ومخارج الأصوات الدقيقة.","dur":12,"lang":"fr"}},{"h":"التدريب الأكاديمي على التهجئة الذاتية","p":["في التعاملات الإدارية والأكاديمية في فرنسا، التهجئة (l'épellation) مهارة يومية لا غنى عنها لتدوين الأسماء، العناوين، وأرقام الهويات. يُستخدم في ذلك السؤال الرسمي: «Comment ça s'épelle ?» (كيف يُكتب ذلك بالتهجئة؟).","عند تهجئة الكلمات التي تحتوي على حرفين متتاليين متطابقين، يُستخدم التعبير «deux» أو «double» متبوعاً باسم الحرف: كلمة pomme تُهجّأ: P - O - deux M - E.","يجسر هذا الدرس جسراً تعليمياً نحو a0-t1-l2 الذي يعالج العلامات التشكيلية فوق الحروف نفسها التي أتقنت الآن أسماءها ومخارجها، ثم نحو a0-t1-l3 الذي يوظف التهجئة ذاتها في سياق إداري كامل. وللتطبيق: أعد مشاهدة الفيديو الرئيسي حتى نهاية مقطع الحروف المفردة، ثم سجّل صوتك وأنت تهجّئ اسمك الشخصي ولقبك العائلي اعتماداً على الجدول الصوتي الوارد في هذا الدرس، مع إعادة تسجيل أي حرف تردّدت فيه حتى يستقيم مخرجه تماماً."]}],"examples":[{"fr":"L'alphabet compte vingt-six lettres.","ar":"تتكون الأبجدية من ستة وعشرين حرفاً.","note":"قاعدة أساسية في بنية الرسم اللاتيني"},{"fr":"A, E, I, O, U et Y sont des voyelles.","ar":"A و E و I و O و U و Y هي حروف علة.","note":"تصنيف حروف العلة الستة"},{"fr":"B, C, D et F sont des consonnes.","ar":"B و C و D و F هي حروف ساكنة.","note":"تصنيف الحروف الصامتة"},{"fr":"Le mot « pain » commence par la lettre P.","ar":"كلمة 'خبز' تبدأ بحرف P.","note":"صوت انفجاري مهموس /p/"},{"fr":"Le mot « bain » commence par la lettre B.","ar":"كلمة 'حمام' تبدأ بحرف B.","note":"صوت انفجاري مجهور /b/"},{"fr":"La lettre C se prononce [s] dans « citron ».","ar":"يُنطق حرف C كـ [s] في كلمة 'ليمون'.","note":"قاعدة C أمام حرف I"},{"fr":"La lettre C se prononce [k] dans « café ».","ar":"يُنطق حرف C كـ [k] في كلمة 'قهوة'.","note":"قاعدة C أمام حرف A"},{"fr":"La lettre H est toujours muette en français.","ar":"حرف H صامت دائماً في اللغة الفرنسية.","note":"لا قيمة صوتية مستقلة له"}],"pron":[{"w":"A","ipa":"[a]","approx":"آ","note":"حركة علة مفتوحة مسترخية أمامية تشبه الفتحة الممدودة"},{"w":"B","ipa":"[be]","approx":"بيه","note":"صوت صامت انفجاري مجهور بشفاه مطبقة مع اهتزاز الحبال الصوتية"},{"w":"C","ipa":"[se]","approx":"سيه","note":"يُنطق [s] أمام (e, i, y) ويُنطق [k] كالكاف أمام (a, o, u)"},{"w":"D","ipa":"[de]","approx":"ديه","note":"صوت صامت انفجاري لثوي مجهور مثل الدال المرققة"},{"w":"E","ipa":"[ə]","approx":"أُه / إو","note":"حركة علة متوسطة مركزية محايدة بين الضمة والكسرة باستدارة الشفاه"},{"w":"F","ipa":"[ɛf]","approx":"إيفّ","note":"صوت صامت احتكاكي مهموس (الأسنان العليا مع الشفة السفلى)"},{"w":"G","ipa":"[ʒe]","approx":"جيه (معطشة)","note":"يُنطق [ʒ] كالجيم المعطشة أمام (e, i, y) و[ɡ] كالجيم القاهرية أمام (a, o, u)"},{"w":"H","ipa":"[aʃ]","approx":"آش","note":"اسم الحرف فقط، صامت دائماً ولا يُنطق إطلاقاً في أي كلمة فرنسية"},{"w":"I","ipa":"[i]","approx":"إي","note":"حركة علة مغلقة أمامية غير مستديرة، كسرة نقية مشدودة دون إمالة"},{"w":"J","ipa":"[ʒi]","approx":"جي (معطشة)","note":"صوت احتكاكي مجهور دائم /ʒ/ كالجيم المعطشة الشامية"},{"w":"K","ipa":"[ka]","approx":"كا","note":"صوت صامت انفجاري طبقي مهموس، نطق نقي كالكاف العربية"},{"w":"L","ipa":"[ɛl]","approx":"إيلّ","note":"لام لثوية مرققة دائماً في الفرنسية، لا تفخم أبداً"},{"w":"M","ipa":"[ɛm]","approx":"إيمّ","note":"صوت أنفي شفوي مجهور مثل الميم العربية"},{"w":"N","ipa":"[ɛn]","approx":"إينّ","note":"صوت أنفي لثوي مجهور مثل النون العربية"},{"w":"O","ipa":"[o]","approx":"أو","note":"حركة علة خلفية مستديرة نصف مغلقة مع ضم الشفتين في دائرة واضحة"},{"w":"P","ipa":"[pe]","approx":"پيه","note":"صامت انفجاري مهموس باندفاع هواء، لا تهتز معه الأوتار (تمييزاً عن B)"},{"w":"Q","ipa":"[ky]","approx":"كيو (بضم الشفاه)","note":"كاف متبوعة بحركة /y/ الضيقة، يتبعه حرف U كتابياً في أغلب الكلمات"},{"w":"R","ipa":"[ɛʁ]","approx":"إيرْ (لهوية)","note":"راء لهوية احتكاكية باحتكاك مؤخرة اللسان باللهاة، تشبه الغين المرققة"},{"w":"S","ipa":"[ɛs]","approx":"إيسّ","note":"يُنطق [s] كالسين، ويتحول إلى [z] كالزاي إذا وقع مفرداً بين حركتي علة"},{"w":"T","ipa":"[te]","approx":"تيه","note":"صامت انفجاري أسناني مهموس، تاء مرققة دون تفخيم"},{"w":"U","ipa":"[y]","approx":"إي بضم الشفتين","note":"صوت علة أمامي مدوّر: اللسان في وضع الكسرة (I) مع ضم الشفتين كالواو"},{"w":"V","ipa":"[ve]","approx":"ڤيه","note":"صوت شفوي أسناني احتكاكي مجهور باهتزاز الحبال الصوتية (يقابل F المهموس)"},{"w":"W","ipa":"[dubləve]","approx":"دوبلُ ڤيه","note":"يعني (V المزدوجة)، يكثر في الكلمات المقترضة ويُنطق غالباً [v] أو [w]"},{"w":"X","ipa":"[iks]","approx":"إيكس","note":"مركب صوتي يُنطق غالباً [ks] في الكلمات أو [gz] بعد بادئات مثل ex-"},{"w":"Y","ipa":"[iɡʁɛk]","approx":"إي-غريك","note":"اسمه يعني (الياء اليونانية)، يعامل كحركة علة [i] أو كشبه حركة [j]"},{"w":"Z","ipa":"[zɛd]","approx":"زيد","note":"صوت لثوي صفيري مجهور يقابل السين، مثل الزاي العربية"}],"vocab":[{"fr":"l'alphabet","ar":"الأبجدية","pos":"nom","g":"m","pl":"les alphabets","ipa":"[l‿al.fa.bɛ]","exFr":"J'apprends l'alphabet français.","exAr":"أتعلم الأبجدية الفرنسية."},{"fr":"la lettre","ar":"الحرف","pos":"nom","g":"f","pl":"les lettres","ipa":"[la lɛtʁ]","exFr":"Il y a 26 lettres.","exAr":"يوجد ستة وعشرون حرفاً."},{"fr":"la voyelle","ar":"حرف العلة / الحركة","pos":"nom","g":"f","pl":"les voyelles","ipa":"[la vwa.jɛl]","exFr":"Le français a six voyelles écrites.","exAr":"تحتوي الفرنسية على ستة حروف علة مكتوبة."},{"fr":"la consonne","ar":"الحرف الصامت / الساكن","pos":"nom","g":"f","pl":"les consonnes","ipa":"[la kɔ̃.sɔn]","exFr":"La lettre T est une consonne.","exAr":"حرف T هو حرف ساكن."},{"fr":"le son","ar":"الصوت الفونيمي","pos":"nom","g":"m","pl":"les sons","ipa":"[lə sɔ̃]","exFr":"Chaque lettre produit un son.","exAr":"كل حرف يُنتج صوتاً."},{"fr":"le mot","ar":"الكلمة","pos":"nom","g":"m","pl":"les mots","ipa":"[lə mo]","exFr":"C'est un mot court.","exAr":"هذه كلمة قصيرة."},{"fr":"épeler","ar":"يهجّئ","pos":"verbe","ipa":"[e.pə.le]","exFr":"Pouvez-vous épeler votre nom ?","exAr":"هل يمكنك تهجئة اسمك؟"},{"fr":"prononcer","ar":"ينطق","pos":"verbe","ipa":"[pʁɔ.nɔ̃.se]","exFr":"Je prononce la lettre R.","exAr":"أنطق حرف R."},{"fr":"le prénom","ar":"الاسم الشخصي الأول","pos":"nom","g":"m","pl":"les prénoms","ipa":"[lə pʁe.nɔ̃]","exFr":"Mon prénom est Sami.","exAr":"اسمي الشخصي هو سامي."},{"fr":"le nom","ar":"اللقب العائلي / الاسم","pos":"nom","g":"m","pl":"les noms","ipa":"[lə nɔ̃]","exFr":"Quel est votre nom ?","exAr":"ما هو لقبك؟"},{"fr":"muet","ar":"صامت / أخرس","pos":"adj","g":"m","pl":"muets","ipa":"[mɥɛ]","exFr":"Le H est muet.","exAr":"حرف H صامت."},{"fr":"sonore","ar":"مجهور (صوتي)","pos":"adj","g":"mf","pl":"sonores","ipa":"[sɔ.nɔʁ]","exFr":"La consonne B est sonore.","exAr":"الحرف الساكن B مجهور."},{"fr":"sourd","ar":"مهموس (غير صوتي)","pos":"adj","g":"m","pl":"sourds","ipa":"[suʁ]","exFr":"La consonne P est sourde.","exAr":"الحرف الساكن P مهموس."},{"fr":"le café","ar":"القهوة / المقهى","pos":"nom","g":"m","pl":"les cafés","ipa":"[lə ka.fe]","exFr":"Un café, s'il vous plaît.","exAr":"قهوة، من فضلك."},{"fr":"le pain","ar":"الخبز","pos":"nom","g":"m","pl":"les pains","ipa":"[lə pɛ̃]","exFr":"J'achète du pain.","exAr":"أشتري خبزاً."},{"fr":"la gare","ar":"محطة القطار","pos":"nom","g":"f","pl":"les gares","ipa":"[la ɡaʁ]","exFr":"Où est la gare ?","exAr":"أين محطة القطار؟"}],"grammar":[{"tAr":"ثنائية الحرف الصامت والحركة (Consonnes et Voyelles)","tFr":"Structure syllabique élémentaire","body":["الوحدة الصوتية الأساسية في الفرنسية هي المقطع الصوتي (La syllabe). يبنى المقطع البسيط عادة من صامت يليه حركة (CV: Consonne + Voyelle) مثل: ca-fé, mu-si-que.","الحرف الصامت لا يمكن النطق به بمفرده بسلاسة دون الاستناد إلى حركة صوتية تليه أو تسبقه. في الفرنسية المعيارية، تتتابع المقاطع بشكل متساوٍ في النبر (Langue à accent d'intensité final)، مما يمنحها إيقاعها الموسيقي المميز."],"ex":[{"fr":"ba - be - bi - bo - bu","ar":"مقاطع صوتية متدرجة لحرف B مع حركات العلة"},{"fr":"pa - pe - pi - po - pu","ar":"مقاطع صوتية متدرجة لحرف P مع حركات العلة"}]},{"tAr":"الصامت النهائي غير المنطوق (Consonne finale muette)","tFr":"Le principe de l'amuïssement","body":["في معظم الكلمات الفرنسية، الحرف الساكن الأخير لا يُنطق إذا لم يتبعه حرف علة (مثل D في grand، و T في petit، و S في paris).","الاستثناء العام هو حروف CaReFuL (C, R, F, L) التي تُنطق غالباً في أواخر الكلمات البسيطة مثل: avec, mer, chef, fil."],"ex":[{"fr":"un lit [li]","ar":"سرير (حرف T صامت نهائياً)"},{"fr":"un sac [sak]","ar":"حقيبة (حرف C ينطق كـ [k] لأنه من حروف CaReFuL)"}]}],"mistakes":[{"wrong":"نطق حرف G في الأبجدية كصوت 'غي' (Ghayn)","right":"G = [ʒe] (جيه معطشة)","why":"اسم الحرف الفرنسي هو 'جيه' مثل كلمة journal، ولا ينطق 'غ' إطلاقاً."},{"wrong":"نطق P كـ B في الكلمات مثل pain تصبح bain","right":"pain = [pɛ̃] بحبس الهواء وإطلاقه دون رنين بالحبال الصوتية","why":"الخلل يغير المعنى من 'خبز' إلى 'حمام'."},{"wrong":"محاولة نطق حرف H في بداية الكلمات مثل hôtel","right":"hôtel يُنطق مباشرة [o.tɛl]","why":"حرف H لا صوت له إطلاقاً في الفرنسية الحديثة."}],"dialogues":[{"title":"التهجئة الرسمية للاسم عند موظف الاستقبال","ctx":"في مكتب إداري فرنسي يطلب الموظف من الزائر تهجئة اسمه الشخصي لتسجيله في السجل الرسمي.","lines":[{"who":"L'employé","fr":"Bonjour monsieur. Quel est votre prénom, s'il vous plaît ?","ar":"صباح الخير سيدي. ما هو اسمك الشخصي، من فضلك؟"},{"who":"Le visiteur","fr":"Bonjour. Je m'appelle Farid.","ar":"صباح الخير. اسمي فريد."},{"who":"L'employé","fr":"Comment ça s'épelle ?","ar":"كيف يُهجّأ هذا الاسم؟"},{"who":"Le visiteur","fr":"F - A - R - I - D.","ar":"إف - آ - إير - إي - دي."},{"who":"L'employé","fr":"Merci beaucoup. Et votre nom de famille ?","ar":"شكراً جزيلاً. وما هو لقبك العائلي؟"},{"who":"Le visiteur","fr":"KASMI : K - A - S - M - I.","ar":"قاسمي: كا - آ - إس - إم - إي."},{"who":"L'employé","fr":"Parfait, c'est bien noté.","ar":"ممتاز، تم تسجيله بدقة."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"كم عدد الحروف الصوتية (les voyelles) المكتوبة في الأبجدية الفرنسية؟","opts":["4 حروف","6 حروف (A, E, I, O, U, Y)","8 حروف","20 حرفاً"],"a":1,"why":"الأبجدية تتضمن 6 حروف علة كتابية: A, E, I, O, U, Y، والباقي صوامت."},{"t":"mcq","skill":"listening","q":"كيف يُنطق حرف G عند تسميته في الأبجدية الفرنسية؟","opts":["غي","جي معطشة [ʒe]","كاي","شي"],"a":1,"why":"اسم الحرف هو [ʒe] (جيه معطشة) بينما حرف J هو [ʒi]."},{"t":"correct","skill":"reading","q":"صحّح الخطأ الصوتي في الجملة التالية المنسوبة إلى قاعدة حرف C:","fr":"Le mot « citron » se prononce [kitʁɔ̃].","ans":"Le mot « citron » se prononce [sitʁɔ̃].","why":"حرف C يُنطق رخواً كصوت السين [s] أمام الحروف E و I و Y، ولذلك تُنطق citron [sitʁɔ̃] لا [kitʁɔ̃]."},{"t":"fill","skill":"grammar","q":"أكمل: في كلمة 'hôtel'، حرف H يعتبر حرفاً ___ ولا يُنطق.","fr":"Dans le mot hôtel, la lettre H est ____.","ans":"muet","alts":["muette","صامت"],"why":"حرف H في اللغة الفرنسية muet دائماً."},{"t":"order","skill":"grammar","q":"رتّب كلمات الجملة التي تعبر عن عدد الحروف في الأبجدية:","words":["L'alphabet","français","compte","vingt-six","lettres."],"why":"الترتيب النحوي السليم: فاعل معرف موصوف + فعل + مفعول به كمي.","ans":"L'alphabet français compte vingt-six lettres."},{"t":"listen","skill":"listening","audio":"Pouvez-vous épeler votre nom ?","q":"استمع إلى الجملة وحدد معناها بدقة:","opts":["هل يمكنك تهجئة اسمك؟","هل يمكنك كتابة رسالتك؟","هل تنطق هذه الكلمة؟","ما هو عملك المهني؟"],"a":0,"why":"الفعل épeler يعني تهجئة الحروف حرفاً بحرف."},{"t":"writing","skill":"writing","q":"اكتب جملة بسيطة بالفرنسية توضح أن الأبجدية تحتوي على 26 حرفاً:","min":4,"kw":["alphabet","lettres","vingt-six"],"sample":"L'alphabet a vingt-six lettres.","why":"الجملة تعبر عن البنية الأساسية التي استوعبتها في الدرس."},{"t":"speaking","skill":"pronunciation","q":"تدرّب على نطق الحروف الأربعة الأكثر حساسية للناطق بالعربية:","target":"P, V, R, U","why":"التركيز على انفجارية P، مجهورية V، حلقية R، واستدارة شفاه U."}],"homework":"سجّل مقطعاً صوتياً مدته دقيقة واحدة تنطق فيه الحروف التالية بترتيبها ومخارجها الدقيقة: P - B - V - F - U - OU - R. ثم اختر اسمك الشخصي واسم عائلتك وقم بتهجئتهما بالفرنسية بصوت عالٍ وواضح مستخدماً أسماء الحروف المعيارية. قبل الدرس التالي (a0-t1-l2): راجع الجدول الصوتي لستة وعشرين حرفاً مع أسمائها، ثم تدرّب على تهجئة اسمك الشخصي واللقب العائلي مرة أخيرة قبل الانتقال إلى العلامات التشكيلية.","supplements":[{"id":"eRWYgMGFm_M","title":"L'ALPHABET français | Français pour débutant | Écoutez et répétez 👂🗣✅","channel":"French School TV","why":"تدريب استماع وترديد مباشر يُعيد ترتيب الحروف بالفرنسية المعاصرة، ويصلح كمعاينة سمعية للجدول الصوتي الوارد في الدرس.","dur":4,"lang":"fr"},{"id":"vkOgY2vvyag","title":"الدرس1:تعلم كتابة وقراءة الحروف باللغة الفرنسية بكل سهولة للمبتدئين(A-B-C-D)/الحروف الكبيرة والصغيرة","channel":"سأتعلم اللغة","why":"شرح عربي لكتابة وقراءة الحروف الأولى مع التمييز بين الحرف الكبير والصغير، مما يثري مهارة التهجئة الكتابية المطروحة في هذا الدرس.","dur":14,"lang":"ar"}],"sources":[{"title":"تعلم اللغة الفرنسية من الصفر للمبتدئين: الحروف الفرنسية والحروف المركبة","channel":"Le français avec Nabila — الفرنسية مع نبيلة","why":"شرح عربي كامل للحروف المفردة والمركبة مع أمثلة دقيقة.","videoId":"a5WVeSuZpOs"},{"title":"L'ALPHABET français | Français pour débutant | Écoutez et répétez 👂🗣✅","channel":"French School TV","why":"تدريب استماع وترديد مباشر يُعيد ترتيب الحروف بالفرنسية المعاصرة، ويصلح كمعاينة سمعية للجدول الصوتي الوارد في الدرس.","videoId":"eRWYgMGFm_M"},{"title":"الدرس1:تعلم كتابة وقراءة الحروف باللغة الفرنسية بكل سهولة للمبتدئين(A-B-C-D)/الحروف الكبيرة والصغيرة","channel":"سأتعلم اللغة","why":"شرح عربي لكتابة وقراءة الحروف الأولى مع التمييز بين الحرف الكبير والصغير، مما يثري مهارة التهجئة الكتابية المطروحة في هذا الدرس.","videoId":"vkOgY2vvyag"}]},{"id":"A0-t1-l2","fr":"Les accents et les signes diacritiques","ar":"العلامات التشكيلية والحروف الخاصة: أسرار الكتابة الصوتية","objectives":["التمييز البصري والوظيفي بين العلامات التشكيلية الفرنسية الخمس (aigu, grave, circonflexe, cédille, tréma).","ضبط الفارق الصوتي الجوهري بين صوت [e] المغلق (é) وصوت [ɛ] المفتوح (è / ê).","إدراك الوظيفة الدلالية التمييزية للعلامات في التفريق بين المتشابهات النحوية (Homophones: a/à, ou/où).","تطبيق قاعدة السيدي (la cédille ç) ودورها الفونولوجي في تحويل صوت [k] إلى [s].","فهم وظيفة النقطتين (le tréma) في كسر الاندماج الصوتي للحروف المركبة."],"sections":[{"h":"العلامات التشكيلية الفرنسية: ليست زينة بل أدوات صوتية ودلالية","p":["تختلف اللغة الفرنسية عن الإنجليزية بامتلاكها لنظام دقيق من العلامات التشكيلية (Les signes diacritiques). هذه العلامات ليست إضافات اختيارية؛ بل هي جزء لا يتجزأ من الإملاء الصحيح، ونسيان كتابتها يُعد خطأً إملائياً فادحاً في المعايير الأكاديمية الفرنسية.","تنقسم وظائف العلامات التشكيلية إلى وظيفتين رئيسيتين: وظيفة فونولوجية (تغيير النطق الصوتي للحرف كما في é و è)، ووظيفة دلالية نحوية (التمييز بين كلمتين تُنطقان بنفس الصوت تماماً ولكن لهما معنيان ووظيفتان مختلفتان تماماً: Homophones)."],"video":{"id":"4vM1ajsHGe4","title":"اللغة الفرنسية:العلامات النطقية Les accents🙂🙂","channel":"Français avec  NiSoU الفرنسية مع","why":"شرح بالعربية للعلامات النطقية الخمس يبرز الفرق الصوتي بين é المغلق و è المفتوح وأثر كل علامة على النطق.","dur":7,"lang":"ar","main":true},"sub":[{"h":"أنواع العلامات الخمس وتأثيراتها الصوتية","p":["1. L'accent aigu (´) - الأكسان الحاد: يوضع حصراً فوق حرف E (é). يُحول نطقه إلى صوت [e] مغلق (fermé)؛ حيث تكون زوايا الشفتين مشدودتين للوراء كما في الابتسامة: été (صيف)، café (قهوة)، répéter (يكرر).","2. L'accent grave (`) - الأكسان الخفيف: يوضع فوق E (è) ليصبح صوتاً [ɛ] مفتوحاً (ouvert)؛ حيث يهبط الفك السفلي قليلاً لأسفل: père (أب)، mère (أم)، frère (أخ). كما يوضع فوق A و U للتفريق النحوي دون تغيير النطق: a (فعل يملك) مقابل à (حرف جر إلى/في)؛ ou (أو التخييرية) مقابل où (أين / حيث المكانية).","3. L'accent circonflexe (ˆ) - الأكسان الدائري/المثلث: يمكن أن يوضع فوق الحروف الصوتية الخمسة (â, ê, î, ô, û). في النطق المعاصر ينطق غالباً مثل الصوت المفتوح أو المطول، ولكن قيمته التاريخية تشهد على حرف S سقط من الكلمة عبر تطور اللغة: forêt (غابة، مشتقة من forest اللاتينية)، hôtel (فندق، من hostel).","4. La cédille (¸) - السيدي: علامة تشبه نصف رقم 5 صغيرة توضع حصراً تحت حرف C (ç) عندما يأتي قبله أحد الحروف الصلبة (A, O, U). وظيفتها الفونولوجية هي فرض نطق الحرف كصوت السين [s] بدلاً من الكاف [k]: français (فرنسي)، garçon (ولد)، leçon (درس). بدونها كانت الكلمة ستنطق 'فرانكيه' و'غاركون'!","5. Le tréma (¨) - النقطتان: توضع فوق الحرف الصوتي الثاني (غالباً ë أو ï) لمنع اندماجه الصوتي مع الحرف الذي قبله، وإجبار القارئ على نطق كل حرف بمقطع منفصل: Noël (نو-إل وليس نول)، maïs (ما-إيس: ذرة، وتختلف تماماً عن mais: لكن)."]}]},{"h":"التفريق الإملائي الحاسم بين المتشابهات (Les Homophones)","p":["من أعظم التحديات في المستوى المبتدئ التفريق بين الكلمات المتطابقة صوتاً والمتباينة رسماً ومعنى. العلامات التشكيلية هي الفاصل الأكاديمي الحاسم:","أولاً: a بدون علامة هو تصريف الفعل Avoir للغائب (Il a un livre = هو يملك كتاباً)، بينما à هو حرف جر ثابت يفيد المكان أو الغاية (Il va à Paris = هو يذهب إلى باريس).","ثانياً: ou بدون علامة أداة تخيير (thé ou café = شاي أو قهوة)، بينما où بالعلامة ظرف مكان أو أداة استفهام (Où habitez-vous ? = أين تسكن؟)."]},{"h":"التطبيق والتلخيص","p":["تستخلص هذه الخلاصة نظام العلامات التشكيلية الفرنسية الخمس (aigu, grave, circonflexe, cédille, tréma) ووظيفته المزدوجة: وظيفة فونولوجية تغيّر القيمة الصوتية للحرف كما في é [e] المغلق و è [ɛ] المفتوح، ووظيفة دلالية نحوية تفرّق بين المتشابهات المتطابقة صوتاً مثل a الفعلية و à الجارية، و ou التخييرية و où المكانية. كما وضح الفيديو الرئيسي «اللغة الفرنسية: العلامات النطقية Les accents» من قناة Français avec NiSoU، تُرسم كل علامة فوق الحرف بوظيفة صوتية محددة: الأكسان الحاد حصراً فوق E، والسيدي تحت C، والنقطتان فوق الحرف الصوتي الثاني، وإغفال هذه الرموز يُحوّل النطق والمعنى معاً لا مجرد شكل الكلمة.","تتطلب هذه الخلاصة قاعدة صلبة موروثة من a0-t1-l1، ألا وهي التمييز بين اسم الحرف وقيمته الصوتية؛ فلو لم يكن الطالب قد استوعب أن حرف C يُنطق [s] أمام E و I و Y، لما أدرك فائدة السيدي (ç) في كلمة français. وبعد هذا الدرس ينتقل الطالب إلى a0-t1-l3 الذي يوسّع مهارة الكتابة نفسها إلى التهجئة الرسمية وعلامات الترقيم وقواعد الحروف الكبيرة (Majuscules)، فتُستكمل بذلك أدوات الكتابة الدقيقة قبل الدخول في وحدة الأصوات a0-t2.","أعد مشاهدة الفيديو الرئيسي بتركيز، واستخرج من كل مقطع كلمة واحدة تحمل علامة تشكيلية، ثم سجّل جدولاً بأربعة أعمدة: الكلمة، نوع العلامة، نطقها بالحروف الصوتية، ووظيفتها (صوتية أم دلالية). بعد ذلك سجّل صوتك وأنت تنطق المثالين «Mon père aime l'été» و «Karim va à la gare» مطبقاً الفارق بين [e] و [ɛ]، ثم قارن تسجيلك بالنموذج المسموع في الفيديو وأعد التسجيل حتى يستقيم مخرج الحركة."]}],"examples":[{"fr":"L'été est une saison chaude.","ar":"الصيف فصل دافئ.","note":"é مغلق مرتان في كلمة été [e.te]"},{"fr":"Mon père et ma mère sont là.","ar":"أبي وأمي هنا.","note":"è مفتوح في père [pɛʁ] و mère [mɛʁ]"},{"fr":"Il a une voiture à Paris.","ar":"هو يملك سيارة في باريس.","note":"a الفعلية المجردة مقابل à المكانية بالعلامة"},{"fr":"Tu préfères le thé ou le café ?","ar":"أأنت تفضل الشاي أم القهوة؟","note":"ou التخييرية بدون علامة"},{"fr":"Où est la station de métro ?","ar":"أين هي محطة المترو؟","note":"où المكانية محددة بـ accent grave"},{"fr":"Le garçon apprend la leçon.","ar":"الولد يتعلم الدرس.","note":"ç تحول النطق إلى [s] أمام O"},{"fr":"Le maïs est une céréale.","ar":"الذرة من الحبوب.","note":"النقطتان tréma تفصلان a عن ï"},{"fr":"Nous habitons dans un bel hôtel.","ar":"نحن نسكن في فندق جميل.","note":"circonflexe شاهد تاريخي على حرف s سقط"}],"pron":[{"w":"été","ipa":"[e.te]","approx":"إيتيه","note":"صوتان مغلقان مشدودا الشفتين"},{"w":"père","ipa":"[pɛʁ]","approx":"بَيرْ","note":"صوت مفتوح مع هبوط الفك"},{"w":"français","ipa":"[fʁɑ̃.sɛ]","approx":"فخونسيه","note":"ç تلفظ [s] قبل a"},{"w":"garçon","ipa":"[ɡaʁ.sɔ̃]","approx":"غارسون","note":"ç تلفظ [s] قبل o"},{"w":"Noël","ipa":"[nɔ.ɛl]","approx":"نو-إِل","note":"النقطتان تفصلان الحركتين"},{"w":"maïs","ipa":"[ma.is]","approx":"ما-إيس","note":"مقطعان منفصلان بفضل le tréma"}],"vocab":[{"fr":"l'accent","ar":"العلامة التشكيلية / النبرة","pos":"nom","g":"m","pl":"les accents","ipa":"[l‿ak.sɑ̃]","exFr":"Cette lettre porte un accent.","exAr":"هذا الحرف يحمل علامة تشكيلية."},{"fr":"l'accent aigu","ar":"الأكسان الحاد (é)","pos":"nom","g":"m","pl":"les accents aigus","ipa":"[l‿ak.sɑ̃.t‿e.ɡy]","exFr":"Le mot café prend un accent aigu.","exAr":"كلمة قهوة تأخذ أكسان حاد."},{"fr":"l'accent grave","ar":"الأكسان الخفيف (è, à, ù)","pos":"nom","g":"m","pl":"les accents graves","ipa":"[l‿ak.sɑ̃ ɡʁav]","exFr":"Père s'écrit avec un accent grave.","exAr":"كلمة أب تُكتب بأكسان خفيف."},{"fr":"l'accent circonflexe","ar":"الأكسان الدائري / المثلث (ˆ)","pos":"nom","g":"m","pl":"les accents circonflexes","ipa":"[l‿ak.sɑ̃ siʁ.kɔ̃.flɛks]","exFr":"L'accent circonflexe est sur le O de hôtel.","exAr":"الأكسان الدائري فوق حرف O في فندق."},{"fr":"la cédille","ar":"السيدي (علامة ç)","pos":"nom","g":"f","pl":"les cédilles","ipa":"[la se.dij]","exFr":"Le mot français a une cédille sous le C.","exAr":"كلمة فرنسي تحتوي على سيدي تحت C."},{"fr":"le tréma","ar":"النقطتان (¨)","pos":"nom","g":"m","pl":"les trémas","ipa":"[lə tʁe.ma]","exFr":"Le tréma sépare les deux voyelles.","exAr":"النقطتان تفصلان الحركتين."},{"fr":"le père","ar":"الأب","pos":"nom","g":"m","pl":"les pères","ipa":"[lə pɛʁ]","exFr":"Mon père habite à Lyon.","exAr":"أبي يسكن في ليون."},{"fr":"la mère","ar":"الأم","pos":"nom","g":"f","pl":"les mères","ipa":"[la mɛʁ]","exFr":"Ma mère parle français.","exAr":"أمي تتحدث الفرنسية."},{"fr":"le frère","ar":"الأخ","pos":"nom","g":"m","pl":"les frères","ipa":"[lə fʁɛʁ]","exFr":"J'ai un frère.","exAr":"لدي أخ واحد."},{"fr":"le garçon","ar":"الولد / الصبي","pos":"nom","g":"m","pl":"les garçons","ipa":"[lə ɡaʁ.sɔ̃]","exFr":"Le garçon joue au ballon.","exAr":"الولد يلعب بالكرة."},{"fr":"la leçon","ar":"الدرس","pos":"nom","g":"f","pl":"les leçons","ipa":"[la lə.sɔ̃]","exFr":"Nous lisons la leçon.","exAr":"نحن نقرأ الدرس."},{"fr":"l'été","ar":"الصيف","pos":"nom","g":"m","pl":"les étés","ipa":"[l‿e.te]","exFr":"L'été est chaud.","exAr":"الصيف حار."},{"fr":"l'hôtel","ar":"الفندق","pos":"nom","g":"m","pl":"les hôtels","ipa":"[l‿o.tɛl]","exFr":"L'hôtel est complet.","exAr":"الفندق ممتلئ."},{"fr":"la forêt","ar":"الغابة","pos":"nom","g":"f","pl":"les forêts","ipa":"[la fɔ.ʁɛ]","exFr":"Une promenade dans la forêt.","exAr":"نزهة في الغابة."},{"fr":"ou","ar":"أو (حرف عطف تخييري)","pos":"conjonction","ipa":"[u]","exFr":"Thé ou café ?","exAr":"شاي أم قهوة؟"},{"fr":"où","ar":"أين / حيث (مكانية)","pos":"adverbe","ipa":"[u]","exFr":"Où allez-vous ?","exAr":"إلى أين أنتم ذاهبون؟"}],"grammar":[{"tAr":"التمييز النحوي بين a و à","tFr":"La distinction grammaticale : a (verbe) vs à (préposition)","body":["القاعدة الذهبية للاختبار النحوي: إذا استطعت استبدال الكلمة بـ «avait» (كان يملك في الماضي)، فهي الفعل «a» وتكتب بدون أكسان.","مثال: «Il a faim» تصبح في الماضي «Il avait faim» (جملة صحيحة)، إذن نكتب «a» بدون علامة.","أما إذا استحال الاستبدال بـ avait وأفسد المعنى، فهي حرف الجر «à» ويجب وضع الأكسان حتماً: «Je vais à l'école» (لا يمكن القول Je vais avait l'école!)."],"ex":[{"fr":"Sami a une sœur.","ar":"سامي يملك أختاً. (فعل Avoir)"},{"fr":"Sami va à Paris.","ar":"سامي يذهب إلى باريس. (حرف جر مكاني)"}]}],"mistakes":[{"wrong":"كتابة francais بدون cédille","right":"français (مع ç)","why":"بدون cédille ستنطق الكلمة [fʁɑ̃.kɛ] لأن C قبل A تلفظ صلباً كالكاف."},{"wrong":"كتابة 'Où es-tu ?' بدون accent grave على où","right":"Où es-tu ? (مع أكسان على ù)","why":"بدون أكسان تعني ou 'أو التخييرية' فتفقد الجملة أداة الاستفهام المكانية."},{"wrong":"الخلط بين صوت é وصوت è واعتبارهما نطقاً واحداً","right":"é = [e] مغلق الشفتين، è = [ɛ] مفتوح الفك","why":"التمييز الصوتي ضروري جداً للتفرقة بين صيغ الماضي (parlé) والأفعال المنصوبة والمصادر."}],"dialogues":[{"title":"تصحيح بطاقة التسجيل في معهد اللغة","ctx":"أستاذ فرنسي يراجع استمارة تسجيل طالب مبتدئ وينبهه بدقة إلى العلامات الإملائية.","lines":[{"who":"Le professeur","fr":"Regardez votre fiche : vous avez écrit « garcon » et « francais ».","ar":"انظر إلى استمارتك: لقد كتبت 'garcon' و 'francais'."},{"who":"L'étudiant","fr":"Ah oui, j'ai oublié les cédilles sous le C !","ar":"آه نعم، لقد نسيت علامتي السيدي تحت حرف C!"},{"who":"Le professeur","fr":"Exactement : sans la cédille, on lirait « garkon » et « frankais ».","ar":"بالضبط: بدون السيدي، سنقرأ 'غاركون' و 'فرانكيه'."},{"who":"L'étudiant","fr":"Et pour le mot « etudiant », il faut un accent aigu ?","ar":"وبالنسبة لكلمة 'etudiant'، هل تحتاج أكسان حاد؟"},{"who":"Le professeur","fr":"Oui, sur le E : étudiant [e.ty.djɑ̃]. L'accent change tout !","ar":"نعم، فوق حرف E: طالب. العلامة التشكيلية تغير كل شيء!"}]}],"exercises":[{"t":"mcq","skill":"grammar","q":"ما الفرق النحوي بين 'a' و 'à' في اللغة الفرنسية؟","opts":["'a' فعل يملك، و 'à' حرف جر","'a' حرف جر، و 'à' فعل يملك","لا يوجد أي فرق ويستخدمان عشوائياً","'a' للمذكر و 'à' للمؤنث"],"a":0,"why":"'a' بدون علامة هو تصريف فعل avoir، بينما 'à' بالعلامة حرف جر."},{"t":"mcq","skill":"reading","q":"لماذا نضع السيدي (la cédille ç) في كلمة 'garçon'؟","opts":["لتزيين الكلمة","لجعل حرف C يُنطق [s] أمام حرف O","لجعل الكلمة مؤنثة","لتأكيد نطق حرف R"],"a":1,"why":"بدون cédille كان حرف C سينطق صلباً كالكاف [k] أمام حرف O."},{"t":"fill","skill":"grammar","q":"اختر الكلمة الصحيحة: 'Karim va ___ la gare.' (a أو à)","fr":"Karim va ___ la gare.","ans":"à","alts":["a"],"why":"المطلوب هنا حرف جر مكاني يفيد الذهاب 'إلى' المحطة، لذلك نختار à بالعلامة."},{"t":"order","skill":"grammar","q":"رتّب كلمات السؤال الاستفهامي المكاني التالي:","words":["Où","habite","votre","père","actuellement ?"],"why":"أداة الاستفهام المكانية Où تبدأ الجملة متبوعة بالفعل والفاعل.","ans":"Où habite votre père actuellement ?"},{"t":"listen","skill":"listening","audio":"Le garçon prend un café à l'hôtel.","q":"استمع إلى الجملة وحدد الكلمات التي اشتملت على علامات تشكيلية (accents / cédille):","opts":["garçon, café, à, hôtel","prend, un, hotel","le, prend, cafe","hotel, garçon فقط"],"a":0,"why":"تضمنت: garçon (cédille), café (accent aigu), à (accent grave), hôtel (circonflexe)."},{"t":"correct","skill":"grammar","q":"صحح الخطأ الإملائي في الجملة: 'Je prefere le thé.'","fr":"Je prefere le thé.","ans":"Je préfère le thé.","why":"الفعل préférer يتطلب أكسان حاد فوق e الأولى وأكسان خفيف فوق الثانية في المضارع: préfère."},{"t":"writing","skill":"writing","q":"اكتب جملة بسيطة تسأل فيها صديقك: 'أين تسكن؟' بالفرنسية مع وضع الأكسان الصحيح:","min":3,"kw":["où","tu","habites"],"sample":"Où tu habites ?","why":"تطبيق مباشر على كتابة أداة الاستفهام Où مع علامتها التشكيلية."},{"t":"speaking","skill":"pronunciation","q":"انطق الجملة التالية مراعياً الفارق الصوتي بين é المغلق و è المفتوح:","target":"Mon père aime l'été.","why":"مقارنة دقيقة بين père [pɛʁ] بصوت مفتوح، و été [e.te] بصوتين مغلقين."}],"homework":"استخرج 5 كلمات فرنسية من محيطك اليومي (ماركات، منتجات، لافتات) تحمل علامات تشكيلية فرنسية مختلفة، وصنفها في جدول يوضح: الكلمة، نوع العلامة التشكيلية، ووظيفتها (صوتية أم دلالية)، ثم تدرب على نطقها بصوت مسموع. قبل الدرس التالي (a0-t1-l3): جهّز جدولاً بأربع كلمات تحمل أكساناً مختلفة من محيطك اليومي، وأكمل التسميع الشفوي لزوجي (a / à) و (ou / où) قبل التحول إلى التهجئة الرسمية وعلامات الترقيم.","supplements":[{"id":"ONj_ghJYOIQ","title":"Compilation : l'accent aigu, grave et circonflexe","channel":"Eveiller mon enfant","why":"تجميع مصور لعلامات الأكسان الثلاث داخل مقطع واحد، يغني المتعلم عن تشتيت مصادر متعددة قبل التمييز الصوتي بين é و è.","dur":7,"lang":"fr"},{"id":"-dNeor8jeeE","title":"🟢Le TRÉMA / La CÉDILLE et les Remarques IMPORTANTES🟢","channel":"FRENCH TIME","why":"يركّز حصرًا على علامتَي النقطتين (tréma) والسيدي (cédille) مع ملاحظات تطبيقية تمنع أخطاء إملائية شائعة عند المبتدئين.","dur":4,"lang":"fr"}],"sources":[{"title":"اللغة الفرنسية:العلامات النطقية Les accents🙂🙂","channel":"Français avec  NiSoU الفرنسية مع","why":"شرح عربي واضح للعلامات التشكيلية الخمس وأثرها الصوتي في الكلمات الفرنسية.","videoId":"4vM1ajsHGe4"},{"title":"Compilation : l'accent aigu, grave et circonflexe","channel":"Eveiller mon enfant","why":"تجميع مصور لعلامات الأكسان الثلاث داخل مقطع واحد، يغني المتعلم عن تشتيت مصادر متعددة قبل التمييز الصوتي بين é و è.","videoId":"ONj_ghJYOIQ"},{"title":"🟢Le TRÉMA / La CÉDILLE et les Remarques IMPORTANTES🟢","channel":"FRENCH TIME","why":"يركّز حصرًا على علامتَي النقطتين (tréma) والسيدي (cédille) مع ملاحظات تطبيقية تمنع أخطاء إملائية شائعة عند المبتدئين.","videoId":"-dNeor8jeeE"}]},{"id":"A0-t1-l3","fr":"L'épellation officielle, la ponctuation et les majuscules","ar":"التهجئة الرسمية، علامات الترقيم، وقواعد الحروف الكبيرة","objectives":["إتقان تهجئة الأسماء والعناوين والأرقام وفق الأصول الإدارية الرسمية بالفرنسية.","التعرف على قراءة علامات الترقيم ورموز التواصل الإلكتروني المعاصرة (@, ., -, _).","تطبيق القواعد الأكاديمية الصارمة لاستخدام الحروف الكبيرة (Majuscules) في اللغة الفرنسية.","التمييز بين الحرف الكبير في أسماء الجنسيات كأشخاص، والحرف الصغير في اللغات والصفات.","إجراء حوار إداري مكتمل لملء استمارة تسجيل رسمية دون أخطاء كتابية."],"sections":[{"h":"التهجئة في السياق الإداري والمهني (L'épellation administrative)","p":["عند الاتصال بمؤسسة فرنسية، حجز فندق، أو فتح حساب مصرفي، تطلب الإدارة الفرنسية منك تهجئة اسمك وألقابك فوراً لتجنب الأخطاء الكتابية: «Veuillez épeler votre nom, s'il vous plaît» (تفضل بتهجئة اسمك رجاءً).","لا تقتصر التهجئة على أسماء الحروف فحسب، بل تمتد لتوضيح الحروف المركبة والمضاعفة. إذا احتوى الاسم على حرف مكرر مثل «Rami NASSAR»، تقول: «N - A - deux S (أو double S) - A - R».","في البيئات الصاخبة أو عبر الهاتف، قد يلجأ الفرنسيون إلى الأبجدية الإرشادية بذكر اسم مألوف يبدأ بالحرف: «A comme Arthur, B comme Bernard, C comme Claire»."],"video":{"id":"6SblBSZ7YPg","title":"Comment épeler son nom en français - Alphabet et dialogue (Niveau débutant A1)","channel":"Francisation - FLE","why":"حوار قصير مباشر يطبّق تهجئة الاسم حرفاً بحرف في موقف تعريفي حقيقي للمبتدئين.","dur":3,"lang":"fr","main":true},"sub":[{"h":"قراءة الرموز الحديثة وعناوين البريد الإلكتروني (L'adresse courriel)","p":["أصبح نطق الرموز الرقمية جزءاً لا يتجزأ من الكفاءة التواصلية في المستوى A0:","رمز @ يُنطق: «arobase» (أروباز).","رمز النقطة . يُنطق: «point» (بوان).","الشرطة الأفقية العادية - تُنطق: «tiret» أو للتحديد الدقيق «tiret du 6» (نسبة إلى موضعها على لوحة المفاتيح الفرنسية AZERTY).","الشرطة السفلية _ تُنطق: «tiret bas» أو «tiret du 8» أو «underscore».","مثال: العنوان «sami_paris@gmail.com» يُنطق بدقة: «sami tiret bas paris arobase gmail point com»."]}]},{"h":"القواعد الأكاديمية للحروف الكبيرة (L'usage des majuscules)","p":["تختلف الفرنسية جذرياً عن الإنجليزية في قواعد استخدام الحرف الكبير (La majuscule). التساهل في كتابة الحروف الكبيرة يُعد خطأً أكاديمياً صريحاً وفق مجمع اللغة الفرنسية (Académie française):","1. أيام الأسبوع والشهور تُكتب دائماً بحرف صغير (minuscule): lundi, mardi, janvier, février (خلافاً للإنجليزية التي تبدأ بـ Monday, January).","2. أسماء اللغات تُكتب بحرف صغير دائماً: «J'apprends le français» (وليس Le Français).","3. صفات الجنسية تُكتب بحرف صغير: «un passeport français, une voiture allemande».","4. أسماء الشعوب كأشخاص (Les gentilés) تُكتب بحرف كبير فقط عند الإشارة إلى الشخص ذاته: «Les Français aiment le fromage» (الفرنسيون كشعب بحرف كبير)، ولكن «Il est français» (صفة بحرف صغير)."]},{"h":"التطبيق والتلخيص","p":["تستخلص هذه الخلاصة ثلاث كفايات كتابية تُطبَّق في المواقف الإدارية الفرنسية: التهجئة الرسمية (l'épellation) للاسم واللقب والعناوين باستخدام تعبير «double» أو «deux» للحرف المكرر، ونطق الرموز الرقمية بأسمائها المعيارية (@ = arobase، . = point، - = tiret، _ = tiret bas)، وقواعد الحروف الكبيرة التي تميّز الفرنسية عن الإنجليزية في كتابة الأيام والشهور واللغات. كما وضح الفيديو الرئيسي «Comment épeler son nom en français - Alphabet et dialogue» من قناة Francisation - FLE، تجري التهجئة في حوار مباشر: يسأل الموظف ويتهجّى المتعلم اسمه حرفاً بحرف حتى يُدوَّن الاسم في السجل دون خطأ، وهو بالضبط النمط نفسه الذي يُطبَّق في مكاتب البريد والبنوك والمعاهد.","تستند هذه المهارة إلى a0-t1-l2 حيث استُخدمت العلامات التشكيلية بدقّة أثناء الكتابة، وإلى a0-t1-l1 الذي منح الطالب أسماء الحروف المعيارية اللازمة للتهجئة الرسمية؛ فلا تهجئة صحيحة بلا حروف مضبوطة الأسماء، ولا إملاء سليم بلا علامات تشكيلية في مواضعها. وبعدها يتولى a0-t2-l1 الانتقال من الكتابة إلى الأداء الصوتي، حيث تُعاد حروف العلة الستة التي تهجّئها الآن في صورة مخارج فموية دقيقة (Les voyelles orales)، فتتحول مهارة التهجئة إلى مهارة نطق.","أعد مشاهدة الفيديو الرئيسي وتوقّف عند كل سؤال من أسئلة التهجئة الظاهرة فيه، ثم سجّل صوتك وأنت تهجّئ اسمك الكامل ثم عنوان بريدك الإلكتروني بنفس إيقاع الحوار، ناطقاً كل رمز باسمه الرسمي (arobase, point, tiret) وبلا مسافة داخل العنوان. بعد التسجيل اكتب ما سمعته بحروف صغيرة مع حرف كبير واحد فقط في بداية كل جملة، مقتبساً من الفيديو قاعدة المطابقة بين المنطوق والمكتوب."]}],"examples":[{"fr":"Mon adresse est sami.dupont@email.fr.","ar":"عنواني هو sami نقطة dupont أروباز email نقطة fr.","note":"نطق: point و arobase"},{"fr":"Je suis né en janvier, un lundi.","ar":"ولدت في يناير، في يوم إثنين.","note":"الشهور والأيام بحرف صغير في الفرنسية"},{"fr":"J'étudie la langue française.","ar":"أدرس اللغة الفرنسية.","note":"اللغة والصفة بحرف صغير"},{"fr":"Les Français vivent en France.","ar":"الفرنسيون يعيشون في فرنسا.","note":"اسم الشعب بحرف كبير واسم الدولة بحرف كبير"},{"fr":"Comment s'épelle votre nom de famille ?","ar":"كيف يُهجّأ لقبك العائلي؟","note":"صيغة السؤال الإداري النموذجي"},{"fr":"Mettez un trait d'union entre les deux mots.","ar":"ضع شرطة وصل بين الكلمتين.","note":"علامة tiret للربط"},{"fr":"La phrase commence par une majuscule.","ar":"تبدأ الجملة بحرف كبير.","note":"قاعدة بداية الجملة الثابتة"},{"fr":"La phrase se termine par un point.","ar":"تنتهي الجملة بنقطة.","note":"علامة نهاية الجملة الإخبارية"}],"pron":[{"w":"arobase","ipa":"[a.ʁɔ.baz]","approx":"أروباز","note":"رمز @"},{"w":"point","ipa":"[pwɛ̃]","approx":"بوان","note":"رمز النقطة ."},{"w":"tiret","ipa":"[ti.ʁɛ]","approx":"تيريه","note":"رمز الشرطة -"},{"w":"majuscule","ipa":"[ma.ʒys.kyl]","approx":"ماجيسكول","note":"الحرف الكبير"},{"w":"minuscule","ipa":"[mi.nys.kyl]","approx":"مينيسكول","note":"الحرف الصغير"},{"w":"virgule","ipa":"[viʁ.ɡyl]","approx":"فيرغول","note":"الفاصلة ,"}],"vocab":[{"fr":"la majuscule","ar":"الحرف الكبير","pos":"nom","g":"f","pl":"les majuscules","ipa":"[la ma.ʒys.kyl]","exFr":"Écrivez en majuscules.","exAr":"اكتبوا بالحروف الكبيرة."},{"fr":"la minuscule","ar":"الحرف الصغير","pos":"nom","g":"f","pl":"les minuscules","ipa":"[la mi.nys.kyl]","exFr":"Ce mot est en minuscules.","exAr":"هذه الكلمة بحروف صغيرة."},{"fr":"le point","ar":"النقطة (.)","pos":"nom","g":"m","pl":"les points","ipa":"[lə pwɛ̃]","exFr":"Mettez un point à la fin.","exAr":"ضعوا نقطة في النهاية."},{"fr":"la virgule","ar":"الفاصلة (,)","pos":"nom","g":"f","pl":"les virgules","ipa":"[la viʁ.ɡyl]","exFr":"Séparez par une virgule.","exAr":"افصلوا بفاصلة."},{"fr":"l'arobase","ar":"رمز الآت (@)","pos":"nom","g":"f","pl":"les arobases","ipa":"[l‿a.ʁɔ.baz]","exFr":"Il manque l'arobase dans l'adresse.","exAr":"ينقص رمز @ في العنوان."},{"fr":"le tiret","ar":"الشرطة (-)","pos":"nom","g":"m","pl":"les tirets","ipa":"[lə ti.ʁɛ]","exFr":"Le tiret relie les deux mots.","exAr":"الشرطة تربط الكلمتين."},{"fr":"l'adresse courriel","ar":"عنوان البريد الإلكتروني","pos":"nom","g":"f","pl":"les adresses courriel","ipa":"[l‿a.dʁɛs ku.ʁjɛl]","exFr":"Donnez-moi votre adresse courriel.","exAr":"أعطني عنوان بريدك الإلكتروني."},{"fr":"la ponctuation","ar":"علامات الترقيم","pos":"nom","g":"f","pl":"les ponctuations","ipa":"[la pɔ̃k.tɥa.sjɔ̃]","exFr":"Respectez la ponctuation.","exAr":"احترموا علامات الترقيم."},{"fr":"le formulaire","ar":"استمارة التسجيل","pos":"nom","g":"m","pl":"les formulaires","ipa":"[lə fɔʁ.my.lɛʁ]","exFr":"Remplissez ce formulaire.","exAr":"املأوا هذه الاستمارة."},{"fr":"la signature","ar":"التوقيع","pos":"nom","g":"f","pl":"les signatures","ipa":"[la si.ɲa.tyʁ]","exFr":"Votre signature ici, s'il vous plaît.","exAr":"توقيعك هنا، من فضلك."},{"fr":"lundi","ar":"يوم الإثنين","pos":"nom","g":"m","pl":"les lundis","ipa":"[lœ̃.di]","exFr":"Le cours commence lundi.","exAr":"الدرس يبدأ يوم الإثنين."},{"fr":"janvier","ar":"شهر يناير","pos":"nom","g":"m","ipa":"[ʒɑ̃.vje]","exFr":"Nous sommes en janvier.","exAr":"نحن في شهر يناير."},{"fr":"la nationalité","ar":"الجنسية","pos":"nom","g":"f","pl":"les nationalités","ipa":"[la na.sjɔ.na.li.te]","exFr":"Quelle est votre nationalité ?","exAr":"ما هي جنسيتك؟"},{"fr":"français","ar":"فرنسي (لغة أو صفة)","pos":"adj","g":"m","pl":"français","ipa":"[fʁɑ̃.sɛ]","exFr":"C'est un passeport français.","exAr":"هذا جواز سفر فرنسي."},{"fr":"un Français","ar":"شخص فرنسي (اسم علم للشعب)","pos":"nom","g":"m","pl":"les Français","ipa":"[œ̃ fʁɑ̃.sɛ]","exFr":"Pierre est un Français de Paris.","exAr":"بيير شخص فرنسي من باريس."}],"grammar":[{"tAr":"قواعد الحروف الكبيرة (Majuscules) الدقيقة","tFr":"L'emploi normatif des majuscules","body":["توضع الحروف الكبيرة في مواضع محددة بدقة: الحرف الأول في بداية الجملة بعد نقطة، وأسماء الأعلام الجغرافية والشخصية (Paris, Jean, la France).","لا توضع الحروف الكبيرة مطلقاً في الفرنسية على: أسماء الأيام (mardi)، أسماء الشهور (mars)، أسماء اللغات (l'arabe, le français)، والصفات المشتقة من الدول (la cuisine marocaine)."],"ex":[{"fr":"Je parle français le mardi.","ar":"أتحدث الفرنسية يوم الثلاثاء. (كلاهما بحرف صغير)"},{"fr":"Les Égyptiens aiment l'histoire.","ar":"المصريون كشعب بحرف كبير (Les Égyptiens)."}]}],"mistakes":[{"wrong":"كتابة أيام الأسبوع والشهور بحرف كبير مثل: Lundi أو Janvier","right":"lundi, janvier (بحرف صغير دائماً)","why":"في الفرنسية الشهور والأيام أسماء عامة لا تأخذ حرفاً كبيراً خلافاً للإنجليزية."},{"wrong":"قول 'at' لنطق رمز البريد الإلكتروني @ بدلاً من arobase","right":"arobase [a.ʁɔ.baz]","why":"المصطلح الرسمي المعتمد في جميع الدول الفرنكوفونية هو arobase."},{"wrong":"كتابة اسم اللغة بحرف كبير مثل: J'apprends le Français","right":"J'apprends le français (بحرف صغير)","why":"أسماء اللغات تُعد أسماء شائعة وتُكتب دائماً بحرف صغير."}],"dialogues":[{"title":"تسجيل البريد الإلكتروني ورقم الهاتف","ctx":"حوار بين موظف الاستقبال وطالب يطلب فيه الموظف بريده الإلكتروني لتدوينه في النظام.","lines":[{"who":"La secrétaire","fr":"Pouvez-vous me donner votre adresse courriel ?","ar":"هل يمكنك إعطائي عنوان بريدك الإلكتروني؟"},{"who":"L'étudiant","fr":"Bien sûr : c'est karim.benali@outlook.fr.","ar":"بالتأكيد: هو karim نقطة benali أروباز outlook نقطة fr."},{"who":"La secrétaire","fr":"karim point benali arobase outlook point fr, c'est bien cela ?","ar":"karim نقطة benali أروباز outlook نقطة fr، هل هذا صحيح؟"},{"who":"L'étudiant","fr":"Oui, exactement, tout est en minuscules sans espace.","ar":"نعم، بالضبط، كل شيء بحروف صغيرة بدون مسافات."},{"who":"La secrétaire","fr":"Très bien, votre dossier est maintenant complet.","ar":"ممتاز جداً، ملفك أصبح مكتملاً الآن."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"كيف يُنطق الرمز '@' في عناوين البريد الإلكتروني بالفرنسية؟","opts":["at","arobase","point","tiret"],"a":1,"why":"الرمز @ يسمى رسمياً ويُنطق 'arobase'."},{"t":"mcq","skill":"grammar","q":"أي من الجمل التالية كُتبت بحروف كبيرة وصغيرة وفق القواعد الفرنسية الصحيحة؟","opts":["J'apprends le Français le Lundi.","J'apprends le français le lundi.","J'Apprends Le Français Le Lundi.","j'apprends le français le Lundi."],"a":1,"why":"اللغات والأيام تبدأ دائماً بحروف صغيرة (minuscules) في الفرنسية."},{"t":"fill","skill":"vocabulary","q":"أكمل قراءة العنوان: 'contact@paris.fr' يُقرأ: contact ___ paris point fr.","fr":"contact ___ paris point fr.","ans":"arobase","why":"الرمز بين contact و paris هو @ ويسمى arobase."},{"t":"order","skill":"grammar","q":"رتّب عبارة الطلب الإداري النموذجية:","words":["Veuillez","épeler","votre","prénom,","s'il","vous","plaît."],"why":"الصيغة الإدارية المهذبة: Veuillez + مصدر الفعل + المفعول + s'il vous plaît.","ans":"Veuillez épeler votre prénom, s'il vous plaît."},{"t":"listen","skill":"listening","audio":"Mon adresse est rami point nassar arobase gmail point com","q":"استمع واكتب العنوان الإلكتروني المسموع بالرموز الصحيحة:","opts":["rami.nassar@gmail.com","rami-nassar@gmail.com","rami_nassar@gmail.fr","raminassar@gmail.com"],"a":0,"why":"point تعني نقطة و arobase تعني @."},{"t":"correct","skill":"grammar","q":"صحح خطأ الحروف الكبيرة في الجملة: 'Nous arrivons à Paris en Juillet.'","fr":"Nous arrivons à Paris en Juillet.","ans":"Nous arrivons à Paris en juillet.","why":"اسم الشهر 'juillet' يكتب بحرف صغير في الفرنسية."},{"t":"writing","skill":"writing","q":"اكتب جملة توضح فيها عنوان بريدك الإلكتروني بالفرنسية مستخدماً الكلمات المساعدة:","min":4,"kw":["adresse","courriel","arobase"],"sample":"Mon adresse courriel contient une arobase et un point.","why":"تدريب على توظيف مصطلحات البريد الإلكتروني في جملة تامة."},{"t":"speaking","skill":"pronunciation","q":"اقرأ بصوت عالٍ التهجئة التالية لمصطلحي الترقيم الأساسيين:","target":"arobase, point, tiret","why":"ضبط النطق الصوتي الدقيق للمصطلحات الإدارية."}],"homework":"اكتب فقرة قصيرة من ثلاثة أسطر تتضمن: اسمك الكامل، اسم مدينتك وبلدك، عنوان بريدك الإلكتروني، واليوم الذي بدأت فيه تعلم الفرنسية، مع التأكد التام من تطبيق قواعد الحروف الكبيرة (Majuscules) والصغيرة دون أي خطأ. قبل الدرس التالي (a0-t2-l1): تأكّد من إملاء فقرتك السابقة دون أي خطأ في الحروف الكبيرة، ثم استمع إلى نطق حروف العلة الستة (A, E, I, O, U, Y) استعداداً لوحدة الحركات الفموية.","supplements":[{"id":"HthdHu_5lO8","title":"La phrase et la ponctuation","channel":"Eveiller mon enfant","why":"عرض مبسّط لعلامات الترقيم داخل الجملة الفرنسية (النقطة، الفاصلة، علامة الاستفهام) يكمل قسم الترقيم في هذا الدرس.","dur":6,"lang":"fr"},{"id":"j1XHJx3nxKw","title":"🇫🇷 QUAND mettre une MAJUSCULE ou une MINUSCULE à la NATIONALITÉ ? - GRAMMAIRE en FRANÇAIS FACILE","channel":"Ensemble, le français devient facile","why":"يتعمق في أدق قواعد الدرس: متى يُكتب اسم الجنسية بحرف كبير (Les Français) ومتى يبقى صفة بحرف صغير (un passeport français).","dur":4,"lang":"fr"}],"sources":[{"title":"Comment épeler son nom en français - Alphabet et dialogue (Niveau débutant A1)","channel":"Francisation - FLE","why":"تدريب عملي موجز على تهجئة الاسم والتعارف في حوار مصغّر للمبتدئين.","videoId":"6SblBSZ7YPg"},{"title":"La phrase et la ponctuation","channel":"Eveiller mon enfant","why":"عرض مبسّط لعلامات الترقيم داخل الجملة الفرنسية (النقطة، الفاصلة، علامة الاستفهام) يكمل قسم الترقيم في هذا الدرس.","videoId":"HthdHu_5lO8"},{"title":"🇫🇷 QUAND mettre une MAJUSCULE ou une MINUSCULE à la NATIONALITÉ ? - GRAMMAIRE en FRANÇAIS FACILE","channel":"Ensemble, le français devient facile","why":"يتعمق في أدق قواعد الدرس: متى يُكتب اسم الجنسية بحرف كبير (Les Français) ومتى يبقى صفة بحرف صغير (un passeport français).","videoId":"j1XHJx3nxKw"}]}]},{"id":"a0-t2","slug":"la-prononciation","icon":"headphones","color":"#0F766E","fr":"La prononciation et la phonétique","ar":"الأصوات والنظام الصوتي الفرنسي","desc":"الدراسة الفونولوجية التأسيسية: تشريح حركات العلة الفموية ومثلث النطق، أسرار الأصوات الأنفية وقوانين تعطيل التأنيف، والتراكيب الصوتية المركبة وظاهرة الربط الصوتي (La Liaison).","lessons":[{"id":"A0-t2-l1","fr":"Les voyelles orales et la mécanique articulatoire","ar":"الحركات الفموية وتشريح مخارج الحروف","objectives":["فهم المثلث الصوتي للحركات الفرنسية الفموية (Le triangle vocalique) بناءً على موضع اللسان واستدارة الشفاه.","إتقان النطق العلمي لصوت [y] (حرف U) والتفريق الحاسم بينه وبين [u] (OU) و [i].","التمييز الصوتي الأكاديمي بين الحركة المغلقة [e] والحركة المفتوحة [ɛ].","تطبيق قاعدة الحروف الساكنة الصامتة في أواخر الكلمات وقاعدة الاستثناء CaReFuL.","التدريب على تفكيك الكلمات إلى مقاطع صوتية متساوية الإيقاع (Syllabes ouvertes et fermées)."],"sections":[{"h":"المثلث الصوتي: كيف تُنتج الحركات الفموية الفرنسية علمياً؟","p":["في علم الصوتيات اللغوي (La phonétique articulatoire)، تُصنف الحركات الفموية وفق ثلاثة محاور تشريحية دقيقة: موضع اللسان أفقياً (أمامي antérieur أو خلفي postérieur)، وارتفاع اللسان رأسياً نحو الحنك (مغلق fermé، نصف مغلق mi-fermé، مفتوح ouvert)، وشكل الشفتين (مدورتا الشفاه arrondi أو غير مدورتين non arrondi).","بينما تكتفي اللغة العربية بثلاث حركات رئيسية (الفتحة والضمة والكسرة بنوعيها القصير والطويل)، تمتلك الفرنسية المعيارية 12 حركة فموية نقية، مما يجعل الدقة في حركة الفك والشفاه شرطاً لازماً للفهم.","المحور الصوتي الأمامي يضم: [i] (أقصى الارتفاع الأمامي بدون استدارة الشفاه: si, lit) ← [e] (أقل ارتفاعاً: été, nez) ← [ɛ] (مفتوح: mère, fête) ← [a] (مفتوح منبسط: ami, papa).","المحور الصوتي الخلفي يضم: [u] (أقصى الارتفاع الخلفي مع استدارة قوية للشفاه، ويكتب دائماً بتركيب OU: tout, doux) ← [o] (مغلق مدور: auto, mot) ← [ɔ] (مفتوح مدور: porte, bol) ← [ɑ] (مفتوح خلفي عريض: pâte)."],"video":{"id":"vTnEjzFBkZ0","title":"Alphabet phonétique français pour apprendre les voyelles orales","channel":"Master Your French","why":"تصنيف مرئي للحركات الفموية الفرنسية وفق موضع اللسان والشفاه مع تدريب مباشر على النطق.","dur":7,"lang":"fr","main":true},"sub":[{"h":"المعضلة الكبرى: التمييز الصوتي بين [y] و [u] و [i]","p":["صوت [y] (المكتوب بحرف U) يمثل نقطة التقاء فريدة: اللسان في وضع صوت الكسرة [i] تماماً (ملامس للأسنان السفلية)، لكن الشفتين في وضع الضمة الشديدة المستديرة [u].","المقارنة الثلاثية الشهيرة التي يعتمدها علماء الصوتيات:","1. [i] كما في كلمة «lit» (سرير) و «vie» (حياة) — الشفتان منفرجتان أفقياً.","2. [y] كما في كلمة «lu» (قرأ) و «vu» (رأى) و «tu» (أنت) — اللسان أمامي والشفتان مزمومتان كأنك تصفر.","3. [u] كما في كلمة «loup» (ذئب) و «vous» (أنتم) و «tout» (كل) — اللسان راجع للخلف والشفتان مزمومتان.","الخلط بين [y] و [u] يؤدي إلى سوء فهم دلالي خطير: «Tu as vu ?» (هل رأيت؟) مقابل «Tout a bu ?» (هل شرب الجميع؟)، و «Je suis sûr» (أنا متأكد) مقابل «Je suis sourd» (أنا أصم)!"]},{"h":"قاعدة الصوامت الختامية واستثناء CaReFuL","p":["القاعدة الفونولوجية العامة في الفرنسية هي إسقاط نطق الصامت الأخير للكلمة: un chat [ʃa] (قط)، un lit [li] (سرير)، grand [ɡʁɑ̃] (كبير)، trop [tʁo] (كثير جداً).","لضبط الاستثناء بسهولة، صاغ علماء اللسانيات كلمة التذكر «CaReFuL» (C, R, F, L)؛ فهذه الحروف الأربعة تنطق في الغالبية الساحقة من الكلمات المفردة إذا جاءت في النهاية: un sac [sak], la mer [mɛʁ], un chef [ʃɛf], le fil [fil].","انتبه لاستثناء حرف R: في الأفعال المنتهية بـ -er (المجموعة الأولى)، حرف R صامت دائماً ويتحول المقطع كاملاً إلى [e] مغلق: parler [paʁ.le], manger [mɑ̃.ʒe]."]}]},{"h":"المقاطع الصوتية المفتوحة والمغلقة (Syllabes ouvertes et fermées)","p":["تفضل اللغة الفرنسية بنية المقطع الصوتي المفتوح (Syllabe ouverte)، وهو المقطع الذي ينتهي بحركة صوتية وليس بصامت، مثل: me-rci, cho-co-lat. يمثل هذا النمط أكثر من 75% من المقاطع في الكلام المتصل، وهو ما يمنح اللغة طابعها السلس المتدفق خفيف الوقوف.","عندما ينتهي المقطع بصامت منطوق يسمى مقطعاً مغلقاً (Syllabe fermée)، مثل: par-tir, sec-teur."]},{"h":"التطبيق والتلخيص","p":["تلخّص هذه الخلاصة المثلث الصوتي للحركات الفموية الفرنسية بمحاوره الثلاثة (موضع اللسان أفقياً، وارتفاعه رأسياً، واستدارة الشفاه)، كما تلخّص التحدي الأبرز للناطق بالعربية وهو التمييز الثلاثي بين [y] و [u] و [i]، مع قاعدة الصامت النهائي واستثناء CaReFuL وبنية المقاطع المفتوحة والمغلقة. كما وضح الفيديو الرئيسي «Alphabet phonétique français pour apprendre les voyelles orales» من قناة Master Your French، تُصنَّف الحركات وفق موضعها في الفم ثم يُطلب من المتعلم ملاحظة حركات شفاهه وموضع لسانه وهو يردّد كل صوت وحده؛ وهذا التمرين التشريحي لا اكتمال له دون مراقبة ذاتية أمام المرآة.","يبدأ هذا الدرس وحدة الأصوات a0-t2 بعد أن أغلق a0-t1-l3 وحدة الحروف بمهارات التهجئة وعلامات الترقيم والحروف الكبيرة، فيستثمر الطالب ما كتبه هناك حين يعيد إنتاج الحروف نفسها فونيمات فموية بمخارجها الدقيقة؛ فالمقطع الصوتي الذي تعلّم بناءه كتابةً يُنطق الآن تشريحياً. وبعد هذا الدرس يتقدم الطالب إلى a0-t2-l2 الذي يضيف فوق الحركات الفموية طبقة الرنين الأنفي (Les voyelles nasales)، فيصبح قادراً على التمييز بين bon المنتهية برنين أنفي و bonne المنتهية بنون لسانية صريحة.","أعد مشاهدة الفيديو الرئيسي أمام مرآتك، وتوقّف عند كل لوحة حركات لتقلّد وضع الفك والشفاه كما يفعل المدرس، ثم سجّل تدرّجاً صوتياً متصلاً [i] ← [y] ← [u] ثلاث مرات، وأخيراً انطق جملتي «Tu as lu ce livre ?» و «Vous avez tout compris ?» وسجّلهما، ثم استمع إلى تسجيلك وضع علامة على كل كلمة انطقت فيها الحركة الخاطئة قبل أن تعيد التسجيل."]}],"examples":[{"fr":"Tu as lu ce livre ?","ar":"هل قرأت هذا الكتاب؟","note":"صوت [y] مكرر في Tu و lu"},{"fr":"Vous avez tout compris ?","ar":"هل فهمتم كل شيء؟","note":"صوت [u] مكرر في Vous و tout"},{"fr":"Le chat dort sur le lit.","ar":"القط ينام على السرير.","note":"الصوامت t في chat و lit صامتة نهائياً"},{"fr":"Le chef prépare le sac.","ar":"رئيس العمل يُجهّز الحقيبة.","note":"حرفا f في chef و c في sac ينطقان وفق قاعدة CaReFuL"},{"fr":"Je vais écouter et parler.","ar":"سوف أستمع وأتحدث.","note":"نهاية -er تنطق [e] وصامت R يسقط"},{"fr":"La mer est très belle.","ar":"البحر جميل جداً.","note":"حرف R ينطق في mer لأنه اسم وليس فعل -er"},{"fr":"C'est une minute difficile.","ar":"إنها دقيقة صعبة.","note":"تتابع حركات [y] و [i]"},{"fr":"Il fait chaud en été.","ar":"الجو دافئ في الصيف.","note":"d و t صامتان في fait و chaud"}],"pron":[{"w":"tu","ipa":"[ty]","approx":"تي (بضم الشفتين)","note":"صوت [y] نقي"},{"w":"tout","ipa":"[tu]","approx":"توو","note":"صوت [u] مثل الواو العربية"},{"w":"lit","ipa":"[li]","approx":"لي","note":"صوت [i] مع صموت حرف T"},{"w":"chat","ipa":"[ʃa]","approx":"شا","note":"صموت حرف T الأخير"},{"w":"sac","ipa":"[sak]","approx":"ساك","note":"نطق C كـ [k] كاستثناء CaReFuL"},{"w":"parler","ipa":"[paʁ.le]","approx":"باغليه","note":"نهاية -er تصبح [e] مغلق"}],"vocab":[{"fr":"la voyelle orale","ar":"الحركة الفموية النقية","pos":"nom","g":"f","pl":"les voyelles orales","ipa":"[la vwa.jɛl ɔ.ʁal]","exFr":"Le [a] est une voyelle orale.","exAr":"[a] حركة فموية ناتجة عبر الفم فقط."},{"fr":"la bouche","ar":"الفم","pos":"nom","g":"f","pl":"les bouches","ipa":"[la buʃ]","exFr":"Ouvrez la bouche pour prononcer [a].","exAr":"افتحوا الفم لنطق [a]."},{"fr":"les lèvres","ar":"الشفتان","pos":"nom","g":"f","pl":"les lèvres","ipa":"[le lɛvʁ]","exFr":"Arrondissez les lèvres pour le son [y].","exAr":"دوروا الشفتين لنطق صوت [y]."},{"fr":"la langue","ar":"اللسان / اللغة","pos":"nom","g":"f","pl":"les langues","ipa":"[la lɑ̃ɡ]","exFr":"La langue touche les dents.","exAr":"اللسان يلامس الأسنان."},{"fr":"le chat","ar":"القط","pos":"nom","g":"m","pl":"les chats","ipa":"[lə ʃa]","exFr":"Le chat est petit.","exAr":"القط صغير."},{"fr":"le lit","ar":"السرير","pos":"nom","g":"m","pl":"les lits","ipa":"[lə li]","exFr":"Le lit est confortable.","exAr":"السرير مريح."},{"fr":"le sac","ar":"الحقيبة / الكيس","pos":"nom","g":"m","pl":"les sacs","ipa":"[lə sak]","exFr":"C'est mon sac.","exAr":"هذه حقيبتي."},{"fr":"la mer","ar":"البحر","pos":"nom","g":"f","pl":"les mers","ipa":"[la mɛʁ]","exFr":"Nous allons à la mer.","exAr":"نحن ذاهبون إلى البحر."},{"fr":"le chef","ar":"الرئيس / الطاهي","pos":"nom","g":"m","pl":"les chefs","ipa":"[lə ʃɛf]","exFr":"Le chef donne des ordres.","exAr":"الرئيس يصدر التعليمات."},{"fr":"écouter","ar":"يستمع","pos":"verbe","ipa":"[e.ku.te]","exFr":"Écoutez attentivement.","exAr":"استمعوا باهتمام."},{"fr":"parler","ar":"يتكلم / يتحدث","pos":"verbe","ipa":"[paʁ.le]","exFr":"Je parle français.","exAr":"أنا أتحدث الفرنسية."},{"fr":"manger","ar":"يأكل","pos":"verbe","ipa":"[mɑ̃.ʒe]","exFr":"Il aime manger du pain.","exAr":"هو يحب أكل الخبز."},{"fr":"tu","ar":"أنتَ / أنتِ (ضمير مخاطب ودي)","pos":"pronom","ipa":"[ty]","exFr":"Tu es prêt ?","exAr":"هل أنت جاهز؟"},{"fr":"vous","ar":"أنتم / حضرتكم (ضمير رسمي أو جمع)","pos":"pronom","ipa":"[vu]","exFr":"Vous parlez français ?","exAr":"هل تتحدثون الفرنسية؟"},{"fr":"sûr","ar":"متأكد / يقيني","pos":"adj","g":"m","pl":"sûrs","ipa":"[syʁ]","exFr":"Je suis sûr de ma réponse.","exAr":"أنا متأكد من إجابتي."}],"grammar":[{"tAr":"قاعدة إسقاط الصامت النهائي (L'amuïssement consonantique final)","tFr":"La règle générale des consonnes finales muettes","body":["في النظام الإملائي الفرنسي التاريخي، كُتبت حروف كثيرة تعكس الأصل اللاتيني لكنها سقطت من النطق الصوتي الحي عبر القرون.","الصوامت: D, P, S, T, X, Z في نهاية الكلمات لا تنطق غالباً: pied [pje] (قدم)، drap [dʁa] (ملاءة)، temps [tɑ̃] (وقت)، petit [pə.ti] (صغير)، nez [ne] (أنف).","علامة الجمع S صامتة دائماً في أواخر الأسماء والصفات: un livre [livʁ] مقابل des livres [livʁ] (النطق متطابق تماماً!)."],"ex":[{"fr":"un enfant [ɑ̃.fɑ̃]","ar":"طفل (حرفا n و t في النهاية صامتان كصوامت مستقلة)"},{"fr":"des enfants [de.z‿ɑ̃.fɑ̃]","ar":"أطفال (s الجمع صامتة بمفردها ولكنها ترتبط بالصوتي التالي)"}]}],"mistakes":[{"wrong":"نطق حرف T في كلمة petit أو S في كلمة paris","right":"petit = [pə.ti], Paris = [pa.ʁi]","why":"الحروف الساكنة d, t, s, p في نهاية الكلمات صامتة كقاعدة عامة."},{"wrong":"نطق tu مثل vous (كلاهما كصوت الواو العربي)","right":"tu = [ty] بضم الشفتين واللسان للأمام، vous = [vu] كصوت الواو","why":"الفارق الصوتي جوهري لتمييز الضمائر والأفعال."},{"wrong":"نطق حرف R في مصدر أفعال المجموعة الأولى مثل parler","right":"parler = [paʁ.le] تماماً مثل parlé","why":"نهاية المصدر -er تلغي نطق الراء وتحوله لحركة [e] مغلقة."}],"dialogues":[{"title":"في مختبر الصوتيات اللغوية","ctx":"حوار بين أخصائي النطق وطالب عربي يتدرب على نطق حرف U وتمييزه عن OU.","lines":[{"who":"L'enseignant","fr":"Prononcez après moi : « tu » puis « tout ».","ar":"انطق بعدي: 'tu' ثم 'tout'."},{"who":"L'étudiant","fr":"Tu... tout. Est-ce que la différence s'entend bien ?","ar":"Tu... tout. هل يظهر الفرق بوضوح؟"},{"who":"L'enseignant","fr":"Parfait ! Pour « tu », vos lèvres étaient bien projetées en avant.","ar":"ممتاز! في 'tu'، كانت شفتاك مزمومتين للأمام بدقة."},{"who":"L'étudiant","fr":"Et pour le mot « chat », je ne prononce surtout pas le T final ?","ar":"وبالنسبة لكلمة 'chat'، لا أنطق حرف T الأخير مطلقاً؟"},{"who":"L'enseignant","fr":"Exactement : [ʃa] tout court. La consonne finale dort !","ar":"بالضبط: [ʃa] باقتضاب. الحرف الساكن الأخير نائم!"}]}],"exercises":[{"t":"mcq","skill":"pronunciation","q":"ما هو الرمز الصوتي الدولي الصحيح لصوت حرف U في كلمة 'tu'؟","opts":["[u]","[y]","[i]","[o]"],"a":1,"why":"الرمز الدولي لصوت U الفرنسي هو [y]، بينما [u] يرمز لتركيب OU."},{"t":"mcq","skill":"reading","q":"أي من الكلمات التالية يُنطق فيها الحرف الساكن الأخير وفق قاعدة CaReFuL؟","opts":["lit","chat","sac","trop"],"a":2,"why":"حرف C في sac من حروف CaReFuL وينطق [k]، بينما t في lit وchat و p في trop صامتة."},{"t":"fill","skill":"pronunciation","q":"أكمل: في الفعل 'parler'، الحرف الأخير R ___ ولا يُنطق.","fr":"Dans le verbe parler, la lettre R est ____.","ans":"muette","alts":["muet","صامت"],"why":"نهاية أفعال -er تنطق [e] ويسقط نطق الراء تماماً."},{"t":"order","skill":"grammar","q":"رتّب كلمات الجملة التالية التي تصف قاعدة النطق:","words":["La","consonne","finale","est","souvent","muette."],"why":"الترتيب النحوي: مبتدأ موصوف + فعل كينونة + ظرف + خبر صفة.","ans":"La consonne finale est souvent muette."},{"t":"listen","skill":"listening","audio":"Tu as tout compris ?","q":"استمع إلى الجملة وحدد الكلمتين اللتين تضمنتا التقابل الصوتي بين [y] و [u]:","opts":["tu و tout","as و compris","tu و as","tout و compris"],"a":0,"why":"tu تحتوي على [y] و tout تحتوي على [u]."},{"t":"correct","skill":"pronunciation","q":"هل ينطق حرف T في كلمة 'petit garçon' كصوت تاء؟","fr":"Non, le T de petit est muet.","ans":"Non, le T de petit est muet.","why":"الحرف الساكن الأخير T صامت دائماً أمام الصامت."},{"t":"writing","skill":"writing","q":"اكتب جملة بسيطة تؤكد فيها بالفرنسية أنك تتحدث الفرنسية مستخدماً الفعل parler والضمير Je:","min":3,"kw":["je","parle","français"],"sample":"Je parle français.","why":"تطبيق فعلي للجملة التأسيسية التي توظف الفعل في صيغة المتكلم."},{"t":"speaking","skill":"pronunciation","q":"تدرّب على النطق المتقابل بدقة بين الكلمتين التاليتين:","target":"tu, vous","why":"التمييز بين [ty] و [vu]."}],"homework":"سجّل 5 أزواج من الكلمات الصوتية المتطابقة عدا حركة العلة: (tu / tout), (vu / vous), (su / sous), (lu / loup), (sur / sourd). استمع لتسجيلك وقارن بين حركة الشفتين وموضع اللسان في كل زوج. قبل الدرس التالي (a0-t2-l2): أعد الاستماع إلى التسجيل الذي سجّلته للتمرين الثلاثي [i] ← [y] ← [u] وصحّح ما فيه من انحراف، ثم راجع قاعدة الصامت النهائي واستثناء CaReFuL قبل دخول الأصوات الأنفية.","supplements":[{"id":"zlmL5eQiBHY","title":"Prononcer le français - exercices E (fermé) / U","channel":"France Emoa - Parlez comme un français","why":"تمارين نطق موجّهة على الفارق بين الحركة المغلقة [e] وصوت [y]، وهو جوهر المعضلة التشريحية التي يركز عليها هذا الدرس.","dur":5,"lang":"fr"},{"id":"tvQQ_-fY-XE","title":"Les 16 VOYELLES du français !","channel":"French School TV","why":"خريطة كاملة للحركات الفرنسية الست عشرة تعرض مواضعها في الفم في جدول واحد، فتمنح المتعلم الصورة الإجمالية للمثلث الصوتي.","dur":12,"lang":"fr"}],"sources":[{"title":"Alphabet phonétique français pour apprendre les voyelles orales","channel":"Master Your French","why":"شرح بصري لمخارج الحركات الفموية وترتيبها داخل الفم مع تدريب على المحاكاة.","videoId":"vTnEjzFBkZ0"},{"title":"Prononcer le français - exercices E (fermé) / U","channel":"France Emoa - Parlez comme un français","why":"تمارين نطق موجّهة على الفارق بين الحركة المغلقة [e] وصوت [y]، وهو جوهر المعضلة التشريحية التي يركز عليها هذا الدرس.","videoId":"zlmL5eQiBHY"},{"title":"Les 16 VOYELLES du français !","channel":"French School TV","why":"خريطة كاملة للحركات الفرنسية الست عشرة تعرض مواضعها في الفم في جدول واحد، فتمنح المتعلم الصورة الإجمالية للمثلث الصوتي.","videoId":"tvQQ_-fY-XE"}]},{"id":"A0-t2-l2","fr":"Les voyelles nasales et la résonance phonétique","ar":"الأصوات الأنفية: سر الرنين الصوتي الفرنسي","objectives":["فهم الآلية الفسيولوجية لإنتاج الأصوات الأنفية (Les voyelles nasales) عبر خفض شراع الحنك الرخو.","التمييز الصوتي الدقيق بين الأصوات الأنفية الأساسية الثلاثة (/ɑ̃/ an/en، /ɔ̃/ on، /ɛ̃/ in/ain).","تطبيق القاعدة الفونولوجية الصارمة لتعطيل التأنيف (Dénasalisation) عند مجيء حركة صوتية تالية.","التمييز بين المذكر المؤنف والمؤنث الفموي في الصفات (bon / bonne, plein / pleine).","قراءة جمل ونصوص بسيطة تشتمل على رنين أنفي أصيل دون نطق حرف النون الصريح."],"sections":[{"h":"ما هي الأصوات الأنفية وكيف تتشكل لغوياً؟","p":["تعتبر الأصوات الأنفية (Les voyelles nasales) البصمة الصوتية الأكثر شهرة في اللغة الفرنسية. على عكس اللغات التي تكتفي بالأصوات الفموية، تستخدم الفرنسية تجويف الأنف كمرنان صوتي متكامل.","الآلية الفسيولوجية: أثناء النطق، يهبط شراع الحنك الرخو (Le voile du palais) في مؤخرة الفم جزئياً، مما يسمح للهواء الصاعد من الرئتين بالخروج متزامناً عبر الفم والأنف معاً في اللحظة ذاتها. والنتيجة هي رنين أنفي نقي (Résonance nasale) دون أن يُنطق حرف N أو M كصامت مستقل إطلاقاً!","خطأ المبتدئ الشائع: نطق حركة عادية يليها حرف نون صريح (مثل نطق bon كـ 'بون' بنون واضحة). النطق الأكاديمي الصحيح هو إنتاج حركة واحدة منغمة يتردد صداها في الأنف، مع بقاء اللسان مسترخياً في قاع الفم دون أن يلمس سقف الحلق أو الأسنان إطلاقاً."],"video":{"id":"Cr7zrFrdvMc","title":"LES VOYELLES NASALES | Prononciation française","channel":"Français avec Pierre","why":"تفكيك متسلسل للأصوات الأنفية الثلاثة مع نصائح صريحة لمنع نطق النون الصريحة.","dur":11,"lang":"fr","main":true},"sub":[{"h":"الأصوات الأنفية الثلاثة الكبرى في الفرنسية المعيارية","p":["1. الصوت الأنفي المفتوح /ɑ̃/ (an, am, en, em): يُنتج بفتح الفم عمودياً بارتخاء واستدارة طفيفة للشفاه. الحروف: maman, enfant, vent, temps, France.","2. الصوت الأنفي الدائري المغلق /ɔ̃/ (on, om): يُنتج بضم الشفتين للأمام بإحكام كأنك تنطق ضمة عميقة مستديرة. الحروف: bon, nom, maison, pont, garçon.","3. الصوت الأنفي المنبسط /ɛ̃/ (in, im, ain, aim, ein, un): يُنتج بفتح الفم أفقياً في وضع الابتسامة المفرودة. الحروف: vin, pain, train, main, plein, parfum, un."]},{"h":"قاعدة تعطيل التأنيف الصوتي (La dénasalisation)","p":["متى تفقد الحركة أنفيتها؟ القاعدة الفونولوجية الذهبية تنص على: يفقد الحرف الأنفي (N أو M) صفة التأنيف تماماً، ويتحول إلى حركة فموية عادية يتبعها صامت N/M صريح، في حالتين حاسمتين:","أولاً: إذا جاء بعد حرف N/M حرف صوتي آخر: un bon vin [bɔ̃] (مؤنف) مقابل une bonne soupe [bɔn] (فموي مع نون صريحة).","ثانياً: عند تضاعف حرف N أو M (Double consonne): un an [ɑ̃] مقابل une année [a.ne]، pomme [pɔm]."]}]},{"h":"التطبيقات الدلالية والنحوية للأصوات الأنفية","p":["يلعب التأنيف دوراً جوهرياً في التمييز بين المذكر والمؤنث في الفرنسية:","المذكر ينتهي غالباً بصوت أنفي، بينما المؤنث يعطل التأنيف ويظهر صوت النون بسبب إضافة حرف E التأنيث الصامت في النهاية:","plein [plɛ̃] (ممتلئ - مذكر) مقابل pleine [plɛn] (ممتلئة - مؤنث).","américain [a.me.ʁi.kɛ̃] (أمريكي) مقابل américaine [a.me.ʁi.kɛn] (أمريكية).","ancien [ɑ̃.sjɛ̃] (قديم) مقابل ancienne [ɑ̃.sjɛn] (قديمة)."]},{"h":"التطبيق والتلخيص","p":["تستخلص هذه الخلاصة الآلية الفسيولوجية للأصوات الأنفية الثلاثة (/ɑ̃/، /ɔ̃/، /ɛ̃/) عبر خفض شراع الحنك وخروج الهواء متزامناً عبر الفم والأنف، ثم قاعدة تعطيل التأنيف (Dénasalisation) عند مجيء حرف صوتي تالٍ أو عند تضاعف حرفَي N/M، وأثر ذلك في التمييز بين المذكر والمؤنث كما في bon/bonne و plein/pleine. كما وضح الفيديو الرئيسي «LES VOYELLES NASALES | Prononciation française» من قناة Français avec Pierre، يُنتَج كل صوت أنفي بوضع محدد للشفاه (فتح لـ /ɑ̃/، وضمّ لـ /ɔ̃/، وابتسامة مفرودة لـ /ɛ̃/)، ويُنصح صراحةً بمنع النطق النوني الصريح في كلمات مثل bon و vin، وهو علاج مباشر للخطأ الشائع لدى الناطقين بالعربية.","تبني هذه الطبقة مباشرة على المثلث الصوتي الفموي الذي أتقنه الطالب في a0-t2-l1؛ فالأصوات الأنفية ليست صيغاً منفصلة بل تعميم (nasalisation) لحركات فموية معروفة يُضاف إليها رنين الأنف وحده، ولذلك يبقى وضع اللسان والشفاه المكتسب هناك هو المرجع الأول. وبعد هذا الدرس ينتقل الطالب إلى a0-t2-l3 الذي يعالج التراكيب الحرفية المركبة (ou, oi, ch, ph, gn) وظاهرة الربط الصوتي (La liaison) القائمة على نطق الصامت الأخير للكلمة الأولى وربطه بالكلمة التالية، فيُستكمل بذلك ملف الصوتيات الأساسي في المستوى A0 قبل الانتقال إلى وحدة التحية a0-t3.","أعد مشاهدة الفيديو الرئيسي وأوقفه عند كل نموذج نطق، ثم سجّل نفسك وأنت تردّد ثلاث جمل متتابعة: «Mon enfant va en France.» ثم «C'est un bon vin blanc.» ثم «Il a une bonne idée.»، وبعد التسجيل استمع إليه وضع علامة على كل مقطع أنفي سمعته وعلى كل نون لسانية صريحة، ثم قارن تصنيفك بالتصحيح الظاهر في الفيديو وأعد التسجيل إن اختلف."]}],"examples":[{"fr":"Mon enfant va en France.","ar":"طفلي يذهب إلى فرنسا.","note":"ثلاثة أصوات أنفية مختلفة: /ɔ̃/ في mon، و /ɑ̃/ في enfant و en و France"},{"fr":"C'est un bon vin blanc.","ar":"هذا نبيذ أبيض جيد.","note":"تتابع الأصوات الأنفية: /œ̃/ في un، /ɔ̃/ في bon، /ɛ̃/ في vin، /ɑ̃/ في blanc"},{"fr":"Il a une bonne idée.","ar":"لديه فكرة جيدة.","note":"تعطيل التأنيف في bonne [bɔn] بسبب الحرف الصوتي التالي"},{"fr":"Le pain est sur la table.","ar":"الخبز على الطاولة.","note":"pain تنطق [pɛ̃] بصوت أنفي منبسط"},{"fr":"Bonjour, quel est votre prénom ?","ar":"صباح الخير، ما هو اسمك الأول؟","note":"bon و prénom ينتهيان بالصوت الأنفي /ɔ̃/"},{"fr":"C'est un garçon intelligent.","ar":"إنه ولد ذكي.","note":"تكرار الرنين الأنفي في garçon و intelligent"},{"fr":"Le train arrive à la gare.","ar":"القطار يصل إلى المحطة.","note":"train ينطق [tʁɛ̃]"},{"fr":"Je prends mon temps.","ar":"أنا آخذ وقتي بتأنٍ.","note":"temps ينطق [tɑ̃] وحرفا p و s صامتان نهائياً"}],"pron":[{"w":"enfant","ipa":"[ɑ̃.fɑ̃]","approx":"آنفان (برنين أنفي)","note":"كلا المقطعين بحركة /ɑ̃/ الأنفية"},{"w":"bon","ipa":"[bɔ̃]","approx":"بون (بدون نون صريحة)","note":"شفتان مدورتان للأمام ورنين أنفي"},{"w":"bonne","ipa":"[bɔn]","approx":"بُونْ","note":"حركة فموية عادية تليها نون صريحة"},{"w":"pain","ipa":"[pɛ̃]","approx":"بان (برنين مبتسم)","note":"فم منبسط أفقياً ورنين أنفي"},{"w":"vin","ipa":"[vɛ̃]","approx":"فان (أنفية)","note":"صوت v المجهور يليه /ɛ̃/ الأنفي"},{"w":"maison","ipa":"[mɛ.zɔ̃]","approx":"ميزون (أنفية)","note":"المقطع الثاني /ɔ̃/ أنفي"}],"vocab":[{"fr":"le son nasal","ar":"الصوت الأنفي","pos":"nom","g":"m","pl":"les sons nasals","ipa":"[lə sɔ̃ na.zal]","exFr":"Le français utilise des sons nasals.","exAr":"الفرنسية تستخدم أصواتاً أنفية."},{"fr":"l'enfant","ar":"الطفل / الابن","pos":"nom","g":"m","pl":"les enfants","ipa":"[l‿ɑ̃.fɑ̃]","exFr":"L'enfant apprend à parler.","exAr":"الطفل يتعلم الكلام."},{"fr":"le temps","ar":"الوقت / الطقس","pos":"nom","g":"m","ipa":"[lə tɑ̃]","exFr":"Je n'ai pas le temps.","exAr":"ليس لدي وقت."},{"fr":"le vent","ar":"الريح","pos":"nom","g":"m","pl":"les vents","ipa":"[lə vɑ̃]","exFr":"Le vent souffle fort.","exAr":"الريح تهب بقوة."},{"fr":"bon","ar":"جيد / طيب (مذكر)","pos":"adj","g":"m","pl":"bons","ipa":"[bɔ̃]","exFr":"C'est un bon café.","exAr":"هذه قهوة جيدة."},{"fr":"bonne","ar":"جيدة / طيبة (مؤنث)","pos":"adj","g":"f","pl":"bonnes","ipa":"[bɔn]","exFr":"C'est une bonne nouvelle.","exAr":"هذا خبر جيد."},{"fr":"la maison","ar":"البيت / المنزل","pos":"nom","g":"f","pl":"les maisons","ipa":"[la mɛ.zɔ̃]","exFr":"La maison est grande.","exAr":"المنزل كبير."},{"fr":"le train","ar":"القطار","pos":"nom","g":"m","pl":"les trains","ipa":"[lə tʁɛ̃]","exFr":"Le train part à midi.","exAr":"القطار يغادر ظهراً."},{"fr":"le vin","ar":"العصير المختمر / النبيذ","pos":"nom","g":"m","pl":"les vins","ipa":"[lə vɛ̃]","exFr":"Un verre de vin.","exAr":"كأس عصير."},{"fr":"blanc","ar":"أبيض (مذكر)","pos":"adj","g":"m","pl":"blancs","ipa":"[blɑ̃]","exFr":"Un mur blanc.","exAr":"جدار أبيض."},{"fr":"blanche","ar":"بيضاء (مؤنث)","pos":"adj","g":"f","pl":"blanches","ipa":"[blɑ̃ʃ]","exFr":"Une chemise blanche.","exAr":"قميص أبيض."},{"fr":"le pont","ar":"الجسر","pos":"nom","g":"m","pl":"les ponts","ipa":"[lə pɔ̃]","exFr":"Le pont traverse le fleuve.","exAr":"الجسر يعبر النهر."},{"fr":"le parfum","ar":"العطر / الرائحة","pos":"nom","g":"m","pl":"les parfums","ipa":"[lə paʁ.fɛ̃]","exFr":"Ce parfum sent très bon.","exAr":"هذا العطر ذو رائحة طيبة."},{"fr":"le cousin","ar":"ابن العم / الخال (مذكر)","pos":"nom","g":"m","pl":"les cousins","ipa":"[lə ku.zɛ̃]","exFr":"C'est mon cousin.","exAr":"هذا ابن عمي."},{"fr":"la cousine","ar":"ابنة العم / الخال (مؤنث)","pos":"nom","g":"f","pl":"les cousines","ipa":"[la ku.zin]","exFr":"C'est ma cousine.","exAr":"هذه ابنة عمي."}],"grammar":[{"tAr":"أثر التذكير والتأنيث على الرنين الأنفي","tFr":"L'alternance morpho-phonologique : nasal / oral","body":["في الصفات المنتهية بـ -an, -on, -in, -en, -ain، صيغة المذكر تنتهي دائماً بصوت أنفي خالص: un ami américain [a.me.ʁi.kɛ̃].","عند صياغة المؤنث، تُضاف علامة التأنيث (e) أو تُضاعف النون (ne)، مما يؤدي فونولوجياً إلى تفكيك الصوت الأنفي وتحويله إلى حركة فموية ناصعة تليها نون صريحة: une amie américaine [a.me.ʁi.kɛn]."],"ex":[{"fr":"Il est plein [plɛ̃] / Elle est pleine [plɛn]","ar":"هو ممتلئ (أنفي) / هي ممتلئة (فموي مع نون)"},{"fr":"Un bon plan [bɔ̃] / Une bonne place [bɔn]","ar":"خطة جيدة / مكان جيد"}]}],"mistakes":[{"wrong":"نطق حرف نون صريح كامل في كلمة 'bon' كأنها 'بُونْ'","right":"bon = [bɔ̃] صوت أنفي خالص مع بقاء اللسان مسترخياً","why":"النون لا تنطق منفصلة، بل تشترك مع الحركة في إحداث رنين أنفي موحد."},{"wrong":"نطق 'bonne' برنين أنفي مثل 'bon'","right":"bonne = [bɔn] بنون لسانية واضحة وحركة O فموية عادية","why":"وجود حرف e بعد n يعطل التأنيف تماماً."},{"wrong":"الخلط بين صوت /ɑ̃/ (en/an) وصوت /ɔ̃/ (on)","right":"/ɑ̃/ بفتح الفم مثل blanc، و /ɔ̃/ بضم الشفتين للأمام مثل blond","why":"الخلط يغير المعنى تماماً بين الكلمات المتقاربة."}],"dialogues":[{"title":"في المخبز الباريسي","ctx":"مشتري يطلب خبزاً فرنسياً طازجاً، وتطبيق عملي على الأصوات الأنفية.","lines":[{"who":"Le client","fr":"Bonjour monsieur, un bon pain, s'il vous plaît.","ar":"صباح الخير سيدي، خبز طيب، من فضلك."},{"who":"Le boulanger","fr":"Un pain blanc traditionnel ou un pain complet ?","ar":"خبز أبيض تقليدي أم خبز كامل؟"},{"who":"Le client","fr":"Un pain blanc bien chaud, s'il vous plaît.","ar":"خبز أبيض ساخن جداً، من فضلك."},{"who":"Le boulanger","fr":"Voilà monsieur. Et avec ceci ?","ar":"تفضل سيدي. وهل ترغب في شيء آخر مع هذا؟"},{"who":"Le client","fr":"Ce sera tout, merci. Bonne journée !","ar":"هذا كل شيء، شكراً. أتمنى لك يوماً طيباً!"}]}],"exercises":[{"t":"mcq","skill":"pronunciation","q":"ماذا يحدث للصوت الأنفي في كلمة 'bon' عند تحويلها إلى المؤنث 'bonne'؟","opts":["يبقى الصوت أنفياً كما هو","يتعطل التأنيف ويصبح صوتاً فموياً يليه صوت نون صريح [bɔn]","يتحول إلى صوت تاء","يصبح الصوت صامتاً تماماً"],"a":1,"why":"إضافة ne تعطل التأنيف الصوتي وتحول الحركة إلى فموية نقية تليها نون."},{"t":"mcq","skill":"reading","q":"أي من الكلمات التالية تحتوي على الصوت الأنفي المفتوح /ɑ̃/؟","opts":["maison","France","train","bon"],"a":1,"why":"France تحتوي على an وتُنطق بالصوت الأنفي المفتوح /ɑ̃/."},{"t":"fill","skill":"vocabulary","q":"أكمل: الكلمة التي تعني 'قطار' وتُنطق بصوت أنفي منبسط [tʁɛ̃] هي le ___.","fr":"Le ___ arrive à la gare.","ans":"train","why":"train تحتوي على ain وتلفظ [tʁɛ̃]."},{"t":"order","skill":"grammar","q":"رتّب كلمات الجملة التالية:","words":["Mon","enfant","prend","le","train."],"why":"الترتيب النحوي: فاعل مسبوق بصفة ملكية + فعل + مفعول به معرف.","ans":"Mon enfant prend le train."},{"t":"listen","skill":"listening","audio":"C'est un bon vin blanc","q":"استمع إلى الجملة وحدد كم صوتاً أنفياً ورد فيها:","opts":["صوت واحد","صوتان","ثلاثة أصوات أنفية","أربعة أصوات أنفية"],"a":3,"why":"تضمنت 4 أصوات أنفية: un /œ̃/، bon /ɔ̃/، vin /ɛ̃/، blanc /ɑ̃/."},{"t":"correct","skill":"grammar","q":"هل كلمة 'année' (سنة) تُنطق برنين أنفي؟","fr":"Non, le doublement de N annule la nasalisation.","ans":"Non, le doublement de N annule la nasalisation.","why":"تضاعف حرف النون يمنع التأنيف وتلفظ الكلمة فموياً [a.ne]."},{"t":"writing","skill":"writing","q":"اكتب جملة بسيطة تستخدم فيها كلمتي 'pain' (خبز) و 'bon' (جيد):","min":3,"kw":["pain","bon"],"sample":"C'est un bon pain.","why":"تطبيق جملة بسيطة تضم صوتين أنفيين متباينين: /ɔ̃/ و /ɛ̃/."},{"t":"speaking","skill":"pronunciation","q":"تدرّب على النطق المتقابل بدقة بين المذكر الأنفي والمؤنث الفموي:","target":"bon, bonne","why":"التمييز الدقيق بين [bɔ̃] برنين أنفي و [bɔn] بفم مفتوح ونون صريحة."}],"homework":"استمع إلى نشرة أخبار فرنسية أو مقطع صوتي قصير لمدة دقيقة واحدة، وحاول إحصاء عدد المرات التي تسمع فيها كلمات تنتهي بالرنين الأنفي (مثل: un, bon, non, en, dans, France)، ثم سجّل بصوتك 3 جمل فرنسية قصيرة تضم هذه الكلمات. قبل الدرس التالي (a0-t2-l3 / a0-t3-l1 حسب موقعك): استمع إلى المقطع الصوتي الذي اخترته في الواجب وأعد تسجيل الجمل الثلاث قصيرة برنين أنفي واضح، ثم راجع التراكيب الحرفية المركبة استعداداً لدرس الربط الصوتي.","supplements":[{"id":"O1GgP-SNLvw","title":"⚠️ Prononciation des sons \"AN\", \"EN\", \"IN\", \"ON\", \"UN\" en français | Les voyelles nasales","channel":"Guillaume Posé - Professeur de français","why":"درس أكاديمي مطوّل للأصوات الأنفية الخمسة بتفصيل مخارج كل صوت وتمارين تمييز متدرجة، ويُعدّ أعمق مرجع مرافق لهذا الدرس.","dur":23,"lang":"fr"},{"id":"GX1OsmcJAx8","title":"🇫🇷 Les voyelles nasales - Explications, exemples et exercices ✅","channel":"French School TV","why":"شرح وأمثلة وتمارين تطبيقية على الأصوات الأنفية، تصلح كحصيلة تدريبية مباشرة بعد مشاهدة الفيديو الرئيسي.","dur":14,"lang":"fr"}],"sources":[{"title":"LES VOYELLES NASALES | Prononciation française","channel":"Français avec Pierre","why":"عرض أكاديمي لأصوات الأحرف الأنفية الثلاثة ومخارج إنتاجها وتمارين تمييزها.","videoId":"Cr7zrFrdvMc"},{"title":"⚠️ Prononciation des sons \"AN\", \"EN\", \"IN\", \"ON\", \"UN\" en français | Les voyelles nasales","channel":"Guillaume Posé - Professeur de français","why":"درس أكاديمي مطوّل للأصوات الأنفية الخمسة بتفصيل مخارج كل صوت وتمارين تمييز متدرجة، ويُعدّ أعمق مرجع مرافق لهذا الدرس.","videoId":"O1GgP-SNLvw"},{"title":"🇫🇷 Les voyelles nasales - Explications, exemples et exercices ✅","channel":"French School TV","why":"شرح وأمثلة وتمارين تطبيقية على الأصوات الأنفية، تصلح كحصيلة تدريبية مباشرة بعد مشاهدة الفيديو الرئيسي.","videoId":"GX1OsmcJAx8"}]},{"id":"A0-t2-l3","fr":"Les graphies complexes et la liaison phonétique","ar":"التراكيب الحرفية الصوتية وظاهرة الربط الصوتي (La Liaison)","objectives":["إتقان التراكيب الحرفية الشائعة (ou, oi, ai, eu, au, eau, ch, ph, gn) ونطقها الفونيمي المباشر.","فهم البنية الصوتية لتركيب OI كحركة نصف صامتة تليها حركة فموية [wa].","استيعاب ظاهرة الربط الصوتي (La liaison) وأهميتها في التدفق الموسيقي للغة الفرنسية.","التمييز بين الربط الإلزامي (Liaison obligatoire) والربط الممنوع (Liaison interdite).","تطبيق قواعد الربط عند التقاء أداة التعريف بالجمع (les_amis) وحروف الجر والضمائر."],"sections":[{"h":"التراكيب الحرفية المركبة: عندما يجتمع حرفان لإنتاج صوت واحد","p":["تتميز الكتابة الفرنسية بظاهرة «التراكيب الحرفية» (Les digrammes et trigrammes)؛ حيث يجتمع حرفان أو ثلاثة أحرف كتابية لتمثيل صوت لغوي واحد بسيط. معرفة هذه التراكيب تنقل المتعلم فوراً من التهجئة المتعثرة إلى القراءة الانسيابية.","التراكيب الحركية الكبرى:","• OU يُنطق دائماً كصوت الواو الفموي المضموم [u]: vous, pour, nous, bonjour.","• OI يُنطق كصوت مركب من نصف حركة يتبعها فتح [wa] (مثل 'وا' بالعربية): moi, toi, bonsoir, trois, croissant.","• AI و EI يُنطقان كصوت [ɛ] المفتوح (مثل è): maison [mɛ.zɔ̃], neige [nɛʒ], français [fʁɑ̃.sɛ].","• AU و EAU يُنطقان كصوت [o] المغلق المستدير: auto [o.to], beaucoup [bo.ku], tableau [ta.blo].","• EU و ŒU يُنطقان كحركة أمامية مدورة [ø] أو [œ]: deux [dø], bleu [blø], sœur [sœʁ]."],"video":{"id":"EDgz9uv1c1U","title":"😉✅ La LIAISON en français - Règles et prononciation POUR BIEN PARLER !","channel":"Guillaume Posé - Professeur de français","why":"شرح منهجي لقواعد الربط الصوتي (La liaison) بجميع أنواعها مع نموذج مسموع لكل قاعدة، وهو المرجع الأساسي لفهم الانسياب الفرنسي.","dur":20,"lang":"fr","main":true},"sub":[{"h":"التراكيب الصامتة الخاصة (CH, PH, GN)","p":["• CH يُنطق صوتاً شفوياً احتكاكياً مهموساً كالشين [ʃ]: chocolat, chercher, chambre.","• PH يُنطق دائماً كصوت الفاء [f] (مشتق من الكلمات ذات الأصل اليوناني): photo, téléphone, pharmacie.","• GN يُنطق صوتاً أنفياً غارياً [ɲ] (يشبه نطق النون المتبوعة بياء خفيفة كما في كلمة 'español'): montagne, espagnol, signature."]},{"h":"ظاهرة الربط الصوتي (La liaison): روح الانسياب الفرنسي","p":["الربط الصوتي (La liaison) هو القاعدة الفونولوجية التي تمنح الفرنسية انسيابيتها اللحنية الشهيرة؛ وتتمثل في نطق الحرف الساكن الأخير الصامت للكلمة الأولى وربطه بالحركة الصوتية الأولى للكلمة التالية مباشرة، لتشكيل مقطع صوتي جديد متصل.","تغيرات الأصوات أثناء الربط:","1. الحرفان S و X الصامتان ينطقان كصوت الزاي [z] عند الربط: les amis تُنطق [le.za.mi]، deux enfants تُنطق [dø.zɑ̃.fɑ̃].","2. الحرف D ينطق كصوت التاء [t] عند الربط: un grand homme يُنطق [œ̃.ɡʁɑ̃.tɔm].","3. الحرف N في الكلمات الأحادية ينقل رنينه للكلمة التالية: un ami يُنطق [œ̃.na.mi]، en Espagne يُنطق [ɑ̃.nɛs.paɲ]."]}]},{"h":"الربط الإلزامي مقابل الربط الممنوع (Obligatoire vs Interdit)","p":["ليس كل التقاء صوتي يسمح بالربط؛ بل هناك حدود لسانية صارمة:","الربط الإلزامي (Liaison obligatoire) يحدث حتماً في مواضع تماسك التركيب النحوي: بين أداة التعريف والاسم (les_arbres)، بين الضمير والفاعل والفعل (ils_ont, nous_avons)، وبين الصفة والاسم الذي بعدها (un petit_arbre).","الربط الممنوع (Liaison interdite) يقع حتماً في مواضع الفصل النحوي: بعد أداة العطف «et» (لا يجوز مطلقاً ربط et بالكلمة التالية!)، وبعد الاسم المفرد إلى ما بعده (un chat / intelligent، لا نربط t بالصفة)، وقبل حرف H التنفسي (les / héros)."]},{"h":"التطبيق والتلخيص","p":["يُختم هذا الدرس بمنظومة صوتية متكاملة تصنع الانسياب الفرنسي: التراكيب الحرفية (Les digrammes et trigrammes) من قبيل ou و oi و ai و eu و au/eau و ch و ph و gn التي تُنتج صوتاً فونيمياً واحداً من رموز كتابية متعددة، ثمّ ظاهرة الربط الصوتي (La liaison) التي تنقل الحرف الساكن الصامت من نهاية الكلمة الأولى إلى حركة الكلمة التالية اتّباعاً لقواعد الإلزام والممنوعية. كما وضح الفيديو الرئيسي (La LIAISON en français - Règles et prononciation POUR BIEN PARLER) لقناة Guillaume Posé - Professeur de français، يكتمل إتقان الموضوع حين يحفظ المتعلّم مواضع الربط الإلزامي مثل les_amis و ils_ont، ومواضع المنع بعد أداة العطف et، مع تحوّلات الأصوات ذاتها: [z] لحرفي S و X، و [t] لحرف D، ورنين N في un ami.","يستند هذا الدرس إلى ما وثّقه a0-t2-l2 (الأنفية) من أصوات [ɑ̃] و [ɔ̃] و [ɛ̃]، إذ لا يصحّ الربط الصوتي إلا بنطق أنفي سليم في un ami [œ̃.na.mi] وفي bonsoir، كما يستفيد من مخرجات a0-t2-l1 (الحركات الفموية) عند نطق ai و oi و eu. وبهذا ينتقل المتعلّم إلى a0-t3-l1 (تحيات اليوم والأعراف) ليوظّف هذه التراكيب في أول مدخل تواصلي حقيقي: قراءة Bonjour و Bonsoir بنطق متصل ومخارج صحيحة.","أعد مشاهدة الفيديو الرئيسي (La LIAISON en français) مرتين على الأقل: في المرة الأولى دوّن كل قاعدة يذكرها المدرّس لتمييز الربط الإلزامي عن الممنوع، وفي الثانية أوقف الفيديو عند كل مثال وحاكِ النطق بصوت مسموع، ثمّ سجّل نفسك وأنت تنطق (les amis، un grand homme، deux euros، beaucoup d'eau) وقارن تسجيلك بنطق الفيديو حرفياً."]}],"examples":[{"fr":"Les amis de mon frère sont là.","ar":"أصدقاء أخي هنا.","note":"ربط إلزامي: les amis ينطق [le.za.mi]"},{"fr":"Ils ont trois enfants.","ar":"هم لديهم ثلاثة أطفال.","note":"ربط ils ont [il.zɔ̃] و trois enfants [tʁwa.zɑ̃.fɑ̃]"},{"fr":"C'est un grand ami.","ar":"إنه صديق عظيم.","note":"حرف D يتحول صوتاً إلى [t] عند الربط: [ɡʁɑ̃.ta.mi]"},{"fr":"Un café et un thé, s'il vous plaît.","ar":"قهوة وشاي، من فضلك.","note":"ربط ممنوع منعاً باتاً بعد أداة العطف et"},{"fr":"Le croissant au beurre est chaud.","ar":"الكرواسون بالزبدة ساخن.","note":"تركيب oi [wa] و au [o] و eau [o]"},{"fr":"Elle prend une photo de la montagne.","ar":"هي تلتقط صورة للجبل.","note":"ph تلفظ [f] و gn تلفظ [ɲ]"},{"fr":"Vous avez beaucoup de travail.","ar":"أنتم لديكم الكثير من العمل.","note":"ربط vous avez [vu.za.ve] وتركيب eau [o]"},{"fr":"Nous habitons dans un bel appartement.","ar":"نحن نسكن في شقة جميلة.","note":"ربط nous habitons [nu.za.bi.tɔ̃] مع صموت h"}],"pron":[{"w":"les amis","ipa":"[le.za.mi]","approx":"ليزامي","note":"s تلفظ [z] عند الربط"},{"w":"trois","ipa":"[tʁwa]","approx":"تغوا","note":"تركيب oi يلفظ [wa]"},{"w":"beaucoup","ipa":"[bo.ku]","approx":"بوكو","note":"تركيب eau يلفظ [o] و p الأخيرة صامتة"},{"w":"photo","ipa":"[fo.to]","approx":"فوتو","note":"تركيب ph يلفظ [f]"},{"w":"montagne","ipa":"[mɔ̃.taɲ]","approx":"مونتانيي","note":"تركيب gn يلفظ [ɲ]"},{"w":"chocolat","ipa":"[ʃɔ.kɔ.la]","approx":"شوكولا","note":"تركيب ch يلفظ [ʃ] و t الأخيرة صامتة"}],"vocab":[{"fr":"la liaison","ar":"الربط الصوتي","pos":"nom","g":"f","pl":"les liaisons","ipa":"[la ljɛ.zɔ̃]","exFr":"La liaison adoucit la langue.","exAr":"الربط الصوتي يمنح اللغة عذوبة وسلاسة."},{"fr":"l'ami","ar":"الصديق (مذكر)","pos":"nom","g":"m","pl":"les amis","ipa":"[l‿a.mi]","exFr":"C'est mon ami Sami.","exAr":"هذا صديقي سامي."},{"fr":"l'amie","ar":"الصديقة (مؤنث)","pos":"nom","g":"f","pl":"les amies","ipa":"[l‿a.mi]","exFr":"C'est une amie française.","exAr":"هذه صديقة فرنسية."},{"fr":"le croissant","ar":"خبز الكرواسون الهلالي","pos":"nom","g":"m","pl":"les croissants","ipa":"[lə kʁwa.sɑ̃]","exFr":"Un café et un croissant.","exAr":"قهوة وكرواسون."},{"fr":"beaucoup","ar":"كثيراً / جداً","pos":"adverbe","ipa":"[bo.ku]","exFr":"Merci beaucoup.","exAr":"شكراً جزيلاً."},{"fr":"la photo","ar":"الصورة الفوتوغرافية","pos":"nom","g":"f","pl":"les photos","ipa":"[la fo.to]","exFr":"Regardez cette belle photo.","exAr":"انظروا إلى هذه الصورة الجميلة."},{"fr":"le chocolat","ar":"الشوكولاتة","pos":"nom","g":"m","pl":"les chocolats","ipa":"[lə ʃɔ.kɔ.la]","exFr":"J'aime le chocolat noir.","exAr":"أحب الشوكولاتة الداكنة."},{"fr":"la montagne","ar":"الجبل","pos":"nom","g":"f","pl":"les montagnes","ipa":"[la mɔ̃.taɲ]","exFr":"Nous allons à la montagne.","exAr":"نحن ذاهبون إلى الجبل."},{"fr":"l'oiseau","ar":"الطائر","pos":"nom","g":"m","pl":"les oiseaux","ipa":"[l‿wa.zo]","exFr":"L'oiseau chante dans l'arbre.","exAr":"الطائر يغرد في الشجرة (تركيب oi [wa] و eau [o])."},{"fr":"les arbres","ar":"الأشجار","pos":"nom","g":"m","pl":"les arbres","ipa":"[le.zɑʁbʁ]","exFr":"Les arbres sont verts.","exAr":"الأشجار خضراء (ربط إلزامي: les_arbres بصوت [z])."},{"fr":"le tableau","ar":"اللوحة / السبورة","pos":"nom","g":"m","pl":"les tableaux","ipa":"[lə ta.blo]","exFr":"Regardez le tableau.","exAr":"انظروا إلى السبورة."},{"fr":"l'appartement","ar":"الشقة السكنية","pos":"nom","g":"m","pl":"les appartements","ipa":"[l‿a.paʁ.tə.mɑ̃]","exFr":"Un bel appartement à Paris.","exAr":"شقة جميلة في باريس."},{"fr":"l'eau","ar":"الماء","pos":"nom","g":"f","pl":"les eaux","ipa":"[l‿o]","exFr":"Un verre d'eau, s'il vous plaît.","exAr":"كأس ماء، من فضلك."},{"fr":"la nuit","ar":"الليل","pos":"nom","g":"f","pl":"les nuits","ipa":"[la nɥi]","exFr":"Bonne nuit !","exAr":"تصبح على خير!"},{"fr":"grand","ar":"كبير / طويل القامة","pos":"adj","g":"m","pl":"grands","ipa":"[ɡʁɑ̃]","exFr":"Un grand hôtel.","exAr":"فندق كبير."}],"grammar":[{"tAr":"أحكام الربط الصوتي وقاعدة أداة العطف et","tFr":"La règle fondamentale : Jamais de liaison après 'et'","body":["الربط الصوتي بعد أداة العطف «et» محظور إطلاقاً في جميع مستويات اللغة الفرنسية: لا يجوز القول [e.t‿un]، بل يجب الوقف التام: «un chat et un chien» [œ̃ ʃa e œ̃ ʃjɛ̃].","في المقابل، ضمائر الفاعل المنتهية بـ s (nous, vous, ils, elles) ترتبط وجوباً بالفعل الذي يليها إذا بدأ بحرف صوتي، وتتحول S إلى صوت Z مجهور: ils ont [il.zɔ̃] (هم يملكون) لتفريقها التام عن ils sont [il.sɔ̃] (هم يكونون)!"],"ex":[{"fr":"Ils ont un ami [il.zɔ̃ œ̃.na.mi]","ar":"هم لديهم صديق (ربطان إلزاميان بصوت z و n)"},{"fr":"Un livre et un stylo [œ̃ livʁ e œ̃ sti.lo]","ar":"كتاب وقلم (وقف إلزامي بعد et دون ربط)"}]}],"mistakes":[{"wrong":"ربط حرف T في أداة العطف 'et' مثل: et un تنطق 'إيتان'","right":"et un تُنطق دائماً [e œ̃] بفاصل تام ودون ربط نهائياً","why":"أداة العطف et لا تقبل الربط الصوتي مطلقاً في القواعد الفرنسية."},{"wrong":"نطق 'ils ont' مثل 'ils sont' كصوت سين [s]","right":"ils ont = [il.zɔ̃] بصوت زاي ناتج عن الربط، و ils sont = [il.sɔ̃] بصوت سين","why":"الخلط بينهما يقلب المعنى تماماً بين فعلي 'يملكون' و 'يكونون'!"},{"wrong":"نطق تركيب OI كصوت 'أوي' بدلاً من 'وا' [wa]","right":"trois = [tʁwa], moi = [mwa]","why":"OI يمثل فونولوجياً صوت [wa] دائماً في الفرنسية المعيارية."}],"dialogues":[{"title":"في المقهى وطلب المشروبات","ctx":"حوار بين صديقين ونادل المقهى يبرز التراكيب الصوتية وقواعد الربط العملي.","lines":[{"who":"Le serveur","fr":"Bonjour messieurs, que désirez-vous ?","ar":"صباح الخير سيديّ، ماذا تطلبان؟"},{"who":"Client 1","fr":"Pour moi, un café au lait et un verre d'eau, s'il vous plaît.","ar":"بالنسبة لي، قهوة بالحليب وكأس ماء، من فضلك."},{"who":"Client 2","fr":"Et pour moi, un chocolat chaud avec deux croissants.","ar":"وبالنسبة لي، شوكولاتة ساخنة مع قطعتي كرواسون."},{"who":"Le serveur","fr":"Très bien : deux_croissants bien chauds, c'est noté !","ar":"ممتاز جداً: قطعتان كرواسون ساخنتان، تم التدوين!"},{"who":"Client 1","fr":"Merci beaucoup !","ar":"شكراً جزيلاً!"}]}],"exercises":[{"t":"mcq","skill":"pronunciation","q":"ما هو الصوت الناتج عن اجتماع الحرفين 'OI' في كلمة 'bonsoir'؟","opts":["[wa]","[u]","[o]","[i]"],"a":0,"why":"تركيب OI ينتج صوتاً مركباً هو [wa] دائماً."},{"t":"mcq","skill":"grammar","q":"أي من الحالات التالية يُمنع فيها الربط الصوتي (Liaison interdite) منعاً قاطعاً؟","opts":["بعد ضمائر الفاعل ils و vous","بعد أداة العطف 'et'","بين أدوات التعريف والاسم (les amis)","بعد الصفة القصيرة السابقة للاسم"],"a":1,"why":"أداة العطف 'et' لا تقبل الربط الصوتي إطلاقاً في الفرنسية المعيارية."},{"t":"correct","skill":"pronunciation","q":"صحّح العبارة الصوتية التالية كما نطقها الفيديو الرئيسي: «les amis تُنطق [le.sa.mi]».","fr":"les amis [le.sa.mi]","ans":"les amis [le.za.mi]","why":"حرف S الصامت في أداة التعريف les يتحوّل وجوباً إلى صوت الزاي [z] عند الربط بالحركة التالية."},{"t":"fill","skill":"vocabulary","q":"أكمل الكلمة المركبة بحرفين يعطيان صوت الفاء [f]: une ___oto.","fr":"une ___oto.","ans":"ph","why":"تركيب PH ينتج صوت [f] دائماً."},{"t":"order","skill":"grammar","q":"رتّب عبارة الشكر والامتنان المتداولة:","words":["Merci","beaucoup","pour","votre","aide."],"why":"عبارة الشكر النموذجية: شكر + ظرف كمي + مكمل مجرور.","ans":"Merci beaucoup pour votre aide."},{"t":"listen","skill":"listening","audio":"Ils ont trois amis français.","q":"استمع إلى الجملة: هل المعنى هو 'هم يملكون' أم 'هم يكونون'؟","opts":["هم يملكون (Ils ont بربط صوت الزاي [z])","هم يكونون (Ils sont بصوت السين [s])","هم يذهبون","هم يتحدثون"],"a":0,"why":"صوت [z] في [il.zɔ̃] يدل جزماً على تصريف فعل Avoir (يملكون)."},{"t":"writing","skill":"writing","q":"اكتب جملة بسيطة تطلب فيها 'كأس ماء من فضلك' بالفرنسية مستخدماً un verre d'eau:","min":4,"kw":["verre","eau","plaît"],"sample":"Un verre d'eau, s'il vous plaît.","why":"تطبيق عملي يوظف تركيب eau ومفردة اللباقة الأساسية."},{"t":"speaking","skill":"pronunciation","q":"انطق الجملة التالية مطبقاً الربط الصوتي الصحيح بين les و amis كما استعرضه الفيديو الرئيسي:","target":"les amis","why":"نطق الربط [le.za.mi] بصوت الزاي الصافي."}],"homework":"اقرأ بصوت عالٍ الكلمات التالية وحدد الحروف المركبة ونوع الربط الصوتي في كل منها: (un grand appartement), (beaucoup d'eau), (trois oiseaux), (un bon chocolat). سجّل قراءتك وتأكد من تطبيق قاعدة 'عدم الربط بعد et' في جملة حرة تصيغها بنفسك. قبل الدرس التالي (a0-t3-l1): جهّز جملة ترحيب واحدة لكل فترة من فترات اليوم (Bonjour / Bonsoir) مطبّقاً فيها الربط الصوتي الصحيح الذي درسته اليوم.","sources":[{"title":"😉✅ La LIAISON en français - Règles et prononciation POUR BIEN PARLER !","channel":"Guillaume Posé - Professeur de français","why":"تأسيس شامل يفكك قواعد الربط الصوتي ومواضع الإلزام والمنع وتحوّلات الأصوات.","videoId":"EDgz9uv1c1U"},{"title":"L'enchaînement et la liaison (facultative, obligatoire ou interdite)","channel":"Enseignement du FLE","why":"مقارنة أكاديمية دقيقة بين الانسياب المتصل (enchaînement) والربط الصوتي وتصنيفهما إلى إلزامي واختياري وممنوع.","videoId":"YRrjSgkwo-I"},{"title":"La liaison en français expliquée simplement","channel":"Madame à Paname","why":"تبسيط مرئي لقاعدة الربط الصوتي بأمثلة يومية قصيرة يسهل استيعابها في المستوى A0.","videoId":"OTBF4dpA1_s"}],"supplements":[{"id":"YRrjSgkwo-I","title":"L'enchaînement et la liaison (facultative, obligatoire ou interdite)","channel":"Enseignement du FLE","why":"مقارنة أكاديمية دقيقة بين الانسياب المتصل (enchaînement) والربط الصوتي وتصنيفهما إلى إلزامي واختياري وممنوع.","dur":8},{"id":"OTBF4dpA1_s","title":"La liaison en français expliquée simplement","channel":"Madame à Paname","why":"تبسيط مرئي لقاعدة الربط الصوتي بأمثلة يومية قصيرة يسهل استيعابها في المستوى A0.","dur":11}]}]},{"id":"a0-t3","slug":"les-salutations","icon":"chat","color":"#B45309","fr":"Les salutations et la politesse","ar":"التحية والتعارف وأدبيات التواصل","desc":"الممارسة التواصلية الواقعية: تحيات اليوم وفق التوقيت الزمني، السوسيولسانيات الفرنسية وثنائية Tu مقابل Vous، صياغة السؤال عن الحال والردود المتدرجة، وفنون المغادرة والاعتذار واللباقة الاجتماعية.","lessons":[{"id":"A0-t3-l1","fr":"Les salutations selon le temps et les codes culturels","ar":"تحيات أوقات اليوم والأعراف الثقافية الفرنسية","objectives":["إتقان التحيات المعيارية (Bonjour, Bonsoir, Salut) وتحديد التوقيت الزمني الدقيق لكل منها.","استيعاب المفهوم السوسيولوجي لـ 'التحية الإلزامية' (Le rituel d'entrée) في الثقافة الفرنسية.","التمييز الجوهري بين تحية اللقاء (Bonjour) وأمنية التوديع في نهاية اليوم (Bonne journée).","التعرف على لغة الجسد المصاحبة للتحية في فرنسا (la poignée de main مقابل la bise).","تطبيق التحية المناسبة في مواقف الحياة اليومية (المتجر، العمل، المقهى، الأصدقاء)."],"sections":[{"h":"التحية كعقد اجتماعي إلزامي في الثقافة الفرنسية","p":["في علم اللغة الاجتماعي (La sociolinguistique)، لا تُعد التحية في فرنسا مجرد خيار لطيف، بل هي «عقد اجتماعي إلزامي» (Un rituel civique indispensable). من غير المقبول ثقافياً في فرنسا الدخول إلى مخبز أو متجر أو ركوب سيارة أجرة أو بدء معاملة إدارية بطرح سؤالك مباشرة دون أن تبدأ بكلمة «Bonjour» واضحة ونبرة مبتسمة.","الفرنسي يعتبر تجاوز التحية وبدء الطلب فوراً تصرفاً فظاً (impoli). كلمة «Bonjour» هي المفتاح السحري الذي يفتح أي حوار، ويضمن لك استقبالاً حسناً وودوداً في أي بيئة فرنكوفونية."],"video":{"id":"fQfkO2E4og4","title":"A1  Leçon  (1) :  Les salutations","channel":"Apprendre la langue française de A jusqu'à Z","why":"درس مصنّف A1 يعرض التحيات بترتيبها ومناسباتها الزمنية، وهو تمهيد مباشر لمفردات هذا الدرس وأعرافه.","dur":6,"lang":"fr","main":true},"sub":[{"h":"توزيع التحيات وفق ساعات اليوم والمقام الاجتماعي","p":["1. Bonjour [bɔ̃.ʒuʁ] (حرفياً: يوم طيب): التحية الرسمية والمعيارية الشاملة منذ شروق الشمس وحتى أواخر بعد الظهر (حوالي الساعة السادسة مساءً). تُستخدم مع الجميع دون استثناء: الغرباء، المديرين، الزملاء، والأصدقاء.","2. Bonsoir [bɔ̃.swaʁ] (مساء طيب): تُستخدم فور حلول المساء (بعد السادسة أو غروب الشمس) حتى وقت متأخر من الليل للتحية عند اللقاء.","3. Salut [sa.ly] (مرحباً / أهلاً): تحية غير رسمية (informelle) تُستخدم حصراً بين الأصدقاء، أفراد العائلة، والشباب والزملاء المقربين. لاحظ أن حرف T الأخير صامت دائماً [sa.ly]. وتتميز بأنها تستخدم للقاء والوداع معاً!","4. Coucou [ku.ku]: كلمة مفرطة في الودية والتلطف، تستخدم بين المقربين جداً، الأمهات مع الأطفال، أو في الرسائل النصية الودية."]},{"h":"الفرق الحاسم بين تحية اللقاء وأمنية الوداع (Bon vs Bonne)","p":["يقع المتعلمون المبتدئون في خطأ متكرر بالخلط بين صيغ التحية وصيغ التوديع:","• تحيات اللقاء (عند المجيء): Bonjour (مذكر مفرد) و Bonsoir (مذكر مفرد).","• أمنيات التوديع (عند المغادرة والانصراف):","  - Bonne journée [bɔn ʒuʁ.ne] (أتمنى لك يوماً سعيداً/موفقاً) — تقال نهاراً عند المغادرة.","  - Bonne soirée [bɔn swa.ʁe] (أتمنى لك أمسية سعيدة) — تقال مساءً عند المغادرة.","  - Bonne nuit [bɔn nɥi] (ليلة سعيدة / تصبح على خير) — تقال حصراً عند الذهاب للنوم مباشرة أو في ساعات متأخرة جداً من الليل.","القاعدة النحوية: كلمة jour مذكر (أخذت bon)، بينما journée مؤنثة تدل على مدة اليوم وامتداده (أخذت صفة bonne)."]}]},{"h":"لغة الجسد المصاحبة للتحية في فرنسا (Codes corporels)","p":["في الأوساط الرسمية والمهنية وعند لقاء شخص لأول مرة: المصافحة الواحدة الخفيفة والحازمة باليد اليمنى (La poignée de main) مع النظر المباشر في العينين وابتسامة مهذبة.","بين الأصدقاء، المقربين، والعائلة: عادة القبلات الرمزية الخفيفة على الخدين (La bise)، وتتراوح حسب المنطقة الجغرافية الفرنسية من قبلتين (قبلة على كل خد، وهي السائدة في باريس ومعظم فرنسا) إلى ثلاث أو أربع قبلات في الجنوب."]},{"h":"التطبيق والتلخيص","p":["يقدّم هذا الدرس خريطة التحيات الفرنسية بحسب التوقيت والمقام الاجتماعي: Bonjour [bɔ̃.ʒuʁ] من الصباح حتى نحو السادسة مساءً، و Bonsoir بعد حلول المساء، و Salut بين الأصدقاء حصراً، مع القاعدة الحاسمة بين تحية اللقاء (Bonjour) وأمنية المغادرة (Bonne journée / Bonne soirée / Bonne nuit) ولغة الجسد المصاحبة (la poignée de main مقابل la bise). كما وضح الفيديو الرئيسي (A1 Leçon (1) : Les salutations) لقناة Apprendre la langue française de A jusqu'à Z، فإن التحية في فرنسا عقدٌ اجتماعي إلزامي يسبق كل طلب، وتخطّيها يُعدّ تصرّفاً غير لائق (impoli).","تستمد هذا الدرس استقامته الصوتية من a0-t2-l3 (التراكيب الحرفية والربط الصوتي): طبّق نطق تركيب oi [wa] في bonsoir [bɔ̃.swaʁ] واربط النون في bonne بالصوت التالي كما تعلّمت، واستعمل ما أتقنته من مخارج الحروف عند نطق السؤال. ثمّ يفتح الدرس التالي a0-t3-l2 (Tu/Vous) على المرحلة التالية من الحوار: بعد التحية يأتي السؤال عن الحال بصيغتين اجتماعيتين متمايزتين Comment allez-vous ? للمقام الرسمي و Comment vas-tu ? للودّ، مع أوّل ظهور لمبدأي Le tutoiement و Le vouvoiement.","أعد مشاهدة الفيديو الرئيسي (Les salutations) ودوّن جدول توقيت التحيات كما يعرضه المدرّس، ثمّ أعِد حركاته بصوت مسموع محاكياً نبرته، وبعد ذلك سجّل نفسك وأنت تحيّي ثلاثة أشخاص في ثلاثة مقامات (موظف، صديق، جار) مقترناً كل تحية بأمنية المغادرة المناسبة لها (Bonne journée / Bonne soirée / Bonne nuit)."]}],"examples":[{"fr":"Bonjour monsieur, comment allez-vous ?","ar":"صباح الخير سيدي، كيف حال حضرتك؟","note":"التحية الرسمية المعيارية صباحاً"},{"fr":"Bonsoir madame, bienvenue au restaurant.","ar":"مساء الخير سيدتي، مرحباً بك في المطعم.","note":"التحية الرسمية المسائية"},{"fr":"Salut Thomas, tu vas bien ?","ar":"أهلاً توما، هل أنت بخير؟","note":"تحية غير رسمية بين الأصدقاء"},{"fr":"Merci beaucoup et bonne journée !","ar":"شكراً جزيلاً وأتمنى لك يوماً طيباً!","note":"أمنية وداع نهارية عند مغادرة المكان"},{"fr":"Passez une excellente soirée.","ar":"اقضوا أمسية ممتازة.","note":"صيغة توديع مسائية مهذبة"},{"fr":"Il est minuit, je vais dormir. Bonne nuit !","ar":"إنها منتصف الليل، سأذهب للنوم. ليلة سعيدة!","note":"تقال فقط عند التوجه للنوم"},{"fr":"On se serre la main pour se saluer.","ar":"نتصافح بالأيدي لتحية بعضنا.","note":"المصافحة في السياق الرسمي"},{"fr":"Ils se font la bise entre collègues amis.","ar":"يتبادلون القبلات الرمزية كزملاء أصدقاء.","note":"العرف الثقافي الودي"}],"pron":[{"w":"bonjour","ipa":"[bɔ̃.ʒuʁ]","approx":"بونجور","note":"صوت أنفي /ɔ̃/ يليه صوت /u/ وراء حلقية /ʁ/"},{"w":"bonsoir","ipa":"[bɔ̃.swaʁ]","approx":"بونسوار","note":"صوت أنفي /ɔ̃/ يليه تركيب oi [wa]"},{"w":"salut","ipa":"[sa.ly]","approx":"سالو (بضم الشفاه)","note":"حرف T صامت تماماً في النهاية"},{"w":"bonne journée","ipa":"[bɔn ʒuʁ.ne]","approx":"بُنْ جُوغنيه","note":"نون فموية صريحة في bonne"},{"w":"bonne soirée","ipa":"[bɔn swa.ʁe]","approx":"بُنْ سواريه","note":"نون صريحة وتوديع مسائي"},{"w":"bonne nuit","ipa":"[bɔn nɥi]","approx":"بُنْ نوي","note":"تقال حصراً عند النوم"}],"vocab":[{"fr":"la salutation","ar":"التحية","pos":"nom","g":"f","pl":"les salutations","ipa":"[la sa.ly.ta.sjɔ̃]","exFr":"Les salutations sont importantes.","exAr":"التحيات مهمة جداً."},{"fr":"bonjour","ar":"صباح الخير / مرحباً نهاراً","pos":"interjection","ipa":"[bɔ̃.ʒuʁ]","exFr":"Bonjour tout le monde.","exAr":"صباح الخير للجميع."},{"fr":"bonsoir","ar":"مساء الخير (عند اللقاء مساءً)","pos":"interjection","ipa":"[bɔ̃.swaʁ]","exFr":"Bonsoir et bienvenue.","exAr":"مساء الخير وأهلاً بكم."},{"fr":"salut","ar":"أهلاً / وداعاً (بين الأصدقاء)","pos":"interjection","ipa":"[sa.ly]","exFr":"Salut Paul !","exAr":"أهلاً بول!"},{"fr":"bonne journée","ar":"أتمنى لك يوماً سعيداً (عند الوداع نهاراً)","pos":"locution","ipa":"[bɔn ʒuʁ.ne]","exFr":"Au revoir et bonne journée !","exAr":"إلى اللقاء ويوماً سعيداً!"},{"fr":"bonne soirée","ar":"أمسية سعيدة (عند الوداع مساءً)","pos":"locution","ipa":"[bɔn swa.ʁe]","exFr":"Bonne soirée à tous.","exAr":"أمسية سعيدة للجميع."},{"fr":"bonne nuit","ar":"تصبح على خير (عند النوم)","pos":"locution","ipa":"[bɔn nɥi]","exFr":"Dors bien, bonne nuit.","exAr":"نم جيداً، تصبح على خير."},{"fr":"monsieur","ar":"سيدي / أستاذ (لقب احترام)","pos":"nom","g":"m","pl":"messieurs","ipa":"[mə.sjø]","exFr":"Bonjour monsieur le directeur.","exAr":"صباح الخير سيدي المدير."},{"fr":"madame","ar":"سيدتي (لقب احترام لامرأة)","pos":"nom","g":"f","pl":"mesdames","ipa":"[ma.dam]","exFr":"Merci madame.","exAr":"شكراً سيدتي."},{"fr":"mademoiselle","ar":"آنستي (للشابات الصغيرات)","pos":"nom","g":"f","pl":"mesdemoiselles","ipa":"[mad.mwa.zɛl]","exFr":"Bonjour mademoiselle.","exAr":"صباح الخير آنستي."},{"fr":"le matin","ar":"الصباح","pos":"nom","g":"m","pl":"les matins","ipa":"[lə ma.tɛ̃]","exFr":"Je travaille le matin.","exAr":"أعمل في الصباح."},{"fr":"l'après-midi","ar":"بعد الظهر","pos":"nom","g":"mf","pl":"les après-midis","ipa":"[l‿a.pʁɛ.mi.di]","exFr":"Une réunion cet après-midi.","exAr":"اجتماع بعد ظهر اليوم."},{"fr":"le soir","ar":"المساء","pos":"nom","g":"m","pl":"les soirs","ipa":"[lə swaʁ]","exFr":"Le soir tombe vite.","exAr":"المساء يحل سريعاً."},{"fr":"la politesse","ar":"اللباقة / الأدب","pos":"nom","g":"f","ipa":"[la pɔ.li.tɛs]","exFr":"La politesse est une vertu.","exAr":"اللباقة فضيلة إنسانية."},{"fr":"la bise","ar":"القبلة الرمزية الودية على الخد","pos":"nom","g":"f","pl":"les bises","ipa":"[la biz]","exFr":"Faire la bise aux amis.","exAr":"تبادل القبلات الودية مع الأصدقاء."}],"grammar":[{"tAr":"الفرق التركيبي بين Bon و Bonne","tFr":"L'accord de l'adjectif qualificatif : bon (m) / bonne (f)","body":["الصفة الفرنسية تتبع الموصوف في التذكير والتأنيث وجوباً:","• مع الأسماء المذكرة (jour, soir): نستخدم «bon» [bɔ̃] بصوت أنفي: Bonjour, Bonsoir.","• مع الأسماء المؤنثة (journée, soirée, nuit): نستخدم «bonne» [bɔn] بصوت فموي ناصع يليه نون صريحة: Bonne journée, Bonne soirée, Bonne nuit."],"ex":[{"fr":"Un bon moment [bɔ̃]","ar":"وقت طيب (مذكر أنفي)"},{"fr":"Une bonne heure [bɔn]","ar":"ساعة طيبة (مؤنث فموي)"}]}],"mistakes":[{"wrong":"قول 'Bonne journée' عند دخولك على شخص في الصباح","right":"تقول 'Bonjour' عند الدخول واللقاء، و 'Bonne journée' عند المغادرة والانصراف","why":"Bonjour هي تحية المجيء، بينما Bonne journée هي أمنية الوداع."},{"wrong":"قول 'Bonne nuit' للموظف عند مغادرتك المتجر في الثامنة مساءً","right":"تقول 'Bonne soirée' للمساء العادي، و 'Bonne nuit' لمن يذهب لفراش النوم فقط","why":"Bonne nuit تعني حرفياً تصبح على خير ولا تقال في الحياة العامة."},{"wrong":"استخدام 'Salut' مع مديرك في العمل أو موظف الشرطة أو الغرباء","right":"استخدام 'Bonjour monsieur' في المقامات الرسمية","why":"Salut تحية عامية ودية تقتصر على الأصدقاء والمقربين فقط."}],"dialogues":[{"title":"التحية عند مدخل الفندق","ctx":"مسافر يدخل إلى الفندق في التاسعة صباحاً لإتمام إجراءات الحجز.","lines":[{"who":"Le client","fr":"Bonjour monsieur. J'ai une réservation au nom de Karim.","ar":"صباح الخير سيدي. لدي حجز باسم كريم."},{"who":"Le réceptionniste","fr":"Bonjour monsieur Karim, bienvenue. Votre chambre est prête.","ar":"صباح الخير سيد كريم، مرحباً بك. غرفتك جاهزة."},{"who":"Le client","fr":"Merci beaucoup. Je monte mes bagages.","ar":"شكراً جزيلاً. سأصعد بحقائبي."},{"who":"Le réceptionniste","fr":"Très bien. Passez une excellente journée dans notre hôtel !","ar":"ممتاز جداً. اقضِ يوماً ممتازاً في فندقنا!"},{"who":"Le client","fr":"Merci, bonne journée à vous aussi !","ar":"شكراً، ويوماً سعيداً لك أيضاً!"}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما هي العبارة الصحيحة التي تقال عند مغادرة زميلك في العمل في الساعة الثانية بعد الظهر؟","opts":["Bonjour","Bonne nuit","Bonne journée","Bonsoir"],"a":2,"why":"Bonne journée هي أمنية التوديع المستخدمة خلال النهار عند المغادرة."},{"t":"mcq","skill":"culture","q":"مع من يجوز لك استخدام التحية الودية غير الرسمية 'Salut'؟","opts":["مع ضابط الجوازات في المطار","مع صديقك المقرب في الفصل","مع مدير الشركة أثناء مقابلة عمل","مع قاضي المحكمة"],"a":1,"why":"Salut مخصصة حصراً للأصدقاء والمقربين والأطفال."},{"t":"fill","skill":"grammar","q":"أكمل العبارة بالصفة المناسبة (مذكر أو مؤنث): 'Passez une ___ soirée.'","fr":"Passez une ___ soirée.","ans":"bonne","alts":["Bonne"],"why":"كلمة soirée مؤنثة، فتأخذ صفة التأنيث bonne."},{"t":"order","skill":"grammar","q":"رتّب عبارة التحية الرسمية الصباحية الكاملة:","words":["Bonjour","madame,","comment","allez-vous","aujourd'hui ?"],"why":"الترتيب المعياري: التحية + لقب الاحترام + السؤال عن الحال.","ans":"Bonjour madame, comment allez-vous aujourd'hui ?"},{"t":"listen","skill":"listening","audio":"Au revoir et bonne soirée à tous","q":"استمع إلى العبارة وحدد الموقف المناسب لها بدقة:","opts":["شخص يدخل متجراً في الصباح","شخص يغادر أصدقاءه في المساء مودعاً","شخص يطلب قهوة","شخص يسأل عن العنوان"],"a":1,"why":"Au revoir et bonne soirée تعني وداعاً وأمسية سعيدة للجميع، وتقال عند المغادرة مساءً."},{"t":"correct","skill":"culture","q":"صحح الخطأ السوسيولغوي: 'دخل العميل المتجر في العاشرة صباحاً وقال: Bonne journée !'","fr":"Il doit dire Bonjour en entrant.","ans":"Il doit dire Bonjour en entrant.","why":"عند الدخول يجب قول Bonjour للتحية، و Bonne journée تقال عند الخروج."},{"t":"writing","skill":"writing","q":"اكتب عبارة تحية رسمية صباحية متكاملة توجهها لسيدة محترمة:","min":3,"kw":["bonjour","madame"],"sample":"Bonjour madame, comment allez-vous ?","why":"صياغة التحية الرسمية الأساسية وفق المعايير الفرنسية."},{"t":"speaking","skill":"pronunciation","q":"انطق عبارة الوداع المسائية بنطق فرنسي أنيق كما سمعتها في الفيديو الرئيسي:","target":"Bonne soirée !","why":"نطق bonne [bɔn] بفم مفتوح ونون صريحة و soirée [swa.ʁe] بتركيب oi المنبسط."}],"homework":"اكتب جدولاً يقسم يومك إلى أربع فترات زمنية (الصباح، الظهيرة، المساء، وقت النوم)، وحدد أمام كل فترة: تحية اللقاء المناسبة، وأمنية الوداع المناسبة، مع تسجيل صوتي لنطق هذه العبارات الثمانية بوضوح تام. قبل الدرس التالي (a0-t3-l2): راجع لقبَي vous و tu اللذين ستستعملهما في السؤال عن الحال، ولا تكرّر محتوى درس التحيات لأنه منصوص عليه في جدولك.","sources":[{"title":"A1  Leçon  (1) :  Les salutations","channel":"Apprendre la langue française de A jusqu'à Z","why":"شرح حيّ للفروق الدقيقة بين التحيات وتوقيتاتها ومقاماتها الاجتماعية.","videoId":"fQfkO2E4og4"},{"title":"Les salutations en français - Niveau débutant A1","channel":"Francisation - FLE","why":"لخصة سريعة وواضحة لجميع التحيات الأساسية في المستوى A1 تصلح للمراجعة قبل التدريب على النطق.","videoId":"hOCBlwMBOoY"},{"title":"Les formules de politesse en français. Niveau A1-FLE","channel":"La prof Elisabeth","why":"توسيع لمفردات اللباقة (Les formules de politesse) في المستوى A1 بما يكمّل التحيات بعبارات المعاملة اليومية.","videoId":"TQzcgWMbNAU"}],"supplements":[{"id":"hOCBlwMBOoY","title":"Les salutations en français - Niveau débutant A1","channel":"Francisation - FLE","why":"لخصة سريعة وواضحة لجميع التحيات الأساسية في المستوى A1 تصلح للمراجعة قبل التدريب على النطق.","dur":4},{"id":"TQzcgWMbNAU","title":"Les formules de politesse en français. Niveau A1-FLE","channel":"La prof Elisabeth","why":"توسيع لمفردات اللباقة (Les formules de politesse) في المستوى A1 بما يكمّل التحيات بعبارات المعاملة اليومية.","dur":5}]},{"id":"A0-t3-l2","fr":"L'état de santé et la distinction fondamentale Tu / Vous","ar":"كيف حالك؟ وثنائية المخاطب (Tu مقابل Vous)","objectives":["إتقان صيغ السؤال عن الحال المتدرجة (Comment allez-vous ?, Comment vas-tu ?, Ça va ?).","استيعاب درجات الإجابة والتعبير عن الحالة النفسية والجسدية بدقة (Très bien, Comme ci comme ça, Mal).","الاستيعاب الأكاديمي والاجتماعي العميق للفارق بين ضميري المخاطب Tu (Le tutoiement) و Vous (Le vouvoiement).","تجنب الإساءة الثقافية الناجمة عن استخدام Tu مع الغرباء أو أصحاب المقامات الرسمية.","استخدام صيغة Ça va في السؤال والإجابة بنبرة صوتية صحيحة (Intonation montante / descendante)."],"sections":[{"h":"كيف حالك بالفرنسية؟ من النبرة الرسمية إلى الأحاديث الودية","p":["السؤال عن الحال في الفرنسية ليس مجرد فحص لصحة المتكلم، بل هو الركن الثاني من طقوس المحادثة اليومية بعد التحية. تختلف الصيغة جذرياً باختلاف المقام الاجتماعي ودرجة القرب بين المتحدثين:","1. المقام الرسمي والمحترم (Registre soutenu / formel):","  «Comment allez-vous ?» [kɔ.mɑ̃.t‿a.le.vu] (مع ربط صوت التاء بين Comment و allez!). تعني: كيف حال حضرتك؟ أو كيف حالكم؟ وتستخدم مع الغرباء والمسؤولين والزبائن.","2. المقام المعتاد الودود (Registre courant):","  «Comment vas-tu ?» [kɔ.mɑ̃ va ty] أو «Comment ça va ?» [kɔ.mɑ̃ sa va]. تستخدم بين الزملاء والأقارب والمعارف.","3. المقام العفوي المختصر (Registre familier):","  «Ça va ?» [sa va]. العبارة السحرية في الفرنسية التي تُستخدم كسؤال وجواب في نفس اللحظة!"],"video":{"id":"mF9mw22qct8","title":"Tu ou Vous En Français, Quelle est la Différence? 🤔","channel":"Français avec Pierre","why":"شرح متكامل للفرق بين ضميري المخاطب Tu و Vous ومقامات استخدام كل منهما في الحياة اليومية.","dur":10,"lang":"fr","main":true},"sub":[{"h":"أعظم قرار اجتماعي في فرنسا: Tu (التودد) مقابل Vous (الاحترام)","p":["تمتلك اللغة الفرنسية قاعدتين سوسيولغويتين صارمتين للمخاطب المفرد:","• Le tutoiement (استخدام الضمير Tu): يُخاطب به شخص واحد مفرد تربطك به علاقة قرابة، صداقة حميمة، أو طفل صغير، أو بين الطلاب في الجامعات. يعبر عن الاندماج والود والأريحية.","• Le vouvoiement (استخدام الضمير Vous): يُخاطب به شخص واحد مفرد للتعبير عن التقدير والاحترام والمسافة الاجتماعية (Politesse et distance sociale). يجب استخدامه حتماً مع: أي شخص تقابله لأول مرة، أصحاب الأعمال، أساتذتك، الشرطة، موظفي الإدارة، البائعين في المتاجر، والأشخاص الأكبر سناً.","القاعدة الذهبية للأجنبي في فرنسا: ابدأ دائماً باستخدام «Vous». لا تنتقل إلى «Tu» إلا إذا بادر الفرنسي نفسه بالقول صراحة: «On peut se tutoyer ?» (هل يمكننا أن نخاطب بعضنا بـ Tu؟)."]},{"h":"تدرجات الإجابة عن الحال (L'échelle des réponses)","p":["لا يقتصر الرد على Ça va، بل توجد مروحة واسعة من التعبيرات المعبرة بدقة:","• الإيجابية الفائقة: «Très bien, merci ! Et vous ?» (بخير جداً، شكراً! وحضرتك؟).","• الإيجابية العادية: «Ça va bien, merci.» / «Ça va, et toi ?».","• الحياد والوسطية: «Pas mal.» (لست سيئاً / لا بأس) أو «Comme ci, comme ça.» (بين بين / كذا وكذا).","• السلبية والشكوى: «Ça ne va pas très bien.» (الأمور ليست على ما يرام) أو «Je suis très fatigué.» (أنا متعب جداً)."]}]},{"h":"سحر عبارة Ça va والنغمة الصوتية (L'intonation)","p":["تتكون كلمة Ça va من كلمتين: الضمير الإشاري Ça (هذا/الأمر) وتصريف الفعل Aller (يمضي/يسير). المعنى الحرفي: 'الأمر يمضي'.","الفارق بين السؤال والإجابة يعتمد 100% على النغمة الصوتية (L'intonation):","• في السؤال: نغمة صاعدة في النهاية (Intonation montante ↗) — «Ça va ?» (هل الأمور بخير؟).","• في الإجابة: نغمة هابطة مستقرة (Intonation descendante ↘) — «Oui, ça va.» (نعم، الأمور بخير)."]},{"h":"التطبيق والتلخيص","p":["يؤسّس هذا الدرس لثلاثة مستويات في السؤال عن الحال — Comment allez-vous ? و Comment vas-tu ? و Ça va ? — ولسلّم الإجابات المتدرّج من Très bien إلى Comme ci comme ça ثمّ Mal، قبل أن يركّز على أعمق قاعدة سوسيولغوية في المخاطبة الفرنسية: التمايز بين Le tutoiement و Le vouvoiement. كما وضح الفيديو الرئيسي (Tu ou Vous En Français, Quelle est la Différence?) لقناة Français avec Pierre، فالقاعدة الذهبية للغريب هي البدء دائماً بـ Vous مع كل من يقابله لأول مرة، وعدم الانتقال إلى Tu إلا بموافقة صريحة (On peut se tutoyer ?).","تتفرّع هذا الدرس عمّا بناه a0-t3-l1 (تحيات اليوم والأعراف): لا يُطرح السؤال قبل تحية الدخول Bonjour، وتبقى لقابا monsieur و madame سنداً لصيغة الاحترام، وتبقى أمنية bonne journée ملزمة عند المغادرة نهاراً. وفي المقابل يمهّد الدرس الطريق إلى a0-t3-l3 (الوداع والشكر والاعتذار) الذي يعالج نهاية المحادثة: الصيغ المحدّدة لموعد اللقاء (À bientôt / À demain / À tout à l'heure) ودرجات الشكر (Merci / Merci beaucoup / Je vous en prie) وصيغ الاعتذار الثلاث (Pardon / Excusez-moi / Désolé).","أعد مشاهدة الفيديو الرئيسي ودوّن في كل مرة يستخدم فيها المتحدث tu أو vous سبب الاختيار الاجتماعي، ثمّ سجّل نفسك وأنت تؤدّي حوارين متوازيين: الأول مع مدير تبدأ فيه بـ Comment allez-vous ? وتنهيه بـ Et vous ?، والثاني مع صديق تبدأ فيه بـ Ça va ? وتنهيه بـ Et toi ?، مع الحفاظ على النغمة الصاعدة في السؤال والهابطة في الإجابة."]}],"examples":[{"fr":"Bonjour professeur, comment allez-vous ?","ar":"صباح الخير يا أستاذ، كيف حال حضرتك؟","note":"صيغة الاحترام vous الإلزامية مع المعلم"},{"fr":"Salut Karim, comment vas-tu ?","ar":"أهلاً كريم، كيف حالك؟","note":"صيغة التودد tu بين صديقين"},{"fr":"Ça va très bien, merci, et vous ?","ar":"بخير جداً، شكراً، وحضرتك؟","note":"رد نموذجي مع رد السؤال بـ vous"},{"fr":"Comme ci, comme ça, je suis un peu fatigué.","ar":"بين بين، أنا متعب قليلاً.","note":"تعبير عن حالة متوسطة"},{"fr":"— Ça va ? — Oui, ça va bien !","ar":"— ماشي الحال؟ — نعم، ماشي الحال تماماً!","note":"سؤال وجواب بنغمة متقابلة"},{"fr":"On se tutoie ou on se vouvoie ?","ar":"هل نتخاطب بـ tu أم نتخاطب بـ vous؟","note":"سؤال اجتماعي صريح لتحديد مستوى العلاقة"},{"fr":"Tout va très bien, merci infiniment.","ar":"كل شيء يسير على ما يرام، شكراً جزيلاً.","note":"إجابة إيجابية تامة"},{"fr":"Pas mal du tout pour un premier jour.","ar":"لست سيئاً إطلاقاً كأول يوم.","note":"تعبير يومي دارج"}],"pron":[{"w":"comment allez-vous","ipa":"[kɔ.mɑ̃.t‿a.le.vu]","approx":"كومون تاليفو","note":"ربط إلزامي بحرف T: [t‿a.le]"},{"w":"comment vas-tu","ipa":"[kɔ.mɑ̃ va ty]","approx":"كومون فا تي","note":"صوت v المجهور يليه tu المضموم الشفاه"},{"w":"ça va","ipa":"[sa va]","approx":"سا فا","note":"سيدي ç تعطي صوت [s]"},{"w":"très bien","ipa":"[tʁɛ bjɛ̃]","approx":"تخي بيان (أنفية)","note":"صوت أنفي منبسط في bien"},{"w":"comme ci comme ça","ipa":"[kɔm si kɔm sa]","approx":"كوم سي كوم سا","note":"تعبير تراثي عن التوسط"}],"vocab":[{"fr":"comment","ar":"كيف (أداة استفهام)","pos":"adverbe","ipa":"[kɔ.mɑ̃]","exFr":"Comment vous appelez-vous ?","exAr":"ما هو اسم حضرتك؟"},{"fr":"aller","ar":"يذهب / يمضي الحال","pos":"verbe","ipa":"[a.le]","exFr":"Je vais bien.","exAr":"أموري تسير على ما يرام."},{"fr":"bien","ar":"بخير / حسناً / جيداً","pos":"adverbe","ipa":"[bjɛ̃]","exFr":"Tout va bien.","exAr":"كل شيء بخير."},{"fr":"très","ar":"جداً","pos":"adverbe","ipa":"[tʁɛ]","exFr":"Il est très gentil.","exAr":"هو لطيف جداً."},{"fr":"mal","ar":"بسوء / ليس على ما يرام","pos":"adverbe","ipa":"[mal]","exFr":"Ça va mal aujourd'hui.","exAr":"الأمور سيئة اليوم."},{"fr":"fatigué","ar":"متعب / مرهق (مذكر)","pos":"adj","g":"m","pl":"fatigués","ipa":"[fa.ti.ɡe]","exFr":"Je suis un peu fatigué.","exAr":"أنا متعب قليلاً."},{"fr":"fatiguée","ar":"متعبة / مرهقة (مؤنث)","pos":"adj","g":"f","pl":"fatiguées","ipa":"[fa.ti.ɡe]","exFr":"Elle est très fatiguée.","exAr":"هي متعبة جداً."},{"fr":"et vous","ar":"وحضرتك؟ / وأنتم؟","pos":"locution","ipa":"[e vu]","exFr":"Ça va bien, et vous ?","exAr":"بخير، وحضرتك؟"},{"fr":"et toi","ar":"وأنتَ؟ / وأنتِ؟","pos":"locution","ipa":"[e twa]","exFr":"Je vais bien, et toi ?","exAr":"أنا بخير، وأنت؟"},{"fr":"le tutoiement","ar":"استخدام صيغة tu (التودد)","pos":"nom","g":"m","ipa":"[lə ty.twa.mɑ̃]","exFr":"Le tutoiement est familier.","exAr":"التخاطب بـ tu أسلوب غير رسمي."},{"fr":"le vouvoiement","ar":"استخدام صيغة vous (الاحترام)","pos":"nom","g":"m","ipa":"[lə vu.vwa.mɑ̃]","exFr":"Le vouvoiement marque le respect.","exAr":"التخاطب بـ vous علامة على الاحترام."},{"fr":"la santé","ar":"الصحة","pos":"nom","g":"f","ipa":"[la sɑ̃.te]","exFr":"Comment est votre santé ?","exAr":"كيف حال صحتك؟"},{"fr":"comme ci comme ça","ar":"بين بين / نص نص","pos":"locution","ipa":"[kɔm si kɔm sa]","exFr":"— Ça va ? — Comme ci comme ça.","exAr":"— ماشي الحال؟ — بين بين."},{"fr":"pas mal","ar":"لا بأس به / لست سيئاً","pos":"locution","ipa":"[pa mal]","exFr":"Ce travail est pas mal.","exAr":"هذا العمل لا بأس به."}],"grammar":[{"tAr":"تصريف فعل Aller في السؤال عن الحال","tFr":"La conjugaison du verbe aller au présent pour l'état","body":["في الفرنسية، لا نسأل عن الحال بفعل الكينونة Être (لا يجوز القول Comment êtes-vous ?)، بل نستخدم حصراً فعل Aller (يمضي/يسير):","• مع الضمير tu: «Comment vas-tu ?» (الفعل vas ينتهي بـ s صامتة).","• مع الضمير vous: «Comment allez-vous ?» (الفعل allez ينتهي بـ z وتتحول إلى t صوتية عند الربط مع Comment).","• في الإجابة: «Je vais bien» (أنا أسير بخير = أنا بخير)."],"ex":[{"fr":"Tu vas bien ?","ar":"هل تسير أمورك بخير؟"},{"fr":"Je vais très bien.","ar":"أموري تسير على أحسن ما يرام."}]}],"mistakes":[{"wrong":"قول 'Comment êtes-vous ?' للسؤال عن الحال","right":"Comment allez-vous ? (باستخدام فعل Aller)","why":"السؤال عن الحال في الفرنسية يرتبط بفعل الحركة Aller وليس فعل الكينونة être."},{"wrong":"مخاطبة موظف بنك أو طبيب أو شرطي بالضمير 'Tu'","right":"مخاطبتهم دائماً بـ 'Vous' للتعبير عن الاحترام والمسافة المهنية","why":"استخدام Tu مع الغرباء والمسؤولين يعتبر تعدياً غير مقبول على قواعد الأدب."},{"wrong":"نسيان رد السؤال بعد الإجابة: الاكتفاء بقول Ça va دون شكر أو سؤال المتحدث","right":"Ça va bien, merci ! Et vous ? (أو Et toi ?)","why":"رد السؤال وعبارة الشكر ركن أساسي في آداب الحوار الفرنسي."}],"dialogues":[{"title":"لقاء رسمي بين زميلي عمل في الصباح","ctx":"محادثة مهنية محترمة بين موظف ومسؤولته في بهو الشركة.","lines":[{"who":"L'employé","fr":"Bonjour madame Laurent, comment allez-vous aujourd'hui ?","ar":"صباح الخير سيدة لوران، كيف حال حضرتك اليوم؟"},{"who":"Mme Laurent","fr":"Bonjour Karim. Je vais très bien, merci. Et vous ?","ar":"صباح الخير كريم. أنا بخير جداً، شكراً. وحضرتك؟"},{"who":"L'employé","fr":"Très bien aussi, merci. Le dossier est prêt pour la réunion.","ar":"بخير جداً أيضاً، شكراً. الملف جاهز للاجتماع."},{"who":"Mme Laurent","fr":"C'est parfait, je vous remercie !","ar":"هذا ممتاز، أشكر حضرتك!"}]}],"exercises":[{"t":"mcq","skill":"grammar","q":"ما هو الفعل المستخدم بالفرنسية في السؤال عن الحال 'Comment allez-vous ?'؟","opts":["فعل الكينونة être","فعل يمضي/يسير aller","فعل يملك avoir","فعل يفعل faire"],"a":1,"why":"السؤال عن الحال يستوجب حصراً استخدام تصريف فعل aller."},{"t":"mcq","skill":"culture","q":"إذا دخلت مكتباً رسمياً لمقابلة مدير لأول مرة، أي ضمير مخاطب تستخدم حتماً؟","opts":["Tu","Vous","Il","On"],"a":1,"why":"قاعدة الاحترام (Le vouvoiement) تفرض استخدام Vous مع المسؤولين والغرباء."},{"t":"fill","skill":"grammar","q":"أكمل الإجابة النموذجية: '— Comment allez-vous ? — Je ___ très bien, merci.'","fr":"Je ___ très bien, merci.","ans":"vais","why":"تصريف فعل aller مع ضمير المتكلم Je هو vais."},{"t":"order","skill":"grammar","q":"رتّب كلمات السؤال المهذب عن الحال بصيغة الاحترام:","words":["Comment","allez-vous","ce","matin,","monsieur ?"],"why":"أداة الاستفهام + الفعل المقيد بالفاعل + الظرف الزمني + لقب الاحترام.","ans":"Comment allez-vous ce matin, monsieur ?"},{"t":"listen","skill":"listening","audio":"Ça va bien, merci, et vous ?","q":"استمع إلى العبارة وحدد نبرة ومستوى الخطاب:","opts":["خطاب رسمي مهذب (يستخدم vous)","خطاب بين أطفال في المدرسة","مشاجرة في الشارع","وداع عند النوم"],"a":0,"why":"استخدام et vous يدل على التخاطب بصيغة الاحترام واللباقة."},{"t":"correct","skill":"grammar","q":"صحح الخطأ في السؤال عن الحال: 'Comment êtes-vous ?'","fr":"Comment êtes-vous ?","ans":"Comment allez-vous ?","why":"يجب استخدام فعل aller وليس فعل être."},{"t":"writing","skill":"writing","q":"اكتب جملة ترد فيها بأنك بخير وتشكر المتحدث وتسأله عن حاله بصيغة الاحترام:","min":5,"kw":["bien","merci","vous"],"sample":"Je vais bien, merci, et vous ?","why":"الرد النموذجي المتكامل في الأعراف الفرنسية."},{"t":"speaking","skill":"pronunciation","q":"انطق عبارة السؤال عن الحال مع تطبيق الربط الصوتي الصريح في [t‿a.le] كما في الفيديو الرئيسي:","target":"Comment allez-vous ?","why":"ربط T الصامتة مع صوت a التالي لتصبح [kɔ.mɑ̃.t‿a.le.vu]."}],"homework":"اكتب حوارين متوازيين من 4 أسطر لكل منهما: الأول يدور في سياق رسمي بين زبون وموظف فندق باستخدام Vous، والثاني يدور بين طالبين جامعيين صديقين باستخدام Tu و Ça va، مع مراعاة كافة قواعد التحية والرد. قبل الدرس التالي (a0-t3-l3): اكتب ثلاث عبارات شكر واعتذار (Merci beaucoup / Je vous en prie / Pardon) ستصفّق بها نهاية حوارك، دون إعادة محتوى درس Tu/Vous.","sources":[{"title":"Tu ou Vous En Français, Quelle est la Différence? 🤔","channel":"Français avec Pierre","why":"شرح تفصيلي لتدرّجات السؤال عن الحال وثنائية Tu و Vous في الحياة اليومية.","videoId":"mF9mw22qct8"},{"title":"TUTOYER OU VOUVOYER ? Je vous explique !","channel":"Oh My French Class","why":"عرض ممتع على المواقف التي تفرض التودّد (tutoiement) والتي تفرض الاحترام (vouvoiement) مع أمثلة حيّة.","videoId":"alz0oLPuosg"},{"title":"🇫🇷 Vouvoiement ou tutoiement ? (Se) vouvoyer et (se) tutoyer | Français A1-B1","channel":"French with Elyse","why":"تلخيص موجز ومنظّم لمعيارَي (se) vouvoyer و (se) tutoyer في حدود المستويين A1-B1.","videoId":"gzpa4-dn2jY"}],"supplements":[{"id":"alz0oLPuosg","title":"TUTOYER OU VOUVOYER ? Je vous explique !","channel":"Oh My French Class","why":"عرض ممتع على المواقف التي تفرض التودّد (tutoiement) والتي تفرض الاحترام (vouvoiement) مع أمثلة حيّة.","dur":8},{"id":"gzpa4-dn2jY","title":"🇫🇷 Vouvoiement ou tutoiement ? (Se) vouvoyer et (se) tutoyer | Français A1-B1","channel":"French with Elyse","why":"تلخيص موجز ومنظّم لمعيارَي (se) vouvoyer و (se) tutoyer في حدود المستويين A1-B1.","dur":3}]},{"id":"A0-t3-l3","fr":"La prise de congé, la gratitude et les formules de politesse","ar":"المغادرة والوداع، كلمات الشكر والاعتذار واللباقة","objectives":["إتقان تعبيرات الوداع المتنوعة وتحديد زمن اللقاء القادم بدقة (Au revoir, À bientôt, À tout à l'heure, À demain).","التمييز بين صيغتي الطلب المهذب: S'il vous plaît (رسمي) و S'il te plaît (ودي).","استيعاب درجات الشكر والتعبير عن الامتنان (Merci, Merci beaucoup, Je vous remercie).","إتقان الردود المتدرجة على الشكر (De rien, Je vous en prie, Avec plaisir).","التفريق الدقيق بين صيغ الاعتذار الثلاث: Pardon و Excusez-moi و Désolé."],"sections":[{"h":"فنون إنهاء المحادثة والمغادرة في الفرنسية (La prise de congé)","p":["مثلما تبدأ المحادثة الفرنسية بعقد إلزامي (Bonjour)، تنتهي المحادثة بأصول وقواعد دقيقة تسمى «La prise de congé» (أخذ الإذن بالمغادرة). الاكتفاء بقطع الحديث والمغادرة المفاجئة يترك أثراً سلبياً في الذهن الفرنسي.","التعبير الأكثر شمولاً ورسمية هو «Au revoir» [o.ʁə.vwaʁ] (حرفياً: إلى حين أن نرى بعضنا مجدداً). يُستخدم في كل زمان ومع أي شخص.","تتميز الفرنسية بامتلاكها تعبيرات وداع تحدد موعد اللقاء القادم باستخدام حرف الجر «À» متبوعاً بظرف الزمان:","• «À bientôt» [a bjɛ̃.to]: إلى لقاء قريب (دون تحديد موعد دقيق).","• «À tout à l'heure» [a tu.t‿a lœʁ]: إلى اللقاء بعد قليل (حين تلتقي بالشخص في وقت لاحق من نفس اليوم!).","• «À demain» [a də.mɛ̃]: إلى الغد (حين تلتقيان في اليوم التالي).","• «À la semaine prochaine» [a la sə.mɛn pʁɔ.ʃɛn]: إلى الأسبوع القادم.","• «À plus tard» [a ply taʁ] (أو اختصاراً À plus [a plys] بين الشباب): إلى وقت لاحق."],"video":{"id":"y9F3i0UAqNA","title":"Comment dire AU REVOIR en français ❓ Il y a des NUANCES ❗","channel":"Le français by Alex","why":"توضيح الفروق الدقيقة بين صيغ الوداع ومقام كل صيغة وزمن لقاءها، وهو مرجع مباشر لمفردات هذا الدرس.","dur":7,"lang":"fr","main":true}},{"h":"مثلث اللباقة الأساسي: الطلب، الشكر، والرد على الشكر","p":["1. طلب الشيء بلباقة (Demander poliment): لا تطلب شيئاً في فرنسا بصيغة الأمر المباشر، بل ألحقه دائماً بـ S'il vous plaît (إذا ناسب حضرتك - رسمي مع الكبار والغرباء)، أو S'il te plaît (إذا ناسبك - مع الأصدقاء والأطفال).","2. التعبير عن الشكر والامتنان (Remercier): Merci (شكراً)، Merci beaucoup (شكراً جزيلاً)، Je vous remercie (أنا أشكر حضرتك - رسمي راقٍ جداً).","3. الرد على الشكر (Répondre aux remerciements): De rien (لا شكر على واجب - عادي ومقبول يومياً)، Je vous en prie (عفواً لحضرتك - الصيغة الأكثر رقياً وأدباً في المعاملات الرسمية)، أو Avec plaisir (بكل سرور - شائعة ومحبوبة)."]},{"h":"التفريق الدقيق بين صيغ الاعتذار: Pardon / Excusez-moi / Désolé","p":["في اللغة اليومية، يخلط الأجانب بين كلمات الاعتذار، بينما يمتلك الفرنسي فرزاً واضحاً لكل كلمة:","• «Pardon» [paʁ.dɔ̃]: اعتذار خفيف وفوري لحادث عارض (كالاصطدام بشخص في المترو)، أو للاستئذان بالمرور في ممر ضيق.","• «Excusez-moi» [ɛk.sky.ze.mwa] (أو Excuse-moi للأصدقاء): لطلب المعذرة قبل جذب انتباه شخص غريب لطرح سؤال (Excusez-moi monsieur, où est la gare ?).","• «Désolé» [de.zɔ.le] (أو بصيغتها الكاملة «Je suis désolé»): للتعبير عن الأسف والندم الحقيقي على خطأ ارتكبته، أو لإظهار التعاطف مع مشكلة واجهت الآخر (آسف جداً، لا أستطيع مساعدتك). وتبقى الحدود الفاصلة صارمة: Pardon لحادث عارض بلا نية، و Excusez-moi للاستئذان وجلب الانتباه، أما Désolé فاعتراف صريح بمسؤولية يستحسن أن يتبعه تصحيح عملي أو عرض مساعدة (Je suis désolé, je vous aide tout de suite)، على نحو ما يرد في تطبيقات هذا الدرس وفي الفيديو الرئيسي (Comment dire AU REVOIR en français)."]}],"examples":[{"fr":"Au revoir madame, et à demain !","ar":"إلى اللقاء سيدتي، وإلى الغد!","note":"وداع مع تحديد موعد اللقاء القادم"},{"fr":"Je te vois ce soir, à tout à l'heure !","ar":"سأراك هذا المساء، إلى اللقاء بعد قليل!","note":"À tout à l'heure للقاء في نفس اليوم"},{"fr":"Un café, s'il vous plaît.","ar":"قهوة، من فضلك.","note":"الطلب المقترن بصيغة اللباقة الرسمية"},{"fr":"— Merci mille fois ! — Je vous en prie.","ar":"— ألف شكر! — عفواً لحضرتك.","note":"الرد الراقي على الامتنان الكبير"},{"fr":"Excusez-moi monsieur, est-ce que ce train va à Lyon ?","ar":"اعذرني سيدي، هل هذا القطار يذهب إلى ليون؟","note":"لفت انتباه شخص غريب قبل السؤال"},{"fr":"Pardon, je dois passer.","ar":"عفواً، يجب أن أمر.","note":"اعتذار عارض للمرور"},{"fr":"Je suis vraiment désolé pour ce retard.","ar":"أنا آسف حقاً على هذا التأخير.","note":"تعبير عن الندم الحقيقي"},{"fr":"À bientôt et bon voyage !","ar":"إلى لقاء قريب ورحلة موفقة!","note":"أمنية سفر مع وداع مفتوح"}],"pron":[{"w":"au revoir","ipa":"[o.ʁə.vwaʁ]","approx":"أوغفوار","note":"au تنطق [o] و oi تنطق [wa]"},{"w":"s'il vous plaît","ipa":"[sil vu plɛ]","approx":"سيل فو بليه","note":"تركيب ît ينطق صوتاً مفتوحاً [ɛ]"},{"w":"merci beaucoup","ipa":"[mɛʁ.si bo.ku]","approx":"ميرسي بوكو","note":"eau تنطق [o] و p الأخيرة صامتة"},{"w":"je vous en prie","ipa":"[ʒə vu.z‿ɑ̃ pʁi]","approx":"جو فوزان بري","note":"ربط إلزامي مع z و صوت أنفي /ɑ̃/"},{"w":"excusez-moi","ipa":"[ɛk.sky.ze.mwa]","approx":"إكسكوزيه موا","note":"صوت [y] في ku و [wa] في moi"},{"w":"désolé","ipa":"[de.zɔ.le]","approx":"ديزوليه","note":"صوت [e] ناصع في البداية والنهاية"}],"vocab":[{"fr":"au revoir","ar":"إلى اللقاء / وداعاً","pos":"locution","ipa":"[o.ʁə.vwaʁ]","exFr":"Au revoir et à lundi.","exAr":"إلى اللقاء وإلى يوم الإثنين."},{"fr":"à bientôt","ar":"إلى لقاء قريب","pos":"locution","ipa":"[a bjɛ̃.to]","exFr":"Prends soin de toi, à bientôt.","exAr":"اعتنِ بنفسك، إلى لقاء قريب."},{"fr":"à tout à l'heure","ar":"أراك بعد قليل (في نفس اليوم)","pos":"locution","ipa":"[a tu.t‿a lœʁ]","exFr":"On mange ensemble à midi, à tout à l'heure !","exAr":"سنتناول الغداء معاً ظهراً، أراك بعد قليل!"},{"fr":"à demain","ar":"إلى الغد / أراك غداً","pos":"locution","ipa":"[a də.mɛ̃]","exFr":"Bonne soirée et à demain !","exAr":"أمسية سعيدة وأراك غداً!"},{"fr":"s'il vous plaît","ar":"من فضلك / رجاءً (رسمي)","pos":"locution","ipa":"[sil vu plɛ]","exFr":"L'addition, s'il vous plaît.","exAr":"الحساب، من فضلك."},{"fr":"s'il te plaît","ar":"من فضلك (ودي للأصدقاء)","pos":"locution","ipa":"[sil tə plɛ]","exFr":"Passe-moi le pain, s'il te plaît.","exAr":"ناولني الخبز، من فضلك."},{"fr":"merci","ar":"شكراً","pos":"interjection","ipa":"[mɛʁ.si]","exFr":"Merci pour votre accueil.","exAr":"شكراً على حسن استقبالكم."},{"fr":"de rien","ar":"لا شكر على واجب / عفواً","pos":"locution","ipa":"[də ʁjɛ̃]","exFr":"— Merci ! — De rien.","exAr":"— شكراً! — لا شكر على واجب."},{"fr":"je vous en prie","ar":"عفواً لحضرتك / على الرحب والسعة (راقٍ)","pos":"locution","ipa":"[ʒə vu.z‿ɑ̃ pʁi]","exFr":"— Merci monsieur. — Je vous en prie.","exAr":"— شكراً سيدي. — عفواً لحضرتك."},{"fr":"pardon","ar":"عفواً (للمرور أو حادث عارض)","pos":"interjection","ipa":"[paʁ.dɔ̃]","exFr":"Pardon, je ne vous avais pas vu.","exAr":"عفواً، لم أكن قد رأيتك."},{"fr":"excusez-moi","ar":"اعذرني / المعذرة (لجلب الانتباه)","pos":"locution","ipa":"[ɛk.sky.ze.mwa]","exFr":"Excusez-moi, quelle heure est-il ?","exAr":"المعذرة، كم الساعة الآن؟"},{"fr":"désolé","ar":"آسف / نادم (مذكر)","pos":"adj","g":"m","pl":"désolés","ipa":"[de.zɔ.le]","exFr":"Je suis désolé pour l'erreur.","exAr":"أنا آسف على هذا الخطأ."},{"fr":"désolée","ar":"آسفة / نادمة (مؤنث)","pos":"adj","g":"f","pl":"désolées","ipa":"[de.zɔ.le]","exFr":"Elle est désolée d'être en retard.","exAr":"هي آسفة على التأخر."},{"fr":"avec plaisir","ar":"بكل سرور / برحابة صدر","pos":"locution","ipa":"[a.vɛk plɛ.ziʁ]","exFr":"Je vous aide avec plaisir.","exAr":"أساعدكم بكل سرور."}],"grammar":[{"tAr":"صياغة الطلب المهذب: الشرط الخفيف s'il vous plaît","tFr":"La structure conditionnelle de politesse : si + il + plaît","body":["تتكون عبارة «S'il vous plaît» حرفياً من: si (إذا) + il (ضمير غير شخصي) + plaît (يروق/يعجب) + vous (لحضرتك)، أي: 'إذا كان يروق لحضرتك'.","هذا التعبير يحول أي جملة أمرية جافة إلى طلب لائق اجتماعياً ومقبول تماماً في أي معاملة تجارية أو إدارية.","موضعها: تأتي غالباً في نهاية الجملة بعد الطلب مباشرة، مسبوقة بفاصلة: «Un croissant, s'il vous plaît»."],"ex":[{"fr":"Un billet pour Paris, s'il vous plaît.","ar":"تذكرة إلى باريس، من فضلك."},{"fr":"Répétez, s'il vous plaît.","ar":"أعد الشرح، من فضلك."}]}],"mistakes":[{"wrong":"استخدام 'À tout à l'heure' لتوديع شخص لن تراه إلا الأسبوع القادم","right":"استخدام 'À la semaine prochaine' أو 'À bientôt'","why":"À tout à l'heure تعني حصراً اللقاء بعد قليل في نفس اليوم."},{"wrong":"استخدام 'Pardon' لمحاولة استيقاف شخص في الشارع لسؤاله عن الطريق","right":"استخدام 'Excusez-moi monsieur' لجلب الانتباه أولاً","why":"Excusez-moi هي الصيغة المخصصة للاستئذان وطرح الأسئلة."},{"wrong":"طلب المشروب أو الخدمة دون إرفاقها بـ s'il vous plaît","right":"إنهاء أي طلب بـ 's'il vous plaît'","why":"الطلب بدون هذه العبارة يعتبر في فرنسا أمراً غير لائق ويقابل بالاستياء."}],"dialogues":[{"title":"في محطة القطار مع موظف التذاكر","ctx":"مسافر يشتري تذكرة قطار مستخدماً كافة أدبيات اللباقة والوداع.","lines":[{"who":"L'employé","fr":"Bonjour monsieur, que puis-je faire pour vous ?","ar":"صباح الخير سيدي، ماذا يمكنني أن أفعل من أجلك؟"},{"who":"Le voyageur","fr":"Bonjour. Un billet pour Lyon, s'il vous plaît.","ar":"صباح الخير. تذكرة إلى ليون، من فضلك."},{"who":"L'employé","fr":"Voilà votre billet, monsieur. Le train part voie 4.","ar":"تفضل تذكرتك، سيدي. القطار يغادر من الرصيف 4."},{"who":"Le voyageur","fr":"Merci beaucoup pour votre aide !","ar":"شكراً جزيلاً على مساعدتك!"},{"who":"L'employé","fr":"Je vous en prie. Bon voyage et au revoir !","ar":"عفواً لحضرتك. رحلة موفقة وإلى اللقاء!"},{"who":"Le voyageur","fr":"Au revoir, bonne journée !","ar":"إلى اللقاء، ويوماً سعيداً!"}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما هي العبارة التي تعني 'إلى اللقاء بعد قليل' إذا كنت ستلتقي بزميلك في نفس اليوم؟","opts":["À demain","À tout à l'heure","Au revoir","À la semaine prochaine"],"a":1,"why":"À tout à l'heure مخصصة حصراً للقاء في وقت لاحق من نفس اليوم."},{"t":"mcq","skill":"culture","q":"ما هي العبارة الأكثر رقياً وأدباً في المعاملات الرسمية للرد على كلمة 'Merci'؟","opts":["De rien","Je vous en prie","Salut","Pardon"],"a":1,"why":"Je vous en prie هي العبارة الأرقى والأكثر لياقة في المقام الرسمي."},{"t":"fill","skill":"vocabulary","q":"أكمل العبارة المهذبة للطلب: 'Un café, s'il ___ plaît.'","fr":"Un café, s'il ___ plaît.","ans":"vous","why":"صيغة اللباقة الرسمية المعتمدة هي s'il vous plaît."},{"t":"order","skill":"grammar","q":"رتّب عبارة استئذان شخص في الشارع لطرح سؤال:","words":["Excusez-moi","monsieur,","où","est","le","métro ?"],"why":"جلب الانتباه بالأدب أولاً متبوعاً بأداة الاستفهام والفعل والمبتدأ.","ans":"Excusez-moi monsieur, où est le métro ?"},{"t":"listen","skill":"listening","audio":"Je vous en prie, passez une bonne journée","q":"استمع إلى العبارة وحدد المعنى المقصود منها:","opts":["عفواً لحضرتك، اقضِ يوماً طيباً","شكراً جزيلاً، أنا متعب","أين تسكن يا سيدي؟","أنا أطلب قهوة بالحليب"],"a":0,"why":"Je vous en prie تعني عفواً لحضرتك و bonne journée يوماً طيباً."},{"t":"correct","skill":"culture","q":"صديقان سيلتقيان غداً صباحاً، فقال أحدهما: À la semaine prochaine ! صحح عبارة الوداع:","fr":"À la semaine prochaine !","ans":"À demain !","why":"اللقاء في الغد يتطلب استخدام À demain."},{"t":"writing","skill":"writing","q":"اكتب طلباً مؤدباً تطلب فيه تذكرة قطار إلى باريس مع عبارة اللباقة الرسمية:","min":4,"kw":["billet","paris","plaît"],"sample":"Un billet pour Paris, s'il vous plaît.","why":"صياغة صحيحة للطلب المتكامل بلغة فرنسية سليمة."},{"t":"speaking","skill":"pronunciation","q":"انطق عبارة الرد الراقي على الشكر بنطق سلس وربط متصل كما في الفيديو الرئيسي:","target":"Je vous en prie","why":"تطبيق الربط الصوتي مع صوت z و رنين an الأنفي [ʒə vu.z‿ɑ̃ pʁi]."}],"homework":"قم بتمثيل مشهد قصير تسجل فيه صوتك: تطلب وجبة في مطعم، تستفسر عن الحساب، تشكر النادل باحترام بالغ، وتودعه مع تمنياتك له بأمسية سعيدة، مستخدماً كل ما تعلمته في دروس مسار التحية واللباقة الثلاثة. قبل الدرس التالي (a0-t4-l1): عدّ من 0 إلى 10 بصوت مسموع تمهيداً لدرس الأرقام، مع الإبقاء على عبارات الشكر والاعتذار التي درستها دون إعادة محتواها.","sources":[{"title":"Comment dire AU REVOIR en français ❓ Il y a des NUANCES ❗","channel":"Le français by Alex","why":"مرجع شامل لبيان الفروق بين صيغ الوداع ومستويات اللباقة في التعامل.","videoId":"y9F3i0UAqNA"},{"title":"Comment Dire Merci en Français et que Répondre 🙏🏻","channel":"Français avec Pierre","why":"توسيع درجات الشكر وردودها (Merci وما يقابلها) بما يكمّل قسم الردود على الشكر في هذا الدرس.","videoId":"p9hY24qGvE0"},{"title":"15 façons de dire AU REVOIR","channel":"Guillaume Posé - Professeur de français","why":"خزانة واسعة من بدائل Au revoir تحدّد لكل صيغة مقامها وزمن لقاءها، مفيدة لتمييز À bientôt عن À demain.","videoId":"N_6QE897C9c"}],"supplements":[{"id":"p9hY24qGvE0","title":"Comment Dire Merci en Français et que Répondre 🙏🏻","channel":"Français avec Pierre","why":"توسيع درجات الشكر وردودها (Merci وما يقابلها) بما يكمّل قسم الردود على الشكر في هذا الدرس.","dur":5},{"id":"N_6QE897C9c","title":"15 façons de dire AU REVOIR","channel":"Guillaume Posé - Professeur de français","why":"خزانة واسعة من بدائل Au revoir تحدّد لكل صيغة مقامها وزمن لقاءها، مفيدة لتمييز À bientôt عن À demain.","dur":8}]}]},{"id":"a0-t4","slug":"les-nombres","icon":"users","color":"#2563EB","fr":"Les nombres et la numération","ar":"الأرقام ونظام العد التطبيقي","desc":"الدراسة الفونولوجية والرياضية للأعداد: أسرار الأرقام 0-10 وتغير أصواتها الختامية، الأعداد 11-20 واستخدامها الفوري في العمر والساعة، العشرات حتى 100 وفك شفرة النظام العشري-العشريني التاريخي وأرقام الهواتف.","lessons":[{"id":"A0-t4-l1","fr":"Les chiffres de 0 à 10 et les mutations phonétiques","ar":"الأرقام من 0 إلى 10 وتغيراتها الصوتية الدقيقة","objectives":["إتقان نطق الأرقام من 0 إلى 10 كتابة وصوتاً بالرموز الدولية IPA.","فهم الظاهرة الفونولوجية الفريدة لتغير الصامت الأخير في الأرقام (six, huit, dix).","تطبيق الربط الصوتي للأرقام عند وقوعها قبل حركة علة (deux_amis, six_heures).","التمييز بين un (رقم وأداة تنكير مذكر) و une (مؤنث) كأول ظهور للتأنيث العددي.","استخدام الأرقام في سياقات يومية بسيطة: الحساب في المقهى، الأمتعة، والكميات."],"sections":[{"h":"الأرقام العشرة الأولى: البناء الصوتي والتغيرات اللسانية","p":["تعتبر الأرقام من 0 إلى 10 اللبنات التأسيسية التي يُبنى عليها النظام الرياضي واللغوي الفرنسي بأكمله. في الفرنسية، لا يتحدد نطق الرقم برسمه الكتابي فقط، بل يتأثر بما يليه مباشرة في الجملة:","الأرقام العشرة المعيارية:","• 0 : zéro [ze.ʁo] (يبدأ بصوت زاي مجهور).","• 1 : un [œ̃] (للمذكر المؤنف) / une [yn] (للمؤنث الفموي، وهو الرقم الوحيد الذي يتغير جنسه في الأرقام المفردة!).","• 2 : deux [dø] (حركة أمامية مدورة مع إسقاط حرف X في الوقف).","• 3 : trois [tʁwa] (تركيب OI ينطق [wa] وحرف S صامت في الوقف).","• 4 : quatre [katʁ] (ينطق كافاً صريحة تليه حركة a).","• 5 : cinq [sɛ̃k] (صوت أنفي منبسط [ɛ̃] يليه كاف صريحة).","• 6 : six [sis] (ينتهي بصوت السين في الوقف).","• 7 : sept [sɛt] (حرف P صامت تاريخياً تماماً، ويُنطق فقط s-e-t).","• 8 : huit [ɥit] (يبدأ بصوت /ɥ/ الشفوي دون أي همس للـ H).","• 9 : neuf [nœf] (ينتهي بصوت الفاء الخالص).","• 10 : dix [dis] (ينتهي بصوت السين في الوقف)."],"video":{"id":"Ps6z11X0vZc","title":"Les chiffres de 0 à 10 - prononciation","channel":"FLE Nantes","why":"عرض فونولوجي واضح للأرقام من 0 إلى 10 يركّز على النطق الصحيح والتغيّرات الصوتية، مناسب تماماً للمستوى A0.","dur":4,"lang":"fr","main":true},"sub":[{"h":"الحالات الصوتية الثلاث للأرقام (six, huit, dix)","p":["تتميز الأرقام 6 و 8 و 10 في الفرنسية بوجود ثلاثة وجوه صوتية مختلفة تماماً حسب موضعها في الكلام:","1. الحالة الأولى: الرقم معزولاً أو في نهاية جملة (En fin de phrase) — يُنطق الصامت الأخير كصوت سين كامل أو تاء: six = [sis]، dix = [dis]، huit = [ɥit]. مثال: «J'en ai dix» [dis].","2. الحالة الثانية: الرقم متبوعاً بكلمة تبدأ بحرف ساكن (Devant consonne) — يسقط الصامت الأخير تماماً ويصمت: six livres تُنطق [si li.vʁ] (بدون سين!)، dix tables تُنطق [di tabl] (بدون سين!)، huit jours تُنطق [ɥi ʒuʁ] (بدون تاء!).","3. الحالة الثالثة: الرقم متبوعاً بحرف صوتي (Devant voyelle / Liaison) — يتحول الصامت الأخير إلى صوت زاي مجهور [z] في 6 و 10: six amis تُنطق [si.za.mi]، dix euros تُنطق [di.zø.ʁo]! بينما huit ترتبط بالتاء الصريحة: huit heures [ɥi.tœʁ]."]},{"h":"التحول الخاص بالرقم neuf (تسعة)","p":["الرقم neuf ينتهي طبيعياً بصوت الفاء [nœf] (مثل neuf tables). ولكن في حالتين مخصصتين حصراً ترتبط بمرور الزمن: قبل كلمة «heures» (ساعات) و «ans» (سنوات)، يتحول صوت الفاء وجوباً إلى صوت [v] المجهور لتسهيل النطق اللحني:","«neuf heures» تُنطق بدقة: [nœ.vœʁ] (تسع ساعات).","«neuf ans» تُنطق بدقة: [nœ.vɑ̃] (تسع سنوات)."]}]},{"h":"موضع الرقم في التركيب النحوي الفرنسي","p":["في القواعد النحوية الفرنسية، الرقم صفة عددية (Adjectif numéral) ويأتي دائماً قبل الاسم المعدود مباشرة وبدون فاصل:","«deux cafés» (قهوتان)، «quatre billets» (أربع تذاكر)، «trois personnes» (ثلاثة أشخاص).","الاسم المعدود بعد الأرقام من 2 وما فوق يأخذ دائماً علامة الجمع S في الكتابة، ولكن تذكر أن حرف S الجمع لا ينطق إلا إذا وجد ربط صوتي مع الكلمة التالية!"]},{"h":"التطبيق والتلخيص","p":["يعرض هذا الدرس الأرقام من 0 إلى 10 بمنظور فونولوجي دقيق: النطقات الثلاثة للأرقام six و huit و dix (كاملة في الوقف، ثمّ بصمت الصامت قبل ساكن، ثمّ بالربط بـ [z] أو [t] قبل حرف صوتي)، وتحوّل فاء neuf إلى [v] في neuf heures و neuf ans، مع تقديم الرقم قبل المعدود دون فاصل وخصوصية un و une اللتين تتغيّران بتغيّر الجنس. كما وضح الفيديو الرئيسي (Les chiffres de 0 à 10 - prononciation) لقناة FLE Nantes، نطق الرقم يتغيّر بتغيّر ما يليه في الجملة لا برسمه الكتابي وحده.","تنطلق هذا الدرس من أدبيات a0-t3-l3 (الوداع والشكر والاعتذار): استأذن بـ Excusez-moi، واطلب بلباقة بـ s'il vous plaît قبل عدّ أي رقم أو حساب، واعذر خطأك بـ Pardon أو Désolé إذا أخطأت في العدّ، فالموقف العددي في فرنسية المعاملات موقف لبق أولاً. ثمّ يتّصل بالدرس التالي a0-t4-l2 (من 11 إلى 20 والعمر) الذي يبني الأرقام المركّبة فوق عشرة ويضعها في أوّل سؤال عمر مباشر (Quel âge as-tu ?).","أعد مشاهدة الفيديو الرئيسي وتابع العدّ من 0 إلى 10 مراراً حتى تستقرّ النطقات الثلاثة للأرقام six و huit و dix، ثمّ سجّل نفسك وأنت تعدّ عشرة أشياء من محيطك مع ضبط أداة un/une مع كل معدود، وبعد ذلك استمع إلى الفيديو مجدداً وأنت تعدّ بصوت خافت لمطابعة سرعته ونبرته."]}],"examples":[{"fr":"J'ai deux frères et une sœur.","ar":"لدي أخوان وأخت واحدة.","note":"deux للمذكر والمؤنث، بينما une مؤنثة مخصصة"},{"fr":"Il a dix ans et six mois.","ar":"عمره عشر سنوات وستة أشهر.","note":"ربط dix ans [di.zɑ̃] وسقوط سين six قبل mois [si mwa]"},{"fr":"Un café et deux croissants, s'il vous plaît.","ar":"قهوة واحدة واثنان كرواسون، من فضلك.","note":"تطبيق في طلب المقهى اليومي"},{"fr":"Il est neuf heures du matin.","ar":"الساعة التاسعة صباحاً.","note":"تحول f في neuf إلى [v] عند الربط مع heures"},{"fr":"Sept personnes attendent le bus.","ar":"سبعة أشخاص ينتظرون الحافلة.","note":"حرف P صامت في sept [sɛt]"},{"fr":"Huit jours de vacances en France.","ar":"ثمانية أيام إجازة في فرنسا.","note":"سقوط التاء في huit قبل jours [ɥi ʒuʁ]"},{"fr":"Le numéro de la chambre est le six.","ar":"رقم الغرفة هو ستة.","note":"نطق السين كاملة [sis] في نهاية الجملة"},{"fr":"Quatre saisons dans l'année.","ar":"أربعة فصول في السنة.","note":"quatre تنطق كافاً صريحة [katʁ]"}],"pron":[{"w":"zéro","ipa":"[ze.ʁo]","approx":"زيرو","note":"زاي مجهورة وراء حلقية"},{"w":"un","ipa":"[œ̃]","approx":"آن (أنفية)","note":"صوت أنفي للمذكر"},{"w":"une","ipa":"[yn]","approx":"إين (بضم الشفاه)","note":"صوت [y] يليه نون صريحة للمؤنث"},{"w":"deux","ipa":"[dø]","approx":"دُه","note":"شفتان مدورتان وحرف X صامت"},{"w":"trois","ipa":"[tʁwa]","approx":"تغوا","note":"تركيب oi يلفظ [wa]"},{"w":"quatre","ipa":"[katʁ]","approx":"كاتغ","note":"كاف متبوعة بـ a"},{"w":"cinq","ipa":"[sɛ̃k]","approx":"سانك","note":"أنفي يليه كاف"},{"w":"six","ipa":"[sis]","approx":"سيس","note":"سين كاملة في الوقف"},{"w":"sept","ipa":"[sɛt]","approx":"سيت","note":"حرف P صامت نهائياً"},{"w":"huit","ipa":"[ɥit]","approx":"ويت","note":"يبدأ بـ /ɥ/ وحرف H صامت"},{"w":"neuf","ipa":"[nœf]","approx":"نوف","note":"فاء صريحة في الوقف"},{"w":"dix","ipa":"[dis]","approx":"ديس","note":"سين كاملة في الوقف"}],"vocab":[{"fr":"le chiffre","ar":"الرقم (رمز من 0 إلى 9)","pos":"nom","g":"m","pl":"les chiffres","ipa":"[lə ʃifʁ]","exFr":"Un code à quatre chiffres.","exAr":"رمز سري من أربعة أرقام."},{"fr":"le nombre","ar":"العدد (الكمية الإجمالية)","pos":"nom","g":"m","pl":"les nombres","ipa":"[lə nɔ̃bʁ]","exFr":"Un grand nombre de personnes.","exAr":"عدد كبير من الأشخاص."},{"fr":"zéro","ar":"صفر (0)","pos":"adjectif numéral","ipa":"[ze.ʁo]","exFr":"Zéro degré dehors.","exAr":"صفر مئوي في الخارج."},{"fr":"un","ar":"واحد (1) للمذكر","pos":"adjectif numéral","ipa":"[œ̃]","exFr":"Un euro.","exAr":"يورو واحد."},{"fr":"une","ar":"واحدة (1) للمؤنث","pos":"adjectif numéral","ipa":"[yn]","exFr":"Une table.","exAr":"طاولة واحدة."},{"fr":"deux","ar":"اثنان (2)","pos":"adjectif numéral","ipa":"[dø]","exFr":"Deux cafés.","exAr":"اثنان قهوة."},{"fr":"trois","ar":"ثلاثة (3)","pos":"adjectif numéral","ipa":"[tʁwa]","exFr":"Trois billets.","exAr":"ثلاث تذاكر."},{"fr":"quatre","ar":"أربعة (4)","pos":"adjectif numéral","ipa":"[katʁ]","exFr":"Quatre saisons.","exAr":"أربعة فصول."},{"fr":"cinq","ar":"خمسة (5)","pos":"adjectif numéral","ipa":"[sɛ̃k]","exFr":"Cinq minutes.","exAr":"خمس دقائق."},{"fr":"six","ar":"ستة (6)","pos":"adjectif numéral","ipa":"[sis]","exFr":"Six mois.","exAr":"ستة أشهر."},{"fr":"sept","ar":"سبعة (7)","pos":"adjectif numéral","ipa":"[sɛt]","exFr":"Sept jours.","exAr":"سبعة أيام."},{"fr":"huit","ar":"ثمانية (8)","pos":"adjectif numéral","ipa":"[ɥit]","exFr":"Huit heures.","exAr":"الساعة الثامنة."},{"fr":"neuf","ar":"تسعة (9)","pos":"adjectif numéral","ipa":"[nœf]","exFr":"Neuf ans.","exAr":"تسع سنوات."},{"fr":"dix","ar":"عشرة (10)","pos":"adjectif numéral","ipa":"[dis]","exFr":"Dix euros.","exAr":"عشرة يورو."},{"fr":"l'euro","ar":"اليورو (العملة الأوروبية)","pos":"nom","g":"m","pl":"les euros","ipa":"[l‿ø.ʁo]","exFr":"Ça coûte cinq euros.","exAr":"سعره خمسة يورو."}],"grammar":[{"tAr":"تطابق الرقم مع المعدود: خصوصية un و une","tFr":"L'accord en genre du numéral un / une","body":["في اللغة الفرنسية، جميع الأرقام من 2 إلى ما لا نهاية لا تتغير بتغير جنس المعدود (فهي جامدة invariable): نقول deux hommes و deux femmes، dix garçons و dix filles.","الاستثناء الوحيد في الأرقام المفردة هو الرقم (1):","• مع المعدود المذكر: un [œ̃] (un livre, un café).","• مع المعدود المؤنث: une [yn] (une table, une personne)."],"ex":[{"fr":"Un livre et une pomme.","ar":"كتاب واحد وتفاحة واحدة."},{"fr":"Trois livres et trois pommes.","ar":"ثلاثة كتب وثلاث تفاحات (trois ثابتة لا تتغير)."}]}],"mistakes":[{"wrong":"نطق حرف P في كلمة 'sept' (سبعة) كأنها 'سبت'","right":"sept تُنطق [sɛt] (سيت) مع صموت تام للـ P","why":"حرف P في sept تاريخي لا ينطق إطلاقاً في الفرنسية المعيارية."},{"wrong":"نطق صوت السين في 'six jours' أو 'dix jours'","right":"تُنطق [si ʒuʁ] و [di ʒuʁ] بسقوط السين قبل الساكن","why":"الصامت الأخير في six و dix يسقط صوته تماماً إذا تلته كلمة تبدأ بساكن."},{"wrong":"نطق 'huit' ببدء بالهاء كأنها 'هويت'","right":"huit تُنطق [ɥit] (ويت) لأن H صامت دائماً","why":"حرف H لا صوت له وتبدأ الكلمة مباشرة بحركة /ɥ/ الشفوية."}],"dialogues":[{"title":"في المقهى الباريسي ودفع الحساب","ctx":"زبون يطلب الحساب في مقهى ويدفع باليورو مستخدماً الأرقام الأساسية.","lines":[{"who":"Le client","fr":"S'il vous plaît, l'addition pour la table numéro six.","ar":"من فضلك، الحساب للطاولة رقم ستة."},{"who":"Le serveur","fr":"Oui monsieur : deux cafés et un croissant, cela fait cinq euros.","ar":"نعم سيدي: اثنان قهوة وكرواسون واحد، الحساب خمسة يورو."},{"who":"Le client","fr":"Voilà un billet de dix euros.","ar":"تفضل ورقة نقدية من فئة عشرة يورو."},{"who":"Le serveur","fr":"Merci, et voici cinq euros de monnaie. Bonne journée !","ar":"شكراً، وتفضل خمسة يورو الباقي. يوماً سعيداً!"},{"who":"Le client","fr":"Merci beaucoup, au revoir !","ar":"شكراً جزيلاً، إلى اللقاء!"}]}],"exercises":[{"t":"mcq","skill":"pronunciation","q":"كيف ينطق الرقم 'six' في عبارة 'six livres' (ستة كتب)؟","opts":["[sis] مع نطق السين","[si] بدون نطق السين نهائياً","[siz] بصوت زاي","[sik] بصوت كاف"],"a":1,"why":"الصامت الأخير في six يسقط نطقاً إذا تلته كلمة تبدأ بساكن (livres)."},{"t":"mcq","skill":"reading","q":"أي من الحروف في كلمة 'sept' (7) يُعتبر صامتاً ولا ينطق إطلاقاً؟","opts":["حرف S","حرف E","حرف P","حرف T"],"a":2,"why":"حرف P في كلمة sept صامت تاريخياً وتنطق الكلمة [sɛt]."},{"t":"fill","skill":"grammar","q":"اختر أداة العدد الصحيحة: 'J'ai ___ voiture.' (un أو une)","fr":"J'ai ___ voiture.","ans":"une","why":"كلمة voiture مؤنثة، فتأخذ أداة التأنيث العددي une."},{"t":"order","skill":"grammar","q":"رتّب كلمات العبارة الحسابية التالية:","words":["L'addition","fait","exactement","huit","euros."],"why":"الترتيب النحوي: فاعل معرف + فعل + ظرف + صفة عددية + تمييز معدود.","ans":"L'addition fait exactement huit euros."},{"t":"listen","skill":"listening","audio":"Il a dix amis à Paris.","q":"استمع إلى الجملة: كيف نُطق الرقم dix عند ارتباطه بكلمة amis؟","opts":["بصوت زاي [di.z‿a.mi]","بصوت سين [dis a.mi]","بدون أي صوت ختامي [di a.mi]","بصوت تاء [dit a.mi]"],"a":0,"why":"حرف x في dix يتحول وجوباً إلى صوت [z] عند الربط الصوتي مع حركة العلة التالية."},{"t":"correct","skill":"grammar","q":"صحح خطأ مطابقة العدد مع المؤنث: 'Il a un maison à Lyon.'","fr":"Il a un maison à Lyon.","ans":"Il a une maison à Lyon.","why":"maison اسم مؤنث ويجب استخدام une معه."},{"t":"writing","skill":"writing","q":"اكتب بالفرنسية جملة تطلب فيها 'طاولة لشخصين من فضلك' مستخدماً deux personnes:","min":4,"kw":["table","deux","personnes","plaît"],"sample":"Une table pour deux personnes, s'il vous plaît.","why":"توظيف الأرقام في مواقف تواصلية واقعية بمطعم أو فندق."},{"t":"speaking","skill":"pronunciation","q":"انطق الأرقام الأربعة التالية بصوت واضح كما نطقها الفيديو الرئيسي:","target":"deux, quatre, six, huit","why":"ضبط النطق الصوتي المتتالي للأرقام الزوجية الأساسية."}],"homework":"قم بعدّ 10 أشياء من غرفتك باللغة الفرنسية بصوت مسموع من 1 إلى 10، مع كتابة قائمة بهذه الأشياء متضمنة الرقم واسم الشيء (مثال: un lit, deux chaises, trois livres, quatre stylos...). احرص على التأنيث مع une والتذكير مع un. قبل الدرس التالي (a0-t4-l2): تدرّب على سؤال العمر (Quel âge as-tu ?) بالاعتماد على الأرقام من 0 إلى 10 فقط، وراجع عبارة اللباقة s'il vous plaît من a0-t3-l3 قبل السؤال.","sources":[{"title":"Les chiffres de 0 à 10 - prononciation","channel":"FLE Nantes","why":"شرح فونولوجي مبسط يوضّح نطق الأرقام 0-10 وتغيّراتها مع الصامت والمتحرك.","videoId":"Ps6z11X0vZc"},{"title":"Prononciation des nombres de 1 à 10, seuls ou accompagnés d'un nom.","channel":"A Cup of French","why":"تدريب على نطق الأرقام منفردةً ومع اسم بعدها، وهو جوهري لفهم تغيّر الصامت الأخير والربط الصوتي.","videoId":"_DiHFmq22ww"},{"title":"🇫🇷  Les chiffres en français de 0 à 10 (part 1)","channel":"Prononciation avec Christophe","why":"شرح متدرّج للأرقام من 0 إلى 10 مع كتابتها بالحروف (العدد كتابةً) وضبط نطقها.","videoId":"Avp2KnqAgaA"}],"supplements":[{"id":"_DiHFmq22ww","title":"Prononciation des nombres de 1 à 10, seuls ou accompagnés d'un nom.","channel":"A Cup of French","why":"تدريب على نطق الأرقام منفردةً ومع اسم بعدها، وهو جوهري لفهم تغيّر الصامت الأخير والربط الصوتي.","dur":8},{"id":"Avp2KnqAgaA","title":"🇫🇷  Les chiffres en français de 0 à 10 (part 1)","channel":"Prononciation avec Christophe","why":"شرح متدرّج للأرقام من 0 إلى 10 مع كتابتها بالحروف (العدد كتابةً) وضبط نطقها.","dur":7}]},{"id":"A0-t4-l2","fr":"Les nombres de 11 à 20 et l'expression de l'âge","ar":"الأعداد من 11 إلى 20 والتعبير عن العمر والوقت","objectives":["إتقان الأعداد من 11 إلى 20 وفهم بنيتها الصرفية التاريخية المستمدة من اللاتينية.","التمييز بين الأعداد البسيطة ذات النهاية -ze (من 11 إلى 16) والأعداد المركبة الجمعية (17 إلى 19).","استيعاب التعبير الأكاديمي عن العمر في الفرنسية باستخدام فعل الملكية Avoir بدلاً من الكينونة.","تطبيق الأعداد في مواقف الساعة والمواعيد اليومية (Il est 15 heures).","صياغة سؤال وجواب مكتملين حول العمر وتاريخ الميلاد."],"sections":[{"h":"بنية الأعداد من 11 إلى 20: من البساطة اللاتينية إلى التركيب","p":["تتميز الأعداد من 11 إلى 20 في الفرنسية بانقسام بنيتها إلى مجموعتين لغويتين تعكسان التاريخ الصرفي للغة اللاتينية:","المجموعة الأولى: الأعداد من 11 إلى 16 (النهاية الصامتة -ZE):","• 11 : onze [ɔ̃z] (مقطع أنفي يليه زاي مجهورة).","• 12 : douze [duz] (حركة [u] المضمومة تليها زاي).","• 13 : treize [tʁɛz] (حركة [ɛ] المفتوحة تليها زاي).","• 14 : quatorze [ka.tɔʁz].","• 15 : quinze [kɛ̃z] (حركة أنفية منبسطة [ɛ̃] تليها زاي).","• 16 : seize [sɛz] (حركة [ɛ] المفتوحة تليها زاي).","المجموعة الثانية: الأعداد من 17 إلى 19 (التركيب الجمعي بالعشرات):","تتحول اللغة إلى صياغة تركيبية صريحة تربط كلمة dix (10) بالرقم المفرد عبر شرطة وصل (Trait d'union):","• 17 : dix-sept [dis.sɛt] (حرفياً: 10 + 7، مع نطق السين في dix والتاء في sept!).","• 18 : dix-huit [di.zɥit] (حرفياً: 10 + 8، مع ربط إلزامي ينطق x كصوت زاي [z]!).","• 19 : dix-neuf [diz.nœf] (حرفياً: 10 + 9، مع تحول x إلى زاي مجهورة أمام نون neuf!).","• 20 : vingt [vɛ̃] (حركة أنفية خالصة [ɛ̃] مع صموت تام لحرفي G و T في الوقف)."],"video":{"id":"1uoJrVIJXqY","title":"الأعداد بالفرنسية من 1 إلى 20 بالكتابة والنطق","channel":"الأنيس","why":"عرض بصري يربط بين الرسم الكتابي والنطق الصوتي لجميع أعداد 11-20.","dur":5,"lang":"ar","main":true},"sub":[{"h":"التعبير الأكاديمي عن العمر: ثنائية Avoir مقابل Be الإنجليزية","p":["من أهم الفروق التركيبية بين الفرنسية واللغات الجرمانية والإنجليزية: في الفرنسية لا نستخدم فعل الكينونة للتعبير عن العمر (خطأ فادح أن تقول: Je suis 20 ans كما في الإنجليزية I am 20 years old).","في الفلسفة اللغوية الفرنسية، العمر يُعدّ 'رصيداً زمنياً يمتلكه الإنسان'، لذا يُستخدم حصراً فعل الملكية «Avoir» متبوعاً بالرقم وكلمة «ans» (سنوات) إلزامياً:","• القاعدة: Sujet + Avoir (au présent) + Nombre + ans.","• «J'ai dix-huit ans» [ʒe di.zɥi.tɑ̃] (حرفياً: أنا أملك ثماني عشرة سنة).","• «Il a quinze ans» [i.l‿a kɛ̃.zɑ̃] (هو عمره خمس عشرة سنة).","ملاحظة فونولوجية هامة: كلمة ans تبدأ بحرف علة، لذا يقع ربط إلزامي دائماً بين الرقم و ans: dix-huit_ans [di.zɥi.tɑ̃]."]},{"h":"السؤال عن العمر بالفرنسية (Demander l'âge)","p":["صيغة السؤال عن العمر الرسمية والمألوفة:","• بصيغة الاحترام (Vous): «Quel âge avez-vous ?» [kɛ.l‿ɑ.ʒ‿a.ve.vu].","• بصيغة الود والتعارف (Tu): «Quel âge as-tu ?» [kɛ.l‿ɑ.ʒ‿a.ty] أو بالترتيب اليومي «Tu as quel âge ?»."]}]},{"h":"استخدام الأعداد في توقيت الساعة والمواعيد","p":["في نظام التوقيت الرسمي الفرنسي (ساعات اليوم 24)، تُستخدم الأعداد من 11 إلى 20 يومياً للتعبير عن مواعيد القطارات، العمل، وحصص الدراسة:","«Il est quatorze heures» (الساعة الرابعة عشرة = الثانية بعد الظهر).","«Le train part à seize heures trente» (القطار يغادر في الرابعة والنصف عصراً)."]},{"h":"التطبيق والتلخيص","p":["يحرّك هذا الدرس المتعلّم في المدى الوظيفي الأول من سلّم الأعداد الفرنسية: فبنيّة الأعداد من 11 إلى 20 تنقسم تاريخياً إلى أعداد بسيطة منتهية بالصامت المركّب -ZE (onze، douze، treize، quatorze، quinze، seize) وأعداد مركّبة بالعشرة تربط dix بالآحاد بشرطة وصل (dix-sept، dix-huit، dix-neuf)، ويتوقّف الرقم 20 عند vingt بحرفيه الصامتين في الوقف. كما وضح الفيديو الرئيسي «الأعداد بالفرنسية من 1 إلى 20 بالكتابة والنطق» كل رقم ببطء مرئي وسمعي، يضيف هذا الدرس الطبقة التركيبية الثانية: التعبير عن العمر حصراً بفعل الملكية Avoir متبوعاً بـ ans (J'ai dix-huit ans) بدلاً من فعل الكينونة، وتطبيق الأرقام في توقيت الساعة الرسمي (Il est quatorze heures).","يقوم هذا الدرس استناداً مباشرةً على ما أتقنته في a0-t4-l1: فكل تركيبة من 17 إلى 19 هي dix (10) المأخوذة من درس الأرقام العشرة الأولى مع الآحاد (sept، huit، neuf)، وصيغة «J'ai ... ans» هي امتداد عملي لأرقام عمرك في a0-t4-l1 بعشرات أعلى. ويُهيّئ هذا الدرس الطالب لدرس a0-t4-l3 الذي يرفع السقف من vingt إلى cent عبر العشرات (trente إلى soixante) ثم النظام العشريني الغالي في 70 و 80 و 90، مع قراءة أسعار اليورو وأرقام الهواتف الفرنسية.","المهمة التطبيقية: أعد مشاهدة الفيديو الرئيسي، وأوقفه بعد كل رقم لتركبه بالحروف ثم تنطقه مرتين؛ وبعدها سجّل نفسك وأنت تجيب عن سؤالين بصوتك دون ورقة: «Quel âge avez-vous ?» بصيغة Avoir + ans، و«Il est quelle heure ?» مستخدماً أرقام 11 إلى 20، ثم استمع للتسجيل وصحّح فقط ما نطقته خطأً وأعد التسجيل مرة واحدة."]}],"examples":[{"fr":"Quel âge avez-vous ? — J'ai vingt ans.","ar":"كم عمر حضرتك؟ — عمري عشرون سنة.","note":"السؤال مع فعل avoir والرد مع vingt ans [vɛ̃.tɑ̃]"},{"fr":"Mon frère a quinze ans.","ar":"أخي عمره خمس عشرة سنة.","note":"quinze مع ربط ans: [kɛ̃.zɑ̃]"},{"fr":"Le rendez-vous est à quatorze heures.","ar":"الموعد في الساعة الثانية بعد الظهر (14:00).","note":"نظام التوقيت الرسمي"},{"fr":"Il y a douze mois dans une année.","ar":"يوجد اثنا عشر شهراً في السنة.","note":"douze mois [duz mwa]"},{"fr":"La chambre numéro seize est libre.","ar":"الغرفة رقم 16 شاغرة.","note":"رقم الغرفة seize [sɛz]"},{"fr":"Elle a dix-sept ans aujourd'hui.","ar":"عمرها سبع عشرة سنة اليوم.","note":"dix-sept [dis.sɛt] مع شرطة الوصل"},{"fr":"J'attends depuis dix-huit minutes.","ar":"أنتظر منذ ثماني عشرة دقيقة.","note":"dix-huit [di.zɥit] بربط الزاي"},{"fr":"Nous avons onze questions à traiter.","ar":"لدينا إحدى عشرة مسألة لنعالجها.","note":"onze [ɔ̃z]"}],"pron":[{"w":"onze","ipa":"[ɔ̃z]","approx":"أونز","note":"رنين أنفي /ɔ̃/ يليه زاي مجهورة"},{"w":"douze","ipa":"[duz]","approx":"دوز","note":"صوت [u] ممدود يليه زاي"},{"w":"treize","ipa":"[tʁɛz]","approx":"تريز","note":"صوت مفتوح [ɛ] يليه زاي"},{"w":"quatorze","ipa":"[ka.tɔʁz]","approx":"كاتوغز","note":"مقطعان: ka يليه tɔʁz"},{"w":"quinze","ipa":"[kɛ̃z]","approx":"كانز (أنفية)","note":"رنين أنفي منبسط يليه زاي"},{"w":"seize","ipa":"[sɛz]","approx":"سيز","note":"صوت [s] يليه [ɛz]"},{"w":"dix-sept","ipa":"[dis.sɛt]","approx":"ديس-سيت","note":"نطق حرف السين في dix والتاء في sept"},{"w":"dix-huit","ipa":"[di.zɥit]","approx":"دي-زويت","note":"ربط x كـ [z] وصموت حرف h"},{"w":"vingt","ipa":"[vɛ̃]","approx":"فان (أنفية)","note":"صموت حرفي g و t في الوقف"}],"vocab":[{"fr":"l'âge","ar":"العمر / السن","pos":"nom","g":"m","pl":"les âges","ipa":"[l‿ɑʒ]","exFr":"L'âge de la majorité est 18 ans.","exAr":"سن الرشد هو 18 سنة."},{"fr":"l'an","ar":"العام / السنة","pos":"nom","g":"m","pl":"les ans","ipa":"[l‿ɑ̃]","exFr":"Il a vingt ans.","exAr":"عمره عشرون سنة."},{"fr":"l'année","ar":"السنة (كمدة وامتداد)","pos":"nom","g":"f","pl":"les années","ipa":"[l‿a.ne]","exFr":"Une bonne année !","exAr":"عام سعيد!"},{"fr":"l'heure","ar":"الساعة (كتوقيت ومدة)","pos":"nom","g":"f","pl":"les heures","ipa":"[l‿œʁ]","exFr":"Il est midi, l'heure du déjeuner.","exAr":"إنها الظهيرة، موعد الغداء."},{"fr":"onze","ar":"أحد عشر (11)","pos":"adjectif numéral","ipa":"[ɔ̃z]","exFr":"Onze joueurs.","exAr":"أحد عشر لاعباً."},{"fr":"douze","ar":"اثنا عشر (12)","pos":"adjectif numéral","ipa":"[duz]","exFr":"Douze mois.","exAr":"اثنا عشر شهراً."},{"fr":"treize","ar":"ثلاثة عشر (13)","pos":"adjectif numéral","ipa":"[tʁɛz]","exFr":"Le treize du mois.","exAr":"اليوم الثالث عشر من الشهر."},{"fr":"quatorze","ar":"أربعة عشر (14)","pos":"adjectif numéral","ipa":"[ka.tɔʁz]","exFr":"Quatorze jours.","exAr":"أربعة عشر يوماً."},{"fr":"quinze","ar":"خمسة عشر (15)","pos":"adjectif numéral","ipa":"[kɛ̃z]","exFr":"Quinze minutes.","exAr":"خمس عشرة دقيقة."},{"fr":"seize","ar":"ستة عشر (16)","pos":"adjectif numéral","ipa":"[sɛz]","exFr":"Seize ans.","exAr":"ست عشرة سنة."},{"fr":"dix-sept","ar":"سبعة عشر (17)","pos":"adjectif numéral","ipa":"[dis.sɛt]","exFr":"Dix-sept élèves.","exAr":"سبعة عشر تلميذاً."},{"fr":"dix-huit","ar":"ثمانية عشر (18)","pos":"adjectif numéral","ipa":"[di.zɥit]","exFr":"Dix-huit ans.","exAr":"ثماني عشرة سنة."},{"fr":"dix-neuf","ar":"تسعة عشر (19)","pos":"adjectif numéral","ipa":"[diz.nœf]","exFr":"Dix-neuf pages.","exAr":"تسع عشرة صفحة."},{"fr":"vingt","ar":"عشرون (20)","pos":"adjectif numéral","ipa":"[vɛ̃]","exFr":"Vingt euros.","exAr":"عشرون يورو."}],"grammar":[{"tAr":"صياغة جملة العمر بفعل Avoir الحصري","tFr":"La structure grammaticale de l'âge : Sujet + Avoir + Nombre + ans","body":["تذكر دائماً أن معادلة العمر في الفرنسية هي: فاعل + فعل يملك (Avoir) + عدد السنوات + كلمة ans.","تصريف فعل Avoir في الحاضر مع الضمائر المفردة:","• J'ai (أنا أملك) → J'ai 19 ans.","• Tu as (أنت تملك) → Tu as quel âge ?","• Il a / Elle a (هو/هي تملك) → Elle a 16 ans.","لا يجوز إطلاقاً حذف كلمة «ans» في نهاية الجملة: في الإنجليزية يمكنك قول 'I am 20'، ولكن بالفرنسية مستحيل قول 'J'ai 20' بمفردها بل يجب إتمامها بـ 'J'ai 20 ans'."],"ex":[{"fr":"J'ai dix-huit ans.","ar":"عمري ثمانية عشر عاماً."},{"fr":"Mon ami a seize ans.","ar":"صديقي عمره ستة عشر عاماً."}]}],"mistakes":[{"wrong":"قول 'Je suis vingt ans' مثل الإنجليزية I am 20 years old","right":"J'ai vingt ans (باستخدام فعل Avoir)","why":"العمر في الفرنسية يعبر عنه بـ 'أملك كذا سنة' وليس بفعل الكينونة."},{"wrong":"حذف كلمة ans والقول: 'J'ai vingt'","right":"J'ai vingt ans (مع ذكر ans وجوباً)","why":"حذف ans يجعل الجملة ناقصة المعنى في المعايير الفرنسية."},{"wrong":"كتابة dix sept أو dix huit بدون شرطة وصل","right":"dix-sept, dix-huit (مع trait d'union)","why":"الأعداد المركبة في الفرنسية ترتبط بشرطة وصل إملائية واجبة."}],"dialogues":[{"title":"استمارة التسجيل الجامعي والسؤال عن العمر","ctx":"مسؤول التسجيل في الجامعة يستفسر من طالب جديد عن عمره وتاريخ ميلاده.","lines":[{"who":"L'agent","fr":"Bonjour. Quel est votre prénom et quel âge avez-vous ?","ar":"صباح الخير. ما هو اسمك الشخصي وكم عمر حضرتك؟"},{"who":"L'étudiant","fr":"Bonjour. Je m'appelle Yassine et j'ai dix-neuf ans.","ar":"صباح الخير. اسمي ياسين وعمري تسعة عشر عاماً."},{"who":"L'agent","fr":"Très bien. Vous êtes né quel jour ?","ar":"ممتاز جداً. في أي يوم ولدت؟"},{"who":"L'étudiant","fr":"Le quatorze mai.","ar":"في الرابع عشر من شهر مايو."},{"who":"L'agent","fr":"Parfait Yassine, votre dossier pour la chambre numéro douze est validé.","ar":"ممتاز ياسين، ملفك للغرفة رقم اثني عشر تم اعتماده."}]}],"exercises":[{"t":"mcq","skill":"grammar","q":"ما هو الفعل الصحيح المستخدم للتعبير عن العمر بالفرنسية في جملة 'عمري 18 سنة'؟","opts":["فعل الكينونة être (Je suis 18 ans)","فعل الملكية avoir (J'ai 18 ans)","فعل يمضي aller (Je vais 18 ans)","فعل يعمل faire (Je fais 18 ans)"],"a":1,"why":"العمر بالفرنسية يعبر عنه حصراً بفعل الملكية Avoir متبوعاً بـ ans."},{"t":"mcq","skill":"reading","q":"كم يساوي العدد 'dix-huit' في النظام الرقمي؟","opts":["16","17","18","19"],"a":2,"why":"dix-huit يمثل تركيب dix (10) + huit (8) أي 18."},{"t":"fill","skill":"grammar","q":"أكمل الجملة التعبيرية عن العمر: 'Mon frère ___ quinze ans.'","fr":"Mon frère ___ quinze ans.","ans":"a","why":"تصريف فعل avoir مع الغائب المفرد (mon frère = il) هو a."},{"t":"order","skill":"grammar","q":"رتّب كلمات الجملة المعبرة عن السن والعمر:","words":["J'ai","exactement","dix-neuf","ans","aujourd'hui."],"why":"فاعل وفعل + ظرف + عدد مركب + تمييز ans + ظرف زمان.","ans":"J'ai exactement dix-neuf ans aujourd'hui."},{"t":"listen","skill":"listening","audio":"Le train part à quatorze heures","q":"استمع إلى الموعد وحدد ساعة انطلاق القطار:","opts":["الساعة 12:00 ظهراً","الساعة 14:00 (الثانية بعد الظهر)","الساعة 16:00 عصراً","الساعة 18:00 مساءً"],"a":1,"why":"quatorze heures تعني الساعة الرابعة عشرة (الثانية بعد الظهر)."},{"t":"correct","skill":"grammar","q":"صحح الخطأ الإنجليزي في التعبير عن العمر: 'Je suis 17 ans.'","fr":"Je suis 17 ans.","ans":"J'ai 17 ans.","why":"يجب استبدال فعل être بفعل avoir: J'ai 17 ans."},{"t":"writing","skill":"writing","q":"اكتب جملة كاملة بالفرنسية تعبر فيها عن عمرك الحقيقي أو التقديري (مثال: 20 سنة):","min":4,"kw":["j'ai","ans"],"sample":"J'ai vingt ans.","why":"صياغة جملة العمر المتكاملة وفق المعادلة اللغوية الصحيحة."},{"t":"speaking","skill":"pronunciation","q":"انطق الجملة التالية مطبقاً الربط الصوتي في [di.zɥi.tɑ̃]:","target":"J'ai dix-huit ans.","why":"ربط dix-huit مع ans بصوت التاء الصريح: [di.zɥi.tɑ̃]."}],"homework":"اكتب أعمار 4 من أفراد عائلتك أو أصدقائك في جمل فرنسية كاملة (مثال: Mon père a... ans, Ma sœur a... ans) مستخدماً الأرقام بالحروف الفرنسية حصراً، ثم سجّل قراءتها صوتياً مع العناية التامة بالربط الصوتي مع كلمة ans. قبل الدرس التالي (a0-t4-l3): راجع أعدادك من 0 إلى 20 في a0-t4-l1 و a0-t4-l2 كتابةً ونطقاً، فكامل العشرات والمركّبات حتى 100 يعتمد على هذه الأرقام أساساً.","sources":[{"title":"الأعداد بالفرنسية من 1 إلى 20 بالكتابة والنطق","channel":"الأنيس","why":"مرجع بصري يربط بين نطق وكتابة الأعداد 11-20 بالترتيب.","videoId":"1uoJrVIJXqY"},{"title":"French Numbers 1 to 20 (French Essentials Lesson 2)","channel":"Learn French With Alexa","why":"مراجعة متكاملة للأعداد من 1 إلى 20 بخطوات أساسية متدرجة تثبّت 11-20 بعد الفيديو الرئيسي — من أشهر قنوات تدريس الفرنسية كلغة أجنبية.","videoId":"H2-REbL2OU0"},{"title":"French for beginners : Dire et demander l'âge en français","channel":"French with Sana","why":"درس قصير مخصّص حصراً للتعبير عن العمر واسئلته، يطابق مباشرةً معادلة Avoir + ans المعلّمة في الفيديو الرئيسي لهذا الدرس.","videoId":"mUc4fKEBZvM"}],"supplements":[{"id":"H2-REbL2OU0","title":"French Numbers 1 to 20 (French Essentials Lesson 2)","channel":"Learn French With Alexa","why":"مراجعة متكاملة للأعداد من 1 إلى 20 بخطوات أساسية متدرجة تثبّت 11-20 بعد الفيديو الرئيسي — من أشهر قنوات تدريس الفرنسية كلغة أجنبية.","dur":8,"lang":"en"},{"id":"mUc4fKEBZvM","title":"French for beginners : Dire et demander l'âge en français","channel":"French with Sana","why":"درس قصير مخصّص حصراً للتعبير عن العمر واسئلته، يطابق مباشرةً معادلة Avoir + ans المعلّمة في الفيديو الرئيسي لهذا الدرس.","dur":4,"lang":"fr"}]},{"id":"A0-t4-l3","fr":"Les dizaines jusqu'à 100 et le système vicésimal gaulois","ar":"العشرات حتى المئة، النظام العشري-العشريني، وأرقام الهواتف","objectives":["إتقان العشرات الفرنسية (20 إلى 100) وفهم التكوين الصرفي لكل منها.","فك اللغز التاريخي للنظام العشريني الغالي (Le système vicésimal) في 70 و 80 و 90.","تطبيق قواعد الإملاء الفرنسية الخاصة بأداة الربط 'et un' واستخدام شرطة الوصل (Trait d'union).","إتقان قراءة الأسعار باليورو والسنتيم في المعاملات اليومية.","قراءة أرقام الهواتف الفرنسية المكونة من 10 أرقام بالنظام الزوجي الشفهي المعتمد."],"sections":[{"h":"العشرات الأساسية حتى الستين: النظام العشري المنتظم","p":["حتى الرقم 60، تتبع اللغة الفرنسية نظاماً عشرياً قياسياً وبسيطاً مستمداً مباشرة من جذور اللاتينية:","• 20 : vingt [vɛ̃] (صامتان نهائيان muets).","• 30 : trente [tʁɑ̃t] (صوت أنفي مفتوح /ɑ̃/).","• 40 : quarante [ka.ʁɑ̃t].","• 50 : cinquante [sɛ̃.kɑ̃t] (صوت أنفي منبسط يليه صوت أنفي مفتوح).","• 60 : soixante [swa.sɑ̃t] (حرف x ينطق كصوت السين [s] الصريح!).","قاعدة الآحاد مع العشرات: في الأرقام التي تنتهي بواحد (21, 31, 41, 51, 61)، نضع أداة الربط «et» بين العشرات والواحد: «vingt et un» [vɛ̃.t‿e œ̃], «trente et un» [tʁɑ̃.t‿e œ̃].","أما من الرقم 2 إلى 9، فنستغني عن et ونضع شرطة وصل إملائية فقط: «vingt-deux» [vɛ̃t.dø], «vingt-trois», «quarante-cinq»."],"video":{"id":"CEx2fPn-_UE","title":"French numbers 1-100 — أليكسا تفكك أرقام 70 و 80 و 90","channel":"Learn French With Alexa","why":"الشرح الأفضل على الإطلاق لفهم وتجاوز عقدة أرقام 70 و 80 و 90 في الفرنسية.","dur":11,"lang":"en","main":true},"sub":[{"h":"السر التاريخي لأرقام 70 و 80 و 90: تركة قبائل الغال العشرينية","p":["يتفاجأ جميع متعلمي الفرنسية في العالم عندما يكتشفون أن 70 ليست كلمة مفردة، بل هي «soixante-dix» (ستون وعشرة)، وأن 80 هي «quatre-vingts» (أربع عشرينات = 4 × 20)، وأن 90 هي «quatre-vingt-dix» (أربع عشرينات وعشرة = 80 + 10)!","التعليل الأكاديمي التاريخي: عندما غزا الرومان بلاد الغال (فرنسا القديمة)، كان السكان الأصليون (Les Gaulois) يعدون بنظام قائم على قاعدة الرقم 20 (Système vicésimal) - لأن الإنسان يعد بأصابع يديه ورجليه معاً (20 أصبعاً)! ورغم أن الفرنسية تبنت اللاتينية، بقيت بقايا هذا النظام الرياضي القديم حية في الأرقام 70 و 80 و 90.","تفاصيل الحساب الدقيق:","• 70 : soixante-dix (60 + 10) ← 71 : soixante et onze (60 + 11) ← 72 : soixante-douze (60 + 12)... حتى 79 : soixante-dix-neuf (60 + 19).","• 80 : quatre-vingts (4 × 20) ← لاحظ أن vingt تأخذ S الجمع فقط عندما تكون 80 بمفردها! وتسقط S بمجرد أن يليها رقم: 81 : quatre-vingt-un (بدون s وبدون et!).","• 90 : quatre-vingt-dix (80 + 10) ← 91 : quatre-vingt-onze (80 + 11) ← 92 : quatre-vingt-douze... حتى 99 : quatre-vingt-dix-neuf.","• 100 : cent [sɑ̃] (حرفا n و t صامتان كصوامت مستقلة، وتُنطق كحركة أنفية مفتوحة خالصة)."]},{"h":"قراءة أرقام الهواتف الفرنسية (Le numéro de téléphone)","p":["يتكون رقم الهاتف الفرنسي دائماً من 10 أرقام تبدأ عادة بـ 06 أو 07 للهواتف المحمولة، أو 01 إلى 05 للخطوط الأرضية حسب المنطقة.","العرف الثقافي الفرنسي في قراءة الهاتف: لا يقرأ الفرنسيون أرقام الهواتف رقماً برقم أبداً، بل يقرؤونها دائماً على شكل «خمسة أزواج من العشرات» (Par paires de deux chiffres):","مثال: الرقم 06 12 34 56 78 يُقرأ هكذا:","«Zéro six (06) — douze (12) — trente-quatre (34) — cinquante-six (56) — soixante-dix-huit (78)».","إتقان الأرقام حتى 100 شرط أساسي لفهم وتدوين أرقام الهواتف في فرنسا!"]}]},{"h":"الأسعار والمعاملات النقدية (Les prix en euros)","p":["تستخدم فرنسا عملة اليورو (€ Euro) والوحدة الأصغر السنتيم (Centime).","في القراءة الشفهية للسعر، يُذكر رقم اليورو متبوعاً بكلمة euro ثم عدد السنتيمات:","• 25 € يُقرأ: «vingt-cinq euros» [vɛ̃t.sɛ̃.k‿ø.ʁo].","• 49,90 € يُقرأ: «quarante-neuf euros quatre-vingt-dix» (أو باقتضاب «quarante-neuf quatre-vingt-dix»)."]},{"h":"التطبيق والتلخيص","p":["يُتمّ هذا الدرس سلّم الأعداد الفرنسية الكامل حتى المئة: فبعد النظام العشري المنتظم من trente إلى soixante — الذي يضع أداة العطف et حصراً مع الآحاد 1 (vingt et un، quarante et un...) — تُفكَّك عقدة النظام العشريني الغالي: 70 = soixante-dix (60 + 10)، و 80 = quatre-vingts (4 × 20 مع s الجمع الاصطلاحي الذي تسقط بمجرد مجيء رقم بعدها)، و 90 = quatre-vingt-dix (80 + 10)، حتى 100 = cent بصوت أنفي خالص. كما وضح الفيديو الرئيسي «French numbers 1-100» مع أليكسا كيفية تفكيك هذه الأرقام غير المنطقية ظاهرياً بمنطق حسابي واضح، يضيف هذا الدرس الإطار الاستعمالي: قراءة الأسعار باليورو والسنتيم، وقراءة أرقام الهواتف الفرنسية العشرية أزواجاً من العشرات كما يفرض العرف الثقافي الفرنسي (zéro six, douze, trente-quatre...).","يبني هذا الدرس كلياً على أساس a0-t4-l2: فكل تركيبة من 71 إلى 99 تعيد استعمال الأعداد من 11 إلى 19 التي أتقنتها هناك (soixante et onze، quatre-vingt-dix-neuf، quatre-vingt-douze...)، ومعادلة العمر بفعل Avoir هي نفسها المعادلة المعلّمة في a0-t4-l2 بعشرات مرفوعة (Elle a cinquante-cinq ans). وبعد إتقان الأرقام والعنوان والهاتف، تنتقل السلسلة إلى a0-t5-l1 الذي يفتح تبويب الجمل والهوية: التعريف بالنفس والجنسية والمهنة والحالات بعد أن صار رصيدك الرقمي مكتملاً.","المهمة التطبيقية: أعد مشاهدة الجزء المخصّص لـ 70 و 80 و 90 في الفيديو الرئيسي ثلاث مرات متتالية، ثم سجّل نفسك وأنت تقرأ بالحروف الفرنسية خمسة أرقام تختارها عشوائياً من 61 إلى 99 (مثال: 72، 81، 90، 95، 99) متتبّعاً قواعد الشرطة و et un وسقوط s في quatre-vingts؛ وأخيراً اقرأ رقم هاتف مكوّن من 10 أرقام مقسّماً خمسة أزواج من العشرات كما يفعل الفرنسيون فعلاً."]}],"examples":[{"fr":"Le livre coûte soixante-dix euros.","ar":"الكتاب سعره سبعون يورو.","note":"soixante-dix = 60 + 10 = 70"},{"fr":"Mon grand-père a quatre-vingts ans.","ar":"جدي عمره ثمانون عاماً.","note":"s الجمع في quatre-vingts لأنها منتهية بـ 80"},{"fr":"Quatre-vingt-deux personnes sont présentes.","ar":"اثنان وثمانون شخصاً حاضرون.","note":"سقوط s من vingt عند مجيء رقم بعدها (82)"},{"fr":"C'est quatre-vingt-dix-neuf euros.","ar":"السعر تسعة وتسعون يورو.","note":"99 = 80 + 19"},{"fr":"Mon numéro est le zéro six, vingt et un, quarante, cinquante, soixante.","ar":"رقمي هو 06 21 40 50 60.","note":"القراءة الثنائية لأرقام الهاتف"},{"fr":"Il y a cent pages dans ce document.","ar":"يوجد مئة صفحة في هذا المستند.","note":"cent [sɑ̃] بصوت أنفي"},{"fr":"Le billet coûte trente et un euros.","ar":"التذكرة سعرها واحد وثلاثون يورو.","note":"استخدام et un مع 31"},{"fr":"Elle a cinquante-cinq ans.","ar":"عمرها خمس وخمسون سنة.","note":"شرطة الوصل في الأعداد المركبة"}],"pron":[{"w":"vingt","ipa":"[vɛ̃]","approx":"فان (أنفية)","note":"g و t صامتتان"},{"w":"trente","ipa":"[tʁɑ̃t]","approx":"تغونت","note":"أنفي مفتوح يليه تاء"},{"w":"quarante","ipa":"[ka.ʁɑ̃t]","approx":"كاغونت","note":"كاف ثم راء وأنفي"},{"w":"cinquante","ipa":"[sɛ̃.kɑ̃t]","approx":"سانكونت","note":"أنفي منبسط ثم أنفي مفتوح"},{"w":"soixante","ipa":"[swa.sɑ̃t]","approx":"سواسونت","note":"حرف x ينطق كصوت السين [s]"},{"w":"soixante-dix","ipa":"[swa.sɑ̃t.dis]","approx":"سواسونت-ديس","note":"60 + 10 = 70"},{"w":"quatre-vingts","ipa":"[katʁ.vɛ̃]","approx":"كاتغ-فان","note":"4 × 20 = 80"},{"w":"quatre-vingt-dix","ipa":"[katʁ.vɛ̃.dis]","approx":"كاتغ-فان-ديس","note":"80 + 10 = 90"},{"w":"cent","ipa":"[sɑ̃]","approx":"صان (أنفية)","note":"100 بصوت أنفي نقي"}],"vocab":[{"fr":"trente","ar":"ثلاثون (30)","pos":"adjectif numéral","ipa":"[tʁɑ̃t]","exFr":"Trente jours.","exAr":"ثلاثون يوماً."},{"fr":"quarante","ar":"أربعون (40)","pos":"adjectif numéral","ipa":"[ka.ʁɑ̃t]","exFr":"Quarante ans.","exAr":"أربعون عاماً."},{"fr":"cinquante","ar":"خمسون (50)","pos":"adjectif numéral","ipa":"[sɛ̃.kɑ̃t]","exFr":"Cinquante pour cent.","exAr":"خمسون بالمئة."},{"fr":"soixante","ar":"ستون (60)","pos":"adjectif numéral","ipa":"[swa.sɑ̃t]","exFr":"Soixante secondes.","exAr":"ستون ثانية."},{"fr":"soixante-dix","ar":"سبعون (70)","pos":"adjectif numéral","ipa":"[swa.sɑ̃t.dis]","exFr":"Soixante-dix euros.","exAr":"سبعون يورو."},{"fr":"quatre-vingts","ar":"ثمانون (80)","pos":"adjectif numéral","ipa":"[katʁ.vɛ̃]","exFr":"Quatre-vingts invités.","exAr":"ثمانون ضيفاً."},{"fr":"quatre-vingt-dix","ar":"تسعون (90)","pos":"adjectif numéral","ipa":"[katʁ.vɛ̃.dis]","exFr":"Quatre-vingt-dix pour cent.","exAr":"تسعون بالمئة."},{"fr":"cent","ar":"مئة (100)","pos":"adjectif numéral","ipa":"[sɑ̃]","exFr":"Cent pour cent.","exAr":"مئة بالمئة."},{"fr":"le prix","ar":"السعر / الثمن","pos":"nom","g":"m","pl":"les prix","ipa":"[lə pʁi]","exFr":"Quel est le prix ?","exAr":"ما هو السعر؟"},{"fr":"coûter","ar":"يُكلّف / يبلغ سعره","pos":"verbe","ipa":"[ku.te]","exFr":"Ça coûte cher.","exAr":"هذا يكلف ثمناً غالياً."},{"fr":"le numéro de téléphone","ar":"رقم الهاتف","pos":"nom","g":"m","pl":"les numéros de téléphone","ipa":"[lə ny.me.ʁo də te.le.fɔn]","exFr":"Quel est votre numéro de téléphone ?","exAr":"ما هو رقم هاتفك؟"},{"fr":"quatre-vingt-un","ar":"واحد وثمانون (81)","pos":"adjectif numéral","ipa":"[katʁ.vɛ̃ œ̃]","exFr":"Quatre-vingt-un invités.","exAr":"واحد وثمانون ضيفاً."}],"grammar":[{"tAr":"أحكام كتابة الشرطة (Trait d'union) وأداة et","tFr":"L'orthographe des nombres composés : tiret et conjonction","body":["القاعدة الكلاسيكية: توضع أداة العطف «et» حصراً مع الآحاد رقم 1 في الأعداد من 21 إلى 71: vingt et un (21), trente et un (31), quarante et un (41), cinquante et un (51), soixante et un (61), soixante et onze (71).","في المقابل، الرقم 81 يشذ عن القاعدة ولا يأخذ et إطلاقاً: يُكتب «quatre-vingt-un» بشرطة وصل مباشرة!","جميع الأرقام المركبة الأخرى تربط وجوباً بشرطة وصل (trait d'union): soixante-cinq (65), quatre-vingt-douze (92)."],"ex":[{"fr":"Vingt et un [vɛ̃.t‿e œ̃]","ar":"واحد وعشرون (مع أداة et)"},{"fr":"Quatre-vingt-un [katʁ.vɛ̃ œ̃]","ar":"واحد وثمانون (بدون et ومع شرطة وصل)"}]}],"mistakes":[{"wrong":"كتابة soixante et dix للرقم 70","right":"soixante-dix (بشرطة وصل وبدون et)","why":"الرقم 70 مركب مباشر 60+10 بدون أداة العطف et."},{"wrong":"وضع s الجمع في كلمة vingt في الرقم 85: quatre-vingts-cinq","right":"quatre-vingt-cinq (بدون s)","why":"حرف s يسقط من vingt في 80 بمجرد أن يليها أي رقم آخر."},{"wrong":"نطق أرقام الهواتف رقماً برقم مثل 0-6-1-2","right":"نطقها أزواجاً من العشرات: zéro six, douze...","why":"العرف الثقافي الفرنسي المعياري يقرأ الهواتف أزواجاً من العشرات."}],"dialogues":[{"title":"تبادل أرقام الهواتف وتسجيل رقم للتواصل","ctx":"شخصان يتعارفان ويتبادلان أرقام الهواتف الفرنسية بصيغة الأزواج المعتمدة.","lines":[{"who":"Thomas","fr":"Quel est ton numéro de téléphone pour rester en contact ?","ar":"ما هو رقم هاتفك لنبقى على تواصل؟"},{"who":"Karim","fr":"C'est le 06 72 84 91 30. Tu as de quoi noter ?","ar":"هو 06 72 84 91 30. هل معك ما تدون به؟"},{"who":"Thomas","fr":"Attends : zéro six... soixante-douze (72)... quatre-vingt-quatre (84)...","ar":"انتظر: صفر ستة... 72... 84..."},{"who":"Karim","fr":"...quatre-vingt-onze (91), et trente (30) !","ar":"...91، و 30!"},{"who":"Thomas","fr":"Parfait, je t'envoie un message tout de suite !","ar":"ممتاز، سأرسل لك رسالة فوراً!"}]}],"exercises":[{"t":"mcq","skill":"grammar","q":"ما هو التكوين الحسابي للرقم 'soixante-dix' (70) في الفرنسية؟","opts":["7 × 10","60 + 10","50 + 20","80 - 10"],"a":1,"why":"soixante-dix مركب حرفياً من 60 (soixante) و 10 (dix)."},{"t":"mcq","skill":"reading","q":"ما هو الرقم المقابل لعبارة 'quatre-vingt-dix' بالفرنسية؟","opts":["80","90","70","100"],"a":1,"why":"quatre-vingt-dix تعني 80 + 10 وتساوي 90."},{"t":"fill","skill":"vocabulary","q":"أكمل الرقم 71 بالحروف الفرنسية: soixante et ___.","fr":"soixante et ___","ans":"onze","why":"الرقم 71 يبنى من 60 + 11 أي soixante et onze."},{"t":"order","skill":"grammar","q":"رتّب كلمات العدد 99 بالحروف الفرنسية:","words":["quatre-vingt-dix-neuf"],"why":"99 يكتب بكلمة مركبة واحدة مربوطة بالشرطات: quatre-vingt-dix-neuf.","ans":"quatre-vingt-dix-neuf"},{"t":"listen","skill":"listening","audio":"Ça coûte quatre-vingts euros","q":"استمع إلى السعر وحدد المبلغ باليورو:","opts":["40 يورو","60 يورو","80 يورو","90 يورو"],"a":2,"why":"quatre-vingts euros تعني 80 يورو."},{"t":"correct","skill":"grammar","q":"صحح الخطأ الإملائي في كتابة الرقم 80: 'quatre vingt'","fr":"quatre vingt","ans":"quatre-vingts","why":"يجب وضع شرطة وصل وحرف s الجمع في نهاية vingt: quatre-vingts."},{"t":"writing","skill":"writing","q":"اكتب جملة بسيطة تذكر فيها أن سعر الشيء هو 50 يورو مستخدماً coûte و cinquante euros:","min":4,"kw":["coûte","cinquante","euros"],"sample":"Ça coûte cinquante euros.","why":"تطبيق عملي لصياغة السعر باستخدام العشرات والعملة."},{"t":"speaking","skill":"pronunciation","q":"انطق بصوت واضح ومتصل الأعداد الثلاثة المركبة الشائعة التالية:","target":"soixante-dix, quatre-vingts, cent","why":"إتقان مخارج 70 و 80 و 100 بالفرنسية."}],"homework":"اكتب رقم هاتفك الشخصي (أو رقماً افتراضياً من 10 أرقام) بالحروف الفرنسية مقسماً إلى 5 أزواج من العشرات، وتدرب على قراءته شفهياً 5 مرات متتالية حتى تنطقه بسلاسة وسرعة طبيعية دون تردد. قبل الدرس التالي (a0-t5-l1): تأكّد من إتقانك للعشرات من 20 إلى 100 وأزواج قراءة الهاتف، ثم انتقل بثقة إلى تبويب الجمل a0-t5 مع التعريف بالنفس.","sources":[{"title":"French numbers 1-100 — أليكسا تفكك أرقام 70 و 80 و 90","channel":"Learn French With Alexa","why":"شرح تفكيكي مبسّط وعلمي لأرقام 70 و 80 و 90 ولنظام العد الشامل حتى 100.","videoId":"CEx2fPn-_UE"},{"title":"Les Nombres en Français sont ILLOGIQUES ! 70, 80, 90 expliqués enfin","channel":"EzeeFrench","why":"شرح بصري ممتع ومختصر لعقدة 70 و 80 و 90 وللأسرار الكامنة وراء النظام العشريني — يدعم الشرح الأكاديمي التاريخي للفيديو الرئيسي.","videoId":"y2w2QIig0kY"},{"title":"French Lesson - NUMBERS 1-100 - Compter jusqu'à 100 - Learn French","channel":"The French Minute","why":"عدّ متتالٍ كامل من 1 إلى 100 بسرعة مناسبة للتقليد والحفظ النهائي للعشرات بعد فهم قواعدها.","videoId":"Ij3fpaHnWs0"}],"supplements":[{"id":"y2w2QIig0kY","title":"Les Nombres en Français sont ILLOGIQUES ! 70, 80, 90 expliqués enfin","channel":"EzeeFrench","why":"شرح بصري ممتع ومختصر لعقدة 70 و 80 و 90 وللأسرار الكامنة وراء النظام العشريني — يدعم الشرح الأكاديمي التاريخي للفيديو الرئيسي.","dur":7,"lang":"fr"},{"id":"Ij3fpaHnWs0","title":"French Lesson - NUMBERS 1-100 - Compter jusqu'à 100 - Learn French","channel":"The French Minute","why":"عدّ متتالٍ كامل من 1 إلى 100 بسرعة مناسبة للتقليد والحفظ النهائي للعشرات بعد فهم قواعدها.","dur":6,"lang":"fr"}]}]},{"id":"a0-t5","slug":"tes-premieres-phrases","icon":"mic","color":"#4F46E5","fr":"Tes premières phrases et la syntaxe","ar":"أول جملك بالفرنسية وبناء الهوية","desc":"تتويج المستوى التأسيسي A0: تقديم النفس كاملاً (الاسم، الجنسية، المدينة، المهنة)، استراتيجيات النجاة اللغوية والسؤال عن المعنى والنفي الأكاديمي، وهندسة الجملة الفرنسية البسيطة عبر الركيزتين الخالدتين: Être و Avoir.","lessons":[{"id":"A0-t5-l1","fr":"La présentation de soi complète et l'expression de l'identité","ar":"التعريف بالنفس، الهوية، والجنسية المتكاملة","objectives":["إتقان أركان التعريف بالنفس الأربعة: الاسم، الجنسية، المدينة، والمهنة.","استيعاب تصريف الفعل الضميري s'appeler في المضارع مع ضمائر المفرد الثلاثة.","تطبيق قاعدة إسقاط أداة التعريف والتنكير أمام صفات الجنسية والمهن بعد فعل الكينونة.","التفريق بين صفة الجنسية للمذكر والمؤنث (français / française, marocain / marocaine).","إنتاج فقرة تعريفية متماسكة ومترابطة من 5 جمل فرنسية دون أي خطأ تركيبي."],"sections":[{"h":"أركان التعريف بالنفس الأربعة باللغة الفرنسية","p":["لتعريف نفسك بالفرنسية في موقف تعارف رسمي أو اجتماعي، تعتمد اللغة بنية معيارية واضحة تتكون من أربعة محاور تركيبية متسلسلة:","1. الاسم (Le nom) باستخدام الفعل الضميري s'appeler:","  «Je m'appelle Karim» [ʒə ma.pɛl ka.ʁim] (حرفياً: أنا أُدعى كريم). أو بالصيغة الاسمية: «Mon prénom est Karim et mon nom est Kasmi».","2. الجنسية والأصل (La nationalité et l'origine):","  «Je suis marocain» (أنا مغربي) / «Je suis marocaine» (أنا مغربية). أو بذكر بلد القدوم: «Je viens d'Algérie» / «Je viens d'Égypte».","3. مكان الإقامة (Le lieu de résidence):","  «J'habite à Paris» [ʒa.bi.t‿a pa.ʁi] (أنا أسكن في باريس — حرف الجر «à» للمدن دائماً، مع إسقاط e من Je أمام الحرف الصوتي لتصبح J'habite!).","4. المهنة والنشاط (La profession):","  «Je suis étudiant» [ʒə sɥi.z‿e.ty.djɑ̃] (أنا طالب) / «Je suis ingénieur» (أنا مهندس)."],"video":{"id":"fqZB-BXJD_Q","title":"تعلم الفرنسية من الصفر للمبتدئين — الدرس الأول 1: تركيب الجمل بإحترافية","channel":"Learn English & French with Asmae","why":"تأسيس تركيبي رائع يعلمك كيف تبني أول جملة كاملة بالعربية وباحترافية.","dur":20,"lang":"ar","main":true},"sub":[{"h":"تصريف الفعل الضميري s'appeler (يُدعى / يُسمى)","p":["فعل s'appeler هو فعل ذو ضميرين (Verbe pronominal)؛ يتغير ضميره الانعكاسي بتغير الفاعل، وتتضاعف فيه اللام (LL) مع جميع الضمائر المفردة لتظل الحركة مفتوحة [ɛ]:","• Je m'appelle [ʒə ma.pɛl] (أنا اسمي)","• Tu t'appelles [ty ta.pɛl] (أنتَ / أنتِ اسمك)","• Il s'appelle [il sa.pɛl] (هو اسمه)","• Elle s'appelle [ɛl sa.pɛl] (هي اسمها)","• بصيغة الاحترام: Vous vous appelez [vu vu.z‿a.ple] (مع لام واحدة لأن النبر انتقل إلى النهاية ez!)."]},{"h":"القاعدة الأكاديمية: لا أداة بعد فعل Être مع المهن والجنسيات","p":["من الأخطاء الكبرى المتأثرة بالإنجليزية قول 'Je suis un étudiant' (ترجمة حرفية لـ I am a student).","في القواعد الفرنسية، المهن والجنسيات بعد فعل الكينونة Être تُعامل معاملة الصفات المباشرة وتسقط منها أداة النكرة (un / une) تماماً:","• الصحيح: «Je suis étudiant» (بدون un).","• الصحيح: «Je suis professeur» (بدون un).","• الصحيح: «Je suis égyptien» (بدون un)."]}]},{"h":"تأنيث صفات الجنسية (Le féminin des nationalités)","p":["تؤنث صفات الجنسية في الفرنسية كقاعدة عامة بإضافة حرف «e» صامت في النهاية، مما يؤدي فونولوجياً إلى إنطاق الحرف الساكن الأخير الذي كان صامتاً في المذكر:","• français [fʁɑ̃.sɛ] (مذكر - s صامتة) ← française [fʁɑ̃.sɛz] (مؤنث - s تنطق زياً مجهوراً [z]!).","• marocain [ma.ʁɔ.kɛ̃] (مذكر - صوت أنفي) ← marocaine [ma.ʁɔ.kɛn] (مؤنث - صوت فموي ونون صريحة!).","• algérien [al.ʒe.ʁjɛ̃] (مذكر - أنفي) ← algérienne [al.ʒe.ʁjɛn] (مؤنث - مضاعفة النون مع [ɛn] صريحة!)."]},{"h":"التطبيق والتلخيص","p":["يُجسّد هذا الدرس هوية المتعلّم باللغة الفرنسية عبر الأركان الأربعة المتسلسلة: الاسم بفعل s'appeler الضميري (Je m'appelle...)، الجنسية بصفة تابعة جنسياً للمتكلم (marocain / marocaine) أو بلد الأصل بـ «Je viens de...»، مكان الإقامة بحرف الجر à للمدن مع إسقاط e من Je (J'habite à...)، والمهنة مباشرةً بعد فعل الكينونة Être بلا أداة نكرة (Je suis étudiant). كما وضح الفيديو الرئيسي «تعلم الفرنسية من الصفر للمبتدئين — الدرس الأول 1» كيف تُبنى أول جملة فرنسية كاملة بتخطيط احترافي من البداية، يمنح هذا الدرس المفردات والقواعد اللازمة لتلك الجملة من واقع معرفة المتعلّم بنفسه، بما في ذلك قاعدة إسقاط الأداة أمام المهن والجنسيات وتأنيث صفات الجنسية.","يتأسّس هذا الدرس على أدبيات تبويب a0-t3: فالتعارف في المجتمع الفرنكوفوني يبدأ بتحية المناسبة الصحيحة (راجع a0-t3-l1 و a0-t3-l2 مع تفاصيل Tu / Vous) ثم يُعرّف بنفسك فوراً، فاجعل التحية من a0-t3 مقدمة جملك الأولى هنا. ويُهيّئ هذا الدرس الطالب لدرس a0-t5-l2 الذي يضيف طبقة النجاة والنفي البسيط (ne...pas) لتتمكن من إعلان عدم الفهم وطلب الإعادة بعده أن قدّمت نفسك بالفعل.","المهمة التطبيقية: أعد مشاهدة الفيديو الرئيسي، وأوقفه عند كل نموذج جملة وردّده بصوت مسموع باسمك وجنسيتك ومدينتك الحقيقية؛ ثم سجّل مقطعاً صوتياً من 20 ثانية تقدّم فيه نفسك بالكامل (s'appeler + الجنسية + الإقامة + المهنة) مستحضراً قاعدة عدم الأداة بعد Être، وقارن نطقك بالنموذج المعروض في الفيديو قبل إعادة التسجيل مرة واحدة فقط."]}],"examples":[{"fr":"Je m'appelle Karim, je suis tunisien.","ar":"اسمي كريم، أنا تونسي.","note":"الاسم والجنسية بدون أداة"},{"fr":"Elle s'appelle Sarah, elle est architecte.","ar":"اسمها سارة، هي مهندسة معمارية.","note":"المهنة بدون أداة بعد فعل être"},{"fr":"J'habite à Paris et je parle arabe et français.","ar":"أسكن في باريس وأتحدث العربية والفرنسية.","note":"حرف الجر à للمدن واللغات بدون أداة بعد parler"},{"fr":"Comment vous appelez-vous ? — Je m'appelle Paul.","ar":"ما اسم حضرتك؟ — اسمي بول.","note":"صيغة السؤال الرسمي والرد"},{"fr":"Tu t'appelles comment ? — Je m'appelle Thomas.","ar":"ما اسمك؟ — اسمي توما.","note":"صيغة السؤال الودي بين الشباب"},{"fr":"Il est français mais il habite au Caire.","ar":"هو فرنسي ولكنه يسكن في القاهرة.","note":"الجنسية والإقامة"},{"fr":"Je suis étudiant à l'université.","ar":"أنا طالب في الجامعة.","note":"توصيف الصفة والنشاط"},{"fr":"Enchanté de faire votre connaissance !","ar":"تشرفت بمعرفة حضرتك!","note":"عبارة المجاملة بعد التعارف"}],"pron":[{"w":"je m'appelle","ipa":"[ʒə ma.pɛl]","approx":"جو مابيل","note":"إلغاء e في me مع صامت صوتي"},{"w":"je suis","ipa":"[ʒə sɥi]","approx":"جو سوي","note":"حرف s الأخير صامت تماماً"},{"w":"j'habite","ipa":"[ʒa.bit]","approx":"جابيت","note":"صموت حرف h وارتباط تام"},{"w":"étudiant","ipa":"[e.ty.djɑ̃]","approx":"إيتوديان (أنفية)","note":"حرف t الأخير صامت"},{"w":"étudiante","ipa":"[e.ty.djɑ̃t]","approx":"إيتوديانت","note":"حرف t ينطق بفضل e التأنيث"},{"w":"enchanté","ipa":"[ɑ̃.ʃɑ̃.te]","approx":"أونشانتيه","note":"صوتان أنفيان مفتوحان متبوعان بـ [te]"}],"vocab":[{"fr":"s'appeler","ar":"يُدعى / يُسمى","pos":"verbe","ipa":"[sa.ple]","exFr":"Il s'appelle Lucas.","exAr":"هو اسمه لوكاس."},{"fr":"habiter","ar":"يسكن / يقيم","pos":"verbe","ipa":"[a.bi.te]","exFr":"J'habite en France.","exAr":"أسكن في فرنسا."},{"fr":"être","ar":"يكون (فعل الكينونة)","pos":"verbe","ipa":"[ɛtʁ]","exFr":"Je suis ici.","exAr":"أنا هنا."},{"fr":"l'étudiant","ar":"الطالب (مذكر)","pos":"nom","g":"m","pl":"les étudiants","ipa":"[l‿e.ty.djɑ̃]","exFr":"L'étudiant étudie à la bibliothèque.","exAr":"الطالب يدرس في المكتبة."},{"fr":"l'étudiante","ar":"الطالبة (مؤنث)","pos":"nom","g":"f","pl":"les étudiantes","ipa":"[l‿e.ty.djɑ̃t]","exFr":"Elle est une brillante étudiante.","exAr":"هي طالبة متفوقة."},{"fr":"la profession","ar":"المهنة / العمل","pos":"nom","g":"f","pl":"les professions","ipa":"[la pʁɔ.fɛ.sjɔ̃]","exFr":"Quelle est votre profession ?","exAr":"ما هي مهنتك؟"},{"fr":"la ville","ar":"المدينة","pos":"nom","g":"f","pl":"les villes","ipa":"[la vil]","exFr":"Paris est une grande ville.","exAr":"باريس مدينة كبيرة."},{"fr":"le pays","ar":"البلد / الوطن","pos":"nom","g":"m","pl":"les pays","ipa":"[lə pe.i]","exFr":"La France est un beau pays.","exAr":"فرنسا بلد جميل."},{"fr":"enchanté","ar":"تشرّفت بمعرفتك (للمتكلم المذكر)","pos":"adj","g":"m","ipa":"[ɑ̃.ʃɑ̃.te]","exFr":"Enchanté, monsieur !","exAr":"تشرفت بمعرفتك، سيدي!"},{"fr":"enchantée","ar":"تشرّفت بمعرفتك (للمتكلمة المؤنثة)","pos":"adj","g":"f","ipa":"[ɑ̃.ʃɑ̃.te]","exFr":"Enchantée de vous rencontrer.","exAr":"تشرفت بلقائكم."},{"fr":"marocain","ar":"مغربي (مذكر)","pos":"adj","g":"m","pl":"marocains","ipa":"[ma.ʁɔ.kɛ̃]","exFr":"Il est marocain.","exAr":"هو مغربي."},{"fr":"marocaine","ar":"مغربية (مؤنث)","pos":"adj","g":"f","pl":"marocaines","ipa":"[ma.ʁɔ.kɛn]","exFr":"Elle est marocaine.","exAr":"هي مغربية."},{"fr":"égyptien","ar":"مصري (مذكر)","pos":"adj","g":"m","pl":"égyptiens","ipa":"[e.ʒip.sjɛ̃]","exFr":"Je suis égyptien.","exAr":"أنا مصري."},{"fr":"égyptienne","ar":"مصرية (مؤنث)","pos":"adj","g":"f","pl":"égyptiennes","ipa":"[e.ʒip.sjɛn]","exFr":"Elle est égyptienne.","exAr":"هي مصرية."}],"grammar":[{"tAr":"تصريف الفعلين التأسيسيين: s'appeler و être مع المفرد","tFr":"Conjugaison au présent : s'appeler et être (singulier)","body":["تصريف s'appeler (يُدعى):","• Je m'appelle [ʒə ma.pɛl]","• Tu t'appelles [ty ta.pɛl]","• Il / Elle s'appelle [il / ɛl sa.pɛl]","تصريف être (يكون):","• Je suis [ʒə sɥi]","• Tu es [ty ɛ]","• Il / Elle est [i.l‿ɛ / ɛ.l‿ɛ]"],"ex":[{"fr":"Je m'appelle Rami et je suis professeur.","ar":"اسمي رامي وأنا أستاذ."},{"fr":"Tu es étudiant à Paris.","ar":"أنت طالب في باريس."}]}],"mistakes":[{"wrong":"قول 'Je suis un étudiant' بوضع أداة un قبل المهنة","right":"Je suis étudiant (بدون أداة)","why":"المهن بعد فعل الكينونة être تعامل كصفات ولا تسبقها أدوات نكرة."},{"wrong":"قول 'Je appelle Ahmed' بنسيان الضمير m'","right":"Je m'appelle Ahmed (بإثبات m' الانعكاسي)","why":"الفعل ضميري ولا يجوز فصله عن ضميره الانعكاسي me المختصر إلى m'."},{"wrong":"قول فتاة: 'Je suis algérien' بصيغة المذكر","right":"Je suis algérienne (بصيغة المؤنث)","why":"صفة الجنسية تتبع جنس المتكلم وجوباً."}],"dialogues":[{"title":"التعارف الأول في المعهد اللغوي بباريس","ctx":"طالبان يلتقيان في اليوم الأول من الدورة التدريبية ويتعارفان.","lines":[{"who":"Lucas","fr":"Bonjour ! Je m'appelle Lucas, je suis français. Et toi ?","ar":"صباح الخير! اسمي لوكاس، أنا فرنسي. وأنت؟"},{"who":"Amine","fr":"Bonjour Lucas. Moi, je m'appelle Amine. Je suis marocain.","ar":"صباح الخير لوكاس. أنا اسمي أمين. أنا مغربي."},{"who":"Lucas","fr":"Enchanté Amine ! Tu habites où à Paris ?","ar":"تشرفت بمعرفتك يا أمين! أين تسكن في باريس؟"},{"who":"Amine","fr":"J'habite près de l'université. Je suis étudiant en informatique.","ar":"أسكن بالقرب من الجامعة. أنا طالب في علوم الحاسب."},{"who":"Lucas","fr":"Super ! Bienvenue à Paris alors !","ar":"رائع جداً! مرحباً بك في باريس إذن!"}]}],"exercises":[{"t":"mcq","skill":"grammar","q":"ما هي الجملة الصحيحة لغوياً للتعريف بالمهنة؟","opts":["Je suis un professeur.","Je suis professeur.","Je m'appelle professeur.","J'ai professeur."],"a":1,"why":"تسقط أداة النكرة un/une أمام أسماء المهن بعد فعل الكينونة être."},{"t":"mcq","skill":"grammar","q":"كيف تصوغ فتاة جنسيتها إذا كانت من تونس؟","opts":["Je suis tunisien.","Je suis tunisienne.","Je m'appelle Tunisie.","J'ai tunisienne."],"a":1,"why":"صفة الجنسية تؤنث بإضافة e ومضاعفة النون: tunisienne."},{"t":"fill","skill":"grammar","q":"أكمل الجملة بحرف الجر الصحيح للمدن: 'J'habite ___ Paris.'","fr":"J'habite ___ Paris.","ans":"à","why":"المدن تأخذ دائماً حرف الجر à بالعلامة."},{"t":"order","skill":"grammar","q":"رتّب كلمات جملة التعريف بالنفس المتكاملة:","words":["Je","m'appelle","Sami","et","je","suis","étudiant."],"why":"الجملة المركبة: فاعل وفعل واسم + حرف عطف + فاعل وفعل كينونة ومهنة.","ans":"Je m'appelle Sami et je suis étudiant."},{"t":"listen","skill":"listening","audio":"Enchanté de faire votre connaissance","q":"استمع إلى العبارة وحدد معناها الاجتماعي الدقيق:","opts":["تشرفت بمعرفة حضرتك","إلى اللقاء غداً","عفواً من فضلك","أنا أبحث عن القطار"],"a":0,"why":"Enchanté de faire votre connaissance تعني تشرفت بمعرفتك."},{"t":"correct","skill":"grammar","q":"صحح الخطأ في الجملة التالية: 'Je m'appelle un ingénieur.'","fr":"Je m'appelle un ingénieur.","ans":"Je suis ingénieur.","why":"المهنة يعبر عنها بفعل être وليس s'appeler، وبدون أداة un."},{"t":"writing","skill":"writing","q":"اكتب فقرة قصيرة من 3 جمل تعرف فيها بنفسك: اسمك، جنسيتك، والمدينة التي تسكن فيها:","min":9,"kw":["m'appelle","suis","habite"],"sample":"Je m'appelle Karim. Je suis marocain. J'habite à Rabat.","why":"تطبيق متكامل لأركان التعريف بالنفس الأساسية."},{"t":"speaking","skill":"pronunciation","q":"انطق جملتك التعريفية بصوت واضح وواثق:","target":"Je m'appelle Karim et je suis étudiant.","why":"التدريب على ربط الكلمات وسلامة نطق الضمائر والأفعال."}],"homework":"اكتب بطاقة هويتك الكاملة بالفرنسية تضم 4 أسطر: (الاسم واللقب، العمر باستخدام فعل avoir، الجنسية والمهنة بدون أداة، والمدينة مع حرف الجر à)، ثم سجّل مقطعاً صوتياً تقرأ فيه هذه البطاقة في 20 ثانية بطلاقة ودون توقف. قبل الدرس التالي (a0-t5-l2): احفظ بطاقة هويتك من a0-t5-l1 عن ظهر قلب وسجّلها مجدداً بنبرة صديق جديد، مستحضراً التحية المناسبة من a0-t3 قبل جملتك الأولى.","sources":[{"title":"تعلم الفرنسية من الصفر للمبتدئين — الدرس الأول 1: تركيب الجمل بإحترافية","channel":"Learn English & French with Asmae","why":"شرح عربي تأسيسي لتركيب الجمل والتعريف بالنفس من البداية.","videoId":"fqZB-BXJD_Q"},{"title":"Je me présente. Savoir se présenter en français. Niveau A1 de FLE - Delf A1 - English subtitles !","channel":"La prof Elisabeth","why":"عرض عملي لنفس أركان هذا الدرس (الاسم والجنسية والمهنة) بمستوى A1 — يصلح للتقليد والمقارنة مع نموذجك الشخصي.","videoId":"fpC0KhjGkMM"},{"title":"Se présenter en français - Dire son nom (Niveau débutant A1)","channel":"Francisation - FLE","why":"تركيز مكثّف على صيغ الاسم واللقب مع التهجئة الفرنسية القياسية — مكمّل عربي-فرنسي موجّه للمبتدئ لدرس التعريف بالنفس.","videoId":"BFZeLq10Zjg"}],"supplements":[{"id":"fpC0KhjGkMM","title":"Je me présente. Savoir se présenter en français. Niveau A1 de FLE - Delf A1 - English subtitles !","channel":"La prof Elisabeth","why":"عرض عملي لنفس أركان هذا الدرس (الاسم والجنسية والمهنة) بمستوى A1 — يصلح للتقليد والمقارنة مع نموذجك الشخصي.","dur":4,"lang":"fr"},{"id":"BFZeLq10Zjg","title":"Se présenter en français - Dire son nom (Niveau débutant A1)","channel":"Francisation - FLE","why":"تركيز مكثّف على صيغ الاسم واللقب مع التهجئة الفرنسية القياسية — مكمّل عربي-فرنسي موجّه للمبتدئ لدرس التعريف بالنفس.","dur":3,"lang":"fr"}]},{"id":"A0-t5-l2","fr":"Les stratégies de survie linguistique et la négation simple","ar":"عبارات النجاة، التواصل الذاتي، وقاعدة النفي البسيط","objectives":["إتقان عبارات النجاة الأساسية السبع للتصرف في أي موقف لغوي طارئ بفرنسا.","استيعاب مهارة الاستفسار الميتالغوي (Demander le sens : Qu'est-ce que ça veut dire ?).","طلب التمهل والإعادة بأدب جم (Pouvez-vous répéter ? Plus lentement, s'il vous plaît).","فهم القاعدة الأكاديمية للنفي البسيط (La négation à deux éléments : Ne ... Pas).","التعرف على ظاهرة إسقاط 'ne' في الحديث الشفوي اليومي الفرنسي غير الرسمي."],"sections":[{"h":"عبارات النجاة اللغوية: صندوق إسعافاتك الأولية في فرنسا","p":["عندما تجد نفسك في بلد فرنكوفوني وأنت في المستوى المبتدئ A0، لا تحتاج لحفظ قواميس كاملة، بل تحتاج إلى «عبارات النجاة» (Les phrases de survie). هذه العبارات هي أدوات ميتا-لغوية (Métalinguistiques) تمكّنك من توجيه الحوار والسيطرة على وتيرته وتفادي الإحراج:","1. عند عدم الاستيعاب: «Je ne comprends pas» [ʒə nə kɔ̃.pʁɑ̃ pa] (أنا لا أفهم).","2. عند الجهل بالمعلومة: «Je ne sais pas» [ʒə nə sɛ pa] (أنا لا أعرف / لا أدري).","3. لطلب التمهل في الكلام: «Parlez plus lentement, s'il vous plaît» [paʁ.le ply lɑ̃t.mɑ̃ sil vu plɛ] (تحدث ببطء أكثر، من فضلك).","4. لطلب تكرار الجملة: «Pouvez-vous répéter, s'il vous plaît ?» [pu.ve vu ʁe.pe.te sil vu plɛ] (هل يمكنك الإعادة، من فضلك؟).","5. للسؤال عن معنى كلمة مجهولة: «Qu'est-ce que ça veut dire ?» [kɛs kə sa vø diʁ] (ماذا يعني هذا؟).","6. للسؤال عن المقابل الفرنسي لكلمة: «Comment dit-on ... en français ?» [kɔ.mɑ̃ di.t‿ɔ̃ ... ɑ̃ fʁɑ̃.sɛ] (كيف نقول ... بالفرنسية؟).","7. للسؤال عن مكان وجود شيء: «Où est ... , s'il vous plaît ?» [u ɛ ... sil vu plɛ] (أين يقع ...، من فضلك؟)."],"video":{"id":"83RMINVGxuk","title":"جمل فرنسية بسيطة تحتاجها في حياتك اليومية — عبارات النجاة","channel":"عربي بلسان فرنسي","why":"حزمة العبارات الحيوية الأكثر تكراراً للمواقف الطارئة واليومية للمبتدئين.","dur":9,"lang":"ar","main":true},"sub":[{"h":"القاعدة الأكاديمية للنفي البسيط (La négation en Ne ... Pas)","p":["تتميز اللغة الفرنسية بظاهرة «النفي المزدوج المطوق» (La négation discontinue)؛ حيث لا نكتفي بكلمة نفي واحدة قبل الفعل، بل نُطوّق الفعل المصرف بين عنصرين كالكماشة:","• البنية النحوية: Sujet + NE + Verbe conjugué + PAS.","• مثال: «Je comprends» (أنا أفهم) تصبح في النفي: «Je ne comprends pas» (أنا لا أفهم).","• قاعدة الحذف الصوتي (L'élision): إذا بدأ الفعل بحرف صوتي أو حرف H الصامت، يتحول ne وجوباً إلى n' لتفادي التقاء الساكنين:","  - «J'aime» (أنا أحب) ← «Je n'aime pas» [ʒə nɛm pa].","  - «J'habite» (أنا أسكن) ← «Je n'habite pas à Paris»."]},{"h":"الملاحظة السوسيولغوية: سقوط 'ne' في الشارع الفرنسي الشفوي","p":["في الفرنسية المكتوبة والأكاديمية والرسمية، كتابة «ne» إلزامية 100%.","ولكن عند الاستماع إلى الفرنسيين في الشارع والأفلام والمحادثات اليومية (Le français parlé informel)، ستلاحظ أنهم يسقطون كلمة «ne» صوتياً ويكتفون بـ «pas» للتسريع والإيجاز:","«Je sais pas» بدلاً من «Je ne sais pas».","«Je comprends pas» بدلاً من «Je ne comprends pas».","افهمها عندما تسمعها، ولكن احرص على استخدام الصيغة الكاملة «ne ... pas» في كتابتك واختباراتك الأكاديمية!"]}]},{"h":"كيف تطلب المساعدة في الشارع الفرنسي (Demander de l'aide)","p":["إذا تهت في محطة مترو أو احتجت دواءً أو مساعدة عاجلة:","• «Aidez-moi, s'il vous plaît !» [e.de.mwa sil vu plɛ] (ساعدني، من فضلك!).","• «Je cherche la station de métro» [ʒə ʃɛʁʃ la sta.sjɔ̃ də me.tʁo] (أنا أبحث عن محطة المترو).","• «Parlez-vous anglais ?» [paʁ.le vu ɑ̃.ɡlɛ] (هل تتحدث الإنجليزية؟) — وسيلة إنقاذ أخيرة عندما تتعثر بالفرنسية."]},{"h":"التطبيق والتلخيص","p":["يجمع هذا الدرس المهارة والقاعدة في وحدة واحدة: فحزمة عبارات النجاة السبع (عدم الفهم، عدم المعرفة، طلب التمهل، طلب الإعادة، السؤال عن معنى كلمة، السؤال عن المقابل الفرنسي، طلب الموقع) تمكّن المتعلّم من إدارة أي موقف لغوي وتفادي الإحراج، بينما تُثبّت القاعدة الأكاديمية للنفي البسيط الصيغة المعيارية للإنكار: كماشة ne ... pas تطوّق الفعل المصرف مع إلزامية تحويل ne إلى n' أمام الحرف الصوتي أو h الصامت (Je n'habite pas)، مع ملاحظة سوسيولوجية لغوية بأن الشارع الفرنسي الشفوي يسقط ne ويكتفي بـ pas. كما وضح الفيديو الرئيسي «جمل فرنسية بسيطة تحتاجها في حياتك اليومية» استعمال هذه الجمل في سياقات واقعية، يضيف هذا الدرس الضبط الصوتي والصرفي للنفي وحدوده الأكاديمية.","يستمد هذا الدرس كلاً من تعارف a0-t5-l1 والتحيات في a0-t3: فبعد أن عرّفت بنفسك (a0-t5-l1) قد تسأل أو تُنكر أو تطلب الإعادة، وعبارات النجاة كلها تنطلق ضمن حوار اجتماعي مفتوح بالتحية المناسبة من a0-t3 أولاً. ويشكّل هذا الدرس بدوره جسر الطالب نحو a0-t5-l3 الذي يشرح التمييز الجوهري بين الركييزتين Être و Avoir — وهما الفعلان اللذان يستعملهما المتعلّم في تعريفه ونفيه ومعاملاته معاً.","المهمة التطبيقية: أعد مشاهدة الفيديو الرئيسي، وأوقفه بعد كل عبارة وردّدها بصوت مسموع في سيناريو حقيقي تختاره (الشارع، المتجر، المقهى)؛ ثم سجّل نفسك وأنت تجري حواراً من ست جمل: تبدأ بالتحية، تسأل عن موقع شيء ما، تصرّح بـ «Je ne comprends pas» عند عدم الفهم، تطلب الإعادة بلطف بـ «Pouvez-vous répéter, s'il vous plaît ?»، وتختم بالشكر — مع انتباهك إلى تحويل ne إلى n' أمام الأفعال اللاحقة."]}],"examples":[{"fr":"Je ne comprends pas cette question.","ar":"أنا لا أفهم هذا السؤال.","note":"نفي قياسي: ne + verbe + pas"},{"fr":"Pouvez-vous répéter plus lentement, s'il vous plaît ?","ar":"هل يمكن لحضرتك الإعادة ببطء أكثر، من فضلك؟","note":"صيغة طلب التمهل والإعادة المزدوجة"},{"fr":"Qu'est-ce que ça veut dire « maison » ?","ar":"ماذا تعني كلمة 'maison'؟","note":"السؤال عن معنى مفردة مجهولة"},{"fr":"Comment dit-on « book » en français ?","ar":"كيف نقول 'كتاب' بالفرنسية؟","note":"السؤال عن المقابل الفرنسي"},{"fr":"Je ne sais pas où est la gare.","ar":"أنا لا أعرف أين هي المحطة.","note":"التعبير عن عدم المعرفة"},{"fr":"Je n'habite pas ici.","ar":"أنا لا أسكن هنا.","note":"تحول ne إلى n' أمام حرف h الصامت"},{"fr":"Excusez-moi, je cherche la pharmacie.","ar":"معذرة، أنا أبحث عن الصيدلية.","note":"استئذان وطلب موقع حيوي"},{"fr":"Parlez-vous un peu anglais ?","ar":"هل تتحدثون قليلاً من الإنجليزية؟","note":"طلب المساعدة بلغة وسيطة"}],"pron":[{"w":"je ne comprends pas","ipa":"[ʒə nə kɔ̃.pʁɑ̃ pa]","approx":"جو نو كومبغو با","note":"رنين أنفي في comprends وحرف s صامت"},{"w":"je ne sais pas","ipa":"[ʒə nə sɛ pa]","approx":"جو نو سيه با","note":"صوت مفتوح [sɛ] يليه [pa]"},{"w":"qu'est-ce que ça veut dire","ipa":"[kɛs kə sa vø diʁ]","approx":"كيسكُو سا فو دير","note":"عبارة مركبة سريعة ومترابطة"},{"w":"lentement","ipa":"[lɑ̃t.mɑ̃]","approx":"لونتمو (أنفيتان)","note":"صوتان أنفيان مفتوحان"},{"w":"répéter","ipa":"[ʁe.pe.te]","approx":"غيبيتيه","note":"ثلاث حركات [e] مغلقة متتالية"},{"w":"aidez-moi","ipa":"[e.de.mwa]","approx":"إيديه موا","note":"طلب نجدة مباشر"}],"vocab":[{"fr":"comprendre","ar":"يفهم / يستوعب","pos":"verbe","ipa":"[kɔ̃.pʁɑ̃dʁ]","exFr":"Je comprends le français.","exAr":"أنا أفهم الفرنسية."},{"fr":"savoir","ar":"يعرف / يعلم","pos":"verbe","ipa":"[sa.vwaʁ]","exFr":"Je sais la réponse.","exAr":"أنا أعرف الإجابة."},{"fr":"répéter","ar":"يكرر / يعيد القول","pos":"verbe","ipa":"[ʁe.pe.te]","exFr":"Répétez après moi.","exAr":"كرروا بعدي."},{"fr":"chercher","ar":"يبحث عن","pos":"verbe","ipa":"[ʃɛʁ.ʃe]","exFr":"Je cherche mon hôtel.","exAr":"أنا أبحث عن فندقي."},{"fr":"lentement","ar":"ببطء / بتمهل","pos":"adverbe","ipa":"[lɑ̃t.mɑ̃]","exFr":"Parlez lentement, s'il vous plaît.","exAr":"تحدثوا ببطء، من فضلكم."},{"fr":"vite","ar":"بسرعة","pos":"adverbe","ipa":"[vit]","exFr":"Ne parlez pas trop vite.","exAr":"لا تتحدثوا بسرعة مفرطة."},{"fr":"la question","ar":"السؤال / المسألة","pos":"nom","g":"f","pl":"les questions","ipa":"[la kɛs.tjɔ̃]","exFr":"J'ai une question.","exAr":"لدي سؤال."},{"fr":"la pharmacie","ar":"الصيدلية","pos":"nom","g":"f","pl":"les pharmacies","ipa":"[la faʁ.ma.si]","exFr":"La pharmacie est ouverte.","exAr":"الصيدلية مفتوحة."},{"fr":"le métro","ar":"قطار الأنفاق (المترو)","pos":"nom","g":"m","pl":"les métros","ipa":"[lə me.tʁo]","exFr":"La station de métro est là.","exAr":"محطة المترو هناك."},{"fr":"l'aide","ar":"المساعدة / العون","pos":"nom","g":"f","ipa":"[l‿ɛd]","exFr":"Merci pour votre aide.","exAr":"شكراً على مساعدتكم."},{"fr":"anglais","ar":"إنجليزي (لغة)","pos":"nom","g":"m","ipa":"[ɑ̃.ɡlɛ]","exFr":"Parlez-vous anglais ?","exAr":"هل تتحدثون الإنجليزية؟"}],"grammar":[{"tAr":"أركان النفي البسيط (La négation absolue en Ne ... Pas)","tFr":"La structure de la négation : Sujet + Ne + Verbe + Pas","body":["في الفرنسية المعيارية، النفي عبارة عن كماشة مكونة من كلمتين تحيطان بالفعل المصرف مباشرة:","• الإثبات: Je parle français.","• النفي: Je ne parle pas français.","إذا بدأ الفعل بحرف علة، يحدث اختصار (Élision) لـ ne لتصبح n':","• الإثبات: J'écoute.","• النفي: Je n'écoute pas."],"ex":[{"fr":"Je ne sais pas la réponse.","ar":"أنا لا أعلم الإجابة."},{"fr":"Il n'aime pas le café.","ar":"هو لا يحب القهوة (مع اختصار n')."}]}],"mistakes":[{"wrong":"قول 'Je pas comprends' بنسيان ne ووضع pas قبل الفعل","right":"Je ne comprends pas (تطويق الفعل بين ne و pas)","why":"الفعل المصرف يجب أن يتوسط عنصري النفي: ne قبله و pas بعده."},{"wrong":"قول 'Je ne aime pas' بدون حذف علة ne","right":"Je n'aime pas (تحويل ne إلى n')","why":"التقاء حركتي علة يفرض حذف الأولى ووضع apostrophe."},{"wrong":"البحث عن صيدلية دون بدء السؤال بـ Excusez-moi","right":"Excusez-moi monsieur, où est la pharmacie ?","why":"الاستئذان بالأدب ركن حاسم لاستجابة الشخص في الشارع."}],"dialogues":[{"title":"في شارع باريسي: طلب الاتجاهات بتمهل","ctx":"سائح مبتدئ في الفرنسية يسأل أحد المارة في باريس ويطلب منه التمهل في الحديث.","lines":[{"who":"Le touriste","fr":"Excusez-moi madame, où est la station de métro, s'il vous plaît ?","ar":"معذرة سيدتي، أين تقع محطة المترو، من فضلك؟"},{"who":"La passante","fr":"Vous prenez à droite, puis tout droit jusqu'au carrefour.","ar":"تأخذ يميناً، ثم إلى الأمام مباشرة حتى المفترق."},{"who":"Le touriste","fr":"Pardon, je ne comprends pas bien. Parlez plus lentement, s'il vous plaît.","ar":"عفواً، أنا لا أفهم جيداً. تحدثي ببطء أكثر، من فضلك."},{"who":"La passante","fr":"Ah, bien sûr : tournez à droite (geste), puis continuez tout droit.","ar":"آه، بالتأكيد: انعطف يميناً، ثم واصل للأمام مباشرة."},{"who":"Le touriste","fr":"C'est très clair maintenant. Merci beaucoup, madame !","ar":"الأمر واضح جداً الآن. شكراً جزيلاً، سيدتي!"}]}],"exercises":[{"t":"mcq","skill":"grammar","q":"ما هو التركيب النحوي السليم لنفي الجملة 'Je sais' (أنا أعرف)؟","opts":["Je pas sais.","Je ne sais pas.","Je non sais.","Je sais ne pas."],"a":1,"why":"القاعدة: فاعل + ne + فعل + pas."},{"t":"mcq","skill":"vocabulary","q":"ما هي العبارة التي تستخدمها لتطلب من شخص فرنسي أن يتحدث بسرعة أقل وببطء؟","opts":["Parlez plus vite !","Parlez plus lentement, s'il vous plaît.","Répétez fort !","Je ne sais pas."],"a":1,"why":"Parlez plus lentement تعني تحدث ببطء أكثر."},{"t":"fill","skill":"grammar","q":"حوّل الجملة للنفي: 'Je comprends' تصبح: 'Je ___ comprends ___.'","fr":"Je ___ comprends ___.","ans":"ne pas","why":"عنصرا النفي هما ne قبل الفعل و pas بعده."},{"t":"order","skill":"grammar","q":"رتّب عبارة السؤال عن معنى كلمة مجهولة:","words":["Qu'est-ce","que","ça","veut","dire ?"],"why":"السؤال المعياري عن المعنى: Qu'est-ce que ça veut dire ?","ans":"Qu'est-ce que ça veut dire ?"},{"t":"listen","skill":"listening","audio":"Pouvez-vous répéter, s'il vous plaît ?","q":"استمع إلى العبارة وحدد الطلب المقصود بدقة:","opts":["هل يمكنك التكرار والإعادة، من فضلك؟","هل يمكنك التحدث بالإنجليزية؟","أين هي المحطة؟","كم سعر هذا الشيء؟"],"a":0,"why":"Pouvez-vous répéter تعني هل يمكنك الإعادة."},{"t":"correct","skill":"grammar","q":"صحح خطأ التقاء الحركات الصوتية في النفي: 'Je ne habite pas à Paris.'","fr":"Je ne habite pas à Paris.","ans":"Je n'habite pas à Paris.","why":"حرف h صامت وتلتقي علتان فيتحول ne إلى n': Je n'habite pas."},{"t":"writing","skill":"writing","q":"اكتب جملة فرنسية تعبر فيها عن أنك 'لا تفهم' مستخدماً النفي السليم والفعل comprendre:","min":4,"kw":["je","ne","comprends","pas"],"sample":"Je ne comprends pas, s'il vous plaît.","why":"تطبيق متكامل لجملة النفي الأساسية الحيوية."},{"t":"speaking","skill":"pronunciation","q":"انطق عبارة الاستفسار عن المعنى بنبرة استفهامية صحيحة:","target":"Qu'est-ce que ça veut dire ?","why":"نطق العبارة الميتالغوية الأكثر فائدة في رحلة التعلم."}],"homework":"اكتب 'بطاقة نجاة' من 5 عبارات فرنسية أساسية تستعين بها إذا واجهت موقفاً لا تفهمه في فرنسا (طلب الإعادة، طلب التمهل، إعلان عدم الفهم، السؤال عن المعنى، وطلب المساعدة)، وتدرب على نطقها غيباً دون النظر إلى الورقة. قبل الدرس التالي (a0-t5-l3): سجّل بطاقة نجاتك الخمس عبارات غيباً من a0-t5-l2، وراجع تعارفك من a0-t5-l1 لتدمجهما في حوار واحد متماسك في الدرس الختامي.","sources":[{"title":"جمل فرنسية بسيطة تحتاجها في حياتك اليومية — عبارات النجاة","channel":"عربي بلسان فرنسي","why":"حزمة العبارات الحيوية الأكثر تكراراً للمواقف الطارئة واليومية.","videoId":"83RMINVGxuk"},{"title":"جمل أساسية للتكلم باللغة الفرنسية في أسرع وقت","channel":"Yasser Academy","why":"حزمة جمل يومية بالعربية توسّع مخزون عبارات النجاة وتثبّت استعمالها في مواقف واقعية بعد الفيديو الرئيسي.","videoId":"kQpNBQxFlsE"},{"title":"Grammaire A1, La négation tout ce que vous devez savoir en 4 minutes.","channel":"Le français avec François","why":"تلخيص مكثّف لقاعدة ne ... pas بمنهج متدرّج أوروبي — يؤكد ما وضحه الفيديو الرئيسي بتبسيط مدرسي مقرب.","videoId":"IV13GxAkM2Y"}],"supplements":[{"id":"kQpNBQxFlsE","title":"جمل أساسية للتكلم باللغة الفرنسية في أسرع وقت","channel":"Yasser Academy","why":"حزمة جمل يومية بالعربية توسّع مخزون عبارات النجاة وتثبّت استعمالها في مواقف واقعية بعد الفيديو الرئيسي.","dur":7,"lang":"ar"},{"id":"IV13GxAkM2Y","title":"Grammaire A1, La négation tout ce que vous devez savoir en 4 minutes.","channel":"Le français avec François","why":"تلخيص مكثّف لقاعدة ne ... pas بمنهج متدرّج أوروبي — يؤكد ما وضحه الفيديو الرئيسي بتبسيط مدرسي مقرب.","dur":4,"lang":"fr"}]},{"id":"A0-t5-l3","fr":"L'architecture de la phrase simple et les deux verbes piliers","ar":"هندسة الجملة الفرنسية البسيطة والركيزتان Être و Avoir","objectives":["إتقان الهيكل التركيبي الأساسي للجملة الفرنسية البسيطة (Sujet + Verbe + Complément).","استيعاب التمييز الوظيفي والوجودي الدقيق بين فعلي اللغة الفرنسية المحوريين: Être و Avoir.","استخدام فعل Avoir للتعبير عن الاحتياجات البيولوجية والحالات الفيزيولوجية (faim, soif, chaud, froid).","تصريف الفعلين Être و Avoir تصريفاً متقناً في الحاضر مع جميع ضمائر المفرد (Je, Tu, Il, Elle).","تتويج المستوى A0 بإنتاج نص تقديمي متكامل ومترابط من 6 جمل يدمج كافة الكفايات المكتسبة."],"sections":[{"h":"هندسة الجملة الفرنسية البسيطة: الترتيب الذهبي (SVO)","p":["تعتمد اللغة الفرنسية المعيارية ترتيباً تركيبياً صارماً للجملة الإخبارية البسيطة يُعرف بنمط (Sujet + Verbe + Complément / Attribut):","1. الفاعل (Le sujet): يأتي دائماً أولاً، ويكون إما ضميراً شخصياً (Je, Tu, Il, Elle) أو اسماً معرّفاً (Le professeur, Karim). خلافاً للغة العربية التي تسمح بالبدء بالفعل وتستغني عن الضمير المستتر، لا يمكن في الفرنسية إطلاقاً بناء جملة بدون فاعل ظاهر!","2. الفعل المصرف (Le verbe conjugué): يأتي مباشرة في المركز الثاني ليربط الفاعل بالمعنى.","3. المكمل أو المسند (Le complément ou l'attribut): يكمل معنى الجملة (مفعول به، ظرف مكان أو زمان، أو صفة توضيحية).","مثال نموذجي: «Karim (Sujet) habite (Verbe) à Paris (Complément de lieu)»."],"video":{"id":"TrgrCckXmr0","title":"تعلم الفرنسية من الصفر للمبتدئين — الدرس الأول 2: تركيب الجمل بإحترافية","channel":"Learn English & French with Asmae","why":"شرح تركيبي مبسط وعميق ينقلك إلى بناء جملك الكاملة الخاصة بك.","dur":21,"lang":"ar","main":true},"sub":[{"h":"الركيزتان الخالدتان: الفرق الوجودي بين Être و Avoir","p":["كل لغة تمتلك أفعالاً محورية تدور حولها معظم التراكيب. في الفرنسية، هذان الفعلان هما Être (الكينونة) و Avoir (الملكية). الخلط بينهما هو الخطأ الأكثر فداحة لدى المبتدئين:","• فعل Être (الكينونة): يعبر عن «من أنت» و «ما صفتك» و «أين أنت»:","  - الهوية والمهنة: «Je suis Karim», «Je suis étudiant».","  - الصفات النفسية والشخصية: «Je suis content», «Je suis fatigué».","  - الجنسية والموقع الجغرافي: «Je suis marocain», «Je suis à l'hôtel».","• فعل Avoir (الملكية والسن والاحتياجات الحيوية): يعبر عن «ما تملكه» وما تشعر به جسدياً:","  - التملك المادي والمعنوي: «J'ai un livre», «J'ai une question».","  - العمر حصراً: «J'ai vingt ans».","  - الاحتياجات البيولوجية الإلزامية بـ Avoir: في الفرنسية لا نقول 'أنا جائع كصفة' بل نقول حرفياً 'أنا أملك جوعاً':","    * «J'ai faim» [ʒe fɛ̃] (أنا جائع).","    * «J'ai soif» [ʒe swaf] (أنا عطشان).","    * «J'ai chaud» [ʒe ʃo] (أنا أشعر بالحرارة).","    * «J'ai froid» [ʒe fʁwa] (أنا أشعر بالبرد).","    * «J'ai sommeil» [ʒe sɔ.mɛj] (أنا أشعر بالنعاس).","انتبه: لو قلت «Je suis chaud» في الفرنسية لقلبت المعنى إلى تعبير غير لائق ومحرج تماماً!"]},{"h":"جدول التصريف المقارن للركيزتين في زمن الحاضر (Présent)","p":["تصريف فعل Être (يكون):","• Je suis [ʒə sɥi] (أنا أكون)","• Tu es [ty ɛ] (أنتَ تكون / أنتِ تكونين)","• Il est [i.l‿ɛ] (هو يكون)","• Elle est [ɛ.l‿ɛ] (هي تكون)","تصريف فعل Avoir (يملك):","• J'ai [ʒe] (أنا أملك / عندي)","• Tu as [ty a] (أنت تملك / عندك)","• Il a [i.l‿a] (هو يملك / عنده)","• Elle a [ɛ.l‿a] (هي تملك / عندها)"]}]},{"h":"التتويج الأكاديمي لمستوى A0: إنتاج ملفك التواصلي الشامل","p":["بوصولك إلى هذا الدرس، اكتملت بين يديك كل عناصر المستوى التأسيسي A0: الحروف، الأصوات، الأرقام، التحيات، أدبيات اللباقة، وتركيب الجمل البسيطة.","الهدف النهائي للمستوى هو أن تكون قادراً على كتابة ونطق فقرة متماسكة من 6 جمل تقدم فيها نفسك بالكامل وتتفاعل في أي بيئة فرنكوفونية باستقلالية تامة وثقة علمية واضحة."]},{"h":"التطبيق والتلخيص","p":["يُتْمِم هذا الدرس المشروع التأسيسي للمستوى A0 فيقدم النمط الذهبي لبناء الجملة الفرنسية الإخبارية (Sujet + Verbe + Complément) مع إلزام الفاعل الظاهر خلافاً للعربية، ثم يميّز وظيفياً بين الركييزتين Être (الكينونة والصفات والمهن والجنسية والموقع الجغرافي) و Avoir (الملكية والحالات الفيزيولوجية: faim، soif، chaud، froid، sommeil) مع جدول تصريف المفرد للاثنتين. كما وضح الفيديو الرئيسي «تعلم الفرنسية من الصفر للمبتدئين — الدرس الأول 2» كيف تُبنى الجملة من فاعل ومصرف ومكمل، يمنح هذا الدرس الخريطة الكاملة لاستعمال كل فعل في موضعه الصحيح بما في ذلك أخطاء «Je suis faim» و «Parle français» الشهيرة.","يمثّل هذا الدرس خاتمة سلسلة A0 الخمسة وتاجها: فلقد أسّس a0-t1 الحروف والتشكيل والتهجئة، وa0-t2 الأصوات ومخارجها والربط الصوتي، وa0-t3 التحيات وأدبيات اللباقة مع Tu / Vous، وa0-t4 الأرقام من 0 إلى 100 مع العمر والأسعار وأرقام الهواتف، وa0-t5 التعريف بالنفس ثم عبارات النجاة والنفي البسيط (راجع a0-t5-l2)؛ ويجمع هذا الدرس كل تلك الكفايات في نصّ واحد متماسك بالنمط الذهبي SVO وفعلَي Être و Avoir. وبهذا يكتمل أساس A0 الذي تُبنى عليه مباشرةً رحلتك في مستوى A1.","المهمة التطبيقية: أعد مشاهدة الفيديو الرئيسي، وأوقفه عند كل مثال SVO وحدّد الفاعل والفعل والمكمل بصوت مسموع؛ ثم سجّل فقرتك التتويجية «Qui suis-je ?» من ست جمل مدمجة فيها تحية، الاسم بـ s'appeler، العمر بـ Avoir (راجع a0-t4-l2)، المهنة والصفة بـ Être، والإحساس الحيوي (J'ai faim / soif...) في سياق طبيعي — مستحضراً كل قواعد المستوى من الحروف حتى النفي في تسجيل واحد واثق دون ورقة أمامك."]}],"examples":[{"fr":"Je suis à Paris et j'ai faim.","ar":"أنا في باريس وأشعر بالجوع.","note":"الموقع بـ être والاحتياج الحيوي بـ avoir"},{"fr":"Tu as soif ? Voici un verre d'eau.","ar":"أأنت عطشان؟ تفضل كأس ماء.","note":"Avoir soif للتعبير عن العطش"},{"fr":"Il a vingt ans et il est étudiant.","ar":"عمره عشرون عاماً وهو طالب.","note":"العمر بـ avoir والمهنة بـ être"},{"fr":"J'ai froid, je ferme la fenêtre.","ar":"أنا أشعر بالبرد، سأغلق النافذة.","note":"Avoir froid للشعور بالبرد"},{"fr":"Elle est très contente aujourd'hui.","ar":"هي مسرورة جداً اليوم.","note":"الحالة الشعورية بفعل être"},{"fr":"J'ai un problème avec ma réservation.","ar":"لدي مشكلة في حجزي.","note":"الملكية المعنوية بـ avoir"},{"fr":"Nous sommes prêts pour le niveau A1.","ar":"نحن جاهزون للمستوى A1.","note":"الكينونة والجاهزية"},{"fr":"Bonjour, je m'appelle Karim, j'ai 22 ans, je suis marocain et j'habite à Lyon.","ar":"صباح الخير، اسمي كريم، عمري 22 سنة، أنا مغربي وأسكن في ليون.","note":"الفقرة التتويجية الشاملة للمستوى A0"}],"pron":[{"w":"j'ai faim","ipa":"[ʒe fɛ̃]","approx":"جيه فان (أنفية)","note":"صوت أنفي منبسط في faim"},{"w":"j'ai soif","ipa":"[ʒe swaf]","approx":"جيه سواف","note":"تركيب oi يلفظ [wa] تليها فاء"},{"w":"j'ai froid","ipa":"[ʒe fʁwa]","approx":"جيه فغوا","note":"حرف d الأخير صامت تماماً"},{"w":"j'ai chaud","ipa":"[ʒe ʃo]","approx":"جيه شو","note":"تركيب au يلفظ [o] و d صامتة"},{"w":"je suis","ipa":"[ʒə sɥi]","approx":"جو سوي","note":"صوت /ɥ/ الشفوي و s صامتة"},{"w":"content","ipa":"[kɔ̃.tɑ̃]","approx":"كونتان (أنفيتان)","note":"أنفي دائري يليه أنفي مفتوح"}],"vocab":[{"fr":"la faim","ar":"الجوع","pos":"nom","g":"f","ipa":"[la fɛ̃]","exFr":"Avoir faim.","exAr":"الشعور بالجوع."},{"fr":"la soif","ar":"العطش","pos":"nom","g":"f","ipa":"[la swaf]","exFr":"Avoir soif.","exAr":"الشعور بالعطش."},{"fr":"le chaud","ar":"الحرارة / الدفء","pos":"nom","g":"m","ipa":"[lə ʃo]","exFr":"Avoir chaud.","exAr":"الشعور بالحر."},{"fr":"le froid","ar":"البرد","pos":"nom","g":"m","ipa":"[lə fʁwa]","exFr":"Avoir froid.","exAr":"الشعور بالبرد."},{"fr":"le sommeil","ar":"النعاس / النوم","pos":"nom","g":"m","ipa":"[lə sɔ.mɛj]","exFr":"Avoir sommeil.","exAr":"الشعور بالنعاس."},{"fr":"content","ar":"مسرور / راضٍ (مذكر)","pos":"adj","g":"m","pl":"contents","ipa":"[kɔ̃.tɑ̃]","exFr":"Je suis content de mon travail.","exAr":"أنا راضٍ عن عملي."},{"fr":"contente","ar":"مسرورة / راضية (مؤنث)","pos":"adj","g":"f","pl":"contentes","ipa":"[kɔ̃.tɑ̃t]","exFr":"Elle est très contente.","exAr":"هي مسرورة جداً."},{"fr":"prêt","ar":"جاهز / مستعد (مذكر)","pos":"adj","g":"m","pl":"prêts","ipa":"[pʁɛ]","exFr":"Tu es prêt ?","exAr":"هل أنت جاهز؟"},{"fr":"prête","ar":"جاهزة / مستعدة (مؤنث)","pos":"adj","g":"f","pl":"prêtes","ipa":"[pʁɛt]","exFr":"La chambre est prête.","exAr":"الغرفة جاهزة."},{"fr":"la phrase","ar":"الجملة اللغوية","pos":"nom","g":"f","pl":"les phrases","ipa":"[la fʁɑz]","exFr":"Construisez une phrase simple.","exAr":"ابنوا جملة بسيطة."},{"fr":"le verbe","ar":"الفعل","pos":"nom","g":"m","pl":"les verbes","ipa":"[lə vɛʁb]","exFr":"Le verbe est le cœur de la phrase.","exAr":"الفعل هو قلب الجملة."},{"fr":"le sujet","ar":"الفاعل","pos":"nom","g":"m","pl":"les sujets","ipa":"[lə sy.ʒɛ]","exFr":"Identifiez le sujet.","exAr":"حددوا الفاعل."}],"grammar":[{"tAr":"الاستخدام الإلزامي لفعل Avoir مع الحالات الفيزيولوجية","tFr":"L'emploi idiomatique de AVOIR : faim, soif, chaud, froid","body":["في اللغات الأخرى (كالعربية والإنجليزية)، نعبر عن الجوع والبرد بصفات مع فعل الكينونة (I am hungry, أنا جائع).","أما في الفرنسية المعيارية، فالقاعدة صارمة: تُستخدم الأسماء المجردة (faim, soif, chaud, froid, sommeil, peur) مباشرة مع فعل الملكية Avoir بدون أي أداة:","• J'ai faim (أنا جائع).","• J'ai soif (أنا عطشان).","• J'ai froid (أنا بردان).","• J'ai chaud (أنا أشعر بالحر).","استخدام فعل être في هذه التعبيرات خطأ نحوي جسيم ويقلب المعنى تماماً."],"ex":[{"fr":"Tu as faim ? — Oui, j'ai très faim.","ar":"هل أنت جائع؟ — نعم، أنا جائع جداً."},{"fr":"Elle a froid dans cette chambre.","ar":"هي تشعر بالبرد في هذه الغرفة."}]}],"mistakes":[{"wrong":"قول 'Je suis faim' مثل الإنجليزية I am hungry","right":"J'ai faim (باستخدام فعل Avoir)","why":"الجوع والعطش في الفرنسية احتياجات تملك بفعل avoir ولا توصف بـ être."},{"wrong":"قول 'Je suis froid' للتعبير عن البرد","right":"J'ai froid (مع فعل Avoir)","why":"Je suis froid تعني أنك شخص بارد العواطف والطباع!"},{"wrong":"بناء جملة بدون فاعل ظاهر مثل: 'Parle français' بدلاً من 'Je parle français'","right":"Je parle français (إثبات الفاعل وجوباً)","why":"الجملة الفرنسية الإخبارية لا تقبل الفاعل المستتر وتفرض وجود الفاعل ظاهراً دائماً."}],"dialogues":[{"title":"في المقهى وطلب وجبة سريعة","ctx":"صديقان يدخلان مطعماً بعد جولة طويلة في باريس ويعبران عن احتياجاتهما.","lines":[{"who":"Thomas","fr":"Je suis fatigué et j'ai très soif après cette marche !","ar":"أنا متعب وأشعر بعطش شديد بعد هذا المشي!"},{"who":"Amine","fr":"Moi aussi, et en plus j'ai très faim. On commande ?","ar":"أنا أيضاً، وفوق ذلك أنا جائع جداً. هل نطلب الطعام؟"},{"who":"Thomas","fr":"Oui ! Deux sandwichs et deux grandes bouteilles d'eau, s'il vous plaît.","ar":"نعم! اثنان ساندويتش وزجاجتا ماء كبيرتان، من فضلك."},{"who":"Le serveur","fr":"Très bien messieurs, c'est prêt dans cinq minutes !","ar":"ممتاز سيديّ، الطلب جاهز خلال خمس دقائق!"},{"who":"Amine","fr":"Parfait, merci beaucoup !","ar":"ممتاز، شكراً جزيلاً!"}]}],"exercises":[{"t":"mcq","skill":"grammar","q":"ما هي العبارة الفرنسية الصحيحة للتعبير عن أنك 'جائع'؟","opts":["Je suis faim.","J'ai faim.","Je fais faim.","Je vais faim."],"a":1,"why":"الجوع يعبر عنه بالاسم faim مسبوقاً بتصريف فعل الملكية Avoir: J'ai faim."},{"t":"mcq","skill":"grammar","q":"ما هو الفعل المناسب لملء الفراغ: 'Karim ___ très fatigué ce soir.'؟","opts":["a (فعل avoir)","est (فعل être)","va (فعل aller)","fait (فعل faire)"],"a":1,"why":"fatigué صفة تعبر عن حالة جسدية فتأخذ فعل الكينونة être: il est fatigué."},{"t":"fill","skill":"grammar","q":"أكمل الجملة التعبيرية عن العطش: 'J'ai ___.'","fr":"J'ai ___.","ans":"soif","why":"العطش في الفرنسية هو soif مع فعل avoir: J'ai soif."},{"t":"order","skill":"grammar","q":"رتّب كلمات الجملة الإخبارية الفرنسية البسيطة وفق النمط الذهبي (SVO):","words":["Le","professeur","explique","la","leçon","clairement."],"why":"فاعل معرف (المبتدأ) + فعل مصرف + مفعول به + ظرف.","ans":"Le professeur explique la leçon clairement."},{"t":"listen","skill":"listening","audio":"J'ai très faim et j'ai soif","q":"استمع إلى العبارة وحدد الاحتياجين المذكورين فيها:","opts":["الجوع والعطش","البرد والحر","التعب والنوم","الخوف والقلق"],"a":0,"why":"faim تعني الجوع و soif تعني العطش."},{"t":"correct","skill":"grammar","q":"صحح الخطأ النحوي الشائع: 'Je suis froid.'","fr":"Je suis froid.","ans":"J'ai froid.","why":"الشعور بالبرد يعبر عنه بفعل avoir: J'ai froid."},{"t":"writing","skill":"writing","q":"اكتب فقرة متكاملة من 4 جمل تقدم فيها نفسك بالكامل: اسمك، عمرك، جنسيتك، والمدينة التي تسكن فيها:","min":14,"kw":["m'appelle","ans","suis","habite"],"sample":"Bonjour, je m'appelle Sami. J'ai vingt ans. Je suis égyptien. J'habite à Alexandrie.","why":"التتويج الشامل للقدرة التعبيرية المتماسكة في نهاية المستوى A0."},{"t":"speaking","skill":"pronunciation","q":"انطق فقرتك التقديمية المتكاملة بصوت واضح ونبرة فرنسية مستقرة:","target":"Bonjour, je m'appelle Karim. J'ai dix-neuf ans. Je suis étudiant.","why":"تطبيق النطق الصوتي المتصل والواثق لتقديم النفس في ختام المستوى A0."}],"homework":"اكتب مقالاً تعريفياً قصيراً بعنوان «Qui suis-je ?» (من أنا؟) يتكون من 6 جمل كاملة ومترابطة توظف فيها: تحية اللقاء المناسبة، اسمك، عمرك، جنسيتك ومهنتك، مكان إقامتك، واللغات التي تتحدثها وتفهمها، مع تسجيل صوتي كامل للمقال في 30 ثانية بجودة ووضوح. أكملت سلسلة A0 من الحروف حتى هندسة الجملة (a0-t1 ← a0-t2 ← a0-t3 ← a0-t4 ← a0-t5) — التالي: مستوى A1، حيث تتوسّع الأزمنة والحوارات الممتدة على هذا الأساس المكتمل.","sources":[{"title":"تعلم الفرنسية من الصفر للمبتدئين — الدرس الأول 2: تركيب الجمل بإحترافية","channel":"Learn English & French with Asmae","why":"درس تأسيسي متين لتركيب الجمل البسيطة وفهم أدوار الفاعل والفعل والمكمل.","videoId":"TrgrCckXmr0"},{"title":"ف Le Verbe être et Avoir و l'auxiliaire être et avoir تعلم الفرنسية--مستحيل تخطىء مرة أخرى","channel":"Apprendre Le Français - FrTV - تعلم الفرنسية","why":"شرح عربي موسع لتصريف الركييزتين être و avoir ولأدوارهما كفعلَي مساعدة — يعمّق ما عرضه الفيديو الرئيسي على الجملة البسيطة.","videoId":"HOgSGwmZvIA"},{"title":"Comment construire une phrase en français | Sujet, verbe, complément – FLE débutants","channel":"AdServ Formation","why":"تجسيد مرئي مختصر ومباشر للنمط الذهبي SVO في بناء الجملة الفرنسية — تطبيق حيّ على هندسة الجملة المعلّمة في الفيديو الرئيسي.","videoId":"Pt7Opm6AFhY"}],"supplements":[{"id":"HOgSGwmZvIA","title":"ف Le Verbe être et Avoir و l'auxiliaire être et avoir تعلم الفرنسية--مستحيل تخطىء مرة أخرى","channel":"Apprendre Le Français - FrTV - تعلم الفرنسية","why":"شرح عربي موسع لتصريف الركييزتين être و avoir ولأدوارهما كفعلَي مساعدة — يعمّق ما عرضه الفيديو الرئيسي على الجملة البسيطة.","dur":15,"lang":"ar"},{"id":"Pt7Opm6AFhY","title":"Comment construire une phrase en français | Sujet, verbe, complément – FLE débutants","channel":"AdServ Formation","why":"تجسيد مرئي مختصر ومباشر للنمط الذهبي SVO في بناء الجملة الفرنسية — تطبيق حيّ على هندسة الجملة المعلّمة في الفيديو الرئيسي.","dur":2,"lang":"fr"}]}]}]},{"code":"A1","ar":"المبتدئ","fr":"Débutant","desc":"أهم مستوى في رحلتك: الفعلان être و avoir، الضمائر، أدوات التعريف، الأزمنة الأساسية، ومفردات الحياة اليومية.","color":"#059669","order":2,"tracks":[{"id":"a1-t1","slug":"le-verbe-etre","icon":"book","color":"#059669","fr":"Le verbe être","ar":"الفعل être (يكون)","desc":"أهم فعل في الفرنسية: تصريفه الكامل واستخداماته.","lessons":[{"id":"A1-t1-l1","fr":"Être ou ne pas être","ar":"أكون أو لا أكون","objectives":["تصريف être في المضارع الستة تصرفاً صحيحاً دون تردد","تكوين جمل التصفية (subject + être + complement)","النفي مع être بـ ne...pas ونحت ne إلى n'","توظيف être في التعريف بالعمر والحالة والمهنة"],"sections":[{"h":"تصريف être","p":["الفعل être (يكون) هو أهم فعل في اللغة الفرنسية: يدخل في جمل التصفية، وفي الأزمنة المركبة كمساعد، وفي التحية والتعارف. من أتقن être أتقنت العمود الفقري للغة.","تصريفها في المضارع: je suis، tu es، il/elle est، nous sommes، vous êtes، ils/elles sont. لاحظ أن tu es و il est تأتيان بحرفي s و t في آخرهما — وهذه أكثر موضعين يخطئ فيهما المبتدئون.","شاهد الفيديو الأساسي بالشرح العربي لتسمع التصريف بالنطق الصحيح، ثم اقرأه هنا بصوت مسموع ثلاث مرات. التصريف لا يُحفظ بالعين وحدها؛ يجب أن يمرّ على الأذن واللسان معًا حتى يصبح ردة فعل.","التركيب الذهبي لجملة التصفية: فاعل + être + صفة/مهنة/مكان. Je suis étudiant (أنا طالب)، Elle est marocaine (هي مغربية)، Nous sommes prêts (نحن جاهزون). لا تستخدم أبدًا صفة مباشرة بعد الفاعل بدون être.","قاعدة المطابقة: الصفة بعد être تتفق مع الفاعل في الجنس والعدد: Il est grand / Elle est grande / Ils sont grands / Elles sont grandes. النهاية e للمؤنث و s للجمع هي كل القاعدة في هذا المستوى.","مع النفي: ne...pas يحيطان بالفعل. Je ne suis pas fatigué (لست متعبًا). قبل حرف العلة تصبح ne إلى n': Elle n'est pas là (ليست هنا). احفظ الحالتين معًا لأن نصف جملك اليومية منفية."],"video":{"id":"KY32SIbmE-c","title":"تعلم اللغة الفرنسية بسهولة وسرعة للمبتدئين : تصريف الفعل Etre , Avoir الى الحاضر مع الأ…","channel":"la langue francaise","why":"شرح عربي مبسط لتصريف الفعلين معًا — يبني الصورة الكاملة قبل الغوص في التفاصيل.","lang":"ar","main":true},"sub":[{"h":"جدول التصريف مع التقريب العربي","p":["je suis — /ʒə sɥi/ — \"جو-سوي\" (أنا أكون)","tu es — /ty e/ — \"تي إ\" (أنت تكون)","il/elle est — /il ɛl ɛ/ — \"إل/إل إ\" (هو/هي يكون)","nous sommes — /nu sɔm/ — \"نو سُم\" (نحن نكون)","vous êtes — /vu zɛt/ — \"فوا زيت\" (أنتم تكونون)","ils/elles sont — /il ɛl sɔ̃/ — \"إل/إل سُون\" (هم يكونون) — الـ s في elles صامتة."]},{"h":"أهم ثلاث استعمالات يومية لـ être","p":["الحالة: Comment ça va ? — Je suis fatigué. (كيف حالك؟ — متعب.)","المهنة: Quel est ton métier ? — Je suis ingénieur. (ما مهنتك؟ — مهندس.)","المكان والهوية: Je suis ici. / Je suis le frère de Karim. (أنا هنا. / أنا أخي كريم.)","لاحظ: مع المهنة المفردة لا نضع أداة تعريف: Il est médecin وليس Il est le médecin."]},{"h":"أخطاء المبتدئين مع être وأصلها","p":["خطأ: «Je fatigué» — السبب: نقل البناء من العربية. الجواب: الصفة تحتاج être دائماً.","خطأ: «Il est le docteur» — السبب: الخلط بين المهنة والشيء المعرّف. الجواب: المهنة بعد être مجرّدة.","خطأ: «Vous sommes» — السبب: حفظ الترتيب دون ربط. الحيلة: vous تنتهي بـ s مكتوبة و t مسموعة: vous êtes."]}]},{"h":"جملة التصفية","p":["الفرنسية لا تخترع دائماً: في جملة التصفية نحتاج être: «Je suis fatigué» (أنا متعب) وليس «Je fatigué». كذلك في المهنة: Il est médecin (هو طبيب) — بدون أداة تعريف قبل المهنة المفرد بعد être.","مع الصفات: La maison est grande (البيت كبير). الـ grand صفة تتبع maison المؤنث فأصبحت grande.","يمكنك توسيع جمل التصفية فورًا بصفات مقابلة: grand/petit، content/triste، chaud/froid. كل صفة زائدة تضاعف جملك دون قواعد جديدة."]},{"h":"النفي: ne ... pas","p":["للنفي نحيط الفعل بـ ne ... pas: Je ne suis pas fatigué (أنا لست متعباً). Elle n'est pas là (هي ليست هنا).","ملاحظة: قبل حرف علة تتحول ne إلى n': Il n'est pas étudiant.","النفي مع être هو أكثر ما ستجده في ردود «كيف حالك؟»: Je ne suis pas bien اليوم. احفظ النمط ككتلة واحدة لا كثلاث كلمات منفصلة."]},{"h":"التطبيق والتلخيص","p":["يُختم هذا الدرس بتثبيت الصورة الذهنية للفعل être في وظيفته الثلاثية: تصريفه في المضارع بصيغه الستّ (suis، es، est، sommes، êtes، sont)، وبناء جملة التصفية الذي يفرض وجوده بين الفاعل والصفة أو المهنة أو المكان، ثمّ نفيه بـ ne...pas مع نحت ne إلى n' أمام حرف العلة. كما وضح الفيديو الرئيسي «تعلم اللغة الفرنسية بسهولة وسرعة للمبتدئين : تصريف الفعل Etre , Avoir الى الحاضر مع الأ…» لقناة la langue francaise، لا يقوم إتقان هذا الفعل على الحفظ الجافّ للجدول وحده، بل على دقّة الصيغ الستّ، ومطابقة الصفة لجنس الفاعل وعدده، وإحاطة الفعل بالنفي في نمط سمعي متّصل يُنطق دفعة واحدة دون تقطيع.","يمثّل هذا الدرس أولى عقد سلسلة المستوى، واستعد لـ a1-t2-l1 (الفعل avoir) الذي يبني على المكانة نفسها ليفصل بين المجالين: être للحالة والصفة والمهنة، وavoir للملكية والحالات الجسدية والأعمار. وبعدها تتوالى السلسلة: a1-t3-l1 (aller + faire) لأفعال الحركة والفعل اليومي، ثمّ a1-t4-l1 (الضمائر) الذي يعيد قراءة أفعال a1-t1-l1 و a1-t2-l1 و a1-t3-l1 بصيغ الضمائر الستّة، وأخيراً a1-t5-l1 (أدوات التعريف والتنكير) الذي يسبق الأسماء والصفات الآتية بعد être.","أعد مشاهدة الفيديو الرئيسي «تعلم اللغة الفرنسية بسهولة وسرعة للمبتدئين : تصريف الفعل Etre , Avoir الى الحاضر مع الأ…» مصحوباً بالقلم: أوقفه عند كل صيغة تصرّفها وانطقها بصوت مسموع قبل أن يكمل المدرّس، ثمّ سجّل صوتك وأنت تتلو التصريف الستّة مرّة واحدة متّصلة، وبعدها اكتب ست جمل تصفية عن أفراد عائلتك (Je suis... / Tu es... / Il ou elle est... / Nous sommes... / Vous êtes... / Ils sont...) تضمّ جملتين منفيتين على الأقل، وقارن تسجيلك بنطق الفيديو حرفياً حتى تستقيم المخارج."]}],"examples":[{"fr":"Je suis étudiant.","ar":"أنا طالب."},{"fr":"Tu es très gentil.","ar":"أنت لطيف جداً."},{"fr":"Nous sommes en retard.","ar":"نحن متأخرون."},{"fr":"Ils ne sont pas à la maison.","ar":"هم ليسوا في البيت."},{"fr":"Vous êtes bien arrivés ?","ar":"هل وصلتم بخير؟"},{"fr":"Elle est contente aujourd'hui.","ar":"هي سعيدة اليوم.","note":"مطابقة المؤنث: e في نهاية الصفة"},{"fr":"Vous êtes le professeur ?","ar":"هل أنت الأستاذ؟","note":"être في السؤال بالنشر"},{"fr":"Il n'est pas disponible.","ar":"هو غير متاح.","note":"نفي: n' قبل حرف العلة"},{"fr":"Mes amis sont à Paris.","ar":"أصدقائي في باريس.","note":"جمع الفاعل + sont"}],"pron":[{"w":"je suis","ipa":"[ʒə.sɥi]","approx":"جو-سوي"},{"w":"nous sommes","ipa":"[nu.sɔm]","approx":"نو-سوم"},{"w":"ils sont","ipa":"[il.sɔ̃]","approx":"يل-سون","note":"الـ t صامتة"}],"vocab":[{"fr":"fatigué(e)","ar":"متعب(ة)","pos":"adj","g":"mf","ipa":"[fa.ti.ɡe]","exFr":"Je suis fatigué.","exAr":"أنا متعب."},{"fr":"heureux / heureuse","ar":"سعيد / سعيدة","pos":"adj","g":"mf","ipa":"[ø.ʁø / ø.ʁøz]","exFr":"Elle est heureuse.","exAr":"هي سعيدة."},{"fr":"malade","ar":"مريض / مريضة","pos":"adj","g":"mf","ipa":"[malad]","exFr":"Je suis malade aujourd'hui.","exAr":"أنا مريض اليوم."},{"fr":"ici","ar":"هنا","pos":"adv","ipa":"[i.si]","exFr":"Je suis ici.","exAr":"أنا هنا."},{"fr":"en retard","ar":"متأخر","pos":"expression","ipa":"[ɑ̃.ʁə.taʁ]","exFr":"Le train est en retard.","exAr":"القطار متأخر."},{"fr":"prêt(e)","ar":"جاهز(ة)","pos":"adj","g":"mf","ipa":"[pʁɛ]","exFr":"Nous sommes prêts.","exAr":"نحن جاهزون."},{"fr":"mal / bien","ar":"بسوء / بخير","pos":"adv","ipa":"[mɑl / bjɛ̃]","exFr":"Je ne vais pas bien.","exAr":"لست بخير."},{"fr":"seul(e)","ar":"وحيد(ة)","pos":"adj","g":"mf","ipa":"[sœl]","exFr":"Elle est seule.","exAr":"هي وحيدة."},{"fr":"occupé(e)","ar":"مشغول(ة)","pos":"adj","g":"mf","ipa":"[ɔ.kype]","exFr":"Je suis occupé.","exAr":"أنا مشغول."},{"fr":"content(e)","ar":"سعيد / سعيدة","pos":"adj","g":"mf","ipa":"[kɔ̃tɑ̃]","exFr":"Elle est contente ce matin.","exAr":"هي سعيدة هذا الصباح."},{"fr":"ensemble","ar":"معًا","pos":"adv","ipa":"[ɑ̃.sɑ̃bəl]","exFr":"Nous sommes ensemble.","exAr":"نحن معًا."}],"grammar":[{"tFr":"Être au présent","tAr":"القاعدة: تصريف être وجملة التصفية","body":["être هو الفعل الوحيد الذي لا يشبه أي فعل آخر في تصريفه؛ لذلك يُحفظ مستقلًا. القاعدة العامة: بعد être تأتي الصفة أو المهنة أو المكان مباشرة.","المطابقة إلزامية: الصفة تأخذ علامة جنس الفاعل (e للمؤنث) وعلامة عدده (s للجمع). إن نسيت العلامة بقي المعنى صحيحًا لكن النطق والكتابة يبدوان أجنبيين."],"ex":[{"fr":"Je suis étudiant.","ar":"أنا طالب."},{"fr":"Elles sont intelligentes.","ar":"هن ذكيات."}]}],"mistakes":[{"wrong":"Je fatigué aujourd'hui","right":"Je suis fatigué aujourd'hui","why":"الصفة لا تأتي بعد الفاعل مباشرة؛ تحتاج être."},{"wrong":"Il est le médecin","right":"Il est médecin","why":"المهنة بعد être مجرّدة بلا أداة تعريف."},{"wrong":"Vous sommes à la maison","right":"Vous êtes à la maison","why":"vous يقترن بـ êtes وليس sommes."},{"wrong":"Elle est content","right":"Elle est contente","why":"مطابقة المؤنث تضيف e في نهاية الصفة."}],"dialogues":[{"title":"التعريف بالحالة في الهاتف","ctx":"صديق يسألك عن حالك عبر الهاتف","lines":[{"who":"Ami","fr":"Allô ? Comment ça va ?","ar":"هلو؟ كيف حالك؟"},{"who":"Toi","fr":"Ça va, merci. Je suis un peu fatigué.","ar":"بخير، شكراً. أنا قليلاً متعب."},{"who":"Ami","fr":"Tu es occupé ce soir ?","ar":"هل أنت مشغول هذا المساء؟"},{"who":"Toi","fr":"Non, je ne suis pas occupé. On se voit ?","ar":"لا، لست مشغولاً. هل نلتقي؟"},{"who":"Ami","fr":"D'accord, à sept heures ?","ar":"حسنًا، الساعة السابعة؟"}]}],"exercises":[{"t":"mcq","skill":"grammar","q":"أكمل: «Nous ___ étudiants.»","opts":["sommes","sont","êtes","suis"],"a":0,"why":"nous ← sommes."},{"t":"fill","skill":"grammar","q":"أكمل التصريف: «Tu ___ très gentil.»","fr":"Tu ___ très gentil.","ans":"es","why":"tu ← es."},{"t":"translate","skill":"writing","q":"ترجم: «هي ليست متعبة.»","ans":"Elle n'est pas fatiguée.","alts":["elle n est pas fatiguee"],"why":"النفي: n' + est + pas، والصفة بمطابقة المؤنث."},{"t":"order","skill":"grammar","q":"رتّب: «أنا سعيد هنا»","words":["Je","suis","heureux","ici"],"ans":"Je suis heureux ici","why":"ترتيب جملة التصفية: الفاعل ثم être ثم الصفة ثم ظرف المكان."},{"t":"listen","skill":"listening","q":"استمع واختر:","audio":"Vous êtes en retard !","opts":["أنتِ متأخرة (جمع/رسمي)","هو متأخر","نحن متأخرون","أنا متأخر"],"a":0,"why":"التمرين يربط النطق بالمعنى: اسمع الجملة وحدّد المفرد الصحيح — نفس مهارة الفيديو الرئيسي."},{"t":"speaking","skill":"speaking","q":"قل: «أنا طالب وأنا لست متعباً».","target":"Je suis étudiant et je ne suis pas fatigué","why":"تجربة تجمع تصريف être مع نفيه: جملة مثبتة وأخرى منفية في قول واحد."},{"t":"mcq","skill":"grammar","q":"أكمل: «Vous ___ à la maison.»","opts":["êtes","sommes","sont","est"],"a":0,"why":"vous ← êtes."},{"t":"order","skill":"grammar","q":"رتّب: «الطالبان جديدان»","words":["Les","étudiants","sont","nouveaux"],"ans":"Les étudiants sont nouveaux","why":"فاعل الجمع يأخذ être بصيغة sont، والصفة تأخذ علامة الجمع: nouveaux."}],"homework":"اكتب 6 جمل لتصريف être كاملة (سطر لكل ضمير) واقرأها بصوت عالٍ 5 مرات. الدرس السابق: أنت الدرس الأول في المستوى (بداية سلسلة A1) — الدرس التالي: a1-t2-l1 (الفعل avoir).","sources":[{"title":"تعلم اللغة الفرنسية بسهولة وسرعة للمبتدئين : تصريف الفعل Etre , Avoir الى الحاضر مع الأ…","channel":"la langue francaise","videoId":"KY32SIbmE-c","why":"شرح عربي مبسط لتصريف الفعلين معًا — يبني الصورة الكاملة قبل الغوص في التفاصيل.","cat":"Grammar","level":"A1","main":true},{"title":"Conjugaison du verbe verbe être au présent. Niveau A1","channel":"podcast francais facile","videoId":"v1tvQWULsXo","why":"تسميع تصريف être بالنطق الفرنسي الواضح — التكرار المنظم يثبّت الأفعال كما يثبّتها الأطفال الفرنسيون.","cat":"Grammar","level":"A1","extra":true},{"title":"Ne...Pas, Ne...Plus: La Négation en Français - L'essentiel en 8 minutes 🤩","channel":"Français avec Pierre","videoId":"ygO9WmfZUyA","why":"شرح بيير المحترم للنفي ne...pas/ne...plus في 8 دقائق — يصلح فورًا المحور الثالث.","cat":"Grammar","level":"A1","extra":true},{"title":"الفرق بين فعل avoir و فعل être","channel":"الفرنسية بسهولة للمبتدئين","videoId":"_ASx55gH38Q","why":"التمييز بين الفعلين الأساسيين هو أكمل أخطاء المبتدئين — مكمّل ممتاز لدرس être.","cat":"Grammar","dur":13,"level":"A1","extra":true}],"supplements":[{"id":"v1tvQWULsXo","title":"Conjugaison du verbe verbe être au présent. Niveau A1","channel":"podcast francais facile","why":"تسميع تصريف être بالنطق الفرنسي الواضح — التكرار المنظم يثبّت الأفعال كما يثبّتها الأطفال الفرنسيون.","lang":"fr"},{"id":"ygO9WmfZUyA","title":"Ne...Pas, Ne...Plus: La Négation en Français - L'essentiel en 8 minutes 🤩","channel":"Français avec Pierre","why":"شرح بيير المحترم للنفي ne...pas/ne...plus في 8 دقائق — يصلح فورًا المحور الثالث.","lang":"fr"},{"id":"_ASx55gH38Q","title":"الفرق بين فعل avoir و فعل être","channel":"الفرنسية بسهولة للمبتدئين","why":"التمييز بين الفعلين الأساسيين هو أكمل أخطاء المبتدئين — مكمّل ممتاز لدرس être.","dur":13,"lang":"ar"}]}]},{"id":"a1-t2","slug":"le-verbe-avoir","icon":"headphones","color":"#059669","fr":"Le verbe avoir","ar":"الفعل avoir (يملك/عند)","desc":"الإمتلاك، العمر، والتراكيب الشائعة مع avoir.","lessons":[{"id":"A1-t2-l1","fr":"Avoir : j'ai, tu as, il a...","ar":"Avoir: عندي، عندك، عنده...","objectives":["تصريف avoir في المضارع الستة","التمييز بين استخدام être وأ avoir في التصفية","استخدام avoir في تعبيرات العمر والحالة والجوع","تكوين النفي مع avoir"],"sections":[{"h":"تصريف avoir","p":["الفعل avoir (يملك) هو الفعل الثاني غير المنتظم الذي يبني مع être أساس الجملة الفرنسية. تصريفه: j'ai، tu as، il/elle a، nous avons，vous avez，ils/elles ont.","انتبه: الضمير je يتصل بهائاً فيصبح j'ai، والصيغة الأخيرة ils ont تُنطق \"إي-زون\" بحرف n صامت وتُقرأ ont مثل on. هذه الثلاثة مفاتيح أخطاء المبتدئين.","شاهد الفيديو الأساسي بالشرح العربي لتسمع التصريف مع الأمثلة، ثم عدّ بصوت مسموع: j'ai — tu as — il a — nous avons — vous avez — ils ont. ثلاث جولات يوميًا تكفي للتثبيت.","الفرق الحاسم: être للحالة والصفة (Je suis content)، أما avoir فيعبّر عن الملكية والصفات الجسدية: J'ai faim (جائع)، J'ai chaud (ليست حارقًا)، J'ai vingt ans (عندي عشرون سنة)، J'ai peur (خائف).","العمر بالفرنسية يُعرب بـ avoir لا être: Tu as dix ans حرفياً «لديك عشر سنوات» — على خلاف العربية والإنجليزية تقريبًا. هذا أشهر فخّ في درس العمر.","النفي: Je n'ai pas d'argent (ليس لدي مال). قبل حرف العلة: Il n'a pas de voiture. لاحظ أن نفي الملكية يأتي بـ de لا du بعد pas — قاعدة صغيرة تكسبك نقاطاً في كل كتابة."],"video":{"id":"BtYLTF5yBC0","title":"avoir فعل يملك بالفرنسية","channel":"اللغة الفرنسية للمبتدئين","why":"شرح عربي مباشر لفعل الملكية مع أمثلة يومية — الأنسب لأول لقاء مع avoir.","lang":"ar","main":true},"sub":[{"h":"جدول التصريف مع التقريب","p":["j'ai — /ʒe/ — \"جيه\" (أنا أملك)","tu as — /ty a/ — \"تي آ\" (أنت تملك)","il/elle a — /il ɛl a/ — \"إل/إل آ\" (هو/هي يملك)","nous avons — /nu zavɔ̃/ — \"نو-زافون\" (نحن نملك)","vous avez — /vu zave/ — \"فوا-زافيه\" (أنتم تملكون)","ils/elles ont — /il ɛl ɔ̃/ — \"إل/إل أُون\" (هم يملكون) — الـ n صامتة."]},{"h":"تعبيرات avoir اليومية الخمس","p":["J'ai faim / soif / sommeil — جائع / عطشان / نعسان. هذه الثلاثة تسبق أي وصف لحالتك الجسدية.","J'ai chaud / froid — حارّ عليّ / بارد عليّ. لا تقل Il est chaud عن حالتك أبدًا.","J'ai vingt ans — عمري عشرون سنة (حرفيًا: لديّ عشرون سنة).","J'ai peur / envie / besoin — أخاف / أريد / أحتاج. هذه تفتح لك أفعالًا كاملة في جمل قادمة.","J'ai raison / tort — أنا محق / مخطئ. عبارة رأي أساسية في أي نقاش."]},{"h":"être أم avoir؟ مقارنة سريعة","p":["الحالة النفسية والجسدية العامة: être — Je suis content / fatigué.","المشاعر المؤقتة والحواس والأعمار: avoir — J'ai peur / faim / vingt ans.","الحيلة: إن كانت الكلمة بعد الفعل صفةً محضة فهي être غالبًا؛ وإن كانت اسمًا محسوسًا (جوع، خوف، سنّ) فهي avoir."]}]},{"h":"الإمتلاك والعمر","p":["J'ai une voiture (عندي سيارة). J'ai deux frères (عندي أخوان). وللعمر: J'ai 30 ans (عمري 30 سنة) — الفرنسيون «يملكون» العمر.","للسؤال: As-tu un frère ? أو Tu as un frère ? وللنفي: Je n'ai pas de voiture — لاحظ de بعد pas بدل un/une.","استعمل لعبتي: اكتب 6 جمل نصف فيها حالتك اليوم بـ être، و6 جمل بـ avoir (فجوع، طلب، عمر). المقارنة العملية تثبت الفرق أسرع من جدول."]},{"h":"تراكيب avoir الذكية","p":["الفرنسيون «يملكون» الشعور بدل «أن يكونوا»: avoir faim (جائع)، avoir soif (عطشان)، avoir peur (خائف)، avoir froid/chaud (بارد/حار)، avoir raison (محق)، avoir sommeil (نعسان).","خطأ شائع للعرب: Je suis faim ✗ — الصحيح: J'ai faim ✓. وحتى البارد: J'ai froid وليس Je suis froid.","نفي الملكية يأتي بالهمزة: Je n'ai pas. احفظه مع النفي الذهبي: أي جملة تملكها قلبها بـ ne...pas وستكون صحيحة دائمًا."]},{"h":"التطبيق والتلخيص","p":["يُختم هذا الدرس بمنظومة الفعل avoir المتكاملة: تصريفه الستّة (ai، as، a، avons، avez، ont)، وتوظيفه في الملكية (J'ai une voiture) والعمر (J'ai vingt ans) والحالات الجسدية والنفسية (J'ai faim، J'ai peur، J'ai raison)، مع قاعدة نفي الملكية التي تحوّل un/une/des إلى de بعد pas. كما وضح الفيديو الرئيسي «avoir فعل يملك بالفرنسية» لقناة اللغة الفرنسية للمبتدئين، يقوم سلوك هذا الفعل على ثلاث ركائز: اندماج همزة je في j'ai، وحفظ الصيغة الأخيرة ont بنونها الصامتة، وتمييزها عن être في كل جملة تصفية.","اربط ما بنيته من être في a1-t1-l1 بالـ avoir هنا: هناك تكون الحالة والصفة (Je suis content)، وهنا تملك وتُشعر وتُعرب العمر (J'ai faim، J'ai trente ans)، وخلافُ الفعلين أخطر خطأ يقع فيه المبتدئ. وبعد إتقان avoir تستعد مباشرةً إلى a1-t3-l1 (aller + faire) لتركيب أفعال الحركة والفعل اليومي، ثمّ إلى a1-t4-l1 لتوظيف هذه الأفعال كلها مع الضمائر، وإلى a1-t5-l1 لقواعد الأدوات التي تسبق الأسماء التي تملكها.","أعد مشاهدة الفيديو الرئيسي «avoir فعل يملك بالفرنسية» ودوّن كل تعبير avoir يذكره المدرّس في عمود مستقل، ثمّ سجّل صوتك وأنت تتلو التصريف الستّة ثمّ تستعمل أربعة تعبيرات في جمل من إنشائك: faim و soif و peur و raison، وصحّح في تسجيلك أي جملة وقعت فيها في خطأ «Je suis faim» فحوّلها إلى «J'ai faim»، وقارن نطقك بالفيديو بعد التصحيح."]}],"examples":[{"fr":"J'ai une question.","ar":"عندي سؤال."},{"fr":"Elle a trois chats.","ar":"عندها ثلاث قطط."},{"fr":"Nous avons faim !","ar":"نحن جائعون!"},{"fr":"Tu as raison.","ar":"أنت محق."},{"fr":"Ils n'ont pas de temps.","ar":"ليس عندهم وقت."},{"fr":"Nous avons une grande maison.","ar":"لدينا بيت كبير.","note":"الملكية المباشرة"},{"fr":"Il a vingt-cinq ans.","ar":"عمره خمس وعشرون سنة.","note":"العمر مع avoir"},{"fr":"Elle n'a pas de frère.","ar":"ليس لديها أخ.","note":"النفي + de"},{"fr":"Vous avez bien travaillé !","ar":"لقد عملتم جيداً!","note":"has = ساعد في الماضي لاحقًا"}],"pron":[{"w":"j'ai","ipa":"[ʒe]","approx":"جيه"},{"w":"ils ont","ipa":"[il.zɔ̃]","approx":"يل-زون","note":"وصل liaison: [z]"},{"w":"vous avez","ipa":"[vu.za.ve]","approx":"فوزافي"}],"vocab":[{"fr":"avoir faim","ar":"يكون جائعاً","pos":"expression","ipa":"[a.vwaʁ fɛ̃]","exFr":"Le bébé a faim.","exAr":"الطفل جائع."},{"fr":"avoir soif","ar":"يكون عطشاناً","pos":"expression","ipa":"[a.vwaʁ swaf]","exFr":"J'ai soif.","exAr":"أنا عطشان."},{"fr":"avoir peur","ar":"يخاف","pos":"expression","ipa":"[a.vwaʁ pœʁ]","exFr":"Il a peur du noir.","exAr":"يخاف من الظلام."},{"fr":"avoir raison","ar":"يكون محقاً","pos":"expression","ipa":"[a.vwaʁ ʁe.zɔ̃]","exFr":"Tu as raison !","exAr":"أنت محق!"},{"fr":"une voiture","ar":"سيارة","pos":"nom","g":"f","pl":"des voitures","ipa":"[vwa.tyʁ]","exFr":"J'ai une voiture rouge.","exAr":"عندي سيارة حمراء."},{"fr":"une question","ar":"سؤال","pos":"nom","g":"f","pl":"des questions","ipa":"[kɛs.tjɔ̃]","exFr":"J'ai une question.","exAr":"عندي سؤال."},{"fr":"avoir chaud","ar":"يكون حارًا عليه","pos":"expression","exFr":"J'ai chaud, ouvre la fenêtre.","ipa":"[avwaʁ ʃo]","exAr":"حارّ عليّ، افتح النافذة."},{"fr":"l'argent","ar":"المال","pos":"nom","g":"m","ipa":"[laʁʒɑ̃]","exFr":"Je n'ai pas d'argent.","exAr":"ليس لدي مال."},{"fr":"un besoin","ar":"حاجة/احتياج","pos":"nom","g":"m","pl":"des besoins","ipa":"[bəzwɛ̃]","exFr":"J'ai besoin d'aide.","exAr":"أحتاج إلى مساعدة."},{"fr":"avoir l'air","ar":"يبدو أنّ / يظهر","pos":"loc. verb","g":"—","exFr":"Tu as l'air content.","ipa":"/avwaʁ lɛʁ/","exAr":"تبدو سعيداً."}],"grammar":[{"tFr":"Avoir au présent","tAr":"القاعدة: تصريف avoir واستعمالاته","body":["avoir يعبّر عن: الملكية (J'ai un livre)، العمر (J'ai dix ans)، الحالة الجسدية والنفسية المؤقتة (J'ai faim/froid/peur).","في النفي يصبح j'ai إلى je n'ai، وبعد pas تأتي de بدل du/une: Je n'ai pas de voiture."],"ex":[{"fr":"J'ai un chat.","ar":"لدي قطة."},{"fr":"Il n'a pas le temps.","ar":"ليس لديه وقت."}]}],"mistakes":[{"wrong":"Je ai vingt ans","right":"J'ai vingt ans","why":"بعد je تُحذف الهمزة ويُكتب الفاصل apostrophe."},{"wrong":"Je suis vingt ans","right":"J'ai vingt ans","why":"العمر يُعرب بالفرنسية بـ avoir لا être."},{"wrong":"J'ai pas de temps","right":"Je n'ai pas de temps","why":"النفي الكامل يتطلب ne قبل الفعل في الفصحى."},{"wrong":"Il n'a pas du travail","right":"Il n'a pas de travail","why":"بعد نفي الملكية يأتي de لا du."}],"dialogues":[{"title":"سؤال عن العمر والحالة في الحافلة","ctx":"سيدة تتحدث إلى شاب في الطريق","lines":[{"who":"Madame","fr":"Pardon, tu as l'heure ?","ar":"عفواً، كم الساعة؟"},{"who":"Jeune","fr":"Il est quinze heures.","ar":"الساعة الثالثة عصراً."},{"who":"Madame","fr":"Merci. Tu as l'air fatigué.","ar":"شكراً. تبدو متعباً."},{"who":"Jeune","fr":"Oui, j'ai beaucoup travaillé.","ar":"نعم، لقد عملت كثيراً."},{"who":"Madame","fr":"Courage ! Bonne soirée.","ar":"لا بأس! مساء سعيد."}]}],"exercises":[{"t":"mcq","skill":"grammar","q":"أكمل: «Elle ___ deux frères.»","opts":["a","as","ai","ont"],"a":0,"why":"elle ← a."},{"t":"mcq","skill":"vocabulary","q":"كيف تقول «أنا جائع»؟","opts":["Je suis faim","J'ai faim","J'ai une faim suis","Je mange faim"],"a":1,"why":"الجوع يُقال بـ avoir: J'ai faim."},{"t":"fill","skill":"grammar","q":"أكمل: «Nous ___ un rendez-vous.»","fr":"Nous ___ un rendez-vous.","ans":"avons","why":"nous ← avons."},{"t":"translate","skill":"writing","q":"ترجم: «ليس عندي سيارة.»","ans":"Je n'ai pas de voiture.","alts":["je n ai pas de voiture"],"why":"بعد pas مع avoir نستخدم de."},{"t":"listen","skill":"listening","q":"استمع واختر الجملة التي سمعتها بالضبط (avoir مع الحالة الجسدية):","audio":"Nous avons soif","opts":["Nous avons faim.","Nous avons soif.","Nous sommes soif.","Nous avons peur."],"a":1,"why":"العطش يُقال avoir soif؛ أمّا «Nous sommes soif» فهو خطأ شائع لأن هذه الحالات الجسدية تُعرب بـ avoir لا être."},{"t":"speaking","skill":"speaking","q":"قل: «عندي سيارة وأنا محق».","target":"J'ai une voiture et j'ai raison","why":"جملتان مع avoir: الأولى ملكية (une voiture) والثانية تعبير رأي (raison)."},{"t":"mcq","skill":"grammar","q":"أي جملة صحيحة عن الملكية؟","opts":["J'ai un frère","Je suis un frère","Il a je","Nous avonses"],"a":0,"why":"avoir للملكية: j'ai + المعدود."},{"t":"fill","skill":"grammar","q":"أكمل: «Tu ___ deux yeux.»","fr":"Tu ___ deux yeux.","ans":"as","why":"tu ← as."}],"homework":"اكتب 8 جمل avoir: 4 عن مقتنياتك و4 عن مشاعرك (faim, soif, froid, sommeil). الدرس السابق: a1-t1-l1 (الفعل être) — الدرس التالي: a1-t3-l1 (aller + faire).","sources":[{"title":"avoir فعل يملك بالفرنسية","channel":"اللغة الفرنسية للمبتدئين","videoId":"BtYLTF5yBC0","why":"شرح عربي مباشر لفعل الملكية مع أمثلة يومية — الأنسب لأول لقاء مع avoir.","cat":"Grammar","level":"A1","main":true},{"title":"conjugaison verbe être et avoir au présent de l'indicatif","channel":"Le professeur","videoId":"Lvs2OvBKSGU","why":"تصريف être وavoir معًا على السبورة بالنطق الأصيل — يقوّي المقارنة بين الفعلين.","cat":"Grammar","level":"A1","extra":true},{"title":"10 expressions avec le verbe AVOIR. Première partie. Niveau A1 de FLE. 😍 English subti…","channel":"La prof Elisabeth","videoId":"40iTiyh36kY","why":"عشر تراكيب حقيقية مع avoir بمستوى A1 من أستاذة FLE — يطبق مباشرة ما قرأته.","cat":"Grammar","level":"A1","extra":true},{"title":"تصريف الفعلين Être et Avoir في الحاضر والفرق بينهما","channel":"الحصة — La Séance","videoId":"HxN3FmFRPkM","why":"تصريف مشترك مع أمثلة تطبيقية — مراجعة مركزة لدرس avoir.","cat":"Grammar","dur":7,"level":"A1","extra":true}],"supplements":[{"id":"Lvs2OvBKSGU","title":"conjugaison verbe être et avoir au présent de l'indicatif","channel":"Le professeur","why":"تصريف être وavoir معًا على السبورة بالنطق الأصيل — يقوّي المقارنة بين الفعلين.","lang":"fr"},{"id":"40iTiyh36kY","title":"10 expressions avec le verbe AVOIR. Première partie. Niveau A1 de FLE. 😍 English subti…","channel":"La prof Elisabeth","why":"عشر تراكيب حقيقية مع avoir بمستوى A1 من أستاذة FLE — يطبق مباشرة ما قرأته.","lang":"fr"},{"id":"HxN3FmFRPkM","title":"تصريف الفعلين Être et Avoir في الحاضر والفرق بينهما","channel":"الحصة — La Séance","why":"تصريف مشترك مع أمثلة تطبيقية — مراجعة مركزة لدرس avoir.","dur":7,"lang":"ar"}]}]},{"id":"a1-t3","slug":"aller-et-faire","icon":"pen","color":"#059669","fr":"Aller et faire","ar":"الفعلان aller و faire","desc":"الذهاب، القيام، والتراكيب الأكثر استخداماً في الحوار.","lessons":[{"id":"A1-t3-l1","fr":"Je vais à l'école et je fais mes devoirs","ar":"أذهب إلى المدرسة وأعمل واجباتي","objectives":["تصريف aller في المضارع (vais, vas, va, allons, allez, vont)","تصريف faire (fais, fait, fait, faisons, faites, font)","استخدام aller مع À لوصف الاتجاه","استخدام faire في التعبيرات اليومية الجاهزة"],"sections":[{"h":"الفعلان Aller و Faire: التصريف والاستعمال","p":["الفعلان aller (يذهب) و faire (يفعل) يتصدران مع être و avoir قائمة الأفعال الأربعة الأكثر استخدامًا في الفرنسية. يجمعهما درس واحد لأن كليهما غير منتظم وشديد التكرار في الكلام اليومي.","تصريف aller: je vais، tu vas، il va، nous allons，vous allez，ils vont. لاحظ التغيّر الجذري في ils vont (تُنطق \"فون\") — الحرف v يتسلل في الجمع والسطر ينقلب.","تصريف faire: je fais، tu fais، il fait، nous faisons، vous faites، ils font. كلمة faisons تُنطق \"فِزون\" بحرف z ولا تُنطق \"فايزون\" — أشهر خطأ صوتي في هذا الدرس.","شاهد الفيديو الأساسي لتسمع الفعلين في جمل حقيقية، ثم اقرأ الجداول هنا بصوت مسموع. الفعلان يحفظان بالاستعمال لا بالجدول: اجعل كل جملة تستخدم فيها، فتثبّت الصيغة مع معناها.","aller مع حرف الجر à: Je vais au marché (أذهب إلى السوق)، Nous allons à l'école، Vous allez en France. لاحظ au = à + le و aux = à + les. هذه الصيغ الثلاث تُتقن في درس واحد.","faire تدخل في تعبيرات جاهزة لا تُفكّك: Faire du sport (يمارس الرياضة)، faire les courses (يتسوق)،faire une promenade (يتمشّى)، qu'est-ce que tu fais ? (ماذا تفعل؟). احفظها ككتل: من فكّكها نسيها."],"video":{"id":"jnsFUVwJLBk","title":"أهم أفعال اللغة الفرنسية في المضارع: avoir / être / aller et faire","channel":"Gilane Mohy — جيلان محيى","why":"يغطي les quatre verbes essentiels (aller و faire تحديدًا موضوع الدرس) في الحاضر مع تطبيقات — الأنسب كأساسي عربي.","dur":7,"lang":"ar","main":true},"sub":[{"h":"جداول التصريف المختصرة","p":["ALLER: je vais — tu vas — il va — nous allons — vous allez — ils vont.","FAIRE: je fais — tu fais — il fait — nous faisons — vous faites — ils font.","القاعدة الاستثنائية لـ faire مع nous و vous حفظ خاص: faisons / faites — وهي مواضع الاستعمال المنفصل (est-ce que...)."]},{"h":"تعبيرات faire اليومية التي تكفي أسبوعًا","p":["faire du soleil / du froid — يكون حارًا/باردًا (الطقس): Il fait beau aujourd'hui.","faire ses devoirs — يفعل واجباته.","faire la cuisine / la vaisselle — يطبغ / يغسل الأطباق.","qu'est-ce que je fais ? — ماذا أفعل؟ — جملة تفكّرك من أي مأزق."]},{"h":"aller في المواقف الأربعة الأساسية","p":["الاتجاه: Où vas-tu ? — Je vais au travail. (إلى أين تذهب؟ — إلى العمل.)","المستقبل القريب: Je vais partir غدًا (سأغادر) — هذا التكوين هو أساس درس المستقبل القريب لاحقًا.","السلام: Ça va ? — Ça va. (التحية القصيرة) — جملة منفصلة عن معنى «يذهب» تمامًا.","التمني: Tu vas bien ? — هل أنت بخير؟ — استعمال مهذب للاطمئنان."]}]},{"h":"الذهاب إلى: à, au, à la, aux","p":["قاعدة الذهاب: je vais + à. لكن à تتغير: للذكر المفرد: au = à + le: Je vais au marché (أذهب للسوق). للمؤنث: à la: Je vais à la plage. للجمع: aux: Je vais aux toilettes. قبل حرف علة: à l': Je vais à l'école.","خطأ شائع: Je vais à le marché ✗ ← الصحيح: Je vais au marché ✓.","الفرق بين aller و venir (يأتي): aller للذهاب منك وإلى مكان، venir للاتجاه نحوك. جملة واحدة تثبتهما: Je vais à Paris / Tu viens à Paris."]},{"h":"تصريف faire واستخداماته","p":["faire تعني «يفعل/يصنع»: je fais، tu fais، il/elle fait، nous faisons، vous faites، ils/elles font.","تراكيب يومية: faire les courses (يقوم بالتسوق)، faire du sport (يمارس الرياضة)، faire la cuisine (يطبخ)، faire ses devoirs (يعمل واجباته)، faire attention (ينتبه).","التمرين الصوتي: أغلق عينيك واسأل نفسك خمسة أسئلة يومية بالإجابة بـ faire و aller. الاسترجاع من الذاكرة أمامك أقوى من القراءة عشر مرات."]},{"h":"التطبيق والتلخيص","p":["يُختم هذا الدرس بربط الفعلين غير المنتظمين aller و faire في بنية واحدة: تصريف aller الستّ (vais، vas، va، allons، allez، vont) مع حرف الجر à وتحوّلاته au و à la و aux و à l'، وتصريف faire الستّ (fais، fait، fait، faisons، faites، font) مع تعبيراتها الجاهزة التي لا تُفكّك: faire du sport و faire les courses و faire ses devoirs و faire une promenade. كما وضح الفيديو الرئيسي «أهم أفعال اللغة الفرنسية في المضارع: avoir / être / aller et faire» لقناة Gilane Mohy — جيلان محيى، تُحفظ هذان الفعلان بالاستعمال في جمل يومية لا بالجدول، لأن كليهما ينحرف جذرياً عن قاعدة الأفعال المنتظمة.","ستجمع في الدرس التالي a1-t4-l1 (الضمائر) بين ما بنيته هنا وبين الضمائر الستّة، فتصبح جملك كاملة: Je vais... / Tu fais... / Ils vont... / Nous faisons.... وقد سبقك تصريف être في a1-t1-l1 وavoir في a1-t2-l1، فراجع هذين مع صيغتي aller وfaire حتى لا تتسرّع الصيغة مع الضمير، ثمّ انتقل بعدها إلى a1-t5-l1 (أدوات التعريف والتنكير) ليسبق اسم الوجهة أو المفعول أداة سليمة: au marché و à l'école و les courses.","أعد مشاهدة الفيديو الرئيسي «أهم أفعال اللغة الفرنسية في المضارع: avoir / être / aller et faire» وأوقفه عند كل مثال تذهب فيه أو تفعل فيه، ثمّ سجّل صوتك وأنت تصرّف الفعلين معاً في ست جمل: ثلاثٌ تبدأ بـ «Je vais...» وثلاثٌ تبدأ بـ «Je fais...»، وبعدها اكتب الجمل على الورق وصحّح فيها حرف الجر (au / à la / aux / à l') وقارن نطقك بالفيديو حرفياً."]}],"examples":[{"fr":"Je vais au travail en bus.","ar":"أذهب للعمل بالباص."},{"fr":"Nous allons à la plage dimanche.","ar":"نذهب للشاطئ الأحد."},{"fr":"Tu fais du sport ?","ar":"هل تمارس الرياضة؟"},{"fr":"Je fais mes devoirs.","ar":"أعمل واجباتي."},{"fr":"Elle fait la cuisine ce soir.","ar":"هي تطبخ هذا المساء."},{"fr":"Je vais à l'école à pied.","ar":"أذهب إلى المدرسة مشياً.","note":"aller + à"},{"fr":"Il fait du tennis le dimanche.","ar":"يلعب التنس يوم الأحد.","note":"faire + sport"},{"fr":"Nous faisons la cuisine ensemble.","ar":"نطبخ معاً.","note":"nous faisons"},{"fr":"Où allez-vous ?","ar":"إلى أين تذهب؟","note":"سؤال مهذب بالـ vous"}],"pron":[{"w":"je vais","ipa":"[ʒə.vɛ]","approx":"جو-فيه"},{"w":"ils vont","ipa":"[il.vɔ̃]","approx":"يل-فون"},{"w":"nous faisons","ipa":"[nu.fə.zɔ̃]","approx":"نو-فوزون"}],"vocab":[{"fr":"aller","ar":"يذهب","pos":"verbe","ipa":"[a.le]","exFr":"Où vas-tu ?","exAr":"إلى أين تذهب؟"},{"fr":"faire","ar":"يفعل / يصنع","pos":"verbe","ipa":"[fɛʁ]","exFr":"Que fais-tu ?","exAr":"ماذا تفعل؟"},{"fr":"l'école","ar":"المدرسة","pos":"nom","g":"f","ipa":"[e.kɔl]","exFr":"Je vais à l'école.","exAr":"أذهب للمدرسة."},{"fr":"faire les courses","ar":"يقوم بالتسوق","pos":"expression","ipa":"[fɛʁ le kuʁs]","exFr":"On fait les courses samedi ?","exAr":"نتسوق السبت؟"},{"fr":"faire du sport","ar":"يمارس الرياضة","pos":"expression","ipa":"[fɛʁ dy spɔʁ]","exFr":"Je fais du sport trois fois par semaine.","exAr":"أمارس الرياضة ثلاث مرات أسبوعياً."},{"fr":"faire une promenade","ar":"يتمشى","pos":"expression","exFr":"Faisons une promenade !","ipa":"[fɛʁ yn pʁɔnad]","exAr":"نتمشّى!"},{"fr":"il fait beau","ar":"الجو جميل","pos":"expression","exFr":"Il fait beau aujourd'hui.","ipa":"[il fɛ bo]","exAr":"الجو جميل اليوم."},{"fr":"le marché","ar":"السوق","pos":"nom","g":"m","pl":"les marchés","ipa":"[maʁʃe]","exFr":"Je vais au marché.","exAr":"أذهب إلى السوق."},{"fr":"en France","ar":"إلى فرنسا","pos":"locution","exFr":"Nous allons en France.","ipa":"[ɑ̃ fʁɑ̃s]","exAr":"نسافر إلى فرنسا."},{"fr":"le ménage","ar":"التنظيف المنزلي","pos":"nom","g":"m","exFr":"Il fait le ménage le dimanche.","ipa":"/lə menaːʒ/","exAr":"يُنظّف المنزل يوم الأحد."}],"grammar":[{"tFr":"Aller / Faire au présent","tAr":"القاعدة: تصريف الفعلين غير المنتظمين","body":["aller و faire ينحرف تصريفهما عن القاعدة المنتظمة تمامًا، لذلك يُحفظان كوحدات مستقلة بترتيب الضمائر الستة.","aller تدخل أيضًا في تكوين futur proche (aller + inf): Je vais manger — سآكل. تعلّمها الآن توفر عليك درسًا كاملًا لاحقًا."],"ex":[{"fr":"Tu vas où ?","ar":"إلى أين تذهب؟"},{"fr":"Ils font leurs devoirs.","ar":"هم يفعلون واجباتهم."}]}],"mistakes":[{"wrong":"Je vais en le marché","right":"Je vais au marché","why":"à + le = au، ولا يُفصل حرف الجر عن أداة التعريف."},{"wrong":"Nous faisons [fezɔ̃] منطوقة فايزون","right":"nous faisons /fə.zɔ̃/","why":"s في faisons تُنطق زاي وليس سين."},{"wrong":"Il va à Paris بحرف de","right":"Il va à Paris","why":"aller يأخذ à دائماً مع الوجهة."},{"wrong":"Je fais un sport","right":"Je fais du sport","why":"التعبير القياسي faire du sport بحرف الجر du."}],"dialogues":[{"title":"تحديد موعد للتمشية","ctx":"صديقان يخطّطان لنزهة","lines":[{"who":"Amine","fr":"Salut ! Tu fais quoi demain ?","ar":"أهلاً! ماذا تفعل غداً؟"},{"who":"Sara","fr":"Je vais au marché le matin. Et toi ?","ar":"سأذهب إلى السوق صباحاً. وأنت؟"},{"who":"Amine","fr":"Je fais mes devoirs, puis je fais une promenade.","ar":"سأفعل واجباتي، ثم أتمشى."},{"who":"Sara","fr":"Il fait beau demain, on va au parc ?","ar":"الجو جميل غداً، هل نذهب إلى الحديقة؟"},{"who":"Amine","fr":"Bonne idée ! On y va à dix heures.","ar":"فكرة جيدة! نذهب الساعة العاشرة."}]}],"exercises":[{"t":"mcq","skill":"grammar","q":"أكمل: «Je vais ___ cinéma.»","opts":["à le","au","à la","aux"],"a":1,"why":"cinéma مذكر مفرد: à + le = au."},{"t":"fill","skill":"grammar","q":"أكمل: «Nous ___ à la plage.»","fr":"Nous ___ à la plage.","ans":"allons","why":"nous + aller ← allons."},{"t":"mcq","skill":"grammar","q":"«العمل واجباتي» بالفرنسية:","opts":["Je fais mes devoirs","Je vais mes devoirs","Je suis mes devoirs","J'ai mes devoirs"],"a":0,"why":"faire ses devoirs = يعمل واجباته."},{"t":"translate","skill":"writing","q":"ترجم: «تذهب إلى المدرسة.» (هي)","ans":"Elle va à l'école.","alts":["elle va a l ecole"],"why":"elle ← va، وأمام العلة: à l'."},{"t":"listen","skill":"listening","q":"استمع واختر المعنى الصحيح (faire les courses):","audio":"On fait les courses samedi matin ?","opts":["نتسوق صباح السبت؟","نذهب للعمل السبت؟","نمارس الرياضة السبت؟","نطبخ السبت؟"],"a":0,"why":"faire les courses تعني التسوّق؛ أما الذهاب (aller) والرياضة (du sport) فتعبرتان مختلفتان."},{"t":"speaking","skill":"speaking","q":"قل: «أذهب إلى السوق ثم أعمل الرياضة».","target":"Je vais au marché et je fais du sport","why":"جملة تجمع aller مع حرف الجر au، و faire مع du sport، في آن واحد."},{"t":"mcq","skill":"grammar","q":"أكمل: «Nous ___ au parc demain.»","opts":["allons","allez","vont","vais"],"a":0,"why":"nous ← allons."},{"t":"translate","skill":"writing","q":"ترجم: «هي تفعل واجبها كل مساء.»","ans":"Elle fait ses devoirs chaque soir.","alts":["elle fait ses devoirs tous les soirs"],"why":"faire + ses devoirs."}],"homework":"اكتب جدول «ماذا تفعل كل يوم؟» بـ 5 جمل: Je vais... / Je fais... الدرس السابق: a1-t2-l1 (الفعل avoir) — الدرس التالي: a1-t4-l1 (الضمائر).","sources":[{"title":"أهم أفعال اللغة الفرنسية في المضارع: avoir / être / aller et faire","channel":"Gilane Mohy — جيلان محيى","videoId":"jnsFUVwJLBk","why":"يغطي les quatre verbes essentiels (aller و faire تحديدًا موضوع الدرس) في الحاضر مع تطبيقات — الأنسب كأساسي عربي.","cat":"Grammar","dur":7,"level":"A1","main":true},{"title":"Aller (to go) — Present Tense (French verbs conjugated by Learn French With Alexa)","channel":"Learn French With Alexa","videoId":"Ru9pCQDV1eE","why":"تصريف aller بالنطق البطيء المتكرر من سلسلة Alexa Essentials المرجعية عالميًا.","cat":"Grammar","level":"A1","extra":true},{"title":"Aller (to go) + prepositions (French Essentials Lesson 11)","channel":"Learn French With Alexa","videoId":"2oB5kR7CH8M","why":"درس Alexa المتخصص: aller مع أدوات المكان au/à la/aux — مطابق تمامًا لموضوع المحور.","cat":"Grammar","level":"A1","extra":true},{"title":"Verbe faire - Présent de l'indicatif - alain le lait","channel":"tialela99","videoId":"Ulw2HkqKaiQ","why":"أنشودة فعل faire من ألين لو-ليه — اللحن يثبت تصريف الفعل الثالث دون مجهود.","cat":"Grammar","level":"A1","extra":true},{"title":"جميع استعمالات le verbe aller","channel":"français avec saida","videoId":"xjDGTSGgfr4","why":"مرجع شامل لاستعمالات aller مع الجمل اليومية — يكمّل الجزء الأول من الدرس.","cat":"Grammar","dur":14,"level":"A1","extra":true},{"title":"شرح فعل Faire وجميع استعمالاته مع أمثلة وتمارين","channel":"bonjour — بونجور","videoId":"al4lsQ2Q_XI","why":"يركّز على faire وحدها بتمارين — يكمّل الجزء الثاني من الدرس.","cat":"Grammar","dur":6,"level":"A1","extra":true}],"supplements":[{"id":"Ru9pCQDV1eE","title":"Aller (to go) — Present Tense (French verbs conjugated by Learn French With Alexa)","channel":"Learn French With Alexa","why":"تصريف aller بالنطق البطيء المتكرر من سلسلة Alexa Essentials المرجعية عالميًا.","lang":"fr"},{"id":"2oB5kR7CH8M","title":"Aller (to go) + prepositions (French Essentials Lesson 11)","channel":"Learn French With Alexa","why":"درس Alexa المتخصص: aller مع أدوات المكان au/à la/aux — مطابق تمامًا لموضوع المحور.","lang":"fr"},{"id":"Ulw2HkqKaiQ","title":"Verbe faire - Présent de l'indicatif - alain le lait","channel":"tialela99","why":"أنشودة فعل faire من ألين لو-ليه — اللحن يثبت تصريف الفعل الثالث دون مجهود.","lang":"fr"},{"id":"xjDGTSGgfr4","title":"جميع استعمالات le verbe aller","channel":"français avec saida","why":"مرجع شامل لاستعمالات aller مع الجمل اليومية — يكمّل الجزء الأول من الدرس.","dur":14,"lang":"ar"},{"id":"al4lsQ2Q_XI","title":"شرح فعل Faire وجميع استعمالاته مع أمثلة وتمارين","channel":"bonjour — بونجور","why":"يركّز على faire وحدها بتمارين — يكمّل الجزء الثاني من الدرس.","dur":6,"lang":"ar"}]}]},{"id":"a1-t4","slug":"les-pronoms-sujets","icon":"users","color":"#059669","fr":"Les pronoms sujets","ar":"الضمائر الشخصية","desc":"je, tu, il, elle, nous, vous, ils, elles وأسرارها.","lessons":[{"id":"A1-t4-l1","fr":"Je, tu, il, elle...","ar":"أنا، أنت، هو، هي...","objectives":["استعمال الضمائر الستة بدلاً من الأسماء دون اختلاف المعنى","ترتيب الضمائر في الجملة الفرنسية","التفريق بين tu و vous عمليًا","استبدال الاسم بالضمير في حوار قصير"],"sections":[{"h":"الضمائر الأساسية","p":["الضمائر الشخصية الفاعلية (les pronoms sujets) هي: je، tu، il، elle، nous، vous، ils، elles. وظيفتها أن تحفظك من تكرار الأسماء: Marie étudie... Marie va... Étudie-t-elle ? — الضمير elle يغني عن تكرار Marie في كل جملة.","ترتيب الضمائر في الجملة: قبل الفعل مباشرة في الجملة المثبتة. Marie et moi → nous. Il parle → Il parle français. إن كان الفعل في سؤال مركّب بـ est-ce que فالضمير يأتي بعده: Est-ce qu'il parle ?","شاهد الفيديو الأساسي بالشرح العربي لتسمع الضمائر في جمل كاملة، ثم كرّر الجدول بصوت مسموع. الربط السمعي (tu تُنطق «تي»، vous تُنطق «فوا») يمنع الخلط أكثر من أي رسم توضيحي.","tu و vous ليسا ضميرين بمعنى واحد: tu غير رسمية (الأصدقاء والعائلة والأطفال)، وvous رسمية (الغرباء وكبار السن والإدارة وجمع «أنتم»). الاختيار الخاطئ يُقرأ كوقاحة أو كبرد — ولذلك نبدأ في كل تعارف بـ vous.","الضمير يحدد فعلاً في الجمع: il للغائب المفرد، وils للغائب الجمع بلا تمييز بين مذكر ومؤنث. أما elles فللمؤنث الجمع، ويبقى فعلهما في المضارع هو نفسه.","جملة المتكلم nous مزدوجة المعنى: «نحن» دائمًا. أما vous فبمعنى الجمع أو المفرد المخاطَب رسمية. حين تسمع merci beaucoup فيقول لك: merci, vous êtes gentil — الضمير هنا مفرد رسمية."],"video":{"id":"rsbb1aIfVoI","title":"الدرس السابع : الضمائر الشخصية وفعل الكون بالفرنسية بطريقة مبسطة être","channel":"من فرنسا","why":"شرح عربي يربط ضمائر الفرنسية بضمائر العربية — أسرع طريق للفهم العميق.","lang":"ar","main":true},"sub":[{"h":"جدول الضمائر كاملًا","p":["je — أنا (تُنطق /ʒə/ وتُكتب j' قبل حرف العلة)","tu — أنتَ/أنتِ (غير رسمية)","il / elle — هو / هي","nous — نحن","vous — أنتم / سيادتك (رسمية أو جمع)","ils / elles — هم / هنّ (الفعل واحد في المضارع)"]},{"h":"استبدال الاسم بالضمير: تمرين عملي","p":["Yasmine étudie → Elle étudie.","Yasmine et Karim étudient → Ils étudient.","Toi et moi, nous allons au cinéma → Nous allons au cinéma.","القاعدة: ابحث عن الفاعل، ثم بدّله بالضمير المطابق في العدد والجنس."]},{"h":"أخطاء الشحنة والترتيب","p":["خطأ: «Marie, elle est contente» في جملة مستقلة — هذا تكرار في لغة الحديث اليومية لا في الكتابة المنظمة.","خطأ: «Il pas va» — الضمير مع النفي يبقى قبل الفعل: Il ne va pas.","خطأ: وضع الضمير بعد الفعل في الجملة المثبتة — الاستثناء الوحيد أسئلة القسم: Tu viens-tu ? (نادرة في A0-A1)."]}]},{"h":"je أم j'؟","p":["je تتحول إلى j' قبل حرف علة: j'ai، j'habite، j'écris. مثال: Je parle (بحرف ساكن) لكن J'apprends (بحرف علة).","أما moi فهي شكل التوكيد: Moi, je suis marocain (أما أنا، فأنا مغربي). ونستخدمها بعد حروف الجر: avec moi، pour toi.","لفظ الضمير بسرعة يتوقف عند «nous» و«vous» — أبطئ عندهما خصوصًا، فالنطق الخاطئ يغيّر المعنى (nous ≠ nous autres)."]},{"h":"on — سر الفرنسيين","p":["on ضمير شائع جداً في الحديث اليومي وتعني «نحن/الناس/أحدهم» وتصرف مثل il/elle: On va au marché ? (نذهب للسوق؟). الفرنسيون يستخدمون on بدل nous في 90% من الحديث اليومي.","احفظ التصريف: on parle = هي يتحدث بصيغة المفرد. On est fatigués (نحن متعبون) — الصفة تتطابق عادة مع المعنى الجمعي.","استمع للحوار الإثرائي واكتبه من الذاكرة: كل ضمير سمعته، اكتب السؤال الذي يقابله. الربط السؤال-الجواب يثبت التموضع الصحيح للضمير."]},{"h":"التطبيق والتلخيص","p":["يُختم هذا الدرس بمنظومة الضمائر الفاعلية الثمانية: je و tu و il و elle و nous و vous و ils و elles مع on اليومي، وترتيبها الذي يسبق الفعل مباشرة في الإثبات والنفي ويأتي بعد est-ce que في السؤال، ثمّ الفرق العملي بين tu غير الرسمية وvous الرسمية في كل تعارف. كما وضح الفيديو الرئيسي «الدرس السابع : الضمائر الشخصية وفعل الكون بالفرنسية بطريقة مبسطة être» لقناة من فرنسا، يقوم إتقان الضمير على استبدال الاسم دون تغيير المعنى، ومطابقته لعدد الفاعل وجنسه، وحفظه ككتلة سمعية متّصلة بالفعل لا ككلمة منفصلة.","راجع الأفعال التي أتقنتها في a1-t1-l1 (être) و a1-t2-l1 (avoir) و a1-t3-l1 (aller + faire) مع الضمائر هنا: Je suis... / J'ai... / Je vais... / Je fais... — فهذه الجمل الأربع أوّل بناء متكامل تملكه في اللغة. وبعد إتقان تموضع الضمير انتقل إلى a1-t5-l1 (أدوات التعريف والتنكير) الذي يسبق الاسم المعرّف أو المنكّر في جمل الضمير: le livre و un livre و les amis.","أعد مشاهدة الفيديو الرئيسي «الدرس السابع : الضمائر الشخصية وفعل الكون بالفرنسية بطريقة مبسطة être» وأوقفه عند كل جملة واستبدل فيها الاسم بالضمير بصوت مسموع قبل أن ينطقه المدرّس، ثمّ سجّل صوتك وأنت تقرأ جملاً من إنشائك بضمائر الثمانية: جملتان بـ tu، وجملتان بـ vous، وجملتان بـ il/elle، وجملتان بـ ils/elles، وقارن ترتيب كلماتك بالترتيب الذي ورد في الفيديو."]}],"examples":[{"fr":"Je parle arabe. Tu parles français ?","ar":"أتحدث العربية. هل تتحدث الفرنسية؟"},{"fr":"Ali et Sara sont là — ils sont amis.","ar":"علي وسارة هنا — هما صديقان."},{"fr":"Nous sommes quatre.","ar":"نحن أربعة."},{"fr":"On va manger quoi ce soir ?","ar":"ماذا سنأكل الليلة؟","note":"أسلوب يومي شائع"},{"fr":"Est-ce que tu viens avec nous ?","ar":"هل تأتي معنا؟","note":"الضمائر في السؤال بـ est-ce que"},{"fr":"Pierre et moi, nous allons au restaurant.","ar":"بيير وأنا، نذهب إلى المطعم.","note":"Pierre et moi تصبح nous"},{"fr":"Elle ne le connaît pas.","ar":"هي لا تعرفه.","note":"gزيد تمهيدي — له درس خاص"},{"fr":"Vous voulez un café ?","ar":"هل تريد قهوة؟","note":"vous المخاطب رسمية"}],"pron":[{"w":"je","ipa":"[ʒə]","approx":"جو (خفيفة)"},{"w":"vous","ipa":"[vu]","approx":"فو"},{"w":"elles","ipa":"[ɛl]","approx":"إيل","note":"s صامتة"}],"vocab":[{"fr":"je / j'","ar":"أنا","pos":"pronom","ipa":"[ʒə / ʒ]","exFr":"J'apprends le français.","exAr":"أتعلم الفرنسية."},{"fr":"tu","ar":"أنتَ/أنتِ","pos":"pronom","ipa":"[ty]","exFr":"Tu es où ?","exAr":"أين أنت؟"},{"fr":"il / elle","ar":"هو / هي","pos":"pronom","ipa":"[il / ɛl]","exFr":"Elle travaille beaucoup.","exAr":"هي تعمل كثيراً."},{"fr":"nous / on","ar":"نحن","pos":"pronom","ipa":"[nu / ɔ̃]","exFr":"On part demain.","exAr":"نغادر غداً."},{"fr":"vous","ar":"أنتم / حضرتكم","pos":"pronom","ipa":"[vu]","exFr":"Vous parlez français ?","exAr":"أتحدثون الفرنسية؟"},{"fr":"ils / elles","ar":"هم / هن","pos":"pronom","ipa":"[il / ɛl]","exFr":"Elles sont tunisiennes.","exAr":"هنّ تونسيات."},{"fr":"nous","ar":"نحن","pos":"pron","ipa":"[nu]","exFr":"Nous sommes prêts.","exAr":"نحن جاهزون."},{"fr":"on","ar":"المرء / نحن (ضمير عام)","pos":"pron","g":"—","exFr":"On dit que le français est facile.","ipa":"/ɔ̃/","exAr":"يُقال إن الفرنسية سهلة."},{"fr":"moi / toi","ar":"أنا / أنت (ضمير لفّاف)","pos":"pron","g":"—","exFr":"Moi, je parle ; toi, tu écoutes.","ipa":"/mwa/ twa/","exAr":"أنا أتحدث؛ وأنت تُصغي."},{"fr":"le pronom","ar":"الضمير","pos":"nom","g":"m","exFr":"«Je» est un pronom sujet.","ipa":"/lə pʁɔnɔ̃/","exAr":"Je ضمير فاعل."}],"grammar":[{"tFr":"Les pronoms sujets","tAr":"القاعدة: الضمائر الفاعلية وترتيبها","body":["الضمير الفاعل يأتي قبل الفعل مباشرة في الجملة المثبتة والمنفية، وبعد est-ce que في السؤال.","يجب أن يطابق الفاعل في العدد والجنس: elle للمفرد المؤنث، ils/elles للجمع مع الفعل نفسه في المضارع."],"ex":[{"fr":"Tu parles bien.","ar":"أنت تتكلم جيداً."},{"fr":"Ils habitent ici.","ar":"هم يسكنون هنا."}]}],"mistakes":[{"wrong":"Marie, elle va à l'école","right":"Marie va à l'école","why":"في الكتابة المنظمة لا نكرر الاسم والضمير معًا."},{"wrong":"Il va pas","right":"Il ne va pas","why":"ne تسبق الفعل حتى مع الضمير القصير."},{"wrong":"Vous es content","right":"Vous êtes contents","why":"vous يقترن بـ êtes في être."},{"wrong":"Elle vont au travail","right":"Elles vont au travail","why":"الفعل نفسه في المضارع لكن اكتب الضمير بصيغته الصحيحة."}],"dialogues":[{"title":"حوار قصير في المصعد","ctx":"جاران يلتقيان في المصعد","lines":[{"who":"Mme Diallo","fr":"Bonjour ! Vous habitez ici ?","ar":"مرحباً! هل تسكن هنا؟"},{"who":"Vous","fr":"Oui, j'habite au deuxième. Et vous ?","ar":"نعم، أسكن في الطابق الثاني. وأنتِ؟"},{"who":"Mme Diallo","fr":"Moi, je suis au cinquième avec mes enfants.","ar":"أنا في الخامس مع أطفالي."},{"who":"Vous","fr":"Ils vont à l'école près d'ici ?","ar":"هل يذهبون إلى مدرسة قريبة من هنا؟"},{"who":"Mme Diallo","fr":"Oui, ils marchent à pied. Voici le rez-de-chaussée.","ar":"نعم، يمشون. هذا هو الطابق الأرضي."}]}],"exercises":[{"t":"mcq","skill":"grammar","q":"علي وسارة في الصف — أي ضمير نستخدم؟","opts":["elles","ils","nous","on"],"a":1,"why":"المجموعة المختلطة تُعامل كمذكر: ils."},{"t":"fill","skill":"grammar","q":"أكمل: «___ apprends le français.» (أنا)","fr":"___ apprends le français.","ans":"J'","alts":["j"],"why":"قبل حرف علة (a) نستخدم j'."},{"t":"mcq","skill":"grammar","q":"أي جملة تستخدم on بشكل يومي صحيح؟","opts":["On suis amis","On est amis","On être amis","On avons amis"],"a":1,"why":"on تصرف مثل il: on est."},{"t":"translate","skill":"writing","q":"ترجم: «هي تعمل كثيراً.»","ans":"Elle travaille beaucoup.","alts":["elle travaille beaucoup"],"why":"الضمير elle يسبق الفعل مباشرة في الجملة المثبتة: Elle travaille."},{"t":"listen","skill":"listening","q":"استمع واختر الضمير:","audio":"Elles sont françaises","opts":["elles","ils","elle","on"],"a":0,"why":"الجمع المؤنث الغائب elles يظهر حرف s في آخره، والفعل يبقى في صيغة المفرد."},{"t":"order","skill":"grammar","q":"رتّب: «نذهب إلى السوق» (بأسلوب on)","words":["On","va","au","marché"],"ans":"On va au marché","why":"on تأتي قبل الفعل وتتصرف بصيغة المفرد: On va."},{"t":"mcq","skill":"grammar","q":"ما الضمير الصحيح: «___ parle français.»","opts":["Il","Le","Lui","On a"],"a":0,"why":"الفاعل غائب مفرد: il."},{"t":"order","skill":"grammar","q":"رتّب: «نحن نسكن هنا»","words":["Nous","habitons","ici"],"ans":"Nous habitons ici","why":"الترتيب المثبّت: الضمير ثم الفعل ثم ظرف المكان."}],"homework":"اكتب جملة لكل ضمير من الثمانية عن نفسك وعائلتك وأصدقائك. الدرس السابق: a1-t3-l1 (aller + faire) — الدرس التالي: a1-t5-l1 (أدوات التعريف والتنكير).","sources":[{"title":"الدرس السابع : الضمائر الشخصية وفعل الكون بالفرنسية بطريقة مبسطة être","channel":"من فرنسا","videoId":"rsbb1aIfVoI","why":"شرح عربي يربط ضمائر الفرنسية بضمائر العربية — أسرع طريق للفهم العميق.","cat":"Grammar","level":"A1","main":true},{"title":"French Lesson 12 - Subject pronouns in French Pronoms personnels sujet Pronombres perso…","channel":"YouLearnFrench","videoId":"Zv4W_Q250ow","why":"الضمائر الستة بالنطق الفرنسي مع جدول بصري واضح للتقليد الصوتي.","cat":"Grammar","level":"A1","extra":true},{"title":"PRONOMS FRANÇAIS | 😉 Explications, Exemples et Test","channel":"Guillaume Posé - Professeur de français","videoId":"4ZGG9u9m_hw","why":"غيوم بوزيه يشرح الضمائر ومنها on بأسلوبه الشهير مع اختبار تفاعلي في النهاية.","cat":"Grammar","level":"A1","extra":true},{"title":"الدرس 04: الضمائر الشخصية les pronoms personnels sujets","channel":"Appfrançais — تعلم اللغة الفرنسية","videoId":"R61bhSeRfoA","why":"شرح متسلسل لضمائر الفاعل مع الترتيب والتركيب — مرجع عربي واضح للدرس.","cat":"Grammar","dur":8,"level":"A1","extra":true},{"title":"Les pronoms personnels sujets / les pronoms personnels toniques","channel":"Prof. Abdellatif","videoId":"WhmcAhZK2jo","why":"يفصل بين ضمائر الفاعل وضمائر التوكيد — إثراء لفهم الاستعمال الصحيح.","cat":"Grammar","dur":10,"level":"A1","extra":true}],"supplements":[{"id":"Zv4W_Q250ow","title":"French Lesson 12 - Subject pronouns in French Pronoms personnels sujet Pronombres perso…","channel":"YouLearnFrench","why":"الضمائر الستة بالنطق الفرنسي مع جدول بصري واضح للتقليد الصوتي.","lang":"fr"},{"id":"4ZGG9u9m_hw","title":"PRONOMS FRANÇAIS | 😉 Explications, Exemples et Test","channel":"Guillaume Posé - Professeur de français","why":"غيوم بوزيه يشرح الضمائر ومنها on بأسلوبه الشهير مع اختبار تفاعلي في النهاية.","lang":"fr"},{"id":"R61bhSeRfoA","title":"الدرس 04: الضمائر الشخصية les pronoms personnels sujets","channel":"Appfrançais — تعلم اللغة الفرنسية","why":"شرح متسلسل لضمائر الفاعل مع الترتيب والتركيب — مرجع عربي واضح للدرس.","dur":8,"lang":"ar"},{"id":"WhmcAhZK2jo","title":"Les pronoms personnels sujets / les pronoms personnels toniques","channel":"Prof. Abdellatif","why":"يفصل بين ضمائر الفاعل وضمائر التوكيد — إثراء لفهم الاستعمال الصحيح.","dur":10,"lang":"ar"}]}]},{"id":"a1-t5","slug":"les-articles-definis-et-indefinis","icon":"mic","color":"#059669","fr":"Les articles définis et indéfinis","ar":"أدوات التعريف والتنكير","desc":"le, la, les و un, une, des — قلب الجملة الفرنسية.","lessons":[{"id":"A1-t5-l1","fr":"Le, la, les — un, une, des","ar":"أدوات التعريف والتنكير","objectives":["اختيار le/la/les/l' حسب الجنس والعدد","استعمال un/une/des قبل المفرد والجمع المعدود","معرفة متى تُحذف الأداة (partitif بعد avoir)","تطبيق الأدوات في جمل مكتوبة دون خطأ"],"sections":[{"h":"أدوات التعريف","p":["أدوات التعريف (le, la, les, l') تشير إلى شيء معروف أو محدّد: le livre (الكتاب)، la maison (البيت)، les enfants (الأطفال). أما أدوات التنكير (un, une, des) فتشير إلى شيء غير محدد: un livre (كتاب ما)، une maison (بيت ما)، des livres (كتب).","الاختيار يعتمد على ثلاثة أمور فقط: الجنس (مذكر le/un، مؤنث la/une)، العدد (مفرد، جمع les/des)، وحرف العلة (l' قبل متحرك: l'école، l'homme). احفظ هذا المثلث وستختار أداة في أقل من ثانية.","شاهد الفيديو الأساسي بالشرح العربي لتسمع الأدوات في جمل مكتوبة، ثم طبّق هنا: افتح أي كتاب واختر الأداة لعشر كلمات متتالية. التطبيق المتكرر يبني الحدس قبل الحفظ.","قبل حرف العلة تندمج le أو la مع الهمزة في l': le école → l'école، la amie → l'amie. أما les فتبقى كما هي قبل المتحرك: les étudiants. لاحظ التماثل واحفظه كوحدة واحدة.","في النفي والسؤال عن الشيء نستخدم de بدل الأداة: Je n'ai pas de voiture (ليس لدي سيارة) — لا تقل pas la voiture. ونقول Combien de livres ? (بكم عدد الكتب؟) لا Combien les livres.","الخطأ الشائع: خلط la و le مع جنس الكلمة العربية بدل جنسها الفرنسي. la voiture مؤنثة بالفرنسية رغم مذكرتها بالعربية، وle problème مذكر رغم مؤنثه بالعربية. الجنس يُحفظ مع الكلمة لا بترجمتها."],"video":{"id":"MANFli3p9pg","title":"تعلم الفرنسية : Les Articles : Un - Une - Des - La - Le - Les","channel":"Apprendre Le Français - FrTV - تعلم الفرنسية","why":"شرح عربي شامل للأدوات معاً un/une/le/la/les — يغطي المحورين الأول والثاني دفعة واحدة.","lang":"ar","main":true},"sub":[{"h":"خريطة الاختيار في سطرين","p":["مفرد مذكر معروف: le — مفرد مذكر غير محدد: un.","مفرد مؤنث معروف: la — مفرد مؤنث غير محدد: une.","جمع معروف: les — جمع غير محدد: des.","قبل حرف علة: l' في الحالتين، ونفحص الحالة بالسؤال: est-ce que c'est défini ?"]},{"h":"أدوات التنكير في العدّ والنفي","p":["un camion (شاحنة ما) — deux camions (شاحنتان، بلا أداة).","une question (سؤال ما) — trois questions (ثلاثة أسئلة، بلا أداة).","النفي: pas de / n'a pas de — J'ai des amis mais je n'ai pas d'amis ici."]},{"h":"تمارين تصحيح سريع","p":["___ livre est sur la table → Le (شيء محدد).","Je voudrais ___ café, s'il vous plaît → un (مفرد متحرك).","Les enfants mangent ___ gâteaux → des (جمع غير محدد).","Il est dans ___ hôtel → un (h صامتة في النطق فتبقى أداة غير متحركة)."]}]},{"h":"أدوات التنكير","p":["un (مذكر مفرد): un livre (كتاب). une (مؤنث مفرد): une maison (بيت). des (جمع): des livres, des maisons (كتب/بيوت).","الفهم العملي: le livre = كتاب محدد يعرفه المتحدثان، un livre = كتاب غير محدد. القاعدة الذهبية في الفرنسية: لا اسم بدون أداة (على عكس العربية أحياناً).","أضف مثالين من حياتك لكل أداة: le téléphone de mon père، une tasse de thé. الكلمات الخاصة بك تخزن أسرع من كلمات الجداول."]},{"h":"النفي يلغي الأداة","p":["في النفي تتحول un/une/des إلى de: J'ai une voiture → Je n'ai pas de voiture. J'ai des amis → Je n'ai pas d'amis (d' قبل حرف علة).","لكن التعريف يبقى: Je n'aime pas le café (لا أحب القهوة — تعريف لأننا نتحدث عن القهوة عموماً).","لاحظ في الفيديو الإثرائي كيف تتغير الأدوات مع نفي الملكية — هذا الربط يُنهي أكبر مصدر خطأ في كتابة المبتدئين."]},{"h":"التطبيق والتلخيص","p":["يُختم هذا الدرس بميزان الأدوات كله: أدوات التعريف le و la و les و l' للمعدود المعروف أو المحدّد، وأدوات التنكير un و une و des للمعدود عند أول ذكره أو غير المحدّد، وحتمية الأداة قبل الاسم في الفرنسية، ثمّ استثناء النفي الذي يحوّل un/une/des إلى de ويبقي التعريف على حاله. كما وضح الفيديو الرئيسي «تعلم الفرنسية : Les Articles : Un - Une - Des - La - Le - Les» لقناة Apprendre Le Français - FrTV - تعلم الفرنسية، يُختار النوع بمثلث لا يخون: جنس الكلمة الفرنسي، وعددها، ووقوعها قبل حرف علة الذي يوحّد le وla في l'.","الأدوات تسبق الاسم والصفة في كل درس قادم: a1-t6-l1 (المذكر والمؤنث) يبني على جنس الكلمة نفسه الذي يحدّد le أو la و un أو une، ثمّ a1-t7-l1 (الجمع) يمدّك بعلامة s التي تنقل les و des إلى الجمع، ثمّ a1-t8-l1 (الصفات) حيث تسبق الأداة الصفة والمعدود معاً: le livre intéressant و une voiture rouge. استعد لهذه السلسلة بحفظ المثلث: جنس، عدد، حرف علة.","أعد مشاهدة الفيديو الرئيسي «تعلم الفرنسية : Les Articles : Un - Une - Des - La - Le - Les» واكتب كل مثال للأدوات يذكره المدرّس في جدول بعمودين: تعريف وتنكير، ثمّ سجّل صوتك وأنت تقرأ عشرة أسماء من بيتك: خمسة معرّفة (le / la / les / l') وخمسة منكّرة (un / une / des)، وصحّح في تسجيلك كل موضع وقعت فيه بـ le أو la قبل حرف علة بدل l'."]}],"examples":[{"fr":"Le livre est sur la table.","ar":"الكتاب على الطاولة.","note":"تعريف: الكتاب المحدد"},{"fr":"J'ai un livre.","ar":"عندي كتاب.","note":"تنكير"},{"fr":"Les étudiants parlent.","ar":"الطلاب يتحدثون."},{"fr":"Il y a des fleurs dans le jardin.","ar":"هناك أزهار في الحديقة."},{"fr":"Je n'ai pas d'argent.","ar":"ليس عندي مال.","note":"des → d' في النفي"},{"fr":"Le matin, je bois un café.","ar":"في الصباح، أشرب قهوة.","note":"تعريف مع اسم محدد + تنكير مع شيء معدود"},{"fr":"Les élèves entrent dans l'école.","ar":"يدخل التلاميذ المدرسة.","note":"l' قبل حرف علة"},{"fr":"Je n'ai pas de voiture.","ar":"ليس لدي سيارة.","note":"في النفي: de بدل الأداة"},{"fr":"Elle achète des fruits et une baguette.","ar":"تشتري فاكهة ورغيفاً.","note":"des للجمع، une للمفرد المؤنث"}],"pron":[{"w":"les","ipa":"[le]","approx":"ليه","note":"s صامتة"},{"w":"des","ipa":"[de]","approx":"ديه"},{"w":"l'école","ipa":"[le.kɔl]","approx":"ليكول","note":"l' تتصل بالكلمة التالية"}],"vocab":[{"fr":"le / la / les","ar":"أداة التعريف","pos":"article","ipa":"[lə / la / le]","exFr":"Le soleil et la lune.","exAr":"الشمس والقمر."},{"fr":"un / une / des","ar":"أداة التنكير","pos":"article","ipa":"[œ̃ / yn / de]","exFr":"Un homme et une femme.","exAr":"رجل وامرأة."},{"fr":"le livre","ar":"الكتاب","pos":"nom","g":"m","pl":"les livres","ipa":"[lə li.vʁ]","exFr":"Le livre est intéressant.","exAr":"الكتاب مثير للاهتمام."},{"fr":"la maison","ar":"البيت","pos":"nom","g":"f","pl":"les maisons","ipa":"[la mɛ.zɔ̃]","exFr":"La maison est grande.","exAr":"البيت كبير."},{"fr":"la fenêtre","ar":"النافذة","pos":"nom","g":"f","pl":"les fenêtres","ipa":"[la fɛ.nɛtʁ]","exFr":"La fenêtre est ouverte.","exAr":"النافذة مفتوحة."},{"fr":"le café","ar":"القهوة / المقهى","pos":"nom","g":"m","pl":"les cafés","ipa":"[ka.fe]","exFr":"Un café, s'il vous plaît.","exAr":"قهوة من فضلك."},{"fr":"l'","ar":"أداة متحدة مع الهمزة","pos":"article","exFr":"l'école / l'ami","ipa":"[l]","exAr":"المدرسة/الصديق"},{"fr":"défini","ar":"معرّف/محدد","pos":"adj","ipa":"[defini]","exFr":"C'est le livre défini.","exAr":"إنه الكتاب المحدد."},{"fr":"indéfini","ar":"غير معرّف","pos":"adj","ipa":"[ɛ̃defini]","exFr":"Un livre indéfini.","exAr":"كتاب غير محدد."},{"fr":"la voiture","ar":"السيارة","pos":"nom","g":"f","pl":"les voitures","ipa":"[la vwatyʁ]","exFr":"La voiture est rouge.","exAr":"السيارة حمراء."},{"fr":"le problème","ar":"المشكلة","pos":"nom","g":"m","pl":"les problèmes","ipa":"[lə pʁɔblɛm]","exFr":"Le problème est grave.","exAr":"المشكلة خطيرة."}],"grammar":[{"tFr":"Articles définis / indéfinis","tAr":"القاعدة: أدوات التعريف والتنكير","body":["تعريف = le/la/les/l' مع شيء معروف؛ تنكير = un/une/des مع شيء أول ذكره أو غير محدد. جنس الكلمة فرنسي ويُحفظ معها.","بعد نفي الملكية وأسئلة العدّ تأتي de: pas de..., combien de.... ولا تستخدم الأداة هنا."],"ex":[{"fr":"Le journal est sur la table.","ar":"الجريدة على الطاولة."},{"fr":"Elle n'a pas d'enfants.","ar":"ليس لديها أطفال."}]}],"mistakes":[{"wrong":"la problème","right":"le problème","why":"جنس الكلمة فرنسي: problème مذكر بالفرنسية."},{"wrong":"je n'ai pas la voiture","right":"je n'ai pas de voiture","why":"بعد نفي الملكية تأتي de بدل الأداة."},{"wrong":"l'hommes","right":"les hommes","why":"l' للمفرد فقط؛ الجمع les يبقى منفصلاً."},{"wrong":"un garçons","right":"des garçons","why":"المفرد un لا ينطبق على الجمع."}],"dialogues":[{"title":"في المتجر: السؤال عن الشيء","ctx":"زبون يسأل بائعاً عن منتج","lines":[{"who":"Vendeur","fr":"Bonjour, vous cherchez quoi ?","ar":"مرحباً، ماذا تبحث؟"},{"who":"Client","fr":"Un sac, s'il vous plaît. Vous avez des sacs noirs ?","ar":"حقيبة من فضلك. هل لديكم حقائب سوداء؟"},{"who":"Vendeur","fr":"Oui, voici le sac en cuir.","ar":"نعم، تفضل الحقيبة الجلدية."},{"who":"Client","fr":"Combien coûte le sac ?","ar":"بكم الحقيبة؟"},{"who":"Vendeur","fr":"Il coûte quarante euros.","ar":"ثمنها أربعون يورو."}]}],"exercises":[{"t":"fill","skill":"grammar","q":"أكمل بالأداة المناسبة: «___ maison est grande.»","fr":"___ maison est grande.","ans":"La","alts":["la"],"why":"maison مؤنث مفرد ← la."},{"t":"mcq","skill":"grammar","q":"«عندي سيارات» بالفرنسية:","opts":["J'ai la voitures","J'ai des voitures","J'ai une voitures","J'ai le voiture"],"a":1,"why":"جمع منكّر ← des."},{"t":"mcq","skill":"grammar","q":"نفي «J'ai un frère» هو:","opts":["Je n'ai pas un frère","Je n'ai pas de frère","Je ne pas frère","Je n'ai pas des frère"],"a":1,"why":"un/une/des ← de في النفي."},{"t":"translate","skill":"writing","q":"ترجم: «الطلاب في المدرسة.»","ans":"Les étudiants sont à l'école.","alts":["les etudiants sont a l ecole"],"why":"لجمع معرّف نستخدم les، وقبل حرف العلة يندمج حرف الجر مع التعريف في l'."},{"t":"listen","skill":"listening","q":"استمع واختر ما سمعته:","audio":"une femme et un homme","opts":["امرأة ورجل","الامرأة والرجل","نساء ورجال","النساء والرجال"],"a":0,"why":"ما سمعته بصيغة التنكير un/une لا بصيغة التعريف le/la."},{"t":"order","skill":"grammar","q":"رتّب: «يوجد أزهار في الحديقة»","words":["Il","y","a","des","fleurs"],"ans":"Il y a des fleurs","why":"des أداة جمع منكّر، وil y a يليها مباشرةً قبل الاسم."},{"t":"mcq","skill":"grammar","q":"أكمل: «J'ai ___ chien et ___ chat.»","opts":["un / un","le / la","du / de la","des / des"],"a":0,"why":"تنكير مذكر ومؤنث: un + un."},{"t":"fill","skill":"grammar","q":"أكمل (نفي): «Il n'a pas de ___ (سيارة).»","fr":"Il n'a pas de ___.","ans":"voiture","why":"بعد نفي الملكية de بدل une."}],"homework":"اكتب 10 أشياء في بيتك: 5 مع أدوات التعريف و5 مع أدوات التنكير (le lit... / un lit...). الدرس السابق: a1-t4-l1 (الضمائر) — الدرس التالي: a1-t6-l1 (المذكر والمؤنث).","sources":[{"title":"تعلم الفرنسية : Les Articles : Un - Une - Des - La - Le - Les","channel":"Apprendre Le Français - FrTV - تعلم الفرنسية","videoId":"MANFli3p9pg","why":"شرح عربي شامل للأدوات معاً un/une/le/la/les — يغطي المحورين الأول والثاني دفعة واحدة.","cat":"Grammar","level":"A1","main":true},{"title":"French Definite Article / How to say THE in French (French Essentials Lesson 7)","channel":"Learn French With Alexa","videoId":"054MD3i3RDE","why":"درس Alexa لأدوات التعريف — سلسلة French Essentials الأكثر موثوقية للمبتدئين.","cat":"Grammar","level":"A1","extra":true},{"title":"Le, la, les / un, une, des : articles définis et indéfinis + négation","channel":"Ask the French teacher","videoId":"m-xDh7rKh_E","why":"درس مركز على نقطة المحور بالضبط: علاقة النفي بالأدوات — سؤال امتحانات DELF الكلاسيكي.","cat":"Grammar","level":"A1","extra":true},{"title":"استعمال الأدوات un, une, des, le, la, les","channel":"le français avec nabila — الفرنسية مع نبيلة","videoId":"v17x9g-bCY0","why":"أمثلة عملية على الأدوات الستة معًا من القناة المعتمدة — تطبيق بعد شرح القاعدة.","cat":"Grammar","dur":19,"level":"A1","extra":true},{"title":"Les articles définis — Le, La, Les, L' أدوات التعريف في الفرنسية","channel":"الفرنسية بسهولة للمبتدئين","videoId":"nWhKH--SpYk","why":"تخصيص أدوات التعريف وحدها مع حالات l' — تثبيت الجزء الأول من الدرس.","cat":"Grammar","dur":9,"level":"A1","extra":true}],"supplements":[{"id":"054MD3i3RDE","title":"French Definite Article / How to say THE in French (French Essentials Lesson 7)","channel":"Learn French With Alexa","why":"درس Alexa لأدوات التعريف — سلسلة French Essentials الأكثر موثوقية للمبتدئين.","lang":"fr"},{"id":"m-xDh7rKh_E","title":"Le, la, les / un, une, des : articles définis et indéfinis + négation","channel":"Ask the French teacher","why":"درس مركز على نقطة المحور بالضبط: علاقة النفي بالأدوات — سؤال امتحانات DELF الكلاسيكي.","lang":"fr"},{"id":"v17x9g-bCY0","title":"استعمال الأدوات un, une, des, le, la, les","channel":"le français avec nabila — الفرنسية مع نبيلة","why":"أمثلة عملية على الأدوات الستة معًا من القناة المعتمدة — تطبيق بعد شرح القاعدة.","dur":19,"lang":"ar"},{"id":"nWhKH--SpYk","title":"Les articles définis — Le, La, Les, L' أدوات التعريف في الفرنسية","channel":"الفرنسية بسهولة للمبتدئين","why":"تخصيص أدوات التعريف وحدها مع حالات l' — تثبيت الجزء الأول من الدرس.","dur":9,"lang":"ar"}]}]},{"id":"a1-t6","slug":"le-masculin-et-le-feminin","icon":"file","color":"#059669","fr":"Le masculin et le féminin","ar":"المذكر والمؤنث","desc":"كيف تعرف جنس أي اسم فرنسي؟ القواعد والاستثناءات.","lessons":[{"id":"A1-t6-l1","fr":"Masculin ou féminin ?","ar":"مذكر أم مؤنث؟","objectives":["تمييز جنس الاسم الفرنسي (c'est un / c'est une)","تحويل الصفة من المذكر إلى المؤنث بإضافة e","معرفة الاستثناءات الشائعة في جنس الأسماء","وصف الأشخاص والأشياء بدقة جنسية"],"sections":[{"h":"لماذا الجنس مهم؟","p":["كل اسم فرنسي إما مذكر (masculin) أو مؤنث (féminin)، ولا وسط. الجنس لا يُعرف من المعنى بل من الشكل غالبًا: نهايات -age و -ment و -ier مذكر، ونهايات -tion و -té و -ée مؤنث.","القاعدة العملية للصفات: أضف e إلى الصفة المذكرة فتصبح مؤنثة. grand → grande، petit → petite، content → contente. إن انتهت الصفة بـ e أصلاً فلا يتغير شيء: belle (جميلة) تبقى belle.","شاهد الفيديو الأساسي بالشرح العربي لتسمع التمييز في جمل وصف، ثم افتح قاموسك واختبر عشر كلمات: هل ستختار un أم une؟ الخطأ هنا ليس عيبًا بل جزء من عملية الحفظ.","الاسم يُحفظ مع أداته: لا تحفظ «voiture» مجرّدة بل «la voiture»، ولا «livre» بل «le livro». الأداة هي بطاقة هوية الاسم، ومن حفظها معه لا يحتاج لاحقًا لتحليل الجنس.","الاستثناءات القليلة التي يجب حفظها: une personne (شخس مؤنث حتى لو مذكراً)، un jour (يوم)، une eau (ماء) لأنها فردية، un problème (مشكلة) رغم -ème. هي أقل من عشر كلمات تحفظها مرة واحدة.","مع الأشخاص: أضف e للصفة لتصبح مؤنثة عن المرأة: un homme grand (رجل طويل) مقابل une femme grande (امرأة طويلة). هنا يظهر أثر الجنس على الكتابة في كل جملة تصف فيها شخصًا."],"video":{"id":"BMCJG0i57zw","title":"تعلم اللغة الفرنسية : كيف تميز بين الإسم المذكر و المؤنث في اللغة الفرنسية بشكل دقيق","channel":"عربي بلسان فرنسي","why":"شرح عربي لإشارات الجنس من نهايات الكلمات — الحيلة العملية الأولى للمتعلم العربي.","lang":"ar","main":true},"sub":[{"h":"نهايات تدل على الجنس","p":["مذكر غالبًا: -age (le voyage)، -ment (le moment)، -ier (le cahier)، -eau (le bateau).","مؤنث غالبًا: -tion / -sion (la nation)، -té (la beauté)، -ée (la journée)، -ure (la peinture)، -esse (la jeunesse).","التذكير: النهايات إرشادية لا حتمية — استثناء واحد يُحفظ ولا يُعمّم."]},{"h":"تحويل الصفات: من مذكرة إلى مؤنثة","p":["grand → grande، petit → petite، heureux → heureuse (تنتهي بـ x تتحول إلى s).","beau → belle (تبدّل شكلها: -eau ← -elle)، nouveau → nouvelle، vieux → vieille.","fraîche / sèche / rouge / verte — انتهت بـ e فلا تزيد: الصفة نفسها للمذكر والمؤنث."]},{"h":"تمارين تثبيت الجنس","p":["التمرين الأول: اكتب 10 أسماء من بيتك مع أداتها الصحيحة (le four، la table، les chaises).","التمرين الثاني: صف كل شيء بجملتين: C'est un grand frigo. C'est une grande table. لاحظ تغيّر e.","التمرين الثالث: اقلب الوصف: la voiture est rapide → le camion est rapide — ثم أضف e حيث يلزم."]}]},{"h":"قواعد التخمين الذكية","p":["غالباً ما تكون مؤنثة الكلمات المنتهية بـ: -tion (la nation)، -té (la liberté)، -ure (la culture)، -ance/-ence (l'importance)، -ie (la famille)، -ette (la cassette)، -esse (la sagesse)، -e الأخيرة أحياناً.","وغالباً مذكر: الكلمات المنتهية بـ -age (le fromage)، -ment (le gouvernement)، -eau (le bateau)، -isme (le tourisme)، -ier (le papier).","استثناءات مشهورة يجب حفظها: la photo (رغم -o)، le problème (رغم -e)، la main، l'eau (م مؤنث!).","الاستثناءات تُحفظ بالمثل لا بالقاعدة: jour = يوم مذكر، eau = ماء مؤنث، problème = مشكلة مذكر. ثلاث فقط تكفيك في هذا المستوى."]},{"h":"تحويل للجنس الآخر","p":["لكثير من المهن والصفات: نضيف -e للمؤنث: étudiant → étudiante، français → française، heureux → heureuse، sportif → sportive.","استثناءات قوية: homme/femme، père/mère، frère/sœur، oncle/tante — لها أسماء مختلفة كلياً.","بعد أن تتقن تحويل الصفة، صف ثلاثة أشخاص تعرفهم: un ami grand / une sœur intelligente / des parents gentils. الجملة الموصوفة تُثبت القاعدة في سياقها."]},{"h":"التطبيق والتلخيص","p":["يلخّص هذا الدرس قاعدة الجنس في الفرنسية: كل اسم إما مذكر أو مؤنث، والصفة تتبع الاسم بإضافة e إلى الصفة المذكرة، والاسم يُحفظ مع أداته لا مجرّدًا. كما وضح الفيديو الرئيسي «تعلم اللغة الفرنسية : كيف تميز بين الإسم المذكر و المؤنث في اللغة الفرنسية بشكل دقيق»، يقوم التمييز على نهايات الكلمات (-age و -ment و -ier للمذكر، و -tion و -té و -ée للمؤنث) ثم على الاستثناءات القليلة التي تُحفظ مرة واحدة ولا تُستنتج: le problème، un jour، une eau.","أدوات a1-t5 تسبق الاسم هنا؛ فاختيار le أو la أو un أو une هو الخطوة الأولى قبل تناول جنس الاسم، وهو ما ورد في a1-t5-l1، وبعد إتقان الجنس ينتقل المتعلم إلى a1-t7-l1 الذي يعالج الجمع، إذ تُضاف علامة الجمع إلى الاسم وقد تتبع الصفة الاسم كما تابعته في هذا الدرس.","أعد مشاهدة الفيديو الرئيسي بتركيز على الأمثلة النهائية التي يذكرها المشرح، ثم سجّل نفسك وأنت تصف خمسة أشياء من محيطك بصيغة C'est un... / C'est une... متبوعةً بصفة، واستمع إلى تسجيلك فصحّح كل أداة أو صفة خاطئة قبل أن تنتقل إلى الدرس التالي."]}],"examples":[{"fr":"Un étudiant / Une étudiante","ar":"طالب / طالبة"},{"fr":"Le problème est difficile.","ar":"المشكلة صعبة.","note":"المشكلة مذكر رغم e الأخيرة!"},{"fr":"La nation, la liberté, la culture","ar":"أمثلة للنهايات المؤنثة"},{"fr":"Un français / Une française","ar":"فرنسي / فرنسية"},{"fr":"C'est un vieux monsieur.","ar":"إنه رجل مسن.","note":"vieux لا تتغير: قاعدة مع الـ e"},{"fr":"La semaine est longue.","ar":"الأسبوع طويل.","note":"long → longue"},{"fr":"Une idée intéressante.","ar":"فكرة ممتعة.","note":"intéressant(e) تأخذ e"},{"fr":"Le matin, le café est chaud.","ar":"في الصباح، القهوة ساخنة.","note":"chaud → chaude للتأنيث"}],"pron":[{"w":"étudiante","ipa":"[e.ty.djɑ̃t]","approx":"إيتوديانط","note":"t تُنطق في المؤنث!"},{"w":"français / française","ipa":"[fʁɑ̃.sɛ / fʁɑ̃.sɛz]","approx":"فرونسيه / فرونسيس"}],"vocab":[{"fr":"le genre","ar":"الجنس النحوي","pos":"nom","g":"m","ipa":"[ʒɑ̃ʁ]","exFr":"Le genre est important en français.","exAr":"الجنس مهم في الفرنسية."},{"fr":"un problème","ar":"مشكلة","pos":"nom","g":"m","pl":"des problèmes","ipa":"[pʁɔ.blɛm]","exFr":"C'est un gros problème.","exAr":"إنها مشكلة كبيرة."},{"fr":"l'homme","ar":"الرجل","pos":"nom","g":"m","pl":"les hommes","ipa":"[ɔm]","exFr":"L'homme parle.","exAr":"الرجل يتكلم."},{"fr":"la femme","ar":"المرأة / الزوجة","pos":"nom","g":"f","pl":"les femmes","ipa":"[fam]","exFr":"La femme travaille.","exAr":"المرأة تعمل."},{"fr":"la main","ar":"اليد","pos":"nom","g":"f","pl":"les mains","ipa":"[mɛ̃]","exFr":"Mes mains sont froides.","exAr":"يديّ باردتان.","note":"استثناء: مؤنثة رغم النهاية"},{"fr":"masculin / féminin","ar":"مذكر / مؤنث","pos":"nom","exFr":"Le genre masculin.","ipa":"[maskylɛ̃ / feminine]","exAr":"الجنس المذكر."},{"fr":"un homme / une femme","ar":"رجل / امرأة","pos":"nom","exFr":"L'homme et la femme.","ipa":"[œ̃ ɔm / yn fam]","exAr":"الرجل والمرأة."},{"fr":"la beauté","ar":"الجمال","pos":"nom","g":"f","exFr":"La beauté de la ville.","ipa":"[bøte]","exAr":"جمال المدينة."},{"fr":"un cousin / une cousine","ar":"ابن العم / بنت العم","pos":"nom","g":"mf","pl":"des cousins / des cousines","ipa":"[œ̃ ku.zɛ̃ / yn ku.zin]","exFr":"Ma cousine habite près d'ici.","exAr":"ابنة عمتي تسكن قرب هنا.","note":"نفس الكلمة بعلامتَي تأنيث: e في نهاية المؤنث."},{"fr":"un acteur / une actrice","ar":"ممثل / ممثلة","pos":"nom","g":"mf","pl":"des acteurs / des actrices","ipa":"[œ̃ ta.ktœʁ / yn ta.ktʁis]","exFr":"L'actrice joue dans une pièce.","exAr":"الممثلة تمثل في مسرحية.","note":"المؤنث يتغيّر جذرًا: -teur ← -trice."},{"fr":"un voisin / une voisine","ar":"جار / جارة","pos":"nom","g":"mf","pl":"des voisins / des voisines","ipa":"[œ̃ vwa.zɛ̃ / yn vwa.zin]","exFr":"Le voisin est tranquille.","exAr":"الجار هادئ.","note":"زيادة e وحدها تكفي لتحويل المذكر إلى مؤنث."}],"grammar":[{"tFr":"Masculin / féminin des noms et adjectifs","tAr":"القاعدة: جنس الأسماء وتحويل الصفات","body":["الاسم يُحفظ مع أداته. الصفة تتبع الاسم: تأخذ e للمؤنث، وتتحول heureux → heureuse و beau → belle.","بعض الكلمات تنتهي بـ e للمذكر والمؤنث معًا (un police لا une police في A1) — ونبقى نعتمد على الأداة المحفوظة معها."],"ex":[{"fr":"Une grande maison.","ar":"بيت كبير (مؤنث)."},{"fr":"Un petit jardin.","ar":"حديقة صغيرة (مذكر)."}]}],"mistakes":[{"wrong":"la problème","right":"le problème","why":"المشكلة مذكر في الفرنسية رغم مؤنثها في العربية."},{"wrong":"elle est content","right":"elle est contente","why":"الصفة تأخذ e عند التأنيث."},{"wrong":"une beau maison","right":"une belle maison","why":"beau مع المؤنث تصبح belle."},{"wrong":"un jour (مذكر لا مؤنث)","right":"un jour","why":"day مذكر دائماً."}],"dialogues":[{"title":"وصف عائلة في الصورة","ctx":"زميل يصف صورة عائلته","lines":[{"who":"Lucie","fr":"C'est une photo de ma famille.","ar":"هذه صورة عائلتي."},{"who":"Toi","fr":"Qui est l'homme grand ?","ar":"من الرجل الطويل؟"},{"who":"Lucie","fr":"C'est mon père. Il est content.","ar":"إنه والدي. هو سعيد."},{"who":"Toi","fr":"Et la femme intelligente ?","ar":"والمرأة الذكية؟"},{"who":"Lucie","fr":"C'est ma sœur, elle est très belle.","ar":"إنها أختي، وهي جميلة جداً."}]}],"exercises":[{"t":"mcq","skill":"grammar","q":"ما جنس كلمة «problème»؟","opts":["مؤنث","مذكر","كلاهما","لا جنس"],"a":1,"why":"استثناء شهير: le problème مذكر."},{"t":"mcq","skill":"grammar","q":"الكلمات المنتهية بـ -tion عادة:","opts":["مذكر","مؤنث","جمع دائماً","لا قاعدة"],"a":1,"why":"-tion مؤنثة دائماً تقريباً: la situation."},{"t":"fill","skill":"grammar","q":"حوّل للمؤنث: «Il est étudiant.» ← «Elle est ___»","fr":"Elle est ___.","ans":"étudiante","alts":["etudiante"],"why":"نضيف e: étudiante."},{"t":"fill","skill":"grammar","q":"أكمل بالأداة: «___ nation est forte.»","fr":"___ nation est forte.","ans":"La","why":"nation مؤنثة (-tion)."},{"t":"listen","skill":"listening","q":"استمع واختر نوع الكلمة:","audio":"une table","opts":["مؤنث مفرد","مذكر مفرد","مؤنث جمع","مذكر جمع"],"a":0,"why":"une أداة تنكير للمفرد المؤنث؛ فالمفرد المؤنث يدل عليه علامة une لا un."},{"t":"translate","skill":"writing","q":"ترجم: «المرأة تعمل في المدرسة.»","ans":"La femme travaille à l'école.","alts":["la femme travaille a l ecole"],"why":"La femme مفرد مؤنث، والفعل يوافق الفاعل، و à l'école تُكتب مع apostrophe قبل l."},{"t":"mcq","skill":"vocabulary","q":"ما جنس كلمة «une table»؟","opts":["مؤنث","مذكر","محايد","جمع"],"a":0,"why":"المؤنث يدل عليه un/une: une table."},{"t":"translate","skill":"writing","q":"ترجم: «هذا قلم جديد.»","ans":"C'est un stylo nouveau.","alts":["cest un stylo nouveau"],"why":"التنكير un مع مؤنث/مذكر حسب الاسم."}],"homework":"اكتب 15 اسمًا من دروسك مع جنسها (le/la) وصنفها في جدولين: مذكر/مؤنث، وابحث عن القاعدة في كل مجموعة.\nالدرس السابق/التالي: a1-t5-l1 (أدوات التعريف والتنكير) / a1-t7-l1 (جمع الأسماء والصفات).","sources":[{"title":"تعلم اللغة الفرنسية : كيف تميز بين الإسم المذكر و المؤنث في اللغة الفرنسية بشكل دقيق","channel":"عربي بلسان فرنسي","videoId":"BMCJG0i57zw","why":"شرح عربي لإشارات الجنس من نهايات الكلمات — الحيلة العملية الأولى للمتعلم العربي.","cat":"Grammar","level":"A1","main":true},{"title":"Comment savoir si un mot est masculin ou féminin (niveau A1/A2)","channel":"podcast francais facile","videoId":"9FDmvpkhqeM","why":"بودكاست français facile يفصل قواعد التخمين بمستوى A1/A2 وسرد هادئ ممتاز للاستماع.","cat":"Grammar","level":"A1","extra":true},{"title":"Le masculin et le féminin/التحويل من المذكر للمؤنث في اللغة الفرنسية/الشرح بالعربية","channel":"Speak English and French","videoId":"q7Opz2BzoUk","why":"درس ثنائي اللغة للتحويل من المذكر للمؤنث بقواعده — مطابق حرفيًا لموضوع المحور.","cat":"Grammar","level":"A1","extra":true},{"title":"Le genre des noms || Féminin ou masculin || Français","channel":"Eveiller mon enfant","videoId":"E3nFnkRTIoM","why":"درس مخصص لجنس الأسماء (le genre des noms) وتمييز المذكر من المؤنث — مكمّل مباشر لمحور الدرس دون تداخل مع محور الصفات المخصّص للمستوى t8.","cat":"Grammar","dur":8,"level":"A1","extra":true}],"supplements":[{"id":"9FDmvpkhqeM","title":"Comment savoir si un mot est masculin ou féminin (niveau A1/A2)","channel":"podcast francais facile","why":"بودكاست français facile يفصل قواعد التخمين بمستوى A1/A2 وسرد هادئ ممتاز للاستماع.","lang":"fr"},{"id":"q7Opz2BzoUk","title":"Le masculin et le féminin/التحويل من المذكر للمؤنث في اللغة الفرنسية/الشرح بالعربية","channel":"Speak English and French","why":"درس ثنائي اللغة للتحويل من المذكر للمؤنث بقواعده — مطابق حرفيًا لموضوع المحور.","lang":"ar"},{"id":"E3nFnkRTIoM","title":"Le genre des noms || Féminin ou masculin || Français","channel":"Eveiller mon enfant","why":"درس مخصص لجنس الأسماء (le genre des noms) وتمييز المذكر من المؤنث — مكمّل مباشر لمحور الدرس دون تداخل مع محور الصفات المخصّص للمستوى t8.","dur":8,"lang":"fr"}]}]},{"id":"a1-t7","slug":"le-pluriel","icon":"briefcase","color":"#059669","fr":"Le pluriel","ar":"الجمع","desc":"من المفرد إلى الجمع: قواعد -s و -x والكلمات الخاصة.","lessons":[{"id":"A1-t7-l1","fr":"Le pluriel des noms et des adjectifs","ar":"جمع الأسماء والصفات","objectives":["تكوين جمع الاسم بإضافة s","معرفة الاستثناءات: -s → -x، -eau → -eaux","مطابقة الصفة في الجمع","استعمال les و des مع الجمع بثقة"],"sections":[{"h":"القاعدة العامة: + s","p":["قاعدة الجمع الأولى تكفي 80% من الكلمات: أضف s إلى المفرد. un livre → des livres، une chaise → des chaises، le café → les cafés. لا تتغيّر النطق غالبًا — الجمع الفرنسي علامة كتابية أكثر منها صوتية.","الاستثناءات ثلاثة رئيسة: الكلمات المنتهية بـ s أو x لا تزيد في الجمع (les chevaux من cheval، les yeux من oeil)، والكلمات المنتهية بـ -eau تأخذ -eaux (un bateau → des bateaux)، وبعض الكلمات المنتهية بـ -al تصبح -aux (un animal → des animaux).","شاهد الفيديو الأساسي بالشرح العربي لتصفّح الحالات الثلاث، ثم اكتب 15 كلمة تعلمتها حتى الآن بصيغتي المفرد والجمع. الرحلة من المفرد إلى الجمع بخطوة واحدة لا تحتاج أكثر من هذا.","الصفة تأتي بعد الاسم وتتبعه في الجمع: des livres intéressants (مثير للاهتمام)، des chaises blanches (بيضاء). النهاية s للصفة تأتي بعد صيغة المفرد نفسها: interesting → interesting+s.","انتبه: الجملة المفردة تبدأ بـ le/la، والجمع بـ les في التعريف، وبـ des في التنكير. la porte → les portes (ال)، une porte → des portes (بعض).","خطأ لفظي شائع: نطق الجمع بنطق مفرّد. قد يُقبل في البداية لكن الأذن الفرنسية تنبّه للخطأ. تدرّب على إضافة s المكتوبة في مخرج الصوت حتى تصبح عادة لحظية."],"video":{"id":"5EC1bzuGqfY","title":"جمع الأسماء والصفات — قواعد الدلف A1: Le pluriel des noms et des adjectifs","channel":"فرنشاوي Frenchawy","why":"شرح عربي لقواعد A1 الرسمية (جمع الاسم والصفة معًا) من أشهر قناة عربية متخصصة في التحضير لدلف.","dur":13,"lang":"ar","main":true},"sub":[{"h":"جدول الاستثناءات الكامل","p":["jeu → jeux (لعبة → ألعاب)، cheval → chevaux (حصان → خيول)، journal → journaux (جريدة → جرائد).","bureau → bureaux (مكتب → مكاتب)، château → châteaux، bateau → bateaux.","oeil → yeux (عين → أعين) — أشهر استثناء مطلق في اللغة الفرنسية.","un homme → des hommes — الـ h صامتة لكن s تبقى مكتوبة (والنطق لا يتغير)."]},{"h":"مطابقة الصفات في الجمع","p":["un livre utile → des livres utiles (الصفة لا تتغير بعد s).","une belle maison → de belles maisons (belle لا تأخذ s لأنها انتهت بـ e).","un grand arbre → de grands arbres — الصفة قبل الاسم أو بعده، وكلاهما يأخذ s."]},{"h":"دورة الكتابة: من مفرد إلى جمع","p":["خطوة 1: اكتب المفرد مع أداته: le garçon.","خطوة 2: بدّل الأداة: les garçons (تعريف) أو des garçons (تنكير).","خطوة 3: أضف s إلى أي صفة مصاحبة: les garçons contents."]}]},{"h":"الجموع بـ -x","p":["الكلمات المنتهية بـ -eau تأخذ -x: le bateau → les bateaux، le cadeau → les cadeaux. وكذلك -eu: le jeu → les jeux، le cheveu → les cheveux.","و7 كلمات بـ -ou تأخذ -x وأشهرها: le genou (الركبة) → les genoux. الباقي يأخذ -s العادية: les clous.","الكلمات المنتهية بـ -eau و -al تُكتب مع x في الكتابة أولاً — لا تحفظ النطق قبل الشكل، فالفرق الصوتي يظهر عند التمييز السمعي لاحقًا."]},{"h":"الجمع الشاذ","p":["الكلمات المنتهية بـ -al تصبح -aux: un journal → des journaux (صحف)، un animal → des animaux (حيوانات).","جمع شاذ خاص: un œil (عين) → des yeux (عيون) — احفظه فهو شائع جداً. أما le ciel → les cieux.","بعد إتقان الجمع، جرّب أن تصف 5 أشياء حولك بصيغة الجمع: des chaussures neuves، des clés rouges. الجملة الطويلة تكشف أي نقص في المطابقة."]},{"h":"التطبيق والتلخيص","p":["يلخّص هذا الدرس تكوين الجمع في الفرنسية: القاعدة العامة بإضافة s، ثم الاستثناءات الثلاثة (-s و -x لا تزيد، و-eau تصبح -eaux، و-al تصبح -aux)، ثم الجمع الشاذ لـ œil الذي يصبح yeux. كما وضح الفيديو الرئيسي «جمع الأسماء والصفات — قواعد الدلف A1: Le pluriel des noms et des adjectifs»، تأتي علامة الجمع في الكتابة لا في النطق غالبًا، ويجب أن تتبع الصفة الاسم في علامة العدد مع بقاء المعنى واحدًا.","الجمع يغيّر الصفة في a1-t8؛ ففي a1-t6-l1 تعلّمت أن الصفة تتبع الجنس بإضافة e، ويضيف الدرس التالي a1-t8-l1 علامة العدد s ومكان الصفة قبل الاسم أو بعده، فتصبح لكل صفة أربع صيغ: مفرد مذكر، ومفرد مؤنث، وجمع مذكر، وجمع مؤنث.","أعد مشاهدة الفيديو الرئيسي ودوّن كل استثناء يذكره في جدول من عمودين (مفرد/جمع)، ثم سجّل نفسك وأنت تحوّل خمس كلمات من دروسك السابقة إلى الجمع مع أداة les أو des الصحيحة، وقارن نطقك بالصورة المكتوبة قبل أن تنتقل إلى a1-t8."]}],"examples":[{"fr":"un livre → des livres","ar":"كتاب → كتب"},{"fr":"un cadeau → des cadeaux","ar":"هدية → هدايا"},{"fr":"un animal → des animaux","ar":"حيوان → حيوانات"},{"fr":"un œil → des yeux","ar":"عين → عيون","note":"الجمع الأشهر شذوذاً"},{"fr":"un journal → des journaux","ar":"صحيفة → صحف"},{"fr":"Les élèves arrivent à huit heures.","ar":"يصل التلاميذ الساعة الثامنة.","note":"les + جمع"},{"fr":"J'achète des fruits frais.","ar":"أشتري فاكهة طازجة.","note":"des + جمع تنكيري"},{"fr":"Les beaux jardins sont ouverts.","ar":"الحدائق الجميلة مفتوحة.","note":"beau → beaux في الجمع"},{"fr":"Trois chevaux noirs.","ar":"ثلاثة خيول سوداء.","note":"cheval → chevaux"}],"pron":[{"w":"bateaux","ipa":"[ba.to]","approx":"باتو","note":"x صامتة والنطق مثل المفرد"},{"w":"yeux","ipa":"[jø]","approx":"يو"}],"vocab":[{"fr":"un œil / des yeux","ar":"عين / عيون","pos":"nom","g":"m","pl":"les yeux","ipa":"[œj / jø]","exFr":"Elle a de beaux yeux.","exAr":"عندها عيون جميلة."},{"fr":"un animal","ar":"حيوان","pos":"nom","g":"m","pl":"des animaux","ipa":"[a.ni.mal]","exFr":"J'aime les animaux.","exAr":"أحب الحيوانات."},{"fr":"un journal","ar":"صحيفة","pos":"nom","g":"m","pl":"des journaux","ipa":"[ʒuʁ.nal]","exFr":"Je lis les journaux.","exAr":"أقرأ الصحف."},{"fr":"un cheveu","ar":"شعرة","pos":"nom","g":"m","pl":"des cheveux","ipa":"[ʃə.vø]","exFr":"Elle a les cheveux noirs.","exAr":"شعرها أسود."},{"fr":"un jeu","ar":"لعبة","pos":"nom","g":"m","pl":"des jeux","ipa":"[ʒø]","exFr":"Les jeux vidéo sont amusants.","exAr":"ألعاب الفيديو ممتعة."},{"fr":"le pluriel","ar":"الجمع","pos":"nom","g":"m","exFr":"Le pluriel des noms.","ipa":"[plyʁjɛl]","exAr":"جمع الأسماء."},{"fr":"un cheval / des chevaux","ar":"حصان / خيول","pos":"nom","g":"m","exFr":"Les chevaux courent.","ipa":"[ʃəval / ʃəvo]","exAr":"الخيول تركض."},{"fr":"un bateau / des bateaux","ar":"سفينة / سفن","pos":"nom","g":"m","exFr":"Des bateaux blancs.","ipa":"[bato / bato]","exAr":"سفينتان بيضاء (جمع)."},{"fr":"les yeux","ar":"العينان/الأعين","pos":"nom","g":"m pl","exFr":"Il a les yeux bleus.","ipa":"[le jø]","exAr":"عيناه زرقاوان."},{"fr":"intelligent(e)(s)","ar":"ذكي(ون)","pos":"adj","g":"mf","exFr":"Les élèves intelligents.","ipa":"[ɛ̃tɛliʒɑ̃]","exAr":"التلاميذ الأذكياء."},{"fr":"blanc / blanche","ar":"أبيض","pos":"adj","g":"mf","exFr":"Des chaussures blanches.","ipa":"[blɑ̃ / blɑ̃ʃ]","exAr":"حذاء أبيض (جمع)."},{"fr":"un journal / des journaux","ar":"جريدة / جرائد","pos":"nom","g":"m","exFr":"Je lis les journaux.","ipa":"[ʒuʁnal / ʒuʁno]","exAr":"أقرأ الجرائد."},{"fr":"un œuf / des œufs","ar":"بيضة / بيض","pos":"nom","g":"m","pl":"des œufs","ipa":"[œf / ø]","exFr":"J'achète six œufs.","exAr":"أشتري ست بيضات.","note":"جمع شاذ: النهاية f تتحول إلى x: œuf → œufs."}],"grammar":[{"tFr":"Le pluriel des noms et adjectifs","tAr":"القاعدة: تكوين الجمع","body":["القاعدة العامة: أضف s. الاستثناءات: -s/-x لا تزيد، -eau ← -eaux، -al ← -aux، oeil ← yeux.","الصفة تأخذ s مع الاسم إن لم تنته بـ s أو x أصلًا، وتبقى بلا تغيير إن انتهت بـ e."],"ex":[{"fr":"des journaux","ar":"جرائد"},{"fr":"de grandes maisons","ar":"بيوت كبيرة"}]}],"mistakes":[{"wrong":"les chevals","right":"les chevaux","why":"cheval يأخذ au في الجمع وليس s."},{"wrong":"des beaux maisons","right":"de belles maisons","why":"beau مع المؤنث collective تتحول إلى belle وليس beaux."},{"wrong":"je veux des bonnes idées bonne","right":"de bonnes idées","why":"الصفة bonne تأخذ s في الجمع بعد المؤنث."},{"wrong":"un oeil → des oeuils","right":"des yeux","why":"عين له جمع شاذ: yeux."}],"dialogues":[{"title":"التسوق: أسماء الأشياء بالجمع","ctx":"في محل ملابس","lines":[{"who":"Vendeuse","fr":"Vous cherchez quoi, monsieur ?","ar":"ماذا تبحث يا سيدي؟"},{"who":"Client","fr":"Des chaussettes blanches, s'il vous plaît.","ar":"جوارب بيضاء من فضلك."},{"who":"Vendeuse","fr":"Voici des modèles neufs. Vous voulez d'autres couleurs ?","ar":"تفضل موديلات جديدة. هل تريد ألواناً أخرى؟"},{"who":"Client","fr":"Non merci, j'ai assez de chaussettes !","ar":"لا شكراً، لدي جوارب كافية!"}]}],"exercises":[{"t":"mcq","skill":"grammar","q":"جمع «un cadeau» هو:","opts":["des cadeaus","des cadeaux","des cadeauxx","des cadeaules"],"a":1,"why":"-eau ← -aux بالجمع."},{"t":"mcq","skill":"grammar","q":"جمع «un œil»:","opts":["des œils","des yeus","des yeux","des oeuils"],"a":2,"why":"oeil استثناء مطلق: جمعه yeux لا œils."},{"t":"fill","skill":"grammar","q":"جمع: «un animal» ← «des ___»","fr":"des ___","ans":"animaux","why":"-al ← -aux."},{"t":"mcq","skill":"pronunciation","q":"كيف تُنطق «les livres»؟","opts":["ليز ليفرز","ليه ليفر","ليس ليفرس","ليفر"],"a":1,"why":"أداة الجمع [le] والـ s الصامتة."},{"t":"translate","skill":"writing","q":"ترجم: «عندي هدايا.»","ans":"J'ai des cadeaux.","alts":["j ai des cadeaux"],"why":"des أداة جمع تنكيري تقدّم الاسم بعد avoir."},{"t":"order","skill":"grammar","q":"رتّب: «تقرأ الصحف»","words":["Elle","lit","les","journaux"],"ans":"Elle lit les journaux","why":"ترتيب الجملة الفرنسية: الفاعل ثم الفعل ثم les ثم الاسم بالجمع."},{"t":"mcq","skill":"grammar","q":"جمع كلمة «un journal»؟","opts":["des journaux","des journals","les journalles","un journaux"],"a":0,"why":"المنتهي بـ al يصبح aux في الجمع."},{"t":"fill","skill":"grammar","q":"أكمل: «Les ___ sont sur la table. (livres)»","fr":"Les ___ sont sur la table.","ans":"livres","why":"livre سالم: أضف s فقط."}],"homework":"اكتب جمع 12 كلمة من دروسك السابقة، وحدد أيها يأخذ -s وأيها يأخذ -x.\nالدرس السابق/التالي: a1-t6-l1 (مذكر أم مؤنث؟) / a1-t8-l1 (كبير، صغير، جميل...).","sources":[{"title":"جمع الأسماء والصفات — قواعد الدلف A1: Le pluriel des noms et des adjectifs","channel":"فرنشاوي Frenchawy","videoId":"5EC1bzuGqfY","why":"شرح عربي لقواعد A1 الرسمية (جمع الاسم والصفة معًا) من أشهر قناة عربية متخصصة في التحضير لدلف.","cat":"Grammar","dur":13,"level":"A1","main":true},{"title":"le pluriel des noms","channel":"David Crolbois","videoId":"frd_WcGT5vA","why":"شرح مدرسي واضح للجمع العام — إيقاع بطيء يناسب من يبني قواعده أول مرة.","cat":"Grammar","level":"A1","extra":true},{"title":"French Plural of Nouns - How To Make A Noun Plural in French // French Grammar Course /…","channel":"The perfect French with Dylane","videoId":"TZOvVRVnt9I","why":"دايلان تشرح قواعد الجمع كلها بمنهجية Course منظمة — من أفضل قنوات القواعد الحديثة.","cat":"Grammar","level":"A1","extra":true},{"title":"le pluriel des noms en al et ail.","channel":"Français Avec Chaimae","videoId":"T6qvjgtVnSg","why":"درس متخصص في الجموع الشاذة -al/-ail التي يطلبها المحور حرفيًا.","cat":"Grammar","level":"A1","extra":true},{"title":"Pluriel des noms et des adjectifs — درس جامع مانع","channel":"Maîtriser le Français — أتقن الفرنسية","videoId":"_brC2ubTask","why":"تغطية شاملة لجميع حالات الجمع بما فيها الاستثناءات — مرجع بعد الشرح الأساسي.","cat":"Grammar","dur":14,"level":"A1","extra":true},{"title":"le pluriel في الفرنسية كما لم تدرسه من قبل — ملاحظات عن النطق","channel":"من فرنسا","videoId":"f3F6AfWwip8","why":"إضافة نظرة عن النطق الجمعي التي تغفلها أغلب الشروح — مكمّل مفيد.","cat":"Grammar","dur":11,"level":"A1","extra":true}],"supplements":[{"id":"frd_WcGT5vA","title":"le pluriel des noms","channel":"David Crolbois","why":"شرح مدرسي واضح للجمع العام — إيقاع بطيء يناسب من يبني قواعده أول مرة.","lang":"fr"},{"id":"TZOvVRVnt9I","title":"French Plural of Nouns - How To Make A Noun Plural in French // French Grammar Course /…","channel":"The perfect French with Dylane","why":"دايلان تشرح قواعد الجمع كلها بمنهجية Course منظمة — من أفضل قنوات القواعد الحديثة.","lang":"fr"},{"id":"T6qvjgtVnSg","title":"le pluriel des noms en al et ail.","channel":"Français Avec Chaimae","why":"درس متخصص في الجموع الشاذة -al/-ail التي يطلبها المحور حرفيًا.","lang":"fr"},{"id":"_brC2ubTask","title":"Pluriel des noms et des adjectifs — درس جامع مانع","channel":"Maîtriser le Français — أتقن الفرنسية","why":"تغطية شاملة لجميع حالات الجمع بما فيها الاستثناءات — مرجع بعد الشرح الأساسي.","dur":14,"lang":"ar"},{"id":"f3F6AfWwip8","title":"le pluriel في الفرنسية كما لم تدرسه من قبل — ملاحظات عن النطق","channel":"من فرنسا","why":"إضافة نظرة عن النطق الجمعي التي تغفلها أغلب الشروح — مكمّل مفيد.","dur":11,"lang":"ar"}]}]},{"id":"a1-t8","slug":"les-adjectifs","icon":"book","color":"#059669","fr":"Les adjectifs","ar":"الصفات","desc":"وصف الأشخاص والأشياء: مكان الصفة ومطابقتها.","lessons":[{"id":"A1-t8-l1","fr":"Grand, petit, beau, belle...","ar":"كبير، صغير، جميل...","objectives":["وضع الصفة بعد الاسم في الفرنسية","مطابقة الصفة في الجنس والعدد","تمييز صفات الألوان عن صفات الحجم","وصف الأشخاص والأماكن بجملتين صحيحتين"],"sections":[{"h":"مكان الصفة: بعد الاسم","p":["الصفة الفرنسية تأتي بعد الاسم في أغلب الحالات: une voiture rouge (سيارة حمراء) لا une rouge voiture. هذا الترتيب يعكس أولوية الفرنسيين: الاسم أولًا ثم وصفه.","المطابقة مزدوجة: الصفة تأخذ علامة جنس الاسم (e للمؤنث) وعلامة عدده (s للجمع). un homme grand → une femme grande → des hommes grands → des femmes grandes. أربع صيغ لكل صفة واحدة.","شاهد الفيديو الأساسي بالشرح العربي لتسمع الصفات في جمل وصف كاملة، ثم صف خمسة أشياء تراها أمامك الآن بجملة واحدة لكل شيء: Le mur est blanc. La chaise est confortable...","بعض الصفات تأتي قبل الاسم كاستثناء ثابت وقليل: un nouveau livre (كتاب جديد)، une vieille maison (بيت قديم)، un bon ami (صديق طيب)، de jolies fleurs. احفظها كقائمة قصيرة لا كقاعدة عامة.","ألوان قبل الصفات الأخرى وأحيانًا تتبع بـ très: très joli mais un peu petit (جميل جدًا لكن صغيرًا قليلاً). أدوات التدرّج (très، trop، assez، un peu) هي مفاتيح تنويع وصفك.","خطأ ترجمة شائع: وصف الشيء بصفة مناسبة بالعربية لا بالفرنسية — «حلو» تترجم favorable قطعًا، لكن «سيارة حلوة» بالفرنسية une jolie voiture لا une douce voiture. تعلّم الوصف كما تعلّم الكلمة."],"video":{"id":"6nqcB3o6iNY","title":"l'accord de l'adjectif qualificatif شرح بالدارجة!","channel":"قناة كوثر التعليمية","why":"شرح كوثر للمطابقة بالدارجة العربية — تبسيط محبب لموضوع يخطئ فيه الكثيرون.","lang":"ar","main":true},"sub":[{"h":"قواعد التموضع والمطابقة في جدول","p":["الصفة المفردة بعد الاسم: le chat noir (القط الأسود).","المؤنث: la chatte noire — e تضاف للصفة.","الجمع: les chats noirs — s للصفة.","الصفات الاستثنائية قبل الاسم: beau, bon, joli, nouveau, vieux, jeune, mauvais, grand (أحيانًا)."]},{"h":"صفات أساسية مرتبة حسب المعنى","p":["اللون: rouge، bleu، noir، blanc، vert، jaune.","الحجم: grand، petit، haut، bas.","العمر والحالة: jeune، vieux، nouveau، bon، mauvais، joli.","المشاعر: content، triste، fatigué، occupé — وهي كلها بعد être لا بعد الاسم مباشرة."]},{"h":"تمارين الوصف المتدرج","p":["صف غرفتك بثلاث صفات: Ma chambre est petite mais confortable.","صف صديقًا: Mon ami est grand et il porte un t-shirt bleu.","صحّح: «une voiture rouge belle» → «une belle voiture rouge» — لاحظ ترتيب beau ثم اللون."]}]},{"h":"المطابقة (l'accord)","p":["الصفة تتطابق مع الاسم في الجنس والعدد: un garçon intelligent → une fille intelligente → des garçons intelligents → des filles intelligentes.","استثناءات مهمة: beau → belle (جميل/جميلة)، nouveau → nouvelle (جديد/جديدة)، vieux → vieille (قديم/قديمة)، blanc → blanche.","صفات المشاعر تأتي بعد être وحده: Je suis content — لا تقل «Je suis un content». الفرق بين الصفة و «الشخص السعيد» يظهر في حذف الأداة."]},{"h":"الصفات المميزة: قبل الاسم","p":["عدد قليل من الصفات الشائعة يأتي قبل الاسم مثل العربية: beau (جميل)، joli (جميل)، grand، petit، bon (جيد)، mauvais (سيء)، jeune (شاب)، vieux، nouveau.","مثال: un beau jardin (حديقة جميلة)، une petite fille (بنت صغيرة)، un bon repas (وجبة جيدة).","الحوار الإثرائي يعرض الصفات في سياق شراء؛ انتبه لكل صفة سمعتها وحاول كتابتها من الذاكرة قبل أن تراها مكتوبة."]},{"h":"التطبيق والتلخيص","p":["يلخّص هذا الدرس موضع الصفة ومطابقتها: الصفة بعد الاسم في أغلب الحالات، وبعضها يسبق الاسم كاستثناء ثابت، والمطابقة مزدوجة (e للمؤنث و s للجمع). كما وضح الفيديو الرئيسي «l'accord de l'adjectif qualificatif شرح بالدارجة!»، تكون علامتا الجنس والعدد في الصفة نفسها، وتبدل بعض الصفات شكلها: beau ← belle، nouveau ← nouvelle، vieux ← vieille، مع أدوات التدرج très و trop و assez و un peu.","الصفة تُنفّى بـ ne...pas في a1-t9؛ فجمل الوصف التي بنيتها هنا تدخلها صيغة النفي في الدرس التالي a1-t9-l1 (Il n'est pas grand / Elle n'est pas belle)، وأما a1-t7-l1 فقد أعطاك علامة الجمع s التي ترى أثرها الآن في الصفة قبل أن تُضاف إليها علامة النفي.","أعد مشاهدة الفيديو الرئيسي ولاحظ ترتيب الصفة في كل مثال يذكره، ثم سجّل نفسك وأنت تصف ثلاثة أشياء: صفة قبل الاسم، وصفة بعد الاسم، وجملة تصف فيها نفسك بصفتين بعد être، وصحّح أي مخالفة في الترتيب أو المطابقة."]}],"examples":[{"fr":"Une voiture rouge","ar":"سيارة حمراء","note":"بعد الاسم"},{"fr":"Un beau jardin","ar":"حديقة جميلة","note":"قبل الاسم (استثناء)"},{"fr":"Des filles intelligentes","ar":"بنات ذكيات"},{"fr":"Mon frère est grand et sportif.","ar":"أخي طويل ورياضي."},{"fr":"Il porte un manteau noir.","ar":"يرتدي معطفاً أسود.","note":"الصفة بعد الاسم"},{"fr":"Nous avons une grande table ronde.","ar":"لدينا طاولة كبيرة مستديرة.","note":"صفتان: حجم ثم شكل"},{"fr":"Les fleurs sont très jolies.","ar":"الزهور جميلة جداً.","note":"مطابقة الجمع + très"},{"fr":"C'est un vieux château.","ar":"إنه قلعة قديمة.","note":"vieux قبل الاسم"}],"pron":[{"w":"beau / belle","ipa":"[bo / bɛl]","approx":"بو / بيل"},{"w":"intelligente","ipa":"[ɛ̃.tɛ.li.ʒɑ̃t]","approx":"آنتيليجانت"},{"w":"sportif / sportive","ipa":"[spɔʁ.tif / spɔʁ.tiv]","approx":"سبورطيف / سبورطيف"}],"vocab":[{"fr":"beau / belle","ar":"جميل / جميلة","pos":"adj","g":"mf","pl":"beaux / belles","ipa":"[bo / bɛl]","exFr":"Une belle journée !","exAr":"يوم جميل!"},{"fr":"bon / bonne","ar":"جيد / جيدة","pos":"adj","g":"mf","ipa":"[bɔ̃ / bɔn]","exFr":"C'est un bon restaurant.","exAr":"مطعم جيد."},{"fr":"grand(e) / petit(e)","ar":"كبير/طويل — صغير/قصير","pos":"adj","g":"mf","ipa":"[ɡʁɑ̃ / pə.ti]","exFr":"Elle est grande pour son âge.","exAr":"هي طويلة لعمرها."},{"fr":"nouveau / nouvelle","ar":"جديد / جديدة","pos":"adj","g":"mf","ipa":"[nu.vo / nu.vɛl]","exFr":"Une nouvelle voiture !","exAr":"سيارة جديدة!"},{"fr":"intelligent(e)","ar":"ذكي / ذكية","pos":"adj","g":"mf","ipa":"[ɛ̃.tɛ.li.ʒɑ̃]","exFr":"C'est une idée intelligente.","exAr":"فكرة ذكية."},{"fr":"joli(e)","ar":"جميل (بهيئة)","pos":"adj","g":"mf","ipa":"[ʒɔ.li]","exFr":"Une jolie fleur.","exAr":"زهرة جميلة."},{"fr":"rouge","ar":"أحمر","pos":"adj","exFr":"Une voiture rouge.","ipa":"[ʁuʒ]","exAr":"سيارة حمراء."},{"fr":"confortable","ar":"مريح","pos":"adj","exFr":"La chaise est confortable.","ipa":"[kɔ̃fɔʁtabl]","exAr":"الكرسي مريح."},{"fr":"très / trop / assez","ar":"جداً / أكثر من اللازم / بما يكفي","pos":"adv","exFr":"Il est très grand.","ipa":"[tʁɛ / tʁo / asɛ]","exAr":"إنه طويل جداً."},{"fr":"la couleur","ar":"اللون","pos":"nom","g":"f","pl":"les couleurs","ipa":"[kulœʁ]","exFr":"Quelle est la couleur ?","exAr":"ما اللون؟"},{"fr":"un peu","ar":"قليلًا","pos":"locution","exFr":"C'est un peu cher.","ipa":"[œ pø]","exAr":"إنه غالٍ قليلاً."},{"fr":"dangereux / dangereuse","ar":"خطير / خطيرة","pos":"adj","g":"mf","pl":"dangereux / dangereuses","ipa":"[dɑ̃.ʒə.ʁø / dɑ̃.ʒə.ʁøz]","exFr":"Un animal dangereux.","exAr":"حيوان خطير.","note":"نهاية -eux تتحول إلى -euse في المؤنث ثم تأخذ s في الجمع."},{"fr":"riche","ar":"غني / ثري","pos":"adj","g":"mf","ipa":"[ʁiʃ]","exFr":"Une femme riche.","exAr":"امرأة ثرية.","note":"تنتهي بـ e فلا تتغير بين المذكر والمؤنث."}],"grammar":[{"tFr":"Les adjectifs : place et accord","tAr":"القاعدة: تموضع الصفة ومطابقتها","body":["الصفة بعد الاسم غالبًا، وبعد être في جملة التصفية. الاستثناء: beau/bon/joli/nouveau/vieux تسبق الاسم.","المطابقة: e للمؤنث + s للجمع. بعض الصفات تبدل صورتها: nouveau→nouvelle، beau→belle."],"ex":[{"fr":"une voiture rouge","ar":"سيارة حمراء"},{"fr":"une belle voiture rouge","ar":"سيارة حمراء جميلة"}]}],"mistakes":[{"wrong":"une voiture rouge belle","right":"une belle voiture rouge","why":"beau قبل اللون والاسم معًا."},{"wrong":"un chat noirS","right":"un chat noir","why":"المفرد لا يأخذ s في الصفة."},{"wrong":"Je suis un fatigué","right":"Je suis fatigué","why":"الصفة بعد être بلا أداة."},{"wrong":"une nouveau maison","right":"une nouvelle maison","why":"nouveau مع المؤنث تصبح nouvelle."}],"dialogues":[{"title":"شراء هاتف جديد","ctx":"في محل إلكترونيات","lines":[{"who":"Vendeur","fr":"Vous cherchez un téléphone ?","ar":"هل تبحث عن هاتف؟"},{"who":"Cliente","fr":"Oui, un peu petit, et pas trop cher.","ar":"نعم، صغير قليلاً، وليست غالياً جداً."},{"who":"Vendeur","fr":"Celui-ci est nouveau et il est très léger.","ar":"هذا جديد وخفيف جداً."},{"who":"Cliente","fr":"Il est joli ! Quelle est la couleur ?","ar":"إنه جميل! ما لونه؟"},{"who":"Vendeur","fr":"Il existe en noir, en blanc et en bleu.","ar":"متوفر بالأسود والأبيض والأزرق."}]}],"exercises":[{"t":"mcq","skill":"grammar","q":"أي تركيب صحيح؟","opts":["une rouge voiture","une voiture rouge","rouge une voiture","voiture une rouge"],"a":1,"why":"الصفات العادية بعد الاسم."},{"t":"fill","skill":"grammar","q":"أكمل بالمطابقة: «Une ville ___» (جميلة)","fr":"Une ville ___.","ans":"belle","alts":["belle"],"why":"beau قبل الاسم للمذكر؛ للمؤنث belle ويمكن قبل الاسم أيضاً: une belle ville."},{"t":"mcq","skill":"grammar","q":"«un bon repas» — لماذا bon قبل الاسم؟","opts":["خطأ","bon من الصفات القليلة السابقة","لأن repas مؤنث","للتأكيد"],"a":1,"why":"bon, beau, grand, petit, jeune, vieux, nouveau, joli تأتي قبل الاسم."},{"t":"translate","skill":"writing","q":"ترجم: «بيت كبير».","ans":"Une grande maison","alts":["une grande maison"],"why":"grand صفة سابقة، وhouse مؤنثة فتصبح grande."},{"t":"listen","skill":"listening","q":"استمع واختر المطابقة الصحيحة للصفة:","audio":"Les chaussures sont très jolies","opts":["الحذاء (جمع) جميل جداً — مطابقة بالـ s","الحذاء مفرد جميل","الحذاء (مفرد مؤنث) ليس جميلاً","الحذاء (مذكر) جميل جداً"],"a":0,"why":"chaussures جمع مؤنث: الصفة joli تأخذ e للمؤنث و s للجمع فتصبح jolies مع très."},{"t":"speaking","skill":"pronunciation","q":"انطق: «صديقتي ذكية وجميلة».","target":"Mon amie est intelligente et belle","why":"صفتان بعد être: صفة الحالة ثم صفة الجمال، والمؤنث يأخذ e في intelligente."},{"t":"mcq","skill":"grammar","q":"أي جملة صحيحة؟","opts":["une maison blanche","une blanche maison","une maison blancs","blanc une maison"],"a":0,"why":"الصفة بعد الاسم و belle/masculine."},{"t":"order","skill":"grammar","q":"رتّب: «سيارة حمراء صغيرة»","words":["une","petite","voiture","rouge"],"ans":"une petite voiture rouge","why":"petite صفة قبل الاسم، و rouge لون يأتي بعده دائمًا."}],"homework":"اوصف 5 أشياء تحبها بجملة لكل شيء، بصفة بعد الاسم وصفة قبل الاسم.\nالدرس السابق/التالي: a1-t7-l1 (جمع الأسماء والصفات) / a1-t9-l1 (النفي بأشكاله).","sources":[{"title":"l'accord de l'adjectif qualificatif شرح بالدارجة!","channel":"قناة كوثر التعليمية","videoId":"6nqcB3o6iNY","why":"شرح كوثر للمطابقة بالدارجة العربية — تبسيط محبب لموضوع يخطئ فيه الكثيرون.","cat":"Grammar","level":"A1","main":true},{"title":"Comment placer les adjectifs en français + exercice - How to use adjectives in French","channel":"Parlez-vous FRENCH : Cours de français","videoId":"2vCABG_X6ug","why":"درس Parlez-vous French لمكان الصفة مع تمرين تطبيقي مباشر في نهايته.","cat":"Grammar","level":"A1","extra":true},{"title":"GRAMMAIRE - Les adjectifs irréguliers beau nouveau vieux et fou Cours","channel":"Apprendre le français avec Bruno Milet","videoId":"ERe7AlldMqo","why":"درس مخصص للصفات الاستثنائية beau/nouveau/vieux/fou — العقدة الحقيقية في A1.","cat":"Grammar","level":"A1","extra":true},{"title":"مفردات هامة: الصفات ومؤنثها بالفرنسية بطريقة مبسطة","channel":"من فرنسا","videoId":"z2StVaeINyc","why":"تحويل الصفات إلى المؤنث بأمثلة — يربط الدرس بالتطبيق المباشر.","cat":"Grammar","dur":7,"level":"A1","extra":true},{"title":"Grammaire — Les adjectifs qualificatifs: الصفات في حالة المؤنث","channel":"Sylingo — سيلينغو","videoId":"xJgqNRFEXPw","why":"عرض أكاديمي لقواعد مطابقة الصفات للمؤنث مع جدول منظم — تثبيت القاعدة.","cat":"Grammar","dur":15,"level":"A1","extra":true}],"supplements":[{"id":"2vCABG_X6ug","title":"Comment placer les adjectifs en français + exercice - How to use adjectives in French","channel":"Parlez-vous FRENCH : Cours de français","why":"درس Parlez-vous French لمكان الصفة مع تمرين تطبيقي مباشر في نهايته.","lang":"fr"},{"id":"ERe7AlldMqo","title":"GRAMMAIRE - Les adjectifs irréguliers beau nouveau vieux et fou Cours","channel":"Apprendre le français avec Bruno Milet","why":"درس مخصص للصفات الاستثنائية beau/nouveau/vieux/fou — العقدة الحقيقية في A1.","lang":"fr"},{"id":"z2StVaeINyc","title":"مفردات هامة: الصفات ومؤنثها بالفرنسية بطريقة مبسطة","channel":"من فرنسا","why":"تحويل الصفات إلى المؤنث بأمثلة — يربط الدرس بالتطبيق المباشر.","dur":7,"lang":"ar"},{"id":"xJgqNRFEXPw","title":"Grammaire — Les adjectifs qualificatifs: الصفات في حالة المؤنث","channel":"Sylingo — سيلينغو","why":"عرض أكاديمي لقواعد مطابقة الصفات للمؤنث مع جدول منظم — تثبيت القاعدة.","dur":15,"lang":"ar"}]}]},{"id":"a1-t9","slug":"la-negation","icon":"headphones","color":"#059669","fr":"La négation","ar":"النفي","desc":"ne... pas وأدوات النفي الأخرى: لا شيء، لا أحد، أبداً.","lessons":[{"id":"A1-t9-l1","fr":"Ne... pas et plus","ar":"النفي بأشكاله","objectives":["تكوين النفي بـ ne...pas حول الفعل","نحت ne إلى n' قبل حرف العلة","النفي مع les / du / des (de بدل الأداة)","تفكيك جملة مثبتة إلى منفية دون خطأ"],"sections":[{"h":"البنية الأساسية ne... pas","p":["النفي في الفرنسية مكوّن من قطعتين تحاطان بالفعل: ne قبله و pas بعده. Je parle → je ne parle pas. هذه الالتفافات هي القاعدة الأولى لكل نفي، ولا تحتاج أكثر منها في المستوى A1.","قبل حرف علة (a, e, i, o, u و h) ينحت ne إلى n': il a → il n'a pas، elle est → elle n'est pas. الحذف ليس اختياريًا بل هو النطق الصحيح — فرنسية تقولها هكذا في كل جملة.","شاهد الفيديو الأساسي بالشرح العربي لتسمع النفي في سياقات متعددة، ثم تدرّب على قلب ثلاث جمل مثبتة: Je suis là → Je ne suis pas là. Tu as un livre → Tu n'as pas de livre. Nous allons bien → Nous n'allons pas bien.","أداة النفي تغيّر مع الملكية: بعد pas يأتي de بدل un/une/du/des. Je n'ai pas un ami → Je n'ai pas d'ami. Je n'aime pas le café بدل Je n'aime pas de café (هنا يبقى لأنها ليست ملكية).","النفي مع les: Nous n'allons pas au cinéma بدل Nous n'allons pas au cinéma في الجمل العادية. استثناء واحد يكفي: نفي «عدم الوجود» يحتفظ بالـ de، أما نفي «المشاعر والعلاقات» فيبقى بالحرف المعرّف.","لكل نفي بديل يغيّر المعنى: ne...plus (لم يعد)، ne...jamais (أبدًا)، ne...rien (لا شيء)، ne...personne (لا أحد). احفظها في نهاية الدرس لأنها امتداد لـ pas لا بديل تام عنه في الكتابة المنظمة."],"video":{"id":"muL5akVOvTA","title":"تعلم قواعد اللغة الفرنسية بطريقة مبسطة : النفي La négation","channel":"تعلم اللغة الفرنسية la langue française","why":"شرح عربي لأدوات النفي المختلفة — يوسع ما بدأه الدرس بنفس الترتيب.","lang":"ar","main":true},"sub":[{"h":"خطوات تكوين النفي","p":["خطوة 1: اكتب الجملة المثبتة كاملة: Il prend le train.","خطوة 2: أضف ne قبل الفعل و pas بعده: Il ne prend pas le train.","خطوة 3: إن بدا الفعل بحرف علة، حوّل ne إلى n': Il n'a pas le train.","خطوة 4: إن كانت الجملة ملكية، بدّل الأداة بعد pas بـ de."]},{"h":"النفي في الأسئلة والأوامر","p":["السؤال المنفي: Tu ne viens pas ? (ألا تأتي؟) — بترتيب عكسي تمامًا عن الإنجليزية.","الأمر المنفي: Ne fumez pas ! (لا تدخن!) — الاستثناء الوحيد الذي يأتي ne وحدها قبل الفعل.","الحوار اليومي غالبًا يحذف ne نباتيًا (je sais pas)، لكن الكتابة المنظمة تحافظ عليها — اكتب ما تقرأه في الكتب لا ما تسمعه في الشارع."]},{"h":"خريطة بدائل ne...pas","p":["ne...plus — لم يعد: Je ne bois plus de thé.","ne...jamais — أبدًا: Il ne vient jamais.","ne...rien — لا شيء: Je ne mange rien.","ne...personne — لا أحد: Je ne vois personne."]}]},{"h":"أدوات نفي إضافية","p":["ne... jamais (أبداً): Je ne fume jamais (لا أدخن أبداً). ne... rien (لا شيء): Je ne vois rien (لا أرى شيئاً). ne... plus (لم يعد): Je ne travaille plus ici (لم أعد أعمل هنا).","ne... personne (لا أحد): Je ne connais personne ici (لا أعرف أحداً هنا).","الأسئلة المنفية هي أكثر صيغة تربك المبتدئ: Tu ne comprends pas ? احفظ عكسها الموجب Tu comprends ? للتأكد من الفهم قبل بناء النفي."]},{"h":"قاعدة de الذهبية","p":["بعد نفي الفعل، تتحول un/une/des إلى de/d': J'ai une voiture → Je n'ai pas de voiture. Il y a des fleurs → Il n'y a pas de fleurs.","لكن مع être يبقى un: Ce n'est pas un problème (ليست مشكلة). وللأفعال مثل aimer تبقى الأداة: Je n'aime pas le café.","استمع للجولة الإثرائية وأنت تحدّد: هل هذه ne...pas أم ne...plus أم ne...rien؟ تصنيف الأنواع بالسمع يثبت المفردات الجديدة مع المعنى."]},{"h":"التطبيق والتلخيص","p":["يلخّص هذا الدرس بنية النفي: ne...pas تحاط بالفعل، وتصبح n' قبل حرف العلة، وتتحول الأداة إلى de بعد pas في نفي الملكية، مع بدائل plus و jamais و rien و personne. كما وضح الفيديو الرئيسي «تعلم قواعد اللغة الفرنسية بطريقة مبسطة : النفي La négation»، النفي قيدان على الفعل لا تغيير في ترتيب الجملة، وإن كان حذف ne شائعًا في الكلام اليومي فالأسلوب المنظم يثبّته.","للسؤال عن النفي: a1-t10 هو الدرس الذي يليه، فتأتي أدوات الاستفهام لتصيغ السؤال المنفي (Tu ne viens pas ? / Est-ce que tu ne comprends pas ?)، وأما a1-t8-l1 فقد وضع الصفات التي ستنفيها الآن، والنفي يقع على الفعل لا على الصفة مباشرة.","أعد مشاهدة الفيديو الرئيسي وأنت تحدّد نوع النفي في كل جملة (pas، plus، jamais، rien، personne)، ثم سجّل نفسك وأنت تحوّل ثلاث جمل مثبتة من دروسك إلى النفي، وصحّح فيها n' وأداة de قبل أن تنتقل إلى a1-t10."]}],"examples":[{"fr":"Je ne parle pas espagnol.","ar":"لا أتكلم الإسبانية."},{"fr":"Elle n'est pas là aujourd'hui.","ar":"هي غير موجودة اليوم."},{"fr":"Je ne mange jamais de viande.","ar":"لا آكل اللحم أبداً."},{"fr":"Il n'y a rien dans le frigo.","ar":"لا يوجد شيء في الثلاجة."},{"fr":"Je ne comprends pas la question.","ar":"لا أفهم السؤال.","note":"النفي الأساسي"},{"fr":"Elle n'habite plus à Paris.","ar":"لم تعد تسكن في باريس.","note":"ne...plus + حذف الهمزة"},{"fr":"Nous n'avons jamais vu ça.","ar":"لم نرَ ذلك قط.","note":"ne...jamais"},{"fr":"Il n'y a personne ici.","ar":"لا يوجد أحد هنا.","note":"ne...personne"}],"pron":[{"w":"ne... pas","ipa":"[nə.pa]","approx":"نو... با"},{"w":"jamais","ipa":"[ʒa.mɛ]","approx":"جاميه"},{"w":"rien","ipa":"[ʁjɛ̃]","approx":"ريان (أنفي)"}],"vocab":[{"fr":"ne... pas","ar":"لا / ليس","pos":"négation","ipa":"[nə pa]","exFr":"Je ne sais pas.","exAr":"لا أعرف."},{"fr":"ne... jamais","ar":"أبداً (نفي)","pos":"négation","ipa":"[nə ʒa.mɛ]","exFr":"Il ne dort jamais tard.","exAr":"لا ينام متأخراً أبداً."},{"fr":"ne... rien","ar":"لا شيء","pos":"négation","ipa":"[nə ʁjɛ̃]","exFr":"Je ne fais rien.","exAr":"لا أفعل شيئاً."},{"fr":"ne... plus","ar":"لم يعد / لم تعد","pos":"négation","ipa":"[nə ply]","exFr":"Je ne fume plus.","exAr":"لم أعد أدخن."},{"fr":"ne... personne","ar":"لا أحد","pos":"négation","ipa":"[nə pɛʁ.sɔn]","exFr":"Personne n'est venu.","exAr":"لم يأتِ أحد."},{"fr":"je ne sais pas","ar":"لا أعرف","pos":"expression","ipa":"[ʒə nə sɛ pa]","exFr":"— Où est la gare ? — Je ne sais pas.","exAr":"— أين المحطة؟ — لا أعرف."},{"fr":"ne...pas","ar":"النفي الأساسي (لا/ليس)","pos":"locution","exFr":"Je ne parle pas.","ipa":"[nə...pa]","exAr":"لا أتكلم."},{"fr":"ne...plus","ar":"لم يعد","pos":"locution","exFr":"Je ne veux plus.","ipa":"[nə...ply]","exAr":"لم أعد أريد."},{"fr":"ne...jamais","ar":"أبدًا/قط","pos":"locution","exFr":"Il ne vient jamais.","ipa":"[nə...ʒamɛ]","exAr":"هو لا يأتي أبداً."},{"fr":"ne...rien","ar":"لا شيء","pos":"locution","exFr":"Je ne vois rien.","ipa":"[nə...ʁjɛ̃]","exAr":"لا أرى شيئاً."},{"fr":"ne...personne","ar":"لا أحد","pos":"locution","exFr":"Il n'y a personne.","ipa":"[nə...pɛʁsɔn]","exAr":"لا يوجد أحد."},{"fr":"fumer","ar":"يدخن","pos":"verbe","g":"—","exFr":"Ne fumez pas !","ipa":"[fyme]","exAr":"لا تدخن!"},{"fr":"non plus","ar":"أيضًا (في النفي)","pos":"locution","exFr":"Moi non plus.","ipa":"[nɔ pli]","exAr":"وأنا أيضًا لا."}],"grammar":[{"tFr":"La négation","tAr":"القاعدة: صيغ النفي","body":["ne...pas تحيط بالفعل، وتصبح n'... devant حرف علة. في نفي الملكية تأتي de بعد pas.","بدائل نُنظر إليها كتوسعات: plus (الاستمرار)، jamais (التكرار)، rien (الشيء)، personne (الشخص)."],"ex":[{"fr":"Je n'ai pas le temps.","ar":"ليس لدي وقت."},{"fr":"Je ne veux rien.","ar":"لا أريد شيئاً."}]}],"mistakes":[{"wrong":"Je pas comprends","right":"Je ne comprends pas","why":"ne تسبق الفعل و pas تليه، وليس العكس."},{"wrong":"Il ne a pas","right":"Il n'a pas","why":"ne تتحول إلى n' قبل حرف علة."},{"wrong":"Je n'ai pas une voiture","right":"Je n'ai pas de voiture","why":"بعد نفي الملكية تأتي de بدل un/une."},{"wrong":"Ne viens pas ! (بدون ne في الأمر)","right":"Ne fumez pas !","why":"الأمر المنفي يحتفظ بـ ne ولا يستغني عنها."}],"dialogues":[{"title":"طلب في المطعم: لا سكر ولا ملح","ctx":"زبون ينفي إضافات","lines":[{"who":"Serveur","fr":"Vous voulez du sucre dans le café ?","ar":"هل تريد سكراً في القهوة؟"},{"who":"Client","fr":"Non merci, je ne prends pas de sucre.","ar":"لا شكراً، لا آخذ سكراً."},{"who":"Serveur","fr":"Et le sel, il n'y a pas assez ?","ar":"والملح، ألا يوجد بما يكفي؟"},{"who":"Client","fr":"Non, je ne mange jamais trop salé.","ar":"لا، أنا لا آكل مالحاً أبداً."},{"who":"Serveur","fr":"Très bien, je vous apporte ça.","ar":"حسناً، أحضر لك ذلك."}]}],"exercises":[{"t":"mcq","skill":"grammar","q":"نفي «J'aime le thé»:","opts":["Je n'aime le thé pas","Je n'aime pas le thé","Je ne aime pas le thé","J'ai pas le thé"],"a":1,"why":"n' + aime + pas ثم الباقي."},{"t":"fill","skill":"grammar","q":"أكمل: «Je n'ai pas ___ voiture.»","fr":"Je n'ai pas ___ voiture.","ans":"de","why":"un ← de بعد النفي."},{"t":"mcq","skill":"grammar","q":"«لا أرى شيئاً» بالفرنسية:","opts":["Je ne vois jamais","Je ne vois rien","Je vois pas rien","Je ne vois personne"],"a":1,"why":"rien = لا شيء: Je ne vois rien."},{"t":"translate","skill":"writing","q":"ترجم: «لا يعمل هنا.»","ans":"Il ne travaille pas ici.","alts":["il ne travaille pas ici"],"why":"ne...pas تحاط بالفعل والجملة تبقى على ترتيبها المثبت."},{"t":"listen","skill":"listening","q":"استمع واختر المعنى:","audio":"Je ne fume jamais","opts":["أدخن دائماً","لا أدخن أبداً","لم أعد أدخن","أدخن أحياناً"],"a":1,"why":"jamais تعني الأبدية في النفي: لا أدخن أبدًا."},{"t":"order","skill":"grammar","q":"رتّب: «ليس عندي مال»","words":["Je","n'ai","pas","d'argent"],"ans":"Je n'ai pas d'argent","why":"بعد نفي الملكية تأتي d' بدل un/une قبل اسم المفعول."},{"t":"mcq","skill":"grammar","q":"النفي الصحيح مع «manger»؟","opts":["Je ne mange pas","Je n'mange pas","Je ne mange plus pas","Je pas ne mange"],"a":0,"why":"ne قبل الفعل و pas بعده."},{"t":"fill","skill":"grammar","q":"أكمل النفي: «Nous n'avons ___ de voiture.»","fr":"Nous n'avons ___ de voiture.","ans":"pas","why":"ne...pas + de للملكية المنفية."}],"homework":"حوّل 8 جمل من دروسك السابقة إلى النفي، واكتب جملتين بأدوات jamais و rien.\nالدرس السابق/التالي: a1-t8-l1 (كبير، صغير، جميل...) / a1-t10-l1 (من؟ ماذا؟ أين؟ متى؟).","sources":[{"title":"تعلم قواعد اللغة الفرنسية بطريقة مبسطة : النفي La négation","channel":"تعلم اللغة الفرنسية la langue française","videoId":"muL5akVOvTA","why":"شرح عربي لأدوات النفي المختلفة — يوسع ما بدأه الدرس بنفس الترتيب.","cat":"Grammar","level":"A1","main":true},{"title":"Simple Negations - part 1 (French Essentials Lesson 13)","channel":"Learn French With Alexa","videoId":"Rymbg3PnyL0","why":"الجزء الأول من سلسلة Alexa للنفي — بنية ne...pas بأمثلة متدرجة.","cat":"Grammar","level":"A1","extra":true},{"title":"Simple Negations - part 2 (French Essentials Lesson 14)","channel":"Learn French With Alexa","videoId":"KJBQ_xDAvq0","why":"الجزء الثاني من Alexa يغطي قاعدة de بعد النفي — نقطة المحور الثالث بالضبط.","cat":"Grammar","level":"A1","extra":true},{"title":"تعلم قواعد اللغة الفرنسية بطريقة مبسطة: النفي la négation","channel":"français avec saida","videoId":"oRdFM91N4h8","why":"شرح النفي كاملًا (pas، plus، jamais، rien) بالعربية بترتيب منظم — مرجع أساسي ممتاز.","cat":"Grammar","dur":15,"level":"A1","extra":true},{"title":"تعليم الفرنسية للمبتدئين #39: صيغة النفي البسيط La négation","channel":"فرنشاوي Frenchawy","videoId":"26kHW67O68U","why":"تركيز على ne...pas الأساسية فقط كما يحتاج مستوى A1 — مراجعة سريعة.","cat":"Grammar","dur":6,"level":"A1","extra":true}],"supplements":[{"id":"Rymbg3PnyL0","title":"Simple Negations - part 1 (French Essentials Lesson 13)","channel":"Learn French With Alexa","why":"الجزء الأول من سلسلة Alexa للنفي — بنية ne...pas بأمثلة متدرجة.","lang":"fr"},{"id":"KJBQ_xDAvq0","title":"Simple Negations - part 2 (French Essentials Lesson 14)","channel":"Learn French With Alexa","why":"الجزء الثاني من Alexa يغطي قاعدة de بعد النفي — نقطة المحور الثالث بالضبط.","lang":"fr"},{"id":"oRdFM91N4h8","title":"تعلم قواعد اللغة الفرنسية بطريقة مبسطة: النفي la négation","channel":"français avec saida","why":"شرح النفي كاملًا (pas، plus، jamais، rien) بالعربية بترتيب منظم — مرجع أساسي ممتاز.","dur":15,"lang":"ar"},{"id":"26kHW67O68U","title":"تعليم الفرنسية للمبتدئين #39: صيغة النفي البسيط La négation","channel":"فرنشاوي Frenchawy","why":"تركيز على ne...pas الأساسية فقط كما يحتاج مستوى A1 — مراجعة سريعة.","dur":6,"lang":"ar"}]}]},{"id":"a1-t10","slug":"poser-des-questions","icon":"pen","color":"#059669","fr":"Poser des questions","ar":"السؤال","desc":"Est-ce que، الانقلاب، وأدوات الاستفهام quand, où, pourquoi...","lessons":[{"id":"A1-t10-l1","fr":"Qui ? Quoi ? Où ? Quand ?","ar":"من؟ ماذا؟ أين؟ متى؟","objectives":["بناء السؤال بثلاث طرق: نبرة، est-ce que، تقلاب الفعل","استعمال أدوات الاستفهام: qui, que, où, quand, comment, pourquoi, quel","التفريق بين est-ce que و inversion","إجراء حوار سؤال-جواب قصير"],"sections":[{"h":"ثلاث طرق للسؤال","p":["للسؤال في الفرنسية ثلاث طرق متدرجة: الطريقة الأولى النبرة فقط (Tu viens ?) — الأسهل والأكثر كلامًا يوميًا. الطريقة الثانية est-ce que في البداية (Est-ce que tu viens ?) — الأكثر وضوحًا وأمانًا للمبتدئ. الطريقة الثالثة تقلاب الفعل والضمير (Viens-tu ?) — الأدبي والأقل استخدامًا في الحوار.","أدوات الاستفهام السبعة الأساسية: qui (من)، que/quoi (ماذا)، où (أين)، quand (متى)، comment (كيف)، pourquoi (لماذا)، quel (أي). احفظها كقائمة واحدة وستتمكن من فتح أي سؤال جديد.","شاهد الفيديو الأساسي بالشرح العربي لتسمع كل أداة في سياقها، ثم اكتب ثلاثة أسئلة بكل أداة من هذه السبعة. الكتابة الإنتاجية تكشف أي أداة لم تُتقن بعد — وهي عادةً pourquoi أو quel.","مع est-ce que تبقى الجملة مثبتة الترتيب: Est-ce que tu as un frère ? — لا تنقلب الفعل. هذا يجعلها الخيار الآمن للمبتدئ: أخطاؤها أقل لأنك تضيف جزءًا فقط.","الاختلافات الصغيرة: que تعني «ماذا» في السؤال (Qu'est-ce que tu fais ?)، أما quoi فتأتي في نهاية الجملة (Tu fais quoi ?). ماذا فعلت تُقال بالطريقتين لكن النبرة تختلف.","الحوار العملي: تعلّم نمط «سؤال ← جواب قصير ← سؤال مقابل». المحادثة الفرنسية لا تُدار بسؤال واحد وصمت — إعادة السؤال للطرف الآخر هي قاعدة اللباقة العملية."],"video":{"id":"l5pPevHlv_s","title":"تعلم الاستفهام بالفرنسية l’interrogation","channel":"فرنساوى العرب le français","why":"شرح عربي لأدوات الاستفهام مع أمثلة مترجمة — مرجع سريع للحفظ.","lang":"ar","main":true},"sub":[{"h":"أدوات الاستفهام في جدول واحد","p":["qui — من: Qui est-ce ? (من هو؟)","que / quoi — ماذا: Qu'est-ce que tu fais ? / Tu fais quoi ?","où — أين: Où habites-tu ?","quand — متى: Quand arrives-tu ?","comment — كيف: Comment ça va ?","pourquoi — لماذا: Pourquoi tu es tard ?","quel — أي: Quel âge as-tu ? / Quelle est ton adresse ?"]},{"h":"طرق الثلاثة مع نفس السؤال","p":["Tu travailles ici ? — نبرة فقط (يومي).","Est-ce que tu travailles ici ? — est-ce que (آمن وواضح).","Tu travailles-tu ici ? — inversion (أدبي).","الحيلة: تدرّب على الثانية في الكتابة، وردّد الأولى في الكلام."]},{"h":"أخطاء بناء السؤال الشائعة","p":["Est-ce que tu es étudiant ? (صحيح) vs Tu es est étudiant ? (خاطئ) — لا تضف est مرتين.","Où tu habites ? → Où habites-tu ? أو Est-ce que tu habites où ? — في النبرة وحدها يجوز الكلام اليومي.","Quel âge ? بلا verb — يُفهم من السياق لكن الكتابة تفضل: Quel âge as-tu ?"]}]},{"h":"أدوات الاستفهام","p":["qui (من؟)، que/quoi (ماذا؟)، où (أين؟)، quand (متى؟)، pourquoi (لماذا؟)، comment (كيف؟)، combien (كم؟)، quel(le)(s) (أيّ؟).","أمثلة: Qui est-ce ? (من هذا؟) — Où habites-tu ? (أين تسكن؟) — Pourquoi tu apprends le français ? (لماذا تتعلم الفرنسية؟) — Combien ça coûte ? (كم يكلف؟).","الرد على pourquoi عادة بـ parce que (لأن): Parce que j'aime la langue (لأنني أحب اللغة).","أدوات الاستفهام هي نفسها كلمات الربط في الجمل المركبة لاحقًا: où habites-tu ? تصبح بعد ذلك où tu habites كثيرًا في الكلام — احفظ الأصل المكتوب أولًا."]},{"h":"أسئلة يومية يجب إتقانها","p":["Quel est ton nom ? (ما اسمك؟) — Quelle heure est-il ? (كم الساعة؟) — C'est combien ? (بكم؟) — Tu es d'où ? (من أين أنت؟) — Ça va ? (كيف الحال؟).","لاحظ أسلوب الحديث اليومي المختصر: Tu es d'où ? بدل D'où venez-vous ? — كلاهما صحيح.","السؤال المطابق: بعد أن تسمع سؤال الفيديو، أجب بجملة كاملة ثم اسأل الطرف الآخر بنفس الأداة. هذه الحلقة المزدوجة تبني الحوار لا مجرد الإجابة."]},{"h":"التطبيق والتلخيص","p":["يلخّص هذا الدرس طرق تكوين السؤال الثلاث (النبرة، est-ce que، التقلاب) وأدوات الاستفهام: qui، que/quoi، où، quand، comment، pourquoi، quel، مع combien. كما وضح الفيديو الرئيسي «تعلم الاستفهام بالفرنسية l’interrogation»، أسلوب est-ce que هو الأسلم للكتابة المنظمة لأنه يضيف جزءًا فقط دون نقلاب، بينما يظل التقلاب الأدبي والأقل استعمالًا في الحوار اليومي.","الأسئلة تتصل بتصريف الأفعال في a1-t11؛ فبعد إتقان أدوات الاستفهام تحتاج إلى أفعال المجموعة الأولى في المضارع لتصيغ سؤالًا سليمًا (Est-ce que tu parles ? / Parles-tu ?)، وأما a1-t9-l1 فقد أعطاك النفي الذي يُسأل عنه بالمثل (Tu ne viens pas ?) فيبقى السؤال والنفي خطوتين متتاليتين في الحوار.","أعد مشاهدة الفيديو الرئيسي ودوّن كل أداة استفهام مع مثالها، ثم سجّل نفسك وأنت تطرح خمسة أسئلة بأدوات مختلفة على زميل وهمية، وأنجِز كل سؤال بالطريقتين: est-ce que ثم التقلاب، وقارن نطقك بمثال الفيديو."]}],"examples":[{"fr":"Est-ce que tu aimes le café ?","ar":"هل تحب القهوة؟"},{"fr":"Où est la gare ?","ar":"أين المحطة؟"},{"fr":"Pourquoi apprends-tu le français ?","ar":"لماذا تتعلم الفرنسية؟"},{"fr":"Quelle heure est-il ? — Il est 8 heures.","ar":"كم الساعة؟ — الساعة 8."},{"fr":"Qu'est-ce que tu manges ?","ar":"ماذا تأكل؟","note":"que مع est-ce que"},{"fr":"Où est-ce que tu travailles ?","ar":"أين تعمل؟","note":"où + est-ce que"},{"fr":"Qui est ton professeur ?","ar":"من أستاذك؟","note":"qui مباشرة"},{"fr":"Pourquoi tu ne viens pas ?","ar":"لماذا لا تأتي؟","note":"سؤال منفي مقبول يومياً"}],"pron":[{"w":"Est-ce que","ipa":"[ɛs.kə]","approx":"إس-كو"},{"w":"pourquoi","ipa":"[puʁ.kwa]","approx":"بور-كوا"},{"w":"quand","ipa":"[kɑ̃]","approx":"كان (أنفي)"}],"vocab":[{"fr":"qui","ar":"من","pos":"interrogatif","ipa":"[ki]","exFr":"Qui est là ?","exAr":"من هناك؟"},{"fr":"où","ar":"أين","pos":"interrogatif","ipa":"[u]","exFr":"Où travailles-tu ?","exAr":"أين تعمل؟"},{"fr":"quand","ar":"متى","pos":"interrogatif","ipa":"[kɑ̃]","exFr":"Quand est-ce qu'on part ?","exAr":"متى نغادر؟"},{"fr":"pourquoi","ar":"لماذا","pos":"interrogatif","ipa":"[puʁ.kwa]","exFr":"Pourquoi pas ?","exAr":"لماذا لا؟"},{"fr":"combien","ar":"كم","pos":"interrogatif","ipa":"[kɔ̃.bjɛ̃]","exFr":"Combien de temps ?","exAr":"كم من الوقت؟"},{"fr":"parce que","ar":"لأن","pos":"conjonction","ipa":"[paʁ.s(ə).kə]","exFr":"Je reste, parce qu'il pleut.","exAr":"أبقى لأنها تمطر."},{"fr":"comment","ar":"كيف","pos":"adv","exFr":"Comment t'appelles-tu ?","ipa":"[kɔmɑ̃]","exAr":"ما اسمك؟"},{"fr":"quel / quelle","ar":"أي/أيّة","pos":"adj","exFr":"Quel chemin ?","ipa":"[kɛl]","exAr":"أي طريق؟"},{"fr":"est-ce que","ar":"أداة تكوين السؤال","pos":"locution","exFr":"Est-ce que c'est vrai ?","ipa":"[ɛs kə]","exAr":"هل هذا صحيح؟"},{"fr":"demander","ar":"يسأل / يطلب","pos":"verbe","g":"1","exFr":"J'ai demandé mon chemin.","ipa":"/dəmɑ̃de/","exAr":"سألت عن طريقي."}],"grammar":[{"tFr":"Poser des questions","tAr":"القاعدة: طرق تكوين السؤال","body":["ثلاث طرق: النبرة، est-ce que في البداية (يبقى الترتيب المثبت)، أو تقلاب الفعل مع الضمير (أدوات المكان -t-).","أدوات الاستفهام تُحفظ مع معناها: qui/que/où/quand/comment/pourquoi/quel/combien."],"ex":[{"fr":"Est-ce que tu parles français ?","ar":"هل تتكلم الفرنسية؟"},{"fr":"Parles-tu français ?","ar":"هل تتكلم الفرنسية؟"}]}],"mistakes":[{"wrong":"Tu es où ?","right":"Où es-tu ? / Où tu es ? (نبرة) / Est-ce que tu es où ?","why":"في الكتابة المنظمة تأتي الأداة قبل الفعل أو مع est-ce que."},{"wrong":"Quoi tu fais ?","right":"Qu'est-ce que tu fais ?","why":"quoi تأتي في نهاية السؤال اليومي لا في بدايته."},{"wrong":"Est-ce que tu est prêt","right":"Est-ce que tu es prêt","why":"الفعل es يأتي مع tu وليس est."},{"wrong":"Combien coûte ça ?","right":"Combien ça coûte ?","why":"في الأسئلة اليومية يأتي الضمير المعرّف قبل الفعل غالبًا."}],"dialogues":[{"title":"مقابلة عمل قصيرة: أسئلة تعريف","ctx":"شركة تسأل زبوناً جديداً عن بياناته","lines":[{"who":"Agent","fr":"Bonjour ! Comment vous appelez-vous ?","ar":"مرحباً! ما اسمك؟"},{"who":"Candidat","fr":"Je m'appelle Nadia Benali.","ar":"اسمي نادية بن علي."},{"who":"Agent","fr":"Où habitez-vous ?","ar":"أين تسكن؟"},{"who":"Candidat","fr":"J'habite à Lyon, près du centre.","ar":"أسكن في ليون، قرب المركز."},{"who":"Agent","fr":"Quel est votre métier ?","ar":"ما مهنتك؟"},{"who":"Candidat","fr":"Je suis graphiste. Et vous, vous travaillez ici ?","ar":"أنا مصمم جرافيك. وأنت، هل تعمل هنا؟"}]}],"exercises":[{"t":"mcq","skill":"grammar","q":"أي طريقة سؤال مناسبة لكل المواقف؟","opts":["نبرة الصوت","Est-ce que","الانقلاب فقط","لا سؤال"],"a":1,"why":"Est-ce + جملة عادية أسلوب آمن دائماً."},{"t":"mcq","skill":"grammar","q":"حوّل الجملة إلى سؤال بـ est-ce que: «Tu parles français.»","opts":["Est-ce que tu parles français ?","Tu est-ce que parles français ?","Est-ce que parles français tu ?","Est-ce que tu français parles ?"],"a":0,"why":"est-ce que تُلحق أول الجملة المثبتة دون تغيير ترتيبها، فلا يُنقلب الفعل."},{"t":"fill","skill":"grammar","q":"أكمل: «___ habites-tu ?» (أين)","fr":"___ habites-tu ?","ans":"Où","alts":["ou","où"],"why":"où = أين (بالنبرة)."},{"t":"translate","skill":"writing","q":"ترجم: «لماذا تتعلم الفرنسية؟»","ans":"Pourquoi apprends-tu le français ?","alts":["pourquoi tu apprends le francais","pourquoi est-ce que tu apprends le français"],"why":"pourquoi تبدأ السؤال، وجوابها بـ parce que."},{"t":"listen","skill":"listening","q":"استمع واختر السؤال:","audio":"Combien ça coûte ?","opts":["بكم هذا؟","أين هذا؟","متى نذهب؟","من هذا؟"],"a":0,"why":"combien أداة السعر والكمية: Combien ça coûte ?"},{"t":"speaking","skill":"speaking","q":"اسأل بالفرنسية: «أين تسكن؟»","target":"Où habites-tu ?","why":"où أداة المكان، و التقلاب habites-tu أسلوب كتابة سليم."},{"t":"mcq","skill":"grammar","q":"سؤال عن الاسم: «___ t'appelles-tu ?»","opts":["Comment","Quand","Où","Pourquoi"],"a":0,"why":"comment للسؤال عن الطريقة/الاسم هنا."},{"t":"translate","skill":"writing","q":"ترجم: \"هل تسكن هنا؟\"","ans":"Est-ce que tu habites ici ?","alts":["habites-tu ici"],"why":"est-ce que أو قلاب الفعل."}],"homework":"اكتب 8 أسئلة ستسألها لأصدقائك الجدد بالفرنسية، وأنجزها بثلاث طرق مختلفة.\nالدرس السابق/التالي: a1-t9-l1 (النفي بأشكاله) / a1-t11-l1 (قاعدة أفعال المجموعة الأولى).","sources":[{"title":"تعلم الاستفهام بالفرنسية l’interrogation","channel":"فرنساوى العرب le français","videoId":"l5pPevHlv_s","why":"شرح عربي لأدوات الاستفهام مع أمثلة مترجمة — مرجع سريع للحفظ.","cat":"Grammar","level":"A1","main":true},{"title":"Comment poser une question en français - How to ask questions in French","channel":"Parlez-vous FRENCH : Cours de français","videoId":"4tYHwD4w2js","why":"الطرق الثلاث للسؤال في درس واحد منظم من Parlez-vous French.","cat":"Grammar","level":"A1","extra":true},{"title":"Learn How to Ask Questions in French | French for Beginners (A1) | Slow French Podcast","channel":"Français Rapide","videoId":"yFrnHodfVqE","why":"أسئلة يومية بسرعة بطيئة A1 — تدريب استماع مباشر على صيغ السؤال الشائعة.","cat":"Grammar","level":"A1","extra":true},{"title":"الدرس 22: الاستفهام وأدوات الاستفهام (أين/متى/لماذا...) مع أمثلة","channel":"من فرنسا","videoId":"MTvUbl_1e6s","why":"يغطي أدوات الاستفهام الأساسية بترتيب مدرسي واضح — بالضبط ما يحتاجه درس الأسئلة.","cat":"Grammar","dur":10,"level":"A1","extra":true},{"title":"طرح الأسئلة والإجابة بضمائر الاستفهام Les pronoms interrogatifs","channel":"Le français avec Imad Zniti","videoId":"bvLTjFRZ14U","why":"يتعمق في comment/qui/où/quel داخل السؤال — إثراء لبنية السؤال.","cat":"Grammar","dur":12,"level":"A1","extra":true}],"supplements":[{"id":"4tYHwD4w2js","title":"Comment poser une question en français - How to ask questions in French","channel":"Parlez-vous FRENCH : Cours de français","why":"الطرق الثلاث للسؤال في درس واحد منظم من Parlez-vous French.","lang":"fr"},{"id":"yFrnHodfVqE","title":"Learn How to Ask Questions in French | French for Beginners (A1) | Slow French Podcast","channel":"Français Rapide","why":"أسئلة يومية بسرعة بطيئة A1 — تدريب استماع مباشر على صيغ السؤال الشائعة.","lang":"en"},{"id":"MTvUbl_1e6s","title":"الدرس 22: الاستفهام وأدوات الاستفهام (أين/متى/لماذا...) مع أمثلة","channel":"من فرنسا","why":"يغطي أدوات الاستفهام الأساسية بترتيب مدرسي واضح — بالضبط ما يحتاجه درس الأسئلة.","dur":10,"lang":"ar"},{"id":"bvLTjFRZ14U","title":"طرح الأسئلة والإجابة بضمائر الاستفهام Les pronoms interrogatifs","channel":"Le français avec Imad Zniti","why":"يتعمق في comment/qui/où/quel داخل السؤال — إثراء لبنية السؤال.","dur":12,"lang":"ar"}]}]},{"id":"a1-t11","slug":"le-present-des-verbes-er","icon":"users","color":"#059669","fr":"Le présent des verbes -er","ar":"مضارع أفعال -er","desc":"أكبر عائلة أفعال فرنسية: قاعدة موحدة لآلاف الأفعال.","lessons":[{"id":"A1-t11-l1","fr":"Parler, manger, travailler","ar":"قاعدة أفعال المجموعة الأولى","objectives":["تصريف أي فعل منتهٍ بـ er في المضارع بالقواعد الست","معرفة المواضع التي تُحذف فيها e (nous parlons)","تكوين جمل مثبتة ومنفية بأفعال شرعي","تحويل أفعال الكلام اليومي إلى صيغة المضارع"],"sections":[{"h":"القاعدة الوحيدة","p":["أفعال المجموعة الأولى (les verbes en -er) تمثل نحو 90% من الأفعال الفرنسية المنتظمة. لتصريفها احذف er ثم أضف النهايات: e، es، e، ons، ez، ent. هذا هو أكثر قاعدة واحدة مفيدة في اللغة كلها.","على فعل parler (يتكلم): je parle، tu parles، il parle، nous parlons، vous parlez، ils parlent. لاحظ أن ils parlent تُنطق كما يُنطق il parle تمامًا — النهاية ent صامتة، وهذا ما يحفظ الجملة من السخرية.","شاهد الفيديو الأساسي بالشرح العربي لتسمع التصريف في جمل حقيقية، ثم صرف أربعة أفعال يومية بصوت مسموع: aimer (يحب)، manger (يأكل)، travailler (يعمل)، habite (يسكن — لا، هذا آخر!). قاعدة واحدة تفتح مئات الأفعال.","استثناء مهم واحد: مع nous يُحذف e من نهايات الأفعال المنتهية بـ -cer أو -ger: nous commençons (نبدأ)، nous mangeons (نأكل). بدون هذا الحذف يصبح النطق عسرًا على الفرنسية — وهو استثناء يُحفظ بمثالين فقط.","مع النفي تبقى النهايات كما هي: je ne parle pas، nous ne parlons pas. ومع الأسئلة: Est-ce que tu parles ? تبقى الصيغة المفردة دون أي تغيير.","الترتيب العملي: احفظ النهايات الست في جملة واحدة — e, es, e, ons, ez, ent — ثم اصرف عليها parler في المرات الثلاث الأولى، وبعدها بدّل الفعل كل يوم. هكذا تثبت القاعدة لا الفعل الواحد."],"video":{"id":"HRHTZtBUCZU","title":"الدرس 11: الزمن الحاضر بالفرنسية بطريقة مبسطة — تركيب جمل | المجموعة الأولى","channel":"من فرنسا","why":"يشرح présent des verbes -er (المجموعة الأولى) بالتركيب والجمل — بالضبط موضوع الدرس بالعربية.","dur":10,"lang":"ar","main":true},"sub":[{"h":"جدول النهايات الست على parler","p":["je parle — أتكلم","tu parles — أنت تتكلم","il/elle parle — هو/هي يتكلم","nous parlons — نحن نتكلم","vous parlez — أنتم تتكلمون","ils/elles parlent — هم يتكلمون (ent صامتة)"]},{"h":"الاستثناءان: -cer و -ger","p":["commencer → nous commençons (أضف ç قبل ons ليُنطق c سينية).","manger → nous mangeons (احتفظ بـ e قبل ons ليُنطق g جيم).","نفس الحذف/الإضافة مع el/ez/ent: il commence، vous mangez، ils commencent."]},{"h":"أفعال A1 المنتظمة الأساسية","p":["parler (يتكلم)، aimer (يحب)، donner (يعطي)، habiter (يسكن)، travailler (يعمل).","écouter (يستمع)، regarder (ينظر)، étudier (يدرس)، acheter (يشتري)، porter (يحمل).","اختر خمسة وصرّفها يوميًا عكس الترتيب — فالعكس يكشف الحفظ الآلي."]}]},{"h":"أفعال يومية أساسية","p":["habiter (يسكن)، travailler (يعمل)، manger (يأكل)، étudier (يدرس)، regarder (يشاهد)، écouter (يستمع)، aimer (يحب)، jouer (يلعب)، penser (يفكر)، donner (يعطي).","أمثلة: J'habite à Amman. Tu manges bien ! Nous écoutons de la musique. Elles aiment le français.","التقليب العكسي (من ils إلى je) تمرين انتقائي: ابدأ من parlent ثم parlez ثم parlons... إن استطعت فقد أتقنت القاعدة لا الترتيب."]},{"h":"استثناء وحيد: aller","p":["aller هو الفعل الشاذ الوحيد في عائلة -er: je vais، tu vas، il va، nous allons، vous allez، ils vont.","احفظه لوحده، وسيُشرح بالتفصيل في وحدة مستقلة في A1.","اللاصوتيات (en -er) هي مخزونك الإنتاجي الأول: كل فكرة يومية تدور حول أفعالها. اكتب ثلاث جمل فكرية بها واقرأها بصوت مسموع."]},{"h":"التطبيق والتلخيص","p":["تستخلص هذه الخلاصة القاعدة الأوسع انتشارًا في اللغة الفرنسية كلها: قاعدة الأفعال المنتهية بـ -er (les verbes en -er)، وهي أن تُحذف النهاية er ثم يُلحق بالجذر نهايات العلة الست e, es, e, ons, ez, ent، مع حالتين مقيّدتين تخصّان فعلَي -cer و -ger عند الضمير nous (nous commençons، nous mangeons)، وقاعدة صامتة تخصّ النهاية ent المكتوبة التي لا مقطع لها في النطق (ils parlent تنطق كما يُنطق il parle). كما وضح الفيديو الرئيسي «الدرس 11: الزمن الحاضر بالفرنسية بطريقة مبسطة — تركيب جمل | المجموعة الأولى» من قناة «من فرنسا» على الرابط https://www.youtube.com/watch?v=HRHTZtBUCZU، يتقدّم الجدول إلى جمل حيّة مسموعة مثل «Nous écoutons de la musique» و«Elles aiment le français»، وأن معيار إتقان القاعدة هو النطق لا الحفظ وحده: النهايتان ons وez مسموعتان بوضوح، و ent صامتة تمامًا، ونهاية المفرد الغائب (il parle) صامتة هي الأخرى.","«الأفعال المنتظمة تسبق الشاذة في a1-t12»: وهذا ترتيب تربوي مقصود لا اعتباطي، فلولا إتقانك للنهايات الست لما استطعت أن تميّز انحراف الشاذ عنها في صيغة tu وفي جذور nous وils، ولا سيّما مع الوحدات الأربع الأساسية être و avoir و aller و faire. ويبقى في هذا الباب استثناء واحد يُحفظ لوحده ألا وهو aller، وهو المدخل نفسه إلى الباب التالي من السلسلة.","أعد مشاهدة الفيديو الرئيسي بتركيز على مقطع جدول النهايات، وأوقفه عند كل ضمير ثم صرّف معه فعل parler بصوت مسموع؛ وبعد ذلك سجّل نفسك وأنت تصرّف أربعة أفعال يومية من هذا الدرس (aimer، manger، travailler، commencer) في الأشكال الستة من je إلى ils، ثم استمع إلى تسجيلك وصحّح كل نهاية خرجت عن النطق السليم مقارنةً بالنموذج المسموع في الفيديو قبل أن تُسلّم التمرين."]}],"examples":[{"fr":"Je travaille à l'hôpital.","ar":"أعمل في المستشفى."},{"fr":"Nous mangeons à midi.","ar":"نأكل في الظهيرة.","note":"manger + ons: mangeons"},{"fr":"Elles écoutent la radio.","ar":"هن يستمعن للراديو.","note":"ent صامتة!"},{"fr":"Tu aimes le sport ?","ar":"تحب الرياضة؟"},{"fr":"Le professeur parle lentement.","ar":"يتحدث الأستاذ ببطء.","note":"il parle"},{"fr":"Nous commençons le cours.","ar":"نبدأ الدرس.","note":"استثناء -cer: ç"},{"fr":"Ils mangent à midi.","ar":"يأكلون عند الظهر.","note":"ent صامتة"},{"fr":"Est-ce que tu étudies ce soir ?","ar":"هل تدرس هذا المساء؟","note":"سؤال بـ est-ce que"}],"pron":[{"w":"parler","ipa":"[paʁ.le]","approx":"بارليه"},{"w":"nous mangeons","ipa":"[nu.mɑ̃.ʒɔ̃]","approx":"نو-مانجون"},{"w":"ils parlent","ipa":"[il.paʁl]","approx":"يل-بارل","note":"ent صامتة تماماً"}],"vocab":[{"fr":"travailler","ar":"يعمل","pos":"verbe","ipa":"[tʁa.va.je]","exFr":"Je travaille lundi.","exAr":"أعمل يوم الاثنين."},{"fr":"manger","ar":"يأكل","pos":"verbe","ipa":"[mɑ̃.ʒe]","exFr":"On mange à midi.","exAr":"نأكل ظهراً."},{"fr":"écouter","ar":"يستمع","pos":"verbe","ipa":"[e.ku.te]","exFr":"J'écoute des podcasts.","exAr":"أستمع للبودكاست."},{"fr":"aimer","ar":"يحب","pos":"verbe","ipa":"[ɛ.me]","exFr":"J'aime le français !","exAr":"أحب الفرنسية!"},{"fr":"regarder","ar":"يشاهد","pos":"verbe","ipa":"[ʁə.ɡaʁ.de]","exFr":"On regarde un film.","exAr":"نشاهد فيلماً."},{"fr":"étudier","ar":"يدرس","pos":"verbe","ipa":"[e.ty.dje]","exFr":"Elle étudie la médecine.","exAr":"تدرس الطب."},{"fr":"parler","ar":"يتكلم","pos":"verbe","g":"1er","exFr":"Je parle français.","ipa":"[paʁle]","exAr":"أتكلم الفرنسية."},{"fr":"habiter","ar":"يسكن","pos":"verbe","g":"1er","exFr":"Elle habite à Marseille.","ipa":"[abite]","exAr":"تسكن في مرسيليا."},{"fr":"commencer","ar":"يبدأ","pos":"verbe","g":"1er","exFr":"Le cours commence à neuf heures.","ipa":"[kɔmɑ̃se]","exAr":"يبدأ الدرس الساعة التاسعة."},{"fr":"le premier","ar":"الأول","pos":"adj.","g":"m","exFr":"C’est mon premier jour.","ipa":"/lə pʁəmje/","exAr":"هذا هو يومي الأول."}],"grammar":[{"tFr":"Le présent des verbes en -er","tAr":"القاعدة: تصريف المجموعة الأولى","body":["احذف er وأضف: e, es, e, ons, ez, ent. النهايتان ons وez مسموعتان، و ent صامتة.","الاستثناء: -cer → ç و -ger → e قبل ons مع nous. لا قواعد أخرى في هذا المستوى."],"ex":[{"fr":"Tu parles bien !","ar":"أنت تتكلم جيداً!"},{"fr":"Nous étudions ensemble.","ar":"ندرس معاً."}]}],"mistakes":[{"wrong":"nous parlons avec ent","right":"nous parlons","why":"مع nous يبقى النطق واضحًا بلا ent إطلاقاً."},{"wrong":"ils mangent [mɑ̃ʒɛnt]","right":"ils mangent [mɑ̃ʒ]","why":"نهاية ent صامتة تماماً."},{"wrong":"nous commençons","right":"nous commençons","why":"مع -cer توضع ç قبل ons لضمان النطق السيني."},{"wrong":"il parle (بصوت e مسموعة)","right":"il parle","why":"نهاية المفرد الغائب صامتة في النطق العملي."}],"dialogues":[{"title":"حوار عن الروتين اليومي","ctx":"زميلان يتحدثان عن عادتهما","lines":[{"who":"Fatima","fr":"À quelle heure tu te lèves ?","ar":"في أي ساعة تستيقظ؟"},{"who":"Yanis","fr":"Je me lève à six heures, puis je travaille.","ar":"أستيقظ الساعة السادسة، ثم أعمل."},{"who":"Fatima","fr":"Nous commençons le cours à huit heures.","ar":"نبدأ الدرس الساعة الثامنة."},{"who":"Yanis","fr":"Et le soir, tu écoutes la radio ?","ar":"وفي المساء، تستمع للراديو؟"},{"who":"Fatima","fr":"Non, je regarde les informations.","ar":"لا، أشاهد الأخبار."}]}],"exercises":[{"t":"mcq","skill":"grammar","q":"أكمل: «Nous ___ le français.» (aimer)","opts":["aimons","aimez","aiment","aime"],"a":0,"why":"nous ← -ons: aimons."},{"t":"fill","skill":"grammar","q":"أكمل: «Tu ___ la télévision.» (regarder)","fr":"Tu ___ la télévision.","ans":"regardes","why":"tu ← -es: regardes."},{"t":"mcq","skill":"pronunciation","q":"كيف تُنطق «ils parlent»؟","opts":["يل-بارلانت","يل-بارل","يل-بارلت","يل-بارليه"],"a":1,"why":"-ent صامتة: [il.paʁl]."},{"t":"translate","skill":"writing","q":"ترجم: «نستمع للموسيقى.»","ans":"Nous écoutons de la musique.","alts":["nous ecoutons de la musique"],"why":"نأتي بالضمير nous ثم الفعل المصرف بـ ons: écoutons، ويسبقه حرف الجر de قبل la musique."},{"t":"listen","skill":"listening","q":"استمع واختر الفعل:","audio":"Elles travaillent à l'hôpital","opts":["travaillent","mangent","écoutent","habitent"],"a":0,"why":"الفاعل جمع المخاطبات (elles) والنهاية ent مكتوبة صامتة، فيُسمع travaillent على غرار travaille."},{"t":"speaking","skill":"speaking","q":"قل: «أحب الفرنسية وأدرس كل يوم».","target":"J'aime le français et j'étudie tous les jours","why":"aimer و étudier من المجموعة الأولى: aime بحرف e صامت في المفرد، و étudie بـ e مسموعة، مع ظرف التكرار tous les jours."},{"t":"mcq","skill":"grammar","q":"أكمل مع «parler»: «Ils ___ français.»","opts":["parlent","parlez","parlons","parle"],"a":0,"why":"ils ← parlent (ent صامتة)."},{"t":"fill","skill":"grammar","q":"أكمل مع «manger»: «Nous ___ à midi.»","fr":"Nous ___ à midi.","ans":"mangeons","why":"الاستثناء: e قبل ons مع -ger."}],"homework":"اختر 6 أفعال -er وصرفها كاملة (6 أشكال لكل فعل)، ثم اكتب 6 جمل من حياتك. الدرس السابق: a1-t10 (الأسئلة) — راجع تكوين السؤال بـ est-ce que فستوظّفه في تسميع أفعال -er المثبتة والمنفية. الدرس التالي: a1-t12 (الأفعال الشاذة) — احفظ نهايات المجموعة الأولى الست قبل أن تقارنها بانحراف الشاذ عنها.","sources":[{"title":"الدرس 11: الزمن الحاضر بالفرنسية بطريقة مبسطة — تركيب جمل | المجموعة الأولى","channel":"من فرنسا","videoId":"HRHTZtBUCZU","why":"يشرح présent des verbes -er (المجموعة الأولى) بالتركيب والجمل — بالضبط موضوع الدرس بالعربية.","cat":"Grammar","dur":10,"level":"A1","main":true},{"title":"Conjugaison Française : Présent de l'indicatif 1er Groupe","channel":"Français avec Pierre","videoId":"94GZJjxGslE","why":"بيير يشرح قاعدة المجموعة الأولي كاملة — الإحساس بأن القاعدة حقًا واحدة.","cat":"Grammar","level":"A1","extra":true},{"title":"Speak French TODAY – ER Verbs, Routine & Food (Lesson 8- Lesson 15) | 30 days SERIES |…","channel":"EzeeFrench","videoId":"WNCB7qkYZFg","why":"أفعال -er في الروتين اليومي والطعام — يربط التصريف بمفردات حياتية فورية.","cat":"Grammar","level":"A1","extra":true},{"title":"Le verbe Aller - Présent de l'indicatif - alain le lait","channel":"tialela99","videoId":"D4ktRrWUzCw","why":"أنشودة فعل Aller — الاستثناء الوحيد يثبت بالموسيقى أسهل من أي قاعدة.","cat":"Grammar","level":"A1","extra":true},{"title":"درس تصريف الأفعال المنتظمة المنتهية بـ ER في المضارع","channel":"Hadi Pertguiz — برطقيز","videoId":"8RYBEpebd-g","why":"شرح مختصر وسريع لتصريف -er في الحاضر — مراجعة سريعة قبل التمارين.","cat":"Grammar","dur":3,"level":"A1","extra":true},{"title":"المرجع الشامل لتصريف كل الأفعال الفرنسية Conjugaison — الدرس الأول","channel":"le français avec nabila — الفرنسية مع نبيلة","videoId":"rC5a63PF_3U","why":"مرجع تصريف مصنّف يبدأ بالمجموعة الأولى — نقطة انطلاق لمن يريد التعمق بعد الدرس.","cat":"Grammar","dur":17,"level":"A1","extra":true}],"supplements":[{"id":"94GZJjxGslE","title":"Conjugaison Française : Présent de l'indicatif 1er Groupe","channel":"Français avec Pierre","why":"بيير يشرح قاعدة المجموعة الأولي كاملة — الإحساس بأن القاعدة حقًا واحدة.","lang":"fr"},{"id":"WNCB7qkYZFg","title":"Speak French TODAY – ER Verbs, Routine & Food (Lesson 8- Lesson 15) | 30 days SERIES |…","channel":"EzeeFrench","why":"أفعال -er في الروتين اليومي والطعام — يربط التصريف بمفردات حياتية فورية.","lang":"en"},{"id":"D4ktRrWUzCw","title":"Le verbe Aller - Présent de l'indicatif - alain le lait","channel":"tialela99","why":"أنشودة فعل Aller — الاستثناء الوحيد يثبت بالموسيقى أسهل من أي قاعدة.","lang":"fr"},{"id":"8RYBEpebd-g","title":"درس تصريف الأفعال المنتظمة المنتهية بـ ER في المضارع","channel":"Hadi Pertguiz — برطقيز","why":"شرح مختصر وسريع لتصريف -er في الحاضر — مراجعة سريعة قبل التمارين.","dur":3,"lang":"ar"},{"id":"rC5a63PF_3U","title":"المرجع الشامل لتصريف كل الأفعال الفرنسية Conjugaison — الدرس الأول","channel":"le français avec nabila — الفرنسية مع نبيلة","why":"مرجع تصريف مصنّف يبدأ بالمجموعة الأولى — نقطة انطلاق لمن يريد التعمق بعد الدرس.","dur":17,"lang":"ar"}]}]},{"id":"a1-t12","slug":"le-present-des-verbes-irreguliers","icon":"mic","color":"#059669","fr":"Le présent des verbes irréguliers","ar":"مضارع الأفعال الشاذة","desc":"pouvoir, vouloir, devoir, prendre, savoir وغيرها.","lessons":[{"id":"A1-t12-l1","fr":"Je peux, je veux, je dois","ar":"أستطيع، أريد، يجب عليّ","objectives":["تصريف avoir و être و aller و faire في المضارع تدريجياً","تمييز مواضع الانحراف عن القاعدة (je vais، nous avons)","توظيف الأفعال الشاذة في جمل قصيرة صحيحة","معرفة أن نهاية -s في tu تأتي مع معظم الأفعال الشاذة"],"sections":[{"h":"الأفعال الشاذة الأكثر أهمية","p":["الأفعال الشاذة (les verbes irréguliers) لا تهدم القاعدة بل ينحرف نهاياتها قليلًا. أشهرها أربعة: être، avoir، aller، faire — وقد تعلمتها في الدروس الأولى، والآن نجمعها في صورة واحدة متكاملة.","النمط الشائع في tu: أسهل من الفعل المنتظم. مع avoir تقول tu as (لا tu avez)، ومع être تقول tu es، ومع aller tu vas. النهاية s في tu هي الحد الفاصل بين المنتظم والشاذ في أغلب الحالات.","شاهد الفيديو الأساسي بالشرح العربي لتصريف الأفعال الثلاثة الأساسية معًا، ثم اكتب جدولًا واحدًا بأربعة أفعال × ستة ضمائر. رؤية الأنماط متجاورة تكشف الفروق فورًا.","الاستثناء الفعلي الوحيد الذي يجب حفظه الآن: nous avons و vous avez (لأن av- تتبدّل)، و ils ont (تُنطق on). هذه الثلاثة تُحفظ كأصوات لا كحروف.","الروابط مفيدة: tu as / tu es / tu vas — ثلاث نهايات قصيرة تغطي نصف ردودك اليومية. احفظها في جمل: Tu es là ? Tu as le temps ? Tu vas où ?","قاعدة أمان: كل فعل شاذ في A1 يجب أن يُحفظ مع ضمائره الستة، ولا يُطلق في جملة مفردة فقط. سجّل نفسك تصرّفها عكس الترتيب — العكس هو الاختبار الحقيقي."],"video":{"id":"bt6ejCe6Hxg","title":"تصريف vouloir et pouvoir بالحاضر | je veux, je voudrais يريد ويستطيع | الفرق بين","channel":"من فرنسا","why":"شرح عربي لتصريف vouloir/pouvoir مع سر je voudrais المهذبة — جوهر المحور.","lang":"ar","main":true},"sub":[{"h":"جدول الأربعة الأساسية","p":["ÊTRE: suis, es, est, sommes, êtes, sont.","AVOIR: ai, as, a, avons, avez, ont.","ALLER: vais, vas, va, allons, allez, vont.","FAIRE: fais, fait, fait, faisons, faites, font."]},{"h":"قواعد الانحراف الصغيرة","p":["مع tu غالبًا ينتهي الفعل بـ s: tu as، tu es، tu fais — لكن tu vas بحرف v لأنها فعل مختلف الأصل.","nous نادرًا ما تنتهي بـ ons الفعل الشاذ: avons، allons —/faisons فريدة بـ sons.","ils/elles تنتهي غالبًا بـ ont أو vont: elles ont، elles vont."]},{"h":"كيف تعرف أن الفعل شاذ؟","p":["جرّب النهايات المنتظمة: لو خرجت كلمة غريبة (tu avons) فالفعل شاذ.","احفظ قائمة صغيرة: être، avoir، aller، faire، voir، venir، prendre، dire — ثمانية تغطي أغلب كلام A1.","كل فرنسي يتعلّم قواعده أيضًا بحفظ هذه القائمة — فهم ليس معصومين منها."]}]},{"h":"البنيوات الثلاثية الذهبية","p":["يجتمع الشذوذ في بنيوات يومية: Je peux + فعل مجرد (أستطيع أن...)، Je veux + فعل مجرد (أريد أن...)، Je dois + فعل مجرد (يجب أن...).","مثال: Je peux parler français (أستطيع الكلام بالفرنسية). Je veux manger (أريد أن آكل). Je dois partir (يجب أن أغادر).","الترتيب في الجملة لا يتغير مع الشذوذ: الفعل يبقى بعد الضمير مباشرة. الشذوذ في الصوت لا في التركيب — وهذا يخفف الرهبة من الدرس."]},{"h":"فعلان مهمان آخران","p":["prendre (يأخذ/يتناول): je prends، tu prends، il prend، nous prenons، vous prenez، ils prennent. شائع جداً مع الطعام: Je prends un café (أتناول قهوة).","savoir (يعرف): je sais، tu sais، il sait، nous savons، vous savez، ils savent. — Je ne sais pas (لا أعرف) من أشهر العبارات.","الاستماع المركّز: بعد الفيديو أعد تشغيل جزء التصريف فقط وأنت تكتب ما تسمع. مهارة التسميع الشاذة أثبت من الحفظ البصري."]},{"h":"التطبيق والتلخيص","p":["تستخلص هذه الخلاصة جدول الأفعال الشاذة (les verbes irréguliers) في زمن المضارع بأربع وحدات مغلقة تُحفظ كأصوات لا كقواعد: être (suis, es, est, sommes, êtes, sont)، و avoir (ai, as, a, avons, avez, ont)، و aller (vais, vas, va, allons, allez, vont)، و faire (fais, fait, fait, faisons, faites, font)، ثم بنيّتان نحويتان يوميتان تقومان على الفعل المجرّد: je peux، je veux، je dois. كما وضح الفيديو الرئيسي «تصريف vouloir et pouvoir بالحاضر | je veux, je voudrais يريد ويستطيع | الفرق بين» من قناة «من فرنسا» على الرابط https://www.youtube.com/watch?v=bt6ejCe6Hxg، الشذوذ لا يمسّ التركيب بل الصوت والجذر: الفعل يبقى بعد الضمير مباشرة كما في المنتظم، والعلامة المميّزة في tu غالبًا حرف s (tu as، tu es، tu fais)، بينما تنقلب الجذور في nous وils إلى avons وont المسموعتين على غرار on.","«من المضارع إلى futur proche بـ aller+infinitif في a1-t13»: فالصيغ الستة لفعل aller التي أتقنتها هنا ليست للاستعمال وحدها بل هي المحرك نفسه لتكوين المستقبل القريب، إذ يُكفي إلحاق المصدر مباشرة بها لتصير Je vais partir. وهكذا ينتقل الدرس من وصف الحاضر إلى بناء المستقبل بالفعل نفسه، دون أن تتعلّم جدولًا جديدًا من الصفر.","أعد مشاهدة الفيديو الرئيسي حتى مقطع je veux / je voudrais، ثم سجّل نفسك وأنت تصرّف الأفعال الأربعة الأساسية في الأشكال الستة بالترتيب العكسي من ils إلى je؛ وبعد ذلك أعد المشاهدة وأنت تبني ثلاث جمل بنيات الثلاثية الذهبية (je peux + مصدر، je veux + مصدر، je dois + مصدر) بالضمائر الستة، واستمع إلى تسجيلك وقارنه بالفيديو للتأكد من بقاء الفعل بعد الضمير مباشرة وبلا تغيير في التركيب."]}],"examples":[{"fr":"Je peux t'aider si tu veux.","ar":"أستطيع مساعدتك إن أردت."},{"fr":"Je veux un thé, s'il vous plaît.","ar":"أريد شاي من فضلك."},{"fr":"Tu dois faire tes devoirs.","ar":"يجب أن تعمل واجباتك."},{"fr":"Nous prenons le petit-déjeuner à 7h.","ar":"نتناول الفطور الساعة 7."},{"fr":"Je ne sais pas.","ar":"لا أعرف."},{"fr":"Nous avons deux enfants.","ar":"لدينا طفلان.","note":"nous avons — شاذة"},{"fr":"Tu vas au travail à pied.","ar":"تذهب إلى العمل مشياً.","note":"tu vas"},{"fr":"Ils font leurs devoirs.","ar":"يفعلون واجباتهم.","note":"ils font"},{"fr":"Elle est contente de te voir.","ar":"هي سعيدة برؤيتك.","note":"être + voir معاً"}],"pron":[{"w":"je peux","ipa":"[ʒə.pø]","approx":"جو-بو"},{"w":"ils peuvent","ipa":"[il.pœv]","approx":"يل-بوف"},{"w":"nous prenons","ipa":"[nu.pʁə.nɔ̃]","approx":"نو-برنون"}],"vocab":[{"fr":"pouvoir","ar":"يستطيع","pos":"verbe","ipa":"[pu.vwaʁ]","exFr":"Pouvez-vous répéter ?","exAr":"هل يمكنك التكرار؟"},{"fr":"vouloir","ar":"يريد","pos":"verbe","ipa":"[vu.lwaʁ]","exFr":"Je veux apprendre.","exAr":"أريد أن أتعلم."},{"fr":"devoir","ar":"يجب / يدين","pos":"verbe","ipa":"[də.vwaʁ]","exFr":"Je dois partir.","exAr":"عليّ أن أغادر."},{"fr":"prendre","ar":"يأخذ / يتناول","pos":"verbe","ipa":"[pʁɑ̃dʁ]","exFr":"Je prends le bus.","exAr":"أركب الباص."},{"fr":"savoir","ar":"يعرف (معلومة)","pos":"verbe","ipa":"[sa.vwaʁ]","exFr":"Tu sais où c'est ?","exAr":"تعرف أين هي؟"},{"fr":"aider","ar":"يساعد","pos":"verbe","ipa":"[ɛ.de]","exFr":"Je t'aide.","exAr":"أساعدك."},{"fr":"voir","ar":"يرى","pos":"verbe","g":"—","exFr":"Je vois l'école.","ipa":"[vwaʁ]","exAr":"أرى المدرسة."},{"fr":"venir","ar":"يأتي","pos":"verbe","g":"—","exFr":"Tu viens d'où ?","ipa":"[vəniʁ]","exAr":"من أين أتيت؟"},{"fr":"dire","ar":"يقول","pos":"verbe","g":"—","exFr":"Il dit bonjour.","ipa":"[diʁ]","exAr":"يقول مرحباً."},{"fr":"le temps","ar":"الوقت/الطقس","pos":"nom","g":"m","exFr":"Tu as le temps ?","ipa":"[tɑ̃]","exAr":"هل لديك وقت؟"},{"fr":"toujours","ar":"دائمًا","pos":"adv","exFr":"Il est toujours là.","ipa":"[tuʒuʁ]","exAr":"هو دائماً هنا."}],"grammar":[{"tFr":"Les verbes irréguliers au présent","tAr":"القاعدة: الأفعال الشاذة الأساسية","body":["الشاذ لا يعني عشوائيًا: être/avoir/aller/faire لكل منها جدول ثابت يُحفظ كوحدة واحدة.","مع tu غالبًا s: tu as, tu es, tu fais — ومع nous/ils يتبدّل الجذر قليلًا: avons, ont."],"ex":[{"fr":"J'ai un chien.","ar":"لدي كلب."},{"fr":"Ils vont au parc.","ar":"يذهبون إلى الحديقة."}]}],"mistakes":[{"wrong":"tu as (لكنه يُكتب je as)","right":"j'ai","why":"مع je يتصل الفعل بهاء مكتوبة."},{"wrong":"nous allons [alez]","right":"nous allons [alɔ̃]","why":"النهاية ons مسموعة مع aller."},{"wrong":"vous avez = vu avez","right":"vous avez /vu.za.ve/","why":"الوصل يحذف همزة الفعل الثاني."},{"wrong":"ils ont [ɔnt]","right":"ils ont [ɔ̃]","why":"حرف n صامت، تُنطق على غرار on."}],"dialogues":[{"title":"التخطيط لرحلة نهاية الأسبوع","ctx":"صديقان يتصلان بالتخطيط","lines":[{"who":"Mehdi","fr":"Salut ! Tu fais quoi samedi ?","ar":"أهلاً! ماذا تفعل السبت؟"},{"who":"Samira","fr":"Je n'ai pas de plans. Tu as une idée ?","ar":"ليس لدي خطط. عندك فكرة؟"},{"who":"Mehdi","fr":"On va à la plage ? Je prends la voiture.","ar":"نذهب إلى الشاطئ؟ سآخذ السيارة."},{"who":"Samira","fr":"Bonne idée ! À quelle heure on se voit ?","ar":"فكرة جيدة! في أي ساعة نلتقي؟"},{"who":"Mehdi","fr":"À neuf heures, si tu es prête.","ar":"الساعة التاسعة، إن كنتِ جاهزة."}]}],"exercises":[{"t":"mcq","skill":"grammar","q":"أكمل: «___-vous m'aider ?» (pouvoir)","opts":["Peux","Pouvez","Peut","Pouvons"],"a":1,"why":"vous ← pouvez: Pouvez-vous ?"},{"t":"fill","skill":"grammar","q":"أكمل: «Je ___ partir maintenant.» (يجب)","fr":"Je ___ partir maintenant.","ans":"dois","why":"je + devoir ← dois."},{"t":"mcq","skill":"vocabulary","q":"«أتناول قهوة» بالفرنسية (بأسلوب مطعم):","opts":["Je mange un café","Je prends un café","Je bois café","Je veux café un"],"a":1,"why":"prendre تستخدم للطعام والشراب."},{"t":"translate","skill":"writing","q":"ترجم: «أريد أن أتعلم الفرنسية.»","ans":"Je veux apprendre le français.","alts":["je veux apprendre le français"],"why":"veux صيغة vouloir الشاذة مع je، و apprendre يبقى مصدرًا مطلقًا بعدها مباشرة."},{"t":"listen","skill":"listening","q":"استمع واختر المعنى الصحيح لجملة الشاذ «nous avons»:","audio":"Nous avons deux enfants","opts":["لدينا طفلان","كان لدينا طفلان","سيكون لدينا طفلان","عندكما طفلان"],"a":0,"why":"nous avons صيغة شاذة محفوظة من avoir في المضارع، والنفي عنها يكون nous n'avons pas."},{"t":"speaking","skill":"speaking","q":"قل: «أستطيع أن أتكلم قليلاً بالفرنسية».","target":"Je peux parler un peu français","why":"pouvoir مع je ← peux، ثم parler مصدر مطلق بلا حرف جر وبلا تغيير."},{"t":"mcq","skill":"grammar","q":"التصريف الصحيح لـ avoir مع nous؟","opts":["avons","avez","ont","avez-vous"],"a":0,"why":"nous avons — شاذة تُحفظ."},{"t":"order","skill":"grammar","q":"رتّب: «لدي كلبان»","words":["J'ai","deux","chiens"],"ans":"J'ai deux chiens","why":"الفعل الشاذ j'ai (avoir) يتصدّر الجملة، ثم العدد deux ثم المعدود المفرد chiens بلا s."}],"homework":"اكتب 9 جمل: 3 بـ je peux و3 بـ je veux و3 بـ je dois عن خططك اليومية. الدرس السابق: a1-t11 (المضارع بـ -er) — أعد تصريف ثلاثة أفعال منتظمة لتثبيت النهايات الست قبل مقارنتها بالشاذة. الدرس التالي: a1-t13 (المستقبل القريب) — أتقن صيغ aller الست جاهزةً لتركيب aller + infinitif.","sources":[{"title":"تصريف vouloir et pouvoir بالحاضر | je veux, je voudrais يريد ويستطيع | الفرق بين","channel":"من فرنسا","videoId":"bt6ejCe6Hxg","why":"شرح عربي لتصريف vouloir/pouvoir مع سر je voudrais المهذبة — جوهر المحور.","cat":"Grammar","level":"A1","main":true},{"title":"Devoir - Vouloir - Pouvoir // Present tense // French conjugation Course","channel":"The perfect French with Dylane","videoId":"2SdjK6S0zn8","why":"درس دايلان المتخصص للأفعال الثلاثة devoir/vouloir/pouvoir في المضارع.","cat":"Grammar","level":"A1","extra":true},{"title":"Savoir vs. Connaître in French","channel":"Learn French With Alexa","videoId":"d3SObR7-hlI","why":"مقارنة Alexa المركزة بين savoir وconnaître — أشهر لبس في المستوى المبتدئ.","cat":"Grammar","level":"A1","extra":true},{"title":"تصريف الأفعال Être – Avoir – Aller بالزمن الحاضر","channel":"تعلم وتحدث الفرنسية بأسلوب مبسط — Line Alhindi","videoId":"MhG_dcnsoNA","why":"الأفعال غير المنتظمة الثلاثة الأساسية في تصريف واحد — تطبيق مباشر لدرس الأفعال الشاذة.","cat":"Grammar","dur":8,"level":"A1","extra":true},{"title":"Le présent de l'indicatif — تصريف الأفعال في المضارع","channel":"تعلم اللغة الفرنسية في دقائق","videoId":"sCpuCwVEcoY","why":"عرض شامل لزمن المضارع بجدول مقارن — مرجع بعد تعلم المجموعات.","cat":"Grammar","dur":8,"level":"A1","extra":true}],"supplements":[{"id":"2SdjK6S0zn8","title":"Devoir - Vouloir - Pouvoir // Present tense // French conjugation Course","channel":"The perfect French with Dylane","why":"درس دايلان المتخصص للأفعال الثلاثة devoir/vouloir/pouvoir في المضارع.","lang":"fr"},{"id":"d3SObR7-hlI","title":"Savoir vs. Connaître in French","channel":"Learn French With Alexa","why":"مقارنة Alexa المركزة بين savoir وconnaître — أشهر لبس في المستوى المبتدئ.","lang":"fr"},{"id":"MhG_dcnsoNA","title":"تصريف الأفعال Être – Avoir – Aller بالزمن الحاضر","channel":"تعلم وتحدث الفرنسية بأسلوب مبسط — Line Alhindi","why":"الأفعال غير المنتظمة الثلاثة الأساسية في تصريف واحد — تطبيق مباشر لدرس الأفعال الشاذة.","dur":8,"lang":"ar"},{"id":"sCpuCwVEcoY","title":"Le présent de l'indicatif — تصريف الأفعال في المضارع","channel":"تعلم اللغة الفرنسية في دقائق","why":"عرض شامل لزمن المضارع بجدول مقارن — مرجع بعد تعلم المجموعات.","dur":8,"lang":"ar"}]}]},{"id":"a1-t13","slug":"le-futur-proche","icon":"file","color":"#059669","fr":"Le futur proche","ar":"المستقبل القريب","desc":"aller + فعل مجرد: أسهل وأكثر استخداماً للمستقبل.","lessons":[{"id":"A1-t13-l1","fr":"Je vais manger dans dix minutes","ar":"سآكل بعد عشر دقائق","objectives":["تكوين futur proche ب aller + infinitif","مطابقة aller مع الضمائر الستة داخل التكوين","تمييز futur proche عن المضارع بالسياق والظرف الزمني","التحدث عن خططك ومواعيدك القادمة"],"sections":[{"h":"البنية: aller + فعل مجرد","p":["المستقبل القريب (le futur proche) هو أبسط أزمنة المستقبل وأكثرها استخدامًا: يتكوّن من الفعل aller في المضارع + مصدر الفعل الثاني. Je vais partir — «أنا ذاهب للقيام بـ...» أي «سأغادر».","تكوينه يتطلب إتقان aller الست صيغ: je vais، tu vas، il va، nous allons، vous allez، ils vont — ثم تُلحق بها المصدر مباشرة بلا وصلة: Je vais manger. Nous allons étudier.","شاهد الفيديو الأساسي بالشرح العربي لتسمع التكوين في جمل خطط يومية، ثم صرف: je vais parler، tu vas parler، nous allons parler... لاحظ أن الفعل الثاني يبقى مطلقًا في كل الضمائر — هذه راحة كبيرة مقارنة بالمضارع.","الفرق عن المضارع: المضارع يعبّر عن العادة أو الحاضر، والمستقبل القريب يعبّر عن النية القريبة أو الموعد المحدد. Demain, je vais travailler (غدًا سأعمل) بدل Je travaille demain.","يأتي غالبًا مع ظرف زمني يحدّد القريب: maintenant (الآن)، tout de suite (فورًا)، ce soir (المساء)، demain (غدًا)، la semaine prochaine (الأسبوع القادم). احفظ الظرف مع الزمن لا منفصلًا عنه.","تمييز مهم: aller بمعنى «يذهب» فعل مستقل، وaller هنا أداة تكوين. نفس الكلمة لكن الوظيفة مختلفة: Je vais à Paris (أذهب) مقابل Je vais partir (سأغادر). السياق يحسم دائمًا."],"video":{"id":"aRy1vXHoaSY","title":"شرح زمن المستقبل القريب في اللغة الفرنسية Le futur proche","channel":"فرنشاوي Frenchawy","why":"شرح عربي متخصص لتكوين واستعمال futur proche مع جاهزية الجمل — الأنسب كأساسي.","dur":10,"lang":"ar","main":true},"sub":[{"h":"جدول التكوين على parler","p":["je vais parler — سأتكلم","tu vas parler — ستتكلم","il/elle va parler — سيتكلم","nous allons parler — سنتكلم","vous allez parler — ستكلمون","ils/elles vont parler — سيتكلمون (vont صامتة النهاية)"]},{"h":"النفي والسؤال في المستقبل القريب","p":["النفي: Je ne vais pas partir (لن أغادر) — ne...pas تحيطان بـ aller لا بالمصدر.","السؤال: Est-ce que tu vas venir ? (هل ستأتي؟).","الجمع: Ils ne vont pas étudier. لاحظ أن المصدر يبقى مطلقًا في كل الحالات."]},{"h":"ظرف الزمان المفتاحية","p":["ce soir — هذا المساء: Je vais dîner ici.","demain — غدًا: Nous allons voyager.","la semaine prochaine — الأسبوع القادم: Ils vont déménager.","tout de suite — فورًا: Je vais te rappeler."]}]},{"h":"خطط الأسبوع","p":["امزج الوقت مع المستقبل: Ce soir, je vais regarder un film (هذا المساء سأشاهد فيلماً). Samedi, on va faire les courses (السبت سنتسوق). L'année prochaine, je vais visiter la France (العام القادم سأزور فرنسا).","مهم: بعد aller المصرف يأتي الفعل بالصورة الأصلية دائماً (infinitif): Je vais manger وليس Je vais mange.","الصفات المستقبلية تأتي في نبرة ثابتة: «je vais + مصدر» لا تتغير مع المصدر إطلاقًا — استمع وردّد ثم حوّل الفعل في آخر الكلمة فقط."]},{"h":"مقارنة سريعة","p":["المضارع = حقائق وعادات: Je mange du riz tous les jours (آكل الأرز كل يوم).","المستقبل القريب = نية قريبة أو مخططة: Je vais manger à midi (سآكل في الظهيرة).","الفيديو الإثرائي يركز على الاستعمال في الكلام؛ أوقفه بعد كل جملة وقل جملتك الخاصة بنفس القالب. التوليد الفوري يثبت القاعدة."]},{"h":"التطبيق والتلخيص","p":["تستخلص هذه الخلاصة قاعدة المستقبل القريب (le futur proche) بعنصرَين ثابتين: فعل aller في المضارع بصفاته الست je vais، tu vas، il va، nous allons، vous allez، ils vont، ثم مصدر الفعل الثاني المُلحق مباشرة بلا حرف جر وبلا تغيير (Je vais manger، Nous allons étudier)، والنفي والسؤال يحيطان بفعل aller لا بالمصدر (Je ne vais pas partir). كما وضح الفيديو الرئيسي «شرح زمن المستقبل القريب في اللغة الفرنسية Le futur proche» من قناة «فرنشاوي Frenchawy» على الرابط https://www.youtube.com/watch?v=aRy1vXHoaSY، يقترن الزمن دائمًا بظرف يحدّد القريب (demain، ce soir، tout de suite، la semaine prochaine) وهو ما يميّزه عن المضارع في الكتابة والسمع معًا، ويبقى ميّزه الثاني أن كلمة aller تحمل وظيفتين: فعل ذهاب مستقل (Je vais à Paris) وأداة تكوين (Je vais partir) يحسم بينهما السياق وحده.","«المستقبل يقابله الماضي المركب في a1-t14»: فاللغة تبني هذين الزمنين على نمط متوازٍ، فكما يتكوّن هنا من فعل مساعد مصرف + مصدر، يتكوّن الماضي المركب من فعل مساعد مصرف + التصريف الثاني، غير أن المساعد هنا هو aller يأتي على هيئة vai/vas/va، وهناك يأتي على هيئة avoir أو être. وهذا التقابل يجعل حفظ جدولين في الحقيقة حفظ نمط واحد يُوظَّف في اتجاهين متعاكسين من الزمن.","أعد مشاهدة الفيديو الرئيسي وأوقفه بعد كل جملة نموذجية، ثم سجّل نفسك وأنت تكوّن ست جمل على قالب «Je vais + مصدر» عن خطط أسبوعك، مع ظرف زمني مختلف في كل جملة (demain، ce soir، samedi، la semaine prochaine)؛ وبعد التسجيل استمع إليه فاحصًا أن الفعل الثاني بقي مطلقًا في كل جملة بلا حرف جر (Je vais manger لا Je vais à manger)، وأن ne...pas إن وُجدت قد أحاطت بفعل aller لا بالمصدر."]}],"examples":[{"fr":"Je vais étudier ce soir.","ar":"سأدرس هذا المساء."},{"fr":"On va aller à la plage ?","ar":"هل سنذهب للشاطئ؟"},{"fr":"Il va pleuvoir demain.","ar":"ستمطر غداً.","note":"استخدام شائع للطقس"},{"fr":"Vous allez adorer ce film !","ar":"ستحبون هذا الفيلم!"},{"fr":"Je vais téléphoner à ma mère.","ar":"سأتصل بأمي.","note":"aller + مصدر"},{"fr":"Nous allons dîner au restaurant.","ar":"سنتعشى في المطعم.","note":"nous allons"},{"fr":"Tu vas faire quoi ce soir ?","ar":"ماذا ستفعل هذا المساء؟","note":"سؤال بالمستقبل القريب"},{"fr":"Elles ne vont pas venir.","ar":"لن تأتين.","note":"النفي تحاط بـ aller"}],"pron":[{"w":"je vais étudier","ipa":"[ʒə.ve.z‿e.ty.dje]","approx":"جو-فيز-إيتودييه","note":"وصل: vais + étudier"},{"w":"on va aller","ipa":"[ɔ̃.va.a.le]","approx":"أون-فا-آليه"}],"vocab":[{"fr":"ce soir","ar":"هذا المساء","pos":"expression","ipa":"[sə.swaʁ]","exFr":"Ce soir, je vais sortir.","exAr":"هذا المساء سأخرج."},{"fr":"demain matin","ar":"غداً صباحاً","pos":"expression","ipa":"[də.mɛ̃ ma.tɛ̃]","exFr":"Demain matin, je vais courir.","exAr":"غداً صباحاً سأركض."},{"fr":"la semaine prochaine","ar":"الأسبوع القادم","pos":"expression","ipa":"[la sə.mɛn pʁɔ.ʃɛn]","exFr":"La semaine prochaine, je vais voyager.","exAr":"الأسبوع القادم سأسافر."},{"fr":"visiter","ar":"يزور (مكاناً)","pos":"verbe","ipa":"[vi.zi.te]","exFr":"Je vais visiter Paris.","exAr":"سأزور باريس."},{"fr":"pleuvoir","ar":"تمطر (السماء)","pos":"verbe","ipa":"[plə.vwaʁ]","exFr":"Il va pleuvoir.","exAr":"ستمطر."},{"fr":"demain","ar":"غدًا","pos":"adv","exFr":"Demain, je vais au marché.","ipa":"[dəmɛ̃]","exAr":"غداً أذهب إلى السوق."},{"fr":"tout de suite","ar":"فورًا","pos":"locution","exFr":"Je t'appelle tout de suite.","ipa":"[tu də sɥit]","exAr":"أتصل بك فوراً."},{"fr":"partir","ar":"يغادر","pos":"verbe","g":"—","exFr":"Je vais partir à huit heures.","ipa":"[paʁtiʁ]","exAr":"سأغادر الساعة الثامنة."},{"fr":"attendre","ar":"ينتظر","pos":"verbe","g":"—","exFr":"Il va attendre le bus.","ipa":"[atɑ̃dʁ]","exAr":"سينتظر الحافلة."},{"fr":"un projet","ar":"مشروع/خطة","pos":"nom","g":"m","exFr":"J'ai un projet.","ipa":"[pʁɔʒɛ]","exAr":"لدي مشروع."}],"grammar":[{"tFr":"Le futur proche","tAr":"القاعدة: تكوين المستقبل القريب","body":["aller (مضارع) + مصدر = futur proche. النفي والسؤال يحيطان بـ aller: ne...pas، est-ce que.","يأتي مع ظروف القرب: demain, ce soir, tout de suite — وهي التي تميزه عن المضارع في الكتابة."],"ex":[{"fr":"Je vais étudier ce soir.","ar":"سأدرس هذا المساء."},{"fr":"Ils vont partir demain.","ar":"سيغادرون غداً."}]}],"mistakes":[{"wrong":"Je vais à manger","right":"Je vais manger","why":"المصدر يأتي مطلقًا بلا حرف جر داخل التكوين."},{"wrong":"Je vais mange","right":"Je vais manger","why":"المصدر يبقى بصيغته الأصلية لا بصيغة المضارع."},{"wrong":"nous allons à partir","right":"nous allons partir","why":"نفس القاعدة: بلا حرف جر."},{"wrong":"Ils vont au cinéma (خطا في المستقبل)","right":"Ils vont au cinéma (مباشرة) / Ils vont y aller","why":"aller الذهاب الفعلي لا تُلتبس مع أداة التكوين — يحسمها السياق."}],"dialogues":[{"title":"خطة عطلة نهاية الأسبوع","ctx":"زميلان يخططان للعطلة","lines":[{"who":"Aya","fr":"Qu'est-ce que tu vas faire dimanche ?","ar":"ماذا ستفعل يوم الأحد؟"},{"who":"Karim","fr":"Je vais aller à la montagne avec ma famille.","ar":"سأذهب إلى الجبل مع عائلتي."},{"who":"Aya","fr":"Nous allons aussi partir tôt !","ar":"سنسافر أيضاً مبكراً!"},{"who":"Karim","fr":"Tu vas prendre le train ?","ar":"ستركب القطار؟"},{"who":"Aya","fr":"Oui, je vais réserver ce soir.","ar":"نعم، سأحجز هذا المساء."}]}],"exercises":[{"t":"mcq","skill":"grammar","q":"«سآكل» بالفرنسية:","opts":["Je vais mange","Je vais manger","Je mange aller","Je vais à manger"],"a":1,"why":"aller المصرف + الفعل الأصلي: Je vais manger."},{"t":"fill","skill":"grammar","q":"أكمل: «Nous ___ ___ partir.» (سنغادر)","fr":"Nous ___ partir.","ans":"allons","why":"nous + aller ← allons + infinitif."},{"t":"order","skill":"grammar","q":"رتّب: «سأدرس هذا المساء»","words":["Je","vais","étudier","ce","soir"],"ans":"Je vais étudier ce soir","why":"ترتيب التكوين: الضمير Je ثم aller المصرف (vais) ثم المصدر étudier ثم ظرف الزمان ce soir."},{"t":"translate","skill":"writing","q":"ترجم: «ستمطر غداً.»","ans":"Il va pleuvoir demain.","alts":["il va pleuvoir demain"],"why":"va من aller مع الضمير il، ثم مصدر pleuvoir، و demain ظرف يحدّد قرب الحدث."},{"t":"listen","skill":"listening","q":"استمع واختر المعنى الصحيح لجملة المستقبل القريب:","audio":"Je vais téléphoner à ma mère ce soir","opts":["سأتصل بأمي هذا المساء","اتصلت بأمي أمس المساء","أتصل بأمي كل مساء","هل اتصلتِ بأمي هذا المساء؟"],"a":0,"why":"aller المصرف (vais) + مصدر téléphoner = futur proche، وظرف ce soir يحدّد قرب الموعد."},{"t":"speaking","skill":"speaking","q":"قل: «هذا المساء سأشاهد فيلماً».","target":"Ce soir, je vais regarder un film","why":"aller مع je ← vais، ومصدر regarder مطلق، ويسبق الظرف ce soir الجملة كاملة."},{"t":"mcq","skill":"grammar","q":"أكمل: «Je ___ partir à neuf heures.»","opts":["vais","va","sommes","allez"],"a":0,"why":"je vais + مصدر."},{"t":"fill","skill":"grammar","q":"أكمل: «Nous allons ___ (درس).»","fr":"Nous allons ___.","ans":"étudier","why":"المصدر بعد aller مباشرة."}],"homework":"اكتب خطة الأسبوع القادم: 6 جمل «Je vais + فعل» مع أوقات مختلفة. الدرس السابق: a1-t12 (الأفعال الشاذة) — أعد تسميع être وavoir وaller وfaire لأن الصيغة الأخيرة منها هي أداة تكوين هذا الزمن. الدرس التالي: a1-t14 (الماضي المركب) — جهّز قائمة أفعال être المغلقة فستستعملها مع فعلَي المساعدة هناك.","sources":[{"title":"شرح زمن المستقبل القريب في اللغة الفرنسية Le futur proche","channel":"فرنشاوي Frenchawy","videoId":"aRy1vXHoaSY","why":"شرح عربي متخصص لتكوين واستعمال futur proche مع جاهزية الجمل — الأنسب كأساسي.","cat":"Grammar","dur":10,"level":"A1","main":true},{"title":"Le futur proche - La conjugaison","channel":"La conjugaison des verbes français","videoId":"oDeltwmguVg","why":"قناة متخصصة بالتصريف تشرح بنية futur proche خطوة خطوة بجداول نظيفة.","cat":"Grammar","level":"A1","extra":true},{"title":"Mes projets - Le futur proche - français québécois","channel":"Logo Situations de communication","videoId":"CbYFCnfg-N4","why":"مشروعات أسبوعية حقيقية بالمستقبل القريب — سياق تطبيقي مطابق لموضوع المحور.","cat":"Grammar","level":"A1","extra":true},{"title":"FUTUR OU FUTUR PROCHE EN FRANÇAIS ?","channel":"Français avec Pierre","videoId":"yYoOXFX_PMY","why":"بيير يفصل الفرق بين futur proche وfutur simple — المقارنة السريعة المطلوبة.","cat":"Grammar","level":"A1","extra":true},{"title":"Grammaire française — Le futur proche — المستقبل القريب","channel":"Sylingo — سيلينغو","videoId":"hnZaw4bR1zg","why":"عرض أكاديمي مرتب للقاعدة بجدول التكوين — مراجعة تثبيتية.","cat":"Grammar","dur":7,"level":"A1","extra":true},{"title":"الدرس 12: كيف تستعمل زمن المستقبل القريب في الكلام","channel":"français avec saida","videoId":"pIIUw5vrLr8","why":"تركيز على الاستعمال في الكلام اليومي لا مجرد التكوين — يصلح بين القاعدة والتطبيق.","cat":"Grammar","dur":14,"level":"A1","extra":true}],"supplements":[{"id":"oDeltwmguVg","title":"Le futur proche - La conjugaison","channel":"La conjugaison des verbes français","why":"قناة متخصصة بالتصريف تشرح بنية futur proche خطوة خطوة بجداول نظيفة.","lang":"fr"},{"id":"CbYFCnfg-N4","title":"Mes projets - Le futur proche - français québécois","channel":"Logo Situations de communication","why":"مشروعات أسبوعية حقيقية بالمستقبل القريب — سياق تطبيقي مطابق لموضوع المحور.","lang":"fr"},{"id":"yYoOXFX_PMY","title":"FUTUR OU FUTUR PROCHE EN FRANÇAIS ?","channel":"Français avec Pierre","why":"بيير يفصل الفرق بين futur proche وfutur simple — المقارنة السريعة المطلوبة.","lang":"fr"},{"id":"hnZaw4bR1zg","title":"Grammaire française — Le futur proche — المستقبل القريب","channel":"Sylingo — سيلينغو","why":"عرض أكاديمي مرتب للقاعدة بجدول التكوين — مراجعة تثبيتية.","dur":7,"lang":"ar"},{"id":"pIIUw5vrLr8","title":"الدرس 12: كيف تستعمل زمن المستقبل القريب في الكلام","channel":"français avec saida","why":"تركيز على الاستعمال في الكلام اليومي لا مجرد التكوين — يصلح بين القاعدة والتطبيق.","dur":14,"lang":"ar"}]}]},{"id":"a1-t14","slug":"le-passe-compose","icon":"briefcase","color":"#059669","fr":"Le passé composé","ar":"الماضي المركب","desc":"حدثك عن أمس: avoir/être + participe passé.","lessons":[{"id":"A1-t14-l1","fr":"Hier, j'ai mangé au restaurant","ar":"أمس تناولت في المطعم","objectives":["تكوين passé composé مع avoir وأضفته -é/-i/-u","معرفة أفعال être المساعدة في passé composé","تمييز الماضي المركب عن المضارع بالظرف الزمني","روايتك حدثًا واحدًا ماضيًا في جملتين"],"sections":[{"h":"البنية الأساسية","p":["الماضي المركب (le passé composé) هو زمن الرواية الأساسي: يُستخدم لسرد أحداث مكتملة في الماضي: J'ai mangé (أكلتُ)، Nous sommes partis (غادرنا). تكوينه: فعل مساعد (avoir أو être) + التصريف الثاني (participe passé).","مع avoir تأتي الأضفة غالبًا: -é مع أفعال -er (parlé)، -i مع -ir (fini)، -u مع غالبية الباقي (vu، pris، bu). ثلاث نهايات تغطي أغلب ما ستكتبه.","شاهد الفيديو الأساسي بالشرح العربي لتسمع الرواية الفعلية للأحداث، ثم راوِ يومك أمس في أربع جمل: J'ai mangé... J'ai travaillé... Je suis rentré... J'ai dormi. الرواية الشخصية أثبت من قواعد الجداول.","مع être المساعدة يتغيّر التكوين:être في المضارع + التصريف الثاني، ثم مطابقة مع فاعل: Je suis allé(e)، Nous sommes partis، Elle est partie. لاحظ أنها مطابقة دائمًا — وهذه الصفة نفسها تحدد أفعال être.","قائمة أفعال être الأساسية (كلها تعبّر عن حركة أو تغيّر حالة): aller، venir، entrer، sortir، partir، arriver، rentrer، monter، descendre، rester، tomber، naître، mourir. احفظها كقائمة واحدة مغلقة في هذا المستوى.","التمييز بالظرف: passé composé يأتي مع hier (أمس)، l'autre semaine (الأسبوع الماضي)، ce matin (هذا الصباح). المضارع يبقى للعادة والحقيقة. اكتب جملة لكل زمن بالفعل نفسه لترى الفرق."],"video":{"id":"PcrRuwZxrvE","title":"الدرس3:الأفعال التي تصرف معauxiliaire être ou avoir au passé composé être.","channel":"Mon Français","why":"شرح عربي لأفعال المساعدة être/avoir في الماضي — يزيل أشهر حيرة عند العرب.","lang":"ar","main":true},"sub":[{"h":"التكوين خطوة بخطوة","p":["avoir في المضارع (ai, as, a, avons, avez, ont) + التصريف الثاني.","être في المضارع (suis, es, est, sommes, êtes, sont) + التصريف الثاني + مطابقة الفاعل.","النفي: Je n'ai pas mangé — ne...pas تحاطان بالفعل المساعد وحده."]},{"h":"التصريف الثاني: ثلاث نهايات","p":["-é: parler → parlé، travailler → travaillé، aimer → aimé.","-i: finir → fini، choisir → choisi، réfléchir → réfléchi.","-u: voir → vu، prendre → pris، boire → bu، écrire → écrit (استثناء مكتوب).","-t أو -es?: avoir → eu، faire → fait — تُحفظ كوحدات."]},{"h":"أفعال être + المطابقة","p":["Je suis allé au marché. (أنا ذهبت — مذكر).","Elle est allée au marché. (هي ذهبت — أضيف e).","Nous sommes partis tôt. (غادرنا — جمع مذكر).","Elles sont parties tôt. (غادرن — جمع مؤنث: es)."]}]},{"h":"أفعال être القليلة المهمة","p":["مع avoir تُصرف معظم الأفعال: J'ai mangé، J'ai vu. لكن 14 فعل حركة تُصرف مع être: aller (je suis allé)، venir (je suis venu)، partir، arriver، entrer، sortir، monter، descendre، naître، mourir، rester، tomber، devenir، retourner.","مع être يتطابق اسم المفعول مع الفاعل: Elle est allée (هي ذهبت — بالمؤنث +e)، Ils sont allés (ذهبوا — +s).","الماضي المركب يظهر في كل قصة قصيرة؛ اقرأ نص الحوار الإثرائي ثم حاول إعادة سرده من الذاكرة بثلاث جمل ماضية."]},{"h":"أفعال شاذة يجب حفظها","p":["faire → fait (j'ai fait)، voir → vu (j'ai vu)، prendre → pris (j'ai pris)، mettre → mis (j'ai mis)، être → été (j'ai été)، avoir → eu (j'ai eu).","مثال عملي: Hier, j'ai fait les courses et j'ai vu Amine (أمس قمت بالتسوق ورأيت أمين).","الخطأ الأشهر: استخدام avoir مع حركة (J'ai allé). أفعال الحركة تأتي مع être دائمًا — ضع قائمة العشرة أمامك حتى تصبح آلية."]},{"h":"التطبيق والتلخيص","p":["تستخلص هذه الخلاصة بنية الماضي المركب (le passé composé): فعل مساعد مصرف في المضارع — avoir أو être — يليه التصريف الثاني (participe passé)، ومع avoir تُشكَّل الأغلبية بأضفة واحدة من ثلاث: -é مع أفعال -er (parlé، mangé)، و -i مع أفعال -ir (fini)، و -u مع بقية الأفعال (vu، pris، bu)، وتُحفظ ثلاث صيغ شاذة كوحدات مسموعة: fait، vu، eu. ومع أفعال الحركة القليلة يتولّى être المساعدة فتتطابق الصيغة مع الفاعل: Je suis allé، Elle est allée، Nous sommes partis. كما وضح الفيديو الرئيسي «الدرس3:الأفعال التي تصرف معauxiliaire être ou avoir au passé composé être.» من قناة «Mon Français» على الرابط https://www.youtube.com/watch?v=PcrRuwZxrvE، الفارق عن المضارع يحسمه الظرف الزمني (hier، ce matin، l'autre semaine) لا الصيغة وحدها، وأن أفعال être مقصورة على قائمة مغلقة تعبّر عن الحركة أو تغيّر الحالة.","«ستستعمل passé composé لسرد تجربة المطعم في a1-t15»: فحين تدخل المطعم وتطلب وتستفسر وتدفع، لن يكفيك المضارع لإخبار ما جرى، بل تحتاج إلى الرواية: J'ai commandé، J'ai mangé، J'ai payé، مع صيغة الطلب المهذّبة في الحاضر. وهكذا يتحوّل زمن الرواية من قاعدة نحوية إلى أداة سياقية تجمع بين الماضي المركب الذي تتقنه الآن والحوار الكامل في a1-t15.","أعد مشاهدة الفيديو الرئيسي وركّز على مقطع القائمة المغلقة لأفعال être وعلى مقطع المطابقة، ثم سجّل نفسك وأنت تروي يوم أمس في أربع جمل: جملتين بـ avoir (كـ J'ai travaillé) وجملتين بـ être مع المطابقة الصحيحة (كـ Je suis rentré)؛ وبعد التسجيل استمع إليه واستخرج فعلًا مساعدًا واحدًا لكل جملة، فإن خلطت بين avoir وêtre مع فعل حركة فصحّح الجملة وأعد التسجيل قبل أن تقارنها بنبرة الممثلين في الفيديو."]}],"examples":[{"fr":"J'ai mangé une pizza hier.","ar":"أكلت بيتزا أمس."},{"fr":"Elle est allée au travail tôt.","ar":"ذهبت للعمل باكراً.","note":"être: مطابقة مؤنثة"},{"fr":"Nous avons vu un film génial.","ar":"شاهدنا فيلماً رائعاً."},{"fr":"Tu as fait tes devoirs ?","ar":"هل عملت واجباتك؟"},{"fr":"Hier, j'ai regardé un film.","ar":"أمس شاهدت فيلماً.","note":"avoir + -é"},{"fr":"Elle est arrivée en retard.","ar":"وصلت متأخرة.","note":"être + مطابقة المؤنث"},{"fr":"Nous avons fini le travail.","ar":"أنهينا العمل.","note":"finir → fini"},{"fr":"Tu as vu mon message ?","ar":"هل رأيت رسالتي؟","note":"voir → vu"}],"pron":[{"w":"j'ai mangé","ipa":"[ʒe.mɑ̃.ʒe]","approx":"جيه-مانجيه"},{"w":"je suis allé","ipa":"[ʒə.sɥi.z‿a.le]","approx":"جو-سوي-زاليه","note":"وصل suis+allé"},{"w":"elle est allée","ipa":"[ɛl.ɛ.ta.le]","approx":"إيل-إيت-آليه"}],"vocab":[{"fr":"hier","ar":"أمس","pos":"adv","ipa":"[jɛʁ]","exFr":"Hier, j'ai travaillé.","exAr":"أمس عملت."},{"fr":"hier soir","ar":"أمس في المساء","pos":"expression","ipa":"[jɛʁ.swaʁ]","exFr":"Hier soir, j'ai vu un film.","exAr":"أمس في المساء شاهدت فيلماً."},{"fr":"le participe passé","ar":"اسم المفعول","pos":"nom","g":"m","ipa":"[paʁ.ti.sip pa.se]","exFr":"Le participe passé de faire est fait.","exAr":"اسم مفعول faire هو fait."},{"fr":"tôt","ar":"باكراً","pos":"adv","ipa":"[to]","exFr":"Je me lève tôt.","exAr":"أستيقظ باكراً."},{"fr":"vu","ar":"شاهد (اسم مفعول voir)","pos":"pp","ipa":"[vy]","exFr":"J'ai vu ce film.","exAr":"شاهدت هذا الفيلم."},{"fr":"l'autre semaine","ar":"الأسبوع الماضي","pos":"locution","exFr":"L'autre semaine, je suis parti.","ipa":"[lotʁ sɛmɛn]","exAr":"الأسبوع الماضي سافرت."},{"fr":"ce matin","ar":"هذا الصباح","pos":"locution","exFr":"Ce matin, j'ai couru.","ipa":"[sə matɛ̃]","exAr":"هذا الصباح جريت."},{"fr":"finir","ar":"ينهي","pos":"verbe","g":"2e","exFr":"J'ai fini mon devoir.","ipa":"[finiʁ]","exAr":"أنهيت واجبي."},{"fr":"rentrer","ar":"يعود إلى المنزل","pos":"verbe","g":"—","exFr":"Je suis rentré à six heures.","ipa":"[ʁɑ̃tʁe]","exAr":"عدت الساعة السادسة."},{"fr":"une histoire","ar":"قصة","pos":"nom","g":"f","exFr":"Raconte-moi ton histoire.","ipa":"[istwaʁ]","exAr":"احكِ لي قصتك."},{"fr":"déjà","ar":"بالفعل/إلى الآن","pos":"adv","exFr":"J'ai déjà mangé.","ipa":"[deʒa]","exAr":"لقد أكلت بالفعل."}],"grammar":[{"tFr":"Le passé composé","tAr":"القاعدة: تكوين الماضي المركب","body":["avoir/être (مضارع) + التصريف الثاني. الأضفة: -é/-i/-u. أفعال الحركة تكون مع être مع مطابقة الفاعل.","النفي يحيط بالمساعد: je n'ai pas vu. والظرف الزمني (hier...) هو فارق التمييز عن المضارع."],"ex":[{"fr":"J'ai parlé à mon patron.","ar":"تحدثت مع مديري."},{"fr":"Ils sont partis hier.","ar":"غادروا أمس."}]}],"mistakes":[{"wrong":"J'ai allé au travail","right":"Je suis allé au travail","why":"aller من أفعال être في الماضي المركب."},{"wrong":"J'ai fini (بلا é مكتوبة)","right":"J'ai fini","why":"fini تنتهي بـ i وليس é — القاعدة حسب نوع الفعل."},{"wrong":"Elle est parti","right":"Elle est partie","why":"المطابقة تضيف e للمؤنث في التصريف الثاني."},{"wrong":"Hier, je mange (بلا ضمير)","right":"Hier, j'ai mangé","why":"حدها يحدد الماضي المركب لا المضارع."}],"dialogues":[{"title":"رواية يوم أمس","ctx":"صديقان يتحدثان عن اليوم السابق","lines":[{"who":"Nora","fr":"Qu'est-ce que tu as fait hier ?","ar":"ماذا فعلت أمس؟"},{"who":"Sami","fr":"J'ai travaillé le matin, puis je suis allé au cinéma.","ar":"عملت صباحاً، ثم ذهبت إلى السينما."},{"who":"Nora","fr":"Tu as vu quel film ?","ar":"أي فيلم شاهدت؟"},{"who":"Sami","fr":"Un film français. Il était très bien !","ar":"فيلماً فرنسياً. كان ممتازاً!"},{"who":"Nora","fr":"Moi, je suis restée à la maison.","ar":"وأنا، بقيت في البيت."}]}],"exercises":[{"t":"mcq","skill":"grammar","q":"«أكلت» (je) بالماضي المركب:","opts":["Je suis mangé","J'ai mangé","Je mangeais","Je mangé"],"a":1,"why":"manger فعل عادي ← avoir: J'ai mangé."},{"t":"mcq","skill":"grammar","q":"«ذهبت» (elle):","opts":["Elle a allé","Elle est allé","Elle est allée","Elle va aller"],"a":2,"why":"aller من أفعال être + مطابقة مؤنثة: allée."},{"t":"fill","skill":"grammar","q":"أكمل: «Hier, j'ai ___ les courses.» (faire)","fr":"j'ai ___ les courses.","ans":"fait","why":"faire ← fait (شاذ)."},{"t":"translate","skill":"writing","q":"ترجم: «شاهدت فيلماً أمس.»","ans":"J'ai vu un film hier.","alts":["j ai vu un film hier"],"why":"avoir مع je ← ai، ثم التصريف الثاني vu لفعل voir، وظرف hier يحسم زمن الجملة."},{"t":"listen","skill":"listening","q":"استمع واختر المعنى الصحيح لجملة الماضي المركب:","audio":"Hier, j'ai mangé au restaurant","opts":["أكلتُ في المطعم أمس","سآكل في المطعم غداً","آكل في المطعم كل يوم","هل أكلتَ في المطعم؟"],"a":0,"why":"hier + avoir (ai) + mangé = passé composé لحدث مكتمل في الماضي."},{"t":"speaking","skill":"speaking","q":"قل: «أمس عملت واجباتي».","target":"Hier, j'ai fait mes devoirs","why":"fait التصريف الثاني الشاذ لفعل faire مع avoir، وحرف الجر de يسبق les devoirs."},{"t":"mcq","skill":"grammar","q":"الماضي الصحيح: «Hier, je ___ un film.»","opts":["ai vu","suis vu","avoir vu","ai voit"],"a":0,"why":"avoir + التصريف الثاني vu."},{"t":"translate","skill":"writing","q":"ترجم: \"ذهبنا إلى السوق أمس.\"","ans":"Nous sommes allés au marché hier.","alts":["nous sommes alles au marche hier"],"why":"aller مع être + مطابقة الجمع."}],"homework":"اكتب 6 جمل عن أمسك: 4 بـ avoir و2 بـ être، واقرأها بصوت عالٍ. الدرس السابق: a1-t13 (المستقبل القريب) — قارن «Je vais partir» بـ «Je suis parti» لترى توازن الصيغتين من المساعد إلى المصدر. الدرس التالي: a1-t15 (في المطعم) — راجع الضمائر a1-t4 والنفي a1-t9 والأسئلة a1-t10 قبل حوار المطعم الكامل.","sources":[{"title":"الدرس3:الأفعال التي تصرف معauxiliaire être ou avoir au passé composé être.","channel":"Mon Français","videoId":"PcrRuwZxrvE","why":"شرح عربي لأفعال المساعدة être/avoir في الماضي — يزيل أشهر حيرة عند العرب.","cat":"Grammar","level":"A1","main":true},{"title":"Le Passé Composé - Cours Complet en Français","channel":"Parlez-vous FRENCH : Cours de français","videoId":"yrL2nPF83no","why":"الدورة الكاملة للماضي المركب من Parlez-vous French — المرجع الأشمل المنظم.","cat":"Grammar","level":"A1","extra":true},{"title":"😉 50 VERBES irréguliers les plus utilisés en français","channel":"Guillaume Posé - Professeur de français","videoId":"fCPur-76iPw","why":"غويوم بوزيه في قائمة أهم 50 فعلاً شاذًا مع تصريفاتها — مادة حفظ منظمة.","cat":"Grammar","level":"A1","extra":true},{"title":"شرح زمن الماضي المركب في اللغة الفرنسية Le passé composé","channel":"فرنشاوي Frenchawy","videoId":"fY3rInMbC7g","why":"شرح عربي شامل للماضي المركب مع avoir/être والتكوين — الأنسب كأساسي للدرس.","cat":"Grammar","dur":17,"level":"A1","extra":true},{"title":"Grammaire — le passé composé — الماضي المركب","channel":"Sylingo — سيلينغو","videoId":"GPX45ED4Z54","why":"عرض أكاديمي منظم بالجدول والتفرعات — مراجعة تثبيتية بعد الشرح.","cat":"Grammar","dur":19,"level":"A1","extra":true}],"supplements":[{"id":"yrL2nPF83no","title":"Le Passé Composé - Cours Complet en Français","channel":"Parlez-vous FRENCH : Cours de français","why":"الدورة الكاملة للماضي المركب من Parlez-vous French — المرجع الأشمل المنظم.","lang":"fr"},{"id":"fCPur-76iPw","title":"😉 50 VERBES irréguliers les plus utilisés en français","channel":"Guillaume Posé - Professeur de français","why":"غويوم بوزيه في قائمة أهم 50 فعلاً شاذًا مع تصريفاتها — مادة حفظ منظمة.","lang":"fr"},{"id":"fY3rInMbC7g","title":"شرح زمن الماضي المركب في اللغة الفرنسية Le passé composé","channel":"فرنشاوي Frenchawy","why":"شرح عربي شامل للماضي المركب مع avoir/être والتكوين — الأنسب كأساسي للدرس.","dur":17,"lang":"ar"},{"id":"GPX45ED4Z54","title":"Grammaire — le passé composé — الماضي المركب","channel":"Sylingo — سيلينغو","why":"عرض أكاديمي منظم بالجدول والتفرعات — مراجعة تثبيتية بعد الشرح.","dur":19,"lang":"ar"}]}]},{"id":"a1-t15","slug":"au-restaurant","icon":"book","color":"#059669","fr":"Au restaurant","ar":"في المطعم","desc":"اطلب طعامك بالفرنسية: من القائمة إلى الفاتورة.","lessons":[{"id":"A1-t15-l1","fr":"Je voudrais un café, s'il vous plaît","ar":"أريد قهوة من فضلك","objectives":["طلب وجبة كاملة بلطف عبر صيغ désirer/je voudrais","التفريق بين entrée و plat و dessert","التعبير عن حساسية غذائية أو نظام غذائي","التعامل مع الحساب والدفع بأدب"],"sections":[{"h":"الصيغة المهذبة الذهبية","p":["المطعم موقف اجتماعي كامل: تحيّة، طلب، استفسار، حساب، شكراً. الفيديو الأساسي بالشرح العربي يقدّم الموقف كاملاً بأصوات نادل وزبون — استمع له مرتين: مرة للمعنى ومرة للكشف عن أسلوب النبرة المهذّب.","طلب الطعام يبدأ بأدب: Je voudrais... (أودّ...) هو الأفضل دائمًا، و Je prends... (آخذ...) مقبول في الحالات العادية. تجنّب الجملة الجافة «J'ai un steak» دون أدب في البداية.","مفردات الطعام المفتاحية تُحفظ مزدوجة بالصيغة المعدودة: une soupe (شوربة)، un plat (طبق رئيسي)، un dessert (حلوى)، un verre de... (كوب من...)، une bouteille de... (زجاجة من...).","الاستفسارات الشائعة: Qu'est-ce que vous recommandez ? (ماذا تنصح؟)، C'est combien ? (بكم؟)، L'addition s'il vous plaît (الحساب من فضلك). احفظها كحزم ثلاثية لا كأفعال منفصلة.","الحساسية الغذائية موقف أمان: Je suis allergique aux fruits de mer (أنا حساس لبقاع البحر)، Je ne mange pas de viande (لا آكل لحومًا)، Je suis végétarien (نباتي). نفي الملكية يأتي مع de: pas de.","بعد الطلب يأتي الدفع: تُدفع البطاقة أو النقد في نهاية الوجبة، والشكر يُقال بصوت مسموع: Merci, c'était délicieux ! (شكرًا، كان لذيذًا!). خروجك من المطعم هو آخر انطباع تتركه."],"video":{"id":"ZjGEuofvtFc","title":"Au restaurant في المطعم، شرح المصطلحات والعبارات، النطق + نشاط 2 صفحة 90، نشاط 24 صفحة…","channel":"الأستاذة سلمى الطاهر لغة فرنسية","why":"شرح عربي لمصطلحات القائمة والعبارات مع نشاط تدريبي في النهاية.","lang":"ar","main":true},"sub":[{"h":"مفردات الوجبة الثلاثية","p":["entrée — المقبل: Une salade en entrée.","plat — الطبق الرئيسي: Du poisson en plat.","dessert — الحلوى: Un fromage, puis un dessert.","المشروبات: eau, vin, café, jus d'orange."]},{"h":"عبارات الطلب المهذّبة","p":["Je voudrais un café, s'il vous plaît.","Vous avez une table pour deux ?","Qu'est-ce que vous conseillez ?","Je prends le menu du jour."]},{"h":"الحساسية والنظام الغذائي","p":["Je suis allergique à... — حساسية من: noix, fruits de mer, gluten.","Je ne mange pas de... — لا آكل: viande, porc, fromage.","Je suis végétarien/vegan — نظام نباتي.","Est-ce qu'il y a des plats végétariens ?"]}]},{"h":"مفردات القائمة","p":["الأطباق: le poulet (دجاج)، le poisson (سمك)، la viande (لحم)، le riz (أرز)، les légumes (خضراوات)، la salade، le fromage (جبن)، le pain (خبز)، la soupe (حساء).","الشراب: l'eau (ماء) — eau gazeuse أو eau plate، le jus d'orange، le thé، le lait (حليب)، un café.","الحلوى: le dessert، une glace (آيس كريم)، le gâteau (كيك)، les fruits.","سلوك الطاولة يأتي في الفيديو الإثرائي: طريقة الجلوس، ترتيب الكحاتي، متى تتكلم مع النادل — لغة الصورة تكمل لغة الكلمات."]},{"h":"في نهاية الوجبة","p":["لتطلب الفاتورة: L'addition, s'il vous plaît (الفاتورة من فضلك). وللتعليق: C'était délicieux ! (كان لذيذاً!).","ملاحظة ثقافية: في فرنسا لا تعلق اللباقة بالبقشيش (pourboire) فهو اختياري — وغالباً يُترك تقريباً 5-10%.","تجربة المحاكاة: اكتب سيناريو مطعم كامل في ست جمل — تحيّة، طلب، استفسار، استفسار عن الحساسية، الحساب، شكر. اقرأه بصوت مسموع مرتين."]},{"h":"التطبيق والتلخيص","p":["تستخلص هذه الخلاصة مفردات الموقف وأدبَه معًا: ترتيب الوجبة بثلاث مراحل (entrée ثم plat ثم dessert) والمعدود المحفوظ مع كل طبق (une soupe، un plat، un dessert، un verre de...)، وصيغة الطلب الأرقى Je voudrais مقابل الصيغة المقبول Je prends، وقاعدة نفي الملكية التي تفرض de بعد pas (Je ne mange pas de viande)، والحالة الصحية المنسوبة إلى être لا avoir (Je suis allergique aux...)، ثم خاتمة الموقف بطلب الحساب والشكر (L'addition, s'il vous plaît — C'était délicieux !). كما وضح الفيديو الرئيسي «Au restaurant في المطعم، شرح المصطلحات والعبارات، النطق + نشاط 2 صفحة 90، نشاط 24 صفحة…» من قناة «الأستاذة سلمى الطاهر لغة فرنسية» على الرابط https://www.youtube.com/watch?v=ZjGEuofvtFc، يُقدَّم الموقف كاملاً بأصوات نادل وزبون فتُسمع النبرة المهذّبة في je voudrais وموضع s'il vous plaît من الجملة لا مجرد معناها.","«راجع الضمائر a1-t4 والنفي a1-t9 وأسئلة a1-t10 قبل طلب طعام كامل»: فلا يكتمل الطلب بلا ضمير معرَّف في جملة الفاعل (je)، ولا تتحقق اللباقة بلا نفي صحيح مصحوب بـ de (ne...pas de)، ولا يفتح استفسارك عن القائمة أو السعر أو الطاولة بلا سؤال est-ce que. وهي ثلاث حزم موروثة من تلك الدروس تستدعيها هنا دفعة واحدة في موقف واحد، ولذلك تُراجَع قبل أن تُمثَّل الحوار لا بعده.","أعد مشاهدة الفيديو الرئيسي مرتين: مرة للمعنى ومرة لنبرة الصوت، ثم سجّل نفسك وأنت تؤدّي مشهد مطعم كامل في ست جمل: التحية، وطلب طاولة، وطلب مهذّب بـ je voudrais، وسؤال est-ce que عن الطبق المناسب، واعتذار عن حساسية بنفي الملكية مع de، ثم طلب الحساب؛ وبعد التسجيل قارن نبرتك بنبرة النادل في الفيديو وأعد التسجيل عند أي جملة بدت جافة أو مرتجلة."]}],"examples":[{"fr":"Une table pour deux, s'il vous plaît.","ar":"طاولة لشخصين من فضلك."},{"fr":"La carte, s'il vous plaît ?","ar":"القائمة من فضلك؟"},{"fr":"Qu'est-ce que vous recommandez ?","ar":"ماذا تنصحون؟"},{"fr":"C'était excellent, merci !","ar":"كان ممتازاً شكراً!"},{"fr":"Je voudrais un poulet frit, s'il vous plaît.","ar":"أودّ دجاج مقلي من فضلك.","note":"طلب مهذّب"},{"fr":"Vous avez une table libre ?","ar":"هل لديكم طاولة شاغرة؟","note":"الدخول"},{"fr":"Je suis allergique aux crevettes.","ar":"أنا حساس للروبيان.","note":"حساسية"},{"fr":"L'addition, s'il vous plaît.","ar":"الحساب من فضلك.","note":"الختام"}],"pron":[{"w":"Je voudrais","ipa":"[ʒə.vu.dʁɛ]","approx":"جو-فودريه"},{"w":"s'il vous plaît","ipa":"[sil.vu.plɛ]","approx":"سيل-فو-بليه"},{"w":"l'addition","ipa":"[la.di.sjɔ̃]","approx":"لاديسيون"}],"vocab":[{"fr":"je voudrais","ar":"أريد (مهذباً)","pos":"expression","ipa":"[ʒə.vu.dʁɛ]","exFr":"Je voudrais un thé.","exAr":"أريد شاي."},{"fr":"le poulet","ar":"الدجاج","pos":"nom","g":"m","ipa":"[pu.lɛ]","exFr":"Le poulet est bon.","exAr":"الدجاج لذيذ."},{"fr":"le poisson","ar":"السمك","pos":"nom","g":"m","pl":"des poissons","ipa":"[pwa.sɔ̃]"},{"fr":"l'eau","ar":"الماء","pos":"nom","g":"f","ipa":"[o]","exFr":"Une carafe d'eau.","exAr":"إبريق ماء."},{"fr":"l'addition","ar":"الفاتورة","pos":"nom","g":"f","pl":"les additions","ipa":"[la.di.sjɔ̃]","exFr":"L'addition, s'il vous plaît.","exAr":"الفاتورة من فضلك."},{"fr":"délicieux / délicieuse","ar":"لذيذ / لذيذة","pos":"adj","g":"mf","ipa":"[de.li.sjø / de.li.sjøz]","exFr":"Ce plat est délicieux !","exAr":"هذا الطبق لذيذ!"},{"fr":"un menu","ar":"قائمة الطعام","pos":"nom","g":"m","exFr":"Le menu du jour, s'il vous plaît.","ipa":"[məny]","exAr":"قائمة اليوم من فضلك."},{"fr":"une entrée","ar":"مقبل/مُقدَّم","pos":"nom","g":"f","exFr":"Une soupe en entrée.","ipa":"[ɑ̃tʁe]","exAr":"شوربة كمقبل."},{"fr":"un plat","ar":"طبق رئيسي","pos":"nom","g":"m","exFr":"Un plat de viande.","ipa":"[plɑ]","exAr":"طبق لحم."},{"fr":"un dessert","ar":"حلوى","pos":"nom","g":"m","exFr":"Quel dessert proposez-vous ?","ipa":"[dɛsɛʁ]","exAr":"أي حلوى تقترح؟"},{"fr":"allergique","ar":"حساس","pos":"adj","exFr":"Je suis allergique aux noix.","ipa":"[alɛʁʒik]","exAr":"أنا حساس للمكسرات."},{"fr":"délicieux","ar":"لذيذ","pos":"adj","exFr":"C'est délicieux !","ipa":"[delisjø]","exAr":"إنه لذيذ!"},{"fr":"réserver","ar":"يحجز","pos":"verbe","g":"1er","exFr":"Je voudrais réserver une table.","ipa":"[ʁezɛʁve]","exAr":"أودّ حجز طاولة."}],"grammar":[{"tFr":"Exprimer le désir et la politesse","tAr":"القاعدة: أدب الطلب","body":["je voudrais (subjonctif مهذّب) بدل je veux مباشرة — القاعدة اللفظية نفسها لكن النبرة مهذّبة.","المعدود يحدد الأداة: un plat, une soupe, une assiette de... — حفظ المعدود مع الكلمة جزء منها."],"ex":[{"fr":"Je voudrais une assiette de riz.","ar":"أودّ طبق أرز."},{"fr":"Vous voulez du vin ?","ar":"هل تريد نبيذاً؟"}]}],"mistakes":[{"wrong":"Je veux un café (بارد)","right":"Je voudrais un café","why":"je veux مباشر يبدو جافًا مع الغرباء؛ je voudrais هو المهذّب."},{"wrong":"Je ne mange pas viande","right":"Je ne mange pas de viande","why":"بعد نفي الملكية تأتي de."},{"wrong":"J'ai allergique","right":"Je suis allergique","why":"allergique صفة مرتبطة بـ être لا avoir."},{"wrong":"L'addition combien ?","right":"L'addition, s'il vous plaît.","why":"سؤال السعر يكون C'est combien ? وليس بعد لفظ الفاتورة مباشرة."}],"dialogues":[{"title":"عشاء في مطعم","ctx":"زبونان يطلبان العشاء","lines":[{"who":"Serveuse","fr":"Bonsoir ! Vous avez une réservation ?","ar":"مساء الخير! هل لديكم حجز؟"},{"who":"Hicham","fr":"Non, une table pour deux, s'il vous plaît.","ar":"لا، طاولة لشخصين من فضلك."},{"who":"Serveuse","fr":"Voici le menu. Vous voulez commander ?","ar":"تفضلوا القائمة. تريدان أن تطلبا؟"},{"who":"Salma","fr":"Je voudrais le poulet et une salade.","ar":"أودّ الدجاج وسلطة."},{"who":"Hicham","fr":"Moi, je prends le poisson. Et de l'eau gazeuse.","ar":"وأنا آخذ السمك. وماءً غازيًا."},{"who":"Serveuse","fr":"Très bien, je vous apporte ça.","ar":"حسناً، أحضر لكما ذلك."}]}],"exercises":[{"t":"mcq","skill":"grammar","q":"أكثر صيغة مهذبة للطلب:","opts":["Je veux un café","Donne-moi un café","Je voudrais un café","Café !"],"a":2,"why":"Je voudrais هي الصيغة المهذبة القياسية."},{"t":"translate","skill":"writing","q":"ترجم: «الفاتورة من فضلك.»","ans":"L'addition, s'il vous plaît.","alts":["l addition sil vous plait","l'addition s'il vous plaît"],"why":"طلب الفاتورة يبدأ باسمها l'addition ثم تُغلق الجملة بعبارة اللباقة s'il vous plaît."},{"t":"mcq","skill":"vocabulary","q":"ما معنى «le pain»؟","opts":["اللحم","الخبز","السمك","الحليب"],"a":1,"why":"le pain هو الخبز، بينما le poisson سمك و la viande لحم و le lait حليب."},{"t":"listen","skill":"listening","q":"استمع للطلب واختره:","audio":"Je voudrais un sandwich au poulet","opts":["ساندويج دجاج","سلطة خضراء","سمك مشوي","حساء الخضراوات"],"a":0,"why":"الطلب يبدأ بصيغة je voudrais المهذّبة، و au poulet أي بالدجاج داخل الساندويج."},{"t":"order","skill":"grammar","q":"رتّب الطلب المهذب:","words":["Je","voudrais","un","café","s'il","vous","plaît"],"ans":"Je voudrais un café s'il vous plaît","why":"الضمير Je ثم الصيغة المهذبة voudrais ثم un café، وتُسدَّد الجملة بـ s'il vous plaît."},{"t":"speaking","skill":"speaking","q":"اطلب مهذباً: «أريد شاي من فضلك».","target":"Je voudrais un thé, s'il vous plaît","why":"je voudrais هي الصيغة المهذبة، و يأتي بعدها un ثم المعدود thé، وتُغلق بعبارة اللباقة."},{"t":"mcq","skill":"vocabulary","q":"ما الطبق المناسب: «___ en entrée»؟","opts":["Une soupe","Un dessert","Le café","L'addition"],"a":0,"why":"المقبل يسبق الطبق الرئيسي."},{"t":"fill","skill":"writing","q":"اطلب القهوة بأدب: «Je ___ un café, s'il vous plaît.»","fr":"Je ___ un café, s'il vous plaît.","ans":"voudrais","why":"je voudrais الصيغ المهذبة."}],"homework":"اكتب حوار مطعم من 6 أسطر بينك وبين جرسون: الطلب، السؤال عن السعر، والفاتورة. الدرس السابق: a1-t14 (الماضي المركب) — استعد أفعال être وتصريفات التصريف الثاني فستروي بها تجربة المطعم ماضية. الدرس التالي: a1-t16 (التسوق) — احفظ مفردات الطعام والشراب والمعدودات فستستعملها مع الأسعار والعملة.","sources":[{"title":"Au restaurant في المطعم، شرح المصطلحات والعبارات، النطق + نشاط 2 صفحة 90، نشاط 24 صفحة…","channel":"الأستاذة سلمى الطاهر لغة فرنسية","videoId":"ZjGEuofvtFc","why":"شرح عربي لمصطلحات القائمة والعبارات مع نشاط تدريبي في النهاية.","cat":"Conversation","level":"A1","main":true},{"title":"French Lesson 75 - Ordering food at the restaurant How to order food in French Dialogue…","channel":"YouLearnFrench","videoId":"AfGjmmkLQM0","why":"درس YouLearnFrench للطلب في المطعم بجمل je voudrais المهذبة جاهزة التطبيق.","cat":"Conversation","level":"A1","extra":true},{"title":"DIALOGUE EN FRANÇAIS : Au Restaurant | Exercice de Compréhension Orale en Français","channel":"Français avec Pierre","videoId":"DRmqLuTem1c","why":"حوار مطعم كامل من بيير مع تمرين فهم مسموع — يغلق المحور بمحادثة حية.","cat":"Conversation","level":"A1","extra":true},{"title":"حوار في المطعم Au restaurant — مستوى DELF A1 مترجم","channel":"تكلم FRENCH","videoId":"exRM0qb_QWw","why":"حوار كامل مترجم بمستوى A1 الرسمي — بالضبط سياق درس المطعم.","cat":"Conversation","dur":12,"level":"A1","extra":true},{"title":"حوار فرنسي أصلي مترجم — في المطعم Au restaurant","channel":"عربي بلسان فرنسي","videoId":"cIOSxcNd144","why":"حوار قصير بطبيعة يومية مع ترجمة — تدريب استماع سريع.","cat":"Conversation","dur":6,"level":"A1","extra":true}],"supplements":[{"id":"AfGjmmkLQM0","title":"French Lesson 75 - Ordering food at the restaurant How to order food in French Dialogue…","channel":"YouLearnFrench","why":"درس YouLearnFrench للطلب في المطعم بجمل je voudrais المهذبة جاهزة التطبيق.","lang":"fr"},{"id":"DRmqLuTem1c","title":"DIALOGUE EN FRANÇAIS : Au Restaurant | Exercice de Compréhension Orale en Français","channel":"Français avec Pierre","why":"حوار مطعم كامل من بيير مع تمرين فهم مسموع — يغلق المحور بمحادثة حية.","lang":"fr"},{"id":"exRM0qb_QWw","title":"حوار في المطعم Au restaurant — مستوى DELF A1 مترجم","channel":"تكلم FRENCH","why":"حوار كامل مترجم بمستوى A1 الرسمي — بالضبط سياق درس المطعم.","dur":12,"lang":"ar"},{"id":"cIOSxcNd144","title":"حوار فرنسي أصلي مترجم — في المطعم Au restaurant","channel":"عربي بلسان فرنسي","why":"حوار قصير بطبيعة يومية مع ترجمة — تدريب استماع سريع.","dur":6,"lang":"ar"}]}]},{"id":"a1-t16","slug":"faire-des-achats","icon":"headphones","color":"#059669","fr":"Faire des achats","ar":"التسوق","desc":"في السوق والمتجر: الأسعار، المقاسات، والدفع.","lessons":[{"id":"A1-t16-l1","fr":"Combien ça coûte ?","ar":"بكم هذا؟","objectives":["السؤال عن السعر والمقاس والتوفر","التعبير عن الرغبة في الشراء عبر vouloir/préférer","التفاوض البسيط والدفع في المتجر","استخدام lequel / laquelle للاختيار بين بديلين"],"sections":[{"h":"الأسعار","p":["التسوق موقف يومي يعيد نفسه في السوق والمتجر والصيدلية. الفيديو الأساسي بالشرح العربي يعرض حوارًا كاملًا بين زبون وبائع — ركّز على نبرة السؤال القصيرة: C'est combien ? و Vous l'avez en bleu ?","الألوان والمقاسات من أوّل ما يحتاجه المسافر أو المقيم: en bleu (باللون الأزرق)، en taille M (بالمقاس M)، en stock (متوفر)، épuisé (نفد). حفظها كعبارات جاهزة يختصر الموقف كله.","الرغبة تُعبَّر بأربعة مستويات: Je cherche... (أبحث عن...)، Je voudrais... (أودّ...)، Je préfère... (أفضّل...)، Je prends... (آخذها). اختر المستوى حسب ثقتك وأدائك.","الاختيار بين بديلين يستخدم lequel/laquelle: Lequel préférez-vous ? (أيهما تفضّل؟)، Laquelle (للمؤنث). مع لفظ الجر تصبح duquel/de laquelle: C'est lequel des deux ?","الدفع والسؤال عن السعر: Ça coûte combien ? (بكم؟)، C'est trop cher (غالي جدًا)، Vous acceptez la carte ? (هل تقبلون البطاقة؟). الأسعار تُقرأ بالأرقام والعملة: euros، dirhams.","المكانة الثقافية: في السوق العربي أو الفرنسيي (souk / marché) يمكن السؤال عن الخصم بـ Est-ce que vous faites un prix ? — صيغة أدبية لكنها مفيدة. في المتاجر الكبرى لا تُستخدم، بل السعر مكتوب وثابت."],"video":{"id":"v5Fplxo3P6c","title":"تعلم اللغة الفرنسية من الصفر للمبتدئين: التسوق / كلمات ومحادثة Le shopping en France","channel":"تكلم FRENCH","why":"شرح عربي للتسوق بكلماته ومحادثته من قناة تكلم — مطابق لجمهورنا.","lang":"ar","main":true},"sub":[{"h":"عبارات السؤال الأساسية","p":["C'est combien ? — بكم؟","Vous l'avez en autre taille/couleur ? — هل لديك مقاس/لون آخر؟","Est-ce que c'est en stock ? — هل هو متوفر؟","Je peux essayer ? — هل يمكنني القياس؟"]},{"h":"الألوان والصفات في الشراء","p":["en + لون: en noir, en rouge, en bleu.","أصفة المنتج: petit, grand, cher, bon marché (رخيص).","المقاسات: S, M, L — ou petit/moyen/grand."]},{"h":"المستويات الأربعة للرغبة","p":["Je cherche un cadeau. — أبحث عن هدية.","Je voudrais ces chaussures. — أودّ هذه الحذاء.","Je préfère le modèle bleu. — أفضل الطراز الأزرق.","Je prends celui-ci. — آخذ هذا."]}]},{"h":"الطلب في المتجر","p":["لشراء: Je voudrais ce t-shirt en taille M, s'il vous plaît (أريد هذا التيشيرت مقاس M). وللسؤال عن المقاس: Vous avez une taille plus grande ? (هل عندكم مقاس أكبر؟).","وفي المحاولة: Je peux l'essayer ? (هل يمكنني تجربته؟) وla cabine d'essayage (غرفة القياس).","لقطة الإشارة مهمة: celui-ci (هذا) وcelle-là (تلك) تحل محل الاسم لتفادي تكراره — في التسوق تُستخدم كل دقيقة."]},{"h":"الدفع","p":["للدفع: Je peux payer par carte ? (أستطيع الدفع بالبطاقة؟) أو en espèces (نقداً). ولطلب الفاتورة: Un reçu, s'il vous plaît (إيصال من فضلك).","ملاحظة: نقول payer par carte (بالبطاقة) و payer en espèces (نقداً) — حروف مختلفة لكل طريقة.","الفيديو الإثرائي يعرض مقاسات فعلية وأسعارًا؛ أوقفه وردّد الأرقام والعملة بصوت مسموع — القراءة العجلة في الأسعار مهارة مستقلة."]},{"h":"التطبيق والتلخيص","p":["يُختم هذا الدرس محور التسوق بمنظومة واحدة متكاملة من الوظائف اليومية: فسؤال السعر يتحوّل إلى ثلاث صيغ شائعة (C'est combien ? / Ça coûte combien ? / Quel est le prix ?)، والرغبة في الشراء تتدرّج من Je cherche إلى Je prends عبر أربعة مستويات (cherche، voudrais، préfère، prends)، والاختيار بين بديلَين يردّد أدوات lequel / laquelle، بينما تضبط الألوان والمقاسات والتوفر (en bleu، en taille M، en stock، épuisé) تفاصيل الطلب، ويُغلق الموقف الدفع بصيغتَي payer par carte و payer en espèces. كما وضح الفيديو الرئيسي «تعلم اللغة الفرنسية من الصفر للمبتدئين: التسوق / كلمات ومحادثة Le shopping en France» حوار الزبون والبائع كاملًا من السؤال عن السعر والمقاس حتى القياس والدفع، يمنح هذا الدرس الطالب المفردات والقواعد اللازمة لإقامته بنفسه في أي متجر أو سوق.","يستمد هذا الدرس قوّته من وحدات المستوى السابقة: فصفات a1-t8 (cher، bon marché، grand، petit) هي أداة تقييم السعر الأساسية، ونفي a1-t9 (ne...pas / ne...plus) يمنح جملة الاعتراض صيغتها الصحيحة (Ce n'est pas cher / Je n'ai plus de taille M)؛ وبذلك تفيدك صفة a1-t8 مع نفي a1-t9 حرفًا بحرف عند السعر في كل موقف شراء. وبعد إتقان الموقف تنتقل السلسلة إلى a1-t7 الذي يفتح جمع الأسماء والصفات (les robes، les cadeaux، les taille grandes) فتتعدّد مشترياتك في جملة واحدة بدل تكرار المفرد.","المهمة التطبيقية: أعد مشاهدة الفيديو الرئيسي كاملًا، وأوقفه بعد كل عبارة وردّدها بصوت مسموع بنبرة الزبون؛ ثم ادخل متجرًا حقيقيًا أو تصفّح متجرًا إلكترونيًا واختر ثلاثة أصناف، وسجّل نفسك وأنت تسأل عن سعر كل صنف ومقاسه وتصرّح بأخذ أحدها (Je prends...)، مع جملة اعتراض واحدة بصيغة النفي من a1-t9 (Ce n'est pas cher)، ثم استمع للتسجيل وقارنه بنطق البائع في الفيديو."]}],"examples":[{"fr":"Combien coûte ce stylo ?","ar":"بكم هذا القلم؟"},{"fr":"Ça fait 12 euros.","ar":"المجموع 12 يورو."},{"fr":"Vous avez une taille plus grande ?","ar":"هل عندكم مقاس أكبر؟"},{"fr":"Je peux payer par carte ?","ar":"أستطيع الدفع بالبطاقة؟"},{"fr":"Excusez-moi, c'est combien ce t-shirt ?","ar":"عفواً، بكم هذا التي شيرت؟","note":"سؤال السعر"},{"fr":"Je voudrais une bourse noire.","ar":"أودّ حقيبة سوداء.","note":"vouloir + معدود"},{"fr":"Lequel préférez-vous ?","ar":"أيهما تفضّل؟","note":"اختيار"},{"fr":"Je peux payer par carte ?","ar":"هل يمكنني الدفع بالبطاقة؟","note":"الدفع"}],"pron":[{"w":"combien ça coûte","ipa":"[kɔ̃.bjɛ̃ sa.kut]","approx":"كونبيان-سا-كوت"},{"w":"essayer","ipa":"[ɛ.sɛ.je]","approx":"إيسييه"},{"w":"en espèces","ipa":"[ɑ̃.n‿ɛs.pɛs]","approx":"آن-إيسبيس"}],"vocab":[{"fr":"coûter","ar":"يكلف","pos":"verbe","ipa":"[ku.te]","exFr":"Ça coûte cher.","exAr":"يكلف كثيراً."},{"fr":"cher / chère","ar":"غالي / غالية","pos":"adj","g":"mf","ipa":"[ʃɛʁ]","exFr":"C'est trop cher !","exAr":"غالي جداً!"},{"fr":"la taille","ar":"المقاس","pos":"nom","g":"f","pl":"les tailles","ipa":"[taj]","exFr":"Quelle est votre taille ?","exAr":"ما مقاسك؟"},{"fr":"payer","ar":"يدفع","pos":"verbe","ipa":"[pe.je]","exFr":"Je paie par carte.","exAr":"أدفع بالبطاقة."},{"fr":"un euro","ar":"يورو","pos":"nom","g":"m","pl":"des euros","ipa":"[ø.ʁo]"},{"fr":"un reçu","ar":"إيصال","pos":"nom","g":"m","pl":"des reçus","ipa":"[ʁə.sy]","exFr":"Un reçu, s'il vous plaît.","exAr":"إيصال من فضلك."},{"fr":"le prix","ar":"السعر","pos":"nom","g":"m","exFr":"Quel est le prix ?","ipa":"[pʁi]","exAr":"ما السعر؟"},{"fr":"en stock","ar":"متوفر","pos":"locution","exFr":"Il n'est plus en stock.","ipa":"[ɑ̃ stɔk]","exAr":"لم يعد متوفرًا."},{"fr":"épuisé","ar":"نفد/نفذ","pos":"adj","exFr":"Le rouge est épuisé.","ipa":"[epɥize]","exAr":"الأحمر نفد."},{"fr":"cher / pas cher","ar":"غالي / رخيص","pos":"adj","exFr":"Ce sac est trop cher.","ipa":"[ʃɛʁ]","exAr":"هذه الحقيبة غالية جداً."},{"fr":"essayer","ar":"يجرب/يقيس","pos":"verbe","g":"1er","exFr":"Je peux essayer ?","ipa":"[eseje]","exAr":"هل يمكنني القياس؟"},{"fr":"celui-ci / celle-là","ar":"هذا / تلك","pos":"pron","exFr":"Je prends celui-ci.","ipa":"[sɥi.si]","exAr":"آخذ هذا."},{"fr":"un cadeau","ar":"هدية","pos":"nom","g":"m","exFr":"C'est un cadeau.","ipa":"[kado]","exAr":"إنها هدية."},{"fr":"préférer","ar":"يفضّل","pos":"verbe","g":"1er","exFr":"Je préfère le bleu.","ipa":"[pʁefeʁe]","exAr":"أفضل الأزرق."}],"grammar":[{"tFr":"Le choix : lequel / laquelle","tAr":"القاعدة: أدوات الاختيار","body":["lequel (مذكر) / laquelle (مؤنث) / lesquels (جمع) تعني «أيهما» وتغني عن تكرار الاسم.","مع لفظ الجر: duquel, de laquelle, auquel, à laquelle."],"ex":[{"fr":"Laquelle tu préfères ?","ar":"أيّة واحدة تفضل؟"},{"fr":"C'est la robe dont je parle.","ar":"إنها الفستان الذي أتحدث عنه."}]}],"mistakes":[{"wrong":"Combien est le prix ?","right":"C'est combien ? / Quel est le prix ?","why":"السؤال عن السعر له صيغتان شائعتان، والصفة لا تأتي بعد est مباشرة هكذا."},{"wrong":"Je veux veste (بلا أداة)","right":"Je veux une veste","why":"المعدود يلزم الأداة في الجملة الاسمية."},{"wrong":"Je peux l'essayer (مع le)","right":"Je peux essayer","why":"essayer يتعدى بنفسه هنا؛ إضافة le اختيارية مع le vêtement المضمر."},{"wrong":"Lequel vous préférez ? (بدون vouloir)","right":"Lequel préférez-vous ?","why":"ترتيب السؤال بقلاب الفعل: Lequel + verbe + pronom."}],"dialogues":[{"title":"شراء قميص","ctx":"زبون في محل ملابس","lines":[{"who":"Vendeur","fr":"Bonjour, je peux vous aider ?","ar":"مرحباً، هل يمكنني مساعدتك؟"},{"who":"Imane","fr":"Oui, je cherche un chemisier.","ar":"نعم، أبحث عن قميص."},{"who":"Vendeur","fr":"Quelle couleur préférez-vous ?","ar":"أي لون تفضلين؟"},{"who":"Imane","fr":"Le bleu, en taille S. C'est combien ?","ar":"الأزرق، بالمقاس S. بكم؟"},{"who":"Vendeur","fr":"Cinquante euros. Vous voulez l'essayer ?","ar":"خمسون يورو. هل تريدين قياسه؟"},{"who":"Imane","fr":"Oui, merci. Et vous acceptez la carte ?","ar":"نعم، شكراً. وهل تقبلون البطاقة؟"}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"«بكم هذا؟» بالفرنسية:","opts":["Où ça ?","Combien ça coûte ?","Qui ça ?","Quand ça ?"],"a":1,"why":"التمرين يثبّت مفردات التسوّق: السعر واللون والمقاس — أساس أي حوار في المتجر."},{"t":"fill","skill":"vocabulary","q":"أكمل: «C'est trop ___ !» (غالي)","fr":"C'est trop ___.","ans":"cher","why":"cher = غالي."},{"t":"translate","skill":"writing","q":"ترجم: «المجموع 15 يورو.»","ans":"Ça fait 15 euros.","alts":["ca fait quinze euros","ça fait quinze euros"],"why":"الترجمة تربط الصفة بالسعر: كيف تسأل وتردّ بالفرنسية كما في الفيديو."},{"t":"listen","skill":"listening","q":"استمع لسؤال البائع واختره:","audio":"Vous avez une taille plus petite ?","opts":["هل عندكم مقاس أصغر؟","هل عندكم مقاس أكبر؟","هل تريد تجربته؟","هل تدفع بالبطاقة؟"],"a":0,"why":"الاستماع يحاكي الحوار الحقيقي في المتجر: تعرّف على العبارة وسياقها."},{"t":"mcq","skill":"grammar","q":"«أدفع بالبطاقة» بالفرنسية:","opts":["Je paie en carte","Je paie par carte","Je paie avec carte","Je paie sur carte"],"a":1,"why":"تُستخدم par مع البطاقة."},{"t":"speaking","skill":"speaking","q":"اسأل عن السعر مهذباً.","target":"Excusez-moi, combien ça coûte ?","why":"التحدث المحاكى يبني طلاقة Je voudrais وهي صيغة الطلب الأساسية."},{"t":"mcq","skill":"vocabulary","q":"سؤال السعر الصحيح؟","opts":["C'est combien ?","Quel âge ?","Comment allez-vous ?","Où est-ce ?"],"a":0,"why":"C'est combien = بكم؟"},{"t":"order","skill":"grammar","q":"رتّب: «أفضل اللون الأزرق»","words":["Je","préfère","la","couleur","bleue"],"ans":"Je préfère la couleur bleue","why":"ترتيب الكلمات يثبّت تركيب الجملة: أداة + اسم + صفة كما في الشرح."}],"homework":"اكتب حوار تسوق من 8 أسطر: سؤال عن السعر، المقاس، التجربة، والدفع. الدرس السابق/التالي: a1-t15 (Je voudrais un café — المطعم) ← a1-t16 (Combien ça coûte ? — التسوق) → a1-t17 (Chez moi — المنزل).","sources":[{"title":"تعلم اللغة الفرنسية من الصفر للمبتدئين: التسوق / كلمات ومحادثة Le shopping en France","channel":"تكلم FRENCH","videoId":"v5Fplxo3P6c","why":"شرح عربي للتسوق بكلماته ومحادثته من قناة تكلم — مطابق لجمهورنا.","cat":"Conversation","level":"A1","main":true},{"title":"How to Ask How Much It Costs in French: Paying at Shops Beginner Phrases","channel":"French Speak","videoId":"uK0UL-TnCLg","why":"جمل السؤال عن السعر والدفع من French Speak — مختصرة وجاهزة للاستعمال.","cat":"Conversation","level":"A1","extra":true},{"title":"Dialogue dans un magasin de vêtements. Niveau A1. SANS FOND MUSICAL 👉 https://youtu.be…","channel":"La prof Elisabeth","videoId":"IKSzhRBsLa4","why":"حوار أستاذة إليزابيث في محل ملابس بمستوى A1 — نموذج DELF واقعي.","cat":"Conversation","level":"A1","extra":true},{"title":"Faire les courses — التسوق بالفرنسية بسهولة للمبتدئين (A1)","channel":"الفرنسية مع Sarita","videoId":"4vALicKge3g","why":"عبارات التسوق الأساسية بمستوى A1 مع النطق الواضح — مكمّل مباشر للدرس.","cat":"Conversation","dur":6,"level":"A1","extra":true},{"title":"حوار فرنسي أصلي مترجم — في السوق Au marché","channel":"عربي بلسان فرنسي","videoId":"xnBGRSP3CiU","why":"حوار سوق حقيقي مترجم — تطبيق عملي على المفردات المتسوق بها.","cat":"Conversation","dur":5,"level":"A1","extra":true}],"supplements":[{"id":"uK0UL-TnCLg","title":"How to Ask How Much It Costs in French: Paying at Shops Beginner Phrases","channel":"French Speak","why":"جمل السؤال عن السعر والدفع من French Speak — مختصرة وجاهزة للاستعمال.","lang":"fr"},{"id":"IKSzhRBsLa4","title":"Dialogue dans un magasin de vêtements. Niveau A1. SANS FOND MUSICAL 👉 https://youtu.be…","channel":"La prof Elisabeth","why":"حوار أستاذة إليزابيث في محل ملابس بمستوى A1 — نموذج DELF واقعي.","lang":"fr"},{"id":"4vALicKge3g","title":"Faire les courses — التسوق بالفرنسية بسهولة للمبتدئين (A1)","channel":"الفرنسية مع Sarita","why":"عبارات التسوق الأساسية بمستوى A1 مع النطق الواضح — مكمّل مباشر للدرس.","dur":6,"lang":"ar"},{"id":"xnBGRSP3CiU","title":"حوار فرنسي أصلي مترجم — في السوق Au marché","channel":"عربي بلسان فرنسي","why":"حوار سوق حقيقي مترجم — تطبيق عملي على المفردات المتسوق بها.","dur":5,"lang":"ar"}]}]},{"id":"a1-t17","slug":"a-la-maison","icon":"pen","color":"#059669","fr":"À la maison","ar":"في المنزل","desc":"وصف منزلك: الغرف، الأثاث، والأنشطة المنزلية.","lessons":[{"id":"A1-t17-l1","fr":"Chez moi","ar":"في بيتي","objectives":["تسمية غرف المنزل والأثاث الأساسي بأدوات الجر الصحيحة","التعبير عن وجود شيء/عدمه عبر il y a و il n'y a pas","وصف المنزل: الدور، الموقع، الاتجاهات","التحدث عن حرفة الترتيب والتنقل داخل المنزل"],"sections":[{"h":"الغرف والأثاث","p":["المنزل هو المخزون اللغوي الأوسع في المستوى A1: كل غرفة وكل أثاث كلمة جديدة تُربط بموقعها الفعلي. الفيديو الأساسي بالشرح العربي يقودك جولة غرفة بغرفة — شاهده وأنت تشير إلى أثاث منزلك بنفسك.","il y a (يوجد) و il n'y a pas (لا يوجد) هما عمودا الوصف السكني: Il y a trois chambres. Il n'y a pas de jardin. لاحظ أن n'y a يأتي مع de بعد النفي (pas de).","أدوات الجر تتحدد حسب الكلمة لا المعنى: dans la cuisine (في المطبخ)، dans le salon (في الصالة)، à côté de la fenêtre (بجانب النافذة)، derrière la porte (خلف الباب)، devant (أمام)، sous (تحت)، sur (فوق).","وصف الشقة يأتي مع الأرقام والدور: au premier étage (في الطابق الأول)، ascenseur (مصعد)، au rez-de-chaussée (الطابق الأرضي). حفظها مطلوب للحديث السكني الشائع.","الوظائف اليومية للمنزل: je fais le ménage (أنظّف)، je range (أرتّب)، je répare (أصلح)، j'ouvre/je ferme (أفتح/أغلق). الأفعال المنتظمة تعود للقاعدة الأولى لكن بمعانٍ جديدة.","الاتجاهات تكمل الوصف: il est à gauche (على اليسار)، à droite (على اليمين)، au fond (في النهاية)، près de (قريب من)، loin de (بعيد عن). مع il y a تصبح جمل مكانية كاملة وجاهزة للتصريف."],"video":{"id":"3ST1iwbXpxk","title":"تعليم الفرنسية للمبتدئين #54 اجزاء و غرف المنزل و وصف المنزل Les pièces de la maison فر…","channel":"فرنشاوي Frenchawy","why":"شرح فرنشاوي لغرف المنزل ووصفه بالعربية — مكمل مثالي للمحور الأول.","lang":"ar","main":true},"sub":[{"h":"غرف المنزل","p":["la cuisine — المطبخ، le salon — الصالة، la chambre — الغرفة.","la salle de bain — الحمام، les toilettes — المرحاض.","le jardin — الحديقة، le balcon — الشرفة، le garage — المرآب."]},{"h":"الأثاث الأساسي","p":["le lit — السرير، la table — الطاولة، la chaise — الكرسي.","le canapé — الأريكة، l'armoire — الخزانة، le tapis — السجادة.","la lampe — المصباح، la fenêtre — النافذة، la porte — الباب."]},{"h":"il y a + الاتجاهات","p":["Il y a un lit dans la chambre.","Il n'y a pas de télévision.","Le canapé est à côté de la fenêtre.","La lampe est sous la table."]}]},{"h":"أنشطة المنزلية","p":["faire le ménage (تنظيف البيت)، faire la vaisselle (غسل الصحون)، faire la lessive (غسل الملابس)، ranger (يرتب)، cuisiner / faire la cuisine (يطبخ).","الفرنسيون يستخدمون faire في كل هذه الأفعال، فتُعلمها مرة واحدة وتستخدمها في مواقف عديدة.","الجمل المكانية تتكرر في كل وصف شقة؛ استمع للإثرائي وأنت ترسم خريطة ذهنية لغرفتك وحدد كل كلمة بمكانها."]},{"h":"وصف منزلك","p":["نموذج: «J'habite dans un appartement. Il y a deux chambres, un salon et une cuisine. Mon salon est grand et lumineux (مشرق). J'aime beaucoup mon quartier (حيي).»","للسؤال: Tu habites où ? (أين تسكن؟) — Dans une maison ou un appartement ? (بيت أم شقة؟)","تمرين يومي: صف غرفتك في ثلاث جمل — il y a + اتجاه + فعل منزلي. الصراحة في الوصف الشخصي تثبت الحفظ أسرع من أي جدول."]},{"h":"التطبيق والتلخيص","p":["يُوسّع هذا الدرس المخزون السكني للمتعلّم أوسع توسيع في المستوى A1: فغرف المنزل (la cuisine، le salon، la chambre، la salle de bain) وأثاثه (le lit، la table، le canapé، l'armoire) تُحفظ كلها مع أداة جرّها، بينما يبني الوصف المكاني عمودَيه il y a و il n'y a pas + de (Il y a un canapé / Il n'y a pas de jardin)، وتثبّت أدوات الاتجاه (dans، à côté de، derrière، sous، sur) ومراتب الطوابق (au rez-de-chaussée، au premier étage، ascenseur)، وتضيف أنشطة البيت اليومية (faire le ménage، faire la vaisselle، ranger). كما وضح الفيديو الرئيسي «تعليم الفرنسية للمبتدئين #54 اجزاء و غرف المنزل و وصف المنزل Les pièces de la maison» من قناة فرنشاوي Frenchawy جولة غرفة بغرفة بأسماء الأجزاء والأثاث بالشرح العربي، يمنح هذا الدرس الطالب المفردات اللازمة لوصف بيته وشرحه لغيره.","يتأسّس هذا الدرس على أدبيات المستوى كله: فأدوات الجر في a1-t5 وترتيب الصفة في a1-t8 يضبطان وصف كل غرفة، والجمع a1-t7 يضاعف أثاث البيت (deux lits، trois chaises، des lampes) فلا يبقى البيت على مفرد واحد — أضف جمع a1-t7 لأثاث البيت في كل وصف تكتبه؛ وأفعال a1-t11 المنتظمة تعود هنا بمعانٍ منزلية جديدة (ranger، cuisiner). وبعد إتقان وصف البيت تنتقل السلسلة إلى a1-t18 الذي ينقل المتعلّم من غرف المنزل إلى أماكن العمل والمهن (bureau، usine، hôpital) فيوسّع محيطه من البيت إلى المجتمع.","المهمة التطبيقية: أعد مشاهدة الفيديو الرئيسي، وأوقفه عند كل غرفة أو قطعة أثاث وسمِّها بصوت مسموع من حفظك؛ ثم صِف غرفتك الحقيقية في أربع جمل مسجّلة (il y a + اتجاه + أثاث بالجمع من a1-t7 + جملة نفي واحدة بـ il n'y a pas de)، وبعد التسجيل استمع إليه وأضف كل كلمة فركتها إلى دفترك، ثم أعد التسجيل مرة واحدة فقط بعد التصحيح."]}],"examples":[{"fr":"J'habite dans un appartement au 3e étage.","ar":"أسكن في شقة بالطابق الثالث."},{"fr":"Le salon est grand et lumineux.","ar":"الصالة كبيرة ومشرقة."},{"fr":"Je fais la vaisselle après le dîner.","ar":"أغسل الصحون بعد العشاء."},{"fr":"On range la maison le samedi.","ar":"نرتب البيت يوم السبت."},{"fr":"Il y a un canapé dans le salon.","ar":"توجد أريكة في الصالة.","note":"il y a"},{"fr":"Il n'y a pas de lumière dans la cuisine.","ar":"لا يوجد إضاءة في المطبخ.","note":"pas de بعد النفي"},{"fr":"Le lit est à côté de la fenêtre.","ar":"السرير بجانب النافذة.","note":"اتجاه"},{"fr":"Nous allons dîner dans la salle à manger.","ar":"سنتعشى في غرفة الطعام.","note":"استخدام الاسم المركب"}],"pron":[{"w":"chez moi","ipa":"[ʃe.mwa]","approx":"شي-موا"},{"w":"la vaisselle","ipa":"[la.vɛ.sɛl]","approx":"لافيسيل"},{"w":"l'armoire","ipa":"[laʁ.mwaʁ]","approx":"لارموَار"}],"vocab":[{"fr":"chez moi","ar":"في بيتي / عندي","pos":"expression","ipa":"[ʃe mwa]","exFr":"Viens chez moi !","exAr":"تعال إلى بيتي!"},{"fr":"le canapé","ar":"الكنبة / الأريكة","pos":"nom","g":"m","pl":"les canapés","ipa":"[ka.na.pe]"},{"fr":"faire la vaisselle","ar":"غسل الصحون","pos":"expression","ipa":"[fɛʁ la vɛ.sɛl]","exFr":"C'est mon tour de faire la vaisselle.","exAr":"دوري غسل الصحون."},{"fr":"ranger","ar":"يرتّب","pos":"verbe","ipa":"[ʁɑ̃.ʒe]","exFr":"Range ta chambre !","exAr":"رتّب غرفتك!"},{"fr":"lumineux / lumineuse","ar":"مشرق / مشرقة","pos":"adj","g":"mf","ipa":"[ly.mi.nø / ly.mi.nøz]","exFr":"Un salon lumineux.","exAr":"صالة مشرقة."},{"fr":"l'appartement","ar":"الشقة","pos":"nom","g":"m","pl":"les appartements","ipa":"[a.paʁ.tə.mɑ̃]","exFr":"Un appartement à louer.","exAr":"شقة للإيجار."},{"fr":"la cuisine","ar":"المطبخ","pos":"nom","g":"f","exFr":"La cuisine est grande.","ipa":"[kɥizin]","exAr":"المطبخ واسع."},{"fr":"le salon","ar":"الصالة","pos":"nom","g":"m","exFr":"On se retrouve dans le salon.","ipa":"[salɔ̃]","exAr":"نلتقي في الصالة."},{"fr":"la chambre","ar":"غرفة النوم","pos":"nom","g":"f","exFr":"Ma chambre est à l'étage.","ipa":"[ʃɑ̃bʁ]","exAr":"غرفتي في الأعلى."},{"fr":"un lit","ar":"سرير","pos":"nom","g":"m","exFr":"Il y a deux lits.","ipa":"[li]","exAr":"يوجد سريران."},{"fr":"une table","ar":"طاولة","pos":"nom","g":"f","exFr":"La table est dans le salon.","ipa":"[tabl]","exAr":"الطاولة في الصالة."},{"fr":"à côté de","ar":"بجانب","pos":"prép","exFr":"À côté de la porte.","ipa":"[a kote də]","exAr":"بجانب الباب."},{"fr":"dessous / dessus","ar":"تحت / فوق","pos":"adv","exFr":"Le chat est dessous.","ipa":"[dəsu]","exAr":"القطة تحته."},{"fr":"un étage","ar":"طابق/دور","pos":"nom","g":"m","exFr":"Au deuxième étage.","ipa":"[etaʒ]","exAr":"في الطابق الثاني."}],"grammar":[{"tFr":"Il y a / Il n'y a pas + le lieu","tAr":"القاعدة: الوصف المكاني","body":["il y a = يَوجد (لا يُترجم حرفيًا)، والنفي il n'y a pas + de بعد النفي.","أدوات الجر تتحدد بالاسم: dans + à côté de + sous + sur — تُحفظ مع المكان لا منفصلة."],"ex":[{"fr":"Il y a un bureau près de la fenêtre.","ar":"يوجد مكتب قرب النافذة."},{"fr":"Il n'y a pas d'ordinateur.","ar":"لا يوجد حاسوب."}]}],"mistakes":[{"wrong":"Il a une table","right":"Il y a une table","why":"il y a فعل وجود تام لا ضمير غائب."},{"wrong":"Il n'y a pas un lit","right":"Il n'y a pas de lit","why":"بعد النفي تأتي de بدل un/une."},{"wrong":"dans le cuisine","right":"dans la cuisine","why":"cuisine مؤنثة: la."},{"wrong":"à gauche de la fenêtre (بلا أداة)","right":"à côté de la fenêtre / derrière la fenêtre","why":"الاتجاهات تتطلب حرف الجر المناسب: à côté de, derrière, devant."}],"dialogues":[{"title":"وصف شقة جديدة","ctx":"صديقان يتفقان على سكن مشترك","lines":[{"who":"Rachid","fr":"Tu as vu l'appartement ?","ar":"هل رأيت الشقة؟"},{"who":"Dounia","fr":"Oui ! Il y a deux chambres et un grand salon.","ar":"نعم! يوجد غرفتان وصالة كبيرة."},{"who":"Rachid","fr":"La cuisine est petite, mais il y a un balcon.","ar":"المطبخ صغير، لكن توجد شرفة."},{"who":"Dounia","fr":"Et il n'y a pas d'ascenseur, c'est au troisième.","ar":"ولا يوجد مصعد، إنها في الطابق الثالث."},{"who":"Rachid","fr":"Pas grave, on fait le ménage à tour de rôle.","ar":"لا مشكلة، ننظف بالتناوب."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما معنى «la cuisine»؟","opts":["غرفة النوم","المطبخ","الصالة","الحمام"],"a":1,"why":"المفردات المختارة تغطي غرف البيت الأساسية — منظومة واحدة متصلة."},{"t":"fill","skill":"vocabulary","q":"أكمل: «Je fais la ___ après le dîner.» (غسل الصحون)","fr":"Je fais la ___ après le dîner.","ans":"vaisselle","why":"faire la vaisselle = يغسل الصحون."},{"t":"translate","skill":"writing","q":"ترجم: «أسكن في شقة.»","ans":"J'habite dans un appartement.","alts":["j habite dans un appartement"],"why":"الترجمة تثبّت أسماء الأثاث وIl y a في وصف البيت."},{"t":"listen","skill":"listening","q":"استمع لوصف الشقة واختر:","audio":"Il y a un canapé dans le salon","opts":["توجد أريكة في الصالة","لا توجد أريكة في الصالة","الأريكة بجانب النافذة","الطاولة تحت المصباح"],"a":0,"why":"il y a = يَوجد، و dans le salon = في الصالة."},{"t":"mcq","skill":"grammar","q":"«رتّب غرفتك!» بالفرنسية:","opts":["Cuisine ta chambre !","Range ta chambre !","Fais ta chambre !","Nettoie ta cuisine !"],"a":1,"why":"ranger = يرتّب."},{"t":"writing","skill":"writing","q":"اكتب 4 جمل تصف بيتك: الغرف، الحجم، والإضاءة.","min":12,"kw":["chambre","salon","cuisine"],"sample":"J'habite dans une maison. Il y a trois chambres. Le salon est grand et lumineux. La cuisine est petite mais pratique.","why":"وصف بيتك بصوتك يدمج أسماء الغرف والمعارف في جمل حية."},{"t":"mcq","skill":"grammar","q":"النفي الصحيح لـ il y a؟","opts":["Il n'y a pas de lit","Il a pas un lit","Il n'a y pas lit","Pas il y a"],"a":0,"why":"il n'y a pas + de."},{"t":"fill","skill":"vocabulary","q":"أكمل: «Le canapé est ___ de la fenêtre. (بجانب)»","fr":"Le canapé est ___ de la fenêtre.","ans":"à côté","why":"à côté de = بجانب."}],"homework":"اكتب إعلاناً قصيراً (4 أسطر) لتأجير شقتك بالفرنسية: الغرف، المكان، والسعر. الدرس السابق/التالي: a1-t16 (Combien ça coûte ? — التسوق) ← a1-t17 (Chez moi — المنزل) → a1-t18 (Quelle est votre profession ? — العمل).","sources":[{"title":"تعليم الفرنسية للمبتدئين #54 اجزاء و غرف المنزل و وصف المنزل Les pièces de la maison فر…","channel":"فرنشاوي Frenchawy","videoId":"3ST1iwbXpxk","why":"شرح فرنشاوي لغرف المنزل ووصفه بالعربية — مكمل مثالي للمحور الأول.","cat":"Vocabulaire","level":"A1","main":true},{"title":"House Vocabulary For Beginners in French | Super Easy French 128","channel":"Easy French","videoId":"UXMB6Ms_2Uw","why":"سلسلة Easy French الشارعية بمفردات المنزل مع نطق طبيعي وترجمة مزدوجة.","cat":"Vocabulaire","level":"A1","extra":true},{"title":"Decrivez Votre Maison en Francais | Describe Your House in French | Pièces de la maison…","channel":"CCube Academy","videoId":"ZZNzs-OUKJY","why":"وصف منزل كامل جملة جملة من CCube — نموذج جاهز للتقليد في الكتابة.","cat":"Vocabulaire","level":"A1","extra":true},{"title":"La maison — مكونات المنزل والأثاث بالفرنسية بطريقة مميزة","channel":"عربي بلسان فرنسي","videoId":"_BwsCsyEqaU","why":"مفردات المنزل كاملة (غرف + أثاث) بطريقة مبسطة — توسعة مثالية لمفردات الدرس.","cat":"Vocabulaire","dur":9,"level":"A1","extra":true},{"title":"les parties de la maison — أجزاء المنزل بالفرنسية","channel":"Mon Français","videoId":"y4jN_6kzVBM","why":"قائمة سريعة بأسماء الغرف — مراجعة سريعة للحفظ.","cat":"Vocabulaire","dur":5,"level":"A1","extra":true}],"supplements":[{"id":"UXMB6Ms_2Uw","title":"House Vocabulary For Beginners in French | Super Easy French 128","channel":"Easy French","why":"سلسلة Easy French الشارعية بمفردات المنزل مع نطق طبيعي وترجمة مزدوجة.","lang":"fr"},{"id":"ZZNzs-OUKJY","title":"Decrivez Votre Maison en Francais | Describe Your House in French | Pièces de la maison…","channel":"CCube Academy","why":"وصف منزل كامل جملة جملة من CCube — نموذج جاهز للتقليد في الكتابة.","lang":"fr"},{"id":"_BwsCsyEqaU","title":"La maison — مكونات المنزل والأثاث بالفرنسية بطريقة مميزة","channel":"عربي بلسان فرنسي","why":"مفردات المنزل كاملة (غرف + أثاث) بطريقة مبسطة — توسعة مثالية لمفردات الدرس.","dur":9,"lang":"ar"},{"id":"y4jN_6kzVBM","title":"les parties de la maison — أجزاء المنزل بالفرنسية","channel":"Mon Français","why":"قائمة سريعة بأسماء الغرف — مراجعة سريعة للحفظ.","dur":5,"lang":"ar"}]}]},{"id":"a1-t18","slug":"le-travail","icon":"users","color":"#059669","fr":"Le travail","ar":"العمل","desc":"مهنتك، مكان عملك، وجدول يومك المهني.","lessons":[{"id":"A1-t18-l1","fr":"Quelle est votre profession ?","ar":"ما مهنتك؟","objectives":["التعرّف عن مهنتك ومكان عملك في جمل قصيرة","تسمية مهن شائعة وأماكن العمل (bureau, usine, hôpital)","التحدث عن رواتب/ساعات عمل بعبارات أساسية","وصف يوم عملك الماضي بال passé composé"],"sections":[{"h":"المهن الأساسية","p":["موضوع العمل يدخل في كل مقابلة عمل أو محادثة اجتماعية: Que faites-vous dans la vie ? (ماذا تعمل في حياتك؟). الفيديو الأساسي بالشرح العربي يعرض حوارًا مهنيًا كاملًا — استمع وحدّد ثلاث كلمات مهنية جديدة.","السؤال عن المهنة يأتي بصيغتين: Qu'est-ce que tu fais ? (عامية) و Quelle est votre profession ? (رسمية). الإجابة بـ être: Je suis ingénieur. Je suis infirmière. أو بـ travailler: Je travaille dans l'hôpital.","أماكن العمل تُحفظ مع حرف الجر المناسب: à l'hôpital (في المستشفى)، à l'école (في المدرسة)، dans un bureau (في مكتب)، en usine (في المصنع)، à la maison (من المنزل — télétravail).","المهن الشائعة في A1: médecin (طبيب)، professeur (أستاذ)، ingénieur (مهندس)، avocat (محامٍ)، infirmier (ممرض)، chauffeur (سائق)، cuisinier (طبّاخ)، vendeur (بائع)، étudiant (طالب). حفظ المهنة مع الجر يغني عن الجملة الطويلة.","الرواتب والساعات: Je gagne... (أربح...)، Le salaire est... (الراتب...)، Je travaille de 9 à 5 (أعمل من 9 إلى 5)، Je fais des heures supplémentaires (أعمل ساعات إضافية). الأرقام تعود للدرس السابق وتُوظّف هنا.","يوم العمل الماضي يُروى بال passé composé: J'ai eu une réunion (لدي اجتماع)، J'ai rencontré un client (قابلت عميلًا)، Je suis rentré à 18h (عدت الساعة السادسة). الدمج هنا يثبت الزمن السابق فعليًا."],"video":{"id":"eCb4g47elHA","title":"تعلم اللغة الفرنسية : المهن بالفرنسية Les Métiers","channel":"عربي بلسان فرنسي","why":"عربي بلسان فرنسي يقدم المهن بالنطق والصورة — أساس مفردات المحور.","lang":"ar","main":true},"sub":[{"h":"السؤال والإجابة عن المهنة","p":["Que faites-vous dans la vie ? — ماذا تعمل؟","Je suis médecin / Je suis infirmière.","Je travaille dans une banque.","Je suis étudiant, mais je cherche un job."]},{"h":"أماكن العمل والأدوات","p":["le bureau — المكتب، l'usine — المصنع، l'hôpital — المستشفى.","l'école — المدرسة، le cabinet — العيادة، le magasin — المتجر.","le rendez-vous — الموعد، la réunion — الاجتماع، le client — العميل."]},{"h":"ساعات العمل والرواتب","p":["Je travaille du lundi au vendredi. — أعمل من الاثنين إلى الجمعة.","Je gagne 2000 euros par mois. — أربح 2000 يورو شهريًا.","J'ai une pause à midi. — لدي استراحة عند الظهر.","Je prends des congés en été. — آخذ إجازة في الصيف."]}]},{"h":"السؤال عن المهنة","p":["رسمي: Quelle est votre profession ? أو Que faites-vous dans la vie ? (ماذا تعمل في الحياة؟).","غير رسمي: Tu fais quoi dans la vie ? أو Tu travailles où ? (أين تعمل؟). الرد: Je suis ingénieur. Je travaille dans une école.","الفيديو الإثرائي يعرض وجوهًا مهنية حقيقية؛ أوقفه وصف مهنتك بنفس القالب — الاستجابة الفورية تثبت التعلّم."]},{"h":"جدول العمل","p":["Je travaille de 9h à 17h (أعمل من 9 إلى 5). Je travaille du lundi au vendredi (أعمل من الاثنين إلى الجمعة). Je suis en congé (في إجازة).","تراكيب مفيدة: avoir une réunion (لديه اجتماع)، envoyer un email (يرسل إيميل)، prendre un rendez-vous (يحدد موعداً).","تمرين الكتابة: اكتب فقرة من 5 جمل عن يوم عملك الماضي ( passé composé) ثم اقرأها بصوت مسموع. الرواية الشخصية تدمج المفردات والزمن معًا."]},{"h":"التطبيق والتلخيص","p":["يُعرّفك هذا الدرس على سوق العمل بالفرنسية بأربعة مستويات متتابعة: مستوى السؤال (Quelle est votre profession ? رسميًّا، Que faites-vous dans la vie ? عاميًّا)، مستوى الإجابة بـ être بلا أداة (Je suis médecin / Je suis infirmière)، مستوى المكان بحروف الجر الخاصة (à l'hôpital، à l'école، dans un bureau، en usine، à la maison للعمل عن بعد)، ثم مستوى الساعات والرواتب (Je travaille de 9 à 5، Je gagne ... euros par mois) ورواية يوم العمل الماضي بالـ passé composé (J'ai eu une réunion، Je suis rentré à 18h). كما وضح الفيديو الرئيسي «تعلم اللغة الفرنسية : المهن بالفرنسية Les Métiers» من قناة عربي بلسان فرنسي أسماء المهن الأساسية بالنطق والصورة، يمنح هذا الدرس الطالب المفردات والتراكيب اللازمة ليجيب عن أسئلة العمل في المقابلات والمحادثات الاجتماعية.","يربط هذا الدرس المهنة بما سبقها في السلسلة: فمهن البيت والأنشطة المنزلية في a1-t17 (faire le ménage، ranger، cuisiner) تتحوّل هنا إلى عمل خارجي منظّم بأفعال a1-t11 المجموعة الأولى (travailler، parler، rencontrer، cuisiner)؛ فالعمل يجمع ما تعلّمته من أعمال البيت في a1-t17 وأفعال a1-t11 في موقف واحد مهني. وبعد إتقان وصف المهنة وأماكنها وساعاتها تنتقل السلسلة إلى a1-t19 الذي ينقل مفردات العمل إلى موقف الحجز والسفر: مواعيد الرحلة، أنواع التذاكر، وكلمات المطار.","المهمة التطبيقية: أعد مشاهدة الفيديو الرئيسي، وأوقفه عند كل مهنة وردّدها مع مكان عملها؛ ثم سجّل نفسك في مقابلة عمل من دقيقة: تُسلّم بتحية، وتجيب عن «Quelle est votre profession ?» بجملة être بلا أداة، وتذكر مكان عملك بحرف الجر الصحيح، وتشرح جدول أسبوعك (du lundi au vendredi)، ثم تُختم بجملة واحدة بالـ passé composé عن أمسك المهني (J'ai eu une réunion...) كما في الفيديو — وبعد الاستماع صحّح أخطاء الأدوات وحدها وأعد التسجيل مرة واحدة."]}],"examples":[{"fr":"Je suis professeur de français.","ar":"أنا معلم فرنسية."},{"fr":"Elle travaille dans un hôpital.","ar":"تعمل في مستشفى."},{"fr":"Je travaille du lundi au vendredi.","ar":"أعمل من الاثنين إلى الجمعة."},{"fr":"J'ai une réunion à 10 heures.","ar":"عندي اجتماع الساعة 10."},{"fr":"Je suis professeur de mathématiques.","ar":"أنا أستاذ رياضيات.","note":"المهنة بـ être"},{"fr":"Il travaille dans un hôpital.","ar":"هو يعمل في مستشفى.","note":"المكان + dans"},{"fr":"Nous avons eu une longue réunion.","ar":"لقد أجرينا اجتماعاً طويلاً.","note":"passé composé"},{"fr":"Elle gagne bien sa vie.","ar":"هي تكسب رزقها جيداً.","note":"تعبير عن الراتب"}],"pron":[{"w":"professeur","ipa":"[pʁɔ.fe.sœʁ]","approx":"بروفيسور"},{"w":"ingénieur","ipa":"[ɛ̃.ʒe.njøʁ]","approx":"أنجينيور"},{"w":"la réunion","ipa":"[ʁe.y.njɔ̃]","approx":"ريونيون"}],"vocab":[{"fr":"le travail","ar":"العمل","pos":"nom","g":"m","pl":"les travaux","ipa":"[tʁa.vaj]","exFr":"J'aime mon travail.","exAr":"أحب عملي."},{"fr":"le professeur","ar":"المعلم","pos":"nom","g":"m","pl":"les professeurs","ipa":"[pʁɔ.fe.sœʁ]","exFr":"Mon professeur est sympa.","exAr":"معلمي لطيف."},{"fr":"l'ingénieur","ar":"المهندس","pos":"nom","g":"m","pl":"les ingénieurs","ipa":"[ɛ̃.ʒe.njøʁ]"},{"fr":"le médecin","ar":"الطبيب","pos":"nom","g":"m","pl":"les médecins","ipa":"[med.sɛ̃]"},{"fr":"une réunion","ar":"اجتماع","pos":"nom","g":"f","pl":"des réunions","ipa":"[ʁe.y.njɔ̃]","exFr":"La réunion commence à 9h.","exAr":"الاجتماع يبدأ 9 صباحاً."},{"fr":"en congé","ar":"في إجازة","pos":"expression","ipa":"[ɑ̃.kɔ̃.ʒe]","exFr":"Je suis en congé cette semaine.","exAr":"أنا في إجازة هذا الأسبوع."},{"fr":"un métier","ar":"حرفة/مهنة","pos":"nom","g":"m","exFr":"Quel est ton métier ?","ipa":"[metje]","exAr":"ما مهنتك؟"},{"fr":"le bureau","ar":"المكتب","pos":"nom","g":"m","exFr":"Je travaille au bureau.","ipa":"[byʁo]","exAr":"أعمل في المكتب."},{"fr":"la réunion","ar":"الاجتماع","pos":"nom","g":"f","exFr":"La réunion commence à 10h.","ipa":"[ʁejɔ̃]","exAr":"يبدأ الاجتماع الساعة 10."},{"fr":"le salaire","ar":"الراتب","pos":"nom","g":"m","exFr":"Le salaire est bon.","ipa":"[salɛʁ]","exAr":"الراتب جيد."},{"fr":"un médecin","ar":"طبيب","pos":"nom","g":"m","exFr":"Je consulte un médecin.","ipa":"[mədəsɛ̃]","exAr":"أزور طبيباً."},{"fr":"un client","ar":"عميل","pos":"nom","g":"m","exFr":"Le client attend.","ipa":"[klijɑ̃]","exAr":"العميل ينتظر."},{"fr":"gagner","ar":"يكسب/يربح","pos":"verbe","g":"1er","exFr":"Je gagne ma vie.","ipa":"[ɡeɲe]","exAr":"أكسب رزقي."}],"grammar":[{"tFr":"Parler du travail : être + métier","tAr":"القاعدة: وصف المهنة","body":["المهنة تأتي مع être مباشرة بلا أداة: Je suis médecin — لا «je suis un médecin» في الوصف المباشر.","المكان يأتي مع حرف جر خاص: à (مستشفى/مدرسة)، dans (شركة/مكتب)، en (مصنع)."],"ex":[{"fr":"Je suis avocat.","ar":"أنا محامٍ."},{"fr":"Il travaille en usine.","ar":"يعمل في مصنع."}]}],"mistakes":[{"wrong":"Je suis un médecin","right":"Je suis médecin","why":"المهنة مع être تأتي بلا أداة في الوصف المباشر."},{"wrong":"Je travaille dans l'hôpital","right":"Je travaille à l'hôpital","why":"المستشفى يأخذ à لا dans."},{"wrong":"Il a une réunion (بالمعنى)","right":"Il a une réunion / Nous avons eu une réunion","why":"avoir يصلح للملكية، لكن الماضي المركب يكوّن بـ avons eu."},{"wrong":"Je gagne 2000 euros (بلا par mois)","right":"Je gagne 2000 euros par mois","why":"تُذكر دورية الدفع مع المبلغ: par mois / par an."}],"dialogues":[{"title":"مقابلة عمل أولى","ctx":"مرشح يُسأل عن خبرته","lines":[{"who":"Recruteur","fr":"Quelle est votre profession actuelle ?","ar":"ما مهنتكم الحالية؟"},{"who":"Sofia","fr":"Je suis assistante dans une entreprise.","ar":"أنا مساعدة في شركة."},{"who":"Recruteur","fr":"Depuis combien de temps travaillez-vous ?","ar":"منذ متى تعملين؟"},{"who":"Sofia","fr":"Depuis trois ans. J'ai eu deux promotions.","ar":"منذ ثلاث سنوات. حصلت على ترقيتين."},{"who":"Recruteur","fr":"Très bien. Pourquoi voulez-vous changer ?","ar":"جيد جداً. لماذا تريدين التغيير؟"},{"who":"Sofia","fr":"Je cherche plus de responsabilités.","ar":"أبحث عن مسؤوليات أكثر."}]}],"exercises":[{"t":"mcq","skill":"grammar","q":"أي جملة صحيحة عن المهنة ومكان العمل؟","opts":["Je suis un médecin.","Je suis médecin.","Je travaille dans l'hôpital.","Elle est une infirmière."],"a":1,"why":"المهنة مع être بلا أداة في الوصف المباشر، والمستشفى يأخذ à لا dans."},{"t":"fill","skill":"vocabulary","q":"أكمل: «Elle travaille dans un ___ (مستشفى).»","fr":"Elle travaille dans un ___.","ans":"hôpital","why":"hôpital = مستشفى."},{"t":"translate","skill":"writing","q":"ترجم: «أعمل من الاثنين إلى الجمعة.»","ans":"Je travaille du lundi au vendredi.","alts":["je travaille du lundi au vendredi"],"why":"الترجمة تربط اسم المهنة بمكان العمل — مفردات الفيديو الأساسية."},{"t":"listen","skill":"listening","q":"استمع لسؤال المقابلة واختره:","audio":"Quelle est votre profession ?","opts":["ما مهنتك؟","أين تسكن؟","كم عمرك؟","ما اسمك؟"],"a":0,"why":"الاستماع يميّز المهنة من السياق كما في حوار الفيديو."},{"t":"speaking","skill":"speaking","q":"قدّم مهنتك وجدول عملك بجملة واحدة.","target":"Je suis ingénieur et je travaille du lundi au vendredi","why":"التركيب اللغوي للتعريف بالمهنة: Je suis + métier أو Je travaille à + lieu."},{"t":"mcq","skill":"vocabulary","q":"أي مكان عمل يناسب «infirmier»؟","opts":["l'hôpital","l'école","le jardin","la gare"],"a":0,"why":"الممرض في المستشفى."},{"t":"fill","skill":"grammar","q":"أكمل: «Je ___ médecin.»","fr":"Je ___ médecin.","ans":"suis","why":"المهنة مع être."},{"t":"order","skill":"grammar","q":"رتّب: «كان لدينا اجتماع طويل»","words":["Nous","avons","eu","une","réunion"],"ans":"Nous avons eu une réunion","why":"ترتيب الجملة يثبّت بنية travailler à + lieu كما شرح الفيديو."}],"homework":"اكتب 5 جمل عن عملك أو دراستك: المهنة، المكان، الأيام، الساعات، وشيء تحبه في عملك. الدرس السابق/التالي: a1-t17 (Chez moi — المنزل) ← a1-t18 (Quelle est votre profession ? — العمل) → a1-t19 (Un billet pour Paris — السفر).","sources":[{"title":"تعلم اللغة الفرنسية : المهن بالفرنسية Les Métiers","channel":"عربي بلسان فرنسي","videoId":"eCb4g47elHA","why":"عربي بلسان فرنسي يقدم المهن بالنطق والصورة — أساس مفردات المحور.","cat":"Vocabulaire","level":"A1","main":true},{"title":"What's Your Occupation? | Easy French 95","channel":"Easy French","videoId":"ooouJuoeQ1c","why":"مقابلات شارعية من Easy French: ما مهنتك؟ — إيقاع حقيقي وأجوبة متنوعة.","cat":"Vocabulaire","level":"A1","extra":true},{"title":"How to Talk About Jobs and Work in French (A1) | Learn French with Podcast | Easy Frenc…","channel":"Simply French Podcast | Easy French","videoId":"8M__AwkeP3o","why":"بودكاست Simply French عن الحديث عن العمل بمستوى A1 — استماع مريح ومفيد.","cat":"Vocabulaire","level":"A1","extra":true},{"title":"les métiers — المهن: الخدمات والحرف بالفرنسية الجزء 1","channel":"عربي بلسان فرنسي","videoId":"z9N_ziNjqRY","why":"مفردات المهن الأساسية مترجمة مع أمثلة — تطبيق مباشر لvocab درس العمل.","cat":"Vocabulaire","dur":11,"level":"A1","extra":true},{"title":"الوظائف باللغة الفرنسية — معجم Métiers","channel":"Français avec Khalid","videoId":"AXAaYDQXyQs","why":"معجم مركّز للأسماء الوظيفية الشائعة — مراجعة سريعة.","cat":"Vocabulaire","dur":5,"level":"A1","extra":true}],"supplements":[{"id":"ooouJuoeQ1c","title":"What's Your Occupation? | Easy French 95","channel":"Easy French","why":"مقابلات شارعية من Easy French: ما مهنتك؟ — إيقاع حقيقي وأجوبة متنوعة.","lang":"fr"},{"id":"8M__AwkeP3o","title":"How to Talk About Jobs and Work in French (A1) | Learn French with Podcast | Easy Frenc…","channel":"Simply French Podcast | Easy French","why":"بودكاست Simply French عن الحديث عن العمل بمستوى A1 — استماع مريح ومفيد.","lang":"fr"},{"id":"z9N_ziNjqRY","title":"les métiers — المهن: الخدمات والحرف بالفرنسية الجزء 1","channel":"عربي بلسان فرنسي","why":"مفردات المهن الأساسية مترجمة مع أمثلة — تطبيق مباشر لvocab درس العمل.","dur":11,"lang":"ar"},{"id":"AXAaYDQXyQs","title":"الوظائف باللغة الفرنسية — معجم Métiers","channel":"Français avec Khalid","why":"معجم مركّز للأسماء الوظيفية الشائعة — مراجعة سريعة.","dur":5,"lang":"ar"}]}]},{"id":"a1-t19","slug":"les-voyages","icon":"mic","color":"#059669","fr":"Les voyages","ar":"السفر","desc":"في المطار والفندق: الحجز، التذاكر، والاتجاهات.","lessons":[{"id":"A1-t19-l1","fr":"Un billet pour Paris, s'il vous plaît","ar":"تذكرة لباريس من فضلك","objectives":["حجز رحلة وسؤال عن المواعيد والأسعار","تعبئة نموذج سفر ووصف وجهتك بجمل بسيطة","استخدام futur proche في خطط السفر","فهم إعلانات المطار والمحطة بالكلمات المفتاحية"],"sections":[{"h":"في المطار والقطار","p":["السفر موقف مركّب يجمع كل ما تعلمته: الوقت، الأرقام، الأفعال الشاذة، المستقبل القريب. الفيديو الأساسي بالشرح العربي يعرض حوار حجز تذاكر — ركّز على كلمات: billet (تذكرة)، aller-retour (ذهاب وإياب)، horaire (موعد).","الحجز يبدأ بالسؤال: Un billet pour Paris, s'il vous plaît. À quelle heure part le train ? (في أي ساعة ينطلق القطار؟). الإجابة تأتي بأرقام وساعات — تدريب مزدوج على الرقم والزمن.","أنواع التذاكر تُحفظ كما هي: aller simple (ذهاب فقط)، aller-retour (ذهاب وإياب)، première classe / seconde classe (الدرجة الأولى/الثانية). السؤال عن السعر يعيدك لدرس التسوق: C'est combien ?","وصف الوجهة يأتي مع صفات مكانية: la plage (الشاطئ)، la montagne (الجبل)، la ville (المدينة)، le désert (الصحراء). الجملة: Je vais à la plage — avec le futur proche: Je vais aller à la plage.","إعلانات المحطة والمطار تحمل كلمات مفتاحية بعينها: arrivée (وصول)، départ (انطلاق)، retard (تأخير)، enregistrement (تسجيل)، passeport (جواز سفر)، bagages (أمتعة). فهم هذه العشر يكفي للاستدلال على الباقي.","نصيحة السلوك: في المحطات الفرنسية تُعلن الوجهات بصوت مسموع و على الشاشات — المفردات المكتوبة هنا ليست مجرد قراءة بل أداة تنقّل فعلية. احفظها مرئية وسمعية معًا."],"video":{"id":"9w0CQfV9AWA","title":"محادثة في المطار بالفرنسية ✈️","channel":"Le Français avec Yasmine","why":"محادثة المطار بالفرنسية مع ياسمين بشرح عربي — ثقة أكبر قبل السفر.","lang":"ar","main":true},"sub":[{"h":"عبارات الحجز","p":["Un billet pour Lyon, s'il vous plaît.","Un aller-retour pour Marseille.","À quelle heure part le bus ?","Est-ce qu'il reste des places ?"]},{"h":"الوجهات والصفات","p":["la plage — الشاطئ، la montagne — الجبل، la ville — المدينة.","l'étranger — الخارج، le nord / le sud — الشمال/الجنوب.","un voyage — رحلة، les vacances — العطلة، une escale — توقف."]},{"h":"كلمات المطار والمحطة","p":["le départ / l'arrivée — الانطلاق/الوصول.","le retard — التأخير، l'annulation — الإلغاء.","l'enregistrement — تسجيل الأمتعة، les bagages — الحقائب.","le passeport — جواز السفر، la carte d'embarquement — بطاقة الصعود."]}]},{"h":"في الفندق","p":["la chambre (غرفة)، une chambre simple / double، la réservation (الحجز)، la clé (المفتاح)، le petit-déjeuner (الفطور)، la réception (الاستقبال).","حوار قياسي: J'ai une réservation au nom de Ahmed (عندي حجز باسم أحمد). Est-ce que le petit-déjeuner est inclus ? (هل الفطور مشمول؟).","الصوت في الفيديو الإثرائي بطيء وواضح؛ استمع وأنت تكتب أرقام المغادرة — التمرين يدمج الرقم والزمن والمفردات في نشاط واحد."]},{"h":"السؤال عن الطريق","p":["Pardon, où est la gare, s'il vous plaît ? (عفواً، أين المحطة؟). Excusez-moi, comment aller au centre-ville ? (كيف أذهب لمركز المدينة؟).","الردود المفيدة: Allez tout droit (امشِ مستقيماً)، Tournez à droite (انعطف يميناً)، à gauche (يساراً)، C'est loin (بعيد) / C'est à côté (بجانب).","محاكاة: تخيّل أنك تسافر غدًا واكتب ردّك على خمسة أسئلة: إلى أين؟ متى؟ بأي وسيلة؟ كم التذكرة؟ ماذا تحمل؟ اقرأها بصوت مسموع مستخدمًا futur proche."]},{"h":"التطبيق والتلخيص","p":["يجمع هذا الدرس رحلة السفر كاملة في مفرداته وتراكيبه: فحجز التذكرة يبدأ بـ «Un billet pour Paris, s'il vous plaît» مع تمييز aller simple من aller-retour، والسؤال عن الموعد والسعر يعيد استخدام «À quelle heure part...؟» و«C'est combien...؟»، وكلمات المطار تُحفظ كما هي (départ، arrivée، retard، enregistrement، passeport، bagages)، ووصف الوجهة يأتي بصفات مكانية بسيطة (la plage، la montagne، la ville)، بينما تُعبَّر خطط السفر القريبة بـ futur proche (Je vais aller، Je vais réserver). كما وضح الفيديو الرئيسي «محادثة في المطار بالفرنسية» من قناة Le Français avec Yasmine حوارًا كاملًا بين مسافر وموظف حجز بشرح عربي، يمنح هذا الدرس الطالب الجاهزية اللغوية لأول رحلة جوية أو قطار بها.","يستدعي هذا الدرس futur proche من a1-t13 (Je vais partir / Je vais réserver ce soir) لتعبير النية القريبة قبل السفر، وتتكرر فيه أرقام المواعيد والأسعار وأسئلة a1-t10 (Quand ? / Où ?) داخل حوار الحجز نفسه؛ فالسفر يستدعي futur proche a1-t13 ويجمّع أسئلة السؤال كلها في موقف واحد. وبعد إتقان الحجز والاتجاهات تنتقل السلسلة إلى a1-t20 الذي يضع بين يديك قراءة الساعة والمواعيد اليومية — فلا معنى لحجز رحلة دون قراءة مواعيدها بثقة.","المهمة التطبيقية: أعد مشاهدة الفيديو الرئيسي ثلاث مرات (مرّة لفهم المعنى، ومرّة مع التوقف عند كل عبارة ورددها، ومرّة بصوت مكتوم للتنبؤ بالكلام قبل سماعه)؛ ثم سجّل حوار حجز كاملًا من ستة أسطر بينك وبين موظف المحطة: تطلب تذكرة، وتُميّز aller simple من aller-retour، وتسأل عن ساعة الانطلاق بـ «À quelle heure part...؟»، وتسأل عن السعر، وتُختم بجملة futur proche من a1-t13 (Je vais voyager...) — وبعد الاستماع صحّح ما نطقته خطأً وأعد التسجيل مرة واحدة."]}],"examples":[{"fr":"Un billet aller simple pour Marseille.","ar":"تذكرة ذهاب فقط لمارسيليا."},{"fr":"À quelle heure arrive le train ?","ar":"متى يصل القطار؟"},{"fr":"Excusez-moi, où sont les toilettes ?","ar":"عفواً، أين المراحيض؟"},{"fr":"Allez tout droit puis tournez à gauche.","ar":"امشِ مستقيماً ثم انعطف يساراً."},{"fr":"Je vais aller à Marrakech cet été.","ar":"سأذهب إلى مراكش هذا الصيف.","note":"futur proche"},{"fr":"À quelle heure part le vol ?","ar":"في أي ساعة ينطلق الرحلة؟","note":"سؤال الموعد"},{"fr":"Le train a du retard de vingt minutes.","ar":"القطار متأخر عشرين دقيقة.","note":"التأخير"},{"fr":"Nous avons réservé un aller-retour.","ar":"حجزنا تذكرة ذهاب وإياب.","note":"passé composé"}],"pron":[{"w":"un billet","ipa":"[œ̃.bi.jɛ]","approx":"أو-بيييه"},{"w":"la gare","ipa":"[la.ɡaʁ]","approx":"لاغار"},{"w":"tout droit","ipa":"[tu.dʁwa]","approx":"تو-دروا","note":"انتبه: tout droit = مستقيماً"}],"vocab":[{"fr":"un billet","ar":"تذكرة","pos":"nom","g":"m","pl":"des billets","ipa":"[bi.jɛ]","exFr":"Un billet, s'il vous plaît.","exAr":"تذكرة من فضلك."},{"fr":"aller-retour","ar":"ذهاب وعودة","pos":"expression","ipa":"[a.le.ʁə.tuʁ]","exFr":"Un aller-retour, s'il vous plaît.","exAr":"ذهاب وعودة من فضلك."},{"fr":"une réservation","ar":"حجز","pos":"nom","g":"f","pl":"des réservations","ipa":"[ʁe.zɛʁ.va.sjɔ̃]","exFr":"J'ai une réservation.","exAr":"عندي حجز."},{"fr":"à droite / à gauche","ar":"يميناً / يساراً","pos":"expression","ipa":"[a.dʁwat / a.ɡoʃ]","exFr":"Tournez à droite.","exAr":"انعطف يميناً."},{"fr":"tout droit","ar":"مستقيماً","pos":"expression","ipa":"[tu.dʁwa]","exFr":"Allez tout droit.","exAr":"امشِ مستقيماً."},{"fr":"l'horaire","ar":"الموعد/الجدول","pos":"nom","g":"m","exFr":"L'horaire du train ?","ipa":"[ɔʁɛʁ]","exAr":"جدول القطار؟"},{"fr":"partir / arriver","ar":"ينطلق / يصل","pos":"verbe","g":"—","exFr":"Le train part à 8h.","ipa":"[paʁtiʁ]","exAr":"ينطلق القطار الساعة 8."},{"fr":"un voyage","ar":"رحلة","pos":"nom","g":"m","exFr":"Bon voyage !","ipa":"[vwaʒaʒ]","exAr":"رحلة سعيدة!"},{"fr":"les vacances","ar":"العطلة","pos":"nom","g":"f.pl","exFr":"Les vacances d'été.","ipa":"[vakɑ̃s]","exAr":"عطلة الصيف."},{"fr":"le retard","ar":"التأخير","pos":"nom","g":"m","exFr":"Le train a du retard.","ipa":"[ʁətaʁ]","exAr":"القطار متأخر."},{"fr":"les bagages","ar":"الأمتعة","pos":"nom","g":"m.pl","exFr":"Où sont mes bagages ?","ipa":"[baɡaʒ]","exAr":"أين أمتعتي؟"},{"fr":"un passeport","ar":"جواز سفر","pos":"nom","g":"m","exFr":"Votre passeport, s'il vous plaît.","ipa":"[pas pɔʁ]","exAr":"جواز سفرك من فضلك."},{"fr":"la valise","ar":"الحقيبة","pos":"nom","g":"f","exFr":"Ma valise est prête pour le voyage.","ipa":"/la valiz/","exAr":"حقيبتي جاهزة للسفر."}],"grammar":[{"tFr":"Demander le voyage","tAr":"القاعدة: أسئلة السفر","body":["À quelle heure... ? للسؤال عن الوقت، Et combien... ? عن السعر، Où... ? عن الوجهة — ثلاثة أسئلة تغطي الحجز كله.","futur proche يناسب خطط السفر: Je vais partir... — النية القريبة في جملة واحدة."],"ex":[{"fr":"À quelle heure on part demain ?","ar":"في أي ساعة نغادر غداً؟"},{"fr":"Je vais réserver ce soir.","ar":"سأحجز هذا المساء."}]}],"mistakes":[{"wrong":"Je vais à voyager","right":"Je vais voyager","why":"المصدر داخل futur proche بلا حرف جر."},{"wrong":"Un ticket de train","right":"Un billet de train","why":"billet هي الكلمة الأصيلة للتذاكر؛ ticket تُستخدم للحافلة/السينما."},{"wrong":"Le train part à Paris (بلا معنى)","right":"Le train part pour Paris","why":"الانطلاق إلى وجهة يأخذ pour لا à."},{"wrong":"les bagage","right":"les bagages","why":"bagages جمع دائمًا في هذا السياق."}],"dialogues":[{"title":"في محطة القطار","ctx":"زبون يشتري تذكرة","lines":[{"who":"Guichetier","fr":"Bonjour, je peux vous aider ?","ar":"مرحباً، هل يمكنني مساعدتك؟"},{"who":"Tarek","fr":"Un billet pour Bordeaux, s'il vous plaît.","ar":"تذكرة إلى بوردو من فضلك."},{"who":"Guichetier","fr":"Aller simple ou aller-retour ?","ar":"ذهاب فقط أم ذهاب وإياب؟"},{"who":"Tarek","fr":"Aller-retour. À quelle heure part le premier train ?","ar":"ذهاب وإياب. في أي ساعة ينطلق أول قطار؟"},{"who":"Guichetier","fr":"À sept heures trente. Ça fait quarante-cinq euros.","ar":"الساعة السابعة والنصف. المجموع خمسة وأربعون يورو."},{"who":"Tarek","fr":"Très bien, je le prends.","ar":"جيد جداً، آخذه."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"«تذكرة ذهاب وعودة» بالفرنسية:","opts":["un billet simple","un aller-retour","un aller simple","un vol retour"],"a":1,"why":"التمرين يثبّت مفردات السفر: التذكرة والجواز والحقيبة — أساس أي رحلة."},{"t":"fill","skill":"vocabulary","q":"أكمل: «J'ai une ___ au nom de Ali.» (حجز)","fr":"J'ai une ___ au nom de Ali.","ans":"réservation","why":"une réservation = حجز."},{"t":"translate","skill":"writing","q":"ترجم: «أين المحطة؟»","ans":"Où est la gare ?","alts":["ou est la gare"],"why":"الترجمة تربط فعل السفر بالوقت عبر futur proche من a1-t13."},{"t":"listen","skill":"listening","q":"استمع للإرشاد واختره:","audio":"Allez tout droit et tournez à droite","opts":["امشِ مستقيماً وانعطف يميناً","انعطف يساراً ثم يميناً","امشِ مستقيماً وانعطف يساراً","المرحض بجانبك"],"a":0,"why":"الاستماع يحاكي إعلانات المطار الحقيقية كما في الفيديو."},{"t":"mcq","skill":"vocabulary","q":"ما معنى «tout droit»؟","opts":["كل الحق","مستقيماً","دائماً","بعيداً"],"a":1,"why":"tout droit = مستقيماً في الإرشادات."},{"t":"speaking","skill":"speaking","q":"اطلب تذكرة ذهاب وعودة لباريس.","target":"Un billet aller-retour pour Paris, s'il vous plaît","why":"محادثة الحجز المحاكاة تدمج التحية من a1-t3 والطلب من a1-t15."},{"t":"mcq","skill":"vocabulary","q":"تذكرة الذهاب والإياب؟","opts":["un aller-retour","un aller simple","une escale","un retard"],"a":0,"why":"aller-retour = ذهاب وإياب."},{"t":"fill","skill":"listening","q":"أكمل إعلان المحطة: «Le train a du ___ de dix minutes.»","fr":"Le train a du ___ de dix minutes.","ans":"retard","why":"retard = تأخير."}],"homework":"اكتب حواراً من 8 أسطر في محطة قطار: شراء تذكرة، سؤال عن الوقت، والمنصة. الدرس السابق/التالي: a1-t18 (Quelle est votre profession ? — العمل) ← a1-t19 (Un billet pour Paris — السفر) → a1-t20 (Quelle heure est-il ? — الوقت).","sources":[{"title":"محادثة في المطار بالفرنسية ✈️","channel":"Le Français avec Yasmine","videoId":"9w0CQfV9AWA","why":"محادثة المطار بالفرنسية مع ياسمين بشرح عربي — ثقة أكبر قبل السفر.","cat":"Conversation","level":"A1","main":true},{"title":"Acheter un billet de train à la gare. Dialogue. Niveau A1 de FLE. DELF A1. French dialog","channel":"La prof Elisabeth","videoId":"3FM7OutUxJ0","why":"حوار شراء تذكرة القطار بمستوى A1 من أستاذة FLE — سيناريو المحور نفسه.","cat":"Conversation","level":"A1","extra":true},{"title":"French for Beginners: Asking & Giving Directions | Super Easy French 147","channel":"Easy French","videoId":"ZKnn-l4mLLQ","why":"حلقة Super Easy French الأولى: السؤال عن الطريق في الشارع ببطء ووضوح.","cat":"Conversation","level":"A1","extra":true},{"title":"الفرنسية في الحياة اليومية: أهم كلمات السفر — في المطار (1) À L'AÉROPORT","channel":"الفرنسية مع سارة","videoId":"GSukarbSYHM","why":"مفردات المطار الأساسية مرتبة بترتيب الرحلة — مرجع عملي لدرس السفر.","cat":"Conversation","dur":10,"level":"A1","extra":true},{"title":"محادثة فرنسية في المطار — كيف تتحدث بالفرنسية في المطار","channel":"عالم اللغات مع أنس","videoId":"UW5epkNGOIo","why":"محادثة واقعية في المطار مع الترجمة — تدريب مواقف.","cat":"Conversation","dur":6,"level":"A1","extra":true}],"supplements":[{"id":"3FM7OutUxJ0","title":"Acheter un billet de train à la gare. Dialogue. Niveau A1 de FLE. DELF A1. French dialog","channel":"La prof Elisabeth","why":"حوار شراء تذكرة القطار بمستوى A1 من أستاذة FLE — سيناريو المحور نفسه.","lang":"fr"},{"id":"ZKnn-l4mLLQ","title":"French for Beginners: Asking & Giving Directions | Super Easy French 147","channel":"Easy French","why":"حلقة Super Easy French الأولى: السؤال عن الطريق في الشارع ببطء ووضوح.","lang":"fr"},{"id":"GSukarbSYHM","title":"الفرنسية في الحياة اليومية: أهم كلمات السفر — في المطار (1) À L'AÉROPORT","channel":"الفرنسية مع سارة","why":"مفردات المطار الأساسية مرتبة بترتيب الرحلة — مرجع عملي لدرس السفر.","dur":10,"lang":"ar"},{"id":"UW5epkNGOIo","title":"محادثة فرنسية في المطار — كيف تتحدث بالفرنسية في المطار","channel":"عالم اللغات مع أنس","why":"محادثة واقعية في المطار مع الترجمة — تدريب مواقف.","dur":6,"lang":"ar"}]}]},{"id":"a1-t20","slug":"l-heure-et-le-temps","icon":"file","color":"#059669","fr":"L'heure et le temps","ar":"الوقت","desc":"قل الساعة، حدد الموعد، وتحدث عن جدول يومك.","lessons":[{"id":"A1-t20-l1","fr":"Quelle heure est-il ?","ar":"كم الساعة؟","objectives":["قراءة الساعة بالعشرة والنصف والربع بالعربية والفرنسية","التعبير عن المواعيد اليومية بالساعة","السؤال عن الوقت عبر quelle heure والرد عليه","تمييز du matin / de l'après-midi / du soir في الجملة"],"sections":[{"h":"قول الساعة","p":["الوقت لغة يومية لا تُؤجَّل: quelle heure est-il ? (كم الساعة؟) سؤال يسبق كل موعد. الفيديو الأساسي بالشرح العربي يعرض القراءة بالعشرة والنصف والربع — استمع وأنت تنظر إلى ساعة حقيقية.","القراءة الأساسية: il est une heure (ساعة واحدة — يبقى une)، il est deux heures (ساعتان)، il est trois heures. لاحظ أن الفعل والعدد يظلان ثابتين مع il est.","الدقائق تُقرأ بعد الرقم: il est trois heures dix (الثالثة عشرة)، il est huit heures vingt-cinq. أما النصف والربع فلديهما صيغتان: il est trois heures et demie (الثالثة والنصف)، il est trois heures et quart (الثالثة والربع).","قبل الدقيقة الثلاثين تُستخدم avec: il est deux heures moins le quart (الثانية إلا ربعًا)، il est quatre heures moins dix (الخامسة إلا عشرًا). قاعدة واحدة: et للمجموعة الأولى، moins للمجموعة الثانية.","الفترات تُضاف للتفصيل: du matin (صباحًا)، de l'après-midi (بعد الظهر)، du soir (مساءً). il est huit heures du matin ≠ il est huit heures du soir — نفس الرقم ووقتان مختلفان تمامًا.","السؤال عن المواعيد مع الصفات: À quelle heure tu te lèves ? (في أي ساعة تستيقظ؟) — الجواب بجملة كاملة: Je me lève à sept heures. حرف الجر à مع الساعة جزء من القاعدة نفسها."],"video":{"id":"chM3yu9iMU0","title":"تعلم قراءة الساعة #2 للأطفال | تعليم الساعة والدقائق مع زكريا - اللغة العربية للأطفال","channel":"Learn with Zakaria - تعلم مع زكريا","why":"زكرياء يعلّم قراءة الساعة بالفرنسية بأسلوب الأطفال الهادئ — مدخل بلا توتر.","lang":"ar","main":true},"sub":[{"h":"القاعدة الأساسية","p":["il est + عدد + heures: il est deux heures.","una heure فقط مع الواحد: il est une heure.","Minutes بعد الرقم: il est dix heures quinze."]},{"h":"et demi(e) / et quart / moins","p":["et demie (نصف): il est deux heures et demie.","et quart (ربع): il est neuf heures et quart.","moins (قبل الدقيقة 30): il est trois heures moins le quart.","moins le quart = إلا ربعًا، moins dix = إلا عشرًا."]},{"h":"الفترات وأسئلة المواعيد","p":["du matin / de l'après-midi / du soir.","À quelle heure... ? — في أي ساعة؟","C'est l'heure de... — حان وقت...","tôt (مبكرًا)، tard (متأخرًا)، pile (تمامًا)."]}]},{"h":"نظام 24 ساعة","p":["في المواقف الرسمية (المحطات، البرامج) يستخدم الفرنسيون نظام 24: le train part à 14h30 (القطار يغادر 14:30) أي «كاتور-أور-ترانت».","ومع الأوقات: du matin (صباحاً)، de l'après-midi (ظهيرة)، du soir (مساءً): Il est 8h du soir = 20h.","الفيديو الإثرائي يعرض شاشة ساعة متحركة؛ أوقفه عند كل قراءة وردّدها قبل أن ينطقها. التنبؤ بالصوت هو أسرع طريق لإتقان الوقت."]},{"h":"جدولك اليومي","p":["أفعال يومية: se réveiller (يستيقظ)، se lever (يقوم من السرير)، prendre le petit-déjeuner (يتناول الفطور)، rentrer (يعود للبيت)، se coucher (ينام).","نموذج: «Je me lève à 6h30. Je prends mon petit-déjeuner à 7h. Je travaille de 8h à 16h. Je rentre à 17h et je me couche à 23h.»","تمرين اليد: انظر إلى ساعتك الآن واكتب الوقت بالفرنسية بالثلاث الصيغ (ساعة، دقايق، إلا/إلى). اقرأها بصوت مسموع — الوقت حاضر دائمًا في حياتك فلا عذر لتجاهله."]},{"h":"التطبيق والتلخيص","p":["يُتقن هذا الدرس أصغر وحدات الزمن وأكثرها استعمالًا: فقاعدة il est + heures تبقى ثابتة مع كل الأعداد ما عدا الواحدة (il est une heure)، والنصف والربع يردّدان et demie و et quart، وما قبل الدقيقة الثلاثين يتحوّل إلى moins (moins le quart، moins dix)، وتُميَّز الفترات بـ du matin و de l'après-midi و du soir فلا تلتبس الثامنة صباحًا بالثامنة مساءً، ويُضاف النظام الرسمي بعشرين ساعة (14h30) لقراءة جداول المحطات والبرامج، بينما تربط الأسئلة بـ «À quelle heure...؟» مع حرف الجر à، وتُوظَّف الأفعال الانعكاسية اليومية (se réveiller، se lever، se coucher) في جدول الروتين. كما وضح الفيديو الرئيسي «تعلم قراءة الساعة #2 للأطفال | تعليم الساعة والدقائق مع زكريا» قراءة العقربَين بالعشرة والنصف والربع بالنطق العربي الهادئ، يمنح هذا الدرس الطالب الطريقة نفسها لقراءة أي ساعة يراها في شاشة أو جدول.","يعود هذا الدرس إلى الأرقام التي أتقنها في a1-t1 وأسئلة a1-t10 (Quand ?) ويحوّلها إلى «À quelle heure...؟»، ويستعين بـ a1-t13 حين تصف خطتك المستقبلية بوقت محدد (Je vais partir à dix heures). وبعد إتقان الساعة يأتي جدول أوقات السفر: فمواعيد القطار والباص والمترو في a1-t21 تُقرأ الآن بالعشرة والنصف والربع وبـ moins le quart كما تعلمت هنا، وأنت جاهز لدخول أي محطة وقراءة لوحة المغادرة بثقة.","المهمة التطبيقية: أعد مشاهدة الفيديو الرئيسي، وأوقفه عند كل قراءة ساعة وردّدها قبل أن تسمع الصواب؛ ثم انظر إلى ساعة حقيقية أمامك الآن وسجّل نفسك تقرأ وقتها بثلاث صيغ (دقيقة كاملة، et demie أو et quart، moins إذا لزم)، ثم اقرأ جدول يومك من خمسة مواعيد (se lever، petit-déjeuner، travail، rentrer، se coucher) بنبرة هادئة — وبعد الاستماع صحّح فقط أخطاء et / moins وأعد التسجيل مرة واحدة."]}],"examples":[{"fr":"Il est sept heures et demie.","ar":"الساعة 7:30."},{"fr":"Le cours commence à 9 heures.","ar":"الحصة تبدأ الساعة 9."},{"fr":"Je me lève à six heures du matin.","ar":"أستيقظ الساعة 6 صباحاً."},{"fr":"On se retrouve à midi ?","ar":"نتقابل الظهيرة؟"},{"fr":"Il est trois heures et demie.","ar":"الساعة الثالثة والنصف.","note":"et demie"},{"fr":"Il est cinq heures moins le quart.","ar":"الساعة الخامسة إلا ربعاً.","note":"moins le quart"},{"fr":"À quelle heure tu arrives ?","ar":"في أي ساعة تصل؟","note":"سؤال"},{"fr":"Il est huit heures du soir.","ar":"الساعة الثامنة مساءً.","note":"الفترة"}],"pron":[{"w":"Quelle heure est-il ?","ipa":"[kɛl.œʁ.ɛ.til]","approx":"كيل-أور-إيتيل"},{"w":"et demie","ipa":"[e.də.mi]","approx":"إيه-دومي"},{"w":"se lever","ipa":"[sə.lə.ve]","approx":"سو-لوفيه"}],"vocab":[{"fr":"une heure","ar":"ساعة / وقت","pos":"nom","g":"f","pl":"des heures","ipa":"[œʁ]","exFr":"Il est une heure.","exAr":"الساعة 1."},{"fr":"se réveiller","ar":"يستيقظ","pos":"verbe","ipa":"[sə.ʁe.ve.je]","exFr":"Je me réveille à 6h.","exAr":"أستيقظ الساعة 6."},{"fr":"se coucher","ar":"ينام (يذهب للسرير)","pos":"verbe","ipa":"[sə.ku.ʃe]","exFr":"Je me couche tard.","exAr":"أنام متأخراً."},{"fr":"le petit-déjeuner","ar":"الفطور","pos":"nom","g":"m","pl":"des petits-déjeuners","ipa":"[pə.ti de.ʒø.ne]"},{"fr":"midi / minuit","ar":"الظهيرة / منتصف الليل","pos":"nom","g":"m","ipa":"[mi.di / mi.nɥi]","exFr":"On mange à midi.","exAr":"نأكل ظهراً."},{"fr":"tôt / tard","ar":"باكراً / متأخراً","pos":"adv","ipa":"[to / taʁ]","exFr":"Je rentre tard.","exAr":"أعود متأخراً."},{"fr":"l'heure","ar":"الساعة/الوقت","pos":"nom","g":"f","exFr":"Quelle heure est-il ?","ipa":"[œʁ]","exAr":"كم الساعة؟"},{"fr":"et demie","ar":"والنصف","pos":"locution","exFr":"Trois heures et demie.","ipa":"[e dəmi]","exAr":"الثالثة والنصف."},{"fr":"et quart","ar":"والربع","pos":"locution","exFr":"Neuf heures et quart.","ipa":"[e kaʁ]","exAr":"التاسعة والربع."},{"fr":"moins","ar":"إلا","pos":"prép","exFr":"Deux heures moins dix.","ipa":"[mwɛ̃]","exAr":"الثانية إلا عشرًا."},{"fr":"pile","ar":"تمامًا","pos":"adv","exFr":"Il est huit heures pile.","ipa":"[pil]","exAr":"الساعة الثامنة تمامًا."},{"fr":"le matin / le soir","ar":"الصباح / المساء","pos":"nom","g":"m","exFr":"Le matin, je cours.","ipa":"[matɛ̃]","exAr":"صباحاً أجري."},{"fr":"se lever","ar":"يستيقظ","pos":"verbe","g":"—","exFr":"Je me lève à six heures.","ipa":"[sə ləve]","exAr":"أستيقظ الساعة السادسة."}],"grammar":[{"tFr":"Dire l'heure","tAr":"القاعدة: قراءة الوقت","body":["il est + heures (ثابت مع كل الأعداد). النصف et demie، الربع et quart، وما قبل الدقيقة 30 يأتي avec moins.","الفترة (du matin/de l'après-midi/du soir) تُضاف عند اللبس، و à مع الساعة في الأسئلة والجواب."],"ex":[{"fr":"Il est six heures moins vingt.","ar":"الساعة السادسة إلا عشرين."},{"fr":"Je pars à sept heures du matin.","ar":"أغادر الساعة السابعة صباحاً."}]}],"mistakes":[{"wrong":"Il est une heures","right":"Il est une heure","why":"مع الواحد تبقى heure في المفرد."},{"wrong":"Il est huit heures et demi","right":"Il est huit heures et demie","why":"heure مؤنثة: demie لا demi."},{"wrong":"trois heures moins quart","right":"trois heures moins le quart","why":"العبارة ثابتة: moins le quart."},{"wrong":"Il est sept heures du matin/du soir بلا تمييز","right":"du matin / du soir","why":"الفترة ضرورية عند ذكر الصباح والمساء لتفادي اللبس."}],"dialogues":[{"title":"تحديد موعد","ctx":"شخصان يتفقان على ساعة اللقاء","lines":[{"who":"Lina","fr":"Il est quelle heure maintenant ?","ar":"كم الساعة الآن؟"},{"who":"Omar","fr":"Il est dix heures et demie.","ar":"الساعة العاشرة والنصف."},{"who":"Lina","fr":"On se voit à quelle heure ?","ar":"نلتقي في أي ساعة؟"},{"who":"Omar","fr":"À trois heures moins le quart, chez moi.","ar":"الساعة الثالثة إلا ربعاً، عندي."},{"who":"Lina","fr":"D'accord, je suis libre à cette heure-là.","ar":"حسناً، أنا حرة في هذا الوقت."}]}],"exercises":[{"t":"mcq","skill":"grammar","q":"بمنهجية قراءة الساعة في الفيديو: «الساعة الرابعة إلا عشر دقائق» بالفرنسية:","opts":["Il est quatre heures moins dix","Il est quatre heures et dix","Il est quatre heures dix","Il est trois heures moins dix"],"a":0,"why":"قبل الدقيقة الثلاثين يُستعمل moins: moins dix = إلا عشرًا."},{"t":"mcq","skill":"vocabulary","q":"«الساعة 3:30» بالفرنسية:","opts":["Il est trois heures moins le quart","Il est trois heures et demie","Il est trois et demi heures","Il est trois heures quart"],"a":1,"why":"et demie = ونصف."},{"t":"fill","skill":"vocabulary","q":"أكمل: «Je me ___ à 6h30.» (أستيقظ)","fr":"Je me ___ à 6h30.","ans":"réveille","why":"se réveiller = يستيقظ."},{"t":"listen","skill":"listening","q":"استمع للساعة واخترها:","audio":"Il est huit heures et quart","opts":["8:15","8:45","8:30","7:15"],"a":0,"why":"الاستماع يثبّت منهجية moins في قراءة الساعة كما عرضها الفيديو."},{"t":"translate","skill":"writing","q":"ترجم: «الحصة تبدأ الساعة 9.»","ans":"Le cours commence à 9 heures.","alts":["le cours commence a neuf heures"],"why":"التمرين يطبّق قواعد النصف والساعة كما في الشرح."},{"t":"writing","skill":"writing","q":"اكتب جدول يومك: 5 جمل بأوقات مختلفة (se lever, manger, travailler...).","min":15,"kw":["heures","je"],"sample":"Je me lève à 6h. Je prends mon petit-déjeuner à 7h. Je travaille de 8h à 16h. Je rentre à 17h. Je me couche à 23h.","why":"نطق الوقت بصوتك يثبّت الترتيب العددي من a1-t4."},{"t":"mcq","skill":"grammar","q":"اقرأ: «Il est trois heures et demie» =","opts":["الثالثة والنصف","الثالثة والربع","الثالثة إلا ربعًا","العاشرة والنصف"],"a":0,"why":"et demie = والنصف."},{"t":"fill","skill":"grammar","q":"أكمل: «Il est deux heures ___ quart.»","fr":"Il est deux heures ___ quart.","ans":"moins","why":"قبل الدقيقة 30: moins le quart."}],"homework":"اسأل 3 أشخاص عن مواعيدهم اليومية بالفرنسية واكتب أجوبتهم. الدرس السابق/التالي: a1-t19 (Un billet pour Paris — السفر) ← a1-t20 (Quelle heure est-il ? — الوقت) → a1-t21 (Prendre le bus et le métro — النقل).","sources":[{"title":"تعلم قراءة الساعة #2 للأطفال | تعليم الساعة والدقائق مع زكريا - اللغة العربية للأطفال","channel":"Learn with Zakaria - تعلم مع زكريا","videoId":"chM3yu9iMU0","why":"زكرياء يعلّم قراءة الساعة بالفرنسية بأسلوب الأطفال الهادئ — مدخل بلا توتر.","cat":"Vocabulaire","level":"A1","main":true},{"title":"Comment on dit #1 Dire l'heure en français A1 ⌚","channel":"Tout en français","videoId":"5wH0W88MiT0","why":"درس Tout en français لقول الساعة بمستوى A1 — قواعد الساعة والنصف والربع.","cat":"Vocabulaire","level":"A1","extra":true},{"title":"Telling the time in French! [Perfect for beginners]","channel":"Learn French With Alexa","videoId":"K4wskRR0cxs","why":"درس Alexa الشامل للتوقيت — يربط الساعة بالمواعيد والجداول اليومية.","cat":"Vocabulaire","level":"A1","extra":true},{"title":"كيف أقرأ الساعة باللغة الفرنسية — من الصفر للمبتدئين","channel":"le français avec nabila — الفرنسية مع نبيلة","videoId":"lv5iWfRF1fk","why":"شرح قراءة الساعة خطوة بخطوة من القناة المعتمدة — مرجع أساسي لدرس الوقت.","cat":"Vocabulaire","dur":16,"level":"A1","extra":true},{"title":"تعليم الفرنسية للمبتدئين #30: الساعة L'heure","channel":"فرنشاوي Frenchawy","videoId":"7PyyY1uqH-Q","why":"شرح الساعة بأسلوب مختصر ومباشر — مراجعة سريعة قبل التمارين.","cat":"Vocabulaire","dur":6,"level":"A1","extra":true}],"supplements":[{"id":"5wH0W88MiT0","title":"Comment on dit #1 Dire l'heure en français A1 ⌚","channel":"Tout en français","why":"درس Tout en français لقول الساعة بمستوى A1 — قواعد الساعة والنصف والربع.","lang":"fr"},{"id":"K4wskRR0cxs","title":"Telling the time in French! [Perfect for beginners]","channel":"Learn French With Alexa","why":"درس Alexa الشامل للتوقيت — يربط الساعة بالمواعيد والجداول اليومية.","lang":"fr"},{"id":"lv5iWfRF1fk","title":"كيف أقرأ الساعة باللغة الفرنسية — من الصفر للمبتدئين","channel":"le français avec nabila — الفرنسية مع نبيلة","why":"شرح قراءة الساعة خطوة بخطوة من القناة المعتمدة — مرجع أساسي لدرس الوقت.","dur":16,"lang":"ar"},{"id":"7PyyY1uqH-Q","title":"تعليم الفرنسية للمبتدئين #30: الساعة L'heure","channel":"فرنشاوي Frenchawy","why":"شرح الساعة بأسلوب مختصر ومباشر — مراجعة سريعة قبل التمارين.","dur":6,"lang":"ar"}]}]},{"id":"a1-t21","slug":"les-transports","icon":"briefcase","color":"#059669","fr":"Les transports","ar":"المواصلات","desc":"الباص، المترو، سيارة الأجرة: كيف تتنقل في المدينة.","lessons":[{"id":"A1-t21-l1","fr":"Prendre le bus et le métro","ar":"ركوب الباص والمترو","objectives":["اختيار وسيلة النقل المناسبة ووصفها","التعبير عن الانتقال بالـ se rendre + en/à pied","فهم إعلانات النقل العام (الخط، الوجهة، التذكرة)","استخدام passé composé في رحلة ماضية قصيرة"],"sections":[{"h":"وسائل النقل","p":["المواصلات هي آخر حلقة قبل المستوى A2: موقف يومي متكرر يجمع الوقت والمكان والسعر والسؤال. الفيديو الأساسي بالشرح العربي يعرض حوارًا في محطة المترو — استمع وحدّد كلمات الاتجاه واسم الخط.","الوسائط تُحفظ بالمعدود: le train (القطار)، le bus (الحافلة)، le métro (المترو)، le tramway (الترامواي)، l'avion (الطائرة)، un taxi (سيارة أجرة)، un vélo (دراجة). لاحظ أن بعضها بلا أداة لصقة (le métro لا un).","السؤال عن الوصول: Comment je vais à la gare ? (كيف أذهب إلى المحطة؟)، Je vais en bus / à pied / en taxi (وسيلة النقل مع en، والسير بقدمي à pied). قاعدة صغيرة تُستخدم كل يوم.","التذكرة والمعلومة: un ticket (تذكرة)، un abonnement (اشتراك شهري)، la carte (البطاقة)، la station (المحطة)، la ligne 4 (الخط 4)، direction (الاتجاه: direction La Défense).","وصف رحلة سابقة يعود لـ passé composé: Je suis monté dans le métro (ركبت المترو)، J'ai pris le bus (أخذت الحافلة)، Nous sommes arrivés en retard (وصلنا متأخرين). الفعل شاذ لكنه هنا في جملة حقيقية.","سلوك النقل العام مهم لغويًا:Bonjour à vous (تحية الصعود)، Excusez-moi (تنبيه لطيف)، La place est libre ? (المكان شاغر؟)، Je descends à la prochaine (أنزل في المحطة القادمة). هذه الجمل تُنقذ موقفك الحافلة أول أسبوع."],"video":{"id":"Fjp0uqJGBJc","title":"وسائل النقل باللغة الفرنسية","channel":"الأنيس","why":"الأنيس يقدم وسائل النقل بالصوت والصورة — تثبيت مفردات بصري سريع.","lang":"ar","main":true},"sub":[{"h":"وسائل النقل","p":["le train — القطار، le métro — المترو، le bus — الحافلة.","le tramway — الترامواي، l'avion — الطائرة، un vélo — الدراجة.","un taxi — سيارة الأجرة، un bateau — القارب، à pied — سيرًا."]},{"h":"كيف تصل؟","p":["Comment je vais à... ? — كيف أصل إلى...؟","Je vais en bus / en métro / en taxi.","Je vais à pied. — أذهب سيرًا.","Je prends la ligne 4 direction nord."]},{"h":"في الحافلة والمحطة","p":["Un ticket, s'il vous plaît. — تذكرة من فضلك.","La place est libre ? — هل المكان شاغر؟","Je descends à la prochaine. — أنزل في القادمة.","C'est la dernière station ? — هل هي المحطة الأخيرة؟"]}]},{"h":"في المحطة والباص","p":["l'arrêt de bus (محطة الباص)، la ligne (الخط): «Quel bus va au centre-ville ?» (أي باص يذهب للمركز؟).","وللسائق: Un ticket, s'il vous plaît (تذكرة من فضلك). C'est quel arrêt pour le musée ? (أي محطة للمتحف؟).","لقطات الفيديو الإثرائي تعرض لوحات الاتجاه فعلية؛ أوقفه واقرأ اسم الخط والمDirection بصوت مسموع — مهارة قراءة المحطة لا تُكتسب إلا بالمشاهدة."]},{"h":"المدينة والاتجاهات","p":["le centre-ville (مركز المدينة)، la rue (الشارع)، l'avenue (الشارع الكبير)، le carrefour (التقاطع)، le coin (الزاوية): «À l'angle de la rue» (عند زاوية الشارع).","وللتفهم: «C'est par là ?» (هل من هناك؟) — «Non, c'est par ici» (لا، من هنا).","التمرين الأخير: صف رحلة بالأمس بالفرنسية في أربع جمل (passé composé). به تربط كل ما تعلمته في A1 بجملة واحدة متكاملة."]},{"h":"التطبيق والتلخيص","p":["يُغلق هذا الدرس سلّم A1 بحزمة التنقّل اليومي: فوسائل النقل تُحفظ بالمعدود الصحيح (le métro، le bus، le train، le tramway، un taxi، un vélo، l'avion)، وطريقة الوصول تفرّق بين en (en bus، en métro، en taxi) وبين à pied و à vélo بلا en، ويُبنى السؤال على «Comment je vais à...؟» مع اسم الخط والاتجاه (la ligne 4 direction nord)، وتُضبط التذكرة والاشتراك (un ticket، un abonnement)، ويُروى رحلة الأمس بـ passé composé مع الأفعال الشاذة (Je suis monté، J'ai pris، Nous sommes arrivés)، وتُضيف عبارات السلوك في الحافلة (La place est libre ?، Je descends à la prochaine). كما وضح الفيديو الرئيسي «وسائل النقل باللغة الفرنسية» من قناة الأنيس أسماء الوسائل وصورها ونطقها، يمنح هذا الدرس الطالب الجاهزية للتنقّل المستقل في المدينة الفرانكوفونية.","بهذا تُكمل سلسلة A1 كاملة من منظور واحد متصل: بدأت الحروف والتأسيس الصوتي في a1-t1، وبناء الجملة بـ être في a1-t2، والحياة اليومية في a1-t3، والضمائر في a1-t4، والأدوات في a1-t5، والجنس في a1-t6، والجمع في a1-t7، والصفات في a1-t8، والنفي في a1-t9، والأسئلة في a1-t10، وأفعال المجموعة الأولى في a1-t11، والقدرة والرغبة والوجوب في a1-t12، والمستقبل القريب في a1-t13، والماضي المركّب في a1-t14، والمطعم في a1-t15، والتسوق في a1-t16، والمنزل في a1-t17، والعمل في a1-t18، والسفر في a1-t19، والوقت في a1-t20، ثم النقل في a1-t21؛ وبذلك تكمل سلسلة A1 الكاملة — الحروف والقواعد والمواقف — والجاهز لـ A2.","المهمة التطبيقية: أعد مشاهدة الفيديو الرئيسي كاملًا وحدّد كل وسيلة بأداة الجرّ الصحيحة؛ ثم سجّل رحلة حقيقية قمت بها بالأمس أو ستفعلها غدًا في ست جمل مسموعة: تبدأ بالوجهة ووسيلة النقل (Je vais... en bus)، وتذكر الخط والاتجاه، وتشرح التذكرة، وتضيف جملة واحدة بالـ passé composé عن رحلة سابقة (Je suis monté...)، وتُغلق الجملة بشكر أو سؤال لطيف. استمع للتسجيل وصحّح أخطاء الأدوات وحدها؛ فمن تصحّحه أنت تُثبت ما تعلّمته في A1 كلّه."]}],"examples":[{"fr":"Je prends le bus numéro 12.","ar":"أركب الباص رقم 12."},{"fr":"Quel bus va à l'aéroport ?","ar":"أي باص يذهب للمطار؟"},{"fr":"Je vais au travail à pied.","ar":"أذهب للعمل مشياً."},{"fr":"Le métro est plus rapide.","ar":"المترو أسرع."},{"fr":"Je vais au travail en métro.","ar":"أذهب إلى العمل بالمترو.","note":"وسيلة + en"},{"fr":"Comment je vais à l'aéroport ?","ar":"كيف أصل إلى المطار؟","note":"سؤال"},{"fr":"Nous sommes montés dans le bus.","ar":"ركبنا الحافلة.","note":"passé composé + être"},{"fr":"Je descends à la prochaine station.","ar":"أنزل في المحطة التالية.","note":"في الحافلة"}],"pron":[{"w":"le métro","ipa":"[le.me.tʁo]","approx":"لو-ميطرو"},{"w":"l'arrêt","ipa":"[la.ʁɛ]","approx":"لاريه"},{"w":"à pied","ipa":"[a.pje]","approx":"آ-بييه","note":"d صامتة"}],"vocab":[{"fr":"prendre le bus","ar":"يركب الباص","pos":"expression","ipa":"[pʁɑ̃dʁ lə.bys]","exFr":"Je prends le bus chaque jour.","exAr":"أركب الباص كل يوم."},{"fr":"un arrêt","ar":"محطة (باص)","pos":"nom","g":"m","pl":"des arrêts","ipa":"[a.ʁɛ]","exFr":"C'est le prochain arrêt.","exAr":"إنها المحطة القادمة."},{"fr":"une ligne","ar":"خط","pos":"nom","g":"f","pl":"des lignes","ipa":"[liɲ]","exFr":"La ligne 5 va au centre.","exAr":"الخط 5 يذهب للمركز."},{"fr":"le centre-ville","ar":"مركز المدينة","pos":"nom","g":"m","pl":"les centres-villes","ipa":"[sɑ̃.tʁ.vil]","exFr":"Le centre-ville est animé.","exAr":"مركز المدينة حيوي."},{"fr":"à pied","ar":"على القدمين","pos":"expression","ipa":"[a.pje]","exFr":"Je vais à pied.","exAr":"أذهب مشياً."},{"fr":"rapide","ar":"سريع","pos":"adj","g":"mf","ipa":"[ʁa.pid]","exFr":"Le train est rapide.","exAr":"القطار سريع."},{"fr":"le transport","ar":"النقل","pos":"nom","g":"m","exFr":"Les transports en commun.","ipa":"[tʁɑ̃spɔʁ]","exAr":"وسائل النقل العام."},{"fr":"la gare","ar":"المحطة الكبرى","pos":"nom","g":"f","exFr":"La gare est loin ?","ipa":"[ɡaʁ]","exAr":"المحطة بعيدة؟"},{"fr":"le métro","ar":"المترو","pos":"nom","g":"m","exFr":"Je prends le métro.","ipa":"[metʁo]","exAr":"أركب المترو."},{"fr":"en bus / à pied","ar":"بالحافلة / سيرًا","pos":"locution","exFr":"J'y vais en bus.","ipa":"[ɑ̃ bɥs]","exAr":"أذهب بالحافلة."},{"fr":"une station","ar":"محطة","pos":"nom","g":"f","exFr":"Descendre à la station suivante.","ipa":"[stasjɔ̃]","exAr":"أنزل في المحطة التالية."},{"fr":"direction","ar":"الاتجاه","pos":"nom","g":"f","exFr":"Direction centre-ville.","ipa":"[diʁɛksjɔ̃]","exAr":"الاتجاه نحو وسط المدينة."},{"fr":"un ticket","ar":"تذكرة","pos":"nom","g":"m","exFr":"J'ai acheté un ticket.","ipa":"[tikɛ]","exAr":"اشتريت تذكرة."},{"fr":"monter / descendre","ar":"يركب / ينزل","pos":"verbe","g":"—","exFr":"Je descends ici.","ipa":"[mɔ̃te]","exAr":"أنزل هنا."}],"grammar":[{"tFr":"Moyens de transport","tAr":"القاعدة: أسلوب وصف التنقل","body":["الوسيلة مع en: en bus, en métro, en taxi — ما عدا à pied (سيرًا) وà vélo (بالدراجة).","se rendre + مكان = يذهب إلى: Je me rends au travail (أذهب إلى العمل) — صيغة رسمية مفيدة."],"ex":[{"fr":"Je vais à pied jusqu'à la gare.","ar":"أسير حتى المحطة."},{"fr":"Elle va au bureau en tramway.","ar":"تذهب إلى المكتب بالترامواي."}]}],"mistakes":[{"wrong":"Je vais en à pied","right":"Je vais à pied","why":"à pied جملة قائمة بلا en."},{"wrong":"en le bus","right":"en bus","why":"الوسيلة مع en تأتي بلا أداة."},{"wrong":"J'ai allé en bus","right":"Je suis allé en bus","why":"aller في passé composé مع être."},{"wrong":"une gare vs une station (خلط)","right":"la gare (قطار) / la station (مترو أو حافلة)","why":"الاسم يحدد بنوع النقل — لا تُستبدل."}],"dialogues":[{"title":"البحث عن المحطة","ctx":"سائح يسأل عن المترو","lines":[{"who":"Yasmine","fr":"Excusez-moi, comment je vais au centre-ville ?","ar":"عفواً، كيف أصل إلى وسط المدينة؟"},{"who":"Passant","fr":"Vous prenez la ligne 2 direction nord.","ar":"تأخذ الخط 2 باتجاه الشمال."},{"who":"Yasmine","fr":"La station est loin d'ici ?","ar":"المحطة بعيدة من هنا؟"},{"who":"Passant","fr":"Non, c'est à cinq minutes à pied.","ar":"لا، تبعد خمس دقائق سيرًا."},{"who":"Yasmine","fr":"Merci beaucoup ! Il me faut un ticket.","ar":"شكراً جزيلاً! أحتاج تذكرة."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"«أركب المترو» بالفرنسية:","opts":["Je mange le métro","Je prends le métro","Je vais le métro","Je suis le métro"],"a":1,"why":"prendre + وسيلة النقل."},{"t":"fill","skill":"vocabulary","q":"أكمل: «Je vais au travail à ___» (مشياً)","fr":"Je vais au travail à ___.","ans":"pied","why":"à pied = على القدمين."},{"t":"translate","skill":"writing","q":"ترجم: «أي باص يذهب للمطار؟»","ans":"Quel bus va à l'aéroport ?","alts":["quel bus va a l aeroport"],"why":"الترجمة تربط وسيلة النقل بمكانها — مفردات الفيديو الأساسية."},{"t":"listen","skill":"listening","q":"استمع لإعلان في الحافلة واختر معناه:","audio":"Je descends à la prochaine station","opts":["أنزل في المحطة التالية","أركب في المحطة التالية","هذه المحطة الأخيرة","المحطة بعد المحطة"],"a":0,"why":"descendre = ينزل، و la prochaine station = المحطة التالية."},{"t":"mcq","skill":"grammar","q":"أكمل: «Le train est ___ que le bus.» (أسرع)","opts":["plus rapide","rapide plus","très rapide","plus vite"],"a":0,"why":"التفضيل: plus + صفة."},{"t":"speaking","skill":"speaking","q":"قل: «أركب الباص رقم 12 كل يوم».","target":"Je prends le bus numéro douze chaque jour","why":"وصف رحلتك اليومية يدمج المواصلات a1-t21 والوقت a1-t20 والمدينة."},{"t":"mcq","skill":"grammar","q":"الصيغة الصحيحة؟","opts":["à pied","en pied","au pied","de pied"],"a":0,"why":"السير à pied بلا en."},{"t":"translate","skill":"writing","q":"ترجم: «أذهب إلى العمل بالمترو.»","ans":"Je vais au travail en métro.","alts":["je vais au travail en metro"],"why":"المكان مع au/à والوسيلة مع en."}],"homework":"اكتب كيف تذهب من بيتك إلى العمل/الجامعة بالفرنسية: 5 خطوات (Je prends... puis...). الدرس السابق/التالي: a1-t20 (Quelle heure est-il ? — الوقت) ← a1-t21 (Prendre le bus et le métro — النقل). أكملت سلسلة A1 (a1-t1→a1-t21) — التالي: مستوى A2.","sources":[{"title":"وسائل النقل باللغة الفرنسية","channel":"الأنيس","videoId":"Fjp0uqJGBJc","why":"الأنيس يقدم وسائل النقل بالصوت والصورة — تثبيت مفردات بصري سريع.","cat":"Vocabulaire","level":"A1","main":true},{"title":"Pratique le français courant dans le métro et le bus 🚇 ✅","channel":"Français Plus Facile","videoId":"tMMeuOjFvQQ","why":"تدريب محادثة حقيقية في المترو والباص — عبارات التنقل اليومية المتكررة.","cat":"Vocabulaire","level":"A1","extra":true},{"title":"Demander son chemin en français 🇫🇷 | Directions French Dialogue A1/A2","channel":"Learn French for Beginners","videoId":"rTBIOFTzWhg","why":"حوار السؤال عن الاتجاهات بمستوى A1/A2 — يغلق رحلة A1 بإتقان المدينة.","cat":"Vocabulaire","level":"A1","extra":true},{"title":"أسماء وسائل النقل والمواصلات — Les moyens de transport","channel":"Améliore ton français avec wafa","videoId":"Eg7fh0cGy7Q","why":"قائمة وسائل النقل مترجمة مع صور — تثبيت مفردات الدرس.","cat":"Vocabulaire","dur":4,"level":"A1","extra":true},{"title":"تعليم الفرنسية للمبتدئين #87: وسائل المواصلات والأفعال المستخدمة معها","channel":"فرنشاوي Frenchawy","videoId":"1vo5MwvfCQg","why":"يضيف الأفعال المرتبطة بكل وسيلة نقل (prendre un train...) — إثراء مهم للاستعمال.","cat":"Vocabulaire","dur":19,"level":"A1","extra":true}],"supplements":[{"id":"tMMeuOjFvQQ","title":"Pratique le français courant dans le métro et le bus 🚇 ✅","channel":"Français Plus Facile","why":"تدريب محادثة حقيقية في المترو والباص — عبارات التنقل اليومية المتكررة.","lang":"fr"},{"id":"rTBIOFTzWhg","title":"Demander son chemin en français 🇫🇷 | Directions French Dialogue A1/A2","channel":"Learn French for Beginners","why":"حوار السؤال عن الاتجاهات بمستوى A1/A2 — يغلق رحلة A1 بإتقان المدينة.","lang":"fr"},{"id":"Eg7fh0cGy7Q","title":"أسماء وسائل النقل والمواصلات — Les moyens de transport","channel":"Améliore ton français avec wafa","why":"قائمة وسائل النقل مترجمة مع صور — تثبيت مفردات الدرس.","dur":4,"lang":"ar"},{"id":"1vo5MwvfCQg","title":"تعليم الفرنسية للمبتدئين #87: وسائل المواصلات والأفعال المستخدمة معها","channel":"فرنشاوي Frenchawy","why":"يضيف الأفعال المرتبطة بكل وسيلة نقل (prendre un train...) — إثراء مهم للاستعمال.","dur":19,"lang":"ar"}]}]}]},{"code":"A2","ar":"الأولوي","fr":"Élémentaire","desc":"أول مستوى منظّم في مسارات: القراءة 📖، القصص التعليمية 📚، القواعد ✏️، المحادثة 🗣️، الاستماع 🎧، والكتابة والتعبير ✒️ — كل مسار دروس متكاملة بفيديوهات مدمجة وشرح عربي وتمارين.","color":"#16a34a","order":3,"tracks":[{"id":"a2-t1","slug":"reading","icon":"📖","color":"#059669","fr":"Lecture","ar":"مسار القراءة","desc":"طوّر مهارة الفهم القرائي: نصوص الحياة اليومية، الرسائل والإيميلات، والإعلانات والقوائم والجداول — كما تطلبها امتحانات DELF A2.","lessons":[{"id":"A2-t1-l1","fr":"Lire des textes courts","ar":"قراءة النصوص القصيرة عن الحياة اليومية","objectives":["قراءة نص قصير وفهم فكرته العامة من أول تمريرة","استخراج المعلومات الأساسية (من؟ أين؟ متى؟ ماذا؟)","استخدام كلمات الربط كخريطة للنص"],"sections":[{"h":"كيف تقرأ نصاً فرنسياً بذكاء؟","p":["القراءة الذكية ليست معرفة كل كلمة. اقرأ النص مرتين: التمريرة الأولى للفكرة العامة (من؟ أين؟ ما الموضوع؟) دون التوقف عند الكلمات الغريبة، والتمريرة الثانية لاستخراج التفاصيل المطلوبة منك فقط. هذه هي استراتيجية امتحانات DELF حرفياً.","استفد من الكلمات المشتركة (mots apparentés): «restaurant، famille، important، national» تعني نفسها تقريباً. والكلمات الربطية (d'abord, ensuite, mais, parce que) تروي لك منطق النص حتى لو نسيت بعض المفردات. بين لغتين متشابكتين تاريخياً، جسر المفردات أقصر مما تتخيل.","تابع الفيديو الأساسي بالشرح العربي عملياً: كيف يمسح المدرّس النص بعينه وكيف يتخطى ما لا يعرفه دون تردد. الملاحظة أن المفهم الحقيقي لا يترجم كلمة كلمة — بل يبني «ترجيحات» ثم يتحقق منها في الجملة التالية.","سؤال الفكرة العامة يجيب عليه غالبًا العنوان أو الجملة الأولى أو الأخيرة. هذه الثلاث نقاط هي خريطة أي نص قصير: العنوان يَعِد، البداية تُقدِّم، النهاية تُلخِّص. جرّبها على أي فقرة تصادفها اليوم.","الكلمات المشتركة ليست وحدها: الأرقام والتواريخ والأسماء المألوفة (Paris، le café، Madame) تمسك بها عينك فورًا وتثبّت لك مكانك في النص. حتى لو لم تعرف الفعل، معرفة «ساعة ونصف» أو «الاثنين» قد تكفي للإجابة.","القاعدة العملية: اقرأ السؤال قبل النص دائمًا. السؤال يحوّل القراءة من «فهم كل شيء» إلى «بحث مُوجَّه» — وفرق هذه الحيلة في الامتحان قد يكون درجتين كاملتين."],"video":{"id":"VlRTCx6S6Iw","title":"Apprendre à lire le français: texte court et facile","channel":"Prof Youssef Talbi","why":"قراءة موجهة لنص قصير بشرح عربي — يعرض الطريقة الصحيحة: اقرأ ثم فهم ثم تحقق، وهي مدخلك الأول لقراءة فرنسية واعية.","lang":"ar","main":true},"sub":[{"h":"القراءة بمرتبتين: خطة التنفيذ","p":["التمريرة الأولى: 30 ثانية — العنوان + أول وآخر جملة + الأرقام الظاهرة.","التمريرة الثانية: قراءة السؤال ثم المسح بحثاً عن الكلمة المفتاحية فقط.","لا تترجم أبداً أثناء المرتين — الترجمة تقتل السرعة وتستهلك الوقت."]},{"h":"جسور المعرفة في النص","p":["الكلمات الفرنسية الإنجليزية المشتركة: restaurant, famille, national, important.","الكلمات الربطية كعلامات طريق: d'abord → ensuite → enfin.","الاستعلام بالسياق: كلمة غريبة بين معلومتين معروفتين = استنتاج لا حفظ."]},{"h":"تمارين DELF النموذجية","p":["Vrai ou Faux (صح/خطأ): عبارات مأخوذة حرفياً من النص.","Choix multiple (اختيار من متعدد): أربعة خيارات، ثلاثة منها تفصيلات مشوِّشة.","Catégorisation (تصنيف): صِل كل عبارة بالفقرة التي وردت فيها."]}]},{"h":"نص نموذجي: يوم في حياة ياسمين","p":["اقرأ هذا النص ثم أجب عن الأسئلة بعده: «Yasmine se réveille à six heures et demie. D'abord, elle prend une douche rapide. Ensuite, elle boit son café et elle mange une tartine. À sept heures et quart, elle prend le bus. Elle travaille dans une boulangerie jusqu'à quinze heures. Le soir, elle regarde des séries avec sa sœur.»","أسئلة النموذج: 1) متى تستيقظ ياسمين؟ 2) أين تعمل؟ 3) ماذا تفعل مساءً؟ لاحظ كيف أجابتك موجودة حرفياً تقريباً في النص — في A2 الهدف هو «إيجاد» المعلومة لا «تحليلها».","بعد الإجابة، صحّح بنفسك من النص لا من ذاكرتك: ضع إصبعك على الجملة التي أثبتت كل إجابة. إن لم تجد الجملة فلم تفهم بعد — هذه هي المراجعة الصامتة التي يتقنها المتفوقون."],"video":null},{"h":"كلمات الربط: خريطة النص","p":["الكلمات الربطية تلمح لك ترتيب الأحداث: d'abord (أولاً)، ensuite/puis (ثم)، après (بعد)، enfin (أخيراً) للترتيب الزمني. et, mais, donc (و، لكن، لذلك) للربط المنطقي. parce que (لأن) تسبق السبب دائماً.","عند قراءة أي نص، ضع دائماً ذهنية على هذه الكلمات: هي علامات الطريق التي تخبرك «أين نحن في القصة». في تمارين DELF A2، أكثر من نصف الأسئلة تُحل بمجرد تعقب هذه الكلمات.","تمرين عملي: خذ كلمات الربط من نص إعلان حقيقي (قائمة متجر أو صفحة أخبار) وارتب كل كلمة بجواب: هل هي ترتيب أم سبب أم تناقض؟ سريعاً وبلا كتابة."],"video":null},{"h":"التطبيق والتلخيص","p":["يلخّص هذا الدرس استراتيجية القراءة الذكية في مستوى A2: تمريرة أولى للفكرة العامة (العنوان وأول وآخر جملة والأرقام الظاهرة)، وتمريرة ثانية لاستخراج المعلومة المطلوبة وحدها، مع الاعتماد على كلمات الربط d'abord و ensuite و parce que كعلامات طريق وعلى الكلمات المشتركة كجسور فورية، وقاعدة قراءة السؤال قبل النص لتحويل القراءة إلى بحث موجَّه. كما وضح الفيديو الرئيسي «Apprendre à lire le français: texte court et facile» من قناة «Prof Youssef Talbi»، يمسح المدرّس النص بعينه ثم يتخطّى ما لا يعرفه دون ترجمة كلمة كلمة، ويبني ترجيحات ثم يتحقق منها في الجملة التالية — وهو الترتيب نفسه الذي طبّقته على نص «يوم في حياة ياسمين».","الجسر التعليمي داخل خريطة المستوى، بالترتيب: a2-t1-l1 (قراءة النصوص القصيرة) ← a2-t1-l2 (قراءة الرسائل والإيميلات) ← a2-t1-l3 (الإعلانات وقوائم الطعام والجداول) ← a2-t2-l1 (قصة يوم في حياة سامي) ← a2-t2-l2 (قصة عطلة لايلا) ← a2-t2-l3 (حكاية الأسد والفأر) ← a2-t3-l1 (الماضي المركب مقابل الناقص). هذا الدرس هو أول حلقة فيه؛ فهو يمنح البحث الموجَّه وكلمات الربط التي ستقرأ بها الرسالة في a2-t1-l2 ثم الإعلان والقائمة والجدول في a2-t1-l3، ثم وصف أحداث يوم كامل بالمضارع في a2-t2-l1، والعطلة بالزمن الماضي في a2-t2-l2، والحكاية بأزمنة ثلاثة معاً في a2-t2-l3، وتأطير كل ذلك نحويًا في a2-t3-l1.","أعد مشاهدة الفيديو الرئيسي مركّزًا على نموذج المسح الأولي الذي يعرضه المشرح، ثم سجّل نفسك وأنت تقرأ نصاً قصيراً من اختيارك بمرتبتين وتستخرج منه بأعلى صوت ثلاثة أجوبة (من؟ أين؟ متى؟) مع الاستشهاد بالجملة الداعمة لكل إجابة، وصحّح أي إجابة لا تجد لها شاهداً في النص قبل أن تنتقل إلى a2-t1-l2."]}],"examples":[{"fr":"D'abord, elle prend une douche.","ar":"أولاً، تأخذ دشاً سريعاً."},{"fr":"Ensuite, elle boit son café.","ar":"ثم تشرب قهوتها."},{"fr":"Elle travaille jusqu'à quinze heures.","ar":"تعمل حتى الخامسة عصراً."},{"fr":"Parce qu'elle aime son métier.","ar":"لأنها تحب مهنتها."},{"fr":"D'abord je lis le titre, ensuite je lis le texte.","ar":"أولاً أقرأ العنوان، ثم أقرأ النص.","note":"المرتبتان"},{"fr":"Je ne comprends pas ce mot, mais je continue.","ar":"لا أفهم هذه الكلمة، لكنني أستأنف.","note":"الاستمرار بلا تجمد"},{"fr":"La réponse est dans la deuxième phrase.","ar":"الجواب في الجملة الثانية.","note":"البحث الموجَّه"},{"fr":"Ce texte parle de la vie quotidienne.","ar":"هذا النص يتحدث عن الحياة اليومية.","note":"الفكرة العامة"}],"pron":[{"w":"d'abord","ipa":"[da.bɔʁ]","approx":"دابور"},{"w":"ensuite","ipa":"[ɑ̃.sɥit]","approx":"آن-سويت"},{"w":"jusqu'à","ipa":"[ʒys.ka]","approx":"جوس-كا"}],"vocab":[{"fr":"d'abord","ar":"أولاً","pos":"adv","ipa":"[da.bɔʁ]","exFr":"D'abord, je lis le titre.","exAr":"أولاً أقرأ العنوان."},{"fr":"ensuite","ar":"ثم / بعدها","pos":"adv","ipa":"[ɑ̃.sɥit]","exFr":"Ensuite, je cherche les détails.","exAr":"بعدها أبحث عن التفاصيل."},{"fr":"enfin","ar":"أخيراً","pos":"adv","ipa":"[ɑ̃.fɛ̃]","exFr":"Enfin, je vérifie mes réponses.","exAr":"أخيراً أتحقق من إجاباتي."},{"fr":"jusqu'à","ar":"حتى (زمناً)","pos":"préposition","ipa":"[ʒys.ka]","exFr":"Le magasin est ouvert jusqu'à 20h.","exAr":"المتجر مفتوح حتى الثامنة."},{"fr":"un texte","ar":"نص","pos":"nom","g":"m","pl":"des textes","ipa":"[tɛkst]","exFr":"Ce texte est facile.","exAr":"هذا النص سهل."},{"fr":"lire","ar":"يقرأ","pos":"verbe","ipa":"[liʁ]","exFr":"Je lis dix minutes chaque jour.","exAr":"أقرأ عشر دقائق كل يوم."},{"fr":"comprendre","ar":"يفهم","pos":"verbe","g":"—","exFr":"Je comprends le texte.","ipa":"[kɔ̃pʁɑ̃dʁ]","exAr":"أفهم النص."},{"fr":"le sens","ar":"المعنى","pos":"nom","g":"m","pl":"les sens","exFr":"Quel est le sens de ce mot ?","ipa":"[sɑ̃]","exAr":"ما معنى هذه الكلمة؟"},{"fr":"le titre","ar":"العنوان","pos":"nom","g":"m","exFr":"Lis le titre d'abord.","ipa":"[titʁ]","exAr":"اقرأ العنوان أولاً."},{"fr":"une question","ar":"سؤال","pos":"nom","g":"f","pl":"les questions","exFr":"Réponds à la question.","ipa":"[kɛstjɔ̃]","exAr":"أجب عن السؤال."},{"fr":"la réponse","ar":"الجواب","pos":"nom","g":"f","pl":"les réponses","exFr":"La réponse est dans le texte.","ipa":"[ʁɛspɔ̃s]","exAr":"الجواب في النص."},{"fr":"souligner","ar":"يُظلِّل/يضعط تحت","pos":"verbe","g":"1er","exFr":"Souligne les mots importants.","ipa":"[suliɲe]","exAr":"ظلّل الكلمات المهمة."},{"fr":"le paragraphe","ar":"الفقرة","pos":"nom","g":"m","exFr":"Lis le premier paragraphe.","ipa":"[paʁaɡʁaf]","exAr":"اقرأ الفقرة الأولى."}],"grammar":[{"tFr":"Lire en français : les mots-repères","tAr":"القاعدة: كلمات المرساة أثناء القراءة","body":["كلمات الربط (d'abord, ensuite, donc, mais, parce que) تبني الهيكل المنطقي للنص — اقرأها أولاً فتعرف بنية الفقرة قبل محتواها.","الكلمات المشتركة مع الإنجليزية/العربية (restaurant, important, familial) جسور قراءة فورية لا تحتاج تعريفها."],"ex":[{"fr":"D'abord, il travaille, ensuite il se repose.","ar":"أولاً يعمل، ثم يرتاح."},{"fr":"Je lis parce que c'est utile.","ar":"أقرأ لأن ذلك مفيد."}]}],"mistakes":[{"wrong":"قراءة كلمة كلمة مع ترجمة كل واحدة","right":"قراءة بمرتبتين بلا ترجمة","why":"الترجمة الكلمية تقتل السرعة وتُفقد السياق دوره في فهم الغامض."},{"wrong":"بدء القراءة من أول كلمة قبل رؤية السؤال","right":"اقرأ السؤال أولاً","why":"السؤال يحوّل القراءة إلى بحث موجَّه ويوفر نصف الوقت."},{"wrong":"التوقف عند كل كلمة غريبة","right":"تجاوزها وتحقّق لاحقاً","why":"أغلب الكلمات الغريبة لا تُستخدم في الأسئلة أصلاً."},{"wrong":"تجاهل العنوان والوسوم","right":"العنوان يَعِد ونهاية الفقرة تُلخِّص","why":"أول سؤال الفكرة العامة يُجابة منهما في 90% من الحالات."}],"dialogues":[{"title":"زميلان يناقشان نصاً","ctx":"نقاش بعد قراءة","lines":[{"who":"Salma","fr":"Tu as lu le texte ?","ar":"هل قرأت النص؟"},{"who":"Yacine","fr":"Oui, je l'ai lu deux fois comme le prof a dit.","ar":"نعم، قرأته مرتين كما قال الأستاذ."},{"who":"Salma","fr":"Et le titre, qu'est-ce qu'il dit ?","ar":"والعنوان، ماذا يقول؟"},{"who":"Yacine","fr":"Il parle de la vie quotidienne à Paris.","ar":"يتحدث عن الحياة اليومية في باريس."},{"who":"Salma","fr":"Parfait ! Moi, j'ai eu du mal avec deux mots.","ar":"ممتاز! أنا واجهت صعوبة في كلمتين."},{"who":"Yacine","fr":"Lesquels ? On regarde ensemble.","ar":"أيهما؟ ننظر معاً."}]}],"exercises":[{"t":"mcq","skill":"reading","q":"من النص النموذجي: متى تستيقظ ياسمين؟","opts":["À sept heures","À six heures et demie","À sept heures et quart","À six heures"],"a":1,"why":"النص يقول: «se réveille à six heures et demie»."},{"t":"mcq","skill":"reading","q":"أي كلمة تدل على «الخطوة التالية» في النص؟","opts":["d'abord","ensuite","parce que","jusqu'à"],"a":1,"why":"ensuite تعني «ثم» وتدل على الخطوة التالية."},{"t":"fill","skill":"grammar","q":"أكمل بالربط المناسب: «___, elle prend le bus.» (ثم)","fr":"___, elle prend le bus.","ans":"Ensuite","alts":["ensuite","puis"],"why":"ensuite أو puis كلاهما يدل على الترتيب."},{"t":"order","skill":"reading","q":"رتّب جمل الفقرة منطقياً: (1) ثم تشرب قهوتها (2) أولاً تأخذ دشاً (3) أخيراً تنام مبكراً","words":["D'abord,","elle","prend","une","douche."],"ans":"D'abord, elle prend une douche.","why":"الترتيب الزمني يبدأ دائماً بـ d'abord في هذا التمرين."},{"t":"listen","skill":"listening","q":"استمع واختر معنى الجملة:","audio":"Elle travaille dans une boulangerie jusqu'à quinze heures","opts":["تعمل في مخبز حتى الثالثة","تعمل في مكتبة حتى الخامسة","تنام حتى الثالثة","تسوق في المخابز صباحاً"],"a":0,"why":"boulangerie تعني مخبزاً لا مكتبة، وjusqu’à quinze heures أي حتى الثالثة عصراً؛ فالإجابة الصحيحة وحدها تُطابق المكان والزمان معاً: تعمل في مخبز حتى الثالثة."},{"t":"writing","skill":"writing","q":"اقرأ أي إعلان قصير بالفرنسية ثم اكتب 3 أسطر تلخصه: من؟ أين؟ متى؟","min":12,"kw":["il","elle","à"],"sample":"C'est une annonce pour un concert. Il a lieu samedi à vingt heures à la salle des fêtes. L'entrée est gratuite pour les enfants.","why":"كتابة الملخص هنا تطبّق استراتيجية الدرس نفسها: إيجاد من؟ أين؟ متى؟ بدل الترجمة الحرفية، والكلمات المفتاحية il / elle / à هي علامات الإجابة في النص."},{"t":"mcq","skill":"reading","q":"أهم فائدة من قراءة نص كامل بدلاً من الكلمات المفردة:","opts":["بناء الفهم العام للنص","حفظ كل كلمة في القاموس","تجاهل السياق","القراءة ببطء شديد"],"a":0,"why":"النص الكامل يبني المعنى والسياق معاً."},{"t":"fill","skill":"reading","q":"أكمل: «Je ___ l'article avant de répondre.» (أقرأ)","fr":"Je ___ l'article avant de répondre.","ans":"lis","alts":["Lis"],"why":"le présent من lire هو lis مع je."}],"homework":"اقرأ نصاً قصيراً واحداً كل يوم لمدة أسبوع (إعلان، وصفة، رسالة قصيرة) واكتب سطراً واحداً يلخص كل نص.\nالدرس السابق/التالي: بداية مسار a2-t1 (لا سابق في هذا المسار) / a2-t1-l2 (قراءة الرسائل والإيميلات).","sources":[{"title":"Apprendre à lire le français: texte court et facile","channel":"Prof Youssef Talbi","videoId":"VlRTCx6S6Iw","why":"قراءة موجهة لنص قصير بشرح عربي — يعرض الطريقة الصحيحة: اقرأ ثم فهم ثم تحقق، وهي مدخلك الأول لقراءة فرنسية واعية.","cat":"Reading","level":"A2","main":true},{"title":"French Listening Practice for Beginners A1 DELF - Top 35 Questions","channel":"CCube Academy","videoId":"XK0xf5ZW5u4","why":"سلسلة أسئلة فهم مع نصوص قصيرة بأسلوب امتحاني — يدرّبك على قراءة/سماع نص قصير ثم الإجابة فوراً، وهي نفس مهارة قراءة النصوص القصيرة.","cat":"Reading","level":"A2","extra":true},{"title":"Learn French Fast with Simple Stories (A1-A2) | French for Beginners","channel":"Francais facile","videoId":"So-SShqBfn8","why":"قصص بسيطة بمستوى A1-A2 بسرعة مريحة — تدرّب عليها بقراءة النص المكتوب مع الصوت لترسيخ عادة القراءة اليومية.","cat":"Reading","level":"A2","extra":true}],"supplements":[{"id":"XK0xf5ZW5u4","title":"French Listening Practice for Beginners A1 DELF - Top 35 Questions","channel":"CCube Academy","why":"سلسلة أسئلة فهم مع نصوص قصيرة بأسلوب امتحاني — يدرّبك على قراءة/سماع نص قصير ثم الإجابة فوراً، وهي نفس مهارة قراءة النصوص القصيرة.","lang":"fr"},{"id":"So-SShqBfn8","title":"Learn French Fast with Simple Stories (A1-A2) | French for Beginners","channel":"Francais facile","why":"قصص بسيطة بمستوى A1-A2 بسرعة مريحة — تدرّب عليها بقراءة النص المكتوب مع الصوت لترسيخ عادة القراءة اليومية.","lang":"fr"}]},{"id":"A2-t1-l2","fr":"Lire des e-mails et des messages","ar":"قراءة الرسائل والإيميلات","objectives":["التعرّف على بنية الإيميل الفرنسي من الترويسة إلى الختام","التمييز بين الرسالة الرسمية وغير الرسمية أثناء القراءة","استخراج المعلومة المطلوبة من رسالة بسرعة (متى؟ أين؟ ماذا يريد المرسل؟)"],"sections":[{"h":"بنية الإيميل: خريطة القراءة","p":["كل إيميل فرنسي له هيكل ثابت يساعدك على القراءة السريعة: Objet (الموضوع — يخبرك بكل شيء مسبقاً!)، ثم التحية (Bonjour/Salut/Cher...)، ثم الجسم، ثم الختام (Cordialement/À bientôt...)، ثم التوقيع.","نصيحة امتحانية: اقرأ Objet أولاً ثم اقرأ السؤال المطلوب منك، وبعدها ابحث عن الإجابة في الجسم فقط — لا تقرأ كل شيء. توفير الوقت مهارة تُقيَّم في DELF. الموضوع يكشف الغرض: une invitation، une demande d'information، un rappel.","شاهد الفيديو الأساسي بالشرح العربي لترى بنية الرسالة تُفكَّك أمامك سطرًا سطرًا، ثم طبّق فورًا على أي رسالة تصلك: ضع علامة على كل جزء (ترويسة، متن، ختام، توقيع). بعد خمس رسائل ستصبح البنية تلقائية.","الألوان اللغوية تتغير مع النوع: الرسالة غير الرسمية تحمل tu و اختصارات ونبرة دافئة، والرسمية تحمل vous و صيغة كاملة بلا اختصارات. قراءة نوع الرسالة قبل محتواها توفر عليك مفاجآت في فهم النبرة.","الكلمات الدالة على الغرض هي مفاتيح فورية: pour vous informer (للإعلامكم)، pour vous demander (لطلب)، pour vous inviter (لدعوتك)، pour confirmer (للتأكيد). رصدت واحدة منها = عرفت سبب الرسالة كاملاً.","في الامتحان تأتي الأسئلة بصيغة: من يكتب؟ لماذا؟ ماذا يطلب؟ متى الموعد؟ — أربعة أسئلة، وكلها تُجاب من الترويسة والمتن دون أي تحليل عميق. القراءة الهدف تكفي."],"video":{"id":"hHq420vnVO8","title":"كيفية كتابة رسالة شخصية باللغة الفرنسية - lettre personnelle","channel":"تعلم اللغة الفرنسية في دقائق","why":"شرح عربي لبنية الرسالة الفرنسية خطوة بخطوة — البنية نفسها التي تحللها وأنت تقرأ الإيميل: التحية، المتن، الوداع.","lang":"ar","main":true,"dur":6},"sub":[{"h":"أجزاء الرسالة الخمسة","p":["Objet — الموضوع: ملخص في سطر واحد.","La formule d'appel — التحية: Bonjour / Salut / Cher Madame...","Le corps — المتن: الغرض + التفاصيل.","La formule de politesse — الختام: Cordialement / À bientôt.","La signature — التوقيع: الاسم في النهاية دائماً."]},{"h":"مؤشرات الرسمية في القراءة","p":["vous + Madame/Monsieur + صيغة كاملة (je suis وليس j'suis).","Je vous écris au sujet de... — بداية رسمية جاهزة.","Veuillez agréer... / Cordialement — ختام رسمي."]},{"h":"مؤشرات عدم الرسمية","p":["tu + Salut + اختصارات (j'ai, t'inviter).","عبارات ودية: Comment vas-tu ? / Réponds-moi vite !","ختام حميمي: À bientôt / Bisous / Amicalement."]}]},{"h":"الرسالة غير الرسمية: نقرأ نموذجاً","p":["اقرأ هذه الرسالة من صديق: «Salut Amine ! J'espère que tu vas bien. Je t'écris pour t'inviter à mon anniversaire samedi à 19h chez moi. Tu peux apporter le gâteau ? Réponds-moi vite ! À bientôt, Karim.»","أسئلة الفهم: 1) من يكتب لمن؟ 2) ما المناسبة؟ 3) متى وأين؟ 4) ماذا يطلب الكاتب؟ لاحظ مؤشرات عدم الرسمية: Salut، tu، Réponds-moi vite، À bientôt.","في رسالتها، لاحظ تسلسل المعلومات: مناسبة ← موعد ← طلب ← ردّ مطلوب. هذا التسلسل نفسه ستحتاجه لاحقاً وأنت تكتب رسالة — القراءة والكتابة مرآتان."],"video":null},{"h":"الرسالة الرسمية: كيف تعرفها وأنت تقرأ؟","p":["مؤشرات الرسمية في أي رسالة تقرؤها: Madame/Monsieur بدل الاسم، vous بدل tu، عبارات مثل Je vous écris pour... (أكتب لكم من أجل...)، وختم Cordialement أو Veuillez agréer... فور رؤية هذه المؤشرات اضبط ذهنك: النبرة محترمة والمطلوب غالباً معلومات أو إجراء.","نموذج رسمي للقراءة: «Madame, Je vous écris au sujet de votre annonce pour les cours de français. Pourriez-vous m'indiquer les horaires et les tarifs ? Dans l'attente de votre réponse, cordialement, Omar Bennani.» — السؤال هنا: ماذا يريد عمر؟ (المواعيد والأسعار).","الأسئلة الرسمية غالباً عن الأرقام والوقت: tarifs (الأسعار)، horaires (المواعيد)، délays (المدد). ضع عينك على الأرقام في النص — الإجابة رقمية في أغلب الأحيان."],"video":null},{"h":"التطبيق والتلخيص","p":["يلخّص هذا الدرس بنية الرسالة الفرنسية وقراءتها الهدف: Objet يكشف الغرض قبل أي شيء، ثم التحية، ثم المتن، ثم الختام، ثم التوقيع؛ وقراءة السؤال أولاً ثم البحث في المتن فقط توفّر الوقت في الامتحان. والتمييز بين الرسمية (vous + صيغة كاملة + Cordialement) وغير الرسمية (tu + اختصارات + Salut + À bientôt) يحدّد النبرة والمطلوب. كما وضح الفيديو الرئيسي «كيفية كتابة رسالة شخصية باللغة الفرنسية - lettre personnelle» من قناة «تعلم اللغة الفرنسية في دقائق»، تُفكَّك الرسالة سطراً سطراً إلى تحية ومتن ووداع وتوقيع، وهذه البنية نفسها هي التي تحللها في كل إيميل تقرؤه.","الجسر التعليمي داخل خريطة المستوى، بالترتيب: a2-t1-l1 (قراءة النصوص القصيرة) ← a2-t1-l2 (قراءة الرسائل والإيميلات) ← a2-t1-l3 (الإعلانات وقوائم الطعام والجداول) ← a2-t2-l1 (قصة يوم في حياة سامي) ← a2-t2-l2 (قصة عطلة لايلا) ← a2-t2-l3 (حكاية الأسد والفأر) ← a2-t3-l1 (الماضي المركب مقابل الناقص). هذا الدرس حلقة وسطى: يستلم من a2-t1-l1 مهارة البحث الموجَّه عن الأسئلة الأربعة (من يكتب؟ لماذا؟ ماذا يطلب؟ متى الموعد؟)، ويسلّم إلى a2-t1-l3 نفس المهارة مطبّقة على الإعلانات وقوائم الطعام والجداول، ثم تدخل بقصص السرد في a2-t2-l1 ف a2-t2-l2 ف a2-t2-l3، وينتهي إلى a2-t3-l1 حيث تُدرس أزمنة الماضي التي تظهر في الرسائل والقصص.","أعد مشاهدة الفيديو الرئيسي وحدّد على ورقة أجزاء الرسالة الخمسة أثناء تشغيله، ثم سجّل نفسك وأنت تقرأ رسالة تصلك بصوت عالٍ وتستخرج منها المرسل والموضوع والطلب والموعد، ثم تكتب رداً من ثلاثة أسطر على نبرتها نفسها، وصحّح في تسجيلك أي التباس بين tu و vous قبل أن تنتقل إلى a2-t1-l3."]}],"examples":[{"fr":"Je t'écris pour t'inviter à mon anniversaire.","ar":"أكتب لك لأدعوك لعيد ميلادي."},{"fr":"Je vous écris au sujet de votre annonce.","ar":"أكتب لكم بخصوص إعلانكم."},{"fr":"Pourriez-vous m'indiquer les horaires ?","ar":"هل يمكنكم إخباري بالمواعيد؟"},{"fr":"Dans l'attente de votre réponse, cordialement.","ar":"في انتظار ردكم، مع التقدير."},{"fr":"Objet : Invitation à mon anniversaire","ar":"الموضوع: دعوة لعيد ميلادي","note":"الترويسة"},{"fr":"Je vous écris au sujet de votre annonce.","ar":"أكتب لكم بخصوص إعلانكم.","note":"بداية رسمية"},{"fr":"Réponds-moi vite, s'il te plaît !","ar":"أجبني بسرعة من فضلك!","note":"نبرة غير رسمية"},{"fr":"Dans l'attente de votre réponse, cordialement.","ar":"في انتظار ردكم، مع التقدير.","note":"ختام رسمي"}],"pron":[{"w":"objet","ipa":"[ɔb.ʒɛ]","approx":"أوب-جيه","note":"في الإيميل يعني: الموضوع"},{"w":"Pourriez-vous","ipa":"[pu.ʁje.vu]","approx":"بوريه-فو"},{"w":"l'attente","ipa":"[la.tɑ̃t]","approx":"لاتانت"}],"vocab":[{"fr":"l'objet (d'un email)","ar":"موضوع الرسالة","pos":"nom","g":"m","ipa":"[ɔb.ʒɛ]","exFr":"L'objet dit tout avant la lecture.","exAr":"الموضوع يخبرك بكل شيء قبل القراءة."},{"fr":"t'inviter","ar":"يدعوك","pos":"verbe","ipa":"[tɛ̃.vi.te]","exFr":"Je veux t'inviter au café.","exAr":"أريد دعوتك للمقهى."},{"fr":"au sujet de","ar":"بخصوص","pos":"expression","ipa":"[o.sy.ʒe də]","exFr":"Je vous écris au sujet de votre offre.","exAr":"أكتب لكم بخصوص عرضكم."},{"fr":"répondre vite","ar":"يرد بسرعة","pos":"expression","ipa":"[ʁe.pɔ̃dʁ vit]","exFr":"Réponds-moi vite, s'il te plaît.","exAr":"أجبني بسرعة من فضلك."},{"fr":"le tarife","ar":"التعرفة / السعر","pos":"nom","g":"m","pl":"les tarifs","ipa":"[ta.ʁif]","exFr":"Les tarifs sont sur le site.","exAr":"الأسعار على الموقع."},{"fr":"ecrire","ar":"يكتب","pos":"verbe","g":"—","exFr":"Je vous écris pour...","ipa":"[ɛkʁiʁ]","exAr":"أكتب لكم من أجل..."},{"fr":"la formule de politesse","ar":"عبارة الأدب","pos":"locution","exFr":"La formule de politesse finale.","ipa":"[fɔʁmyl də pɔlitɛs]","exAr":"عبارة الأدب الختامية."},{"fr":"inviter","ar":"يدعو","pos":"verbe","g":"1er","exFr":"Je t'inviter à ma fête.","ipa":"[ɛ̃vite]","exAr":"أدعو حفلتي."},{"fr":"confirmer","ar":"يؤكد","pos":"verbe","g":"1er","exFr":"Je confirme le rendez-vous.","ipa":"[kɔ̃fiʁme]","exAr":"أؤكد الموعد."},{"fr":"une information","ar":"معلومة","pos":"nom","g":"f","pl":"les informations","exFr":"Je voudrais une information.","ipa":"[ɛfɔʁmasjɔ̃]","exAr":"أودّ معلومة."},{"fr":"le courriel / l'email","ar":"البريد الإلكتروني","pos":"nom","g":"m","exFr":"J'ai reçu un courriel.","ipa":"[kuʁjɛl]","exAr":"تلقيت بريداً إلكترونياً."},{"fr":"la signature","ar":"التوقيع","pos":"nom","g":"f","exFr":"Mets ta signature.","ipa":"[siɲatɥʁ]","exAr":"ضع توقيعك."},{"fr":"le destinataire","ar":"المرسل إليه","pos":"nom","g":"m","exFr":"Le destinataire est inconnu.","ipa":"[dɛsitinɛʁ]","exAr":"المرسل إليه مجهول."}],"grammar":[{"tFr":"L'écriture formelle vs informelle","tAr":"القاعدة: لغة الرسالة الرسمية وغير الرسمية","body":["الرسمية: vous + صيغ كاملة (je suis, il a) + عبارات أدب طويلة. غير الرسمية: tu + اختصارات (j'ai, c'est) + نبرة دافئة.","الغرض يتعرَّف من الأفعال: informer / demander / inviter / confirmer — أربع رسائل تغطي 80% من رسائلك."],"ex":[{"fr":"Je voudrais des informations, s'il vous plaît.","ar":"أودّ معلومات من فضلكم."},{"fr":"Salut ! Tu viens demain ?","ar":"أهلاً! هل تأتي غداً؟"}]}],"mistakes":[{"wrong":"البدء بالمتن مباشرة","right":"اقرأ Objet والسؤال أولاً","why":"الموضوع يكشف الغرض ويوفر قراءة كاملة."},{"wrong":"اعتبار كل الرسائل متشابهة","right":"ميّز الرسمية عن غير الرسمية بالمؤشرات","why":"tu/vous والاختصارات تغيّر تفسير النبرة والجواب."},{"wrong":"إهمال التوقيع","right":"التوقيع يحدد المُرسِل غالبًا","why":"الأسئلة «من يكتب؟» تُجابة من التوقيع مباشرة."},{"wrong":"ترجمة كل كلمة في الرسالة الرسمية","right":"اكتفِ بالعبارات الجاهزة المألوفة","why":"الرسائل الرسمية تكرار عالية — تعرّف القالب واقرأ بسرعة."}],"dialogues":[{"title":"تحليل رسالة بين زميلين","ctx":"بعد وصول دعوة","lines":[{"who":"Nadia","fr":"J'ai reçu un email. Tu peux m'aider à le lire ?","ar":"تلقيت بريداً إلكترونياً. هل تساعدني في قراءته؟"},{"who":"Omar","fr":"Bien sûr. Commence par l'objet : de quoi parle-t-il ?","ar":"بالتأكيد. ابدئ بالموضوع: عمّاذا يتحدث؟"},{"who":"Nadia","fr":"« Demande d'informations sur les cours ». C'est formel, non ?","ar":"\"طلب معلومات عن الدورات\". إنه رسمي، أليس كذلك؟"},{"who":"Omar","fr":"Oui : Madame, vous, cordialement. Réponds avec «Madame» et «cordialement».","ar":"نعم: سيدتي، أنتم، مع التقدير. أجيبي بـ\"سيدتي\" و\"مع التقدير\"."},{"who":"Nadia","fr":"D'accord, et je demande les horaires et les tarifs.","ar":"حسناً، وسأسأل عن المواعيد والأسعار."},{"who":"Omar","fr":"Parfait, c'est exactement ce qu'il faut.","ar":"ممتاز، هذا بالضبط ما يلزم."}]}],"exercises":[{"t":"mcq","skill":"reading","q":"«Salut ! Ça va ? On se voit samedi ?» — هذه الرسالة:","opts":["رسمية","غير رسمية","إعلان","تعليمات"],"a":1,"why":"Salut + tu + عبارة لقاء ودية = غير رسمية."},{"t":"mcq","skill":"reading","q":"في نموذج الرسالة الرسمية: ماذا يريد عمر؟","opts":["دعوة حفلة","المواعيد والأسعار","شكر معلمة","تأجيل موعد"],"a":1,"why":"سأل عن «les horaires et les tarifs»."},{"t":"fill","skill":"writing","q":"أكمل ختام الرسالة الرسمية: «___, Omar Bennani»","fr":"___, Omar Bennani","ans":"Cordialement","alts":["cordialement"],"why":"Cordialement الختام الرسمي القياسي."},{"t":"mcq","skill":"reading","q":"أين تبحث عن «متى الحفلة؟» في إيميل دعوة بسرعة؟","opts":["في Objet فقط","في التوقيع","في جسم الرسالة حول التواريخ","في عنوان المرسل"],"a":2,"why":"التفاصيل الزمنية تكون في الجسم."},{"t":"translate","skill":"writing","q":"ترجم: «أكتب لكم بخصوص إعلانكم.»","ans":"Je vous écris au sujet de votre annonce.","alts":["je vous ecris au sujet de votre annonce"],"why":"au sujet de = بخصوص."},{"t":"writing","skill":"writing","q":"اقرأ الرسالة غير الرسمية في الدرس ثم اكتب رداً من 3 أسطر: تقبل الدعوة وتسأل عن شيء واحد.","min":12,"kw":["salut","samedi","merci"],"sample":"Salut Karim ! Merci pour l'invitation. C'est le samedi 14 à 19h, c'est bien ça ? J'apporte le gâteau avec plaisir ! À bientôt, Amine.","why":"الرد المطلوب مرآة لرسالة الصديق نفسها: نبرة غير رسمية بـ Salut و tu، وقبول الدعوة، وسؤال واحد فقط — فإن كتبت رسالة رسمية رجعتَ إلى قواعد a2-t1-l1 بدل مواصلة مهارة قراءة الرسائل."},{"t":"mcq","skill":"reading","q":"عند قراءة عنوان، أول استدلال مشروع هو:","opts":["تخمين الموضوع العام","حفظ العنوان","تجاهله","ترجمته حرفيًا"],"a":0,"why":"التوقع من العنوان يستعد الدماغ للمفردات القادمة."},{"t":"translate","skill":"writing","q":"ترجم: «اقرأ النص مرة أخرى قبل الإجابة.»","ans":"Relis le texte avant de répondre.","alts":["relis le texte avant de repondre","Relis le texte avant de repondre"],"why":"relire = يعيد القراءة، وجملة أمر."}],"homework":"ابحث في بريدك عن أي رسالة ثم اكتب ملخصها بفرنسية في 3 أسطر: المرسل، الموضوع، المطلوب.\nالدرس السابق/التالي: a2-t1-l1 (قراءة النصوص القصيرة) / a2-t1-l3 (الإعلانات وقوائم الطعام والجداول).","sources":[{"title":"كيفية كتابة رسالة شخصية باللغة الفرنسية - lettre personnelle","channel":"تعلم اللغة الفرنسية في دقائق","videoId":"hHq420vnVO8","why":"شرح عربي لبنية الرسالة الفرنسية خطوة بخطوة — البنية نفسها التي تحللها وأنت تقرأ الإيميل: التحية، المتن، الوداع.","cat":"Reading","level":"A2","main":true},{"title":"JKL - cours A2 leçon 33 - écrire un email","channel":"JKL","videoId":"5pdh3Fp1PY4","why":"درس A2 متكامل لبنية الإيميل بالفرنسية — فهم الهيكل الذي ستقرؤه في كل رسالة، من الموضوع حتى التوقيع.","cat":"Reading","level":"A2","extra":true},{"title":"FLE FLS ÉCRIRE Préparer le DELF A2. Écrire un message pour remercier","channel":"Parler, lire, écrire le français - Cris","videoId":"yFllmrFr-0M","why":"نموذج تطبيقي لرسالة شكر بمستوى A2 — يعرض رسالة حقيقية سطراً سطراً كما ستقرؤها وتحللها أنت.","cat":"Reading","level":"A2","extra":true},{"title":"A2 📖 DELF ECRIT ✍️ | Cours de français","channel":"Ohlala ! Français","videoId":"RRz74p0n62o","why":"شرح قسم الكتابة في امتحان DELF A2 — يريك شكل الرسالة المطلوبة في الامتحان حتى تعرف مسبقاً ما ستقرأ وما ستكتب.","cat":"Reading","level":"A2","extra":true}],"supplements":[{"id":"5pdh3Fp1PY4","title":"JKL - cours A2 leçon 33 - écrire un email","channel":"JKL","why":"درس A2 متكامل لبنية الإيميل بالفرنسية — فهم الهيكل الذي ستقرؤه في كل رسالة، من الموضوع حتى التوقيع.","lang":"fr"},{"id":"yFllmrFr-0M","title":"FLE FLS ÉCRIRE Préparer le DELF A2. Écrire un message pour remercier","channel":"Parler, lire, écrire le français - Cris","why":"نموذج تطبيقي لرسالة شكر بمستوى A2 — يعرض رسالة حقيقية سطراً سطراً كما ستقرؤها وتحللها أنت.","lang":"fr"},{"id":"RRz74p0n62o","title":"A2 📖 DELF ECRIT ✍️ | Cours de français","channel":"Ohlala ! Français","why":"شرح قسم الكتابة في امتحان DELF A2 — يريك شكل الرسالة المطلوبة في الامتحان حتى تعرف مسبقاً ما ستقرأ وما ستكتب.","lang":"fr"}]},{"id":"A2-t1-l3","fr":"Annonces, menus et horaires","ar":"قراءة الإعلانات وقوائم الطعام والجداول","objectives":["قراءة قائمة طعام فهم ما يمكن طلبه","فهم إعلانات المتاجر والمدينة (فتح/إغلاق، عروض، أحداث)","قراءة الجداول الزمنية (مواصلات، سينما، برامج) بثقة"],"sections":[{"h":"قراءة قائمة الطعام","p":["القائمة الفرنسية لها أقسام ثابتة: entrée (المقبلات)، plat principal (الطبق الرئيسي)، dessert (الحلويات)، boissons (المشروبات). اعرف القسم = وجدت ما تريد بنصف الوقت.","حيلة القراءة: في القوائم، الكلمات الإنجليزية/العربية المشتركة كثيرة (steak، salade، pizza) لكن احذر الفخاخ: «entrée» ليست الطبق الرئيسي بل المقبل! و«plat du jour» = طبق اليوم بأسعار أرخص عادة.","تابع الفيديو الأساسي بالشرح العربي: قائمة طعام حقيقية تُقرأ سطرًا سطرًا مع ترجمة الأقسام والأسعار. لاحظ كيف يميّز المدرّس بين les entrées و les plats بنظرة واحدة — والفخ الشهير: hors-d'oeuvre ليست entrée بالمعنى الامتحاني.","الإعلانات في المدينة تقرأ بعين مختلفة: «Soldes -50%» (تخفيضات)، «Fermé le lundi» (مغلق الاثنين)، «Ouvert 7j/7» (مفتوح طوال الأسبوع)، «Promotion jusqu'au 30 juin» (عرض حتى 30 يونيو). الأرقام والتواريخ هي جوهر المعلومة.","الجداول الزمنية (horaires): في محطة القطار أو السينما، ابحث عن عمودين: الاسم/الوجهة والتوقيت. «Départ 14h35 — Voie 6» يعني: مغادرة 14:35 من الرصيف 6. في DELF A2 يطلبون منك غالباً: «ما هو أقرب قطار بعد الخامسة؟»","قاعدة البحث الذهبي في كل الجداول: حدد مفتاح البحث (اليوم؟ السعر؟ الوقت؟) ثم امسح العمود المقابل بعينك عموديًا. لا تقرأ الجدول كنص — اقرأه كأداة استعلام. الفرق بين القارئ المبتدئ والمحترف هو اتجاه النظر."],"video":{"id":"I3A-LmVIGMY","title":"تعلم اللغة الفرنسية : أسـماء أنواع الطعام بالفرنسية مع الصور","channel":"عربي بلسان فرنسي","why":"قاموس مصوّر لأنواع الطعام بالفرنسية بالعربية — مفردات قائمة الطعام قبل قراءتها فعليًا.","lang":"ar","main":true,"dur":14},"sub":[{"h":"أقسام قائمة الطعام","p":["les entrées — المقبلات: soupe, salade, pâté.","les plats principaux — الرئيسية: viande, poisson, végétarien.","les desserts — الحلوى: fromage, gâteau, glace.","les boissons — المشروبات: eau, vin, café, jus."]},{"h":"كلمات الإعلانات الحيوية","p":["les soldes / la promotion — التخفيضات.","fermé(e) / ouvert(e) — مغلق / مفتوح.","gratuit(e) — مجاني، en stock — متوفر.","jusqu'au... — حتى (تاريخ): jusqu'au 30 juin."]},{"h":"قراءة الجدول الزمني","p":["Départ / Arrivée — المغادرة / الوصول.","Voie / Quai — الرصيف/السكة.","du lundi au vendredi — من الاثنين للجمعة.","tous les jours — كل يوم، le week-end — عطلة نهاية الأسبوع."]}]},{"h":"من القائمة إلى الطلب","p":["الإعلانات في المدينة تقرأ بعين مختلفة: «Soldes -50%» (تخفيضات)، «Fermé le lundi» (مغلق الاثنين)، «Ouvert 7j/7» (مفتوح طوال الأسبوع)، «Promotion jusqu'au 30 juin» (عرض حتى 30 يونيو). الأرقام والتواريخ هي جوهر المعلومة.","الجداول الزمنية (horaires): في محطة القطار أو السينما، ابحث عن عمودين: الاسم/الوجهة والتوقيت. «Départ 14h35 — Voie 6» يعني: مغادرة 14:35 من الرصيف 6. في DELF A2 يطلبون منك غالباً: «ما هو أقرب قطار بعد الخامسة؟»","في الامتحان، السؤال يصلك أولاً ثم تعود للجدول: «أقرب قطار بعد الخامسة» ← انظر لعمود Départ فقط وابحث عن أول رقم بعد 17h. استبعاد بقية الجدول نصف الإجابة."],"video":null},{"h":"القراءة في امتحان DELF A2","p":["قسم القراءة في DELF A2 يعطيك نصوصاً حقيقية قصيرة: إعلانات، قوائم، رسائل، أوصاف. الأسئلة من نوع: صح/خطأ، اختيار من متعدد، ومطابقة. لا يتطلب الامتحان فهم 100% من النص بل إيجاد 100% من الإجابات.","استراتيجية ذهبية: اقرأ السؤال أولاً، حدد الكلمة المفتاحية (توقيت؟ سعر؟ يوم؟)، ثم امسح النص بعينك بحثاً عنها. تدرب على هذا اليومياً مع إعلانات حقيقية من مواقع متاجر فرنسية.","قاعدة التمييز الذهبية:entrée في القائمة المقبل، أما في الحياة اليومية فـ «l'entrée» قد تعني الدخول نفسه. السياق (قائمة مطعم أم بطاقة دخول) يحسم المعنى دائماً."],"video":null},{"h":"التطبيق والتلخيص","p":["يلخّص هذا الدرس قراءة مستندات الحياة اليومية الثلاثة: قائمة الطعام بأقسامها الثابتة (entrée ثم plat ثم dessert ثم boissons) والتحذير من فخّ «entrée» و«plat du jour»، والإعلانات بكلماتها الحيوية (soldes، fermé، ouvert، gratuit، jusqu'au...)، والجداول الزمنية بقراءتها العمودية انطلاقاً من مفتاح السؤال (يوم؟ سعر؟ وقت؟). كما وضح الفيديو الرئيسي «تعلم اللغة الفرنسية : أسـماء أنواع الطعام بالفرنسية مع الصور» من قناة «عربي بلسان فرنسي»، تُبنى مفردات القائمة قبل قراءتها بمصوّراتها، وهذا هو ترتيب العمل الصحيح: اسم الطعام ومعناه ثم السعر ثم الطلب.","الجسر التعليمي داخل خريطة المستوى، بالترتيب: a2-t1-l1 (قراءة النصوص القصيرة) ← a2-t1-l2 (قراءة الرسائل والإيميلات) ← a2-t1-l3 (الإعلانات وقوائم الطعام والجداول) ← a2-t2-l1 (قصة يوم في حياة سامي) ← a2-t2-l2 (قصة عطلة لايلا) ← a2-t2-l3 (حكاية الأسد والفأر) ← a2-t3-l1 (الماضي المركب مقابل الناقص). هذا الدرس يجمع ما قبله ويفتح ما بعده: من a2-t1-l1 يستلم مهارة الاستخراج الموجَّه، ومن a2-t1-l2 يستلم قراءة المستند قبل السؤال، ثم يسلّم مباشرة إلى a2-t2-l1 حيث تصبح القراءة سرداً متصلاً بالمضارع، ثم a2-t2-l2 بالزمن الماضي، ثم a2-t2-l3 بالحكاية، وأخيراً a2-t3-l1 الذي يعطيك القاعدة النحوية للأزمنة كلها.","أعد مشاهدة الفيديو الرئيسي وأنت تدوّن مقابل كل صورة اسمها وسعرها بالفرنسية، ثم سجّل نفسك وأنت تشرح بأعلى صوت قسمين من قائمة طعام (entrée / plat) وموعد واحد من جدول (Départ... Voie...)، وصحّح في تسجيلك أي كلمة أو رقم لا يطابق ما هو مكتوب قبل أن تنتقل إلى a2-t2-l1."]}],"examples":[{"fr":"Le restaurant est fermé le lundi.","ar":"المطعم مغلق يوم الاثنين."},{"fr":"Soldes : -50% sur tout !","ar":"تخفيضات: خصم 50% على كل شيء!"},{"fr":"Départ : 14h35, Voie 6.","ar":"المغادرة: 14:35، الرصيف 6."},{"fr":"Le plat du jour coûte 12 euros.","ar":"طبق اليوم بثمن 12 يورو."},{"fr":"Quelle est la différence entre l'entrée et le plat ?","ar":"ما الفرق بين المقبل والطبق؟","note":"فخ شهير"},{"fr":"Le train de 17h35 est en retard.","ar":"قطار الساعة الخامسة والنصف متأخر.","note":"قراءة الجدول"},{"fr":"Tout est gratuit aujourd'hui !","ar":"كل شيء مجاني اليوم!","note":"إعلان"},{"fr":"Nous fermons le lundi, sauf les jours fériés.","ar":"نغلق الاثنين، عدا العطل الرسمية.","note":"مواعيد"}],"pron":[{"w":"soldes","ipa":"[sɔld]","approx":"سولد","note":"دائماً جمع: التخفيضات"},{"w":"la voie","ipa":"[la.vwa]","approx":"لا-فوا","note":"الرصيف/المسار في المحطة"},{"w":"fermé","ipa":"[fɛʁ.me]","approx":"فيرميه"}],"vocab":[{"fr":"les soldes","ar":"التخفيضات","pos":"nom","g":"fpl","ipa":"[le.sɔld]","exFr":"Les soldes commencent en janvier.","exAr":"التخفيضات تبدأ في يناير."},{"fr":"fermé(e)","ar":"مغلق(ة)","pos":"adj","g":"mf","ipa":"[fɛʁ.me]","exFr":"La pharmacie est fermée la nuit.","exAr":"الصيدلية مغلقة ليلاً."},{"fr":"le départ","ar":"المغادرة","pos":"nom","g":"m","ipa":"[de.paʁ]","exFr":"Le départ est à 14h35.","exAr":"المغادرة في 14:35."},{"fr":"le plat du jour","ar":"طبق اليوم","pos":"expression","ipa":"[le.pla dy ʒuʁ]","exFr":"Quel est le plat du jour ?","exAr":"ما هو طبق اليوم؟"},{"fr":"l'entrée","ar":"المقبلات (في القائمة)","pos":"nom","g":"f","ipa":"[lɑ̃.tʁe]","exFr":"Je prends une entrée et un plat.","exAr":"آخذ مقبلاً وطبقاً رئيسياً."},{"fr":"gratuit(e)","ar":"مجاني(ة)","pos":"adj","g":"mf","ipa":"[ɡʁa.tɥi]","exFr":"L'entrée du musée est gratuite dimanche.","exAr":"دخول المتحف مجاني الأحد."},{"fr":"le menu / la carte","ar":"قائمة الطعام","pos":"nom","g":"f","exFr":"La carte, s'il vous plaît.","ipa":"[kaʁt]","exAr":"القائمة من فضلك."},{"fr":"une boisson","ar":"مشروب","pos":"nom","g":"f","pl":"les boissons","exFr":"Quelle boisson voulez-vous ?","ipa":"[bwasɔ̃]","exAr":"أي مشروب تريدون؟"},{"fr":"les horaires","ar":"مواعيد العمل","pos":"nom","g":"m.pl","exFr":"Quels sont vos horaires ?","ipa":"[ɔʁɛʁ]","exAr":"ما مواعيدكم؟"},{"fr":"une promotion","ar":"عرض/تخفيض","pos":"nom","g":"f","exFr":"Il y a une promotion sur le pain.","ipa":"[pʁɔmɔsjɔ̃]","exAr":"يوجد عرض على الخبز."},{"fr":"une place","ar":"مكان/مقعد","pos":"nom","g":"f","exFr":"Il reste une place.","ipa":"[plas]","exAr":"يتبقى مقعد واحد."},{"fr":"un horaire de train","ar":"جدول قطار","pos":"nom","g":"m","exFr":"Regarde l'horaire des trains.","ipa":"[ɔʁɛʁ]","exAr":"انظر إلى جدول القطارات."},{"fr":"coûter","ar":"يُكلِّف","pos":"verbe","g":"1er","exFr":"Ça coûte combien ?","ipa":"[kute]","exAr":"بكم الثمن؟"}],"grammar":[{"tFr":"Lire un tableau : repères et prépositions","tAr":"القاعدة: قراءة الجداول بأدوات الجر","body":["de... à... للتوقيت (de 9h à 18h)، du... au... للأيام (du lundi au vendredi)، jusqu'au... للنهاية الزمنية.","أفعال الجدول: ouvrir/fermer (يفتح/يغلق)، commencer/finir (يبدأ/ينهي)، partir/arriver (ينطلق/يصل)."],"ex":[{"fr":"Le musée est ouvert du mardi au dimanche.","ar":"المتحف مفتوح من الثلاثاء للأحد."},{"fr":"Le cours finit à 17h.","ar":"ينهي الدرس الساعة الخامسة."}]}],"mistakes":[{"wrong":"اعتبار entrée الطبق الرئيسي","right":"entrée = المقبل في القائمة","why":"فخ شهير في DELF: entrée في القائمة مقابل الدخول في السياق العام."},{"wrong":"قراءة الجدول كنص متصل","right":"اقرأ عمودياً بحسب مفتاح السؤال","why":"الجدول أداة استعلام — اتجاه النظر يختصر الوقت."},{"wrong":"الخلط بين du / au / jusqu'au","right":"du... au... للأيام، jusqu'au للنهاية","why":"أدوات الجر هي مفاتيح معنى الجدول كله."},{"wrong":"تجاهل suffix(es)","right":"les horaires / les soldes جمع","why":"المفرد والجمع يغيّران عدد العناصر المطلوبة في الإجابة."}],"dialogues":[{"title":"في مطعم سياحي","ctx":"زبون يقرأ القائمة ويسأل","lines":[{"who":"Serveur","fr":"Vous avez choisi ?","ar":"هل اخترتَ؟"},{"who":"Hakim","fr":"Quelle est la différence entre l'entrée et le plat du jour ?","ar":"ما الفرق بين المقبل وطبق اليوم؟"},{"who":"Serveur","fr":"L'entrée est une petite salade, le plat du jour est du poisson.","ar":"المقبل سلطة صغيرة، وطبق اليوم سمك."},{"who":"Hakim","fr":"D'accord. Et le plat du jour, ça coûte combien ?","ar":"حسناً. وطبق اليوم بكم؟"},{"who":"Serveur","fr":"Douze euros, boisson comprise.","ar":"اثنا عشر يورو، مع المشروب."},{"who":"Hakim","fr":"Parfait, je le prends.","ar":"ممتاز، آخذه."}]}],"exercises":[{"t":"mcq","skill":"reading","q":"إعلان يقول: «Fermé le lundi» — ماذا تفهم؟","opts":["يفتح الاثنين فقط","مغلق يوم الاثنين","مغلق طوال الأسبوع","يفتح مساء الاثنين"],"a":1,"why":"fermé le lundi = مغلق يوم الاثنين."},{"t":"mcq","skill":"reading","q":"في القائمة: «Plat du jour : Poulet rôti — 12€» — ما هذا؟","opts":["مقبل بـ 12 يورو","طبق اليوم: دجاج مشوي بـ 12 يورو","حلوى بـ 12 يورو","مشروب"],"a":1,"why":"plat du jour = طبق اليوم، poulet rôti = دجاج مشوي."},{"t":"mcq","skill":"reading","q":"جدول قطار: «Départ 14h35, Voie 6» — أين تصعد؟","opts":["الرصيف 35","الرصيف 6","البوابة 14","السيارة 6"],"a":1,"why":"voie = الرصيف/المسار: رقم 6."},{"t":"fill","skill":"vocabulary","q":"أكمل: «Le musée est ___ dimanche.» (مجاني)","fr":"Le musée est ___ dimanche.","ans":"gratuit","alts":["gratuite"],"why":"gratuit = مجاني (المتحف مذكر)."},{"t":"listen","skill":"listening","q":"استمع للإعلان واختر:","audio":"Attention, le magasin ferme à vingt heures","opts":["المتجر يغلق في الثامنة","المتجر يفتح في الثامنة","المتجر مغلق اليوم","المتجر يفتح طوال اليوم"],"a":0,"why":"ferme هي «يغلق» لا «يفتح»، وvingt heures تساوي الثامنة مساءً؛ فالمطلوب تحويل الساعة إلى نظام الاثني عشر مع قراءة الفعل دفعة واحدة، ولا يطابقهما إلا «المتجر يغلق في الثامنة»."},{"t":"writing","skill":"writing","q":"اكتب إعلاناً قصيراً لمطعم من عندك: الاسم، ما يقدمه، مواعيد الفتح والغلق.","min":14,"kw":["ouvert","fermé","euros"],"sample":"Restaurant Le Palmier. Cuisine marocaine : couscous, tajine, thé à la menthe. Ouvert du mardi au dimanche de 12h à 23h. Fermé le lundi. Menu du jour : 14 euros.","why":"إعلان المطعم يجمع ما درسته في هذا الدرس: اسم المنشأة ونوع المأكولات ومواعيد ouvert / fermé مع الأيام والثمن بالـ euros؛ فهذه العناصر الثلاثة هي بالضبط ما يُبحث عنه في نصوص الإعلانات الحقيقية."},{"t":"mcq","skill":"reading","q":"أفضل استراتيجية عند كلمة مجهولة أثناء القراءة:","opts":["استمر والسِر بالسياق ثم تحقق","توقف فوراً وافتح القاموس","اقرأ الكلمة بصوت عالٍ","تجاهل الفقرة كلها"],"a":0,"why":"السياق يدل على المعنى ويحافظ على سرعة القراءة."},{"t":"correct","skill":"writing","q":"صحّح الخطأ: «Je cherche le sens des mots en dictionnaire.»","ans":"dans le dictionnaire","alts":["Dans le dictionnaire"],"why":"البحث في كتاب بـ dans + le = dans le dictionnaire."}],"homework":"افتح موقع مطعم أو متجر فرنسي واقرأ صفحة «Horaires» وصفحة «Menu»، ثم اكتب 5 معلومات استخرجتها بالفرنسية.\nالدرس السابق/التالي: a2-t1-l2 (قراءة الرسائل والإيميلات) / a2-t2-l1 (قصة يوم في حياة سامي).","sources":[{"title":"تعلم اللغة الفرنسية : أسـماء أنواع الطعام بالفرنسية مع الصور","channel":"عربي بلسان فرنسي","videoId":"I3A-LmVIGMY","why":"قاموس مصوّر لأنواع الطعام بالفرنسية بالعربية — مفردات قائمة الطعام قبل قراءتها فعليًا.","cat":"Reading","level":"A2","main":true},{"title":"😋🍴 Lire et comprendre le menu français","channel":"Guillaume Posé - Professeur de français","videoId":"R_7f44eHKAU","why":"درس متخصص في قراءة قائمة الطعام الفرنسية ببنيتها الحقيقية: entrée، plat، dessert — من أستاذ FLE محترف.","cat":"Reading","level":"A2","extra":true},{"title":"🇫🇷 Commander un Repas au Restaurant 🍽️ | Everyday French Conversations","channel":"Learn French and English","videoId":"mY6MIIq0fWo","why":"حوار طلب حقيقي في مطعم — يربط القراءة (القائمة) بالمحادثة (الطلب) في مشهد واحد متكامل.","cat":"Reading","level":"A2","extra":true},{"title":"Tu es niveau A2 en français si tu connais ces mots | DELF A2","channel":"Français avec Nelly","videoId":"FeAcjAAA-3U","why":"مفردات A2 التي تتكرر في نصوص الامتحان والإعلانات — تقويم سريع يعرفك بالمفردات التي ستجدها في كل نص تقرؤه.","cat":"Reading","level":"A2","extra":true}],"supplements":[{"id":"R_7f44eHKAU","title":"😋🍴 Lire et comprendre le menu français","channel":"Guillaume Posé - Professeur de français","why":"درس متخصص في قراءة قائمة الطعام الفرنسية ببنيتها الحقيقية: entrée، plat، dessert — من أستاذ FLE محترف.","lang":"fr"},{"id":"mY6MIIq0fWo","title":"🇫🇷 Commander un Repas au Restaurant 🍽️ | Everyday French Conversations","channel":"Learn French and English","why":"حوار طلب حقيقي في مطعم — يربط القراءة (القائمة) بالمحادثة (الطلب) في مشهد واحد متكامل.","lang":"fr"},{"id":"FeAcjAAA-3U","title":"Tu es niveau A2 en français si tu connais ces mots | DELF A2","channel":"Français avec Nelly","why":"مفردات A2 التي تتكرر في نصوص الامتحان والإعلانات — تقويم سريع يعرفك بالمفردات التي ستجدها في كل نص تقرؤه.","lang":"fr"}]}]},{"id":"a2-t2","slug":"stories","icon":"📚","color":"#D97706","fr":"Histoires éducatives","ar":"مسار القصص التعليمية","desc":"تعلّم الفرنسية كما تعلّمها الأطفال الفرنسيون: عبر القصص. قصة بالمضارع، قصة بالماضي، ثم حكاية من فابل لافونتين — متعة + مفردات + قواعد في سياق حي.","lessons":[{"id":"A2-t2-l1","fr":"L'histoire de Sami (au présent)","ar":"قصة: يوم في حياة سامي","objectives":["قراءة/سماع قصة كاملة بالمضارع وفهم تسلسل الأحداث","استخدام كلمات الترتيب لسرد يومك أنت","بناء 12 كلمة من سياق القصة"],"sections":[{"h":"لماذا القصص هي أفضل معلم؟","p":["القصة تضع الكلمات في سياق: بدل حفظ «se réveiller = يستيقظ» منفصلة، تحفظ المشهد كله: Sami se réveille, il est fatigué, il regarde l'heure... الدماغ يحب القصص ويحتفظ بها أطول بكثير من القوائم.","قاعدة القصص الصحيحة: افهم 80% وتعلّم 20% جديد. إذا فهمت كل شيء فهي سهلة عليك، وإذا فهمت أقل من نصفها فهي صعبة. مستوى هذه القصة مضبوط على A2 — اقرأها مرة للفهم ومرة للاستخراج.","شاهد الفيديو الأساسي بالشرح العربي: قصة مصوّرة قصيرة تُروى بالعربية ثم بالفرنسية. الطابع المزدوج يثبت معنى المشهد في ذهنك قبل أن تسمع الجملة الفرنسية — وهو أسرع طريق لربط الحركة بالكلمة.","الأفعال اليومية هي عظم القصة: se réveiller، prendre، aller، manger، travailler، regarder، dormir. ثمانية أفعال تصف يوم أي إنسان في أي لغة — احفظها كسلسلة متصلة مرتبة بالأوقات لا كقائمة معجمية.","كلمات الترتيب (d'abord، ensuite، puis، après، enfin) هي عمود القصة نفسه. تعلّمها مرتبطة بالفعل الذي يليها: d'abord il prend... ensuite il va... هكذا تصبح السرد تلقائيًا لا مفكَّرًا.","أبعد مهارة تكسبها من القصص: التوقّع. بعد جملة «il prend son petit-déjeuner» يتنبأ دماغك بما بعدها (يخرج للعمل...)، وهذا التوقّع نفسه هو جوهر الفهم المسموع في المستوى الأعلى."],"video":{"id":"9rO7GN00L3E","title":"قصة ليلى والذئب باللغة الفرنسية مترجمة للعربية – تعلم الفرنسية بسهولة! Le petit chaperon rouge","channel":"LE FRANÇAIS AVEC MOHAMED KB","why":"قصة عربية مترجمة قصيرة تُظهر السرد الفرنسي الحي — تسمع كلمات الربط والمضارع في قصة مكتملة.","lang":"ar","main":true,"dur":4},"sub":[{"h":"سلسلة أفعال اليوم (حزمة واحدة)","p":["il se réveille (يستيقظ) → il prend son petit-déjeuner (يتناول فطوره)","il va à... (يذهب إلى...) → il travaille / il étudie (يعمل/يدرس)","il mange (يأكل) → il se repose (يرتاح) → il dort (ينام)"]},{"h":"كلمات الترتيب مع معانيها","p":["d'abord — أولاً (بداية السلسلة)","ensuite / puis — ثم (خطوة تالية)","après — بعد ذلك (فاصل زمني)","enfin — أخيراً (نهاية السلسلة)"]},{"h":"أسئلة الفهم النموذجية","p":["À quelle heure...? — في أي ساعة؟ (وقت)","Comment...? — كيف؟ (وسيلة)","Pourquoi...? — لماذا؟ (سبب — parce que)","Où...? — أين؟ (مكان)"]}]},{"h":"القصة: يوم في حياة سامي","p":["اقرأ القصة: «Sami se réveille à sept heures. D'abord, il prend son petit-déjeuner : du pain et du café. Ensuite, il va à l'université en vélo. Le matin, il a trois cours. À midi, il mange avec son ami Karim au restaurant universitaire. L'après-midi, Sami travaille à la bibliothèque parce qu'il a un examen. Le soir, il est fatigué mais content : il regarde un film et il dort à onze heures.»","أسئلة القصة: 1) متى يستيقظ سامي؟ 2) كيف يذهب للجامعة؟ 3) لماذا يعمل في المكتبة؟ 4) كيف يشعر مساءً ولماذا؟ — أعد قراءتها مرة ثانية وستفهمها 100%.","بعد فهم القصة، اقرأها بصوت مسموع بهدوء ثم أعطِ نفسك 10 ثوانٍ لتخيل كل جملة كصورة. الربط الصوتي-البصري مع مشاهدة الفيديو الأساسي يجعل تذكر السلسلة مؤتمتاً."],"video":null},{"h":"أسلوب السرد: كلمات الترتيب + المضارع","p":["لاحظ بنية القصة: بداية بـ se réveiller (يستيقظ)، ثم d'abord/ensuite للترتيب، ثم parce que للسبب، ونهاية بوجه (fatigué mais content). هذا «هيكل اليوم» الذي ستحاكيه في السرد عن نفسك.","المضارع في القصة يصف عادة يوم كامل: il se réveille, il prend, il va, il a, il mange, il travaille, il regarde, il dort — ثمانية أفعال هي عظم يوم أي شخص. احفظها كسلسلة متصلة لا كلمات منفصلة.","لقطات الفيديو الإثرائي تركز على نفس الأفعال في مواقف أخرى؛ أوقفه عند كل فعل وقل جملتك اليومية به أنت. التوليد من حياتك أثبت من إعادة حفظ حياة سامي."],"video":null},{"h":"التطبيق والتلخيص","p":["يلخّص هذا الدرس سرد الروتين اليومي بالمضارع: ثمانية أفعال أساسية (se réveiller, prendre, aller, travailler, manger, regarder, dormir) مرتّبة بالوقت، وعمود من كلمات الترتيب d'abord ثم ensuite ثم puis ثم après ثم enfin، ووصلة السبب parce que، ونهاية بوصف شعور. كما وضح الفيديو الرئيسي «قصة ليلى والذئب باللغة الفرنسية مترجمة للعربية – تعلم الفرنسية بسهولة! Le petit chaperon rouge» من قناة «LE FRANÇAIS AVEC MOHAMED KB»، يُروى المشهد بالعربية ثم بالفرنسية، فالمعنى يثبت أولاً ثم تُسمَع الجملة الفرنسية — وهو الترتيب نفسه الذي يجعل تذكّر السلسلة مؤتمتاً.","الجسر التعليمي داخل خريطة المستوى، بالترتيب: a2-t1-l1 (قراءة النصوص القصيرة) ← a2-t1-l2 (قراءة الرسائل والإيميلات) ← a2-t1-l3 (الإعلانات وقوائم الطعام والجداول) ← a2-t2-l1 (قصة يوم في حياة سامي) ← a2-t2-l2 (قصة عطلة لايلا) ← a2-t2-l3 (حكاية الأسد والفأر) ← a2-t3-l1 (الماضي المركب مقابل الناقص). هذا هو أول درس سرد في المسار: يستلم a2-t1-l3 (الإعلانات والقوائم والجداول) حيث انتهت القراءة عند مستندات جامدة، ويبدأ منها إلى حياة متحركة بالمضارع، ثم يتبعه a2-t2-l2 الذي ينقل نفس السرد إلى الماضي (imparfait + passé composé)، ف a2-t2-l3 الذي يطبّقه على حكاية بأزمنة ثلاثة، ثم a2-t3-l1 الذي يُشكِّل الناقص والمركب نحويًا.","أعد مشاهدة الفيديو الرئيسي مركّزًا على ترتيب الأحداث وأفعالها، ثم سجّل نفسك وأنت تحكي يومك في خمس جمل واضحة بصوت عالٍ مع كلمة ترتيب صريحة في كل جملة (d'abord... ensuite... enfin)، وصحّح في تسجيلك أي فعل خرج عن المضارع أو أي خطوة بلا رابط قبل أن تنتقل إلى a2-t2-l2."]}],"examples":[{"fr":"Sami se réveille à sept heures.","ar":"يستيقظ سامي في السابعة."},{"fr":"Il va à l'université en vélo.","ar":"يذهب إلى الجامعة بالدراجة."},{"fr":"Il travaille parce qu'il a un examen.","ar":"يعمل لأن عنده امتحان."},{"fr":"Il est fatigué mais content.","ar":"هو متعب لكنه سعيد."},{"fr":"D'abord il prend son café, ensuite il va travailler.","ar":"أولاً يشرب قهوته، ثم يذهب للعمل.","note":"سلسلة"},{"fr":"Sami va à l'université en vélo.","ar":"سامي يذهب إلى الجامعة بالدراجة.","note":"الوسيلة مع en"},{"fr":"Il travaille à la bibliothèque parce qu'il a un examen.","ar":"يعمل في المكتبة لأنه لديه امتحان.","note":"السبب"},{"fr":"Le soir, il est fatigué mais content.","ar":"مساءً هو متعب لكن سعيد.","note":"الوجه"}],"pron":[{"w":"se réveille","ipa":"[sə ʁe.vɛj]","approx":"سو-ره-ڤيه"},{"w":"en vélo","ipa":"[ɑ̃.ve.lo]","approx":"آن-ڤيلو"},{"w":"la bibliothèque","ipa":"[bi.bli.jɔ.tɛk]","approx":"بيبليو-تِك"}],"vocab":[{"fr":"se réveiller","ar":"يستيقظ","pos":"verbe","ipa":"[sə.ʁe.ve.je]","exFr":"Je me réveille à six heures.","exAr":"أستيقظ في السادسة."},{"fr":"le petit-déjeuner","ar":"الفطور","pos":"nom","g":"m","ipa":"[lə.pə.ti.de.ʒø.ne]","exFr":"Le petit-déjeuner est prêt.","exAr":"الفطور جاهز."},{"fr":"en vélo","ar":"بالدراجة","pos":"expression","ipa":"[ɑ̃.ve.lo]","exFr":"Je vais au travail en vélo.","exAr":"أذهب للعمل بالدراجة."},{"fr":"fatigué(e)","ar":"متعب(ة)","pos":"adj","g":"mf","ipa":"[fa.ti.ɡe]","exFr":"Le soir, il est fatigué.","exAr":"مساءً هو متعب."},{"fr":"la bibliothèque","ar":"المكتبة","pos":"nom","g":"f","pl":"les bibliothèques","ipa":"[bi.bli.jɔ.tɛk]","exFr":"Il étudie à la bibliothèque.","exAr":"يدرس في المكتبة."},{"fr":"content(e)","ar":"سعيد(ة) / راضٍ(ية)","pos":"adj","g":"mf","ipa":"[kɔ̃.tɑ̃]","exFr":"Elle est contente de son jour.","exAr":"هي راضية عن يومها."},{"fr":"prendre le petit-déjeuner","ar":"يتناول الفطور","pos":"locution","exFr":"Elle prend son petit-déjeuner.","ipa":"[pʁɑ̃dʁ]","exAr":"تتناول فطورها."},{"fr":"la journée","ar":"اليوم (من الصباح للمساء)","pos":"nom","g":"f","exFr":"Bonne journée !","ipa":"[ʒuʁne]","exAr":"نهاراً سعيداً!"},{"fr":"l'université","ar":"الجامعة","pos":"nom","g":"f","exFr":"Il étudie à l'université.","ipa":"[ynivɛʁsite]","exAr":"يدرس في الجامعة."},{"fr":"un examen","ar":"امتحان","pos":"nom","g":"m","pl":"les examens","exFr":"J'ai un examen demain.","ipa":"[ɛɡzamɛ̃]","exAr":"لدي امتحان غداً."},{"fr":"se reposer","ar":"يرتاح","pos":"verbe","g":"—","exFr":"Il se repose l'après-midi.","ipa":"[sə ʁəpoze]","exAr":"يرتاح بعد الظهر."},{"fr":"le soir","ar":"المساء","pos":"nom","g":"m","exFr":"Le soir, je lis.","ipa":"[swaʁ]","exAr":"مساءً أقرأ."},{"fr":"parce que","ar":"لأن","pos":"conj","exFr":"Il travaille parce qu'il a un examen.","ipa":"[paʁs kə]","exAr":"يعمل لأنه لديه امتحان."}],"grammar":[{"tFr":"Raconter une journée : le présent + repères","tAr":"القاعدة: سرد اليوم بالمضارع","body":["المضارع الوصفي يروي الروتين: verbs + d'abord/ensuite/enfin تبني الخط الزمني بلا أزمنة معقدة.","parce que يربط السبب بالحدث — وهو أول «وصلة منطقية» يحتاجها أي سرد."],"ex":[{"fr":"Le matin, je prends le bus à huit heures.","ar":"صباحاً أركب الحافلة الساعة الثامنة."},{"fr":"Ensuite, je travaille jusqu'à midi.","ar":"ثم أعمل حتى الظهر."}]}],"mistakes":[{"wrong":"حفظ مفردات القصة كقائمة منفصلة","right":"احفظها كسلسلة مرتبة بالأوقات","why":"القصة تتذكر كمشهد واحد، والقائمة تُنسى كأرقام."},{"wrong":"قرأة مرة واحدة ثم الانتقال","right":"مرة للفهم ومرة للاستخراج","why":"القراءة الثانية تحول الفهم العام إلى مفردات مُستخلصة."},{"wrong":"abandon عند كلمة غريبة","right":"تجاوز واستنتج من السياق","why":"الأفعال اليومية متوقعة — الكلمة الغريبة غالبًا لا تُسأل عنها."},{"wrong":"سرد بلا كلمات ربط","right":"ابدأ كل خطوة بـ d'abord/ensuite","why":"بلا ربط يبدو السرد كأفعال متناثرة لا قصة."}],"dialogues":[{"title":"حديث عن الروتين اليومي","ctx":"زميلان يقارنان يوميهما","lines":[{"who":"Sami","fr":"Moi, je me réveille à sept heures. Et toi ?","ar":"أنا أستيقظ الساعة السابعة. وأنت؟"},{"who":"Lina","fr":"Moi, à six heures et demie. D'abord je fais du sport.","ar":"أنا السادسة والنصف. أولاً أمارس الرياضة."},{"who":"Sami","fr":"Ensuite tu prends le petit-déjeuner ?","ar":"ثم تتناولين الفطور؟"},{"who":"Lina","fr":"Oui, du thé et du pain. Puis je vais au travail.","ar":"نعم، شاياً وخبزاً. ثم أذهب إلى العمل."},{"who":"Sami","fr":"Tu rentres à quelle heure ?","ar":"تعودين في أي ساعة؟"},{"who":"Lina","fr":"À dix-sept heures. Le soir, je me repose.","ar":"الساعة الخامسة. مساءً أرتاح."}]}],"exercises":[{"t":"mcq","skill":"reading","q":"من القصة: كيف يذهب سامي إلى الجامعة؟","opts":["En bus","En vélo","À pied","En voiture"],"a":1,"why":"النص: «il va à l'université en vélo»."},{"t":"mcq","skill":"reading","q":"لماذا يعمل سامي في المكتبة؟","opts":["Il aime la lecture","Il a un examen","Il cherche un travail","Son ami y travaille"],"a":1,"why":"«parce qu'il a un examen»."},{"t":"fill","skill":"grammar","q":"أكمل من القصة: «Sami ___ à sept heures.» (يستيقظ)","fr":"Sami ___ à sept heures.","ans":"se réveille","alts":["se reveille"],"why":"الفعل الانعكاسي se réveille في المضارع."},{"t":"order","skill":"reading","q":"رتّب أحداث يوم سامي: (المكتبة، الفطور، الاستيقاظ، الفيلم)","words":["Sami","se","réveille","d'abord"],"ans":"Sami se réveille d'abord","why":"الاستيقاظ أول حدث في اليوم."},{"t":"listen","skill":"listening","q":"استمع لجملة من القصة واخترها:","audio":"À midi, il mange avec son ami Karim","opts":["يأكل مع صديقه ظهراً","يأكل وحده مساءً","يشرب قهوة صباحاً","يعمل مع كريم ليلاً"],"a":0,"why":"À midi تعني الظهر لا المساء، وavec son ami Karim يحدّد الرفيق؛ فالإجابة الصحيحة وحدها تحافظ على الوقت والرفيق معاً: يأكل مع صديقه ظهراً."},{"t":"writing","skill":"writing","q":"اكتب «يوم في حياتك أنت» على نمط قصة سامي: 5 أسطر بالمضارع مع d'abord/ensuite/enfin.","min":18,"kw":["d'abord","ensuite","je"],"sample":"Je me réveille à six heures. D'abord, je prends mon café. Ensuite, je vais au travail en bus. À midi, je mange avec mes collègues. Le soir, enfin, je lis un livre et je dors tôt.","why":"السرد المطلوب ليس إعادة حفظ قصة سامي بل نقل نفس الهيكل إلى يومك: المضارع الوصفي لوصف الروتين وكلمات الترتيب d'abord و ensuite و enfin لربطه، وهما المهارتان اللتان يُقيَّم بهما سرد الروتين في A2."},{"t":"mcq","skill":"reading","q":"العنصر الأول في أي قصة قصيرة هو:","opts":["الحدث المحرّك (le problème)","الخاتمة","أسماء الشخصيات","تاريخ الكتابة"],"a":0,"why":"الحدث المحرّك يفتح الحكاية ويحرّك الشخصيات."},{"t":"fill","skill":"reading","q":"أكمل: «Il ___ une fois un roi très riche.» (كان)","fr":"Il ___ une fois un roi très riche.","ans":"était","alts":["Était"],"why":"imparfait من être مع il = était."}],"homework":"أعد سماع قصة سامي مرة واحدة، ثم احكِ يومك بصوت عالٍ بنفس الترتيب: استيقاظ ← فطور ← عمل/دراسة ← مساء.\nالدرس السابق/التالي: a2-t1-l3 (الإعلانات وقوائم الطعام والجداول) / a2-t2-l2 (قصة عطلة لايلا).","sources":[{"title":"قصة ليلى والذئب باللغة الفرنسية مترجمة للعربية – تعلم الفرنسية بسهولة! Le petit chaperon rouge","channel":"LE FRANÇAIS AVEC MOHAMED KB","videoId":"9rO7GN00L3E","why":"قصة عربية مترجمة قصيرة تُظهر السرد الفرنسي الحي — تسمع كلمات الربط والمضارع في قصة مكتملة.","cat":"Stories","level":"A2","main":true},{"title":"Don't Translate! Speak French Naturally || French Story for Beginners","channel":"Francais facile","videoId":"eZzcXDURn1k","why":"قصة مصممة للمبتدئين بمنهجية «لا تترجم» — تستمع وتفهم مباشرة بالفرنسية، وهي أهم مهارة تريد رسوخها من القصص.","cat":"Stories","level":"A2","extra":true},{"title":"Les enfants parlent français - Episode 1 : Je me présente (French conversation)","channel":"Les enfants parlent français","videoId":"y8trQNgkVPk","why":"أطفال فرنسيون يتحدثون ببطء وبساطة عن أنفسهم وأيامهم — بعد قراءة قصة سامي استمع لأطفال حقيقيين يحكون روتينهم لتقارن.","cat":"Stories","level":"A2","extra":true},{"title":"Le premier jour d'école de Rani: Apprendre le Français avec sous-titres","channel":"BookBox French","videoId":"ycxaG424TgI","why":"قصة مصورة بترجمة مزدوجة (نص + كلمات مبرزة) — تقنية BookBox التعليمية تجعل كل كلمة مرئية وواضحة.","cat":"Stories","level":"A2","extra":true}],"supplements":[{"id":"eZzcXDURn1k","title":"Don't Translate! Speak French Naturally || French Story for Beginners","channel":"Francais facile","why":"قصة مصممة للمبتدئين بمنهجية «لا تترجم» — تستمع وتفهم مباشرة بالفرنسية، وهي أهم مهارة تريد رسوخها من القصص.","lang":"fr"},{"id":"y8trQNgkVPk","title":"Les enfants parlent français - Episode 1 : Je me présente (French conversation)","channel":"Les enfants parlent français","why":"أطفال فرنسيون يتحدثون ببطء وبساطة عن أنفسهم وأيامهم — بعد قراءة قصة سامي استمع لأطفال حقيقيين يحكون روتينهم لتقارن.","lang":"fr"},{"id":"ycxaG424TgI","title":"Le premier jour d'école de Rani: Apprendre le Français avec sous-titres","channel":"BookBox French","why":"قصة مصورة بترجمة مزدوجة (نص + كلمات مبرزة) — تقنية BookBox التعليمية تجعل كل كلمة مرئية وواضحة.","lang":"fr"}]},{"id":"A2-t2-l2","fr":"Les vacances de Leïla (au passé)","ar":"قصة: عطلة لايلا في المغرب","objectives":["قراءة قصة كاملة بالماضي المركب والناقص","التمييز في القصة بين الخلفية (imparfait) والحدث (passé composé)","سرد عطلتك الماضية بترتيب زمني صحيح"],"sections":[{"h":"القصة: عطلة لايلا","p":["اقرأ القصة: «L'été dernier, Leïla est allée au Maroc avec sa famille. Il faisait très chaud. D'abord, ils ont visité Marrakech : ils ont vu la place Jemaa el-Fna et ils ont mangé du tajine. Un jour, pendant qu'ils se promenaient, Leïla a rencontré une vieille amie ! Elles ont beaucoup parlé. Le voyage était court mais inoubliable.»","لاحظ اللعبة الزمنية: «Il faisait très chaud» و«pendant qu'ils se promenaient» ناقص (خلفية/مشهد)، بينما «est allée، ont visité، ont vu، a rencontré، ont parlé» مركب (أحداث تقدّم القصة). هذه هي قراءة الماضي الصحيحة: الناقص يرسم والإطار، والمركب يحرّك السهم.","تابع الفيديو الأساسي بالشرح العربي: رحلة مصوّرة تُروى بالزمنين معًا. حين تسمع «il faisait» تعرف أن الكاميرا وقفت لتصوير المشهد، وحين تسمع «nous avons visité» تعرف أن القصة تحركت — استمع وصنّف كل جملة بعينك.","خدعة للتمييز أثناء القراءة: اسأل نفسك «هل هذه الجملة تُحرك القصة أم تصف المشهد؟». الجمل المحركة (ذهب، زار، رأى، التقى) = passé composé. الجمل التي ترسم (كان الجو، كانوا يتنزهون، كانت تمطر) = imparfait.","الكلمات المرشدة: «L'été dernier، Un jour، Soudain، D'abord...Enfin» تلمّح لحدث مركب، بينما «Il faisait، C'était، Nous habitions، pendant que» تلمّح لناقص. اقرأ بهذه العدسة وستتحسن سرعتك جذرياً لأن التوقّع يسبق الفهم.","قاعدة الصياغة لسرد عطلتك: افتتاحية زمنية + خلفية ناقصة + ثلاثة أحداث مركبة + خاتمة بذوق. أربعة أجزاء جاهزة تُمسك بها في أي سؤال امتحاني عن «summer holidays» — والجزء الرابع (C'était génial !) يضيف لمسة فرنسية تُحبّها لجنة التقييم."],"video":{"id":"LxThPaNoXo4","title":"تعلم كيف تتحدث عن موضوع رحلة قصيرة إلى حديقة الحيوانات بالفرنسية مترجمة بالعربية - Sortie en famille","channel":"Speak French & English","why":"سرد رحلة بالعربية والفرنسية معًا — نموذج جاهز لرواية العطلة بالزمن الماضي.","lang":"ar","main":true,"dur":12},"sub":[{"h":"الزمنان في القصة: من يرسم ومن يحرّك","p":["imparfait (الخلفية): Il faisait chaud / ils se promenaient / c'était beau.","passé composé (الأحداث): est allée / ont visité / a rencontré / ont parlé.","السؤال الحاسم: هل تُتحرك القصة أم تُرسم؟"]},{"h":"كلمات تلمّح لكل زمن","p":["المركب: l'été dernier, un jour, soudain, d'abord, enfin.","الناقص: toujours, tous les jours, pendant que, quand j'étais...","علامة واحدة تكفي لتوجيه العين: pendant que ← ناقص دائمًا."]},{"h":"قالب سرد العطلة (4 أجزاء)","p":["الافتتاح: L'été dernier / Il y a deux ans...","الخلفية: Le temps était beau / Nous habitions un hôtel...","الأحداث: j'ai visité، j'ai mangé، j'ai rencontré...","الخاتمة: C'était inoubliable ! / J'ai beaucoup aimé."]}]},{"h":"تمرين الحس الزمني في القصص","p":["خدعة للتمييز أثناء القراءة: اسأل نفسك «هل هذه الجملة تُحرك القصة أم تصف المشهد؟». الجمل المحركة (ذهب، زار، رأى، التقى) = passé composé. الجمل التي ترسم (كان الجو، كانوا يسكنون، كانت تمطر) = imparfait.","الكلمات المرشدة: «L'été dernier، Un jour، Soudain، D'abord...Enfin» تلمّح لحدث مركب، بينما «Il faisait، C'était، Nous habitions، pendant que» تلمّح لناقص. اقرأ بهذه العدسة وستتحسن سرعتك جذرياً.","التمرين العملي: أعد قراءة القصة وضع نقطة أمام كل جملة مركبة ودائرة حول كل جملة ناقصة. عشر جمل فقط — لكنها تثبت العين على النمط قبل أن تثبته القاعدة."],"video":null},{"h":"سرد عطلتك أنت","p":["الآن حاكِ نموذج لايلا في سرد عطلة قصيرة: افتتاحية زمنية (L'été dernier / Il y a deux ans) + الخلفية بالناقص (Le temps était beau) + ثلاثة أحداث بالمركب (j'ai visité، j'ai mangé، j'ai rencontré) + خاتمة بذوق (C'était génial !).","أخطاء شائعة في سرد العطلات: «J'ai été très content» صحيحة لكن «C'était très content» خطأ (الشعور بشخص: j'étais content). و«Je suis allé au Maroc» ليست «Je vais au Maroc» إلا إذا كانت خطة مستقبلية.","الفيديو الإثرائي يعرض سرد رحلة فعلية؛ أوقفه بعد كل جملة وصنّفها أنت (ناقص أم مركب؟) قبل أن تسمع شرح المدرّس. التصنيف المستباقي هو التمرين الأهم في هذا الدرس."],"video":null},{"h":"التطبيق والتلخيص","p":["يلخّص هذا الدرس قراءة الماضي وسرده: الناقص يرسم الخلفية والمشهد (Il faisait, ils se promenaient) والمركب يحرّك الأحداث (est allée, ont visité, a rencontré)، وكلمات إرشادية واحدة تحسم غالبًا (pendant que ← ناقص، soudain / un jour ← مركب)، مع قالب سرد العطلة من أربعة أجزاء. كما وضح الفيديو الرئيسي «تعلم كيف تتحدث عن موضوع رحلة قصيرة إلى حديقة الحيوانات بالفرنسية مترجمة بالعربية - Sortie en famille» من قناة «Speak French & English»، تُروى الرحلة بالزمنين معًا: حين تسمع «il faisait» توقّف الكاميرا لتصوير المشهد، وحين تسمع «nous avons visité» تحركت القصة.","الجسر التعليمي داخل خريطة المستوى، بالترتيب: a2-t1-l1 (قراءة النصوص القصيرة) ← a2-t1-l2 (قراءة الرسائل والإيميلات) ← a2-t1-l3 (الإعلانات وقوائم الطعام والجداول) ← a2-t2-l1 (قصة يوم في حياة سامي) ← a2-t2-l2 (قصة عطلة لايلا) ← a2-t2-l3 (حكاية الأسد والفأر) ← a2-t3-l1 (الماضي المركب مقابل الناقص). هذا الدرس حلقة تحوّل في المسار: يستلم a2-t2-l1 الذي سرد الروتين بالمضارع، ويحوّله إلى الماضي دون أن يغيّر تسلسل الأحداث، ويسلّم إلى a2-t2-l3 الحكاية التي تجمع الناقص للخلفية والمركب للأحداث و futur simple للوعد، ثم a2-t3-l1 الذي يعطي القاعدة الصريحة للزمنين، بعد أن تكون قد قرأت وسردت قبل القاعدة.","أعد مشاهدة الفيديو الرئيسي وأصنّف كل جملة تسمعها بعينك (ناقص للخلفية أم مركب للحدث)، ثم سجّل نفسك وأنت تسرد عطلة قصيرة دقيقتين: افتتاحية زمنية، ثم جملتين ناقصتين للخلفية، ثم ثلاثة أحداث مركبة، ثم خاتمة، وصحّح في تسجيلك أي حدث فردي وقع بالناقص قبل أن تنتقل إلى a2-t2-l3."]}],"examples":[{"fr":"L'été dernier, elle est allée au Maroc.","ar":"الصيف الماضي ذهبت للمغرب."},{"fr":"Il faisait très chaud à Marrakech.","ar":"كان الجو حاراً جداً في مراكش."},{"fr":"Ils ont mangé du tajine traditionnel.","ar":"أكلوا طاجيناً تقليدياً."},{"fr":"Le voyage était inoubliable.","ar":"كانت الرحلة لا تُنسى."},{"fr":"L'été dernier, je suis allée au Maroc.","ar":"الصيف الماضي ذهبت إلى المغرب.","note":"افتتاحية زمنية"},{"fr":"Il faisait beau quand nous nous promenions.","ar":"كان الجو جميلاً حين كنا نتنزه.","note":"خلفية ناقصة"},{"fr":"Soudain, j'ai vu un vieil ami.","ar":"فجأة رأيت صديقاً قديماً.","note":"حدث مركب"},{"fr":"Le voyage court mais inoubliable.","ar":"رحلة قصيرة لكنها لا تُنسى.","note":"خاتمة"}],"pron":[{"w":"L'été dernier","ipa":"[le.te dɛʁ.nje]","approx":"ليتيه-دِرنييه"},{"w":"inoubliable","ipa":"[i.nu.bli.jabl]","approx":"إينو-بليابْل"},{"w":"ils ont visité","ipa":"[il.zɔ̃.vi.zi.te]","approx":"يل-زون-ڤيزيتيه"}],"vocab":[{"fr":"l'été dernier","ar":"الصيف الماضي","pos":"expression","ipa":"[le.te dɛʁ.nje]","exFr":"L'été dernier, j'ai voyagé.","exAr":"الصيف الماضي سافرت."},{"fr":"se promener","ar":"يتجول","pos":"verbe","ipa":"[sə.pʁɔm.ne]","exFr":"Nous nous promenions au souk.","exAr":"كنا نتجول في السوق."},{"fr":"rencontrer","ar":"يقابل / يصادف","pos":"verbe","ipa":"[ʁɑ̃.kɔ̃.tʁe]","exFr":"J'ai rencontré mon ancien prof.","exAr":"صادفت أستاذي القديم."},{"fr":"inoubliable","ar":"لا يُنسى","pos":"adj","g":"mf","ipa":"[i.nu.bli.jabl]","exFr":"C'était un voyage inoubliable.","exAr":"كانت رحلة لا تُنسى."},{"fr":"court(e)","ar":"قصير(ة)","pos":"adj","g":"mf","ipa":"[kuʁ]","exFr":"Les vacances étaient courtes.","exAr":"كانت العطلة قصيرة."},{"fr":"le tajine","ar":"الطاجين","pos":"nom","g":"m","pl":"les tajines","ipa":"[ta.ʒin]","exFr":"Le tajine était délicieux.","exAr":"كان الطاجين لذيذاً."},{"fr":"le voyage","ar":"السفر/الرحلة","pos":"nom","g":"m","exFr":"Le voyage était inoubliable.","ipa":"[vwaʒaʒ]","exAr":"كانت الرحلة لا تُنسى."},{"fr":"la famille","ar":"العائلة","pos":"nom","g":"f","exFr":"J'ai voyagé avec ma famille.","ipa":"[famij]","exAr":"سافرت مع عائلتي."},{"fr":"visiter","ar":"يزور (معلماً)","pos":"verbe","g":"1er","exFr":"Nous avons visité la ville.","ipa":"[vizite]","exAr":"زرنا المدينة."},{"fr":"la chaleur","ar":"الحرارة (الجو)","pos":"nom","g":"f","exFr":"Il faisait très chaud.","ipa":"[ʃalœʁ]","exAr":"كان الجو حاراً جداً."}],"grammar":[{"tFr":"Imparfait + passé composé dans un récit","tAr":"القاعدة: تداخل الزمنين في السرد","body":["الناقص يصف ويُنَوِّم (il faisait, ils se promenaient)، والمركب يُحرِّك الأحداث (est allée, a rencontré).","كلمة إرشادية واحدة تحسم غالبًا: pendant que ← ناقص، soudain/un jour ← مركب."],"ex":[{"fr":"Il pleuvait quand je suis sorti.","ar":"كانت تمطر حين خرجت."},{"fr":"Pendant que je dormais, il a téléphoné.","ar":"بينما كنت نائماً اتصل."}]}],"mistakes":[{"wrong":"استخدام المركب للخلفية: «Il a fait beau»","right":"Il faisait beau","why":"وصف حالة مستمرة = ناقص، حتى لو انتهى في الواقع."},{"wrong":"الناقص للأحداث: «Je marchais et j'ai vu...» (بلا حدث)","right":"الأحداث الفردية مركبة دائماً","why":"المشي المشهد (ناقص) والرؤية حدث (مركب) — تداخلان لكن كلٌّ بدوره."},{"wrong":"J'étais content بتغيير الفاعل","right":"الشعور بـ être في المضارع: j'étais content","why":"passé composé بـ avoir للحالة لا يصل هنا."},{"wrong":"سرد بلا افتتاحية زمنية","right":"ابدأ بـ L'été dernier / Un jour","why":"الامتحان يبحث عن تموضع زمني واضح من الجملة الأولى."}],"dialogues":[{"title":"حديث عن العطلة الماضية","ctx":"صديقان يذكّران رحلة","lines":[{"who":"Riad","fr":"Tu te souviens du Maroc l'été dernier ?","ar":"أتتذكر المغرب الصيف الماضي؟"},{"who":"Leïla","fr":"Bien sûr ! Il faisait très chaud à Marrakech.","ar":"بالتأكيد! كان الجو حاراً جداً في مراكش."},{"who":"Riad","fr":"Qu'est-ce que vous avez visité ?","ar":"ماذا زرتم؟"},{"who":"Leïla","fr":"Nous avons visité la médina et la place Jemaa el-Fna.","ar":"زرنا المدينة القديمة والساحة."},{"who":"Riad","fr":"Et vous vous promeniez le soir, non ?","ar":"وكنتم تتنزهون مساءً، أليس كذلك؟"},{"who":"Leïla","fr":"Oui, pendant qu'ils se promenaient, j'ai rencontré une amie !","ar":"نعم، وبينما كانوا يتنزهون قابلت صديقة!"}]}],"exercises":[{"t":"mcq","skill":"reading","q":"«Il faisait très chaud» — لماذا الناقص هنا؟","opts":["حدث مفاجئ","وصف خلفية/مشهد","عادة بعيدة","مستقبل"],"a":1,"why":"وصف الجو يرسم المشهد ← imparfait."},{"t":"mcq","skill":"grammar","q":"«Leïla ___ une vieille amie» (يصادف، حدث):","opts":["rencontrait","a rencontré","rencontre","rencontrera"],"a":1,"why":"حدث محدد يحرك القصة ← passé composé."},{"t":"fill","skill":"grammar","q":"أكمل بالناقص: «Nous ___ au souk.» (يتجول)","fr":"Nous ___ au souk.","ans":"nous promenions","alts":["promenions"],"why":"se promener بالناقص: nous nous promenions."},{"t":"order","skill":"reading","q":"رتّب قصة لايلا: (التقاط الصديقة، الذهاب للمغرب، تناول الطاجين)","words":["D'abord,","elle","est","allée","au","Maroc"],"ans":"D'abord, elle est allée au Maroc","why":"الذهاب أول حدث ثم الزيارة ثم اللقاء."},{"t":"listen","skill":"listening","q":"استمع واختر الزمن الصحيح:","audio":"Pendant qu'ils se promenaient, Leïla a rencontré son amie","opts":["ناقص ثم مركب","مركب ثم ناقص","مضارع فقط","ناقص فقط"],"a":0,"why":"se promenaient خلفية ناقصة، a rencontré حدث مركب."},{"t":"writing","skill":"writing","q":"اكتب عن عطلة قصيرة عشتها: افتتاحية زمنية + خلفية ناقصة + حدثان مركبان + خاتمة. (5 أسطر)","min":20,"kw":["ai","était","ai visité"],"sample":"L'année dernière, je suis allé à Alexandrie. Le temps était magnifique. J'ai visité la bibliothèque et j'ai mangé du poisson. J'ai rencontré de nouveaux amis. C'était inoubliable !","why":"القالب الأربعة أجزاء هو ما يُختبر هنا: افتتاحية زمنية توضّع الحدث، ثم خلفية بالناقص ترسم المشهد، ثم حادثتان بالمركب تحرّكان السرد، ثم خاتمة بذوق فرنسي؛ فأي جملة خرجت عن دورها اختلّ التمييز بين الرسم والحركة."},{"t":"mcq","skill":"reading","q":"الفعل الذي يحرّك الأحداث في الحكاية يسمى:","opts":["الفعل المحرّك","صفة الوصف","جملة السياق","الرابط"],"a":0,"why":"الأفعال المحرّكة تبني الحبكة والتسلسل."},{"t":"order","skill":"reading","q":"رتّب عناصر الحكاية: (1) الحل (2) المشكلة (3) النتيجة","words":["Le problème","apparaît,","puis","vient","la solution."],"ans":"Le problème apparaît, puis vient la solution.","why":"المشكلة أولاً ثم الحل — التسلسل المنطقي للحبكة."}],"homework":"احكِ عطلتك الماضية صوتياً لمدة دقيقة واحدة: سجّل نفسك وأنت تستخدم ناقصاً للخلفية ومركباً للأحداث.\nالدرس السابق/التالي: a2-t2-l1 (قصة يوم في حياة سامي) / a2-t2-l3 (حكاية الأسد والفأر).","sources":[{"title":"تعلم كيف تتحدث عن موضوع رحلة قصيرة إلى حديقة الحيوانات بالفرنسية مترجمة بالعربية - Sortie en famille","channel":"Speak French & English","videoId":"LxThPaNoXo4","why":"سرد رحلة بالعربية والفرنسية معًا — نموذج جاهز لرواية العطلة بالزمن الماضي.","cat":"Stories","level":"A2","main":true},{"title":"Le Pouvoir de l'Aide - Best French Short Story to Improve French Conversation","channel":"CCube Academy","videoId":"EXa5OWG4XeY","why":"قصة قصيرة كاملة بصوت واضح وتشخيص حي — قصص CCube مصممة خصيصاً لتعليم المحادثة عبر السرد.","cat":"Stories","level":"A2","extra":true},{"title":"IMPARFAIT French Dialogue Conversation Practice Cartoon Short Film","channel":"CCube Academy","videoId":"KgQnUx-0wt0","why":"حوار كرتوني قصير يمارس الناقص في سياق حي — يقوّي إحساسك بالزمن الذي «يرسم الخلفية» قبل قراءة قصص أطول.","cat":"Stories","level":"A2","extra":true},{"title":"La question à 1 million : passé composé ou imparfait ?","channel":"innerFrench","videoId":"3rpQ5xeFneg","why":"بودكاست هادئ يفكّ أشهر لغز في الفرنسية (متى المركب ومتى الناقص؟) بأسلوب سمعي مريح — مثالي أثناء القصة.","cat":"Stories","level":"A2","extra":true}],"supplements":[{"id":"EXa5OWG4XeY","title":"Le Pouvoir de l'Aide - Best French Short Story to Improve French Conversation","channel":"CCube Academy","why":"قصة قصيرة كاملة بصوت واضح وتشخيص حي — قصص CCube مصممة خصيصاً لتعليم المحادثة عبر السرد.","lang":"fr"},{"id":"KgQnUx-0wt0","title":"IMPARFAIT French Dialogue Conversation Practice Cartoon Short Film","channel":"CCube Academy","why":"حوار كرتوني قصير يمارس الناقص في سياق حي — يقوّي إحساسك بالزمن الذي «يرسم الخلفية» قبل قراءة قصص أطول.","lang":"fr"},{"id":"3rpQ5xeFneg","title":"La question à 1 million : passé composé ou imparfait ?","channel":"innerFrench","why":"بودكاست هادئ يفكّ أشهر لغز في الفرنسية (متى المركب ومتى الناقص؟) بأسلوب سمعي مريح — مثالي أثناء القصة.","lang":"fr"}]},{"id":"A2-t2-l3","fr":"Le Lion et la Souris (La Fontaine)","ar":"حكاية الأسد والفأر","objectives":["قراءة حكاية كلاسيكية مبسطة وفهم المغزى","تعلّم مفردات الحكايات (sursaut, gracier, libérer...)","إعادة سرد الحكاية بكلماتك"],"sections":[{"h":"الحكاية: Le Lion et la Souris","p":["اقرأ الحكاية المبسطة: «Un lion dormait sous un arbre. Une souris a couru sur son nez ! Le lion s'est réveillé et il a attrapé la souris. «Pardonne-moi !» a crié la souris. «Un jour, je pourrai t'aider.» Le lion a ri, mais il l'a laissée partir. Quelques jours plus tard, le lion est tombé dans un piège. La souris a rongé les cordes et l'a libéré. Moralité : même les petits peuvent aider les grands.»","الحكاية تستثمر نفس بنية قصة لايلا: الناقص للخلفية (dormait، سرّد تحت الشجرة) والمركب للأحداث (a couru، a attrapé، est tombé، a rongé). اقرأها مرة ثالثة وأنت تصنّف — ستجد النمط يعرفه دماغك الآن تلقائياً.","شاهد الفيديو الأساسي بالشرح العربي: الحكاية نفسها مرويّة بتعريب كامل. ميزة معرفة النهاية مسبقاً أن ذهنك مُشغَّل بفهم اللغة لا بتشويق الحبكة — وهذه هي أفضل حالة لتعلّم لغة ثانية.","الحكايات تعلّمك كنزاً من أدوات السرد: «Un jour» (ذات يوم)، «Quelques jours plus tard» (بعد أيام قليلة)، «Soudain» (فجأة)، «Enfin» (أخيراً). ابدأ جملتك بإحداها وسيبدو سردك فرنسياً أصيلاً فوراً.","حوار الحكاية قصير وحاد: «Pardonne-moi !» و«Je pourrai t'aider». الحوارات في القصص القصيرة هي أنقى لغة مكتوبة ستقابلها — لاحظ موضع الضمائر (t'aider، l'a laissée) فهو تطبيق مباشر لقواعد COD التي تعلمتها.","أعد السرد بثلاث خطوات: 1) بالترتيب مع كلمات السرد، 2) أضف الحوار بصوتك المختلف لكل حيوان، 3) اختم بالمغزى. الخطوة الثالثة تحوّل اللغة من حفظ إلى تعبير — والمغزى جملة واحدة تحفظ الحكاية كاملة في ذاكرتك."],"video":{"id":"Og7N8WPwX1A","title":"قصة الأسد والفأر باللغة الفرنسية (مترجمة بالعربية)","channel":"LE FRANÇAIS AVEC MOHAMED KB","why":"نفس حكاية الدرس (الأسد والفأر) مترجمة بالعربية — تتابع النص وأنت تعرف نهايته مسبقًا فيسهل الفهم.","lang":"ar","main":true,"dur":3},"sub":[{"h":"مفردات الحكايات الأساسية","p":["Un jour / Soudain / Enfin — ذات يوم / فجأة / أخيراً.","attraper (يمسك)، pardonner (يسامح)، libérer (يحرّر).","le piège (الفخ)، les cordes (الحبال)، ronger (يقضم).","la moralité — المغزى/العبرة"]},{"h":"الأزمنة في الحكاية","p":["dormait — خلفية: الأسد نائم تحت الشجرة.","a couru / a attrapé / est tombé — سلسلة أحداث مركبة.","pourrai — futur simple: وعد الفأر بالمستقبل."]},{"h":"قالب إعادة السرد","p":["1) بالترتيب: Un jour, puis, ensuite, enfin.","2) الحوار بصوتين: «Pardonne-moi !» / «Je pourrai t'aider».","3) المغزى: Moralité : même les petits peuvent aider les grands."]}]},{"h":"أدوات السرد في الحكايات","p":["الحكايات تعلّمك كنزاً من أدوات السرد: «Un jour» (ذات يوم)، «Quelques jours plus tard» (بعد أيام قليلة)، «Soudain» (فجأة)، «Enfin» (أخيراً). ابدأ جملتك بإحداها وسيبدو سردك فرنسياً أصيلاً فوراً.","لاحظ الأزمنة: الحكاية تبدأ بالناقص (dormait — المشهد)، ثم المركب للأحداث (a couru, a attrapé, a crié, a laissé, est tombé, a rongé). نفس نمط قصة لايلا — النمطان يحكمان كل سرد بالفرنسية.","لاحظ «Je pourrai» بـ futur simple داخل الحكاية: الماضي يُروى والمستقبل يُوعَد به — مزيج تجده في كل قصة ويذكّرك بدرس المستقبل البسيط."],"video":null},{"h":"أعد السرد بكلماتك","p":["أفضل تمرين بعد الحكاية: أعد سردك لها بصوت عالٍ بثلاث خطوات — 1) بالترتيب مع كلمات السرد (Un jour، puis، enfin)، 2) أضف الحوار («Pardonne-moi !»)، 3) اختم بالمغزى: «Moralité : ...».","الغرابة اللغوية: «Il l'a laissée partir» فيها l' ضمير COD قبل الفعل المساعد (راجع درس الضمائر في مسار القواعد)، و«partir» تبقى بمصدرها بعد laisser. تراكيب كهذه ستقابلها في كل قراءة.","الفيديو الإثرائي يروي الحكاية بصوت درامي؛ استمع وأنت تُغمض عينيك ثم أعد الجزء الأخير بصوتك. الإعادة الصوتية بعد الإغماض تثبت النص في الذاكرة العاملة."],"video":null},{"h":"التطبيق والتلخيص","p":["يلخّص هذا الدرس بنية الحكاية الفرنسية: ناقص للخلفية الافتتاحية (dormait)، مركب لسلسلة الأحداث (a couru, a attrapé, est tombé, a rongé)، و futur simple للوعد (je pourrai)، مع أدوات سرد ثابتة (Un jour, Quelques jours plus tard, Soudain, Enfin) وخاتمة بالمغزى (Moralité). كما وضح الفيديو الرئيسي «قصة الأسد والفأر باللغة الفرنسية (مترجمة بالعربية)» من قناة «LE FRANÇAIS AVEC MOHAMED KB»، تُروى الحكاية نفسها متعربية بالكامل، وميزتها أنك تعرف النهاية مسبقاً فيترك ذهنك مشغولاً باللغة لا بتشويق الحبكة.","الجسر التعليمي داخل خريطة المستوى، بالترتيب: a2-t1-l1 (قراءة النصوص القصيرة) ← a2-t1-l2 (قراءة الرسائل والإيميلات) ← a2-t1-l3 (الإعلانات وقوائم الطعام والجداول) ← a2-t2-l1 (قصة يوم في حياة سامي) ← a2-t2-l2 (قصة عطلة لايلا) ← a2-t2-l3 (حكاية الأسد والفأر) ← a2-t3-l1 (الماضي المركب مقابل الناقص). هذا آخر درس في مسار القصص: يستلم a2-t2-l2 حيث تمّ التمييز بين الناقص والمركب في سرد عطلة، ويضيف عليه الحوار والمغزى و futur simple داخل النص، ويسلّم كاملاً إلى a2-t3-l1 الذي يبدأ مسار القواعد بالماضي المركب مقابل الناقص، فتصبح القاعدة مبنيّة على نصوص قرأتها وسردتها بالفعل.","أعد مشاهدة الفيديو الرئيسي وأنت تتابع النص المكتوب كلمة بكلمة مع الصوت، ثم سجّل نفسك وأنت تعيد سرد الحكاية بثلاث خطوات: الترتيب بكلمات السرد، ثم الحوار بصوتَي الأسد والفأر، ثم المغزى بجملة واحدة، وصحّح في تسجيلك أي أفعال خرجت عن المضارع البسيط قبل أن تنتقل إلى a2-t3-l1."]}],"examples":[{"fr":"Un lion dormait sous un arbre.","ar":"كان أسد ناماً تحت شجرة."},{"fr":"Le lion a attrapé la souris.","ar":"أمسك الأسد الفأر."},{"fr":"La souris a rongé les cordes.","ar":"قرضت الفأر الحبال."},{"fr":"Même les petits peuvent aider les grands.","ar":"حتى الصغار يستطيعون مساعدة الكبار."},{"fr":"Un jour, la souris a sauvé le lion.","ar":"ذات يوم أنقذت الفأرة الأسد.","note":"حدث مركب"},{"fr":"Le lion a ri mais il l'a laissée partir.","ar":"ضحك الأسد لكنه تركها تمضي.","note":"COD قبل الفعل المساعد"},{"fr":"Je pourrai t'aider un jour.","ar":"سأستطيع مساعدتك ذات يوم.","note":"futur simple + COD"},{"fr":"Moralité : les petits comptent aussi.","ar":"المغزى: الصغار يُحسب لهم أيضاً.","note":"المغزى"}],"pron":[{"w":"s'est réveillé","ipa":"[sɛ ʁe.ve.je]","approx":"سِه-ره-ڤيه-يه"},{"w":"il a ri","ipa":"[il.a.ʁi]","approx":"إيل-آ-ري"},{"w":"la moralité","ipa":"[la.mɔ.ʁa.li.te]","approx":"لاموراليتيه"}],"vocab":[{"fr":"attraper","ar":"يمسك / يأسر","pos":"verbe","ipa":"[a.tʁa.pe]","exFr":"Le chat a attrapé la souris.","exAr":"أمسك القط الفأر."},{"fr":"pardonner","ar":"يسامح","pos":"verbe","ipa":"[paʁ.dɔ.ne]","exFr":"Pardonne-moi, s'il te plaît.","exAr":"سامحني من فضلك."},{"fr":"un piège","ar":"مصيدة","pos":"nom","g":"m","pl":"des pièges","ipa":"[pjɛʒ]","exFr":"Le lion est tombé dans un piège.","exAr":"وقع الأسد في مصيدة."},{"fr":"ronger","ar":"يقضّ / يقرض","pos":"verbe","ipa":"[ʁɔ̃.ʒe]","exFr":"La souris a rongé la corde.","exAr":"قرضت الفأر الحبل."},{"fr":"libérer","ar":"يحرر","pos":"verbe","ipa":"[li.be.ʁe]","exFr":"Elle a libéré l'oiseau.","exAr":"حررت العصفور."},{"fr":"la moralité","ar":"المغزى / العبرة","pos":"nom","g":"f","pl":"les moralités","ipa":"[mɔ.ʁa.li.te]","exFr":"Quelle est la moralité de l'histoire ?","exAr":"ما مغزى الحكاية؟"},{"fr":"un lion","ar":"أسد","pos":"nom","g":"m","exFr":"Le lion dormait.","ipa":"[ljɔ̃]","exAr":"كان الأسد نائماً."},{"fr":"une souris","ar":"فأرة","pos":"nom","g":"f","pl":"les souris","exFr":"La souris a aidé le lion.","ipa":"[suʁi]","exAr":"ساعدت الفأرة الأسد."},{"fr":"les cordes","ar":"الحبال","pos":"nom","g":"f.pl","exFr":"Les cordes sont fortes.","ipa":"[kɔʁd]","exAr":"الحبال قوية."},{"fr":"même","ar":"حتى/نفسه","pos":"prép","exFr":"Même les petits peuvent aider.","ipa":"[mɛm]","exAr":"حتى الصغار يمكنهم المساعدة."}],"grammar":[{"tFr":"Le récit : imparfait, passé composé, futur","tAr":"القاعدة: ثلاثة أزمنة في حكاية واحدة","body":["الخلفية ناقصة (dormait)، الأحداث مركبة (a attrapé، est tombé)، والوعد/التوقّع futur simple (pourrai).","laisser + مصدر مع ضمير COD: il l'a laissée partir — نمط شائع في الحكايات وسياق ممتاز لترسيخ الضمائر."],"ex":[{"fr":"Le lion a ri et il est parti.","ar":"ضحك الأسد وذهب."},{"fr":"Un jour, je serai grand.","ar":"ذات يوم سأكون كبيراً."}]}],"mistakes":[{"wrong":"كل الحكاية بزمن واحد","right":"خلفية ناقصة + أحداث مركبة","why":"الأزمنة الثلاثة (مع futur للوعد) هي بنية الحكاية الفرنسية نفسها."},{"wrong":"Il l'a laissée (بلا e)","right":"Il l'a laissée partir","why":"laissée تطابق la souris المؤنثة."},{"wrong":"تجاهل المغزى","right":"اختم بـ Moralité :...","why":"المغزى يربط الحكاية بعبرة ويُسأل عنه في الفهم."},{"wrong":"قراءة الحوار بنبرة واحدة","right":"أعطِ كل شخصية صوتها","why":"التمثيل الصوتي يثبت الحوار ويطوّر النطق معاً."}],"dialogues":[{"title":"مناقشة المغزى","ctx":"معلّمة وطلاب بعد الحكاية","lines":[{"who":"Mme Claire","fr":"Quelle est la moralité de cette histoire ?","ar":"ما مغزى هذه القصة؟"},{"who":"Amine","fr":"Même les petits peuvent aider les grands.","ar":"حتى الصغار يمكنهم مساعدة الكبار."},{"who":"Mme Claire","fr":"Exactement. Et pourquoi le lion a-t-il laissé la souris partir ?","ar":"بالضبط. ولماذا ترك الأسد الفأرة تمضي؟"},{"who":"Sara","fr":"Parce qu'il a ri, mais il l'a laissée partir.","ar":"لأنه ضحك، لكنه تركها تمضي."},{"who":"Mme Claire","fr":"Bravo ! Et qu'est-ce qu'elle a fait après ?","ar":"أحسنت! وماذا فعلت بعد ذلك؟"},{"who":"Amine","fr":"Elle a rongé les cordes et l'a libéré du piège.","ar":"قضمت الحبال وحررته من الفخ."}]}],"exercises":[{"t":"mcq","skill":"reading","q":"ماذا وعدت الفأر الأسد؟","opts":["أن تجلب له طعاماً","أن تساعده يوماً ما","أن تخرج من بيته","أن تغني له"],"a":1,"why":"«Un jour, je pourrai t'aider» — سأساعدك يوماً."},{"t":"mcq","skill":"reading","q":"كيف حررت الفأر الأسد؟","opts":["أعادت له مالاً","قرضت الحبال","طلبت مساعدة أخرى","داست على المصيدة"],"a":1,"why":"«La souris a rongé les cordes»."},{"t":"fill","skill":"grammar","q":"أكمل: «Le lion ___ dans un piège.» (وقع، passé composé)","fr":"Le lion ___ dans un piège.","ans":"est tombé","alts":["tombé"],"why":"tomber فعل حركة: être + tombé."},{"t":"mcq","skill":"grammar","q":"«Un lion dormait» — الناقص هنا لأنه:","opts":["حدث منتهٍ","وصف المشهد الافتتاحي","أمر","تنبؤ"],"a":1,"why":"افتح الحكايات دائماً بوصف المشهد بالناقص."},{"t":"order","skill":"reading","q":"رتّب أحداث الحكاية: (التحرير، المسك، الوقوع في المصيدة، وعد الفأر)","words":["Le","lion","a","attrapé","la","souris"],"ans":"Le lion a attrapé la souris","why":"المسك حدث ثانٍ بعد الجري على أنفه."},{"t":"speaking","skill":"speaking","q":"اسرد نهاية الحكاية صوتياً: الفأر تحرر الأسد والمغزى.","target":"La souris a rongé les cordes et a libéré le lion. Même les petits peuvent aider les grands","why":"إعادة السرد الشفوية تختبر ثلاثية الحكاية معاً: حدث التحرير بالمركب (a rongé, a libéré) ثم صياغة المغزى بجملة واحدة مخفوضة الأسلوب؛ وبدون المغزى يبقى السرد وصفاً للأحداث لا حكاية مكتملة."},{"t":"mcq","skill":"reading","q":"المغزى (la morale) في الحكاية هو:","opts":["الدرس أو الفكرة النهائية","اسم البطل","مكان الأحداث","أول جملة"],"a":0,"why":"المغزى هو الرسالة التي تخرج بها القصة."},{"t":"translate","skill":"writing","q":"ترجم: «انتهى الحدث والجميع سعيد.»","ans":"L'histoire est terminée et tout le monde est content.","alts":["l'histoire est terminee et tout le monde est content"],"why":"tout le monde = الجميع."}],"homework":"أعد سرد الحكاية لأحد أفراد عائلتك بالفرنسية (أو صوّر نفسك) بثلاثة أسطر على الأقل مع كلمة المغزى Moralité.\nالدرس السابق/التالي: a2-t2-l2 (قصة عطلة لايلا) / a2-t3-l1 (الماضي المركب مقابل الناقص).","sources":[{"title":"قصة الأسد والفأر باللغة الفرنسية (مترجمة بالعربية)","channel":"LE FRANÇAIS AVEC MOHAMED KB","videoId":"Og7N8WPwX1A","why":"نفس حكاية الدرس (الأسد والفأر) مترجمة بالعربية — تتابع النص وأنت تعرف نهايته مسبقًا فيسهل الفهم.","cat":"Stories","level":"A2","main":true},{"title":"Le Lion et Le Rat + 6 Fables de La Fontaine | Dessin Animé","channel":"Les P'tits z'Amis","videoId":"Bl8ucQ9OO1E","why":"حكاية الأسد والفأر (الرَت) مصورة مع أشهر فابل لافونتين الأخرى — تسمع النص الكلاسيكي بصوت تمثيلي ممتع.","cat":"Stories","level":"A2","extra":true},{"title":"Français facile. Podcast. Le petit Prince.","channel":"Français avec Pierre","videoId":"ZUhRSj8GgDM","why":"بودكاست بيير عن Le Petit Prince بفرنسية سهلة — يعوّدك على الاستماع لقصص كاملة من الأدب الفرنسي بعد الحكاية القصيرة.","cat":"Stories","level":"A2","extra":true},{"title":"Le chacal bleu: Apprendre le Français avec sous-titres - Histoire","channel":"BookBox French","videoId":"wP7s-aiCjRw","why":"حكاية أخرى كاملة بترجمة مزدوجة (Le chacal bleu) — مادة إضافية جاهزة لتطبيق كل ما تعلمته في هذه الوحدة.","cat":"Stories","level":"A2","extra":true}],"supplements":[{"id":"Bl8ucQ9OO1E","title":"Le Lion et Le Rat + 6 Fables de La Fontaine | Dessin Animé","channel":"Les P'tits z'Amis","why":"حكاية الأسد والفأر (الرَت) مصورة مع أشهر فابل لافونتين الأخرى — تسمع النص الكلاسيكي بصوت تمثيلي ممتع.","lang":"fr"},{"id":"ZUhRSj8GgDM","title":"Français facile. Podcast. Le petit Prince.","channel":"Français avec Pierre","why":"بودكاست بيير عن Le Petit Prince بفرنسية سهلة — يعوّدك على الاستماع لقصص كاملة من الأدب الفرنسي بعد الحكاية القصيرة.","lang":"fr"},{"id":"wP7s-aiCjRw","title":"Le chacal bleu: Apprendre le Français avec sous-titres - Histoire","channel":"BookBox French","why":"حكاية أخرى كاملة بترجمة مزدوجة (Le chacal bleu) — مادة إضافية جاهزة لتطبيق كل ما تعلمته في هذه الوحدة.","lang":"fr"}]}]},{"id":"a2-t3","slug":"grammar","icon":"✏️","color":"#7C3AED","fr":"Grammaire","ar":"مسار القواعد","desc":"قلب المستوى A2: الزمنان الماضيان، المستقبل، الضمائر المستبدلة، المقارنة، ومقدمة subjonctif — كل قاعدة بشرح عربي وفيديو من أفضل الأساتذة.","lessons":[{"id":"A2-t3-l1","fr":"Passé composé vs imparfait","ar":"الماضي المركب مقابل الناقص","objectives":["تكوين imparfait","التمييز بين الحدث والوصف في الماضي","دمج الزمنين في قصة واحدة"],"sections":[{"h":"تكوين imparfait","p":["imparfait سهل التكوين: خذ صيغة nous في المضارع، احذف -ons، وأضف: -ais, -ais, -ait, -ions, -iez, -aient. مثال parler → nous parlons → je parlais (كنت أتكلم). الجدول كله يتفرع من مصدر واحد — لا حفظ لكل ضمير.","استثناء وحيد: être → nous sommes → j'étais، tu étais، il était، nous étions، vous étiez، ils كانت. احفظ جدول être كاملًا بصوته — فك الحالات الوصفية كلها (كنت متعباً، كانت جميلة) تأتي منه.","شاهد الفيديو الأساسي بالشرح العربي: تكوين الناقص يُبنى أمامك من المضارع بخطوة واحدة، ثم تسمع الأمثلة في جمل حقيقية. التكرار المسموع أهم من الجدول المرئي — عينك تفهم وآذانك تحفظ.","passé composé للحدث المنتهي والمحدد: Hier, j'ai acheté une voiture (أمس اشتريت سيارة — حدث واحد انتهى). التحديد بالظرف الزمني هو شهادة هوية المركب: سطر واحد، انتهى.","قاعدة القصة: الخلفية والحالة بـ imparfait، والأحداث المتتابعة بـ passé composé: «Il pleuvait (كانت تمطر — خلفية). Je suis sorti (خرجت — حدث) et j'ai pris un taxi (وأخذت تاكسي).» احفظ هذا المثال المزدوج كنموذج كامل للتدخّل.","التمييز العملي في الكتابة: كل جملة اسأل عنها — «هل تُرسم أم تُتحرك؟». الجملة التي ترسم لوحة (الجو، المكان، الحالة، العادة) ناقصة؛ التي تحرّك سهم الحبكة مركبة. عشر جمل من هذا التصنيف تثبت القاعدة إلى الأبد."],"video":{"id":"iyFyhRNPTBA","title":"الدرس ٢٧ : الماضي المستمر l'imparfait أسهل زمن في الفرنسية | جمل وأمثلة مفيدة ومكررة | من فرنسا","channel":"من فرنسا","why":"شرح عربي مبسّط لتكوين imparfait واستخدامه مع أمثلة مكررة — تغطي محور التكوين والاستعمال معًا.","lang":"ar","main":true,"dur":10},"sub":[{"h":"التكوين: من المضارع إلى الناقص","p":["نأخذ nous du présent: nous parlons → نحذف -ons.","نضيف النهايات: -ais, -ais, -ait, -ions, -iez, -aient.","être الشاذ: j'étais, tu étais, il était, nous étions, vous étiez, ils étaient."]},{"h":"بوصلات التمييز في النص","p":["ناقص: toujours, souvent, tous les jours, d'habitude, pendant que, quand j'étais.","مركب: hier, soudain, une fois, d'abord, ensuite, enfin, à ce moment-là.","سؤال المفتاح: تُرسم أم تُتحرك؟"]},{"h":"التدخّل النموذجي","p":["Il faisait froid (خلفية).","Je suis sorti (حدث 1).","Et j'ai pris un taxi (حدث 2).","Les trois temps ensemble = قصة واحدة كاملة."]}]},{"h":"متى نستخدم كل زمن؟","p":["passé composé للحدث المنتهي والمحدد: Hier, j'ai acheté une voiture (أمس اشتريت سيارة — حدث واحد انتهى).","imparfait للوصف والعادة والخلفية: Quand j'étais petit, je jouais au football tous les jours (عندما كنت صغيراً كنت ألعب الكرة كل يوم — عادة متكررة + وصف حالة).","قاعدة القصة: الخلفية والحالة بـ imparfait، والأحداث المتتابعة بـ passé composé: «Il pleuvait (كانت تمطر — خلفية). Je suis sorti (خرجت — حدث) et j'ai pris un taxi (وأخذت تاكسي).»","مع zawal التمييز، لاحظ أن الحدث قد يحدث وسط مشهد ناقص: «Pendant que je dormais, il a téléphoné» — النوم مشهد والاتصال حدث. الجملتان تشتغلان في طبقتين مختلفتين من الزمن."],"video":null},{"h":"كلمات إرشادية","p":["تلميح imparfait: toujours (دائماً)، souvent (غالباً)، tous les jours (كل يوم)، chaque (كل)، d'habitude (عادة)، pendant que (بينما).","تلميح passé composé: hier، soudain (فجأة)، une fois (مرة)، d'abord (أولاً)، ensuite (ثم)، enfin (أخيراً).","الكلمات الإرشادية تأتي مجمّعة في الفيديو الإثرائي؛ أوقفه واكتب ثلاثة أمثلة من حياتك لكل كلمة. العلاقة الشخصية بالكلمة أثبت من الترجمة المجردة."],"video":null},{"h":"التطبيق والتلخيص","p":["يلخّص هذا الدرس تمييز الزمنين الماضيين: تكوين imparfait من صيغة nous في المضارع بحذف -ons وإضافة ais, ais, ait, ions, iez, aient مع الشاذ الوحيد être (j'étais)، ثم القاعدة الحاكمة للقصة: الخلفية والحالة والعادة بـ imparfait، والأحداث المتتابعة المنتهية بـ passé composé، والفصل بينهما بالسؤال «هل تُرسم أم تُتحرك؟» وبكلمات الإرشاد toujours و d'habitude في الناقص و soudain و une fois في المركب. كما وضح الفيديو الرئيسي «الدرس ٢٧ : الماضي المستمر l'imparfait أسهل زمن في الفرنسية | جمل وأمثلة مفيدة ومكررة | من فرنسا»، يكفي إتقان صيغة nous ونهايات الناقص لتصريف كل الأفعال، وأن توزّع جملك بين الزمنين حسب وظيفة كل جملة لا حسب ترتيبها. رابط الفيديو الأساسي: https://www.youtube.com/watch?v=iyFyhRNPTBA","السلسلة: أغلق a2-t2-l3 (Le Lion et la Souris) مسار القصص بالسرد، ويفتح هذا الدرس a2-t3-l1 مسار القواعد بالماضي؛ ويليه a2-t3-l2 (le futur simple) ليضيف المستقبل على الماضيين فتكتمل الأزمنة قبل الضمائر في a2-t3-l3. وقد روَت a2-t2-l2 (عطلة لايلا) أحداث الماضي التي يميّز هذا الدرس حيالها بين الزمنين، ويستعمل a2-t6-l1 (وصف الأشخاص والأماكن) imparfait في وصفه الطويل، بينما تأتي كلمات الإرشاد نفسها في نصوص a2-t1-l1 وحوارات a2-t5-l1 وأحداث a2-t7-l1.","أعد مشاهدة الفيديو الرئيسي وقوفاً عند كل مثال يمزج الزمنين، ثم سجّل نفسك وأنت تروي يوماً من طفولتك في أربع جمل: جملة خلفية أو عادة بـ imparfait وحدثَين منتهيين بـ passé composé، واستمع إلى تسجيلك وصحّح ما وقع من حدث فردي في الناقص أو من خلفية في المركب. ثم انتقل إلى a2-t3-l2."]}],"examples":[{"fr":"Quand j'étais étudiant, je lisais beaucoup.","ar":"عندما كنت طالباً كنت أقرأ كثيراً."},{"fr":"Soudain, le téléphone a sonné.","ar":"فجأة رن الهاتف."},{"fr":"Il faisait beau. Nous sommes sortis.","ar":"كان الطقس جميلاً. خرجنا."},{"fr":"Chaque été, nous allions à la mer.","ar":"كل صيف كنا نذهب للبحر."},{"fr":"Quand j'étais enfant, je jouais au parc.","ar":"حين كنت طفلاً كنت ألعب في الحديقة.","note":"عادة بالناقص"},{"fr":"Hier, j'ai acheté une voiture.","ar":"أمس اشتريت سيارة.","note":"حدث محدد بالمركب"},{"fr":"Il pleuvait quand je suis sorti.","ar":"كانت تمطر حين خرجت.","note":"تدخّل الزمنين"},{"fr":"Pendant que je dormais, il a téléphoné.","ar":"بينما كنت نائماً اتصل.","note":"مشهد + حدث"}],"pron":[{"w":"je parlais","ipa":"[ʒə.pa.ʁlɛ]","approx":"جو-بارليه"},{"w":"ils parlaient","ipa":"[il.pa.ʁlɛ]","approx":"يل-بارليه","note":"aient صامتة مثل ait"},{"w":"il pleuvait","ipa":"[il.plø.vɛ]","approx":"يل-بلوفيه"}],"vocab":[{"fr":"soudain","ar":"فجأة","pos":"adv","ipa":"[su.dɛ̃]","exFr":"Soudain, il a crié.","exAr":"فجأة صاح."},{"fr":"d'habitude","ar":"عادةً","pos":"adv","ipa":"[da.bi.tyd]","exFr":"D'habitude, je me lève tôt.","exAr":"عادةً أستيقظ باكراً."},{"fr":"pendant que","ar":"بينما","pos":"conjonction","ipa":"[pɑ̃.dɑ̃.kə]","exFr":"Il lisait pendant que je dormais.","exAr":"كان يقرأ بينما كنت أنام."},{"fr":"une fois","ar":"مرة واحدة","pos":"expression","ipa":"[yn.fwa]","exFr":"Une fois, j'ai perdu mes clés.","exAr":"مرة فقدت مفاتيحي."},{"fr":"l'enfance","ar":"الطفولة","pos":"nom","g":"f","ipa":"[ɑ̃.fɑ̃s]","exFr":"Mon enfance était heureuse.","exAr":"طفولتي كانت سعيدة."},{"fr":"l'imparfait","ar":"الماضي المستمر/الناقص","pos":"nom","g":"m","exFr":"Quand j'étais petit, je jouais.","ipa":"[ɛ̃paʁfɛ]","exAr":"حين كنت صغيراً كنت ألعب."},{"fr":"le passé composé","ar":"الماضي المركب","pos":"nom","g":"m","exFr":"J'ai mangé hier.","ipa":"[pase kɔ̃poze]","exAr":"أكلت أمس."},{"fr":"tous les jours","ar":"كل يوم","pos":"locution","exFr":"Tous les jours, je cours.","ipa":"[tu le ʒuʁ]","exAr":"كل يوم أجري."},{"fr":"autrefois","ar":"قديماً/في السابق","pos":"adv","exFr":"Autrefois, on écrivait des lettres.","ipa":"[otʁəfwa]","exAr":"قديماً كنا نكتب الرسائل."},{"fr":"toujours","ar":"دائماً","pos":"adv","exFr":"Il regardait toujours la télé.","ipa":"[tuʒuʁ]","exAr":"كان يشاهد التلفاز دائماً."},{"fr":"hier","ar":"أمس","pos":"adv","exFr":"Hier, j'ai vu un film.","ipa":"[jɛʁ]","exAr":"أمس شاهدت فيلماً."}],"grammar":[{"tFr":"Imparfait : formation et usage","tAr":"القاعدة: التكوين والاستعمال","body":["التكوين من nous (présent) بحذف -ons وإضافة ais/ais/ait/ions/iez/aient — شاذ واحد: être → j'étais.","الاستعمال: الوصف والعادة والخلفية؛ والمركب للأحداث. الظرف الزمني هو الشاهد الأول."],"ex":[{"fr":"Nous regardions la télé quand tu as appelé.","ar":"كنا نشاهد التلفاز حين اتصلت."},{"fr":"Elle était contente.","ar":"كانت سعيدة."}]}],"mistakes":[{"wrong":"nous parlions [parliɔ̃] مع نطق -ons","right":"nous parlions [parlijɔ̃]","why":"نهايات الناقص -ions/-iez مسموعة مختلفاً عن المضارع."},{"wrong":"Il a fait beau (للخلفية)","right":"Il faisait beau","why":"الحالة المستمرة وإن انتهت في الواقع تبقى ناقصة."},{"wrong":"Je jouais au parc et je suis allé... (بلا حدث)","right":"الأحداث الفردية مركبة دائماً","why":"الناقص لا يروي حدثاً فردياً منجهاً — تحتاج المركب."},{"wrong":"j'étais (مع avoir)","right":"j'étais / elle était","why":"الصفات وحدها تأتي مع être في الماضي."}],"dialogues":[{"title":"سرد يوم ماضٍ","ctx":"صديقان يرويان أمس","lines":[{"who":"Yasmine","fr":"Qu'est-ce que tu as fait hier ?","ar":"ماذا فعلت أمس؟"},{"who":"Mehdi","fr":"Il pleuvait, donc je suis resté à la maison.","ar":"كانت تمطر، فبقيت في البيت."},{"who":"Yasmine","fr":"D'habitude, tu sors le dimanche.","ar":"عادةً تخرج يوم الأحد."},{"who":"Mehdi","fr":"Oui, mais hier j'ai reçu un appel de mon frère.","ar":"نعم، لكنني أمس تلقيت اتصالاً من أخي."},{"who":"Yasmine","fr":"Et vous avez parlé longtemps ?","ar":"وتكلمتا طويلاً؟"},{"who":"Mehdi","fr":"Pendant que je parlais, il est arrivé un message.","ar":"بينما كنت أتكلم وصلت رسالة."}]}],"exercises":[{"t":"mcq","skill":"grammar","q":"«كنت ألعب كل يوم» (je, jouer):","opts":["j'ai joué","je jouais","je jouera","je joué"],"a":1,"why":"عادة متكررة ← imparfait: je jouais."},{"t":"mcq","skill":"grammar","q":"«فجأة رنّ الهاتف»:","opts":["le téléphone sonnait","le téléphone a sonné","le téléphone sonne","le téléphone sonnerait"],"a":1,"why":"حدث مفاجئ منتهٍ ← passé composé."},{"t":"fill","skill":"grammar","q":"أكمل بـ imparfait: «Nous ___ contents.» (être)","fr":"Nous ___ contents.","ans":"étions","why":"الاستثناء الوحيد: être → étions."},{"t":"translate","skill":"writing","q":"ترجم: «كانت تمطر وخرجت.»","ans":"Il pleuvait et je suis sorti.","alts":["il pleuvait et je suis sorti(e)"],"why":"الخلفية بـ imparfait والحدث بـ passé composé."},{"t":"listen","skill":"listening","q":"استمع واختر الزمن المستخدم:","audio":"Chaque dimanche, nous allions au marché","opts":["passé composé","imparfait","futur","présent"],"a":1,"why":"«Chaque dimanche» ظرف تكرار ومن علامات imparfait؛ فالجملة المسموعة مبنية في الناقص لا في المركب."},{"t":"writing","skill":"writing","q":"اكتب 4 أسطر عن طفولتك: 2 جمل وصف (imparfait) و2 حدث (passé composé).","min":14,"kw":["étais","jouais","ai"],"sample":"Quand j'étais petit, je jouais dans la rue. Ma famille avait une grande maison. Un jour, j'ai cassé ma jambe. On m'a emmené à l'hôpital.","why":"كتابة القصة تمزج الزمنين: كل جملة ترسم مشهداً أو عادة تُكتب بـ imparfait، وكل حدث منتهٍ يحرّك الحبكة يُكتب بـ passé composé."},{"t":"mcq","skill":"grammar","q":"متى يُستعمل l'imparfait حسب قاعدة VSS؟","opts":["الخلفية والاستمرار (الوصف)","الحدث المفاجئ المنتهي","المستقبل","الأمر"],"a":0,"why":"قاعدة VSS: الخلفية والاستمرار تبقى بـ imparfait."},{"t":"fill","skill":"grammar","q":"أكمل: «Hier, il ___ (faire) beau quand je suis sorti.»","fr":"Hier, il ___ beau quand je suis sorti.","ans":"faisait","alts":["Faisait"],"why":"الطقس المستمر خلف الحدث: imparfait faisait."}],"homework":"اكتب قصة قصيرة (6 أسطر) عن يوم مميز في طفولتك: الخلفية بـ imparfait والأحداث بـ passé composé.\nالدرس السابق/التالي: a2-t2-l3 (الأسد والفأر — La Fontaine) / a2-t3-l2 (المستقبل البسيط).","sources":[{"title":"الدرس ٢٧ : الماضي المستمر l'imparfait أسهل زمن في الفرنسية | جمل وأمثلة مفيدة ومكررة | من فرنسا","channel":"من فرنسا","videoId":"iyFyhRNPTBA","why":"شرح عربي مبسّط لتكوين imparfait واستخدامه مع أمثلة مكررة — تغطي محور التكوين والاستعمال معًا.","cat":"Grammar","level":"A2","main":true},{"title":"Imparfait - Cours COMPLET - Formation et Utilisations","channel":"Parlez-vous FRENCH","videoId":"culF1WXnaOw","why":"دورة كاملة عن الناقص: التكوين خطوة بخطوة ثم الاستخدامات — أساس نظيف قبل مزج الزمنين.","cat":"Grammar","level":"A2","extra":true},{"title":"Passé composé ou imparfait en français ?","channel":"Français avec Pierre","videoId":"zsBJ2qtBzhw","why":"بيير يفكّ أشهر لغز في A2 بمقارنة عملية مشهدية: متى الزمن الذي يحرّك القصة ومتى زمن الذي يرسمها؟","cat":"Grammar","level":"A2","extra":true},{"title":"😯 IMPARFAIT ou PASSÉ COMPOSÉ ? Quelles sont les différences...","channel":"Guillaume Posé - Professeur de français","videoId":"4IexZtlIqF0","why":"مقارنة ثالثة من زاوية مختلفة مع أمثلة وتدريب — التكرار من مصادر متنوعة هو ما يثبّت هذا التمييز الدقيق.","cat":"Grammar","level":"A2","extra":true}],"supplements":[{"id":"culF1WXnaOw","title":"Imparfait - Cours COMPLET - Formation et Utilisations","channel":"Parlez-vous FRENCH","why":"دورة كاملة عن الناقص: التكوين خطوة بخطوة ثم الاستخدامات — أساس نظيف قبل مزج الزمنين.","lang":"fr"},{"id":"zsBJ2qtBzhw","title":"Passé composé ou imparfait en français ?","channel":"Français avec Pierre","why":"بيير يفكّ أشهر لغز في A2 بمقارنة عملية مشهدية: متى الزمن الذي يحرّك القصة ومتى زمن الذي يرسمها؟","lang":"fr"},{"id":"4IexZtlIqF0","title":"😯 IMPARFAIT ou PASSÉ COMPOSÉ ? Quelles sont les différences...","channel":"Guillaume Posé - Professeur de français","why":"مقارنة ثالثة من زاوية مختلفة مع أمثلة وتدريب — التكرار من مصادر متنوعة هو ما يثبّت هذا التمييز الدقيق.","lang":"fr"}]},{"id":"A2-t3-l2","fr":"Le futur simple","ar":"المستقبل البسيط","objectives":["تكوين futur simple","استخدام الأفعال الشاذة في المستقبل","التمييز بين futur proche و futur simple"],"sections":[{"h":"القاعدة: المصدر + النهايات","p":["futur simple = المصدر + نهايات avoir: -ai, -as, -a, -ons, -ez, -ont. parler → je parlerai (سأتحدث)، finir → tu finiras، attendre → il attendra. النهايات مأخوذة من avoir المفرد — تعلّمها مرة تُطبَّق على كل الأفعال.","ملاحظة: أفعال -re تحذف e الأخيرة: vendre → je vendrai. وهذه القاعدة الصغيرة تمنع أشهر خطأ كتابي في هذا الزمن.","شاهد الفيديو الأساسي بالشرح العربي: التصريف يُبنى من المصدر أمامك، ثم تسمع الفروق النطقية (ـrai، ـras، ـra...) في جمل تنبؤ ووعود. الصوت هنا أهم من الكتابة: futur simple يُنطق بلهجة مميزة لا تخلط بأي زمن آخر.","الأفعال الشاذة تُحفظ كحزمة واحدة: être → je serai، avoir → j'aurai، aller → j'irai، faire → je ferai، venir → je viendrai، voir → je verrai، pouvoir → je pourrai، vouloir → je voudrai، devoir → je devrai. تسعة أفعال تغطي 95% من كلامك المستقبلي.","مثال يجمع الشاذ معًا: «Quand j'aurai le temps, je viendrai te voir» (حين أجد الوقت سآتي لرؤيتك) — جملة واحدة تحمل j'aurai + je viendrai وتُتذكَّر كمشهد لا كجدول.","futur simple ليس للخطط القريبة بل للتنبؤ والوعود والمستقبل البعيد والرسمي: Dans dix ans, le monde sera différent. Je te promets que je reviendrai. النبرة هنا أقرب للعهد والرسالة الرسمية منها لحديث الشارع."],"video":{"id":"lh2qOWDUezU","title":"الدرس ٢٩: المستقبل البسيط | le futur simple | تصريفه، أمثلة وملاحظات عنه، فرقه عن المستقبل القريب","channel":"من فرنسا","why":"شرح مستقبلي بسيط مع المقارنة الصريحة بالمستقبل القريب — بالضبط محور الدرس الثالث.","lang":"ar","main":true,"dur":10},"sub":[{"h":"النهايات الست من avoir","p":["je... -ai ، tu... -as ، il... -a","nous... -ons ، vous... -ez ، ils... -ont","أفعال -re تحذف e: vendre → je vendrai."]},{"h":"حزمة الشاذة (تسعة)","p":["être → serai / avoir → aurai / aller → irai","faire → ferai / venir → viendrai / voir → verrai","pouvoir → pourrai / vouloir → voudrai / devoir → devrai"]},{"h":"proche أم simple؟","p":["proche (aller + inf.) لخطة قريبة: Je vais sortir ce soir.","simple للتنبؤ والوعد: Dans dix ans, je serai médecin.","simple في الرسائل الرسمية والعقود والعناوين."]}]},{"h":"الأفعال الشاذة","p":["être → je serai، avoir → j'aurai، aller → j'irai، faire → je ferai، venir → je viendrai، voir → je verrai، pouvoir → je pourrai، vouloir → je voudrai، devoir → je devrai.","مثال: Quand j'aurai le temps, je viendrai te voir (عندي وقت، سآتي لرؤيتك).","في النصوص الرسمية (إعلانات، عناوين صحف، رسائل) يأتي futur simple كثيراً: «Le président annoncera...» — قراءته فيها تمرين مزدوج على الزمن والمفردات الرسمية."],"video":null},{"h":"futur proche أم futur simple؟","p":["futur proche (aller + فعل) للخطط القريبة والفورية: Je vais sortir ce soir (سأخرج الليلة).","futur simple للتنبؤ والوعود والمستقبل البعيد والرسمي: Dans dix ans, le monde sera différent (بعد 10 سنوات سيكون العالم مختلفاً). Je te promets que je reviendrai (أعدك أنني سأعود).","استمع للفرق في الفيديو: النبرة الواثقة لـ futur simple مقابل النبرة القريبة لـ proche. الفرنسيون يبدلان بينهما في المحادثة طبقاً لدرجة الالتزام — وفروق السياق تعلّمك أكثر من أي جدول."],"video":null},{"h":"التطبيق والتلخيص","p":["يبني هذا الدرس المستقبل البسيط من المصدر نفسه: نهايات avoir الست -ai, -as, -a, -ons, -ez, -ont تُضاف إلى المصدر (parler ← je parlerai)، وتحذف أفعال -re حرفها الأخير (vendre ← je vendrai)، وتُحفظ حزمة الشاذة (être ← serai، avoir ← aurai، aller ← irai، faire ← ferai، venir ← viendrai، voir ← verrai، pouvoir ← pourrai، vouloir ← voudrai، devoir ← devrai) مع التمييز الحاسم عن futur proche: التنبؤ والوعد والرسالة الرسمية بـ simple، والخطة القريبة بـ aller + infinitif. كما وضح الفيديو الرئيسي «الدرس ٢٩: المستقبل البسيط | le futur simple | تصريفه، أمثلة وملاحظات عنه، فرقه عن المستقبل القريب»، تُبنى الصيغة من المصدر في خطوة واحدة وتُنطق بنبرة مميّزة لا تخلط بأزمنة أخرى. رابط الفيديو الأساسي: https://www.youtube.com/watch?v=lh2qOWDUezU","السلسلة: أعقب a2-t3-l1 (الماضي المركب مقابل الناقص) هذا الدرس a2-t3-l2، فانتقلت من سرد الماضي إلى بناء المستقبل؛ ثم يليه a2-t3-l3 (الضمائر COD و COI) حيث تصير أفعالك المستقبلية تحمل ضمائرها: «Je lui écrirai» و«Je leur parlerai». وتعود صيغة simple في مواعيد a2-t4-l1 (عند الطبيب وفي البنك) وفي رسائل a2-t6-l3 (كتابة الرسائل)، وتسمعها في a2-t5-l1 وتستعملها a2-t7-l1 مسموعة في كل حلقة.","أعد مشاهدة الفيديو الرئيسي مركّزاً على النهايات الست ونطق الصيغ الشاذة، ثم سجّل نفسك وأنت تتوقّع عامك القادم في خمس جمل بـ futur simple مع جملة واحدة بـ futur proche للمقارنة، واستمع إلى تسجيلك وتحقق من أن كل صيغة اشترطت منها simple بُنيت من المصدر لا من aller. ثم انتقل إلى a2-t3-l3."]}],"examples":[{"fr":"Dans dix ans, je serai professeur.","ar":"بعد عشر سنوات سأكون معلماً."},{"fr":"Tu verras, ce sera génial !","ar":"سترى، سيكون رائعاً!"},{"fr":"Quand tu arriveras, appelle-moi.","ar":"عندما تصل، اتصل بي."},{"fr":"Nous irons en France l'année prochaine.","ar":"سنذهب لفرنسا العام القادم."},{"fr":"Je parlerai français l'an prochain.","ar":"سأتكلم الفرنسية العام القادم.","note":"من -er"},{"fr":"Nous finirons le travail à cinq heures.","ar":"سنهي العمل الساعة الخامسة.","note":"من -ir"},{"fr":"Quand j'aurai le temps, je viendrai.","ar":"حين أجد الوقت سآتي.","note":"شاذان معاً"},{"fr":"Il vendra sa voiture.","ar":"سيبيع سيارته.","note":"-re يحذف e"}],"pron":[{"w":"je serai","ipa":"[ʒə.sə.ʁe]","approx":"جو-سوريه"},{"w":"il viendra","ipa":"[il.vjɛ̃.dʁa]","approx":"يل-فياندرا"},{"w":"nous irons","ipa":"[nu.zi.ʁɔ̃]","approx":"نو-زيران"}],"vocab":[{"fr":"dans dix ans","ar":"بعد عشر سنوات","pos":"expression","ipa":"[dɑ̃.di.zɑ̃]","exFr":"Dans dix ans, tout changera.","exAr":"بعد عشر سنوات سيتغير كل شيء."},{"fr":"promettre","ar":"يعد","pos":"verbe","ipa":"[pʁɔ.mɛtʁ]","exFr":"Je te promets.","exAr":"أعدك."},{"fr":"l'avenir","ar":"المستقبل","pos":"nom","g":"m","ipa":"[a.və.niʁ]","exFr":"L'avenir est inconnu.","exAr":"المستقبل مجهول."},{"fr":"changer","ar":"يتغير","pos":"verbe","ipa":"[ʃɑ̃.ʒe]","exFr":"Rien ne changera.","exAr":"لن يتغير شيء."},{"fr":"quand","ar":"عندما / متى","pos":"conjonction","ipa":"[kɑ̃]","exFr":"Quand tu viendras, on mangera ensemble.","exAr":"عندما تأتي سنأكل معاً."},{"fr":"demain","ar":"غداً","pos":"adv","exFr":"Demain, je travaillerai.","ipa":"[dəmɛ̃]","exAr":"غداً سأعمل."},{"fr":"prévoir","ar":"يخطط/يتنبأ","pos":"verbe","g":"—","exFr":"Il prévoit d'acheter une maison.","ipa":"[pʁəvwaʁ]","exAr":"يخطط لشراء منزل."},{"fr":"les prévisions","ar":"التنبؤ/التوقعات (طقس)","pos":"nom","g":"f","exFr":"Les prévisions du temps.","ipa":"[pʁəvizjɔ̃]","exAr":"توقعات الطقس."},{"fr":"un projet","ar":"مشروع","pos":"nom","g":"m","exFr":"J'aurai un projet l'an prochain.","ipa":"[pʁɔʒɛ]","exAr":"سيكون لدي مشروع العام القادم."},{"fr":"revienir (venir)","ar":"يعود","pos":"verbe","g":"—","exFr":"Je reviendrai demain.","ipa":"[ʁəvjɛ̃dʁa]","exAr":"سأعود غداً."}],"grammar":[{"tFr":"Le futur simple","tAr":"القاعدة: التكوين والاستعمال","body":["المصدر + -ai/-as/-a/-ons/-ez/-ont (نهايات avoir)؛ أفعال -re تحذف e النهائية.","الاستعمال: تنبؤ، وعد، مستقبل بعيد، نص رسمي — وليس الخطة القريبة (فهذه proche)."],"ex":[{"fr":"Tu réussiras ton examen.","ar":"ستنجح في امتحانك."},{"fr":"Elle achètera une maison.","ar":"ستشتري منزلًا."}]}],"mistakes":[{"wrong":"Je vais parler (للتوقع البعيد الرسمي)","right":"Je parlerai","why":"التنبؤ والوعود تأخذ futur simple؛ proche للخطة القريبة فقط."},{"wrong":"Je venderei (بلا حذف e)","right":"Je vendrai","why":"أفعال -re تحذف e قبل إضافة النهاية."},{"wrong":"خلط je serai مع je suis","right":"je serai (مستقبل) ≠ je suis (حاضر)","why":"الشاذة المستقبلية حزمة مستقلة تُحفظ بصوتها."},{"wrong":"نهايات -ont مع ils (نطق)","right":"ils parleront [parlʁɔ̃]","why":"t النهاية صامتة — تُنطق كما تُنطق endings بالضد."}],"dialogues":[{"title":"خطط المستقبل","ctx":"زميلان يتحدثان عن السنة القادمة","lines":[{"who":"Samir","fr":"Qu'est-ce que tu feras l'an prochain ?","ar":"ماذا ستفعل العام القادم؟"},{"who":"Nour","fr":"J'étudierai la médecine à Casablanca.","ar":"سأدرس الطب في الدار البيضاء."},{"who":"Samir","fr":"Vraiment ! Et tu habitueras où ?","ar":"حقاً! وستسكن أين؟"},{"who":"Nour","fr":"J'habiterai en cité universitaire, d'abord.","ar":"سسكن في السكن الجامعي أولاً."},{"who":"Samir","fr":"On se verra souvent, j'espère.","ar":"سنلتقي كثيراً أتمنى."},{"who":"Nour","fr":"Je te promets : je reviendrai chaque mois !","ar":"أعدك: سأعود كل شهر!"}]}],"exercises":[{"t":"mcq","skill":"grammar","q":"«سأكون معلماً» (je, être):","opts":["je vais être","je serai","je suis être","j'aurai"],"a":1,"why":"être في المستقبل: je serai."},{"t":"fill","skill":"grammar","q":"أكمل: «Nous ___ en France.» (aller, futur simple)","fr":"Nous ___ en France.","ans":"irons","why":"aller شاذ: nous irons."},{"t":"mcq","skill":"grammar","q":"أي جملة تناسب التنبؤ بالمستقبل البعيد؟","opts":["Je vais visiter demain","Le monde sera différent","Je pars là","Je viens d'arriver"],"a":1,"why":"futur simple مناسب للتنبؤات."},{"t":"translate","skill":"writing","q":"ترجم: «سأعود، أعدك.»","ans":"Je reviendrai, je te promets.","alts":["je reviendrai je te promets"],"why":"revenir شاذ: je reviendrai."},{"t":"listen","skill":"listening","q":"استمع واختر الزمن:","audio":"Quand tu auras fini, tu sortiras","opts":["مستقبل","ماضٍ","مضارع","شرط"],"a":0,"why":"الجملة المسموعة تحمل futur simple مرتين (auras، sortiras) بعد «quand» — علامة تنبؤ مؤكَّد لا خطة قريبة بـ aller + infinitif."},{"t":"writing","skill":"writing","q":"اكتب 3 توقعات عن المستقبل بـ futur simple.","min":9,"kw":["sera","serai","auront"],"sample":"Dans vingt ans, les voitures seront électriques. Les gens travailleront à la maison. Je serai peut-être professeur.","why":"التوقعات البعيدة والوعود هي موطن futur simple؛ والتمرين يقيس قدرتك على بناء la prévision لا على سرد الخطة القريبة."},{"t":"mcq","skill":"grammar","q":"الصيغة المستقبلية الشاذة لـ être هي:","opts":["je serai","je suis","j'étais","je fus"],"a":0,"why":"être شاذة في المستقبل: serai/seras/sera..."},{"t":"translate","skill":"writing","q":"ترجم: «سأدرس غداً في المكتبة.»","ans":"J'étudierai demain à la bibliothèque.","alts":["j'etudierai demain a la bibliotheque"],"why":"futur simple من étudier = étudierai."}],"homework":"اكتب رؤيتك لعامك القادم: 5 جمل بـ futur simple، جملة فيها futur proche للمقارنة.\nالدرس السابق/التالي: a2-t3-l1 (الماضي المركب مقابل الناقص) / a2-t3-l3 (ضمائر المفعول COD و COI).","sources":[{"title":"الدرس ٢٩: المستقبل البسيط | le futur simple | تصريفه، أمثلة وملاحظات عنه، فرقه عن المستقبل القريب","channel":"من فرنسا","videoId":"lh2qOWDUezU","why":"شرح مستقبلي بسيط مع المقارنة الصريحة بالمستقبل القريب — بالضبط محور الدرس الثالث.","cat":"Grammar","level":"A2","main":true},{"title":"Le futur simple de l'indicatif - 1er 2e 3e groupe","channel":"La conjugaison des verbes français","videoId":"ZAn-trSI_q4","why":"درس مخصص لتكوين المستقبل البسيط على المجموعات الثلاثة — القاعدة الصرفة بلا تشتيت.","cat":"Grammar","level":"A2","extra":true},{"title":"French Verbs & Tenses explained in 10 minutes!","channel":"Learn French With Alexa","videoId":"SApp5pEtCB4","why":"أليكسا تلخص خريطة الأزمنة كاملة في 10 دقائق — ترى مكان المستقبل بين الماضي والمضارع فتنظّم فهمك الكلي.","cat":"Grammar","level":"A2","extra":true},{"title":"CONJUGAISON FRANÇAISE | Tous les temps verbaux en 1 vidéo !","channel":"Français avec Pierre","videoId":"QGWjKpV9U_w","why":"خريطة كل الأزمنة في فيديو واحد — تربط futur simple بالزمنين الماضيين الذي تعلمتهما في الدرس السابق.","cat":"Grammar","level":"A2","extra":true}],"supplements":[{"id":"ZAn-trSI_q4","title":"Le futur simple de l'indicatif - 1er 2e 3e groupe","channel":"La conjugaison des verbes français","why":"درس مخصص لتكوين المستقبل البسيط على المجموعات الثلاثة — القاعدة الصرفة بلا تشتيت.","lang":"fr"},{"id":"SApp5pEtCB4","title":"French Verbs & Tenses explained in 10 minutes!","channel":"Learn French With Alexa","why":"أليكسا تلخص خريطة الأزمنة كاملة في 10 دقائق — ترى مكان المستقبل بين الماضي والمضارع فتنظّم فهمك الكلي.","lang":"en"},{"id":"QGWjKpV9U_w","title":"CONJUGAISON FRANÇAISE | Tous les temps verbaux en 1 vidéo !","channel":"Français avec Pierre","why":"خريطة كل الأزمنة في فيديو واحد — تربط futur simple بالزمنين الماضيين الذي تعلمتهما في الدرس السابق.","lang":"fr"}]},{"id":"A2-t3-l3","fr":"Les pronoms COD et COI","ar":"الضمائر المستبدلة المفعولية","objectives":["التمييز بين COD و COI","استبدال المفعول بالضمير ومكانه قبل الفعل","النفي مع الضمائر"],"sections":[{"h":"COD: المفعول المباشر","p":["COD (complément d'objet direct): المفعول بدون حرف جر. الضمائر: me (ـني)، te (ـك)، le/la (ـه/ـها)، nous (ـنا)، vous (ـكم)، les (ـهم). الاختبار البسيط: ضع «؟» بين الفعل والمفعول — إن نجحت بلا à فقد COD.","القاعدة الحاكمة: الضمير يأتي قبل الفعل! Je vois Marie → Je la vois (أراها). Tu manges la pomme → Tu la manges. Il m'appelle (يتصل بي). الاستبدال يغيّر ترتيب الجملة كلها — وهذه أهم نقطة في الدرس.","تابع الفيديو الأساسي بالشرح العربي: COD يُبنى في جمل ثم يستبدل بالضمير أمامك. مشاهدة التحول (Marie → la) بصرياً قبل تطبيقه ورقياً تمنع الخلط الشهير بين «Je vois Marie» و«Je la vois».","COI (complément d'objet indirect): المفعول بحرف جر à (إلى). الضمائر: me (لي)، te (لك)، lui (له/لها)، nous، vous، leur (لهم). الاختبار: وجود à قبل الاسم يعني COI بلا جدال.","الفخ الأكبر: lui = له ولها معاً (مفرد)، leur = لهم ولهنّ (جمع) — لا فرق في الجنس! «Je lui parle» قد تعني أتحدث إليه أو إليها، والسياق يحسم. هذه المسامحة في الفرنسية تسهل عليك كثيراً.","مع passé composé يأتي الضمير قبل الفعل المساعد: Je l'ai vu (رأيته). Je lui ai téléphoné (اتصلت به)، والنفي يحيط بالضمير والفعل معًا: Je ne le vois pas (لا أراه). Je ne lui parle plus. الحدود الخارجية ثابتة والضمائر مُحشورة داخلها."],"video":{"id":"l_GOoEQT0mw","title":"الدرس 37 : المفعول به المباشر، غير المباشر، الثاني COD - COI - COS","channel":"Appfrançais - تعلم اللغة الفرنسية","why":"شرح عربي شامل لـ COD و COI وضمائرهما — يبني مهارة التمييز قبل الترتيب والتنفيذ.","lang":"ar","main":true,"dur":15},"sub":[{"h":"جدول COD مقابل COI","p":["COD: me, te, le/la, nous, vous, les (بلا حرف جر).","COI: me, te, lui, nous, vous,leur (مع à).","الاختبار: « Je parle à Marie ? » نعم ← COI (lui)."]},{"h":"مكان الضمير","p":["قبل الفعل في المضارع والأمر: Je la vois / Appelle-la !","قبل الفعل المساعد في المركب: Je l'ai vu / Je lui ai parlé.","مع les deux verbes: Je vais la voir (يسبق الفعل الأقرب تأثراً)."]},{"h":"النفي والسؤال","p":["Je ne la vois pas. / Je ne lui parle plus.","La vois-tu ? / Lui parles-tu ? (قلاب مع à للمكان).","Est-ce que tu la vois ? (أبسط طريقة يومية)."]}]},{"h":"COI: المفعول غير المباشر","p":["COI (complément d'objet indirect): المفعول بحرف جر à (إلى). الضمائر: me (لي)، te (لك)، lui (له/لها)، nous، vous، leur (لهم).","Je parle à Sara → Je lui parle (أتحدث إليها). Je téléphone à mes amis → Je leur téléphone.","الفخ الأكبر: lui = له ولها معاً (مفرد)، leur = لهم ولهنّ (جمع) — لا فرق في الجنس!","lui و leur بلا تمييز جنس هو أخفّ قواعد الضمائر: «Je lui présente ma sœur» (أعرّفها عليه/إليها). لا تبحث عن مؤنث لـ lui — المفرد واحد مهما كان الجنس."],"video":null},{"h":"ترتيب وتنفي","p":["مع passé composé يأتي الضمير قبل الفعل المساعد: Je l'ai vu (رأيته). Je lui ai téléphoné (اتصلت به).","النفي يحيط بالضمير والفعل: Je ne le vois pas (لا أراه). Je ne lui parle plus (لم أعد أتحدث إليه).","الفيديو الإثرائي يعرض استبدالات سريعة متتابعة؛ أوقفه عند كل تحويل واكتبه بخط اليد: الاسم ثم الضمير. الكتابة اليدية للتحولين معًا تثبت المسار البصري."],"video":null},{"h":"التطبيق والتلخيص","p":["يلخّص هذا الدرس ضمائر المفعول: اختبار COD بوضع «؟» بين الفعل والمفعول فتنجح بلا حرف جر (Je vois Marie ← Je la vois)، واختبار COI بوجود à (Je parle à Sara ← Je lui parle)، ثم القاعدة الحاكمة: الضمير قبل الفعل في المضارع والأمر وقبل الفعل المساعد في المركب (Je l'ai vu، Je lui ai téléphoné) والنفي يحيط بالوحدة (Je ne le vois pas)، مع فخّ: lui للجنسين المفرد وleur للجميع بلا تمييز جنس. كما وضح الفيديو الرئيسي «الدرس 37 : المفعول به المباشر، غير المباشر، الثاني COD - COI - COS»، الاختبار بالحرف الجر هو الفارق الحاسم، وموضع الضمير قبل الفعل هو أكثر نقطة يُخطئ فيها المتعلم. رابط الفيديو الأساسي: https://www.youtube.com/watch?v=l_GOoEQT0mw","السلسلة: بعد a2-t3-l2 (le futur simple) يأتي هذا الدرس a2-t3-l3 ليضع الضمائر في الماضي والحاضر والمستقبل معًا، ثم يفتح a2-t3-l4 (y و en) ضميرَيْن يستبدلان المكان والكمية. والـ imparfait الذي روى حكايات a2-t2 يجد هنا ضمائره: Je l'ai vu / Je lui ai parlé، والصف في a2-t6-l1 (وصف الأشخاص والأماكن) يذكرك بـ la و les و lui، بينما تنقل a2-t5-l1 وأحداث a2-t7-l1 هذه الضمائر في كلام مسموع سريع.","أعد مشاهدة الفيديو الرئيسي عند كل تحويل من الاسم إلى الضمير، ثم سجّل نفسك وأنت تحول ست جمل من اسمها إلى ضمائرها (ثلاث COD وثلاث COI) مع نفي اثنتين، واستمع إلى تسجيلك وتحقق من موضع كل ضمير قبل الفعل ومن احاطة ne و pas. ثم انتقل إلى a2-t3-l4."]}],"examples":[{"fr":"Tu connais Paul ? — Oui, je le connais.","ar":"تعرف بول؟ — نعم أعرفه."},{"fr":"Elle t'écoute.","ar":"إنها تستمع إليك."},{"fr":"Je lui ai écrit un message.","ar":"كتبت له رسالة."},{"fr":"Nous ne les voyons plus.","ar":"لم نعد نراهم."},{"fr":"Je vois Marie. Je la vois.","ar":"أرى ماري. أراها.","note":"COD: la قبل الفعل"},{"fr":"Je parle à Sara. Je lui parle.","ar":"أتحدث إلى سارة. أتحدث إليها.","note":"COI: lui"},{"fr":"Nous avons vu le film. Nous l'avons vu.","ar":"شاهدنا الفيلم. شاهدناه.","note":"الضمير قبل avoir"},{"fr":"Je ne lui parle plus.","ar":"لم أعد أتحدث إليه.","note":"النفي حول الضمير والفعل"}],"pron":[{"w":"je le vois","ipa":"[ʒə.lə.vwa]","approx":"جو-لو-فوا"},{"w":"je lui parle","ipa":"[ʒə.lɥi.paʁl]","approx":"جو-لوي-بارل"},{"w":"il m'appelle","ipa":"[il.ma.pɛl]","approx":"يل-ما-بيل"}],"vocab":[{"fr":"le COD","ar":"المفعول المباشر","pos":"grammaire","ipa":"[se.o.de]","exFr":"Dans «je vois Marie», Marie est le COD.","exAr":"في «أرى ماري»، ماري مفعول مباشر."},{"fr":"le COI","ar":"المفعول غير المباشر","pos":"grammaire","ipa":"[se.o.si]","exFr":"Dans «je parle à Marie», Marie est le COI.","exAr":"في «أتكلم لماري»، ماري مفعول غير مباشر."},{"fr":"lui","ar":"له / لها","pos":"pronom","ipa":"[lɥi]","exFr":"Je lui donne le livre.","exAr":"أعطيه الكتاب."},{"fr":"leur","ar":"لهم","pos":"pronom","ipa":"[lœʁ]","exFr":"Je leur parle demain.","exAr":"أتحدث لهم غداً."},{"fr":"appeler","ar":"يتصل / ينادي","pos":"verbe","ipa":"[a.ple]","exFr":"Il m'appelle chaque soir.","exAr":"يتصل بي كل مساء."},{"fr":"téléphoner à","ar":"يتصل بـ (هاتفياً)","pos":"locution","exFr":"Je téléphone à mon père.","ipa":"[telefɔne]","exAr":"أتصل بأبي."},{"fr":"présenter","ar":"يعرّف/يقدّم","pos":"verbe","g":"1er","exFr":"Je te présente ma sœur.","ipa":"[pʁezɑ̃te]","exAr":"أعرّفك على أختي."},{"fr":"demander à","ar":"يسأل/يطلب من","pos":"locution","exFr":"Je lui demande un service.","ipa":"[dəmɑ̃de]","exAr":"أطلب منه خدمة."},{"fr":"le pronom","ar":"الضمير","pos":"nom","g":"m","ipa":"[lə pʁɔnɔ̃]","exFr":"Le pronom «le» remplace «Marie».","exAr":"الضمير «le» يستبدل «ماري».","note":"الضمير المستبدل يسبق الفعل دائماً."},{"fr":"donner à","ar":"يعطي لـ","pos":"locution","g":"—","ipa":"[dɔne a]","exFr":"Elle donne un cadeau à son frère.","exAr":"تعطي هدية لأخيها.","note":"donner و parler و téléphoner تجرّ بـ à ← COI يُستبدل بـ lui/leur."}],"grammar":[{"tFr":"Pronoms COD et COI","tAr":"القاعدة: ضمائر المفعول","body":["COD بلا حرف جر (le/la/les)، COI مع à (lui/leur) — والاختبار بالسؤال بين الفعل والاسم.","المكان: قبل الفعل المفرد، وقبل الفعل المساعد مع المركب؛ والنفي يحيط بالوحدة: ne + ضمير + مساعد + pas."],"ex":[{"fr":"Tu as appelé nos amis ? → Tu les as appelés ?","ar":"هل اتصلت بأصدقائنا؟ → هل اتصلت بهم؟"},{"fr":"Je n'ose pas lui dire.","ar":"لا أجرؤ على قوله."}]}],"mistakes":[{"wrong":"Je vois Marie → Je vois la","right":"Je la vois","why":"الضمير يسبق الفعل دائماً في المضارع."},{"wrong":"Je téléphone à Marie → Je la téléphone","right":"Je lui téléphone","why":"téléphoner à = COI فيأخذ lui لا la."},{"wrong":"lui للجمع","right":"leur للجمع","why":"lui مفرد (له/لها)، leur جمع (لهم) — بلا تمييز جنس."},{"wrong":"Je ne pas la vois","right":"Je ne la vois pas","why":"النفي يحيط بالضمير والفعل معاً: ne ... pas خارجان."}],"dialogues":[{"title":"جولة استبدال","ctx":"معلّمة وطالب تطبيق عملي","lines":[{"who":"Prof","fr":"Tu vois le professeur ?","ar":"هل ترى الأستاذ؟"},{"who":"Élève","fr":"Oui, je le vois.","ar":"نعم، أراه."},{"who":"Prof","fr":"Et tu parles à ta voisine ?","ar":"وهل تتحدث إلى جارتك؟"},{"who":"Élève","fr":"Oui, je lui parle chaque matin.","ar":"نعم، أتحدث إليها كل صباح."},{"who":"Prof","fr":"Tu as téléphoné à tes amis hier ?","ar":"هل اتصلت بأصدقائك أمس؟"},{"who":"Élève","fr":"Oui, je leur ai téléphoné le soir.","ar":"نعم، اتصلت بهم مساءً."}]}],"exercises":[{"t":"mcq","skill":"grammar","q":"استبدل المفعول: «Je vois Sara» ←","opts":["Je lui vois","Je la vois","Je le vois","Je lui parle"],"a":1,"why":"Sara مفعول مباشر مؤنث ← la قبل الفعل."},{"t":"mcq","skill":"grammar","q":"«أتحدث لهم (الأصدقاء)»:","opts":["Je les parle","Je leur parle","Je lui parle","Je leur dis à eux"],"a":1,"why":"parler à ← COI جمع = leur."},{"t":"fill","skill":"grammar","q":"أكمل: «Il ___ téléphone chaque soir.» (لها)","fr":"Il ___ téléphone.","ans":"lui","why":"téléphoner à ← COI مفرد = lui للجنسين."},{"t":"translate","skill":"writing","q":"ترجم: «رأيته أمس.»","ans":"Je l'ai vu hier.","alts":["je l ai vu hier"],"why":"COD قبل الفعل المساعد."},{"t":"order","skill":"grammar","q":"رتّب: «لم أعد أراهم»","words":["Je","ne","les","vois","plus"],"ans":"Je ne les vois plus","why":"النفي ne ... plus يحيط بالضمير والفعل معاً: les تبقى داخل القيد وقبل الفعل، وهذا هو ترتيب الجملة المنفية بضمير COD."},{"t":"listen","skill":"listening","q":"استمع واختر من يتصل بمن:","audio":"Je lui téléphone demain","opts":["أتصل به غداً","يتصل بي غداً","أتصل بهم غداً","تتصل بي غداً"],"a":0,"why":"«Je lui téléphone» تحويل من «je téléphone à lui»: فعل يجرّ بـ à ← COI، والفاعل «أنا» فلا يصح في الترجمة إلا «أتصل به»."},{"t":"mcq","skill":"grammar","q":"الضمير الذي يسبق les noms الأشخاص بـ à يسمى:","opts":["COI (المفعول غير المباشر)","COD (المفعول به)","فاعل","صفة"],"a":0,"why":"à + شخص ← COI يُستبدل بـ lui/leur."},{"t":"fill","skill":"grammar","q":"أكمل: «Je parle ___ mes parents.» (COD تابع)","fr":"Je parle ___ mes parents.","ans":"à","alts":["A"],"why":"parler à = يتكلم مع/إلى — الـ à ضرورية."}],"homework":"اكتب 8 جمل: 4 بضمائر COD و4 بضمائر COI عن تفاعلك اليومي مع الناس.\nالدرس السابق/التالي: a2-t3-l2 (المستقبل البسيط) / a2-t3-l4 (الضميران y و en).","sources":[{"title":"الدرس 37 : المفعول به المباشر، غير المباشر، الثاني COD - COI - COS","channel":"Appfrançais - تعلم اللغة الفرنسية","videoId":"l_GOoEQT0mw","why":"شرح عربي شامل لـ COD و COI وضمائرهما — يبني مهارة التمييز قبل الترتيب والتنفيذ.","cat":"Grammar","level":"A2","main":true},{"title":"Les pronoms compléments d'objet direct et indirect (COD et COI)","channel":"Parlez-vous FRENCH","videoId":"NPS4hnCHv-4","why":"شرح أكاديمي منظم للنوعين مع جداول واضحة — الأساس المنهجي قبل التطبيق.","cat":"Grammar","level":"A2","extra":true},{"title":"LE, LA, LES ou LUI, LEUR | Les pronoms COD et COI en français","channel":"Le French Club","videoId":"TPfQqEoyyyQ","why":"تدريب اختيار مباشر: le/la/les أم lui/leur؟ — نفس السؤال الذي سيواجهك في كل جملة، بصيغة تمرين حي.","cat":"Grammar","level":"A2","extra":true},{"title":"Les pronoms COD et COI en français : LE/LUI - LES/LEUR - Etc.","channel":"Français avec Pierre","videoId":"ias_lZDHeCg","why":"بيير يغطي الموضع قبل الفعل ومع الماضي والنفي — الجزء الذي يخطئ فيه الجميع، بأسلوب هادئ متكرر.","cat":"Grammar","level":"A2","extra":true}],"supplements":[{"id":"NPS4hnCHv-4","title":"Les pronoms compléments d'objet direct et indirect (COD et COI)","channel":"Parlez-vous FRENCH","why":"شرح أكاديمي منظم للنوعين مع جداول واضحة — الأساس المنهجي قبل التطبيق.","lang":"fr"},{"id":"TPfQqEoyyyQ","title":"LE, LA, LES ou LUI, LEUR | Les pronoms COD et COI en français","channel":"Le French Club","why":"تدريب اختيار مباشر: le/la/les أم lui/leur؟ — نفس السؤال الذي سيواجهك في كل جملة، بصيغة تمرين حي.","lang":"fr"},{"id":"ias_lZDHeCg","title":"Les pronoms COD et COI en français : LE/LUI - LES/LEUR - Etc.","channel":"Français avec Pierre","why":"بيير يغطي الموضع قبل الفعل ومع الماضي والنفي — الجزء الذي يخطئ فيه الجميع، بأسلوب هادئ متكرر.","lang":"fr"}]},{"id":"A2-t3-l4","fr":"Y et en","ar":"الضمائر y و en","objectives":["استخدام y للمكان","استخدام en للكمية و de","الجمع بينهما في جملة"],"sections":[{"h":"y = هناك / إليه","p":["y يستبدل المكان (à + مكان): Tu vas à Paris ? — Oui, j'y vais (نعم أذهب إليها). Il est au bureau ? — Oui, il y est. قاعدة واحدة: كل ما سبقته في الأصل بـ à من المكان يستبدله بـ y.","يأتي قبل الفعل دائماً: J'y vais، Nous y allons، Je n'y vais pas (لا أذهب إليها). مع أزمنة المركب يبقى قبل المساعد: Je n'y suis pas allé. المكان ثابت والضمير يتحرّك مع الفعل.","تابع الفيديو الأساسي بالشرح العربي بمستوى DELF A2: يبني y من السؤال والإجابة ثم ينتقل لـ en. التدرّج المزدوج في فيديو واحد يُظهر أن الضمرين «توأمان»: كلاهما يستبدل ولا يُذكر بعده ما استُبدل.","en يستبدل الكمية بعد de: Tu as des frères ? — Oui, j'en ai deux (نعم عندي اثنان). Tu veux du café ? — Non, merci, je n'en veux pas. تغيّر en نفسها بأعداد مختلفة: j'en ai un/plusieurs/plein.","مع الأفعال الجرّية يأتي en جاهزاً: parler de → J'en parle (أتحدث عنه)، avoir besoin de → J'en ai besoin (أحتاجه)، être content de → J'en suis content. هذه التراكيب من أكثر ما يُستعمل في المحادثة اليومية.","الترتيب بينهما: y يسبق en (على الرغم من أن القياس اللغوي عكسه تاريخياً): On y en a beaucoup (لدينا الكثير منهم هناك). احفظ الجملة القصيرة شاهداً — القاعدة وحدها تُنسى، والشاهد يبقى."],"video":{"id":"AaSayysMN6Y","title":"(37) الضمير en والضمير y  - قواعد اللغة الفرنسية Grammaire DELF A2 - Les pronoms EN et Y","channel":"فرنشاوي Frenchawy","why":"شرح الضمائر y و en بمستوى DELF A2 بالعربية — يربط الاستعمال بالقواعد التي بنيتها في A1.","lang":"ar","main":true,"dur":16},"sub":[{"h":"y: المكان أولًا","p":["Tu vas à Paris ? — Oui, j'y vais.","Il est au bureau ? — Oui, il y est.","Je n'y pense plus. (لم أعد أفكر فيه/بها).","مع المركب: Je n'y suis pas allé."]},{"h":"en: الكمية و de","p":["Tu as des frères ? — Oui, j'en ai deux.","Tu veux du café ? — Non, je n'en veux pas.","avec besoin/parler/content: J'en ai besoin / J'en parle.","الأعداد تبقى بعد en: j'en ai trois."]},{"h":"الترتيب داخل الجملة","p":["y قبل en: On y en a beaucoup.","كلاهما قبل الفعل: Je vais y penser / J'en ai parlé.","النفي: je n'y vais pas / je n'en veux pas."]}]},{"h":"en = منها / منه","p":["en يستبدل الكمية بعد de: Tu as des frères ? — Oui, j'en ai deux (نعم عندي اثنان). Tu veux du café ? — Non, merci, je n'en veux pas.","مع الكميات اللفظية يبقى الرقم بعد en: J'en ai trois (عندي ثلاثة). ملاحظة: en تأتي قبل الفعل مثل y.","السؤال بالكلمات المستبدلة: «Tu penses à ce projet ? — J'y pense.» و«Tu parles du film ? — J'en parle.» — لاحظ أن à يقود y و de يقود en في الأصل دائماً."],"video":null},{"h":"تراكيب مهمة مع en","p":["en مع الأفعال الجرّية: parler de → J'en parle (أتحدث عنه)، avoir besoin de → J'en ai besoin (أحتاجه)، être content de → J'en suis content.","والترتيب مع y: y يسبق en: On y en a beaucoup (لدينا الكثير منهم هناك).","أوقف الفيديو الإثرائي عند كل سلسلة استبدال واكتبه بخط اليد ثلاث مرات: الجملة الكاملة، ثم بعد y، ثم بعد en. الكتابة الثلاثية تثبت المسار لا الحفظ العقلي."],"video":null},{"h":"التطبيق والتلخيص","p":["يُكمل هذا الدرس ضمائر الاستبدال: y تحلّ محلّ à + مكان (Tu vas à Paris ? — Oui, j'y vais) وen تحلّ محلّ de + كمية أو شيء (Tu as des frères ? — Oui, j'en ai deux)، وكلاهما قبل الفعل وقبل الفعل المساعد في المركب، وترتيبهما ثابت عند الاجتماع: y قبل en. وen تُغلق على ما قبلها فلا يُكرَّر de (je n'en veux pas، J'en ai besoin)، وتستبدل الأفعال الجرّية كاملة (parler de ← J'en parle، penser à ← J'y pense). كما وضح الفيديو الرئيسي «(37) الضمير en والضمير y  - قواعد اللغة الفرنسية Grammaire DELF A2 - Les pronoms EN et Y»، الضميران توأمان: كلٌّ منهما يستبدل ولا يُذكر بعده ما استُبدل، وهما أداة اختصار يومي لا زينة. رابط الفيديو الأساسي: https://www.youtube.com/watch?v=AaSayysMN6Y","السلسلة: يكمل a2-t3-l3 (ضمائر COD و COI) ضمائر الأشخاص، ويضيف هذا الدرس a2-t3-l4 ضمَيْري المكان والكمية، ثم يتبعه a2-t3-l5 (المقارنة والتفضيل) الذي يُستعمل فيه en في صيغ التفضيل (le plus ... du monde). وقد أحال عليك a2-t2-l1 (يوم في حياة سامي) جملًا مفعولية تصلح للاستبدال بـ y و en، ويستعمل a2-t6-l1 (وصف الأشخاص والأماكن) «penser à» و«parler de» في وصفه، بينما تظهر en مع الأعداد في a2-t1-l3 (الإعلانات وقوائم الطعام والجداول) وفي حوارات a2-t5-l1.","أعد مشاهدة الفيديو الرئيسي وقوفاً عند كل سلسلة استبدال، ثم سجّل نفسك وأنت تجيب عن ستة أسئلة: ثلاثة عن أماكن بـ y وثلاثة عن كميات بـ en، مع جملة واحدة تجمع الاثنين (On y en a ...)، واستمع إلى تسجيلك وتحقق من ترتيب الضمائر قبل الفعل. ثم انتقل إلى a2-t3-l5."]}],"examples":[{"fr":"Tu vas au travail ? — Oui, j'y vais.","ar":"تذهب للعمل؟ — نعم أذهب إليه."},{"fr":"Tu as des enfants ? — J'en ai deux.","ar":"عندك أطفال؟ — عندي اثنان."},{"fr":"Je pense à ton problème — j'en pense souvent.","ar":"أفكر في مشكلتك — أفكر فيها غالباً."},{"fr":"Il n'y en a plus.","ar":"لم يعد هناك أي منه."},{"fr":"Tu vas à Lyon ? Oui, j'y vais demain.","ar":"هل تذهب إلى ليون؟ نعم، سأذهب إليها غداً.","note":"y للمكان"},{"fr":"Il y a du pain ? Oui, il en reste.","ar":"هل يوجد خبز؟ نعم، يتبقى منه.","note":"en للكمية"},{"fr":"J'en ai besoin maintenant.","ar":"أحتاج إليه الآن.","note":"avoir besoin de"},{"fr":"On y en a beaucoup à la maison.","ar":"لدينا الكثير منها في البيت.","note":"y قبل en"}],"pron":[{"w":"j'y vais","ipa":"[ʒi.vɛ]","approx":"جي-فِه"},{"w":"j'en ai deux","ipa":"[ʒɑ̃.ne.dø]","approx":"جان-نيه-دو"},{"w":"il y en a","ipa":"[i.ljɑ̃.na]","approx":"إيل-يان-نا"}],"vocab":[{"fr":"y","ar":"هناك / إليه","pos":"pronom","ipa":"[i]","exFr":"J'y pense.","exAr":"أفكر فيه."},{"fr":"en","ar":"منه / منها","pos":"pronom","ipa":"[ɑ̃]","exFr":"J'en veux deux.","exAr":"أريد اثنين منه."},{"fr":"avoir besoin de","ar":"يحتاج","pos":"expression","ipa":"[a.vwaʁ bə.zwɛ̃ də]","exFr":"J'en ai besoin.","exAr":"أحتاجه."},{"fr":"penser à","ar":"يفكر في","pos":"verbe","ipa":"[pɑ̃.se.a]","exFr":"J'y pense souvent.","exAr":"أفكر فيه غالباً."},{"fr":"se souvenir de","ar":"يتذكر","pos":"verbe","ipa":"[sə.su.və.niʁ də]","exFr":"Je m'en souviens.","exAr":"أتذكره."},{"fr":"parler de","ar":"يتحدث عن","pos":"locution","exFr":"Nous en parlons souvent.","ipa":"[paʁle]","exAr":"نتحدث عنه كثيراً."},{"fr":"être content de","ar":"سعيد بـ","pos":"locution","exFr":"J'en suis content.","ipa":"[kɔ̃tɑ̃]","exAr":"أنا سعيد به."},{"fr":"un résultat","ar":"نتيجة","pos":"nom","g":"m","exFr":"Tu es content du résultat ?","ipa":"[ʁezylta]","exAr":"أنت سعيد بالنتيجة؟"},{"fr":"s'inquiéter de","ar":"ينتبه لـ/يقلق من","pos":"locution","exFr":"Je m'en inquiète.","ipa":"[ɛ̃kjete]","exAr":"أقلق منها."},{"fr":"répondre à","ar":"يجيب على","pos":"locution","g":"—","ipa":"[ʁɛspɔndʁ a]","exFr":"Je réponds à son message.","exAr":"أجيب على رسالته.","note":"كل ما سبقته à من غير المكان يُستبدل بـ y: répondre à ← j'y réponds."}],"grammar":[{"tFr":"Les pronoms y et en","tAr":"القاعدة: ضميرا y و en","body":["y = à + مكان (j'y vais)، en = de + كمية/شيء (j'en ai). كلاهما يحل محل الذكر ولا يأتي بعده ما استُبدل.","المكان: قبل الفعل ومع المركب قبل المساعد. الترتيب: y قبل en عند اجتماعهما."],"ex":[{"fr":"Tu réponds à mon email ? — J'y réponds ce soir.","ar":"هل ترد على بريدي؟ — سأجيب عليه هذا المساء."},{"fr":"Vous avez des questions ? — Nous en avons une.","ar":"هل لديكم أسئلة؟ — لدينا سؤال واحد."}]}],"mistakes":[{"wrong":"Je pense à ça → Je le pense","right":"J'y pense","why":"penser à يأخذ y لا les/le."},{"wrong":"J'en ai de (بلا كمية)","right":"J'en ai / j'en ai beaucoup","why":"en تحذف ما قبلها تماماً — لا تُكرر de."},{"wrong":"en قبل y","right":"y قبل en: On y en a","why":"الترتيب ثابت ومقابلة الجملة القصيرة تحفظه."},{"wrong":"استبدال بـ le مع à","right":"à مكان ← y، à شخص ← lui","why":"à + مكان ← y، أما à + شخص فـ COD/COI كما تعلمت."}],"dialogues":[{"title":"استفسار عن رحلة","ctx":"صديقان يتذاكران","lines":[{"who":"Fatiha","fr":"Tu penses à ton voyage à Fès ?","ar":"تفكر في رحلتك إلى فاس؟"},{"who":"Karim","fr":"Oui, j'y pense tout le temps !","ar":"نعم، أفكر فيها طوال الوقت!"},{"who":"Fatiha","fr":"Et tu as besoin d'argent ?","ar":"وهل تحتاج إلى مال؟"},{"who":"Karim","fr":"J'en ai un peu, mais il m'en faut plus.","ar":"عندي قليلاً لكنني أحتاج إلى المزيد."},{"who":"Fatiha","fr":"On en parlera demain, d'accord ?","ar":"سنتحدث عنه غداً، حسناً؟"},{"who":"Karim","fr":"D'accord, j'y pense et j'y reviens.","ar":"حسناً، سأفكر فيه وأعود إليك."}]}],"exercises":[{"t":"mcq","skill":"grammar","q":"«تذهب للسوق؟» ← «نعم أذهب إليه»:","opts":["Oui, je en vais","Oui, j'y vais","Oui, je le vais","Oui, j'y ai"],"a":1,"why":"y يستبدل المكان قبل الفعل."},{"t":"mcq","skill":"grammar","q":"«عندك أخوان؟» ← «عندي اثنان»:","opts":["J'ai deux","J'en ai deux","J'y ai deux","Je les ai deux"],"a":1,"why":"en يستبدل de + الكمية."},{"t":"fill","skill":"grammar","q":"أكمل: «Tu as besoin du livre ? — Oui, j'___ ai besoin.»","fr":"j'___ ai besoin.","ans":"en","why":"avoir besoin de ← en."},{"t":"translate","skill":"writing","q":"ترجم: «أفكر فيه غالباً.»","ans":"J'y pense souvent.","alts":["j y pense souvent"],"why":"penser à تأخذ ضمير المكان y: الاستبدال يحذف حرف الجر والشيء معاً، فلا يقال «je le pense» ولا «j'en pense»."},{"t":"listen","skill":"listening","q":"استمع واختر:","audio":"Je n'en veux plus","opts":["لا أريد المزيد منها","لا أذهب هناك","لا أعرفها","لا أريده هو"],"a":0,"why":"en تستبدل de والكمية معاً، و«ne ... plus» يحيط بالضمير قبل الفعل، فالمقروء حتماً «لا أريد المزيد منها»."},{"t":"order","skill":"grammar","q":"رتّب: «لم يعد هناك أي منه»","words":["Il","n'y","en","a","plus"],"ans":"Il n'y en a plus","why":"الضمائر كلها قبل الفعل وترتيبها ثابت: y يسبق en — شاهد الجملة «Il n'y en a plus» هو الحافظ لهذا التسبيق."},{"t":"mcq","skill":"grammar","q":"الترتيب الصحيح عند اجتماع y و en هو:","opts":["y قبل en","en قبل y","أي ترتيب","لا يجتمعان أبداً"],"a":0,"why":"y يسبق en دائماً: On y en a beaucoup."},{"t":"translate","skill":"writing","q":"ترجم: «نعم، أذهب إليها.»","ans":"Oui, j'y vais.","alts":["oui jy vais","Oui, jy vais."],"why":"à + مكان ← y تحل محلها."}],"homework":"اكتب 6 جمل: 3 بـ y (أماكن) و3 بـ en (كميات وأفعال جرّية).\nالدرس السابق/التالي: a2-t3-l3 (ضمائر المفعول COD و COI) / a2-t3-l5 (المقارنة والتفضيل).","sources":[{"title":"(37) الضمير en والضمير y  - قواعد اللغة الفرنسية Grammaire DELF A2 - Les pronoms EN et Y","channel":"فرنشاوي Frenchawy","videoId":"AaSayysMN6Y","why":"شرح الضمائر y و en بمستوى DELF A2 بالعربية — يربط الاستعمال بالقواعد التي بنيتها في A1.","cat":"Grammar","level":"A2","main":true},{"title":"Y et EN - Les pronoms compléments en français (Partie 2)","channel":"Parlez-vous FRENCH","videoId":"B6er4XipYXE","why":"الجزء الثاني من دورة الضمائر يخصص شرحاً كاملاً لـ y وen مع تمرين موجه — امتداد طبيعي لدرس COD/COI.","cat":"Grammar","level":"A2","extra":true},{"title":"2 Common French Pronouns: Y vs EN","channel":"Learn French With Alexa","videoId":"OHQPlvD1ypc","why":"أليكسا تفصل بين الضميرين بالإنجليزية ببساطة شديدة — نظرة ثانية بلغة ثالثة تصلّب الفكرة.","cat":"Grammar","level":"A2","extra":true},{"title":"Pronoms \"EN\" et \"Y\" en français: règles, exemples, test","channel":"Français avec Nelly","videoId":"w9aa2aQkOuk","why":"قواعد + أمثلة + اختبار في فيديو واحد — اختبار نهاية الفيديو هو تمرين مثالي قبل تمارين الدرس.","cat":"Grammar","level":"A2","extra":true}],"supplements":[{"id":"B6er4XipYXE","title":"Y et EN - Les pronoms compléments en français (Partie 2)","channel":"Parlez-vous FRENCH","why":"الجزء الثاني من دورة الضمائر يخصص شرحاً كاملاً لـ y وen مع تمرين موجه — امتداد طبيعي لدرس COD/COI.","lang":"fr"},{"id":"OHQPlvD1ypc","title":"2 Common French Pronouns: Y vs EN","channel":"Learn French With Alexa","why":"أليكسا تفصل بين الضميرين بالإنجليزية ببساطة شديدة — نظرة ثانية بلغة ثالثة تصلّب الفكرة.","lang":"en"},{"id":"w9aa2aQkOuk","title":"Pronoms \"EN\" et \"Y\" en français: règles, exemples, test","channel":"Français avec Nelly","why":"قواعد + أمثلة + اختبار في فيديو واحد — اختبار نهاية الفيديو هو تمرين مثالي قبل تمارين الدرس.","lang":"fr"}]},{"id":"A2-t3-l5","fr":"Comparatif et superlatif","ar":"المقارنة والتفضيل","objectives":["المقارنة بـ plus/moins/aussi","التفضيل بـ le plus / le moins","الأشكال الشاذة: meilleur, mieux"],"sections":[{"h":"المقارنة (comparatif)","p":["plus + صفة + que (أكثر من): Le train est plus rapide que le bus (القطار أسرع من الباص). moins ... que (أقل من): Le bus est moins cher que l'avion. aussi ... que (بقدر/مثل): Elle est aussi grande que sa mère. ثلاث صيغ تبني مقارناتك كلها.","لاحظ أن الصفة بعد plus/aussi لا تتغير، لكنها بعد moins قد تتأثر بالضبط: plus grand que (بلا s) مقابل moins grands que (مع s في الجمع). اكتب المقارنة كاملة وتحقق من طرفيها: المُقارَن والمُقارَن به.","شاهد الفيديو الأساسي بالشرح العربي: plus/moins/aussi تُبنى في أمثلة مصوّرة — القطار مقابل الحافلة، الطقس الماضي مقابل الحاضر. المقارنة بالصور تثبت المعنى قبل القاعدة.","التفضيل (superlatif): le/la/les + plus/moins + صفة: C'est le plus beau pays (أجمل بلد). C'est la ville la plus animée (أكثر مدينة حيوية). superlatif لا يفقد الأداة مهما كان السياق — le تبقى معًا حتى لو بدت ثقيلة.","تفضيل بـ en?: نعم: «C'est la plus belle ville du monde» — à/de + le للضمير: du (de+le)، des، au. هذه الوصلات القصيرة تظهر في كل جملة تفضيل عن «الأفضل في...».","الأشكال الشاذة هي الميزة الحقيقية: bon → meilleur (أفضل — للصفات): Ce café est meilleur que l'autre. bien → mieux (أفضل حالاً — للأفعال): Je parle mieux qu'avant. لا تخلط: الشيء يُقيَّم بـ meilleur، وطريقة الفعل بم mieux."],"video":{"id":"p3xRtSm--HE","title":"تعلم اللغة الفرنسية :كيفية المقارنة و التفضيل بالفرنسية Le comparatif et le superlatif","channel":"عربي بلسان فرنسي","why":"المقارنة والتفضيل في فيديو واحد بالعربية مع الشكلين الشاذين — يغطي الدرس كله في جلسة واحدة.","lang":"ar","main":true,"dur":11},"sub":[{"h":"الصيغ الثلاث للمقارنة","p":["plus ... que — أكثر من: plus rapide que","moins ... que — أقل من: moins cher que","aussi ... que — بقدر/مثل: aussi grand que","مع نفي: ne ... pas aussi ... que (ليس بقدر)"]},{"h":"التفضيل le plus / le moins","p":["le plus beau — الأجمل","la moins chère — الأرخص (مؤنث)","les plus rapides — الأسرع (جمع)","مع الجر: du monde / de la ville / des écoles"]},{"h":"الشاذات الذهبية","p":["bon → meilleur → le meilleur (صفة)","bien → mieux → le mieux (فعل)","mauvais → pire → le pire (أسوأ)","Ce livre est meilleur que l'autre. / Il parle mieux."]}]},{"h":"التفضيل (superlatif)","p":["le/la/les + plus/moins + صفة: C'est le plus beau pays (أجمل بلد). C'est la ville la plus animée (أكثر مدينة حيوية).","ملاحظة: superlatif لا يفقد الأداة مهما كان السياق.","قاعدة «bien mieux لا bien meilleur»: bien تُقيَّم بها أفعال (تكلم، أكل، نجح) وتتخذ mieux. bon صفة للأشياء وتتخذ meilleur. جملة واحدة تحفظ التمييز: «Il chante bien, et ce gâteau est bon.»"],"video":null},{"h":"الأشكال الشاذة","p":["bon → meilleur (أفضل): Ce café est meilleur que l'autre. المفاضل: le meilleur (الأفضل).","bien → mieux (أفضل حالاً): Je parle mieux qu'avant (أتحدث أفضل من قبل). المفاضل: le mieux.","لا تخلط: meilleur للصفات (كيفية الشيء)، mieux للأفعال (كيفية الفعل).","الفيديو الإثرائي يعرض مقارنات في الحياة اليومية؛ أوقفه وصف أنت أشياء من غرفتك بـ plus/moins/aussi. التوليد الفوري يحول الجدول إلى لسان."],"video":null},{"h":"التطبيق والتلخيص","p":["يبني هذا الدرس المقارنة والتفضيل: الصيغ الثلاث plus ... que وmoins ... que وaussi ... que تقارن شيئًا بشيء، وصيغة superlatif تحمل الأداة le/la/les مع plus أو moins (C'est la ville la plus animée) ووصلات الجر du / des / au في «الأفضل في...»، والشاذات bon ← meilleur للصفات وbien ← mieux للأفعال وmauvais ← pire: الشيء يُقيَّم بـ meilleur وطريقة الفعل بم mieux. كما وضح الفيديو الرئيسي «تعلم اللغة الفرنسية :كيفية المقارنة و التفضيل بالفرنسية Le comparatif et le superlatif»، الصيغ الثلاث والشاذات تغطي كل مقارنة تحتاجها في الحياة اليومية وفي الامتحان. رابط الفيديو الأساسي: https://www.youtube.com/watch?v=p3xRtSm--HE","السلسلة: يلي a2-t3-l4 (الضميران y و en) هذا الدرس a2-t3-l5، فتنتقل من الاستبدال إلى المقارنة بين المفردات نفسها، ثم يقفل a2-t3-l6 (subjonctif) سلسلة القواعد الستة في a2-t3. وقد وردت المقارنة في نصوص a2-t1-l3 (الإعلانات والقوائم: «le moins cher»)، وتصِف a2-t6-l1 (وصف الأشخاص والأماكن) بما بنيته هنا (plus grand que / la plus animée)، ولا يستقيم الرأي في a2-t6-l2 (التعبير عن الرأي) بلا mieux وmeilleur، وتُسمع الصيغ نفسها في a2-t5-l1 وأحداث a2-t7-l1.","أعد مشاهدة الفيديو الرئيسي عند كل مقارنة، ثم سجّل نفسك وأنت تقارن ثلاثة أشياء من غرفتك في ثلاث جمل (plus ... que، moins ... que، aussi ... que) وتضيف superlatif واحداً وصيغة شاذة واحدة، واستمع إلى تسجيلك وتحقق من que بعد كل مقارنة ومن فرق meilleur عن mieux. ثم انتقل إلى a2-t3-l6."]}],"examples":[{"fr":"Le métro est plus rapide que le bus.","ar":"المترو أسرع من الباص."},{"fr":"Cette maison est la plus grande de la rue.","ar":"هذا البيت أكبر بيت في الشارع."},{"fr":"Il travaille mieux que moi.","ar":"يعمل أفضل مني."},{"fr":"C'est le meilleur restaurant du quartier.","ar":"إنه أفضل مطعم في الحي."},{"fr":"Paris est plus grande que Lyon.","ar":"باريس أكبر من ليون.","note":"plus ... que"},{"fr":"Le métro est aussi rapide que le bus.","ar":"المترو بسرعة الحافلة.","note":"aussi ... que"},{"fr":"C'est la moins chère des trois.","ar":"إنها الأرخص بين الثلاث.","note":"superlatif negatif"},{"fr":"Il parle mieux qu'avant.","ar":"يتكلم أفضل من قبل.","note":"bien → mieux"}],"pron":[{"w":"plus rapide","ipa":"[ply.ʁa.pid]","approx":"بليه-رابيد","note":"plus تُنطق [ply] وغالباً s صامتة"},{"w":"mieux","ipa":"[mjø]","approx":"ميو"},{"w":"meilleur","ipa":"[mɛ.jœʁ]","approx":"مييوهر"}],"vocab":[{"fr":"plus ... que","ar":"أكثر من","pos":"comparatif","ipa":"[ply.kə]","exFr":"Il est plus grand que moi.","exAr":"هو أطول مني."},{"fr":"moins ... que","ar":"أقل من","pos":"comparatif","ipa":"[mwɛ̃.kə]","exFr":"Ce livre est moins intéressant.","exAr":"هذا الكتاب أقل إثارة."},{"fr":"aussi ... que","ar":"بقدر / مثل","pos":"comparatif","ipa":"[o.si.kə]","exFr":"Elle est aussi rapide que lui.","exAr":"هي سريعة مثله."},{"fr":"meilleur / meilleure","ar":"أفضل (صفة)","pos":"adj","g":"mf","ipa":"[mɛ.jœʁ]","exFr":"Ce pain est meilleur.","exAr":"هذا الخبز أفضل."},{"fr":"mieux","ar":"أفضل (فعل)","pos":"adv","ipa":"[mjø]","exFr":"Je dors mieux maintenant.","exAr":"أنام أفضل الآن."},{"fr":"le plus","ar":"الأكثر","pos":"superlatif","ipa":"[lə.ply]","exFr":"C'est le plus rapide.","exAr":"إنه الأسرع."},{"fr":"meilleur(e)","ar":"أفضل (صفة)","pos":"adj","exFr":"Ce film est meilleur que l'autre.","ipa":"[mɛjœʁ]","exAr":"هذا الفيلم أفضل من الآخر."},{"fr":"le plus ... du monde","ar":"الأكثر ... في العالم","pos":"locution","exFr":"La plus belle ville du monde.","ipa":"[ply də mɔ̃d]","exAr":"أجمل مدينة في العالم."},{"fr":"animé(e)","ar":"حيوي","pos":"adj","exFr":"C'est la ville la plus animée.","ipa":"[anime]","exAr":"إنها أكثر مدينة حيوية."},{"fr":"cher / pas cher","ar":"غالٍ / رخيص","pos":"adj","exFr":"Il est moins cher en ligne.","ipa":"[ʃɛʁ]","exAr":"أرخص على الإنترنت."}],"grammar":[{"tFr":"Comparatif et superlatif","tAr":"القاعدة: المقارنة والتفضيل","body":["المقارنة: plus/moins/aussi + صفة + que. التفضيل: le/la/les + plus/moins + صفة (+ de).","bon → meilleur / bien → mieux — الشاذات تُقيَّم بها الأشياء والأفعال على التوالي."],"ex":[{"fr":"C'est le meilleur restaurant du quartier.","ar":"أفضل مطعم في الحي."},{"fr":"Tu chantes mieux que moi.","ar":"أنت تغني أفضل مني."}]}],"mistakes":[{"wrong":"plus bon","right":"meilleur","why":"bon شاذة — لا تدخل في قالب plus."},{"wrong":"bien meilleur (للفعل)","right":"mieux","why":"بجانب الأفعال bien تتخذ mieux دائماً."},{"wrong":"le plus plus قادمة من السؤال","right":"من دون تكرار: le plus grand","why":"التفضيل يحمل الأداة مرة واحدة فقط."},{"wrong":"aussi ... que مع النفي مباشرة","right":"ne pas aussi ... que","why":"النفي يحيط بـ aussi: il n'est pas aussi grand."}],"dialogues":[{"title":"مقارنة وسائل النقل","ctx":"زوجان يختاران وسيلة السفر","lines":[{"who":"Hind","fr":"Le train est plus rapide que la voiture ?","ar":"القطار أسرع من السيارة؟"},{"who":"Youssef","fr":"Oui, mais la voiture est moins chère pour quatre personnes.","ar":"نعم، لكن السيارة أقل تكلفة لأربعة أشخاص."},{"who":"Hind","fr":"Et l'avion ?","ar":"والطائرة؟"},{"who":"Youssef","fr":"L'avion est plus rapide, mais le train est aussi confortable.","ar":"الطائرة أسرع، لكن القطار مريح بقدرها."},{"who":"Hind","fr":"Quel est le plus économique ?","ar":"ما الاقتصادي أكثر؟"},{"who":"Youssef","fr":"Le train est le plus économique, sans doute.","ar":"القطار هو الاقتصادي بلا شك."}]}],"exercises":[{"t":"mcq","skill":"grammar","q":"«الباص أقل تكلفة من التاكسي»:","opts":["Le bus est plus cher que le taxi","Le bus est moins cher que le taxi","Le bus est aussi cher que le taxi","Le bus est le moins cher taxi"],"a":1,"why":"moins + صفة + que = أقل من."},{"t":"fill","skill":"grammar","q":"أكمل بالشاذ: «Ce thé est ___ que le café.» (أفضل)","fr":"Ce thé est ___ que le café.","ans":"meilleur","why":"bon → meilleur للمقارنة."},{"t":"mcq","skill":"grammar","q":"«أتحدث أفضل من قبل»:","opts":["Je parle meilleur qu'avant","Je parle mieux qu'avant","Je parle plus bien qu'avant","Je parle le mieux qu'avant"],"a":1,"why":"الأفعال ← mieux."},{"t":"translate","skill":"writing","q":"ترجم: «المترو أسرع من الباص.»","ans":"Le métro est plus rapide que le bus.","alts":["le métro est plus rapide que le bus"],"why":"المقارنة الفرنسية لا تكتمل بلا «plus + صفة + que»؛ وحذف que يجعل الجملة ناقصة والمعنى معلّقاً بين الطرفين."},{"t":"listen","skill":"listening","q":"استمع واختر المعنى:","audio":"Elle est aussi intelligente que son frère","opts":["أذكى من أخيها","أقل ذكاءً من أخيها","ذكية بقدر أخيها","الأذكى في العائلة"],"a":2,"why":"aussi ... que تنقل التساوي لا التفوق؛ الصيغة المسموعة بلا plus ولا moins تحسم المعنى على «بقدر أخيها»."},{"t":"writing","skill":"writing","q":"اكتب 3 مقارنات عن مدينتك ومدن أخرى بـ plus/moins/aussi.","min":12,"kw":["que","plus"],"sample":"Ma ville est plus grande que ta ville. Elle est aussi animée que Paris. Le coût de la vie est moins cher que Londres.","why":"الإنتاج الحر بالصيغ الثلاث (plus / moins / aussi) هو مهارة هذا الدرس الأساسية؛ والتمرين يقيس توظيفها في جمل مولّدة لا في جمل جاهزة."},{"t":"mcq","skill":"grammar","q":"الصيغة الصحيحة مع bien هي:","opts":["mieux","meilleur","plus bon","très mieux"],"a":0,"why":"bien تتخذ mieux؛ bon تتخذ meilleur."},{"t":"fill","skill":"grammar","q":"أكمل: «Ce gâteau est ___ que l'autre.» (bon — للمقارنة)","fr":"Ce gâteau est ___ que l'autre.","ans":"meilleur","alts":["Meilleur","meilleure"],"why":"bon شاذة: meilleur في المقارنة."}],"homework":"قارن 5 أشياء تحبها ببعضها: أسرع، أجمل، أفضل... بجميع الأشكال (plus, moins, aussi, meilleur).\nالدرس السابق/التالي: a2-t3-l4 (الضميران y و en) / a2-t3-l6 (مقدمة المضارع المنصوب).","sources":[{"title":"تعلم اللغة الفرنسية :كيفية المقارنة و التفضيل بالفرنسية Le comparatif et le superlatif","channel":"عربي بلسان فرنسي","videoId":"p3xRtSm--HE","why":"المقارنة والتفضيل في فيديو واحد بالعربية مع الشكلين الشاذين — يغطي الدرس كله في جلسة واحدة.","cat":"Grammar","level":"A2","main":true},{"title":"La comparaison en français (A2) : plus, moins, aussi, autant","channel":"Tout en français","videoId":"SVdHAZbJ-wo","why":"درس مصنّف حرفياً بمستوى A2 يغطي أدوات المقارنة الأربع بترتيب تدريجي — مطابق تماماً لموضوع الدرس.","cat":"Grammar","level":"A2","extra":true},{"title":"Le plus, le moins, le meilleur, le mieux, le pire… SUPERLATIF EN FRANÇAIS","channel":"French School TV","videoId":"WEdtGS9fPTA","why":"درس المفاضلة الكامل مع الشواذ (meilleur/mieux/pire) — يغطي حرفياً محور الدرس الثالث والتاسع.","cat":"Grammar","level":"A2","extra":true},{"title":"Comment utiliser les comparatifs et superlatifs sans te tromper ?","channel":"Français Authentique","videoId":"jcrLNMnEpXQ","why":"يوهان (فرنسية أصيلة ببطء مقصود) يشرح كيف لا تخطئ في المقارنات — تدريب سمعي حقيقي فوق الشرح.","cat":"Grammar","level":"A2","extra":true}],"supplements":[{"id":"SVdHAZbJ-wo","title":"La comparaison en français (A2) : plus, moins, aussi, autant","channel":"Tout en français","why":"درس مصنّف حرفياً بمستوى A2 يغطي أدوات المقارنة الأربع بترتيب تدريجي — مطابق تماماً لموضوع الدرس.","lang":"fr"},{"id":"WEdtGS9fPTA","title":"Le plus, le moins, le meilleur, le mieux, le pire… SUPERLATIF EN FRANÇAIS","channel":"French School TV","why":"درس المفاضلة الكامل مع الشواذ (meilleur/mieux/pire) — يغطي حرفياً محور الدرس الثالث والتاسع.","lang":"fr"},{"id":"jcrLNMnEpXQ","title":"Comment utiliser les comparatifs et superlatifs sans te tromper ?","channel":"Français Authentique","why":"يوهان (فرنسية أصيلة ببطء مقصود) يشرح كيف لا تخطئ في المقارنات — تدريب سمعي حقيقي فوق الشرح.","lang":"fr"}]},{"id":"A2-t3-l6","fr":"Le subjonctif — introduction","ar":"مقدمة في المضارع المنصوب (subjonctif)","objectives":["تكوين subjonctif présent","استخدام il faut que","أفعال الرغبة والمشاعر التي تطلبه"],"sections":[{"h":"تكوين subjonctif","p":["من صيغة ils في المضارع: ils parlent → parle-، ثم أضف: -e, -es, -e, -ions, -iez, -ent: que je parle، que tu parles، qu'il parle، que nous parlions، que vous parliez، qu'ils parlent. الجذر من الغائب الجمع — قاعدة واحدة تسقط نصف الدرس.","شواذ مهمة تُحفظ بصوتها: être → que je sois، avoir → que j'aie، aller → que j'aille، faire → que je fasse، pouvoir → que je puisse، savoir → que je sache. ستة أفعال تغطي أغلب جملك المنصوبة.","تابع الفيديو الأساسي بالشرح العربي: يبدأ من «متى نحتاجه» ثم يبني التصريف. الاتجاه الواقعي (الحاجة قبل القاعدة) يجعل الباب المنصوب أقل رهبة — فبلا سياق الحاجة يبدو الباب كلمة بلا معنى.","بعد il faut que (يجب أن): Il faut que tu partes maintenant (يجب أن تغادر الآن). بعد أفعال الرغبة والمشاعر: Je veux que tu viennes (أريدك أن تأتي). Je suis content que tu sois là (سعيد بوجودك هنا).","بعد أفعال الشك: Je doute qu'il vienne (أشك أنه سيأتي)، وbien que (رغم أن): Bien qu'il soit tard, il travaille. لكن بفعل التفكير التأكيدي يبقى المضارع العادي: Je pense qu'il vient — وهذه المفارقة أهم سطر في الدرس.","الفخ الأكبر: il faut que ≠ il faut + مصدر: Il faut partir (يجب المغادرة — بلا شخص محدد) vs Il faut que tu partes (يجب أن تغادر أنت). القاعدة الحاسمة: إذا كان هناك فاعل مختلف بعد que ← منصوب. احفظ الجملتين متقابلتين وستحل كل التمارين."],"video":{"id":"3H3WUCQhJXE","title":"متى نستعمل : le subjonctif présent","channel":"Le français avec Nabil","why":"الدرس الأصعب: متى يُستعمل subjonctif — التركيز على المواضع لا التصريف فقط.","lang":"ar","main":true,"dur":11},"sub":[{"h":"التكوين من ils","p":["ils parlent → جذر: parl-","que je parle / qu'il parle (نفس الصورة مع froid ← fon-).","nous: -ions مسموعة (que nous parlions).","vous: -iez (que vous parliez)."]},{"h":"المواقف التي تطلبه","p":["il faut que — يجب أن (ضرورة).","je veux que / je souhaite que — أريد أن (رغبة).","je suis content que — سعيد بأن (مشاعر).","je doute que / bien que — أشكّ/رغم أن (شك وتفريع)."]},{"h":"الشاذات الستة","p":["être → que je sois","avoir → que j'aie","aller → que j'aille","faire → que je fasse","pouvoir → que je puisse","savoir → que je sache"]}]},{"h":"متى نستخدمه؟","p":["بعد il faut que (يجب أن): Il faut que tu partes maintenant (يجب أن تغادر الآن).","بعد أفعال الرغبة والمشاعر: Je veux que tu viennes (أريدك أن تأتي). Je suis content que tu sois là (سعيد بوجودك هنا).","بعد أفعال الشك: Je doute qu'il vienne (أشك أنه سيأتي). لكن بفعل التفكير التأكيدي يبقى المضارع: Je pense qu'il vient.","استثناء تأكيد التفكير: «Je pense que...» تبقى بالمضارع (أظن أنه يأتي)، لكن «Je ne pense pas que...» و«Je doute que...» تنتقلان للمنصوب — التأكيد يبقى والشك ينقلب. احفظ الثلاثة معًا."],"video":null},{"h":"الفخ الأكبر","p":["il faut que ≠ il faut + مصدر: Il faut partir (يجب المغادرة — بدون شخص محدد) vs Il faut que tu partes (يجب أن تغادر أنت).","احفظ القاعدة: إذا كان هناك فاعل مختلف بعد que ← subjonctif.","الفيديو الإثرائي يركّز على المواقف اليومية لـ il faut que؛ أوقفه واكتب ثلاثة «il faut que» من قواعد بيتك أو جدولك اليومي بضمائر مختلفة."],"video":null},{"h":"التطبيق والتلخيص","p":["يلخّص هذا الدرس أول دخول إلى subjonctif: التكوين من صيغة ils في المضارع بأخذ الجذر وإضافة -e, -es, -e, -ions, -iez, -ent (ils parlent ← que je parle)، والشاذات الست (sois، aie، aille، fasse، puisse، sache)، والمواقف التي تطلبه: il faut que للضرورة، وأفعال الرغبة والمشاعر (je veux que، je suis content que)، وأفعال الشك و bien que، مع استثناء «je pense que» الذي يبقى مضمراً في الإثبات. والقاعدة الحاسمة: il faut partir بلا شخص محدّد، وil faut que tu partes لفاعل مختلف بعد que. كما وضح الفيديو الرئيسي «متى نستعمل : le subjonctif présent»، الاتجاه الواقعي (الحاجة قبل القاعدة) يجعل الباب المنصوب أقلّ رهبة، فبلا سياق الحاجة يبدو subjonctif كلمة بلا معنى. رابط الفيديو الأساسي: https://www.youtube.com/watch?v=3H3WUCQhJXE","السلسلة: أغلق a2-t3-l5 (المقارنة والتفضيل) المقارنة، ويختم هذا الدرس a2-t3-l6 سلسلة القواعد الستة في a2-t3، ثم يفتح a2-t4-l1 (عند الطبيب وفي البنك) المحادثة الواقعية حيث تقول «Il faut que vous preniez...». وقد أعطاك a2-t2-l3 (الأسد والفأر) جملًا قصيرة تصلح لصياغتها بالمنصوب، وتستعمل a2-t6-l3 (كتابة الرسائل) صيغة الرغبة «je souhaite que»، بينما تنقل a2-t5-l1 (الحوارات القصيرة) وأحداث a2-t7-l1 المنصوب في كلام مسموع.","أعد مشاهدة الفيديو الرئيسي وقوفاً عند كل موضع ينتقل فيه الفعل إلى المنصوب، ثم سجّل نفسك وأنت تصرّف ثلاثة أفعال شاذة (être، faire، savoir) بعد «il faut que» وتقرأ جملة واحدة بـ bien que، واستمع إلى تسجيلك وتحقق من أن كل que يليها صيغة subjonctif. ثم انتقل إلى a2-t4-l1."]}],"examples":[{"fr":"Il faut que tu viennes demain.","ar":"يجب أن تأتي غداً."},{"fr":"Je veux que tu sois heureux.","ar":"أريدك أن تكون سعيداً."},{"fr":"C'est important que nous partions tôt.","ar":"من المهم أن نغادر باكراً."},{"fr":"Bien qu'il soit malade, il travaille.","ar":"رغم أنه مريض، إنه يعمل."},{"fr":"Il faut que tu fasses tes devoirs.","ar":"يجب أن تفعل واجباتك.","note":"il faut que + فاعل مختلف"},{"fr":"Je veux que vous soyez prêts.","ar":"أريدكم أن تكونوا جاهزين.","note":"رغبة"},{"fr":"Bien qu'il pleuve, on sort.","ar":"رغم أنها تمطر، نخرج.","note":"bien que"},{"fr":"Je pense qu'il vient ce soir.","ar":"أظن أنه يأتي هذا المساء.","note":"تفكير تأكيدي يبقى مضمراً"}],"pron":[{"w":"il faut que","ipa":"[il.fo.kə]","approx":"يل-فو-كو"},{"w":"que je sois","ipa":"[kə.ʒə.swa]","approx":"كو-جو-سوا"},{"w":"que tu fasses","ipa":"[kə.ty.fas]","approx":"كو-تي-فاس"}],"vocab":[{"fr":"il faut que","ar":"يجب أن (مع فاعل)","pos":"expression","ipa":"[il.fo.kə]","exFr":"Il faut que j'y aille.","exAr":"يجب أن أذهب."},{"fr":"subjonctif","ar":"المضارع المنصوب","pos":"grammaire","g":"m","ipa":"[syb.ʒɔ̃k.tif]","exFr":"Le subjonctif suit «il faut que».","exAr":"subjonctif يتبع «il faut que»."},{"fr":"douter","ar":"يشك","pos":"verbe","ipa":"[du.te]","exFr":"Je doute qu'il vienne.","exAr":"أشك أنه سيأتي."},{"fr":"bien que","ar":"رغم أن","pos":"conjonction","ipa":"[bjɛ̃.kə]","exFr":"Bien qu'il pleuve, on sort.","exAr":"رغم المطر سنخرج."},{"fr":"important(e)","ar":"مهم","pos":"adj","g":"mf","ipa":"[ɛ̃.pɔʁ.tɑ̃]","exFr":"C'est important que tu saches.","exAr":"من المهم أن تعرف."},{"fr":"que","ar":"أن (أداة النصب)","pos":"conj","exFr":"Je veux que tu viennes.","ipa":"[kə]","exAr":"أريدك أن تأتي."},{"fr":"vouloir que","ar":"يريد أن","pos":"locution","exFr":"Je veux que tu restes.","ipa":"[vulwaʁ]","exAr":"أريدك أن تبقى."},{"fr":"être content que","ar":"سعيد بأن","pos":"locution","exFr":"Je suis content que tu sois là.","ipa":"[kɔ̃tɑ̃]","exAr":"سعيد بوجودك هنا."},{"fr":"important que","ar":"مهم أن","pos":"adj","exFr":"Il est important que tu comprennes.","ipa":"[ɛ̃pɔʁtɑ̃]","exAr":"مهم أن تفهم."},{"fr":"sans que","ar":"دون أن","pos":"locution","exFr":"Il part sans que je le sache.","ipa":"[sɑ̃ kə]","exAr":"يغادر دون أن أعلم."}],"grammar":[{"tFr":"Le subjonctif présent","tAr":"القاعدة: المضارع المنصوب","body":["التكوين من ils + نهايات e/es/e/ions/iez/ent؛ الشاذات: sois, aie, aille, fasse, puisse, sache.","المواقف: il faut que، الرغبة والمشاعر، الشك و bien que. استثناء: «je pense que» يبقى مضمراً في الإثبات."],"ex":[{"fr":"C'est bien qu'il ait réussi.","ar":"من الحسن أنه نجح."},{"fr":"Je doute qu'elle sache.","ar":"أشك أنها تعلم."}]}],"mistakes":[{"wrong":"Il faut que je partir","right":"Il faut que je parte","why":"بعد que مع فاعل مختلف يبقى المنصوب لا المصدر."},{"wrong":"Je pense qu'il vienne (في الإثبات)","right":"Je pense qu'il vient","why":"التفكير التأكيدي يبقى بالمضارع العادي."},{"wrong":"que je suis (مع être)","right":"que je sois","why":"être شاذة كلياً في المنصوب."},{"wrong":"bien qu'il a","right":"bien qu'il ait","why":"bien que تطلبه دائماً حتى مع avoir الشاذة."}],"dialogues":[{"title":"ترتيب مشترك","ctx":"زميلان يتشاوران قبل امتحان","lines":[{"who":"Rima","fr":"Il faut que j'étudie ce soir.","ar":"يجب أن أدرس هذا المساء."},{"who":"Adel","fr":"Moi aussi ! Je veux que tu m'aides d'abord.","ar":"وأنا أيضاً! أريدك أن تساعدني أولاً."},{"who":"Rima","fr":"D'accord, bien qu'il soit tard.","ar":"حسناً، رغم أنه متأخر."},{"who":"Adel","fr":"Tu crois que l'examen sera difficile ?","ar":"تظن أن الامتحان سيكون صعباً؟"},{"who":"Rima","fr":"Je ne pense pas qu'il soit très difficile.","ar":"لا أظن أنه صعب جداً."},{"who":"Adel","fr":"Ça me rassure ! Il faut que je commence.","ar":"هذا يريحني! يجب أن أبدأ."}]}],"exercises":[{"t":"mcq","skill":"grammar","q":"أكمل: «Il faut que tu ___ à l'heure.» (être)","opts":["es","sois","soit","seras"],"a":1,"why":"être في subjonctif: que tu sois."},{"t":"fill","skill":"grammar","q":"أكمل: «Je veux que tu ___ avec moi.» (venir)","fr":"Je veux que tu ___ avec moi.","ans":"viennes","why":"venir subjonctif: que tu viennes."},{"t":"mcq","skill":"grammar","q":"أي جملة صحيحة؟","opts":["Il faut partir que tu","Il faut que tu partes","Il faut que tu part","Il faut tu partir"],"a":1,"why":"subjonctif de partir = que tu partes."},{"t":"translate","skill":"writing","q":"ترجم: «يجب أن أذهب.»","ans":"Il faut que j'y aille.","alts":["il faut que j y aille","il faut que je parte"],"why":"aller في subjonctif: que j'aille."},{"t":"listen","skill":"listening","q":"استمع واختر سبب صياغة «finissions» بصيغة subjonctif:","audio":"Il faut que nous finissions avant six heures","opts":["بعد «il faut que» مع فاعل مختلف ← المنصوب","بعد «quand» في futur simple","مع passé composé وأفعال être","بديل عن المضارع المثبت فقط"],"a":0,"why":"il faut que تقتضي subjonctif: finir ← que nous finissions، لا «nous finissons»؛ فالفاعل بعد que مختلف عن فاعل الجملة."},{"t":"writing","skill":"writing","q":"اكتب 3 جمل subjonctif: il faut que / je veux que / c'est important que.","min":12,"kw":["que","faut"],"sample":"Il faut que j'étudie plus. Je veux que tu viennes à ma fête. C'est important que vous soyez ponctuels.","why":"الإنتاج الحر بعد il faut que و je veux que و c'est important que يثبت انتقالك من التمييز إلى الاستعمال، وهي المهارة التي تختبرها كتابة A2."},{"t":"mcq","skill":"grammar","q":"بعد «Je pense que» في الإثبات يبقى:","opts":["المضارع العادي","المنصوب","المستقبل","المصدر"],"a":0,"why":"التفكير التأكيدي يبقى مضمراً؛ الشك والرفض ينقلان للمنصوب."},{"t":"correct","skill":"writing","q":"صحّح: «Il faut que je vais au travail.»","ans":"aille","alts":["Aille"],"why":"après il faut que + sujet différent: subjonctif من aller = aille."}],"homework":"اكتب 6 جمل بـ il faut que عن قواعد بيتك أو عملك (يجب أن...).\nالدرس السابق/التالي: a2-t3-l5 (المقارنة والتفضيل) / a2-t4-l1 (عند الطبيب وفي البنك).","sources":[{"title":"متى نستعمل : le subjonctif présent","channel":"Le français avec Nabil","videoId":"3H3WUCQhJXE","why":"الدرس الأصعب: متى يُستعمل subjonctif — التركيز على المواضع لا التصريف فقط.","cat":"Grammar","level":"A2","main":true},{"title":"Subjonctif présent français - Formation","channel":"Parlez-vous FRENCH","videoId":"wdKogBCxACY","why":"درس مخصص لتكوين subjonctif فقط — عزل التكوين عن الاستخدام يجعله سهلاً قبل الدخول في المنطق.","cat":"Grammar","level":"A2","extra":true},{"title":"LE SUBJONCTIF EN FRANÇAIS / LEÇON COMPLÈTE (FREE PDF)","channel":"Français avec Nelly","videoId":"A2fcFeG6HWw","why":"درس كامل بأمثلة كثيرة وقائمة الأفعال التي تطلبه — مرجع شامل لموضوع الدرس بأكمله.","cat":"Grammar","level":"A2","extra":true},{"title":"Subjonctif en Français : Conjugaison 🤔","channel":"Français avec Pierre","videoId":"50wuiuvRBcQ","why":"بيير يغلق الحلقة: تصريف subjonctif مع أشهر التراكيب — تكرار أخير يرسخ الشواذ قبل التمارين.","cat":"Grammar","level":"A2","extra":true}],"supplements":[{"id":"wdKogBCxACY","title":"Subjonctif présent français - Formation","channel":"Parlez-vous FRENCH","why":"درس مخصص لتكوين subjonctif فقط — عزل التكوين عن الاستخدام يجعله سهلاً قبل الدخول في المنطق.","lang":"fr"},{"id":"A2fcFeG6HWw","title":"LE SUBJONCTIF EN FRANÇAIS / LEÇON COMPLÈTE (FREE PDF)","channel":"Français avec Nelly","why":"درس كامل بأمثلة كثيرة وقائمة الأفعال التي تطلبه — مرجع شامل لموضوع الدرس بأكمله.","lang":"fr"},{"id":"50wuiuvRBcQ","title":"Subjonctif en Français : Conjugaison 🤔","channel":"Français avec Pierre","why":"بيير يغلق الحلقة: تصريف subjonctif مع أشهر التراكيب — تكرار أخير يرسخ الشواذ قبل التمارين.","lang":"fr"}]}]},{"id":"a2-t4","slug":"conversation","icon":"🗣️","color":"#EA580C","fr":"Conversation","ar":"مسار المحادثة","desc":"الفرنسية الحية: مواقف الطبيب والبنك، دعوة صديق وتحديد موعد، والمكالمات الهاتفية — حوارات كاملة تشاهدها ثم تحاكيها.","lessons":[{"id":"A2-t4-l1","fr":"Chez le médecin, à la banque","ar":"عند الطبيب وفي البنك","objectives":["التعبير عن الألم والحالة الصحية","إجراءات البنك والصيدلية","طلب المساعدة في حالات الطوارئ"],"sections":[{"h":"عند الطبيب","p":["للتعبير عن الألم: J'ai mal à + جزء الجسم: J'ai mal à la tête (صداع)، au ventre (معدة)، aux dents (أسنان)، au dos (ظهر). لاحظ تغيّر حرف الجر مع le/la/les: à la، au (à+le)، aux (à+les) — القاعدة نفسها تظهر في كل جملة ألم.","الحوار الطبي القياسي قصير ومتوقع: «Qu'est-ce qui vous arrive ? — J'ai mal à la gorge depuis trois jours. — Vous avez de la fièvre ? — Un peu, 38 degrés.» احفظ السؤال-الجواب كوحدة واحدة — الاستقبال الجواب قبل السؤال يغنيك عن الترجمة في العيادة.","تابع الفيديو الأساسي بالشرح العربي: محادثة طبيب كاملة بالعربية والفرنسية، من الشكوى إلى الوصفة. لاحظ نبرة المريض القصيرة (Oui / Un peu / Depuis trois أيام) — الإجابة القصيرة مقبول ومعمول بها في الطب.","مفردات الحالة تُحفظ مع الأرقام: la fièvre (حرارة)، la toux (كحة)، le rhume (زكام)، une ordonnance (وصفة طبية)، la pharmacie (صيدلية). الأرقام تأتي مع الدرجة واليوم: 38 degrés، depuis trois jours.","في البنك: Je voudrais ouvrir un compte (أريد فتح حساب)، retirer de l'argent (سحب)، déposer (إيداع)، un virement (تحويل). وفي الصيدلية: Je voudrais quelque chose pour la toux، une ordonnance، sans ordonnance (بدون وصفة). نفس قالب Je voudrais يخدمك في المؤسسات كلها.","الطوارئ موقف أمان لغوي: أرقام فرنسا — 112 (طوارئ أوروبية)، 15 (إسعاف SAMU)، 17 (شرطة)، 18 (إطفاء). وعبارات: Au secours ! / Appelez un médecin ! / C'est urgent / J'ai besoin d'aide. أربع جمل قد تنقذ موقفك فعلياً — احفظها بصوت عالٍ لا بعينك."],"video":{"id":"t9vf6ORQdsU","title":"محادثة مع الطبيب || تعلم الفرنسية بسهولة للمبتدئين || تعلم الفرنسية بدون قواعد || فرنسي سهل","channel":"Français Rapidement","why":"محادثة طبيب كاملة بالعربية والفرنسية — تشمل الشكوى والوصفة والاستفسار كما في الدرس.","lang":"ar","main":true,"dur":15},"sub":[{"h":"قالب الألم: mal à + الجير","p":["J'ai mal à la tête / à la gorge.","J'ai mal au ventre / au dos / au bras.","J'ai mal aux dents / aux jambes.","Depuis combien de temps ? — Depuis trois jours."]},{"h":"البنك والصيدلية بـ Je voudrais","p":["Je voudrais ouvrir un compte. — فتح حساب.","Je voudrais retirer 100 euros. — سحب.","J'ai une ordonnance. — لدي وصفة.","Sans ordonnance, s'il vous plaît. — بدون وصفة."]},{"h":"الطوارئ: أرقام وعبارات","p":["112 — الطوارئ الأوروبية (كل اللغات).","15 — SAMU (إسعاف)، 17 — شرطة، 18 — إطفاء.","Au secours ! / Appelez un médecin !","C'est urgent. / J'ai besoin d'aide."]}]},{"h":"في البنك والصيدلية","p":["في البنك: Je voudrais ouvrir un compte (أريد فتح حساب)، retirer de l'argent (سحب مال)، déposer (إيداع)، un virement (تحويل).","في الصيدلية: Je voudrais quelque chose pour la toux (أريد شيئاً للكحة)، une ordonnance (وصفة)، sans ordonnance (بدون وصفة).","في الصيدلية، لاحظ سؤال الصيدلي: «Avec ou sans ordonnance ?» — إجابة واحدة تكفي: «Avec, la voici» أو «Sans, si possible». الردود القصيرة ملك هذه المواقف."],"video":null},{"h":"الطوارئ","p":["أرقام مهمة في فرنسا: 112 (طوارئ أوروبية)، 15 (إسعاف SAMU)، 17 (شرطة)، 18 (إطفاء).","عبارات أساسية: Au secours ! (النجدة!)، Appelez un médecin ! (اتصلوا بطبيب!)، C'est urgent (إنه طارئ)، J'ai besoin d'aide (أحتاج مساعدة).","بعد الفيديو، اكتب وصفتك الافتراضية بجملتين: الأعراض ثم ما تطلبه من الصيدلي. الكتابة القصيرة المستهدفة تثبت المفردات في مكانها الصحيح."],"video":null},{"h":"التطبيق والتلخيص","p":["يُختم هذا الدرس بحزمة الطبيب والبنك والصيدلية: فالألم يُبنى بـ avoir mal à مع تغيّر حرف الجر مع المعدّد (à la tête، au ventre، aux dents)، والحالة الصحية تُسأل وتُجاب بـ de la fièvre، والصيدلية تعمل بـ une ordonnance و sans ordonnance، والبنك بـ Je voudrais ouvrir un compte و retirer de l'argent و déposer، ثم تُغلق الحزمة بأرقام الطوارئ الفرنسية: 112 الطوارئ الأوروبية، 15 إسعاف SAMU، 17 شرطة، 18 إطفاء، مع عبارات لا تُؤجَّل حفظها: Au secours ! و Appelez un médecin ! و C'est urgent. كما وضح الفيديو الرئيسي «محادثة مع الطبيب || تعلم الفرنسية بسهولة للمبتدئين || تعلم الفرنسية بدون قواعد || فرنسي سهل» من قناة Français Rapidement على الرابط https://www.youtube.com/watch?v=t9vf6ORQdsU، تسير الشكوى والوصفة والاستفسار في قالب واحد متسلسل، وأن صيغة Je voudrais مفتاح كل مؤسسة فرنسية من عيادة إلى بنك.","بهذا تدخل سلسلة المواقف الحياتية في المستوى A2 من باب الطبيب: فلقد أغلق a2-t3-l6 الباب النحوي الأثقل (subjonctif: Il faut que tu prennes rendez-vous)، ثم يفتح a2-t4-l1 محوّر المحادثة بثلاثة مواقف متّصلة — الطبيب والبنك والصيدلية — وهي المرحلة التي تسبق دعوات a2-t4-l2 (être libre، avec plaisir، Ça te dit) وتلفون a2-t4-l3 (C'est... à l'appareil، laisser un message، prendre rendez-vous)، فتصل بكلّ منها إلى أبواب الاستماع a2-t5-l1 ثم a2-t5-l2 ثم a2-t5-l3 حيث تُختبر مفردات هذه المواقف في نصوص مسموعة حقيقية، وينتهي المحور بباب الكتابة a2-t6-l1 الذي يصف الأشخاص والأماكن بلغة تجمع ما تقدّمه هذه الدروس الثلاثة.","المهمة التطبيقية: أعد مشاهدة الفيديو الرئيسي كاملًا وأوقفه عند كل شكوى واكتب جملة الألم بحرف الجر الصحيح؛ ثم سجّل نفسك في مكالمة عيادة من ست جمل مسموعة: تبدأ بالتحية، فتشتكي بـ J'ai mal... مع المدة (depuis...)، فتُجيب عن سؤال de la fièvre، ثم تطلب موعدًا وتُغلق بالوداع. استمع إلى تسجيلك وصحّح حرف الجر قبل أي خطأ آخر؛ فمن تتقن à la و au و aux في جملة الألم تتقنها في كل موقف لاحق."]}],"examples":[{"fr":"J'ai mal à la tête.","ar":"عندي صداع."},{"fr":"Je voudrais retirer de l'argent.","ar":"أريد سحب مال."},{"fr":"C'est urgent ! Appelez le 15 !","ar":"إنه طارئ! اتصلوا بـ 15!"},{"fr":"Vous avez une ordonnance ?","ar":"هل لديك وصفة؟"},{"fr":"J'ai mal à la gorge depuis trois jours.","ar":"عندي ألم في الحلق منذ ثلاثة أيام.","note":"mal à + depuis"},{"fr":"Vous avez de la fièvre ?","ar":"هل لديك حرارة؟","note":"سؤال الطبيب"},{"fr":"Je voudrais retirer cent euros.","ar":"أريد سحب مئة يورو.","note":"البنك"},{"fr":"C'est urgent, appelez le 15 !","ar":"إنه طارئ، اتصل بالـ 15!","note":"الطوارئ"}],"pron":[{"w":"J'ai mal","ipa":"[ʒe.mal]","approx":"جيه-مال"},{"w":"la fièvre","ipa":"[la.fjɛvʁ]","approx":"لافيفر"},{"w":"une ordonnance","ipa":"[yn.ɔʁ.dɔ.nɑ̃s]","approx":"أون-أوردونانس"}],"vocab":[{"fr":"avoir mal à","ar":"يشعر بألم في","pos":"expression","ipa":"[a.vwaʁ mal a]","exFr":"J'ai mal au dos.","exAr":"عندي ألم في الظهر."},{"fr":"la fièvre","ar":"الحرارة","pos":"nom","g":"f","ipa":"[fjɛvʁ]","exFr":"Il a de la fièvre.","exAr":"عنده حرارة."},{"fr":"une ordonnance","ar":"وصفة طبية","pos":"nom","g":"f","pl":"des ordonnances","ipa":"[ɔʁ.dɔ.nɑ̃s]","exFr":"Voici votre ordonnance.","exAr":"هذه وصفة طبيتك."},{"fr":"retirer de l'argent","ar":"يسحب مالاً","pos":"expression","ipa":"[ʁə.ti.ʁe de.laʁ.ʒɑ̃]","exFr":"Je veux retirer 200 euros.","exAr":"أريد سحب 200 يورو."},{"fr":"au secours","ar":"النجدة","pos":"expression","ipa":"[o.sə.kuʁ]","exFr":"Au secours, à l'aide !","exAr":"النجدة، النجدة!"},{"fr":"la pharmacie","ar":"الصيدلية","pos":"nom","g":"f","pl":"les pharmacies","ipa":"[faʁ.ma.si]","exFr":"La pharmacie est ouverte.","exAr":"الصيدلية مفتوحة."},{"fr":"le rendez-vous","ar":"الموعد","pos":"nom","g":"m","exFr":"Je voudrais prendre rendez-vous.","ipa":"[ʁɑ̃dəvu]","exAr":"أريد حجز موعد."},{"fr":"un compte","ar":"حساب","pos":"nom","g":"m","exFr":"Ouvrir un compte en banque.","ipa":"[kɔ̃t]","exAr":"فتح حساب بنكي."},{"fr":"urgent(e)","ar":"طارئ","pos":"adj","exFr":"C'est urgent, docteur !","ipa":"[yʁʒɑ̃]","exAr":"إنه طارئ يا دكتور!"},{"fr":"le médecin","ar":"الطبيب","pos":"nom","g":"m","exFr":"Appelez un médecin !","ipa":"[mədəsɛ̃]","exAr":"اتصلوا بطبيباً!"}],"grammar":[{"tFr":"Les prépositions de lieu avec l'appartenance","tAr":"القاعدة: à + le/la/les = au/aux","body":["à + le = au، à + les = aux، في الأجزاء: au ventre، aux dents — القاعدة نفسها في كل جملة ألم.","de + le = du، de + les = des: de la fièvre (بلا حرارة)، du repos (راحة)."],"ex":[{"fr":"J'ai mal aux jambes.","ar":"عندي ألم في الساقين."},{"fr":"Il a besoin d'un médicament.","ar":"يحتاج إلى دواء."}]}],"mistakes":[{"wrong":"J'ai mal en la tête","right":"J'ai mal à la tête","why":"أجزاء الجسم مع à وليس en."},{"wrong":"J'ai la fièvre (بلا أداة)","right":"J'ai de la fièvre","why":"الحالة الصحية بـ de la."},{"wrong":"15 و 112 و 17 كلها للإسعاف","right":"15 إسعاف / 17 شرطة / 112 أوروبية","why":"خلط الأرقام يؤخر الإسعاف الفعلي — احفظها منفصلة."},{"wrong":"retirer l'argent (بلا de)","right":"retirer de l'argent (للكمية)","why":"سحب المال بكمية مجهولة يأخذ de l'."}],"dialogues":[{"title":"حوار الصيدلية","ctx":"زبون بلا وصفة","lines":[{"who":"Pharmacien","fr":"Bonjour, je peux vous aider ?","ar":"مرحباً، هل يمكنني مساعدتك؟"},{"who":"Le client","fr":"Bonjour, j'ai mal à la tête et un peu de fièvre.","ar":"مرحباً، عندي صداع وحرارة قليلاً."},{"who":"Pharmacien","fr":"Avec ou sans ordonnance ?","ar":"مع وصفة أم بدون؟"},{"who":"Le client","fr":"Sans, si possible. C'est urgent, je travaille.","ar":"بدون إن أمكن. إنه طارئ، أعمل."},{"who":"Pharmacien","fr":"Voici un antipyrétique. Prenez deux comprimés par jour.","ar":"تفضل مسكن حرارة. خذ قرصين يومياً."},{"who":"Le client","fr":"D'accord. Ça coûte combien ?","ar":"حسناً. بكم؟"}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"«عندي صداع» بالفرنسية:","opts":["J'ai mal à la tête","J'ai la tête mal","Ma tête fait mal","Je suis mal tête"],"a":0,"why":"avoir mal à + جزء الجسم."},{"t":"fill","skill":"vocabulary","q":"أكمل: «J'ai mal ___ gorge.»","fr":"J'ai mal ___ gorge.","ans":"à la","alts":["a la"],"why":"gorge مؤنث: à la gorge."},{"t":"translate","skill":"writing","q":"ترجم: «أريد سحب مال.»","ans":"Je voudrais retirer de l'argent.","alts":["je voudrais retirer de l argent","je veux retirer de l argent"],"why":"قالب البنك المكتمل: Je voudrais المهذبة + retirer de l'argent بـ de l' للكمية المجهولة."},{"t":"listen","skill":"listening","q":"استمع وسؤال الطبيب واختره:","audio":"Qu'est-ce qui vous arrive ?","opts":["ماذا حدث لك؟","كم عمرك؟","هل تناولت الدواء؟","أين تؤلمك؟"],"a":0,"why":"«Qu'est-ce qui vous arrive ?» هو سؤال الطبيب الافتتاحي، وجوابه الشكوى بـ J'ai mal à."},{"t":"mcq","skill":"vocabulary","q":"رقم الإسعاف في فرنسا:","opts":["17","18","15","112 فقط"],"a":2,"why":"15 = SAMU الإسعاف، 112 الطوارئ الأوروبية."},{"t":"speaking","skill":"speaking","q":"اشكُ عند الطبيب: «عندي ألم في البطن منذ يومين».","target":"J'ai mal au ventre depuis deux jours","why":"المهمة تجمع mal au ventre مع منذ يومين: J'ai mal au ventre depuis deux jours."},{"t":"mcq","skill":"speaking","q":"أجزاء الجسم مع avoir mal تُأخذ بـ:","opts":["à (à la tête / au ventre / aux dents)","en","de","pour"],"a":0,"why":"mal à + جزء الجسم قاعدة ثابتة مع تغيّر حرف الجر."},{"t":"fill","skill":"speaking","q":"أكمل: «J'ai mal ___ dents.» (الأسنان)","fr":"J'ai mal ___ dents.","ans":"aux","alts":["Aux"],"why":"à + les = aux مع جمع الأجزاء."}],"homework":"اكتب حواراً كاملاً في الصيدلية (8 أسطر): الأعراض، السؤال، الدواء، والسعر. الدرس السابق/التالي: a2-t3-l6 (مقدمة المضارع المنصوب subjonctif) / a2-t4-l2 (الدعوات والمواعيد).","sources":[{"title":"محادثة مع الطبيب || تعلم الفرنسية بسهولة للمبتدئين || تعلم الفرنسية بدون قواعد || فرنسي سهل","channel":"Français Rapidement","videoId":"t9vf6ORQdsU","why":"محادثة طبيب كاملة بالعربية والفرنسية — تشمل الشكوى والوصفة والاستفسار كما في الدرس.","cat":"Conversation","level":"A2","main":true},{"title":"French Lesson 78 - At the doctor's Chez le médecin Health Dialogue","channel":"YouLearnFrench","videoId":"0xv_5Pqd89w","why":"حوار طبي مرئي كامل بعبارات مكتوبة على الشاشة — النموذج المثالي للاستماع والتقليد الجماعي.","cat":"Conversation","level":"A2","extra":true},{"title":"Chez le médecin. 2 dialogues pour la production orale du DELF A2. 😍","channel":"La prof Elisabeth","videoId":"LHpGwB5lZPA","why":"حواران بمستوى DELF A2 بالضبط — نفس شكل المواقف التي ستواجهها في الامتحان وفي العيادة الحقيقية.","cat":"Conversation","level":"A2","extra":true},{"title":"French Conversation at the Hospital | Conversation en Français à l'hôpital","channel":"CCube Academy","videoId":"T1KnLJAHRx4","why":"محادثة في المستشفى بمشاهد حقيقية — يعرض الردود السريعة التي تحتاجها حين يكون الوقت ضيقاً.","cat":"Conversation","level":"A2","extra":true}],"supplements":[{"id":"0xv_5Pqd89w","title":"French Lesson 78 - At the doctor's Chez le médecin Health Dialogue","channel":"YouLearnFrench","why":"حوار طبي مرئي كامل بعبارات مكتوبة على الشاشة — النموذج المثالي للاستماع والتقليد الجماعي.","lang":"fr"},{"id":"LHpGwB5lZPA","title":"Chez le médecin. 2 dialogues pour la production orale du DELF A2. 😍","channel":"La prof Elisabeth","why":"حواران بمستوى DELF A2 بالضبط — نفس شكل المواقف التي ستواجهها في الامتحان وفي العيادة الحقيقية.","lang":"fr"},{"id":"T1KnLJAHRx4","title":"French Conversation at the Hospital | Conversation en Français à l'hôpital","channel":"CCube Academy","why":"محادثة في المستشفى بمشاهد حقيقية — يعرض الردود السريعة التي تحتاجها حين يكون الوقت ضيقاً.","lang":"fr"}]},{"id":"A2-t4-l2","fr":"Invitations et rendez-vous","ar":"الدعوات والمواعيد","objectives":["دعوة صديق بلغة طبيعية","قبول الدعوة ورفضها بأدب مع ذكر سبب","تحديد الموعد (اليوم، الساعة، المكان)"],"sections":[{"h":"دعوة صديق: النموذج الكامل","p":["دعوة بسيطة تُبنى بثلاث خطوات: التعليق الافتتاحي (Tu es libre samedi ? / Ça te dit de...؟) ثم الموضوع (un café / un film / un resto) ثم التفصيل (à quelle heure ? où ?). ثلاث خطوات تغطي كل دعوة يومية.","عبارات الدعوة الأشهر: «Ça te dit de manger ensemble ?» (ما رأيك أن نأكل معاً؟)، «Je t'invite au cinéma» (أدعوك للسينما)، «On se retrouve à 18h ?» (نتقابل في السادسة؟). اختَر واحدة وألقِها بصوت طبيعي — النبرة تصنع الفرق أكثر من الاختيار.","تابع الفيديو الأساسي بالشرح العربي: دعوة كاملة من الافتتاح إلى التأكيد مبنية بالعربية ثم بالفرنسية. لاحظ أن الفرنسيين يبدؤون غالبًا بسؤال استطلاع (libre ?) قبل العرض — الترقّب جزء من الأدب.","القبول سهل: «Avec plaisir !» (بكل سرور)، «Bonne idée !» (فكرة جيدة)، «D'accord, à samedi !» (اتفقنا، إلى السبت). ثلاث جمل تُغلق أي دعوة إيجابياً في ثانية.","الرفض المُهذّب له قالب ذهبي: اعتذار + سبب + بديل: «Désolé(e), je ne peux pas, j'ai cours. On peut faire ça dimanche ?». لا ترفض أبداً بلا سبب ولا بلا بديل — يبدو بارداً بالفرنسية، والبارد في الدعوة يؤجّل الدعوات القادمة.","الموعد يحتاج ثلاث معلومات مرتبة: اليوم (samedi prochain) ثم الساعة (à 18h) ثم المكان (devant le cinéma). حوّلها إلى سؤال واحد جاهز: «Samedi prochain à 18h devant le cinéma, ça marche ?» — وعبارة «ça marche» (هل ينفع؟) هي خاتمة كل تفاوض يومي."],"video":{"id":"3cXr9mU9rGg","title":"تعلم اللغة الفرنسية: كيف تدعو شخص بالفرنسية/ قبول او رفض الدعوة بالفرنسية","channel":"Français  parfait","why":"كيفية الدعوة والقبول والرفض بعبارات جاهزة بالعربية — يغطي محورَي النموذج والرفض بأدب.","lang":"ar","main":true,"dur":12},"sub":[{"h":"خطوات الدعوة الثلاث","p":["الاستطلاع: Tu es libre samedi ? / Ça te dimanche ?","الموضوع: Ça te dit de... ? / Je t'invite à...","التفصيل: à quelle heure ? où ? / On se retrouve à... ?"]},{"h":"القبول والرفض","p":["القبول: Avec plaisir ! / Bonne idée ! / D'accord !","الرفض: Désolé, je ne peux pas + سبب.","البديل (إلزامي): On peut faire ça dimanche ?","التثبيت: C'est noté ! / À samedi !"]},{"h":"حزمة الموعد","p":["اليوم: samedi prochain / mardi soir.","الساعة: à 18h / vers 20h.","المكان: devant le cinéma / chez moi.","السؤال الكامل: ..., ça marche ?"]}]},{"h":"قبول ورفض بأدب","p":["القبول سهل: «Avec plaisir !» (بكل سرور)، «Bonne idée !» (فكرة جيدة)، «D'accord, à samedi !» (اتفقنا، إلى السبت).","الرفض المُهذب له قالب ذهبي: اعتذار + سبب + بديل: «Désolé(e), je ne peux pas, j'ai cours. On peut faire ça dimanche ?» (آسف لا أستطيع، عندي درس. يمكننا ذلك الأحد؟). لا ترفض أبداً بلا سبب ولا بلا بديل — يبدو بارداً بالفرنسية.","لاحظ «Ça te dit» تُجاب بـ «Oui, ça me dit !» أو «Ça ne me dit pas trop» — نمط السؤال يتزامن مع نمط الجواب، فاحفظهما معًا كتوأم."],"video":null},{"h":"تحديد الموعد بدقة","p":["الموعد يحتاج ثلاث معلومات مرتبة: اليوم (samedi prochain — السبت القادم) ثم الساعة (à 18h — الثامنة مساءً) ثم المكان (devant le cinéma — أمام السينما). حوّل هذه الثلاثة إلى سؤال جاهز: «Samedi prochain à 18h devant le cinéma, ça marche ?».","عبارات التثبيت: «C'est noté !» (سُجّل!)، «Je t'envoie un message pour confirmer» (سأرسل لك رسالة للتأكيد)، «À samedi alors !» (إلى السبت إذن!).","أوقف الفيديو الإثرائي عند كل دعوة واكتب ردك أنت خلال 5 ثوانٍ — قبول أو رفض ببديل. سرعة الرد الافتراضية هي التمرين الحقيقي لهذه المهارة."],"video":null},{"h":"التطبيق والتلخيص","p":["يُختم هذا الدرس بحزمة الدعوة الكاملة: فدعوة الصديق تُبنى بثلاث خطوات — استطلاع (Tu es libre samedi ?) ثم عرض (Ça te dit de... / Je t'invite...) ثم تفصيل الموعد (à quelle heure ? où ?) — ويُقبل بـ Avec plaisir ! و Bonne idée ! و D'accord، ويُرفض بأدب بقالب لا يُكسر: اعتذار + سبب + بديل (Désolé, je ne peux pas, j'ai cours. On peut faire ça dimanche ؟)، ثم يُثبَّت الموعد بثلاث معلومات: اليوم (samedi prochain)، الساعة (à 18h)، المكان (devant le cinéma) مع خاتمة كل تفاوض يومي: ça marche ؟. كما وضح الفيديو الرئيسي «تعلم اللغة الفرنسية: كيف تدعو شخص بالفرنسية/ قبول او رفض الدعوة بالفرنسية» من قناة Français  parfait على الرابط https://www.youtube.com/watch?v=3cXr9mU9rGg، تأتي الدعوة دائمًا بعد سؤال استطلاع، وأن الرفض بلا سبب وبديل يُقرأ باردًا في الفرنسية.","بهذا تتوسّل محوّر المحادثة في المستوى a2-t4: فبعد أن أعطاك a2-t4-l1 لغة العيادة والبنك (avoir mal à، une ordonnance، retirer de l'argent)، تنتقل a2-t4-l2 إلى لغة العلاقات: كيف تقترح (proposer، Ça te dit de...) وكيف تقبل (avec plaisir) وكيف ترفض بظرف مقبول (un empêchement، j'ai cours) — وكلّه يستند إلى الباب النحوي الذي أتقنته في a2-t3-l6 (Je veux que tu viennes). وبعدها يأتي a2-t4-l3 حيث ينتقل الموعد نفسه من الدعوة الودّية إلى المكالمة (prendre rendez-vous au téléphone)، ثم تختبر مفرداتك في a2-t5-l1 و a2-t5-l2 و a2-t5-l3 حيث تُسمع الدعوات والمواعيد في حوارات ونشرات وأغانٍ حقيقية، وصولًا إلى a2-t6-l1 الذي يصف أصدقاءك وأماكن لقائكم بلغة أدق.","المهمة التطبيقية: أعد مشاهدة الفيديو الرئيسي وأوقفه عند كل دعوة واكتب ردك خلال خمس ثوانٍ — قبول أو رفض ببديل؛ ثم سجّل نفسك في دعوة كاملة من ست جمل مسموعة: استطلاع الحرية، عرض النشاط، اقتراح اليوم والساعة والمكان، ثم صيغة الاختتام ça marche ؟. استمع إلى تسجيلك وراجع هل احترمت ثلاثية الموعد (اليوم، الساعة، المكان)؛ فنقص أي عنصر يفتح اتصالًا تاليًا للتأكيد."]}],"examples":[{"fr":"Tu es libre samedi ?","ar":"هل أنت حر السبت؟"},{"fr":"Ça te dit d'aller au cinéma ?","ar":"ما رأيك أن نذهب للسينما؟"},{"fr":"Désolé, j'ai cours. On peut dimanche ?","ar":"آسف، عندي درس. يمكن الأحد؟"},{"fr":"À 18h devant le cinéma !","ar":"في السادسة أمام السينما!"},{"fr":"Ça te dit de dîner ensemble ?","ar":"ما رأيك أن نتعشى معاً؟","note":"دعوة"},{"fr":"Avec plaisir ! À quelle heure ?","ar":"بكل سرور! في أي ساعة؟","note":"قبول"},{"fr":"Désolée, j'ai cours. Dimanche ?","ar":"آسفة، عندي درس. الأحد؟","note":"رفض + بديل"},{"fr":"On se retrouve devant la gare.","ar":"نلتقي أمام المحطة.","note":"الموعد"}],"pron":[{"w":"ça te dit ?","ipa":"[sa.tə.di]","approx":"سا-تو-دي","note":"ما رأيك؟ (دعوة غير رسمية)"},{"w":"avec plaisir","ipa":"[a.vɛk.plɛ.ziʁ]","approx":"اڤيك-بليزير"},{"w":"désolé(e)","ipa":"[de.zɔ.le]","approx":"ديزوليه"}],"vocab":[{"fr":"être libre","ar":"يكون حرّاً","pos":"expression","ipa":"[ɛtʁ li.bʁ]","exFr":"Tu es libre ce soir ?","exAr":"هل أنت حر الليلة؟"},{"fr":"ça te dit de...","ar":"ما رأيك أن...","pos":"expression","ipa":"[sa.tə.di də]","exFr":"Ça te dit de sortir ?","exAr":"ما رأيك أن نخرج؟"},{"fr":"avec plaisir","ar":"بكل سرور","pos":"expression","ipa":"[a.vɛk.plɛ.ziʁ]","exFr":"Tu viens ? — Avec plaisir !","exAr":"أتأتي؟ — بكل سرور!"},{"fr":"proposer","ar":"يقترح","pos":"verbe","g":"1er","ipa":"[pʁɔ.po.ze]","exFr":"Je propose un film samedi.","exAr":"أقترح فيلماً السبت."},{"fr":"un rendez-vous","ar":"موعد","pos":"nom","g":"m","pl":"des rendez-vous","ipa":"[ʁɑ̃.de.vu]","exFr":"J'ai un rendez-vous à 18h.","exAr":"عندي موعد في السادسة."},{"fr":"annuler","ar":"يلغي","pos":"verbe","ipa":"[a.ny.le]","exFr":"Je dois annuler, désolé.","exAr":"يجب أن ألغي، آسف."},{"fr":"ça te dit ?","ar":"ما رأيك؟","pos":"locution","exFr":"Un café, ça te dit ?","ipa":"[sa tə di]","exAr":"قهوة، ما رأيك؟"},{"fr":"désolé(e)","ar":"آسف/آسفة","pos":"adj","exFr":"Désolé, je ne peux pas.","ipa":"[dezɔle]","exAr":"آسف، لا أستطيع."},{"fr":"un empêchement","ar":"عذر / ظرف طارئ","pos":"nom","g":"m","pl":"des empêchements","ipa":"[ɑ̃.pɛʃ.mɑ̃]","exFr":"J'ai un empêchement, désolé.","exAr":"لدي ظرف طارئ، آسف."},{"fr":"se retrouver","ar":"يلتقي","pos":"verbe","g":"—","exFr":"On se retrouve à 18h ?","ipa":"[sə tʁətruve]","exAr":"نلتقي الساعة السادسة؟"},{"fr":"libre / occupé","ar":"متاح / مشغول","pos":"adj","exFr":"Désolé, je suis occupé.","ipa":"[libʁ]","exAr":"آسف، أنا مشغول."}],"grammar":[{"tFr":"Inviter, accepter, refuser","tAr":"القاعدة: قوالب الدعوة والقبول والرفض","body":["الدعوة: Ça te dire de + inf. / Je t'invite à + nom. القبول: Avec plaisir. الرفض: Désolé + سبب + بديل.","سؤال الموعد: ((اليوم + الساعة + المكان), ça marche ?) — الوحدة الثلاثية لا تُكسر."],"ex":[{"fr":"On se voit demain soir ?","ar":"نرى غداً مساءً؟"},{"fr":"Je suis désolé, je ne peux pas.","ar":"أنا آسف، لا أستطيع."}]}],"mistakes":[{"wrong":"Je ne peux pas. (وحدها)","right":"Je ne peux pas, j'ai cours. + بديل","why":"الرفض بلا سبب أو بديل يبدو بارداً وغير مهذّب."},{"wrong":"refuser بـ non مباشرة","right":"Désolé(e)... / Ça ne m'arrange pas","why":"«Non» الجاف نادر في الرفض — الاعتذار أولًا."},{"wrong":"خلط ça te dit مع ça vous plaît","right":"ça te dit = ما رأيك في العرض","why":"الأولى دعوة بين مألوفين، والثانية طلب تواضع."},{"wrong":"موعد بلا مكان","right":"اليوم + الساعة + المكان","why":"أي نقص يفتح اتصالاً تالياً للتأكيد — وقّت جهدك."}],"dialogues":[{"title":"دعوة سينما","ctx":"رسالة بين صديقين","lines":[{"who":"Lina","fr":"Salut Mehdi ! Tu es libre samedi soir ?","ar":"أهلاً مهدي! هل أنت متاح السبت مساءً؟"},{"who":"Mehdi","fr":"Je pense oui. Ça te dit quoi ?","ar":"أعتقد نعم. ماذا تقترحين؟"},{"who":"Lina","fr":"Un film au cinéma, ça te dit ?","ar":"فيلم في السينما، ما رأيك؟"},{"who":"Mehdi","fr":"Avec plaisir ! À quelle heure ?","ar":"بكل سرور! في أي ساعة؟"},{"who":"Lina","fr":"À dix-huit heures, devant le cinéma.","ar":"الساعة السادسة، أمام السينما."},{"who":"Mehdi","fr":"Parfait, c'est noté. À samedi !","ar":"ممتاز، سُجّل. إلى السبت!"}]}],"exercises":[{"t":"mcq","skill":"conversation","q":"أفضل طريقة لرفض دعوة بأدب:","opts":["Non.","Non merci, je ne veux pas.","Désolé, je ne peux pas, j'ai cours. Et dimanche ?","Je refuse votre invitation."],"a":2,"why":"القالب الذهبي: اعتذار + سبب + بديل."},{"t":"mcq","skill":"conversation","q":"صديق يقول: «Ça te dit d'aller au resto ?» — ماذا يعني؟","opts":["ما رأيك أن نذهب للمطعم؟","هل قال لك المطعم؟","أين المطعم؟","متى نأكل؟"],"a":0,"why":"ça te dit de + مصدر = دعوة غير رسمية."},{"t":"fill","skill":"conversation","q":"أكمل الموعد: «On se retrouve ___ 18h ___ le cinéma.» (في السادسة أمام السينما)","fr":"On se retrouve ___ 18h ___ le cinéma.","ans":"à devant","alts":["a devant"],"why":"à للساعة و devant للمكان."},{"t":"translate","skill":"writing","q":"ترجم: «هل أنت حر السبت؟»","ans":"Tu es libre samedi ?","alts":["tu es libre le samedi"],"why":"être libre للسؤال عن الحرية في موعد."},{"t":"order","skill":"conversation","q":"رتّب حوار الدعوة: (القبول، الدعوة، الموعد)","words":["Ça","te","dit","de","sortir","?"],"ans":"Ça te dit de sortir ?","why":"الكلمات ترتّب كما تُقال فعلًا: اسم الدعوة أولًا ثم التفصيل، بلا تغيير في الصيغة."},{"t":"speaking","skill":"speaking","q":"ادعُ صديقاً للمقهى صوتياً: «ما رأيك أن نذهب للمقهى غداً؟»","target":"Ça te dit d'aller au café demain ?","why":"الدعوة الكاملة: Ça te dit de + مصدر + ظرف الزمان demain — ثلاثية لا تُكسر."},{"t":"mcq","skill":"speaking","q":"الرفض المهذّب في الدعوة يتكوّن من:","opts":["اعتذار + سبب + بديل","رفض مباشر","صمت","نقل الموضوع"],"a":0,"why":"البديل يُبقي الحوار مفتوحاً ويُظهر الأدب."},{"t":"order","skill":"speaking","q":"رتّب خطوات الموعد: (1) الساعة (2) اليوم (3) المكان","words":["Mardi","à","18h,","devant","la gare."],"ans":"Mardi à 18h, devant la gare.","why":"اليوم ← الساعة ← المكان ترتيب الموعد الفرنسية."}],"homework":"ادعُ صديقاً حقيقياً (بالفرنسية في رسالة): دعوة + موعد مقترح، ثم اكتب ردَّه المتوقع بالقبول أو الرفض المُهذب. الدرس السابق/التالي: a2-t4-l1 (عند الطبيب وفي البنك) / a2-t4-l3 (المكالمات الهاتفية).","sources":[{"title":"تعلم اللغة الفرنسية: كيف تدعو شخص بالفرنسية/ قبول او رفض الدعوة بالفرنسية","channel":"Français  parfait","videoId":"3cXr9mU9rGg","why":"كيفية الدعوة والقبول والرفض بعبارات جاهزة بالعربية — يغطي محورَي النموذج والرفض بأدب.","cat":"Conversation","level":"A2","main":true},{"title":"🇲🇫 French Animated Dialogue 06 - Inviter quelqu'un","channel":"Français Facile - Easy French","videoId":"i32M6iqDa6E","why":"حوار متحرك كامل عن دعوة شخص — التشخيص يجعل من يستوعب موقف الدعوة كاملاً: الدعوة، السؤال، الرد.","cat":"Conversation","level":"A2","extra":true},{"title":"parler le français facilement : Inviter à une sortie","channel":"Language for everyone","videoId":"XnuakxHKqKY","why":"حوار خروج آخر من زاوية مختلفة — يعرض طرق قبول الرفض المُهذب والعذور الواقعية.","cat":"Conversation","level":"A2","extra":true},{"title":"Les Meilleures Façons de Proposer une Sortie en Français | Podcast Facile","channel":"Parle Français Channel","videoId":"CTtOUXqv_O8","why":"بودكاست يجمع أفضل صيغ دعوة الخروج مفصولة بسرعة مريحة — مادة إثرائية تتضمن صيغاً رسمية وغير رسمية.","cat":"Conversation","level":"A2","extra":true}],"supplements":[{"id":"i32M6iqDa6E","title":"🇲🇫 French Animated Dialogue 06 - Inviter quelqu'un","channel":"Français Facile - Easy French","why":"حوار متحرك كامل عن دعوة شخص — التشخيص يجعل من يستوعب موقف الدعوة كاملاً: الدعوة، السؤال، الرد.","lang":"fr"},{"id":"XnuakxHKqKY","title":"parler le français facilement : Inviter à une sortie","channel":"Language for everyone","why":"حوار خروج آخر من زاوية مختلفة — يعرض طرق قبول الرفض المُهذب والعذور الواقعية.","lang":"fr"},{"id":"CTtOUXqv_O8","title":"Les Meilleures Façons de Proposer une Sortie en Français | Podcast Facile","channel":"Parle Français Channel","why":"بودكاست يجمع أفضل صيغ دعوة الخروج مفصولة بسرعة مريحة — مادة إثرائية تتضمن صيغاً رسمية وغير رسمية.","lang":"fr"}]},{"id":"A2-t4-l3","fr":"Au téléphone","ar":"المكالمات الهاتفية","objectives":["الإجابة على الهاتف والتعريف بنفسك","طلب التحدث إلى شخص وتركيه رسالة","حجز موعد هاتفياً بأدب"],"sections":[{"h":"قالب المكالمة من الرد إلى الوداع","p":["المكالمة الفرنسية لها قالب ثابت: الرد (Allô ?)، التعريف (C'est Karim à l'appareil / Ici Karim)، السبب (Je vous appelle parce que...)، ثم الطلب، ثم الوداع (Merci, au revoir !). خمس خطوات تُحفظ مرة وتُستعمل طوال حياتك الهاتفية.","الفرق المهم: للهاتف نستخدم C'est... (هو كريم) وليس Il est... — «C'est Karim» هو القاعدة، و«Ici...» لغير الرسمية. هذا الفرق الصغير يكشف مَن يفهم القالب من يترجم حرفيًا.","تابع الفيديو الأساسي بالشرح العربي: أهم جمل المكالمة تُبنى واحدة تلو الأخرى بالعربية ثم الفرنسية. لاحظ نبرة البداية الصاعدة في Allô ? — النبرة نفسها تقول «هل أحد هناك؟» قبل الكلمة.","طلب شخص: «Est-ce que je pourrais parler à Mme Dupont, s'il vous plaît ?» والرد الاستقصائي: «C'est de la part de qui ?» (من يتصل؟). الرد جاهز: «C'est de la part de Karim» — احفظ الزوجين معًا.","تركية رسالة: «Elle n'est pas là. Vous voulez laisser un message ?» — «Oui, dites-lui que j'ai appelé et que je rappellerai demain.» لاحظ que المزدوجة: dites-lui que (قل لها أن...) + je rappellerai (فعلك أنت) — جملة واحدة تحمل النقل والتوكيد معاً.","حجز موعد بالهاتف قالبه: «Bonjour, je voudrais prendre rendez-vous. — Pour quel jour ? — Mardi matin, si possible. — C'est possible à 10h. — Parfait, c'est noté.» وعند ضعف الصوت: «Vous pouvez répéter ?» و«Il y a du bruit» و«Je vous rappelle plus tard» — ثلاث جمل طوارئ تُخرجك من أي مكالمة سيئة."],"video":{"id":"oFZigJJPK2w","title":"كيف تتكلم بالفرنسية في الهاتف: أهم الجمل اليومية","channel":"تعلم مع ليلى Learn with Layla","why":"أهم جمل المكالمة الهاتفية بالعربية — القالب الكامل من الرد إلى الوداع في ثمان دقائق.","lang":"ar","main":true,"dur":8},"sub":[{"h":"القالب الخماسي","p":["Allô ? — الرد.","C'est Karim / Ici Karim — التعريف.","Je vous appelle parce que... — السبب.","Le motif/la demande — الطلب.","Merci, au revoir ! — الوداع."]},{"h":"النقل والرسائل","p":["Est-ce que je pourrais parler à... ? — طلب شخص.","C'est de la part de qui ? — من يتصل؟","Dites-lui que j'ai appelé. — قل لها أنني اتصلت.","Je rappellerai demain. — سأعا الاتصال غداً."]},{"h":"طوارئ المكالمة","p":["Vous pouvez répéter ? — هل تعيد؟","Il y a beaucoup de bruit. — الضجيج كثير.","Je vous appelle plus tard. — أعا الاتصال لاحقاً.","C'est urgent. — إنه طارئ."]}]},{"h":"تركيه رسالة وطلب شخص","p":["طلب شخص: «Est-ce que je pourrais parler à Mme Dupont, s'il vous plaît ?» (هل يمكنني التحدث إلى السيدة دوبون؟) والرد: «C'est de la part de qui ?» (من يتصل؟).","تركيه رسالة: «Elle n'est pas là. Vous voulez laisser un message ?» — «Oui, dites-lui que j'ai appelé et que je rappellerai demain.» (قل لها أنني اتصلت وسأعا الاتصال غداً).","المكالمة الرسمية تبدأ بـ Bonjour Madame/Monsieur وتنتهي بـ Cordialement au revoir — نفس أدب الرسالة لكن مسموعاً. الغلاف واحد واللغة مخنوقة قليلاً في الاتصال المباشر."],"video":null},{"h":"حجز موعد هاتفياً","p":["قالب الحجز: «Bonjour, je voudrais prendre rendez-vous, s'il vous plaît. — Pour quel jour ? — Mardi matin, si possible. — C'est possible à 10h. — Parfait, c'est noté. Merci !»","عبارات الطوارئ الهاتفية: «Vous pouvez répéter ?» (هل تعيد؟ — الصوت ضعيف!)، «Il y a du bruit» (يوجد ضجيج)، «Je vous rappelle plus tard» (سأعا الاتصال لاحقاً).","أوقف الفيديو الإثرائي عند كل سطر وردّده بنبرة المكالمة (صاعدة في الرد، هابطة في الوداع). التمثيل الصوتي للهاتف أكثر نفعاً من قراءة الحوار ورقياً."],"video":null},{"h":"التطبيق والتلخيص","p":["يُختم هذا الدرس بالقالب الخماسي للمكالمة: الرد (Allô ?)، التعريف (C'est Karim à l'appareil — لا Il est)، السبب (Je vous appelle parce que...)، الطلب، ثم الوداع (Merci, au revoir !)، مع لغة النقل: Est-ce que je pourrais parler à... ؟ و C'est de la part de qui ؟، وترك الرسالة (Dites-lui que j'ai appelé et que je rappellerai demain)، وحجز الموعد بـ je voudrais prendre rendez-vous، وطوارئ الصوت الضعيف: Vous pouvez répéter ؟ و Il y a du bruit و Je vous rappelle plus tard. كما وضح الفيديو الرئيسي «كيف تتكلم بالفرنسية في الهاتف: أهم الجمل اليومية» من قناة تعلم مع ليلى Learn with Layla على الرابط https://www.youtube.com/watch?v=oFZigJJPK2w، تُحفظ الجمل في ترتيبها لا منفردة، وأن نبرة الرد الصاعدة في Allô ؟ جزء من القالب نفسه.","بهذا تكتمل ثلاثية محوّر المحادثة في المستوى a2-t4: فقد أعطاك a2-t4-l1 لغة الطبيب والصيدلية، و a2-t4-l2 لغة الدعوة والموعد الودّي، ويضيف a2-t4-l3 غلاف الهاتف الذي ينقل الموعد نفسه إلى خط آخر: نفس prendre rendez-vous لكن بصيغة C'est... à l'appareil وسؤال C'est de la part de qui ؟. وبهذا تنتقل إلى a2-t5-l1 حيث يبدأ تدريب الفهم السمعي على حوارات قصيرة كهذه المكالمة تمامًا، ثم a2-t5-l2 حيث تُسمع النشرات الإخبارية (selon، une enquête، le bilan)، و a2-t5-l3 حيث تُثبَّت المفردات عبر الأغاني (refrain، les paroles)، وصولًا إلى a2-t6-l1 الذي يفتح باب الكتابة الوصفية بنفس المفردات الحياتية.","المهمة التطبيقية: أعد مشاهدة الفيديو الرئيسي وأقف عند كل سطر من القالب الخماسي واكتبه بصوته؛ ثم سجّل مكالمة حقيقية من ست جمل: تردّ بالـ Allô ؟، تعرّف بنفسك à l'appareil، تذكر السبب، تطلب الموعد بـ prendre rendez-vous، وإذا ضعف الصوت فقل Pouvez-vous répéter ؟، ثم اودع بـ Merci, au revoir !. استمع إلى تسجيلك وتأكّد أن تعريفك جاء بـ C'est... لا Il est؛ فهذا الفرق وحده يكشف مَن فهم القالب."]}],"examples":[{"fr":"Allô ? C'est Karim à l'appareil.","ar":"ألو؟ أنا كريم على الخط."},{"fr":"Est-ce que je pourrais parler à Mme Dupont ?","ar":"هل يمكنني التحدث إلى السيدة دوبون؟"},{"fr":"C'est de la part de qui ?","ar":"من يتصل؟ (من الجزاء؟)"},{"fr":"Je vous rappelle plus tard.","ar":"سأعا الاتصال لاحقاً."},{"fr":"Allô ? Oui, c'est Sofiane à l'appareil.","ar":"ألو؟ نعم، أنا سفيان على الخط.","note":"الرد والتعريف"},{"fr":"Je vous appelle pour prendre rendez-vous.","ar":"أتصل بكم لحجز موعد.","note":"السبب"},{"fr":"Dites-lui que j'ai appelé.","ar":"قل لها أنني اتصلت.","note":"ترك رسالة"},{"fr":"Pouvez-vous répéter, s'il vous plaît ?","ar":"هل يمكنك الإعادة من فضلك؟","note":"الطوارئ"}],"pron":[{"w":"à l'appareil","ipa":"[a.la.pa.ʁɛj]","approx":"آ-لا-باريه-ي","note":"على الخط (هاتفياً)"},{"w":"rappeler","ipa":"[ʁa.ple]","approx":"رابليه","note":"يعاود الاتصال"},{"w":"répéter","ipa":"[ʁe.pe.te]","approx":"ره-بيتيه"}],"vocab":[{"fr":"à l'appareil","ar":"على الخط (هاتف)","pos":"expression","ipa":"[a.la.pa.ʁɛj]","exFr":"C'est Omar à l'appareil.","exAr":"أنها عمر على الخط."},{"fr":"rappeler","ar":"يعاود الاتصال","pos":"verbe","ipa":"[ʁa.ple]","exFr":"Je vous rappelle demain.","exAr":"سأعا الاتصال غداً."},{"fr":"laisser un message","ar":"يترك رسالة","pos":"expression","ipa":"[lɛ.se œ̃ mɛ.saʒ]","exFr":"Je peux laisser un message ?","exAr":"هل أترك رسالة؟"},{"fr":"prendre rendez-vous","ar":"يحجز موعداً","pos":"expression","ipa":"[pʁɑ̃dʁ ʁɑ̃.de.vu]","exFr":"Je voudrais prendre rendez-vous.","exAr":"أريد حجز موعد."},{"fr":"répéter","ar":"يعيد / يكرر","pos":"verbe","ipa":"[ʁe.pe.te]","exFr":"Vous pouvez répéter ?","exAr":"هل تعيد من فضلك؟"},{"fr":"occupé(e)","ar":"مشغول / الخط مشغول","pos":"adj","g":"mf","ipa":"[ɔ.ky.pe]","exFr":"La ligne est occupée.","exAr":"الخط مشغول."},{"fr":"le bruit","ar":"الضجيج","pos":"nom","g":"m","exFr":"Il y a trop de bruit.","ipa":"[bʁɥi]","exAr":"الضجيج كثير جداً."},{"fr":"de la part de","ar":"من طرف","pos":"locution","exFr":"C'est de la part de Nour.","ipa":"[də la paʁ də]","exAr":"هذا من طرف نور."},{"fr":"la ligne","ar":"الخط (الهاتفي)","pos":"nom","g":"f","exFr":"La ligne est occupée, rappelez plus tard.","ipa":"/la liɲ/","exAr":"الخط مشغول، أعد الاتصال لاحقاً."},{"fr":"le standard","ar":"مكتب الاستقبال (الهاتف)","pos":"nom","g":"m","exFr":"Passez par le standard de l’hôtel.","ipa":"/lə stɑ̃daʁ/","exAr":"مرّ عبر مكتب استقبال الفندق."}],"grammar":[{"tFr":"Structure d'un appel téléphonique","tAr":"القاعدة: بنية المكالمة","body":["التعريف بالهاتف بـ C'est... (لا il est)؛ والنقل بـ dire que + je/ll (دائمًا ترتيب الفعل).","طلب الرخصة: Je pourrais / Pourriez-vous... — صيغتان مهذبتان تفتحان أي مكالمة."],"ex":[{"fr":"Pourriez-vous lui dire que je l'appelle ?","ar":"هل يمكنك أن تقول له أنني أتصل به؟"},{"fr":"C'est Nour à l'appareil.","ar":"أنا نور على الخط."}]}],"mistakes":[{"wrong":"Il est Karim (في الهاتف)","right":"C'est Karim","why":"التعريف في الهاتف قاعدة ساكنة: ce + être."},{"wrong":"Je rappelle (بمعنى أعا الاتصال)","right":"je vous rappelle / je rappellerai","why":"الفعل يتعدى بالضمير هنا — والمستقبل أفضل للوعد."},{"wrong":"dire à lui que","right":"dites-lui que","why":"الضمير lui يسبق الفعل مباشرة."},{"wrong":"مكالمة بلا وداع","right":"Merci, au revoir !","why":"الوداع جزء من القالب — حذفه يُشعر بالانقطاع."}],"dialogues":[{"title":"حجز موعد هاتفياً","ctx":"عميل عيادة","lines":[{"who":"Secrétaire","fr":"Allô, cabinet médical, bonjour.","ar":"ألو، عيادة طبية، مرحباً."},{"who":"Samia","fr":"Bonjour, je voudrais prendre rendez-vous, s'il vous plaît.","ar":"مرحباً، أريد حجز موعد من فضلك."},{"who":"Secrétaire","fr":"Pour quel jour ?","ar":"لأي يوم؟"},{"who":"Samia","fr":"Mardi matin, si possible. C'est urgent.","ar":"الثلاثاء صباحاً إن أمكن. إنه طارئ."},{"who":"Secrétaire","fr":"C'est possible à dix heures.","ar":"ممكن الساعة العاشرة."},{"who":"Samia","fr":"Parfait, c'est noté. Merci, au revoir !","ar":"ممتاز، سُجّل. شكراً، مع السلامة!"}]}],"exercises":[{"t":"mcq","skill":"conversation","q":"كيف تعرف نفسك على الهاتف؟","opts":["Je suis Karim.","C'est Karim à l'appareil.","Karim parle.","Ici j'appelle Karim."],"a":1,"why":"القالب الهاتفي: C'est + الاسم + à l'appareil."},{"t":"mcq","skill":"conversation","q":"«C'est de la part de qui ?» تعني:","opts":["أين أنت؟","من يتصل؟","ما الموضوع؟","متى تتصل؟"],"a":1,"why":"سؤال السكرتيرة عن هوية المتصل."},{"t":"fill","skill":"conversation","q":"أكمل: «Je voudrais ___ rendez-vous, s'il vous plaît.» (أحجز)","fr":"Je voudrais ___ rendez-vous, s'il vous plaît.","ans":"prendre","why":"prendre rendez-vous = يحجز موعداً."},{"t":"translate","skill":"writing","q":"ترجم: «سأعا الاتصال لاحقاً.»","ans":"Je vous rappelle plus tard.","alts":["je vous rappelle plus tard"],"why":"rappeler = يعاود الاتصال."},{"t":"listen","skill":"listening","q":"استمع واختر رد السكرتيرة المناسب:","audio":"Est-ce que je pourrais parler à Mme Dupont ?","opts":["Elle n'est pas là. Vous voulez laisser un message ?","Oui, c'est possible.","Non, elle ne parle pas.","Je suis occupée demain."],"a":0,"why":"الطلب المهذب للتحدث إلى شخص يُجاب عادةً بترك رسالة: Elle n'est pas là. Vous voulez laisser un message ؟"},{"t":"speaking","skill":"speaking","q":"مثّل مكالمة: عرّف بنفسك هاتفياً واطلب حجز موعد يوم الثلاثاء.","target":"Bonjour, c'est Karim à l'appareil. Je voudrais prendre rendez-vous mardi","why":"القالب الخماسي كاملًا: تحية + C'est... à l'appareil + prendre rendez-vous + اليوم + وداع."},{"t":"mcq","skill":"speaking","q":"التعريف بنفسك في الهاتف يكون بـ:","opts":["C'est + الاسم","Il est + الاسم","Je suis appelant","Je suis + اسم"],"a":0,"why":"C'est Karim à l'appareil قالب الهاتف الثابت."},{"t":"fill","skill":"speaking","q":"أكمل: «___-je vous rappeler demain ?» (هل يمكنني)","fr":"___-je vous rappeler demain ?","ans":"Puis","alts":["puis"],"why":"Puis-je = هل يمكنني (صيغة مهذبة)."}],"homework":"اكتب مكالمة هاتفية كاملة (8 أسطر) لحجز موعد في صالون حلاقة أو عيادة: الرد، التعريف، السبب، الموعد، الوداع. الدرس السابق/التالي: a2-t4-l2 (الدعوات والمواعيد) / a2-t5-l1 (فهم الحوارات القصيرة).","sources":[{"title":"كيف تتكلم بالفرنسية في الهاتف: أهم الجمل اليومية","channel":"تعلم مع ليلى Learn with Layla","videoId":"oFZigJJPK2w","why":"أهم جمل المكالمة الهاتفية بالعربية — القالب الكامل من الرد إلى الوداع في ثمان دقائق.","cat":"Conversation","level":"A2","main":true},{"title":"Comment parler au téléphone en français? 📞😀","channel":"Français avec Pierre","videoId":"j7EB4gNHb1U","why":"بيير يغطي كل قالب المكالمة: الرد، التعريف، الطلب، الرسالة، الوداع — مرجع الدرس الأساسي.","cat":"Conversation","level":"A2","extra":true},{"title":"😄📞 Comment parler au téléphone en français ? | Conversation","channel":"Guillaume Posé - Professeur de français","videoId":"jqsZ1Bkj1lY","why":"أستاذ FLE يعرض حواراً هاتفياً كاملاً مع التسميات — يعزز ما تعلمته بثاني مصدر مع عبارات إضافية.","cat":"Conversation","level":"A2","extra":true},{"title":"FRENCH DIALOGUE : PRENDRE RENDEZ-VOUS CHEZ LE MEDECIN / appointment","channel":"PLANÈTE FRANÇAIS TV avec Elsa Kenza","videoId":"kKBykzjVaBQ","why":"حوار حجز موعد طبي هاتفياً — يربط هذا الدرس بدرس الطبيب ويعرض أهم مكالمة ستجريها بحياتك في فرنسا.","cat":"Conversation","level":"A2","extra":true}],"supplements":[{"id":"j7EB4gNHb1U","title":"Comment parler au téléphone en français? 📞😀","channel":"Français avec Pierre","why":"بيير يغطي كل قالب المكالمة: الرد، التعريف، الطلب، الرسالة، الوداع — مرجع الدرس الأساسي.","lang":"fr"},{"id":"jqsZ1Bkj1lY","title":"😄📞 Comment parler au téléphone en français ? | Conversation","channel":"Guillaume Posé - Professeur de français","why":"أستاذ FLE يعرض حواراً هاتفياً كاملاً مع التسميات — يعزز ما تعلمته بثاني مصدر مع عبارات إضافية.","lang":"fr"},{"id":"kKBykzjVaBQ","title":"FRENCH DIALOGUE : PRENDRE RENDEZ-VOUS CHEZ LE MEDECIN / appointment","channel":"PLANÈTE FRANÇAIS TV avec Elsa Kenza","why":"حوار حجز موعد طبي هاتفياً — يربط هذا الدرس بدرس الطبيب ويعرض أهم مكالمة ستجريها بحياتك في فرنسا.","lang":"fr"}]}]},{"id":"a2-t5","slug":"listening","icon":"🎧","color":"#E11D48","fr":"Compréhension orale","ar":"مسار الاستماع","desc":"افتح أذنك على الفرنسية الحقيقية: مقابلات شارع Easy French، نشرة RFI بالفرنسية السهلة، وتعلّم ممتع بالأغاني — أساس طلاقتك السمعية.","lessons":[{"id":"A2-t5-l1","fr":"Comprendre les dialogues courts","ar":"فهم الحوارات القصيرة","objectives":["فهم فرنسية حقيقية بسرعة طبيعية مع ترجمة مزدوجة","التدرب على «الفرنسية البطيئة» كدرجة وسطى","بناء استراتيجيات فهم لا تحتاج كل كلمة"],"sections":[{"h":"الفرنسية البطيئة: درجتك الوسطى","p":["الخطوة الأولى في الاستماع ليست «فهم كل كلمة» بل « التقاط الموضوع»: اسمع أول جملتين واسأل نفسك: من يتكلم؟ في ماذا؟ عن أي موضوع؟ الخيط العام يكفي لبناء البقية — الدماغ يملأ الفراغات تلقائياً بمجرد أن يعرف السياق.","الفرنسية البطيئة (le français ralenti) درجتك الوسطى بين الفصحى المدرسية والسرعة الحية: مقدمو البرامج الناطقون للمتعلمين يتكلمون أبطأ وأوضح. ابدأ بها أسابيع ثم انتقل للسرعة الطبيعية — القفزة المباشرة إلى السرعة الحية تُفشل أغلب المبتدئين.","تابع الفيديو الأساسي بالشرح العربي: استراتيجيات التقاط الكلمات المفتاحية بالعربية والفرنسية معًا. الفكرة المحورية: الكلمات المفتاحية (الأسماء والأفعال والأرقام) تحمل 80% من المعنى، وحروف الجر والضمائر تُسمَع دون الحاجة لترجمتها في اللحظة.","مقابلات الشارع (les interviews) تمرين ذهبي: السؤال واحد يتكرر («Vous venez d'où ?» / «Quel âge avez-vous ؟») والأجوبة كثيرة ومختلفة. التكرار يقلل عبئك المعرفي — تعرف السؤال من أول مقطع فيتفرغ عقلك للأجوبة الجديدة.","استراتيجيات الفهم الذكي: توقّع قبل أن تسمع (prediction من العنوان)، ركّز على les mots-outils (donc, parce que, mais, en fait) لأنها تبني الهيكل، ولا تقف عند كلمة مجهولة — اكتب فراغاً وتابع. التوقف عند كل كلمة مجهولة هو السبب الأول للفشل في الاستماع.","الجدول الذهبي: 10 دقائق يومياً بأصل واحد مكرّر أفضل من ساعة واحدة أسبوعياً. المرة الأولى للموضوع، الثانية للمفردات، الثالثة للنطق والتكرار بصوت عالٍ (le shadowing). ثلاث مرات = ثلاث وظائف مختلفة، لا تكرار ممل."],"video":{"id":"3wBPmlYbpdM","title":"تطوير مهارة الاستماع باللغة الفرنسية : contact","channel":"تعلم اللغة الانجليزية و الفرنسية بالعربية","why":"تدريب مصوّر على الاستماع بالعربية والفرنسية معًا — استراتيجيات التقاط الكلمات المفتاحية.","lang":"ar","main":true,"dur":7},"sub":[{"h":"المشروع: التقاط الموضوع أولًا","p":["اسأل: من؟ ماذا؟ أين؟ — قبل فهم كل كلمة.","الأسماء والأفعال والأرقام تحمل المعنى.","الضمائر وحروف الجر تُترك ذهنياً في اللحظة.","اكتب خانات فارغة بدل التوقف."]},{"h":"من الفرنسية البطيئة إلى الحية","p":["French ralenti = درجة وسطى مريحة.","Interviews = سؤال واحد × أجوبة كثيرة.","الانتقال التدريجي بعد أسابيع لا أسبوع.","القفزة المباشرة تُفشل أغلب المبتدئين."]},{"h":"الجدول الذهبي: ثلاث مرات","p":["الأولى: الموضوع العام.","الثانية: المفردات والتعبيرات.","الثالثة: shadowing بصوت عالٍ.","10 دقائق يومياً > ساعة أسبوعياً."]}]},{"h":"مقابلات الشارع: نفس السؤال، أجوبة كثيرة","p":["قوة المقابلات: تتكرر فيها صيغة واحدة (Pourquoi vivez-vous à Paris ?) بأجوبة مختلفة، فيتعلم دماغك التوقع: يسمع «parce que...» فينتظر سبباً. هذا التوقع هو سر فهم الناطقين الأصليين.","تدريب مقترح: شغّل المقابلة واجمع 3 أسباب مختلفة ذكرها الفرنسيون للعيش في باريس. اكتبها كاملة ثم قارن مع الترجمة.","الكلمات المساعدة الأهم سمعياً: «en fait» (في الواقع) تُعلن تصحيح المتكلم، «quand même» (مع ذلك) تُعلن تحفظاً، «du coup» (إذن/وبالتالي) تُعلن نتيجة. ثلاث علامات صوتية توجّه فهمك قبل أن تفهم كل كلمة."],"video":null},{"h":"استراتيجيات الفهم الذكي","p":["ثلاث استراتيجيات: 1) استمع للمقطع الأول وحدد الموضوع من أول جملتين (السياق يوفر 50% من الفهم). 2) ركز على الأزمنة: سمعت hier/ai/était؟ إذن القصة ماضٍ. 3) لا تتجمد عند كلمة غريبة — استمر، فالجملة التالية غالباً تشرحها.","خطة الأسبوع: 10 دقائق استماع يومياً تكفي، شرط التكرار: نفس المقطع 3 مرات أفضل من 3 مقاطع مرة واحدة.","بعد الفيديو الإثرائي، اختر مقطعاً من 2 دقيقة وأعِد سماعه 3 مرات بالترتيب الوظيفي (موضوع → مفردات → shadowing). سجّل نفسك في المرة الثالثة وقارن نطقك بمقطع المتحدث."],"video":null},{"h":"التطبيق والتلخيص","p":["يُختم هذا الدرس بمنهج الفهم السمعي كاملًا: فالمدخل ليس فهم كل كلمة بل التقاط الموضوع من أول جملتين (من يتكلم؟ في ماذا؟ عن أي موضوع؟)، والفرنسية البطيئة (le français ralenti) درجة وسطى بين الفصحى المدرسية والسرعة الحية تُقطع فيها أسابيع قبل القفزة للسرعة الطبيعية، والكلمات المفتاحية (الأسماء والأفعال والأرقام) تحمل 80% من المعنى بينما تُترك الضمائر وحروف الجر ذهنيًا، وأدوات التوجيه (donc، parce que، mais، en fait، quand même، du coup) تبني الهيكل، ثم الجدول الذهبي بثلاث مرات وظيفية (الموضوع ← المفردات ← shadowing) بعشر دقائق يوميًا. كما وضح الفيديو الرئيسي «تطوير مهارة الاستماع باللغة الفرنسية : contact» من قناة تعلم اللغة الانجليزية و الفرنسية بالعربية على الرابط https://www.youtube.com/watch?v=3wBPmlYbpdM، تُبنى استراتيجيات التقاط الكلمات المفتاحية بالعربية والفرنسية معًا، وأن التوقف عند كل كلمة مجهولة هو السبب الأول للفشل في الاستماع.","بهذا تدخل أبواب a2-t5 الاستماعية من a2-t4-l3: فالمكالمة الهاتفية التي أتقنتها هناك هي أول اختبار حقيقي للأذن — صوت غير مرئي وجملة تمرّ مرة واحدة؛ ومن a2-t4-l1 تحضر لغة الطبيب (Qu'est-ce qui vous arrive ؟) ومن a2-t4-l2 لغة الدعوة (Tu es libre samedi ؟) في صيغ قصيرة مسموعة، وها أنت تتعلم كيف تلتقطها في a2-t5-l1، ثم توسّع النطاق في a2-t5-l2 بالنشرات الإخبارية (selon، le bilan، une enquête)، وتثبّت المفردات الإيقاعية في a2-t5-l3 بالأغاني (refrain، les paroles)، وينتهي المحور بكتابة a2-t6-l1 حيث تصف الأشخاص والأماكن بلغة سمعية مضبوطة.","المهمة التطبيقية: أعد مشاهدة الفيديو الرئيسي وطبّق الجدول الذهبي على مقطع من دقيقتين: أول مرة للموضوع العام، ثانية للمفردات والتعبيرات، ثالثة shadowing بصوت عالٍ؛ ثم سجّل نفسك وأنت تجيب بصوتك عن سؤال المقابلة «Pourquoi vivez-vous à... ؟» في ثلاث جمل (المدينة + السبب + مثال)، واستمع إلى تسجيلك وحدّد كلمتين لم تُسمعا بوضوح وأعِد تسجيلهما فقط."]}],"examples":[{"fr":"Pourquoi vivez-vous à Paris ?","ar":"لماذا تسكنون في باريس؟"},{"fr":"Parce que c'est une ville vivante.","ar":"لأنها مدينة حيوية."},{"fr":"Je suis ici pour le travail.","ar":"أنا هنا من أجل العمل."},{"fr":"On peut répéter, s'il vous plaît ?","ar":"هل يمكن الإعادة من فضلك؟"},{"fr":"Je ne comprends pas tout, mais je saisis le sujet.","ar":"لا أفهم كل شيء لكنني ألتقط الموضوع.","note":"التوقع قبل التفصيل"},{"fr":"Vous pouvez ralentir un peu ?","ar":"هل يمكنك الإبطاء قليلاً؟","note":"طلب السرعة"},{"fr":"Les mots-clés portent le sens.","ar":"الكلمات المفتاحية تحمل المعنى.","note":"استراتيجية"},{"fr":"J'écoute d'abord pour le thème, ensuite pour les mots.","ar":"أستمع أولاً للموضوع ثم للمفردات.","note":"ثلاث مرات"}],"pron":[{"w":"vivez-vous","ipa":"[vi.ve.vu]","approx":"ڤي-ڤيه-فو"},{"w":"une ville vivante","ipa":"[yn.vil.vi.vɑ̃t]","approx":"أون-ڤيل-ڤيڤانت","note":"لاحظ تكرار [v]"},{"w":"je répète","ipa":"[ʒə.ʁe.pe.t]","approx":"جو-ره-بيت"}],"vocab":[{"fr":"un dialogue","ar":"حوار","pos":"nom","g":"m","pl":"des dialogues","ipa":"[dja.lɔg]","exFr":"Ce dialogue est facile à suivre.","exAr":"هذا الحوار سهل المتابعة."},{"fr":"à voix haute","ar":"بصوت عالٍ","pos":"expression","ipa":"[a.vwa.ot]","exFr":"Répète le dialogue à voix haute.","exAr":"أعد الحوار بصوت عالٍ."},{"fr":"la vitesse","ar":"السرعة","pos":"nom","g":"f","pl":"les vitesses","ipa":"[vi.tɛs]","exFr":"Je comprends à petite vitesse.","exAr":"أفهم بالسرعة البطيئة."},{"fr":"distinguer","ar":"يميّز / يفرّق بين","pos":"verbe","g":"1er","ipa":"[dis.tɛ̃.ɡe]","exFr":"Je distingue les mots clairs.","exAr":"أميّز الكلمات الواضحة."},{"fr":"suivre","ar":"يتبع / يواكب","pos":"verbe","ipa":"[sɥivʁ]","exFr":"Je ne suis pas tout — parle lentement !","exAr":"لا أواكب كل شيء — تكلم ببطء!"},{"fr":"la compréhension orale","ar":"الفهم السمعي","pos":"nom","exFr":"C'est un exercice de compréhension orale.","ipa":"[kɔ̃pʁɛsjɔ̃ ɔʁal]","exAr":"تمرين فهم سمعي."},{"fr":"ralentir","ar":"يبطئ","pos":"verbe","g":"2e","exFr":"Vous pouvez ralentir ?","ipa":"[ʁalɑ̃tiʁ]","exAr":"هل يمكنك الإبطاء؟"},{"fr":"l'essentiel","ar":"الجوهر/الأهم","pos":"nom","g":"m","exFr":"Retenez l'essentiel.","ipa":"[ɛsɑ̃sjɛl]","exAr":"احتفظوا بالأهم."},{"fr":"deviner","ar":"يخمن","pos":"verbe","g":"1er","exFr":"Je devine le sens du contexte.","ipa":"[dəvine]","exAr":"أخمن معنى السياق."},{"fr":"la clé / les mots-clés","ar":"المفتاح/الكلمات المفتاحية","pos":"nom","exFr":"Repérez les mots-clés.","ipa":"[le mo kle]","exAr":"حدّدوا الكلمات المفتاحية."},{"fr":"répéter (à voix haute)","ar":"يكرر بصوت عالٍ","pos":"locution","exFr":"Répétez à voix haute.","ipa":"[ʁepete]","exAr":"كرروا بصوت عالٍ."},{"fr":"un extrait","ar":"مقطع","pos":"nom","g":"m","exFr":"Écoutez cet extrait.","ipa":"[ɛkstʁɛ]","exAr":"استمعوا إلى هذا المقطع."},{"fr":"l'accent","ar":"اللكنة/النطق","pos":"nom","g":"m","exFr":"Distinguez les accents.","ipa":"[akɑ̃]","exAr":"ميّزوا اللهجات."},{"fr":"un rythme","ar":"إيقاع","pos":"nom","g":"m","exFr":"Le rythme est rapide.","ipa":"[ʁitm]","exAr":"الإيقاع سريع."},{"fr":"capter","ar":"يلتقط/يستوعب","pos":"verbe","g":"1er","exFr":"Je capte le sens global.","ipa":"[kapte]","exAr":"ألتقط المعنى العام."}],"grammar":[{"tFr":"Les mots-outils de repérage","tAr":"القاعدة: أدوات التوجيه السمعي","body":["donc / parce que / mais / en fait / quand même / du coup — حروف ربط تبني الهيكل وتوجّه الفهم قبل تفصيل الكلمات.","مع le son liaison: «vous_avez», «elle_est» — اربط الصوت لا الحرف؛ الاستماع للوصلات يسرّع الفهم."],"ex":[{"fr":"En fait, je n'ai pas compris le début.","ar":"في الواقع لم أفهم البداية."},{"fr":"Du coup, on se voit demain.","ar":"إذن، نرى غداً."}]}],"mistakes":[{"wrong":"الترجمة الكلمة بكلمة أثناء السماع","right":"التقاط الموضوع ثم التفاصيل","why":"الترجمة المتزامنة تُحمّل الذاكرة وتُفشل الفهم."},{"wrong":"الوقوف عند كل كلمة مجهولة","right":"خانة فارغة ومتابعة","why":"التوقف يقطع الخيط السياقي وهو ما يبنيه الدماغ."},{"wrong":"الاستماع لساعة مرة واحدة أسبوعياً","right":"10 دقائق يومياً","why":"الاستمرار اليومي يثبت الاستماع أكثر من الكثافة المتقطعة."},{"wrong":"القفزة من البطيء للطبيعي في يوم","right":"انتقال تدريجي بعد أسابيع","why":"السرعة الطبيعية بلا تمرين سابق تُحبط وتُكرر الترجمة الذهنية."}],"dialogues":[{"title":"نقاش عن فهم السمع","ctx":"زميلان يتناقسان حول تقنيتهما","lines":[{"who":"Sara","fr":"Tu comprends les interviews à la télé ?","ar":"هل تفهم مقابلات التلفاز؟"},{"who":"Omar","fr":"Pas tout, mais je saisis le thème.","ar":"ليس كل شيء لكنني ألتقط الموضوع."},{"who":"Sara","fr":"Moi, je regarde d'abord les mots-clés.","ar":"أنا أبدأ بالكلمات المفتاحية."},{"who":"Omar","fr":"Et tu regardes les sous-titres ?","ar":"وهل تشاهد الترجمة؟"},{"who":"Sara","fr":"Une fois sans, puis une fois avec.","ar":"مرة بدون ثم مرة معها."},{"who":"Omar","fr":"Bonne idée ! Je vais essayer.","ar":"فكرة جيدة! سجربها."}]}],"exercises":[{"t":"listen","skill":"listening","q":"استمع واختر موضوع الجملة:","audio":"J'habite à Paris parce que mon travail est ici","opts":["السكن والعمل","السفر والعطلة","الطعام والمطعم","الدراسة والامتحان"],"a":0,"why":"الجملة تحمل السياق (habite) والسبب (parce que) — بمجرّد التقاطهما يتحدد الموضوع: السكن والعمل."},{"t":"listen","skill":"listening","q":"استمع واختر من يتحدث عن ماذا:","audio":"Je me lève tôt et je travaille jusqu'à dix-huit heures","opts":["روتين يومي طويل","عطلة صيفية","قصة طفولة","مشكلة صحية"],"a":0,"why":"أفعال الروتين (me lève، travaille) وأرقام الوقت تكشف الموضوع: روتين يومي طويل."},{"t":"mcq","skill":"listening","q":"ما الاستراتيجية الصحيحة عند سماع كلمة غير مفهومة؟","opts":["أعد المقطع من البداية دائماً","تجمد وفكر فيها حتى النهاية","استمر في الاستماع والسياق سيشرحها","أوقف الفيديو نهائياً"],"a":2,"why":"المتابعة تسمح للسياق بتوضيح المعنى."},{"t":"mcq","skill":"listening","q":"أفضل جدول لتحسين السمع في A2:","opts":["ساعة أسبوعياً بمقطع جديد","10 دقائق يومياً مع تكرار نفس المقطع","3 ساعات في العطلة فقط","استماع بدون تكرار"],"a":1,"why":"الاستمرار + التكرار أقوى من الكثافة المتقطعة."},{"t":"fill","skill":"vocabulary","q":"أكمل: «Répète le dialogue ___ haute.» (بصوت)","fr":"Répète le dialogue ___ haute.","ans":"à","alts":["a"],"why":"à voix haute = بصوت عالٍ."},{"t":"speaking","skill":"speaking","q":"جب صوتياً سؤال المقابلة: «لماذا تعيش في مدينتك؟» جملة واحدة.","target":"J'habite ici parce que ma famille est ici","why":"الإجابة الصوتية تُبنى بـ parce que كنموذج مقابلات الشارع في الفيديو."},{"t":"mcq","skill":"listening","q":"الاستماع الفعّال يبدأ بـ:","opts":["التقاط الموضوع العام","ترجمة كل كلمة","كتابة كل شيء","إعادة فورية"],"a":0,"why":"السياق أولاً ثم التفاصيل — الترجمة المتزامنة تُفشل الفهم."},{"t":"fill","skill":"listening","q":"أكمل: «Je réécoute l'extrait ___ haute.» (بصوت)","fr":"Je réécoute l'extrait ___ haute.","ans":"à voix","alts":["A voix"],"why":"à voix haute = بصوت عالٍ."}],"homework":"شاهد مقطع Super Easy French واحداً ثلاث مرات، ثم اكتب 5 جمل سمعتها فهمتها كاملة. الدرس السابق/التالي: a2-t4-l3 (المكالمات الهاتفية) / a2-t5-l2 (الأخبار بالفرنسية السهلة).","sources":[{"title":"تطوير مهارة الاستماع باللغة الفرنسية : contact","channel":"تعلم اللغة الانجليزية و الفرنسية بالعربية","videoId":"3wBPmlYbpdM","why":"تدريب مصوّر على الاستماع بالعربية والفرنسية معًا — استراتيجيات التقاط الكلمات المفتاحية.","cat":"Listening","level":"A2","main":true},{"title":"Everyday Conversation In Slow French | Super Easy French 161","channel":"Easy French","videoId":"aMx0d42wzBs","why":"سلسلة Super Easy French: محادثات يومية ببطء مقصود وترجمة مزدوجة على الشاشة — التدريب الأمثل للسمع في A2.","cat":"Listening","level":"A2","extra":true},{"title":"Why Do You Live in Paris? | Easy French 97","channel":"Easy French","videoId":"YCuU4SjcS2A","why":"مقابلات شارع حقيقية بأسئلة بسيطة وردود متنوعة — تسمع أجوبة مختلفة على نفس السؤال وهذا أقوى تدريب للتوقع السمعي.","cat":"Listening","level":"A2","extra":true},{"title":"30 min. de dialogues en français - Niveau débutant à avancé","channel":"Français avec Pierre","videoId":"cdDXcbveuGQ","why":"30 دقيقة حوارات متدرجة من المبتدئ للمتقدم — مادة مكثفة تسمع فيها التدرج فعلياً وتختار مستواك بنفسك.","cat":"Listening","level":"A2","extra":true}],"supplements":[{"id":"aMx0d42wzBs","title":"Everyday Conversation In Slow French | Super Easy French 161","channel":"Easy French","why":"سلسلة Super Easy French: محادثات يومية ببطء مقصود وترجمة مزدوجة على الشاشة — التدريب الأمثل للسمع في A2.","lang":"fr"},{"id":"YCuU4SjcS2A","title":"Why Do You Live in Paris? | Easy French 97","channel":"Easy French","why":"مقابلات شارع حقيقية بأسئلة بسيطة وردود متنوعة — تسمع أجوبة مختلفة على نفس السؤال وهذا أقوى تدريب للتوقع السمعي.","lang":"fr"},{"id":"cdDXcbveuGQ","title":"30 min. de dialogues en français - Niveau débutant à avancé","channel":"Français avec Pierre","why":"30 دقيقة حوارات متدرجة من المبتدئ للمتقدم — مادة مكثفة تسمع فيها التدرج فعلياً وتختار مستواك بنفسك.","lang":"fr"}]},{"id":"A2-t5-l2","fr":"Les infos en français facile","ar":"الأخبار بالفرنسية السهلة","objectives":["التعرف على مشروع RFI بالفرنسية السهلة واستخدامه يومياً","فهم نطاق أخبار مبسطة قصيرة","بناء مفردات الأخبار الأساسية"],"sections":[{"h":"RFI: نشرات مصممة للمتعلمين","p":["الأخبار للمتعلمين ليست نشرة عادية بل غذاء مُعايَر: سرعة أهدأ، مفردات مكرّرة، وبنية جملية واضحة. RFI و France 24 وأخبار TF1 السريعة ثلاثة مستويات متدرجة — ابدأ بالمبسطة وانتقل بثقة.","هيكل الخبر يعيد نفسه في كل مرة: العنوان (le titre) يعلن الحدث، ثم la phrase d'accroche (جملة الافتتاح) تلخّص، ثم التفاصيل (من، ماذا، متى، أين)، ثم السياق والآثار. تعرّف على الهيكل فستقرأ أي خبر في ثلث الوقت.","تابع الفيديو الأساسي بالشرح العربي: نشرة RFI كاملة تُقرأ وتُشرح بالعربية. لاحظ أن الأخبار تبدأ غالباً بـ «Selon...» (حسب...) و«Une journée après...» (بعد يوم...) — قوالب زمنية ومصدرية تظهر في كل نشرة وتُغنيك عن فك كل جملة.","المفردات الإخبارية الدائمة: l'actualité (الواقع/الأخبار)، un bulletin (نشرة)، une dépêche (خبر عاجل)، une enquête (تحقيق)، un communiqué (بيان)، en direct (مباشر)، la source (المصدر)، relater (يروي/ينقل). عشر كلمات تفتح 90% من العناوين.","تمرين القراءة الذكي: اقرأ العنوان وخمّن المحتوى، ثم اقرأ الجملة الأولى فقط وصحّح تخمينك، ثم ابحث عن الأرقام والأسماء (تواريخ، نسب، أماكن). الأرقام هي أوائل ما يُنسى في الخبر — دوّنها فوراً على ورقة.","بعد الفهم، تلخيص من جملتين: «Qu'est-ce qui s'est passé ? Et pourquoi c'est important ؟» — حدث وسبب. التلخيص القصير هو المعيار الحقيقي للفهم، وكتابته بالفرنسية يختبر مفرداتك وقواعدك في آن واحد."],"video":{"id":"QkL1ywH2ZCI","title":"تعلم الفرنسية - هكذا ستفهم الأخبار باللغة الفرنسية بشكل رائع الفيديو الشامل Le Journal Télévisé","channel":"french free","why":"كيف تفهم نشرة الأخبار الفرنسية بالكامل — دليل عربي شامل للجملة الإخبارية ومفرداتها المتكررة.","lang":"ar","main":true,"dur":27},"sub":[{"h":"لماذا أخبار المتعلمين؟","p":["RFI (Simple/Slow) — المبسطة أولاً.","France 24 ثم TF1 La Dépêche — تدريج.","سرعة أهدأ ومفردات مكرّرة.","الانتقال بثقة بعد أسابيع."]},{"h":"هيكل الخبر الثابت","p":["le titre — يعلن الحدث.","la phrase d'accroche — تلخيص.","التفاصيل: qui / quoi / quand / où.","السياق والآثار في الختام."]},{"h":"قوالب النشرة الدائمة","p":["Selon... — حسب (المصدر).","Une journée après... — بعد يوم.","en direct de... — مباشر من.","Le ministère a confirmé... — أكدت الوزارة."]}]},{"h":"نموذج نشرة: نقرأ الأخبار معاً","p":["بنية النشرة: مقدمة موجزة للموضوع ثم تفاصيل بسيطة ثم آراء أو أرقام. ركّز على العناوين الداخلية: \"Un incendie a éclaté...\" (اندلع حريق)، \"Les pompiers sont intervenus...\" (تدخل رجال الإطفاء).","مفردات الأخبار الذهبية: «selon» (حسب)، «les autorités» (السلطات)، «une enquête» (تحقيق)، «le bilan» (الحصيلة)، «annoncer» (يُعلن). بهذه الخمس تفهم نصف النشرات.","الأرقام في الخبر: l'an prochain (العام القادم)، 10 % (عشرة بالمئة)، deux sur trois (اثنان من ثلاثة). دوّن الأرقام مع وحداتها على ورقة أثناء القراءة — الذاكرة المجردة تنسى الرقم وتحفظ الخبر ناقصاً."],"video":null},{"h":"أخبار ثقافية + عادة يومية","p":["اجعل النشرة عادة صباحية: قهوة + نشرة واحدة = عشر دقائق. بعد أسبوعين ستلاحظ أنك تفهم المقدمة كاملة، وبعد شهرين تفهم النشرة كاملة تقريباً.","لا تتوتر من الأسماء والأماكن الجغرافية — حتى الفرنسيون يمررونها بسرعة. ركّز على الفعل الرئيسي لكل خبر: ماذا حدث؟ لمن؟ أين؟","الفيديو الإثرائي يقرأ نشرة حقيقية؛ اقرأ أنت أولاً بصمت ثم استمع وصحّح. مطابقة عينك لنص مسموع تمرين الأذن الذهبي (le décodage auditif)."],"video":null},{"h":"التطبيق والتلخيص","p":["يُختم هذا الدرس بنشرة RFI المبسطة: فأخبار المتعلّمين غذاء مُعايَر بسرعة أهدأ ومفردات مكرّرة، وهيكل الخبر ثابت (le titre يعلن الحدث، la phrase d'accroche تلخّص، ثم qui و quoi و quand و où، ثم السياق والآثار)، وقوالبها الدائمة Selon... و Une journée après... و en direct de...، ومفرداتها الذهبية l'actualité و un bulletin و une dépêche و une enquête و le bilan و les autorités و annoncer و relater و une source و résumer، والأرقام تُدوَّن مع وحداتها فورًا على ورقة. كما وضح الفيديو الرئيسي «تعلم الفرنسية - هكذا ستفهم الأخبار باللغة الفرنسية بشكل رائع الفيديو الشامل Le Journal Télévisé» من قناة french free على الرابط https://www.youtube.com/watch?v=QkL1ywH2ZCI، تُقرأ النشرة بالعربية قبل الفرنسية، وأن التلخيص من جملتين (حدث + سبب) هو المعيار الحقيقي للفهم.","بهذا يتقدّم محور الاستماع من a2-t5-l1 إلى a2-t5-l2: فما بنيته من استراتيجيات (التقاط الموضوع أولًا، ركّز على mots-outils، لا تقف عند كلمة مجهولة) يُطبَّق هنا على نص أطول وأسرع، وتبقى صيغتا السؤال الطويلتان من a2-t4-l1 و a2-t4-l3 (Vous avez de la fièvre ؟ / Pouvez-vous répéter ؟) أقرب ما يشبه الإجابة-السؤال الإخباري «Qu'est-ce qui s'est passé ؟»؛ ومن هذه النشرة تنتقل إلى a2-t5-l3 حيث تُثبَّت المفردات الجديدة في نصوص مغنّاة (refrain، les paroles)، وصولًا إلى a2-t6-l1 الذي يوجّه الكتابة الوصفية نحو الأشخاص والأماكن.","المهمة التطبيقية: أعد مشاهدة الفيديو الرئيسي واقرأ النشرة أولًا بصمت والورقة أمامك فارغة، ثم استمع ودوّن الأرقام والأماكن فقط، ثم قارن دفترك بحقائق النص؛ وبعد ذلك سجّل نفسك وأنت تنقل خبرًا من ثلاثين ثانية بأسلوب النشرة: تبدأ بـ «Selon...»، تُذكِر الحدث بالماضي المركّب، وتُغلق بجملة تفسير (c'est pourquoi...). استمع إلى تسجيلك واحذف كل كلمة زائدة — الإخباري يختصر ولا يزيّد."]}],"examples":[{"fr":"Un incendie a éclaté hier soir.","ar":"اندلع حريق مساء أمس."},{"fr":"Selon les autorités, le bilan s'alourdit.","ar":"حسب السلطات، الحصيلة تتفاقم."},{"fr":"Une enquête est en cours.","ar":"تحقيق جارٍ."},{"fr":"L'Unesco a inscrit le compas au patrimoine.","ar":"سجلت اليونسكو البوصلة في التراث."},{"fr":"Selon les spécialistes, la situation s'améliore.","ar":"حسب الخبراء، الوضع يتحسن.","note":"قالب المصدر"},{"fr":"Une journée après, rien n'a changé.","ar":"بعد يوم، لم يتغير شيء.","note":"قالب زمني"},{"fr":"Résumez l'article en deux phrases.","ar":"لخص المقال في جملتين.","note":"تمرين التلخيص"},{"fr":"Le ministère a confirmé la nouvelle.","ar":"أكدت الوزارة الخبر.","note":"صيغة رسمية"}],"pron":[{"w":"selon","ipa":"[sə.lɔ̃]","approx":"سولون"},{"w":"une enquête","ipa":"[yn.ɑ̃.kɛt]","approx":"أون-آن-كِت"},{"w":"le patrimoine","ipa":"[lə.pa.tʁi.mwan]","approx":"لوباتريموين"}],"vocab":[{"fr":"selon","ar":"حسب","pos":"préposition","ipa":"[sə.lɔ̃]","exFr":"Selon la météo, il pleuvra demain.","exAr":"حسب الطقس، ستمطر غداً."},{"fr":"une enquête","ar":"تحقيق / استقصاء","pos":"nom","g":"f","pl":"des enquêtes","ipa":"[ɑ̃.kɛt]","exFr":"L'enquête continue.","exAr":"التحقيق مستمر."},{"fr":"le bilan","ar":"الحصيلة","pos":"nom","g":"m","pl":"les bilans","ipa":"[bi.lɑ̃]","exFr":"Le bilan est grave.","exAr":"الحصيلة خطيرة."},{"fr":"annoncer","ar":"يُعلن","pos":"verbe","ipa":"[a.nɔ̃.se]","exFr":"Le gouvernement a annoncé une réforme.","exAr":"أعلنت الحكومة إصلاحاً."},{"fr":"les autorités","ar":"السلطات","pos":"nom","g":"fpl","ipa":"[le.zo.tɔ.ri.te]","exFr":"Les autorités ont réagi vite.","exAr":"تفاعلت السلطات بسرعة."},{"fr":"le patrimoine","ar":"التراث","pos":"nom","g":"m","ipa":"[pa.tʁi.mwan]","exFr":"Protégeons notre patrimoine.","exAr":"لنحمِ تراثنا."},{"fr":"l'actualité","ar":"الأخبار/الواقع","pos":"nom","g":"f","exFr":"J'écoute les informations.","ipa":"[aktyalite]","exAr":"أستمع إلى الأخبار."},{"fr":"un bulletin","ar":"نشرة إخبارية","pos":"nom","g":"m","exFr":"Le bulletin de 20h.","ipa":"[bylɛtɛ̃]","exAr":"نشرة الثامنة مساءً."},{"fr":"une dépêche","ar":"خبر عاجل","pos":"nom","g":"f","exFr":"Une dépêche de dernière minute.","ipa":"[depeʃ]","exAr":"خبر عاجل من آخر اللحظة."},{"fr":"enquête","ar":"تحقيق","pos":"nom","g":"f","exFr":"Une enquête journalistique.","ipa":"[ɑ̃kɛt]","exAr":"تحقيق صحفي."},{"fr":"le ministère","ar":"الوزارة","pos":"nom","g":"m","exFr":"Le ministère a confirmé.","ipa":"[ministɛʁ]","exAr":"أكدت الوزارة."},{"fr":"relater","ar":"ينقل/يروي","pos":"verbe","g":"1er","exFr":"Le journaliste relate les faits.","ipa":"[ʁɛlate]","exAr":"الصحفي ينقل الوقائع."},{"fr":"en direct","ar":"مباشر","pos":"locution","exFr":"En direct de Paris.","ipa":"[ɑ̃ diʁɛk]","exAr":"مباشر من باريس."},{"fr":"une source","ar":"مصدر","pos":"nom","g":"f","exFr":"Une source officielle.","ipa":"[sɔʁs]","exAr":"مصدر رسمي."},{"fr":"résumer","ar":"يلخّص","pos":"verbe","g":"1er","exFr":"Résumez l'article en deux phrases.","ipa":"[ʁezyze]","exAr":"لخّص المقال في جملتين."}],"grammar":[{"tFr":"Les temps dans l'information","tAr":"القاعدة: الأزمنة في الخبر","body":["الخبر يستعمل passé composé للحدث («Le président a annoncé...») وimparfait للسياق («il faisait beau...») و futur للتوقعات («ce sera...»).","مع structures passives شائعة: «Il a été décidé que...» (تم اتخاذ قرار...) — الصيغة الرسمية المفضلة في النشرات."],"ex":[{"fr":"Le président a annoncé de nouvelles mesures.","ar":"أعلن الرئيس إجراءات جديدة."},{"fr":"Il sera examiné la semaine prochaine.","ar":"سيُدرس الأسبوع القادم."}]}],"mistakes":[{"wrong":"قراءة كل كلمة قبل فهم الموضوع","right":"العنوان ثم جملة الافتتاح","why":"الهيكل أولاً يوفّر وقتاً ويقود التوقع الصحيح."},{"wrong":"تجاهل الأرقام","right":"دوّن الأرقام مع وحداتها","why":"الأرقام هي جوهر الخبر ويسهل نسيانها."},{"wrong":"البدء بنشرة سريعة مباشرة","right":"RFI المبسطة أولاً","why":"السرعة الطبيعية بلا أساس تُفشل وتُحبط."},{"wrong":"الحفظ بلا تلخيص","right":"تلخيص من جملتين (حدث + سبب)","why":"التلخيص المكتوب هو اختبار الفهم الحقيقي."}],"dialogues":[{"title":"مناقشة خبر","ctx":"صديقتان بعد نشرة الأخبار","lines":[{"who":"Nadia","fr":"Tu as entendu le bulletin de 20h ?","ar":"هل سمعت نشرة الثامنة؟"},{"who":"Claire","fr":"Oui, une dépêche sur le climat.","ar":"نعم، خبر عاجل عن المناخ."},{"who":"Nadia","fr":"Qu'est-ce qui s'est passé ?","ar":"ما الذي حدث؟"},{"who":"Claire","fr":"Selon le ministère, il fait plus chaud qu'avant.","ar":"حسب الوزارة، الجو أدفأ من قبل."},{"who":"Nadia","fr":"Et les spécialistes ?","ar":"والخبراء؟"},{"who":"Claire","fr":"Ils confirment, et demandent des mesures.","ar":"يؤكدون ذلك ويطالبون بإجراءات."}]}],"exercises":[{"t":"listen","skill":"listening","q":"استمع للخبر المبسط واختر موضوعه:","audio":"Un incendie a éclaté hier soir dans un immeuble à Lyon","opts":["حريق في مبنى","فيضان في نهر","مباراة كرة","إضراب معلمين"],"a":0,"why":"incendie و éclaté و immeuble كلمات الحدث الثلاث — التقاطها يكفي لتحديد الموضوع: حريق في مبنى."},{"t":"mcq","skill":"listening","q":"«Selon les autorités...» — من مصدر المعلومة؟","opts":["شاهد عيان","السلطات","الرئيس مباشرة","الناس في الشارع"],"a":1,"why":"selon les autorités = حسب السلطات."},{"t":"mcq","skill":"listening","q":"ما الخطوات الثلاث الصحيحة للاستماع لنشرة؟","opts":["نص ثم استماع ثم ترجمة","استماع بلا نص ثم مع النص ثم حفظ 5 كلمات","ترجمة أولاً ثم نسخ كل النص","سماع مرة واحدة فقط"],"a":1,"why":"هي منهجية RFI التعليمية الموصى بها."},{"t":"fill","skill":"vocabulary","q":"أكمل: «___ les autorités, la situation s'améliore.» (حسب)","fr":"___ les autorités, la situation s'améliore.","ans":"Selon","alts":["selon"],"why":"selon تسبق مصدر الخبر."},{"t":"listen","skill":"listening","q":"استمع واختر ما أُعلن:","audio":"Le gouvernement a annoncé une réforme du travail","opts":["إصلاح في العمل","إلغاء المدرسة","افتتاح متحف","تأجيل الامتحان"],"a":0,"why":"المصدر (le gouvernement) والفعل annoncer يحددان ما أُعلن: إصلاح في العمل."},{"t":"writing","skill":"writing","q":"اكتب خبراً مبسطاً من عندك (مدرسة، حي، مدينة) في 3 أسطر بأسلوب النشرة.","min":15,"kw":["selon","a annoncé"],"sample":"Selon la mairie, un nouveau parc a ouvert hier. Les habitants sont contents. La ville a annoncé d'autres projets pour l'année prochaine.","why":"الكتابة تُقاس بالقالب الإخباري نفسه: selon للمصدر و a annoncé للحدث، في ثلاثة أسطر لا أكثر."},{"t":"mcq","skill":"reading","q":"الهيكل الثابت للخبر يبدأ بـ:","opts":["العنوان ثم جملة الافتتاح","الخاتمة","اسم الصحفي","الصور"],"a":0,"why":"Titre ثم phrase d'accroche ثم التفاصيل."},{"t":"fill","skill":"reading","q":"أكمل: «___ la météo, il va pleuvoir.» (حسب)","fr":"___ la météo, il va pleuvoir.","ans":"Selon","alts":["selon"],"why":"selon = حسب، قالب المصدر الإخباري."}],"homework":"استمع لنشرة RFI واحدة اليوم وغداً: دون 5 كلمات جديدة في كل مرة وحاول استخدام إحداها في جملة. الدرس السابق/التالي: a2-t5-l1 (فهم الحوارات القصيرة) / a2-t5-l3 (التعلم بالأغاني).","sources":[{"title":"تعلم الفرنسية - هكذا ستفهم الأخبار باللغة الفرنسية بشكل رائع الفيديو الشامل Le Journal Télévisé","channel":"french free","videoId":"QkL1ywH2ZCI","why":"كيف تفهم نشرة الأخبار الفرنسية بالكامل — دليل عربي شامل للجملة الإخبارية ومفرداتها المتكررة.","cat":"Listening","level":"A2","main":true},{"title":"Le site de RFI pour apprendre le français avec l'actualité internationale","channel":"Français Facile - RFI","videoId":"x72SrIDgrxM","why":"جولة في موقع RFI التعليمي الرسمي — كيف تبحث عن نشرة بالفرنسية السهلة وتمريناتها المصاحبة.","cat":"Listening","level":"A2","extra":true},{"title":"Incendies en France: pompiers fatigués | Journal • Français Facile","channel":"Français Facile - RFI","videoId":"pFRDlELY188","why":"نشرة حقيقية كاملة بمستوى A2/B1 — جرّب عليها كل خطوات الدرس: استماع ثم نص ثم كلمات.","cat":"Listening","level":"A2","extra":true},{"title":"Le compas inscrit au patrimoine culturel immatériel de l'Unesco | Journal","channel":"Français Facile - RFI","videoId":"inCKS-DX2Zw","why":"نشرة ثقافية خفيفة (تراث ومهارات) — أخبار ليست كلها مأساوية: نموذج ممتع يثبّت عادة الاستماع اليومي.","cat":"Listening","level":"A2","extra":true}],"supplements":[{"id":"x72SrIDgrxM","title":"Le site de RFI pour apprendre le français avec l'actualité internationale","channel":"Français Facile - RFI","why":"جولة في موقع RFI التعليمي الرسمي — كيف تبحث عن نشرة بالفرنسية السهلة وتمريناتها المصاحبة.","lang":"fr"},{"id":"pFRDlELY188","title":"Incendies en France: pompiers fatigués | Journal • Français Facile","channel":"Français Facile - RFI","why":"نشرة حقيقية كاملة بمستوى A2/B1 — جرّب عليها كل خطوات الدرس: استماع ثم نص ثم كلمات.","lang":"fr"},{"id":"inCKS-DX2Zw","title":"Le compas inscrit au patrimoine culturel immatériel de l'Unesco | Journal","channel":"Français Facile - RFI","why":"نشرة ثقافية خفيفة (تراث ومهارات) — أخبار ليست كلها مأساوية: نموذج ممتع يثبّت عادة الاستماع اليومي.","lang":"fr"}]},{"id":"A2-t5-l3","fr":"Apprendre avec des chansons","ar":"التعلم بالأغاني","objectives":["استخدام الأغاني البسيطة لتثبيت النطق والمفردات","تدريب «املأ الفراغ» بالكلمات المسموعة","بناء قائمة أغانٍ تعليمية شخصية"],"sections":[{"h":"لماذا الأغاني تعلم بسرعة؟","p":["الأغنية تعلّم لأنها تجمع أربع ذاكرات في تمرين واحد: الكلمات، الإيقاع، المشاعر، والتكرار التلقائي. ما تسمعه 20 مرة في أسبوع دون أن تشعر أنه حفظ — الملل هنا أفضل صديق للذاكرة.","الآلية: la mélodie تحمل la parole إلى الذاكرة طويلة المدى (الموسيقى تُشفّر الكلمة)، وl'émotion (الذكريات المرتبطة بالأغنية) تمنحها سياقاً عاطفياً يقاوم النسيان. لذلك تحفظ أغنيتك المفضلة بسرعة ولا تحفظ النص مكتوباً بنفس السرعة.","تابع الفيديو الأساسي بالشرح العربي: لماذا الأغاني تُعلّم بسرعة وكيف تُستثمر — الشرح بالعربية يوضّح الجانب المعرفي، ثم تستمع إلى مقاطع فعلية بالفرنسية. مزج شرح + نموذج في مصدر واحد يختصر عليك بحثاً كاملاً.","الأغنية كنص قرائي: ابحث عن النص (les paroles) قبل السماع، اقرأه مرة مستوطناً المعنى، ثم استمع وتابع بعينك، ثم ادرس بنية الأغنية: refrain (لازمة تكرر) وcouplet (أبيات تتبدّل). النموذج الرباعي يسهّل توقّع كل سطر.","الاستثمار الذكي: اختر أغنية في مستواك (words مألوفة 70%)، اكتب 5 كلمات جديدة منها، احفظ الـ refrain كاملًا — اللازمة هي الأكثر تكراراً وأعلى عائداً. أغنية واحدة متقنة خير من عشر مسموعة سطحياً.","قائمتك الغنائية الشخصية: أنشئ قائمة (playlist) بأغنية لكل موقف — هادئة للمذاكرة، سريعة للمشي، قديمة كلاسيكية للمفردات الغنية. المزج يحمي من ضجر المقطع الواحد ويوسّع تعرّضك لأصوات ولهجات مختلفة."],"video":{"id":"GCKDHDM0q0I","title":"روتيني اليومي بالفرنسية 🎶 | أغنية تعليمية ممتعة (تعلم الفرنسية من الاغانى)","channel":"دروس فرنساوى أونلاين","why":"أغنية تعليمية بروتين يومي مترجمة — الأغنية نص قصير تحليله أسرع من أي مقال.","lang":"ar","main":true,"dur":4},"sub":[{"h":"لماذا الأغاني تُثمر بسرعة؟","p":["الموسيقى تشفر الكلمة في الذاكرة طويلة المدى.","العاطفة (ذكريات) تقاوم النسيان.","التكرار التلقائي بلا إرادة.","الأربعة ذاكرات معاً: نص، نغم، شعور، تكرار."]},{"h":"الأغنية كنص قرائي","p":["النص أولاً (les paroles) قبل السماع.","قراءة مستوطنة ثم متابعة بالعين.","refrain — لازمة متكررة، couplet — يتبدّل.","توقع السطر القادم = فهم حقيقي."]},{"h":"قائمة غنائية مُدارة","p":["أغنية في مستواك (70% مألوف).","5 كلمات جديدة لكل أغنية.","حفظ الـ refrain كاملاً أولاً.","playlist لكل موقف: مذاكرة/مشي/كلاسيكية."]}]},{"h":"الأغنية كنص قرائي","p":["تدريب «املأ الفراغ»: استمع للأغنية والنص أمامك، ثم أعد الاستماع وأخفِ النص واكتب الكلمات الناقصة. هذه هي تدريبات chansons à trous المستخدمة في فصول FLE حول العالم.","استخرج القواعد من الأغنية: «Il n'y a plus rien dans l'eau» فيها النفي المركب ne...plus + مكان y. قواعدك تمر على الأذن قبل العين — أعمق تثبيت ممكن.","عند الترجمة القسرية للأغنية احذر: الشعر يختزل ويجازف بالكلمة. اترجم المعنى العام أولاً ثم ابحث عن معنى كل كلمة في سياقها — الترجمة الحرفية للأغنية تنتج غالباً جُمل عربية مضحكة."],"video":null},{"h":"اصنع قائمتك الغنائية","p":["خطة القائمة الشخصية: أغنية للأسبوع. أول مرة استماع فقط، ثانياً مع النص، ثالثاً غناء مع إيماءات، رابعاً املأ الفراغ. أربع جلسات قصيرة وأغنية كاملة ملكك.","اختر أغانياً بطيئة ومحدودة الكلمات في هذه المرحلة (comptines، chansons enfantines). الأغاني السريعة المليئة بالعامية (rap) ملوك B2 — لا تستعجلها الآن.","الفيديو الإثرائي يشرح آلية التعلم بالموسيقى؛ أوقفه عند كل نصيحة واربطها بأغنيتك الحالية: ما الكلمات الخمس الجديدة في أغنيتك؟ ما الـ refrain؟ أعدّها الآن بورقة."],"video":null},{"h":"التطبيق والتلخيص","p":["يُختم هذا الدرس بالتعلّم عبر الأغاني: فالأغنية تجمع أربع ذاكرات في تمرين واحد (الكلمة، والإيقاع، والعاطفة، والتكرار التلقائي)، والآلية أن la mélodie تحمل les paroles إلى الذاكرة طويلة المدى و l'émotion تمنحها سياقًا يقاوم النسيان، والأغنية تُقرأ كنص: تبحث عن les paroles قبل السماع، تقرأها مستوطنة المعنى، ثم تسمع وتبني بنية الشكل (refrain لازمة تتكرر، couplet أبيات تتبدّل)، والاستثمار الذكي: أغنية في مستواك (70% مألوفة) بخمس كلمات جديدة وحفظ الـ refrain كاملًا أولًا. كما وضح الفيديو الرئيسي «روتيني اليومي بالفرنسية 🎶 | أغنية تعليمية ممتعة (تعلم الفرنسية من الاغانى)» من قناة دروس فرنساوى أونلاين على الرابط https://www.youtube.com/watch?v=GCKDHDM0q0I، تُشرح آلية التعلّم بالموسيقى بالعربية ثم يُسمع النموذج المُغنّى، وأن الأغنية الواحدة المتقنة خير من عشر مسموعة سطحيًا.","بهذا تُغلق a2-t5 ثلاثة أبواب استماع متدرّجة: ف a2-t5-l1 علّمك التقاط الموضوع من الحوارات القصيرة، و a2-t5-l2 وسّعك إلى النشرات (selon، une enquête، le bilan)، و a2-t5-l3 يثبّت ما سمعته في نصوص تُردَّد بلا ملل (refrain، couplet، les paroles)؛ وكلّه يعيد إلى الأذن ما بدأت به من a2-t4-l1 (لغة الطبيب: J'ai mal à...) و a2-t4-l2 (لغة الدعوة: avec plaisir) و a2-t4-l3 (لغة الهاتف: à l'appareil) في صيغ مسموعة. وانطلاقًا من الباب النحوي a2-t3-l6 (Il faut que tu écoutes) تنتقل بثقة إلى a2-t6-l1 حيث تصف الأشخاص والأماكن كتابةً بلغة سمعية مضبوطة.","المهمة التطبيقية: أعد مشاهدة الفيديو الرئيسي وطبّق خطة الأغنية الأربعية على أغنيتك الحالية: أول استماع للموضوع، ثاني مع les paroles، ثالث غناء مع الإيماءات، رابع املأ الفراغ؛ ثم سجّل نفسك وأنت تغني الـ refrain كاملًا أو تقرأ سطرين بإيقاع، واستمع للمقارنة بين نطقك ونطق المُغنّى — صحّح الكلمة التي خرجت عن الإيقاع أولًا، فالخطأ المُصلَح في الإيقاع يُصلح معه النطق كله."]}],"examples":[{"fr":"Une souris verte qui courait dans l'herbe.","ar":"فأر أخضر كان يجري في العشب."},{"fr":"Il n'y a plus rien dans l'eau.","ar":"لم يعد هناك شيء في الماء."},{"fr":"Vole, vole, vole papillon !","ar":"حلّق، حلّق، حلّق يا فراشة!"},{"fr":"Je chante toute la journée.","ar":"أغني طوال اليوم."},{"fr":"Je cherche les paroles de cette chanson.","ar":"أبحث عن كلمات هذه الأغنية.","note":"قبل السماع"},{"fr":"Le refrain revient trois fois.","ar":"اللازمة تتكرر ثلاث مرات.","note":"بنية الأغنية"},{"fr":"Je l'écoute en boucle pendant mes trajets.","ar":"أستمع إليها بلا توقف أثناء تنقلي.","note":"التكرار"},{"fr":"Tu traduis d'abord le sens global ?","ar":"هل تترجم المعنى العام أولاً؟","note":"الترجمة الذكية"}],"pron":[{"w":"une souris","ipa":"[yn.su.ʁi]","approx":"أون-سوري"},{"w":"l'herbe","ipa":"[lɛʁb]","approx":"لِرب"},{"w":"vole","ipa":"[vɔl]","approx":"فول"}],"vocab":[{"fr":"une comptine","ar":"أغنية أطفال","pos":"nom","g":"f","pl":"des comptines","ipa":"[kɔ̃.tin]","exFr":"Les comptines apprennent la langue.","exAr":"أغاني الأطفال تعلّم اللغة."},{"fr":"chanter","ar":"يغني","pos":"verbe","ipa":"[ʃɑ̃.te]","exFr":"Je chante sous la douche.","exAr":"أغني في الدش."},{"fr":"le refrain","ar":"اللازمة","pos":"nom","g":"m","pl":"les refrains","ipa":"[ʁə.fʁɛ̃]","exFr":"Le refrain se répète souvent.","exAr":"اللازمة تتكرر كثيراً."},{"fr":"les paroles","ar":"الكلمات (الأغنية)","pos":"nom","g":"fpl","ipa":"[le.pa.ʁɔl]","exFr":"J'ai lu les paroles de la chanson.","exAr":"قرأت كلمات الأغنية."},{"fr":"une chanson","ar":"أغنية","pos":"nom","g":"f","pl":"des chansons","ipa":"[ʃɑ̃.sɔ̃]","exFr":"Cette chanson est facile.","exAr":"هذه الأغنية سهلة."},{"fr":"le rythme","ar":"الإيقاع","pos":"nom","g":"m","pl":"les rythmes","ipa":"[ʁitm]","exFr":"Le rythme aide la mémoire.","exAr":"الإيقاع يساعد الذاكرة."},{"fr":"un refrain","ar":"اللازمة (في الأغنية)","pos":"nom","g":"m","exFr":"Le refrain est accrocheur.","ipa":"[ʁəfrɛ̃]","exAr":"اللازمة جذابة."},{"fr":"un couplet","ar":"أبيات/مقطف","pos":"nom","g":"m","exFr":"Le premier couplet est doux.","ipa":"[kuplɛ]","exAr":"المقطف الأول هادئ."},{"fr":"la mélodie","ar":"اللحن","pos":"nom","g":"f","exFr":"La mélodie est facile.","ipa":"[melɔdi]","exAr":"اللحن سهل."},{"fr":"traduire","ar":"يترجم","pos":"verbe","g":"irr","exFr":"Tu traduis la chanson ?","ipa":"[tʁadɥiʁ]","exAr":"هل تترجم الأغنية؟"},{"fr":"un artiste","ar":"فنان","pos":"nom","g":"m","exFr":"Mon artiste préféré.","ipa":"[aʁist]","exAr":"فناني المفضل."},{"fr":"écouter en boucle","ar":"يسمع بلا توقف","pos":"locution","exFr":"J'écoute cette chanson en boucle.","ipa":"[ekute ɑ̃ bukl]","exAr":"أستمع لهذه الأغنية بلا توقف."},{"fr":"un sens / le sens des mots","ar":"المعنى/معنى الكلمات","pos":"nom","g":"m","exFr":"Je comprends le sens global.","ipa":"[sɑ̃s]","exAr":"أفهم المعنى العام."},{"fr":"difficile / facile","ar":"صعب / سهل","pos":"adj","exFr":"Cette chanson est facile.","ipa":"[fisil]","exAr":"هذه الأغنية سهلة."},{"fr":"la chanson","ar":"الأغنية","pos":"nom","g":"f","exFr":"J'aime cette chanson.","ipa":"[ʃɑ̃sɔ̃]","exAr":"أحب هذه الأغنية."}],"grammar":[{"tFr":"Les structures typiques des chansons","tAr":"القاعدة: تراكيب الأغاني الشائعة","body":["في الأغاني: présent للحالة («Je marche seul»)، futur للوعد («On se reverra»)، وsubjonctif للعاطفة («Bien qu'il pleuve»).","الضمائر غالبًا مفقودة في الشِّعر (prose vs chanson): «(Je) t'aime» — لا تُفاجأ بحذف les pronoms في النص."],"ex":[{"fr":"Tu m'as manqué — رائجة في كل أغنية فرنسية.","ar":"اشتقت إليك — شائعة في كل أغنية."},{"fr":"On se reverra un jour.","ar":"سنلتقي يوماً ما."}]}],"mistakes":[{"wrong":"حفظ النص مكتوباً بلا استماع","right":"النص + السماع معاً","why":"النطق المكتوب وحده يُنتج فرنسياً مقروءاً لا مسموعاً."},{"wrong":"ترجمة حرفية لكل سطر","right":"المعنى العام أولاً ثم المفردات","why":"الشعر يختزل — الحرفية تُفسد المعنى."},{"wrong":"10 أغاني سطحياً","right":"أغنية متقنة بالكامل","why":"التعمق بأغنية واحدة يبني المفردات أعمق من التوسع السطحي."},{"wrong":"الاستماع للإيقاع فقط","right":"متابعة النص بالعين أثناء السماع","why":"ربط الصوت بالحرف يدرّب الوعي الصوتي (décodage)."}],"dialogues":[{"title":"نقاش حول أغنية","ctx":"صديقان في طريقهما للعمل","lines":[{"who":"Yasmine","fr":"Tu connais cette chanson ?","ar":"هل تعرف هذه الأغنية؟"},{"who":"Thomas","fr":"Oui, le refrain est facile.","ar":"نعم، اللازمة سهلة."},{"who":"Yasmine","fr":"Tu comprends les paroles ?","ar":"هل تفهم الكلمات؟"},{"who":"Thomas","fr":"L'essentiel, pas tout. Je cherche les mots nouveaux.","ar":"الجوهر لا كل شيء. أبحث عن الكلمات الجديدة."},{"who":"Yasmine","fr":"Je l'écoute en boucle, elle reste en tête.","ar":"أستمع إليها بلا توقف، تبقى في رأسي."},{"who":"Thomas","fr":"Moi aussi, c'est mieux que les listes de vocabulaire.","ar":"وأنا كذلك، هذا أفضل من قوائم المفردات."}]}],"exercises":[{"t":"listen","skill":"listening","q":"استمع واختر الأغنية الصحيحة:","audio":"Une souris verte qui courait dans l'herbe","opts":["الفأر الأخضر","التماسيح","الفراشة","الأيل الكبير"],"a":0,"why":"المقطع هو لازمة Une souris verte — التقاط المفردة (souris = فأر) من الصوت وحده يكشف الاختيار."},{"t":"fill","skill":"listening","q":"أكمل لازمة الأغنية: «Une souris verte qui courait dans ___.»","fr":"Une souris verte qui courait dans ___.","ans":"l'herbe","alts":["l herbe","herbe"],"why":"من نص الأغنية الشهيرة."},{"t":"mcq","skill":"grammar","q":"«Il n'y a plus rien» — ما تركيب النفي هنا؟","opts":["ne...pas","ne...plus مع y","ne...jamais","ne...rien مع y"],"a":1,"why":"ne...plus (لم يعد) مع y (هناك)."},{"t":"mcq","skill":"listening","q":"ترتيب تدريب الأغنية الصحيح:","opts":["غناء ثم استماع ثم نص","استماع ثم نص ثم غناء ثم إملاء الفراغات","إملاء أولاً ثم استماع","غناء فقط يكفي"],"a":1,"why":"التدرج: أذن ← عين ← صوت ← كتابة."},{"t":"listen","skill":"listening","q":"استمع واختر ماذا يُطلب من الفراشة أن تفعل:","audio":"Vole, vole, vole papillon","opts":["حلّق يا فراشة","اركض يا فأر","اذهب يا أسد","اذهب يا طائر"],"a":0,"why":"الفعل vole يعيد نفسه ثلاثًا — إنه أمرٌ بحلق، والاسم papillon هو الفراشة."},{"t":"speaking","skill":"speaking","q":"غنِّ اللازمة التي تحفظها صوتياً أو اقرأ سطرين منها بإيقاع.","target":"Une souris verte qui courait dans l'herbe","why":"الغناء بصوت عالٍ يثبّت الإيقاع والنطق معًا — جوهر التعلّم بالأغاني في هذا الدرس."},{"t":"mcq","skill":"listening","q":"الجزء المتكرر في الأغنية يسمى:","opts":["refrain","couplet","titre","version"],"a":0,"why":"اللازمة تعود في كل مرة وتحمل المفردات الأكثر تكراراً."},{"t":"fill","skill":"listening","q":"أكمل: «Je cherche les ___ de cette chanson.»","fr":"Je cherche les ___ de cette chanson.","ans":"paroles","alts":["Paroles"],"why":"les paroles = كلمات الأغنية."}],"homework":"اختر أغنية أطفال فرنسية واحدة واجعلها «أغنية الأسبوع»: 4 جلسات قصيرة حسب خطة الدرس، ثم املأ فراغاتها بنفسك. الدرس السابق/التالي: a2-t5-l2 (الأخبار بالفرنسية السهلة) / a2-t6-l1 (وصف الأشخاص والأماكن).","sources":[{"title":"روتيني اليومي بالفرنسية 🎶 | أغنية تعليمية ممتعة (تعلم الفرنسية من الاغانى)","channel":"دروس فرنساوى أونلاين","videoId":"GCKDHDM0q0I","why":"أغنية تعليمية بروتين يومي مترجمة — الأغنية نص قصير تحليله أسرع من أي مقال.","cat":"Listening","level":"A2","main":true},{"title":"Une souris verte - Comptine traditionnelle avec paroles","channel":"Didier Jeunesse - Des comptines et des histoires","videoId":"XvTQJM7mh28","why":"أشهر أغنية أطفال فرنسية بكلمات معروضة — هذا بالضبط ما تعلّم به الأطفال الفرنسيون النطق والمفردات.","cat":"Listening","level":"A2","extra":true},{"title":"Ah Les Crocodiles - Chansons et Comptines pour Bébé","channel":"HeyKids - Chansons Pour Enfants","videoId":"gM2Vkfeh1eA","why":"أغنية التماسيح الشهيرة: قصة ممتعة + أرقام وأفعال بالنفي (n'y a plus) — تدريب سمعي مضحك لا يمل منه أحد.","cat":"Listening","level":"A2","extra":true},{"title":"Vole, vole, vole papillon - Comptine avec gestes pour enfants","channel":"Boutchoo!","videoId":"1kq88XtHOEA","why":"أغنية مع إيماءات (comptine avec gestes) — الحركة مع الكلمة تثبت المفردة في الذاكرة الحركية، طريقة الطفولة الفرنسية الحقيقية.","cat":"Listening","level":"A2","extra":true}],"supplements":[{"id":"XvTQJM7mh28","title":"Une souris verte - Comptine traditionnelle avec paroles","channel":"Didier Jeunesse - Des comptines et des histoires","why":"أشهر أغنية أطفال فرنسية بكلمات معروضة — هذا بالضبط ما تعلّم به الأطفال الفرنسيون النطق والمفردات.","lang":"fr"},{"id":"gM2Vkfeh1eA","title":"Ah Les Crocodiles - Chansons et Comptines pour Bébé","channel":"HeyKids - Chansons Pour Enfants","why":"أغنية التماسيح الشهيرة: قصة ممتعة + أرقام وأفعال بالنفي (n'y a plus) — تدريب سمعي مضحك لا يمل منه أحد.","lang":"fr"},{"id":"1kq88XtHOEA","title":"Vole, vole, vole papillon - Comptine avec gestes pour enfants","channel":"Boutchoo!","why":"أغنية مع إيماءات (comptine avec gestes) — الحركة مع الكلمة تثبت المفردة في الذاكرة الحركية، طريقة الطفولة الفرنسية الحقيقية.","lang":"fr"}]}]},{"id":"a2-t6","slug":"writing","icon":"✒️","color":"#0D9488","fr":"Expression écrite","ar":"مسار الكتابة والتعبير","desc":"من الكلمات إلى النصوص: وصف الأشخاص والأماكن، التعبير عن الرأي بأدب، وصياغة الرسائل الرسمية وغير الرسمية — كتابتك تصبح فرنسية حقيقية.","lessons":[{"id":"A2-t6-l1","fr":"Décrire les personnes et les lieux","ar":"وصف الأشخاص والأماكن","objectives":["وصف المظهر الجسدي","وصف شخصية الناس","وصف المدن والأحياء"],"sections":[{"h":"المظهر الجسدي","p":["الوصف الفرنسي يبدأ بالهيكل لا بالمفردات: ماذا أصف؟ (مظهر/شخصية/مدينة) ثم بأي ترتيب؟ (عام ← تفصيل) ثم بأي صيغة؟ (Il est / Elle a / La ville est). من يرتب الفكرة قبل الكلمات يتكلم دقيقة كاملة بلا توقف.","المظهر الجسدي بصيغتين: صفة بعد être (Il est grand, mince, brun — وهو طويل، نحيف، أسمر) وخاصية بعد avoir (Elle a les yeux bleus, les cheveux courts — لديها عيون زرقاء، شعر قصير). فرقتان صغيرتان تصنعان كلا الوصفين.","تابع الفيديو الأساسي بالشرح العربي: وصف المظهر والشخصية بجرد عربي ثم بناء فرنسي. المزج (وصف بالعربية ثم صياغة بالفرنسية) يثبت الترتيب: أولاً فكر في الصورة ثم حوّلها إلى Il est / Elle a.","الشخصية أوسع من المظهر وأصعب: généreux (كريم)، timide (خجول)، ambitieux (طموح)، drôle (مضحك)، sérieux (جاد). أضف سلوكاً شاهداً لكل صفة: «Il est généreux — il aide toujours les autres» — الصفة وحدها تُنسى، والشاهد يبقى.","وصف المدن قالب ثابت: الموقع d'abord (La ville est située au sud de la France)، ثم الحجم (une petite ville / une grande métropole)، ثم الطابع (animée, calme, touristique)، ثم رأيك الشخصي (j'aime / je préfère). أربع خطوات تصف أي مدينة في أوروبا.","أدوات الربط للوصف المتقدم: d'abord (أولاً)، ensuite (ثم)، de plus (بالإضافة)، enfin (أخيراً)، par contre (بخلاف ذلك). الفصل بالكلمات الربطية يرفع وصفك من قائمة كلمات إلى فقرة متماسكة — وهذا بالضبط ما يُقيَّم في DELF."],"video":{"id":"4O7cuWHKCN0","title":"كيف تصف شخص بالفرنسية بكامل مواصفاته (نحيف، واثق، مبتهج،عينان..الخ) Décrire Une Personne","channel":"french free","why":"منهجية وصف الشخص كاملًا بالعربية: المظهر ثم الشخصية — بالترتيب المطلوب في الإنتاج الكتابي.","lang":"ar","main":true,"dur":10},"sub":[{"h":"المظهر: être + صفات / avoir + خصائص","p":["Il est grand / mince / brun.","Elle a les yeux bleus / les cheveux longs.","الصفة تتبع الجنس: grand / grande.","الترتيب: الهيئة ثم التفاصيل."]},{"h":"الشخصية بشاهد","p":["généreux — يساعد الآخرين دائماً.","timide — يتردد في التحدث.","ambitieux — يضع أهدافاً كبيرة.","الصفة + دليل سلوك = وصف حيّ."]},{"h":"قالب المدينة الأربعي","p":["الموقع: est située au sud de...","الحجم: petite ville / grande métropole.","الطابع: animée, calme, touristique.","الرأي: j'aime car... / je préfère... à..."]}]},{"h":"الشخصية","p":["sympa (لطيف - informal)، gentil (لطيف)، sérieux (جدي)، drôle (مضحك)، bavard (ثرثار)، timide (خجول)، courageux (شجاع)، paresseux (كسول)، travailleur (مجتهد).","مثال: Mon ami Karim est très drôle et généreux. Ma sœur est sérieuse et travailleuse.","الصفات الفرنسية تُسبَق ولا تُتَبَّع: أضفها بعد être مباشرة ولا تقل «elle est intelligente une fille» — الترتيب الخاطئ أكثر خطأ شائعًا عند الناطقين بالعربية."],"video":null},{"h":"وصف المدن","p":["animée (حيوية)، calme (هادئة)، moderne، historique، polluée (ملوثة)، propre (نظيفة) / sale (قذرة)، bruyante (مزعجة).","نموذج: «Mon quartier est calme et vert. Il y a un parc, des cafés et un marché le vendredi. C'est un peu loin du centre mais les transports sont pratiques.»","أوقف الفيديو الإثرائي عند كل صورة واكتب وصفاً من جملتين (être/avoir) خلال 20 ثانية. سرعة الوصف القصير هي ما يُطلب في المقابلة الشفوية."],"video":null},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: الوصف الفرنسي يُبنى على هيكل ثابت — المظهر بـ être/avoir، ثم الشخصية بشاهد سلوكي، ثم المدينة بأربع خطوات (الموقع، الحجم، الطابع، الرأي). أعد مشاهدة الفيديو الأساسي «كيف تصف شخص بالفرنسية» (رابطه في مصادر الدرس) وركّز على ترتيب العام قبل التفصيل قبل أن تكتب.","جسر المهارات: ما بنيته في الاستماع (A2-t5-l3) ينتقل الآن إلى مسار الكتابة: وصف الأشخاص هنا (A2-t6-l1) ← التعبير عن الرأي (A2-t6-l2) ← كتابة الرسائل (A2-t6-l3) ← ثم أولى حلقات Reflets (a2-t7-l1). كل حلقة تضيف أداة على السابقة: وصف ← رأي ← رسالة ← محادثة مشاهد.","إعادة المشاهدة والتسجيل: أعد مشاهدة مشهد وصفي من الفيديو الأساسي، ثم سجّل 30 ثانية تصف فيها شخصاً تعرفه — المظهر ثم الشخصية — مع استخدام d'abord/ensuite مرتين على الأقل، وقارن نبرتك بأصل الفيديو."]}],"examples":[{"fr":"Il a les cheveux courts et les yeux marron.","ar":"شعره قصير وعيناه بنيتان."},{"fr":"Ma prof est très sympa mais un peu stricte.","ar":"معلمتي لطيفة جداً لكن صارمة قليلاً."},{"fr":"La ville est belle mais très bruyante.","ar":"المدينة جميلة لكن مزعجة جداً."},{"fr":"Mon quartier est calme et pratique.","ar":"حيي هادئ وعملي."},{"fr":"Il est grand, mince, avec les yeux bruns.","ar":"طويل، نحيف، وعيناه بنيتان.","note":"المظهر"},{"fr":"Elle a le sourire gentil.","ar":"ابتسامتها لطيفة.","note":"avoir + خاصية"},{"fr":"La ville est située au sud, près de la mer.","ar":"المدينة تقع جنوباً قرب البحر.","note":"الموقع"},{"fr":"D'abord calme, le quartier devient animé le soir.","ar":"هادئ أولاً، يصبح حيوياً مساءً.","note":"ربط الوصف"}],"pron":[{"w":"sympa","ipa":"[sɛ̃.pa]","approx":"سانبا","note":"اختصار sympathique"},{"w":"gentil","ipa":"[ʒɑ̃.ti]","approx":"جانتي","note":"l صامتة في المذكر"},{"w":"bruyante","ipa":"[bʁɥi.jɑ̃t]","approx":"برويانت"}],"vocab":[{"fr":"sympa","ar":"لطيف / ودود","pos":"adj","g":"mf","ipa":"[sɛ̃.pa]","exFr":"Il est très sympa.","exAr":"إنه لطيف جداً."},{"fr":"drôle","ar":"مضحك","pos":"adj","g":"mf","ipa":"[dʁol]","exFr":"Ce film est drôle.","exAr":"هذا الفيلم مضحك."},{"fr":"timide","ar":"خجول","pos":"adj","g":"mf","ipa":"[ti.mid]","exFr":"Elle est un peu timide.","exAr":"إنها خجولة قليلاً."},{"fr":"généreux / généreuse","ar":"كريم / كريمة","pos":"adj","g":"mf","ipa":"[ʒe.ne.ʁø / ʒe.ne.ʁøz]","exFr":"C'est un homme généreux.","exAr":"إنه رجل كريم."},{"fr":"animé / animée","ar":"حيوي / حيوية","pos":"adj","g":"mf","ipa":"[a.ni.me]","exFr":"Un quartier animé.","exAr":"حي حيوي."},{"fr":"bruyant / bruyante","ar":"مزعج / مزعجة","pos":"adj","g":"mf","ipa":"[bʁɥi.jɑ̃]","exFr":"La rue est bruyante.","exAr":"الشارع مزعج."},{"fr":"mince","ar":"نحيف","pos":"adj","exFr":"Il est mince et grand.","ipa":"[mɛ̃s]","exAr":"هو نحيف وطويل."},{"fr":"les cheveux","ar":"الشعر","pos":"nom","g":"m","exFr":"Elle a les cheveux longs.","ipa":"[lə ʃəvø]","exAr":"شعرها طويل."},{"fr":"le caractère","ar":"الطبع/الشخصية","pos":"nom","g":"m","exFr":"Il a un bon caractère.","ipa":"[kaʁaktɛʁ]","exAr":"طبعه حسن."},{"fr":"généreux(se)","ar":"كريم","pos":"adj","exFr":"Elle est très généreuse.","ipa":"[ʒeneʁø]","exAr":"هي كريمة جداً."},{"fr":"ambitieux(se)","ar":"طموح","pos":"adj","exFr":"Elle est ambitieuse.","ipa":"[ɑ̃bisjø]","exAr":"هي طموحة."},{"fr":"situé(e)","ar":"يقع (موقع)","pos":"adj","exFr":"La ville est située au nord.","ipa":"[sitye]","exAr":"المدينة تقع شمالاً."},{"fr":"pittoresque","ar":"بديع/جميل الطبيعة","pos":"adj","exFr":"Un village pittoresque.","ipa":"[pitɔʁɛsk]","exAr":"قرية بديعة."},{"fr":"d'abord / ensuite / enfin","ar":"أولاً / ثم / أخيراً","pos":"locution","exFr":"D'abord le général, ensuite le détail.","ipa":"[dabɔʁ]","exAr":"أولاً العام ثم التفصيل."},{"fr":"élégant / élégante","ar":"أنيق / أنيقة","pos":"adj","g":"mf","exFr":"Il est élégant en costume.","ipa":"[e.le.ɡɑ̃]","exAr":"إنه أنيق ببذلته."}],"grammar":[{"tFr":"Décrire : être, avoir et la place de l'adjectif","tAr":"القاعدة: أفعال الوصف ومكان الصفة","body":["être + صفة (الحالة العامة) / avoir + جزء (الممتلكات الجسمية). الصفة بعد الفعل مباشرة وتتوافق في الجنس والعدد.","الترتيب: general → détail، وأدوات الربط d'abord/ensuite/enfin تبني الفقرة."],"ex":[{"fr":"Ma sœur a les cheveux noirs et est très dynamique.","ar":"أختي شعرها أسود وهي نشيطة جداً."},{"fr":"Cette ville est calme mais animée le week-end.","ar":"هذه المدينة هادئة لكنها حيوية في العطلة."}]}],"mistakes":[{"wrong":"une fille intelligente elle est","right":"elle est intelligente","why":"الصفة تتبع الفعل ولا تسبقه في الجملة الفرنسية."},{"wrong":"Il a grand (للعبور)","right":"Il est grand","why":"المظهر العام مع être؛ avoir للجذع والأطراف."},{"wrong":"وصف بلا ترتيب","right":"عام ثم تفصيل مع d'abord/ensuite","why":"العشوائية تُضعف الانطباع وتُظهر ترجمة ذهنية."},{"wrong":"صفة بلا شاهد للشخصية","right":"الصفة + دليل سلوك","why":"الصفة مجردة تُنسى — الشاهد يجعلها حية ومفيدة."}],"dialogues":[{"title":"وصف زميل جديد","ctx":"طالبتان تتحدثان عن زميل","lines":[{"who":"Amina","fr":"Tu as vu le nouveau ?","ar":"هل رأيت الجديد؟"},{"who":"Sofia","fr":"Oui, il est grand et mince, avec les cheveux bruns.","ar":"نعم، طويل ونحيف وشعره بني."},{"who":"Amina","fr":"Et son caractère ?","ar":"وطبعه؟"},{"who":"Sofia","fr":"Il est timide au début, mais très généreux.","ar":"خجول في البداية لكنه كريم جداً."},{"who":"Amina","fr":"Il parle quelle langue ?","ar":"أي لغة يتكلم؟"},{"who":"Sofia","fr":"Le français et l'anglais. Il est ambitieux aussi.","ar":"الفرنسية والإنجليزية. وهو طموح أيضاً."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"«شعرها طويل» بالفرنسية:","opts":["Elle est les cheveux longs","Elle a les cheveux longs","Elle a le cheveux long","Elle est cheveux longs"],"a":1,"why":"أجزاء الجسم ← avoir."},{"t":"fill","skill":"vocabulary","q":"أكمل: «Mon quartier est ___ et vert.» (هادئ)","fr":"Mon quartier est ___ et vert.","ans":"calme","why":"calme = هادئ."},{"t":"mcq","skill":"vocabulary","q":"ما عكس «timide» تقريباً؟","opts":["drôle","bavard","sérieux","paresseux"],"a":1,"why":"bavard (ثرثار) عكس الخجول الذي لا يتكلم."},{"t":"listen","skill":"listening","q":"استمع واختر وصف الشخص:","audio":"Il est grand, il a les cheveux courts et il est très drôle","opts":["طويل قصير الشعر مضحك","قصير طويل الشعر جدي","طويل طويل الشعر خجول","نحيف عيون زرقاء لطيف"],"a":0,"why":"الوصف الكامل يتضمن الطول والشعر والطباع — الإصابة بالخيار الأول تثبت التمييز السمعي."},{"t":"writing","skill":"writing","q":"اوصف صديقاً لك في 4 أسطر: المظهر والشخصية.","min":16,"kw":["il","elle","est","a"],"sample":"Mon ami Yassine est grand et mince. Il a les cheveux noirs et les yeux marron. Il est très drôle et généreux. C'est la personne la plus sympathique que je connaisse.","why":"الكتابة الوصفية تُقيَّم على الترتيب: المظهر بـ être/avoir ثم الشخصية بشاهد."},{"t":"speaking","skill":"speaking","q":"اوصف مدينتك بجملتين صوتياً.","target":"Ma ville est animée et belle","why":"الوصف الشفوي يبدأ بالجملة القصيرة الثابتة — النطق الصحيح للقالب أهم من الطول."},{"t":"mcq","skill":"writing","q":"الوصف بـ «Elle a les yeux bleus» يستعمل فعل:","opts":["avoir","être","faire","aller"],"a":0,"why":"الممتلكات الجسمية (الشعر، العيون) مع avoir."},{"t":"fill","skill":"writing","q":"أكمل: «La ville est ___ au sud de la France.» (يقع)","fr":"La ville est ___ au sud de la France.","ans":"située","alts":["Située","situee","SITUEE"],"why":"situé يتوافق مع la ville = située."}],"homework":"اوصف شخصين من عائلتك ومكانين في مدينتك بجملة لكل واحد.\nسلسلة A2: A2-t5-l3 ← A2-t6-l1 → A2-t6-l2","sources":[{"title":"كيف تصف شخص بالفرنسية بكامل مواصفاته (نحيف، واثق، مبتهج،عينان..الخ) Décrire Une Personne","channel":"french free","videoId":"4O7cuWHKCN0","why":"منهجية وصف الشخص كاملًا بالعربية: المظهر ثم الشخصية — بالترتيب المطلوب في الإنتاج الكتابي.","cat":"Writing","level":"A2","main":true},{"title":"Comment décrire le physique d'une personne en français - Niveau A1 de FLE","channel":"La prof Elisabeth","videoId":"CIO1F1PNgpU","why":"وصف المظهر بالصور والجمل الجاهزة من أستاذة FLE — أساس بصري يثبت المفردات قبل الكتابة.","cat":"Writing","level":"A2","extra":true},{"title":"Vocabulaire: Le caractère / la personnalité (adjectifs au féminin et au masculin)","channel":"Maprofde FLE","videoId":"0pimETJHv4g","why":"صفات الشخصية بصيغتي المذكر والمؤنث معاً — يحل فوراً مشكلة المطابقة التي تظهر في كل كتابة وصفية.","cat":"Writing","level":"A2","extra":true},{"title":"House Vocabulary For Beginners in French | Super Easy French","channel":"Easy French","videoId":"UXMB6Ms_2Uw","why":"جولة في منزل بفرنسية سهلة — يشغّل مفردات الأماكن بصرياً ويمهد لكتابة وصف الحي والمدينة بأسلوب طبيعي.","cat":"Writing","level":"A2","extra":true}],"supplements":[{"id":"CIO1F1PNgpU","title":"Comment décrire le physique d'une personne en français - Niveau A1 de FLE","channel":"La prof Elisabeth","why":"وصف المظهر بالصور والجمل الجاهزة من أستاذة FLE — أساس بصري يثبت المفردات قبل الكتابة.","lang":"fr"},{"id":"0pimETJHv4g","title":"Vocabulaire: Le caractère / la personnalité (adjectifs au féminin et au masculin)","channel":"Maprofde FLE","why":"صفات الشخصية بصيغتي المذكر والمؤنث معاً — يحل فوراً مشكلة المطابقة التي تظهر في كل كتابة وصفية.","lang":"fr"},{"id":"UXMB6Ms_2Uw","title":"House Vocabulary For Beginners in French | Super Easy French","channel":"Easy French","why":"جولة في منزل بفرنسية سهلة — يشغّل مفردات الأماكن بصرياً ويمهد لكتابة وصف الحي والمدينة بأسلوب طبيعي.","lang":"fr"}]},{"id":"A2-t6-l2","fr":"Donner son opinion","ar":"التعبير عن الرأي","objectives":["استخدام عبارات الرأي الأساسية","الموافقة والمعارضة بأدب","ربط السبب والنتيجة"],"sections":[{"h":"عبارات الرأي","p":["الرأي في الفرنسية يُفتح بعبارات جاهزة درجة قياسها: «À mon avis...» (برأيي)، «Je pense que...» (أعتقد أن)، «Je trouve que...» (أجد أن)، «Pour moi...» (من وجهة نظري). أربع بدايات تغنيك عن صمت المقالة الأولى ثانية.","فرق دقيق يرفع مستواك: «Je trouve que» تُستعمل لتقدير شخصي سريع (Je trouve que c'est bien) و«Je pense que» لاعتقاد مُستفاد (Je pense qu'il a raison). كلاهما تأخذ que متبوعة بالفعل المُصرَّف، لا بالمصدر.","تابع الفيديو الأساسي بالشرح العربي: تعبيرات الرأي مبنية بالعربية ثم بالفرنسية مع أمثلة حوارية. الفرنسية تحب الرأي «المُعلَّل» — كل رأي يتبعه «parce que...» أو «car...»؛ رأي بلا سبب يبدو سطحياً في النقاش.","الموافقة والمعارضة بأدب: «Je suis tout à fait d'accord» (موافق تماماً) ثم «Par contre, je ne suis pas d'accord» (لكنني لا أوافق). لاحظ التخفيف: «Je ne suis pas sûr(e) que...» أرقّ من النفي المباشر — التحفّظ فن اجتماعي.","الأدوات المنطقية: «En effet» (فعلاً/إذ)، «C'est vrai que...» (صحيح أن)، «Néanmoins» (ومع ذلك)، «De plus» (بالإضافة)، «Par conséquent» (وبالتالي). خمس كلمات تبني حجة كاملة: وجهة نظر ← تأكيد ← استدراك ← إضافة ← نتيجة.","المواقف الحية: تقييم فيلم («Le film est bien, mais la fin est prévisible»)، طقس («Il fait beau, sauf qu'il vente»)، مقترح («Pourquoi pas aller au musée ؟»). ثلاث مواقف يومية تحتاج رأياً — تدرّب عليها بصوت عالٍ لا بعينك."],"video":{"id":"MPAFVH4CWrE","title":"كيف تعبر بالفرنسية عن : الرأي، الإتفاق و الإختلاف.","channel":"الحصة - La Séance","why":"الرأي والموافقة والمعارضة في فيديو واحد بالعربية — عبارات الربط التي يحتاجها نص الرأي.","lang":"ar","main":true,"dur":5},"sub":[{"h":"حزمة الافتتاح","p":["À mon avis... — رأيي.","Je pense que... — أعتقد أن (اعتقاد).","Je trouve que... — أجد أن (تقدير سريع).","Pour moi... — من وجهة نظري."]},{"h":"الموافقة والمفارقة","p":["Je suis tout à fait d'accord.","C'est exactement ça — تمامًا ذلك.","Par contre, je ne suis pas d'accord.","Je ne suis pas sûr(e) que... — تحفظ مهذّب."]},{"h":"سلسلة الحجة","p":["En effet / C'est vrai que... — تأكيد.","Néanmoins / Par contre — استدراك.","De plus — إضافة.","Par conséquent — نتيجة."]}]},{"h":"الموافقة والمعارضة","p":["الموافقة: Je suis d'accord (أوافق)، C'est vrai (صحيح)، Tout à fait (تماماً)، Exactement (بالضبط).","المعارضة مهذبة: Je ne suis pas d'accord (لا أوافق)، Je ne pense pas (لا أرى ذلك)، Peut-être, mais... (ربما لكن...).","معارضة مهذّبة كاملة: «Je comprends ton point de vue, mais...» ثم رأيك — الاعتراف برأي الطرف قبل الرفض هو شرط الحوار المقبول اجتماعياً، وقد يحسم نقاشاً كان سيشتد."],"video":null},{"h":"السبب والنتيجة","p":["parce que (لأن)، car (لأنّ)، donc (لذلك)، alors (إذن)، mais (لكن)، même si (حتى لو).","نموذج نقاش: «Je pense que c'est une bonne idée, parce que c'est pratique. Mais, je ne suis pas d'accord sur le prix, donc on doit discuter.»","أوقف الفيديو الإثرائي عند كل عبارة رأي واكتب لها جملاً من حياتك خلال 10 ثوانٍ — قيّم فيديو، طعاماً، جدلاً واحداً. ثلاثة رأيّات يومياً تجعل العبارات تلقائية."],"video":null},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: الرأي الفرنسي لا يُقال مجرّداً — يُفتتح بعبارة جاهزة (À mon avis / Je trouve que / Pour moi)، ويُعلَّل بـ parce que، ويُدار بالموافقة والمعارضة المهذّبة. أعد مشاهدة الفيديو الأساسي «كيف تعبر بالفرنسية عن الرأي والاتفاق والاختلاف» (رابطه في مصادر الدرس) واكتب خمس عبارات رأي من الذاكرة.","جسر المهارات: من وصف الأشخاص (A2-t6-l1) ينتقل المهارة إلى رأيك الشخصي هنا (A2-t6-l2)، ثم إلى رسالة تحتاج رأياً مكتوباً ومعلّلاً (A2-t6-l3)، فالمحادثة الحيّة في أولى حلقات Reflets (a2-t7-l1) حيث تدافع عن رأيك شفهياً.","إعادة المشاهدة والتسجيل: أعد مشاهدة الفيديو الأساسي، ثم سجّل دقيقة تناقش فيها فيلماً شاهدته بثلاث صيغ إلزامية: افتتاح رأي + سبب بـ parce que + مفارقة بـ par contre أو néanmoins."]}],"examples":[{"fr":"Je pense que c'est une excellente idée.","ar":"أرى أنها فكرة ممتازة."},{"fr":"À mon avis, c'est trop cher.","ar":"في رأيي إنها غالية جداً."},{"fr":"Je suis d'accord avec toi.","ar":"أوافقك الرأي."},{"fr":"Peut-être, mais c'est pratique.","ar":"ربما، لكنها عملية."},{"fr":"À mon avis, ce restaurant est excellent.","ar":"برأيي، هذا المطعم ممتاز.","note":"افتتاح"},{"fr":"Je ne suis pas sûr qu'il vienne.","ar":"لست متأكداً أنه سيأتي.","note":"تحفّظ"},{"fr":"C'est vrai que c'est cher, mais c'est bon.","ar":"صحيح إنه غالٍ لكنه لذيذ.","note":"إقرار + مفارقة"},{"fr":"Par conséquent, nous avons décidé d'attendre.","ar":"وبالتالي قررنا الانتظار.","note":"النتيجة"}],"pron":[{"w":"À mon avis","ipa":"[a.mɔ̃.na.vi]","approx":"آ-مون-نافي"},{"w":"d'accord","ipa":"[da.kɔʁ]","approx":"داكور"},{"w":"peut-être","ipa":"[po.tɛtʁ]","approx":"بو-تيتر"}],"vocab":[{"fr":"je pense que","ar":"أرى أن","pos":"expression","ipa":"[ʒə.pɑ̃s.kə]","exFr":"Je pense que oui.","exAr":"أرى ذلك."},{"fr":"être d'accord","ar":"يوافق","pos":"expression","ipa":"[ɛtʁ da.kɔʁ]","exFr":"Je suis d'accord.","exAr":"أوافق."},{"fr":"à mon avis","ar":"في رأيي","pos":"expression","ipa":"[a.mɔ̃.na.vi]","exFr":"À mon avis, c'est bon.","exAr":"في رأيي إنه جيد."},{"fr":"je trouve que","ar":"أجد أن","pos":"expression","ipa":"[ʒə.tʁuv.kə]","exFr":"Je trouve que c'est utile.","exAr":"أجده مفيداً."},{"fr":"peut-être","ar":"ربما","pos":"adv","ipa":"[po.tɛtʁ]","exFr":"Peut-être demain.","exAr":"ربما غداً."},{"fr":"donc","ar":"لذلك / إذن","pos":"conjonction","ipa":"[dɔ̃k]","exFr":"Je suis fatigué, donc je reste.","exAr":"أنا متعب لذلك أبقى."},{"fr":"par contre","ar":"لكن/بخلاف ذلك","pos":"locution","exFr":"C'est bien, par contre cher.","ipa":"[paʁ tɔ̃tʁ]","exAr":"إنه جيد لكنه غالٍ."},{"fr":"néanmoins","ar":"ومع ذلك","pos":"adv","exFr":"Il est tard, néanmoins on sort.","ipa":"[neɑ̃mwɛ̃]","exAr":"الوقت متأخر، ومع ذلك نخرج."},{"fr":"en effet","ar":"فعلاً/إذ","pos":"locution","exFr":"En effet, il a raison.","ipa":"[ɑ̃n efɛk]","exAr":"فعلاً، هو على حق."},{"fr":"par conséquent","ar":"وبالتالي","pos":"locution","exFr":"Il pleut, par conséquent on reste.","ipa":"[paʁ kɔ̃sekɑ̃]","exAr":"تمطر، وبالتالي نبقى."},{"fr":"sauf que","ar":"إلا أن","pos":"locution","exFr":"Il fait beau, sauf qu'il vente.","ipa":"[sof kə]","exAr":"الجو جميل، إلا أن هناك رياحاً."},{"fr":"un point de vue","ar":"وجهة نظر","pos":"nom","g":"m","exFr":"Je comprends ton point de vue.","ipa":"[pwɛ̃ də vy]","exAr":"أفهم وجهة نظرك."},{"fr":"prévisible","ar":"متوقع مسبقاً","pos":"adj","exFr":"La fin est prévisible.","ipa":"[pʁevizibl]","exAr":"النهاية متوقعة."}],"grammar":[{"tFr":"Exprimer son opinion","tAr":"القاعدة: التعبير عن الرأي","body":["عبارات الرأي تأخذ que + فعل مُصرَّف (Je pense que tu as raison) لا المصدر.","السلسلة الحججية: رأي ← سبب (parce que) ← استدراك (néanmoins) ← نتيجة (par conséquent)."],"ex":[{"fr":"Je trouve que cette ville est charmante.","ar":"أجد هذه المدينة ساحرة."},{"fr":"Je ne pense pas qu'il ait tort.","ar":"لا أظن أنه مخطئ."}]}],"mistakes":[{"wrong":"Je pense à qu'il...","right":"Je pense que + فعل","why":"عبارات الرأي تأخذ que لا préposition."},{"wrong":"رأي بلا سبب","right":"رأي + parce que / car","why":"الفرنسية تُفضّل الرأي المُعلَّل؛ بلاه يبدو سطحياً."},{"wrong":"Je ne suis pas d'accord (بلا تمهيد)","right":"Je comprends..., mais...","why":"المعارضة المباشرة تُقرأ جافة — التمهيد أدب حواري."},{"wrong":"خلط donc مع par conséquent في الكتابة","right":"كلاهما سليم لكن par conséquent أ رسمي","why":"par conséquent للمقال الرسمي وdonc للحديث اليومي."}],"dialogues":[{"title":"نقاش حول فيلم","ctx":"صديقان يختلفان بلباقة","lines":[{"who":"Inès","fr":"À mon avis, le film était génial.","ar":"برأيي، كان الفيلم رائعاً."},{"who":"Mehdi","fr":"Je trouve que la fin était trop prévisible.","ar":"أجد أن النهاية كانت متوقعة جداً."},{"who":"Inès","fr":"C'est vrai, mais l'histoire est belle.","ar":"صحيح، لكن القصة جميلة."},{"who":"Mehdi","fr":"D'accord pour l'histoire. Par contre, les acteurs...","ar":"أوافق بشأن القصة. بخلاف ذلك، الممثلون..."},{"who":"Inès","fr":"Je ne suis pas sûre, ils sont populaires.","ar":"لست متأكدة، إنها مشهورة."},{"who":"Mehdi","fr":"Bon, on est d'accord pour être en désaccord !","ar":"حسناً، اتفقنا على عدم الاتفاق!"}]}],"exercises":[{"t":"mcq","skill":"grammar","q":"«أوافقك الرأي» بالفرنسية:","opts":["Je suis d'accord avec toi","Je suis dans l'accord","Je agree avec toi","J'ai l'accord"],"a":0,"why":"être d'accord + avec + شخص."},{"t":"fill","skill":"grammar","q":"أكمل: «___ mon avis, c'est utile.»","fr":"___ mon avis, c'est utile.","ans":"À","alts":["a"],"why":"À mon avis = في رأيي."},{"t":"translate","skill":"writing","q":"ترجم: «أرى أنها فكرة جيدة.»","ans":"Je pense que c'est une bonne idée.","alts":["je pense que c est une bonne idee"],"why":"Je pense que تأخذ que + فعل مُصرَّف — أداة الرأي الجاهزة للحفظ."},{"t":"listen","skill":"listening","q":"استمع واختر موقف المتحدث:","audio":"Je ne suis pas d'accord, c'est trop cher","opts":["يوافق","يعارض","محايد","يسأل"],"a":1,"why":"النفي في «ne suis pas d'accord» يكشف الموقف فوراً — تمييز الموافقة من المعارضة سمعاً."},{"t":"order","skill":"grammar","q":"رتّب: «في رأيي إنه الأفضل»","words":["À","mon","avis,","c'est","le","meilleur"],"ans":"À mon avis, c'est le meilleur","why":"القالب «À mon avis, c'est...» يُحفظ ككتلة واحدة لا كترجمة كلمة بكلمة."},{"t":"speaking","skill":"speaking","q":"قل رأيك عن الفرنسية: «أرى أن الفرنسية جميلة لكنها صعبة».","target":"Je pense que le français est beau mais difficile","why":"المهارة هنا الجمع بين الرأي والمفارقة: beau mais difficile — جملتان في هدف واحد."},{"t":"mcq","skill":"writing","q":"عبارة تُفتح بها المعارضة المهذّبة:","opts":["Je comprends ton point de vue, mais...","Tu as tort.","Non.","Je ne t'écoute pas."],"a":0,"why":"الاعتراف برأي الطرف قبل الرفض شرط الحوار."},{"t":"translate","skill":"writing","q":"ترجم: «برأيي، هذا الفيلم طويل جداً.»","ans":"À mon avis, ce film est très long.","alts":["a mon avis, ce film est tres long","A mon avis ce film est tres long"],"why":"à mon avis = برأيي (افتتاح الرأي)."}],"homework":"اكتب رأيك في 3 مواضيع (الرياضة، الطعام الفرنسي، وسائل النقل) بعبارة رأي + سبب.\nسلسلة A2: A2-t6-l1 ← A2-t6-l2 → A2-t6-l3","sources":[{"title":"كيف تعبر بالفرنسية عن : الرأي، الإتفاق و الإختلاف.","channel":"الحصة - La Séance","videoId":"MPAFVH4CWrE","why":"الرأي والموافقة والمعارضة في فيديو واحد بالعربية — عبارات الربط التي يحتاجها نص الرأي.","cat":"Writing","level":"A2","main":true},{"title":"FLE dire son point de vue (A2-B1)","channel":"Le français avec François","videoId":"HXLhI_C21Q0","why":"درس مصنف A2-B1 يعرض صيغ الرأي بتدرج — يأخذك من je pense que إلى صيغ أعمق بسلاسة.","cat":"Writing","level":"A2","extra":true},{"title":"Comment donner son opinion en français ? | 5 phrases clés - Français facile","channel":"Et voilà ! Cours de français","videoId":"YzM_lqjAmaw","why":"خمس جمل مفتاحية جاهزة للاستعمال الفوري — أفضل مادة حفظ سريعة قبل التمرين الحواري.","cat":"Writing","level":"A2","extra":true},{"title":"7 MOTS SOUTENUS POUR EXPRIMER SON OPINION ET ENRICHIR SON VOCABULAIRE","channel":"Français avec Fred","videoId":"GTHC6QrFSJo","why":"سبع صيغ أرقى للتعبير عن الرأي — طبقة إثرائية تجعل كتابتك تبدو بمستوى أعلى من المبتدئين.","cat":"Writing","level":"A2","extra":true}],"supplements":[{"id":"HXLhI_C21Q0","title":"FLE dire son point de vue (A2-B1)","channel":"Le français avec François","why":"درس مصنف A2-B1 يعرض صيغ الرأي بتدرج — يأخذك من je pense que إلى صيغ أعمق بسلاسة.","lang":"fr"},{"id":"YzM_lqjAmaw","title":"Comment donner son opinion en français ? | 5 phrases clés - Français facile","channel":"Et voilà ! Cours de français","why":"خمس جمل مفتاحية جاهزة للاستعمال الفوري — أفضل مادة حفظ سريعة قبل التمرين الحواري.","lang":"fr"},{"id":"GTHC6QrFSJo","title":"7 MOTS SOUTENUS POUR EXPRIMER SON OPINION ET ENRICHIR SON VOCABULAIRE","channel":"Français avec Fred","why":"سبع صيغ أرقى للتعبير عن الرأي — طبقة إثرائية تجعل كتابتك تبدو بمستوى أعلى من المبتدئين.","lang":"fr"}]},{"id":"A2-t6-l3","fr":"Écrire des messages","ar":"كتابة الرسائل","objectives":["صيغة الرسالة غير الرسمية","صيغة الرسالة الرسمية","الختام المناسب لكل نوع"],"sections":[{"h":"الرسالة غير الرسمية","p":["كل رسالة فرنسية تبدأ بالقاعدة الذهبية: حدد العلاقة أولاً (أنا ↔ أنت: tu أم vous؟) — من هنا ينحدر كل ما بعده: التحية، صيغ الجمل، حتى الوداع. العلاقة هي المفتاح والباقي تفاصيل تُشتق منها.","الرسالة غير الرسمية: «Salut Fatima,» ثم «Comment vas-tu ?» و«on se voit bientôt» و«Bises» أو «à plus». نبرة حرة، on بدل nous، جمل قصيرة، حتى emojis مقبولة — لكن لا تخلط درجتين في رسالة واحدة.","تابع الفيديو الأساسي بالشرح العربي: مقارنة الرسالتين جنباً إلى جنب بالعربية — نفس المحتوى بدرجتين. المقارنة الموازية أسرع طريق لضبط الفرق من قواعد مجردة.","الرسالة الرسمية قالبها ثابت: «Madame, Monsieur,» (تحية مفتوحة)، ثم «Je vous écris au sujet de...» (سبب الكتابة في الجملة الأولى)، ثم الفقرات المعنونة بالموضوع، ثم «Dans l'attente de votre réponse, je vous prie d'agréer, Madame, Monsieur, mes salutations distinguées.» (خاتمة رسمية كاملة).","الاختلافات الجوهرية مختصرة في جدول واحد: tu/vous، Salut/Madame، on/nous، Bises/Cordialement، جمل قصيرة/متماسكة، أخطاء مقبولة/لا تُقبل. احفظ الجدول كصورة ذهنية واحدة — 6 أسطر تُغنيك عن صفحة قواعد.","الخاتمة الرسمية مرتّبة من الأكثر رسمية للأقل: «Veuillez agréer...» (للإداري)، «Je vous prie d'agréer...» (القياسي)، «Cordialement» (العملية اليومية)، «Bien à vous» (ودّية مهنية). اختر حسب المتلقّي: وزارة ← الأكثر رسمية، بريد إلكتروني داخل الشركة ← Cordialement يكفي."],"video":{"id":"MbFcId19Cq4","title":"تعلم اللغة الفرنسية للمستوى المحترف : الدرس الأول - 01 - كيف تكتب الرسالة باللغة الفرنسية","channel":"la langue francaise","why":"شرح عربي لكتابة الرسالة الفرنسية من العنوان إلى التوقيع — يقابل قراءة الرسالة في الدرس الأول.","lang":"ar","main":true,"dur":15},"sub":[{"h":"tu أم vous؟ القاعدة الأم","p":["tu — مألوف: أصدقاء، أطفال، عائلة.","vous — مسافة أو جماعة: رسميات وغرباء.","عند الشك: vous دائماً (الأدب لا يُخطئ).","العلاقة تحدد التحية والخاتمة والضمائر."]},{"h":"الرسمية: القالب الكامل","p":["Madame, Monsieur, — الافتتاح.","Je vous écris au sujet de... — السبب.","فقرات مترابطة بموضوع واضح.","Je vous prie d'agréer... mes salutations distinguées."]},{"h":"جدول الفروق الست","p":["tu / nous / on — vous / nous / on.","Salut / Bises — Madame / Cordialement.","جمل قصيرة حرة — جمل متماسكة.","متوافق: emoji مقبول — لا أخطاء ولا emoji رسمي."]}]},{"h":"الرسالة الرسمية","p":["لغريب أو جهة رسمية: Madame, Monsieur (سيدتي السيد)، ثم الموضوع بلغة مهذبة، ثم الختام: Cordialement (مع التقدير)، Bien cordialement، Je vous prie d'agréer mes salutations.","مثال: «Madame, Je vous écris pour demander des informations sur vos cours de français. Pourriez-vous m'envoyer la brochure ? Cordialement, Ahmed Mansouri»","الخطأ الشائع في الرسالة الرسمية العربية الذهنية: ترجمة «تحية طيبة» حرفياً. الصيغة الفرنسية الجاهزة هي «Je vous prie d'agréer...» — تُنسخ كما هي ولا تُركَّب من العدم."],"video":null},{"h":"الاختلافات الجوهرية","p":["في الرسمية: استخدم vous دائماً، تجنب الاختصارات (je suis وليس j'suis)، وتجنّب كلمات العامية (sympa → agréable).","في غير الرسمية: tu، الاختصارات والرموز التعبيرية مقبولة.","أوقف الفيديو الإثرائي عند الرسمية واكتب رسالتك الرسمية على ورقة بالقالب الكامل — من Madame إلى الخاتمة — دون النظر. النسخ المتكرر من الذاكرة يثبت القالب."],"video":null},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: الرسالة الفرنسية تُبنى على درجة واحدة موحّدة (tu أم vous) تحدّد التحية والضمائر والخاتمة — مع قالبين جاهزين: صديق (Salut... Bises) ورسمية (Madame/Monsieur... Je vous prie d'agréer...). أعد مشاهدة الفيديو الأساسي «كيف تكتب الرسالة باللغة الفرنسية» (رابطه في مصادر الدرس) واملأ القالب الرسمي من الذاكرة.","جسر المهارات: وصف (A2-t6-l1) ← رأي (A2-t6-l2) ← رسالة (A2-t6-l3) — هنا تُغلق مهارة الكتابة الثلاثية، وتنتقل إلى أولى حلقات Reflets (a2-t7-l1) حيث تُستعمل الرسائل والتحيات في سياق درامي حيّ.","إعادة المشاهدة والتسجيل: أعد مشاهدة مقطع الرسالة الرسمية في الفيديو الأساسي، ثم اكتب وأقرأ بصوت عالٍ رسالة من 4 أسطر (Madame/Monsieur ← السبب ← الخاتمة) خلال خمس دقائق — تسجيل قالبك الصوتي يثبّته قبل أي امتحان."]}],"examples":[{"fr":"Cher Ahmed, comment vas-tu ?","ar":"صديقي أحمد، كيف حالك؟"},{"fr":"Madame, je vous écris pour...","ar":"سيدتي، أكتب لكم من أجل..."},{"fr":"Cordialement,","ar":"مع التقدير،"},{"fr":"J'espère que tu vas bien.","ar":"أتمنى أن تكون بخير."},{"fr":"Je vous écris au sujet de mon dossier.","ar":"أكتب بخصوص ملفي.","note":"سبب الكتابة"},{"fr":"Salut ! Comment vas-tu ?","ar":"أهلاً! كيف حالك؟","note":"غير رسمية"},{"fr":"Je vous prie d'agréer mes salutations distinguées.","ar":"أرجو تفضّل تحياتي المميزة.","note":"خاتمة رسمية"},{"fr":"Dans l'attente de votre réponse, Cordialement.","ar":"في انتظار ردكم، مع التحية.","note":"خاتمة عملية"}],"pron":[{"w":"Cordialement","ipa":"[kɔʁ.dja.lə.mɑ̃]","approx":"كورديالماون"},{"w":"J'espère","ipa":"[ʒɛs.pɛʁ]","approx":"جيسبير"}],"vocab":[{"fr":"cher / chère","ar":"عزيز / عزيزة (في الرسائل)","pos":"adj","g":"mf","ipa":"[ʃɛʁ]","exFr":"Chère Amina,","exAr":"عزيزتي أمينة،"},{"fr":"Cordialement","ar":"مع التقدير","pos":"formule","ipa":"[kɔʁ.dja.lə.mɑ̃]","exFr":"Cordialement, Ahmed","exAr":"مع التقدير، أحمد"},{"fr":"j'espère que","ar":"أتمنى أن","pos":"expression","ipa":"[ʒɛs.pɛʁ kə]","exFr":"J'espère que tout va bien.","exAr":"أتمنى أن كل شيء بخير."},{"fr":"je vous écris pour","ar":"أكتب لكم من أجل","pos":"expression","ipa":"[ʒə.vu.z‿e.kʁi puʁ]","exFr":"Je vous écris pour poser une question.","exAr":"أكتب لكم لطرح سؤال."},{"fr":"un message","ar":"رسالة","pos":"nom","g":"m","pl":"des messages","ipa":"[mɛ.saʒ]","exFr":"Tu as reçu mon message ?","exAr":"هل وصلك رسالتي؟"},{"fr":"répondre","ar":"يرد","pos":"verbe","ipa":"[ʁe.pɔ̃dʁ]","exFr":"Réponds-moi vite !","exAr":"جبني بسرعة!"},{"fr":"Madame / Monsieur","ar":"السيدة / السيد","pos":"nom","exFr":"Madame la Directrice,","ipa":"[madam]","exAr":"السيدة المديرة،"},{"fr":"je vous prie d'agréer","ar":"أرجو تفضّل (خاتمة رسمية)","pos":"locution","exFr":"Je vous prie d'agréer mes salutations.","ipa":"[ʒə vu pʁi dagʁe]","exAr":"أرجو تفضّل تحياتي."},{"fr":"demande / demande de renseignement","ar":"طلب / طلب معلومات","pos":"nom","g":"f","exFr":"Je vous envoie une demande.","ipa":"[dəmɑ̃d]","exAr":"أرسل لكم طلباً."},{"fr":"remercier","ar":"يشكر","pos":"verbe","g":"1er","exFr":"Je vous remercie de votre aide.","ipa":"[ʁəmɛʁsje]","exAr":"أشكركم على مساعدتكم."},{"fr":"l'objet (d'un mail)","ar":"موضوع (البريد)","pos":"nom","g":"m","exFr":"L'objet : demande de stage.","ipa":"[ɔbʒɛ]","exAr":"الموضوع: طلب تدريب."},{"fr":"les salutations","ar":"التحيات","pos":"nom","g":"f","exFr":"Mes salutations distinguées.","ipa":"[salytasyɔ̃]","exAr":"تحياتي المميزة."},{"fr":"formel(le) / informel(le)","ar":"رسمي / غير رسمي","pos":"adj","exFr":"Ce ton est trop formel.","ipa":"[fɔʁmɛl]","exAr":"هذه النبرة رسمية جداً."},{"fr":"envoyer","ar":"يرسل","pos":"verbe","g":"1er","exFr":"J'envoie la lettre demain.","ipa":"[ɑ̃.vwa.je]","exAr":"أرسل رسالة الغد."},{"fr":"la politesse","ar":"الأدب / اللياقة","pos":"nom","g":"f","exFr":"La politesse est essentielle dans un mail.","ipa":"[pɔ.li.tɛs]","exAr":"الأدب ضروري في البريد."}],"grammar":[{"tFr":"Registre de langue : tutoiement et vouvoiement","tAr":"القاعدة: الدرجات اللغوية","body":["tu/vous يغيّران الضمائر والتحية وحتى الفعل (tu parles / vous parles — انتبه: k→c مع vous: vous parlez).","الخاتمة تتدرّج: Veuillez... > Je vous prie... > Cordialement > Bien à vous — اختر بحسب المتلقّي."],"ex":[{"fr":"Bonjour Madame, je vous remercie.","ar":"مرحباً سيدتي، أشكركم."},{"fr":"Salut, merci pour ton aide !","ar":"أهلاً، شكراً لمساعدتك!"}]}],"mistakes":[{"wrong":"ترجمة «تحية طيبة» حرفياً","right":"Je vous prie d'agréer... (قالب جاهز)","why":"الخاتمة الرسمية صيغة ثابتة لا تُركَّب من العدم."},{"wrong":"خلط tu وvous في الرسالة الواحدة","right":"درجة واحدة موحدة","why":"الخلط يُظهر تردداً وتقصّراً في الأدب."},{"wrong":"البدء بالموضوع بلا تحية","right":"Madame/Monsieur ثم السبب","why":"الرسالة الرسمية تفتح بالتحية ثم «Je vous écris au sujet de»."},{"wrong":"emoji وon في سياق رسمي","right":"nous + صيغ كاملة + بلا emoji","why":"الاختصارات الرسومية تُقرأ جفاء في السياق الإداري."}],"dialogues":[{"title":"تعديل رسالة توظيف","ctx":"مديرة تراجع مسودة موظفة","lines":[{"who":"La responsable","fr":"Votre mail commence par « Salut » ?","ar":"رسالتكم تبدأ بـ «أهلاً»؟"},{"who":"La stagiaire","fr":"Oui... je pensais que c'était suffisant.","ar":"نعم... ظننت أنه يكفي."},{"who":"La responsable","fr":"Pour un recruteur, il faut « Madame, Monsieur ».","ar":"مع مسؤول توظيف، يلزم «السيدة/السيد»."},{"who":"La stagiaire","fr":"Et la fin ?","ar":"والخاتمة؟"},{"who":"La responsable","fr":"« Je vous prie d'agréer... » puis Cordialement.","ar":"«أرجو تفضّل...» ثم مع التحية."},{"who":"La stagiaire","fr":"Je réécris tout de suite. Merci !","ar":"سأعيد كتابتها فوراً. شكراً!"}]}],"exercises":[{"t":"mcq","skill":"writing","q":"أفضل ختام لرسالة رسمية:","opts":["Bisous","À bientôt","Cordialement","Salut"],"a":2,"why":"Cordialement ختام رسمي قياسي."},{"t":"mcq","skill":"writing","q":"أفضل افتتاحية لرسالة لصديق:","opts":["Madame, Monsieur","Cher Nabil,","Objet : demande","Veuillez agréer"],"a":1,"why":"Cher + الاسم للرسائل غير الرسمية."},{"t":"translate","skill":"writing","q":"ترجم: «أتمنى أن تكون بخير.»","ans":"J'espère que tu vas bien.","alts":["j espere que tu vas bien"],"why":"J'espère que + جملة فعلية — تحية الرسالة غير الرسمية الجاهزة."},{"t":"mcq","skill":"grammar","q":"في رسالة رسمية تستخدم:","opts":["tu","vous","on","moi"],"a":1,"why":"الرسمية دائماً بـ vous."},{"t":"order","skill":"writing","q":"رتّب سطر ختام رسالة رسمية: (Cordialement، الختام قبل التوقيع)","words":["Dans","l'attente","de","votre","réponse,","cordialement."],"ans":"Dans l'attente de votre réponse, cordialement.","why":"عبارة الانتظار ثم الختام ثم التوقيع."},{"t":"writing","skill":"writing","q":"اكتب رسالة رسمية قصيرة (3-4 أسطر) لطلب معلومات عن دورة لغة.","min":15,"kw":["madame","monsieur","je vous","cordialement"],"sample":"Madame, Monsieur, Je vous écris pour demander des informations sur vos cours de français pour débutants. Pourriez-vous m'envoyer les horaires et les tarifs ? Cordialement, Ahmed","why":"القالب الرسمي يُقيَّم على عناصره: التحية (Madame/Monsieur) ثم السبب (Je vous écris) ثم الخاتمة (Cordialement)."},{"t":"mcq","skill":"writing","q":"الخاتمة الأنسب لبريد إلكتروني عمل يومي:","opts":["Cordialement","Bises","Salut","À plus"],"a":0,"why":"Cordialement عملية مهنية مقبولة في السياق اليومي."},{"t":"order","skill":"writing","q":"رتّب الرسالة الرسمية: (1) الخاتمة (2) التحية (3) السبب","words":["Madame,","je","vous","écris","au sujet..."],"ans":"Madame, je vous écris au sujet...","why":"التحية ثم السبب ثم الخاتمة — ترتيب القالب الرسمي."}],"homework":"اكتب رسالتين: رسالة لصديق تخبره بتحضيرك لامتحان، ورسالة رسمية لمعهد لغات تسأل عن مواعيده.\nسلسلة A2: A2-t6-l2 ← A2-t6-l3 → a2-t7-l1","sources":[{"title":"تعلم اللغة الفرنسية للمستوى المحترف : الدرس الأول - 01 - كيف تكتب الرسالة باللغة الفرنسية","channel":"la langue francaise","videoId":"MbFcId19Cq4","why":"شرح عربي لكتابة الرسالة الفرنسية من العنوان إلى التوقيع — يقابل قراءة الرسالة في الدرس الأول.","cat":"Writing","level":"A2","main":true},{"title":"Écrire un email professionnel en français | Modèle simple et efficace","channel":"Et voilà ! Cours de français","videoId":"nBWY_d10l7E","why":"قالب إيميل احترافي بسيط وفعال خطوة بخطوة — نفس القالب الذي ستكتبه في الواجب وفي الحياة.","cat":"Writing","level":"A2","extra":true},{"title":"10 Expressions françaises pour vos e-mails professionnels","channel":"Parlez-vous FRENCH","videoId":"5Imwzjlk-bE","why":"عشر تعبيرات جاهزة لرسائل البريد — عبارات تفتح وتغلق وتطلب بلغة مهذبة، قابلة للنسخ في رسالتك الأولى.","cat":"Writing","level":"A2","extra":true},{"title":"🇫🇷 DELF A2 - Production écrite - Exercice 1 écriture créative - exemple","channel":"Madame FLE - Cours de français","videoId":"BZo-INRB5HI","why":"مثال امتحاني كامل لقسم الكتابة في DELF A2 — يربط مهارة الرسالة بالامتحان المعتمد وتقييمه.","cat":"Writing","level":"A2","extra":true}],"supplements":[{"id":"nBWY_d10l7E","title":"Écrire un email professionnel en français | Modèle simple et efficace","channel":"Et voilà ! Cours de français","why":"قالب إيميل احترافي بسيط وفعال خطوة بخطوة — نفس القالب الذي ستكتبه في الواجب وفي الحياة.","lang":"fr"},{"id":"5Imwzjlk-bE","title":"10 Expressions françaises pour vos e-mails professionnels","channel":"Parlez-vous FRENCH","why":"عشر تعبيرات جاهزة لرسائل البريد — عبارات تفتح وتغلق وتطلب بلغة مهذبة، قابلة للنسخ في رسالتك الأولى.","lang":"fr"},{"id":"BZo-INRB5HI","title":"🇫🇷 DELF A2 - Production écrite - Exercice 1 écriture créative - exemple","channel":"Madame FLE - Cours de français","why":"مثال امتحاني كامل لقسم الكتابة في DELF A2 — يربط مهارة الرسالة بالامتحان المعتمد وتقييمه.","lang":"fr"}]}]},{"id":"a2-t7","slug":"reflets","icon":"video","color":"#7c3aed","fr":"Reflets — 28 épisodes","ar":"مسار التعلم بالحلقات (Reflets)","desc":"سلسلة Reflets كاملة في فيديو واحد: 28 حلقة موقوتة (الموسم الأول 15 + الموسم الثاني 13) — كل درس يجمع الحلقة الرئيسية مع إثرائي وتمارين وسلاسلة مترابطة.","lessons":[{"id":"a2-t7-l1","fr":"Épisode 1 — Le nouveau locataire","ar":"الحلقة 1 — الساكن الجديد","objectives":["التواصل الشفهي: إلقاء التحية، والسؤال عن الاسم والمهنة والجنسية، والتعبير عن الاتفاق أو الرفض — بالصيغة الرسمية (Vous) وغير الرسمية (Tu).","القواعد: تصريف واستخدام فعل الكينونة (Être) وفعل التسمية (S’appeler) في جمل تعريف قصيرة سليمة.","التمييز بين ضمائر الفاعل الشخصية (Pronoms sujets) والضمائر التوكيدية (Pronoms toniques) واستعمال كلٍّ منهما في موضعه.","إتقان قاعدة (C’est) مقابل (Il est / Elle est) عند التعريف بالأشخاص والمهن والجنسيات.","المفردات: اكتساب مفردات المهن والجنسيات وعبارات الترحيب والوداع، ثم تشغيل الحلقة وإعادة جملها بصوت عالٍ (Listen & Repeat)."],"sections":[{"h":"الحلقة 1: لقاء الساكن الجديد (00:00 — 06:15)","video":{"id":"dzPrX6Mifjo","title":"Reflets 1 - épisode #1 - Le nouveau locataire","channel":"Jason Mills","why":"الحلقة الكاملة — النص الأصلي للمشوار: طبّق ما تعلمه في دروس القواعد والمفردات.","lang":"fr","main":true,"t":0,"dur":7},"p":["هذه الحلقة مدخلك إلى السلسلة: ساكن جديد يدخل بناوي ويستقبله الجيران. الحدث بسيط جداً، لكنه يختصر كل ما يحتاجه مبتدئ A2 في أول محادثة: التحية، الاسم، المهنة، والجنسية — بأربع جمل فقط تفتح كل باب.","طريقة الاستماع والتكرار في هذا الفيديو مقصودة: يتوقف المقطع بعد كل جملة لترددها بنفس النبرة. لا تحاول فهم كل كلمة في المرة الأولى — المرة الأولى للإيقاع، والثانية للمفردات، والثالثة لتركيب الجملة في فمك.","البنية اللغوية للحلقة صغيرة وقوية: «Je m'appelle...», «Je suis...», «Je viens de...» ثلاث جمل تكفي لتعريف كامل. لاحظ أن الفرنسية تعرّف الجنسية بـ «de» لا بصفة: «Je suis marocain» مع الاسم، و«Je viens du Maroc» مع الجهة.","التحية نفسها تتدرّج: «Bonjour» للنهار، «Bonsoir» للمساء، و«Enchanté(e)» عند اللقاء الأول. المتقدّم A2 يجب أن يفرّق بين المألوف (tu) والمهذّب (vous) من أول جملة — والاختيار الخاطئ هنا يُقرأ كخلل اجتماعي لا لغوي.","بعد الحلقة بادر بكتابة تعريفك بنفسك في أربعة أسطر: الاسم، المهنة، من أين، وماذا تفعل هنا. ثم اقرأها بصوت عالٍ وسجّلها — قارنها بنطق الممثلين وصحّح النبرة لا الكلمات فقط.","الخلاصة: التعارف ليس حفظاً بل إيقاع. من أتقن ثلاث جمل التعارف بلهجة ثابتة يدخل أي محادثة تالية بثقة — وهذا بالضبط ما ستجده في الحلقة الثانية."],"sub":[{"h":"جُمل التعارف الأساسية","p":["Je m'appelle Amine.","Je suis étudiant.","Je viens de Casablanca.","Enchanté, Julie !"]},{"h":"أدوات النطق المفتاحية","p":["appelle ← [a.pɛl] لا «أبل».","étudiant ← النبرة على المقطع الأخير.","viens ← [vjɑ̃] مدموج لا مفكّك.","Enchanté ← [ɑ̃.ʃɑ̃.te]."]},{"h":"خطوات Listen & Repeat","p":["1) استمع بلا ورقة للإيقاع.","2) أعد الجملة فور وقفتها.","3) أعد الحلقة كاملة بلا توقف.","4) سجّل نفسك وقارن."]}]},{"h":"النصوص الحوارية المصححة (Corpus des Dialogues)","p":["النص في تبويب «حوارات» هو المفرغ الأكاديمي للحلقة بعد التنقيح: صُححت أخطاء الفراغ الصوتي (مثل «pré» إلى «Prévost» و«chamb de voyage» إلى «agent de voyage») ليصبح المرجع اللغوي دقيقاً — درس تأسيسي يبني جسر A1 إلى A2 عبر أربعة مشاهد متتابعة.","المشهد الأول (Vouvoiement): تعارف رسمي بين شابة وبيير-هنري دي لا تور وبينوا رواييه — تحيّة بالمحذّب «Vous êtes... ?»، ثم «Enchanté» متبادلة، ثم السؤال عن المهنة «Quelle est votre profession ?» — ولاحظ أن النمط نفسه يُستعمل للاستفهام وللخبر: «Vous êtes étudiant ?» ثم «Vous êtes agent de voyage !».","المشهد الثاني (Tutoiement): تعارف مألوف بين شاب متدرب وجولي بريفو — هنا يظهر الفرق بين «prénom» (الاسم الشخصي الأول) و«nom» (لقب العائلة): «mon prénom c’est Julie, et mon nom c’est Prévost»، مع صيغتي السؤال «comment tu t’appelles ?» و«c’est quoi, ton nom ?» — ثم يقتحم اللقاء بينوا فيقدّم نفسه بعنوانه الكامل ومسكنه.","المشهد الثالث: الجنسية والمهن — «Quelle est votre nationalité ?» ← «Je suis allemande»، ثم الجمع بين الدراسة والعمل «je suis étudiante et je travaille aussi»، وأخيراً تخمين المهنة «Vous êtes mannequin, je suis sûr !» ← «C’est vrai».","المشهد الرابع: المستأجر الجديد — تقديم شخص غائب بصيغة «C’est» («C’est Benoît Royer ?» ← «Non, Pascal Lefèvre, le nouveau locataire») ثم وصفه «Il est très sympa»، وأخيراً طلب الموافقة «tu es d’accord ?» ← «Oui, je suis d’accord».","طريقة العمل: شغّل الفيديو الرئيسي عند بداية كل مشهد، أوقف بعد كل سطر وقارنه بالنص المكتوب، ثم أعد المشهد بصوت الممثلين — وبعد الحلقة كاملة أغلق النص وأعد إلقاء المشهد الأول من ذاكرتك، فهذا هو اختبار الحفظ الحقيقي."]},{"h":"عبارات التعارف التي تتكرر في الحلقة","p":["«Comment tu t'appelles ?» بين المألوف، و«Comment vous appelez-vous ?» في المهذّب — السؤال عن الاسم أول جسر، وطريقة طرحه تحدّد المسافة الاجتماعية من الجملة الأولى.","«Qu'est-ce que tu fais dans la vie ?» سؤال المهنة بالعامية المهذّبة، وجوابه يبدأ بـ «Je suis...» ثم اسم المهنة مباشرة: «Je suis professeur», «Je suis infirmière» — لا نحتاج صيغة فعّالة هنا.","«Et d'où tu viens ؟» يفتح باب الولاء والجنسية، وجواب «Je viens de...» + اسم الجهة يعيدك تلقائياً إلى «moi, je suis...» لتكملة الدائرة — هذه الدائرة الصغيرة (اسم ← عمل ← أصل) هي نواة أي محادثة افتتاحية.","غلق اللقاء بلباقة: «Au plaisir de te connaître» أو «Ravie de vous rencontrer» — جملة وداع قصيرة تُختم اللقاء كما بدأ: بلباقة. من يُغلق بلا جملة يترك انطباعاً ناقصاً مهما كانت بداية قوية."]},{"h":"الأفعال الكلامية والتواصل (Actes de Parole)","p":["١) السؤال عن الاسم (Demander le nom) — الصيغة الرسمية: «Votre nom, Monsieur ?» و«Quel est votre nom, s’il vous plaît ?» و«Comment vous appelez-vous ?»، وأكثرها شيوعاً في الحوار: «Vous vous appelez comment ?» — أما الصيغة غير الرسمية فـ «Comment tu t’appelles ?» و«C’est quoi, ton nom ?».","الجواب عن الاسم: «Je m’appelle...» للاسم مباشرة، وللتوضيح تُفصل القطعتان: «Mon prénom c’est Julie» (الاسم الشخصي الأول) و«mon nom c’est Prévost» (لقب العائلة) — وهو الفرق الذي يزيل لبس «ما اسمك؟» العربية من جذوره.","٢) السؤال عن المهنة (Demander la profession) — «Quelle est votre profession ?» بالرسمية، و«Qu’est-ce que vous faites ?» و«Quel est votre métier ?» في الاستعمال العام — والإجابة قالب واحد لا يتغيّر: «Je suis + اسم المهنة» بلا أداة: «Je suis employé», «Je suis agent de voyage», «Je suis stagiaire».","٣) التعبير عن الاتفاق (Exprimer l’accord) — «Tu es d’accord ?» ← «Oui, d’accord !» أو «Oui, je suis d’accord.» أو «C’est d’accord.»، ومعامل الثقة: «Pas de problème !» بمعنى «لا توجد مشكلة».","الرفض والاعتراض (Le désaccord) — «Ah non, pas d’accord !» رفض صريح، و«Ah si !» ردّ على نفي أو اعتراض سابق (مثل سؤال «Pas de problème ?») بمعنى «بلى!» — وهي أداة نفي النفي التي تمنع سوء الفهم في الحوار.","تذكير بالترتيب: السؤال عن الاسم يبدأ مهذّباً ثم يهبط طبيعياً إلى «tu»، والسؤال عن المهنة لا يتغيّر فيه سوى الضمير، وطلب الموافقة يأتي في ختام الحوار قبل الوداع — اجعل هذه الثلاثة ترتيبك الثابت في كل تمرين شفهي."]},{"h":"تمرين الحلقة","p":["تمرين اليوم: اختر شخصاً تخاطبه (جار، زميل، سائح) واكتب حواراً من 6 أسطر يبدأ بالتحية وينتهي بالوداع — التزام بالصيغة (tu/vous) في الحوار كله.","سجّل الحوار بصوتين إن أمكنك: مرة سريعة طبيعية ومرة بطيئة واضحة. الفرق بين السجّلتين هو تدريبك الحقيقي على النبرة — النبرة الفرنسية صاعدة في السؤال وهابطة في الجملة الخبرية.","ما تحفظه من هذه الحلقة: ثلاث جمل تعارف + جملة وداع. هذا كل شيء — وبقية الحلقات ستفتح أبواباً فوق هذه النواة لا بدلاً عنها."]},{"h":"التطبيق والتلخيص","p":["الحلقة 1: ساكن جديد يصل إلى البناية ويعرّف نفسه بالجيران — التحية ثم الاسم ثم المهنة ثم الجنسية في أربع جمل فقط، كما في الفيديو الرئيسي «Reflets 1 - épisode #1 - Le nouveau locataire»: شغّل من الدقيقة صفر وأعد كل جملة بصوت الممثلين قبل أن تنتقل إلى دروس القواعد والمفردات.","بداية المشوار — لا توجد حلقة قبلها؛ تُتقن هنا جمل التعارف الثلاث ثم تنتقل إلى التالية a2-t7-l2 حيث تفتح الشقة أبواب مفردات المنزل والوصف بـ «il y a».","المهمة: شاهد الحلقة كاملة في الفيديو الرئيسي، ثم افتح ورقة المفردات وراجع كلمات الحلقة (le voisin, l'immeuble, s'installer, la clé)، وأخيراً سجّل تلخيصاً شفهياً مدته 30 ثانية تشرح فيه موقف الساكن الجديد بكلماتك الخاصة."]}],"examples":[{"fr":"Je m'appelle Samira, enchanté !","ar":"اسمي سامية، تشرّفت!","note":"الاسم + الترحيب"},{"fr":"Je suis étudiante en médecine.","ar":"أنا طالبة في الطب.","note":"المهنة/الدراسة"},{"fr":"Je viens d'Oran, et vous ?","ar":"جئت من وهران، وأنت؟","note":"الأصل + ارتداد السؤال"},{"fr":"Vous êtes nouveau dans l'immeuble ؟","ar":"هل أنت جديد في العمارة؟","note":"سؤال مألوف/مهذّب"},{"fr":"Oui, je suis arrivé hier soir.","ar":"نعم، وصلتُ مساء أمس.","note":"passé composé مبسط"},{"fr":"Au plaisir de faire votre connaissance.","ar":"تشرّفت بمعرفتكم.","note":"ختام مهذّب"},{"fr":"Quelle est votre nationalité ?","ar":"ما هي جنسيتكِ؟","note":"سؤال الجنسية (من الحلقة)"},{"fr":"Je suis employé dans une agence de voyage.","ar":"أنا موظف في وكالة سفر.","note":"الجواب عن المهنة (نص الحلقة)"},{"fr":"Oui, je suis d’accord !","ar":"نعم، أنا موافق!","note":"التعبير عن الاتفاق"}],"pron":[{"w":"je m'appelle","ipa":"[ʒə ma.pɛl]","approx":"جُ ماپيل"},{"w":"étudiant","ipa":"[e.ty.djɑ̃]","approx":"إيتّوديَان"},{"w":"viens","ipa":"[vjɑ̃]","approx":"فيان"}],"vocab":[{"fr":"le voisin / la voisine","ar":"الجار/الجارة","pos":"nom","g":"m","exFr":"Mon voisin est très sympa.","ipa":"[lə vwazɛ̃]","exAr":"جارّي لطيف جداً."},{"fr":"l'immeuble","ar":"العمارة السكنية","pos":"nom","g":"m","exFr":"Dans mon immeuble...","ipa":"ɛ̃.mœ.bl","exAr":"في عمّارتي..."},{"fr":"s'installer","ar":"يستقر/يستوطن","pos":"verbe","g":"1er","exFr":"Je m'installe ce week-end.","ipa":"ɛ̃.sta.le","exAr":"أستقر نهاية الأسبوع."},{"fr":"la clé","ar":"المفتاح","pos":"nom","g":"f","exFr":"Voici les clés.","ipa":"[kle]","exAr":"إليك المفاتيح."},{"fr":"la rencontre","ar":"اللقاء","pos":"nom","g":"f","exFr":"Une première rencontre.","ipa":"ʁə.nɑ̃s","exAr":"لقاء أول."},{"fr":"ravie","ar":"سرور/مبتهجة","pos":"adj","exFr":"Ravie de vous voir.","ipa":"ʁa.vi","exAr":"مبتهجة برؤيتكم."},{"fr":"l'étudiant(e)","ar":"الطالب/ة","pos":"nom","exFr":"Je suis étudiant.","ipa":"e.ty.djɑ̃","exAr":"أنا طالب."},{"fr":"la nationalité","ar":"الجنسية","pos":"nom","g":"f","exFr":"Ma nationalité est algérienne.","ipa":"na.sjɔ.na.li.te","exAr":"جنسيتي جزائرية."},{"fr":"l'étage","ar":"الطابق","pos":"nom","g":"m","exFr":"Au deuxième étage.","ipa":"e.taʒ","exAr":"في الطابق الثاني."},{"fr":"poser une question","ar":"يطرح سؤالاً","pos":"locution","exFr":"Je peux poser une question ?","ipa":"po.ze œ̃ kɛsjɔ̃","exAr":"هل لي أن أطرح سؤالاً؟"},{"fr":"travailler","ar":"يعمل","pos":"verbe","g":"1er","exFr":"Je travaille ici.","ipa":"[tʁa.va.je]","exAr":"أعمل هنا."},{"fr":"le secteur","ar":"المجال/الحيّ","pos":"nom","g":"m","exFr":"Dans le secteur bancaire.","ipa":"sɛk.tœʁ","exAr":"في المجال البنكي."},{"fr":"le stagiaire / la stagiaire","ar":"متدرب / متدربة","pos":"nom","exFr":"Moi, je suis stagiaire.","exAr":"أنا متدرب.","ipa":"staʒjɛʁ"},{"fr":"un employé / une employée","ar":"موظّف/موظّفة","pos":"nom","exFr":"Je suis employé dans une agence de voyage.","exAr":"أنا موظف في وكالة سفر.","ipa":"ɑ̃.plɔ.ne"},{"fr":"une agence de voyage","ar":"وكالة سفر","pos":"nom","g":"f","exFr":"Il travaille dans une agence de voyage.","exAr":"يعمل في وكالة سفر.","ipa":"ɑ̃ʒ də vwaʒaʒ"},{"fr":"un agent de voyage","ar":"وكيل سفر","pos":"nom","g":"m","exFr":"Benoît est agent de voyage.","exAr":"بينوا وكيل سفر.","ipa":"aʒɑ̃ də vwaʒaʒ"},{"fr":"un mannequin","ar":"عارض / عارضة أزياء","pos":"nom","g":"mf","exFr":"Elle est mannequin.","exAr":"هي عارضة أزياء.","ipa":"man.də.kɛ̃"},{"fr":"un présentateur","ar":"مقدّم برامج / مذيع","pos":"nom","g":"m","exFr":"Le présentateur est à l’antenne.","exAr":"المقدّم على الهواء.","ipa":"pʁe.zɑ̃.ta.tœʁ"},{"fr":"le locataire / la locataire","ar":"مستأجر / مستأجرة","pos":"nom","exFr":"Pascal est le nouveau locataire.","exAr":"باسكال هو المستأجر الجديد.","ipa":"lə lɔ.ta.tɛʁ"},{"fr":"un nom / un prénom","ar":"لقب العائلة / الاسم الشخصي (الأول)","pos":"nom","g":"m","exFr":"Mon prénom, c’est Julie.","exAr":"اسمي الشخصي جولي.","ipa":"nɔ̃ / pʁe.nɔ̃"},{"fr":"un étudiant / une étudiante","ar":"طالب / طالبة","pos":"nom","exFr":"Pierre-Henri est étudiant.","exAr":"بيير-هنري طالب.","ipa":"e.ty.djɑ̃"},{"fr":"français / française","ar":"فرنسي / فرنسية","pos":"adj","exFr":"Benoît est français.","exAr":"بينوا فرنسي.","ipa":"fʁɑ̃.sɛ"},{"fr":"allemand / allemande","ar":"ألماني / ألمانية","pos":"adj","exFr":"Ingrid est allemande.","exAr":"إنغريد ألمانية.","ipa":"al.mɑ̃"},{"fr":"enchanté(e)","ar":"تشرفت بمعرفتك","pos":"adj","exFr":"Enchanté, Monsieur !","exAr":"تشرفت يا سيدي!","ipa":"ɑ̃.ʃɑ̃.te"},{"fr":"sympa (sympathique)","ar":"لطيف / ودود","pos":"adj","exFr":"Il est très sympa.","exAr":"إنه لطيف جداً.","ipa":"sɛ̃.pa"}],"grammar":[{"tFr":"Je suis / J'ai : les deux verbes qui font tout","tAr":"القاعدة: être وavoir في التعريف","body":["التعريف يعتمد على فعلي الجسر: «Je suis + صفة/مهنة/جنسية» (أنا...) و«J'ai + اسم» (لديّ...) — أخطاء A2 الشائعة تأتي من استعمال «J'ai» مع الصفات: «J'ai étudiant» خطأ، الصحيح «Je suis étudiant».","مع أفعال -er النمط الأول في المضارع يُشكّل بانسحاب er + je/tu/nous/vous... : «je travaille», «tu parles», «nous habitons» — ثلاثية تغطي 80% من أفعال المحادثة اليومية."],"ex":[{"fr":"Je suis ingénieur et j'ai trente ans.","ar":"مهندس وعمري ثلاثون سنة."},{"fr":"Tu travailles dans quel secteur ?","ar":"تعمل في أي مجال؟"}]},{"tFr":"Pronoms sujets vs pronoms toniques","tAr":"ضمائر الفاعل مقابل ضمائر التوكيد","body":["ضمير الفاعل (Pronom sujet) إلزامي قبل الفعل ويحدّد الشخص: je, tu, il, elle, nous, vous — «Je suis étudiant» ولا يُحذف الضمير كما في لغات أخرى.","الضمير التوكيدي (Pronom tonique) له ثلاثة مواضع: للتشديد على الفاعل («Moi, je suis agent de voyage»)، وبعد حروف الجر، وفي الجواب المنفصل («Qui est-ce ? — C’est moi») — وأزواجه: je ↔ moi، tu ↔ toi، il ↔ lui، elle ↔ elle، nous ↔ nous، vous ↔ vous.","قاعدة دقيقة: الضمير التوكيدي لا يحلّ محل ضمير الفاعل أبداً — «Moi suis» خطأ، والصحيح «Moi, je suis» بفاصلة ثم الفعل مع ضميره، أو «Je suis» مباشرة."],"ex":[{"fr":"Moi, je suis agent de voyage.","ar":"أنا، أنا وكيل سفر."},{"fr":"Et toi, tu es stagiaire ?","ar":"وأنت، أنت متدرب؟"},{"fr":"Lui, c’est Benoît Royer.","ar":"هو، إنه بينوا رواييه."}]},{"tFr":"Qui est-ce ? — les 4 cas de « C’est »","tAr":"السؤال عن العاقل و(إنه) في أربع حالات","body":["للسؤال عن هوية شخص ما: «Qui est-ce ?» (من هذا؟) في الفصحى أو «C’est qui ?» في الكلام اليومي — والإجابة تبدأ بـ «C’est» للمفرد.","الحالة (1): C’est + اسم علم للمفرد أو الجمع — «C’est Julie.» و«C’est Julie et Benoît.» — الحالة (2): C’est + ضمير توكيدي — «C’est moi.» و«C’est lui.» و«C’est elle.».","الحالة (3): C’est + أداة (un, une, le, la) + اسم — «C’est le locataire.» و«C’est un agent de voyage» — والحالة (4): C’est + صفة ملكية (mon, ma, ton...) + اسم — «C’est mon ami.»."],"ex":[{"fr":"Qui est-ce ? C’est Julie.","ar":"من هذه؟ إنها جولي."},{"fr":"C’est moi !","ar":"إنه أنا!"},{"fr":"C’est le nouveau locataire.","ar":"إنه المستأجر الجديد."},{"fr":"C’est mon ami.","ar":"إنه صديقي."}]},{"tFr":"« C’est » ou « Il est / Elle est » ?","tAr":"متى أقول (إنه) ومتى أقول (هو/هي) ؟","body":["قبل اسم المهنة المباشر بلا أداة يُستعمل «Il est / Elle est»: «Il est agent de voyage.» و«Elle est mannequin.» — وقول «C’est agent de voyage» خطأ شائع يرتكبه المتعلّمون عند التعريف بالمهن.","قبل الصفة أو الجنسية أيضاً: «Elle est allemande.» و«Il est français.» و«Il est très sympa.» — أي أن نعت العاقل دائماً مع الضمير لا مع C’est.","أما إذا وُجدت أداة (un, une, le, la) قبل المهنة فيجب «C’est»: «C’est un agent de voyage» مقابل «Il est agent de voyage» — الجملتان تصوّران الشخص لكن ببنية مختلفة: بلا أداة مع الضمير، وبأداة مع C’est — وستتوسّع القاعدة مع «ce sont» للجمع في a2-t8-l5."],"ex":[{"fr":"Il est agent de voyage.","ar":"هو وكيل سفر — مهنة بلا أداة."},{"fr":"C’est un agent de voyage.","ar":"إنه وكيل سفر — أداة + اسم."},{"fr":"Elle est allemande.","ar":"هي ألمانية — جنسية بلا أداة."}]}],"mistakes":[{"wrong":"«J'ai étudiant»","right":"«Je suis étudiant»","why":"المهنة والصفة مع être لا مع avoir."},{"wrong":"التحية نفسها طوال النهار والمساء","right":"Bonjour نهاراً وBonsoir مساءً","why":"اختيار التحية يُظهر انتباهك للسياق الاجتماعي."},{"wrong":"tu مع شخص مجهول من أول جملة","right":"vous حتى يُلمَّح للتحوّل","why":"الاختيار الأول يثبّت المسافة — تصحيحها أصعب من احترامها."},{"wrong":"الجنسية بـ «من» حرفياً","right":"Je viens du/de l'/de la...","why":"«de» + المكان مُعرَّفة بشكل صحيح (du/de la/de l')."},{"wrong":"«C’est agent de voyage»","right":"«Il est agent de voyage»","why":"المهنة بلا أداة تأتي مع Il est / Elle est؛ ومع الأداة فقط يصبح القول «C’est un agent de voyage»."},{"wrong":"«Moi suis étudiant»","right":"«Moi, je suis étudiant»","why":"الضمير التوكيدي Moi يؤكد ولا يحلّ محل je — يبقى مسبوقاً بفاصلة ومتبوعاً بالفعل مع ضمير الفاعل."}],"dialogues":[{"title":"المشهد الأول: تعارف رسمي (Registre Formel — Vouvoiement)","ctx":"الشخصيات: شابة، بيير-هنري دي لا تور (Pierre-Henri de La Tour)، وبينوا رواييه (Benoît Royer) — النص كما ورد بعد تنقيح المفرغ.","lines":[{"who":"Femme","fr":"Bonjour Monsieur.","ar":"المرأة: صباح الخير سيدي."},{"who":"Pierre-Henri","fr":"Bonjour Mademoiselle.","ar":"بيير-هنري: صباح الخير آنستي."},{"who":"Benoît","fr":"Vous êtes Monsieur... ?","ar":"بينوا: حضرتك السيد...؟"},{"who":"Pierre-Henri","fr":"Je m’appelle Pierre-Henri de La Tour.","ar":"بيير-هنري: اسمي بيير-هنري دي لا تور."},{"who":"Benoît","fr":"Enchanté. Moi, je suis Benoît Royer.","ar":"بينوا: تشرفنا. أنا بينوا رواييه."},{"who":"Pierre-Henri","fr":"Enchanté, Monsieur.","ar":"بيير-هنري: تشرفنا يا سيدي."},{"who":"Benoît","fr":"Vous êtes étudiant, Monsieur de La Tour ?","ar":"بينوا: هل أنت طالب يا سيد دي لا تور؟"},{"who":"Pierre-Henri","fr":"Oui, je suis étudiant. Et vous, Monsieur Royer, quelle est votre profession ?","ar":"بيير-هنري: نعم، أنا طالب. وأنت يا سيد رواييه، ما هي مهنتك؟"},{"who":"Benoît","fr":"Je suis employé dans une agence de voyage.","ar":"بينوا: أنا موظف في وكالة سفر."},{"who":"Pierre-Henri","fr":"Ah ! Vous êtes agent de voyage ! Comme c’est amusant ! Au revoir, Monsieur.","ar":"بيير-هنري: آه! أنت وكيل سفر! يا له من أمر طريف! إلى اللقاء يا سيدي."},{"who":"Benoît","fr":"Au revoir, Monsieur de La Tour.","ar":"بينوا: إلى اللقاء يا سيد دي لا تور."}]},{"title":"المشهد الثاني: تعارف مألوف (Registre Familier — Tutoiement)","ctx":"الشخصيات: شاب متدرب، جولي بريفو (Julie Prévost)، وبينوا رواييه — الانتقال من السؤال عن اللقب إلى الاسم الشخصي والعائلي.","lines":[{"who":"Jeune homme","fr":"C’est quoi, ton nom ?","ar":"الشاب: ما هو اسمكِ (لقبك)؟"},{"who":"Julie","fr":"Mon nom ?","ar":"جولي: اسمي؟"},{"who":"Jeune homme","fr":"Bah oui, comment tu t’appelles ?","ar":"الشاب: نعم، ماذا تُدعَين؟"},{"who":"Julie","fr":"Prévost. Enfin, mon prénom c’est Julie, et mon nom c’est Prévost.","ar":"جولي: بريفو. أقصد أن اسمي الشخصي جولي، واسم عائلتي بريفو."},{"who":"Jeune homme","fr":"Tu es étudiante ?","ar":"الشاب: هل أنتِ طالبة؟"},{"who":"Julie","fr":"Non. Et toi ?","ar":"جولي: لا. وأنت؟"},{"who":"Jeune homme","fr":"Moi, je suis stagiaire.","ar":"الشاب: أنا متدرب."},{"who":"Julie","fr":"Stagiaire ? Ah oui ! Et lui, c’est qui ?","ar":"جولي: متدرب؟ آه نعم! وهو، من يكون؟"},{"who":"Jeune homme","fr":"Lui, c’est Benoît Royer.","ar":"الشاب: هو، إنه بينوا رواييه."},{"who":"Benoît","fr":"Benoît, c’est moi ! Je suis français, je suis agent de voyage, et j’habite ici, au 4 rue du Cardinal Mercier. Tu es chez moi, ici. Et maintenant... salut ! Au revoir !","ar":"بينوا: بينوا هو أنا! أنا فرنسي، وأعمل وكيل سفر، وأسكن هنا في 4 شارع الكاردينال ميرسييه. أنتَ في منزلي هنا. والآن... سلام! إلى اللقاء!"}]},{"title":"المشهد الثالث: الجنسية والمهن (Nationalités et Métiers)","ctx":"الشخصيات: محاور وإنغريد (Ingrid) — سؤال الجنسية ثم الجمع بين الدراسة والعمل ثم تخمين المهنة.","lines":[{"who":"Homme","fr":"C’est un joli prénom, Ingrid. Quelle est votre nationalité ?","ar":"الرجل: إنه اسم جميل يا إنغريد. ما هي جنسيتكِ؟"},{"who":"Ingrid","fr":"Je suis allemande.","ar":"إنغريد: أنا ألمانية."},{"who":"Homme","fr":"Vous êtes allemande. Et vous êtes étudiante ?","ar":"الرجل: أنتِ ألمانية. وهل أنتِ طالبة؟"},{"who":"Ingrid","fr":"Oui, je suis étudiante et je travaille aussi.","ar":"إنغريد: نعم، أنا طالبة وأعمل أيضاً."},{"who":"Homme","fr":"Ah bon ? Vous êtes mannequin, je suis sûr !","ar":"الرجل: حقاً؟ أنتِ عارضة أزياء، أنا متأكد!"},{"who":"Ingrid","fr":"C’est vrai, je suis mannequin.","ar":"إنغريد: هذا صحيح، أنا عارضة أزياء."}]},{"title":"المشهد الرابع: المستأجر الجديد (Le Nouveau Locataire)","ctx":"تقديم شخص غائب بصيغة (C’est) ثم وصفه وأخذ الموافقة — خاتمة الحلقة.","lines":[{"who":"Femme","fr":"C’est Benoît Royer ?","ar":"المرأة: هل هذا بينوا رواييه؟"},{"who":"Benoît","fr":"Non, Pascal Lefèvre, le nouveau locataire. Il est très sympa !","ar":"بينوا: لا، (إنه) باسكال لوفيفر، المستأجر الجديد. إنه لطيف جداً!"},{"who":"Femme","fr":"Vraiment ?","ar":"المرأة: حقاً؟"},{"who":"Benoît","fr":"Oui ! Mais... tu es d’accord ?","ar":"بينوا: نعم! لكن... هل أنتِ موافقة؟"},{"who":"Femme","fr":"Oui, je suis d’accord.","ar":"المرأة: نعم، أنا موافقة."}]}],"exercises":[{"t":"mcq","skill":"speaking","q":"الصيغة الصحيحة للتعريف بالمهنة:","opts":["Je suis professeur","J'ai professeur","Je suis de professeur","Être un professeur"],"a":0,"why":"المهنة تأتي مع être مباشرة."},{"t":"fill","skill":"speaking","q":"أكمل: «Je ___ de Marrakech.» (جئت)","fr":"Je ___ de Marrakech.","ans":"viens","alts":["vien","Viens"],"why":"venir de + مكان = جئت من."},{"t":"mcq","skill":"listening","q":"التحية المناسبة مساءً:","opts":["Bonsoir","Bonne nuit","Bonne journée","Salut"],"a":0,"why":"Bonsoir تُقال عند اللقاء المسائي؛ bonne nuit عند الوداع للنوم."},{"t":"order","skill":"speaking","q":"رتّب جملة التعارف: الاسم ثم المهنة ثم الأصل","words":["Je","m'appelle","Lina,","je","suis","infirmière,","je","viens","de","Tunis."],"ans":"Je m'appelle Lina, je suis infirmière, je viens de Tunis.","why":"اسم ← عمل ← أصل ترتيب التعارف الفرنسي."},{"t":"listen","skill":"listening","q":"أي جملة سمعتها في مقطع التعارف؟","opts":["Je viens de Lyon","Je viens à Lyon","Je vais de Lyon","Je suis à Lyon"],"a":0,"why":"«viens de» تدل على الأصل لا الاتجاه."},{"t":"translate","skill":"writing","q":"ترجم: «تشرّفت بمعرفتكم، أنا جديد هنا.»","ans":"Enchanté de vous rencontrer, je suis nouveau ici.","alts":["enchante de vous rencontrer, je suis nouveau ici"],"why":"enchanté de + مصدر ثم essere بمفرد."},{"t":"correct","skill":"writing","q":"صحّح: «J'ai étudiant à Alger.»","ans":"Je suis étudiant","alts":["je suis étudiant à Alger","Je suis étudiant à Alger"],"why":"الصفة/المهنة مع être."},{"t":"speaking","skill":"speaking","q":"قدّم نفسك في 3 جمل (الاسم، المهنة، الأصل) — اكتب ثم انطقها بصوت عالٍ.","target":"Je m'appelle... , je suis... , je viens de...","why":"الإنتاج الشفهي الموجّه هو هدف الحلقة."},{"t":"mcq","skill":"grammar","q":"«Qui est-ce ? — ......... Pascal Lefèvre.» اختر الصيغة الصحيحة:","opts":["C’est","Il est","Il a"],"a":0,"why":"اسم علم بعد Qui est-ce يُعرَّف بـ C’est مباشرة: C’est Pascal Lefèvre."},{"t":"mcq","skill":"grammar","q":"«Ingrid travaille : ......... mannequin.» اختر الصيغة الصحيحة:","opts":["Elle est","C’est","Elle a"],"a":0,"why":"مهنة بلا أداة مع الضمير: Elle est mannequin — وليس C’est mannequin."},{"t":"mcq","skill":"grammar","q":"«Benoît habite à Paris : ......... français.» اختر الصيغة الصحيحة:","opts":["Il est","C’est","Il a"],"a":0,"why":"الجنسية صفة بلا أداة: Il est français."},{"t":"mcq","skill":"grammar","q":"«Regarde cet homme : ......... le nouveau locataire.» اختر الصيغة الصحيحة:","opts":["C’est","Il est","Il a"],"a":0,"why":"الأداة le قبل الاسم تفرض C’est: C’est le nouveau locataire."},{"t":"fill","skill":"grammar","q":"أكمل بالضمير التوكيدي المناسب: «....., je m’appelle Julie.»","fr":"___, je m’appelle Julie.","ans":"Moi","alts":["Moi,","moi"],"why":"توكيد الفاعل قبل «je m’appelle» بـ Moi مع فاصلة."},{"t":"fill","skill":"grammar","q":"أكمل بالضمير التوكيدي المناسب: «Et ....., tu es stagiaire ?»","fr":"Et ___, tu es stagiaire ?","ans":"toi","alts":["Toi"],"why":"التوكيد مع tu يأتي بصيغة toi."},{"t":"fill","skill":"grammar","q":"أكمل بالضمير التوكيدي المناسب: «....., il est agent de voyage.»","fr":"___, il est agent de voyage.","ans":"Lui","alts":["lui,","lui"],"why":"Lui هو الضمير التوكيدي لـ il — يؤكد ولا يحلّ محله."},{"t":"mcq","skill":"grammar","q":"«Pierre-Henri ? — ......... mon ami.» اختر الصيغة الصحيحة:","opts":["C’est","Il est","Il a"],"a":0,"why":"صفة ملكية (mon) + اسم مع C’est: C’est mon ami."},{"t":"mcq","skill":"grammar","q":"«C’est mon ami, ......... étudiant.» أكمل بالصيغة الصحيحة:","opts":["il est","c’est","il a"],"a":0,"why":"مهنة بلا أداة مع الضمير: il est étudiant."},{"t":"fill","skill":"grammar","q":"أكمل بالضمير التوكيدي المناسب: «....., vous êtes Monsieur de La Tour ?»","fr":"___, vous êtes Monsieur de La Tour ?","ans":"Vous","alts":["vous,","vous"],"why":"التوكيد مع vous يبقى vous: Vous, vous êtes..."},{"t":"fill","skill":"grammar","q":"أكمل بالضمير التوكيدي المناسب: «....., elle est allemande.»","fr":"___, elle est allemande.","ans":"Elle","alts":["elle,","elle"],"why":"Elle هو الضمير التوكيدي لـ elle في جملة الجنسية."}],"homework":"أعد الاستماع للحلقة 3 مرات (تعمّم ← تدقيق ← تكرار)، ثم اكتب حوار تعارف من 6 أسطر مع جار حقيقي أو زميل وسجّله بصوت عالٍ.\nالحلقة السابقة/التالية: a2-t6-l3 ← a2-t7-l1 → a2-t7-l2","sources":[{"title":"Reflets 1 - épisode #1 - Le nouveau locataire","channel":"Jason Mills","videoId":"dzPrX6Mifjo","why":"الحلقة الكاملة — النص الأصلي للمشوار: طبّق ما تعلمه في دروس القواعد والمفردات.","cat":"Séries","level":"A2","main":true,"t":0},{"title":"Do You Have 2 Hours? Stop Studying and Start Speaking French!","channel":"FRENCH TIME","videoId":"4bgCG-XHp6Q","why":"نصيحة المنهج: ساعتان يومياً — كيف تنظّم مراجعة الحلقات","cat":"Conversation","level":"A2","extra":true}],"supplements":[{"id":"4bgCG-XHp6Q","title":"Do You Have 2 Hours? Stop Studying and Start Speaking French!","channel":"FRENCH TIME","why":"نصيحة المنهج: ساعتان يومياً — كيف تنظّم مراجعة الحلقات","dur":144,"lang":"fr"}],"dialoguesAfterObjectives":true,"videoAfterObjectives":true},{"id":"a2-t7-l2","fr":"Épisode 2 — On visite l'appartement","ar":"الحلقة 2 — نزور الشقة","objectives":["التواصل: تقديم أشخاص آخرين (عائلة، أصدقاء، زملاء) بالصيغة الرسمية (je vous présente) وغير الرسمية (je te présente).","السؤال عن العمر بـ (avoir + quel âge) والتعبير عن الاحتياجات الأساسية (J’ai faim / J’ai soif).","تقديم الاعتذار والرد عليه بمستويات لغوية مختلفة (pardon / excuse-moi / excusez-moi).","القواعد: تصريف فعل الملكية (Avoir) في المضارع وصفات الملكية للمفرد (mon, ma, ton, ta, son, sa).","الثقافة: مفهوم الفرنكوفونية (La Francophonie) وانتشار الفرنسية في القارات الخمس."],"sections":[{"h":"الحلقة 2: جولة في الشقة (06:15 — 14:25)","video":{"id":"lG4VVzdVecw","title":"Reflets 1 - épisode #2 - On visite l'appartement","channel":"Daniel (Pavon)","why":"الحلقة الكاملة — النص الأصلي للمشوار: طبّق ما تعلمه في دروس القواعد والمفردات.","lang":"fr","main":true,"t":0,"dur":5},"p":["الزيارة العقارية موقف يومي ومفيد استثنائياً: ما يراه المتعلم أمامه أثاث ومساحات، فيصبح لكل كلمة صورة. هذه الحلقة تبني «il y a» — الجملة الأهم لوصف أي مكان: «Il y a une cuisine spacieuse».","الحركة داخل الشقة تعطي ترتيباً طبيعياً للمفردات: المدخل ← الصالة ← المطبخ ← غرفة النوم. اتبع الترتيب نفسه وأنت تعدّ — ترتيب المكان أثبت من ترتيب القاموس في الذاكرة.","لاحظ حروف الجر حسّياً: «dans la chambre» داخل، «à côté de la fenêtre» بجانب، «en face du balcon» مقابل. الفرنسية تبني المسافة بحروف ثابتة — تعلّمها مع الصورة لا مع الترجمة.","الصفات تأتي بعد الاسم في الفرنسية: «un appartement lumineux» وليس «un lumineux appartement» — الاستثناءات قليلة (beau/grand/petit تسبق أحياناً)، وترتيبها هو أحد أوامر A2 الأساسية.","الاستماع والتكرار هنا أسهل لأن الوصف يُصرَّف بصيغ متكررة: «Il y a...», «C'est...», «Ça fait...» — ثلاث قوالب تعيد ظهورها في كل غرفة. عدّ ظهورها وأنت تسمع؛ العدّ نفسه تمرين استماع.","بعد الحلقة: صف غرفتك أو منزلك في 5 جمل على الورق ثم قرأتها أمام المرآة. إن استطعت أن تصف ما أمامك دون ترجمة، فقد أتقنت مفردات الزيارة."],"sub":[{"h":"قوالب الوصف الثلاث","p":["Il y a une chambre.","C'est spacieux / lumineux.","Ça fait 60 mètres carrés."]},{"h":"حروف الجر للمكان","p":["dans — داخل.","à côté de — بجانب.","en face de — مقابل.","derrière — خلف."]},{"h":"الغرف الأساسية","p":["le salon — الصالة.","la cuisine — المطبخ.","la chambre — غرفة النوم.","la salle de bain — الحمّام."]}]},{"h":"النصوص الحوارية المصححة (Corpus des Dialogues)","p":["النص في تبويب «حوارات» هو المفرغ الأكاديمي للحلقة بعد التنقيح: صُحح «pour l’ pas» إلى «pour les repas» و«Saint-Bodoniface» إلى «Saint-Boniface» — مشهدان: زيارة الوالدين وتقديم بينوا، ثم جولة الشقة وتقديم باسكال.","المشهد الأول: «Papa, maman, je vous présente Benoît Royer» بالرسمية مع الوالدين، ثم «Benoît, je te présente ma mère» بالمألوف مع الصديق — التبديل بين vous وte في الجملة نفسها هو درس الحلقة الاجتماعي.","المشهد الثاني: الغرف بصيغة الملكية («ma chambre», «sa chambre»)، وتقاسم الأعمال («chacun son tour»)، ثم تعبيرات avoir الجسدية («j’ai faim», «j’ai soif») التي تفتح باب القواعد.","طريقة العمل: شغّل الفيديو الرئيسي عند بداية كل مشهد، أوقف بعد كل سطر وقارنه بالنص، ثم أعد المشهد بصوت الممثلين — وركّز على نطق صيغ التقديم والاعتذار."]},{"h":"مفردات الزيارة التي تتكرر","p":["«Est-ce qu'on peut voir la chambre ?» صيغة السؤال أثناء الزيارة — الاستفهام بـ «est-ce que» هو الأكثر أماناً في A2 لأنه لا يغيّر ترتيب الجملة.","«Il y a assez de lumière» و«Le quartier est calme» — جملتا تقييم تُقالان في كل زيارة حقيقية. حفظهما يعني أنك تشارك في الحوار لا أن تسمعه فقط.","الاستدلال على العيب بلباقة: «Le salon est un peu petit, mais...» — البنية «un peu + adj + mais» تُخفّف السلب وتُبقي اللقاء مهذّباً، وهي مهارة اجتماعية قبل أن تكون لغوية."]},{"h":"الأفعال الكلامية والتواصل (Actes de Parole)","p":["١) السؤال عن العمر وذكره: دائماً مع فعل Avoir — مألوف: «Tu as quel âge ? / Quel âge as-tu ?» ← «J’ai 25 ans»، ورسمي: «Vous avez quel âge ؟»، وللغائب: «Il a quel âge ?» ← «Il a 23 ans» — والعمر يُذكر بالعدد + ans.","٢) تقديم شخص: رسمية «Papa, maman, je vous présente Benoît Royer»، ومألوفة «Benoît, je te présente ma mère et mon père»، ومختصرة «Papa, maman, voici Benoît Royer» — والرد: «Je suis heureux (heureuse) de vous connaître» أو «Enchanté(e)».","٣) الاعتذار والرد: «Oh, pardon !» ← «Ce n’est pas grave» (يومي)، و«Excuse-moi» ← «Ce n’est rien» (مألوف)، و«Je suis désolé(e)» ← «Ça (ne) fait rien» (يومي)، و«Excusez-moi / Excusez-nous» ← «Pas grave» (رسمي)، و«Je vous prie de nous excuser» (رسمي جداً)."]},{"h":"ثقافة وحضارة: الفرنكوفونية (La Francophonie)","p":["التقرير الوثائقي في نهاية الحلقة يعرّف الفرنكوفونية: مجموعة الدول والشعوب المتحدثة بالفرنسية حول العالم — القمة السابعة عُقدت في هانوي (Hanoï) بفيتنام بمشاركة 49 دولة تمثل نحو 200 مليون متحدث آنذاك.","الانتشار في القارات الخمس: أوروبا (en Europe)، أفريقيا (en Afrique — ساحل العاج Côte d’Ivoire ودول المغرب العربي le Maghreb)، آسيا (en Asie)، أمريكا (en Amérique)، وأوقيانوسيا (en Océanie — بولينيزيا en Polynésie).","في كندا: مقاطعة كيبك (Québec) يتحدث 7 ملايين بالفرنسية، وفي مدينة سان بونيفاس (Saint-Boniface) بمقاطعة مانيتوبا (Manitoba) تُدرَّس الرياضيات والأدب بالفرنسية وتُكتب لوحات المرور باللغتين."]},{"h":"تمرين الحلقة","p":["تمرين واقعي: افتح إعلاناً عقارياً حقيقياً بالفرنسية (site de vente) واقرأه بصوت عالٍ، ثم حوّله إلى 5 جمل تتحدث بها أنت.","ركّز في التسجيل على «il y a» وحدها: كيف تُلفظ في الكلام السريع ([il.ja] مدموج)؟ هذا التمرين وحده يقرّبك من الطلاقة أكثر من مفردات جديدة.","ما تحفظه: قوالب الوصف الثلاث + أسماء الغرف الست. وبقية الزيارة ستأتي عليها."]},{"h":"التطبيق والتلخيص","p":["الحلقة 2: جولة داخل شقة مع صاحبها — الغرف والمساحة والأثاث والسعر مع بناء «Il y a»، كما في الفيديو الرئيسي «Reflets 1 - épisode #2 - On visite l'appartement»: شغّل من بدايته وأعد كل سؤال وجواب بصوت عالٍ قبل الرجوع إلى دروس القواعد والمفردات.","جسر الحلقات: من a2-t7-l1 (التعارف مع الساكن الجديد) إلى a2-t7-l2 (زيارة الشقة ووصفها)، ثم إلى a2-t7-l3 حيث تتحوّل المحادثة الهادئة إلى شكوى زبونة غير راضية.","المهمة: شاهد الحلقة كاملة، ثم افتح ورقة المفردات وراجع كلمات المسكن (le salon, la cuisine, le balcon, le loyer)، وأخيراً سجّل تلخيصاً شفهياً مدته 30 ثانية تصف فيه شقة تتخيّلها بـ «il y a»."]}],"examples":[{"fr":"Il y a un grand salon avec un balcon.","ar":"توجد صالة كبيرة مع شرفة.","note":"il y a + وصف"},{"fr":"La cuisine est à côté de la chambre.","ar":"المطبخ بجانب غرفة النوم.","note":"حروف الجر"},{"fr":"C'est lumineux et très calme.","ar":"إنه مضيء وهادئ جداً.","note":"صفة مفردة"},{"fr":"On peut visiter l'appartement demain ?","ar":"هل يمكننا زيارة الشقة غداً؟","note":"سؤال الزيارة"},{"fr":"Le quartier est sympa, mais le salon est petit.","ar":"الحي لطيف، لكن الصالة صغيرة.","note":"الموازنة"},{"fr":"Ça fait combien de mètres carrés ?","ar":"كم المساحة بالمتر المربع؟","note":"سؤال المساحة"},{"fr":"Il a quel âge ? Il a 23 ans.","ar":"كم عمره؟ عمره 23 عاماً.","note":"السؤال عن العمر"},{"fr":"Papa, maman, je vous présente Benoît Royer.","ar":"أبي، أمي، أقدم لكما بينوا رواييه.","note":"التقديم الرسمي"},{"fr":"Moi aussi, j’ai faim et j’ai soif.","ar":"أنا أيضاً جائعة وعطشى.","note":"تعبيرات avoir"}],"pron":[{"w":"il y a","ipa":"[il.ja]","approx":"يليا"},{"w":"lumineux","ipa":"[ly.mi.nø]","approx":"لومينُ"},{"w":"quartier","ipa":"[kaʁ.tje]","approx":"كارتيس"}],"vocab":[{"fr":"l'appartement","ar":"الشقة","pos":"nom","g":"m","exFr":"Un appartement à louer.","ipa":"a.paʁt.mɑ̃","exAr":"شقة للإيجار."},{"fr":"le salon","ar":"الصالة","pos":"nom","g":"m","exFr":"Le salon est grand.","ipa":"salɔ̃","exAr":"الصالة كبيرة."},{"fr":"la cuisine","ar":"المطبخ","pos":"nom","g":"f","exFr":"La cuisine est moderne.","ipa":"kɥi.zin","exAr":"المطبخ حديث."},{"fr":"la chambre","ar":"غرفة النوم","pos":"nom","g":"f","exFr":"Il y a deux chambres.","ipa":"ʃɑ̃bʁ","exAr":"توجد غرفتان."},{"fr":"le balcon","ar":"الشرفة","pos":"nom","g":"m","exFr":"Un balcon sur la rue.","ipa":"bal.kɔ̃","exAr":"شرفة على الشارع."},{"fr":"spacieux(se)","ar":"واسع","pos":"adj","exFr":"Une salle spacieuse.","ipa":"spa.sjø","exAr":"قاعة واسعة."},{"fr":"la surface","ar":"المساحة","pos":"nom","g":"f","exFr":"L'appartement fait 65 m² de surface.","ipa":"[la syʁ.fas]","exAr":"مساحة الشقة 65 متراً مربعاً."},{"fr":"meublé(e)","ar":"مؤثث","pos":"adj","exFr":"Un studio meublé.","ipa":"mø.ble","exAr":"استوديو مؤثث."},{"fr":"le loyer","ar":"الإيجار","pos":"nom","g":"m","exFr":"Le loyer est élevé.","ipa":"lwa.je","exAr":"الإيجار مرتفع."},{"fr":"clair(e)","ar":"مضيء/واضح","pos":"adj","exFr":"Une pièce claire.","ipa":"klɛʁ","exAr":"غرفة مضيئة."},{"fr":"le quartier","ar":"الحيّ","pos":"nom","g":"m","exFr":"Un quartier calme.","ipa":"kaʁ.tje","exAr":"حي هادئ."},{"fr":"en face de","ar":"مقابل","pos":"locution","exFr":"En face de la boulangerie.","ipa":"ɑ̃ fas də","exAr":"مقابل المخبز."},{"fr":"la mère / le père","ar":"الأم / الأب","pos":"nom","exFr":"Je vous présente ma mère et mon père.","exAr":"أقدم لكما أمي وأبي.","ipa":"mɛʁ / pɛʁ"},{"fr":"un lit / une chaise","ar":"سرير / كرسي","pos":"nom","exFr":"Tu as un lit.","exAr":"لديك سرير.","ipa":"li / ʃɛz"},{"fr":"faire le ménage","ar":"يقوم بالتنظيف","pos":"locution","exFr":"La cuisine, c’est comme le ménage.","exAr":"الطبخ مثل التنظيف.","ipa":"fɛʁ lə menaʒ"},{"fr":"une femme de ménage","ar":"عاملة نظافة","pos":"nom","g":"f","exFr":"C’est toi la femme de ménage ici ?","exAr":"هل أنتِ المسؤولة عن التنظيف هنا؟","ipa":"fam də menaʒ"},{"fr":"un cuisinier / une cuisinière","ar":"طباخ / طباخة","pos":"nom","exFr":"Papa, c’est toi le cuisinier en chef ?","exAr":"يا أب، هل أنت كبير الطهاة؟","ipa":"kɥizinje / kɥizinjɛʁ"},{"fr":"sérieux / sérieuse","ar":"جاد / جادة","pos":"adj","exFr":"C’est un garçon sérieux.","exAr":"إنه شاب جاد.","ipa":"seʁjø / seʁjøz"},{"fr":"gentil / gentille","ar":"لطيف / لطيفة","pos":"adj","exFr":"Il a l’air très gentil.","exAr":"يبدو لطيفاً جداً.","ipa":"ʒɑ̃ti / ʒɑ̃tij"},{"fr":"rangé(e)","ar":"مُرتَّب / مُنظَّم","pos":"adj","exFr":"Elle est grande et bien rangée !","exAr":"إنها كبيرة ومرتبة جيداً!","ipa":"ʁɑ̃ʒe"},{"fr":"être seul(e)","ar":"يكون وحده / بمفرده","pos":"locution","exFr":"Tu es seule ?","exAr":"هل أنتِ بمفردكِ؟","ipa":"ɛtʁ sœl"},{"fr":"chacun son tour","ar":"كلٌّ بدوره (بالدور)","pos":"locution","exFr":"Chacun son tour !","exAr":"كلٌّ بدوره!","ipa":"ʃakœ̃ sɔ̃ tuʁ"},{"fr":"la francophonie","ar":"الفرنكوفونية (العالم الناطق بالفرنسية)","pos":"nom","g":"f","exFr":"La francophonie sur les cinq continents.","exAr":"الفرنكوفونية في القارات الخمس.","ipa":"fʁɑ̃kɔfɔni"},{"fr":"un panneau de signalisation","ar":"لوحة إرشادية / لافتة مرور","pos":"nom","g":"m","exFr":"Les panneaux en deux langues.","exAr":"اللوحات باللغتين.","ipa":"pano də siɲalizasjɔ̃"}],"grammar":[{"tFr":"Il y a / il n'y a pas : décrire un lieu","tAr":"القاعدة: وجود الشيء في المكان","body":["«Il y a» الثابت لا يتغيّر مع العدد ولا الجنس: «il y a un livre», «il y a deux livres», «il y a une table» — النفي «Il n'y a pas de...» مع حذف الأداة، وهذه النقطة (pas de) تُصحَّح في كل امتحان.","التمييز بين «c'est» و«il y a»: «C'est la cuisine» لتحديد وتعيين، و«Il y a une cuisine» للوجود — الخطأ يقلب المعنى من «هذه هي المطبخ» إلى «هناك مطبخ»."],"ex":[{"fr":"Il n'y a pas de meubles dans la chambre.","ar":"لا توجد أثاث في الغرفة."},{"fr":"C'est la chambre, à gauche.","ar":"هذه غرفة النوم، على اليسار."}]},{"tFr":"Le verbe Avoir au présent","tAr":"فعل الملكية (Avoir) وتعبيراته","body":["التصريف: j’ai, tu as, il/elle/on a, nous avons, vous avez, ils/elles ont — يُستعمل للملكية («J’ai une chambre»)، والعمر («J’ai 25 ans» / «Il a 23 ans»)، وبعض الأحاسيس الجسدية بلا أداة.","تعبيرات avoir الثابتة: «avoir faim» (جائع) ← «J’ai faim»، و«avoir soif» (عطشان)، و«avoir raison» (على حق) ← «Elle a raison»، و«avoir l’air + صفة» (يبدو) ← «Il a l’air gentil».","الخطأ القاتل: العمر مع avoir لا مع être — «J’ai 23 ans» صحيح و«Je suis 23 ans» خطأ، لأن الرقم هنا مقدار مملوك لا صفة."],"ex":[{"fr":"Il a quel âge ? Il a 23 ans.","ar":"كم عمره؟ عمره 23 عاماً."},{"fr":"Moi aussi, j’ai faim et j’ai soif.","ar":"أنا أيضاً جائعة وعطشى."},{"fr":"Elle a raison.","ar":"معها حق."}]},{"tFr":"Les adjectifs possessifs (mon, ma, ton, ta, son, sa)","tAr":"صفات الملكية للمفرد","body":["الصفة تتبع جنس المملوك لا جنس المالك: مع المالك je نقول «mon père» (مذكر) و«ma chambre» (مؤنث)، ومع tu نقول «ton lit» و«ta mère»، ومع الغائب «son prénom» و«sa chaise» — والجنس يُقرأ من الاسم لا من صاحبه.","التعبير عن الملكية بطريقتين: بفعل avoir («J’ai une chambre») أو بالصفة («C’est ma chambre») — والثانية أدق لأنها تسمّي المالك والمملوك معاً.","تكملة: «votre» للمخاطب الرسمي أو الجمع («Continuez votre travail»)، و«leur» للغائبين الجمع («Les francophones aiment leur langue»)."],"ex":[{"fr":"C’est ma chambre.","ar":"إنها غرفتي."},{"fr":"C’est sa chambre... Oui, c’est sa chambre.","ar":"إنها غرفته... نعم، إنها غرفته."},{"fr":"Continuez votre travail.","ar":"واصلوا عملكم."}]}],"mistakes":[{"wrong":"«Il n'y a pas un...»","right":"«Il n'y a pas de...»","why":"بعد النفي يتحوّل الأداة المفردة إلى de."},{"wrong":"الصفة قبل الاسم دائماً","right":"الصفة بعد الاسم (أصل)","why":"الترتيب الفرنسي: nom + adjectif — الاستثناءات قليلة."},{"wrong":"«C'est une cuisine» عند الوصف المتكرر","right":"«Il y a une cuisine» للوجود","why":"تعيين ≠ وجود، والخلط يغيّر المعنى."},{"wrong":"حروف الجر مترجمة حرفياً","right":"dans / à côté de / en face de محفوظة","why":"حروف الجر للمكان قوالب ثابتة تُحفظ كما هي."},{"wrong":"«Je suis 23 ans»","right":"«J’ai 23 ans»","why":"العمر مقدار مع فعل الملكية avoir لا مع فعل الكينونة."},{"wrong":"«son mère»","right":"«sa mère»","why":"الصفة تتبع جنس المملوك (mère مؤنث ← sa) لا جنس المالك."}],"dialogues":[{"title":"المشهد الأول: زيارة الوالدين وتقديم بينوا (Visite des parents)","ctx":"الشخصيات: جولي (Julie)، والدتها (La mère)، والدها (Le père)، وبينوا رواييه — النص بعد تنقيح المفرغ.","lines":[{"who":"La mère","fr":"Tu es seule ?","ar":"الأم: هل أنتِ بمفردكِ؟"},{"who":"Julie","fr":"Oui, Benoît travaille. Il est à l’agence de voyage.","ar":"جولي: نعم، بينوا يعمل. إنه في وكالة السفر."},{"who":"Le père","fr":"Mais c’est samedi aujourd’hui !","ar":"الأب: ولكن اليوم هو السبت!"},{"who":"Julie","fr":"Oui, il travaille aussi le samedi.","ar":"جولي: نعم، هو يعمل يوم السبت أيضاً."},{"who":"La mère","fr":"C’est un garçon sérieux.","ar":"الأم: إنه شاب جاد."},{"who":"Julie","fr":"Tiens, c’est sûrement lui, il est 6 heures... Salut Benoît, ça va ?","ar":"جولي: ها هو، إنه هو بالتأكيد، الساعة السادسة... مرحباً بينوا، كيف حالك؟"},{"who":"Benoît","fr":"Ça va bien, et toi ?","ar":"بينوا: بخير، وأنتِ؟"},{"who":"Julie","fr":"Oui, moi aussi. Papa, maman, je vous présente Benoît Royer. Benoît, je te présente ma mère...","ar":"جولي: نعم، أنا أيضاً. أبي، أمي، أقدم لكما بينوا رواييه. بينوا، أقدم لك والدتي..."},{"who":"La mère","fr":"Bonjour Benoît, je suis heureuse de vous connaître.","ar":"الأم: مرحباً بينوا، أنا سعيدة بمعرفتك."},{"who":"Julie","fr":"... et mon père.","ar":"جولي: ... ووالدي."},{"who":"Le père","fr":"Bonjour Monsieur.","ar":"الأب: مرحباً سيدي."},{"who":"Benoît","fr":"Bonjour Monsieur. Enchanté. Excusez-moi...","ar":"بينوا: مرحباً سيدي. تشرفت بمعرفتكم. اعذروني (عن إذنكم)..."},{"who":"La mère","fr":"Il a l’air très gentil. Et le nouveau locataire alors, c’est Pascal son prénom ?","ar":"الأم: يبدو لطيفاً جداً. وماذا عن المستأجر الجديد إذن، هل اسمه الأول باسكال؟"},{"who":"Julie","fr":"Oui, c’est ça. Il s’appelle Pascal Lefèvre.","ar":"جولي: نعم، هذا صحيح. اسمه باسكال لوفيفر."},{"who":"Le père","fr":"Et il travaille ?","ar":"الأب: وهل يعمل؟"},{"who":"Julie","fr":"Non, il est comme moi, il cherche du travail.","ar":"جولي: لا، إنه مثلي، يبحث عن عمل."},{"who":"Le père","fr":"Eh oui, hein, c’est difficile... Il a quel âge ?","ar":"الأب: آه نعم، الأمر صعب... كم عمره؟"},{"who":"Julie","fr":"Il a 23 ans.","ar":"جولي: عمره 23 عاماً."}]},{"title":"المشهد الثاني: جولة في الشقة وتقديم باسكال (Visite de l’appartement)","ctx":"الشخصيات: جولي، الأب، الأم، وباسكال (Pascal) — الغرف، تقاسم الأعمال، الجوع، والمطعم.","lines":[{"who":"Julie","fr":"Venez, on visite l’appartement. Voilà ma chambre.","ar":"جولي: تعالوا، لنقم بجولة في الشقة. ها هي غرفتي."},{"who":"La mère","fr":"Elle est grande et bien rangée ! C’est toi la femme de ménage ici ?","ar":"الأم: إنها كبيرة ومرتبة جيداً! هل أنتِ المسؤولة عن التنظيف هنا؟"},{"who":"Julie","fr":"Sûrement pas ! Pour ma chambre, d’accord, mais pour le reste...","ar":"جولي: بالتأكيد لا! بالنسبة لغرفتي، موافقة، لكن بالنسبة للباقي..."},{"who":"Le père","fr":"Et pour les repas, c’est toi la cuisinière en chef ?","ar":"الأب: وبالنسبة للوجبات، هل أنتِ كبيرة الطهاة؟"},{"who":"Julie","fr":"Arrête papa ! La cuisine, c’est comme le ménage : chacun son tour.","ar":"جولي: توقف يا أبي! الطبخ مثل التنظيف: كلٌّ بدوره."},{"who":"La mère","fr":"Elle a raison. Homme, femme, c’est la même chose.","ar":"الأم: معها حق. رجل أو امرأة، الأمر سيان."},{"who":"Le père","fr":"Ouais, peut-être, ouais...","ar":"الأب: نعم، ربما، نعم..."},{"who":"Julie","fr":"Ici, c’est la chambre de Benoît. Et là, c’est la chambre de Pascal. Oui, c’est sa chambre... Oh ! Tu es là, Pascal ? Excuse-moi ! Papa, maman, je vous présente Pascal.","ar":"جولي: هنا غرفة بينوا. وهناك غرفة باسكال. نعم، إنها غرفته... أوه! هل أنت هنا يا باسكال؟ اعذرني! أبي، أمي، أقدم لكما باسكال."},{"who":"La mère","fr":"Bonjour Pascal. Je suis heureuse de vous connaître.","ar":"الأم: مرحباً باسكال. أنا سعيدة بمعرفتك."},{"who":"Pascal","fr":"Bonjour Madame. Bonjour Monsieur. Enchanté.","ar":"باسكال: مرحباً سيدتي. مرحباً سيدي. تشرفت بمعرفتكما."},{"who":"Le père","fr":"Bonjour Monsieur. Excusez-nous, hein. Continuez votre travail.","ar":"الأب: مرحباً سيدي. اعذرنا. واصل عملك."},{"who":"Julie","fr":"Et voilà la cuisine !","ar":"جولي: وها هو المطبخ!"},{"who":"La mère","fr":"Ah, toi, tu as faim !","ar":"الأم: آه، أنتَ جائع! (موجهة الكلام للأب)"},{"who":"Le père","fr":"Oui, j’ai faim. C’est l’heure !","ar":"الأب: نعم، أنا جائع. لقد حان الوقت!"},{"who":"Julie","fr":"Moi aussi, j’ai faim et j’ai soif.","ar":"جولي: أنا أيضاً جائعة وعطشى."},{"who":"La mère","fr":"On mange ici ? Papa, c’est toi le cuisinier en chef aujourd’hui ?","ar":"الأم: هل نأكل هنا؟ يا أب، هل أنت كبير الطهاة اليوم؟"},{"who":"Le père","fr":"Euh... Il y a un bon restaurant dans ton quartier ?","ar":"الأب: إمم... هل يوجد مطعم جيد في حيكِ؟"}]}],"exercises":[{"t":"mcq","skill":"reading","q":"الصيغة الصحيحة للنفي مع «il y a»:","opts":["Il n'y a pas de problème","Il n'y a pas un problème","Il ne y a pas de problème","Pas il y a problème"],"a":0,"why":"بعد pas تأتي de مهما كانت الأداة."},{"t":"fill","skill":"writing","q":"أكمل: «Il ___ deux fenêtres dans la chambre.»","fr":"Il ___ deux fenêtres dans la chambre.","ans":"y a","alts":["a"],"why":"Il y a مع الجمع يبقى كما هو."},{"t":"mcq","skill":"listening","q":"«La cuisine est à côté de la chambre» تعني:","opts":["المطبخ بجانب الغرفة","المطبخ داخل الغرفة","المطبخ مقابل الغرفة","الغرفة كبيرة"],"a":0,"why":"à côté de = بجانب."},{"t":"order","skill":"writing","q":"رتّب وصف الشقة","words":["Il","y","a","un","salon","lumineux","avec","un","balcon."],"ans":"Il y a un salon lumineux avec un balcon.","why":"il y a ← الاسم ← الصفة ← التوسعة."},{"t":"listen","skill":"listening","q":"أي عبارة وصف مكان سمعتها؟","opts":["C'est très calme ici","Je suis très calme","Il est calme demain","On est à Calme"],"a":0,"why":"«C'est + صفة» وصف المكان بأسلوب الحلقة."},{"t":"translate","skill":"writing","q":"ترجم: «توجد غرفتان واسعتان وشرفة صغيرة.»","ans":"Il y a deux chambres spacieuses et un petit balcon.","alts":["il y a deux chambres spacieuses et un petit balcon"],"why":"il y a + جمع ثم الصفات بالجمع."},{"t":"correct","skill":"writing","q":"صحّح: «C'est une fenêtre dans le salon.» (وصف الوجود)","ans":"Il y a une fenêtre","alts":["il y a une fenêtre dans le salon"],"why":"الوجود الوصفي يبدأ بـ il y a."},{"t":"writing","skill":"writing","q":"صف غرفتك في 4 جمل باستخدام il y a وحروف الجر.","target":"Dans ma chambre, il y a...","why":"إنتاج موجّه يثبّت القالب."},{"t":"fill","skill":"grammar","q":"أكمل بتصريف avoir: «Quel âge ___-tu ?»","fr":"Quel âge ___-tu ?","ans":"as","alts":["As"],"why":"المخاطب tu مع avoir يأخذ as."},{"t":"fill","skill":"grammar","q":"أكمل بتصريف avoir: «J’___ 23 ans.»","fr":"J’___ 23 ans.","ans":"ai","alts":["Ai"],"why":"المتكلم je مع avoir يأخذ ai — والعمر دائماً مع avoir."},{"t":"fill","skill":"grammar","q":"أكمل بتصريف avoir: «Pascal ___ une grande chambre.»","fr":"Pascal ___ une grande chambre.","ans":"a","alts":["A"],"why":"الغائب il مع avoir يأخذ a."},{"t":"fill","skill":"grammar","q":"أكمل بتصريف avoir: «Nous ___ faim.»","fr":"Nous ___ faim.","ans":"avons","alts":["Avons"],"why":"المتكلم الجمع nous مع avoir يأخذ avons."},{"t":"fill","skill":"grammar","q":"أكمل بتصريف avoir: «Vous ___ l’air très sérieux !»","fr":"Vous ___ l’air très sérieux !","ans":"avez","alts":["Avez"],"why":"المخاطب vous مع avoir يأخذ avez."},{"t":"mcq","skill":"grammar","q":"اختر صفة الملكية: «c’est ( ... ) chambre» (غرفتي)","opts":["ma","mon","mes"],"a":0,"why":"chambre مؤنث مفرد مع المالك je ← ma."},{"t":"mcq","skill":"grammar","q":"اختر صفة الملكية: «c’est ( ... ) lit» (سريرك)","opts":["ton","ta","tes"],"a":0,"why":"lit مذكر مفرد مع المالك tu ← ton."},{"t":"mcq","skill":"grammar","q":"اختر صفة الملكية: «dans ( ... ) chambre» (غرفته)","opts":["sa","son","ses"],"a":0,"why":"chambre مؤنث مع الغائب ← sa."},{"t":"mcq","skill":"grammar","q":"اختر صفة الملكية: «je présente ( ... ) père» (والدي)","opts":["son","sa","ses"],"a":0,"why":"père مذكر مع الغائب ← son (الجنس من المملوك)."},{"t":"mcq","skill":"grammar","q":"اختر صفة الملكية: «je présente ( ... ) mère» (والدتي)","opts":["sa","son","ses"],"a":0,"why":"mère مؤنث مع الغائب ← sa."},{"t":"mcq","skill":"grammar","q":"اختر صفة الملكية: «dans ( ... ) quartier ?» (حيّك)","opts":["ton","ta","tes"],"a":0,"why":"quartier مذكر مفرد مع tu ← ton."},{"t":"mcq","skill":"speaking","q":"لتقديم والدك لصديقك تقول:","opts":["Je te présente mon père","J’ai faim","C’est pas grave"],"a":0,"why":"التقديم المألوف: je te présente + الاسم."},{"t":"mcq","skill":"speaking","q":"للاعتذار بشكل رسمي جداً تقول:","opts":["Je vous prie de m’excuser","Salut","Chacun son tour"],"a":0,"why":"أرقى صيغة اعتذار في الجدول (Soutenu)."},{"t":"mcq","skill":"speaking","q":"للرد على شخص يعتذر لك تقول:","opts":["Ce n’est pas grave","Enchanté","J’ai 25 ans"],"a":0,"why":"الرد القياسي على الاعتذار."}],"homework":"أعد الحلقة من 06:15 ثلاث مرات، ثم اكتب إعلاناً عقارياً من 5 أسطر لشقة تملكها (المساحة، الغرف، الموقع، السعر).\nالحلقة السابقة/التالية: a2-t7-l1 ← a2-t7-l2 → a2-t7-l3","sources":[{"title":"Reflets 1 - épisode #2 - On visite l'appartement","channel":"Daniel (Pavon)","videoId":"lG4VVzdVecw","why":"الحلقة الكاملة — النص الأصلي للمشوار: طبّق ما تعلمه في دروس القواعد والمفردات.","cat":"Séries","level":"A2","main":true,"t":0},{"title":"Vocabulaire du logement 🏠 - Comment on dit #21","channel":"Tout en français","videoId":"iI9_cLn31oM","why":"مفردات السكن والشقة بالصور والجمل الجاهزة — يثبّت كلمات الحلقة قبل أن تكتب إعلانك العقاري.","cat":"Vocabulaire","level":"A2","extra":true}],"supplements":[{"id":"iI9_cLn31oM","title":"Vocabulaire du logement 🏠 - Comment on dit #21","channel":"Tout en français","why":"مفردات السكن والشقة بالصور والجمل الجاهزة — يثبّت كلمات الحلقة قبل أن تكتب إعلانك العقاري.","dur":5,"lang":"fr"}],"videoAfterObjectives":true,"dialoguesAfterObjectives":true},{"id":"a2-t7-l3","fr":"Épisode 3 — Une cliente difficile","ar":"الحلقة 3 — زبونة صعبة","objectives":["التواصل: التعبير عن عدم الفهم أو الاستغراب وطلب التوضيح (Quoi ? Comment ça ?).","التحدث عن وسائل الدفع (نقداً، بشيك، ببطاقة مصرفية) بحروف الجر الصحيحة.","اقتراح التحدث بصيغة المألوف (Se tutoyer) بين الزملاء والرد على الاقتراح.","القواعد: استخدامات حرف الجر Pour — التخصيص (Attribution) والهدف (But) — والتمييز بين (Pour qui ؟) و(Pourquoi ؟).","الثقافة: أبرز الأعياد الفرنسية (Noël، La Chandeleur، Le Carnaval de Nice)."],"sections":[{"h":"الحلقة 3: زبونة غير راضية (14:25 — 22:50)","video":{"id":"eRga8nz4Cus","title":"Reflets 1 - épisode #3 - Une cliente difficile","channel":"Jason Mills","why":"الحلقة الكاملة — النص الأصلي للمشوار: طبّق ما تعلمه في دروس القواعد والمفردات.","lang":"fr","main":true,"t":0,"dur":6},"p":["الزبون الصعب هو اختبار اللباقة: الفرنسية تُقيّم الموظف على نبرته قبل محتوى جملته. في هذه الحلقة يتعلّم المتعلم أن يبدأ بالاستماع لا بالدفاع — «Je vous écoute» أول جملة تهدئ أي مواجهة.","بنية الثلاثية الذهبية في الشكوى: اعتراف («Je comprends votre frustration») ← تفسير («Le problème vient de...») ← حل («Je propose...»). الثلاثية نفسها تُقال في المحل والهاتف والإيميل — قوالب قابلة للنقل.","لاحظ حِرفة النفي المهذّب: «Je ne pense pas que...» + المنصوب، أو «Ce n'est pas tout à fait ça» — الرفض المباشر «Non» نادر في الخدمة الفرنسية؛ التخفيف جزء من المعنى.","الكلمات الدليلة للحلقة: «le conseiller», «le remboursement», «la garantie» — إن تعرّفت على اتجاه الحديث من ثلاث كلمات، فهمت الحلقة حتى لو فاتتك جملة.","أسلوب Listen & Repeat مطلوب خصوصاً هنا لأن النبرة الحاسمة: نبرة صاعدة أثناء الإنصات، ونبرة هادئة مستقرة أثناء الحل. كرّر الجمل بعد النبرة نفسها — تعلّم النبرة قبل المعنى.","بعد الحلقة: لخّص موقفاً حدث لك شكوت فيه في 4 جمل فرنسية بالثلاثية (اعتراف ← تفسير ← حل). إن قدرت على بنائها، فقد أتقنت ما فيه الحلقة."],"sub":[{"h":"أول ثلاث جمل للتهدئة","p":["Je vous écoute.","Je comprends, madame.","Je suis désolé(e) du désagrément."]},{"h":"بنية الحل","p":["Le problème vient de...","Ce que je peux faire, c'est...","Je vous propose..."]},{"h":"مفردات النزاع","p":["le remboursement — الاسترداد.","la garantie — الضمان.","le reçu — الإيصال.","échanger — يستبدل."]}]},{"h":"النصوص الحوارية المصححة (Corpus des Dialogues)","p":["النص في تبويب «حوارات» هو المفرغ الأكاديمي للحلقة بعد التنقيح: صُحح «petite ent» إلى «petite plaisanterie» و«on se tu toi» إلى «on se tutoie» و«sentant de Provence» إلى «santons de Provence» — ثلاثة مشاهد: الصباح، الوكالة، وبين الزملاء.","المشهد الأول: موعد الصباح («Tu as un rendez-vous ce matin ؟») والمرور بالبنك قبل المكتب — ثم التمني المتبادل «Passe une bonne journée !» ← «Merci, toi aussi !».","المشهد الثاني: مقلب آني («C’est une petite plaisanterie pour souhaiter la bienvenue») ثم أزمة العميلة الغاضبة — وثيقة الهوية الإلزامية («une pièce d’identité est obligatoire»)، ثم الدفع («Vous payez par chèque ؟» ← «je préfère par carte bancaire»).","المشهد الثالث: رفع الكلفة بين الزملاء («À propos, on se tutoie ? Tu es de la maison maintenant !» ← «Oui, bien sûr !») — وهي الصيغة التي ستستعملها آني ونيكول مع لوران في الحلقة التالية.","طريقة العمل: مثّل المشهد الثاني بأدوار (عميلة غاضبة / متدرب مرتبك / بينوا المنقذ) — فالحوار هنا مسرحي بامتياز ويحفظ عن ظهر قلب بالتمثيل لا بالتكرار."]},{"h":"عبارات الخدمة والاعتذار","p":["«Je vous prie de bien vouloir patienter» — طلب الانتظار بصيغة كاملة، و«patienter» نفسها أرقى من «attendre» في الخدمة. التفرقة بين المستويات في المفردات لا في القواعد.","«Sans plus attendre, je m'en occupe» جملة تُحوّل الشكوى إلى فعل: «أشتغل عليها فوراً». الزبون يسمع فيها احتراماً وثقة معاً — وهي أفضل جملة إغلاق للشكوى.","«Est-ce que je peux avoir votre nom, s'il vous plaît؟» — طلب المعلومات بالاستفهام المهذّب بدل الأمر. تذكّر: في الفرنسية السؤال أخصر طريق إلى قلب المتحدث."]},{"h":"الأفعال الكلامية والتواصل (Actes de Parole)","p":["١) طلب التوضيح والاستغراب: «Quoi ? Comment ça, « un remplaçant » ؟» و«Ça veut dire quoi, « un remplaçant » ؟» و«« Un remplaçant », qu’est-ce que tu veux dire ؟» و«qu’est-ce que ça signifie ؟» — أربع صيغ للسؤال عن معنى كلمة سمعتها أول مرة.","٢) وسائل الدفع: بشيك «Payer par chèque / Faire un chèque»، وبالبطاقة «Payer par carte bancaire / par carte de crédit»، ونقداً «Payer en espèces» — والحوار النموذجي: «Vous payez par chèque ؟» ← «Non, je préfère payer par carte bancaire».","٣) اقتراح التوتوامان: «À propos, on se tutoie ? Tu es de la maison maintenant !» أو «Alors, on se dit « tu » ? Nous sommes collègues maintenant !» أو «Bon, dis-moi « tu », on travaille ensemble maintenant !» — والرد: «Oui, bien sûr ! / Oui, d’accord ! / Oui, pas de problème !»."]},{"h":"ثقافة وحضارة: الأعياد في فرنسا (Les Fêtes en France)","p":["عيد الميلاد (Noël — 25 décembre): تجتمع العائلة لإعداد المغارة (La crèche) بتماثيل بروفانس الطينية الملوّنة (Les santons de Provence) أو تماثيل الكريستال، ووجبة احتفالية كبيرة (un grand repas de fête) حول نار المدفأة.","عيد الشموع (La Chandeleur — 2 février): تحضير فطائر الكريب (Les crêpes) — أكلة منطقة بريتاني (une spécialité bretonne) — وتقليد قذف الكريب وقلبه في المقلاة (faire sauter les crêpes dans la poêle) للمهرة.","كرنفال نيس (Le Carnaval de Nice — en février): «عيد الأعياد» (la fête des fêtes) بمجسم «جلالة الكرنفال» (Sa Majesté Carnaval) في مقدمة المواكب (les défilés)، وموضوع سنوي متغير (الموسيقى في الحلقة)، ومجسمات ورقية عملاقة (des géants de papier) لأسبوعين ليلاً ونهاراً."]},{"h":"تمرين الحلقة","p":["تمرين الأداء: اقرأ الحوار مرتين — مرة كالموظف ومرة كالموظفة — مع تغيير النبرة: مستمعة أولاً ثم حاسمة. سجّل نفسك في الحالتين.","قارن نبرتك بمقطع الحلقة الأصلي: أين يرفع المتحدث صوته؟ أين يبطئ؟ علامات صغيرة تصنع فرق الطلاقة.","ما تحفظه: الثلاثية (اعتراف ← تفسير ← حل) + جملة «Je vous écoute». هما درعك في أي موقف شكوى."]},{"h":"التطبيق والتلخيص","p":["الحلقة 3: زبونة غير راضية وموظف يبدأ بالاستماع لا بالدفاع — الاعتذار ثم التفسير ثم الحل، كما في الفيديو الرئيسي «Reflets 1 - épisode #3 - Une cliente difficile»: شغّل من بدايته وبدّل نبرتك مع كل دور قبل الرجوع إلى دروس القواعد والمفردات.","جسر الحلقات: من a2-t7-l2 (زيارة الشقة) إلى a2-t7-l3 (موقف الخدمة والاعتذار)، ثم إلى a2-t7-l4 حيث تنتقل المحادثة إلى تهاني عيد الميلاد وأمنيات المناسبة.","المهمة: شاهد الحلقة كاملة، ثم افتح ورقة المفردات وراجع كلمات الخدمة (se plaindre, le remboursement, la garantie, rassurer)، وأخيراً سجّل تلخيصاً شفهياً مدته 30 ثانية تشرح فيه كيف يهدّئ الموظّف زبوناً غاضباً."]}],"examples":[{"fr":"Je vous écoute, madame.","ar":"أسمعكِ يا سيدة.","note":"إنصات مهذّب"},{"fr":"Je suis désolé du désagrément.","ar":"آسف على الإزعاج.","note":"اعتذار رسمي"},{"fr":"Le problème vient du fournisseur.","ar":"المشكلة تأتي من المورّد.","note":"تفسير محايد"},{"fr":"Je peux vous rembourser ou échanger.","ar":"يمكنني ردّ المبلغ أو استبداله.","note":"عرض الحل"},{"fr":"Un instant, je vérifie pour vous.","ar":"لحظة، أتحقق لكم.","note":"طلب الانتظار"},{"fr":"Est-ce que ça vous convient ?","ar":"هل يناسبك ذلك؟","note":"تأكيد الحل"},{"fr":"Vous payez par chèque ?","ar":"هل تدفعين بشيك؟","note":"السؤال عن وسيلة الدفع"},{"fr":"C’est pour qui ? C’est pour Laurent.","ar":"لمن هذا؟ إنه للوران.","note":"التخصيص"},{"fr":"À propos, on se tutoie ?","ar":"بالمناسبة، هل نرفع الكلفة؟","note":"اقتراح المألوف"}],"pron":[{"w":"désolé","ipa":"[de.zɔ.le]","approx":"ديزولي"},{"w":"remboursement","ipa":"[ʁɑ̃buʁs.mɑ̃]","approx":"رانبورسمان"},{"w":"patienter","ipa":"[pa.sjɑ̃.te]","approx":"باسيانطي"}],"vocab":[{"fr":"la cliente","ar":"الزبونة","pos":"nom","g":"f","exFr":"La cliente attend.","ipa":"klijɑ̃t","exAr":"الزبونة تنتظر."},{"fr":"se plaindre","ar":"يشتكي","pos":"verbe","g":"2e","exFr":"Elle se plaint du service.","ipa":"sə plɛ̃dʁ","exAr":"تشتكي من الخدمة."},{"fr":"le conseiller","ar":"المستشار (الموظف)","pos":"nom","g":"m","exFr":"Je vais appeler le conseiller.","ipa":"kɔ̃sɛje","exAr":"سأستدعي المستشار."},{"fr":"le remboursement","ar":"ردّ المبلغ","pos":"nom","g":"m","exFr":"Je demande un remboursement.","ipa":"ʁɑ̃buʁs.mɑ̃","exAr":"أطلب ردّ المبلغ."},{"fr":"la garantie","ar":"الضمان","pos":"nom","g":"f","exFr":"La garantie est de deux ans.","ipa":"ɡaʁɑ̃ti","exAr":"الضمان سنتان."},{"fr":"échanger","ar":"يستبدل","pos":"verbe","g":"1er","exFr":"Je veux échanger cet article.","ipa":"e.ʃɑ̃ʒe","exAr":"أريد استبدال هذه السلعة."},{"fr":"le reçu","ar":"الإيصال","pos":"nom","g":"m","exFr":"Voici votre reçu.","ipa":"ʁə.sy","exAr":"إليك إيصالك."},{"fr":"patron(ne)","ar":"المدير/ة","pos":"nom","exFr":"Je vais parler au patron.","ipa":"pa.tʁɔ̃","exAr":"سأتكلم مع المدير."},{"fr":"agacé(e)","ar":"منزعج","pos":"adj","exFr":"Elle est agacée.","ipa":"a.ɡa.se","exAr":"هي منزعجة."},{"fr":"rassurer","ar":"يطمئن","pos":"verbe","g":"1er","exFr":"Je vais la rassurer.","ipa":"ʁasyʁe","exAr":"سأطمئنها."},{"fr":"sans plus attendre","ar":"دون تأخير","pos":"locution","exFr":"Sans plus attendre, j'agis.","ipa":"sɑ̃ ply a.tɑ̃dʁ","exAr":"دون تأخير، أتصرّف."},{"fr":"cela vous convient ?","ar":"هل يناسبك ذلك؟","pos":"locution","exFr":"Est-ce que cela vous convient ?","ipa":"sə.la vu kɔ̃tjɛ̃","exAr":"هل هذا يناسبكم؟"},{"fr":"avoir rendez-vous","ar":"يكون لديه موعد","pos":"locution","exFr":"Tu as un rendez-vous ce matin ?","exAr":"هل لديك موعد هذا الصباح؟","ipa":"avwaʁ ʁɑ̃devu"},{"fr":"une banque","ar":"بنك / مصرف","pos":"nom","g":"f","exFr":"Je passe à ma banque.","exAr":"سأمر على البنك.","ipa":"bɑ̃k"},{"fr":"un bureau","ar":"مكتب","pos":"nom","g":"m","exFr":"Qui est dans mon bureau ?","exAr":"من في مكتبي؟","ipa":"byʁo"},{"fr":"un(e) remplaçant(e)","ar":"بديل / من يحل محل آخر","pos":"nom","exFr":"Tu as un remplaçant !","exAr":"لديك بديل!","ipa":"ʁɑ̃plasɑ̃"},{"fr":"une plaisanterie","ar":"دعابة / مقلب","pos":"nom","g":"f","exFr":"C’est une petite plaisanterie !","exAr":"إنها دعابة صغيرة!","ipa":"plɛzɑ̃tʁi"},{"fr":"plaisanter","ar":"يمزح","pos":"verbe","g":"1er","exFr":"Annie adore plaisanter.","exAr":"آني تعشق المزاح.","ipa":"plɛzɑ̃te"},{"fr":"un billet d’avion","ar":"تذكرة طيران","pos":"nom","g":"m","exFr":"Voilà mon billet.","exAr":"ها هي تذكرتي.","ipa":"bijɛ davjɔ̃"},{"fr":"une escale","ar":"توقف مؤقت (ترانزيت)","pos":"nom","g":"f","exFr":"Ajoutez une escale à Londres.","exAr":"أضف توقفاً في لندن.","ipa":"ɛskal"},{"fr":"avoir son passeport","ar":"يحمل جواز سفره","pos":"locution","exFr":"Vous avez votre passeport ?","exAr":"هل معكِ جواز سفركِ؟","ipa":"avwaʁ sɔ̃ paspɔʁ"},{"fr":"une carte d’identité","ar":"بطاقة هوية","pos":"nom","g":"f","exFr":"Ou votre carte d’identité ?","exAr":"أو بطاقة هويتكِ؟","ipa":"kaʁt didɑ̃tite"},{"fr":"une pièce d’identité","ar":"وثيقة هوية","pos":"nom","g":"f","exFr":"Une pièce d’identité est obligatoire.","exAr":"وثيقة الهوية إلزامية.","ipa":"pjɛs didɑ̃tite"},{"fr":"un chèque / une carte bancaire","ar":"شيك / بطاقة مصرفية","pos":"nom","exFr":"Vous payez par chèque ?","exAr":"هل تدفعين بشيك؟","ipa":"ʃɛk / kaʁt bɑ̃kɛʁ"},{"fr":"en espèces","ar":"نقداً (كاش)","pos":"locution","exFr":"Je préfère payer en espèces.","exAr":"أفضل الدفع نقداً.","ipa":"ɑ̃n ɛspɛs"},{"fr":"pressé(e)","ar":"مستعجل / في عجلة","pos":"adj","exFr":"Je suis pressée !","exAr":"أنا مستعجلة!","ipa":"pʁese"},{"fr":"être en retard","ar":"يكون متأخراً","pos":"locution","exFr":"Je suis déjà en retard !","exAr":"أنا متأخرة بالفعل!","ipa":"ɛtʁ ɑ̃ ʁətaʁ"},{"fr":"se tutoyer","ar":"يتحدث بصيغة المألوف (Tu)","pos":"verbe","exFr":"À propos, on se tutoie ?","exAr":"بالمناسبة، هل نرفع الكلفة؟","ipa":"sə tytwaje"},{"fr":"une crêpe / une poêle","ar":"فطيرة كريب / مقلاة","pos":"nom","g":"f","exFr":"Faire sauter les crêpes dans la poêle.","exAr":"قذف الكريب في المقلاة.","ipa":"kʁɛp / pwal"},{"fr":"un défilé","ar":"موكب استعراضي / مسيرة","pos":"nom","g":"m","exFr":"Sa Majesté Carnaval en tête des défilés.","exAr":"جلالة الكرنفال في مقدمة المواكب.","ipa":"defile"}],"grammar":[{"tFr":"Le vouvoiement et la négation polie","tAr":"القاعدة: التICLE المهذّب والنفي اللطيف","body":["الخدمة تُدار بـ «vous» مطلقاً حتى مع زبون شاب؛ و«ne...pas» الكامل في النفي الرسمي مقابل حذف ne في الكلام اليومي — المزدوج (règle + usage) هو ما يجعل A2 يبدو ناضجاً.","«Je ne pense pas que...» + subjonctif و«Ce n'est pas...» للموازنة: الرفض يُبنى على التخفيف لا على حجم الجملة. «Non, c'est faux» جملة تُغلق الحوار؛ «Ce n'est pas tout à fait ça» جملة تُبقيه مفتوحاً."],"ex":[{"fr":"Je ne pense pas que ce soit possible.","ar":"لا أعتقد أنه ممكن."},{"fr":"Ce n'est pas tout à fait ça, madame.","ar":"ليس تماماً ذلك يا سيدة."}]},{"tFr":"Pour + nom : l’attribution (C’est pour qui ?)","tAr":"حرف الجر (Pour) للتخصيص","body":["للتخصيص يأتي Pour متبوعاً باسم شخص أو ضمير توكيدي: «C’est pour Madame Desport» (اسم علم)، و«C’est pour lui / pour Laurent» (توكيدي/علم)، و«C’est pour notre stagiaire» (صفة ملكية + اسم) — والسؤال: «C’est pour qui ؟» (لمن هذا؟).","التركيب: Pour + Nom / Pronom tonique (moi, toi, lui, elle, nous, vous, eux, elles) — ويحدّد المستفيد من الشيء لا سببه.","مثال الحلقة: «Le café est pour toi, Laurent !» — القهوة مخصصة للوران لا لسبب عام."],"ex":[{"fr":"C’est pour qui ? C’est pour Madame Desport.","ar":"لمن هذا؟ إنه للسيدة ديسبور."},{"fr":"Le café est pour toi, Laurent !","ar":"القهوة لك يا لوران!"}]},{"tFr":"Pour + infinitif : le but (C’est pourquoi ?)","tAr":"حرف الجر (Pour) للهدف","body":["للهدف يأتي Pour متبوعاً بفعل في المصدر (غير مصرف): «C’est pour souhaiter la bienvenue» (souhaiter)، و«C’est pour ajouter une escale à Londres» (ajouter)، و«C’est pour payer par carte bancaire» (payer) — والسؤال: «C’est pourquoi ? / Pourquoi ؟».","التركيب: Pour + Verbe à l’infinitif — ويبيّن الغرض من الفعل لا صاحبه.","الفرق الجوهري: بعد Pour إما اسم/ضمير (تخصيص: لمن؟) أو مصدر (هدف: لماذا؟) — والسؤال يكشف الوظيفة: «pour qui ؟» مقابل «pourquoi ؟»."],"ex":[{"fr":"C’est pour souhaiter la bienvenue.","ar":"هذا للترحيب (به)."},{"fr":"C’est pour payer par carte bancaire.","ar":"هذا للدفع بالبطاقة المصرفية."}]}],"mistakes":[{"wrong":"الدفاع فوراً عند الشكوى","right":"«Je vous écoute» ثم الاعتراف","why":"الرفض الأول يزيد احتدام الموقف ضعفاً مضاعفاً."},{"wrong":"«Non» مفردة ردّاً على الطلب","right":"تخفيف + بديل: «Ce n'est pas possible, mais...»","why":"الرفض المجرد في الخدمة يُقرأ وقاحة."},{"wrong":"الخلط بين attendre و patienter","right":"patienter في الخدمة الرسمية","why":"المفردة الدقيقة إشارة مستوى لغوي في العمل."},{"wrong":"طلب المعلومات بأمر","right":"استفهام: «Pourriez-vous me donner...؟»","why":"الأمر مع الزبون يقلب الخادم إلى آمر."},{"wrong":"«payer en chèque»","right":"«payer par chèque»","why":"الشيك والبطاقة مع par، والنقد وحده مع en: payer en espèces."},{"wrong":"«pour quoi ?» بمعنى لمن","right":"«pour qui ?» للأشخاص و«pourquoi ?» للأسباب","why":"السؤال عن المستفيد بـ qui، وعن الهدف بـ pourquoi — وخلطهما يقلب المعنى."}],"dialogues":[{"title":"المشهد الأول: في الصباح قبل العمل (Le matin avant le travail)","ctx":"الشخصيات: جولي (Julie) وبينوا (Benoît) — موعد الصباح والبنك والتمنيات.","lines":[{"who":"Julie","fr":"Tu as un rendez-vous ce matin ?","ar":"جولي: هل لديك موعد هذا الصباح؟"},{"who":"Benoît","fr":"Oui, je passe à ma banque avant d’aller au bureau.","ar":"بينوا: نعم، سأمر على البنك الخاص بي قبل الذهاب إلى المكتب."},{"who":"Julie","fr":"Elle est où, ta banque ?","ar":"جولي: أين يقع البنك الخاص بك؟"},{"who":"Benoît","fr":"Là-bas.","ar":"بينوا: هناك."},{"who":"Julie","fr":"Alors, à ce soir Benoît ! Passe une bonne journée !","ar":"جولي: إذن، إلى المساء يا بينوا! أتمنى لك يوماً سعيداً!"},{"who":"Benoît","fr":"Merci, toi aussi !","ar":"بينوا: شكراً، وأنتِ أيضاً!"}]},{"title":"المشهد الثاني: في وكالة السفر — مقلب الزملاء والعميلة الغاضبة","ctx":"الشخصيات: بينوا، آني (Annie)، لوران المتدرب (Laurent)، والسيدة ديسبور (Madame Desport).","lines":[{"who":"Annie","fr":"Regarde, tu as un remplaçant !","ar":"آني: انظر، لديك بديل (شخص يحل محلك)!"},{"who":"Benoît","fr":"Quoi ? Comment ça, un remplaçant ? Qui est dans mon bureau ?","ar":"بينوا: ماذا؟ كيف ذلك، بديل؟ من في مكتبي؟"},{"who":"Annie","fr":"C’est le nouveau stagiaire. Il est avec Madame Desport. C’est une petite plaisanterie pour souhaiter la bienvenue !","ar":"آني: إنه المتدرب الجديد. إنه مع السيدة ديسبور. إنها دعابة صغيرة للترحيب به!"},{"who":"Benoît","fr":"Oh, Madame Desport !","ar":"بينوا: أوه، السيدة ديسبور!"},{"who":"Mme Desport","fr":"Écoutez jeune homme, voilà mon billet. Ajoutez une escale à Londres, un point c’est tout ! Je suis pressée !","ar":"السيدة ديسبور: اسمع يا شاب، ها هي تذكرتي. أضف محطة توقف (ترانزيت) في لندن، هذا كل ما في الأمر! أنا مستعجلة!"},{"who":"Laurent","fr":"Oui, bien sûr... Vous avez votre passeport ?","ar":"لوران (المتدرب): نعم، بالتأكيد... هل معكِ جواز سفركِ؟"},{"who":"Mme Desport","fr":"Mon passeport ? Euh, oui...","ar":"السيدة ديسبور: جواز سفري؟ إمم، نعم..."},{"who":"Laurent","fr":"Ou votre carte d’identité ?","ar":"لوران: أو بطاقة هويتكِ؟"},{"who":"Mme Desport","fr":"Mais c’est incroyable ! Je suis une bonne cliente de l’agence et vous demandez mon passeport !","ar":"السيدة ديسبور: لكن هذا لا يُصدق! أنا عميلة دائمة (جيدة) في الوكالة وتطلب مني جواز سفري!"},{"who":"Laurent","fr":"Mais Madame, vous comprenez, une pièce d’identité est obligatoire...","ar":"لوران: ولكن يا سيدتي، أنتِ تتفهمين، وثيقة الهوية إلزامية..."},{"who":"Benoît","fr":"Bonjour Madame Desport, excusez mon retard.","ar":"بينوا: صباح الخير سيدة ديسبور، اعذري تأخري."},{"who":"Mme Desport","fr":"Vous avez un problème, Monsieur Royer ? Enfin, aidez-moi, je vous en prie, je suis déjà en retard !","ar":"السيدة ديسبور: هل لديك مشكلة يا سيد رواييه؟ أرجوك ساعدني، فأنا متأخرة بالفعل!"},{"who":"Benoît","fr":"Alors : Genève - Londres - Paris, première classe, le 4 avril... 2 780 francs. Vous payez par chèque ?","ar":"بينوا: إذن: جنيف - لندن - باريس، درجة أولى، في 4 أبريل... 2780 فرنكاً. هل تدفعين بشيك؟"},{"who":"Mme Desport","fr":"Non, je préfère par carte bancaire. Vous êtes d’accord ?","ar":"السيدة ديسبور: لا، أفضل الدفع ببطاقة البنك. هل أنت موافق؟"},{"who":"Benoît","fr":"Pas de problème, Madame. La machine est dans le bureau d’à côté.","ar":"بينوا: لا مشكلة يا سيدتي. جهاز الدفع في المكتب المجاور."}]},{"title":"المشهد الثالث: التعارف بين الزملاء ورفع الكلفة (Entre collègues)","ctx":"الشخصيات: بينوا ولوران — اقتراح التوتوامان (tutoiement) وقهوة نيكولا.","lines":[{"who":"Benoît","fr":"Annie adore plaisanter, mais c’est une collègue adorable. Quand tu as besoin d’elle, elle est toujours là. À propos, on se tutoie ? Tu es de la maison maintenant !","ar":"بينوا: آني تعشق المزاح، لكنها زميلة رائعة. عندما تحتاج إليها، تجدها دائماً حاضرة. بالمناسبة، هل نتحدث بصيغة «أنتَ» (بدون تكلف)؟ أنت من أهل المكان (منا) الآن!"},{"who":"Laurent","fr":"Oui, bien sûr !","ar":"لوران: نعم، بكل تأكيد!"},{"who":"Benoît","fr":"Alors, je t’emmène dans le bureau de Nicolas.","ar":"بينوا: إذن، سأصطحبك إلى مكتب نيكولا."},{"who":"Laurent","fr":"Ah bon ? Pourquoi ?","ar":"لوران: حقاً؟ لماذا؟"},{"who":"Benoît","fr":"Il fait un de ces cafés !","ar":"بينوا: إنه يصنع قهوة لا مثيل لها!"}]}],"exercises":[{"t":"mcq","skill":"speaking","q":"أول جملة مناسبة لموظف يسمع شكوى:","opts":["Je vous écoute","C'est pas ma faute","Non, madame","Attendez"],"a":0,"why":"الإنصات أولاً يُهدّئ قبل أي تفسير."},{"t":"fill","skill":"speaking","q":"أكمل: «Je suis ___ pour le désagrément.» (آسف)","fr":"Je suis ___ pour le désagrément.","ans":"désolé","alts":["désolée","desole","desolee"],"why":"الاعتذار مع désolé."},{"t":"mcq","skill":"reading","q":"«Le problème vient de...» تُستعمل لـ:","opts":["تفسير الحالة محايداً","رفض الزبون","طلب مال","وصف منتج"],"a":0,"why":"تحويل السبب للفاعل الخارجي يُبعد اللوم عنك."},{"t":"order","skill":"writing","q":"رتّب ثلاثية الرد على الشكوى","words":["Je","comprends,","le","problème","vient","de...,","je","propose","de","vous","rembourser."],"ans":"Je comprends, le problème vient de..., je propose de vous rembourser.","why":"اعتراف ← تفسير ← حل."},{"t":"listen","skill":"listening","q":"عبارة طلب الانتظار المهذّبة في الحلقة:","opts":["Un instant, je vérifie","Tais-toi","Non, plus tard","Va-t'en"],"a":0,"why":"«Un instant» المهذّب شائع في الخدمة."},{"t":"translate","skill":"writing","q":"ترجم: «هل يمكنني استبدال المنتج من فضلك؟»","ans":"Puis-je échanger le produit, s'il vous plaît ?","alts":["puis-je echanger le produit, s il vous plait ?","Puis je echanger le produit s il vous plait"],"why":"Puis-je + مصدر + s'il vous plaît."},{"t":"correct","skill":"writing","q":"صحّح: «Donne-moi le reçu.» (مع زبون)","ans":"Pourriez-vous me donner le reçu","alts":["pourriez-vous me donner le reçu"],"why":"الأمر يُستبدل بالاستفهام المهذّب مع الزبون."},{"t":"speaking","skill":"speaking","q":"اكتب ردّاً على شكوى في 4 جمل بالثلاثية (اعتراف ← تفسير ← حل).","target":"Je vous écoute... Je comprends... Le problème... Je propose...","why":"بناء الإنتاج الموجّه على بنية الحلقة."},{"t":"mcq","skill":"grammar","q":"حدد وظيفة pour: «Ce billet d’avion est pour Monsieur Royer.»","opts":["تخصيص (Attribution)","هدف (But)","مكان (Lieu)"],"a":0,"why":"متبوع باسم شخص ← تخصيص."},{"t":"mcq","skill":"grammar","q":"حدد وظيفة pour: «Je passe à la banque pour demander un chèque.»","opts":["هدف (But)","تخصيص (Attribution)","مكان (Lieu)"],"a":0,"why":"متبوع بمصدر (demander) ← هدف."},{"t":"mcq","skill":"grammar","q":"حدد وظيفة pour: «C’est une petite fête pour souhaiter la bienvenue.»","opts":["هدف (But)","تخصيص (Attribution)","زمان (Temps)"],"a":0,"why":"متبوع بمصدر (souhaiter) ← هدف."},{"t":"mcq","skill":"grammar","q":"حدد وظيفة pour: «Le café est pour toi, Laurent !»","opts":["تخصيص (Attribution)","هدف (But)","سبب (Cause)"],"a":0,"why":"متبوع بضمير توكيدي (toi) ← تخصيص."},{"t":"fill","skill":"grammar","q":"أكمل بحرف الجر: «Vous payez (___) chèque ?»","fr":"Vous payez (___) chèque ?","ans":"par","alts":["Par"],"why":"الشيك والبطاقة مع par."},{"t":"fill","skill":"grammar","q":"أكمل بحرف الجر: «... ou (___) espèces ?»","fr":"... ou (___) espèces ?","ans":"en","alts":["En"],"why":"النقد وحده مع en: en espèces."},{"t":"fill","skill":"grammar","q":"أكمل: «C’est (___) qui, ce passeport ?»","fr":"C’est (___) qui, ce passeport ?","ans":"pour","alts":["Pour"],"why":"السؤال عن المستفيد: C’est pour qui ؟"},{"t":"fill","skill":"grammar","q":"أكمل: «C’est (___) moi.»","fr":"C’est (___) moi.","ans":"pour","alts":["Pour"],"why":"تخصيص بضمير توكيدي: pour moi."},{"t":"fill","skill":"grammar","q":"أكمل بحرف الجر: «une escale (___) Londres.»","fr":"une escale (___) Londres.","ans":"à","alts":["A","a"],"why":"الوجهة المكانية مع à."},{"t":"fill","skill":"grammar","q":"أكمل بحرف الجر: «payer (___) carte bancaire.»","fr":"payer (___) carte bancaire.","ans":"par","alts":["Par"],"why":"البطاقة المصرفية مع par."},{"t":"mcq","skill":"speaking","q":"زميلك الجديد يعمل معك وتريد رفع الكلفة، فتقول:","opts":["On se tutoie ?","Vous avez votre passeport ?","Je suis en retard."],"a":0,"why":"صيغة اقتراح التوتوامان من الحلقة."},{"t":"mcq","skill":"speaking","q":"لم تفهم معنى كلمة قالها صديقك، فتسأله:","opts":["Qu’est-ce que ça signifie ?","Passe une bonne journée !","Pas de problème."],"a":0,"why":"طلب المعنى بالصيغة القياسية."},{"t":"mcq","skill":"culture","q":"في فرنسا، لتحضير الكريب في المقلاة نحتفل بـ:","opts":["La Chandeleur","Le Carnaval de Nice","Noël"],"a":0,"why":"عيد الشموع (2 فبراير) عيد الكريب."}],"homework":"أعد الحلقة من 14:25 ثلاث مرات مع تكرار النبرة، ثم سجّل شكوى وردّاً عليها (دورين) في 30 ثانية.\nالحلقة السابقة/التالية: a2-t7-l2 ← a2-t7-l3 → a2-t7-l4","sources":[{"title":"Reflets 1 - épisode #3 - Une cliente difficile","channel":"Jason Mills","videoId":"eRga8nz4Cus","why":"الحلقة الكاملة — النص الأصلي للمشوار: طبّق ما تعلمه في دروس القواعد والمفردات.","cat":"Séries","level":"A2","main":true,"t":0},{"title":"Les 5 clés pour gérer et répondre à un client mécontent !","channel":"ConseilsMarketing.fr","videoId":"3I0M6CjLfUQ","why":"خمس قواعد عملية لاستقبال الزبون الغاضب وتهدئته — ترجمة مباشرة لموقف الحلقة في واقع العمل.","cat":"Conversation","level":"A2","extra":true}],"supplements":[{"id":"3I0M6CjLfUQ","title":"Les 5 clés pour gérer et répondre à un client mécontent !","channel":"ConseilsMarketing.fr","why":"خمس قواعد عملية لاستقبال الزبون الغاضب وتهدئته — ترجمة مباشرة لموقف الحلقة في واقع العمل.","dur":9,"lang":"fr"}],"videoAfterObjectives":true,"dialoguesAfterObjectives":true},{"id":"a2-t7-l4","fr":"Épisode 4 — Joyeux anniversaire","ar":"الحلقة 4 — عيد ميلاد سعيد","objectives":["التواصل: وصف طباع الزملاء وشخصياتهم (صبور، خجول، مزعج، لطيف...).","عرض الطعام أو الشراب وقبوله أو رفضه بلباقة، والإعجاب بجودته (Complimenter).","التهنئة بعيد الميلاد وتقديم الهدايا.","القواعد: الجمع (Le pluriel) للأدوات والأسماء والصفات — بما فيه الجمع بـ x — وصيغة النفي (ne ... pas) مع قاعدة (pas de / pas d’)."],"sections":[{"h":"الحلقة 4: عيد الميلاد (22:50 — 31:45)","video":{"id":"lReBA6A1dmQ","title":"Reflets 1 - épisode #4 - Joyeux anniversaire","channel":"Jason Mills","why":"الحلقة الكاملة — النص الأصلي للمشوار: طبّق ما تعلمه في دروس القواعد والمفردات.","lang":"fr","main":true,"t":0,"dur":5},"p":["الموقف أنيق وبسيط: أصدقاؤ يجمعون لصديقهم ويقدّمون الكعكة. لكنه يحمل ثلاث طبقات لغوية كاملة: التاريخ («C'est le douze mars»)، العمر («Il a trente ans»)، والأمنيات («Je te souhaite tout le bonheur du monde»).","قاعدة العمر الفرنسية تشبه العربية تماماً: العمر مع «avoir» لا مع «être» — «J'ai vingt-cinq ans» لا «Je suis vingt-cinq ans». تعلّمها مرة تمنع خطأ A2 الأخطر والأكثر شيوعاً.","التاريخ يُبنى بالتسلسل الكبير أولاً: اليوم ← الشهر ← السنة، والأشهر بالفرنسية أسماء لا أرقام. لاحظ أن الترتيب المنطقي هنا ينعكس على الجملة كاملة: «Le quinze décembre deux mille...».","التهنية تُبنى على «joyeux/bonne + المناسبة»، ثم التوسعة: «Je te souhaite...» أو «J'espère que tu passeras...». المألوف (tu) هنا هو القاعدة بين الأصدقاء — الانتقال إلى vous في حفلة صديق يُشعر بالبرود.","أسلوب Listen & Repeat: التهنية جمل إيقاعية قصيرة، هي أفضل بداية لممارسة النبرة الفرنسية الصاعدة في نهاية الأمنيات. كرّر «Bonne année !» و«Joyeux anniversaire !» حتى تصبحا جزءاً من ردّ فعلك.","بعد الحلقة: اكتب أمنية تهنئة لصديقك في ثلاث جمل — التاريخ، الأمنية، والدعاء. احفظها حرفياً؛ ستحتاجها في كل مناسبة فرنسية لبقية حياتك."],"sub":[{"h":"التهنية الأساسية","p":["Joyeux anniversaire !","Bonne fête !","Je te souhaite une excellente année.","Que tu sois heureux !"]},{"h":"التاريخ والعمر","p":["C'est le douze mars.","Je suis né(e) en 1990.","Il a trente ans.","Mon anniversaire, c'est demain."]},{"h":"أدوات الاستماع","p":["souhaite ← [su.it] مدموج.","anniversaire ← النبرة على المقطع الأخير.","né(e) ← [ne] لا «ني» بوضوح.","heureux ← [ø.ʁø]."]}]},{"h":"النصوص الحوارية المصححة (Corpus des Dialogues)","p":["النص في تبويب «حوارات» هو المفرغ الأكاديمي للحلقة بعد التنقيح: صُحح «Mais si ! À ton âge, on a besoin» و«On n’offre pas de fleurs» واسم الزميلة «Nicole» بدل «Nicolas» — ثلاثة مشاهد: استراحة القهوة، حديث الزميلات، ومفاجأة عيد الميلاد.","المشهد الأول: تقديم المتدرب («je te présente notre nouveau stagiaire»)، ووصف الطباع («très patient», «agaçante», «pas méchante»)، ثم عرض الكعك («Un petit gâteau ؟» ← «Non merci, je n’ai pas faim») والرد بالإثبات على النفي («Mais si !»).","المشهد الثاني: وصف لوران («Il est sympa... il est timide, il ne parle pas beaucoup»)، ثم جدل الهدية («On n’offre pas de fleurs à un homme !» ← «Pourquoi pas ؟») — وفيه قاعدة النفي مع pas de حيّة.","المشهد الثالث: المفاجأة («Joyeux anniversaire !» ← «Des fleurs ! Elles sont pour moi ؟») — وخاتمة الحلقة تربط الهدية بقاعدة العرض والقبول.","طريقة العمل: احفظ أوصاف الطباع من المشهد الأول (patient, timide, agaçant, charmant) ثم طبّق الجمع والنفي عليها في التمارين — فالمفردات هنا هي مادة القواعد نفسها."]},{"h":"عبارات المناسبات التي تتكرر","p":["«Joyeux anniversaire» للمناسبات الفردية، و«Bonne fête» لتسمية القديس — التفريق بينهما من الفروق الصغيرة التي تُميّز من يعيش الثقافة لا من يترجمها.","«À tes souhaits !» بعد العطس، و«Bonne continuation !» عند وداع من يواصل مشواراً — لهجات صغيرة تُظهر الانتباه. احتفظ بثلاث عبارات كهذه في جيب لغتك.","التأكيد بتكرار البشارة: «C'est incroyable !» أو «Quelle surprise !» — الفرنسية تحب ردود الفعل المفرطة قليلاً؛ الرد المحتشم وحده قد يُقرأ فتوراً."]},{"h":"الأفعال الكلامية والتواصل (Actes de Parole)","p":["١) العرض والقبول والرفض: «Un petit gâteau ؟» ← قبول: «Oui, avec plaisir !» و«Oui, s’il vous plaît» و«Volontiers !» — ورفض: «Non merci, je n’ai pas faim» و«Non merci, je ne mange pas de gâteau» و«Non merci, je ne bois pas de café».","ملاحظة: الرد بالإثبات على جملة منفية يكون بـ «Mais si !» (بلى!) — «Je n’ai pas faim» ← «Mais si ! À ton âge, on a besoin de manger !».","٢) الإطراء والمدح: «Ils sont très bons, vos gâteaux !» و«J’aime beaucoup vos gâteaux !» و«Hmm, délicieux, vos gâteaux !» و«Ils sont vraiment excellents, vos gâteaux !» — والمدح هنا يتبع القبول دائماً لا يسبقه."]},{"h":"تمرين الحلقة","p":["تمرين: اكتب ثلاث تهاني مختلفة لثلاث مناسبات (ميلاد، تخرّج، رأس السنة) — كل واحدة في جملتين.","سجّل نفسك تهنئ صديقاً كأنك على الهاتف: نبرة صاعدة عند الأمنية، هادئة عند التاريخ.","ما تحفظه: «Joyeux anniversaire» + «Je te souhaite...» + قاعدة العمر مع avoir. بهذه الثلاث تدخل أي مناسبة."]},{"h":"التطبيق والتلخيص","p":["الحلقة 4: حفلة عيد ميلاد بين الأصدقاء — التاريخ والعمر والأمنيات مع «joyeux anniversaire»، كما في الفيديو الرئيسي «Reflets 1 - épisode #4 - Joyeux anniversaire»: شغّل من بدايته وكرّر التهاني بصوت الممثلين ثم ارجع إلى دروس القواعد والمفردات.","جسر الحلقات: من a2-t7-l3 (شكوى الزبونة) إلى a2-t7-l4 (عيد الميلاد والتاريخ مع avoir)، ثم إلى a2-t7-l5 حيث يتحوّل الوصف إلى استنطاق وتحقيق عن شخصية.","المهمة: شاهد الحلقة كاملة، ثم افتح ورقة المفردات وراجع كلمات المناسبة (l'anniversaire, la date, souhaiter, le cadeau)، وأخيراً سجّل تلخيصاً شفهياً مدته 30 ثانية تهنئ فيه صديقاً بميلاده بالفرنسية."]}],"examples":[{"fr":"Joyeux anniversaire, cher ami !","ar":"عيد ميلاد سعيد يا صديقي!","note":"التهنية المباشرة"},{"fr":"Il a trente ans aujourd'hui.","ar":"عمري ثلاثون عاماً اليوم.","note":"العمر مع avoir"},{"fr":"C'est le douze mars.","ar":"إنه الثاني عشر من مارس.","note":"التاريخ"},{"fr":"Je te souhaite tout le bonheur du monde.","ar":"أتمنى لك كل سعادة في العالم.","note":"أمنية عميقة"},{"fr":"Nous fêtons ton anniversaire ce soir.","ar":"نحتفل بعيد ميلادك هذا المساء.","note":"فعل المناسبة"},{"fr":"Quelle belle surprise !","ar":"ما أجمل المفاجأة!","note":"ردّ الفعل"},{"fr":"Un petit gâteau ? Non merci, je n’ai pas faim.","ar":"قطعة كعك؟ لا شكراً، لست جائعاً.","note":"العرض والرفض"},{"fr":"Ils sont très bons, les gâteaux !","ar":"هذا الكعك لذيذ جداً!","note":"المدح"},{"fr":"On n’offre pas de fleurs à un homme.","ar":"نحن لا نهدي زهوراً لرجل.","note":"النفي مع pas de"}],"pron":[{"w":"anniversaire","ipa":"[a.ni.vɛʁ.sɛʁ]","approx":"أنيفيرسير"},{"w":"souhaite","ipa":"[su.it]","approx":"سويت"},{"w":"félicitations","ipa":"[fe.li.si.ta.sjɔ̃]","approx":"فيليسيتاسيون"}],"vocab":[{"fr":"l'anniversaire","ar":"عيد الميلاد","pos":"nom","g":"m","exFr":"Mon anniversaire est demain.","ipa":"[a.ni.vɛʁ.sɛʁ]","exAr":"عيد ميلادي غداً."},{"fr":"la date","ar":"التاريخ","pos":"nom","g":"f","exFr":"Quelle est la date ?","ipa":"[dat]","exAr":"ما التاريخ؟"},{"fr":"né(e)","ar":"مولود","pos":"participe","exFr":"Je suis né en 1998.","ipa":"[ne]","exAr":"وُلدت عام 1998."},{"fr":"la fête","ar":"الحفلة/المناسبة","pos":"nom","g":"f","exFr":"La fête commence à huit heures.","ipa":"[fɛt]","exAr":"الحفلة تبدأ في الثامنة."},{"fr":"le gâteau","ar":"الكعكة","pos":"nom","g":"m","exFr":"On partage le gâteau.","ipa":"[ɡa.to]","exAr":"نقسم الكعكة."},{"fr":"souhaiter","ar":"يتمنى","pos":"verbe","g":"1er","exFr":"Je vous souhaite le meilleur.","ipa":"[sɥi.te]","exAr":"أتمنى لك الأفضل."},{"fr":"la bougie","ar":"الشمعة","pos":"nom","g":"f","exFr":"Éteins les bougies.","ipa":"[bu.ʒi]","exAr":"أطفئ الشموع."},{"fr":"le cadeau","ar":"الهدية","pos":"nom","g":"m","exFr":"J'ai un cadeau pour toi.","ipa":"[ka.do]","exAr":"لدي هدية لك."},{"fr":"fêter","ar":"يحتفل بـ","pos":"verbe","g":"1er","exFr":"On fête ça !","ipa":"[fe.te]","exAr":"نحتفل بذلك!"},{"fr":"tous les vœux","ar":"كل الأمنيات","pos":"locution","exFr":"Je vous adresse tous mes vœux.","ipa":"[tu le vø]","exAr":"أقدم لكم كل أمنياتي."},{"fr":"la surprise","ar":"المفاجأة","pos":"nom","g":"f","exFr":"C'est une surprise !","ipa":"[syʁ.pʁiz]","exAr":"إنها مفاجأة!"},{"fr":"cher(ère)","ar":"عزيز/ة","pos":"adj","exFr":"Cher ami, merci !","ipa":"[ʃɛʁ]","exAr":"صديقي العزيز، شكراً!"},{"fr":"un(e) secrétaire","ar":"سكرتير / سكرتيرة","pos":"nom","exFr":"Voilà Nicole, la secrétaire de notre service.","exAr":"هذه نيكول، سكرتيرة قسمنا.","ipa":"səkʁetɛʁ"},{"fr":"un service","ar":"قسم / مصلحة (في شركة)","pos":"nom","g":"m","exFr":"La secrétaire de notre service.","exAr":"سكرتيرة قسمنا.","ipa":"sɛʁvis"},{"fr":"une fleur / un bouquet","ar":"زهرة / باقة زهور","pos":"nom","exFr":"Achetons un bouquet pour Benoît !","exAr":"لنشترِ باقة زهور لبينوا!","ipa":"flœʁ / bukɛ"},{"fr":"le courrier / une lettre","ar":"البريد / رسالة","pos":"nom","exFr":"Tiens, voilà le courrier.","exAr":"خذ، ها هو البريد.","ipa":"kuʁje / lɛtʁ"},{"fr":"fâché(e)","ar":"غاضب / زعلان (من)","pos":"adj","exFr":"Vous n’êtes pas fâché contre Annie ?","exAr":"ألست غاضباً من آني؟","ipa":"faʃe"},{"fr":"agaçant(e)","ar":"مزعج / مستفز","pos":"adj","exFr":"Elle est parfois un peu agaçante.","exAr":"هي أحياناً مزعجة قليلاً.","ipa":"aɡasɑ̃"},{"fr":"méchant(e)","ar":"شرير / سيئ النية","pos":"adj","exFr":"Elle n’est pas méchante !","exAr":"إنها ليست شريرة!","ipa":"meʃɑ̃"},{"fr":"patient(e)","ar":"صبور","pos":"adj","exFr":"Laurent est très patient.","exAr":"لوران صبور جداً.","ipa":"pasjɑ̃"},{"fr":"inséparables","ar":"لا يفترقان / متلازمان","pos":"adj","exFr":"Nicole et Annie sont inséparables !","exAr":"نيكول وآني لا تفترقان!","ipa":"ɛ̃sepaʁabl"},{"fr":"charmant(e)","ar":"ساحر / لطيف جداً","pos":"adj","exFr":"Nous avons des collègues charmantes.","exAr":"لدينا زميلات ساحرات.","ipa":"ʃaʁmɑ̃"},{"fr":"être timide","ar":"يكون خجولاً","pos":"locution","exFr":"Il est timide, il ne parle pas beaucoup.","exAr":"إنه خجول، لا يتحدث كثيراً.","ipa":"ɛtʁ timid"},{"fr":"se dépêcher","ar":"يسرع","pos":"verbe","exFr":"Alors, dépêche-toi !","exAr":"إذن، أسرع!","ipa":"sə depeʃe"},{"fr":"offrir / mériter","ar":"يُهدي / يستحق","pos":"verbe","exFr":"On n’offre pas de fleurs à un homme !","exAr":"نحن لا نهدي زهوراً لرجل!","ipa":"ɔfʁiʁ / meʁite"},{"fr":"bon / délicieux / excellent","ar":"طيّب المذاق / شهي / ممتاز","pos":"adj","exFr":"Ils sont très bons, les gâteaux !","exAr":"هذا الكعك لذيذ جداً!","ipa":"bɔ̃ / delisjø / ɛɡzelɑ̃"}],"grammar":[{"tFr":"Avoir... ans et dire la date","tAr":"القاعدة: العمر مع avoir وقول التاريخ","body":["العمر سلوك «avoir» الدائم: «J'ai dix ans», «Elle a quarante-cinq ans» — الخطأ «Je suis dix ans» يُسمع فوراً. ولاحظ حذف الفاعل في التعريف بالعمر: «Qu'as-tu comme âge ?» يُجاب «Vingt ans» ببساطة.","التاريخ: اليوم بـ «le» + الشهر بالاسم + السنة. والترتيب كبير←صغير: «Le premier janvier deux mille vingt-cinq». الأعداد الترتيبية تُستعمل للأيام: premier, deux, trois... — و«deux mille» لا «vingt mille» للسنة."],"ex":[{"fr":"Je suis né le cinq mai 1992.","ar":"وُلدت في الخامس من مايو 1992."},{"fr":"Ma sœur a douze ans.","ar":"أختي عمرها اثنتا عشرة سنة."}]},{"tFr":"Le pluriel : articles, noms et adjectifs","tAr":"الجمع للأدوات والأسماء والصفات","body":["الجمع يطال الأداة والاسم والصفة معاً: «un/une» ← «des» («Voilà une fleur» ← «Voilà des fleurs»)، و«le/la/l’» ← «les» («La lettre» ← «Les lettres»)، و«C’est + مفرد» ← «Ce sont + جمع» («C’est le stagiaire» ← «Ce sont les stagiaires»).","القاعدة العامة: إضافة s- غير المنطوقة («J’ai une collègue sympathique» ← «des collègues sympathiques») — والخاصة: المنتهي بـ eau- يأخذ x- («un petit gâteau» ← «des petits gâteaux»، و«nouveau stagiaire» ← «nouveaux stagiaires»).","مثال الحلقة الجامع: «le café est bon, les gâteaux sont bons, nous avons des collègues charmantes» — مفرد وجمع وصفات في جملة واحدة."],"ex":[{"fr":"Ce sont les nouveaux stagiaires.","ar":"إنهم المتدربون الجدد."},{"fr":"Nous avons des collègues charmantes.","ar":"لدينا زميلات ساحرات."}]},{"tFr":"La négation : ne ... pas et pas de / pas d’","tAr":"النفي وتحويل الأدوات إلى (de)","body":["النفي ساندويتش يحيط بالفعل: ne قبله وpas بعده — «Il parle beaucoup» ← «Il ne parle pas beaucoup»، وتتحول ne إلى n’ أمام الصوتي: «J’ai faim» ← «Je n’ai pas faim».","قاعدة الكمية الصفرية: أدوات النكرة والتجزئة (un, une, des, du, de la) تتحول كلها إلى de/d’ بعد pas — «On offre des fleurs» ← «On n’offre pas de fleurs»، و«Je bois du café» ← «Je ne bois pas de café».","الاستثناء: مع فعل الكينونة être لا تتغير الأداة — «Ce ne sont pas des fleurs» تبقى des ولا تصبح de."],"ex":[{"fr":"Il ne parle pas beaucoup.","ar":"هو لا يتحدث كثيراً."},{"fr":"On n’offre pas de fleurs à un homme.","ar":"نحن لا نهدي زهوراً لرجل."},{"fr":"Ce ne sont pas des fleurs.","ar":"إنها ليست زهوراً. (استثناء être)"}]}],"mistakes":[{"wrong":"«Je suis vingt-cinq ans»","right":"«J'ai vingt-cinq ans»","why":"العمر مع avoir في الفرنسية مهما كان المنظور."},{"wrong":"التاريخ بالترتيب الصغير أولاً","right":"«Le 12 mars» يوماً ثم شهراً","why":"الترتيب المنطقي الفرنسي: أكبر ← أصغر."},{"wrong":"«Joyeuse anniversaire»","right":"«Joyeux anniversaire»","why":"anniversaire مذكر — joyeux مهما كان جنس المُهنَّأ."},{"wrong":"الشهور بالأرقام","right":"mars, avril, mai... أسماء","why":"الأشهر الفرنسية أسماء تُرسم لا تُعدّ."},{"wrong":"«Je ne mange pas des gâteaux»","right":"«Je ne mange pas de gâteaux»","why":"بعد pas تتحول des إلى de — كمية صفرية."},{"wrong":"«Ce sont pas des fleurs»","right":"«Ce ne sont pas des fleurs»","why":"النفي جزآن لا يُحذف أولهما: ne ... pas — ومع être تبقى des."}],"dialogues":[{"title":"المشهد الأول: استراحة القهوة في المكتب (La pause-café)","ctx":"الشخصيات: بينوا، لوران، نيكول سكرتيرة القسم (Nicole)، وآني — تقديم المتدرب وعرض الكعك.","lines":[{"who":"Nicole","fr":"Entrez !","ar":"نيكول: تفضلوا بالدخول!"},{"who":"Benoît","fr":"Bonjour !","ar":"بينوا: صباح الخير!"},{"who":"Nicole","fr":"Bonjour Benoît !","ar":"نيكول: صباح الخير يا بينوا!"},{"who":"Benoît","fr":"Nicole, je te présente notre nouveau stagiaire. Il s’appelle Laurent. Laurent, voilà Nicole, la secrétaire de notre service.","ar":"بينوا: نيكول، أقدم لكِ متدربنا الجديد. اسمه لوران. لوران، هذه نيكول، سكرتيرة قسمنا."},{"who":"Nicole","fr":"Bonjour Laurent. Vous n’êtes pas fâché contre Annie, j’espère ? Elle est parfois un peu agaçante, mais elle n’est pas méchante !","ar":"نيكول: مرحباً لوران. آمل أنك لست غاضباً من آني؟ هي أحياناً مستفزة (مزعجة) قليلاً، لكنها ليست شريرة (سيئة النية)!"},{"who":"Laurent","fr":"Non, non ! Pourquoi ?","ar":"لوران: لا، لا! ولماذا (أغضب)؟"},{"who":"Benoît","fr":"Laurent est très patient, c’est une grande qualité pour un stagiaire ! Demande à Madame Desport !","ar":"بينوا: لوران صبور جداً، وهذه ميزة عظيمة لمتدرب! اسألي السيدة ديسبور!"},{"who":"Nicole","fr":"Bravo ! Laurent mérite bien un bon café !","ar":"نيكول: أحسنت! لوران يستحق بجدارة قهوة جيدة!"},{"who":"Benoît","fr":"Nicole et Annie sont inséparables !","ar":"بينوا: نيكول وآني لا تفترقان أبداً!"},{"who":"Annie","fr":"Inséparables ? Nous travaillons dans le même bureau, c’est tout !","ar":"آني: لا نفترق؟ نحن نعمل في نفس المكتب، هذا كل ما في الأمر!"},{"who":"Benoît","fr":"Oh, vous avez des gâteaux ? C’est la fête aujourd’hui !","ar":"بينوا: أوه، لديكما كعك (حلوى)؟ إنه يوم احتفال اليوم!"},{"who":"Nicole","fr":"Un petit gâteau ?","ar":"نيكول: قطعة كعك صغيرة؟"},{"who":"Laurent","fr":"Non merci, je n’ai pas faim.","ar":"لوران: لا شكراً، لستُ جائعاً."},{"who":"Annie","fr":"Mais si ! À ton âge, on a besoin de manger ! Surtout après une visite de Madame Desport !","ar":"آني: بلى! في مثل سنك، يحتاج المرء إلى الأكل! خاصة بعد زيارة من السيدة ديسبور!"},{"who":"Laurent","fr":"Merci... Ils sont très bons, les gâteaux !","ar":"لوران: شكراً... هذا الكعك لذيذ جداً!"},{"who":"Benoît","fr":"Eh oui : le café est bon, les gâteaux sont bons, nous avons des collègues charmantes... Mais nous n’avons pas le temps, il est tard ! On a encore des gens à voir avant l’heure du déjeuner. Alors, dépêche-toi !","ar":"بينوا: أي نعم: القهوة جيدة، والكعك لذيذ، ولدينا زميلات ساحرات (لطيفات)... ولكن ليس لدينا وقت، الوقت متأخر! لا يزال لدينا أشخاص لمقابلتهم قبل وقت الغداء. لذا، أسرع!"},{"who":"Laurent","fr":"D’accord. À plus tard !","ar":"لوران: حسناً. أراكم لاحقاً!"}]},{"title":"المشهد الثاني: حديث الزميلات وشراء هدية (Conversation et fleurs)","ctx":"الشخصيات: نيكول وآني — وصف لوران، عيد ميلاد بينوا، وجدل باقة الزهور.","lines":[{"who":"Nicole","fr":"Il est sympa, le nouveau stagiaire !","ar":"نيكول: إنه لطيف، المتدرب الجديد!"},{"who":"Annie","fr":"Oui, mais il est timide, il ne parle pas beaucoup.","ar":"آني: نعم، لكنه خجول، لا يتحدث كثيراً."},{"who":"Nicole","fr":"Ce n’est pas très grave, toi tu parles pour deux ! Mais heureusement, c’est Benoît le responsable de son stage.","ar":"نيكول: ليست مشكلة كبيرة، فأنتِ تتحدثين عن اثنين! ولكن لحسن الحظ، بينوا هو المسؤول عن تدريبه."},{"who":"Annie","fr":"Je te remercie ! Mais c’est vrai, Benoît est très gentil, lui. Mais dis donc, c’est bientôt son anniversaire !","ar":"آني: أشكركِ (بأسى ساخر)! لكن هذا صحيح، بينوا لطيف جداً. ولكن قولي لي، عيد ميلاده قريب جداً!"},{"who":"Nicole","fr":"Tu es sûre ? C’est quand ?","ar":"نيكول: هل أنتِ متأكدة؟ متى يكون؟"},{"who":"Annie","fr":"C’est le 5 avril ! Ils ont de belles fleurs, ici. Achetons un bouquet pour Benoît !","ar":"آني: إنه في 5 أبريل! لديهم زهور جميلة هنا. لنشترِ باقة زهور لبينوا!"},{"who":"Nicole","fr":"On n’offre pas de fleurs à un homme !","ar":"نيكول: نحن لا نهدي زهوراً لرجل!"},{"who":"Annie","fr":"Pourquoi pas ? Eux aussi, ils aiment les fleurs ! Viens, ne discute pas trop !","ar":"آني: ولِمَ لا؟ هم أيضاً يحبون الزهور! تعالي، لا تجادلي كثيراً!"}]},{"title":"المشهد الثالث: مفاجأة عيد الميلاد (La surprise d’anniversaire)","ctx":"الشخصيات: بينوا، لوران، نيكول، وآني — البريد، المكالمة، والمفاجأة.","lines":[{"who":"Benoît","fr":"Tiens, voilà le courrier.","ar":"بينوا: خذ، ها هو البريد."},{"who":"Laurent","fr":"Merci.","ar":"لوران: شكراً."},{"who":"Benoît","fr":"Pose les lettres sur le bureau. Allô ? ... Laurent ? Oui, il est là. Dans ton bureau ? Maintenant ? Tous les deux ? Bon, d’accord, nous arrivons.","ar":"بينوا: ضع الرسائل على المكتب. (في الهاتف): ألو؟ ... لوران؟ نعم، هو هنا. في مكتبكِ؟ الآن؟ كلانا؟ حسناً، موافق، نحن قادمان."},{"who":"Tous","fr":"Joyeux anniversaire !","ar":"الجميع: عيد ميلاد سعيد!"},{"who":"Benoît","fr":"Des fleurs ! Elles sont pour moi ? Quelle bonne idée ! Merci à vous tous, merci !","ar":"بينوا: زهور! هل هي لي؟ يا لها من فكرة رائعة! شكراً لكم جميعاً، شكراً!"}]}],"exercises":[{"t":"mcq","skill":"grammar","q":"الصيغة الصحيحة للعمر:","opts":["J'ai vingt ans","Je suis vingt ans","J'ai de vingt ans","Être vingt ans"],"a":0,"why":"العمر مع avoir دائماً."},{"t":"fill","skill":"writing","q":"أكمل: «Je ___ né en 1990.»","fr":"Je ___ né en 1990.","ans":"suis","alts":["Suis"],"why":"être مع الاسم المفرود للميلاد."},{"t":"mcq","skill":"listening","q":"التهنية المناسبة لصديق في عيده:","opts":["Joyeux anniversaire !","Bonne nuit !","Bonne route !","Au revoir !"],"a":0,"why":"التهنية المطابقة للمناسبة."},{"t":"order","skill":"writing","q":"رتّب تاريخ الميلاد","words":["Je","suis","né","le","douze","janvier","deux","mille","quatre-vingt-dix."],"ans":"Je suis né le douze janvier deux mille quatre-vingt-dix.","why":"يوم ← شهر ← سنة بالكامل."},{"t":"listen","skill":"listening","q":"جملة الأمنية التي سمعتها:","opts":["Je te souhaite le meilleur","Je te donne le meilleur","Je te prends le meilleur","Tu es le meilleur"],"a":0,"why":"souhaiter للأمنيات، not donner."},{"t":"translate","skill":"writing","q":"ترجم: «أتمنى لك سنة سعيدة يا صديقي.»","ans":"Je te souhaite une bonne année, mon ami.","alts":["je te souhaite une bonne annee mon ami"],"why":"souhaiter + ثمّة + منادى بـ te."},{"t":"correct","skill":"writing","q":"صحّح: «Joyeuse anniversaire, Sarah!»","ans":"Joyeux anniversaire","alts":["joyeux anniversaire"],"why":"anniversaire مذكر فالمعدّل joyeux."},{"t":"writing","skill":"writing","q":"اكتب تهنئة عيد ميلاد لصديق في 3 جمل (المناسبة، الأمنية، أمنية شخصية).","target":"Joyeux anniversaire... Je te souhaite...","why":"إنتاج موجّه على بنية المناسبات."},{"t":"correct","skill":"writing","q":"حوّل إلى الجمع: «Voilà une belle fleur. → ...»","ans":"Voilà des belles fleurs","alts":["Voilà de belles fleurs"],"why":"une ← des، والجمع يطال الصفة: belles fleurs."},{"t":"correct","skill":"writing","q":"حوّل إلى الجمع: «C’est le nouveau stagiaire. → ...»","ans":"Ce sont les nouveaux stagiaires","alts":["Ce sont les nouveaux stagiaires."],"why":"C’est ← Ce sont، وeau- تأخذ x: nouveaux."},{"t":"correct","skill":"writing","q":"حوّل إلى الجمع: «Tu manges un petit gâteau. → ...»","ans":"Tu manges des petits gâteaux","alts":["Tu manges des petits gâteaux."],"why":"un ← des، وgâteau ← gâteaux."},{"t":"correct","skill":"writing","q":"حوّل إلى الجمع: «J’ai une collègue charmante. → ...»","ans":"J’ai des collègues charmantes","alts":["J’ai des collègues charmantes."],"why":"une ← des مع جمع الاسم والصفة."},{"t":"correct","skill":"grammar","q":"انفِ الجملة: «Laurent parle beaucoup. → ...»","ans":"Laurent ne parle pas beaucoup","alts":["Laurent ne parle pas beaucoup."],"why":"النفي ساندويتش: ne قبل الفعل وpas بعده."},{"t":"correct","skill":"grammar","q":"انفِ الجملة: «J’ai faim. → ...»","ans":"Je n’ai pas faim","alts":["je n’ai pas faim","Je n’ai pas faim."],"why":"ne تصبح n’ أمام الصوتي."},{"t":"correct","skill":"grammar","q":"انفِ الجملة: «Je bois du café le matin. → ...»","ans":"Je ne bois pas de café le matin","alts":["je ne bois pas de café le matin"],"why":"du تتحول إلى de بعد pas."},{"t":"correct","skill":"grammar","q":"انفِ الجملة: «Nous avons des gâteaux. → ...»","ans":"Nous n’avons pas de gâteaux","alts":["nous n’avons pas de gâteaux"],"why":"des تتحول إلى de بعد pas."},{"t":"mcq","skill":"speaking","q":"زميلك يعرض قهوة وأنت لا تشربها، فتقول:","opts":["Non merci, je ne bois pas de café.","Oui, avec plaisir !","Ils sont délicieux !"],"a":0,"why":"الرفض المهذب مع السبب بالنفي."},{"t":"mcq","skill":"speaking","q":"صديقك يقول «Je n’ai pas faim» وتريد إقناعه بالعكس، فتقول:","opts":["Mais si ! Tu as besoin de manger.","Oui, d’accord.","Joyeux anniversaire !"],"a":0,"why":"الرد بالإثبات على النفي يكون بـ Mais si !"}],"homework":"أعد الحلقة من 22:50 ثلاث مرات، ثم اكتب تاريخ ميلادك وأعمار أفراد عائلتك في 5 جمل فرنسية بالصيغة الصحيحة مع avoir.\nالحلقة السابقة/التالية: a2-t7-l3 ← a2-t7-l4 → a2-t7-l5","sources":[{"title":"Reflets 1 - épisode #4 - Joyeux anniversaire","channel":"Jason Mills","videoId":"lReBA6A1dmQ","why":"الحلقة الكاملة — النص الأصلي للمشوار: طبّق ما تعلمه في دروس القواعد والمفردات.","cat":"Séries","level":"A2","main":true,"t":0},{"title":"Organiser une fête d'anniversaire en français - Dialogues pour le DELF A2 - 😍English subtitles","channel":"La prof Elisabeth","videoId":"OiEF4ctNB-k","why":"حوار وتدريب على التهاني والتاريخ والعمر بمستوى A2 — تكملة مباشرة لعبارات المناسبات في الحلقة.","cat":"Conversation","level":"A2","extra":true}],"supplements":[{"id":"OiEF4ctNB-k","title":"Organiser une fête d'anniversaire en français - Dialogues pour le DELF A2 - 😍English subtitles","channel":"La prof Elisabeth","why":"حوار وتدريب على التهاني والتاريخ والعمر بمستوى A2 — تكملة مباشرة لعبارات المناسبات في الحلقة.","dur":5,"lang":"fr"}],"videoAfterObjectives":true,"dialoguesAfterObjectives":true},{"id":"a2-t7-l5","fr":"Épisode 5 — C'est pour une enquête","ar":"الحلقة 5 — إنه لأجل تحقيق","objectives":["التواصل: التحدث عن الهوايات وأنشطة نهاية الأسبوع (رياضة، موسيقى، ثقافة...).","استيقاف شخص في الشارع بلباقة للسؤال أو الاستبيان، والاعتذار عن ضيق الوقت أو الرفض بتهذيب أو حزم.","القواعد: تصريف فعل (Faire) في المضارع، والتمييز بين (Faire de) و(Jouer à / de) للرياضة والموسيقى.","صياغة السؤال عن النشاط بـ (Qu’est-ce que ...) و( ... fait quoi ؟).","الثقافة: الحرفيون في فرنسا (الساعات، الدراجات، كريستال Baccarat)."],"sections":[{"h":"الحلقة 5: وصف شخصية للتحقيق (31:45 — 42:12)","video":{"id":"6nYetkaUAng","title":"Reflets 1 - épisode #5 - C'est pour une enquête","channel":"Jason Mills","why":"الحلقة الكاملة — النص الأصلي للمشوار: طبّق ما تعلمه في دروس القواعد والمفردات.","lang":"fr","main":true,"t":0,"dur":7},"p":["الوصف مهارة A2 المحورية: حين يُطلب منك أن تصف إنساناً، تكتشف أن مفرداتك مرتّبة حسب «العيون ← الشعر ← القميص ← الطول». الحلقة تعلّمك هذا الترتيب الطبيعي.","الصفات الفرنسية تطابق الموصوف في الجنس والعدد: «Il est grand» مع المذكر، «Elle est grande» مع المؤنث — هذا التوافق هو أكثر ما يُخطئ فيه المتعلّم العربي لأن العربية لا تُطابق في الصفات.","مفردة الحيلة في الوصف: «Il porte des lunettes» — الفعل «porter» يحمل تفاصيل الملابس والحلي كلها. من أتقن porter + noun صار قادراً على وصف أي مظهر بجملة واحدة.","الجملة المستمرة بالفرنسية تُقال بـ «être en train de» + مصدر: «Il est en train de partir». الصيغة تمنع الخلط بين المضارع البسيط والمستمر — وهي مهنة النحاة العرب مع الفرنسية.","الاستماع والتكرار: الوصف مليء بجمل قصيرة تتوالى — الإيقاع هنا أفضل تدريب على التتابع الفرنسي (liaison + rythme). كرّر جملة وصف كاملة حتى تصلك بنَفَس واحد.","بعد الحلقة: صف شخصاً تراه في الشارع في 5 جمل دون أن تنظر إليه مرة أخرى. إن استطعت، فقد أتقنت الوصف لا حفظته."],"sub":[{"h":"قوالب الوصف المباشر","p":["Il est grand et mince.","Il a les cheveux courts.","Il porte des lunettes.","Il est en train de lire."]},{"h":"مفردات المظهر","p":["les cheveux — الشعر.","la moustache — الشارب.","le manteau — المعطف.","la veste — السترة."]},{"h":"الوصف في التحقيق","p":["Comment est-il ?","Il mesure environ...","Que portait-il ?","Rien de particulier."]}]},{"h":"النصوص الحوارية المصححة (Corpus des Dialogues)","p":["النص في تبويب «حوارات» هو المفرغ الأكاديمي للحلقة بعد التنقيح: صُحح «je fais du droit» و«ils lisent beaucoup» و«c’est pour une invitation» و«d’horloges anciennes» و«Baccarat» — ثلاثة مشاهد: الاستبيان الأول، أنشطة العائلة، والمحاولة الأخيرة.","المشهد الأول: افتتاح الاستبيان («Excusez-moi Madame, vous avez cinq minutes ؟») ثم سؤال النشاط («Qu’est-ce que vous faites pendant le week-end ؟») — ولاحظ التخصص الدراسي («Tu fais quoi comme études ؟» ← «Je fais du droit»).","المشهد الثاني: لوحة الأنشطة الكاملة — رياضة («je fais du sport», «je joue au tennis»)، ثقافة («je vais au cinéma», «je visite des musées»)، وموسيقى العائلة («il joue du piano», «il fait de la guitare») — وهو كتالوج فعل faire حيّ.","المشهد الثالث: التشجيع («Ne te décourage pas, on apprend vite !») ثم الرفض الصامت («Avec vous ؟» وينصرف) — درس اجتماعي: الاستبيان مهارة إقناع لا أسئلة فقط.","طريقة العمل: أجرِ الاستبيان حقيقةً مع شخص من محيطك بالأسئلة نفسها (5 دقائق، 3 أسئلة) — فالحلقة مشروع ميداني لا نصاً للحفظ."]},{"h":"عبارات الوصف والتحقيق","p":["«Comment est-il ?» سؤال الوصف الشامل، وجوابه مباشر: «Il est...» + صفة. و«Que portait-il؟» يفتح الماضي — لكن لو لم تعرف الماضي بعد، استخدم «Il porte...» في وصف حيّ.","«Je ne suis pas sûr(e)» جملة أمانة مهمة: الاعتراف بالتردّد أفضل من اختلاق تفصيل. في التحقيق أصلاً، التفصيل الخطأ أخطر من الاعتراف بالغموض.","«Il ressemble à...» للمقارنة بالمشابهة: «Il ressemble à mon cousin». أسلوب قصير يختصر وصفاً كاملاً ويُستعمل كثيراً في الوصف اليومي."]},{"h":"الأفعال الكلامية والتواصل (Actes de Parole)","p":["١) استيقاف المارة: «Pardon Madame, vous avez l’heure ؟» ← «Oui, il est 5 heures dix»، و«Excusez-moi Madame, la rue du Four, s’il vous plaît ؟» ← «Désolée, je ne sais pas»، و«Pardon Madame, il y a une banque par ici ؟» ← «Oui, là-bas !».","٢) رفض الاستبيان لضيق الوقت: مهذب «Je suis désolé(e), je n’ai pas le temps»، ومستعجل «Excusez-moi, je suis en retard»، ومؤكد «Non, vraiment, je suis très pressé(e) !»، وقاطع «Non, pas question !».","تذكير: الاستيقاف يبدأ دائماً بالاعتذار (Pardon / Excusez-moi) قبل الطلب — ومن يبدأ بالسؤال مباشرة يُقابَل بالرفض كما حدث مع باسكال."]},{"h":"ثقافة وحضارة: الحرفيون في فرنسا (Les Artisans)","p":["صانع الساعات (L’horloger): يصلح آليات الساعات القديمة الدقيقة (les mécanismes d’horloges anciennes) بدقة متناهية (avec beaucoup de précision) وأدوات خاصة جداً — وهوايته صناعة الدمى الآلية (des automates).","ميكانيكيو الدراجات: ورشة صغيرة (un atelier) بمئات الدراجات القديمة (des centaines de vieux vélos) يعمل فيها عشرون شاباً (une vingtaine de jeunes) يتعلمون مهنة الحرفي الميكانيكي (artisan mécanicien).","كريستال باكارا (Baccarat): كبار صانعي الزجاج (les maîtres verriers) ينفخون الزجاج المنصهر ويشكّلونه وينحتونه (le tournent, le modèlent, le sculptent)، وآخرون يبتكرون التصاميم ويلوّنون الكريستال — وتُصدَّر التحف إلى العالم أجمع."]},{"h":"تمرين الحلقة","p":["تمرين التصوير الذهني: أغلق عينيك وتذكّر وجهاً رأيته اليوم، ثم اكتبه في 5 جمل — الطول، الشعر، النظارة، الملابس، الانشغال (en train de).","قارن جملك بجمل الحلقة: هل استخدمت porter؟ هل طابقت الصفة مع الموصوف؟ هذه نقطتا التقييم.","ما تحفظه: «Il/Elle est...» + «Il a les cheveux...» + «Il porte...» + «en train de». بهذه القدرات الأربعة تكفيك في أي وصف."]},{"h":"التطبيق والتلخيص","p":["الحلقة 5: وصف شخصية لأجل تحقيق — العيون ثم الشعر ثم القميص ثم الطول بترتيب طبيعي، كما في الفيديو الرئيسي «Reflets 1 - épisode #5 - C'est pour une enquête»: شغّل من بدايته وصف الشخص مع المتحدثين في كل توقف، ثم ارجع إلى دروس القواعد والمفردات.","جسر الحلقات: من a2-t7-l4 (عيد الميلاد) إلى a2-t7-l5 (وصف الشخص للتحقيق)، ثم إلى a2-t7-l6 حيث يتحوّل الوصف إلى حديث عن الإبداعات والهوايات والتفضيل.","المهمة: شاهد الحلقة كاملة، ثم افتح ورقة المفردات وراجع كلمات الوصف (décrire, la taille, les cheveux, les lunettes)، وأخيراً سجّل تلخيصاً شفهياً مدته 30 ثانية تصف فيه شخصاً رأيته اليوم."]}],"examples":[{"fr":"Il est grand, avec les cheveux bruns.","ar":"إنه طويل مع شعر بني.","note":"وصف عام"},{"fr":"Elle porte une veste bleue.","ar":"تلبس سترة زرقاء.","note":"الملابس مع porter"},{"fr":"Il est en train de téléphoner.","ar":"إنه يجري مكالمة الآن.","note":"en train de"},{"fr":"Il mesure un mètre quatre-vingts.","ar":"طوله متر وثمانون سنتيمتراً.","note":"القياس"},{"fr":"Je ne suis pas sûr(e) de l'heure.","ar":"لست متأكداً من الساعة.","note":"التردد الصادق"},{"fr":"Il ressemble à son père.","ar":"إنه يشبه أبيه.","note":"المقارنة بالتشابه"},{"fr":"Qu’est-ce que vous faites le week-end ?","ar":"ماذا تفعلون في العطلة؟","note":"السؤال القياسي"},{"fr":"Nous faisons du vélo.","ar":"نركب الدراجات.","note":"faire + نشاط"},{"fr":"Le premier joue du piano.","ar":"الأول يعزف على البيانو.","note":"jouer + آلة"}],"pron":[{"w":"en train de","ipa":"[ɑ̃ tʁɛ̃ də]","approx":"أون ترين دُ"},{"w":"lunettes","ipa":"[ly.nɛt]","approx":"لنيت"},{"w":"moustache","ipa":"[mus.taʃ]","approx":"موستاش"}],"vocab":[{"fr":"décrire","ar":"يصف","pos":"verbe","g":"2e","exFr":"Peux-tu le décrire ?","ipa":"[de.kʁiʁ]","exAr":"هل تستطيع وصفه؟"},{"fr":"la taille","ar":"الطول/المقاس","pos":"nom","g":"f","exFr":"Quelle est sa taille ?","ipa":"[taj]","exAr":"ما طوله؟"},{"fr":"brun(e)","ar":"بني","pos":"adj","exFr":"Des cheveux bruns.","ipa":"[bʁœ̃]","exAr":"شعر بني."},{"fr":"porter","ar":"يلبس/يحمل","pos":"verbe","g":"1er","exFr":"Il porte une casquette.","ipa":"[pɔʁ.te]","exAr":"يلبس قبعة."},{"fr":"les lunettes","ar":"النظارة","pos":"nom","g":"f.pl","exFr":"Elle porte des lunettes.","ipa":"[ly.nɛt]","exAr":"تلبس نظارة."},{"fr":"le témoin","ar":"الشاهد","pos":"nom","g":"m","exFr":"Le témoin a vu tout.","ipa":"[te.mwɛ̃]","exAr":"الشاهد رأى كل شيء."},{"fr":"ressembler","ar":"يشبه","pos":"verbe","g":"1er","exFr":"Il ressemble à son frère.","ipa":"[ʁɑ̃.sɑ̃.ble]","exAr":"يشبه أخيه."},{"fr":"particulier(ère)","ar":"خاص/مميز","pos":"adj","exFr":"Rien de particulier.","ipa":"[paʁ.ti.kylje]","exAr":"لا شيء مميز."},{"fr":"mesurer","ar":"يقيس/يبلغ طوله","pos":"verbe","g":"1er","exFr":"Il mesure 1 m 80.","ipa":"[mə.zy.ʁe]","exAr":"طوله متر وثمانون."},{"fr":"l'enquête","ar":"التحقيق","pos":"nom","g":"f","exFr":"Une enquête policière.","ipa":"[ɑ̃.kɛt]","exAr":"تحقيق شرطي."},{"fr":"le bouquet","ar":"الباقة (في الحديقة)","pos":"nom","g":"m","exFr":"Ils admiraient le bouquet de fleurs au parc.","ipa":"/lə bukɛ/","exAr":"أعجبوا بباقة الزهور في الحديقة."},{"fr":"le rocher","ar":"عنصر طبيعي في الحديقة/الغابة","pos":"nom","g":"m","exFr":"Ils ont vu le rocher près du sentier.","ipa":"/lə ʁɔʃe/","exAr":"رأوا العنصر قرب الممر."},{"fr":"le week-end","ar":"عطلة نهاية الأسبوع","pos":"nom","g":"m","exFr":"Qu’est-ce que vous faites pendant le week-end ?","exAr":"ماذا تفعلون في العطلة؟","ipa":"wikɛnd"},{"fr":"la fac","ar":"الكلية / الجامعة","pos":"nom","g":"f","exFr":"Quand je ne vais pas à la fac.","exAr":"عندما لا أذهب إلى الجامعة.","ipa":"fak"},{"fr":"faire du droit","ar":"يدرس القانون (الحقوق)","pos":"locution","exFr":"Je fais du droit.","exAr":"أدرس القانون.","ipa":"fɛʁ dy dʁwa"},{"fr":"le sport / la natation","ar":"الرياضة / السباحة","pos":"nom","exFr":"Je fais du sport.","exAr":"أمارس الرياضة.","ipa":"spɔʁ / natasjɔ̃"},{"fr":"le vélo / le judo / le tennis","ar":"الدراجة / الجودو / التنس","pos":"nom","g":"m","exFr":"Nous faisons du vélo.","exAr":"نركب الدراجات.","ipa":"velo / ʒydo / tenis"},{"fr":"le cinéma / le théâtre / le musée","ar":"السينما / المسرح / المتحف","pos":"nom","g":"m","exFr":"Je vais au cinéma et au théâtre.","exAr":"أذهب إلى السينما والمسرح.","ipa":"sinema / teatʁ / myze"},{"fr":"une exposition","ar":"معرض فني","pos":"nom","g":"f","exFr":"Je visite des expositions.","exAr":"أزور معارض فنية.","ipa":"ɛɡzpozisjɔ̃"},{"fr":"la campagne / le jardin","ar":"الريف / الحديقة","pos":"nom","exFr":"Nous allons souvent à la campagne.","exAr":"نذهب غالباً إلى الريف.","ipa":"kɑ̃paɲ / ʒaʁdɛ̃"},{"fr":"faire des courses","ar":"يتسوق (حاجيات المنزل)","pos":"locution","exFr":"Je fais des courses, aussi !","exAr":"وأتسوق أيضاً!","ipa":"fɛʁ de kuʁs"},{"fr":"efficace / passionnant(e)","ar":"فعّال (كفء) / مشوّق","pos":"adj","exFr":"Tu es vraiment efficace !","exAr":"أنتِ ماهرة حقاً!","ipa":"efikas / pasjɔnɑ̃"},{"fr":"se décourager","ar":"يفقد الشجاعة / ييأس","pos":"verbe","exFr":"Ne te décourage pas !","exAr":"لا تيأس!","ipa":"sə dekuʁaʒe"},{"fr":"un artisan / un horloger","ar":"حرفيّ / ساعاتي","pos":"nom","g":"m","exFr":"Le métier d’artisan mécanicien.","exAr":"مهنة الحرفي الميكانيكي.","ipa":"aʁtizɑ̃ / ɔʁlɔʒe"},{"fr":"un automate","ar":"دمية آلية متحركة","pos":"nom","g":"m","exFr":"Des automates.","exAr":"دمى آلية.","ipa":"otɔmat"},{"fr":"un maître verrier / le cristal","ar":"خبير الزجاج / الكريستال","pos":"nom","g":"m","exFr":"Les maîtres verriers à Baccarat.","exAr":"خبراء الزجاج في باكارا.","ipa":"mɛtʁ vɛʁje / kʁistal"}],"grammar":[{"tFr":"Être en train de + l'accord des adjectifs","tAr":"القاعدة: فعل جارٍ الآن + مطابقة الصفات","body":["«être en train de» + مصدر يعبّر عن فعل يقع الآن — وهي البديل الفرنسي للـ present continuous: «Je suis en train de travailler». مع النفي: «Je ne suis pas en train de...» (لا تحذف in).","مطابقة الصفات: مفرد مذكر بلا نهاية، مفرد مؤنث + e، جمع مذكر + s، جمع مؤنث + es: «grand / grande / grands / grandes». صفة قبل الاسم تبقى مطابقة أيضاً: «une veste bleue»."],"ex":[{"fr":"Elle est en train d'étudier sa leçon.","ar":"إنها تدرس درسها الآن."},{"fr":"Ce sont des chaussures neuves.","ar":"إنها أحذية جديدة (جمع). "}]},{"tFr":"Le verbe Faire au présent + Faire vs Jouer","tAr":"فعل (Faire) وتراكيب الأنشطة","body":["التصريف (شاذ): je fais, tu fais, il/elle/on fait, nous faisons (انتبه: تنتهي بـ sons لا بـ zons)، vous faites (تنتهي بـ tes)، ils/elles font — ويغطي الأنشطة والدراسة والأعمال اليومية.","Faire + (du, de la, de l’, des): للرياضة والفن والعلم — «faire du sport / du vélo / du judo / du droit» (مذكر)، و«faire de la natation / de la photo / de la guitare» (مؤنث)، و«faire la cuisine / son jardin / des courses» (اليومية).","Jouer + (au, aux): للرياضات الكروية والألعاب — «jouer au tennis», «jouer aux jeux vidéo» — وJouer + (du, de la): للآلات الموسيقية — «jouer du piano» — والخلط بينهما («jouer du tennis») خطأ الحلقة الأشهر."],"ex":[{"fr":"Je fais du droit.","ar":"أدرس القانون."},{"fr":"Je joue au tennis.","ar":"ألعب التنس."},{"fr":"Le premier joue du piano.","ar":"الأول يعزف على البيانو."}]},{"tFr":"Quoi en fin de phrase vs Qu’est-ce que","tAr":"السؤال عن النشاط: الصيغتان","body":["المألوف (Familier): الفاعل + faire + quoi في النهاية — «Elle fait quoi ؟» و«Ils font quoi ؟» و«Tu fais quoi comme études ؟» — وهي صيغة الحوار اليومي في الحلقة.","القياسي (Standard): Qu’est-ce que في البداية — «Qu’est-ce qu’elle fait ؟» و«Qu’est-ce que vous faites ؟» — وتُختصر Quoi إلى Qu’ أمام il/elle/ils/elles/on.","التحويل آلي: انقل quoi من النهاية إلى البداية بصيغة qu’est-ce que — «Il fait quoi dimanche ؟» ← «Qu’est-ce qu’il fait dimanche ؟» — مع بقاء الفاعل والفعل كما هما."],"ex":[{"fr":"Qu’est-ce que vous faites pendant le week-end ?","ar":"ماذا تفعلون خلال عطلة نهاية الأسبوع؟"},{"fr":"Tu fais quoi comme études ?","ar":"ماذا تدرسين؟"}]}],"mistakes":[{"wrong":"صفات غير مطابقة: «une veste bleu»","right":"«une veste bleue»","why":"الصفة مع المؤنث تأخذ e."},{"wrong":"«Je suis en train...» بلا مصدر","right":"«en train de partir»","why":"القالب يتطلب de + مصدر دائماً."},{"wrong":"خلط grand مع grande بشكل عشوائي","right":"المطابقة حسب الموصوف","why":"المطابقة إجبارية في الفرنسية."},{"wrong":"الوصف بلا ترتيب منطقي","right":"عام ← شعر ← ملابس ← نشاط","why":"الترتيب المنطقي يجعل الوصف مفهوماً بسرعة."},{"wrong":"«Je joue du tennis»","right":"«Je joue au tennis»","why":"الرياضات الكروية مع à (au) — وdu محفوظة للآلات الموسيقية."},{"wrong":"«Qu’est-ce que tu fais quoi ?»","right":"«Qu’est-ce que tu fais ?» أو «Tu fais quoi ؟»","why":"أداة استفهام واحدة في السؤال — إما في البداية أو في النهاية."}],"dialogues":[{"title":"المشهد الأول: استبيان في الشارع (Une enquête dans la rue)","ctx":"الشخصيات: باسكال (Pascal)، جولي (Julie)، وسيدة عابرة (Une passante).","lines":[{"who":"Pascal","fr":"Excusez-moi Madame, vous avez cinq minutes ? C’est pour une enquête.","ar":"باسكال: اعذريني يا سيدتي، هل لديكِ خمس دقائق؟ هذا من أجل استبيان (استطلاع رأي)."},{"who":"Dame 1","fr":"Qu’est-ce que vous dites ? Vous faites une enquête sur quoi ?","ar":"السيدة 1: ماذا تقول؟ تجري استبياناً حول ماذا؟"},{"who":"Pascal","fr":"Sur les activités préférées des Français. Qu’est-ce que vous faites pendant le week-end ?","ar":"باسكال: حول الأنشطة المفضلة لدى الفرنسيين. ماذا تفعلين خلال عطلة نهاية الأسبوع؟"},{"who":"Dame 1","fr":"Je lis, je regarde la télévision, j’écoute des disques de musique... Mais excusez-moi, je suis pressée !","ar":"السيدة 1: أقرأ، أشاهد التلفاز، أستمع إلى أسطوانات الموسيقى... لكن اعذرني، أنا مستعجلة!"},{"who":"Pascal","fr":"Ce n’est pas facile ! Tu fais des enquêtes tous les jours ?","ar":"باسكال: الأمر ليس سهلاً! هل تجرين استبيانات كل يوم؟"},{"who":"Julie","fr":"Non, seulement quand je ne vais pas à la fac.","ar":"جولي: لا، فقط عندما لا أذهب إلى الكلية (الجامعة)."},{"who":"Pascal","fr":"Tu fais quoi comme études ?","ar":"باسكال: ماذا تدرسين (ما هو تخصصك)؟"},{"who":"Julie","fr":"Je fais du droit. Regarde les deux jeunes femmes, elles ont l’air sympa !","ar":"جولي: أدرس القانون (الحقوق). انظر إلى هاتين الشابتين، تبدوان لطيفتين!"}]},{"title":"المشهد الثاني: أنشطة العائلة (Les activités de la famille)","ctx":"الشخصيات: باسكال، جولي، السيدة الثانية (Dame 2)، والسيدة الثالثة (Dame 3) — الرياضة، السينما، والموسيقى.","lines":[{"who":"Pascal","fr":"Excusez-moi Mesdames, vous faites sûrement des choses passionnantes pendant le week-end !","ar":"باسكال: اعذراني سيداتي، أنتما بالتأكيد تقومان بأشياء مشوقة خلال عطلة نهاية الأسبوع!"},{"who":"Dame 2","fr":"Oui, enfin... je fais du sport.","ar":"السيدة 2: نعم، حسناً... أمارس الرياضة."},{"who":"Pascal","fr":"Quel sport est-ce que vous faites ?","ar":"باسكال: أي رياضة تمارسين؟"},{"who":"Dame 2","fr":"Je joue au tennis, je marche, et nous faisons du vélo, mon mari, les enfants et moi.","ar":"السيدة 2: ألعب التنس، أمشي، ونركب الدراجات، زوجي والأطفال وأنا."},{"who":"Pascal","fr":"Et vous Madame, vous faites aussi du sport ?","ar":"باسكال: وأنتِ يا سيدتي، هل تمارسين الرياضة أيضاً؟"},{"who":"Dame 3","fr":"Mon mari fait du judo, mais moi, je n’aime pas le sport. Je vais au cinéma, je fais de la photo... Mais pourquoi vous posez toutes ces questions ? C’est un jeu ? Vous donnez des places de cinéma ?","ar":"السيدة 3: زوجي يمارس الجودو، لكن أنا لا أحب الرياضة. أذهب إلى السينما، أمارس التصوير الفوتوغرافي... ولكن لماذا تطرح كل هذه الأسئلة؟ هل هي لعبة؟ هل توزعون تذاكر سينما؟"},{"who":"Pascal","fr":"Non, je ne donne rien. Je fais une enquête.","ar":"باسكال: لا، أنا لا أوزع شيئاً. أنا أجري استبياناً."},{"who":"Dame 3","fr":"Ah, c’est pour une enquête ! Je suis désolée, mais je n’ai pas le temps !","ar":"السيدة 3: آه، إنه لاستبيان! أنا آسفة، ولكن ليس لدي وقت!"},{"who":"Julie","fr":"Et vous Madame, vous avez cinq minutes ?","ar":"جولي: وأنتِ يا سيدتي، هل لديكِ خمس دقائق؟"},{"who":"Dame 2","fr":"D’accord, mais cinq minutes, hein !","ar":"السيدة 2: موافقة، لكن خمس دقائق فقط، ها!"},{"who":"Julie","fr":"Vous faites du sport, et qu’est-ce que vous faites d’autre ?","ar":"جولي: أنتِ تمارسين الرياضة، وماذا تفعلين غير ذلك؟"},{"who":"Dame 2","fr":"Je lis, je vais au cinéma et au théâtre, je visite des musées et je fais des courses, aussi !","ar":"السيدة 2: أقرأ، أذهب إلى السينما والمسرح، أزور المتاحف، وأقوم بالتسوق أيضاً!"},{"who":"Julie","fr":"Et votre mari, il a d’autres activités ? Il lit, il va au cinéma ?","ar":"جولي: وزوجكِ، هل لديه أنشطة أخرى؟ هل يقرأ، هل يذهب إلى السينما؟"},{"who":"Dame 2","fr":"Non, il ne lit pas beaucoup. Mais nous allons souvent à la campagne et il adore faire son jardin.","ar":"السيدة 2: لا، هو لا يقرأ كثيراً. لكننا نذهب غالباً إلى الريف وهو يعشق الاعتناء بحديقته (البستنة)."},{"who":"Julie","fr":"Et vos enfants, qu’est-ce qu’ils font ?","ar":"جولي: وأطفالكِ، ماذا يفعلون؟"},{"who":"Dame 2","fr":"Du vélo, mais ils préfèrent la musique. Le premier joue du piano, le deuxième fait de la guitare. Ils lisent beaucoup, ils vont au cinéma et ils adorent les jeux vidéo. Voilà, c’est tout !","ar":"السيدة 2: يركبون الدراجة، لكنهم يفضلون الموسيقى. الأول يعزف على البيانو، والثاني يعزف على الجيتار. إنهم يقرؤون كثيراً، يذهبون إلى السينما ويعشقون ألعاب الفيديو. ها قد انتهينا، هذا كل شيء!"},{"who":"Julie","fr":"Merci beaucoup Madame, très bien !","ar":"جولي: شكراً جزيلاً سيدتي، ممتاز جداً!"},{"who":"Dame 2","fr":"Bon courage, Mademoiselle !","ar":"السيدة 2: بالتوفيق يا آنسة!"}]},{"title":"المشهد الثالث: محاولة باسكال الأخيرة (La dernière tentative)","ctx":"الشخصيات: باسكال، جولي، ورجل عابر (Un passant) — التشجيع ثم الرفض الصامت.","lines":[{"who":"Pascal","fr":"Tu es vraiment efficace ! Tu fais des enquêtes depuis quand ?","ar":"باسكال: أنتِ فعّالة (ماهرة) حقاً! منذ متى وأنتِ تجرين الاستبيانات؟"},{"who":"Julie","fr":"Depuis quelques mois. Ne te décourage pas, on apprend vite !","ar":"جولي: منذ بضعة أشهر. لا تفقد حماسك (لا تيأس)، فالمرء يتعلم بسرعة!"},{"who":"Pascal","fr":"Bonjour Monsieur, vous faites sûrement des choses passionnantes le week-end !","ar":"باسكال: صباح الخير سيدي، أنت بالتأكيد تقوم بأشياء مشوقة في عطلة نهاية الأسبوع!"},{"who":"Monsieur","fr":"Oui, enfin... je lis, je visite des expositions, j’invite des amis à la maison, j’aime beaucoup faire la cuisine...","ar":"الرجل: نعم، يعني... أقرأ، أزور معارض فنية، أدعو أصدقاء إلى المنزل، وأحب الطبخ كثيراً..."},{"who":"Pascal","fr":"Vous faites du sport ?","ar":"باسكال: هل تمارس الرياضة؟"},{"who":"Monsieur","fr":"Un peu. Je marche et je fais de la natation. Mais pourquoi toutes ces questions ? C’est pour une invitation ?","ar":"الرجل: قليلاً. أمشي وأمارس السباحة. ولكن لماذا كل هذه الأسئلة؟ هل هذا من أجل دعوة؟"},{"who":"Pascal","fr":"Non, c’est pour une enquête. Vous avez cinq minutes ?","ar":"باسكال: لا، إنه من أجل استبيان. هل لديك خمس دقائق؟"},{"who":"Monsieur","fr":"Avec vous ?","ar":"الرجل: معك أنت؟ (ينصرف)"}]}],"exercises":[{"t":"mcq","skill":"grammar","q":"الصفة الصحيحة: «Il porte une veste ___»","opts":["bleue","bleu","bleus","bleu(e)"],"a":0,"why":"veste مؤنث فتُطابق بـ bleue."},{"t":"fill","skill":"writing","q":"أكمل: «Elle est en train de ___.» (يكتب)","fr":"Elle est en train de ___.","ans":"écrire","alts":["ecrire"],"why":"en train de + مصدر."},{"t":"mcq","skill":"reading","q":"«Il a les cheveux courts» تعني:","opts":["شعره قصير","شعرها طويل","يحمل كتبًا","شعره بني"],"a":0,"why":"courts = قصير (جمع مذكر)."},{"t":"order","skill":"writing","q":"رتّب جملة وصف","words":["Elle","porte","des","lunettes","et","une","robe","rouge."],"ans":"Elle porte des lunettes et une robe rouge.","why":"الفاعل ← porter ← التفاصيل."},{"t":"listen","skill":"listening","q":"أي جملة تصف نشاطاً جارياً الآن؟","opts":["Il est en train de lire","Il a lu","Il lira","Il lisait"],"a":0,"why":"en train de = الفعل الجاري."},{"t":"translate","skill":"writing","q":"ترجم: «إنها تأكل الآن في المطبخ.»","ans":"Elle est en train de manger dans la cuisine.","alts":["elle est en train de manger dans la cuisine"],"why":"être en train de + مصدر + مكان."},{"t":"correct","skill":"writing","q":"صحّح: «Elle porte une veste bleu.»","ans":"une veste bleue","alts":["bleue"],"why":"veste مؤنث فتُطابق الصفة بـ bleue."},{"t":"speaking","skill":"speaking","q":"صف شخصاً تعرفه في 4 جمل (الطول، الشعر، الملابس، النشاط الحالي).","target":"Il/Elle est... Il/Elle a... Il/Elle porte... Il/Elle est en train de...","why":"إنتاج الوصف الكامل الموجّه."},{"t":"fill","skill":"grammar","q":"أكمل بتصريف faire: «Qu’est-ce que vous (___) pendant le week-end ?»","fr":"Qu’est-ce que vous (___) pendant le week-end ?","ans":"faites","alts":["Faites"],"why":"المخاطب vous مع faire يأخذ faites (تنتهي بـ tes)."},{"t":"fill","skill":"grammar","q":"أكمل بتصريف faire: «Mon mari (___) du judo.»","fr":"Mon mari (___) du judo.","ans":"fait","alts":["Fait"],"why":"الغائب il مع faire يأخذ fait."},{"t":"fill","skill":"grammar","q":"أكمل بتصريف faire: «... et moi je (___) de la photo.»","fr":"... et moi je (___) de la photo.","ans":"fais","alts":["Fais"],"why":"المتكلم je مع faire يأخذ fais."},{"t":"fill","skill":"grammar","q":"أكمل بتصريف faire: «Nous (___) souvent du vélo.»","fr":"Nous (___) souvent du vélo.","ans":"faisons","alts":["Faisons"],"why":"المتكلم الجمع nous يأخذ faisons."},{"t":"fill","skill":"grammar","q":"أكمل بتصريف faire: «Les enfants (___) de la guitare.»","fr":"Les enfants (___) de la guitare.","ans":"font","alts":["Font"],"why":"الغائب الجمع ils يأخذ font."},{"t":"fill","skill":"grammar","q":"أكمل بتصريف faire: «Tu (___) quoi comme études ?»","fr":"Tu (___) quoi comme études ?","ans":"fais","alts":["Fais"],"why":"المخاطب tu مع faire يأخذ fais."},{"t":"correct","skill":"grammar","q":"حوّل إلى الصيغة القياسية: «Elle fait quoi ? → ...»","ans":"Qu’est-ce qu’elle fait ?","alts":["Qu’est-ce qu’elle fait ?"],"why":"نقل quoi إلى البداية بصيغة qu’est-ce que."},{"t":"correct","skill":"grammar","q":"حوّل إلى الصيغة القياسية: «Il fait quoi dimanche ? → ...»","ans":"Qu’est-ce qu’il fait dimanche ?","alts":["Qu’est-ce qu’il fait dimanche ?"],"why":"نفس التحويل مع بقاء الظرف dimanche."},{"t":"correct","skill":"grammar","q":"حوّل إلى الصيغة القياسية: «Ils font quoi, vos enfants ? → ...»","ans":"Qu’est-ce qu’ils font, vos enfants ?","alts":["Qu’est-ce qu’ils font, vos enfants ?"],"why":"نفس التحويل مع بقاء المنادى."},{"t":"correct","skill":"grammar","q":"حوّل إلى الصيغة القياسية: «Tu fais quoi dans la vie ? → ...»","ans":"Qu’est-ce que tu fais dans la vie ?","alts":["Qu’est-ce que tu fais dans la vie ?"],"why":"مع tu تبقى الصيغة الكاملة qu’est-ce que."},{"t":"mcq","skill":"grammar","q":"أكمل: «je fais ( ... ) natation»","opts":["de la","du","au"],"a":0,"why":"natation مؤنث ← faire de la."},{"t":"mcq","skill":"grammar","q":"أكمل: «je joue ( ... ) tennis»","opts":["au","du","de la"],"a":0,"why":"رياضة كروية ← jouer au."},{"t":"mcq","skill":"grammar","q":"أكمل: «il joue ( ... ) piano»","opts":["du","au","de la"],"a":0,"why":"آلة موسيقية ← jouer du."},{"t":"mcq","skill":"speaking","q":"تسأل عن الساعة في الشارع فتقول: «Pardon Madame, vous avez ... ؟»","opts":["l’heure","le temps","la monnaie"],"a":0,"why":"السؤال عن الساعة: vous avez l’heure ؟"},{"t":"mcq","skill":"culture","q":"في Baccarat يصنع الخبراء تحفاً من:","opts":["cristal","vélo","papier"],"a":0,"why":"مصنع الكريستال الشهير في باكارا."}],"homework":"أعد الحلقة من 31:45 ثلاث مرات، ثم صِف ثلاثة أشخاص رأيتهم اليوم في 3 جمل لكل واحد، مستعملاً en train de مرة واحدة على الأقل.\nالحلقة السابقة/التالية: a2-t7-l4 ← a2-t7-l5 → a2-t7-l6","sources":[{"title":"Reflets 1 - épisode #5 - C'est pour une enquête","channel":"Jason Mills","videoId":"6nYetkaUAng","why":"الحلقة الكاملة — النص الأصلي للمشوار: طبّق ما تعلمه في دروس القواعد والمفردات.","cat":"Séries","level":"A2","main":true,"t":0},{"title":"Apprendre le vocabulaire de police en français.","channel":"leçons françaises","videoId":"Qo0YGgpH_2M","why":"مفردات الشرطة والبلاغ بلغة بسيطة — يدعم وصف الشخص والتحقيق الذي تدرّبه الحلقة.","cat":"Vocabulaire","level":"A2","extra":true}],"supplements":[{"id":"Qo0YGgpH_2M","title":"Apprendre le vocabulaire de police en français.","channel":"leçons françaises","why":"مفردات الشرطة والبلاغ بلغة بسيطة — يدعم وصف الشخص والتحقيق الذي تدرّبه الحلقة.","dur":2,"lang":"fr"}],"videoAfterObjectives":true,"dialoguesAfterObjectives":true},{"id":"a2-t7-l6","fr":"Épisode 6 — On fête nos créations","ar":"الحلقة 6 — نحتفل بإبداعاتنا","objectives":["التعبير عن الهوايات والتفضيلات (aimer, préférer, adorer) بطبيعية","متابعة الحلقة من توقيتها 42:12 مع إدراك صيغ التفضيل","استخدام «j'aime + infinitif» و«je préfère... à...» في حديث يومي"],"sections":[{"h":"الحلقة 6: حفلة المبدعين (42:12 — 51:46)","video":{"id":"Wj4t6E2HOq4","title":"Reflets 1 - épisode #6 - On fête nos créations","channel":"Jason Mills","why":"الحلقة الكاملة — النص الأصلي للمشوار: طبّق ما تعلمه في دروس القواعد والمفردات.","lang":"fr","main":true,"t":0,"dur":7},"p":["الموقف يدور حول «الإبداعات»: أعمال يدويّة، طبخ، صور... والحديث معه يتطلب صيغ التفضيل أكثر من أي موقف آخر. من أتقن «je préfère... à...» يستطيع توجيه أي محادثة شخصية.","سلّم التفضيل الفرنسي قصير: «j'aime» ← «je préfère» ← «j'adore» ← «je déteste». المتعلم العربي يميل إلى الترجمة الحرفية «أحب أكثر من» — الصحيح بناء «préférer... à...» مباشرة.","لاحظ التكرار الضروري للمضارع: «On cuisine, on chante, on crée» — الفعل «faire» وحده يفتح عوالم: «faire de la peinture», «faire du sport», «faire la cuisine». ثلاث كلمات تختصر عشرات المفردات.","الحوار مليء بـ «Moi aussi», «Moi non plus», «Et toi ?» — ردود الفعل القصيرة هي وقود المحادثة. تعلّمها تعني أنك تشارك في الحوار لا أن تُملي جملة بعد جملة.","الاستماع والتكرار: الجمل في هذه الحلقة قصيرة ومتبادلة بسرعة — أفضل تمرين على «répliques» حقيقية. استبدل أنت في «Moi, je préfère...» بمفرداتك الخاصة وأنت تكرر.","بعد الحلقة: اكتب فقرة من 5 أسطر عن هوايتك: ماذا تفعل، ماذا تفضّل، وماذا تكره. اقرأها بصوت عالٍ — إن سمعتها بنبرة مقنعة، فقد أتقنت الحدث."],"sub":[{"h":"سلّم التفضيل","p":["J'aime bien.","Je préfère la musique.","J'adore dessiner.","Je déteste la bagarre."]},{"h":"الهوايات مع faire","p":["faire du sport","faire de la peinture","faire la cuisine","faire de la guitare"]},{"h":"ردود التفاعل","p":["Moi aussi !","Moi non plus.","Et toi, tu fais quoi ?","Comme moi !"]}]},{"h":"عبارات التفضيل والهوايات","p":["«Je préfère le café au thé» — أداة «à» لا «que» رغم الترجمة «أفضل... من». هذا الفرق الصغير هو أحد أكثر أخطاء A2 تكراراً في الكتابة.","«Qu'est-ce que tu fais comme loisir ؟» سؤال الهوايات القياسي، وجوابه بـ «faire»: «Je fais un peu de...». تعلّم السؤال والجواب معاً تضمن لك محادثة كاملة لا جملتين.","«C'est mon truc !» للتحمّل العفوي: «هذا أسلوبي/هوايتي المفضلة». العبارة عامية لكنها مقبولة في كل لقاء بين الأصدقاء — وتُظهر قرباً لغوياً لا يُلمس بالكتب."]},{"h":"تمرين الحلقة","p":["تمرين الاختيار: ضع 5 أشياء تحبها في عمود و5 لا تحبها في آخر، ثم ابنِ جملاً تفضيلية كاملة لكل عمود («Je préfère X à Y»).","سجّل نفسك تشرح هوايتك لصديق فرنسي في 30 ثانية — بلا ورقة. التلقّي هنا هو هدف المحادثة.","ما تحفظه: سلّم التفضيل + «préférer... à...» + سؤال الهوايات. هذه الثلاثة تفتح لك موضوع المحادثة بأكمله."]},{"h":"التطبيق والتلخيص","p":["الحلقة 6: حفلة المبدعين — أعمال يدويّة وطبخ وصور مع صيغ التفضيل «je préfère... à...»، كما في الفيديو الرئيسي «Reflets 1 - épisode #6 - On fête nos créations»: شغّل من بدايته وأعرب عن تفضيلاتك بنبرة الممثلين قبل الرجوع إلى دروس القواعد والمفردات.","جسر الحلقات: من a2-t7-l5 (وصف الشخص للتحقيق) إلى a2-t7-l6 (الإبداعات والتفضيل)، ثم إلى a2-t7-l7 حيث يدخل الحديث إلى الروتين اليومي وأخبار الإضراب في النقل.","المهمة: شاهد الحلقة كاملة، ثم افتح ورقة المفردات وراجع كلمات الإبداع (le loisir, la création, créer, bricoler)، وأخيراً سجّل تلخيصاً شفهياً مدته 30 ثانية تشرح فيه هوايتك وما تفضّله فيها."]}],"examples":[{"fr":"J'aime beaucoup faire de la peinture.","ar":"أحب جداً الرسم.","note":"aimer + infinitif"},{"fr":"Je préfère la musique au cinéma.","ar":"أفضل الموسيقى على السينما.","note":"préférer... à..."},{"fr":"J'adore cuisiner pour mes amis.","ar":"أحب الطبخ لأصدقائي كثيراً.","note":"ader باستعمال قوي"},{"fr":"Qu'est-ce que tu fais comme loisir ?","ar":"ماذا تفعل من هوايات؟","note":"سؤال القياسي"},{"fr":"Moi non plus, je n'aime pas le bruit.","ar":"وأنا أيضاً، لا أحب الضجيج.","note":"الرفض بالتوازي"},{"fr":"C'est mon truc, ça !","ar":"هذا أسلوبي تماماً!","note":"تحمّل عامي"}],"pron":[{"w":"préférer","ipa":"[pʁe.fe.ʁe]","approx":"بريفيري"},{"w":"loisir","ipa":"[lwa.ziʁ]","approx":"لوازير"},{"w":"déteste","ipa":"[de.tɛst]","approx":"ديتست"}],"vocab":[{"fr":"le loisir","ar":"الهواية","pos":"nom","g":"m","exFr":"Quel est ton loisir préféré ?","ipa":"[lwa.ziʁ]","exAr":"ما هوايتك المفضلة؟"},{"fr":"préférer","ar":"يفضّل","pos":"verbe","g":"1er","exFr":"Je préfère lire.","ipa":"[pʁe.fe.ʁe]","exAr":"أفضل القراءة."},{"fr":"adorer","ar":"يحب كثيراً/يعشق","pos":"verbe","g":"1er","exFr":"J'adore cette chanson.","ipa":"[a.dɔ.ʁe]","exAr":"أحب هذه الأغنية كثيراً."},{"fr":"détester","ar":"يكره","pos":"verbe","g":"1er","exFr":"Je déteste la pluie.","ipa":"[de.tɛs.te]","exAr":"أكره المطر."},{"fr":"la création","ar":"الإبداع","pos":"nom","g":"f","exFr":"Sa création est originale.","ipa":"[kʁe.a.sjɔ̃]","exAr":"إبداعه أصيل."},{"fr":"créer","ar":"يُبدع/يخلق","pos":"verbe","g":"1er","exFr":"Ils créent ensemble.","ipa":"[kʁe.e]","exAr":"يبدعون معاً."},{"fr":"bricoler","ar":"يصنع بيديه","pos":"verbe","g":"1er","exFr":"Il bricole dans son garage.","ipa":"[bʁi.kɔ.le]","exAr":"يصنع في مرآبه."},{"fr":"la recette","ar":"الوصفة","pos":"nom","g":"f","exFr":"J'ai une bonne recette.","ipa":"[ʁə.sɛt]","exAr":"لدي وصفة جيدة."},{"fr":"les invités","ar":"الضيوف","pos":"nom","g":"m.pl","exFr":"Les invités arrivent.","ipa":"[ɛ̃.vi.te]","exAr":"الضيوف يصلون."},{"fr":"la boutique","ar":"المتجر/الحانوت","pos":"nom","g":"f","exFr":"Elle ouvre sa boutique de créations.","ipa":"[la bu.tik]","exAr":"يفتح متجره لمنتجاته المصنوعة يدوياً."},{"fr":"comme moi","ar":"مثلّي تماماً","pos":"locution","exFr":"Tu aimes le jazz, comme moi.","ipa":"[kɔm mwa]","exAr":"تحب الجاز، مثلي."},{"fr":"originale","ar":"أصيلة","pos":"adj","exFr":"Une idée originale.","ipa":"[ɔ.ʁi.ʒi.nal]","exAr":"فكرة أصيلة."}],"grammar":[{"tFr":"Aimer / préférer / détester + l'infinitif","tAr":"القاعدة: أفعال التفضيل مع المصدر","body":["أفعال الشعور والميل تأخذ مصدرها مباشرة: «j'aime lire», «je préfère cuisiner», «je déteste mentir» — لا «que» ولا «à» بعدها. و«je préfère X à Y» وحدها تأخذ «à».","«faire + de/du/de la + sport/activité» قالب الهوايات: du sport (مذكر غير معرّف)، de la peinture (مؤنث)، de la guitare. هذا القالب يغنيك عن عشرات أفعال الهواية."],"ex":[{"fr":"Je préfère la marche à la course.","ar":"أفضل المشي على الجري."},{"fr":"Nous faisons du vélo le week-end.","ar":"نمارس ركوب الدراجات نهاية الأسبوع."}]}],"mistakes":[{"wrong":"«J'aime que je cuisine»","right":"«J'aime cuisiner»","why":"aimer يأخذ المصدر مباشرة لا جملة فعلية."},{"wrong":"«Je préfère le café que le thé»","right":"«Je préfère le café au thé»","why":"préférer... à... (التقارب مع الأصل: à + le → au)."},{"wrong":"«faire sport» بلا أداة","right":"«faire du sport»","why":"قالب faire + أداة جزئية + نشاط."},{"wrong":"ترجمة «أحب أكثر» بـ «aime plus»","right":"«Je préfère...»","why":"التفضيل له فعل مخصص لا تشديد المحبة."}],"dialogues":[{"title":"حفلة الأصدقاء","ctx":"ثلاثة أصدقاء يعرضون أعمالهم","lines":[{"who":"Nina","fr":"Regardez : j'ai peint ce tableau cette semaine.","ar":"انظروا: رسمتُ هذا اللوحة هذا الأسبوع."},{"who":"Marc","fr":"Il est superbe ! Moi, je préfère la photo à la peinture.","ar":"إنها رائعة! أنا أفضل التصوير على الرسم."},{"who":"Nina","fr":"Et toi, Karim, tu fais quoi comme loisir ?","ar":"وأنت يا كريم، ماذا تفعل من هوايات؟"},{"who":"Karim","fr":"Je fais de la guitare, et j'adore cuisiner pour les invités.","ar":"أمارس الغيتار، وأحب الطبخ للضيوف."},{"who":"Marc","fr":"Comme moi ! On devrait fêter ça.","ar":"مثلّي تماماً! يجب أن نحتفل بذلك."},{"who":"Nina","fr":"D'accord : je cuisine, Karim joue, et on admire !","ar":"حسناً: أنا أطبخ، كريم يعزف، ونتأمل!"}]}],"exercises":[{"t":"mcq","skill":"grammar","q":"الصيغة الصحيحة للتفضيل:","opts":["Je préfère le thé au café","Je préfère le thé que le café","Je préfère le thé plus le café","Je préfère que le thé"],"a":0,"why":"préférer... à... (au = à + le)."},{"t":"fill","skill":"writing","q":"أكمل: «J'___ beaucoup ce film.» (أحب)","fr":"J'___ beaucoup ce film.","ans":"aime","alts":["Aime"],"why":"aimer في المضارع مع jo."},{"t":"mcq","skill":"reading","q":"«Je déteste le bruit» تعني:","opts":["أكره الضجيج","أحب الضجيج","أخاف الضجيج","أتمنى الضجيج"],"a":0,"why":"détester = يكره."},{"t":"order","skill":"writing","q":"رتّب جملة التفضيل","words":["Je","préfère","la","musique","au","cinéma."],"ans":"Je préfère la musique au cinéma.","why":"préfère ← الاسم المفضّل ← à."},{"t":"listen","skill":"listening","q":"سؤال الهوايات القياسي:","opts":["Qu'est-ce que tu fais comme loisir ?","Où est le loisir ?","Qui est loisir ?","Quand loisir ?"],"a":0,"why":"القالب القياسي للسؤال عن الهواية."},{"t":"translate","skill":"writing","q":"ترجم: «أفضل القراءة على التلفاز.»","ans":"Je préfère lire à regarder la télé.","alts":["je prefererai lire a regarder la telev","je prefere lire a regarder la tele"],"why":"préférer + مصدرين مفصولين بـ à."},{"t":"correct","skill":"writing","q":"صحّح: «J'aime que je dessine»","ans":"J'aime dessiner","alts":["j'aime dessiner"],"why":"aimer + مصدر مباشرة."},{"t":"speaking","skill":"speaking","q":"اكتب 4 جمل عن هواياتك: ماذا تفعل، ماذا تفضّل، وماذا تكره.","target":"J'aime... Je préfère... à... Je déteste...","why":"إنتاج السلّم الكامل موجّهاً."}],"homework":"أعد الحلقة من 42:12 ثلاث مرات، ثم سجّل وصف هوايتك في 30 ثانية (ماذا تفعل، ماذا تفضّل، مع من).\nالحلقة السابقة/التالية: a2-t7-l5 ← a2-t7-l6 → a2-t7-l7","sources":[{"title":"Reflets 1 - épisode #6 - On fête nos créations","channel":"Jason Mills","videoId":"Wj4t6E2HOq4","why":"الحلقة الكاملة — النص الأصلي للمشوار: طبّق ما تعلمه في دروس القواعد والمفردات.","cat":"Séries","level":"A2","main":true,"t":0},{"title":"Est il possible de vendre ses créations artisanales et vivre de sa passion ?","channel":"Stratégie des créatifs","videoId":"oOIw9bwI3vo","why":"كيف تبيع ما تصنعه وتحوّل هوايتك إلى مشروع صغير — يمدّ حديث الحلقة عن الإبداعات بخطوة عملية.","cat":"Conversation","level":"A2","extra":true}],"supplements":[{"id":"oOIw9bwI3vo","title":"Est il possible de vendre ses créations artisanales et vivre de sa passion ?","channel":"Stratégie des créatifs","why":"كيف تبيع ما تصنعه وتحوّل هوايتك إلى مشروع صغير — يمدّ حديث الحلقة عن الإبداعات بخطوة عملية.","dur":7,"lang":"fr"}]},{"id":"a2-t7-l7","fr":"Épisode 7 — Jour de grève","ar":"الحلقة 7 — يوم الإضراب","objectives":["الحديث عن وسائل النقل ومواعيد العمل اليومية بالفرنسية","متابعة الحلقة من توقيتها 51:46 مع إدراك أفعال الواجب والعادة","استخدام imparfait للعادة مع devoir في جمل واقعية"],"sections":[{"h":"الحلقة 7: يوم إضراب في النقل (51:46 — 60:32)","video":{"id":"psobJVdcV9w","title":"Reflets 1 - épisode #7 - Jour de grève","channel":"Jason Mills","why":"الحلقة الكاملة — النص الأصلي للمشوار: طبّق ما تعلمه في دروس القواعد والمفردات.","lang":"fr","main":true,"t":0,"dur":7},"p":["الإضراب موقف فرنسي كلاسيكي: الكل يتكلم عن المترو والقطار، ويكتشف أن الحياة اليومية مبنية على جدول ثابت. أفعال الروتين هنا (se lever, prendre, arriver) هي مفاتيح الحلقة.","التعبير عن العادة بالماضي ليس ثمناً نحويّاً بل مهارة سرد: «D'habitude, je prends le métro» يفتح الباب إلى imparfait — الزمن الذي يصف الخلفية قبل الحدث.","مفردات النقل جوهر الحلقة: le métro, le bus, le tramway, la grève, le retard — إن تعرّفت على «grève» من أول جملة، فمعناه أنك فهمت اتجاه الحلقة كاملاً.","الاستماع والتكرار: جمل الحوارات هنا قصيرة ومعترضة («Il n'y a pas de métro ?!») — تدرّب على المقاطعة والتعجب بنفس نبرة المتحدثين؛ التكرار بالإيقاع أهم من التكرار بالمعنى.","لاحظ «Il faut...» و«Je dois...»: «faut» للضرورة الموضوعية («Il faut trouver un taxi») و«devoir» للاجبار الشخصي — التفريق بينهما يظهر في كل صفحة من صفحات A2.","بعد الحلقة: صف روتينك الصباحي في 5 أسطر بالماضي (imparfait) ثم أضف جملة واحدة بما يحدث لو تغيّر (passé/composé أو futur). السرد المزدوج هذا تمرين قوي."],"sub":[{"h":"النقل والحركة","p":["Il n'y a pas de métro aujourd'hui.","Je prends le bus à huit heures.","Le train a du retard.","Je vais en vélo."]},{"h":"الضرورة والعادة","p":["Il faut trouver une solution.","D'habitude, je prends le métro.","Je dois arriver à neuf heures.","On partait à sept heures."]},{"h":"أدوات الاستماع","p":["grève ← [ɡʁɛv] لا «غراف».","retard ← النبرة على المقطع الثاني.","d'habitude ← [a.bi.tyd] مدموج.","il faut ← [il fo] بلا t مسموعة."]}]},{"h":"عبارات الروتين والتنقل","p":["«Je prends le bus à huit heures» + «Je dois arriver à neuf» — جملتان تختصران كل مهلة عمل يومية. حافظ على البُعد الزمني بين «prendre» (الفعل) و«arriver» (النتيجة) — بها تبني أي جدول.","«Il n'y a pas de...» نفي الوجود يومي، و«Le train a du retard» جملة حيّة لا تُترجم حرفياً: الفرنسية تقول للقطار «عنده تأخير» لا «متأخر».","«Qu'est-ce qu'on fait alors؟» سؤال العصف الذهني: ماذا نفعل الآن؟ بعده يأتي اقتراح الحل، ولهذا يتدرّج الحوار نحو «Il faut...» — تسلسل طبيعي يخدم أي نقاش عن مشكلة."]},{"h":"تمرين الحلقة","p":["تمرين: صف تنقلك المعتاد أمس (imparfait) في 4 جمل، ثم أضف حلّك لحالة إضراب في جملتين بـ «il faut».","استمع للحلقة مجدداً والتقط فقط كلمات النقل والوقت — كتابتها بمفردها على ورقة تكشف مدى تقدّمك في استماعك.","ما تحفظه: «D'habitude...» للعادة + «Il faut...» للضرورة + كلمات النقل الست. بها تدير أي حديث عن التأخير."]},{"h":"التطبيق والتلخيص","p":["الحلقة 7: يوم إضراب في النقل — جدول معتاد يتعطّل وأفعال الروتين se lever / prendre / arriver، كما في الفيديو الرئيسي «Reflets 1 - épisode #7 - Jour de grève»: شغّل من بدايته وقارن بين روتينك وروتين المتحدثين ثم ارجع إلى دروس القواعد والمفردات.","جسر الحلقات: من a2-t7-l6 (الإبداعات والهوايات) إلى a2-t7-l7 (الروتين وأخبار الإضراب)، ثم إلى a2-t7-l8 حيث تتحوّل المحادثة إلى دعوة لنشاط في المركز الثقافي.","المهمة: شاهد الحلقة كاملة، ثم افتح ورقة المفردات وراجع كلمات التنقل (la grève, le retard, un itinéraire, circuler)، وأخيراً سجّل تلخيصاً شفهياً مدته 30 ثانية تصف فيه صباحك في يوم إضراب."]}],"examples":[{"fr":"Il n'y a pas de métro à cause de la grève.","ar":"لا يوجد مترو بسبب الإضراب.","note":"سبب + نفي"},{"fr":"D'habitude, je prends le tramway.","ar":"عادةً أستقل الترامواي.","note":"imparfait للعادة"},{"fr":"Je dois arriver avant neuf heures.","ar":"يجب أن أصل قبل التاسعة.","note":"devoir شخصي"},{"fr":"Il faut trouver un autre chemin.","ar":"يجب إيجاد طريق آخر.","note":"il faut ضرورة"},{"fr":"Le train a quinze minutes de retard.","ar":"القطار متأخر خمس عشرة دقيقة.","note":"تعبير التأخير"},{"fr":"On partait toujours à sept heures.","ar":"كنا ننطلق دائماً في السابعة.","note":"imparfait عادة"}],"pron":[{"w":"grève","ipa":"[ɡʁɛv]","approx":"غريف"},{"w":"retard","ipa":"[ʁə.taʁ]","approx":"ريطار"},{"w":"d'habitude","ipa":"[a.bi.tyd]","approx":"أبيتّيود"}],"vocab":[{"fr":"la grève","ar":"الإضراب","pos":"nom","g":"f","exFr":"Il y a une grève demain.","ipa":"[ɡʁɛv]","exAr":"يوجد إضراب غداً."},{"fr":"le retard","ar":"التأخير","pos":"nom","g":"m","exFr":"J'ai du retard.","ipa":"[ʁə.taʁ]","exAr":"أنا متأخر."},{"fr":"le métro","ar":"المترو","pos":"nom","g":"m","exFr":"Je prends le métro.","ipa":"[me.tʁo]","exAr":"أستقل المترو."},{"fr":"le tramway","ar":"الترامواي","pos":"nom","g":"m","exFr":"Le tramway passe ici.","ipa":"[tʁam.way]","exAr":"الترامواي يمر من هنا."},{"fr":"le trajet","ar":"الطريق اليومي","pos":"nom","g":"m","exFr":"Mon trajet dure quarante minutes.","ipa":"[lə tʁa.ʒɛ]","exAr":"طريق يومي يستغرق أربعين دقيقة."},{"fr":"devoir","ar":"يجب عليه/يلزم","pos":"verbe","g":"3e","exFr":"Je dois travailler.","ipa":"[də.vwaʁ]","exAr":"يجب أن أعمل."},{"fr":"manquer","ar":"يفتقد/ينقص","pos":"verbe","g":"1er","exFr":"Il manque un bus.","ipa":"[ma̅.ke]","exAr":"ينقص باص واحد."},{"fr":"un itinéraire","ar":"خط السير","pos":"nom","g":"m","exFr":"Quel itinéraire prends-tu ?","ipa":"[i.ti.ne.ʁɛʁ]","exAr":"أي خط سير تسلك؟"},{"fr":"circuler","ar":"يتحرك/يمرّ","pos":"verbe","g":"1er","exFr":"Les bus circulent mal.","ipa":"[siʁ.ky.le]","exAr":"الحافلات تتحرك بشكل سيئ."},{"fr":"partir","ar":"ينطلق","pos":"verbe","g":"3e","exFr":"On part à huit heures.","ipa":"[paʁtiʁ]","exAr":"ننطلق في الثامنة."},{"fr":"un chemin","ar":"الطريق","pos":"nom","g":"m","exFr":"Un autre chemin existe.","ipa":"[ʃə.mɛ̃]","exAr":"يوجد طريق آخر."},{"fr":"le syndicat","ar":"النقابة","pos":"nom","g":"m","exFr":"Les cheminots ont écouté le syndicat.","ipa":"/lə sɛ̃dika/","exAr":"استمع العمال إلى النقابة."}],"grammar":[{"tFr":"L'imparfait de l'habitude et il faut / je dois","tAr":"القاعدة: عادة الماضي مع الضرورة","body":["imparfait يُبنى من المضارع مع yi/ai/nions/iez/aient: «je prenais», «nous partions», «ils arrivaient» — وهو زمن الخلفية والعادة، يُستعمل مع «d'habitude», «chaque matin», «toujours».","«Il faut» + مصدر للضرورة الموضوعية، و«je dois» + مصدر للاجبار الشخصي — الاثنان لا يُستعملان للمستقبل القريب هنا (ذلك futur proche). التكرار في جمل الروتين يثبّت التفرقة."],"ex":[{"fr":"D'habitude, je partais à sept heures.","ar":"عادةً كنت أنطلق في السابعة."},{"fr":"Il faut prendre un taxi.","ar":"يجب أن نستقل سيارة أجرة."}]}],"mistakes":[{"wrong":"imparfait مع حدث مفاجئ واحد","right":"الحدث المفاجئ passé composé والخلفية imparfait","why":"الزمنان يتكاملان في السرد لا يتنازعان."},{"wrong":"«Il faut que je vais»","right":"«Il faut que j'aille» (subjonctif) أو «Je dois aller»","why":"il faut que تستلزم المنصوب الفعلي، والبسيطة تأخذ المصدر."},{"wrong":"ترجمة «عنده تأخير» بـ «est en retard» للقطار","right":"«Le train a du retard»","why":"التعبير الاصطلاحي الفرنسي لوسائل النقل."},{"wrong":"الخلط بين devoir وfaut","right":"devoir شخصي / faut موضوعي","why":"الفاعل يحدد القالب."}],"dialogues":[{"title":"أمام باب المترو","ctx":"زميلان في محطة مغلقة","lines":[{"who":"Samir","fr":"Quoi ? Pas de métro aujourd'hui ?","ar":"ماذا؟ لا مترو اليوم؟"},{"who":"Claire","fr":"Non, il y a une grève générale. Le train aussi a du retard.","ar":"لا، يوجد إضراب عام. والقطار أيضاً متأخر."},{"who":"Samir","fr":"Je dois arriver avant neuf heures !","ar":"يجب أن أصل قبل التاسعة!"},{"who":"Claire","fr":"Il faut trouver un bus, ou partir en vélo.","ar":"يجب إيجاد حافلة، أو الانطلاق بالدراجة."},{"who":"Samir","fr":"D'habitude, je prends le métro à huit heures.","ar":"عادةً أستقل المترو في الثامنة."},{"who":"Claire","fr":"Alors on marche : le bureau n'est pas loin.","ar":"إذن نمشِ: المكتب ليس بعيداً."}]}],"exercises":[{"t":"mcq","skill":"grammar","q":"الصيغة الصحيحة للعادة في الماضي:","opts":["D'habitude, je prenais le métro","D'habitude, je prends le métro demain","D'habitude, je pris le métro","D'habitude, je prendrai"],"a":0,"why":"imparfait للعادة المتكررة."},{"t":"fill","skill":"writing","q":"أكمل: «Il ___ trouver une solution.»","fr":"Il ___ trouver une solution.","ans":"faut","alts":["Faut"],"why":"il faut + مصدر للضرورة."},{"t":"mcq","skill":"listening","q":"عبارة التأخير الصحيحة للقطار:","opts":["Le train a du retard","Le train est tard","Le train a tardif","Le train va retard"],"a":0,"why":"a du retard هو الاصطلاح."},{"t":"order","skill":"writing","q":"رتّب جملة الروتين","words":["D'habitude,","je","prends","le","bus","à","huit","heures."],"ans":"D'habitude, je prends le bus à huit heures.","why":"ظرف العادة ← الفعل ← النقل ← الوقت."},{"t":"listen","skill":"listening","q":"الضرورة الموضوعية في المقطع:","opts":["Il faut partir","Je dois partir","Il part","Partir est bon"],"a":0,"why":"il faut بلا فاعل شخصي."},{"t":"translate","skill":"writing","q":"ترجم: «كنتُ أذهب إلى العمل بالسيارة كل يوم.»","ans":"Je allais au travail en voiture chaque jour.","alts":["je allais au travail en voiture chaque jour"],"why":"imparfait + كل يوم."},{"t":"correct","skill":"writing","q":"صحّح: «Le train est retard.»","ans":"Le train a du retard","alts":["le train a du retard"],"why":"التأخير مع avoir."},{"t":"writing","skill":"writing","q":"صف روتينك الصباحي أمس في 4 جمل بالماضي (imparfait).","target":"D'habitude, je me levais...","why":"سرد العادة الموجّه."}],"homework":"أعد الحلقة من 51:46 ثلاث مرات، ثم اكتب وصفاً لروتين عملك المعتاد في 5 جمل بـ imparfait، مع جملة واحدة بـ «il faut».\nالحلقة السابقة/التالية: a2-t7-l6 ← a2-t7-l7 → a2-t7-l8","sources":[{"title":"Reflets 1 - épisode #7 - Jour de grève","channel":"Jason Mills","videoId":"psobJVdcV9w","why":"الحلقة الكاملة — النص الأصلي للمشوار: طبّق ما تعلمه في دروس القواعد والمفردات.","cat":"Séries","level":"A2","main":true,"t":0},{"title":"[Français Facile A1-A2] 📰 Comprendre les news en français simple","channel":"French Très Bien | Learn French Easy","videoId":"_2RZ9ACeEXQ","why":"أخبار فرنسية بأسلوب سهل من مستويي A1-A2 — يربط حديث الحلقة عن الإضراب بالواقع والمفردات الصحافية.","cat":"Listening","level":"A2","extra":true}],"supplements":[{"id":"_2RZ9ACeEXQ","title":"[Français Facile A1-A2] 📰 Comprendre les news en français simple","channel":"French Très Bien | Learn French Easy","why":"أخبار فرنسية بأسلوب سهل من مستويي A1-A2 — يربط حديث الحلقة عن الإضراب بالواقع والمفردات الصحافية.","dur":7,"lang":"fr"}]},{"id":"a2-t7-l8","fr":"Épisode 8 — Au centre culturel","ar":"الحلقة 8 — في المركز الثقافي","objectives":["وصف الأنشطة الثقافية المقترحة وقبول الدعوة بلباقة","متابعة الحلقة من توقيتها 60:32 مع التقاط صيغ العرض والقبول","استخدام futur proche (aller + infinitif) للخطط القريبة"],"sections":[{"h":"الحلقة 8: ورشة في المركز الثقافي (60:32 — 71:35)","video":{"id":"qDSvhJmUVYE","title":"Reflets 1 - épisode #8 - Au centre culturel","channel":"Jason Mills","why":"الحلقة الكاملة — النص الأصلي للمشوار: طبّق ما تعلمه في دروس القواعد والمفردات.","lang":"fr","main":true,"t":0,"dur":6},"p":["المركز الثقافي مكان مثالي للمفردات المتنوّعة: la conférence, l'atelier, l'exposition, la rencontre — كل كلمة تفتح باب نشاط حقيقي. والدعوة نفسها («On se retrouve...؟») هي قلب الموقف."," futur proche هو حليف A2: «Je vais m'inscrire», «On va se voir vendredi». بُني من aller + مصدر، سهل التركيب، وينقذك كلما تسرّبت إلى الحديث عن الخطط.","مفردات القبول والرفض متعادلة في الأهمية: «Avec plaisir» قبول، «Je voudrais, mais...» رفض مهذّب — الرفض بلا بديل يُغلق الحوار، والقبول بلا حماس يُشعر الطرف بالبرود.","الأفعال المركّبة بـ «se» تظهر هنا: «se retrouver», «s'inscrire», «se rencontrer» — تعلّمها في وسطها (se retrouver avec qui) لا معزولة؛ الفعل المركّب في السياق يثبت أسرع.","الاستماع والتكرار: الحوار يتداول العروض بسرعة («Et si on allait...؟») — الإيقاع هنا تدريب على التخمين السريع لمفردات النشاط التالية قبل أن تُنطق.","بعد الحلقة: اكتب دعوة إلى نشاط ثقافي (ساعة، مكان، نشاط) وردّ قبول أو رفض مهذّب في جملتين — هذا نص قصير كامل من الحياة الواقعية."],"sub":[{"h":"الأنشطة الثقافية","p":["un atelier de dessin","une conférence d'histoire","une exposition de photos","un concert de jazz"]},{"h":"الدعوة والقبول","p":["On se retrouve devant la bibliothèque.","Avec plaisir !","Je viens avec toi.","Désolée, je ne peux pas."]},{"h":" futur proche في الموقف","p":["Je vais m'inscrire demain.","On va commencer à dix heures.","Tu vas aimer l'endroit !"]}]},{"h":"عبارات العرض والانضمام","p":["«Et si on allait voir l'exposition ?» اقتراح بصيغة الشرط البلاغية — أقوى من الأمر وأرقى من السؤال المباشر، وتُسمع كثيراً بين الأصدقاء.","«Je voudrais m'inscrire à l'atelier» استثمار صيغة vouloir في الماضي (conditionnel) لطلب مهذّب: ليست رغبة عابرة بل طلب رسمي لطيف — وهي من أكثر جمل التسجيل استخداماً.","«On se retrouve à la sortie» عبارة وداع + موعد آتي، تختصر وداعاً كاملاً وتعيد تثبيت اللقاء القادم. من صادقَنَّا بالعربية يجد في الفرنسية ما يشبهها تماماً."]},{"h":"تمرين الحلقة","p":["تمرين: اكتب دعوة وردّاً عليها: (1) اقتراح نشاط + futur proche، (2) قبول بـ «avec plaisir» أو رفض بـ «je voudrais, mais...».","سجّل المحادثة بصوتين (أنت وصديقك) — تدريب الحوار المزدوج أسرع في بناء الثقة من الإنصات وحده.","ما تحفظه: «Et si on...» للاقتراح + «Je voudrais...» للطلب + «Avec plaisir» للقبول. الثلاثة تدير كل دعوة ثقافية."]},{"h":"التطبيق والتلخيص","p":["الحلقة 8: ورشة في المركز الثقافي — الدعوة والقبول والرفض مع «On se retrouve...؟»، كما في الفيديو الرئيسي «Reflets 1 - épisode #8 - Au centre culturel»: شغّل من بدايته واكتب دعوة مع المتحدثين، ثم ارجع إلى دروس القواعد والمفردات.","جسر الحلقات: من a2-t7-l7 (الروتين وأخبار الإضراب) إلى a2-t7-l8 (الأنشطة الثقافية والدعوة)، ثم إلى a2-t7-l9 حيث يرتقي اللقاء إلى صيغة رسمية كاملة.","المهمة: شاهد الحلقة كاملة، ثم افتح ورقة المفردات وراجع كلمات النشاط (l'atelier, l'exposition, la conférence, assister à)، وأخيراً سجّل تلخيصاً شفهياً مدته 30 ثانية تدعو فيه صديقاً إلى نشاط ثقافي."]}],"examples":[{"fr":"On va commencer à dix heures.","ar":"سنبدأ في العاشرة.","note":"futur proche"},{"fr":"Je vais m'inscrire à l'atelier.","ar":"سأسجّل في الورشة.","note":"inscrire مع se"},{"fr":"Et si on allait au concert ?","ar":"ماذا لو ذهبنا إلى الحفل؟","note":"اقتراح بلاغي"},{"fr":"Avec plaisir, je viens !","ar":"بكل سرور، آتي!","note":"قبول"},{"fr":"Je voudrais deux places, s'il vous plaît.","ar":"أريد تذكرتين من فضلك.","note":"طلب مهذّب"},{"fr":"On se retrouve devant la bibliothèque.","ar":"نلتقي أمام المكتبة.","note":"موعد"}],"pron":[{"w":"l'atelier","ipa":"[la.te.lje]","approx":"لاتوليي"},{"w":"inscrire","ipa":"[ɛ̃.skʁiʁ]","approx":"أونسكري"},{"w":"bibliothèque","ipa":"[bi.blijɔ.tɛk]","approx":"بيبليوتيك"}],"vocab":[{"fr":"le centre culturel","ar":"المركز الثقافي","pos":"nom","g":"m","exFr":"Le centre culturel ouvre à neuf heures.","ipa":"[sɑ̃tʁ ku.ly.ʁɛl]","exAr":"المركز الثقافي يفتح في التاسعة."},{"fr":"l'atelier","ar":"الورشة","pos":"nom","g":"m","exFr":"Un atelier de peinture.","ipa":"[a.te.lje]","exAr":"ورشة رسم."},{"fr":"l'exposition","ar":"المعرض","pos":"nom","g":"f","exFr":"Une exposition de photos.","ipa":"[ɛ̃.spɔ.zi.sjɔ̃]","exAr":"معرض صور."},{"fr":"l'inscription","ar":"التسجيل","pos":"nom","g":"f","exFr":"L'inscription est gratuite.","ipa":"[ɛ̃.skʁip.sjɔ̃]","exAr":"التسجيل مجاني."},{"fr":"s'inscrire","ar":"يسجّل نفسه","pos":"verbe","g":"2e","exFr":"Je veux m'inscrire.","ipa":"[ɛ̃.skʁiʁ]","exAr":"أريد أن أسجّل."},{"fr":"l'invitation","ar":"الدعوة","pos":"nom","g":"f","exFr":"Merci pour l'invitation.","ipa":"[ɛ̃.vi.ta.sjɔ̃]","exAr":"شكراً على الدعوة."},{"fr":"la conférence","ar":"المحاضرة","pos":"nom","g":"f","exFr":"Une conférence sur l'histoire.","ipa":"[kɔ̃.fe.ʁɑ̃s]","exAr":"محاضرة في التاريخ."},{"fr":"assister à","ar":"يحضر","pos":"locution","exFr":"J'ai assisté au concert.","ipa":"[a.sis.te a]","exAr":"حضرت الحفل."},{"fr":"la sortie","ar":"المخرج/الخروج","pos":"nom","g":"f","exFr":"À la sortie du cinéma.","ipa":"[sɔʁ.ti]","exAr":"عند خروج السينما."},{"fr":"le concert","ar":"الحفل الموسيقي","pos":"nom","g":"m","exFr":"Nous allons au concert vendredi.","ipa":"[lə.kɔ̃.sɛʁ]","exAr":"نذهب إلى الحفل الموسيقي يوم الجمعة."},{"fr":"l'échange","ar":"التبادل","pos":"nom","g":"m","exFr":"Un bel échange d'idées.","ipa":"[e.ʃɑ̃ʒ]","exAr":"تبادل جميل للأفكار."},{"fr":"le spectacle","ar":"العرض المسرحي","pos":"nom","g":"m","exFr":"Ce soir, il y a un spectacle au centre.","ipa":"[lə spɛk.takl]","exAr":"هذا المساء هناك عرض في المركز."}],"grammar":[{"tFr":"Le futur proche : aller + infinitif","tAr":"القاعدة: المستقبل القريب","body":["المستقبل القريب = «aller» في المضارع + مصدر: «je vais partir», «tu vas appeler», «nous allons recevoir» — مع النفي «je ne vais pas...»، ومع le/la: «Je vais l'appeler» (الضمير يسبق الفعلين معاً).","الفرق مع futur simple: القريب شخصي وقريب زمنياً (هذا الأسبوع)، والبسيط أكثر رسمية وابتعاداً. في A2 استعمل القريب — إيقاعه أخف واحتمال الخطأ فيه أدنى."],"ex":[{"fr":"Je vais téléphoner à l'organisme.","ar":"سأتصل بالجهة المنظِّمة."},{"fr":"On ne va pas rester longtemps.","ar":"لن نبقى طويلاً."}]}],"mistakes":[{"wrong":"«Je vais à manger»","right":"«Je vais manger»","why":"aller + مصدر مباشرة، حرف الجر لا محل له."},{"wrong":"الضمير بعد المصدر في futur proche","right":"«Je vais l'appeler» (الضمير قبل)","why":"الضمير يسبق التركيب كاملاً."},{"wrong":"«Je voudrais que...» بلا subjonctif","right":"«Je voudrais avoir...» (مصدر) أو que + subjonctif","why":"الطلب المباشر بالمصدر، والجملة الفرعية بالمنصوب."},{"wrong":"رفض مباشر بلا بديل","right":"«Je voudrais, mais...»","why":"الرفض المهذّب يترك باباً مفتوحاً."}],"dialogues":[{"title":"دعوة إلى الورشة","ctx":"موظفة الاستقبال وطالبة","lines":[{"who":"La réceptionniste","fr":"Nous avons un atelier de dessin mercredi. Vous voulez vous inscrire ?","ar":"لدينا ورشة رسم يوم الأربعاء. أترين التسجيل؟"},{"who":"L'étudiante","fr":"Avec plaisir ! Et si j'amenais une amie ?","ar":"بكل سرور! وماذا لو أحضرت صديقة؟"},{"who":"La réceptionniste","fr":"Bien sûr, elle doit juste remplir ce formulaire.","ar":"بالتأكيد، عليها فقط ملء هذه الاستمارة."},{"who":"L'étudiante","fr":"On commence à quelle heure ?","ar":"نبدأ في أي ساعة؟"},{"who":"La réceptionniste","fr":"On va commencer à quatorze heures.","ar":"سنبدأ في الثانية بعد الزوال."},{"who":"La étudiante","fr":"Parfait, je viendrai avec mon amie. À mercredi !","ar":"ممتاز، سآتي مع صيديقتكم. إلى الأربعاء!"}]}],"exercises":[{"t":"mcq","skill":"grammar","q":"الصيغة الصحيحة للمستقبل القريب:","opts":["Je vais m'inscrire","Je vais à m'inscrire","Je m'inscrirai vais","Je suis m'inscrire"],"a":0,"why":"aller + مصدر مباشرة."},{"t":"fill","skill":"writing","q":"أكمل: «On ___ commencer à dix heures.»","fr":"On ___ commencer à dix heures.","ans":"va","alts":["Va"],"why":"on + va في futur proche."},{"t":"mcq","skill":"speaking","q":"قبول مهذّب للدعوة:","opts":["Avec plaisir !","Non","Peut-être tard","Je ne sais pas"],"a":0,"why":"قبول صريح بحماس."},{"t":"order","skill":"writing","q":"رتّب جملة اقتراح","words":["Et","si","on","allait","voir","l'exposition","?"],"ans":"Et si on allait voir l'exposition ?","why":"si + imparfait للاقتراح."},{"t":"listen","skill":"listening","q":"جملة التسجيل في المقطع:","opts":["Je vais m'inscrire demain","Je suis inscrit hier","Je m'inscrivais","Inscris-toi passé"],"a":0,"why":"futur proche للخطة."},{"t":"translate","skill":"writing","q":"ترجم: «سنتقابل أمام المكتبة في الرابعة.»","ans":"On se retrouve devant la bibliothèque à quatre heures.","alts":["on se retrouve devant la bibliotheque a quatre heures"],"why":"se retrouver + مكان + وقت."},{"t":"correct","skill":"writing","q":"صحّح: «Je vais à appeler ma mère.»","ans":"Je vais appeler ma mère","alts":["je vais appeler ma mere"],"why":"لا حرف جر بين aller والمصدر."},{"t":"writing","skill":"writing","q":"اكتب دعوة نشاط ثقافي وردّ قبول في 4 جمل (futur proche + avec plaisir).","target":"On va... — Avec plaisir !","why":"إنتاج موجّه للموقف كاملًا."}],"homework":"أعد الحلقة من 60:32 ثلاث مرات، ثم اكتب دعوة ورداً عليها: اقتراح نشاط بـ futur proche وقبول بـ «avec plaisir» في 4 جمل.\nالحلقة السابقة/التالية: a2-t7-l7 ← a2-t7-l8 → a2-t7-l9","sources":[{"title":"Reflets 1 - épisode #8 - Au centre culturel","channel":"Jason Mills","videoId":"qDSvhJmUVYE","why":"الحلقة الكاملة — النص الأصلي للمشوار: طبّق ما تعلمه في دروس القواعد والمفردات.","cat":"Séries","level":"A2","main":true,"t":0},{"title":"2.30 minutes pour comprendre ce qu'est un Centre culturel","channel":"Province de Namur","videoId":"v_778RQlmTk","why":"شرح مصوّر لما هو عليه المركز الثقافي وما يُقدَّم فيه من أنشطة — يفتح كلمات الحلقة على الممارسة.","cat":"Vocabulaire","level":"A2","extra":true}],"supplements":[{"id":"v_778RQlmTk","title":"2.30 minutes pour comprendre ce qu'est un Centre culturel","channel":"Province de Namur","why":"شرح مصوّر لما هو عليه المركز الثقافي وما يُقدَّم فيه من أنشطة — يفتح كلمات الحلقة على الممارسة.","dur":2,"lang":"fr"}]},{"id":"a2-t7-l9","fr":"Épisode 9 — Ravi de faire votre connaissance","ar":"الحلقة 9 — سرور بمعرفتكم","objectives":["الحفاظ على لباقة اللقاء الرسمي والمهني (vous, titres, formules)","متابعة الحلقة من توقيتها 71:35 مع إدراك صيغ الاحترام","استخدام conditionnel présent لطلب مهذّب (je voudrais, pourriez-vous)"],"sections":[{"h":"الحلقة 9: لقاء رسمي (71:35 — 82:16)","video":{"id":"o-6MkVG_qmI","title":"Reflets 1 - épisode #9 - Ravi de faire votre connaissance","channel":"Jason Mills","why":"الحلقة الكاملة — النص الأصلي للمشوار: طبّق ما تعلمه في دروس القواعد والمفردات.","lang":"fr","main":true,"t":0,"dur":8},"p":["اللقاء الرسمي هو مرآة اللباقة الفرنسية: الاسم الكامل ثم اللقب ثم الجملة الطويلة «Je suis ravi de faire votre connaissance». التدرّج نفسه يجعل المتحدث يبدو منظماً ومحترماً.","الفرق بين «tu» و«vous» هنا ليس ترجمة بل موقف: الرسمية تحكم اللقاء الأول مع الزملاء الجدد والعملاء، ولا تُلغى إلا بدعوة صريحة («On peut se tutoyer !»).","الطلب المهذّب ينتقل إلى conditionnel: «Je voudrais...», «Pourriez-vous...?» — هما بديلا صيغة الأمر، ولهما وزن رسمي يُسمع في كل مكتب.","«Enchanté / Ravie» تختاران حسب المتحدث: ravie للمؤنث. الخطأ البسيط هنا بسيط فعلاً، لكنه يُلاحَظ لأنه من أول ما يُقال.","الاستماع والتكرار: النبرة في اللقاء الرسمي ثابتة وهادئة — تدرّب على خفض سرعتك قليلاً ورفع وضوح النهايات. الإيقاع البطيء المدروس أقوى من السريع المرتجف.","بعد الحلقة: كنّس جدلاً كاملاً لقاءً بالفرنسية مع وضع «vous» و«Je voudrais» و«ravi de...» في مكانهما. اكتبه ثم انطقه أمام المرآة."],"sub":[{"h":"صيغ اللقاء الرسمي","p":["Enchanté, madame.","Je suis ravi de vous rencontrer.","Voici ma carte.","Permettez-moi de me présenter."]},{"h":"الطلبات المهذّبة","p":["Je voudrais prendre rendez-vous.","Pourriez-vous m'aider ?","Vous pouvez m'expliquer...","Serait-il possible de...?"]},{"h":"الألقاب والمهن","p":["Monsieur / Madame","le directeur / la directrice","le client / la cliente","le collègue"]}]},{"h":"عبارات الاحترام المتكررة","p":["«Permettez-moi de me présenter» افتتاح رسمي لا يُقال بين الأصدقاء، ويُسبق به التحية الرسمية «Bonjour, madame».","«Je vous présente mon collègue, Monsieur Durant» — تعارف ثلاثي يمرّ بالوسط: العرض ثم التقديم ثم المصافحة. لاحظ الضمير le/la مع «présenter»: «Je vous le présente».","«N'hésitez pas à me contacter» خاتمة رسمية مفيدة: تدعو الطرف للاستمرار بلا التزام — عبارة تُغلق اللقاء على مهل، وهي من أنجح العبارات المهنية."]},{"h":"تمرين الحلقة","p":["تمرين: ابنِ موكباً كاملاً للقاء: تحية (Bonjour, madame) ← تعارف (Je suis ravi de...) ← طلب (Je voudrais...) ← خاتمة (N'hésitez pas à...). أربع جمل تكفي.","سجّل نبرتك: هل رفعت صوتك أكثر من اللازم؟ اللقاء الرسمي الفرنسي هادئ — الخفض سلاح ثقة.","ما تحفظه: «ravi de + مصدر» + «je voudrais» + «n'hésitez pas à...» — بها تُدير كل لقاء رسمي في حياتك المهنية."]},{"h":"التطبيق والتلخيص","p":["الحلقة 9: لقاء رسمي — الاسم الكامل ثم اللقب ثم «Je suis ravi de faire votre connaissance»، كما في الفيديو الرئيسي «Reflets 1 - épisode #9 - Ravi de faire votre connaissance»: شغّل من بدايته وقلّد النبرة المهذّبة حرفياً قبل الرجوع إلى دروس القواعد والمفردات.","جسر الحلقات: من a2-t7-l8 (دعوة المركز الثقافي) إلى a2-t7-l9 (اللقاء الرسمي وصيغ الاحترام)، ثم إلى a2-t7-l10 حيث تخفّض المحادثة إلى نزهة في الحديقة وحديث الطقس.","المهمة: شاهد الحلقة كاملة، ثم افتح ورقة المفردات وراجع كلمات اللباقة (la présentation, la carte professionnelle, s'adresser à, le professionnalisme)، وأخيراً سجّل تلخيصاً شفهياً مدته 30 ثانية تقدّم فيه نفسك لقاءً رسمياً."]}],"examples":[{"fr":"Je suis ravi de faire votre connaissance.","ar":"سرورٌ بمعرفتكم.","note":"اللقاء الرسمي"},{"fr":"Permettez-moi de me présenter.","ar":"اسمحوا لي أن أقدّم نفسي.","note":"افتتاح رسمي"},{"fr":"Je voudrais prendre rendez-vous.","ar":"أريد أن أحجز موعداً.","note":"طلب مهذّب"},{"fr":"Pourriez-vous m'expliquer la procédure ?","ar":"هل يمكنك أن تشرح لي الإجراء؟","note":"استفهام بشروط"},{"fr":"Voici ma carte professionnelle.","ar":"تفضّلوا بطاقتي المهنية.","note":"تبادل البطاقات"},{"fr":"N'hésitez pas à me contacter.","ar":"لا تترددوا في التواصل معي.","note":"خاتمة مهنية"}],"pron":[{"w":"ravi","ipa":"[ʁa.vi]","approx":"رافي"},{"w":"connaissance","ipa":"[kɔ.nɛ.sɑ̃s]","approx":"كونيسانس"},{"w":"permettez","ipa":"[pɛʁ.me.te]","approx":"بيرمتي"}],"vocab":[{"fr":"la connaissance","ar":"المعرفة/الشخص المتعرف عليه","pos":"nom","g":"f","exFr":"Faire connaissance avec un client.","ipa":"[kɔ.nɛ.sɑ̃s]","exAr":"التعرف على زبون."},{"fr":"ravi(e)","ar":"سرور/مبتهج","pos":"adj","exFr":"Ravi de vous voir.","ipa":"[ʁa.vi]","exAr":"مبتهج برؤيتكم."},{"fr":"la présentation","ar":"التعارف/العرض","pos":"nom","g":"f","exFr":"Une brève présentation.","ipa":"[pʁe.zɑ̃.ta.sjɔ̃]","exAr":"تعارف موجز."},{"fr":"je vous en prie","ar":"العفو/على الرحب والسعة","pos":"locution","exFr":"— Merci beaucoup. — Je vous en prie.","ipa":"[ʒə vu.ɑ̃ pʁi]","exAr":"— شكراً جزيلاً. — على الرحب والسعة."},{"fr":"la carte professionnelle","ar":"البطاقة المهنية","pos":"nom","g":"f","exFr":"Voici ma carte.","ipa":"[kaʁt pʁɔ.fe.sjɔ.nɛl]","exAr":"تفضّل بطاقتي."},{"fr":"le collègue","ar":"الزميل","pos":"nom","g":"m","exFr":"Mon collègue est sympa.","ipa":"[kɔ.leg]","exAr":"زميلي لطيف."},{"fr":"le directeur / la directrice","ar":"المدير/ة","pos":"nom","exFr":"La directrice est en réunion.","ipa":"[di.ʁɛk.tœʁ]","exAr":"المديرة في اجتماع."},{"fr":"hésiter","ar":"يتردد","pos":"verbe","g":"1er","exFr":"N'hésitez pas.","ipa":"[e.zi.te]","exAr":"لا تتردد."},{"fr":"expliquer","ar":"يشرح","pos":"verbe","g":"1er","exFr":"Pouvez-vous expliquer ?","ipa":"[ɛks.pli.ke]","exAr":"هل يمكنك الشرح؟"},{"fr":"la procédure","ar":"الإجراء","pos":"nom","g":"f","exFr":"Suivre la procédure.","ipa":"[pʁɔ.se.dyʁ]","exAr":"اتّبع الإجراء."},{"fr":"s'adresser à","ar":"يوجّه كلامه إلى","pos":"locution","exFr":"Je m'adresse à la réception.","ipa":"[a.dʁe.se a]","exAr":"أوجّه كلامي للاستقبال."},{"fr":"le professionnalisme","ar":"الاحترافية","pos":"nom","g":"m","exFr":"Sa rapidité témoigne de son professionnalisme.","ipa":"[pʁɔ.fɛ.sjɔ.na.lism]","exAr":"سرعته تدل على احترافيته."}],"grammar":[{"tFr":"Le conditionnel de politesse (présent)","tAr":"القاعدة: شرطية الاحترام","body":["الشرطية الحالية للطلب المهذّب: «Je voudrais», «Pourriez-vous...?», «Il serait possible...?» — تُبنى كالمستقبل (يد+k/rai) لكن وظيفتها لطف لا زمن. الترجمة الحرفية «أريد أن» بـ voudrais تنقل الرسمية كاملة.","«Je voudrais que + subjonctif» للجملة الفرعية («...que vous puissiez...»)، والمصدر للطلب المباشر («Je voudrais partir»). A2 يحتاج القالب المباشر أكثر، والمنصوب عند الحاجة."],"ex":[{"fr":"Pourriez-vous me donner un reçu ?","ar":"هل يمكنك أن تعطيني إيصالاً؟"},{"fr":"Je voudrais que vous m'appeliez demain.","ar":"أريد أن تتصل بي غداً."}]}],"mistakes":[{"wrong":"«Je veux un rendez-vous» مع مجهول","right":"«Je voudrais prendre rendez-vous»","why":"الطلب المباشر يُقرأ خشونة في السياق الرسمي."},{"wrong":"الخلط بين ravie وravi مع المتحدث","right":"ravi للمذكر وravie للمؤنث","why":"الصفة تُطابق المتحدث لا المخاطب."},{"wrong":"tutoyer فوراً في اللقاء الأول","right":"vous حتى يُلمَّح للتحوّل","why":"الاختيار الأول يحدد مستوى العلاقة."},{"wrong":"«Je vous présente à mon collègue»","right":"«Je vous présente mon collègue»","why":"«présenter quelqu'un à quelqu'un»: ضمير الشخصين متتاليان بلا à."}],"dialogues":[{"title":"الأول في الشركة","ctx":"موظفة جديدة ومدير المكتب","lines":[{"who":"Le directeur","fr":"Bonjour, madame. Permettez-moi de me présenter : Marc Durand.","ar":"مرحباً يا سيدة. اسمحوا لي أن أقدّم نفسي: مارك دوران."},{"who":"La nouvelle","fr":"Bonjour, monsieur. Je suis ravie de faire votre connaissance.","ar":"مرحباً سيدي. سروري بمعرفتكم."},{"who":"Le directeur","fr":"Bienvenue ! Vous allez travailler avec l'équipe du troisième étage.","ar":"أهلاً! ستعملين مع فريق الطابق الثالث."},{"who":"La nouvelle","fr":"Merci. Je voudrais connaître la routine de l'équipe.","ar":"شكراً. أودّ أن أتعرف على روتين الفريق."},{"who":"Le directeur","fr":"Bien sûr. N'hésitez pas à me contacter si besoin.","ar":"بالتأكيد. لا تتردد في الاتصال بي عند الحاجة."},{"who":"La nouvelle","fr":"C'est gentil, monsieur. À tout de suite !","ar":"لك اللطف سيدي. أراك حالاً!"}]}],"exercises":[{"t":"mcq","skill":"speaking","q":"الطلب المهذّب الصحيح:","opts":["Je voudrais prendre rendez-vous","Je prends rendez-vous","Donne-moi un rendez-vous","Je veux un rendez-vous"],"a":0,"why":"conditionnel للطلب الرسمي."},{"t":"fill","skill":"writing","q":"أكمل: «___ vous m'expliquer ?» (هل يمكنك)","fr":"___ vous m'expliquer ?","ans":"Pourriez","alts":["pourriez"],"why":"Pourriez-vous استفهام مهذّب."},{"t":"mcq","skill":"reading","q":"«N'hésitez pas à me contacter» تعني:","opts":["لا تترددوا في الاتصال بي","اتصل بي الآن","لا تكلّم معي","اتصل غداً فقط"],"a":0,"why":"خاتمة رسمية تدعو للاستمرار."},{"t":"order","skill":"writing","q":"رتّب جملة اللقاء الرسمية","words":["Je","suis","ravi","de","faire","votre","connaissance."],"ans":"Je suis ravi de faire votre connaissance.","why":"رavi + de + مصدر."},{"t":"listen","skill":"listening","q":"عبارة الافتتاح الرسمي:","opts":["Permettez-moi de me présenter","Je me présente toi","Présente-toi","Moi c'est moi"],"a":0,"why":"القالب القياسي للاستئذان في التعارف."},{"t":"translate","skill":"writing","q":"ترجم: «هل يمكنك أن تعطيني إيصالاً من فضلك؟»","ans":"Pourriez-vous me donner un reçu, s'il vous plaît ?","alts":["pourriez-vous me donner un recu s il vous plait"],"why":"Pourriez-vous + مصدر + s'il vous plaît."},{"t":"correct","skill":"writing","q":"صحّح: «Je veux un café, madame.» (في مكتب)","ans":"Je voudrais un café","alts":["je voudrais un cafe"],"why":"voudrais تخفّف الرغبة إلى طلب مهذّب."},{"t":"speaking","skill":"speaking","q":"اكتب حواراً رسمياً من 6 جمل: تحية، تعارف، طلب، خاتمة.","target":"Bonjour... Je suis ravi... Je voudrais... N'hésitez pas...","why":"إنتاج موكب اللقاء كاملًا."}],"homework":"أعد الحلقة من 71:35 ثلاث مرات، ثم كنّس لقاءً رسمياً بالفرنسية (4 جمل) مع «ravi de» و«je voudrais» ونبرة هادئة.\nالحلقة السابقة/التالية: a2-t7-l8 ← a2-t7-l9 → a2-t7-l10","sources":[{"title":"Reflets 1 - épisode #9 - Ravi de faire votre connaissance","channel":"Jason Mills","videoId":"o-6MkVG_qmI","why":"الحلقة الكاملة — النص الأصلي للمشوار: طبّق ما تعلمه في دروس القواعد والمفردات.","cat":"Séries","level":"A2","main":true,"t":0},{"title":"Les formules de politesse en français. Niveau A1-FLE. English subtitles available 😉French greetings","channel":"La prof Elisabeth","videoId":"TQzcgWMbNAU","why":"شرح كامل للفروق بين les salutations وles formules de politesse — يدعم اللقاء الرسمي والصيغ المهذّبة في الحلقة.","cat":"Vocabulaire","level":"A2","extra":true}],"supplements":[{"id":"TQzcgWMbNAU","title":"Les formules de politesse en français. Niveau A1-FLE. English subtitles available 😉French greetings","channel":"La prof Elisabeth","why":"شرح كامل للفروق بين les salutations وles formules de politesse — يدعم اللقاء الرسمي والصيغ المهذّبة في الحلقة.","dur":5,"lang":"fr"}]},{"id":"a2-t7-l10","fr":"Épisode 10 — Au parc floral","ar":"الحلقة 10 — في الحديقة الزهرية","objectives":["الحديث عن الطقس والفصول مع «il fait / il y a» في مواقف يومية","متابعة الحلقة من توقيتها 82:13 مع التقاط مفردات الهواء الطلق","وصف نشاط خارجي كامل (المكان، الطقس، ما يفعله كل شخص)"],"sections":[{"h":"الحلقة 10: نزهة في الحديقة (82:13 — 93:46)","video":{"id":"D7EhjZrSq2Y","title":"Reflets 1 - épisode #10 - Au parc floral","channel":"Jason Mills","why":"الحلقة الكاملة — النص الأصلي للمشوار: طبّق ما تعلمه في دروس القواعد والمفردات.","lang":"fr","main":true,"t":0,"dur":6},"p":["الحديقة تفتح موضوع الطقس، وهو المدخل الأسهل للحديث الطويل: «Il fait beau» تكفي لبدء محادثة كاملة مع أي فرنسي، لأن الطقس عنوان فقرات الصباح.","قوالب الطقس ثابتة لا تتغيّر: «Il fait + صفة» للحرارة والجو، و«Il y a + noun» للاعتدال والرياح: «Il fait doux», «Il y a du vent». تعلّمها كقوالب لا كقواعد.","الحديقة تضيء أفعال الهواء الطلق: se promener, faire une promenade, pique-niquer, courir — الفعلان الأشهر (se promener / faire la promenade) يتداخلان في الاستعمال، واحتفظ بالاثنين.","الاستماع والتكرار: أصوات الطبيعة تحيط بالحوار، فتقاطع الجمل أوسع — هذا تدريب ممتاز على الاستماع الجزئي: التقط الكلمة الدليلة («soleil», «vent», «arbre») ثم أعد بناء الجملة.","ملاحظة أسلوبية: الوصف في الفرنسية يميل إلى ترتيب المكان أولاً («Dans le parc, il y a...») ثم الحدث — تعلّم أن تبدأ بالمشهد ثم تحرك فيه.","بعد الحلقة: صف مكاناً خارجياً تحبه في 5 جمل: الموقع، الطقس، ما يفعله الناس، ما تحبه فيه، ومتى تعود. قراءتها بصوت عالٍ أمام المرآة تكمل الحلقة."],"sub":[{"h":"قوالب الطقس","p":["Il fait beau.","Il fait froid et vent.","Il y a des nuages.","Le ciel est bleu."]},{"h":"أنشطة الحديقة","p":["On se promène.","Ils font un pique-nique.","Les enfants courent.","Elle lit sur le banc."]},{"h":"أدوات الاستماع","p":["parc ← [paʁk] لا «بارك» بوضوح.","soleil ← [sɔ.lɛj].","pique-nique ← النبرة الأولى.","doux ← [du] مدموج."]}]},{"h":"عبارات الطقس والنزهة","p":["«Quel temps fait-il chez vous؟» سؤال الطقس القياسي، وجوابه بـ «il fait» مباشرة: «Il fait vingt degrés», «Il fait gris». لا تقل «Le temps est...» إلا نادراً.","«Il y a du soleil tout l'été» بنية للاعتدال والمعالم الجوية — تنتبه لجزئية du مع المذكر الغير معرّف: du soleil, du vent, de la pluie.","«C'est le moment idéal pour...» جملة تربط الطقس بالفعل: الفرنسية تربط بين الظرف والنشاط في جملة واحدة، وهذه هي حركة الوصف الحيّ."]},{"h":"تمرين الحلقة","p":["تمرين الطقس: تصف طقس يومك الحالي في 3 جمل بقوالب «il fait / il y a / le ciel»، ثم تصف اليوم المثالي في جملتين.","امشِ في مكان حقيقي واستمع للحلقة مرة أخرى — ربط الكلمة بالصورة الحية يثبّت مفردات الطقس أسرع من أي بطاقة.","ما تحفظه: قوالب الطقس الثلاث + «se promener» + «C'est le moment idéal pour...». بها تفتح أي حديث عن عطلة أو نزهة."]},{"h":"التطبيق والتلخيص","p":["الحلقة 10: نزهة في الحديقة الزهرية — الطقس والوقت والمشي مع «il fait beau»، كما في الفيديو الرئيسي «Reflets 1 - épisode #10 - Au parc floral»: شغّل من بدايته وصف الطقس مع المتحدثين عند كل توقف، ثم ارجع إلى دروس القواعد والمفردات.","جسر الحلقات: من a2-t7-l9 (اللقاء الرسمي) إلى a2-t7-l10 (الحديقة والطقس)، ثم إلى a2-t7-l11 حيث تدخل المحادثة إلى المتجر وتدريب البيع.","المهمة: شاهد الحلقة كاملة، ثم افتح ورقة المفردات وراجع كلمات الطبيعة (le parc, l'ombre, la fleur, le banc)، وأخيراً سجّل تلخيصاً شفهياً مدته 30 ثانية تصف فيه نزهة في يوم مشمس."]}],"examples":[{"fr":"Il fait beau, on se promène au parc.","ar":"الجو جميل، نتنزه في الحديقة.","note":"طقس + نشاط"},{"fr":"Il y a du vent, elle met un manteau.","ar":"هناك ريح، تلبس معطفاً.","note":"il y a للطقس"},{"fr":"Le ciel est bleu et le soleil brille.","ar":"السماء زرقاء والشمس تسطع.","note":"وصف السماء"},{"fr":"Ils font un pique-nique sous les arbres.","ar":"يقيمون نزهة تحت الأشجار.","note":"pique-nique"},{"fr":"En hiver, il fait très froid ici.","ar":"في الشتاء، الجو بارد جداً هنا.","note":"الفصول"},{"fr":"C'est le moment idéal pour courir.","ar":"إنه الوقت المثالي للجري.","note":"ربط الطقس بالنشاط"}],"pron":[{"w":"pique-nique","ipa":"[pik.nik]","approx":"بيك نيك"},{"w":"le banc","ipa":"[bɑ̃]","approx":"بان"},{"w":"promenade","ipa":"[pʁɔ.mə.nad]","approx":"بروميناد"}],"vocab":[{"fr":"le parc","ar":"الحديقة العامة","pos":"nom","g":"m","exFr":"Le parc est ouvert.","ipa":"[paʁk]","exAr":"الحديقة مفتوحة."},{"fr":"il fait beau","ar":"الجو جميل","pos":"expression","exFr":"Il fait beau aujourd'hui.","ipa":"[il fɛ bo]","exAr":"الجو جميل اليوم."},{"fr":"le soleil","ar":"الشمس","pos":"nom","g":"m","exFr":"Le soleil se lève.","ipa":"[sɔ.lɛj]","exAr":"تشرق الشمس."},{"fr":"l'ombre","ar":"الظل","pos":"nom","g":"f","exFr":"On s'assoit à l'ombre.","ipa":"[ɔ̃bʁ]","exAr":"نجلس في الظل."},{"fr":"la fleur","ar":"الزهرة","pos":"nom","g":"f","exFr":"Les fleurs sont ouvertes.","ipa":"[flœʁ]","exAr":"الزهور متفتحة."},{"fr":"le vent","ar":"الريح","pos":"nom","g":"m","exFr":"Il y a du vent.","ipa":"[vɑ̃]","exAr":"هناك ريح."},{"fr":"le sentier","ar":"الممرّ/الدرب في الطبيعة","pos":"nom","g":"m","exFr":"Le sentier longe la rivière.","ipa":"[lə sɑ̃.tje]","exAr":"يمتدّ الممرّ بمحاذاة النهر."},{"fr":"le pique-nique","ar":"النزهة (المطعمة)","pos":"nom","g":"m","exFr":"Faire un pique-nique.","ipa":"[pik.nik]","exAr":"إقامة نزهة."},{"fr":"le banc","ar":"مقعد الحديقة","pos":"nom","g":"m","exFr":"Assis sur le banc.","ipa":"[bɑ̃]","exAr":"جالس على المقعد."},{"fr":"l'été / l'hiver","ar":"الصيف/الشتاء","pos":"nom","exFr":"En été, il fait chaud.","ipa":"[e.te]","exAr":"في الصيف، الجو حار."},{"fr":"couper","ar":"يقطع/يجري (الأطفال)","pos":"verbe","g":"1er","exFr":"Les enfants courent.","ipa":"[ku.pe]","exAr":"الأطفال يركضون."},{"fr":"briller","ar":"يلمع/يسطع","pos":"verbe","g":"1er","exFr":"Le soleil brille.","ipa":"[bʁi.je]","exAr":"الشمس تسطع."}],"grammar":[{"tFr":"La météo : il fait / il y a","tAr":"القاعدة: قوالب الطقس","body":["«Il fait + صفة» للحرارة والجو العام: il fait chaud/froid/beau/mauvais/froid — و«Il y a + noun» للمعطيات: il y a du soleil, du vent, de la pluie, des nuages. لا تخلط بين الصفة والاسم هنا.","الفصول تأتي بـ «en»: en été, en hiver (بدون أداة)، و«au printemps», «à l'automne» للتوافق. أربع كلمات تكفيك لربط الطقس بالزمن."],"ex":[{"fr":"Il fait doux au printemps.","ar":"الجو لطيف في الربيع."},{"fr":"Il y a de la brume le matin.","ar":"يوجد ضباب في الصباح."}]}],"mistakes":[{"wrong":"«Le temps est chaud»","right":"«Il fait chaud»","why":"القالب القياسي للطقس يبدأ بـ il fait."},{"wrong":"«Il a du vent»","right":"«Il y a du vent»","why":"الطقس مع وجود لا مع تملك."},{"wrong":"«En le été»","right":"«En été»","why":"الفصول بلا أداة مع en."},{"wrong":"صفة معقولة في الطقس: «Il fait du soleil»","right":"«Il y a du soleil»","why":"الاسم ينتمي إلى il y a لا il fait."}],"dialogues":[{"title":"نزهة عائلية","ctx":"أب وأبنته في الحديقة","lines":[{"who":"Le père","fr":"Quel temps aujourd'hui ! Il fait doux, on se promène ?","ar":"يا للطقس اليوم! الجو لطيف، نتنزه؟"},{"who":"Julie","fr":"Avec plaisir. Il y a du soleil, c'est parfait.","ar":"بكل سرور. الشمس مشرقة، إنه مثالي."},{"who":"Le père","fr":"Les enfants font un pique-nique près des fleurs.","ar":"الأطفال يقيمون نزهة قرب الزهور."},{"who":"Julie","fr":"Regarde, il y a un banc à l'ombre. On s'assoit ?","ar":"انظر، يوجد مقعد في الظل. نجلس؟"},{"who":"Le père","fr":"Bonne idée. Il fait un peu de vent, donne-moi ton écharpe.","ar":"فكرة جيدة. هناك ريح خفيفة، أعطني وشاحك."},{"who":"Julie","fr":"Tiens. C'est le moment idéal pour lire.","ar":"خُذ. إنه الوقت المثالي للقراءة."}]}],"exercises":[{"t":"mcq","skill":"grammar","q":"القالب الصحيح للطقس:","opts":["Il fait beau","Il a beau","Le temps beau","Être beau"],"a":0,"why":"il fait + صفة للجو."},{"t":"fill","skill":"writing","q":"أكمل: «Il ___ du soleil tout l'été.»","fr":"Il ___ du soleil tout l'été.","ans":"y a","alts":["a"],"why":"il y a للمعطيات الجوية."},{"t":"mcq","skill":"reading","q":"«Ils font un pique-nique» تعني:","opts":["يقيمون نزهة","يصنعون كعكة","يقطعون الطريق","يلعبون كرة"],"a":0,"why":"faire un pique-nique = نزهة."},{"t":"order","skill":"writing","q":"رتّب وصف الطقس","words":["Il","fait","beau,","il","y","a","du","soleil."],"ans":"Il fait beau, il y a du soleil.","why":"il fait للصفة + il y a للاسم."},{"t":"listen","skill":"listening","q":"عبارة الربيع في المقطع:","opts":["Il fait doux","Il fait dur","Il y a douceur personne","Il fait deux"],"a":0,"why":"doux لوصف اعتدال الجو."},{"t":"translate","skill":"writing","q":"ترجم: «في الشتاء يوجد ثلج ورياح قوية.»","ans":"En hiver, il y a de la neige et beaucoup de vent.","alts":["en hiver il y a de la neige et beaucoup de vent"],"why":"en hiver + il y a + جزئية."},{"t":"correct","skill":"writing","q":"صحّح: «Il a froid aujourd'hui.» (وصف الطقس)","ans":"Il fait froid","alts":["il fait froid"],"why":"الجو البارد يبدأ بـ il fait."},{"t":"writing","skill":"writing","q":"صف طقس يومك في 4 جمل (il fait / il y a / النشاط).","target":"Il fait... Il y a... On...","why":"إنتاج موجّه لقوالب الطقس."}],"homework":"أعد الحلقة من 82:13 ثلاث مرات، ثم صف طقس فصلك المفضل في 4 جمل مع نشاط تمارسه فيه.\nالحلقة السابقة/التالية: a2-t7-l9 ← a2-t7-l10 → a2-t7-l11","sources":[{"title":"Reflets 1 - épisode #10 - Au parc floral","channel":"Jason Mills","videoId":"D7EhjZrSq2Y","why":"الحلقة الكاملة — النص الأصلي للمشوار: طبّق ما تعلمه في دروس القواعد والمفردات.","cat":"Séries","level":"A2","main":true,"t":0},{"title":"Compréhension Orale A2 : Les souvenirs - l'imparfait - Les vacances d'été","channel":"Fle Factory","videoId":"X32VkDMny3E","why":"تمرين فهم سمّاعي على صيغة الماضي البسيط مع رواية الذكريات — يقود مباشرة إلى سرد النزهة كما في الحلقة.","cat":"Grammar","level":"A2","extra":true}],"supplements":[{"id":"X32VkDMny3E","title":"Compréhension Orale A2 : Les souvenirs - l'imparfait - Les vacances d'été","channel":"Fle Factory","why":"تمرين فهم سمّاعي على صيغة الماضي البسيط مع رواية الذكريات — يقود مباشرة إلى سرد النزهة كما في الحلقة.","dur":3,"lang":"fr"}]},{"id":"a2-t7-l11","fr":"Épisode 11 — Le stage de vente","ar":"الحلقة 11 — تدريب البيع","objectives":["التحدث عن العمل والمهام باستخدام ضمائر COD (le, la, les, l')","متابعة الحلقة من توقيتها 93:46 مع التقاط مفردات البيع","نقل الضمير بثقة: «Je le vends», «Je la conseille» دون تردد"],"sections":[{"h":"الحلقة 11: تدريب في المحل (93:46 — 1:43:40)","video":{"id":"QuSpnXoCJcU","title":"Reflets 1 - épisode #11 - Le stage de vente","channel":"Jason Mills","why":"الحلقة الكاملة — النص الأصلي للمشوار: طبّق ما تعلمه في دروس القواعد والمفردات.","lang":"fr","main":true,"t":0,"dur":8},"p":["البيع مهارة إيقاع: جمل قصيرة، سؤال وجواب، ثم إغلاق. في هذه الحلقة تتكرر الضمائر كثيراً («Je la prends», «Vous l'avez ?») لأن المتجر كله يدور حول الأشياء المؤنثة والمذكرية.","ضمائر COD هي قفزة الطلاقة: بدل «Je prends la chemise» المتكررة، يقول الفرنسي «Je la prends» — الاختصار ليس ترف بل جوهر الكلام الطبيعي، ومن أتقنه سمع نفسه يتحدث فرنسية لا يترجمها.","مفردات البيع حية: le client, le rayon, l'essayage, la taille, l'addition — كلها من الطابق الأول العملي، وتستعمل في كل متجر دون تغيير.","الاستماع والتكرار: الجمل هنا أقصر مما تتوقع، والإيقاع أسرع — استمع إلى الإغلاق («Je vous l'apporte ?») وكرّره؛ الفعل المركّب مع الضمير (l' + أتكملة) هو أصعب ما يُنطق سريعاً.","لاحظ التوكنز المهنية: «stage» تدريب، «collègue» زميل، «responsable» المسؤول — كلمات ثلاثة تفتح لك وصف وظيفة كامل.","بعد الحلقة: اكتب وصفاً قصيراً لتدريب سابق (ماذا فعلت، ماذا كنت تبيع، مع من) في 5 جمل مع ضمائر le/la/les ثلاث مرات على الأقل."],"sub":[{"h":"ضمائر COD في المتجر","p":["Je la prends.","Vous l'avez en bleu ?","Je le mets sur le comptoir.","Je vous les apporte."]},{"h":"مفردات البيع","p":["le client — الزبون.","le rayon — القسم.","l'essayage — القياس.","la taille — المقاس."]},{"h":"أدوات الاستماع","p":["l'essayage ← [e.sɛ.zaʒ].","comptoir ← النبرة الثانية.","stage ← [staʒ].","hmm أصوات التفكير المعتمدة."]}]},{"h":"عبارات المتجر والتوصية","p":["«Je vous conseille cette référence» — «conseiller» + personne + chose تأتي مرتين في الجملة: الضمير أولاً ثم الشيء. ترتيب ثابت تجده في كل توصية.","«Je vous l'apporte ?» سؤال الإغلاق المهذّب: الفعل apporter مع ل + vous متتاليان — «Je vous la l'apporte» للمؤنث. هذا التمرين وحده يختصر ساعات من حفظ الضمائر.","«C'est trop cher / c'est parfait» ردود الزبون، و«On peut essayer» عرض القياس — أربع جمل تختصر مشوار تسوّق كامل."]},{"h":"تمرين الحلقة","p":["تمرين التمثيل: صف منتج تقترحه على صديق في 4 جمل — الوصف، السعر، الميزة، ثم «Je vous le/la conseille».","اكتب رسالة بريدية قصيرة تطلب فيها استبدالاً (produit + problème + طلب) في 4 جمل — تطبيق عملي للضمائر في الكتابة.","ما تحفظه: «Je la prends / Je vous l'apporte / Je vous le conseille» — الثلاثة تجعلك تتحدث عن أي شيء دون إعادة الاسم."]},{"h":"التطبيق والتلخيص","p":["الحلقة 11: تدريب في محل بيع — عرض المنتج والسؤال والشراء مع ضمائر le/la/les، كما في الفيديو الرئيسي «Reflets 1 - épisode #11 - Le stage de vente»: شغّل من بدايته وردّد جمل البائع بصوت واضح قبل الرجوع إلى دروس القواعد والمفردات.","جسر الحلقات: من a2-t7-l10 (نزهة الحديقة) إلى a2-t7-l11 (تدريب البيع في المحل)، ثم إلى a2-t7-l12 حيث تُوظَّف المفردات في مقارنة منتجين وإثبات الجدارة.","المهمة: شاهد الحلقة كاملة، ثم افتح ورقة المفردات وراجع كلمات المتجر (vendre, le rayon, l'essayage, conseiller)، وأخيراً سجّل تلخيصاً شفهياً مدته 30 ثانية تقدّم فيه منتجاً لزبون."]}],"examples":[{"fr":"Je la prends, elle est parfaite.","ar":"آخذها، إنها مثالية.","note":"COD مؤنث"},{"fr":"Vous l'avez en taille moyenne ?","ar":"هل لديكم منها بالمقاس المتوسط؟","note":"ضمير مُعرَّف"},{"fr":"Je vous conseille ce modèle.","ar":"أنصحك بهذا الطراز.","note":"توصية"},{"fr":"Je vous l'apporte tout de suite.","ar":"أحضرها لك حالاً.","note":"l' + apporter"},{"fr":"Le stage commence lundi prochain.","ar":"يبدأ التدريب الاثنين القادم.","note":"مفردة العمل"},{"fr":"Nous vendons aussi en ligne.","ar":"نبيع أيضاً عبر الإنترنت.","note":"العمل"}],"pron":[{"w":"l'essayage","ipa":"[e.sɛ.zaʒ]","approx":"إيسّياج"},{"w":"comptoir","ipa":"[kɔ̃.twaʁ]","approx":"كونتوار"},{"w":"conseille","ipa":"[kɔ̃.sɛj]","approx":"كونسيي"}],"vocab":[{"fr":"le stage","ar":"التدريب","pos":"nom","g":"m","exFr":"J'ai un stage de vente.","ipa":"[staʒ]","exAr":"لدي تدريب بيع."},{"fr":"vendre","ar":"يبيع","pos":"verbe","g":"3e","exFr":"Ils vendent des vêtements.","ipa":"[vɑ̃dʁ]","exAr":"يبيعون ملابس."},{"fr":"le client / la cliente","ar":"الزبون/ة","pos":"nom","exFr":"Le client attend.","ipa":"[klijɑ̃]","exAr":"الزبون ينتظر."},{"fr":"le rayon","ar":"قسم المتجر","pos":"nom","g":"m","exFr":"Le rayon est en bas.","ipa":"[ʁɛ.jɔ̃]","exAr":"القسم في الأسفل."},{"fr":"l'essayage","ar":"القياس (الملابس)","pos":"nom","g":"m","exFr":"La cabine d'essayage est libre.","ipa":"[e.sɛ.zaʒ]","exAr":"غرفة القياس شاغرة."},{"fr":"conseiller","ar":"ينصح","pos":"verbe","g":"1er","exFr":"Je vous conseille ce modèle.","ipa":"[kɔ̃sɛje]","exAr":"أنصحك بهذا الطراز."},{"fr":"l'addition","ar":"الفاتورة","pos":"nom","g":"f","exFr":"L'addition, s'il vous plaît.","ipa":"[a.di.sjɔ̃]","exAr":"الفاتورة من فضلك."},{"fr":"la promotion","ar":"التخفيض","pos":"nom","g":"f","exFr":"C'est en promotion.","ipa":"[pʁɔ.mɔ.sjɔ̃]","exAr":"إنه في تخفيض."},{"fr":"essayer","ar":"يجرّب","pos":"verbe","g":"1er","exFr":"Je peux l'essayer ?","ipa":"[e.se.je]","exAr":"هل يمكنني تجربته؟"},{"fr":"la référence","ar":"الطراز/المرجع","pos":"nom","g":"f","exFr":"Cette référence est nouvelle.","ipa":"[ʁe.fə.ʁɑ̃s]","exAr":"هذا الطراز جديد."},{"fr":"apporter","ar":"يحضر/يجلب","pos":"verbe","g":"1er","exFr":"Je vous l'apporte.","ipa":"[a.pɔʁ.te]","exAr":"أحضره لك."},{"fr":"la clientèle","ar":"الزبائن (فئة العملاء)","pos":"nom","g":"f","exFr":"La clientèle du magasin est fidèle.","ipa":"/la klijɛl/","exAr":"زبائن المتجر وفيون."}],"grammar":[{"tFr":"Les pronoms COD : le, la, les, l'","tAr":"القاعدة: ضمائر المفعول به","body":["الضمير يأتي قبل الفعل: «Je la prends» — ولا يتغيّر مع le/la إلا نطق الهمزة: l' devant vowel («Je l'achète»). الجمع «les» يبقى كما هو: «Je les vends».","في الأسئلة يبقى الضمير متصلاً: «Vous l'avez ?» / «Tu l'as ?» — وحذفه يُجبر إعادة الاسم («Vous avez la chemise ?») وهذا بالضبط ما نريد تجاوزه."],"ex":[{"fr":"Je la regarde, elle est jolie.","ar":"أنظر إليها، إنها جميلة."},{"fr":"Les clés ? Je les ai sur moi.","ar":"المفاتيح؟ لديّ معي."}]}],"mistakes":[{"wrong":"«Je prends le» ثم إعادة الاسم في كل جملة","right":"«Je le prends» بالضمير","why":"الحوار الطبيعي يختصر بالضمائر."},{"wrong":"«Je la l'achète»","right":"«Je l'achète» ضمير واحد فقط","why":"لا ضميرين لشيء واحد."},{"wrong":"الضمير بعد الفعل مع le/la","right":"قبل الفعل: «Il la voit»","why":"ترتيب الضمير والفعل ثابت في المضارع."},{"wrong":"«Vous avez le en bleu ?»","right":"«Vous l'avez en bleu ?»","why":"الضمير بديل عن الاسم لا مضاف إليه."}],"dialogues":[{"title":"في قسم الملابس","ctx":"متدرّبة وزبون","lines":[{"who":"La vendeuse","fr":"Bonjour ! Vous cherchez quelque chose ?","ar":"مرحباً! هل تبحثين عن شيء؟"},{"who":"La cliente","fr":"Oui, une chemise blanche. Vous l'avez ?","ar":"نعم، قميصاً أبيض. هل لديكم منها؟"},{"who":"La vendeuse","fr":"Oui, je vous la conseille : elle est en coton.","ar":"نعم، أنصحك بها: إنها من القطن."},{"who":"La cliente","fr":"Je peux l'essayer ?","ar":"هل يمكنني قياسها؟"},{"who":"La vendeuse","fr":"Bien sûr, la cabine est libre. Je vous l'apporte ?","ar":"بالتأكيد، غرفة القياس شاغرة. أحضرها لك؟"},{"who":"La cliente","fr":"Parfait, je la prends.","ar":"ممتاز، آخذها."}]}],"exercises":[{"t":"mcq","skill":"grammar","q":"الضمير الصحيح لـ «Je vois la voiture» مع تقصير:","opts":["Je la vois","Je le vois","Je les vois","Je voit la"],"a":0,"why":"voiture مؤنث → la."},{"t":"fill","skill":"writing","q":"أكمل: «Je ___ prends, elle est jolie.»","fr":"Je ___ prends, elle est jolie.","ans":"la","alts":["La"],"why":"الاسم المؤنث المفرد → la."},{"t":"mcq","skill":"reading","q":"«Je vous l'apporte ?» تعني:","opts":["أحضرها لك؟","أحضرها له؟","آخذهما؟","أبيعها؟"],"a":0,"why":"apporter + l' (شيء) + vous (شخص)."},{"t":"order","skill":"writing","q":"رتّب جملة بضمير COD","words":["Nous","la","vendons","en","ligne."],"ans":"Nous la vendons en ligne.","why":"الضمير قبل الفعل."},{"t":"listen","skill":"listening","q":"سؤال الزبون عن التوفر في المقطع:","opts":["Vous l'avez en bleu ?","Vous avez il en bleu ?","L'avez-vous que bleu ?","Avoir bleu vous ?"],"a":0,"why":"ضمير + avoir في السؤال."},{"t":"translate","skill":"writing","q":"ترجم: «أنصحك بهذا المنتج، ستأخذه؟»","ans":"Je te conseille ce produit, tu le prends ?","alts":["je te conseille ce produit tu le prends"],"why":"conseiller + ضمير + سؤال بضمير."},{"t":"correct","skill":"writing","q":"صحّح: «Je prends le la chemise» (اختصر بالضمير)","ans":"Je la prends","alts":["je la prends"],"why":"ضمير واحد يغني عن الاسم."},{"t":"speaking","skill":"speaking","q":"اكتب وصفاً لتدريب بيع في 4 جمل مستعملاً le/la/les ثلاث مرات.","target":"Je le/la/les...","why":"إنتاج موجّه لضمائر COD."}],"homework":"أعد الحلقة من 93:46 ثلاث مرات، ثم اكتب حواراً قصيراً في المتجر (4 جمل) كله بضمائر COD دون تكرار اسم المنتج.\nالحلقة السابقة/التالية: a2-t7-l10 ← a2-t7-l11 → a2-t7-l12","sources":[{"title":"Reflets 1 - épisode #11 - Le stage de vente","channel":"Jason Mills","videoId":"QuSpnXoCJcU","why":"الحلقة الكاملة — النص الأصلي للمشوار: طبّق ما تعلمه في دروس القواعد والمفردات.","cat":"Séries","level":"A2","main":true,"t":0},{"title":"Technique de vente - Les 10 qualités pour devenir un excellent commercial et réussir dans la vente","channel":"Jean-Pierre Giraud","videoId":"zP63gwGERxw","why":"عشر قواعد لتقديم المنتج ومعالجة اعتراض الزبون — توسعة عملية لتدريب البيع في الحلقة.","cat":"Conversation","level":"A2","extra":true}],"supplements":[{"id":"zP63gwGERxw","title":"Technique de vente - Les 10 qualités pour devenir un excellent commercial et réussir dans la vente","channel":"Jean-Pierre Giraud","why":"عشر قواعد لتقديم المنتج ومعالجة اعتراض الزبون — توسعة عملية لتدريب البيع في الحلقة.","dur":9,"lang":"fr"}]},{"id":"a2-t7-l12","fr":"Épisode 12 — Julie fait ses preuves","ar":"الحلقة 12 — جولي تثبت جدارتها","objectives":["المقارنة بين شيئين باستخدام plus... que / aussi... que / moins... que","متابعة الحلقة من توقيتها 1:43:40 مع إدراك صيغ التمييز","صفة أقصى (le plus... parmi / de) في جمل مهنية قصيرة"],"sections":[{"h":"الحلقة 12: جولي في مهمة جديدة (1:43:40 — 1:53:07)","video":{"id":"GrJWOzcTqQ8","title":"Reflets 1 - épisode #12 - Julie fait ses preuves","channel":"Jason Mills","why":"الحلقة الكاملة — النص الأصلي للمشوار: طبّق ما تعلمه في دروس القواعد والمفردات.","lang":"fr","main":true,"t":0,"dur":7},"p":["المقارنة هي امتداد الوصف الطبيعي: بعد أن تصف شيئاً، يطلب منك أن تفضّل بين اثنين. «Ce modèle est plus robuste que l'autre» جملة واحدة تحمل رأياً كاملاً.","ثلاثية المقارنة قصيرة: plus... que (أكثر)، aussi... que (بالمستوى)، moins... que (أقل). تُبنى من الصفة نفسها لا من تغييرها — وهذا سهولة الفرنسية هنا.","الأعلى (le plus) يأتي مع تعبير مجموعة: «Le plus efficace de l'équipe» أو «parmi les collègues» — انتبه لـ de/parmi فهي تحدد المجموعة دائماً.","«faire ses preuves» تعبير جاهز يعني «يثبت جدارته» — التعبيرات المعدّة (être à la hauteur, faire ses preuves) هي ما يعطي جملتك عمقاً لا تكراراً.","الاستماع والتكرار: مونولوج جولي مليء بجمل مقارنة متتابعة — استمع إلى نبرة التأكيد في «plus... que» (النبرة على plus) ثم كرّرها؛ نبرة التمييز جزء من المعنى.","بعد الحلقة: قارن بين شيئين تحملهما الآن (هاتفان، طريقان، وصفتان) في 4 جمل: اثنتان بالمقارنة واثنتان بالأعلى. هذا تمرين المقارنة الكامل."],"sub":[{"h":"المقارنة في التقييم","p":["Ce modèle est plus fiable.","L'un est aussi rapide que l'autre.","Ce délai est moins long.","C'est le plus efficace du lot."]},{"h":"تعبيرات الجدارة","p":["Elle fait ses preuves.","Elle est à la hauteur.","Elle assure sous pression.","Bravo pour ta réussite !"]},{"h":"أدوات الاستماع","p":["plus ← [ply] لا «بلوس» بوضوح.","efficace ← النبرة الأخيرة.","preuves ← [pøv].","parmi ← النبرة الثانية."]}]},{"h":"عبارات التمييز والمدح","p":["«C'est le plus sérieux parmi eux» — التعبير الأعلى يُغلق الجدل حين لا يكفي الوصف: من يملك «le plus» يملك الكلمة الأخيرة بلباقة.","«Vous êtes à la hauteur» عبارة مهنية عميقة: «أنت على مستوى المهمة». تُستعمل للمشروع والشخص معاً، ووزنها أقوى من «bravo» وحده.","«Elle a réussi à...» تقييم إنجاز + فعل (réussir à + اسم/مصدر): القالب الأدق لتقرير نجاح حقيقي لا مجرد مديح عابر."]},{"h":"تمرين الحلقة","p":["تمرين: قارن بين طريقتين للذهاب إلى عملك (أسرع، أغلى، أريح) في 4 جمل مقارنة.","اطلب من شخصك أن يصف شيئاً ثم أضف أنت جملة المقارنة — تحويل وصف إلى تفضيل هو الحد الفاصل بين A1 وA2.","ما تحفظه: الثلاثية (plus/aussi/moins... que) + «le plus... de/parmi» + «à la hauteur». بها تُجري أي تقييم مهني."]},{"h":"التطبيق والتلخيص","p":["الحلقة 12: جولي تثبت جدارتها — المقارنة والتوصية مع «plus... que» و«le plus»، كما في الفيديو الرئيسي «Reflets 1 - épisode #12 - Julie fait ses preuves»: شغّل من بدايته وقارن أنت أيضاً بين منتجين بنبرة الممثلين، ثم ارجع إلى دروس القواعد والمفردات.","جسر الحلقات: من a2-t7-l11 (تدريب البيع) إلى a2-t7-l12 (المقارنة وإثبات الجدارة)، ثم إلى a2-t7-l13 حيث تنتقل المحادثة إلى جودة الخدمة وشعار «الزبون ملك».","المهمة: شاهد الحلقة كاملة، ثم افتح ورقة المفردات وراجع كلمات التمييز (comparer, efficace, la preuve, la mission)، وأخيراً سجّل تلخيصاً شفهياً مدته 30 ثانية تقارن فيه بين منتجين."]}],"examples":[{"fr":"Ce modèle est plus fiable que l'autre.","ar":"هذا الطراز أكثر موثوقية من الآخر.","note":"plus... que"},{"fr":"Les deux sont aussi rapides.","ar":"كلاهما بنفس السرعة.","note":"aussi... que"},{"fr":"Ce délai est moins long que prévu.","ar":"هذه المدة أقصر مما هو متوقع.","note":"moins... que"},{"fr":"C'est le plus efficace de l'équipe.","ar":"إنه الأكثر فعالية في الفريق.","note":"الأعلى"},{"fr":"Julie fait ses preuves chaque jour.","ar":"جولي تثبت جدارتها كل يوم.","note":"تعبير جاهز"},{"fr":"Elle est à la hauteur de la mission.","ar":"إنها على مستوى المهمة.","note":"تعبير مهني"}],"pron":[{"w":"plus","ipa":"[ply]","approx":"بلي"},{"w":"efficace","ipa":"[e.fi.kɑ̃s]","approx":"إيفيكانس"},{"w":"parmi","ipa":"[paʁ.mi]","approx":"بارمي"}],"vocab":[{"fr":"comparer","ar":"يقارن","pos":"verbe","g":"1er","exFr":"Je compare les prix.","ipa":"[kɔ̃.pa.ʁe]","exAr":"أقارن الأسعار."},{"fr":"plus... que","ar":"أكثر... من","pos":"locution","exFr":"Il est plus rapide que moi.","ipa":"[ply]","exAr":"أسرع مني."},{"fr":"moins... que","ar":"أقل... من","pos":"locution","exFr":"C'est moins cher.","ipa":"[mwɛ̃]","exAr":"أرخص."},{"fr":"le CV","ar":"السيرة الذاتية","pos":"nom","g":"m","exFr":"J'ai envoyé mon CV ce matin.","ipa":"[lə se.ve]","exAr":"أرسلت سيرتي الذاتية هذا الصباح."},{"fr":"efficace","ar":"فعال","pos":"adj","exFr":"Une solution efficace.","ipa":"[e.fi.kɑ̃s]","exAr":"حل فعّال."},{"fr":"la preuve","ar":"الدليل/الإثبات","pos":"nom","g":"f","exFr":"Il a fait ses preuves.","ipa":"[pøv]","exAr":"أثبت جدارته."},{"fr":"à la hauteur","ar":"على مستوى المهمة","pos":"locution","exFr":"Il est à la hauteur.","ipa":"[a la o.tyʁ]","exAr":"إنه على المستوى."},{"fr":"sérieux(se)","ar":"جدّي","pos":"adj","exFr":"C'est très sérieux.","ipa":"[se.ʁjø]","exAr":"إنه جدّي جداً."},{"fr":"réussir à","ar":"ينجح في","pos":"locution","exFr":"Elle a réussi à convaincre.","ipa":"[ʁe.y.siʁ a]","exAr":"نجحت في الإقناع."},{"fr":"la mission","ar":"المهمة","pos":"nom","g":"f","exFr":"La mission est terminée.","ipa":"[mi.sjɔ̃]","exAr":"انتهت المهمة."},{"fr":"le délai","ar":"المهلة","pos":"nom","g":"m","exFr":"Respecter le délai.","ipa":"[de.le]","exAr":"احترام المهلة."},{"fr":"parmi","ar":"من بين","pos":"prép","exFr":"Le meilleur parmi eux.","ipa":"[paʁ.mi]","exAr":"الأفضل من بينهم."}],"grammar":[{"tFr":"Le comparatif et le superlatif","tAr":"القاعدة: المقارنة والأعلى","body":["المقارنة تُبنى على الصفة نفسها: plus/aussi/moins + صفة + que — بلا تغيير في الجذر. و«que» تُدمج مع le → devant vowel: plus cher que, aussi grand que.","الأعلى: le plus/moins + صفة + في المكان de/parmi («le plus rapide de l'class»)، ومع العاقل في الأدب يبقى le même: «la plus motivée du groupe». حذف de يجعل الجملة ناقصة دائماً."],"ex":[{"fr":"C'est le moins coûteux du marché.","ar":"إنه الأقل كلفة في السوق."},{"fr":"Son rapport est aussi clair que le mien.","ar":"تقريره واضح كما تقريري."}]}],"mistakes":[{"wrong":"«plus bon que»","right":"«meilleur que» (استثناء)","why":"bon و mauvais لهما شكل خاص في المقارنة."},{"wrong":"الصفة تتطوّر في المقارنة","right":"الصفة تبقى كما هي مع plus/moins","why":"لا تغيير جذري — القياس بالقالب فقط."},{"wrong":"«le plus rapide de parmi»","right":"«de l'équipe» أو «parmi eux»","why":"لا تكرار أداة التحديد."},{"wrong":"ترجمة «كذلك» بـ «aussi que» بلا صفة","right":"«aussi rapide que» صفة إجبارية","why":"aussi تحتاج صفة بعدها."}],"dialogues":[{"title":"تقييم أداء","ctx":"مديرة وموظفة نهاية التجربة","lines":[{"who":"La directrice","fr":"Julie, vos résultats sont meilleurs que prévu.","ar":"جولي، نتائجك أفضل مما هو متوقع."},{"who":"Julie","fr":"Merci ! J'ai beaucoup travaillé avec l'équipe.","ar":"شكراً! عملت كثيراً مع الفريق."},{"who":"La directrice","fr":"Votre rapport est aussi clair que celui du responsable.","ar":"تقريرك واضح كتقرير المسؤول."},{"who":"Julie","fr":"C'est le plus lisible du service, alors.","ar":"إذن هو الأقرأ في القسم."},{"who":"La directrice","fr":"Vous êtes à la hauteur. Vous faites vos preuves.","ar":"أنتِ على المستوى. تثبتين جدارتك."},{"who":"Julie","fr":"Merci, je suis ravie de continuer.","ar":"شكراً، سعيدة بمواصلة العمل."}]}],"exercises":[{"t":"mcq","skill":"grammar","q":"الصيغة الصحيحة للمقارنة:","opts":["plus rapide que","plus plus rapide","rapidement que","plus rapide que moi plus"],"a":0,"why":"plus + صفة + que."},{"t":"fill","skill":"writing","q":"أكمل: «C'est le modèle ___ efficace.»","fr":"C'est le modèle ___ efficace.","ans":"le plus","alts":["Le plus"],"why":"الأعلى مع le plus."},{"t":"mcq","skill":"reading","q":"«Elle est à la hauteur» تعني:","opts":["إنها على مستوى المهمة","إنها طويلة","إنها في مكان مرتفع","إنها تنتظر"],"a":0,"why":"تعبير الجدارة المهنية."},{"t":"order","skill":"writing","q":"رتّب جملة المقارنة","words":["Ce","travail","est","plus","difficile","que","l'autre."],"ans":"Ce travail est plus difficile que l'autre.","why":"plus ← صفة ← que."},{"t":"listen","skill":"listening","q":"عبارة الأعلى في المقطع:","opts":["C'est le plus efficace","C'est plus efficace","C'est tant efficace","C'est assez efficace"],"a":0,"why":"le plus للأعلى المطلق."},{"t":"translate","skill":"writing","q":"ترجم: «هذا الطريق أسرع من ذلك الطريق.»","ans":"Cette route est plus rapide que cette autre.","alts":["cette route est plus rapide que cette autre"],"why":"plus + صفة + que."},{"t":"correct","skill":"writing","q":"صحّح: «C'est le plus bon du groupe.»","ans":"C'est le meilleur du groupe","alts":["c est le meilleur du groupe"],"why":"bon استثناء في الأعلى."},{"t":"writing","skill":"writing","q":"قارن بين طريقتين للعمل في 4 جمل (plus / aussi / moins + le plus).","target":"... plus ... que... — le plus...","why":"إنتاج المقارنة الموجّه."}],"homework":"أعد الحلقة من 1:43:40 ثلاث مرات، ثم قارن بين منتجَين تحبهما في 4 جمل: ميزة وعيوب مع plus/le plus.\nالحلقة السابقة/التالية: a2-t7-l11 ← a2-t7-l12 → a2-t7-l13","sources":[{"title":"Reflets 1 - épisode #12 - Julie fait ses preuves","channel":"Jason Mills","videoId":"GrJWOzcTqQ8","why":"الحلقة الكاملة — النص الأصلي للمشوار: طبّق ما تعلمه في دروس القواعد والمفردات.","cat":"Séries","level":"A2","main":true,"t":0},{"title":"exercice de compréhension orale en français (A2) : CV et expérience professionnelle (passé composé)","channel":"Français Minutes Học tiếng Pháp với John & Mathias","videoId":"lEEG1AX4uQ8","why":"تمرين فهم سمّاعي A2 على السيرة الذاتية والخبرة المهنية — يدعم حديث الحلقة عن الإثبات والجدارة.","cat":"Listening","level":"A2","extra":true}],"supplements":[{"id":"lEEG1AX4uQ8","title":"exercice de compréhension orale en français (A2) : CV et expérience professionnelle (passé composé)","channel":"Français Minutes Học tiếng Pháp với John & Mathias","why":"تمرين فهم سمّاعي A2 على السيرة الذاتية والخبرة المهنية — يدعم حديث الحلقة عن الإثبات والجدارة.","dur":3,"lang":"fr"}]},{"id":"a2-t7-l13","fr":"Épisode 13 — Le client est roi","ar":"الحلقة 13 — الزبون ملك","objectives":["خدمة العملاء بأسلوب فرنسي مهذّب مع استخدام y و en تلقائياً","متابعة الحلقة من توقيتها 1:53:24 مع التقاط عبارات الخدمة","السؤال والجواب عن الكمية والتوفر باستخدام en"],"sections":[{"h":"الحلقة 13: الزبون ملك (1:53:24 — 2:04:50)","video":{"id":"eovTQJ4INAU","title":"Reflets 1 - épisode #13 - Le client est roi","channel":"Jason Mills","why":"الحلقة الكاملة — النص الأصلي للمشوار: طبّق ما تعلمه في دروس القواعد والمفردات.","lang":"fr","main":true,"t":0,"dur":8},"p":["«الزبون ملك» شعار لا يُنطق فحسب بل يُبنى من جمل: كل جملة في هذه الحلقة تبدأ بالإجابة قبل السؤال — التزام عميلي كامل بلباقة فرنسية معتادة.","الضمنان y و en هما قفزة الطلاقة التالية: en للكمية والجزء («Il en reste deux»)، وy للمكان («J'y vais» أو «Vous y pensez»). غيابهما يجعل الجملة مترددة دائماً.","«Est-ce que vous avez...؟» يصبح بـ en: «Vous en avez ?» — هذا الاختصار هو الفرق بين من يكتب فرنسية ومن يتكلمها. تدرّب على تبديل الاسم بـ en في خمس جمل.","مفردات الخدمة هنا عمليّة: la commande, la livraison, le paiement, le bon de commande — مفردات العمل اليومي لا تختلف من متجر إلى آخر.","الاستماع والتكرار: جمل الخدمة وجيزة وسريعة الإيقاع — كرّرها بصوت عالٍ فور سماعها، فالجملة القصيرة قابلة للحفظ بالكامل بثلاث محاولات.","بعد الحلقة: اكتب محادثة قصيرة بين زبون وموظف (6 جمل) تُظهر فيها en للكمية وy للمكان مرة واحدة على الأقل — هذان الضمان يحوّلان نصك إلى نص فرنسي."],"sub":[{"h":"ضميرا y و en في الخدمة","p":["Vous en avez en bleu ?","Il en reste un seul.","J'y vais tout de suite.","Vous y pensez, madame ?"]},{"h":"عبارات الخدمة","p":["Je m'en occupe.","Votre commande est prête.","Vous voulez un sac ?","La livraison est offerte."]},{"h":"أدوات الاستماع","p":["commande ← [kɔ̃.mad].","livraison ← النبرة الثانية.","en ← [ɑ̃] مدموج في الكلام.","y ← [i] خفيف جداً."]}]},{"h":"عبارات التوفر والكمية","p":["«Il en reste combien؟» سؤال المخزون القياسي، وجوابه بـ en مجدداً: «Il n'en reste plus». التكرار المتعمد هنا يبني استجابة تلقائية.","«Je vous en prends deux» يربط الكمية بالضمير في جملة واحدة — الفرنسية تحب الاختصار، ومن لم يعتد عليه يبدو بطيئاً في الكلام.","«Je m'en occupe» العبارة الأم في الخدمة: تختصر «سأتولى الأمر» كاملة، وتظهر في كل موقف عمل من فتح الطلب إلى إغلاقه."]},{"h":"تمرين الحلقة","p":["تمرين الاحتمال: اكتب خمسة أسماء شائعة (pain, café, sac, argent, temps) ثم حوّلها إلى جمل en («J'en ai», «Il en reste»...).","سجّل حوار الخدمة (زبون وموظف) في 30 ثانية — الإيقاع السريع هو هدف الحلقة.","ما تحفظه: «Il en reste...», «Vous en avez...?», «Je m'en occupe», «J'y vais». أربع جمل تجعلك تتصرّف بسرعة دون إعادة الاسم."]},{"h":"التطبيق والتلخيص","p":["الحلقة 13: الزبون ملك — الإجابة قبل السؤال مع «en» للكمية و«y» للمكان، كما في الفيديو الرئيسي «Reflets 1 - épisode #13 - Le client est roi»: شغّل من بدايته وأعد ردود الموظف بنبرة هادئة ثم ارجع إلى دروس القواعد والمفردات.","جسر الحلقات: من a2-t7-l12 (المقارنة والجدارة) إلى a2-t7-l13 (جودة الخدمة و«الزبون ملك»)، ثم إلى a2-t7-l14 حيث تنتقل المحادثة إلى السوق والتسوّق وسؤال السعر.","المهمة: شاهد الحلقة كاملة، ثم افتح ورقة المفردات وراجع كلمات الخدمة (la commande, la livraison, le paiement, en stock)، وأخيراً سجّل تلخيصاً شفهياً مدته 30 ثانية تشرح فيه كيف يُخدَم زبون بامتياز."]}],"examples":[{"fr":"Vous en avez en taille moyenne ?","ar":"هل لديكم منها بالمقاس المتوسط؟","note":"en للكمية"},{"fr":"Il n'en reste plus, désolé.","ar":"لم يتبقَّ منها شيء، آسف.","note":"نفي مع en"},{"fr":"Je m'en occupe immédiatement.","ar":"أتولى الأمر حالاً.","note":"m'en occupe"},{"fr":"J'y vais apporter la caisse.","ar":"أذهب لإحضار الصندوق.","note":"y للمكان"},{"fr":"Votre commande est prête.","ar":"طلبك جاهز.","note":"خدمة"},{"fr":"La livraison est offerte ce mois-ci.","ar":"التوصيل مجاني هذا الشهر.","note":"عرض"}],"pron":[{"w":"la commande","ipa":"[kɔ̃.mad]","approx":"كونماد"},{"w":"la livraison","ipa":"[li.vʁɛ.zɔ̃]","approx":"ليفريزون"},{"w":"reste","ipa":"[ʁɛst]","approx":"ريست"}],"vocab":[{"fr":"la commande","ar":"الطلب","pos":"nom","g":"f","exFr":"Votre commande est prête.","ipa":"[kɔ̃.mad]","exAr":"طلبك جاهز."},{"fr":"la livraison","ar":"التوصيل","pos":"nom","g":"f","exFr":"Livraison gratuite.","ipa":"[li.vʁɛ.zɔ̃]","exAr":"توصيل مجاني."},{"fr":"le paiement","ar":"الدفع","pos":"nom","g":"m","exFr":"Le paiement est sécurisé.","ipa":"[pɛ.mɑ̃]","exAr":"الدفع آمن."},{"fr":"le sac","ar":"الكيس","pos":"nom","g":"m","exFr":"Vous voulez un sac ?","ipa":"[sak]","exAr":"هل تريد كيساً؟"},{"fr":"le stock","ar":"المخزون","pos":"nom","g":"m","exFr":"Il y a du stock.","ipa":"[stɔk]","exAr":"يوجد مخزون."},{"fr":"s'occuper de","ar":"يتولى","pos":"verbe","g":"1er","exFr":"Je m'en occupe.","ipa":"[ɔ.ky.pe də]","exAr":"أتولى الأمر."},{"fr":"en stock","ar":"متوفّر","pos":"locution","exFr":"C'est en stock.","ipa":"[ɑ̃ stɔk]","exAr":"متوفّر."},{"fr":"offrir","ar":"يقدّم مجاناً","pos":"verbe","g":"3e","exFr":"Le café est offert.","ipa":"[ɔ.fʁiʁ]","exAr":"القهوة مجانية."},{"fr":"la caisse","ar":"صندوق الدفع","pos":"nom","g":"f","exFr":"Passez à la caisse.","ipa":"[kɛs]","exAr":"توجّه إلى الصندوق."},{"fr":"le bon","ar":"القسيمة/الإيصال","pos":"nom","g":"m","exFr":"Voici votre bon.","ipa":"[bɔ̃]","exAr":"إليك قسيمتك."},{"fr":"y penser","ar":"يفكر في الأمر","pos":"locution","exFr":"Vous y pensez ?","ipa":"[i pɑ̃.se]","exAr":"هل تفكر في الأمر؟"},{"fr":"le client satisfait","ar":"الزبون الراضي","pos":"nom","exFr":"Le client est satisfait.","ipa":"[klijɑ̃ sa.tis.fe]","exAr":"الزبون راضٍ."}],"grammar":[{"tFr":"Les pronoms y et en","tAr":"القاعدة: ضميرا y و en","body":["en يحلّ محلّ «de + nom» (كمية أو جزء): «Vous avez du pain ?» ← «Vous en avez ?» — والنفي «Je n'en ai plus». وy للمكان («à/in + nom»): «Tu vas au magasin ?» ← «Tu y vas ?» — الاثنان يسبقان الفعل.","مع le/la/les يتسلسل الضمائر: «Je l'y apporte» (شيء ثم مكان)، و«Je vous en donne» (شخص ثم كمية). هذا التسلسل قاعدة واحدة تُغنيك عن تردد طويل."],"ex":[{"fr":"Il y a des croissants ? — Oui, il en reste deux.","ar":"هل هناك كرواسون؟ — نعم، يتبقّى اثنان."},{"fr":"Vous allez au bureau ? Oui, j'y vais.","ar":"تذهب إلى المكتب؟ نعم، ذاهب إليه."}]}],"mistakes":[{"wrong":"«Vous avez en bleu ?»","right":"«Vous en avez en bleu ?»","why":"الضمير يسبق الفعل كأي ضمير آخر."},{"wrong":"y مع الكمية","right":"en للكمية وy للمكان","why":"الاختصاصان واضحان ولا يتداخلان."},{"wrong":"حذف en مع النفي","right":"«Je n'en ai pas»","why":"النفي يبقى مع الضمير لا مع الاسم المحذوف."},{"wrong":"«Je m'en occupe de ça»","right":"«Je m'en occupe» فقط","why":"en يغني عن de + ça."}],"dialogues":[{"title":"الطلب عبر الهاتف","ctx":"زبون يتصل بمحل","lines":[{"who":"Le client","fr":"Bonjour, vous avez du pain complet ?","ar":"مرحباً، هل لديكم خبز كامل؟"},{"who":"Le vendeur","fr":"Il en reste deux, madame. Vous voulez que je vous en garde ?","ar":"يتبقّى اثنان يا سيدة. أتريدين أن أحجز لك أحدهما؟"},{"who":"Le client","fr":"Oui, s'il vous plaît. J'y passe dans dix minutes.","ar":"نعم من فضلك. سأمرّ خلال عشر دقائق."},{"who":"Le vendeur","fr":"Parfait, je vous en mets deux alors.","ar":"ممتاز، سأضع لك اثنين إذن."},{"who":"Le client","fr":"Merci ! Et le total, c'est combien ?","ar":"شكراً! والمجموع كم؟"},{"who":"Le vendeur","fr":"Trois euros vingt. À tout à l'heure !","ar":"ثلاثة يورو وعشرون. أراك بعد قليل!"}]}],"exercises":[{"t":"mcq","skill":"grammar","q":"التحويل الصحيح: «Vous avez du café ?»","opts":["Vous en avez ?","Vous y avez ?","Vous le avez ?","En vous avez ?"],"a":0,"why":"en للكمية."},{"t":"fill","skill":"writing","q":"أكمل: «Il n'___ reste plus.»","fr":"Il n'___ reste plus.","ans":"en","alts":["En"],"why":"النفي مع en يبقى."},{"t":"mcq","skill":"reading","q":"«Je m'en occupe» تعني:","opts":["أتولى الأمر","أتركه","أبيعه","أشتري اثنين"],"a":0,"why":"s'occuper de → en يحل محل de."},{"t":"order","skill":"writing","q":"رتّب جملة en","words":["Je","vous","en","donne","deux."],"ans":"Je vous en donne deux.","why":"التسلسل: vous ← en ← الفعل."},{"t":"listen","skill":"listening","q":"عبارة y للمكان في المقطع:","opts":["J'y vais","J'en vais","Y en je","Je vais en"],"a":0,"why":"y تحلّ محل à + مكان."},{"t":"translate","skill":"writing","q":"ترجم: «هل توجد نسخ متبقية؟ نعم يتبقّى اثنتان.»","ans":"Il en reste ? Oui, il en reste deux.","alts":["il en reste oui il en reste deux"],"why":"en في السؤال والجواب معاً."},{"t":"correct","skill":"writing","q":"صحّح: «Je m'en occupe de la commande.»","ans":"Je m'en occupe","alts":["je m en occupe"],"why":"en تغني عن de la commande."},{"t":"writing","skill":"writing","q":"اكتب حوار خدمة قصيراً (5 جمل) يستخدم en للكمية وy للمكان.","target":"Vous en avez...? — J'y vais...","why":"إنتاج موجّه للضميرين."}],"homework":"أعد الحلقة من 1:53:24 ثلاث مرات، ثم اكتب خمس جمل استخداماً فيها en وأربع جمل فيها y دون تكرار الاسم.\nالحلقة السابقة/التالية: a2-t7-l12 ← a2-t7-l13 → a2-t7-l14","sources":[{"title":"Reflets 1 - épisode #13 - Le client est roi","channel":"Jason Mills","videoId":"eovTQJ4INAU","why":"الحلقة الكاملة — النص الأصلي للمشوار: طبّق ما تعلمه في دروس القواعد والمفردات.","cat":"Séries","level":"A2","main":true,"t":0},{"title":"La satisfaction client : 3 équations pour améliorer la qualité du service client","channel":"Technique de Vente Edition - Formation Commerciale","videoId":"aiwjpZF-SE4","why":"ثلاث معادلات لرفع رضا الزبون وجودة الخدمة — خلفية مهنية لشعار «الزبون ملك» في الحلقة.","cat":"Conversation","level":"A2","extra":true}],"supplements":[{"id":"aiwjpZF-SE4","title":"La satisfaction client : 3 équations pour améliorer la qualité du service client","channel":"Technique de Vente Edition - Formation Commerciale","why":"ثلاث معادلات لرفع رضا الزبون وجودة الخدمة — خلفية مهنية لشعار «الزبون ملك» في الحلقة.","dur":9,"lang":"fr"}]},{"id":"a2-t7-l14","fr":"Épisode 14 — Faisons le marché","ar":"الحلقة 14 — نذهب إلى السوق","objectives":["التسوّق في السوق بالفرنسية: الكميات، الأسعار، الأعداد حتى 100","متابعة الحلقة من توقيتها 2:04:50 مع التقاط مفردات السوق","استعمال الأداة الجزئية (du/de la/des) ونفيها بـ de"],"sections":[{"h":"الحلقة 14: في السوق (2:04:50 — 2:14:51)","video":{"id":"yv9FRqUADC4","title":"Reflets 1 - épisode #14 - Faisons le marché","channel":"Jason Mills","why":"الحلقة الكاملة — النص الأصلي للمشوار: طبّق ما تعلمه في دروس القواعد والمفردات.","lang":"fr","main":true,"t":0,"dur":6},"p":["السوق أعلى كثافة مفردات في السلسلة كلها: كل واقفة تكرر «combien», «kilo», \"s'il vous plaît» — جملتان تفتحان كل طاولة. البدء منهما يغنيك عن الترجمة.","الأداة الجزئية هي قلب التسوّق: du pain (جزء من الخبز)، de la confiture، des œufs — لأن ما يُشترى عادة جزء لا شيء كاملاً. تعلّمها في الشراء أولاً لأنها هناك تُقال فعلاً.","نفي الجزئي يتحوّل إلى de: «Je ne veux pas de sucre» — هذه النقطة النحوية الوحيدة في الموقف، وتكرارها في السوق يثبت تلقائياً.","الأعداد والأسعار: French counting يعود إلى الظهور (quatre-vingts, soixante-dix) — السوق أفضل مكان لسماعها منطوقاً: «Ça fait soixante euros».","الاستماع والتكرار: المكان مزدحم أصواتاً، والحلقة تصل بك لواقع الصوت الحقيقي — استمع مرتين بلا توقف ثم ثالثة وأنت تكرر «Combien, s'il vous plaît؟» معهم.","بعد الحلقة: اكتب قائمة تسوق فرنسية (5 أصناف مع الكمية والسعر) ثم انطقها كما لو كنت تشتري فعلاً. إن استطعت امتداد الجملة بـ s'il vous plaît وmerci بلا تفكير، فقد اجتزت الحلقة."],"sub":[{"h":"أسئلة السوق","p":["Combien le kilo ?","C'est combien, s'il vous plaît ?","Vous en voulez un peu ?","Et avec ceci ?"]},{"h":"الأداة الجزئية والنفي","p":["Je voudrais du pain.","Il y a de la confiture.","Des œufs, s'il vous plaît.","Je ne veux pas de sucre."]},{"h":"أدوات الاستماع","p":["marché ← [maʁ.ʃe].","kilo ← [ki.lo].","soixante ← [swa.sɑ̃t].","frais/fraîche ← مزدوج."]}]},{"h":"عبارات التسوّق المتكررة","p":["«Combien ça fait ?» سؤال الإجمالي، و«C'est combien ?» سؤال السعر للقطعة — التفريق بين الاثنين يمنع الخلط في كل مرة تدفع فيها النقود.","«Je vous fais un prix» ردّ البائع: «سأعطيك ثمناً خاصاً». من فهم هذه الجملة فهم نصف مفاوضة السوق الفرنسية.","«Tenez, voilà» عند التسليم النقدي — عبارة صغيرة تُقال مع كل عملية دفع، وتُظهر راحة بال في الأداء."]},{"h":"تمرين الحلقة","p":["تمرين القائمة: اكتب قائمة تسوق من 6 أصناف (كمية + سعر) ثم انطقها بصوت متسوق حقيقي.","تدرّب على النفي الجزئي: اكتب 4 جمل رفض فيها ما لا تحبه («Je ne veux pas de...»).","ما تحفظه: «Combien le kilo?» + «du/de la/des» في الشراء + «Je ne veux pas de...». بها تدير زيارة سوق كاملة."]},{"h":"التطبيق والتلخيص","p":["الحلقة 14: في السوق — الكمية والسعر والتفاوض مع «combien» و«kilo» و«s'il vous plaît»، كما في الفيديو الرئيسي «Reflets 1 - épisode #14 - Faisons le marché»: شغّل من بدايته واشترِ بصوتك مع البائعين، ثم ارجع إلى دروس القواعد والمفردات.","جسر الحلقات: من a2-t7-l13 (الزبون ملك) إلى a2-t7-l14 (السوق والتسوّق)، ثم إلى a2-t7-l15 حيث تختتم السلسلة بحوار انتقال واستعمال صيغة الأمر.","المهمة: شاهد الحلقة كاملة، ثم افتح ورقة المفردات وراجع كلمات السوق (le kilo, l'étal, la fraise, la monnaie)، وأخيراً سجّل تلخيصاً شفهياً مدته 30 ثانية تشتري فيه خمسة أصناف من بائع."]}],"examples":[{"fr":"Je voudrais deux kilos de pommes.","ar":"أريد كيلوين من التفاح.","note":"الكمية"},{"fr":"Combien le kilo, s'il vous plaît ?","ar":"الكيلو بكم من فضلك؟","note":"سؤال السعر"},{"fr":"Il y a de la fraîcheur aujourd'hui.","ar":"يوجد منتج طازج اليوم.","note":"جزئية مؤنثة"},{"fr":"Je ne veux pas de sucre.","ar":"لا أريد سكراً.","note":"نفي الجزئي"},{"fr":"Ça fait soixante euros.","ar":"المجموع ستون يورو.","note":"الأعداد"},{"fr":"Des légumes frais, s'il vous plaît.","ar":"خضروات طازجة من فضلك.","note":"جزئية جمع"}],"pron":[{"w":"le marché","ipa":"[maʁ.ʃe]","approx":"مارشي"},{"w":"le kilo","ipa":"[ki.lo]","approx":"كيّو"},{"w":"soixante","ipa":"[swa.sɑ̃t]","approx":"سواصانت"}],"vocab":[{"fr":"le marché","ar":"السوق","pos":"nom","g":"m","exFr":"On fait le marché le samedi.","ipa":"[maʁ.ʃe]","exAr":"نسوق يوم السبت."},{"fr":"le kilo","ar":"الكيلوغرام","pos":"nom","g":"m","exFr":"Un kilo de tomates.","ipa":"[ki.lo]","exAr":"كيلو من الطماطم."},{"fr":"le prix","ar":"السعر","pos":"nom","g":"m","exFr":"C'est un bon prix.","ipa":"[pʁi]","exAr":"إنه سعر جيد."},{"fr":"frais / fraîche","ar":"طازج","pos":"adj","exFr":"Des fruits frais.","ipa":"[fʁɛ]","exAr":"فواكه طازجة."},{"fr":"les légumes","ar":"الخضروات","pos":"nom","g":"m.pl","exFr":"J'achète des légumes.","ipa":"[le.ɡym]","exAr":"أشتري خضروات."},{"fr":"acheter","ar":"يشتري","pos":"verbe","g":"1er","exFr":"J'achète du pain.","ipa":"[aʃ.te]","exAr":"أشتري خبزاً."},{"fr":"le client / le vendeur","ar":"الزبون/البائع","pos":"nom","exFr":"Le vendeur sourit.","ipa":"[vɑ̃.dœʁ]","exAr":"البائع يبتسم."},{"fr":"l'étal","ar":"بسطة البائع","pos":"nom","g":"m","exFr":"À l'étal du fromage.","ipa":"[e.tal]","exAr":"عند بسطة الجبن."},{"fr":"la fraise","ar":"الفراولة","pos":"nom","g":"f","exFr":"Un barquet de fraises.","ipa":"[fʁɛz]","exAr":"علبة فراولة."},{"fr":"le total","ar":"المجموع","pos":"nom","g":"m","exFr":"Le total, s'il vous plaît.","ipa":"[to.tal]","exAr":"المجموع من فضلك."},{"fr":"de l'argent","ar":"مال/نقود","pos":"nom","exFr":"J'ai assez d'argent.","ipa":"[də laʁ.ʒɑ̃]","exAr":"لدي مال كافٍ."},{"fr":"la monnaie","ar":"الباقي/العملة","pos":"nom","g":"f","exFr":"Gardez la monnaie.","ipa":"[mɔ.nɛ]","exAr":"احتفظ بالباقي."}],"grammar":[{"tFr":"Les articles partitifs et leur négation","tAr":"القاعدة: الأداة الجزئية ونفيها","body":["الجزئي du/de la/de l'/des يُستعمل مع الأشياء غير المعدودة أو الجزء غير المعروف: du lait, de l'eau, des œufs — في الشراء والرغبة والوجود («Je voudrais du...», «Il y a de la...»).","في النفي يتحوّل كل جزئي إلى de: «Je ne mange pas de viande» — الاستثناءات قليلة (pas beaucoup de، وla/tout l' بقيدين). قاعدة واحدة تُصحَّح أخطاء الكتابة كلها."],"ex":[{"fr":"Je n'ai pas d'argent sur moi.","ar":"ليس لديّ معي نقود."},{"fr":"Vous voulez du fromage ?","ar":"هل تريد جبناً؟"}]}],"mistakes":[{"wrong":"«Je ne veux pas un peu de sucre»","right":"«Je ne veux pas de sucre»","why":"النفي يلغي الجزئي ويُبقي de فقط."},{"wrong":"«acheter le pain» عامة","right":"«acheter du pain» عند الشراء الفعلي","why":"الجزئي لاقتناء جزء من المخزون."},{"wrong":"الخلط بين سؤال السعر والمجموع","right":"«C'est combien?» / «Ça fait combien?»","why":"الأول للقطعة والثاني للإجمالي."},{"wrong":"الأعداد في الاحتفاظ","right":"quatre-vingts بلا s في المفرد","why":"تفاصيل تُلاحظ عند الأرقام الكبيرة."}],"dialogues":[{"title":"شراء الخضار","ctx":"زبون وبائعة في السوق","lines":[{"who":"La cliente","fr":"Bonjour ! Combien les tomates, s'il vous plaît ?","ar":"مرحباً! الطماطم بكم من فضلك؟"},{"who":"La marchande","fr":"Deux euros le kilo. Elles sont très fraîches.","ar":"يوروان للكيلو. إنها طازجة جداً."},{"who":"La cliente","fr":"Je voudrais deux kilos, et un peu de basilic.","ar":"أريد كيلوين، وقليل من الريحان."},{"who":"La marchande","fr":"Du basilic ? Tenez, voilà. Avec ceci ?","ar":"ريحان؟ خُذ، تفضّل. ومع هذا؟"},{"who":"La cliente","fr":"C'est tout. Ça fait combien ?","ar":"هذا كل شيء. المجموع كم؟"},{"who":"La marchande","fr":"Quatre euros. Merci, bonne journée !","ar":"أربعة يورو. شكراً، أطيب يوم!"}]}],"exercises":[{"t":"mcq","skill":"grammar","q":"الصيغة الصحيحة لـ «أريد قليلاً من الجبن»:","opts":["Je veux un peu de fromage","Je veux un peu le fromage","Je veux du le fromage","Je veux de fromage le"],"a":0,"why":"الجزئي مع الأصل، أو de عند التخصيص."},{"t":"fill","skill":"writing","q":"أكمل: «Je n'ai pas ___ temps.»","fr":"Je n'ai pas ___ temps.","ans":"de","alts":["De"],"why":"النفي يحوّل الجزئي إلى de."},{"t":"mcq","skill":"listening","q":"سؤال سعر القطعة:","opts":["C'est combien ?","Ça fait combien ?","Qui est combien ?","Quand combien ?"],"a":0,"why":"C'est combien للقطعة، ça fait للإجمالي."},{"t":"order","skill":"writing","q":"رتّب جملة الشراء","words":["Je","voudrais","deux","kilos","de","pommes."],"ans":"Je voudrais deux kilos de pommes.","why":"الكمية ← de ← الصنف."},{"t":"listen","skill":"listening","q":"عبارة النفي الجزئي في المقطع:","opts":["Je ne veux pas de sucre","Je ne veux pas le sucre","Pas le sucre non","Je veux pas un sucre"],"a":0,"why":"بعد النفي يبقى de."},{"t":"translate","skill":"writing","q":"ترجم: «سأدفع المبلغ، ليس لديّ باقي.»","ans":"Je paie le total, je n'ai pas de monnaie.","alts":["je paie le total je n ai pas de monnaie"],"why":"نفي جزئي مع monnaie."},{"t":"correct","skill":"writing","q":"صحّح: «Je ne mange pas de la viande.» (نفي)","ans":"Je ne mange pas de viande","alts":["je ne mange pas de viande"],"why":"النفي يلغي la ويُبقي de."},{"t":"writing","skill":"writing","q":"اكتب قائمة تسوق من 5 أصناف بالفرنسية (الكمية + سعر تقديري).","target":"Je voudrais... kilos de... — C'est combien ?","why":"إنتاج قائمة موجّه."}],"homework":"أعد الحلقة من 2:04:50 ثلاث مرات، ثم اكتب حوار سوق كاملًا (6 جمل) مع الأداة الجزئية وسؤال السعر.\nالحلقة السابقة/التالية: a2-t7-l13 ← a2-t7-l14 → a2-t7-l15","sources":[{"title":"Reflets 1 - épisode #14 - Faisons le marché","channel":"Jason Mills","videoId":"yv9FRqUADC4","why":"الحلقة الكاملة — النص الأصلي للمشوار: طبّق ما تعلمه في دروس القواعد والمفردات.","cat":"Séries","level":"A2","main":true,"t":0},{"title":"Acheter des fruits et des légumes au marché-Dialogue simulé-Delf A1 - 📢English subtitles available!","channel":"La prof Elisabeth","videoId":"Mb_T3Ewz1Ng","why":"حوار محاكى للشراء من السوق: الفواكه والخضروات والسعر والكمية — نفس مفردات الحلقة في وضع حقيقي.","cat":"Conversation","level":"A2","extra":true}],"supplements":[{"id":"Mb_T3Ewz1Ng","title":"Acheter des fruits et des légumes au marché-Dialogue simulé-Delf A1 - 📢English subtitles available!","channel":"La prof Elisabeth","why":"حوار محاكى للشراء من السوق: الفواكه والخضروات والسعر والكمية — نفس مفردات الحلقة في وضع حقيقي.","dur":3,"lang":"fr"}]},{"id":"a2-t7-l15","fr":"Épisode 15 — On déménage","ar":"الحلقة 15 — ننتقل إلى سكن جديد","objectives":["الإشراف على عملية الانتقال بأوامر مهذّبة (l'impératif)","متابعة الحلقة من توقيتها 2:14:51 — نهاية السلسلة مع خاتمة عملية","وصف الأثاث وأوامر النقل في جمل قصيرة حاسمة"],"sections":[{"h":"الحلقة 15: الانتقال (2:14:51 — نهاية الفيديو)","video":{"id":"7y4_b9LMwkk","title":"Reflets 1 - épisode #15 - On déménage","channel":"Jason Mills","why":"الحلقة الكاملة — النص الأصلي للمشوار: طبّق ما تعلمه في دروس القواعد والمفردات.","lang":"fr","main":true,"t":0,"dur":9},"p":["الانتقال اختبار شامل: أسماء أثاث، أوامر قصيرة، تحديد أماكن — كل ما تعلّمه المتعلم في أربع عشرة حلقة يلتقي هنا في موقف واحد يشغّل صوته.","الأمر (l'impératif) يُبنى من المضارع بلا فاعل: «Prends la caisse!», «Mettons ça ici!», «Allez, on y va!» — نبرة حاسمة وقاعدة قصيرة، وهذه آخر قاعدة في السلسلة.","مفردات الأثاث مهمة ومتداولة: le canapé, l'armoire, l'étagère, le tapis — تعلّمها بالصورة أثناء وصف صندوق تفتحه لا في قائمة جافة.","«Où est-ce qu'on met...؟» سؤال الاتجاه اليومي، وجوابه بمكان: «Ici», \"À gauche», «Dans le salon» — ثلاث إجابات تختصر ارتباط أي نقاش عن الترتيب.","الاستماع والتكرار في الحلقة الأخيرة: اجعلها تكراراً كاملاً لتنبرة السلسلة كلها — أعد الحلقة من البداية إلى النهاية بلا توقف في التمارين، فهذا تقييم قدّمك الحقيقي.","بعد الحلقة: اكتب ميثاقاً شخصياً قصيراً — 5 جمل تصف انتقالك القادم بالفرنسية (المكان، التوقيت، الأثاث، من سيساعدك، ما ستبدأ به). أنت الآن تملك سلسلة كاملة تعمل بها."],"sub":[{"h":"أوامر النقل","p":["Prends la petite caisse !","Mettons le tapis ici.","Faites attention à la porte.","Allez, on y va !"]},{"h":"الأثاث والمواقع","p":["le canapé — الأريكة.","l'armoire — الخزانة.","l'étagère — الرفّ.","à gauche / à droite — يمين/يسار."]},{"h":"أدوات الاستماع","p":["déménager ← الإيقاع على الجذر.","attention ← [a.tɑ̃sjɔ̃].","caisse ← [kɛs].","impératif ← نهايات −e/-s/-ons."]}]},{"h":"عبارات الانتقال","p":["«On commence par la cuisine» — ترتيب المهام يبدأ بـ «par» ثم يكمل بـ «ensuite», «puis» — سلسلة تجعل أي تعليمات مفهومة تسلسلياً.","«Faites attention !» تحذير قصير يُقال في كل مواقف الخطر اليومي — من أتقنه لا يحتاج جملاً طويلة لتنبيه أحد.","«C'est le dernier carton !» عبارة الفرح بالإتمام — وأنت أيضاً عند آخر حلقة: ختِمها بالجملة نفسها بصوت مسموع."]},{"h":"تمرين الحلقة","p":["تمرين الختام: أعد الاستماع للحلقة الأخيرة كاملة، ثم اكتب 8 أوامر قصيرة توجهها لفريق انتقالك (Prends... / Mettons... / Faites...).","اجمع ما حفظته من السلسلة: 15 درساً × 4 جمل تكفي لحياة يومية كاملة. راجع جمل التعارف، والوصف، والخدمة، والسوق — بترتيب الحلقات.","ما تحفظه من هذه الحلقة: l'impératif بثلاث صيغ + «On commence par...» + «Faites attention». وبهذا تُغلق السلسلة غلقاً عملياً."]},{"h":"التطبيق والتلخيص","p":["الحلقة 15: الانتقال — أسماء الأثاث والأوامر القصيرة وتحديد المكان، كما في الفيديو الرئيسي «Reflets 1 - épisode #15 - On déménage»: شغّل من البداية إلى النهاية بلا توقف وأصدر الأوامر بصوت الممثلين قبل الرجوع إلى دروس القواعد والمفردات.","الخاتمة — راجع a2-t7-l1 لتقارن نطقك في البداية والنهاية، وأكمل نحو a2-t8 لتشتغل بالأفلام والمسلسلات (a2-t8-l1).","المهمة: شاهد الحلقة كاملة، ثم افتح ورقة المفردات وراجع كلمات الانتقال (déménager, le carton, l'armoire, le tapis)، وأخيراً سجّل تلخيصاً شفهياً مدته 30 ثانية تصف فيه انتقالك مع ثمانية أوامر قصيرة."]}],"examples":[{"fr":"Prends cette boîte, s'il te plaît.","ar":"خذ هذه الصندوق من فضلك.","note":"أمر tu"},{"fr":"Mettons le canapé près de la fenêtre.","ar":"لندع الأريكة قرب النافذة.","note":"أمر nous"},{"fr":"Faites attention aux escaliers !","ar":"انتبهوا للدرج!","note":"أمر vous + تحذير"},{"fr":"Où est-ce qu'on met l'armoire ?","ar":"أين نضع الخزانة؟","note":"سؤال الترتيب"},{"fr":"On commence par la cuisine.","ar":"نبدأ بالمطبخ.","note":"سلسلة المهام"},{"fr":"C'est le dernier carton, on a fini !","ar":"إنه الصندوق الأخير، انتهينا!","note":"الإتمام"}],"pron":[{"w":"déménager","ipa":"[de.me.na.ʒe]","approx":"دوميناجي"},{"w":"l'armoire","ipa":"[laʁ.mwaʁ]","approx":"لارموار"},{"w":"attention","ipa":"[a.tɑ̃.sjɔ̃]","approx":"أنتانيون"}],"vocab":[{"fr":"déménager","ar":"ينتقل سكناً","pos":"verbe","g":"1er","exFr":"Ils déménagent demain.","ipa":"[de.me.na.ʒe]","exAr":"ينتقلون غداً."},{"fr":"le carton","ar":"الصندوق","pos":"nom","g":"m","exFr":"Un carton de livres.","ipa":"[kaʁ.tɔ̃]","exAr":"صندوق كتب."},{"fr":"le canapé","ar":"الأريكة","pos":"nom","g":"m","exFr":"Le canapé est trop large.","ipa":"[ka.na.pe]","exAr":"الأريكة عريضة جداً."},{"fr":"l'armoire","ar":"الخزانة","pos":"nom","g":"f","exFr":"Range tes vêtements dans l'armoire.","ipa":"[laʁ.mwaʁ]","exAr":"ضع ملابسك في الخزانة."},{"fr":"l'étagère","ar":"الرفّ","pos":"nom","g":"f","exFr":"Les livres sont sur l'étagère.","ipa":"[e.ta.ʒɛʁ]","exAr":"الكتب على الرفّ."},{"fr":"le tapis","ar":"السجادة","pos":"nom","g":"m","exFr":"Pose le tapis ici.","ipa":"[ta.pi]","exAr":"ضع السجادة هنا."},{"fr":"le voisinage","ar":"الجيران/الجيرة","pos":"nom","g":"m","exFr":"Le voisinage est calme.","ipa":"[vwa.zi.naʒ]","exAr":"الجيران هادئون."},{"fr":"les clés","ar":"المفاتيح","pos":"nom","g":"f.pl","exFr":"Voici les clés de l'appartement.","ipa":"[kle]","exAr":"إليك مفاتيح الشقة."},{"fr":"attention","ar":"انتباه","pos":"nom","g":"f","exFr":"Faites attention !","ipa":"[a.tɑ̃sjɔ̃]","exAr":"انتبهوا!"},{"fr":"l'adresse","ar":"العنوان","pos":"nom","g":"f","exFr":"Note mon adresse sur le carton.","ipa":"[la.dʁɛs]","exAr":"اكتب عنواني على الصندوق."},{"fr":"un déménageur","ar":"عامل النقل","pos":"nom","g":"m","exFr":"Les déménageurs arrivent.","ipa":"[de.me.naʒœʁ]","exAr":"عمال النقل يصلون."},{"fr":"le camion","ar":"الشاحنة","pos":"nom","g":"m","exFr":"Le camion est plein de cartons.","ipa":"[lə ka.mjɔ̃]","exAr":"الشاحنة مملوءة بالصناديق."}],"grammar":[{"tFr":"L'impératif : tu, nous, vous","tAr":"القاعدة: الصيغة الأمرية","body":["الأمر يُشتق من المضارع بلا فاعل مع ثلاث نهايات: tu بلا s («Prends!»), nous (+ons) («Mettons!»), vous بلا s («Faites!») — وأفعال être/avir/aller استثناءات شكلية (sois, soissons, soyez / aie, ayons, ayez / va, allons, allez).","مع الضمائر يعود الفاعل: «Prends-le !», \"Mettons-la ici\" — والنفي «Ne... pas» يحيط بالأمر: «Ne prends pas ça !». أربع صيغ تغطي أوامر الحياة اليومية كلها."],"ex":[{"fr":"Soyez prudents sur la route.","ar":"كونوا حذرين في الطريق."},{"fr":"Ne mets pas ça sur le canapé !","ar":"لا تضع ذلك على الأريكة!"}]}],"mistakes":[{"wrong":"«Prends toi la caisse» (tutoiement بالأمر)","right":"«Prends la caisse» أو avec pronom «Prends-la»","why":"الضمير المتصل لا يُفصل بالفاصلة."},{"wrong":"نهاية s مع tu في الأمر","right":"«tu prends» تُعطي «Prends» بلا s","why":"القاعدة: tu بلا s عدا الاستثناءات الثلاثة."},{"wrong":"«Mettons nous»","right":"«Mettons-nous» ملتصق","why":"الضمائر في الأمر ملتصقة دائماً."},{"wrong":"اختيار أمر لا لائق بين الغرباء","right":"«Pourriez-vous...» للأمر المهذّب","why":"الأمر المباشر للقريب أو المألوف، وله بديل رسمي."}],"dialogues":[{"title":"يوم الانتقال","ctx":"جيران يساعدان بعضهما","lines":[{"who":"Karim","fr":"Allez, on commence par les cartons de la cuisine !","ar":"هيا، نبدأ بصناديق المطبخ!"},{"who":"Nadia","fr":"D'accord. Où est-ce qu'on met l'armoire ?","ar":"حسناً. أين نضع الخزانة؟"},{"who":"Karim","fr":"Ici, près de la fenêtre. Prends le tapis, s'il te plaît.","ar":"هنا، قرب النافذة. خذ السجادة من فضلك."},{"who":"Nadia","fr":"Faites attention aux escaliers, il est lourd !","ar":"انتبهوا للدرج، إنها ثقيلة!"},{"who":"Karim","fr":"Ensuite, on range les livres sur l'étagère.","ar":"ثم نرتّب الكتب على الرفّ."},{"who":"Nadia","fr":"C'est le dernier carton. On a fini, bravo !","ar":"إنه الصندوق الأخير. انتهينا، أحسنت!"}]}],"exercises":[{"t":"mcq","skill":"grammar","q":"الأمر الصحيح لـ «prendre» مع tu:","opts":["Prends","Prendre","Prenez","Prenant"],"a":0,"why":"الأمر من tu بلا s."},{"t":"fill","skill":"writing","q":"أكمل: «___ le tapis ici !» (نضع، nous)","fr":"___ le tapis ici !","ans":"Mettons","alts":["mettons"],"why":"أمر nous + ons."},{"t":"mcq","skill":"listening","q":"التحذير الصحيح:","opts":["Faites attention !","Fait attention !","Fais attention !","Faire attention"],"a":0,"why":"أمر vous بصيغة Faites."},{"t":"order","skill":"writing","q":"رتّب أمر النقل","words":["Prends","la","petite","caisse","maintenant."],"ans":"Prends la petite caisse maintenant.","why":"الفعل ← المفعول ← الظرف."},{"t":"listen","skill":"listening","q":"أمر البدء في المقطع:","opts":["On commence par la cuisine","On commençait la cuisine","On commencera cuisine","Commencez la cuisine on"],"a":0,"why":"قالب البداية avec par."},{"t":"translate","skill":"writing","q":"ترجم: «انتبهوا للدرج من فضلكم.»","ans":"Faites attention aux escaliers, s'il vous plaît.","alts":["faites attention aux escaliers s il vous plait"],"why":"Faites + attention + à."},{"t":"correct","skill":"writing","q":"صحّح: «Mets toi la caisse.»","ans":"Prends-la / Mets-la","alts":["mets-la","prends-la"],"why":"الضمير المتصل ملتصق بلا فاصلة."},{"t":"speaking","skill":"speaking","q":"اكتب 5 أوامر لفريق انتقالك (tu/nous/vous مختلط).","target":"Prends... / Mettons... / Faites...","why":"إنتاج الأوامر في وضعية حقيقية."}],"homework":"أعد الحلقة الأخيرة من 2:14:51 كاملة، ثم أعد الاستماع للحلقة الأولى (00:00) — قارن نطقك في البداية والنهاية وسجّل ملاحظتك.\nالحلقة السابقة/التالية: a2-t7-l14 ← a2-t7-l15 → a2-t8-l1","sources":[{"title":"Reflets 1 - épisode #15 - On déménage","channel":"Jason Mills","videoId":"7y4_b9LMwkk","why":"الحلقة الكاملة — النص الأصلي للمشوار: طبّق ما تعلمه في دروس القواعد والمفردات.","cat":"Séries","level":"A2","main":true,"t":0},{"title":"Emménager / Déménager : Comprendre la différence en 3 minutes","channel":"Oh My French Class","videoId":"1SAz_liaSls","why":"الفرق بين emménager وdéménager في ثلاث دقائق — يثبّت مفتاح الحلقة الأخيرة قبل أن تنتقل إلى a2-t8.","cat":"Vocabulaire","level":"A2","extra":true}],"supplements":[{"id":"1SAz_liaSls","title":"Emménager / Déménager : Comprendre la différence en 3 minutes","channel":"Oh My French Class","why":"الفرق بين emménager وdéménager في ثلاث دقائق — يثبّت مفتاح الحلقة الأخيرة قبل أن تنتقل إلى a2-t8.","dur":3,"lang":"fr"}]},{"id":"a2-t7-l16","fr":"Épisode 16 — Reflets 2, saison 2","ar":"الحلقة 16 — الموسم الثاني","objectives":["متابعة انطلاق الموسم الثاني وفهم مشهد la rentrée كما يعيشه الفرنسيون في سبتمبر","استيعاب مفردات التنظيم اليومي: l'emploi du temps, le créneau, la cantine, la papeterie","استعمال futur proche (aller + infinitif) للحديث عن أسبوعك الأول بثقة"],"sections":[{"h":"الدرس","video":{"id":"LviRrhOeYqY","title":"Reflets 2 Episode 01","channel":"Jason Mills","why":"الحلقة كاملة بالفرنسية الحية: شاهدها أولاً بلا ترجمة لتلتقط الموقف، ثم عُد إليها بعد الشرح والمفردات لتُصغي للأصوات التي تعرفتها.","lang":"fr","main":true,"t":0,"dur":13},"p":["ينطلق الموسم الثاني بعد أن ختَم الأول بحلقة الانتقال: الأبطال في مدينة جديدة، وشتاء طويل، ثم يأتي سبتمبر الذي يعيد ترتيب كل شيء. «La rentrée» عند الفرنسيين ليست مجرد عودة إلى المدرسة، بل موسم اجتماعي كامل تُعاد فيه الجداول وتمتلئ المحلات بالقرطاسية وتتبادل الأسر التحيات نفسها في المصعد: «Alors, la rentrée ?» — والسؤال وحده يفتح عشرين دقيقة حديث.","أربع عشرة دقيقة من الحلقة تمثّل تمريناً حقيقياً للأذن: تحيات قصيرة، قهوة صباحية، جدول يُقرأ على عجل، وطلب من محل القرطاسية. لا تحاول فهم كلمة بكلمة؛ خُذ جملتين من كل مشهد فهماً كافياً لبناء الصورة، ثم أعد المشهد لتلتقط التفاصيل، وهذه هي طريقة الاستماع المزدوجة التي تخدمك في كل دروس الموسم الثاني.","القاعدة النجمة هنا هي futur proche: «Je vais commencer lundi», «On va s'installer près de la gare» — صيغة سهلة النطق وقوية الدلالة تُغنيك عن futur simple في هذه المرحلة، ومعها تتعلّم ترتيب الأسبوع بالحروف الزمنية: «le lundi matin», «à partir de septembre», «pendant la pause».","قبل المشاهدة: ركّز في المرة الأولى على فهم الفكرة العامة للموقف دون إيقاف الفيديو، وفي المرة الثانية دوّن الكلمات التي تتكرر — خصوصاً la rentrée des classes، la papeterie، le cartable — وحاول استنتاج معناها من السياق قبل الرجوع إلى قاموسك.","بعد المشاهدة: تدرّب على ملخص من ثلاث جمل للكتابة — حدّد الشخصيات وما فعلنا وما شعروا به — ثم استمع مرة أخيرة وقارن نطقك بنطق الممثلين، مع انتباه خاص لنقطة قاعدة الدرس كما وردت في الحوار.","تلميح الأداء: أعد تشغيل المقاطع الصعبة بسرعة 0.75، وأوقف الفيديو عند نهاية كل جملة لتكرارها بصوت عالٍ — هذه الطريقة تثبّت المفردات والنطق معاً وتُعدّك جاهزاً لتمارين هذا الدرس وللدرس التالي في السلسلة."],"sub":[{"h":"النص الصوتي (مقتطف)","p":["Marc : Re-bonjour ! Alors, c'est la rentrée, tout le monde est de retour.","Julie : Oui, et moi je commence lundi dans la nouvelle agence.","Marc : Tu as vu l'emploi du temps ? Il y a une réunion dès mardi matin.","Julie : Pas encore. Je vais acheter une liste de fournitures à la papeterie.","Sophie : Les cantines ouvrent aussi cette semaine, heureusement.","Marc : Allez, on s'installe. Ce n'est qu'un début !"]},{"h":"مفردات الموقف","p":["la rentrée des classes — العودة إلى الدراسة","la papeterie — محل القرطاسية","le cartable — الحقيبة المدرسية","le créneau — فترة من الوقت","la cantine — مطعم المدرسة أو المؤسسة"]},{"h":"تعبيرات جاهزة للاستماع","p":["Écris la date dans ton cahier.","Où est mon stylo ?","La reprise est toujours un peu dure.","Mon emploi du temps est complet.","Bientôt, la semaine commence."]}]},{"h":"النطق والكلمات المفتاحية","p":["المقاطع الأنفية هي بصمة هذه الحلقة: [ɑ̃] في « rentrée » و« reprise » و« septembre »، و[ɛ̃] في « bientôt » و« cantine » — أخرج الصوت من الأنف مع فم نصف مفتوح ولا تُنهِ المقطع بـ n واضحة؛ الصوت الأنفي الفرنسي لا يُنطق أبداً كأنف عربي ساكن بل كصوت واحد ممتلئ. وانتبه إلى é الأخير في « rentrée » [e] فهو حادّ كـ « إي » لا مفتوح كـ « è ».","ثانياً: الإيقاع. الفرنسي يربط الكلمات في وحدات معنوية: « Je_vais_commencer_lundi_matin » تُقال كحركة واحدة لا كخمس كلمات منفصلة. استمع إلى Julie في النص الصوتي وحاول تقليد النبرة قبل أن تفهم المعنى، ثم كرّر الجملة ثلاث مرات مع الحفاظ على الوحدة الإيقاعية نفسها — هذا التمرين وحده يرفع جودة نطقك في كل الأزمنة."]},{"h":"محتوى الحلقة","p":["المشهد الأول صباحي: لقاء الجيران في الممر، تحيات العودة، وحديث قصير عن مواعيد الأسبوع. المشهد الثاني في المقهى: قهوة سريعة وجدول مواعيد يُقرأ من الهاتف، وسؤال متكرر « Tu as vu l'emploi du temps ? ». المشهد الثالث في محل القرطاسية: قائمة مشتريات المدرسة تُملى على البائعة، ونهاية الحلقة بعبارة تلخّص الروح كلها: « Ce n'est qu'un début ! ».","المفردات الجديدة تخدم موقفاً واحداً: la rentrée des classes (العودة إلى الدراسة)، la papeterie و le cartable و le cahier و le stylo (عالم القرطاسية)، le créneau و l'emploi du temps (تنظيم الوقت)، la cantine و la reprise (روتين المؤسسة). تعلّمها من السياق لا من القائمة: كل كلمة هنا صادفتك في جملة تسمعها قبل أن تراها.","نحوياً، راقب futur proche في جمل الحلقة كلها: « je vais commencer », « on va s'installer », « elles vont ouvrir ». ثم راقب حروف الجر الزمنية: « en septembre » بالحرف en، و« à partir de » للبداية، و« pendant » للمدة، و« le lundi » للتكرار الأسبوعي — أربع لبنات تبني بها أي جملة عن الوقت."]},{"h":"التطبيق والتلخيص","p":["الحلقة 16: مشهد العودة السنوية — الجداول والقرطاسية والمضارع القريب، كما في الفيديو الرئيسي «Reflets 2 Episode 01» من قناة Jason Mills: شاهد الفيديو الرئيسي مرة أخرى بلا توقف، وتوقف فقط عند جملة futur proche لتكتبها في دفترك ثم تعيد استماعها بصوت الممثل.","جسر الحلقات: من a2-t7-l15 («On déménage» — الانتقال من الموسم الأول إلى الموسم الثاني) إلى a2-t7-l16 (الانطلاقة: العودة السنوية، جدول المواعيد، وأول أسبوع)، ثم إلى a2-t7-l17 حيث تدخل Julie مكتبها الجديد لأول مرة وتعرف على زملائها واحداً واحداً.","المهمة: أعد مشاهدة الحلقة كاملة مع إيقاف كل دقيقة لتكتب جملة واحدة بالمضارع القريب عن أسبوعك أنت، ثم سجّل نفسك تلخّص فيها الحلقة في 60 ثانية بالفرنسية دون قراءة — الهدف أن تنطق « la rentrée » و« le créneau » و« je vais » بصوت لا يتردد."]}],"examples":[{"fr":"Je vais commencer lundi matin.","ar":"سأبدأ يوم الاثنين صباحاً."},{"fr":"On va s'installer dans un nouveau quartier.","ar":"سنسكن في حيّ جديد."},{"fr":"Tu as vu l'emploi du temps ?","ar":"هل رأيتَ جدول المواعيد؟"},{"fr":"À partir de septembre, la cantine ouvre à midi.","ar":"ابتداءً من سبتمبر، يُفتح مطعم المدرسة عند الظهر."},{"fr":"La rentrée des classes a lieu en septembre.","ar":"تعود الدراسة في سبتمبر."},{"fr":"Je vais à la papeterie pour les cahiers.","ar":"أذهب إلى محل القرطاسية لشراء الدفاتر."}],"pron":[{"w":"la rentrée","ipa":"[lə ʁɑ̃.tʁe]","approx":"لا رونتري"},{"w":"la reprise","ipa":"[lə ʁə.pʁiz]","approx":"لا رُبْريز"},{"w":"la cantine","ipa":"[kɑ̃.tin]","approx":"كانتين"},{"w":"bientôt","ipa":"[bjɛ̃.to]","approx":"بيانطو"}],"vocab":[{"fr":"la rentrée des classes","ar":"العودة إلى الدراسة","pos":"nom","g":"f","exFr":"La rentrée des classes a lieu en septembre.","exAr":"تعود الدراسة في سبتمبر.","ipa":"[lə ʁɑ̃.tʁe de klas]"},{"fr":"la papeterie","ar":"محل القرطاسية","pos":"nom","g":"f","exFr":"Je vais à la papeterie pour les cahiers.","exAr":"أذهب إلى محل القرطاسية لشراء الدفاتر.","ipa":"[pa.pə.tʁi]"},{"fr":"le cartable","ar":"الحقيبة المدرسية","pos":"nom","g":"m","exFr":"Son cartable est trop lourd.","exAr":"حقيبته ثقيلة جداً.","ipa":"[kaʁ.tabl]"},{"fr":"le créneau","ar":"فترة من الوقت","pos":"nom","g":"m","exFr":"Tu as un créneau libre mardi ?","exAr":"هل لديك فترة حرة يوم الثلاثاء؟","ipa":"[kʁə.no]"},{"fr":"la cantine","ar":"مطعم المدرسة أو المؤسسة","pos":"nom","g":"f","exFr":"La cantine sert à midi.","exAr":"يُقدَّم الغداء في المطعم عند الظهر.","ipa":"[kɑ̃.tin]"},{"fr":"le cahier","ar":"الدفتر","pos":"nom","g":"m","exFr":"Écris la date dans ton cahier.","exAr":"اكتب التاريخ في دفترك.","ipa":"[ka.je]"},{"fr":"le stylo","ar":"القلم","pos":"nom","g":"m","exFr":"Où est mon stylo ?","exAr":"أين قلمي؟","ipa":"[sti.lo]"},{"fr":"la reprise","ar":"استئناف الدراسة أو العمل","pos":"nom","g":"f","exFr":"La reprise est toujours un peu dure.","exAr":"الاستئناف دائماً قاسٍ قليلاً.","ipa":"[lə ʁə.pʁiz]"},{"fr":"l'emploi du temps","ar":"جدول المواعيد","pos":"nom","g":"m","exFr":"Mon emploi du temps est complet.","exAr":"جدول مواعيدي ممتلئ.","ipa":"[lɑ̃.plwa dy tɑ̃]"},{"fr":"bientôt","ar":"قريباً","pos":"adverbe","exFr":"Bientôt, la semaine commence.","exAr":"قريباً يبدأ الأسبوع.","ipa":"[bjɛ̃.to]"},{"fr":"la liste","ar":"القائمة","pos":"nom","g":"f","exFr":"J'ai fait la liste des courses.","exAr":"صنعتُ قائمة المشتريات.","ipa":"[list]"},{"fr":"organiser","ar":"ينظّم","pos":"verbe","exFr":"Elle organise sa semaine.","exAr":"هي تنظّم أسبوعها.","ipa":"[ɔʁ.ɡa.ni.ze]"}],"grammar":[{"tFr":"Le futur proche : aller + infinitif","tAr":"القاعدة: المضارع القريب","body":["المضارع القريب يُكوَّن من الفعل aller في المضارع + المصدر الكامل: « je vais commencer », « tu vas acheter », « nous allons installer ». دلالة قريبة من المضارع الإنجليزي (going to) وتعبر عن نية أو أمر مقرر في القريب، ولا تُشكَّل مع المصدر أبداً بحرف جر.","مع الضمائر المتصلة يعود الفاعل بين aller والمصدر: « Je vais le commencer. » (لا « je vais à le »)، والنفي يحيط بالفعل المركب: « Je ne vais pas commencer. » — والقاعدة كاملة في خمس كلمات: فاعل + va/vas/allons + مصدر."],"ex":[{"fr":"Je vais acheter une liste de fournitures.","ar":"سأشتري قائمة القرطاسية."},{"fr":"Nous allons organiser la semaine ensemble.","ar":"سنظّم معاً هذا الأسبوع."}]},{"tFr":"Les prépositions de temps : en, à, pendant, le","tAr":"القاعدة: حروف الجر الزمنية","body":["« en » للسنوات والشهور والفترات القصيرة: « en septembre », « en 2026 ». « à » لبداية محددة: « à midi », « à partir de deux heures ». « pendant » للمدة: « pendant les vacances ». و« le » للتكرار الأسبوعي: « le lundi matin » — أي كل اثنين.","« à partir de » تعني ابتداءً من نقطة زمنية ولا تُستبدل بـ « depuis » التي تقيس المدة الماضية: « J'étudie le français depuis deux ans » (مدة) مقابل « À partir de lundi, je travaille ici » (بداية). التفريق بينهما يمنع أكثر خطأ زمني عند المتعلمين."],"ex":[{"fr":"La cantine ouvre en septembre.","ar":"يُفتح مطعم المدرسة في سبتمبر."},{"fr":"À partir de mardi, j'ai un créneau libre.","ar":"ابتداءً من الثلاثاء لديّ فترة حرة."}]}],"mistakes":[{"wrong":"«Je vais à commencer lundi.»","right":"«Je vais commencer lundi.»","why":"بعد «aller» في المضارع القريب يأتي المصدر مباشرة بلا حرف جر — والخطأ ناتج عن الترجمة الحرفية للعربية."},{"wrong":"«le rentrée»","right":"«la rentrée»","why":"كلمة rentrée مؤنثة، والمؤنث هنا ليس صفة بل جنس الاسم نفسه."},{"wrong":"«Bientôt, je vais commence.»","right":"«Bientôt, je vais commencer.»","why":"لا تُوضع نهايات المضارع على المصدر بعد «vais»؛ المصدر يبقى على صورته الأصلية."}],"dialogues":[{"title":"La semaine de la rentrée","ctx":"جيران يتبادلون أخبار أول أسبوع","lines":[{"who":"Marc","fr":"Alors, la rentrée ? Tu commences quand ?","ar":"فما رأيك في العودة؟ متى تبدأ؟"},{"who":"Julie","fr":"Je commence lundi matin, à partir de neuf heures.","ar":"أبدأ يوم الاثنين صباحاً، من الساعة التاسعة."},{"who":"Marc","fr":"Tu as un emploi du temps complet, alors ?","ar":"إذن جدولك ممتلئ؟"},{"who":"Julie","fr":"Oui, avec deux créneaux libres le jeudi après-midi.","ar":"نعم، مع فترتين حرتين يوم الخميس بعد الظهر."},{"who":"Sophie","fr":"N'oublie pas la liste pour la papeterie des enfants.","ar":"لا تنسي القائمة لأمور القرطاسية للأطفال."},{"who":"Marc","fr":"On y va ensemble samedi, si tu veux.","ar":"نذهب معاً يوم السبت إن أحببت."},{"who":"Julie","fr":"Avec plaisir. Ce n'est qu'un début, mais on avance.","ar":"بكل سرور. إنها مجرد بداية، لكننا نتقدّم."}]}],"exercises":[{"t":"mcq","skill":"compréhension","q":"ماذا تخطط Julie لشرائه في la papeterie؟","opts":["une liste de fournitures","un billet de train","un café au lait","une carte postale"],"a":0,"why":"في النص الصوتي قالت Julie : « Je vais acheter une liste de fournitures à la papeterie. »"},{"t":"fill","skill":"grammaire","q":"أكمل بالمضارع القريب: «Je ___ commencer lundi.»","fr":"Je ___ commencer lundi.","ans":"vais","alts":["Vais"],"why":"المضارع القريب: فاعل + va/vas + مصدر."},{"t":"mcq","skill":"vocabulaire","q":"المعنى الصحيح لـ «le créneau» في سياق الحلقة:","opts":["فترة من الوقت","الحقيبة المدرسية","الطابور","الرصيف"],"a":0,"why":"le créneau هو الفترة المتاحة في جدول المواعيد."},{"t":"order","skill":"production","q":"رتّب كلمات الحلقة: جملة Julie عن بداية أسبوعها","words":["Je","vais","commencer","lundi","matin."],"ans":"Je vais commencer lundi matin.","why":"الفاعل + vais + المصدر + الظرف الزمني في النهاية."},{"t":"listen","skill":"écoute","q":"[Écoute] ماذا يقول Marc في أول جملة عن la rentrée؟","opts":["C'est la rentrée, tout le monde est de retour","C'est la fin des vacances, personne n'est là","La rentrée est finie depuis longtemps","Tout le monde est parti à la montagne"],"a":0,"why":"افتتاحية Marc : « Re-bonjour ! Alors, c'est la rentrée, tout le monde est de retour. »"},{"t":"translate","skill":"production","q":"ترجم: «سأبدأ العمل يوم الاثنين في المكتب الجديد.»","ans":"Je vais commencer à travailler lundi dans le nouveau bureau.","alts":["Je vais commencer le lundi dans le nouveau bureau","Je vais commencer à travailler le lundi dans le nouveau bureau"],"why":"aller + مصدر + « dans » للمكان، والظرف الزمني في النهاية."},{"t":"correct","skill":"grammaire","q":"صحّح الخطأ: «Je vais à organiser ma semaine.»","ans":"Je vais organiser ma semaine.","alts":["je vais organiser ma semaine"],"why":"لا حرف جر بين « vais » والمصدر في المضارع القريب."},{"t":"speaking","skill":"prononciation","q":"انطق الجملة ثلاث مرات مع إطالة المقطع الأنفي في « rentrée » و« septembre ».","target":"La rentrée des classes a lieu en septembre.","why":"تدريب المقاطع الأنفية [ɑ̃] في كلمات الحلقة الأساسية."}],"homework":"شاهد الحلقة التالية a2-t7-l17 (أول يوم في المكتب الجديد)، ثم اكتب خمس جمل بالمضارع القريب عن أسبوعك مستعملاً « en » و« à partir de » و« le lundi ». سجّل بعد ذلك تلخيصاً صوتياً مدته 60 ثانية. — Regarde a2-t7-l17 et écris cinq phrases au futur proche sur ta semaine de travail, avec « en », « à partir de » et « le lundi ».","sources":[{"label":"الحلقة الرئيسية","videoId":"LviRrhOeYqY","title":"Reflets 2 Episode 01","channel":"Jason Mills","why":"الحلقة الكاملة — النص الأصلي للمشوار: طبّق ما تعلمه في دروس القواعد والمفردات.","main":true,"extra":false,"cat":"Séries","level":"A2","t":0},{"label":"إثرائي","videoId":"_VWYhgdR_Oo","title":"France: la rentrée scolaire pour 11 millions d'élèves | Journal • Français Facile - RFI","channel":"Français Facile - RFI","why":"نشرة بسيطة عن la rentrée في فرنسا: تثبّت مفردات الحلقة في سياق ثقافي حقيقي يشرح لماذا يعيش سبتمبر هكذا.","main":false,"extra":true,"cat":"Culture","level":"A2"}],"supplements":[{"id":"_VWYhgdR_Oo","videoId":"_VWYhgdR_Oo","title":"France: la rentrée scolaire pour 11 millions d'élèves | Journal • Français Facile - RFI","channel":"Français Facile - RFI","why":"نشرة بسيطة عن la rentrée في فرنسا: تثبّت مفردات الحلقة في سياق ثقافي حقيقي يشرح لماذا يعيش سبتمبر هكذا.","dur":10,"lang":"fr","level":"A2"}]},{"id":"a2-t7-l17","fr":"Épisode 17 — Reflets 2, épisode 2","ar":"الحلقة 17 — الموسم الثاني، الحلقة 2","objectives":["متابعة أول يوم عمل في مكتب جديد وفهم تحيات بيئة العمل الفرنسية","استيعاب مفردات المكتب: l'équipe, le couloir, la machine à café, la pause déjeuner","إتقان ضمائر y وen مع الأفعال الانعكاسية في حوار قصير بطبيعة"],"sections":[{"h":"الدرس","video":{"id":"eioGUrw221U","title":"Reflets 2 Episode 02","channel":"Jason Mills","why":"الحلقة كاملة — الموقف الأول بأصواته الحقيقية: شاهدها لتفهم كيف يبدؤون يومهم في المكتب، ثم أعد الاستماع لالتقاط التحيات والأسئلة القصيرة.","lang":"fr","main":true,"t":0,"dur":12},"p":["الحلقة الثانية من الموسم الثاني تنقلنا من الاستعداد إلى الواقع: Julie تدخل مكتبها الجديد لأول مرة، صعدة في المصعد، جولة قصيرة في الممر، ثم أول حديث أمام ماكينة القهوة. اللافت في المكتب الفرنسي ليس التحيات الرسمية بل ما يحدث في « la pause »: خمس دقائق من الحديث السريع تعلّمك أكثر من صفحة مفردات.","اجعل من الاستماع تمريناً على الأسئلة القصيرة: « Tu habites ici ? », « Tu as des enfants ? », « Tu déjeunes avec nous ? » — كل سؤال يتبعه جواب من كلمتين، وهذه هي إيقاع المحادثات اليومية. أعد المشهد مرتين: الأولى لفهم من يتحدث مع من، والثانية لكتابة الأسئلة التي سمعتها في دفترك.","نحوياً تفتح الحلقة بابَ ضمائر المكان والكمية: « Oui, j'y habite » حيث y تحل محل « à + مكان »، و« J'en ai deux » حيث en تحل محل « de + عدد ». وستلاحظ أيضاً الأفعال الانعكاسية في التعارف: « Je me présente », « Enchantée » — صيغة قصيرة تتكرر كل يوم في كل مكتب فرنسي.","قبل المشاهدة: ركّز في المرة الأولى على فهم الفكرة العامة للموقف دون إيقاف الفيديو، وفي المرة الثانية دوّن الكلمات التي تتكرر — خصوصاً l'équipe، le patron، le couloir — وحاول استنتاج معناها من السياق قبل الرجوع إلى قاموسك.","بعد المشاهدة: تدرّب على ملخص من ثلاث جمل للكتابة — حدّد الشخصيات وما فعلنا وما شعروا به — ثم استمع مرة أخيرة وقارن نطقك بنطق الممثلين، مع انتباه خاص لنقطة قاعدة الدرس كما وردت في الحوار.","تلميح الأداء: أعد تشغيل المقاطع الصعبة بسرعة 0.75، وأوقف الفيديو عند نهاية كل جملة لتكرارها بصوت عالٍ — هذه الطريقة تثبّت المفردات والنطق معاً وتُعدّك جاهزاً لتمارين هذا الدرس وللدرس التالي في السلسلة."],"sub":[{"h":"النص الصوتي (مقتطف)","p":["Karim : Bonjour ! Tu es la nouvelle, non ? Je m'appelle Karim.","Julie : Oui, enchantée. Je viens d'arriver dans le service marketing.","Sophie : Tu habites ici ? Moi, j'habite près de la gare.","Julie : Oui, j'y habite aussi, c'est pratique.","Karim : Tu as des enfants ? J'en ai deux, ils vont à l'école d'ici.","Sophie : Allez, on descend à la machine à café, la pause déjeuner commence."]},{"h":"مفردات الموقف","p":["l'équipe — الفريق","le patron — رئيس العمل","le couloir — الممر","l'accueil — الاستقبال","la machine à café — ماكينة القهوة"]},{"h":"تعبيرات جاهزة للاستماع","p":["On mange à la cafétéria.","La pause déjeuner dure une heure.","C'est une tâche facile.","L'ascenseur est en panne.","Je salue mes collègues."]}]},{"h":"النطق والكلمات المفتاحية","p":["الصوتان الحاكمان هنا هما الهمزة المهموسة والأنف: « j'y habite » تُقال [ʒi.tabit] بلا همس زائد، و« j'en ai deux » تضع [ɑ̃] بامتلاء داخل الأنف في en، و« enchantée » تنتهي بـ é حادّ [e] لا مفتوح. ولاحظ أن « ascenseur » تُنقَّط على المقطع الأخير في النطق الفرنسي، لا على الأول كما نميل إليه نحن.","الأهم نبرة الأسئلة القصيرة: « Tu habites ici ? » تصعد في نهايتها بحركة خفيفة واحدة، بينما « Tu habites ici. » بالجواب تهبط. استمع إلى الفرق بين السؤال والجواب في الحوار ثم قلّد النبرة قبل الكلمات نفسها؛ الفرنسي يفهم سؤالك من طرف الجملة لا من أدوات الاستفهام."]},{"h":"محتوى الحلقة","p":["المشهد الأول: باب المكتب ونداء « Bonjour ! » المتكرر، وتعارف سريع مع Karim الذي يقدّم نفسه أولاً. المشهد الثاني: المصعد والممر، ووصف قصير للمكان: « le service est au deuxième étage ». المشهد الثالث: ماكينة القهوة ودعوة الغداء، وهي اللحظة الاجتماعية الأهم في الحلقة كلها.","المفردات تستخرج من بيئة واحدة: l'équipe (الفريق)، le patron وl'accueil (الرئيس والاستقبال)، le couloir وl'ascenseur (الممر والمصعد)، la machine à café وla cafétéria، la pause déjeuner، la tâche (المهمة المكلّف بها)، discuter وsaluer وdéjeuner. احفظها كخريطة للمكان لا كقائمة كلمات.","نحوياً تعمل y وen على نفس النمط: ضمير متصل يحل محل جملة كاملة. « J'y vais » = « je vais au bureau ». « J'en parle » = « je parle du projet ». ومع الأفعال الانعكاسية يعود الضمير على الفاعل نفسه: « Je me présente » لا « je présente moi » — وهذه هي أكثر مفردة تُنطق خطأً في اليوم الأول."]},{"h":"التطبيق والتلخيص","p":["الحلقة 17: أول يوم في المكتب — التحيات، المصعد، وماكينة القهوة، كما في الفيديو الرئيسي «Reflets 2 Episode 02» من قناة Jason Mills: شاهد الفيديو الرئيسي مرة أخرى وارفع صوت التحيات لتقلّدها بصوتٍ مسموع، ثم أعد الاطلاع على النص الصوتي لكتابة كل سؤال سمعته.","جسر الحلقات: من a2-t7-l16 (العودة السنوية والجدول والقرطاسية) إلى a2-t7-l17 (أول يوم عمل: الزملاء، الممر، وماكينة القهوة)، ثم إلى a2-t7-l18 حيث يذهب Marc إلى la poste لإرسال طرده ويسمع جملة سيعيدها لاحقاً بصيغة السرد.","المهمة: أعد مشاهدة الحلقة كاملة، ثم سجّل نفسك تلخّص فيها الحلقة في 60 ثانية مستعملاً ثلاث كلمات مفتاحية من المفردات الاثني عشر، واضبط فيها ضمرين y وen على الأقل — هذا هو اختبار الحفظ الحقيقي."]}],"examples":[{"fr":"Tu habites ici ? — Oui, j'y habite.","ar":"تسكن هنا؟ — نعم، أسكن هنا."},{"fr":"Tu as des enfants ? — J'en ai deux.","ar":"عندك أطفال؟ — عندي اثنان."},{"fr":"Je me présente : Julie, du service marketing.","ar":"أقدّم نفسي: جولي، من قسم التسويق."},{"fr":"On déjeune à la cafétéria ?","ar":"نتناول الغداء في مقهى المؤسسة؟"},{"fr":"Toute l'équipe est là.","ar":"الفريق كله موجود."},{"fr":"Le patron arrive à neuf heures.","ar":"يصل رئيس العمل في الساعة التاسعة."}],"pron":[{"w":"j'y habite","ipa":"[ʒi.ta.bit]","approx":"جيتابيت"},{"w":"j'en ai deux","ipa":"[ʒɑ̃.ne dø]","approx":"جانْي دُو"},{"w":"enchantée","ipa":"[ɑ̃.ʃɑ̃.te]","approx":"انشانتي"},{"w":"l'ascenseur","ipa":"[la.sɑ̃.sœʁ]","approx":"لاسانسُور"}],"vocab":[{"fr":"l'équipe","ar":"الفريق","pos":"nom","g":"f","exFr":"Toute l'équipe est là.","exAr":"الفريق كله موجود.","ipa":"[le.kip]"},{"fr":"le patron","ar":"رئيس العمل","pos":"nom","g":"m","exFr":"Le patron arrive à neuf heures.","exAr":"يصل رئيس العمل في الساعة التاسعة.","ipa":"[pə.tʁɔ̃]"},{"fr":"le couloir","ar":"الممر","pos":"nom","g":"m","exFr":"Les bureaux sont dans le couloir.","exAr":"المكاتب في الممر.","ipa":"[ku.lwaʁ]"},{"fr":"l'accueil","ar":"الاستقبال","pos":"nom","g":"m","exFr":"L'accueil est au rez-de-chaussée.","exAr":"الاستقبال في الطابق الأرضي.","ipa":"[la.kœj]"},{"fr":"la machine à café","ar":"ماكينة القهوة","pos":"nom","g":"f","exFr":"La machine à café est dans la salle.","exAr":"ماكينة القهوة في القاعة.","ipa":"[la ma.ʃin a ka.fe]"},{"fr":"la cafétéria","ar":"مقهى المؤسسة","pos":"nom","g":"f","exFr":"On mange à la cafétéria.","exAr":"نتناول الطعام في مقهى المؤسسة.","ipa":"[ka.fe.te.ʁja]"},{"fr":"la pause déjeuner","ar":"استراحة الغداء","pos":"nom","g":"f","exFr":"La pause déjeuner dure une heure.","exAr":"تستمر استراحة الغداء ساعة.","ipa":"[poz de.ʒø.ne]"},{"fr":"la tâche","ar":"المهمة","pos":"nom","g":"f","exFr":"C'est une tâche facile.","exAr":"إنها مهمة سهلة.","ipa":"[taʃ]"},{"fr":"l'ascenseur","ar":"المصعد","pos":"nom","g":"m","exFr":"L'ascenseur est en panne.","exAr":"المصعد معطّل.","ipa":"[la.sɑ̃.sœʁ]"},{"fr":"saluer","ar":"يُحيّي","pos":"verbe","exFr":"Je salue mes collègues.","exAr":"أُحيّي زملائي.","ipa":"[salɥe]"},{"fr":"déjeuner","ar":"يتناول الغداء","pos":"verbe","exFr":"Ils déjeunent à midi.","exAr":"يتناولون الغداء عند الظهر.","ipa":"[de.ʒø.ne]"},{"fr":"discuter","ar":"يُناقش","pos":"verbe","exFr":"On discute du projet à la pause.","exAr":"نناقش المشروع أثناء الاستراحة.","ipa":"[dis.ky.te]"}],"grammar":[{"tFr":"Les pronoms y et en","tAr":"القاعدة: ضميرا y و en","body":["y تحل محل « à + مكان أو أمر » وتوضع قبل الفعل: « Tu habites à Paris ? — Oui, j'y habite. » و« Tu penses au dossier ? — Oui, j'y pense. ». وen تحل محل « de + كمية أو عدد أو جزء »: « Tu as des enfants ? — J'en ai deux. » و« Tu veux du café ? — J'en veux bien. ».","مع المضارع القريب ينفصل المركب: « Je vais y aller. » لا « je vais aller y »، ومع الأوامر: « Allez-y ! », « Allez-en parler ! » — والضميران لا يجتمعان أبداً في مكان واحد: إن احتجت الاثنين ضع en أولاً: « J'en ai parlé, j'y vais. »."],"ex":[{"fr":"Vous habitez près de la gare ? Moi, j'y habite aussi.","ar":"تسكنون قرب المحطة؟ وأنا أسكن هناك أيضاً."},{"fr":"Il y a des places ? — Oui, il y en a deux.","ar":"هل هناك أماكن؟ — نعم، هناك اثنتان."}]},{"tFr":"Les verbes pronominaux : se présenter, se saluer","tAr":"القاعدة: الأفعال الانعكاسية","body":["الفعل الانعكاسي يتضمن ضميراً يعود على الفاعل: « je me présente », « tu te présentes », « il se présente ». وفي التعارف تُستعمل بصيغة القصر: « Je m'appelle Karim », « Enchantée ». وينفي بالحرف ne ولا يتبعه فاعل منفصل: « Je ne me présente pas. ».","مع الأزمنة يتصرف كغيره: مضارع « elle se lève », ماضٍ « elle s'est levée », أمر « présentez-vous ! ». وانتبه إلى الحذف في النفي: « Elle ne se présente jamais. » — والضمير الانعكاسي لا يُفصل عن الفعل مطلقاً."],"ex":[{"fr":"Je me présente : Julie, du service marketing.","ar":"أقدّم نفسي: جولي، من قسم التسويق."},{"fr":"Ils se saluent chaque matin dans le couloir.","ar":"يتبادلون التحية كل صباح في الممر."}]}],"mistakes":[{"wrong":"«J'ai des enfants, je les ai deux.»","right":"«J'en ai deux.»","why":"en هي الضمير الصحيح للكمية والعدد المجرّد عن المعدود، ولا يُستعمل les هنا."},{"wrong":"«Je me présente moi.»","right":"«Je me présente.»","why":"الضمير الانعكاسي متصل بالفعل ولا يُكرَّر بضمير منفصل بعده."},{"wrong":"«Je viens de arriver.»","right":"«Je viens d'arriver.»","why":"إلزام الهمزة: de تُكتب d' قبل مصدر يبدأ بحرف علة — والخطأ سمعي وإملائي معاً."}],"dialogues":[{"title":"Premier jour de travail","ctx":"تعارف سريع في الممر","lines":[{"who":"Karim","fr":"Bonjour ! Tu es la nouvelle, non ?","ar":"صباح الخير! أنتِ الجديدة، أليس كذلك؟"},{"who":"Julie","fr":"Oui, enchantée. Je viens d'arriver dans le service.","ar":"نعم، سعيدة بلقائك. وصلتُ للتو إلى القسم."},{"who":"Karim","fr":"Tu habites ici ? Moi, j'habite près de la gare.","ar":"تسكنين هنا؟ وأنا أسكن قرب المحطة."},{"who":"Julie","fr":"Oui, j'y habite aussi, c'est pratique.","ar":"نعم، أسكن هناك أيضاً، إنه عملي."},{"who":"Sophie","fr":"Tu as des enfants ? J'en ai deux.","ar":"عندك أطفال؟ عندي اثنان."},{"who":"Julie","fr":"J'en ai un, il va à l'école d'ici.","ar":"عندي واحد، يذهب إلى مدرسة هنا."},{"who":"Sophie","fr":"Allez, on descend à la machine à café !","ar":"هيا، ننزل إلى ماكينة القهوة!"}]}],"exercises":[{"t":"mcq","skill":"compréhension","q":"من الذي يقابل Julie أولاً في المكتب؟","opts":["Karim","Le facteur","Le gardien du square","Le patron de la poste"],"a":0,"why":"الافتتاحية: « Bonjour ! Tu es la nouvelle, non ? Je m'appelle Karim. »"},{"t":"fill","skill":"grammaire","q":"أكمل بالضمير المناسب: «Tu as des enfants ? — Oui, ___ ai deux.»","fr":"Tu as des enfants ? — Oui, ___ ai deux.","ans":"j'en","alts":["J'en"],"why":"en تحل محل « de + عدد »، وتتصل بـ j' في النطق."},{"t":"mcq","skill":"vocabulaire","q":"المعنى الصحيح لـ «la pause déjeuner»:","opts":["استراحة الغداء","الاجتماع الصباحي","الممر الطويل","الحقيبة المهنية"],"a":0,"why":"الاستراحة التي ينزل فيها الجميع إلى ماكينة القهوة أو المقهى."},{"t":"order","skill":"production","q":"رتّب كلمات الحلقة: تعريف Julie بنفسها","words":["Je","me","présente","du","service","marketing."],"ans":"Je me présente du service marketing.","why":"الفاعل + الانعكاسي + مصدر التقديم + الجملة الاسمية في النهاية."},{"t":"listen","skill":"écoute","q":"[Écoute] ما السؤال الذي تسأله Sophie عن السكن؟","opts":["Tu habites ici ?","Tu travailles où ?","Tu aimes le café ?","Tu viens avec nous ?"],"a":0,"why":"Sophie: « Tu habites ici ? Moi, j'habite près de la gare. »"},{"t":"translate","skill":"production","q":"ترجم: «عندك أطفال؟ نعم، عندي اثنان يذهبان إلى المدرسة هنا.»","ans":"Tu as des enfants ? Oui, j'en ai deux qui vont à l'école ici.","alts":["Tu as des enfants ? Oui, j'en ai deux qui vont à l'école d'ici"],"why":"en للكمية، وجملة وصفية بـ « qui » في النهاية."},{"t":"correct","skill":"grammaire","q":"صحّح الخطأ: «Je me présente moi.»","ans":"Je me présente.","alts":["je me présente"],"why":"الضمير الانعكاسي مضموم إلى الفعل ولا يُكرَّر بـ « moi »."},{"t":"speaking","skill":"production","q":"قدّم نفسك في ثلاث جمل كما تفعل في أول يوم عمل، مع استخدام y وen.","target":"Je m'appelle Julie, je viens d'arriver dans le service.","why":"إنتاج التعريف بالنفس في وضعية حقيقية مع ضمائر الحلقة."}],"homework":"شاهد الحلقة التالية a2-t7-l18 (رحلة Marc إلى la poste)، واكتب عشر كلمات تسمعها عن البريد، ثم سجّل تلخيصاً صوتياً مدته 60 ثانية لأول يوم عمل مع استخدام y وen. — Regarde a2-t7-l18 et relève les dix mots de la poste que tu entends, puis apprends-les.","sources":[{"label":"الحلقة الرئيسية","videoId":"eioGUrw221U","title":"Reflets 2 Episode 02","channel":"Jason Mills","why":"الحلقة الكاملة — النص الأصلي للمشوار: طبّق ما تعلمه في دروس القواعد والمفردات.","main":true,"extra":false,"cat":"Séries","level":"A2","t":0},{"label":"إثرائي","videoId":"BEVE2OrLqCU","title":"46 | Dialogues en français pour parler avec vos collègues au travail | A1 à B2","channel":"Apprendre le français avec Ama - تعلم الفرنسية","why":"حوارات جاهزة مع الزملاء والرؤساء: تمديد لمفردات الحلقة في مواقف مكتبية كثيرة تسمعها كل يوم.","main":false,"extra":true,"cat":"Conversation","level":"A2"}],"supplements":[{"id":"BEVE2OrLqCU","videoId":"BEVE2OrLqCU","title":"46 | Dialogues en français pour parler avec vos collègues au travail | A1 à B2","channel":"Apprendre le français avec Ama - تعلم الفرنسية","why":"حوارات جاهزة مع الزملاء والرؤساء: تمديد لمفردات الحلقة في مواقف مكتبية كثيرة تسمعها كل يوم.","dur":14,"lang":"fr","level":"A2"}]},{"id":"a2-t7-l18","fr":"Épisode 18 — Reflets 2, épisode 3","ar":"الحلقة 18 — الموسم الثاني، الحلقة 3","objectives":["متابعة مواقف la poste الفرنسية: الطابور، الشباك، والطوابع","استيعاب مفردات البريد: le colis, le timbre, la file d'attente, l'avis","إتقان الجملة المركّبة عبر le discours indirect مع que"],"sections":[{"h":"الدرس","video":{"id":"SNFHhLupxmo","title":"Reflets 2 -  03 1","channel":"Evgeny Dronov","why":"الحلقة كاملة — موقف يومي بامتياز: راقب كيف يتبادل الأدوار عند الشباك بين زبون وموظف، فهي مسرحيتك الأولى في الإدارية الفرنسية.","lang":"fr","main":true,"t":0,"dur":13},"p":["الحلقة الثالثة تأخذنا إلى la poste: طرد لم يصل، إشعار على الباب، ثم رحلة قصيرة إلى مكتب البريد. في فرنسا لا يُرسل الطرد إلا بعد المرور بالطابور وبالوزن والدفع، وكل هذه الخطوات تُقال بجمل قصيرة ثابتة تسمعها مرة فتفهمها مدى الحياة.","الاستماع هنا درس على الأدوار: دور الموظف يطرح أسئلة قصيرة (« Vous avez l'avis ? », « C'est pour qui ? »)، ودور الزبون يجيب بجمل قصيرة أيضاً. اضبط أذنك على هذه الإيقاعية: سؤال من ثلاث كلمات، جواب من أربع، ثم رقم أو سعر — وهذا هو نص البريد الفرنسي كله.","نحوياً تفتح الحلقة باب الجملة المركّبة: عندما يروي Marc ما قاله موظف البريد أو أخته، تنتقل من الكلام المباشر إلى « Il a dit que le colis arriverait demain. » — زمن يتحرك خطوة إلى الوراء، وحرف que يربط الجملتين. ومعها تتقن الأرقام والأسعار: « six euros cinquante », « trois kilos » — لغة لا تُهمل.","قبل المشاهدة: ركّز في المرة الأولى على فهم الفكرة العامة للموقف دون إيقاف الفيديو، وفي المرة الثانية دوّن الكلمات التي تتكرر — خصوصاً le colis، la poste، le timbre — وحاول استنتاج معناها من السياق قبل الرجوع إلى قاموسك.","بعد المشاهدة: تدرّب على ملخص من ثلاث جمل للكتابة — حدّد الشخصيات وما فعلنا وما شعروا به — ثم استمع مرة أخيرة وقارن نطقك بنطق الممثلين، مع انتباه خاص لنقطة قاعدة الدرس كما وردت في الحوار.","تلميح الأداء: أعد تشغيل المقاطع الصعبة بسرعة 0.75، وأوقف الفيديو عند نهاية كل جملة لتكرارها بصوت عالٍ — هذه الطريقة تثبّت المفردات والنطق معاً وتُعدّك جاهزاً لتمارين هذا الدرس وللدرس التالي في السلسلة."],"sub":[{"h":"النص الصوتي (مقتطف)","p":["Marc : Bonjour, je viens retirer un colis. J'ai un avis de passage.","Agent : Bonjour. Vous avez l'avis et une pièce d'identité ?","Marc : Oui, les voici. Le colis vient de ma sœur, elle dit qu'il est lourd.","Agent : Il pèse trois kilos. Le tarif est de six euros cinquante.","Marc : D'accord. Je peux aussi acheter dix timbres ?","Agent : Bien sûr. La file d'attente est à droite, ce n'est pas long."]},{"h":"مفردات الموقف","p":["le colis — الطرد","la poste — مكتب البريد","le timbre — الطابع البريدي","la carte postale — البطاقة البريدية","la file d'attente — طابور الانتظار"]},{"h":"تعبيرات جاهزة للاستماع","p":["Le guichet numéro trois.","L'expéditeur est à Lyon.","Le tarif a changé cette année.","La boîte aux lettres est pleine.","J'ai trouvé un avis sur ma porte."]}]},{"h":"النطق والكلمات المفتاحية","p":["انتبه إلى نهايات الكلمات: « le colis » تُنطق [kɔ.li] فالحرف s الأخير مكتوب لكنه صامت، بينما « le timbre » تُحفظ بـ [b] الخفية وتنطق [tɛ̃bʁ] مع مقطع أنفي واحد. و« le guichet » الجيم فيها خفيفة كالشين المهموسة [ʃ]، وهي من أكثر الأصوات التي يخطئ فيها المبتدئ فيسمّيها « جي » قوية.","الحروف اللفظية هنا كثيرة: « la file d'attente » تُقال [fil.dɑ̃t] بحذف t الثانية وربط النون بـ d، و« six euros » تُقال [sizø.ʁo] بروابط ثلاث. استمع إلى الموظف في النص الصوتي وقلّد الجملة ككتلة واحدة، ثم افصل كلماتها ببطء — هذه تقنية « التفكيك بعد الإدماج » وأنفعها في البريد والبنك والمطار."]},{"h":"محتوى الحلقة","p":["المشهد الأول: الإشعار على باب الشقة وقرار الذهاب إلى la poste. المشهد الثاني: الطابور والانتظار القصير وسؤال الجارة عن الطوابع. المشهد الثالث: الشباك — الوزن، السعر، الدفع، ثم خروج Marc ومعه الطرد وعشرة طوابع لرسائله القادمة.","المفردات مرتّبة على مسار الزبون: l'avis (الإشعار)، la file d'attente (الطابور)، le guichet (الشباك)، le colis (الطرد)، l'expéditeur، la boîte aux lettres (صندوق البريد)، le timbre و la carte postale و le courrier، le tarif (التعرفة)، expédier و recevoir. تعلّمها بالترتيب فستتذكرها كمشهد لا كقائمة.","نحوياً، القاعدة الأولى هي le discours indirect: « Elle a expliqué que le tarif avait changé. » — نلاحظ أن المضارع يصبح imparfait والحاضر يصبح futur dans le récit. والقاعدة الثانية عملية: الأرقام والسعر: « ça fait six euros cinquante », « ça coûte trois euros » — قلّدها بصوت عالٍ حتى تصبح رد فعل لا تفكير."]},{"h":"التطبيق والتلخيص","p":["الحلقة 18: رحلة إلى la poste — الإشعار، الطابور، الشباك، والطرد، كما في الفيديو الرئيسي «Reflets 2 - 03 1» من قناة Evgeny Dronov: شاهد الفيديو الرئيسي مرة أخرى وتوقف عند كل جملة سؤال/جواب لتكتبها في دفترك، ثم أعد الاستماع بسرعة طبيعية.","جسر الحلقات: من a2-t7-l17 (أول يوم عمل والزملاء وماكينة القهوة) إلى a2-t7-l18 (la poste: الطرد، الطابور، والجملة المركّبة)، ثم إلى a2-t7-l19 حيث يجلس شخص وحيد على مقعده في الساحة وتفتح له الكلمات الودودة باب حديث لا يُنسى.","المهمة: أعد مشاهدة الحلقة كاملة، ثم سجّل نفسك تلخّص فيها الحلقة في 60 ثانية مستعملاً جملة سرد واحدة بـ « que »، وثلاثة أرقام على الأقل من أرقام الوزن والسعر — فهذا ما يثبت أنك فهمت لا أنك حفظت."]}],"examples":[{"fr":"Je viens retirer un colis.","ar":"جئتُ لاستلام طرد."},{"fr":"Le tarif est de six euros cinquante.","ar":"التعرفة ستة يورو ونصف."},{"fr":"L'agent a dit que le colis arriverait demain.","ar":"قال موظف البريد إن الطرد سيصل غداً."},{"fr":"Je peux acheter dix timbres, s'il vous plaît.","ar":"هل يمكنني شراء عشرة طوابع من فضلك؟"},{"fr":"Le colis est trop lourd.","ar":"الطرد ثقيل جداً."},{"fr":"La poste ferme à midi.","ar":"يُغلق مكتب البريد عند الظهر."}],"pron":[{"w":"le colis","ipa":"[kɔ.li]","approx":"كولي"},{"w":"le guichet","ipa":"[ɡi.ʃɛ]","approx":"جيْشِي"},{"w":"la file d'attente","ipa":"[fil.dɑ̃t]","approx":"فيلْدانت"},{"w":"le timbre","ipa":"[tɛ̃bʁ]","approx":"تانْبر"}],"vocab":[{"fr":"le colis","ar":"الطرد","pos":"nom","g":"m","exFr":"Le colis est trop lourd.","exAr":"الطرد ثقيل جداً.","ipa":"[kɔ.li]"},{"fr":"la poste","ar":"مكتب البريد","pos":"nom","g":"f","exFr":"La poste ferme à midi.","exAr":"يُغلق مكتب البريد عند الظهر.","ipa":"[lə pɔst]"},{"fr":"le timbre","ar":"الطابع البريدي","pos":"nom","g":"m","exFr":"Je voudrais dix timbres.","exAr":"أريد عشرة طوابع.","ipa":"[tɛ̃bʁ]"},{"fr":"la carte postale","ar":"البطاقة البريدية","pos":"nom","g":"f","exFr":"Elle envoie une carte postale.","exAr":"ترسل بطاقة بريدية.","ipa":"[laʁt pɔstal]"},{"fr":"la file d'attente","ar":"طابور الانتظار","pos":"nom","g":"f","exFr":"La file d'attente est longue.","exAr":"طابور الانتظار طويل.","ipa":"[la fil dɑ̃t]"},{"fr":"le guichet","ar":"الشباك الإداري","pos":"nom","g":"m","exFr":"Le guichet numéro trois.","exAr":"الشباك رقم ثلاثة.","ipa":"[ɡi.ʃɛ]"},{"fr":"l'expéditeur","ar":"المرسِل","pos":"nom","g":"m","exFr":"L'expéditeur est à Lyon.","exAr":"المرسِل في ليون.","ipa":"[lɛk.spe.di.tœʁ]"},{"fr":"le tarif","ar":"التعرفة","pos":"nom","g":"m","exFr":"Le tarif a changé cette année.","exAr":"تغيّرت التعرفة هذا العام.","ipa":"[ta.ʁif]"},{"fr":"la boîte aux lettres","ar":"صندوق البريد","pos":"nom","g":"f","exFr":"La boîte aux lettres est pleine.","exAr":"صندوق البريد ممتلئ.","ipa":"[bwat o lɛtʁ]"},{"fr":"l'avis","ar":"الإشعار","pos":"nom","g":"m","exFr":"J'ai trouvé un avis sur ma porte.","exAr":"وجدتُ إشعاراً على بابي.","ipa":"[la.vi]"},{"fr":"expédier","ar":"يُرسل","pos":"verbe","exFr":"J'expédie le colis demain.","exAr":"أرسل الطرد غداً.","ipa":"[ɛk.spe.dje]"},{"fr":"recevoir","ar":"يستلم","pos":"verbe","exFr":"Je reçois le colis jeudi.","exAr":"أستلم الطرد يوم الخميس.","ipa":"[ʁəsə.vwaʁ]"}],"grammar":[{"tFr":"Le discours indirect : dire, expliquer + que","tAr":"القاعدة: الكلام غير المباشر","body":["لنقل ما قاله أحد دون تكرار كلماته، نستعمل « que » مع تغيير الزمن خطوة إلى الوراء: « Il dit : 'Je viens. ' » تصبح « Il dit qu'il vient. »، و« Il a dit : 'Je viendrai. ' » تصبح « Il a dit qu'il viendrait. » — والمضارع البسيط في الكلام المباشر يبقى مضارعاً بعد « présent narratif » إن كان الخبر ما زال صحيحاً.","مع الأفعال المنفية أو الاستفهامية يبقى التغيير نفسه: « Elle a demandé si le colis était parti. » (si للاستفهام) و« Ils ont expliqué que le tarif n'avait pas changé. » (نفي بلا تكرار ne... pas من الكلام المباشر). ثلاث صيغ تكفي A2: que للخبر، si للاستفهام، ونفي واحد بـ n'avait pas."],"ex":[{"fr":"L'agent a dit que le colis arriverait demain.","ar":"قال الموظف إن الطرد سيصل غداً."},{"fr":"Elle a expliqué que le tarif avait changé.","ar":"شرحت أن التعرفة قد تغيّرت."}]},{"tFr":"Les chiffres et le prix : ça fait, ça coûte","tAr":"القاعدة: الأرقام والسعر","body":["لقول السعر تستعمل « ça fait » للحساب و« ça coûte » للثمن: « Ça fait six euros cinquante. » و« Ça coûte trois euros. »، والكسر يُقرأ بالواو في الفرنسية: 6,50 تُقال « six euros cinquante » لا « virgule cinquante ».","مع الكيلوغرام والوزن: « Il pèse trois kilos. »، ومع العدد يبقى الاسم مفرداً في الجملة الوصفية: « dix timbres » لا « dix de timbres ». وانتبه إلى الروابط في النطق: « six_euros » [sizø.ʁo] و« dix_h Euros » — الروابط تصنع الفرق بين نطق متذبذب ونطق طبيعي."],"ex":[{"fr":"Ça fait six euros cinquante.","ar":"المجموع ستة يورو ونصف."},{"fr":"Je voudrais dix timbres, s'il vous plaît.","ar":"أريد عشرة طوابع من فضلك."}]}],"mistakes":[{"wrong":"«Il a dit que je viens demain.»","right":"«Il a dit que je viendrais demain.»","why":"في الكلام غير المباشر يتحرّك الزمن خطوة إلى الوراء: المضارع يصير شرطاً أو مستقبلاً في السرد."},{"wrong":"«J'ai envoyé un colis ma mère.»","right":"«J'ai envoyé un colis à ma mère.»","why":"الإضافة الثانية (المخاطب) تأخذ حرف الجر à، والترتيب: فعل + شيء + à + شخص."},{"wrong":"«la colis»","right":"«le colis»","why":"colis اسم مذكر، والتأنيث هنا خطأ شائع عند من يربطه بصوت -s الختامي."}],"dialogues":[{"title":"À la poste","ctx":"عند الشباك","lines":[{"who":"Marc","fr":"Bonjour, je viens retirer un colis.","ar":"صباح الخير، جئت لاستلام طرد."},{"who":"Agent","fr":"Vous avez l'avis et une pièce d'identité ?","ar":"هل معك الإشعار ووثيقة الهوية؟"},{"who":"Marc","fr":"Oui, les voici. Ma sœur dit qu'il est lourd.","ar":"نعم، هما معي. تقول أختي إنه ثقيل."},{"who":"Agent","fr":"Il pèse trois kilos. Le tarif est de six euros cinquante.","ar":"وزنه ثلاثة كيلوغرامات. التعرفة ستة يورو ونصف."},{"who":"Marc","fr":"Très bien. Je peux acheter dix timbres en plus ?","ar":"جيد جداً. هل يمكنني شراء عشرة طوابع إضافية؟"},{"who":"Agent","fr":"Bien sûr. Allez au guichet numéro deux.","ar":"بالتأكيد. اذهب إلى الشباك رقم اثنين."},{"who":"Marc","fr":"Merci beaucoup, bonne journée !","ar":"شكراً جزيلاً، أتمنى لك يوماً سعيداً!"}]}],"exercises":[{"t":"mcq","skill":"compréhension","q":"لماذا يذهب Marc إلى la poste؟","opts":["لإرسال واستلام طرد","لشراء الخبز","للتعرف على جارته","لتغيير جدول عمله"],"a":0,"why":"معه avis de passage لاستلام الطرد، ويطلب في النهاية عشرة طوابع."},{"t":"fill","skill":"grammaire","q":"أكمل بالزمن الصحيح: «L'agent a dit que le colis ___ demain.» (viendre)","fr":"L'agent a dit que le colis ___ demain.","ans":"viendrait","alts":["Viendrait"],"why":"بعد « a dit que » ينتقل المستقبل إلى الشرط في السرد."},{"t":"mcq","skill":"vocabulaire","q":"المعنى الصحيح لـ «la file d'attente»:","opts":["طابور الانتظار","الشباك الإداري","الطابع البريدي","صندوق البريد"],"a":0,"why":"السطر الذي يقف فيه الزبائن قبل الشباك."},{"t":"order","skill":"production","q":"رتّب كلمات الحلقة: جملة Marc عند الشباك","words":["Je","viens","retirer","un","colis","s'il","vous","plaît."],"ans":"Je viens retirer un colis s'il vous plaît.","why":"« venir + infinitif » ثم المفعول، والتكليف في النهاية."},{"t":"listen","skill":"écoute","q":"[Écoute] كم يبلغ وزن الطرد حسب الموظف؟","opts":["trois kilos","deux kilos","cinq kilos","un kilo"],"a":0,"why":"الموظف: « Il pèse trois kilos. »"},{"t":"translate","skill":"production","q":"ترجم: «قال الموظف إن الطرد سيصل غداً.»","ans":"L'agent a dit que le colis arriverait demain.","alts":["L'agent a dit que le colis viendrait demain"],"why":"الكلام غير المباشر مع que + زمن الشرط في السرد."},{"t":"correct","skill":"grammaire","q":"صحّح الخطأ: «J'ai envoyé un colis ma mère.»","ans":"J'ai envoyé un colis à ma mère.","alts":["j'ai envoyé un colis à ma mère"],"why":"المخاطب يأخذ à بعد المفعول المباشر."},{"t":"speaking","skill":"prononciation","q":"انطق جملة السعر بروابط طبيعية، مع إطالة « cinquante » الأنفية.","target":"Le tarif est de six euros cinquante.","why":"تدريب الأرقام والسعر وحروف اللفظ في النهاية."}],"homework":"شاهد الحلقة التالية a2-t7-l19 (الشخص الوحيد على مقعده في الساحة)، وانتبه إلى العبارات المهذّبة التي تفتح بها المحادثة، ثم سجّل تلخيصاً صوتياً مدته 60 ثانية لرحلة Marc إلى البريد. — Regarde a2-t7-l19 et repère les phrases polies que les personnages utilisent pour ouvrir la conversation.","sources":[{"label":"الحلقة الرئيسية","videoId":"SNFHhLupxmo","title":"Reflets 2 -  03 1","channel":"Evgeny Dronov","why":"الحلقة الكاملة — النص الأصلي للمشوار: طبّق ما تعلمه في دروس القواعد والمفردات.","main":true,"extra":false,"cat":"Séries","level":"A2","t":0},{"label":"إثرائي","videoId":"fTeMq8xYdYA","title":"L'incroyable histoire du service postal en France ✉️","channel":"Gallia - notre histoire de France","why":"قصة الخدمة البريدية في فرنسا في أربع دقائق: يعطي لزيارة la poste بعداً ثقافياً يثبّت مفردات الحلقة.","main":false,"extra":true,"cat":"Culture","level":"A2"}],"supplements":[{"id":"fTeMq8xYdYA","videoId":"fTeMq8xYdYA","title":"L'incroyable histoire du service postal en France ✉️","channel":"Gallia - notre histoire de France","why":"قصة الخدمة البريدية في فرنسا في أربع دقائق: يعطي لزيارة la poste بعداً ثقافياً يثبّت مفردات الحلقة.","dur":4,"lang":"fr","level":"A2"}]},{"id":"a2-t7-l19","fr":"Épisode 19 — Seul, sur son banc","ar":"الحلقة 19 — وحيدٌ على مقعده","objectives":["متابعة مشهد الساحة: كيف يبدأ حديث بين غرباء بلباقة","استيعاب مفردات الساحة والمشي: le square, la promenade, le passant, la fraîcheur","استعمال الشرط المضارع للتهذيب والتمني مع l'imparfait لوصف المشهد"],"sections":[{"h":"الدرس","video":{"id":"uDVZEOtzISE","title":"Reflets 2 Episode 04","channel":"Jason Mills","why":"الحلقة كاملة — إيقاع هادئ وأصوات حية للساحة: استمع إليها مرة كاملة قبل الشرح لتلتقط نبرة الحديث الودود.","lang":"fr","main":true,"t":0,"dur":11},"p":["الحلقة الرابعة تغيّر الإيقاع بعد المكتب والبريد: رجل متقاعد يجلس وحيداً على مقعده في ساحة صغيرة، ومعه حليب وجريدة، ونظرة تعرف كل شجرة. العنوان نفسه « Seul, sur son banc » يقول إن الحكاية عن الوحدة، لكن ما يليه يقول إن الوحدة قد تنكسر بكلمة واحدة مهذّبة.","إيقاع الحلقة بطيء ومقصود: جملة، ثم صمت، ثم جملة أطول قليلاً. هذه أفضل تدريب على الاستماع الحقيقي، لأنك ستتعلّم أن تملأ الفراغ بالسياق لا بالكلمات. ركّز على العبارات القصيرة: « Bonjour », « Il fait frais », « C'est agréable », « Venez » — وهي أدوات فتح أي حديث في الشارع الفرنسي.","نحوياً تفتح الحلقة صندوق الشرط المضارع: « Je voudrais vous montrer quelque chose. » ليست مستقبلاً بل تهذيباً وتمنياً، و« Je pourrais revenir demain. » احتمال لطيف. ومعها يعود الوصف إلى l'imparfait: « Il faisait frais », « Il s'asseyait ici chaque jour » — الزمن الذي يرسم الخلفية قبل أن يتحرك الحدث.","قبل المشاهدة: ركّز في المرة الأولى على فهم الفكرة العامة للموقف دون إيقاف الفيديو، وفي المرة الثانية دوّن الكلمات التي تتكرر — خصوصاً la promenade، le square، un inconnu — وحاول استنتاج معناها من السياق قبل الرجوع إلى قاموسك.","بعد المشاهدة: تدرّب على ملخص من ثلاث جمل للكتابة — حدّد الشخصيات وما فعلنا وما شعروا به — ثم استمع مرة أخيرة وقارن نطقك بنطق الممثلين، مع انتباه خاص لنقطة قاعدة الدرس كما وردت في الحوار.","تلميح الأداء: أعد تشغيل المقاطع الصعبة بسرعة 0.75، وأوقف الفيديو عند نهاية كل جملة لتكرارها بصوت عالٍ — هذه الطريقة تثبّت المفردات والنطق معاً وتُعدّك جاهزاً لتمارين هذا الدرس وللدرس التالي في السلسلة."],"sub":[{"h":"النص الصوتي (مقتطف)","p":["Le retraité : Bonjour. Il fait frais aujourd'hui, n'est-ce pas ?","Julie : Oui, c'est agréable. Vous venez souvent dans ce square ?","Le retraité : Tous les jours, après ma promenade. Je m'assois ici depuis trente ans.","Julie : C'est votre banc préféré, alors !","Le retraité : Venez, je vous montre la fontaine. Je voudrais vous montrer quelque chose.","Julie : Volontiers ! Je peux m'asseoir un moment, ce n'est pas gênant ?"]},{"h":"مفردات الموقف","p":["la promenade — النزهة والمشي","le square — الساحة العامة","un inconnu — شخص غريب","le retraité — المتقاعد","s'asseoir — يجلس"]},{"h":"تعبيرات جاهزة للاستماع","p":["La conversation dure une heure.","Un passant nous a aidés.","Ici, on trouve la paix.","Le promeneur salue les gens.","La fontaine est au milieu du square."]}]},{"h":"النطق والكلمات المفتاحية","p":["الصوت الأصعب هنا هو الساكن المركّب في « le square » [skwaʁ]: لا تُنقص الحروف ولا تضع همزة بينها، بل انطق الكتلة sq- بسرعة واحدة ثم أوقف عند R الفرنسية الخفيفة. و« la fraîcheur » [fʁɛ.ʃœʁ] فيها è المفتوحة [ɛ] — لا تخلطها بـ é الحادّ فتصير الكلمة إلى معنى آخر.","أما الشرط المضارع فآخره [ɛ] كآخر الماضي المستمر: « je voudrais » [ʒə vu.dʁɛ]، والنبرة في طلب التهذيب تصعد قليلاً في النهاية لأنها استفارة مخففة: « Je voudrais vous demander...؟ ». استمع إلى النبرة في النص الصوتي وقلّدها؛ الفرق بين النبرة الحادّة والنبرة المهذّبة هو الفرق بين أمرين وطلب."]},{"h":"محتوى الحلقة","p":["المشهد الأول: المقعد والتقاط الجريدة، ووصف قصير لحالة الطقس. المشهد الثاني: سؤال Julie المهذّب عن الساحة، وجواب يكشف عادة عمرية: « Tous les jours, après ma promenade. ». المشهد الثالث: دعوة إلى النافورة، وهي لحظة الانتقال من الوحدة إلى الحوار.","المفردات مأخوذة من الساحة نفسها: le square (الساحة العامة)، la promenade (النزهة)، le passant (العابر)، le promeneur، la fontaine وla statue (النافورة والتمثال)، la fraîcheur (النسيم البارد)، le moineau (العصفور)، la paix (السكينة)، un inconnu (شخص غريب)، le retraité (المتقاعد)، la conversation و s'asseoir. كلمة « banc » نفسها محور الحلقة، فاحفظها من السياق لا من القائمة.","نحوياً، الشرط المضارع يُكوَّن من الماضي المستمر لنفس الفعل: « je voudrais » من vouloir، « je pourrais » من pouvoir، « je serais » من être — وثلاث صيغ تكفيك للتهذيب: Je voudrais / Je pourrais / Est-ce que je peux. ومعها l'imparfait لوصف الخلفية والعادة: « Il s'asseyait ici chaque jour. » — اجعلها هي الطباخة التي يُطبخ عليها الحدث."]},{"h":"التطبيق والتلخيص","p":["الحلقة 19: المشهد الوحيد على المقعد — الطقس، الساحة، والدعوة المهذّبة، كما في الفيديو الرئيسي «Reflets 2 Episode 04» من قناة Jason Mills: شاهد الفيديو الرئيسي مرة أخرى بالكامل، وتوقف عند كل عبارة تهذيب (Je voudrais / Je pourrais / Est-ce que je peux) لتكتبها، ثم أعد الاستماع لالتقاط نبرة الصمت بين الجمل.","جسر الحلقات: من a2-t7-l18 (la poste: الطابور، الطرد، والجملة المركّبة) إلى a2-t7-l19 (الساحة والتقاعد وافتتاح الحديث بلباقة)، ثم إلى a2-t7-l20 حيث يجلس الأصدقاء في نهاية الأسبوع ليقيّموا ما سبق من أيام ويستعملون الماضي المركّب للحكاية.","المهمة: أعد مشاهدة الحلقة كاملة، ثم سجّل نفسك تلخّص فيها الحلقة في 60 ثانية مستعملاً جملة تهذيب واحدة بـ « Je voudrais » ووصفًا واحداً بـ l'imparfait — فالتمرين يقيس قدرتك على الانتقال بين زمنين في نفس الكلام."]}],"examples":[{"fr":"Je voudrais vous demander quelque chose.","ar":"أودّ أن أسألك شيئاً."},{"fr":"Vous venez souvent ici ?","ar":"هل تأتي إلى هنا كثيراً؟"},{"fr":"Quand j'étais petit, je venais ici tous les jours.","ar":"كنت أأتي إلى هنا كل يوم عندما كنت صغيراً."},{"fr":"Je pourrais vous montrer la fontaine.","ar":"يمكنني أن أريك النافورة."},{"fr":"Je fais ma promenade le matin.","ar":"أقوم بنزهتي في الصباح."},{"fr":"Le square est près de la mairie.","ar":"الساحة قرب البلدية."}],"pron":[{"w":"le square","ipa":"[lə skwaʁ]","approx":"لا سْكْوار"},{"w":"je voudrais","ipa":"[ʒə vu.dʁɛ]","approx":"جْفودْري"},{"w":"s'asseoir","ipa":"[sa.swaʁ]","approx":"سَسْوار"},{"w":"la fraîcheur","ipa":"[la fʁɛ.ʃœʁ]","approx":"لا فْرَيشُور"}],"vocab":[{"fr":"la promenade","ar":"النزهة والمشي","pos":"nom","g":"f","exFr":"Je fais ma promenade le matin.","exAr":"أقوم بنزهتي في الصباح.","ipa":"[lə pʁɔ.mə.nad]"},{"fr":"le square","ar":"الساحة العامة","pos":"nom","g":"m","exFr":"Le square est près de la mairie.","exAr":"الساحة قرب البلدية.","ipa":"[skwaʁ]"},{"fr":"un inconnu","ar":"شخص غريب","pos":"nom","g":"m","exFr":"Un inconnu m'a souri.","exAr":"ابتسم لي شخص غريب.","ipa":"[œ̃.tɔ̃.ky]"},{"fr":"le retraité","ar":"المتقاعد","pos":"nom","g":"m","exFr":"Le retraité lit le journal.","exAr":"المتقاعد يقرأ الجريدة.","ipa":"[lə ʁə.tʁe.te]"},{"fr":"s'asseoir","ar":"يجلس","pos":"verbe","exFr":"Je m'assois sur le banc.","exAr":"أجلس على المقعد.","ipa":"[sa.swaʁ]"},{"fr":"la conversation","ar":"المحادثة","pos":"nom","g":"f","exFr":"La conversation dure une heure.","exAr":"تستمر المحادثة ساعة.","ipa":"[lə kɔ̃.vɛʁ.sa.sjɔ̃]"},{"fr":"le passant","ar":"العابر المارّ","pos":"nom","g":"m","exFr":"Un passant nous a aidés.","exAr":"ساعدنا عابر مارّ.","ipa":"[pa.sɑ̃]"},{"fr":"la paix","ar":"السكينة","pos":"nom","g":"f","exFr":"Ici, on trouve la paix.","exAr":"هنا تجد السكينة.","ipa":"[pɛ]"},{"fr":"le promeneur","ar":"النزّاه","pos":"nom","g":"m","exFr":"Le promeneur salue les gens.","exAr":"النزّاه يحيّي الناس.","ipa":"[lə pʁɔ.mə.nœʁ]"},{"fr":"la fontaine","ar":"النافورة","pos":"nom","g":"f","exFr":"La fontaine est au milieu du square.","exAr":"النافورة في وسط الساحة.","ipa":"[fɔ̃.tɛn]"},{"fr":"la statue","ar":"التمثال","pos":"nom","g":"f","exFr":"La statue est toute verte.","exAr":"التمثال أخضر بالكامل.","ipa":"[staty]"},{"fr":"la fraîcheur","ar":"النسيم البارد","pos":"nom","g":"f","exFr":"On aime la fraîcheur du soir.","exAr":"نحب نسيم المساء.","ipa":"[fʁɛ.ʃœʁ]"}],"grammar":[{"tFr":"Le conditionnel présent : politesse et souhait","tAr":"القاعدة: الشرط المضارع للتهذيب والتمني","body":["يُكوَّن الشرط المضارع من نهايات الماضي المستمر على جذر المضارع: « je voudrais » (من vouloir)، « je pourrais » (من pouvoir)، « je serais » (من être). استعماله الأول تهذيب في الطلب: « Je voudrais un café. » أهذّب من « Je veux un café. »، وثانيه احتمال لطيف: « Je pourrais revenir demain. ».","يُستعمل أيضاً في التمني مع « si » في الماضي: « Si j'avais le temps, je viendrais. » — ولا يُخلط بالمستقبل البسيط. في الحياة اليومية ثلاث صيغ تفتح كل الأبواب: Je voudrais / Je pourrais / Est-ce que je peux — وتلك هي حقيبة التهذيب الكاملة."],"ex":[{"fr":"Je voudrais vous montrer quelque chose.","ar":"أودّ أن أريك شيئاً."},{"fr":"Je pourrais revenir après la promenade.","ar":"يمكنني العودة بعد النزهة."}]},{"tFr":"L'imparfait : description et habitude","tAr":"القاعدة: الماضي المستمر للوصف والعادة","body":["يُستعمل l'imparfait لرسم الخلفية: الطقس، الزمن، الحالة، والعادة المتكررة: « Il faisait frais. », « Il s'asseyait ici chaque jour. ». نهاياته ثابتة: -ais, -ais, -ait, -ions, -iez, -aient، ولا يتغير جذر الفعل.","يظهر بوضوح مقابل الحدث: « Je marchais (خلفية) quand je l'ai vu (حدث). » — ولا يُستعمل للحدث المكتمل وحده. في حوار الساحة هو ما يجعل المشهد حيّاً: بدونه تبقى الجمل جملتين منفصلتين بلا عالم."],"ex":[{"fr":"Il faisait frais, alors je me suis assis sur le banc.","ar":"كان الجوّ بارداً، فجلست على المقعد."},{"fr":"Quand j'étais petit, je venais ici tous les jours.","ar":"كنت آتي إلى هنا كل يوم عندما كنت صغيراً."}]}],"mistakes":[{"wrong":"«Je voudrais à parler avec vous.»","right":"«Je voudrais parler avec vous.»","why":"الفعل vouloir يأتي مباشرة مع المصدر بلا حرف جر."},{"wrong":"«Quand j'étais petit, je viens ici.»","right":"«Quand j'étais petit, je venais ici.»","why":"العادة في الماضي تُروى بـ l'imparfait لا بالمضارع."},{"wrong":"«Je voudrais que tu viens.»","right":"«Je voudrais que tu viennes.»","why":"بعد que في التمني يأتي صيغة subjonctif، وهي هنا على صورة المضارع مع تغيير endings."}],"dialogues":[{"title":"Sur le banc du square","ctx":"حديث بين متقاعد وجارة جديدة","lines":[{"who":"Le retraité","fr":"Bonjour. Il fait frais aujourd'hui, n'est-ce pas ?","ar":"صباح الخير. الجوّ بارد قليلاً اليوم، أليس كذلك؟"},{"who":"Julie","fr":"Oui, c'est agréable. Vous venez souvent ici ?","ar":"نعم، إنه منعش. هل تأتي إلى هنا كثيراً؟"},{"who":"Le retraité","fr":"Tous les jours, après ma promenade.","ar":"كل يوم، بعد نزهتي."},{"who":"Julie","fr":"Vous habitez près d'ici ?","ar":"أسكن قريباً من هنا؟"},{"who":"Le retraité","fr":"Oui, depuis trente ans. Venez, je vous montre la fontaine.","ar":"نعم، منذ ثلاثين عاماً. تفضّلي، سأريك النافورة."},{"who":"Julie","fr":"Volontiers ! Je voudrais aussi vous offrir un café.","ar":"بكل سرور! أودّ أيضاً أن أقدّم لك قهوة."},{"who":"Le retraité","fr":"Merci, madame. Ce n'est qu'un début d'amitié.","ar":"شكراً يا سيدتي. إنها مجرد بداية لصداقة."}]}],"exercises":[{"t":"mcq","skill":"compréhension","q":"أين يجلس الرجل المتقاعد كل يوم؟","opts":["في الساحة قرب النافورة","في مقهى الشارع","عند شباك البريد","في المصعد"],"a":0,"why":"قال إنه يجلس هنا كل يوم بعد نزهته، ثم دعا Julie ليرى النافورة."},{"t":"fill","skill":"grammaire","q":"أكمل بصيغة التهذيب: «Je ___ vous poser une question.» (vouloir)","fr":"Je ___ vous poser une question.","ans":"voudrais","alts":["Voudrais"],"why":"الشرط المضارع من vouloir هو أسلوب الطلب المهذّب."},{"t":"mcq","skill":"vocabulaire","q":"المعنى الصحيح لـ «la promenade»:","opts":["النزهة والمشي","النافورة","التمثال","الطابور"],"a":0,"why":"الجولان القصير الذي يفعله المتقاعد قبل أن يجلس."},{"t":"order","skill":"production","q":"رتّب كلمات الحلقة: عبارة Julie المهذّبة","words":["Je","peux","m'asseoir","un","moment","?"],"ans":"Je peux m'asseoir un moment ?","why":"الفعل + الانعكاسي + المدة، ثم علامة الاستفهام."},{"t":"listen","skill":"écoute","q":"[Écoute] كم يجلس الرجل في هذه الساحة حسب حديثه؟","opts":["depuis trente ans","depuis deux ans","depuis cinq ans","depuis hier"],"a":0,"why":"« Je m'assois ici depuis trente ans. »"},{"t":"translate","skill":"production","q":"ترجم: «أودّ أن أريك النافورة.»","ans":"Je voudrais vous montrer la fontaine.","alts":["je voudrais vous montrer la fontaine"],"why":"الشرط المضارع + المصدر + المفعول بالـ vous."},{"t":"correct","skill":"grammaire","q":"صحّح الخطأ: «Je voudrais à parler avec vous.»","ans":"Je voudrais parler avec vous.","alts":["je voudrais parler avec vous"],"why":"لا حرف جر بعد vouloir قبل المصدر."},{"t":"speaking","skill":"production","q":"افتح حديثاً مع جار في الساحة بثلاث جمل: تحية، تعليق على الطقس، ثم سؤال مهذّب.","target":"Bonjour, il fait beau aujourd'hui, n'est-ce pas ?","why":"إنتاج افتتاح حديث ودود كما في الحلقة."}],"homework":"شاهد الحلقة التالية a2-t7-l20 («Un bon début !» — حصيلة الأسبوع)، وانتبه إلى الأزمنة المستعملة في الحكاية، ثم سجّل تلخيصاً صوتياً مدته 60 ثانية لمشهد الساحة مع جملة تهذيب واحدة. — Regarde a2-t7-l20 et repère les temps du passé utilisés pour raconter la semaine.","sources":[{"label":"الحلقة الرئيسية","videoId":"uDVZEOtzISE","title":"Reflets 2 Episode 04","channel":"Jason Mills","why":"الحلقة الكاملة — النص الأصلي للمشوار: طبّق ما تعلمه في دروس القواعد والمفردات.","main":true,"extra":false,"cat":"Séries","level":"A2","t":0},{"label":"إثرائي","videoId":"VijK_ocTe90","title":"Ce que les 8 521 bancs publics révèlent de Paris","channel":"Les Echos","why":"قصة مقاعد باريس العامة في أربعة عشر دقيقة: تمنح مقعد الحلقة بعداً اجتماعياً وتثبّت مفردات الساحة.","main":false,"extra":true,"cat":"Culture","level":"A2"}],"supplements":[{"id":"VijK_ocTe90","videoId":"VijK_ocTe90","title":"Ce que les 8 521 bancs publics révèlent de Paris","channel":"Les Echos","why":"قصة مقاعد باريس العامة في أربعة عشر دقيقة: تمنح مقعد الحلقة بعداً اجتماعياً وتثبّت مفردات الساحة.","dur":14,"lang":"fr","level":"A2"}]},{"id":"a2-t7-l20","fr":"Épisode 20 — Un bon début !","ar":"الحلقة 20 — بدايةٌ جيدة","objectives":["متابعة حصيلة الأسبوع الأول وفهم الرواية بالزمنين","استيعاب مفردات التقييم: le progrès, la réussite, la difficulté, le cap","استعمال plus-que-parfait مقابل l'imparfait في سرد قصير"],"sections":[{"h":"الدرس","video":{"id":"oYoxwfdDF-s","title":"Reflets 2 Episode 05","channel":"Jason Mills","why":"الحلقة كاملة — نهاية قطعة الموسم الثاني: استمع إلى الأصوات الفرنسية في حديث الأصدقاء قبل أن تعيد بناء الحصيلة بكلماتك.","lang":"fr","main":true,"t":0,"dur":13},"p":["الحلقة الخامسة تجمع الخيوط: نهاية الأسبوع الأول، وأربعة أصدقاء حول طاولة واحدة، وكل واحد يقول ما نجح فيه وما عسر. العنوان « Un bon début ! » ليس عبارة تشجيع فارغة، بل خلاصة يتعلم فيها المتعلم كيف يُقيّم تجربته بالفرنسية: القصير والموجب أولاً، ثم الصعوبة بلباقة، ثم الخطة.","هذه الحلقة هي تمرين الرواية الأكمل في الموسم: جملة بالمضارع البسيط، وأخرى بالماضي المركّب، وأخرى بالماضي المستمر، ثم جملة بالمضارع القريب للخطة. اجعل من أذنك شبكة تلتقط « علامات الأزمنة »: « déjà » مع passé composé، و« quand » مع الخلفية، و« avant que » مع الماضي المركّب — فالأزمنة في الفرنسية تُعرف من العلامات قبل أن تُعرف من الدلالة.","نحوياً تقدّم الحلقة صندوقين: الماضي المركّب « quand je suis arrivé, la réunion avait déjà commencé »، والمضارع القريب للتوصل حديثاً « Je viens de finir ma première tâche ». ومعها حروف الربط الدقيقة: « d'abord », « ensuite », « finalement » — ثلاث كلمات تحوّل إجابتك المبعثرة إلى قصة واحدة.","قبل المشاهدة: ركّز في المرة الأولى على فهم الفكرة العامة للموقف دون إيقاف الفيديو، وفي المرة الثانية دوّن الكلمات التي تتكرر — خصوصاً l'objectif، l'étape، la démarche — وحاول استنتاج معناها من السياق قبل الرجوع إلى قاموسك.","بعد المشاهدة: تدرّب على ملخص من ثلاث جمل للكتابة — حدّد الشخصيات وما فعلنا وما شعروا به — ثم استمع مرة أخيرة وقارن نطقك بنطق الممثلين، مع انتباه خاص لنقطة قاعدة الدرس كما وردت في الحوار.","تلميح الأداء: أعد تشغيل المقاطع الصعبة بسرعة 0.75، وأوقف الفيديو عند نهاية كل جملة لتكرارها بصوت عالٍ — هذه الطريقة تثبّت المفردات والنطق معاً وتُعدّك جاهزاً لتمارين هذا الدرس وللدرس التالي في السلسلة."],"sub":[{"h":"النص الصوتي (مقتطف)","p":["Karim : Alors, première semaine terminée. Tu en penses quoi ?","Julie : Un vrai début ! J'ai déjà organisé trois réunions.","Marc : Moi, j'avais peur de rater le premier jour, mais tout s'est bien passé.","Sophie : Tu te sens bien dans le service, alors ?","Julie : Oui, je m'y habitue. Je viens de finir ma première tâche.","Karim : Parfait. Un bon début, et la suite sera encore meilleure !"]},{"h":"مفردات الموقف","p":["l'objectif — الهدف","l'étape — المرحلة","la démarche — الخطوة والإجراء","le progrès — التقدّم","la réussite — النجاح"]},{"h":"تعبيرات جاهزة للاستماع","p":["La difficulté, c'est l'écoute.","On a pris le bon cap.","J'ai une petite fierté.","Heureusement, tout s'est bien passé.","On avance petit à petit."]}]},{"h":"النطق والكلمات المفتاحية","p":["كلمات الحصيلة فيها أصوات دقيقة: « la réussite » [ʁe.ɥsit] فيها y المدوّرة [ɥ] التي لا مقابل لها في العربية — ارفع لسانك إلى وسط الحنك ومرّر الهواء على جانبيه. و« le progrès » تنتهي بـ è مفتوحة [ɛ] مع R خفيفة، و« le début » ينتهي بـ y هادئة [y] لا بـ i حادة.","انتبه أيضاً إلى وحدة « tout s'est bien passé »: تُقال ككتلة واحدة، والـ t في s'est لا تنطق إلا بربط خفيف، والـ p في passé صامتة تقريباً. استمع إلى النبرة الفرحية في « Un bon début ! » وقلّدها؛ الفرنسية تعلّم مشاعرها بالنبرة قبل المفردات."]},{"h":"محتوى الحلقة","p":["المشهد الأول: طاولة المقهى وسؤال افتتاحي « Tu en penses quoi ? ». المشهد الثاني: دورة قصيرة يقول فيها كل واحد جملتين — نجاح، ثم صعوبة. المشهد الثالث: الخطة القادمة بجملتين بالمضارع القريب، وخاتمة إيجابية تربط ما سبق بـ « la suite ».","المفردات هنا مفردات التقييم: le bilan غير مستعمل في الحوار لكنه في خلفيتك، و le progrès و la réussite و la difficulté و l'objectif و l'étape و la démarche و le cap و la fierté، مع أفعال avancer و oser و s'habituer و constater. هي خزانة تفتح بها أي حديث عن تقدّمك في اللغة.","نحوياً، الفرق الحاسم: الماضي المركّب لما قبل الماضي (« avait commencé » قبل وصوله)، والماضي المستمر للخلفية والعادة (« j'avais peur »)، والمضارع القريب للتوصل (« je viens de finir »). ومعها « en » في « Tu en penses quoi ? » — ضمير يعود على الخبر كله، وهو أقصر طريق لإعادة صياغة سؤال."]},{"h":"التطبيق والتلخيص","p":["الحلقة 20: حصيلة الأسبوع الأول — النجاح، الصعوبة، والخطة، كما في الفيديو الرئيسي «Reflets 2 Episode 05» من قناة Jason Mills: شاهد الفيديو الرئيسي مرة أخرى بلا توقف، ثم أعد الاستماع مكتوباً بجانبك لتصحّح كل زمن استعملته الأصوات في سطورك.","جسر الحلقات: من a2-t7-l19 (الساحة والتقاعد وافتتاح الحديث المهذّب) إلى a2-t7-l20 (حصيلة الأسبوع: الماضي المركّب، الماضي المستمر، والمضارع القريب)، ثم إلى a2-t7-l21 حيث يبدأ فصل جديد من المشوار بتمارين تجميع جديدة على الأزمنة نفسها.","المهمة: أعد مشاهدة الحلقة كاملة، ثم سجّل نفسك تلخّص فيها الحلقة في 60 ثانية مستعملاً جملة بالماضي المركّب وجملة بالمضارع القريب على الأقل — وهذه هي الحصيلة النهائية لخمس حلقات من الموسم الثاني."]}],"examples":[{"fr":"Quand je suis arrivé, la réunion avait déjà commencé.","ar":"عندما وصلتُ، كان الاجتماع قد بدأ بالفعل."},{"fr":"Je viens de finir ma première semaine.","ar":"انتهيتُ للتو من أسبوعي الأول."},{"fr":"D'abord, j'ai organisé la liste, ensuite j'ai appelé le chef.","ar":"أولاً رتّبتُ القائمة، ثم اتصلتُ بالرئيس."},{"fr":"Tout s'est bien passé.","ar":"مرّ كل شيء على ما يُرام."},{"fr":"L'objectif est clair.","ar":"الهدف واضح."},{"fr":"C'est la première étape.","ar":"إنها المرحلة الأولى."}],"pron":[{"w":"le début","ipa":"[lə de.by]","approx":"لا دُبي"},{"w":"la réussite","ipa":"[la ʁe.ɥsit]","approx":"لا ْريحْسيت"},{"w":"le progrès","ipa":"[lə pʁɔ.ɡʁɛ]","approx":"لا پْروغْري"},{"w":"s'habituer","ipa":"[sa.bi.tɥe]","approx":"سابيتوي"}],"vocab":[{"fr":"l'objectif","ar":"الهدف","pos":"nom","g":"m","exFr":"L'objectif est clair.","exAr":"الهدف واضح.","ipa":"[lɔb.ʒɛk.tif]"},{"fr":"l'étape","ar":"المرحلة","pos":"nom","g":"f","exFr":"C'est la première étape.","exAr":"إنها المرحلة الأولى.","ipa":"[le.tap]"},{"fr":"la démarche","ar":"الخطوة والإجراء","pos":"nom","g":"f","exFr":"C'est une démarche utile.","exAr":"إنها خطوة مفيدة.","ipa":"[la dɛʁ.maʃ]"},{"fr":"le progrès","ar":"التقدّم","pos":"nom","g":"m","exFr":"Je vois des progrès chaque semaine.","exAr":"أرى تقدّماً كل أسبوع.","ipa":"[pʁɔ.ɡʁɛ]"},{"fr":"la réussite","ar":"النجاح","pos":"nom","g":"f","exFr":"La réussite vient avec le travail.","exAr":"النجاح يأتي مع العمل.","ipa":"[ʁe.ɥsit]"},{"fr":"la difficulté","ar":"الصعوبة","pos":"nom","g":"f","exFr":"La difficulté, c'est l'écoute.","exAr":"الصعوبة في الاستماع.","ipa":"[di.fi.kyl.te]"},{"fr":"le cap","ar":"الاتجاه والمرحلة","pos":"nom","g":"m","exFr":"On a pris le bon cap.","exAr":"اتخذنا الاتجاه الصحيح.","ipa":"[kap]"},{"fr":"la fierté","ar":"الفخر","pos":"nom","g":"f","exFr":"J'ai une petite fierté.","exAr":"لديّ فخر صغير.","ipa":"[fjɛʁ.te]"},{"fr":"heureusement","ar":"لحسن الحظ","pos":"adverbe","exFr":"Heureusement, tout s'est bien passé.","exAr":"لحسن الحظ، مرّ كل شيء على ما يُرام.","ipa":"[œʁ.øz.mɑ̃]"},{"fr":"avancer","ar":"يتقدّم","pos":"verbe","exFr":"On avance petit à petit.","exAr":"نتقدّم شيئاً فشيئاً.","ipa":"[a.vɑ̃.se]"},{"fr":"s'habituer","ar":"يعتاد على","pos":"verbe","exFr":"Je m'habitue au service.","exAr":"أعتاد على القسم.","ipa":"[sa.bi.tɥe]"},{"fr":"oser","ar":"يجترؤ ويقدّم على","pos":"verbe","exFr":"Il faut oser parler.","exAr":"يجب أن تجرؤ على التحدث.","ipa":"[o.ze]"}],"grammar":[{"tFr":"Le plus-que-parfait : temps de l'avant-dernier fait","tAr":"القاعدة: الماضي المركّب لما قبل الماضي","body":["يُكوَّن من الحرف المساعد في l'imparfait (avais, avais, avait...) + المصدر المعدوم للمهمة: « J'avais fini avant ton arrivée. », « La réunion avait déjà commencé. » — ويستعمل كلما وقع حدثٌ قبل حدث ماضٍ آخر، أو مع « avant que » و« quand » و« déjà ».","لاحظ الجملة الكاملة: « Quand je suis arrivé, la réunion avait déjà commencé. » — حدثان ماضيان: الأول passé composé (الوصول)، والذي قبله plus-que-parfait (بداية الاجتماع). وغالباً تظهر الخلفية بـ l'imparfait قبل الحدث: « Il pleuvait quand je suis sorti. » — ثلاثة أزمنة في جملة واحدة، وهذا هو قلب السرد الفرنسي."],"ex":[{"fr":"Quand je suis arrivé, la réunion avait déjà commencé.","ar":"عندما وصلتُ، كان الاجتماع قد بدأ بالفعل."},{"fr":"Avant de partir, j'avais fini ma première tâche.","ar":"قبل أن أخرج، كنتُ أنهيتُ مهمتي الأولى."}]},{"tFr":"Le passé récent : venir de + infinitif","tAr":"القاعدة: الماضي القريب ( venir de + مصدر )","body":["للتوصل من فعل حديث تستعمل « venir de + مصدر » مع تصريف venir: « Je viens de finir », « Nous venons de commencer ». وهي تُغنيك عن البحث عن زمن مركّب آخر، وتستعمل في الحديث اليومي أكثر مما تظن.","مع النفي: « Je ne viens pas d'arriver. » ومع الأوامر لا تُستعمل، ومع الأفعال الانعكاسية: « Elle vient de se lever. » — وثلاث جمل تكفيك للإتقان: أني أنهيت، أني بدأت، أني وصلت للتو."],"ex":[{"fr":"Je viens de finir ma première tâche.","ar":"انتهيتُ للتو من مهمتي الأولى."},{"fr":"Nous venons de commencer le nouveau chapitre.","ar":"بدأنا للتو الفصل الجديد."}]}],"mistakes":[{"wrong":"«Quand je suis arrivé, il a mangé.»","right":"«Quand je suis arrivé, il mangeait.»","why":"الحدث المستمر في الخلفية يُروى بـ l'imparfait، والحدث القصير بـ passé composé."},{"wrong":"«Je viens finir ma semaine.»","right":"«Je viens de finir ma semaine.»","why":"الضمير de إلزامي في المضارع القريب، والتحذف يجعل الجملة ناقصة."},{"wrong":"«Avant de partir, j'ai fini le rapport.»","right":"«Avant de partir, j'avais fini le rapport.»","why":"الحدث الذي وقع قبل حدث ماضٍ آخر يأخذ الماضي المركّب."}],"dialogues":[{"title":"Le bilan de la semaine","ctx":"أصدقاء حول طاولة المقهى","lines":[{"who":"Karim","fr":"Alors, première semaine terminée. Tu en penses quoi ?","ar":"فما رأيك في الأسبوع الأول؟"},{"who":"Julie","fr":"Un vrai début ! J'ai déjà organisé trois réunions.","ar":"بداية حقيقية! نظّمتُ للتو ثلاثة اجتماعات."},{"who":"Marc","fr":"Moi, j'avais peur de rater le premier jour.","ar":"أنا كنتُ خائفاً أن أفوت اليوم الأول."},{"who":"Sophie","fr":"Mais tout s'est bien passé, non ?","ar":"لكن كل شيء مرّ على ما يُرام، أليس كذلك؟"},{"who":"Marc","fr":"Oui, heureusement. Je viens de finir mon premier dossier.","ar":"نعم، لحسن الحظ. أنهيتُ للتو ملفّي الأول."},{"who":"Julie","fr":"Bravo ! D'abord on apprend, ensuite on avance.","ar":"أحسنت! أولاً نتعلّم، ثم نتقدّم."},{"who":"Karim","fr":"Un bon début, et la suite sera encore meilleure !","ar":"بداية جيدة، وسيكون ما بعده أفضل!"}]}],"exercises":[{"t":"mcq","skill":"compréhension","q":"ماذا أنجزت Julie في أسبوعها الأول؟","opts":["نظّمت ثلاث اجتماعات","انتقلت إلى مدينة أخرى","بدأت دراسة الطهي","غادرت العمل"],"a":0,"why":"Julie: « J'ai déjà organisé trois réunions. »"},{"t":"fill","skill":"grammaire","q":"أكمل بالزمن الصحيح: «Quand je suis arrivé, la réunion avait déjà ___.» (commencer)","fr":"Quand je suis arrivé, la réunion avait déjà ___.","ans":"commencé","alts":["Commencé"],"why":"الحدث الذي وقع قبل الوصول يُروى بالماضي المركّب."},{"t":"mcq","skill":"vocabulaire","q":"المعنى الصحيح لـ «la réussite»:","opts":["النجاح","الصعوبة","الفخر","الهدف"],"a":0,"why":"ما يتحقق من العمل الجيد، وتأتي مع التقدّم."},{"t":"order","skill":"production","q":"رتّب كلمات الحلقة: جملة الحصيلة الإيجابية","words":["Tout","s'est","bien","passé","cette","semaine."],"ans":"Tout s'est bien passé cette semaine.","why":"فاعل + avoir مع صيغة الانعكاس + ظرف المكان ثم الزمن."},{"t":"listen","skill":"écoute","q":"[Écoute] ماذا تقول Julie عن إحساسها في القسم؟","opts":["Je m'y habitue","Je n'aime pas le service","Je vais partir demain","Je cherche un autre bureau"],"a":0,"why":"Julie: « Oui, je m'y habitue. Je viens de finir ma première tâche. »"},{"t":"translate","skill":"production","q":"ترجم: «عندما وصلتُ، كان الاجتماع قد بدأ بالفعل.»","ans":"Quand je suis arrivé, la réunion avait déjà commencé.","alts":["Je suis arrivé, la réunion avait déjà commencé"],"why":"« quand » + passé composé، وما قبله بالماضي المركّب."},{"t":"correct","skill":"grammaire","q":"صحّح الخطأ: «Je viens finir ma première tâche.»","ans":"Je viens de finir ma première tâche.","alts":["je viens de finir ma première tâche"],"why":"الضمير de إلزامي في « venir de + infinitif »."},{"t":"speaking","skill":"production","q":"اكتب في جملتين ثم انطقهما: حصيلة أسبوعك الأول، واحدة بالماضي المركّب وأخرى بالمضارع القريب.","target":"Tout s'est bien passé, c'est un bon début !","why":"إنتاج الحصيلة كما في خاتمة الحلقة."}],"homework":"شاهد الحلقة التالية a2-t7-l21 لتدخل الفصل الجديد من المشوار، وراجع دروس الموسم الثاني الخمسة، ثم اكتب حصيلتك الشخصية في خمسين كلمة بالفرنسية، وأخيراً سجّل تلخيصاً صوتياً مدته 60 ثانية للحلقة 20. — Regarde a2-t7-l21 et relis les cinq leçons du début de la saison 2, puis écris ton bilan personnel en cinquante mots.","sources":[{"label":"الحلقة الرئيسية","videoId":"oYoxwfdDF-s","title":"Reflets 2 Episode 05","channel":"Jason Mills","why":"الحلقة الكاملة — النص الأصلي للمشوار: طبّق ما تعلمه في دروس القواعد والمفردات.","main":true,"extra":false,"cat":"Séries","level":"A2","t":0},{"label":"إثرائي","videoId":"IC90jPgr7Dg","title":"Le plus que parfait en Français","channel":"Le French Club","why":"شرح مختصر وواضح للماضي المركّب: يثبّت القاعدة النجمة في الحلقة الخمسين قبل أن تنتقل إلى الفصل التالي.","main":false,"extra":true,"cat":"Grammaire","level":"A2"}],"supplements":[{"id":"IC90jPgr7Dg","videoId":"IC90jPgr7Dg","title":"Le plus que parfait en Français","channel":"Le French Club","why":"شرح مختصر وواضح للماضي المركّب: يثبّت القاعدة النجمة في الحلقة الخمسين قبل أن تنتقل إلى الفصل التالي.","dur":8,"lang":"fr","level":"A2"}]},{"id":"a2-t7-l21","fr":"Épisode 21 — Quel beau village !","ar":"الحلقة 21 — يا لها من قرية جميلة","objectives":["وصف قرية سياحية بصيغة التفضيل الأقصى (le plus / le moins) في جمل مسموعة حاسمة","تسمية معالم القرية (le clocher, la ruelle, la fontaine) وترتيب الزيارة بـ «on + verbe»","متابعة الحلقة على فيديو qihuang chuwu واستخراج الانطباع الأول والوصف من النص الأصلي"],"sections":[{"h":"الدرس","video":{"id":"SIMvu2NK_00","title":"Reflets 2 épisode 06","channel":"qihuang chuwu","why":"الحلقة السادسة كاملة من الموسم الثاني — جولة القرية بالنص الأصلي: اسمع الوصف قبل أن تصف أنت قرية زرتها.","lang":"fr","main":true,"t":0,"dur":5},"p":["تدور أحداث الحلقة في قرية صغيرة يزورها الأبطال لأول مرة: ساحة وفي وسطها نافورة، زقاق ضيّق يعلوه رداء من الزهور، برج كنيسة يُرى من بعيد، ومخبز تفوح منه رائحة الخبز — كل معلم يحمل اسماً واحداً يجب أن يخرج منك مسموعاً لا مكتوباً فقط.","أثناء الاستماع امسك كلمتين تكفيان لفهم الوصف كله: «le plus» في صيغة التفضيل الأقصى (la plus belle vue) و«Il y a» في تحديد المكان (Il y a une fontaine...). جُمَل الحلقة قصيرة وإيقاعها هادئ، وهذه فرصتك لالتقاط نبرة الوصف الفرنسية لا لمجرد فهم معناها.","قبل المشاهدة استعدّ لأربعة أصوات تتناثر في النص: [ʃ] في clocher، و[ɥɛl] في ruelle، والأنف في fontaine [fɔ̃.tɛn]، وفتحة [ʒ] في boulangerie — ثم أعد المقطع وردّد الكلمة بصوت الممثل في اللحظة نفسها.","قبل المشاهدة: ركّز في المرة الأولى على فهم الفكرة العامة للموقف دون إيقاف الفيديو، وفي المرة الثانية دوّن الكلمات التي تتكرر — خصوصاً la vue، la balade، le château — وحاول استنتاج معناها من السياق قبل الرجوع إلى قاموسك.","بعد المشاهدة: تدرّب على ملخص من ثلاث جمل للكتابة — حدّد الشخصيات وما فعلنا وما شعروا به — ثم استمع مرة أخيرة وقارن نطقك بنطق الممثلين، مع انتباه خاص لنقطة قاعدة الدرس كما وردت في الحوار.","تلميح الأداء: أعد تشغيل المقاطع الصعبة بسرعة 0.75، وأوقف الفيديو عند نهاية كل جملة لتكرارها بصوت عالٍ — هذه الطريقة تثبّت المفردات والنطق معاً وتُعدّك جاهزاً لتمارين هذا الدرس وللدرس التالي في السلسلة."],"sub":[{"h":"النص الصوتي (مقتطف)","p":["Regardez cette ruelle, elle est vraiment charmante !","D'en haut, la vue sur la vallée est superbe.","Le clocher de l'église date du Moyen Âge.","On se repose à la fontaine, puis on descend à la boulangerie.","Cette balade est la plus belle de tout le séjour."]},{"h":"مفردات الموقف","p":["la vue — المنظر","la balade — الجولة راجلين","le château — القلعة","la ruelle — الزقاق","l'église — الكنيسة"]},{"h":"تعبيرات جاهزة للاستماع","p":["La randonnée commence à huit heures.","Le clocher se voit de loin.","On achète le pain à la boulangerie.","L'artisan vend ses objets sur la place.","On se repose près de la fontaine."]}]},{"h":"النطق والكلمات المفتاحية","p":["النطق هنا رحلة قصيرة في ثلاثة أصوات: كلمة ruelle تفتح بـ [ʁ] الفرنسية المتموّجة لا بالر العربية القاسية، وتنتهي بـ [ɥɛl] وهي مزيج نادر عليك إيقاعه بتحريك الشفتين للداخل؛ وكلمة clocher تحمل [ʃ] شيطانية في المنتصف فلا تنطقها [k]؛ أما fontaine فمقطع أنفي واحد [tɛ̃] لا كلمتان.","في صيغة التفضيل اجعل «le plus beau» كتلة واحدة لا كلمات مفرقة: [lə ply bo] بنبرة على plus وصمت خفيف قبلها، ولا تقرأها مقسومة. وتمرّن على la vue [la vy] بلا الواو الإنجليزية، وعلى l'église [le.ɡliz] بسكون الـ s، فهذان الصوتان يكشفان متحدثاً متهماً فوراً."]},{"h":"محتوى الحلقة","p":["الحلقة تسير بترتيب زيارة واضحة: الساحة ← الزقاق ← برج الكنيسة ← النافورة ← المخبز، وهذا الترتيب نفسه هو الذي يحمل الحوار كله؛ فكلما انتقل الأبطال إلى معلم جديد تظهر كلمة جديدة معه، وانتبه خصوصاً لصيغ التفضيل التي تتكرر ثلاث مرات في المقتطف (superbe, la plus belle).","حِملَة القاعدة في هذه الحلقة جزءان: صيغة التفضيل الأقصى مع أداة التعريف ثم de/du/des (la plus belle vue de la région)، و«on» الحكائي الذي يقود الجولة بفعله المضارع (on va, on voit, on se repose) — وكلاهما يخدم وصف الأماكن في كل موقف سياحي لاحق.","ما يستحق الحفظ من الحلقة: التعجب «Quel beau village !» و«Quelle belle vue !»، وطلب الاستراحة «On se pose...؟»، والوصف بـ «C'est le plus ...» — ثلاث عبارات تخرج منك صوتية في أول قرية تزورها."]},{"h":"التطبيق والتلخيص","p":["الحلقة 21 — Quel beau village !: جولة القرية بالوصف والتفضيل، كما في الفيديو الرئيسي «Reflets 2 épisode 06» على قناة qihuang chuwu: شغّل الحلقة كاملة بلا توقف أول مرة لتلتقط الإيقاع، ثم أعد التشغيل وعينك على كلمات «le plus / la plus» و«Il y a» فقط.","جسر الحلقات: من a2-t7-l20 («Un bon début / بداية جيدة») إلى a2-t7-l21 («Quel beau village ! / يا لها من قرية جميلة»)، ثم إلى a2-t7-l22 حيث يتحوّل الحديث من شوارع القرية ومعالمها إلى مائدتها الإقليمية وأطباقها المحلية.","شاهد الحلقة مرة ثانية والنص مفتوح أمامك، ثم افتح ورقة المفردات وراجع اثني عشر مفردة من مفردات الجولة (la vue، la ruelle، le clocher، la boulangerie...)، وأخيراً سجّل تلخيصاً شفهياً مدته 60 ثانية تصف فيه قرية أو حيّاً زرتها مستعملاً ثلاث صيغ تفضيل."]}],"examples":[{"fr":"C'est le plus beau village de la région.","ar":"إنها أجمل قرية في المنطقة.","note":"superlatif + de"},{"fr":"Il y a une fontaine au milieu de la place.","ar":"توجد نافورة في وسط الساحة.","note":"il y a مكاني"},{"fr":"Quelle belle vue depuis la terrasse !","ar":"يا لها من منظر جميل من الشرفة!","note":"تعجب Quelle"},{"fr":"On descend à la boulangerie acheter du pain.","ar":"ننزل إلى المخبز لشراء خبز.","note":"on + مصدر"},{"fr":"La vue sur la vallée est superbe.","ar":"المنظر على الوادي رائع."},{"fr":"La balade dure deux heures.","ar":"الجولة تدوم ساعتين."}],"pron":[{"w":"le clocher","ipa":"[lə klɔ.ʃe]","approx":"لو كلوشيه"},{"w":"la ruelle","ipa":"[la ʁɥɛl]","approx":"لا رويل"},{"w":"la vue","ipa":"[la vy]","approx":"لا في"},{"w":"la fontaine","ipa":"[la fɔ̃.tɛn]","approx":"لا فونتين"}],"vocab":[{"fr":"la vue","ar":"المنظر","pos":"nom","g":"f","exFr":"La vue sur la vallée est superbe.","ipa":"[la vy]","exAr":"المنظر على الوادي رائع."},{"fr":"la balade","ar":"الجولة راجلين","pos":"nom","g":"f","exFr":"La balade dure deux heures.","ipa":"[la ba.lad]","exAr":"الجولة تدوم ساعتين."},{"fr":"le château","ar":"القلعة","pos":"nom","g":"m","exFr":"Le château est ouvert aux visiteurs.","ipa":"[lə ʃa.to]","exAr":"القلعة مفتوحة للزوار."},{"fr":"la ruelle","ar":"الزقاق","pos":"nom","g":"f","exFr":"La ruelle est pleine de fleurs.","ipa":"[la ʁɥɛl]","exAr":"الزقاق مليء بالزهور."},{"fr":"l'église","ar":"الكنيسة","pos":"nom","g":"f","exFr":"L'église est au bout de la place.","ipa":"[le.ɡliz]","exAr":"الكنيسة في نهاية الساحة."},{"fr":"la randonnée","ar":"المشي في الطبيعة","pos":"nom","g":"f","exFr":"La randonnée commence à huit heures.","ipa":"[la ʁɑ̃.dɔ.ne]","exAr":"النزهة تبدأ في الثامنة."},{"fr":"le clocher","ar":"برج الكنيسة","pos":"nom","g":"m","exFr":"Le clocher se voit de loin.","ipa":"[lə klɔ.ʃe]","exAr":"برج الكنيسة يُرى من بعيد."},{"fr":"la boulangerie","ar":"المخبز","pos":"nom","g":"f","exFr":"On achète le pain à la boulangerie.","ipa":"[la bu.lɑ̃.ʒʁi]","exAr":"نشتري الخبز من المخبز."},{"fr":"l'artisan","ar":"الحرفي","pos":"nom","g":"m","exFr":"L'artisan vend ses objets sur la place.","ipa":"[laʁ.ti.zɑ̃]","exAr":"الحرفي يبيع منتجاته في الساحة."},{"fr":"le mérite","ar":"النافورة","pos":"nom","g":"f","exFr":"On se repose près de le mérite.","ipa":"[la fɔ̃.tɛn]","exAr":"نستريح قرب النافورة."},{"fr":"la terrasse","ar":"الشرفة","pos":"nom","g":"f","exFr":"Le café est sur la terrasse.","ipa":"[la tɛ.ʁas]","exAr":"المقهى في الشرفة."},{"fr":"le vignoble","ar":"الكرم (مزرعة العنب)","pos":"nom","g":"m","exFr":"Le vignoble s'étend derrière le village.","ipa":"[lə vi.ɲɔbl]","exAr":"الكرم يمتد خلف القرية."}],"grammar":[{"tFr":"Le superlatif : le/la plus ... + de / du / au","tAr":"القاعدة: التفضيل الأقصى","body":["التفضيل الأقصى يُبنى بأداة التعريف مع plus ثم يتبعه الاسم: la plus belle vue، le plus vieux clocher — والأداة تتبع الجنس والعدد، ثم تُغلق الجملة بجرّ الانتساب: de la région، du village، au monde.","حين يأتي توضيح بعد الاسم يبقى التفضيل بعد الاسم نفسه: le village le plus beau de la région (وليس le plus beau village de la région) — فقاعدة واحدة تحكم الوصف كله: بلا توضيح يسبق التفضيل الاسم، ومع التوضيح يلحقه."],"ex":[{"fr":"C'est la plus jolie ruelle du quartier.","ar":"إنها أجمل زقاق في الحي."},{"fr":"Le clocher est le monument le plus ancien de la ville.","ar":"البرج هو أقدم معلم في المدينة."}]},{"tFr":"on + présent : raconter la visite","tAr":"القاعدة: «on» الحكائي أثناء الجولة","body":["«on» يحلّ محلّ nous في الحديث اليومي ويُصرَّف كـ il: on va، on voit، on se repose — وهو يقود سرد الجولة خطوة بخطوة: on arrive، on monte، on redescend، فلا يحتاج المتحدث إلى تغيير الفعل مرتين.","بعض الأفعال يليها مصدر مباشرة (on va acheter du pain) وبعضها يأتي معها حرف جر (on se pose sur la terrasse) — والحرف هو الفارق بين الحركة والاستراحة، فاحفظه مع الفعل لا منفرداً."],"ex":[{"fr":"On commence par la place, puis on va vers l'église.","ar":"نبدأ بالساحة ثم نتجه نحو الكنيسة."},{"fr":"On se pose cinq minutes devant la fontaine.","ar":"نستريح خمس دقائق أمام النافورة."}]}],"mistakes":[{"wrong":"«la plus belle vue de le village»","right":"«la plus belle vue du village»","why":"à + le ينحت إلى du تماماً داخل التفضيل."},{"wrong":"«Il n'y a pas des touristes le matin.»","right":"«Il n'y a pas de touristes le matin.»","why":"بعد النفي يتحوّل أداة الجزء des إلى de."},{"wrong":"«On va à acheter du pain.»","right":"«On va acheter du pain.»","why":"بعد aller يأتي الفعل مباشرة بلا حرف جر."}],"dialogues":[{"title":"جولة في القرية","ctx":"سائح مع مرشد محلي","lines":[{"who":"Sofiane","fr":"Regarde cette ruelle, elle est pleine de fleurs !","ar":"انظر إلى هذا الزقاق، إنه مليء بالزهور!"},{"who":"Claire","fr":"Elle mène à la place. Il y a une fontaine au milieu.","ar":"إنه يقود إلى الساحة، وتوجد نافورة في وسطها."},{"who":"Sofiane","fr":"Le clocher est immense, c'est le plus haut de la région.","ar":"برج الكنيسة ضخم، إنه الأعلى في المنطقة."},{"who":"Claire","fr":"On se pose sur la terrasse ? J'ai faim.","ar":"نستريح على الشرفة؟ إنني جائع."},{"who":"Sofiane","fr":"D'accord, puis on descend à la boulangerie.","ar":"حسناً، ثم ننزل إلى المخبز."},{"who":"Claire","fr":"Tu as vu l'artisan ? Il vend des cartes postales.","ar":"هل رأيت الحرفي؟ إنه يبيع بطاقات بريدية."},{"who":"Sofiane","fr":"Quel beau village ! J'ai envie d'y revenir au printemps.","ar":"يا لها من قرية جميلة! أودّ العودة إليها في الربيع."}]}],"exercises":[{"t":"mcq","skill":"grammar","q":"أي جملة تصف التفضيل ترتيبها صحيح؟","opts":["C'est la plus jolie ruelle du quartier.","C'est la jolie plus ruelle du quartier.","C'est plus la jolie ruelle du quartier.","C'est la ruelle jolie plus du quartier."],"a":0,"why":"الأداة + plus + الصفة، ثم الاسم والجر."},{"t":"fill","skill":"writing","q":"أكمل: «On ___ à la boulangerie après la fontaine.» (ننزل)","fr":"On ___ à la boulangerie après la fontaine.","ans":"descend","alts":["Descend"],"why":"on + المضارع: الفعل يبقى في صيغة المفرد."},{"t":"listen","skill":"listening","q":"[Écoute] أي عبارة مسموعة في مقتطف جولة القرية؟","opts":["Regardez cette ruelle, elle est vraiment charmante !","Regardez cette rue, elle est en travaux.","Regardez la ruelle, elle est fermée.","Nous allons à la boulangerie demain."],"a":0,"why":"العبارة الأولى هي المقتطف الحرفي من النص الصوتي."},{"t":"order","skill":"writing","q":"رتّب وصف الساحة","words":["Il","y","a","une","fontaine","au","milieu","de","la","place."],"ans":"Il y a une fontaine au milieu de la place.","why":"Il y a ← الاسم ← تحديد المكان بـ au milieu de."},{"t":"translate","skill":"writing","q":"ترجم: «من أعلى البرج، المنظر رائع.»","ans":"D'en haut, la vue est superbe.","alts":["den haut la vue est superbe","d en haut la vue est superbe"],"why":"D'en haut + la vue + صفة."},{"t":"correct","skill":"writing","q":"صحّح: «C'est la plus beau vue de le village.»","ans":"C'est la plus belle vue du village.","alts":["cest la plus belle vue du village"],"why":"belle تتوافق مع vue المؤنث، و de le تنحت إلى du."},{"t":"speaking","skill":"speaking","q":"صف قرية أو حيّاً زرتها في ثلاث جمل: تفضيل + Il y a + on.","target":"C'est le plus... / Il y a... / On commence par...","why":"إنتاج الوصف المكاني المتكامل في وضعية سياحية."},{"t":"mcq","skill":"vocabulary","q":"أي كلمة تعني «برج الكنيسة»؟","opts":["le clocher","la boulangerie","le vignoble","la terrasse"],"a":0,"why":"le clocher هو برج الكنيسة المميّز في القرية."}],"homework":"أعد مشاهدة الحلقة بلا ترجمة، ثم اكتب أربعة أسطر تعرّف فيها بقرية أو حيّ زرتها مستعملاً صيغتَي تفضيل وجملة «Il y a...».\nالحلقة السابقة/التالية: a2-t7-l20 (Un bon début / بداية جيدة) ← a2-t7-l21 → a2-t7-l22 — Révois l'épisode une fois sans sous-titres, puis écris quatre lignes pour présenter ton village ou ton quartier avec deux superlatifs et une phrase « Il y a... ».","sources":[{"label":"الحلقة الأساسية","videoId":"SIMvu2NK_00","title":"Reflets 2 épisode 06","channel":"qihuang chuwu","why":"الحلقة السادسة كاملة من الموسم الثاني — جولة القرية بالنص الأصلي: اسمع الوصف قبل أن تصف أنت قرية زرتها.","cat":"Séries","level":"A2","main":true,"t":0},{"label":"مكمّل الدرس","videoId":"dumuBi2BmGM","title":"Télé FLE : un village francais","channel":"Télé FLE","why":"درس Télé FLE موجّه للمتعلّمين على قرية فرنسية في خمس دقائق — يعيد كلمات الجولة بصوت هادئ قبل عودتك إلى الحلقة.","cat":"Civilisation","level":"A2","extra":true}],"supplements":[{"id":"dumuBi2BmGM","videoId":"dumuBi2BmGM","title":"Télé FLE : un village francais","channel":"Télé FLE","why":"درس Télé FLE موجّه للمتعلّمين على قرية فرنسية في خمس دقائق — يعيد كلمات الجولة بصوت هادئ قبل عودتك إلى الحلقة.","dur":5,"lang":"fr","level":"A2"}]},{"id":"a2-t7-l22","fr":"Épisode 22 — Reflets 2, épisode 7","ar":"الحلقة 22 — الموسم الثاني، الحلقة 7","objectives":["الطلب والتعبير عن التفضيل بأدوات الجزء (du / de la / des) على مائدة إقليمية","وصف طريقة الطهي بـ «en + verbe -ant» وحفظ أسماء أطباق إقليمية فرنسية","متابعة الحلقة على فيديو Jason Mills واستخراج ترتيب الوجبة من المقدمة إلى الحلوى"],"sections":[{"h":"الدرس","video":{"id":"kb7s1bt01KM","title":"Reflets 2 Episode 07","channel":"Jason Mills","why":"الحلقة السابعة كاملة — المائدة الإقليمية بالنص الأصلي: التقط أدوات الجزء وطلب الطعام من كلام الممثلين.","lang":"fr","main":true,"t":0,"dur":11},"p":["المشهد يدور حول مائدة إقليمية كاملة: يبدأ بالمشروب التقديمي، ثم طبق محلي يُطهى ببطء على النار، وخلال ذلك يعرض الأبطال أطباق مناطق مختلفة — راتاتوي من الجنوب، كيك (quiche) من الشمال، وسايدر التفاح الذي يُقدَّم بارداً مع الحلوى.","أثناء الاستماع راقب ثلاث نقاط تحمل الوصف كله: أدوات الجزء في الإثبات (du pain, de la sauce, des crêpes)، وتحوّلها إلى de بعد la négation (pas de sauce)، وصيغة «en + verbe -ant» التي تصف ما يحدث بالتوازي (En goûtant, on découvre...).","جُمَل الحلقة قصيرة وطبيعية، كثيرة الأفعال اليومية (goûter, mijoter, passer, prendre). استمع أول مرة للمعنى العام، وثانية للأصوات المفردة، وثالثة لتكرار جملة الطلب بصوت الممثل قبل أن تنتزعها لمفرداتك.","قبل المشاهدة: ركّز في المرة الأولى على فهم الفكرة العامة للموقف دون إيقاف الفيديو، وفي المرة الثانية دوّن الكلمات التي تتكرر — خصوصاً l'ingrédient، la sauce، le dessert — وحاول استنتاج معناها من السياق قبل الرجوع إلى قاموسك.","بعد المشاهدة: تدرّب على ملخص من ثلاث جمل للكتابة — حدّد الشخصيات وما فعلنا وما شعروا به — ثم استمع مرة أخيرة وقارن نطقك بنطق الممثلين، مع انتباه خاص لنقطة قاعدة الدرس كما وردت في الحوار.","تلميح الأداء: أعد تشغيل المقاطع الصعبة بسرعة 0.75، وأوقف الفيديو عند نهاية كل جملة لتكرارها بصوت عالٍ — هذه الطريقة تثبّت المفردات والنطق معاً وتُعدّك جاهزاً لتمارين هذا الدرس وللدرس التالي في السلسلة."],"sub":[{"h":"النص الصوتي (مقتطف)","p":["Tu as goûté la ratatouille ? C'est la spécialité du coin.","Moi, je préfère la quiche, elle est encore tiède.","On commence par l'apéritif, ensuite viendra le repas.","Le chef laisse mijoter la sauce pendant deux heures.","Passe-moi le cidre, s'il te plaît."]},{"h":"مفردات الموقف","p":["l'ingrédient — المكوّن","la sauce — الصلصة","le dessert — الحلوى","mijoter — يُطهى على نار هادئة","la casserole — القِدر"]},{"h":"تعبيرات جاهزة للاستماع","p":["On mange des crêpes le dimanche.","Le cidre est servi bien frais.","Le repas commence à midi.","On prend l'apéritif sur la terrasse.","La ratatouille est la spécialité du coin."]}]},{"h":"النطق والكلمات المفتاحية","p":["كلمة mijoter تُقرأ جملة واحدة لا كلمات: [mi.ʒɔ.te] مع ضبط [ʒ] الرخوة في المنتصف والنهاية [e] الفرنسية الصافية؛ وكلمة l'apéritif تحمل ثلاثة مقاطع قصيرة [la.pe.ʁi.tif] وتسقط همزتها في النطق [l]، فقل «لابيريتيف» بلا تردد بين الهمزة واللام.","انتبه إلى الأصوات الأنفية المتكررة في مفردات المطبخ: goûter [ɡu.te] بـ [u] المدوّرة، والجسر الصوتي في «des_ingrédients» و«cartes_postales» حيث يتدفّق الصوت من نهاية الكلمة إلى بداية التالية دون فاصل — وهو ما يميّز حديث الطاولة الفرنسية."]},{"h":"محتوى الحلقة","p":["تتقدّم الحلقة كترتيب وجبة: مقدمة (l'apéritif) ← طبق رئيسي (le repas مع la sauce) ← حلوى (le dessert مع la crêpe) — وكل مرحلة تأتي بطلبها الخاص وبمفرداتها، فستجد أنفسك تحفظ قائمة طعام كاملة وأنت تحفظ موقفاً واحداً.","الحِملَتان اللغويتان في هذه الحلقة: أولاً أدوات الجزء التي تُستخدم مع أسماء غير معدودة أو معدودة جزئياً (du pain، de la sauce، des crêpes) وتحوّلها إلى de في النفي (Il n'y a pas de piment)؛ وثانياً اسم الحال en + participe présent الذي يصف حدثاً موازياً (En cuisinant, on apprend beaucoup).","ما يستحق الحفظ: طلب الطعام «Je voudrais...»، ونفي الجزء «pas de...»، ووصف الطهي «Ça mijote...»، وطلب المرور «Passe-moi...» — أربع عبارات تعمل في كل مطبخ فرنسي تدخله."]},{"h":"التطبيق والتلخيص","p":["الحلقة 22 — الموسم الثاني، الحلقة 7: المائدة الإقليمية وأدوات الجزء واسم الحال، كما في الفيديو الرئيسي «Reflets 2 Episode 07» على قناة Jason Mills: شغّل الحلقة كاملة أول مرة لتسمع إيقاع الطاولة، ثم أعد التشغيل وعينك على «du / de la / des» و«en ...ant» فقط.","جسر الحلقات: من a2-t7-l21 («Quel beau village ! / يا لها من قرية جميلة») إلى a2-t7-l22 («Reflets 2, épisode 7 / الموسم الثاني، الحلقة 7»)، ثم إلى a2-t7-l23 حيث ينتقل الفريق من مائدة الطعام إلى المكتب والاجتماع وأجواء العمل.","شاهد الحلقة مرة ثانية والنص مفتوح أمامك، ثم افتح ورقة المفردات وراجع اثني عشر مفردة من مفردات المائدة (l'ingrédient، la sauce، mijoter، le cidre...)، وأخيراً سجّل تلخيصاً شفهياً مدته 60 ثانية تصف فيه وجبة إقليمية تذوقتها أو تحبّ تذوّقها."]}],"examples":[{"fr":"Je voudrais du pain et de la sauce, s'il vous plaît.","ar":"أريد خبزاً وصلصة من فضلك.","note":"طلب بأدوات الجزء"},{"fr":"La sauce mijote depuis deux heures.","ar":"الصلصة تُطهى على نار هادئة منذ ساعتين.","note":"وصف الطهي"},{"fr":"En cuisinant, on apprend beaucoup.","ar":"بالطبخ يتعلّم المرء الكثير.","note":"en + participe"},{"fr":"Ce n'est pas de la crème, c'est du fromage frais.","ar":"ليست قشدة، بل جبن طازج.","note":"نفي الجزء"},{"fr":"Liste les ingrédients avant de cuisiner.","ar":"اسرد المكوّنات قبل الطبخ."},{"fr":"La sauce est encore tiède.","ar":"الصلصة ما زالت دافئة."}],"pron":[{"w":"mijoter","ipa":"[mi.ʒɔ.te]","approx":"ميجوتي"},{"w":"l'apéritif","ipa":"[la.pe.ʁi.tif]","approx":"لابيريتيف"},{"w":"la crêpe","ipa":"[la kʁɛp]","approx":"لا كريب"},{"w":"le cidre","ipa":"[lə si.dʁ]","approx":"لو سيدر"}],"vocab":[{"fr":"l'ingrédient","ar":"المكوّن","pos":"nom","g":"m","exFr":"Liste les ingrédients avant de cuisiner.","ipa":"[lɛ̃.ɡʁe.djɑ̃]","exAr":"اسرد المكوّنات قبل الطبخ."},{"fr":"la sauce","ar":"الصلصة","pos":"nom","g":"f","exFr":"La sauce est encore tiède.","ipa":"[la sos]","exAr":"الصلصة ما زالت دافئة."},{"fr":"le dessert","ar":"الحلوى","pos":"nom","g":"m","exFr":"Comme dessert, il y a de la tarte.","ipa":"[lə de.sɛʁ]","exAr":"أما الحلوى فهناك تارت."},{"fr":"mijoter","ar":"يُطهى على نار هادئة","pos":"verbe","exFr":"Le chef laisse mijoter la sauce.","ipa":"[mi.ʒɔ.te]","exAr":"الطبّاخ يترك الصلصة على نار هادئة."},{"fr":"la casserole","ar":"القِدر","pos":"nom","g":"f","exFr":"Pose la casserole sur le feu.","ipa":"[la ka.sə.ʁɔl]","exAr":"ضع القدور على النار."},{"fr":"la crêpe","ar":"الكريب (الفطيرة الرقيقة)","pos":"nom","g":"f","exFr":"On mange des crêpes le dimanche.","ipa":"[la kʁɛp]","exAr":"نأكل الكريب يوم الأحد."},{"fr":"le cidre","ar":"سايدر التفاح","pos":"nom","g":"m","exFr":"Le cidre est servi bien frais.","ipa":"[lə si.dʁ]","exAr":"يُقدَّم سايدر التفاح بارداً جداً."},{"fr":"le repas","ar":"الوجبة","pos":"nom","g":"m","exFr":"Le repas commence à midi.","ipa":"[lə ʁə.pa]","exAr":"الوجبة تبدأ عند الظهر."},{"fr":"l'apéritif","ar":"المشروب التقديمي","pos":"nom","g":"m","exFr":"On prend l'apéritif sur la terrasse.","ipa":"[la.pe.ʁi.tif]","exAr":"نتناول المشروب التقديمي على الشرفة."},{"fr":"la ratatouille","ar":"الراتاتوي (طبخة برونسالية)","pos":"nom","g":"f","exFr":"La ratatouille est la spécialité du coin.","ipa":"[la ʁa.ta.tuj]","exAr":"الراتاتوي هي طبق المنطقة."},{"fr":"la quiche","ar":"الكيك المملّح (كيخ لورين)","pos":"nom","g":"f","exFr":"La quiche se mange chaude ou froide.","ipa":"[la kiʃ]","exAr":"يُؤكل الكيخ ساخناً أو بارداً."},{"fr":"l'épice","ar":"التوابل","pos":"nom","g":"f","exFr":"Ajoute un peu d'épice dans la sauce.","ipa":"[lepis]","exAr":"أضف قليلاً من التوابل إلى الصلصة."}],"grammar":[{"tFr":"Les partitifs : du / de la / des, et leur chute après la négation","tAr":"القاعدة: أدوات الجزء وتحوّلها إلى de في النفي","body":["أداة الجزء تسبق الأسماء غير المعدودة أو المعدودة جزئياً: du pain، de la sauce، des crêpes — وهي مشتقة من à + le/la/les، وتظهر حين يتكلم الفرد عن جزء من شيء لا عن شيء محدّد.","في النفي يتحوّل الجزء كله إلى de: Il n'y a pas de piment / Je ne mange pas de crêpes — إلا إذا نفيت وجود المعدود ذاته فتبقى التعريفة: Ce n'est pas la sauce. القاعدة واحدة في الإثبات والنفي وتخدم طلب الطعام كله."],"ex":[{"fr":"Il n'y a pas de piment dans cette sauce.","ar":"لا يوجد حار في هذه الصلصة."},{"fr":"Je voudrais des crêpes et du cidre.","ar":"أريد كريب وسايدر تفاح."}]},{"tFr":"Le gérondif : en + verbe -ant","tAr":"القاعدة: اسم الحال بـ en","body":["اسم الحال يتكوّن من en مع المصدر في صيغة -ant: en goûtant، en mijotant، en cuisinant — ويصف حدثاً يتزامن مع الفعل الرئيسي بنفس الفاعل: En cuisinant, on apprend beaucoup (الفاعل واحد: on).","إن اختلف الفاعل انتهى الاستعمال وبات الخطأ: En arrivant, le plat était prêt خطأ لأن الظرف يتبع المتكلّم بينما الفاعل هو الطبق — والصواب En arrivant, j'ai trouvé le plat prêt."],"ex":[{"fr":"En goûtant, on découvre la cuisine du coin.","ar":"عند التذوّق يكتشف المرء بلد المطبخ."},{"fr":"Il a terminé son travail en écoutant la radio.","ar":"أنهى عمله وهو يستمع إلى الراديو."}]}],"mistakes":[{"wrong":"«Je ne mange pas des crêpes le matin.»","right":"«Je ne mange pas de crêpes le matin.»","why":"بعد ne...pas تتحوّل أداة الجزء des إلى de."},{"wrong":"«En arrivant, le plat était prêt.»","right":"«En arrivant, j'ai trouvé le plat prêt.»","why":"فاعل en يجب أن يكون نفس فاعل الجملة."},{"wrong":"«J'ai besoin de un couteau.»","right":"«J'ai besoin d'un couteau.»","why":"de أمام همزة تُمّد إلى d'."}],"dialogues":[{"title":"مائدة إقليمية","ctx":"ضيف عند صاحب البيت","lines":[{"who":"Nour","fr":"Bienvenue ! On commence par l'apéritif, tu préfères quoi ?","ar":"أهلاً! نبدأ بالمشروب التقديمي، ماذا تفضّل؟"},{"who":"Thomas","fr":"Une petite crêpe, s'il te plaît. Et c'est quoi cette sauce ?","ar":"كريبة صغيرة من فضلك. وما هذه الصلصة؟"},{"who":"Nour","fr":"C'est la spécialité du coin : elle mijote depuis deux heures.","ar":"إنها طبق المنطقة: تُطهى منذ ساعتين."},{"who":"Thomas","fr":"Elle est bonne ! Il n'y a pas de piment dedans ?","ar":"إنها لذيذة! أليس فيها شيء حار؟"},{"who":"Nour","fr":"Un peu, mais tu peux boire du cidre avec.","ar":"قليل، لكن يمكنك شرب سايدر التفاح معها."},{"who":"Thomas","fr":"Et le dessert, c'est la tarte du dimanche ?","ar":"أما الحلوى فهل هي تارت الأحد؟"},{"who":"Nour","fr":"Oui, et après on prendra le café sur la terrasse.","ar":"نعم، وبعد ذلك نتناول القهوة على الشرفة."}]}],"exercises":[{"t":"mcq","skill":"grammar","q":"أي جملة تحفظ أداة الجزء بعد النفي؟","opts":["Il n'y a pas de crêpes ce matin.","Il n'y a pas des crêpes ce matin.","Il n'y a pas les crêpes ce matin.","Il n'y a pas une crêpe ce matin."],"a":0,"why":"بعد النفي يتحوّل des إلى de."},{"t":"fill","skill":"writing","q":"أكمل: «Le chef laisse ___ la sauce pendant deux heures.» (يُطهى ببطء)","fr":"Le chef laisse ___ la sauce pendant deux heures.","ans":"mijoter","alts":["Mijoter"],"why":"laisser + مصدر."},{"t":"listen","skill":"listening","q":"[Écoute] أي عبارة مسموعة في مقتطف المائدة الإقليمية؟","opts":["On commence par l'apéritif, ensuite viendra le repas.","On commençait par l'apéritif et le repas.","On commencera l'apéritif avant le repas.","Par l'apéritif on finit le repas."],"a":0,"why":"العبارة الأولى هي المقتطف الحرفي مع «ensuite»."},{"t":"order","skill":"writing","q":"رتّب طلب الطعام على الطاولة","words":["Je","voudrais","du","pain","et","de","la","sauce."],"ans":"Je voudrais du pain et de la sauce.","why":"الفعل المهذّب ← أداة الجزء ← الاسم."},{"t":"translate","skill":"writing","q":"ترجم: «لا يوجد شيء حار في هذه الصلصة.»","ans":"Il n'y a pas de piment dans cette sauce.","alts":["il ny a pas de piment dans cette sauce"],"why":"النفي + أداة الجزء de."},{"t":"correct","skill":"writing","q":"صحّح: «Je ne veux pas des crêpes.»","ans":"Je ne veux pas de crêpes.","alts":["je ne veux pas de crepes"],"why":"des ← de بعد النفي."},{"t":"speaking","skill":"speaking","q":"اطلب وجبة كاملة: مقدمة، طبق رئيسي، حلوى، مشروب — بأربعة أسطر.","target":"Je voudrais... / Ensuite... / Comme dessert... / Pour boire...","why":"سلسلة الطلب في المطعم بأدوات الجزء."},{"t":"mcq","skill":"vocabulary","q":"أي كلمة تدلّ على مكوّن الطبق؟","opts":["l'ingrédient","le dessert","la sauce","le repas"],"a":0,"why":"l'ingrédient هو مكوّن الطبق نفسه."}],"homework":"أعد مشاهدة الحلقة، ثم اكتب قائمة طعام إقليمي: مقدمة، طبق رئيسي، حلوى، مشروب — مستعملاً du/de la/des في كل سطر.\nالحلقة السابقة/التالية: a2-t7-l21 (Quel beau village / يا لها من قرية جميلة) ← a2-t7-l22 → a2-t7-l23 — Révois l'épisode, puis écris le menu d'un repas régional : entrée, plat, dessert, boisson — avec du / de la / des à chaque ligne.","sources":[{"label":"الحلقة الأساسية","videoId":"kb7s1bt01KM","title":"Reflets 2 Episode 07","channel":"Jason Mills","why":"الحلقة السابعة كاملة — المائدة الإقليمية بالنص الأصلي: التقط أدوات الجزء وطلب الطعام من كلام الممثلين.","cat":"Séries","level":"A2","main":true,"t":0},{"label":"مكمّل الدرس","videoId":"dkbo61QDkBM","title":"Top 10 des Spécialités Françaises les plus réputées et appréciées","channel":"FaitsDivers TV","why":"أبرز الأطباق الإقليمية الفرنسية في تسع دقائق — تثبّت أسماء الأطباق التي تسمعها في الحلقة.","cat":"Vocabulaire","level":"A2","extra":true}],"supplements":[{"id":"dkbo61QDkBM","videoId":"dkbo61QDkBM","title":"Top 10 des Spécialités Françaises les plus réputées et appréciées","channel":"FaitsDivers TV","why":"أبرز الأطباق الإقليمية الفرنسية في تسع دقائق — تثبّت أسماء الأطباق التي تسمعها في الحلقة.","dur":9,"lang":"fr","level":"A2"}]},{"id":"a2-t7-l23","fr":"Épisode 23 — Reflets 2, épisode 8","ar":"الحلقة 23 — الموسم الثاني، الحلقة 8","objectives":["التعبير عن ضرورة العمل بـ «il faut + infinitif» وفي الطلب المهذّب بالشرطية","تسمية مفردات المكتب (l'échéance, le classeur, le courrier) وترتيب المهام اليومية","متابعة الحلقة على فيديو Jason Mills واستخراج المواعيد والمهام من الحوار"],"sections":[{"h":"الدرس","video":{"id":"J3_8XhiUQFM","title":"Reflets 2 Episode 08","channel":"Jason Mills","why":"الحلقة الثامنة كاملة — صباح العمل والاجتماع بالنص الأصلي: التقط صيغتَي il faut والطلب المهذّب من الحوار.","lang":"fr","main":true,"t":0,"dur":12},"p":["المشهد يفتح في المكتب صباحاً: اجتماع يبدأ على الساعة، تقرير عليه موعد تسليم، ملفّ ينتظر ترتيباً، وطلب توظيف يردّ على البريد — موقف عمل واحد يجمع فيه الأبطال كلمات المكتب وألحان الأذكار اليومية.","أثناء الاستماع التقط صيغتين تحملان الحوار كله: «Il faut + مصدر» التي تعبّر عن الضرورة (Il faut finir le rapport)، وصيغة الشرطية المهذّبة (Je voudrais..., Pourriez-vous...؟) التي تحوّل كل طلب إلى جملة لائقة بين الزملاء.","انتبه إلى الأصوات الطويلة في é [e] وè [ɛ] داخل l'échéance وl'entretien، وإلى الجسر الصوتي في «vous_avez» و«c'est_le» — فبدونه يبدو حديث المكتب مقطّعاً وغير طبيعي.","قبل المشاهدة: ركّز في المرة الأولى على فهم الفكرة العامة للموقف دون إيقاف الفيديو، وفي المرة الثانية دوّن الكلمات التي تتكرر — خصوصاً l'employé، l'entreprise، la tâche — وحاول استنتاج معناها من السياق قبل الرجوع إلى قاموسك.","بعد المشاهدة: تدرّب على ملخص من ثلاث جمل للكتابة — حدّد الشخصيات وما فعلنا وما شعروا به — ثم استمع مرة أخيرة وقارن نطقك بنطق الممثلين، مع انتباه خاص لنقطة قاعدة الدرس كما وردت في الحوار.","تلميح الأداء: أعد تشغيل المقاطع الصعبة بسرعة 0.75، وأوقف الفيديو عند نهاية كل جملة لتكرارها بصوت عالٍ — هذه الطريقة تثبّت المفردات والنطق معاً وتُعدّك جاهزاً لتمارين هذا الدرس وللدرس التالي في السلسلة."],"sub":[{"h":"النص الصوتي (مقتطف)","p":["Bonjour à tous, la réunion commence à neuf heures.","J'ai terminé le rapport, mais l'échéance est vendredi.","Tu as envoyé ta candidature pour le poste ?","L'employeur propose un entretien jeudi matin.","Range les dossiers dans le classeur, puis on part."]},{"h":"مفردات الموقف","p":["l'employé — الموظف","l'entreprise — المؤسسة","la tâche — المهمة","l'entretien — المقابلة","l'ouvrier — العامل"]},{"h":"تعبيرات جاهزة للاستماع","p":["Quel est ton métier ?","J'ai envoyé ma candidature lundi.","L'employeur organise les entretiens.","Le rapport est prêt pour vendredi.","Range les dossiers dans le classeur."]}]},{"h":"النطق والكلمات المفتاحية","p":["المكتب كلمات طويلة نسبياً، وعليك أن تضبط نهاياتها: l'échéance [le.ʃe.ɑ̃s] بفتحتين ثم أنف، وl'entretien [lɑ̃tʁə.tjɛ̃] بسكون مختزل في المنتصف، وle classeur [lə kla.sœʁ] بنهاية [œʁ] المستديرة — تدرّب على كل كلمة منفردة قبل أن تدخلها في الجملة.","الجسر الصوتي هو علامة المتحدث في هذا الموقف: «vous_avez une minute ?» و«c'est_important» — الصوت يمتد من نهاية s أو t إلى الهمزة أو h التالية بلا توقّف. قرئ الجملة ببطء مرة واحدة بجسر، وبلا جسر مرة أخرى، وستسمع الفرق بنفسك."]},{"h":"محتوى الحلقة","p":["تتقدّم الحلقة كصباح عمل حقيقي: تحية ← موعد الاجتماع ← تقرير وأجل تسليم ← سؤال عن طلب التوظيف ← ترتيب الملفات — كل خطوة تحمل مفرداتها، فستجد أنك تحفظ جدول يوم كامل وأنت تحفظ حواراً واحداً.","حِملَتا القاعدة: «il faut + مصدر» للضرورة الموضوعية (Il faut finir avant vendredi)، وصيغة الشرطية المهذّبة (je voudrais، pourriez-vous) التي تُستعمل بين الزملاء وفي أي رسالة عمل — وكلاهما يفتح عليك باب الفصحى المهذّبة في بيئة العمل.","ما يستحق الحفظ: «La réunion commence à...» لتحديد المواعيد، و«Il faut...» للضرورة، و«Je voudrais...» للطلب، و«Proposer un entretien» لوصف إجراء التوظيف — أربع عبارات تشتغل في أي مكتب فرنسي."]},{"h":"التطبيق والتلخيص","p":["الحلقة 23 — الموسم الثاني، الحلقة 8: المكتب والاجتماع ومهام اليوم، كما في الفيديو الرئيسي «Reflets 2 Episode 08» على قناة Jason Mills: شغّل الحلقة كاملة لتسمع إيقاع العمل، ثم أعد التشغيل وعينك على «Il faut» و«Je voudrais / Pourriez-vous» فقط.","جسر الحلقات: من a2-t7-l22 («Reflets 2, épisode 7 / الموسم الثاني، الحلقة 7») إلى a2-t7-l23 («Reflets 2, épisode 8 / الموسم الثاني، الحلقة 8»)، ثم إلى a2-t7-l24 حيث يخرج الأبطال من المكتب إلى رحلة تجمع الطرود والذكريات وأدوات السفر.","شاهد الحلقة مرة ثانية والنص مفتوح أمامك، ثم افتح ورقة المفردات وراجع اثني عشر مفردة من مفردات العمل (le rapport، l'échéance، le classeur، le courrier...)، وأخيراً سجّل تلخيصاً شفهياً مدته 60 ثانية تصف فيه يوم عمل نمطي عندك مستعملاً «Il faut» وطلبَين مهذّبين."]}],"examples":[{"fr":"Il faut finir le rapport avant vendredi.","ar":"يجب إنهاء التقرير قبل الجمعة.","note":"il faut + مصدر"},{"fr":"Je voudrais prendre rendez-vous avec l'employeur.","ar":"أودّ طلب موعد مع صاحب العمل.","note":"طلب مهذّب"},{"fr":"Pourriez-vous m'aider avec ce classeur ?","ar":"هل يمكنك مساعدتي في ترتيب هذا الملف؟","note":"سؤال مهذّب"},{"fr":"L'entretien aura lieu jeudi matin.","ar":"سيُجرى المقابلة صباح الخميس.","note":"المواعيد"},{"fr":"L'employé arrive à huit heures.","ar":"يصل الموظف في الثامنة."},{"fr":"L'entreprise compte cinquante personnes.","ar":"تضمّ المؤسسة خمسين شخصاً."}],"pron":[{"w":"l'échéance","ipa":"[le.ʃe.ɑ̃s]","approx":"ليشيانس"},{"w":"le rapport","ipa":"[lə ʁa.pɔʁ]","approx":"لو رابور"},{"w":"l'entretien","ipa":"[lɑ̃tʁə.tjɛ̃]","approx":"أونتريتيان"},{"w":"le classeur","ipa":"[lə kla.sœʁ]","approx":"لو كلاسور"}],"vocab":[{"fr":"l'employé","ar":"الموظف","pos":"nom","g":"m","exFr":"L'employé arrive à huit heures.","ipa":"[lɑ̃.plɔ.we]","exAr":"يصل الموظف في الثامنة."},{"fr":"l'entreprise","ar":"المؤسسة","pos":"nom","g":"f","exFr":"L'entreprise compte cinquante personnes.","ipa":"[lɑ̃tʁə.pʁiz]","exAr":"تضمّ المؤسسة خمسين شخصاً."},{"fr":"le dossier","ar":"المهمة","pos":"nom","g":"f","exFr":"Cette tâche prend deux jours.","ipa":"[la taʃ]","exAr":"تستغرق هذه المهمة يومين."},{"fr":"l'entretien","ar":"المقابلة","pos":"nom","g":"m","exFr":"L'entretien est prévu à dix heures.","ipa":"[lɑ̃tʁə.tjɛ̃]","exAr":"المقابلة مبرمجة في العاشرة."},{"fr":"l'ouvrier","ar":"العامل","pos":"nom","g":"m","exFr":"Les ouvriers finissent à seize heures.","ipa":"[lu.vʁi.e]","exAr":"ينهي العمال عملهم في الرابعة."},{"fr":"le métier","ar":"الحرفة/المهنة","pos":"nom","g":"m","exFr":"Quel est ton métier ?","ipa":"[lə me.tje]","exAr":"ما مهنتك؟"},{"fr":"la candidature","ar":"طلب التوظيف","pos":"nom","g":"f","exFr":"J'ai envoyé ma candidature lundi.","ipa":"[la kɑ̃.di.dy.tyʁ]","exAr":"أرسلت طلب التوظيف يوم الاثنين."},{"fr":"l'employeur","ar":"صاحب العمل","pos":"nom","g":"m","exFr":"L'employeur organise les entretiens.","ipa":"[lɑ̃.plwa.jœʁ]","exAr":"صاحب العمل ينظّم المقابلات."},{"fr":"le rapport","ar":"التقرير","pos":"nom","g":"m","exFr":"Le rapport est prêt pour vendredi.","ipa":"[lə ʁa.pɔʁ]","exAr":"التقرير جاهز لليوم الجمعة."},{"fr":"le classeur","ar":"ملف الأوراق","pos":"nom","g":"m","exFr":"Range les dossiers dans le classeur.","ipa":"[lə kla.sœʁ]","exAr":"رتّب الملفات في ملف الأوراق."},{"fr":"l'échéance","ar":"أجل التسليم","pos":"nom","g":"f","exFr":"L'échéance du projet est vendredi.","ipa":"[le.ʃe.ɑ̃s]","exAr":"أجل تسليم المشروع يوم الجمعة."},{"fr":"le courrier","ar":"المراسلات","pos":"nom","g":"m","exFr":"Le courrier arrive à neuf heures.","ipa":"[lə ku.ʁje]","exAr":"تصل المراسلات في التاسعة."}],"grammar":[{"tFr":"Il faut + infinitif : la nécessité","tAr":"القاعدة: ضرورة العمل بـ il faut","body":["«Il faut» فعل غير شخصي يعني «من الضروري» ويأخذ المصدر مباشرة: Il faut finir، Il faut partir، Il faut envoyer le courrier — ولا يحتاج فاعلاً حقيقياً لأن الضرورة نفسها هي الفاعل.","حين يختلف الفاعل يتحوّل البناء إلى «il faut que + subjonctif»: Il faut que tu finisses — أما مع نفس الفاعل فيبقى المصدر. استعمل «Il faut + مصدر» في تعليمات العمل القصيرة وفي رسائلك المهنية."],"ex":[{"fr":"Il faut terminer la tâche avant midi.","ar":"يجب إنهاء المهمة قبل الظهر."},{"fr":"Il faut que je lise le rapport ce soir.","ar":"يجب أن أقرأ التقرير هذا المساء."}]},{"tFr":"Le conditionnel de politesse : je voudrais, pourriez-vous","tAr":"القاعدة: صيغة الطلب المهذّب","body":["الشرطية ليست زمناً هنا بل نبرة: «Je voudrais» و«Pourriez-vous» تحوّلان الطلب المباشر إلى جملة لائقة بين الزملاء وفي أي مقابلة: Je voudrais parler à l'employeur / Pourriez-vous m'aider ?","التكوين من المستقبل بقلب النهاية: voudrais من voudrai، pourriez من pourrez — وفي السؤال ينفصل الفاعل: Pourriez-vous..., مع بقاء الفعل متصلاً بالفاعل. حفظ الصيغتين يكفيك أغلب مواقف العمل المهذّبة."],"ex":[{"fr":"Je voudrais prendre rendez-vous jeudi.","ar":"أودّ طلب موعد يوم الخميس."},{"fr":"Pourriez-vous répéter la question, s'il vous plaît ?","ar":"هل يمكنك إعادة السؤال من فضلك؟"}]}],"mistakes":[{"wrong":"«Il faut de finir le rapport.»","right":"«Il faut finir le rapport.»","why":"il faut يأخذ المصدر مباشرة بلا حرف جر."},{"wrong":"«Pourriez-vous de m'aider ?»","right":"«Pourriez-vous m'aider ?»","why":"الفعل المهلّب يأخذ ما بعده مباشرة."},{"wrong":"«J'ai travaillé à le bureau hier.»","right":"«J'ai travaillé au bureau hier.»","why":"à + le تنحت إلى au."}],"dialogues":[{"title":"صباح في المكتب","ctx":"زميلان قبل الاجتماع","lines":[{"who":"Lina","fr":"Bonjour ! La réunion commence à neuf heures, tu es prête ?","ar":"صباح الخير! الاجتماع يبدأ في التاسعة، هل أنتِ جاهزة؟"},{"who":"Karim","fr":"Presque. Il faut finir le rapport avant midi.","ar":"تقريباً. يجب إنهاء التقرير قبل الظهر."},{"who":"Lina","fr":"Et l'échéance du projet, c'est vendredi, non ?","ar":"وأجل تسليم المشروع هو الجمعة، أليس كذلك؟"},{"who":"Karim","fr":"Oui. Tu as envoyé ta candidature à l'employeur ?","ar":"نعم. هل أرسلتِ طلب التوظيف إلى صاحب العمل؟"},{"who":"Lina","fr":"Hier. Il propose un entretien jeudi matin.","ar":"أمس. إنه يقترح مقابلة صباح الخميس."},{"who":"Karim","fr":"Il faudra arriver tôt. Range le courrier dans le classeur.","ar":"سيتعين الوصول مبكراً. رتّبي المراسلات في ملف الأوراق."},{"who":"Lina","fr":"D'accord, et après la réunion, on prend un café ?","ar":"حسناً، وبعد الاجتماع نتناول قهوة؟"}]}],"exercises":[{"t":"mcq","skill":"grammar","q":"أي جملة صحيحة مع «il faut»؟","opts":["Il faut finir le rapport.","Il faut de finir le rapport.","Il faut à finir le rapport.","Il faut que finir le rapport."],"a":0,"why":"il faut + مصدر مباشرة."},{"t":"fill","skill":"writing","q":"أكمل: «Je ___ prendre rendez-vous avec l'employeur.» (أودّ)","fr":"Je ___ prendre rendez-vous avec l'employeur.","ans":"voudrais","alts":["Voudrais"],"why":"vouloir + مصدر بصيغة الطلب المهذّب."},{"t":"listen","skill":"listening","q":"[Écoute] أي عبارة مسموعة في مقتطف صباح المكتب؟","opts":["J'ai terminé le rapport, mais l'échéance est vendredi.","J'ai terminé le rapport, mais l'échéance est lundi.","J'ai commencé le rapport avant l'échéance.","Le rapport finit avec l'échéance de mars."],"a":0,"why":"العبارة الأولى هي المقتطف الحرفي مع «vendredi»."},{"t":"order","skill":"writing","q":"رتّب جملة الاجتماع","words":["Il","faut","finir","le","rapport","avant","vendredi."],"ans":"Il faut finir le rapport avant vendredi.","why":"il faut ← المصدر ← المفعول ← الظرف الزمني."},{"t":"translate","skill":"writing","q":"ترجم: «هل يمكنك مساعدتي في هذا الملف؟»","ans":"Pourriez-vous m'aider avec ce classeur ?","alts":["pourriez vous maider avec ce classeur"],"why":"Pourriez-vous + ضمير متصل + avec."},{"t":"correct","skill":"writing","q":"صحّح: «J'ai travaillé à le bureau hier.»","ans":"J'ai travaillé au bureau hier.","alts":["j ai travaille au bureau hier"],"why":"à + le = au قبل اسم المكان."},{"t":"speaking","skill":"speaking","q":"اطلب موعداً مهذّباً مع صاحب العمل، ثم اذكر سبب الطلب في جملة.","target":"Je voudrais... / Pourriez-vous... / parce que...","why":"الطلب المهذّب في وضعية عمل حقيقية."},{"t":"mcq","skill":"vocabulary","q":"أي كلمة تعني «أجل التسليم»؟","opts":["l'échéance","le courrier","le classeur","la candidature"],"a":0,"why":"l'échéance هو الموعد النهائي لتسليم عمل."}],"homework":"أعد مشاهدة الحلقة، ثم اكتب وسجّل وصف يوم عملك أو دراستك: ضرورة واحدة بصيغة «Il faut...» وطلبَين مهذّبين.\nالحلقة السابقة/التالية: a2-t7-l22 (Reflets 2, épisode 7 / الموسم الثاني، الحلقة 7) ← a2-t7-l23 → a2-t7-l24 — Révois l'épisode, puis écris et enregistre la description de ta journée de travail ou d'études : une nécessité avec « Il faut... » et deux demandes polies.","sources":[{"label":"الحلقة الأساسية","videoId":"J3_8XhiUQFM","title":"Reflets 2 Episode 08","channel":"Jason Mills","why":"الحلقة الثامنة كاملة — صباح العمل والاجتماع بالنص الأصلي: التقط صيغتَي il faut والطلب المهذّب من الحوار.","cat":"Séries","level":"A2","main":true,"t":0},{"label":"مكمّل الدرس","videoId":"X_sGkN6ptHU","title":"Dialogues en Français au Travail - Français au Bureau","channel":"Daily French Conversations","why":"حوارات قصيرة من الحياة المكتبية الفرنسية — تكرّر فيها صيغ il faut والطلب المهذّب على إيقاع طبيعي.","cat":"Professional","level":"A2","extra":true}],"supplements":[{"id":"X_sGkN6ptHU","videoId":"X_sGkN6ptHU","title":"Dialogues en Français au Travail - Français au Bureau","channel":"Daily French Conversations","why":"حوارات قصيرة من الحياة المكتبية الفرنسية — تكرّر فيها صيغ il faut والطلب المهذّب على إيقاع طبيعي.","dur":13,"lang":"fr","level":"A2"}]},{"id":"a2-t7-l24","fr":"Épisode 24 — Reflets 2, épisode 9","ar":"الحلقة 24 — الموسم الثاني، الحلقة 9","objectives":["رواي رحلة قصيرة بالماضي مع أدوات الربط «avant de» و«après»","تسمية مفردات السفر والذكريات (les souvenirs, la nuitée, l'hébergement) ووصف برنامج الرحلة","متابعة الحلقة على فيديو Jason Mills واستخراج ترتيب الرحلة والانطباعات من الحوار"],"sections":[{"h":"الدرس","video":{"id":"qFJ9qc9oFJY","title":"Reflets 2 Episode 09","channel":"Jason Mills","why":"الحلقة التاسعة كاملة — الرحلة والذكريات بالنص الأصلي: اربط زمن الحكي بأدوات avant / après من كلام الممثلين.","lang":"fr","main":true,"t":0,"dur":10},"p":["المشهد يجمع بين الإجازة والذاكرة: حجز مبيت قرب المحطة، كارنيه سفر يُملأ ببطاقات بريدية، طقائم صغيرة تُحفظ كتذكار، وحديث يجري بعد العودة عن أجمل ما شوهد في الرحلة.","أثناء الاستماع التقط علامات الزمن: «avant de + مصدر» لما قبل الانطلاق، و«après + مصدر/اسم» لما بعد الزيارة، وظروف التكرار déjà / encore / toujours / jamais التي تضبط نبرة الحكي الفرنسي كلّه.","انتبه إلى الجسر الصوتي في «cartes_postales» و«c'est_une»، وإلى النهاية الصوتية [ə] في l'étranger التي تخرج خفيفة من الفم — هذان الصوتان يمنحان وصف الرحلة إيقاعه الفرنسي.","قبل المشاهدة: ركّز في المرة الأولى على فهم الفكرة العامة للموقف دون إيقاف الفيديو، وفي المرة الثانية دوّن الكلمات التي تتكرر — خصوصاً les souvenirs، le carnet، la carte postale — وحاول استنتاج معناها من السياق قبل الرجوع إلى قاموسك.","بعد المشاهدة: تدرّب على ملخص من ثلاث جمل للكتابة — حدّد الشخصيات وما فعلنا وما شعروا به — ثم استمع مرة أخيرة وقارن نطقك بنطق الممثلين، مع انتباه خاص لنقطة قاعدة الدرس كما وردت في الحوار.","تلميح الأداء: أعد تشغيل المقاطع الصعبة بسرعة 0.75، وأوقف الفيديو عند نهاية كل جملة لتكرارها بصوت عالٍ — هذه الطريقة تثبّت المفردات والنطق معاً وتُعدّك جاهزاً لتمارين هذا الدرس وللدرس التالي في السلسلة."],"sub":[{"h":"النص الصوتي (مقتطف)","p":["C'est ta première fois à l'étranger ?","J'ai réservé une nuitée près de la gare.","Dans mon carnet, je colle les cartes postales.","On a fait cette escapade au mois de mai.","Le plus beau souvenir, c'est la découverte du vieux port."]},{"h":"مفردات الموقف","p":["les souvenirs — الذكريات","le carnet — الكرّاس","la carte postale — البطاقة البريدية","l'escapade — النزهة القصيرة","la découverte — الاكتشاف"]},{"h":"تعبيرات جاهزة للاستماع","p":["J'ai réservé une nuitée près de la gare.","C'est sa première fois à l'étranger.","L'itinéraire est dans le carnet.","Le séjour dure une semaine.","La malle est déjà dans le couloir."]}]},{"h":"النطق والكلمات المفتاحية","p":["كلمة l'étranger تنتهي بهمزة مكسورة خفيفة [ə] لا بـ [e] المفتوحة: [le.tʁɑ̃.ʒə] — وقفاً قصيراً عند نهايتها يكفي لتبدو طبيعية. وla nuitée [la nɥi.te] تحمل مزيج [ɥ] النادر في أولها، فحرّك شفتيك للداخل واقرأ «نوِيتي» بلمحة واحدة.","الجسر الصوتي يلمع في الجمع: «les cartes postales» تنطق كأنها كلمة واحدة [le kaʁt pɔs.tal]، و«les souvenirs» [le suv.niʁ] بنهاية [ʁ] المتموّجة. تدرّب على أزواج الجمع والمفرد بصوت عالٍ: un souvenir / des souvenirs، une carte / des cartes."]},{"h":"محتوى الحلقة","p":["تتقدّم الحلقة كروايَة رحلة: الاستعداد ← الحجز ← الأماكن المزروعة ← الذكريات بعد العودة — وهذا الترتيب الزمني نفسه هو الذي يحكم الجمل، فستجد الماضي المركّب في الأحداث المنجزة والناقص في الخلفية والوصف.","حِملَتا القاعدة: أدوات الربط الزمني «avant de + مصدر» (Avant de partir, j'ai vérifié l'itinéraire) و«après + اسم أو مصدر» (Après la visite, on a mangé...)؛ وظروف التكرار déjà / encore / toujours / jamais التي تأتي قبل الفعل المركّب أو بعده مباشرة وتحوّل الحكي إلى تقرير طبيعي.","ما يستحق الحفظ: «C'est ma première fois...» للتجربة الأولى، و«J'ai réservé...» للحجز، و«Le plus beau souvenir, c'est...» لاختيار الذكرى، و«On a fait une escapade...» لوصف الرحلة القصيرة — أربع عبارات تحكي بها أي إجازة."]},{"h":"التطبيق والتلخيص","p":["الحلقة 24 — الموسم الثاني، الحلقة 9: الرحلة والذكريات وروايَة الماضي، كما في الفيديو الرئيسي «Reflets 2 Episode 09» على قناة Jason Mills: شغّل الحلقة كاملة لتسمع سياق الحكي، ثم أعد التشغيل وعينك على «avant de / après» و«déjà / jamais» فقط.","جسر الحلقات: من a2-t7-l23 («Reflets 2, épisode 8 / الموسم الثاني، الحلقة 8») إلى a2-t7-l24 («Reflets 2, épisode 9 / الموسم الثاني، الحلقة 9»)، ثم إلى a2-t7-l25 حيث تتحوّل الرحلة القصيرة إلى حفل زفاف وخطاب يُلقى أمام الحضور.","شاهد الحلقة مرة ثانية والنص مفتوح أمامك، ثم افتح ورقة المفردات وراجع اثني عشر مفردة من مفردات السفر (les souvenirs، le carnet، la nuitée، l'hébergement...)، وأخيراً سجّل تلخيصاً شفهياً مدته 60 ثانية تحكي فيه رحلة قصيرة: قبل الانطلاق، بعد الوصول، الذكرى الأجمل."]}],"examples":[{"fr":"Avant de partir, j'ai vérifié l'itinéraire.","ar":"قبل الانطلاق تحقّقت من المسار.","note":"avant de + مصدر"},{"fr":"Après la visite, on a mangé près du port.","ar":"بعد الزيارة أكلنا قرب الميناء.","note":"après + اسم"},{"fr":"J'ai déjà vu ce village, c'est ma deuxième visite.","ar":"رأيتُ القرية من قبل، إنها زيارتي الثانية.","note":"ظرف déjà"},{"fr":"Ce séjour restera un beau souvenir.","ar":"ستبقى هذه الإجازة ذكرى جميلة.","note":"المستقبل للتعبير عن البقاء"},{"fr":"Les souvenirs de voyage restent longtemps.","ar":"تبقى ذكريات السفر طويلاً."},{"fr":"J'écris tout dans mon carnet.","ar":"أكتب كل شيء في كرّاسي."}],"pron":[{"w":"l'étranger","ipa":"[le.tʁɑ̃.ʒə]","approx":"لوتريانج"},{"w":"la nuitée","ipa":"[la nɥi.te]","approx":"لا نْيوتي"},{"w":"les souvenirs","ipa":"[le suv.niʁ]","approx":"لو سُفنيْر"},{"w":"la carte postale","ipa":"[la kaʁt pɔs.tal]","approx":"لا كارت بوستال"}],"vocab":[{"fr":"les souvenirs","ar":"الذكريات","pos":"nom","g":"m.pl","exFr":"Les souvenirs de voyage restent longtemps.","ipa":"[le suv.niʁ]","exAr":"تبقى ذكريات السفر طويلاً."},{"fr":"le carnet","ar":"الكرّاس","pos":"nom","g":"m","exFr":"J'écris tout dans mon carnet.","ipa":"[lə kaʁ.nɛ]","exAr":"أكتب كل شيء في كرّاسي."},{"fr":"le jalon","ar":"البطاقة البريدية","pos":"nom","g":"f","exFr":"Elle a envoyé une carte postale de la plage.","ipa":"[la kaʁt pɔs.tal]","exAr":"أرسلت بطاقة بريدية من الشاطئ."},{"fr":"l'escapade","ar":"النزهة القصيرة","pos":"nom","g":"f","exFr":"On a fait une escapade le week-end.","ipa":"[lɛs.ka.pad]","exAr":"أجرينا نزهة قصيرة في عطلة الأسبوع."},{"fr":"la découverte","ar":"الاكتشاف","pos":"nom","g":"f","exFr":"La découverte du vieux port était magique.","ipa":"[la de.ku.vɛʁt]","exAr":"كان اكتشاف الميناء القديم سحرياً."},{"fr":"la nuitée","ar":"مبيت ليلة واحدة","pos":"nom","g":"f","exFr":"J'ai réservé une nuitée près de la gare.","ipa":"[la nɥi.te]","exAr":"حجزتُ مبيت ليلة قرب المحطة."},{"fr":"l'étranger","ar":"الخارج (بلاد أخرى)","pos":"nom","g":"m","exFr":"C'est sa première fois à l'étranger.","ipa":"[le.tʁɑ̃.ʒə]","exAr":"إنها المرة الأولى له في الخارج."},{"fr":"l'itinéraire","ar":"المسار","pos":"nom","g":"m","exFr":"L'itinéraire est dans le carnet.","ipa":"[li.ti.ne.ɛʁ]","exAr":"المسار في الكرّاس."},{"fr":"le séjour","ar":"الإقامة/الإجازة","pos":"nom","g":"m","exFr":"Le séjour dure une semaine.","ipa":"[lə seʒuʁ]","exAr":"تدوم الإجازة أسبوعاً."},{"fr":"la malle","ar":"الصندوق السفري","pos":"nom","g":"f","exFr":"La malle est déjà dans le couloir.","ipa":"[la mal]","exAr":"الصندوق السفري في الممرّ أصلاً."},{"fr":"la réservation","ar":"الحجز","pos":"nom","g":"f","exFr":"La réservation est au nom de Karim.","ipa":"[la ʁe.zɛʁ.va.sjɔ̃]","exAr":"الحجز باسم كريم."},{"fr":"l'hébergement","ar":"السكن المؤقت","pos":"nom","g":"m","exFr":"L'hébergement est près du vieux port.","ipa":"[le.bɛʁ.ʒəmɑ̃]","exAr":"السكن المؤقت قرب الميناء القديم."}],"grammar":[{"tFr":"Avant de + infinitif / après + nom ou infinitif","tAr":"القاعدة: ترتيب الحكي قبل وبعد","body":["«Avant de» لا تأتي إلا مع المصدر: Avant de partir, j'ai vérifié l'itinéraire — والحرف de يمّد إلى d' أمام الهمزة: avant d'arriver. أما «après» فتأتي مع الاسم (après la visite) أو مع المصدر (après avoir mangé).","الاثنان يبنيان تسلسل الرحلة كله: تحضير ← تنفيذ ← حساب. احفظهما مع الفعل الذي يليهما لا منفردين، فلكل واحد موقعه الثابت في الجملة: avant de + مصدر، après + اسم/مصدر."],"ex":[{"fr":"Avant de réserver, j'ai cherché un hébergement pas cher.","ar":"قبل الحجز بحثت عن سكن غير غالٍ."},{"fr":"Après avoir visité le musée, on est rentré.","ar":"بعد زيارة المتحف عدنا."}]},{"tFr":"Les adverbes de fréquence : déjà, encore, toujours, jamais","tAr":"القاعدة: ظروف التكرار في الرواية","body":["déjà (من قبل)، encore (ما زال)، toujours (دائماً)، jamais (قط) تأتي قبل الفعل المركّب أو بعد جزءه الأول: J'ai déjà vu / Je n'ai jamais vu / Il est toujours en voyage — وهي التي تملي نبرة الحكي الفرنسي.","كلمة jamais تعمل مع النفي في الفرنسية: «Je n'ai jamais» تعني «لم أفعل قط»، ولا تُستعمل مفردة مثبتة بمعنى «أبداً» كما في الإنجليزية — فهذه أخطاء المتسرّعين."],"ex":[{"fr":"J'ai déjà réservé la nuitée.","ar":"حجزتُ المبيت من قبل."},{"fr":"Je n'ai jamais oublié ce séjour.","ar":"لم أنسَ هذه الإجازة قط."}]}],"mistakes":[{"wrong":"«Avant de partir, j'ai vérifié le itinéraire.»","right":"«Avant de partir, j'ai vérifié l'itinéraire.»","why":"de أمام همزة تُمّد إلى d'."},{"wrong":"«J'ai jamais vu un coucher de soleil pareil.»","right":"«Je n'ai jamais vu un coucher de soleil pareil.»","why":"النفي الفرنسي يبدأ بـ ne مهما بدأت الجملة."},{"wrong":"«Je suis allé en France depuis deux ans.»","right":"«Je suis en France depuis deux ans.»","why":"depuis يرتبط بالحاضر لا بحدث منتهٍ."}],"dialogues":[{"title":"ذكريات رحلة","ctx":"صديقان بعد العودة","lines":[{"who":"Yasmine","fr":"Alors, ce séjour à la mer, tu en gardes quel souvenir ?","ar":"ها هي إجازتك على البحر، أي ذكرى تحتفظ بها؟"},{"who":"Mehdi","fr":"Le plus beau, c'est la découverte du vieux port.","ar":"الأجمل هو اكتشاف الميناء القديم."},{"who":"Yasmine","fr":"Tu as déjà collé les cartes postales dans ton carnet ?","ar":"هل الصقت البطاقات البريدية في كرّاسك من قبل؟"},{"who":"Mehdi","fr":"Pas encore. Avant de ranger, j'ai acheté des souvenirs.","ar":"ليس بعد. قبل الترتيب اشتريتُ تذكارات."},{"who":"Yasmine","fr":"Moi, j'ai réservé une nuitée près de la gare pour la prochaine fois.","ar":"أنا حجزتُ مبيت ليلة قرب المحطة للمرة القادمة."},{"who":"Mehdi","fr":"Bonne idée. On partira avec un itinéraire précis.","ar":"فكرة جيدة. سننطلق بمسار دقيق."},{"who":"Yasmine","fr":"D'accord, mais cette fois on prend la malle, pas le sac de sport !","ar":"حسناً، لكن هذه المرة نأخذ الصندوق السفري لا حقيبة الرياضة!"}]}],"exercises":[{"t":"mcq","skill":"grammar","q":"ما الترتيب الصحيح قبل الانطلاق؟","opts":["Avant de partir, j'ai réservé une nuitée.","Avant partir, j'ai réservé une nuitée.","Avant à partir, j'ai réservé une nuitée.","Avant de avoir réservé, je pars."],"a":0,"why":"avant de + مصدر دائماً."},{"t":"fill","skill":"writing","q":"أكمل: «___ la visite, on a mangé près du port.» (بعد)","fr":"___ la visite, on a mangé près du port.","ans":"Après","alts":["après","Apres","apres"],"why":"après + اسم."},{"t":"listen","skill":"listening","q":"[Écoute] أي عبارة مسموعة في مقتطف رحلة الصديقين؟","opts":["J'ai réservé une nuitée près de la gare.","J'ai réservé une nuitée près de l'aéroport.","J'ai réservé deux nuitsées à l'hôtel.","J'ai annulé la nuitée de la gare."],"a":0,"why":"العبارة الأولى هي المقتطف الحرفي مع «près de la gare»."},{"t":"order","skill":"writing","q":"رتّب جملة الاستعداد للرحلة","words":["Avant","de","partir","j'ai","vérifié","l'itinéraire."],"ans":"Avant de partir j'ai vérifié l'itinéraire.","why":"avant de + مصدر ← الحدث المنجز."},{"t":"translate","skill":"writing","q":"ترجم: «لم أرَ ميناءً كهذا قط.»","ans":"Je n'ai jamais vu un port comme celui-ci.","alts":["je n ai jamais vu un port comme celui ci","je nai jamais vu un port comme celui-ci"],"why":"ne... jamais + اسم الفعل."},{"t":"correct","skill":"writing","q":"صحّح: «J'ai jamais gardé un souvenir pareil.»","ans":"Je n'ai jamais gardé un souvenir pareil.","alts":["je n ai jamais garde un souvenir pareil"],"why":"ne إلزامية في النفي الفرنسي."},{"t":"speaking","skill":"speaking","q":"احكِ رحلة قصيرة في أربع جمل: قبل الانطلاق، بعد الوصول، أجمل ما رأيت، الذكرى.","target":"Avant de... / Après... / Le plus beau... / Un souvenir...","why":"ربط الحكي الزمني في سرد تجربة."},{"t":"mcq","skill":"vocabulary","q":"أي كلمة تعني «مبيت ليلة واحدة»؟","opts":["la nuitée","le séjour","l'hébergement","la réservation"],"a":0,"why":"la nuitée هي الليلة الواحدة، والـ séjour إجازة كاملة."}],"homework":"أعد مشاهدة الحلقة، ثم احكِ إحدى نزهاتك في أربع جمل: قبل أن...، بعد...، أجمل ذكرى، وأغلى ما أحضرت.\nالحلقة السابقة/التالية: a2-t7-l23 (Reflets 2, épisode 8 / الموسم الثاني، الحلقة 8) ← a2-t7-l24 → a2-t7-l25 — Révois l'épisode, puis raconte une de tes sorties en quatre phrases : avant de..., après..., le plus beau souvenir, un objet rapporté.","sources":[{"label":"الحلقة الأساسية","videoId":"qFJ9qc9oFJY","title":"Reflets 2 Episode 09","channel":"Jason Mills","why":"الحلقة التاسعة كاملة — الرحلة والذكريات بالنص الأصلي: اربط زمن الحكي بأدوات avant / après من كلام الممثلين.","cat":"Séries","level":"A2","main":true,"t":0},{"label":"مكمّل الدرس","videoId":"7B-nyTMPbH4","title":"Carnet de voyage : Guide pour faire son carnet","channel":"TitouTrips - Voyage Enfants Famille","why":"دليل عملي لصنع كارنيه السفر خطوة بخطوة — يربط كلمات الذكريات بمهمة تفعلها بنفسك.","cat":"Conversation","level":"A2","extra":true}],"supplements":[{"id":"7B-nyTMPbH4","videoId":"7B-nyTMPbH4","title":"Carnet de voyage : Guide pour faire son carnet","channel":"TitouTrips - Voyage Enfants Famille","why":"دليل عملي لصنع كارنيه السفر خطوة بخطوة — يربط كلمات الذكريات بمهمة تفعلها بنفسك.","dur":13,"lang":"fr","level":"A2"}]},{"id":"a2-t7-l25","fr":"Épisode 25 — Un beau mariage","ar":"الحلقة 25 — زواجٌ جميل","objectives":["إلقاء تهنئة قصيرة بصيغة «Je souhaite que + subjonctif» و«ce qui / ce que»","تسمية مفردات الحفل (les alliances, la piste de danse, le dîner) ووصف برنامج اليوم","متابعة الحلقة على فيديو Jason Mills واستخراج ترتيب الحفل من مراسم البلدية إلى ساحة الرقص"],"sections":[{"h":"الدرس","video":{"id":"Bo1mO3oudQo","title":"Reflets 2 Episode 10","channel":"Jason Mills","why":"الحلقة العاشرة كاملة — حفل الزفاف وخطابه بالنص الأصلي: احفظ صيغ التهنئة قبل أن تلقيها بنفسك.","lang":"fr","main":true,"t":0,"dur":11},"p":["الحلقة تنقلنا إلى حفل زفاف كامل: مراسم أمام المأذون، تبادل الخواتم، مأدبة عائلية، وخطابات قصيرة يتبادلها الحضور — وكل خطاب فيها نموذج صغير للفصحى المهذّبة التي ستستعملها في أي مناسبة.","أثناء الاستماع التقط ثلاث صيغ تحمل الخطاب كله: «Je souhaite que + subjonctif» للأمنية (Je souhaite que vous soyez heureux)، و«ce qui / ce que» لما يُبرز (Ce qui m'a touché...)، وفعل الأمر المهذّب في رفع الكأس (Levez vos verres !).","انتبه إلى الجسر الصوتي في «les_alliances» و«vous_êtes»، وإلى صوت [ø] المستدير في vœux [vø]، وإلى المدّ في dîner [di.ne] — ثلاثة أصوات تمنح نبرة الخطاب الفرنسية طابعها الرسمي.","قبل المشاهدة: ركّز في المرة الأولى على فهم الفكرة العامة للموقف دون إيقاف الفيديو، وفي المرة الثانية دوّن الكلمات التي تتكرر — خصوصاً le couple، le dîner، la piste de danse — وحاول استنتاج معناها من السياق قبل الرجوع إلى قاموسك.","بعد المشاهدة: تدرّب على ملخص من ثلاث جمل للكتابة — حدّد الشخصيات وما فعلنا وما شعروا به — ثم استمع مرة أخيرة وقارن نطقك بنطق الممثلين، مع انتباه خاص لنقطة قاعدة الدرس كما وردت في الحوار.","تلميح الأداء: أعد تشغيل المقاطع الصعبة بسرعة 0.75، وأوقف الفيديو عند نهاية كل جملة لتكرارها بصوت عالٍ — هذه الطريقة تثبّت المفردات والنطق معاً وتُعدّك جاهزاً لتمارين هذا الدرس وللدرس التالي في السلسلة."],"sub":[{"h":"النص الصوتي (مقتطف)","p":["Je souhaite que vous soyez heureux tous les deux.","C'est ce qui m'a touché depuis le premier jour.","La piste de danse est déjà pleine de monde.","Levez vos verres à la mariée et au mari !","Nous avons échangé les alliances devant le maire."]},{"h":"مفردات الموقف","p":["le couple — الزوجان","le dîner — العشاء","la piste de danse — ساحة الرقص","les alliances — خواتم الزفاف","la mariée — العروس"]},{"h":"تعبيرات جاهزة للاستماع","p":["Le mari reçoit les invités à l'entrée.","Toutes nos félicitations !","La danse continue jusqu'à minuit.","La lune de miel aura lieu en septembre.","Le faire-part est très élégant."]}]},{"h":"النطق والكلمات المفتاحية","p":["الخطاب كلمات مدوّرة طويلة، وعليك أن تضبط نهاياتها: les vœux [le vø] بالمستدير [ø] التي تُصنع بتحريك الشفتين للداخل مع لسان الأمامية، وla piste de danse [la pist dɑ̃s] بالجسر الصوتي بين البيست والدانس، وles alliances [lez a.li.jɑ̃s] بجسر أيضاً.","النبرة في خطاب المناسبة ليست نبرة الحكي اليومي: الجمل أبطأ، وكلمة واحدة تُرفع قليلاً (heureux، déjà، pleine). استمع للممثلين ثلاث مرات وحاول تقليد المكان نفسه الذي ترفع فيه الكلمة، فهذا أسرع طريق لخطاب فرنسي مسموع لا مترجم."]},{"h":"محتوى الحلقة","p":["تتقدّم الحلقة كبرنامج حفل: الترحيب ← الخطاب ← الخواتم ← العشاء ← الراقصة — وكل مرحلة تأتي بمفرداتها وصيغها، فستحفظ مناسبة كاملة وأنت تحفظ موقفاً واحداً.","حِملَتا القاعدة: صيغة المنصوب بعد أفعال الرغبة والتهنئة (Je souhaite que vous soyez heureux)، وضمائر الوصل ce qui للفاعل وce que للمفعول (Ce qui m'a touché... / Ce que je voudrais dire...) — وهما الصيغتان اللتان يجعلان خطابك متماسكاً لا مجموعة جمل.","ما يستحق الحفظ: «Je souhaite que...» للأمنية، و«Ce qui m'a touché, c'est...» لللمست الشخصية، و«Toutes nos félicitations !» للتهنئة، و«Levez vos verres !» لرفع الكأس — أربع عبارات تخرج منك في أي مناسبة فرنسية."]},{"h":"التطبيق والتلخيص","p":["الحلقة 25 — زواجٌ جميل: حفل الزفاف وخطابه بصيغ التهنئة، كما في الفيديو الرئيسي «Reflets 2 Episode 10» على قناة Jason Mills: شغّل الحلقة كاملة لتسمع نبرة الخطاب، ثم أعد التشغيل وعينك على «Je souhaite que» و«ce qui / ce que» فقط.","جسر الحلقات: من a2-t7-l24 («Reflets 2, épisode 9 / الموسم الثاني، الحلقة 9») إلى a2-t7-l25 («Un beau mariage / زواجٌ جميل»)، ثم إلى a2-t7-l26 حيث يفتح المشهد المقبل باب حلقة جديدة من السلسلة بعد انتهاء هذا الحفل.","شاهد الحلقة مرة ثانية والنص مفتوح أمامك، ثم افتح ورقة المفردات وراجع اثني عشر مفردة من مفردات المناسبة (le couple، le serment، les alliances، la piste de danse...)، وأخيراً سجّل تلخيصاً شفهياً مدته 60 ثانية تلقي فيه تهنئة كاملة: أمنية بالمنصوب، وصف بـ ce qui، وخاتمة بالتهنئة."]}],"examples":[{"fr":"Je souhaite que vous soyez heureux tous les deux.","ar":"أتمنى أن تكونا سعيدين جميعاً.","note":"subjonctif"},{"fr":"Ce qui m'a plu, c'est la piste de danse.","ar":"ما أحببته هو ساحة الرقص.","note":"ce qui فاعل"},{"fr":"Après le dîner, il y aura une surprise.","ar":"بعد العشاء سيكون هناك مفاجأة.","note":"après + اسم"},{"fr":"Toutes nos félicitations aux jeunes mariés !","ar":"كل التهاني للعروسين!","note":"تهنئة جاهزة"},{"fr":"Le couple danse pour la première fois.","ar":"يرقص الزوجان لأول مرة."},{"fr":"Le dîner est servi à dix-neuf heures.","ar":"يُقدَّم العشاء في السابعة مساءً."}],"pron":[{"w":"les vœux","ipa":"[le vø]","approx":"لو فو"},{"w":"la piste de danse","ipa":"[la pist dɑ̃s]","approx":"لا بيست دانس"},{"w":"les alliances","ipa":"[lez a.li.jɑ̃s]","approx":"ليزاليجانس"},{"w":"le dîner","ipa":"[lə di.ne]","approx":"لو دينيه"}],"vocab":[{"fr":"le couple","ar":"الزوجان","pos":"nom","g":"m","exFr":"Le couple danse pour la première fois.","ipa":"[lə kupl]","exAr":"يرقص الزوجان لأول مرة."},{"fr":"le dîner","ar":"العشاء","pos":"nom","g":"m","exFr":"Le dîner est servi à dix-neuf heures.","ipa":"[lə di.ne]","exAr":"يُقدَّم العشاء في السابعة مساءً."},{"fr":"la piste de danse","ar":"ساحة الرقص","pos":"nom","g":"f","exFr":"La piste de danse est déjà pleine.","ipa":"[la pist dɑ̃s]","exAr":"ساحة الرقص ممتلئة أصلاً."},{"fr":"les alliances","ar":"خواتم الزفاف","pos":"nom","g":"f.pl","exFr":"Ils ont échangé les alliances.","ipa":"[lez a.li.jɑ̃s]","exAr":"تبادلوا خواتم الزفاف."},{"fr":"la mariée","ar":"العروس","pos":"nom","g":"f","exFr":"La mariée porte une robe blanche.","ipa":"[la ma.ʁje]","exAr":"تلبس العروس ثوباً أبيض."},{"fr":"le mari","ar":"العريس/الزوج","pos":"nom","g":"m","exFr":"Le mari reçoit les invités à l'entrée.","ipa":"[lə ma.ʁi]","exAr":"يستقبل العريس الضيوف عند المدخل."},{"fr":"les félicitations","ar":"التهاني","pos":"nom","g":"f.pl","exFr":"Toutes nos félicitations !","ipa":"[le fe.li.si.ta.sjɔ̃]","exAr":"كل التهاني!"},{"fr":"la danse","ar":"الرقص","pos":"nom","g":"f","exFr":"La danse continue jusqu'à minuit.","ipa":"[la dɑ̃s]","exAr":"يستمر الرقص حتى منتصف الليل."},{"fr":"la lune de miel","ar":"شهر العسل","pos":"nom","g":"f","exFr":"La lune de miel aura lieu en septembre.","ipa":"[la lyn də mjɛl]","exAr":"ستكون شهر العسل في شتنبر."},{"fr":"le faire-part","ar":"بطاقة الإعلان بالزواج","pos":"nom","g":"m","exFr":"Le faire-part est très élégant.","ipa":"[lə fɛʁ.paʁ]","exAr":"بطاقة الإعلان أنيقة جداً."},{"fr":"la noce","ar":"حفل الزفاف (الدعوات)","pos":"nom","g":"f","exFr":"La noce compte quatre-vingts personnes.","ipa":"[la nɔs]","exAr":"يضمّ حفل الزفاف ثمانين شخصاً."},{"fr":"le serment","ar":"القسم","pos":"nom","g":"m","exFr":"Ils ont échangé un serment devant le maire.","ipa":"[lə sɛʁmɑ̃]","exAr":"تبادلوا قسماً أمام المأذون."}],"grammar":[{"tFr":"Je souhaite que + subjonctif","tAr":"القاعدة: أفعال الرغبة والتهنئة بالمنصوب","body":["بعد «que» من أفعال الرغبة والمشاعر والتهنئة (souhaiter, être content que, aimer que) يأتي الفعل في صيغة المنصوب: Je souhaite que vous soyez heureux / Je suis content que vous soyez là — والصيغة تتكوّن من ils في المضارع مع تعديل نهايتها (vous soyez من vous êtes).","إن تبعها مصدر بفاعل آخر مباشرة بلا que يبقى الأمر مبسطاً: Je souhaite vous revoir (دون subjonctif) — فالـ que هي التي تفتح باب المنصوب، ومعها تحفظ النهايات: que je sois، que tu sois، que vous soyez."],"ex":[{"fr":"Je souhaite que vous soyez heureux tous les deux.","ar":"أتمنى أن تكونا سعيدين جميعاً."},{"fr":"Je suis content que la noce soit réussie.","ar":"أنا سعيد بأن المراسم نجحت."}]},{"tFr":"Ce qui / ce que","tAr":"القاعدة: ضمائر الوصل «ما هو» و«ما»","body":["«ce qui» تحلّ محلّ فاعل، وتأتي بعد المبتدأ: Ce qui m'a touché, c'est leur patience — أي «الشيء الذي لمسني هو صبرهما». و«ce que» تحلّ محلّ مفعول، وتأتي قبل الاسم: Ce que j'aime, c'est la piste de danse.","القاعدة العملية السريعة: ضع «؟» مكان الكلمة الموصوفة؛ إن أجاب السؤال بـ «هو/هي» فهو ce qui، وإن احتاج إلى فعلاً فهو ce que — واحفظ الثنائي مع «c'est» فهما يفتحان لك كل خطاب تمهيدي."],"ex":[{"fr":"Ce qui m'a plu, c'est leur patience.","ar":"ما أحببته هو صبرهما."},{"fr":"Ce que je voudrais dire, c'est merci à tous.","ar":"ما أودّ قوله هو شكراً للجميع."}]}],"mistakes":[{"wrong":"«Je souhaite que vous êtes heureux.»","right":"«Je souhaite que vous soyez heureux.»","why":"بعد que من أفعال التمنّي يأتي المنصوب لا المضارع."},{"wrong":"«Ce que m'a touché, c'est leur patience.»","right":"«Ce qui m'a touché, c'est leur patience.»","why":"ce qui فاعل وce que مفعول، والموضع هنا فاعل."},{"wrong":"«Bonjour à toute le monde !»","right":"«Bonjour à tout le monde !»","why":"«tout le monde» لا تتغيّر مع المؤنث."}],"dialogues":[{"title":"خطاب الزفاف","ctx":"الوالدان يوجّهان التهنئة","lines":[{"who":"Le père","fr":"Je souhaite que vous soyez heureux tous les deux.","ar":"أتمنى أن تكونا سعيدين جميعاً."},{"who":"La mère","fr":"Ce qui m'a touchée, c'est votre patience.","ar":"ما لمسني هو صبركما."},{"who":"Karim","fr":"Merci ! La piste de danse est déjà pleine.","ar":"شكراً! ساحة الرقص ممتلئة أصلاً."},{"who":"Nadia","fr":"On passe au dîner, puis au gâteau ?","ar":"ننتقل إلى العشاء، ثم إلى الكعكة؟"},{"who":"Le père","fr":"Après le dîner, je lèverai mon verre à la mariée.","ar":"بعد العشاء سأرفع كأسي تكريماً للعروس."},{"who":"Nadia","fr":"Tu as vu les alliances ? Elles sont gravées avec vos prénoms.","ar":"هل رأيتَ الخواتم؟ إنها محفورة بأسمائكما."},{"who":"Karim","fr":"Toutes nos félicitations ! Vive les mariés !","ar":"كل التهاني! يعيش العريسان!"}]}],"exercises":[{"t":"mcq","skill":"grammar","q":"أي كلمة تكمل التهنئة بعد «Je souhaite que»؟","opts":["soyez","êtes","soit","serez"],"a":0,"why":"مع vous يأتي المنصوب soyez."},{"t":"fill","skill":"writing","q":"أكمل: «___ qui m'a touché, c'est leur patience.» (ما)","fr":"___ qui m'a touché, c'est leur patience.","ans":"Ce","alts":["ce"],"why":"ce qui تحلّ محلّ الفاعل."},{"t":"listen","skill":"listening","q":"[Écoute] أي عبارة مسموعة في مقتطف خطاب الزفاف؟","opts":["La piste de danse est déjà pleine de monde.","La piste de danse est fermée pour tout le monde.","La place est pleine, il n'y a pas de danse.","La danse commence après tout le monde."],"a":0,"why":"العبارة الأولى هي المقتطف الحرفي مع «de monde»."},{"t":"order","skill":"writing","q":"رتّب جملة التهنئة","words":["Je","souhaite","que","vous","soyez","heureux."],"ans":"Je souhaite que vous soyez heureux.","why":"الفعل الراغب ← que ← الفاعل ← المنصوب."},{"t":"translate","skill":"writing","q":"ترجم: «كل التهاني للعروسين!»","ans":"Toutes nos félicitations aux jeunes mariés !","alts":["toutes nos felicitations aux jeunes maries"],"why":"صيغة التهنئة الجاهزة مع الجمع."},{"t":"correct","skill":"writing","q":"صحّح: «Ce que m'a plu, c'est leur patience.»","ans":"Ce qui m'a plu, c'est leur patience.","alts":["ce qui ma plu cest leur patience","Ce qui ma plu, cest leur patience."],"why":"ce qui فاعل للفعل plaire."},{"t":"speaking","skill":"speaking","q":"ألقِ تهنئة من 30 ثانية: أمنية بالمنصوب، وصف بـ ce qui، وخاتمة بالتهنئة.","target":"Je souhaite que... / Ce qui... / Toutes nos félicitations...","why":"إنتاج خطاب مناسبة كامل في وضعية اجتماعية."},{"t":"mcq","skill":"vocabulary","q":"أي كلمة تعني «خواتم الزفاف»؟","opts":["les alliances","la noce","le couple","la lune de miel"],"a":0,"why":"les alliances هي خواتم الزفاف المتبادلة."}],"homework":"أعد مشاهدة الحلقة، ثم اكتب وسجّل تهنئة من 60 ثانية: أمنية بالمنصوب، وجملة تبدأ بـ «Ce qui...»، وتهنئة ختامية.\nالحلقة السابقة/التالية: a2-t7-l24 (Reflets 2, épisode 9 / الموسم الثاني، الحلقة 9) ← a2-t7-l25 → a2-t7-l26 — Révois l'épisode, puis écris et enregistre un toast de 60 secondes : un souhait en subjonctif, une phrase avec « Ce qui... », et une félicitation finale.","sources":[{"label":"الحلقة الأساسية","videoId":"Bo1mO3oudQo","title":"Reflets 2 Episode 10","channel":"Jason Mills","why":"الحلقة العاشرة كاملة — حفل الزفاف وخطابه بالنص الأصلي: احفظ صيغ التهنئة قبل أن تلقيها بنفسك.","cat":"Séries","level":"A2","main":true,"t":0},{"label":"مكمّل الدرس","videoId":"ECcXpq1G7EM","title":"5 idées originales pour réussir un discours de mariage","channel":"Aguere - Parole et Rhétorique","why":"خمس أفكار لخطاب زفاف ناجح — يعطيك بنية الخطاب نفسها التي يستعملها المتحدّثون في الحلقة.","cat":"Culture","level":"A2","extra":true}],"supplements":[{"id":"ECcXpq1G7EM","videoId":"ECcXpq1G7EM","title":"5 idées originales pour réussir un discours de mariage","channel":"Aguere - Parole et Rhétorique","why":"خمس أفكار لخطاب زفاف ناجح — يعطيك بنية الخطاب نفسها التي يستعملها المتحدّثون في الحلقة.","dur":7,"lang":"fr","level":"A2"}]},{"id":"a2-t7-l26","fr":"Épisode 26 — Le marché à la brocante","ar":"الحلقة 26 — سوق المستعمل","objectives":["التفاوض على الثمن في سوق المستعمل بعبارات لباقة («C'est à quel prix؟», «Je vous fais un prix»)","متابعة الحلقة كاملة مدتها 12 دقيقة و التقاط مفردات البيع والشراء منطوقة","وصف حالة السلعة المستعملة بالصفات (en bon état, comme neuf, une rayure) في جمل قصيرة مقنعة"],"sections":[{"h":"الدرس","video":{"id":"3jCPqMqtbvM","title":"Reflets 2 Episode 11","channel":"Jason Mills","why":"الحلقة الحادية عشرة من Reflets 2: سوق مستعمل كامل بأسعار ومساومة — طبّق مفردات الحلقة واقفاً أمام الشاشة وكرّر جمل البائع قبل أن تعود إلى القواعد.","lang":"fr","main":true,"t":0,"dur":12},"p":["السوق المستعمل مدرسة يومية للتفاوض: كل طاولة تطرح سؤالاً واحداً وتكرّر جواباً واحداً — «C'est à quel prix؟» ثم «Je vous fais un prix». من أتقن هاتين الجملتين استطاع أن يشتري في أي سوق فرنسي دون تردّد.","الوصف شرط البيع: en bon état, comme neuf, une petite rayure — صفات قليلة تُغيّر الثمن تماماً، وتُؤدَّى هنا في جمل فعلية ينطقها البائع والمشتري معاً، لا في قائمة حفظ جافة.","الاستماع والتكرار: الحلقة قصيرة مكثّفة الإيقاع، وأسعارها تُقال بسرعة وامتزاج — استمع إليها مرة بلا توقف، ثم كرّر جمل المساومة بصوت مسموع قبل أن تعود إلى دروس القواعد والمفردات.","قبل المشاهدة: ركّز في المرة الأولى على فهم الفكرة العامة للموقف دون إيقاف الفيديو، وفي المرة الثانية دوّن الكلمات التي تتكرر — خصوصاً la pièce، la foule، l'occasion — وحاول استنتاج معناها من السياق قبل الرجوع إلى قاموسك.","بعد المشاهدة: تدرّب على ملخص من ثلاث جمل للكتابة — حدّد الشخصيات وما فعلنا وما شعروا به — ثم استمع مرة أخيرة وقارن نطقك بنطق الممثلين، مع انتباه خاص لنقطة قاعدة الدرس كما وردت في الحوار.","تلميح الأداء: أعد تشغيل المقاطع الصعبة بسرعة 0.75، وأوقف الفيديو عند نهاية كل جملة لتكرارها بصوت عالٍ — هذه الطريقة تثبّت المفردات والنطق معاً وتُعدّك جاهزاً لتمارين هذا الدرس وللدرس التالي في السلسلة."],"sub":[{"h":"النص الصوتي (مقتطف)","p":["Bonjour ! Vous cherchez quelque chose en particulier ?","C'est à quel prix, ce vieux miroir ?","Trois euros, mais je vous fais un prix : cinq euros les deux.","Il est en bon état ? On dirait une petite rayure.","D'accord, je le prends. Voilà quatre euros, merci !"]},{"h":"مفردات الموقف","p":["la pièce — القطعة (العملة المعدنية)","la foule — الزحام / الحشد","l'occasion — الفرصة","la rayure — الخدش","la poussière — الغبار"]},{"h":"تعبيرات جاهزة للاستماع","p":["Ce vieux bibelot est intéressant.","C'est une vraie trouvaille !","Les chineurs arrivent tôt le matin.","Ils marchandent le prix depuis dix minutes.","Le vélo est en bon état."]}]},{"h":"النطق والكلمات المفتاحية","p":["brocante [bʁɔ.kɑ̃t] تُفتح بـ br مدوّرة ثم ر فرنسية خفيفة بلا تفخيم — كرّرها ثلاث مرات ببطء ثم بسرعة، وانتبه إلى الصمت الأخير: كلمة prix [pʁi] لا يُنطق حرف s النهائي فيها أبداً.","كلمات المفتاح تتصل صوتها في الكلام الحقيقي: la pièce [la pjɛs] مع s مجموع، comme neuf [kɔm nœf] باندماج خفيف، et [e] صامت تماماً في «comme neuf et en bon état». تدرّب على جملة واحدة تجمعها كلها بصوت متصل دون توقف."]},{"h":"محتوى الحلقة","p":["يفتح المشهد على وصول البطل إلى السوق في أول ضوء: ممرات ضيقة، طاولات مغطاة بالقِدام، وبائعون يعلّقون أوراق الأسعار — الحشد يكبر بسرعة، ومن يتأخر لا يجد إلا ما رفضه الآخرون.","تتحوّل الاهتمام إلى قطعة تلفت النظر: عرض أول، ثم جولة مساومة قصيرة، ثم اكتشاف خدش صغير عند الفحص، وتراجع في الثمن واتفاق في المنتصف — مهارة كاملة في ثلاث دقائق من الحوار.","تنتهي الحلقة بصفقة تُختم بابتسامة وعبارة شكر، وبملاحظة صغيرة عن عادة السوق: من يعرف ما يريد يقوله بجملتين فقط، والباقي تفاصيل تُترك للتفاوض."]},{"h":"التطبيق والتلخيص","p":["الحلقة 26 — سوق المستعمل: مفردات البيع والشراء، وتعبيرات الثمن والمساومة، ووصف حالة السلعة، كما في الفيديو الرئيسي «Reflets 2 Episode 11» على قناة Jason Mills: شغّل الحلقة كاملة بلا توقف أول مرة لتلتقط الإيقاع، ثم أعد التشغيل وعينك على «C'est à quel prix ?» و«Je vous fais un prix» فقط.","جسر الحلقات: من a2-t7-l25 («Un beau mariage / زواج جميل») إلى a2-t7-l26 («Le marché à la brocante / سوق المستعمل»)، ثم إلى a2-t7-l27 حيث تنتقل الحكاية من طاولة البيع إلى ملعب النادي وتنطلق مسابقة البِيتَنك.","شاهد الحلقة مرة ثانية والنص مفتوح أمامك، ثم افتح ورقة المفردات وراجع اثني عشر مفردة من مفردات السوق (la pièce, l'occasion, la trouvaille, le chineur...)، وأخيراً سجّل تلخيصاً شفهياً مدته 60 ثانية تصف فيه أجمل صفقة اشتريتها."]}],"examples":[{"fr":"C'est à quel prix, cette lampe ?","ar":"بكم هذه المصباحة؟","note":"سؤال الثمن عند الإشارة لقطعة"},{"fr":"Je vous fais un prix : quatre euros les deux.","ar":"سأعطيك ثمناً خاصاً: أربعة يورو للاثنين.","note":"لغة المساومة"},{"fr":"Il est en bon état, regardez.","ar":"حالته ممتازة، انظروا.","note":"وصف الحالة"},{"fr":"C'est un peu trop cher, vous pouvez baisser ?","ar":"إنه غالٍ قليلاً، هل يمكنك تخفيض الثمن؟","note":"طلب مهذّب"},{"fr":"Il m'a rendu deux pièces.","ar":"أعاد لي قطعتين ماليتين."},{"fr":"La foule bloque le passage.","ar":"الزحام يسدّ الممر."}],"pron":[{"w":"la brocante","ipa":"[la bʁɔ.kɑ̃t]","approx":"لا بروكانط"},{"w":"la pièce","ipa":"[la pjɛs]","approx":"لا بييس"},{"w":"comme neuf","ipa":"[kɔm nœf]","approx":"كوم نُوف"}],"vocab":[{"fr":"la pièce","ar":"القطعة (العملة المعدنية)","pos":"nom","g":"f","exFr":"Il m'a rendu deux pièces.","ipa":"[la pjɛs]","exAr":"أعاد لي قطعتين ماليتين."},{"fr":"la foule","ar":"الزحام / الحشد","pos":"nom","g":"f","exFr":"La foule bloque le passage.","ipa":"[la ful]","exAr":"الزحام يسدّ الممر."},{"fr":"l'occasion","ar":"الفرصة","pos":"nom","g":"f","exFr":"La brocante est une bonne occasion d'acheter moins cher.","ipa":"[lɔ.ka.zjɔ̃]","exAr":"السوق المستعمل فرصة جيدة للشراء بأرخص ثمن."},{"fr":"la rayure","ar":"الخدش","pos":"nom","g":"f","exFr":"Il y a une petite rayure sur la table.","ipa":"[la ʁe.jyʁ]","exAr":"هناك خدش صغير على الطاولة."},{"fr":"la poussière","ar":"الغبار","pos":"nom","g":"f","exFr":"Ce cadre est couvert de poussière.","ipa":"[la pu.sjɛʁ]","exAr":"هذا الإطار مغطى بالغبار."},{"fr":"le bibelot","ar":"التحفة الصغيرة","pos":"nom","g":"m","exFr":"Ce vieux bibelot est intéressant.","ipa":"[lə bi.be.lo]","exAr":"هذه التحفة القديمة مثيرة للاهتمام."},{"fr":"la trouvaille","ar":"الإيجاد الجميل / الصفقة الحلوة","pos":"nom","g":"f","exFr":"C'est une vraie trouvaille !","ipa":"[la tʁu.vaj]","exAr":"إنه إيجاد جميل حقاً!"},{"fr":"le chineur","ar":"زبون السوق المستعمل","pos":"nom","g":"m","exFr":"Les chineurs arrivent tôt le matin.","ipa":"[lə ʃi.nœʁ]","exAr":"زوّار السوق يصلون مبكراً."},{"fr":"marchander","ar":"يساوم على الثمن","pos":"verbe","exFr":"Ils marchandent le prix depuis dix minutes.","ipa":"[maʁ.ʃɑ̃.de]","exAr":"يتساومان على الثمن منذ عشر دقائق."},{"fr":"en bon état","ar":"في حالة جيدة","pos":"locution","exFr":"Le vélo est en bon état.","ipa":"[ɑ̃ bɔ̃ ne.tɑ̃]","exAr":"الدراجة في حالة جيدة."},{"fr":"comme neuf","ar":"كأنه جديد","pos":"locution","exFr":"Ce vase est comme neuf.","ipa":"[kɔm nœf]","exAr":"هذه المزهريّة كأنها جديدة."},{"fr":"de seconde main","ar":"من اليد الثانية (مستعمل)","pos":"locution","exFr":"Ce manteau est de seconde main.","ipa":"[də sə.ɡɔ̃d mɛ̃]","exAr":"هذا المعطف مستعمل."}],"grammar":[{"tFr":"Exprimer le prix : ça coûte, ça fait, ça vaut","tAr":"القاعدة: تعبير الثمن والقيمة","body":["«ça coûte» لثمن القطعة («Ça coûte trois euros»)، و«ça fait» للحساب والإجمالي («Ça fait dix euros les deux»)، و«ça vaut» للقيمة الحقيقية («Ça vaut le coup») — الثلاثة تُسند إلى ça دائماً، لا إلى اسم الشيء.","سؤال الثمن يُصاغ بطرقتين: «C'est combien ?» للكلام العام، و«C'est à quel prix ?» عند الإشارة لقطعة بعينها — والجواب يبدأ بالثمن ثم يفتح باب المساومة: «Trois euros, mais je vous fais un prix.»"],"ex":[{"fr":"Ça fait dix euros les deux.","ar":"المجموع عشرة يورو للاثنين."},{"fr":"Ça vaut le coup, non ?","ar":"هل يستحق الثمن، أليس كذلك؟"}]},{"tFr":"Le conditionnel de politesse : je voudrais, vous pourriez","tAr":"القاعدة: شرطية اللباقة في المساومة","body":["نهايات الشرطية (‑ais, ‑ais, ‑ait) تحوّل الجملة إلى طلب مهذّب: «Je voudrais voir...», «Vous pourriez baisser ?» — والأمر المباشر «Baissez le prix!» لا يليق بالغرباء في السوق.","الشرطية تُستعمل أيضاً في عرض البائع: «Je vous le ferais à quatre euros» — من سمع هذه الجملة عرف أنه فُتح له باب للتفاوض، وأنه من المناسب أن يردّ بجولة ثانية."],"ex":[{"fr":"Je voudrais voir cette lampe de plus près.","ar":"أريد أن أرى هذه المصباحة عن قرب."},{"fr":"Vous pourriez me faire un prix ?","ar":"هل يمكنك أن تعطيني ثمناً خاصاً؟"}]}],"mistakes":[{"wrong":"«Le miroir coûte à trois euros.»","right":"«Le miroir coûte trois euros.»","why":"الفعل coûter يتعدّى بمفعول مباشر بلا حرف جر."},{"wrong":"«Baissez le prix, s'il te plaît !»","right":"«Vous pourriez baisser le prix ?»","why":"المساومة مع الغرباء تُصاغ بالشرطية المهذّبة لا بالأمر المباشر."},{"wrong":"«Il est bon état.»","right":"«Il est en bon état.»","why":"حالة الشيء تُعبَّر بالجار والمجرور en مع état."}],"dialogues":[{"title":"المساومة في السوق","ctx":"زبون وبائعة أمام طاولة","lines":[{"who":"Le client","fr":"Bonjour ! C'est à quel prix ce plateau ?","ar":"مرحباً! بكم هذا الطبق؟"},{"who":"La vendeuse","fr":"Cinq euros, mais c'est une pièce unique.","ar":"خمسة يورو، لكنها قطعة فريدة."},{"who":"Le client","fr":"C'est un peu trop cher pour moi.","ar":"إنه غالٍ قليلاً بالنسبة لي."},{"who":"La vendeuse","fr":"Je vous fais un prix : quatre euros.","ar":"سأعطيك ثمناً خاصاً: أربعة يورو."},{"who":"Le client","fr":"Il y a une petite rayure, quand même.","ar":"هناك خدش صغير على أي حال."},{"who":"La vendeuse","fr":"Regardez, elle est presque comme neuf. Allez, quatre euros.","ar":"انظروا، إنها شبه جديدة. هيا، أربعة يورو."},{"who":"Le client","fr":"D'accord, je le prends. Merci !","ar":"حسناً، سآخذه. شكراً!"}]}],"exercises":[{"t":"mcq","skill":"grammar","q":"التحويل الصحيح لثمن القطعة:","opts":["Ça coûte trois euros.","Il coûte à trois euros.","Ça fait à trois euros.","C'est coûter trois euros."],"a":0,"why":"coûter يتعدّى بمفعول مباشر، والفاعل في التعبير الشائع هو ça."},{"t":"fill","skill":"writing","q":"أكمل: «C'est ___ prix, cette lampe ?»","fr":"C'est ___ prix, cette lampe ?","ans":"à","alts":["A"],"why":"السؤال عن الثمن: à quel prix."},{"t":"order","skill":"writing","q":"رتّب عبارة المساومة مع البائع","words":["Je","vous","fais","un","prix.","Quatre","euros."],"ans":"Je vous fais un prix. Quatre euros.","why":"الفعل يتبعه المفعول، ثم يُذكر الثمن عرضاً."},{"t":"listen","skill":"listening","q":"[Écoute] أي عبارة قالها المشتري لإتمام الصفقة؟","opts":["Je le prends.","Je le laisse.","Je le regarde.","Je le répare."],"a":0,"why":"«Je le prends» تعني «سآخذه» وهي لغة إتمام الصفقة."},{"t":"translate","skill":"writing","q":"ترجم: «بكم هذا الطبق من فضلك؟»","ans":"C'est combien ce plateau, s'il vous plaît ?","alts":["c est combien ce plateau s il vous plait"],"why":"«C'est combien» هي العبارة الشائعة لسؤال الثمن."},{"t":"correct","skill":"writing","q":"صحّح: «Le miroir coûte à trois euros.»","ans":"Le miroir coûte trois euros.","alts":["le miroir coûte trois euros"],"why":"حذف حرف الجر مع coûter."},{"t":"mcq","skill":"vocabulary","q":"«Comme neuf» في وصف السلعة تعني:","opts":["كأنه جديد","مكسور تماماً","مستعمل طويلاً","بلا ثمن"],"a":0,"why":"comme neuf وصف يعيد للشيء حالته الأولى."},{"t":"speaking","skill":"speaking","q":"اكتب ثم انطق حوار مساومة من 6 جمل بين بائع وزبون.","target":"C'est à quel prix... ? — Je vous fais un prix...","why":"إنتاج موجّه لعبارات الثمن والمساومة."}],"homework":"أعد الاستماع لمشهد السوق، اكتب ست جمل للثمن (Ça coûte... / Je vous fais un prix...)، وسجّل 30 ثانية مساومة.\nالحلقة السابقة/التالية: a2-t7-l25 («Un beau mariage / زواج جميل») ← a2-t7-l26 → a2-t7-l27 («Le concours de pétanque / مسابقة البِيتَنك») — Réécoute la scène du marché, écris six phrases de prix (Ça coûte..., Je vous fais un prix...) et enregistre 30 secondes de négociation. Suite : a2-t7-l27.","sources":[{"label":"الحلقة الأساسية","videoId":"3jCPqMqtbvM","title":"Reflets 2 Episode 11","channel":"Jason Mills","why":"الحلقة الحادية عشرة من Reflets 2: سوق مستعمل كامل بأسعار ومساومة — طبّق مفردات الحلقة واقفاً أمام الشاشة وكرّر جمل البائع قبل أن تعود إلى القواعد.","cat":"Séries","level":"A2","main":true,"t":0},{"label":"مكمّل الدرس","videoId":"bfdA7Z9E_nw","title":"🎀 La Revendeuse Vintage | Easy French Story for A1–A2 Learners (Subtitles: Français + English)","channel":"Just French Stuff","why":"قصة قصيرة عن بائعة ملابس مستعملة بالترجمة — تُثبّت مفردات السوق المستعمل والوصف قبل مشاهدة الحلقة.","cat":"Vocabulaire","level":"A2","extra":true}],"supplements":[{"id":"bfdA7Z9E_nw","videoId":"bfdA7Z9E_nw","title":"🎀 La Revendeuse Vintage | Easy French Story for A1–A2 Learners (Subtitles: Français + English)","channel":"Just French Stuff","lang":"fr","dur":16,"why":"قصة قصيرة عن بائعة ملابس مستعملة (A1–A2) مع ترجمة — تُثبّت مفردات السوق المستعمل ووصف السلعة قبل أن تدخل إلى حلقة المساومة.","level":"A2"}]},{"id":"a2-t7-l27","fr":"Épisode 27 — Le concours de pétanque","ar":"الحلقة 27 — مسابقة البِيتَنك","objectives":["وصف مباراة البِيتَنك بالمقارنات والتفضيل («plus précis que...», «la plus forte du club»)","متابعة الحلقة كاملة مدتها 13 دقيقة و التقاط تعبيرات الفوز والخسارة والتعادل","استعمال ظروف ‑ment و«venir de + infinitif» كتعليق صغير على دقائق المباراة"],"sections":[{"h":"الدرس","video":{"id":"dyiRuZucfIU","title":"Reflets 2 Episode 12","channel":"Jason Mills","why":"الحلقة الثانية عشرة من Reflets 2: مسابقة نادي البِيتَنك من أول رمية حتى تسليم الجائزة — لغة المقارنة والنتيجة في موقف حيّ سريع الإيقاع.","lang":"fr","main":true,"t":0,"dur":13},"p":["البِيتَنك رياضة فرنسية أصيلة: قواعدها بسيطة ولغتها اليومية ثابتة — la manche, le tir, le point — ومن حفظ هذه الكلمات الثلاث فهم المباراة قبل أن تبدأ.","المقارنة لغة الرياضة نفسها: «plus précis que moi», «la plus forte du club», «il joue mieux qu'avant» — لا يمكن وصف مباراة دونها، وهي هنا في جمل قصيرة يتفوّه بها اللاعبون بين الرميات الواحدة تلو الأخرى.","الاستماع والتكرار: الإيقاع سريع والحماس يرفع الصوت — استمع إلى الحلقة كاملة بلا توقف، ثم أعد المشاهدة وأنت تكرّر بصوت الممثلين جمل التعليق قبل أن تعود إلى دروس القواعد والمفردات.","قبل المشاهدة: ركّز في المرة الأولى على فهم الفكرة العامة للموقف دون إيقاف الفيديو، وفي المرة الثانية دوّن الكلمات التي تتكرر — خصوصاً l'équipe، le trophée، le terrain — وحاول استنتاج معناها من السياق قبل الرجوع إلى قاموسك.","بعد المشاهدة: تدرّب على ملخص من ثلاث جمل للكتابة — حدّد الشخصيات وما فعلنا وما شعروا به — ثم استمع مرة أخيرة وقارن نطقك بنطق الممثلين، مع انتباه خاص لنقطة قاعدة الدرس كما وردت في الحوار.","تلميح الأداء: أعد تشغيل المقاطع الصعبة بسرعة 0.75، وأوقف الفيديو عند نهاية كل جملة لتكرارها بصوت عالٍ — هذه الطريقة تثبّت المفردات والنطق معاً وتُعدّك جاهزاً لتمارين هذا الدرس وللدرس التالي في السلسلة."],"sub":[{"h":"النص الصوتي (مقتطف)","p":["Salut ! Tu es prêt pour le concours ?","Oui, notre équipe joue sur le terrain du club.","On a gagné la première manche, douze à neuf.","Attention, il est plus précis que moi aujourd'hui.","Regarde ce lancer : la boule arrive doucement !","Deux points ! On vient de gagner le trophée !"]},{"h":"مفردات الموقف","p":["l'équipe — الفريق","le trophée — الكأس / الجائزة","le terrain — الملعب","le lancer — الرمي (الحركة)","la victoire — الانتصار"]},{"h":"تعبيرات جاهزة للاستماع","p":["Nous avons gagné la première manche.","La boule est un peu lourde.","Le club organise le concours.","Le championnat commence en juin.","Le vainqueur serre la main de son adversaire."]}]},{"h":"النطق والكلمات المفتاحية","p":["pétanque [pe.tɑ̃k] تُنطق بـ p واضحة ثم مقطع nasal [ɑ̃] قصير — لا تُهمَس البداية ولا يُطيل المنطق العربي المقطعان. كرّرها ثلاث مرات مع la boule [la bul] وle terrain [lə tɛ.ʁɛ̃] حتى تصير سلسلة واحدة.","الأرقام في النتيجة تتصل صوتها: «douze à neuf» [dɔz a nœf] يُنطق z اتصالاً بين الكلمتين، و«doucement» [du.s.mɑ̃] يُخفَّف مقطعها الأخير حتى لا تطول الجملة. أربع كلمات تُدير المرة الأولى: la manche, le lancer, le vainqueur, remporter."]},{"h":"محتوى الحلقة","p":["تبدأ الحلقة أمام ملعب النادي: الفرق تجهّز أكوامها، والكرة المعدنية تخرج من الجيب، وحكم المسابقة يعلن البداية بجملة واحدة تكرّرها كل بطولات الحيّ.","تتوالى الرميات: رمية تقترب من الهدف وأخرى تنحرف، والنقاط تُحسب بسرعة — والمقارنة تتساقط من أفواه اللاعبين: «Il est plus précis», «Elle lance mieux que moi».","الجولة الأخيرة ضيّقة النتيجة، ورمية واحدة تقلب المباراة: صمت قصير، ثم صراخ الفرح، وتبريكات متتالية تنتهي بتسليم صغير للجائزة وصافقة للجميع."]},{"h":"التطبيق والتلخيص","p":["الحلقة 27 — مسابقة البِيتَنك: مفردات الملعب والنتيجة، ولغة المقارنة والتعجّب، وظروف الطريقة في ‑ment، كما في الفيديو الرئيسي «Reflets 2 Episode 12» على قناة Jason Mills: شغّل الحلقة كاملة بلا توقف أول مرة لتلتقط الإيقاع، ثم أعد التشغيل وعينك على «plus... que» و«doucement» فقط.","جسر الحلقات: من a2-t7-l26 («Le marché à la brocante / سوق المستعمل») إلى a2-t7-l27 («Le concours de pétanque / مسابقة البِيتَنك»)، ثم إلى a2-t7-l28 («Le grand final / الخاتمة الكبرى») حيث يُغلق أبطال السلسلة موسمهم في الحلقة الختامية.","شاهد الحلقة مرة ثانية والنص مفتوح أمامك، ثم افتح ورقة المفردات وراجع اثني عشر مفردة من مفردات الملعب (la manche, le lancer, l'adversaire, le vainqueur...)، وأخيراً سجّل تلخيصاً شفهياً مدته 60 ثانية تصف فيه الرمية الحاسمة."]}],"examples":[{"fr":"Notre équipe est la plus forte du club.","ar":"فريقنا هو الأقوى في النادي.","note":"التفضيل"},{"fr":"Tu as gagné plus de points que moi.","ar":"لقد ربحت نقاطاً أكثر مني.","note":"المقارنة مع الكمية"},{"fr":"On vient de gagner la dernière manche !","ar":"لقد ربحنا للتو المجموعة الأخيرة!","note":"حدث حديث"},{"fr":"Il lance la boule doucement et précisément.","ar":"يرمي الكرة ببطء وبدقة.","note":"ظروف ‑ment"},{"fr":"Notre équipe gagne la manche.","ar":"فريقنا يربح المجموعة."},{"fr":"Le vainqueur reçoit le trophée.","ar":"الفائز يتلقى الجائزة."}],"pron":[{"w":"la pétanque","ipa":"[la pe.tɑ̃k]","approx":"لا بيطانك"},{"w":"le lancer","ipa":"[lə lɑ̃.se]","approx":"لو لانسي"},{"w":"la boule","ipa":"[la bul]","approx":"لابول"},{"w":"gagner","ipa":"[ɡa.ɲe]","approx":"غانيي"}],"vocab":[{"fr":"la médaille","ar":"الفريق","pos":"nom","g":"f","exFr":"Notre équipe gagne la manche.","ipa":"[le.kip]","exAr":"فريقنا يربح المجموعة."},{"fr":"le trophée","ar":"الكأس / الجائزة","pos":"nom","g":"m","exFr":"Le vainqueur reçoit le trophée.","ipa":"[lə tʁɔ.fe]","exAr":"الفائز يتلقى الجائزة."},{"fr":"le terrain","ar":"الملعب","pos":"nom","g":"m","exFr":"Le terrain est sec aujourd'hui.","ipa":"[lə tɛ.ʁɛ̃]","exAr":"الملعب جاف اليوم."},{"fr":"le lancer","ar":"الرمي (الحركة)","pos":"nom","g":"m","exFr":"Son lancer était parfait.","ipa":"[lə lɑ̃.se]","exAr":"رميته كانت مثالية."},{"fr":"la victoire","ar":"الانتصار","pos":"nom","g":"f","exFr":"C'est une belle victoire.","ipa":"[la vik.twaʁ]","exAr":"إنه انتصار جميل."},{"fr":"la manche","ar":"المجموعة (من المباراة)","pos":"nom","g":"f","exFr":"Nous avons gagné la première manche.","ipa":"[la mɑ̃ʃ]","exAr":"لقد ربحنا المجموعة الأولى."},{"fr":"la boule","ar":"كرة البِيتَنك المعدنية","pos":"nom","g":"f","exFr":"La boule est un peu lourde.","ipa":"[la bul]","exAr":"الكرة ثقيلة قليلاً."},{"fr":"le club","ar":"النادي","pos":"nom","g":"m","exFr":"Le club organise le concours.","ipa":"[lə klœb]","exAr":"النادي ينظّم المسابقة."},{"fr":"le championnat","ar":"البطولة","pos":"nom","g":"m","exFr":"Le championnat commence en juin.","ipa":"[lə ʃɑ̃.pjɔ.na]","exAr":"البطولة تبدأ في يونيو."},{"fr":"le vainqueur","ar":"الفائز","pos":"nom","g":"m","exFr":"Le vainqueur serre la main de son adversaire.","ipa":"[lə vɛ̃.kœʁ]","exAr":"الفائز يصافح خصمه."},{"fr":"l'adversaire","ar":"الخصم","pos":"nom","g":"m","exFr":"Mon adversaire est très calme.","ipa":"[l‿a.d.vɛʁ.sɛʁ]","exAr":"خصمي هادئ جداً."},{"fr":"remporter","ar":"يفوز بـ / يحصد","pos":"verbe","exFr":"Notre équipe a remporté le trophée.","ipa":"[ʁɑ̃.pɔʁ.te]","exAr":"فريقنا فاز بالجائزة."}],"grammar":[{"tFr":"Le comparatif et le superlatif","tAr":"القاعدة: المقارنة والتفضيل","body":["المقارنة: «plus + صفة + que» («Il est plus précis que moi»)، و«moins + صفة + que»، و«aussi + صفة + que» — ومع الأفعال: «il joue mieux que», «elle lance mieux». انتبه إلى حرف الجر قبل الاسم: plus précis que moi، لا que je.","التفضيل: «le/la + plus + صفة + de + جماعة» («la plus forte du club») — وهنا de لا que. والأفعال الشاذة تُحفظ مرة واحدة: bon → meilleur، bien → mieux، mal → pis — ومن أتقن الشاذ أتقن نصف الوصف الرياضي."],"ex":[{"fr":"C'est la manche la plus difficile du concours.","ar":"إنها أصعب مجموعة في المسابقة."},{"fr":"Tu lances mieux que moi.","ar":"أنت ترمي أفضل مني."}]},{"tFr":"Les adverbes en -ment","tAr":"القاعدة: ظروف ‑ment","body":["الظرف يُبنى من الصفة على صيغة المؤنث + ment: lent → lentement، doux → doucement، précis → précisément — أي أن شكل المؤنث هو المدخل، وهذه القاعدة توفر حفظ قائمتين من كلمات جديدة.","الظرف يصف الطريقة ويأتي بعد الفعل: «Il lance doucement», «Elle joue tranquillement» — والاستثناء الشهير vite: لا نقول «vitement» بل «vite»، وهو الظرف الأكثر استعمالاً في الوصف السريع."],"ex":[{"fr":"La boule arrive doucement et s'arrête près du but.","ar":"تصل الكرة ببطء وتتوقف قرب الهدف."},{"fr":"Ils jouent vite mais sans précision.","ar":"يلعبون بسرعة لكن دون دقة."}]}],"mistakes":[{"wrong":"«C'est l'équipe la plus meilleure.»","right":"«C'est l'équipe la meilleure.»","why":"meilleur هو تفضيل bon ولا يقبل la plus معه."},{"wrong":"«On va de gagner !»","right":"«On vient de gagner !»","why":"venir de + infinitif لحدث حدث للتو، وaller + infinitif للمستقبل."},{"wrong":"«Il joue plus bien que les autres.»","right":"«Il joue mieux que les autres.»","why":"tendance: bien يتحول إلى mieux بلا plus."}],"dialogues":[{"title":"أمام ملعب النادي","ctx":"لاعبان بين رميتين","lines":[{"who":"Karim","fr":"Salut ! Tu es prêt pour le concours ?","ar":"مرحباً! هل أنت مستعد للمسابقة؟"},{"who":"Nadia","fr":"Oui, notre équipe joue sur le terrain du club.","ar":"نعم، فريقنا يلعب على ملعب النادي."},{"who":"Karim","fr":"On a gagné la première manche, douze à neuf.","ar":"لقد ربحنا المجموعة الأولى، اثنا عشر مقابل تسعة."},{"who":"Nadia","fr":"Attention, il est plus précis que moi aujourd'hui.","ar":"انتبه، إنه أدقّ مني اليوم."},{"who":"Karim","fr":"Regarde ce lancer : la boule arrive doucement !","ar":"انظر إلى هذا الرمي: الكرة تصل ببطء!"},{"who":"Nadia","fr":"Deux points ! On vient de gagner le trophée !","ar":"نقطتان! لقد ربحنا الجائزة للتو!"},{"who":"Karim","fr":"Bravo à tous, et bien joué !","ar":"أحسنتم للجميع، لعبة جميلة!"}]}],"exercises":[{"t":"mcq","skill":"grammar","q":"الصحيح: «C'est l'équipe ___ du club.»","opts":["la plus forte","la plus forte que","plus forte de","la forte plus"],"a":0,"why":"التفضيل القصوى: le/la + plus + صفة + de (لا que)."},{"t":"listen","skill":"listening","q":"[Écoute] أي عبارة مسموعة تعلن الفوز في المقطع؟","opts":["On vient de gagner !","On allait gagner !","Nous venons de perdre !","Il vient de gagner demain !"],"a":0,"why":"venir de + infinitif تعني «لقد حدث للتو»."},{"t":"order","skill":"writing","q":"رتّب جملة وصف الرمية","words":["La","boule","arrive","doucement","sur","le","terrain."],"ans":"La boule arrive doucement sur le terrain.","why":"الفاعل ثم الفعل ثم ظرف الوصف ثم المكان."},{"t":"fill","skill":"writing","q":"أكمل: «Il lance la boule ___ et gagne deux points.»","fr":"Il lance la boule ___ et gagne deux points.","ans":"doucement","alts":["Doucement"],"why":"ظرف من ‑ment يصف طريقة الرمي."},{"t":"translate","skill":"writing","q":"ترجم: «فريقنا هو الأقوى في النادي.»","ans":"Notre équipe est la plus forte du club.","alts":["notre equipe est la plus forte du club"],"why":"التفضيل: la + plus + صفة + de."},{"t":"correct","skill":"writing","q":"صحّح: «C'est l'équipe la plus meilleure.»","ans":"C'est l'équipe la meilleure.","alts":["c est l equipe la meilleure"],"why":"meilleur لا يقبل la plus معه."},{"t":"mcq","skill":"vocabulary","q":"«La manche» في البِيتَنك تعني:","opts":["المجموعة من الرميات","الملعب","الحكم","المشجعين"],"a":0,"why":"la manche قطعة من المباراة تنتهي بنقطة أو أكثر."},{"t":"speaking","skill":"speaking","q":"صف لقطة من مباراة بِيتَنك في 5 جمل مستعملاً المقارنة وظرفاً من ‑ment.","target":"Il est plus précis que moi... / La boule arrive doucement...","why":"دمج المقارنة والظرف في وصف حيّ."}],"homework":"أعد الاستماع للمباراة، اكتب خمس جمل بالمقارنة وظرف من ‑ment، ثم سجّلها بصوت مسموع.\nالحلقة السابقة/التالية: a2-t7-l26 («Le marché à la brocante / سوق المستعمل») ← a2-t7-l27 → a2-t7-l28 («Le grand final / الخاتمة الكبرى») — Réécoute le match, écris cinq phrases avec le comparatif et un adverbe en -ment, puis enregistre-les à voix haute. Suite : a2-t7-l28.","sources":[{"label":"الحلقة الأساسية","videoId":"dyiRuZucfIU","title":"Reflets 2 Episode 12","channel":"Jason Mills","why":"الحلقة الثانية عشرة من Reflets 2: مسابقة نادي البِيتَنك من أول رمية حتى تسليم الجائزة — لغة المقارنة والنتيجة في موقف حيّ سريع الإيقاع.","cat":"Séries","level":"A2","main":true,"t":0},{"label":"مكمّل الدرس","videoId":"io6CswpylHg","title":"Le jeu Provençal : l'ancêtre de la pétanque aux règles bien différentes ...","channel":"La Provence","why":"تقرير من قلب بروفانس عن اللعبة التي سبقت البِيتَنك — خلفية ثقافية من دقيقتين تثري الحلقة بلا إطالة.","cat":"Culture","level":"A2","extra":true}],"supplements":[{"id":"io6CswpylHg","videoId":"io6CswpylHg","title":"Le jeu Provençal : l'ancêtre de la pétanque aux règles bien différentes ...","channel":"La Provence","lang":"fr","dur":2,"why":"دقيقتان عن jeu provençal أصل البِيتَنك وقوانينه — تُثبّت أسماء اللعبة والملعب قبل مشاهدة حلقة المسابقة.","level":"A2"}]},{"id":"a2-t7-l28","fr":"Épisode 28 — Le grand final","ar":"الحلقة 28 — الخاتمة الكبرى","objectives":["مراجعة تراكمية للماضي المركّب مقابل الامتداد (passé composé / imparfait) في سرد قصة كاملة","متابعة الحلقة الختامية كاملة مدتها 12 دقيقة و التقاط عبارات الختام والشكر","أكملت سلسلة Reflets كاملة: تلخيص 28 حلقة بلغة فرنسية واثقة والانتقال إلى المستوى التالي"],"sections":[{"h":"الدرس","video":{"id":"tjVs9hXVeN4","title":"Reflets 2 -  13 1","channel":"Evgeny Dronov","why":"الحلقة الأخيرة من Reflets 2: الخاتمة الكبرى — عودة إلى كل اللحظات وجملة وداع تُقال مرة واحدة في السلسلة كلها. أعدّها وأنت تجمع حصيلة سنتين من التعلّم.","lang":"fr","main":true,"t":0,"dur":12},"p":["الخاتمة ليست وداعاً فحسب بل مراجعة حيّة: يعود الأبطال إلى أجمل لحظاتهم ويتذكّرون أول جملة قالوها — وأنت تسمع الآن ما لم تفهمه في الحلقة الأولى وتفهمه اليوم من غير ترجمة.","سرد الماضي هنا اختبار تراكمي: الماضي المركّب يقدّم الحدث («J'ai commencé, j'ai vu, j'ai gagné»)، والامتداد يرسم الخلفية والمشاعر («Je parlais à peine», «il faisait beau») — والتمييز بينهما آخر مهارة تُختبر في السلسلة كلها.","عبارات الوداع تُحفظ مرة واحدة ولا تُنسى: «Merci pour tout», «On se retrouve bientôt», «Ce n'est qu'un au revoir» — من مثّلها بصوته في هذه الحلقة مثّلها في كل نهاية فرنسية بعد ذلك.","قبل المشاهدة: ركّز في المرة الأولى على فهم الفكرة العامة للموقف دون إيقاف الفيديو، وفي المرة الثانية دوّن الكلمات التي تتكرر — خصوصاً la fierté، le progrès، le défi — وحاول استنتاج معناها من السياق قبل الرجوع إلى قاموسك.","بعد المشاهدة: تدرّب على ملخص من ثلاث جمل للكتابة — حدّد الشخصيات وما فعلنا وما شعروا به — ثم استمع مرة أخيرة وقارن نطقك بنطق الممثلين، مع انتباه خاص لنقطة قاعدة الدرس كما وردت في الحوار.","تلميح الأداء: أعد تشغيل المقاطع الصعبة بسرعة 0.75، وأوقف الفيديو عند نهاية كل جملة لتكرارها بصوت عالٍ — هذه الطريقة تثبّت المفردات والنطق معاً وتُعدّك جاهزاً لتمارين هذا الدرس وللدرس التالي في السلسلة."],"sub":[{"h":"النص الصوتي (مقتطف)","p":["Alors, c'est vraiment la dernière soirée ?","Oui, après deux saisons, on fait le bilan.","Quand j'ai commencé, je parlais à peine le français.","Maintenant, je regarde les séries sans sous-titres.","Tu as fait de vrais progrès, sincèrement !","Merci pour tout. On se retrouve bientôt !"]},{"h":"مفردات الموقف","p":["la fierté — الفخر","le progrès — التقدّم","le défi — التحدّي","l'objectif — الهدف","le sentiment — الشعور / الإحساس"]},{"h":"تعبيرات جاهزة للاستماع","p":["Une étape de plus, et voilà le niveau B1 !","Cette série est une réussite.","Fais un récapitulatif des cinq premières leçons.","Mon expérience avec Reflets a duré deux ans.","J'ai atteint mon objectif."]}]},{"h":"النطق والكلمات المفتاحية","p":["نبرة الوداع أبطأ وأدفأ من نبرة المباراة: «bientôt» [bjɛ̃.to] بـ t صامتة في النهاية، و«merci» بـ s صامتة، والحرف et يُنطق [e] صامتاً في العبارات المركّبة — النطق الدقيق هنا يصنع الفرق بين وداع مهذّب ووداع ناقص.","ثلاث كلمات تحمل الحلقة كلها: le progrès [lə pʁɔ.ɡʁɛ] بالغنة الخفيفة في النهاية، la fierté [la fjɛʁ.te] بالر الخفيفة، وl'étape [le.tap] بلا أي صوت إضافي — كرّرها في جملة واحدة حتى تصير جاهزة في ذاكرتك."]},{"h":"محتوى الحلقة","p":["يفتح المشهد على جمع أخير في المكان المألوف: ضحك، وذكريات، وصور قديمة تُعرض على الجميع — كل جملة تبدأ بـ «Tu te rappelles...؟» وتُغلق بابتسامة.","تتوالى اللقطات القديمة مع تصحيحات لطيفة: أول الأسئلة كانت بطيئة والآن الحديث سريع — وهنا تظهر الجملة المحورية «Quand j'ai commencé, je parlais àpeine»، أي حدث يتحرّك فوق خلفية ثابتة.","الوداع الأخير يُقال في هدوء: شكر، وضحك، وصافقة قصيرة، وجملة واحدة تُختم بها السلسلة — «On se retrouve bientôt !» — ثم تعود الكاميرا صامتة إلى المكان كما كان في أول يوم."]},{"h":"التطبيق والتلخيص","p":["الحلقة 28 — الخاتمة الكبرى: مراجعة الماضي، وعبارات الوداع، وحصيلة سنتين من التعلّم، كما في الفيديو الرئيسي «Reflets 2 -  13 1» على قناة Evgeny Dronov: شغّل الحلقة كاملة بلا توقف أول مرة لتلتقط الإيقاع، ثم أعد التشغيل وعينك على «Quand j'ai commencé, je parlais...» و«Merci pour tout» فقط.","اكتملت سلسلتا Reflets 1 (15 حلقة) وReflets 2 (13 حلقة) = 28 حلقة كاملة — راجع a2-t7-l1 وقارن ثم انتقل إلى a2-t8-l1 (الأفلام والمسلسلات) أو مباشرة إلى المستوى B1.","شاهد الحلقة مرة ثانية والنص مفتوح أمامك، ثم افتح ورقة المفردات وراجع اثني عشر مفردة من مفردات الختام (la fierté, le progrès, l'étape, le défi...)، وأخيراً سجّل تلخيصاً شفهياً مدته 60 ثانية تتحدث فيه عن رحلتك مع Reflets بأزمنة الماضي."]}],"examples":[{"fr":"On fait le bilan de deux saisons.","ar":"نراجع حصيلة موسمين.","note":"الحصيلة"},{"fr":"Quand j'ai commencé, je parlais à peine le français.","ar":"عندما بدأت، كنت أتكلم الفرنسية بالكاد.","note":"حدث + خلفية"},{"fr":"J'ai fait de vrais progrès cette année.","ar":"أحرزت تقدماً حقيقياً هذا العام.","note":"الماضي المركّب"},{"fr":"Merci pour tout, on se retrouve bientôt !","ar":"شكراً على كل شيء، نلتقي قريباً!","note":"الوداع"},{"fr":"Elle regarde son travail avec fierté.","ar":"تنظر إلى عملها بفخر."},{"fr":"Je vois mes progrès chaque mois.","ar":"أرى تقدمي كل شهر."}],"pron":[{"w":"la fierté","ipa":"[la fjɛʁ.te]","approx":"لا فيرتي"},{"w":"le progrès","ipa":"[lə pʁɔ.ɡʁɛ]","approx":"لو بروغري"},{"w":"l'étape","ipa":"[le.tap]","approx":"لتاب"}],"vocab":[{"fr":"la constance","ar":"الفخر","pos":"nom","g":"f","exFr":"Elle regarde son travail avec fierté.","ipa":"[la fjɛʁ.te]","exAr":"تنظر إلى عملها بفخر."},{"fr":"le prestige","ar":"التقدّم","pos":"nom","g":"m","exFr":"Je vois mes progrès chaque mois.","ipa":"[lə pʁɔ.ɡʁɛ]","exAr":"أرى تقدمي كل شهر."},{"fr":"le défi","ar":"التحدّي","pos":"nom","g":"m","exFr":"Le prochain défi, c'est le niveau B1.","ipa":"[lə de.fi]","exAr":"التحدّي القادم هو المستوى B1."},{"fr":"la réflexion","ar":"الهدف","pos":"nom","g":"m","exFr":"Mon objectif est de parler couramment.","ipa":"[lɔ.bʒe.tif]","exAr":"هدفي أن أتكلم بطلاقة."},{"fr":"le sentiment","ar":"الشعور / الإحساس","pos":"nom","g":"m","exFr":"J'ai le sentiment d'avoir réussi.","ipa":"[lə sɑ̃.timɑ̃]","exAr":"أشعر بأنني نجحت."},{"fr":"la réputation","ar":"المرحلة","pos":"nom","g":"f","exFr":"Une étape de plus, et voilà le niveau B1 !","ipa":"[le.tap]","exAr":"مرحلة أخرى، وهذا هو المستوى B1!"},{"fr":"le sommet","ar":"النجاح","pos":"nom","g":"f","exFr":"Cette série est une réussite.","ipa":"[la ʁɥɛ.sit]","exAr":"هذه السلسلة نجاح."},{"fr":"le récapitulatif","ar":"الاسترجاع / الملخّص","pos":"nom","g":"m","exFr":"Fais un récapitulatif des cinq premières leçons.","ipa":"[lə ʁe.ka.pi.ta.li.tif]","exAr":"اعمل استرجاعاً للدروس الخمسة الأولى."},{"fr":"l'expérience","ar":"التجربة","pos":"nom","g":"f","exFr":"Mon expérience avec Reflets a duré deux ans.","ipa":"[lɛks.pe.ʁjɑ̃s]","exAr":"تجربتي مع Reflets دامت عامين."},{"fr":"atteindre","ar":"يبلغ / يحقّق","pos":"verbe","exFr":"J'ai atteint mon objectif.","ipa":"[a.tɛ̃dʁ]","exAr":"لقد حققت هدفي."},{"fr":"consolider","ar":"يرسّخ / يثبّت","pos":"verbe","exFr":"Il faut consolider ses acquis.","ipa":"[kɔ̃.sɔ.li.de]","exAr":"يجب تثبيت المكتسبات."},{"fr":"être fier de","ar":"يفخر بـ","pos":"locution","exFr":"Je suis fier de mon parcours.","ipa":"[ɛtə fjeʁ də]","exAr":"أفتخر بمساري."}],"grammar":[{"tFr":"Passé composé vs imparfait : récapitulatif","tAr":"القاعدة: الماضي المركّب مقابل الامتداد — مراجعة تراكمية","body":["الماضي المركّب يسجّل الحدث المنجز والمؤرَّخ: «J'ai commencé hier», «elle a gagné la finale» — والامتداد يرسم ما كان مستمراً أو ثابتاً: «je parlais à peine», «il faisait beau». في الحكاية الواحدة يتداخلان: الامتداد يهيّئ المشهد ثم المركّب يحرّك الأحداث.","إشارتان تختصران الاختيار: «soudain», «à ce moment-là», «hier» ← passé composé، و«souvent», «tous les jours», «en même temps» ← imparfait. ومن تذكّر الإشارتين لم يخطئ الزمن في وصف أي قصة."],"ex":[{"fr":"J'ai regardé le match quand j'ai fini mon travail.","ar":"شاهدت المباراة عندما أنهيت عملي."},{"fr":"Pendant que je lisais, il a téléphoné.","ar":"بينما كنت أقرأ، اتصل الهاتف."}]},{"tFr":"Bilan des temps du niveau A2","tAr":"القاعدة: خريطة الأزمنة الأربعة في المستوى A2","body":["أربع أزمنة تغطي حاجة المستوى كاملاً: المضارع للحاضر والوعد («On se retrouve demain»)، وvenir de + infinitif للتو («On vient de finir la série»)، والماضي المركّب للحدث، والامتداد للخلفية والعادة — من رتّبها في رأسه رتّب حديثه كله.","الاختيار يكون من الفعل نفسه قبل الصيغة: هل أصف شيئاً كان مستمراً؟ ← imparfait. هل أؤرّخ لحدث وقع وانتهى؟ ← passé composé. وهل أتحدث عن خطة قادمة؟ ← aller + infinitif. ثلاث أسئلة قصيرة تحلّ نصف تمارين الزمن."],"ex":[{"fr":"Je vais m'inscrire au prochain cours.","ar":"سأُسجّل في الدورة القادمة."},{"fr":"On vient de terminer le dernier épisode.","ar":"لقد أنهينا للتو الحلقة الأخيرة."}]}],"mistakes":[{"wrong":"«Quand j'ai commencé, je parle à peine.»","right":"«Quand j'ai commencé, je parlais à peine.»","why":"الحالة الممتدة وقت حدث سابق تُروى بالامتداد لا بالمضارع."},{"wrong":"«Je suis allé au marché tous les dimanches.»","right":"«J'allais au marché tous les dimanches.»","why":"العادة المتكررة في الماضي تختار الامتداد لا الماضي المركّب."},{"wrong":"«À ce moment-là, je comprends tout.»","right":"«À ce moment-là, j'ai compris tout.»","why":"لحظة حاسمة في سرد الماضي تُسجَّل بالماضي المركّب."}],"dialogues":[{"title":"وداع السلسلة","ctx":"بطلان يجمعان حصيلة السنتين","lines":[{"who":"Karim","fr":"Alors, c'est vraiment la dernière soirée ?","ar":"إذن، هل هي فعلاً الليلة الأخيرة؟"},{"who":"Nadia","fr":"Oui, après deux saisons, on fait le bilan.","ar":"نعم، بعد موسمين، نراجع الحصيلة."},{"who":"Karim","fr":"Quand j'ai commencé, je parlais à peine le français.","ar":"عندما بدأت، كنت أتكلم الفرنسية بالكاد."},{"who":"Nadia","fr":"Maintenant, tu regardes les séries sans sous-titres.","ar":"الآن، تشاهد المسلسلات بلا ترجمة."},{"who":"Karim","fr":"C'est vrai, j'ai fait de vrais progrès.","ar":"صحيح، لقد أحرزت تقدماً حقيقياً."},{"who":"Nadia","fr":"Merci pour tout. Tu as été un bon prof.","ar":"شكراً على كل شيء. كنت معلماً جيداً."},{"who":"Karim","fr":"On se retrouve pour les films ! À bientôt !","ar":"نلتقي عند الأفلام! إلى اللقاء!"}]}],"exercises":[{"t":"mcq","skill":"grammar","q":"الزمن الصحيح: «Quand j'ai commencé, je ___ à peine.»","opts":["parlais","parle","parlé","parlerai"],"a":0,"why":"حالة مستمرة وقت الماضي ← imparfait."},{"t":"listen","skill":"listening","q":"[Écoute] أي عبارة مسموعة تُقال في الوداع؟","opts":["On se retrouve bientôt !","On se retrouve jamais !","Je me retrouve hier !","On se retrouvait demain !"],"a":0,"why":"«On se retrouve» = «نلتقي»، وبصيغة المضارع للوعد."},{"t":"order","skill":"writing","q":"رتّب جملة الحصيلة الشخصية","words":["J'ai","vu","mes","progrès","cette","année."],"ans":"J'ai vu mes progrès cette année.","why":"الفاعل مع auxiliaire، ثم الفعل، ثم المفعول، ثم الظرف الزمني."},{"t":"fill","skill":"writing","q":"أكمل: «On ___ le bilan de la série.»","fr":"On ___ le bilan de la série.","ans":"fait","alts":["Fait"],"why":"faire le bilan = يراجع الحصيلة."},{"t":"translate","skill":"writing","q":"ترجم: «لقد أحرزت تقدماً حقيقياً في الفرنسية هذا العام.»","ans":"J'ai fait de vrais progrès en français cette année.","alts":["j ai fait de vrais progrès en français cette année"],"why":"الحدث المتأرَّخ يُسجَّل بالماضي المركّب."},{"t":"correct","skill":"writing","q":"صحّح: «Quand j'étais jeune, je vais au marché.»","ans":"Quand j'étais jeune, j'allais au marché.","alts":["quand j etais jeune j allais au marché"],"why":"العادة في الماضي تختار الامتداد."},{"t":"mcq","skill":"reading","q":"«faire le bilan» تعني:","opts":["يراجع الحصيلة","يبدأ من جديد","يؤجّل القرار","يحتفل بعيد ميلاد"],"a":0,"why":"bilan = حصيلة ما تمّ إنجازه وتقييمه."},{"t":"speaking","skill":"speaking","q":"سجّل تلخيصاً شفهياً مدته 30 ثانية عن رحلتك مع سلسلة Reflets مستعملاً الماضي المركّب والامتداد.","target":"J'ai commencé... / Je parlais...","why":"دمج الزمنين في سرد شخصي مقنع."}],"homework":"أكملت Reflets — انتقل إلى a2-t8-l1 أو B1.\nأعد الاستماع للحلقة الختامية كاملة، اكتب فقرة حصيلة بالماضي المركّب والامتداد، وسجّل 30 ثانية شفهية.\nالحلقة السابقة/التالية: a2-t7-l27 («Le concours de pétanque / مسابقة البِيتَنك») ← a2-t7-l28 → a2-t8-l1 (بداية أفلام ومسلسلات) — Série terminée ! Réécoute le dernier épisode, écris un paragraphe de bilan (passé composé + imparfait) et enregistre 30 secondes. Étape suivante : a2-t8-l1 ou niveau B1.","sources":[{"label":"الحلقة الأساسية","videoId":"tjVs9hXVeN4","title":"Reflets 2 -  13 1","channel":"Evgeny Dronov","why":"الحلقة الأخيرة من Reflets 2: الخاتمة الكبرى — عودة إلى كل اللحظات وجملة وداع تُقال مرة واحدة في السلسلة كلها. أعدّها وأنت تجمع حصيلة سنتين من التعلّم.","cat":"Séries","level":"A2","main":true,"t":0},{"label":"مكمّل الدرس","videoId":"NuxgV428dOQ","title":"APPRENDRE le FRANÇAIS avec les SÉRIES TV et les FILMS - Lingopie Review","channel":"Apprendre le French","why":"كيف تتعلم الفرنسية من الأفلام والمسلسلات — مراجعة عملية تمهّل لك درس a2-t8-l1 مباشرة بعد نهاية السلسلة.","cat":"Méthode","level":"A2","extra":true}],"supplements":[{"id":"NuxgV428dOQ","videoId":"NuxgV428dOQ","title":"APPRENDRE le FRANÇAIS avec les SÉRIES TV et les FILMS - Lingopie Review","channel":"Apprendre le French","lang":"fr","dur":12,"why":"اثنتا عشرة دقيقة عن تعلّم الفرنسية من خلال الأفلام والمسلسلات — جسر مباشر وأخير من سلسلة Reflets إلى أسلوب الدراسة التالي.","level":"A2"}]}]},{"id":"a2-t8","slug":"films","icon":"play","color":"#e11d48","fr":"Films & séries","ar":"مسار التعلم بالأفلام والمسلسلات","desc":"تعلّم من الأفلام والمسلسلات الفرنسية: مشاهد Intouchables وInside Out ومسلسل Extra، مع دروس تطبيقية من قنوات عربية (إسراء ورنية) — كل درس بفيديوهات إثرائية.","lessons":[{"id":"a2-t8-l1","fr":"Apprendre le français par les films","ar":"الدرس 1: كيف تتعلّم الفرنسية من الأفلام","objectives":["تبني طريقة شخصية للتعلّم من الأفلام: مشاهدة مزدوجة + بطاقات مفردات","تفرّق بين voir و regarder وتستعملهما في وصف عادات المشاهدة","تصف فيلمك المفضّل في 4 جمل فرنسية بثقة"],"sections":[{"h":"الطريقة: من المشاهدة إلى التعلّم","video":{"id":"6WFsctwXlGc","title":"تعلم الفرنسية من خلال الأفلام","channel":"تعلم الفرنسية FR_AR","why":"شرح عربي مبسّط لطريقة الاستفادة من الأفلام: اختيار الفيلم، الترجمة الفرنسية، وتكرار المشاهد المفيدة — شغّله كمقدمة نظرية قبل التدريب العملي.","lang":"ar","main":true,"dur":10},"p":["الأفلام ليست ترفيهاً إضافياً على دروسك بل معمل لغة حقيقي: صوت حقيقي، إيقاع حقيقي، وخطأ وصواب حقيقي. الفرق بين من «يشاهد» ومن «يتعلّم» هو الخطة — وهذه الخطة في أربع خطوات تعلّمها هنا.","الخطوة الأولى: اختر فيلماً قصيراً أو مشهداً لا يتجاوز عشر دقائق، وشاهده بالترجمة الفرنسية لا العربية. الهدف ليس الفهم الكامل بل مسك الإيقاع والفكرة العامة.","الخطوة الثانية: أعد المشهد بلا ترجمة، وعند كل جملة توقف — لا للبحث عن كلمة، بل لتسجيل الجملة كاملة في دفترك. الجملة كاملة خزنة أفضل من الكلمة مفردة.","الخطوة الثالثة: اقرأ الجمل بصوت عالٍ ثلاث مرات مع النطق الأصلي — وهذا هو «Listen & Repeat» داخل الفيلم نفسه. النبرة التي تقلّدها هي هدية الفيلم الحقيقية.","الخطوة الرابعة: استعمل جملك الجديدة في جملتك أنت — اكتب مشهداً خيالياً قصيراً بثلاث جمل. من يكتب ما سمعه يملكه؛ من يكتبه فقط يقرؤه.","انتبه للفعلين: «voir» للرؤية العامة («Je vois bien le film») و«regarder» للانتباه المقصود («Je regarde un film le vendredi») — الفرق نفسه موجود في العربية بين «أرى» و«أشاهد»، فاستغله."],"sub":[{"h":"خطوات الخطة الأربع","p":["1) بترجمة فرنسية للفكرة.","2) بلا ترجمة لتسجيل الجمل.","3) قراءة بصوت عالٍ ثلاث مرات.","4) كتابة مشهد جديد."]},{"h":"voir / regarder","p":["Je vois bien le sujet.","Je regarde un film le soir.","Il regarde par la fenêtre.","On voit le résultat."]},{"h":"مفردات السينما","p":["le film — الفيلم.","la scène — المشهد.","le sous-titre — الترجمة.","la bande-annonce — الإعلان."]}]},{"h":"عبارات الحديث عن الأفلام","p":["«J'ai regardé un film hier soir» + «Il raconte...» — جملتان تفتحان كل نقاش عن السهرة. لاحظ الماضي هنا: النقاش عن فيلم مرّ يقتضي passé composé، ومع ذلك استمر في فهمك لو بقيت في المضارع.","«Le personnage principal est...» لوصف البطل: الأفلام تعطيك مفردات الوصف والمشاعر في سياقها الطبيعي لا في قائمة.","«Je recommande ce film parce que...» جملة رأي كاملة: تفضيل + سبب. من أتقن «parce que» تعلّم كيف يقول لماذا بفرنسية، لا أن يترجم كلمة «لأن» فقط."]},{"h":"التطبيق والتلخيص","p":["تمرين عملي: اختر مشهداً من فيلم تحبه (3 دقائق)، طبّق الخطوات الأربع عليه اليوم، وسجّل خمس جمل سمعتها.","اكتب مراجعة قصيرة لفيلم مفضّل: 4 جمل (الاسم، الحبكة، الشخصية، التوصية) بصوت عالٍ.","ما تحفظه: الخطوات الأربع + voir/regarder + «Je recommande parce que...». بهذه تنتقل من مشاهد إلى متدرّب حقيقي."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: الطريقة الأربع (مشاهدة بترجمة فرنسية ← إعادة بلا ترجمة لتسجيل الجمل ← قراءة بصوت عالٍ ← كتابة مشهد جديد) والفرق بين voir وregarder. أعد مشاهدة الفيديو الأساسي «تعلم الفرنسية من خلال الأفلام» (رابطه في مصادر الدرس) وطبّق الخطوات على مشهد واحد اليوم.","جسر المهارات: من كتابة الرسائل (A2-t6-l3) إلى خمس عشرة حلقة من Reflets (a2-t7-l1 حتى a2-t7-l15) حيث تدرّبت على المحادثة والاستماع، وأنت الآن في مدخل مسار الأفلام (a2-t8-l1): كل ما تعلّمته — الوصف والرأي والرسالة — يُستعمل الآن لمشاهدة الفيلم بعين المتعلّم لا بعين المتفرّج.","إعادة المشاهدة والتسجيل: أعد مشاهدة 3 دقائق من الفيديو الأساسي أو من فيلم قصير بلا ترجمة، سجّل ثلاث جمل سمعتها في دفترك، ثم اكتب مراجعة فيلم من 4 جمل بصوت عالٍ — مراجعتك الأولى هي محطة قياس تقدّمك."]}],"examples":[{"fr":"Je regarde des films en français chaque semaine.","ar":"أشاهد أفلاماً بالفرنسية كل أسبوع.","note":"العادة مع regarder"},{"fr":"Je vois bien l'intrigue, mais les mots sont rapides.","ar":"أرى الحبكة جيداً، لكن الكلمات سريعة.","note":"voir للإدراك"},{"fr":"Le personnage principal est très courageux.","ar":"الشخصية الرئيسية شجاعة جداً.","note":"وصف الشخصية"},{"fr":"Je recommande ce film parce que l'histoire est belle.","ar":"أوصي بهذا الفيلم لأن القصة جميلة.","note":"رأي + سبب"},{"fr":"J'ai noté cinq phrases de la scène.","ar":"دوّنت خمس جمل من المشهد.","note":"سجل الملاحظات"},{"fr":"On recommence sans sous-titres.","ar":"نعيد بلا ترجمة.","note":"خطوة 2"}],"pron":[{"w":"le film","ipa":"[lə fɛlm]","approx":"لفيلم"},{"w":"la scène","ipa":"[la sɛn]","approx":"لاسين"},{"w":"recommander","ipa":"[ʁə.kɔ̃.ma̅.de]","approx":"ريكونمادي"}],"vocab":[{"fr":"regarder","ar":"يشاهد (بانتباه)","pos":"verbe","g":"1er","exFr":"Je regarde un film.","ipa":"[ʁə.ɡaʁ.de]","exAr":"أشاهد فيلماً."},{"fr":"voir","ar":"يرى/يُدرك","pos":"verbe","g":"3e","exFr":"Je vois ce que tu veux dire.","ipa":"[vwaʁ]","exAr":"أرى ما تريد قوله."},{"fr":"l'intrigue","ar":"الحبكة","pos":"nom","g":"f","exFr":"L'intrigue est compliquée.","ipa":"[ɛ̃.tʁig]","exAr":"الحبكة معقدة."},{"fr":"le personnage","ar":"الشخصية","pos":"nom","g":"m","exFr":"Un personnage attachant.","ipa":"[pɛʁ.sɔ.naʒ]","exAr":"شخصية مؤثرة."},{"fr":"la scène","ar":"المشهد","pos":"nom","g":"f","exFr":"Cette scène est drôle.","ipa":"[sɛn]","exAr":"هذا المشهد مضحك."},{"fr":"le sous-titre","ar":"الترجمة (الشاشة)","pos":"nom","g":"m","exFr":"Avec ou sans sous-titres ?","ipa":"[su.titʁ]","exAr":"مع ترجمة أم بدون؟"},{"fr":"recommander","ar":"يوصي بـ","pos":"verbe","g":"1er","exFr":"Je recommande ce livre.","ipa":"[ʁə.kɔ̃.ma.de]","exAr":"أوصي بهذا الكتاب."},{"fr":"noter","ar":"يسجّل/يقيّم","pos":"verbe","g":"1er","exFr":"J'ai noté la phrase.","ipa":"[nɔ.te]","exAr":"سجّلت الجملة."},{"fr":"la bande-annonce","ar":"الإعلان الدعائي","pos":"nom","g":"f","exFr":"La bande-annonce est nerveuse.","ipa":"[bɑ̃d ɑ̃.nɔns]","exAr":"الإعلان مشوق."},{"fr":"courageux(se)","ar":"شجاع","pos":"adj","exFr":"Il est très courageux.","ipa":"[ku.ʁa.ʒø]","exAr":"إنه شجاع جداً."},{"fr":"chaque semaine","ar":"كل أسبوع","pos":"locution","exFr":"Je vais au cinéma chaque semaine.","ipa":"[ʃak sə.mɛn]","exAr":"أذهب إلى السينما كل أسبوع."},{"fr":"le réalisateur","ar":"المخرج","pos":"nom","g":"m","exFr":"Le réalisateur est talentueux.","ipa":"[ʁe.a.li.za.tœʁ]","exAr":"المخرج موهوب."}],"grammar":[{"tFr":"Voir vs regarder : la perception et l'attention","tAr":"القاعدة: الفرق بين voir وregarder","body":["«voir» الفعل العام: الرؤية والإدراك والانتقاء البصري — «Je vois la différence», «On voit bien...». أما «regarder» ففعل انتباه مقصود ومُوجَّه: «Je regarde la télé», «Elle regarde par la fenêtre» — لا يُقال بلا شيء تراه بوعي.","كلاهما من الفئة الثالثة في المضارع (tu regardes, il voit, nous voyons) — ومع tournure المستقبل يصبحان: «Je regarderai», «Je verrai». التمييز في المعنى أهم من التمييز الإملائي هنا."],"ex":[{"fr":"Je regarde le film, mais je ne vois pas le détail.","ar":"أشاهد الفيلم لكنني لا أرى التفصيل."},{"fr":"Nous regardons une série le dimanche.","ar":"نشاهد مسلسلاً يوم الأحد."}]}],"mistakes":[{"wrong":"«Je vois la télé tous les soirs»","right":"«Je regarde la télé tous les soirs»","why":"المشاهدة المقصودة مع regarder."},{"wrong":"«Je regarde bien le sens»","right":"«Je vois bien le sens»","why":"الإدراك المجرد مع voir."},{"wrong":"تسجيل كلمات مفردة من الفيلم","right":"تسجيل الجملة كاملة","why":"الجملة تحمل النبرة والسياق مع الكلمة."},{"wrong":"الترجمة العربية أثناء المشاهدة","right":"الترجمة الفرنسية أو بلا ترجمة","why":"العربية تقطع سلسلة الربط بين الصوت والمعنى."}],"dialogues":[{"title":"نقاش عن فيلم","ctx":"صديقان بعد مشاهدة","lines":[{"who":"Samir","fr":"Tu as regardé le film que je t'ai recommandé ?","ar":"هل شاهدت الفيلم الذي أوصيتك به؟"},{"who":"Léa","fr":"Oui, hier soir. J'ai aimé l'intrigue, elle est originale.","ar":"نعم، مسأ أمس. أعجبتني الحبكة، إنها أصيلة."},{"who":"Samir","fr":"Et le personnage principal ?","ar":"وأما الشخصية الرئيسية؟"},{"who":"Léa","fr":"Il est courageux, mais un peu naïf.","ar":"إنه شجاع، لكنه ساذج قليلاً."},{"who":"Samir","fr":"Moi, je regrette la fin. Tu vois ce que je veux dire ?","ar":"أما أنا فأشفق على النهاية. هل ترى ما أقول؟"},{"who":"Léa","fr":"Oui, je vois. Mais je recommande la suite !","ar":"نعم، أرى. لكنني أوصي بالجزء التالي!"}]}],"exercises":[{"t":"mcq","skill":"grammar","q":"الصيغة الصحيحة لعادات المشاهدة:","opts":["Je regarde des films le vendredi","Je vois des films le vendredi","Je regarder films","Regarder un film moi"],"a":0,"why":"المشاهدة المقصودة مع regarder."},{"t":"fill","skill":"writing","q":"أكمل: «Je ___ bien l'intrigue.» (أُدرك)","fr":"Je ___ bien l'intrigue.","ans":"vois","alts":["Vois"],"why":"الإدراك العام مع voir."},{"t":"mcq","skill":"reading","q":"«Je recommande ce film parce que...» تُستعمل لـ:","opts":["إبداء رأي مع سبب","سؤال عن السعر","طلب تذكرة","وصف المكان"],"a":0,"why":"توصية + سبب."},{"t":"order","skill":"writing","q":"رتّب جملة رأي","words":["Je","recommande","ce","film","parce","que","l'histoire","est","belle."],"ans":"Je recommande ce film parce que l'histoire est belle.","why":"رأي ← سبب بـ parce que."},{"t":"listen","skill":"listening","q":"عبارة الخطوات في الشرح:","opts":["On recommence sans sous-titres","On recommence avec arabe","On finit sans film","On regarde demain tard"],"a":0,"why":"خطوة 2: بلا ترجمة."},{"t":"translate","skill":"writing","q":"ترجم: «أشاهد فيلماً كل نهاية أسبوع.»","ans":"Je regarde un film chaque week-end.","alts":["je regarde un film chaque week end"],"why":"regarder + كل + وقت."},{"t":"correct","skill":"writing","q":"صحّح: «Je regarde bien le sens de cette phrase.»","ans":"Je vois bien le sens","alts":["je vois bien le sens de cette phrase"],"why":"الإدراك المجرد مع voir."},{"t":"writing","skill":"writing","q":"اكتب مراجعة فيلم من 4 جمل (الاسم، الحبكة، الشخصية، التوصية).","target":"J'ai regardé... L'intrigue... Le personnage... Je recommande...","why":"إنتاج مراجعة موجّهة."}],"homework":"اختر مشهداً من فيلم (3 دقائق) وطبّق الخطوات الأربع اليوم، ثم اكتب خمس جمل سمعتها في دفتر المفردات.\nسلسلة A2: a2-t7-l15 ← a2-t8-l1 → a2-t8-l2","sources":[{"title":"تعلم الفرنسية من خلال الأفلام","channel":"تعلم الفرنسية FR_AR","videoId":"6WFsctwXlGc","why":"شرح عربي لطريقة التعلّم من الأفلام — المقدمة النظرية للدرس.","cat":"Films & séries","level":"A2","main":true},{"title":"تعلم اللغة الفرنسية من الافلام — كلمات وجمل لا غنى عنها","channel":"Rania's Academy","videoId":"Epm5fSPjy2Q","why":"جُمل جاهزة من الأفلام بالعربية — بطاقة مفردات إضافية.","cat":"Films & séries","level":"A2","extra":true},{"title":"8 films pour améliorer ton français","channel":"Français Authentique","videoId":"3gmJXVqwiHQ","why":"ثمانيية أفلام سهلة تحسّن لغتك — يمدّ يدك من الطريقة النظرية إلى قائمة أفلام جاهزة للمشاهدة.","cat":"Films & séries","level":"A2","extra":true}],"supplements":[{"id":"Epm5fSPjy2Q","title":"تعلم اللغة الفرنسية من الافلام — كلمات وجمل لا غنى عنها","channel":"Rania's Academy","why":"شرح عربي مختصر لجمل وأمتع من الأفلام — مكمل عربي سريع.","lang":"ar","dur":8},{"id":"3gmJXVqwiHQ","title":"8 films pour améliorer ton français","channel":"Français Authentique","why":"ثمانيية أفلام سهلة مع منهجية للاستفادة منها — قائمة أفلام جاهزة تطبّق عليها خطوات الدرس الأربع فوراً.","lang":"fr","dur":14}]},{"id":"a2-t8-l2","fr":"Intouchables — la vraie langue du cinéma","ar":"الدرس 2: Intouchables — لغة السينما الحقيقية","objectives":["تفهم مشاهد فيلم Intouchables من خلال درس تفاعلي موجّه","تستعمل أفعال الرؤية والأفعال المنتهية بـ -emment في جمل يومية","تصف شخصيتين متقابلتين (الأمريكي/الشاب) في أربع جمل"],"sections":[{"h":"درس مصوّر: مشاهد Intouchables","video":{"id":"sXUKSxTP5xY","title":"Learn French with Movies: Intouchables","channel":"FluentU French","why":"درس FluentU على فيلم Intouchables: يعرض مشهداً أصلياً ثم يشرح مفرداته وجمله — تعلّم الإيقاع السينمائي الحقيقي مع شرح واضح.","lang":"en","main":true,"dur":14},"p":["Intouchables فيلم ناجح لسبب لغوي: حوارات قصيرة، لهجة شارع فرنسية واضحة، وحوارات مكتوبة بذكاء. المشاهد منه معمل ممتاز للفصحى المعاصرة والعامية المفهومة معاً.","في هذا الدرس تشاهد المشهد أولاً ثم يُشرح لك: الفعل والجملة الجديدة ثم السياق. اتبع الترتيب نفسه في أي مشهد تختاره لاحقاً بنفسك — الترتيب هو الطريقة.","لاحظ الأفعال المنتهية بـ -emment في الحوارات: «vraiment», «complètement», «simplement» — الانتهاء نفسه يعطيك ظرفاً من أي صفة: lent → lentement, prudent → prudemment, facile → facilement. قاعدة واحدة تضاعف مفرداتك الظرفية.","الشخصيتان في الفيلم تتقابلان لغويّاً: خطاب رسمي عند موظف القصر مقابل شارع في حديث الشاب — المقارنة بين المستويين داخل مشهد واحد أوضح من أي شرح نظري.","الاستماع والتكرار: الحوارات السينمائية مليئة بالتقطيع والحذف («T'as vu?», «J'ai pas...») — انسخ الحذف نفسه عند المحاكاة، فالفرنسية المنطوقة تُحذف كثيراً ولا تُنطق كتبياً.","بعد الدرس: اكتب خمس جمل عن تناقض الشخصيةين (الرسمي/العامي) مستعملاً ظرفاً بـ -emment اثنتين على الأقل."],"sub":[{"h":"ظرف من الصفة بـ -emment","p":["vraiment — حقاً.","complètement — كلياً.","simplement — ببساطة.","facilement — بسهولة."]},{"h":"مفردات المشهد","p":["le handicap — الإعاقة.","le cadre — الإطار/الموظف.","la conduite — القيادة.","le lien — الرابط."]},{"h":"مستويان لغويان","p":["registre soutenu — المستوى المرتفع.","registre courant — المستوى اليومي.","T'as vu ? — عامية مفهومة.","Vous avez vu ? — مهذّب."]}]},{"h":"عبارات الحوارات السينمائية","p":["«Ça va ?» اختصار الحياة كلها: تحية وسؤال وطمأنينة في كلمتين. الفيلم يكرّرها بأشكالها (Ça va ? / Ça roule ? / Nickel !) — احفظ الثلاثة كردود.","«On verra bien» عبارة الحدس الفرنسي: «سنرى». تُغلق النقاش بلا وعد ولا رفض، وتظهر في نهاية كل حوار معلّق — منطق اجتماعي قبل أن يكون لغوياً.","«Tu exagères !» ردّ التعجب: «أنت تبالغ!». حوارات الأصدقاء تميل إلى المبالغة المتبادلة، والردّ عليها جزء من إيقاع المحادثة لا اعتراضاً عليها."]},{"h":"التطبيق والتلخيص","p":["تمرين: اختر جملتين من المشهد المفسَّر وسجّلهما محاكياً نبرة الممثلين حرفياً — ثلاث مرات متتالية.","اكتب مقارنة قصيرة بين شخصيتين في 4 جمل: واحدة لكل من السؤال والجواب والصفة والظرف.","ما تحفظه: قاعدة -emment + «Ça va? / Nickel!» + «On verra bien». الثلاثة تجعل حوارك يبدو سينمائياً لا كتابياً."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: الإيقاع السينمائي الحقيقي، قاعدة الظرف بـ -emment، والمستويان اللغويان (رسمية موظف القصر/شارع الشاب). أعد مشاهدة درس FluentU الأساسي على Intouchables (الرابط في مصادر الدرس) وسجّل ثلاث جمل بمحاكاة نبرة الممثلين.","جسر المهارات: من منهجية الأفلام العامة (a2-t8-l1) إلى التحليل العملي على فيلم واحد (a2-t8-l2) — وصفك في A2-t6-l1 يصبح هنا وصف شخصية فيلم، ورأيك في A2-t6-l2 يصبح حكماً على المشهد، وسؤالك يعود بطرقه الثلاث من a2-t8-l4 إليه.","إعادة المشاهدة والتسجيل: أعد المشهد المفسَّر ثلاث مرات — بالترجمة، بلا ترجمة، ثم وأنت تُكرّر — وسجّل مقارنة بين شخصيتين في 4 جمل تتضمن ظرفاً واحداً بـ -emment على الأقل."]}],"examples":[{"fr":"C'est vraiment touchant.","ar":"إنه مؤثر حقاً.","note":"ظرف -emment"},{"fr":"Il comprend complètement la situation.","ar":"إنه يفهم الوضع كلياً.","note":"complètement"},{"fr":"— Ça va ? — Nickel, merci !","ar":"— كيف حالك؟ — ممتاز، شكراً!","note":"تحية حوارية"},{"fr":"Tu exagères un peu !","ar":"أنت تبالغ قليلاً!","note":"ردّ تعجب"},{"fr":"On verra bien demain.","ar":"سنرى غداً.","note":"إغلاق معلّق"},{"fr":"Il conduit simplement et vite.","ar":"يقود ببساطة وسرعة.","note":"ظرف من صفة"}],"pron":[{"w":"vraiment","ipa":"[vʁɛ.mɑ̃]","approx":"فرامان"},{"w":"complètement","ipa":"[kɔ̃.plɛt.mɑ̃]","approx":"كونبليتمان"},{"w":"le handicap","ipa":"[ɑ̃.da.kap]","approx":"أنداكاب"}],"vocab":[{"fr":"le film / le personnage","ar":"الفيلم/الشخصية","pos":"nom","exFr":"Le personnage est attachant.","ipa":"[pɛʁ.sɔ.naʒ]","exAr":"الشخصية مؤثرة."},{"fr":"vraiment","ar":"حقاً","pos":"adv","exFr":"C'est vraiment beau.","ipa":"[vʁɛ.mɑ̃]","exAr":"إنه جميل حقاً."},{"fr":"complètement","ar":"كلياً/تماماً","pos":"adv","exFr":"Je suis d'accord complètement.","ipa":"[kɔ̃.plɛt.mɑ̃]","exAr":"أوافق تماماً."},{"fr":"simplement","ar":"ببساطة","pos":"adv","exFr":"C'est simplement génial.","ipa":"[sɛ̃.plə.mɑ̃]","exAr":"إنه ببساطة رائع."},{"fr":"la conduite","ar":"القيادة","pos":"nom","g":"f","exFr":"Il aime la conduite.","ipa":"[kɔ̃.dyt]","exAr":"يحب القيادة."},{"fr":"le lien","ar":"الرابط","pos":"nom","g":"m","exFr":"Un lien solide.","ipa":"[ljɛ̃]","exAr":"رابط متين."},{"fr":"exagérer","ar":"يبالغ","pos":"verbe","g":"1er","exFr":"Tu exagères !","ipa":"[eɡ.za.ʒe.ʁe]","exAr":"أنت تبالغ!"},{"fr":"nickel","ar":"ممتاز (عامية)","pos":"adj","exFr":"Tout est nickel !","ipa":"[ni.kɛl]","exAr":"كل شيء ممتاز!"},{"fr":"touchant(e)","ar":"مؤثر","pos":"adj","exFr":"Un film touchant.","ipa":"[tu.ʃɑ̃]","exAr":"فيلم مؤثر."},{"fr":"on verra","ar":"سنرى","pos":"expression","exFr":"On verra bien !","ipa":"[ɔ̃ vɛ.ʁa]","exAr":"سنرى!"},{"fr":"la situation","ar":"الوضع","pos":"nom","g":"f","exFr":"La situation est claire.","ipa":"[si.ty.a.sjɔ̃]","exAr":"الوضع واضح."},{"fr":"l'amitié","ar":"الصداقة","pos":"nom","g":"f","exFr":"Une amitié solide naît dans le film.","ipa":"[a.mi.tje]","exAr":"صداقة متينة تولد في الفيلم."}],"grammar":[{"tFr":"Les adverbes en -emment","tAr":"القاعدة: الظرف من الصفة بـ -emment","body":["الصفة تتحول إلى ظرف بـ -emment: lent → lentement, prudent → prudemment, évident → évidemment — مع شذوذ شائع (bon → bien, mauvais → mal, vite يبقى vite, beaucoup غير مشتق). القاعدة تمنحك عشرات الظرفات بتصريفة واحدة.","موضع الظرف في الجملة مرن: بعد الفعل أو نهايته أو أول الجملة للتأكيد — «Il comprend complètement», «Complètement, il a raison» — التأكيد المتقدّم شائع في الحوار السينمائي."],"ex":[{"fr":"Elle parle clairement et simplement.","ar":"تتحدث بوضوح وبساطة."},{"fr":"Il a évidemment raison.","ar":"من الواضح أنه محق."}]}],"mistakes":[{"wrong":"«Il comprend totalementment»","right":"«Il comprend totalement» (تام بلا -ment)","why":"بعض الصفات تنتهي بـ -al → -alement/ammais: totalement يبقى بلا سوابق إضافية."},{"wrong":"حذف النبرة في النسخ السينمائي","right":"محاكاة إيقاع المقطع الأصلي","why":"الفيلم يعلّمك النبرة قبل المفردات."},{"wrong":"اعتماد الترجمة العربية أثناء المشاهدة","right":"الترجمة الفرنسية أو بلا ترجمة","why":"الربط المباشر صوت←معنى أسرع ترسباً."},{"wrong":"اعتبار عامي الشارع خطأً","right":"تمييزه عن الفصحى ثم استخدامه بحذر","why":"الحوار السينمائي يستعمله بوعي."}],"dialogues":[{"title":"بعد الفيلم","ctx":"زميلان يتناقشان في المشهد","lines":[{"who":"Yanis","fr":"Le moment où il apprend à conduire est vraiment drôle.","ar":"اللحظة التي يتعلم فيها القيادة مضحك حقاً."},{"who":"Sofia","fr":"Oui, mais la fin est complètement touchante.","ar":"نعم، لكن النهاية مؤثرة تماماً."},{"who":"Yanis","fr":"Tu exagères ! C'est simplement un bon film.","ar":"أنت تبالغ! إنه ببساطة فيلم جيد."},{"who":"Sofia","fr":"Non, vraiment. Le lien entre eux est solide.","ar":"لا، حقاً. الرابط بينهما متين."},{"who":"Yanis","fr":"D'accord. On verra la suite samedi ?","ar":"حسناً. نشاهد الجزء التالي السبت؟"},{"who":"Sofia","fr":"Nickel ! Ça roule.","ar":"ممتاز! تمّ الأمر."}]}],"exercises":[{"t":"mcq","skill":"grammar","q":"الظرف الصحيح من «facile»:","opts":["facilement","facilementment","facilementa","facile"],"a":0,"why":"الصفة + emment (مع التجانس)."},{"t":"fill","skill":"writing","q":"أكمل: «Il a ___ compris.» (كلياً)","fr":"Il a ___ compris.","ans":"complètement","alts":["Complètement"],"why":"ظرف التأكيد."},{"t":"mcq","skill":"listening","q":"ردّ «ممتاز» في الحوار العامي:","opts":["Nickel !","Vraiment !","Simplement !","Bientôt !"],"a":0,"why":"nickel عامية بمعنى ممتاز."},{"t":"order","skill":"writing","q":"رتّب وصف العلاقة بين شخصيتي Intouchables","words":["Le","lien","entre","eux","est","vraiment","touchant."],"ans":"Le lien entre eux est vraiment touchant.","why":"الظرف vraiment يسبق الصفة touchant — والرابط بين الشخصيتين هو موضوع الفيلم."},{"t":"listen","skill":"listening","q":"عبارة الإغلاق المعلّقة:","opts":["On verra bien","On verra jamais","On ne voit rien","On a vu hier"],"a":0,"why":"on verra bien = سنرى."},{"t":"translate","skill":"writing","q":"ترجم: «أنت تبالغ قليلاً يا صديقي.»","ans":"Tu exagères un peu, mon ami.","alts":["tu exageres un peu mon ami"],"why":"exagérer + un peu."},{"t":"correct","skill":"writing","q":"صحّح: «Je vois la télé chaque soir»","ans":"Je regarde la télé","alts":["je regarde la tele"],"why":"المشاهدة المقصودة مع regarder."},{"t":"speaking","skill":"speaking","q":"صف شخصيتين متقابلتين في 4 جمل (صفة + ظرف -emment ×2).","target":"Il/Elle est... et parle...ment.","why":"إنتاج المقارنة والظرف معاً."}],"homework":"أعد درس FluentU كاملاً، ثم انسخ ثلاث جمل من المشهد وسجّلها بمحاكاة نبرة الممثل — ودوّن خمس ظروف جديدة من -emment.\nسلسلة A2: a2-t8-l1 ← a2-t8-l2 → a2-t8-l3","sources":[{"title":"Learn French with Movies: Intouchables","channel":"FluentU French","videoId":"sXUKSxTP5xY","why":"درس مصوّر يشرح مشهد Intouchables مقطعاً مقطعاً.","cat":"Films & séries","level":"A2","main":true},{"title":"Learn French with Movies: Intouchables (interactive deepdive lesson!)","channel":"FluentU French","videoId":"9EDKN4Wqlig","why":"نسخة تفاعلية أعمق لنفس المشهد — للمراجعة الثانية.","cat":"Films & séries","level":"A2","extra":true},{"title":"«Intouchables» en 10 minutes | Français Facile!","channel":"FRENCH TIME","videoId":"aqHG9hgFZqI","why":"تلخيص كامل لفيلم Intouchables بفرنسية سهلة — إعادة سريعة لحبكة الفيلم قبل الدرس وبعده.","cat":"Films & séries","level":"A2","extra":true}],"supplements":[{"id":"9EDKN4Wqlig","title":"Learn French with Movies: Intouchables (interactive deepdive lesson!)","channel":"FluentU French","why":"درس تفاعلي أعمق لنفس الفيلم — إعادة بعمق مختلف بعد الدرس الأساسي.","lang":"en","dur":14},{"id":"aqHG9hgFZqI","title":"«Intouchables» en 10 minutes | Français Facile!","channel":"FRENCH TIME","why":"تلخيص Intouchables بفرنسية سهلة في عشر دقائق — صورة كاملة لحبكة الفيلم قبل تحليل مشاهده.","lang":"fr","dur":11}]},{"id":"a2-t8-l3","fr":"Dessins animés — émotions et langage simple","ar":"الدرس 3: أفلام الكرتون — المشاعر واللغة الواضحة","objectives":["تعبر عن المشاعر بالفرنسية (content, triste, en colère) بأزواجها اللغوية الصحيحة (être / avoir)","تشاهد مشاهد كرتونية بالترجمة الفرنسية وتفهمها دون مساعدة","تصف فيلم كرتون مفضّل في أربع جمل تشمل شعوراً واحداً"],"sections":[{"h":"درس مصوّر: Inside Out بالعربية","video":{"id":"p4atTiZTRKc","title":"تعلم الفرنسية الحقيقية من خلال الأفلام: فيلم Inside Out","channel":"FrenchVerse","why":"درس عربي يشرح فيلم الكرتون Inside Out بلغة بسيطة — بداية مثالية لأن مفردات الكرتون أوضح وأقل تعقيداً من دراما الشارع.","lang":"ar","main":true,"dur":16},"p":["أفلام الكرتون هي أبسط بوابة إلى اللغة السينمائية: الجمل قصيرة، النطق بطيئ وواضح، والمشاعر مصوّرة على الشاشة نفسها — فتشاهد «content» في وجه البطل فوراً.","Inside Out فيلم عن المشاعر بذاته، فضاعفك لغويّاً: كل مشهد يعطيك شعوراً بالفرنسية لا بالترجمة. أنفع درس لبناء «مفردات الشعور» كلها دفعة واحدة.","مفردات المشاعر تُبنى مع أفعال مختلفة: «être content» للحالة، و«avoir peur» للمخافة، و«être en colère» للغضب — احفظها كأزواج (فعل + شعور) لا كترجمات.","لاحظ السؤال عن الشعور: «Comment tu te sens ?» وجوابه «Je suis content(e)» أو «Je me sens bien» — سؤال وجواب يعيدان ظهورهما في كل حوار شخصي.","الاستماع والتكرار: أصوات الكرتون أوضح من الأفلام — استعمل المقطع لتدريب النطق الكامل بلا خجل، ثم انتقل إلى الفيلم الحقيقي وأنت معتاد على السرعة.","بعد الحلقة: اكتب يوميات مشاعر قصيرة (5 جمل): كيف استيقظت، ما شعرت في العمل، وما شعرت مساءً — بمفردات الشعور لا بالأحداث."],"sub":[{"h":"المشاعر مع أفعالها","p":["être content(e) — سعيد.","être triste — حزين.","être en colère — غاضب.","avoir peur — يخاف."]},{"h":"سؤال الشعور","p":["Comment tu te sens ?","Je me sens bien.","Ça ne va pas fort.","Je suis fatigué(e)."]},{"h":"مفردات الكرتون","p":["le dessin animé — الكرتون.","l'émotion — الشعور.","le rêve — الحلم.","le cauchemar — الكابوس."]}]},{"h":"عبارات المشاعر المتكررة","p":["«Je suis tellement content !» أداة التوكيد «tellement» ترفع الجملة من وصف إلى شعور — الكرتون يكررها دائماً، ونحن نقلدها.","«J'ai peur du noir» — لاحظ à/du بعد avoir peur: لا يُقال «peur le noir». احفظ الشعور كقالب كامل: avoir peur de + شيء.","«Ça me rend triste» (يجعلني حزيناً) أسلوب سببي مهم: الفعل rendre + personne + صفة — به تنتقل من الوصف إلى التأثير."]},{"h":"التطبيق والتلخيص","p":["تمرين اليوم: اكتب خمس جمل مشاعر مختلفة (سعيد، حزين، غاضب، خائف، متعب) — كل جملة مسبوقة بسببها بـ «parce que».","شاهد مشهداً كرتونياً قصيراً بالترجمة الفرنسية وسجّل ثلاث جمل شعور سمعتها.","ما تحفظه: أزواج المشاعر الخمسة + «Comment tu te sens؟» + «Ça me rend...». بها تفتح أي حديث شخصي حقيقي."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: أزواج المشاعر مع أفعالها (être content / avoir peur / être en colère) وسؤال «Comment tu te sens؟» وجوابه. أعد مشاهدة الفيديو الأساسي «تعلم الفرنسية الحقيقية من خلال الأفلام: فيلم Inside Out» (رابطه في مصادر الدرس) ودوّن ثلاث جمل شعور سمعتها.","جسر المهارات: من دراما الشارع في Intouchables (a2-t8-l2) إلى لغة الكرتون الأوضح هنا (a2-t8-l3) — مفردات المشاعر التي تصف بها الشخصيات مكملة لمفردات الوصف في A2-t6-l1 ولأدوات الرأي في A2-t6-l2، وأصوات الكرتون أبطأ فتثبّت النطق.","إعادة المشاهدة والتسجيل: أعد مشهداً كرتونياً قصيراً بالترجمة الفرنسية، وسجّل خمس جمل مشاعر بصوت عالٍ — كل جملة تبدأ بـ «Je suis... parce que...» — ثم استمع لتسجيلك وصحّح نطقك."]}],"examples":[{"fr":"Je suis content d'avoir compris.","ar":"سعيدٌ لأنني فهمت.","note":"être + شعور"},{"fr":"J'ai peur de l'orage.","ar":"أخاف من العاصفة.","note":"avoir peur de"},{"fr":"Elle est en colère contre moi.","ar":"هي غاضبة منّي.","note":"être en colère"},{"fr":"Ça me rend triste de te voir partir.","ar":"يؤلمني رؤيتك مغادراً.","note":"rendre + صفة"},{"fr":"— Comment tu te sens ? — Je me sens fatigué.","ar":"— كيف تشعر؟ — أشعر بالتعب.","note":"سؤال وجواب"},{"fr":"C'est tellement émouvant !","ar":"إنه مؤثر جداً!","note":"tellement توكيد"}],"pron":[{"w":"l'émotion","ipa":"[e.mɔ.sjɔ̃]","approx":"إمّوسيون"},{"w":"la peur","ipa":"[lə pœʁ]","approx":"لوبور"},{"w":"en colère","ipa":"[ɑ̃ kɔ.lɛʁ]","approx":"أون كولير"}],"vocab":[{"fr":"le dessin animé","ar":"الفيلم الكرتوني","pos":"nom","g":"m","exFr":"Les dessins animés sont pour tous.","ipa":"[dɛ.zi.n a.ni.me]","exAr":"الكرتون للجميع."},{"fr":"triste","ar":"حزين","pos":"adj","exFr":"Le film est triste.","ipa":"[tʁist]","exAr":"الفيلم حزين."},{"fr":"en colère","ar":"غاضب","pos":"locution","exFr":"Il est en colère.","ipa":"[ɑ̃ kɔ.lɛʁ]","exAr":"إنه غاضب."},{"fr":"avoir peur","ar":"يخاف","pos":"locution","exFr":"J'ai peur du noir.","ipa":"[avwaʁ pœʁ]","exAr":"أخاف من الظلام."},{"fr":"l'émotion","ar":"الشعور","pos":"nom","g":"f","exFr":"Une forte émotion.","ipa":"[e.mɔ.sjɔ̃]","exAr":"شعور عنيف."},{"fr":"le rêve","ar":"الحلم","pos":"nom","g":"m","exFr":"Un beau rêve.","ipa":"[ʁɛv]","exAr":"حلم جميل."},{"fr":"le cauchemar","ar":"الكابوس","pos":"nom","g":"m","exFr":"J'ai fait un cauchemar.","ipa":"[ko.ʃə.maʁ]","exAr":"رأيت كابوساً."},{"fr":"rendre + adj","ar":"يجعل (صفة)","pos":"verbe","g":"3e","exFr":"Ça me rend malade.","ipa":"[ʁɑ̃dʁ]","exAr":"هذا يجعلني مريضاً."},{"fr":"se sentir","ar":"يشعر بنفسه","pos":"verbe","g":"2e","exFr":"Je me sens bien.","ipa":"[sə sɑ̃.tiʁ]","exAr":"أشعر بخير."},{"fr":"émouvant(e)","ar":"مؤثر","pos":"adj","exFr":"Une scène émouvante.","ipa":"[e.mu.vɑ̃]","exAr":"مشهد مؤثر."},{"fr":"l'aventure","ar":"المغامرة","pos":"nom","g":"f","exFr":"Le dessin animé raconte une aventure.","ipa":"[a.vɑ̃.tyʁ]","exAr":"الكرتون يروي مغامرة."},{"fr":"la joie","ar":"الفرح","pos":"nom","g":"f","exFr":"La joie se lit sur son visage.","ipa":"[ʒwa]","exAr":"الفرح يُقرأ على وجهه."}],"grammar":[{"tFr":"Les émotions : être + adjectif / avoir peur de","tAr":"القاعدة: أزواج المشاعر","body":["معظم المشاعر مع être + صفة (content, triste, fatigué, en colère) — لكن «avoir peur» و«avoir envie» و«avoir honte» مع avoir، ويلزمها حرف الجر: peur de, envie de, honte de. حفظ الزوج كاملاً (الفعل + الأداة) يمنع الخلط.","«se sentir» + صفة للشعور الذاتي («Je me sens mieux»)، و«rendre» + personnage + صفة للتأثير («Ça me rend triste») — ثلاث طرق للتعبير عن الشعور: الحالة، الإحساس، التأثير."],"ex":[{"fr":"J'ai envie de rire.","ar":"أودّ الضحك."},{"fr":"Le résultat me rend heureux.","ar":"النتيجة تجعلني سعيداً."}]}],"mistakes":[{"wrong":"«J'ai peur le noir»","right":"«J'ai peur du noir»","why":"avoir peur تأخذ de مع الاسم."},{"wrong":"«Je suis peur»","right":"«J'ai peur»","why":"الخوف مع avoir لا être."},{"wrong":"«Ça me rend à triste»","right":"«Ça me rend triste» بلا حرف جر","why":"rendre + صفة مباشرة."},{"wrong":"وصف الشعور بالأفعال الحركية بدل être","right":"«Je suis content» لا «Je contents»","why":"المشاعر الصفة تحتاج étre."}],"dialogues":[{"title":"بعد مشاهدة كرتون","ctx":"طفل وأمه يتحدثان بالفرنسية","lines":[{"who":"La mère","fr":"Alors, tu as aimé le dessin animé ?","ar":"فماذا، أعجبك الكرتون؟"},{"who":"L'enfant","fr":"Oui ! J'étais content, mais j'ai eu peur du monstre.","ar":"نعم! كنت سعيداً، لكنني خفت من الوحش."},{"who":"La mère","fr":"Ne fais pas de cauchemar, d'accord ?","ar":"لا تحلم كابوساً، حسناً؟"},{"who":"L'enfant","fr":"D'accord. La fin m'a rendu triste un peu.","ar":"حسناً. جعلتني النهاية حزيناً قليلاً."},{"who":"La mère","fr":"Comment tu te sens maintenant ?","ar":"كيف تشعر الآن؟"},{"who":"L'enfant","fr":"Je me sens bien ! Je recommande le film.","ar":"أشعر بخير! أوصي بالفيلم."}]}],"exercises":[{"t":"mcq","skill":"grammar","q":"الصيغة الصحيحة للخوف:","opts":["J'ai peur de l'orage","Je suis peur de l'orage","J'ai peur l'orage","Peur avoir de"],"a":0,"why":"avoir peur de + اسم."},{"t":"fill","skill":"writing","q":"أكمل: «Je ___ content aujourd'hui.»","fr":"Je ___ content aujourd'hui.","ans":"suis","alts":["Suis"],"why":"المشاعر مع être."},{"t":"mcq","skill":"reading","q":"«Ça me rend triste» تعني:","opts":["هذا يجعلني حزيناً","أنا أحزن نفسه","أرى حزناً","حزن بعيد"],"a":0,"why":"rendre + personnage + صفة."},{"t":"order","skill":"writing","q":"رتّب جملة شعور","words":["J'ai","peur","du","cauchemar."],"ans":"J'ai peur du cauchemar.","why":"avoir peur de + du مع المذكر."},{"t":"listen","skill":"listening","q":"سؤال الشعور:","opts":["Comment tu te sens ?","Comment as-tu fait ?","Qu'est-ce que tu sens ?","Où te sens-tu ?"],"a":0,"why":"القالب القياسي للاستفسار عن الشعور."},{"t":"translate","skill":"writing","q":"ترجم: «أخاف من العتمة، وهذا يجعلني متعباً.»","ans":"J'ai peur du noir, ça me rend fatigué.","alts":["j ai peur du noir ca me rend fatigue"],"why":"avoir peur de + rendre + صفة."},{"t":"correct","skill":"writing","q":"صحّح: «Je suis peur des éclairs.»","ans":"J'ai peur des éclairs","alts":["j ai peur des eclairs"],"why":"الخوف مع avoir."},{"t":"writing","skill":"writing","q":"اكتب خمس جمل مشاعر (سعيد/حزين/غاضب/خائف/متعب) مع سبب بـ parce que.","target":"Je suis... parce que...","why":"إنتاج المشاعر مع الأسباب."}],"homework":"شاهد مشهداً كرتونياً قصيراً بالترجمة الفرنسية اليوم، ودوّن ثلاث جمل شعور سمعتها + اكتب خمس جمل مشاعر عن يومك.\nسلسلة A2: a2-t8-l2 ← a2-t8-l3 → a2-t8-l4","sources":[{"title":"تعلم الفرنسية الحقيقية من خلال الأفلام: فيلم Inside Out","channel":"FrenchVerse","videoId":"p4atTiZTRKc","why":"درس عربي مبسّط على فيلم كرتون عن المشاعر — مدخل سهل لمفردات الشعور.","cat":"Films & séries","level":"A2","main":true},{"title":"Learn French with Movies: Despicable Me","channel":"FluentU French","videoId":"xPgQ1MJMMZw","why":"درس FluentU على كرتون آخر — مقارنة أسلوبين في الشرح نفسه.","cat":"Films & séries","level":"A2","extra":true},{"title":"Learn French with Movies: Harry Potter","channel":"FluentU French","videoId":"a9jLaQ8WO9E","why":"درس أطول (23 دقيقة) على سلسلة سينمائية شهيرة — تدرّج في المستوى.","cat":"Films & séries","level":"A2","extra":true}],"supplements":[{"id":"xPgQ1MJMMZw","title":"Learn French with Movies: Despicable Me","channel":"FluentU French","why":"درس FluentU على فيلم كرتون آخر — نفس الطريقة بمحتوى مختلف.","lang":"en","dur":10},{"id":"a9jLaQ8WO9E","title":"Learn French with Movies: Harry Potter","channel":"FluentU French","why":"درس أطول على سلسلة Harry Potter — يناسب من أتقن الدرس الأول ويريد تحدياً.","lang":"en","dur":23}]},{"id":"a2-t8-l4","fr":"Séries — Extra et Les amis à Paris","ar":"الدرس 4: المسلسلات — Extra وأصدقاء باريس","objectives":["تفهم حلقة قصيرة من مسلسل Extra بالترجمة العربية ثم بدونها","تطرح الأسئلة بثلاث طرق فرنسية (intonation, est-ce que, inversion)","تكتب حواراً قصيراً من أربعة أسئلة وأجوبة مكتوبة بشكل صحيح"],"sections":[{"h":"حلقة من مسلسل Extra (مترجمة)","video":{"id":"p3zSSZQonN0","title":"مسلسل Extra فرنسي كوميدي افضل مسلسل لتعلم اللغة الفرنسية مترجم للعربية","channel":"مغربي pro","why":"حلقة كاملة من مسلسل Extra المخصص لتعلّم الفرنسية: إيقاع بطيئ وواضح وترجمة عربية — شاهدها أولًا بالترجمة ثم أعد الجمل بصوت عالٍ.","lang":"ar","main":true,"dur":23},"p":["Extra مسلسل صُمّم أصلاً للمتعلمين: إيقاع أبطاله أبطأ، وكل جملة تُكرر بأشكالها. إنه جسر بين الكتاب والشاشة الحقيقية — الانتقال من النص إلى الصوت لأول مرة.","المسلسل يركز على حوار الشارع اليومي: التعارف، العطش، الهموم، وحكايات الحب — كلها موضوعات تعلمتها في دروسك السابقة، فستلاحظ تكرار المفردات في سياق جديد.","سؤال الأسئلة هو موضوع هذه الحلقة: النبرة الصاعدة تصنع سؤالاً («Tu viens ؟»)، و«est-ce que» تضيفه على الجملة الخبرية، و«Inversion» تُثبّته رسمياً («Venez-vous ؟»). ثلاث طرق لسؤال واحد.","لاحظ أن النبرة وحدها تكفي أحياناً: «Tu parles français» خبر، و«Tu parles français ؟» سؤال — نفس الكلمات، والفرق في الصوت. تدرّب على التسجيل والنبرة قبل القاعدة.","الاستماع والتكرار: شاهد المشهد ثلاث مرات — (1) بالترجمة للفهم، (2) بلا ترجمة للإيقاع، (3) وأنت تكرّر الجملة فور سماعها. المشاهدة الثلاثية هي الطريقة كاملة.","بعد الحلقة: اكتب أربعة أسئلة عن حياتك اليومية بصيغ مختلفة (سؤال نبرة، سؤال est-ce que) ثم أجب عنها بجملة واحدة. هذا يثبت القالب الثلاثي في يدك."],"sub":[{"h":"طرق السؤال الثلاث","p":["Tu viens ? (نبرة)","Est-ce que tu viens ? (قالب)","Viens-tu ? (régulier)","Quand est-ce que tu arrives ?"]},{"h":"مفردات الحوار اليومي","p":["le rendez-vous — الموعد.","le souci — الهمّ.","la surprise — المفاجأة.","la fête — الحفلة."]},{"h":"أدوات الاستماع","p":["Extra ← لا تُنطق «اكسترا» كاملة.","Est-ce que ← [ɛs kə] مدموج.","la série ← الجمع les séries.","l'épisode ← الحلقة."]}]},{"h":"عبارات المسلسلات المتكررة","p":["«Qu'est-ce qui se passe؟» سؤال الوضع العام — يُقال فور أي مفاجأة، ويكفيك فتح أي نقاش درامي.","«Tu as vu ce qu'il a dit؟» سؤال التصوير العفوي: هل رأيت ما قاله؟ وهو مدخل نقاش أي أخبار أو مشاهد.","«C'est incroyable!» ردّ الفعل المبالغ فيه — المبالغة في المسلسلات قاعدة اجتماعية لا خطأ لغوي، وتقليدها يجعل حوارك حيّاً."]},{"h":"التطبيق والتلخيص","p":["تمرين: اختر حلقة Extra قصيرة، اكتب خمس جمل سمعتها، ثم حوّل ثلاثاً منها إلى أسئلة بصيغتين مختلفتين.","مع زميل أو أمام المرآة: اطرح ثلاثة أسئلة بطرق مختلفة (نبرة، est-ce que، inversion) ولاحظ أين ترتفع نبرتك.","ما تحفظه: الثلاثية (نبرة / est-ce que / inversion) + «Qu'est-ce qui se passe؟». بها تدير أي سؤال في أي مسلسل."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: طرق السؤال الثلاث (النبرة / est-ce que / inversion) وقالب سؤال الوضع «Qu'est-ce qui se passe؟». أعد حلقة Extra (الرابط الأساسي في مصادر الدرس) بالترجمة أولاً ثم بلا ترجمة، وحوّل ثلاث جمل سمعتها إلى أسئلة بصيغ مختلفة.","جسر المهارات: من الأفلام الفردية (a2-t8-l1 حتى a2-t8-l3) إلى حوار المسلسلات هنا (a2-t8-l4) — طرق السؤال الثلاث تكمل تدريب Reflets (a2-t7-l1 حتى a2-t7-l15) وتُجهّزك للمحادثة المباشرة مع إسراء في a2-t8-l5.","إعادة المشاهدة والتسجيل: أعد حلقة Extra بالمشاهدة الثلاثية (ترجمة ← بلا ترجمة ← تكرار)، ثم سجّل ثلاثة أسئلة بصيغ مختلفة (نبرة، est-ce que، inversion) وثلاثة أجوبة قصيرة عليها — دقيقة واحدة تكفي."]}],"examples":[{"fr":"Tu viens à la fête ce soir ?","ar":"هل تأتي إلى الحفلة هذا المساء؟","note":"سؤال بالنبرة"},{"fr":"Est-ce que tu parles français ?","ar":"هل تتكلم الفرنسية؟","note":"est-ce que"},{"fr":"Parlez-vous anglais ?","ar":"هل تتكلم الإنجليزية؟","note":"inversion"},{"fr":"Qu'est-ce qui se passe ?","ar":"ماذا يحدث؟","note":"سؤال الوضع"},{"fr":"Tu as vu ce qu'il a dit ?","ar":"هل رأيت ما قاله؟","note":"سؤال عفوي"},{"fr":"C'est incroyable, cette histoire !","ar":"هذه القصة لا تُصدَّق!","note":"مبالغة حوارية"}],"pron":[{"w":"l'épisode","ipa":"[e.pi.zɔd]","approx":"إبيزود"},{"w":"la série","ipa":"[la siʁ]","approx":"لاصير"},{"w":"se passe","ipa":"[sə pas]","approx":"سُباس"}],"vocab":[{"fr":"la série","ar":"المسلسل","pos":"nom","g":"f","exFr":"Je regarde une série.","ipa":"[siʁ]","exAr":"أشاهد مسلسلاً."},{"fr":"l'épisode","ar":"الحلقة","pos":"nom","g":"m","exFr":"Le prochain épisode est long.","ipa":"[e.pi.zɔd]","exAr":"الحلقة القادمة طويلة."},{"fr":"se passer","ar":"يحدث","pos":"verbe","g":"1er","exFr":"Qu'est-ce qui se passe ?","ipa":"[sə pa.se]","exAr":"ماذا يحدث؟"},{"fr":"le souci","ar":"الهمّ","pos":"nom","g":"m","exFr":"Il a un souci.","ipa":"[su.si]","exAr":"لديه همّ."},{"fr":"l'inverse (inversion)","ar":"القلب (في السؤال)","pos":"nom","exFr":"Faites-vous vos devoirs ?","ipa":"[ɛ̃.vɛʁs]","exAr":"هل تفعل واجباتك؟"},{"fr":"la question","ar":"السؤال","pos":"nom","g":"f","exFr":"Pose une question.","ipa":"[kɛs.tjɔ̃]","exAr":"اطرح سؤالاً."},{"fr":"l'intonation","ar":"النبرة","pos":"nom","g":"f","exFr":"L'intonation change le sens.","ipa":"[ɛ̃.tɔ.na.sjɔ̃]","exAr":"النبرة تغيّر المعنى."},{"fr":"incroyable","ar":"لا يُصدَّق","pos":"adj","exFr":"C'est incroyable !","ipa":"[ɛ̃.kʁwa.bl]","exAr":"إنه لا يُصدَّق!"},{"fr":"l'amour / les amis","ar":"الحب/الأصدقاء","pos":"nom","exFr":"Il parle d'amour.","ipa":"[a.muʁ]","exAr":"يتحدث عن الحب."},{"fr":"prochain(e)","ar":"التالي","pos":"adj","exFr":"Le prochain épisode.","ipa":"[pʁɔ.ʃɛ̃]","exAr":"الحلقة التالية."},{"fr":"arriver","ar":"يصل","pos":"verbe","g":"1er","exFr":"Il arrive à huit heures.","ipa":"[a.ʁi.ve]","exAr":"يصل في الثامنة."},{"fr":"la réplique","ar":"سطر الحوار / الردّ","pos":"nom","g":"f","exFr":"Il connaît toutes les répliques.","ipa":"[ʁe.plik]","exAr":"يعرف كل أسطر الحوار."}],"grammar":[{"tFr":"Poser les questions : trois méthodes","tAr":"القاعدة: طرق طرح السؤال الثلاث","body":["الطريقة 1 — النبرة: جملة خبرية + نبرة صاعدة («Tu arrives demain ?»)؛ الطريقة 2 — «est-ce que» تضاف على الجملة دون تغيير («Est-ce que tu arrives ?»)؛ الطريقة 3 — القلب inversion («Arrives-tu ?») الرسمي أكثر، ويلزم علامة الاستفهام دائماً.","مع الاسم المعرّف أو الضمير المتصل يأتي est-ce + le/la... : «Est-ce le train ?»، ومع الضمائر القصيرة est-ce que لا تُستعمل («Parle-t-il ?»). الاختيار بين الطرق يحدّده الرسم لا المعنى."],"ex":[{"fr":"Est-ce que tu as le temps ?","ar":"هل لديك وقت؟"},{"fr":"As-tu le temps ? (régulier)","ar":"هل لديك وقت؟ (رسمي)"}]}],"mistakes":[{"wrong":"السؤال بـ «هل» مترجمة كلمة بكلمة","right":"النبرة أو est-ce que أو inversion","why":"الفرنسية لا تملك أداة استفهام مفردة."},{"wrong":"خلط est-ce que مع الضمائر القصيرة","right":"«Parles-tu» لا «Est-ce que tu parles-tu»","why":"ضمير + فعل لا يحتملان الوسيط معاً."},{"wrong":"سؤال بلا علامة في الكتابة","right":"علامة استفهام إجبارية","why":"العلامة جزء من السؤال الكتابي."},{"wrong":"ردّ «oui» وحده بلا نبرة","right":"«Oui, bien sûr !» بحماس","why":"الرد المجرّد يبدو بارداً في الحوار."}],"dialogues":[{"title":"أسئلة على السرير","ctx":"أصدقاء يسألون بعضهم","lines":[{"who":"Hélène","fr":"Qu'est-ce qui se passe ? Tu as l'air nerveux.","ar":"ماذا يحدث؟ تبدو متوتراً."},{"who":"Nicolas","fr":"Est-ce que tu as vu mon message ?","ar":"هل رأيت رسالتي؟"},{"who":"Hélène","fr":"Non. Tu m'as écrit quoi ?","ar":"لا. بماذا كتبت لي؟"},{"who":"Nicolas","fr":"La fête est annulée. Tu es au courant ?","ar":"الحفلة أُلغيت. هل أنت على اطلاع؟"},{"who":"Hélène","fr":"Vraiment ? C'est incroyable !","ar":"حقاً؟ إنه لا يُصدَّق!"},{"who":"Nicolas","fr":"Bon, qu'est-ce qu'on fait maintenant ?","ar":"حسناً، ماذا نفعل الآن؟"}]}],"exercises":[{"t":"mcq","skill":"grammar","q":"السؤال الرسمى بالقلب (inversion):","opts":["Arrives-tu demain ?","Tu arrives demain ?","Est-ce que tu arrives ?","الطريقتان B وC صحيحتان"],"a":3,"why":"الطريقتان شائعتان؛ inversion هي الأشد رسمية — والإجابة الدقيقة تذكر كلاهما."},{"t":"fill","skill":"writing","q":"أكمل: «___-ce que tu viens ?»","fr":"___-ce que tu viens ?","ans":"Est","alts":["est"],"why":"قالب est-ce que."},{"t":"mcq","skill":"listening","q":"سؤال بالنبرة فقط:","opts":["Tu viens ce soir ?","Est-ce que tu viens ?","Viens-tu ?","Tu viens."],"a":0,"why":"جملة خبرية بعلامة استفهام = نبرة."},{"t":"order","skill":"writing","q":"رتّب سؤالاً بـ est-ce que","words":["Est-ce","que","vous","avez","le","temps","?"],"ans":"Est-ce que vous avez le temps ?","why":"قالب كامل بلا قلب."},{"t":"listen","skill":"listening","q":"عبارة «ماذا يحدث؟»:","opts":["Qu'est-ce qui se passe ?","Qu'est-ce qu'il fait ?","Où est-ce ?","Qui se passe ?"],"a":0,"why":"القالب القياسي لسؤال الوضع."},{"t":"translate","skill":"writing","q":"ترجم: «هل تصل غداً بالقطار؟»","ans":"Est-ce que tu arrives demain en train ?","alts":["est ce que tu arrives demain en train"],"why":"est-ce que + فعل + وقت + وسيلة."},{"t":"correct","skill":"writing","q":"صحّح: «Est-ce que tu viens-tu ?»","ans":"Est-ce que tu viens","alts":["est ce que tu viens"],"why":"لا inversion مع est-ce que."},{"t":"writing","skill":"writing","q":"اكتب أربعة أسئلة عن يوم غدٍ بصيغتين مختلفتين + أجوبة قصيرة.","target":"Est-ce que...? — ...-t-il ?","why":"إنتاج السؤال بالطريقتين."}],"homework":"شاهد حلقة Extra كاملة بالترجمة ثم إعادة بدونها، وسجّل خمس جمل سؤال بصيغ مختلفة بصوت عالٍ.\nسلسلة A2: a2-t8-l3 ← a2-t8-l4 → a2-t8-l5","sources":[{"title":"مسلسل Extra فرنسي كوميدي — مترجم للعربية","channel":"مغربي pro","videoId":"p3zSSZQonN0","why":"حلقة كاملة من Extra مترجمة — نص المسلسل المخصص للمتعلمين.","cat":"Films & séries","level":"A2","main":true},{"title":"مسلسل أصدقاء في باريس — الحلقة الأولى","channel":"دروس فرنساوى أونلاين","videoId":"zFSVoFTIxBI","why":"مسلسل تعليمي عربي آخر لمقارنة الأساليب.","cat":"Films & séries","level":"A2","extra":true},{"title":"Learn French with TV Shows: Friends — How Joey Keeps a Secret","channel":"FluentU French","videoId":"ClbsguGgPOw","why":"درس FluentU على مشهد من مسلسل Friends — شرح مقارن بين مسلسلين.","cat":"Films & séries","level":"A2","extra":true}],"supplements":[{"id":"zFSVoFTIxBI","title":"مسلسل أصدقاء فى باريس — مسلسل تعليمى فرنسى (الحلقة الأولى)","channel":"دروس فرنساوى أونلاين","why":"حلقة تمهيدية قصيرة (8 دقائق) بمزج عربي — بداية سريعة قبل Extra الطويل.","lang":"ar","dur":8},{"id":"ClbsguGgPOw","title":"Learn French with TV Shows: Friends — How Joey Keeps a Secret","channel":"FluentU French","why":"شرح إنجليزي لمشهد من Friends — يقارن بين أسلوب المسلسل الأمريكي والفرنسي.","lang":"en","dur":13}]},{"id":"a2-t8-l5","fr":"Avec Israa — bases de la conversation","ar":"الدرس 5: مع إسراء — أساسيات المحادثة","objectives":["تعتمد «C'est / Ce sont» للتعريف والتمييز بلا خطأ","تحاور قصيراً مع إسراء في فيديو محادثة وتكرّر جملها","تستعمل الضمائر المختصرة (moi, toi, lui...) في تأكيد الأشخاص"],"sections":[{"h":"درس إسراء: أساسيات التحدث","video":{"id":"b4q07icwBbo","title":"تعلم اللغة الفرنسية من الصفر للمبتدئين — تعلم اللغة الفرنسية بسهولة","channel":"فرنسية ببساطة - Israa Elsayed","why":"درس عربي مبسّط من قناة إسراء: شرح النطق والأساسيات بخطوات صغيرة مع أمثلة منطقية — استمع لتكرار نطقها ثم أعد الجمل بنفس النبرة.","lang":"ar","main":true,"dur":18},"p":["إسراء تشرح بالعربية وتتكلم بالفرنسية بالتبادل — هذا المزج يمنحك الوقت لتبني المعنى ثم تسمع النطق. الطريقة المثالية لمراجعة الأساسيات قبل المحادثة.","الدرس يركّز على «C'est...» وهو قالب التعريف الفرنسي: «C'est mon frère», «Ce sont mes amis» — لاحظ الجمع «ce sont» ولا تقل «C'est mes amis» إلا في الكلام السريع الشائع.","الضمائر المختصرة (moi, toi, lui, elle, nous, vous, eux) تأتي للتوكيد أو العزل: «Moi, je pense...», «Lui, il travaille...» — ترتيب واضح يعطي الكلمة وزنها.","المقارنة بين السؤال الصريح والسؤال بالنبرة تظهر مجدداً هنا: تدرّب على تكرار نطق إسراء للسؤال قبل أن تبحث عن قاعده — الصوت أولاً.","الاستماع والتكرار: أوقف الفيديو بعد كل جملة فرنسية وأعدها بحذافيرها معها — لا تقرأ الترجمة العربية، بل انسخ الصوت الفرنسي.","بعد الدرس: اكتب خمس جمل تعريفية عن عائلتك ومحيطك بـ c'est/ce sont، ثم انطقها بنبرة السؤال وبنبرة الخبر مرتين لكل منها."],"sub":[{"h":"C'est / Ce sont","p":["C'est mon voisin.","Ce sont mes collègues.","C'est une bonne idée.","Ce sont des amis d'enfance."]},{"h":"الضمائر المختصرة","p":["Moi, je suis d'accord.","Toi, tu arrives en premier.","Lui, il préfère le thé.","Eux, ils viendront demain."]},{"h":"أدوات الاستماع","p":["C'est ← [sɛ] مدموج.","ce sont ← [sə sɔ̃].","toi ← [twa].","nous ← [nu] مفتوح."]}]},{"h":"عبارات مساعدة من الدرس","p":["«C'est-à-dire؟» بمعنى «أي/ماذا تقصد؟» — عبارة استيضاح تُقال بين الجملتين في كل محادثة فرنسية فهمها واطمأنّ.","«Bien sûr!» و«Pas du tout!» ردود القبول والرفض القاطع — بينهما عشر ردود متوسطة، لكن هذان يكفيان لبداية حوار سريع.","«Comment on dit... en français؟» سؤال الترجمة الفوري: بمجرد أن تعلمت السؤال صرت تطلب المفردات من الواقع لا من الكتاب."]},{"h":"التطبيق والتلخيص","p":["تمرين التكرار: أعد خمس جمل من درس إسراء بصوت عالٍ مع الفيديو، ثم اكتبها من الذاكرة وتحقق من الإملاء.","ابنِ حواراً قصيراً بين شخصين (4 جمل) يستعمل c'est وضميراً مختكلاً (toi/lui) في كل جملة.","ما تحفظه: c'est/ce sont + الضمائر المختصرة + «Comment on dit...؟». بها تدير بداية أي محادثة ومتابعتها."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: قالب التعريف c'est / ce sont والضمائر المختصرة (moi, toi, lui...) مع عبارتي الاستيضاح «C'est-à-dire؟» و«Comment on dit...؟». أعد مشاهدة درس إسراء (الرابط الأساسي في مصادر الدرس) وأعد خمس جمل فرنسية بحذافير مع نطقها.","جسر المهارات: من مسلسل Extra (a2-t8-l4) إلى المحادثة المباشرة مع إسراء (a2-t8-l5) — تعريفك بـ c'est/ce sont يبني على وصفك لأشخاص في A2-t6-l1، وسؤالك يبني على طرق السؤال الثلاث من a2-t8-l4، وستختم السلسلة بخطة اليوم في a2-t8-l6.","إعادة المشاهدة والتسجيل: أوقف الفيديو بعد كل جملة فرنسية وأعدها مع إسراء بحذافيرها، ثم سجّل حواراً من 4 جمل بين شخصين يستعمل c'est أو ce sont وضميراً مختكراً واحداً على الأقل."]}],"examples":[{"fr":"C'est mon professeur de français.","ar":"هذا أستاذ الفرنسية لديّ.","note":"تعريف مفرد"},{"fr":"Ce sont mes voisins.","ar":"هؤلاء جيرتي.","note":"تعريف جمع"},{"fr":"Moi, je préfère le matin.","ar":"أما أنا فأفضّل الصباح.","note":"ضمير توكيد"},{"fr":"Lui, il travaille à Lyon.","ar":"أما هو فيعمل في ليون.","note":"توكيد فاعل"},{"fr":"C'est-à-dire ?","ar":"أي ماذا تقصد؟","note":"استيضاح"},{"fr":"Comment on dit «bread» en français ?","ar":"كيف نقول «bread» بالفرنسية؟","note":"سؤال ترجمة"}],"pron":[{"w":"c'est","ipa":"[sɛ]","approx":"سي"},{"w":"ce sont","ipa":"[sə sɔ̃]","approx":"سُون"},{"w":"toi","ipa":"[twa]","approx":"تْوا"}],"vocab":[{"fr":"c'est / ce sont","ar":"إنه/هم","pos":"expression","exFr":"C'est vrai.","ipa":"[sɛ]","exAr":"إنه صحيح."},{"fr":"moi / toi / lui","ar":"أنا/أنت/هو (توكيد)","pos":"pronom","exFr":"Moi, je reste.","ipa":"[mwa]","exAr":"أما أنا فأبقى."},{"fr":"C'est-à-dire","ar":"أي/بمعنى","pos":"expression","exFr":"C'est-à-dire, tu refuses ?","ipa":"[sɛ.ta.diʁ]","exAr":"أي ترفض؟"},{"fr":"bien sûr","ar":"بالتأكيد","pos":"locution","exFr":"Bien sûr, viens !","ipa":"[bjɛ̃ syʁ]","exAr":"بالتأكيد، تعال!"},{"fr":"pas du tout","ar":"ليس إطلاقاً","pos":"locution","exFr":"Non, pas du tout.","ipa":"[pa dy tu]","exAr":"لا، إطلاقاً."},{"fr":"dire","ar":"يقول","pos":"verbe","g":"3e","exFr":"Comment dit-on cela ?","ipa":"[diʁ]","exAr":"كيف يُقال ذلك؟"},{"fr":"d'accord","ar":"موافق","pos":"locution","exFr":"Je suis d'accord.","ipa":"[da.kɔʁ]","exAr":"أوافق."},{"fr":"l'ami d'enfance","ar":"صديق الطفولة","pos":"nom","exFr":"Un ami d'enfance.","ipa":"[dɑ̃.fɑ̃s]","exAr":"صديق طفولة."},{"fr":"l'expression","ar":"العبارة","pos":"nom","g":"f","exFr":"C'est une expression utile.","ipa":"[ɛks.pʁɛ.sjɔ̃]","exAr":"إنها عبارة مفيدة."},{"fr":"la prononciation","ar":"النطق","pos":"nom","g":"f","exFr":"Sa prononciation est précise.","ipa":"[pʁɔ.nɔn.sja.sjɔ̃]","exAr":"نطقه دقيق."},{"fr":"le compliment","ar":"كلمة إطراء","pos":"nom","g":"m","exFr":"Il fait un compliment sincère.","ipa":"[kɔ̃.pli.mɑ̃]","exAr":"يقدّم كلمة إطراء صادقة."},{"fr":"l'exemple","ar":"المثال","pos":"nom","g":"m","exFr":"Donne un exemple simple.","ipa":"[ɛɡ.zɑ̃pl]","exAr":"أعط مثالاً بسيطاً."}],"grammar":[{"tFr":"C'est / ce sont + les pronoms toniques","tAr":"القاعدة: قالب c'est والضمائر المختصرة","body":["«C'est» للمفرد المعرّف و«ce sont» للجمع في الفصحى: «C'est mon père», «Ce sont mes parents» — وفي الكلام اليومي يشيع «C'est mes parents»، لكن الكتابة تلتزم بالفصحى.","الضمائر المختصرة (toniques): moi/toi/lui/elle/nous/vous/eux — تُستعمل للتوكيد والعزل والجواب المنفصل («Moi ? Je vais bien»). لا تُستعمل كفاعل في المضارع (خطأ: «Moi suis...»)."],"ex":[{"fr":"Toi, tu viens avec nous ?","ar":"وأنت، هل تأتي معنا؟"},{"fr":"Eux, ce sont des professionnels.","ar":"هم، إنهم محترفون."}]}],"mistakes":[{"wrong":"«C'est mes amis» كتابةً","right":"«Ce sont mes amis»","why":"الفصحى تفرد العدد في السؤال والخبر المعرّف."},{"wrong":"«Moi suis d'accord»","right":"«Moi, je suis d'accord»","why":"الضمير المختصر للتأكيد لا ليحل محل الفاعل."},{"wrong":"ترجمة «ماذا تقصد؟» حرفياً","right":"«C'est-à-dire ?»","why":"القالب الجاهز هو الاستعمال الفعلي."},{"wrong":"سكون عند الجمع بعد c'est","right":"تمييز ce sont عند الكتابة","why":"التفصيل الكتابي جزء من الاختبارات."}],"dialogues":[{"title":"محادثة مع زميلة","ctx":"طالبة تراجع مع صديقتها","lines":[{"who":"Amina","fr":"C'est ton premier cours aujourd'hui ?","ar":"هل هذا درسك الأول اليوم؟"},{"who":"Sara","fr":"Oui, ce sont mes premiers pas !","ar":"نعم، إنها خطواتي الأولى!"},{"who":"Amina","fr":"Moi, je suis ici depuis un mois. Tu es d'accord pour réviser ?","ar":"أما أنا فهنا منذ شهر. هل توافقين على المراجعة؟"},{"who":"Sara","fr":"Bien sûr ! Comment on dit «priorité» en français ?","ar":"بالتأكيد! كيف نقول «priorité» بالفرنسية؟"},{"who":"Amina","fr":"«La priorité». C'est clair ?","ar":"«La priorité». هل الأمر واضح؟"},{"who":"Sara","fr":"Très clair. Lui, le professeur, explique bien.","ar":"واضح جداً. أما الأستاذ فهو يشرح جيداً."}]}],"exercises":[{"t":"mcq","skill":"grammar","q":"الصيغة الفصحى للجمع:","opts":["Ce sont mes amis","C'est mes amis","Sont mes amis","Ils est amis"],"a":0,"why":"الفصحى تميّز الجمع بـ ce sont."},{"t":"fill","skill":"writing","q":"أكمل: «___ moi, je viens demain.» (أما أنا)","fr":"___ moi, je viens demain.","ans":"Moi","alts":["moi"],"why":"الضمير المختصر للتوكيد."},{"t":"mcq","skill":"reading","q":"«C'est-à-dire؟» تعني:","opts":["أي ماذا تقصد؟","أين أنت؟","من هو؟","متى الحصة؟"],"a":0,"why":"قالب الاستيضاح."},{"t":"order","skill":"writing","q":"رتّب جملة تعريف جمع (الأساتذة)","words":["Ce","sont","des","professeurs."],"ans":"Ce sont des professeurs.","why":"ce sont + جمع معرّف."},{"t":"listen","skill":"listening","q":"الرد على السؤال بالتأكيد:","opts":["Bien sûr","Pas du tout","Peut-être pas","Ni oui ni non"],"a":0,"why":"قبول صريح."},{"t":"translate","skill":"writing","q":"ترجم: «هؤلاء أصدقائي من الطفولة.»","ans":"Ce sont mes amis d'enfance.","alts":["ce sont mes amis denfance"],"why":"ce sont + جمع + صفة ملكية."},{"t":"correct","skill":"writing","q":"صحّح: «Moi suis professeur.»","ans":"Moi, je suis professeur","alts":["moi je suis professeur"],"why":"الضمير المختصر لا يحل محل الفاعل."},{"t":"speaking","skill":"speaking","q":"اكتب خمس جمل تعريف عن عائلتك بـ c'est/ce sont مع ضمير توكيد واحد.","target":"C'est... / Ce sont... — Moi, / Lui,","why":"إنتاج القالب والضمائر معاً."}],"homework":"أعد درس إسراء مرة بجانبها ومرة بلا مساعدة، ثم اكتب خمس جمل تعريف (c'est/ce sont) عن أفراد أسرتك.\nسلسلة A2: a2-t8-l4 ← a2-t8-l5 → a2-t8-l6","sources":[{"title":"تعلم اللغة الفرنسية بسهولة للمبتدئين","channel":"فرنسية ببساطة - Israa Elsayed","videoId":"b4q07icwBbo","why":"درس إسراء الأساسي: شرح بالعربية مع نطق فرنسي مكرر.","cat":"Films & séries","level":"A2","main":true},{"title":"تعلم اللغه الفرنسيه للمبتدئين — أفضل طريقة لتعلم الحروف (الدرس 18)","channel":"Le français avec Israa","videoId":"INd1S1Eg6rA","why":"درس من قناة إسراء الأخرى — مقارنة بين قناتيها وتنويع الشرح.","cat":"Films & séries","level":"A2","extra":true},{"title":"تعلم اللغه الفرنسيه من الصفر — تعلم الفرنسية بسهولة في 10 دقائق","channel":"فرنسية ببساطة - Israa Elsayed","videoId":"AMDQyMh6kzA","why":"درس قصير مكثّف من إسراء — مراجعة سريعة بين الدروس.","cat":"Films & séries","level":"A2","extra":true}],"supplements":[{"id":"INd1S1Eg6rA","title":"تعلم اللغه الفرنسيه للمبتدئين: احسن طريقه لتعلم الحروف","channel":"Le français avec Israa","why":"درس من قناة إسراء الأخرى (9 دقائق) — ينوّع أسلوب الشرح بين قناتها.","lang":"ar","dur":9},{"id":"AMDQyMh6kzA","title":"تعلم الفرنسية بسهولة في 10 دقائق","channel":"فرنسية ببساطة - Israa Elsayed","why":"درس مكثّف قصير من إسراء — مراجعة سريعة خارج المدة الطويلة.","lang":"ar","dur":12}]},{"id":"a2-t8-l6","fr":"Avec Israa — un plan quotidien sans ennui","ar":"الدرس 6: مع إسراء — خطة يومية بلا ملل","objectives":["تبني خطة يومية بالفرنسية مع أفعال الواجب والحاجة (avoir besoin de / il faut)","تصف عاداتك اليومية في 5 جمل واقعية غير متكررة","تجيب عن سؤال «كيف تطوّر لغتك؟» بالفرنسية في ثلاث جمل"],"sections":[{"h":"درس إسراء: كيف تطوّر لغتك يومياً","video":{"id":"pAsSJ39vTQ4","title":"تعلم اللغة الفرنسية من الصفر — كيف تطور لغتك الفرنسية يومياً بدون ملل","channel":"فرنسية ببساطة - Israa Elsayed","why":"إسراء تعرض خطة يومية ممتعة: قواعد قصيرة، أغانٍ، محادثات — استمع لخطتها ثم ابنِ خطتك أنت بنفس البنية.","lang":"ar","main":true,"dur":20},"p":["الدرس عن الحيلة الأهم في اللغات: الروتين غير الممل. بدل ساعة واحدة أسبوعياً، عشر دقائق كل يوم — والدرس يبني لك الجدول نفسه بالفرنسية.","القاعدة اللغوية هنا: «avoir besoin de + مصدر» للحاجة الشخصية («J'ai besoin de pratiquer») مقابل «il faut + مصدر» للضرورة الموضوعية («Il faut pratiquer chaque jour») — التفرقة نفسها التي تعلمتها ثم تُستعمل هنا في خطة حياتك.","«Chaque matin, je...» قالب العادة: ظرف زمني + فاعل + فعل — خمس جمل بهذا القالب تصف يومك كاملاً. اجعلها متنوعة: قراءة، صوت، بطاقات، محادثة، مراجعة.","مفردات الخطة تأتي من «درس»: la leçon, la révision, l'écoute, la carte (بطاقة), la conversation — استبدلها في قالب واحد فتنتج عشرات الجداول.","الاستماع والتكرار: أعد جمل إسراء الفرنسية فور نطقها — هي الهدف من الفيديو لا الشرح العربي حولها.","بعد الدرس: اكتب خطتك اليومية في 5 جمل (الصباح، الظهر، المساء، نهاية الأسبوع، هدف الأسبوع) ثم انطقها بصوت معلن لنفسك — الالتزام يبدأ بالنطق."],"sub":[{"h":"الحاجة والضرورة","p":["J'ai besoin de pratiquer.","Il faut pratiquer chaque jour.","Tu as besoin de repos.","Il faut un plan simple."]},{"h":"قالب الروتين","p":["Chaque matin, je lis dix minutes.","Le soir, je révise une leçon.","Le week-end, je parle avec un ami.","Une fois par semaine, j'écris."]},{"h":"مفردات الخطة","p":["la leçon — الدرس.","la révision — المراجعة.","l'écoute — الاستماع.","le but — الهدف."]}]},{"h":"عبارات التخطيط اليومي","p":["«Mon objectif du mois est...» تحدّد هدفاً شهرياً — «لأتمكن من...» بـ «pour + مصدر»: «pour mieux parler» — هدف + سبب في جملة واحدة.","«Je m'y mets !» عبارة الانطلاق الحماسية: «أنا أبدأ!». الفعل se mettre à هو الفعل الرسمي لبدء أي مهمة — حفظه يغنيك عن ترجمة «أبدأ».","«Pas de temps, pas d'excuses» شعار قصير يُقال في الخطط — وبالفعل: «Je n'ai pas le temps, mais j'ai dix minutes» — المعنى العملي: الإمكان أولاً."]},{"h":"التطبيق والتلخيص","p":["تمين اليوم: اكتب خطتك اليومية (5 جمل بـ chaque/le soir/le week-end) وسجّلها — أعد التسجيل غداً بعد تغيير جملتين.","أجب شفهياً عن سؤال «Comment tu apprends le français؟» في ثلاث جمل — إجابتك الجديدة هي مبرّر استمرارك.","ما تحفظه: avoir besoin de مقابل il faut + قالب chaque... + «Je m'y mets». بها تحوّل نيّتك إلى جدول قابل للتنفيذ."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: الحاجة الشخصية (avoir besoin de + مصدر) مقابل الضرورة الموضوعية (il faut + مصدر)، وقالب «Chaque...» للخطة اليومية مع عبارة الانطلاق «Je m'y mets!». أعد مشاهدة درس إسراء (الرابط الأساسي في مصادر الدرس) وابنِ خطتك اليومية بنفس بنية خطتها.","جسر المهارات — إنجاز المستوى: من القراءة (a2-t1) إلى القصص (a2-t2) فالقواعد (a2-t3) فالمحادثة (a2-t4) فالاستماع (a2-t5) فالكتابة (a2-t6) فحلقات Reflets الخمس عشرة (a2-t7) فالأفلام والمحادثة (a2-t8 — وأنت في نهايتها هنا). سلسلة A2 كاملة؛ خطتك اليومية هي التي تحفظ تقدّمك، والمستوى B1 يبدأ من هذه الخطة.","إعادة المشاهدة والتسجيل: أعد مشاهدة درس إسراء، وسجّل إجابتك الفرنسية عن «Comment tu apprends le français؟» في ثلاث جمل، ثم سجّل خطة أسبوعك الخمسية بصوت معلن — هذان التسجيلان هما شاهد إتمام المستوى قبل الانتقال إلى B1."]}],"examples":[{"fr":"J'ai besoin de pratiquer tous les jours.","ar":"أحتاج إلى الممارسة كل يوم.","note":"حاجة شخصية"},{"fr":"Il faut réviser une leçon par jour.","ar":"يجب مراجعة درس كل يوم.","note":"ضرورة موضوعية"},{"fr":"Chaque matin, je lis dix minutes.","ar":"كل صباح أقرأ عشر دقائق.","note":"قالب العادة"},{"fr":"Mon objectif du mois est de parler mieux.","ar":"هدف هذا الشهر هو التحدث أفضل.","note":"الهدف"},{"fr":"Je m'y mets dès maintenant.","ar":"أنا أبدأ من الآن.","note":"se mettre à"},{"fr":"Je n'ai pas le temps, mais j'ai dix minutes.","ar":"ليس لديّ وقت، لكن لدي عشر دقائق.","note":"الجدولة الذكية"}],"pron":[{"w":"besoin","ipa":"[bə.zwɛ̃]","approx":"بزوان"},{"w":"révision","ipa":"[ʁe.vi.zjɔ̃]","approx":"ريفيزيون"},{"w":"l'objectif","ipa":"[ɔb.ʒɛk.tif]","approx":"أوبجكتيف"}],"vocab":[{"fr":"la leçon","ar":"الدرس","pos":"nom","g":"f","exFr":"La leçon est courte.","ipa":"[lə.sɔ̃]","exAr":"الدرس قصير."},{"fr":"la révision","ar":"المراجعة","pos":"nom","g":"f","exFr":"J'ai fait la révision.","ipa":"[ʁe.vi.zjɔ̃]","exAr":"أتممت المراجعة."},{"fr":"l'écoute","ar":"الاستماع","pos":"nom","g":"f","exFr":"Vingt minutes d'écoute.","ipa":"[e.kɔt]","exAr":"عشرون دقيقة استماعاً."},{"fr":"l'objectif / le but","ar":"الهدف","pos":"nom","exFr":"L'objectif est clair.","ipa":"[ɔb.ʒɛk.tif]","exAr":"الهدف واضح."},{"fr":"chaque jour","ar":"كل يوم","pos":"locution","exFr":"Je travaille chaque jour.","ipa":"[ʃak ʒuʁ]","exAr":"أعمل كل يوم."},{"fr":"se mettre à","ar":"يبدأ (يبدأ العمل)","pos":"verbe","g":"2e","exFr":"Je m'y mets tout de suite.","ipa":"[sə mɛtʁ a]","exAr":"أبدأ حالاً."},{"fr":"le loisir / la pause","ar":"الهواية/الاستراحة","pos":"nom","exFr":"Une pause de cinq minutes.","ipa":"[pɔz]","exAr":"استراحة خمس دقائق."},{"fr":"maintenant","ar":"الآن","pos":"adv","exFr":"On commence maintenant.","ipa":"[mɛn.tə.nɑ̃]","exAr":"نبدأ الآن."},{"fr":"l'habitude","ar":"العادة","pos":"nom","g":"f","exFr":"C'est une bonne habitude.","ipa":"[a.bi.tyd]","exAr":"إنها عادة جيدة."},{"fr":"progresser","ar":"يتقدم/يتحسّن","pos":"verbe","g":"1er","exFr":"Je progresse chaque semaine.","ipa":"[pʁɔ.ɡʁe.se]","exAr":"أتقدّم كل أسبوع."},{"fr":"ennuyeux(se)","ar":"ممل","pos":"adj","exFr":"Ce plan n'est pas ennuyeux.","ipa":"[ɑ̃.nɥijø]","exAr":"هذا الخطة ليست مملة."},{"fr":"la persévérance","ar":"المثابرة","pos":"nom","g":"f","exFr":"La persévérance paie toujours.","ipa":"[pɛʁ.se.ve.ʁɑ̃s]","exAr":"المثابرة تُجدي دائماً."}],"grammar":[{"tFr":"Avoir besoin de vs il faut","tAr":"القاعدة: الحاجة مقابل الضرورة","body":["«avoir besoin de + مصدر/اسم» حاجة شخصية مع فاعل («J'ai besoin de dormir»)، و«il faut + مصدر» ضرورة موضوعية بلا فاعل محدّد («Il faut dormir») — مع le/la: «Il faut le faire»، ومع جملة فعلية: «Il faut que je dorme» (subjonctif).","«de + le → du»: «J'ai besoin du livre» عند التخصيص، و«de» عند التعميم («besoin de repos»). قاعدة الجزئية نفسها تتكرر هنا — المراجعة المتقاطعة أثبت من الدرس المفرد."],"ex":[{"fr":"J'ai besoin de ce livre maintenant.","ar":"أحتاج هذا الكتاب الآن."},{"fr":"Il faut que je progresse.","ar":"يجب أن أتقدم."}]}],"mistakes":[{"wrong":"«Il faut de pratiquer»","right":"«Il faut pratiquer»","why":"il faut تأخذ المصدر مباشرة بلا de."},{"wrong":"«J'ai besoin pratiquer»","right":"«J'ai besoin de pratiquer»","why":"avoir besoin de لا يُحذف منه حرف الجر."},{"wrong":"خطة بجمل واحدة طويلة","right":"خمس جمل قصيرة متنوعة الأوقات","why":"الجدول المجزّأ أنجح للالتزام."},{"wrong":"الرد على «كيف تتعلم؟» بـ «je study»","right":"جملة فرنسية كاملة بفعل صحيح","why":"الإجابة تُختبر وضوحها لا ترجمتها."}],"dialogues":[{"title":"خطة الأسبوع","ctx":"صديقتان تخططان للغتين","lines":[{"who":"Meryem","fr":"Quel est ton objectif du mois ?","ar":"ما هدفك هذا الشهر؟"},{"who":"Salma","fr":"J'ai besoin de mieux parler. Et toi ?","ar":"أحتاج إلى التحدث أفضل. وأنتِ؟"},{"who":"Meryem","fr":"Il faut que je révise une leçon chaque soir.","ar":"يجب أن أراجع درساً كل مساء."},{"who":"Salma","fr":"Chaque matin, je lis dix minutes. C'est une bonne habitude.","ar":"كل صباح أقرأ عشر دقائق. إنها عادة جيدة."},{"who":"Meryem","fr":"On se met à partir de lundi ?","ar":"نبدأ من الاثنين؟"},{"who":"Salma","fr":"D'accord. Je m'y mets dès maintenant !","ar":"موافق. سأبدأ من الآن!"}]}],"exercises":[{"t":"mcq","skill":"grammar","q":"الصيغة الصحيحة:","opts":["Il faut pratiquer","Il faut de pratiquer","Il faut que pratiquer","Il faut à pratiquer"],"a":0,"why":"il faut + مصدر مباشرة."},{"t":"fill","skill":"writing","q":"أكمل: «J'ai besoin ___ dormir.»","fr":"J'ai besoin ___ dormir.","ans":"de","alts":["De"],"why":"avoir besoin de + مصدر."},{"t":"mcq","skill":"reading","q":"«Chaque matin, je...» تُستعمل لـ:","opts":["وصف العادة اليومية","وصف الماضي البعيد","الأوامر","الاستفهام"],"a":0,"why":"القالب الزمني للعادة."},{"t":"order","skill":"writing","q":"رتّب جملة خطة","words":["Le","soir,","je","révise","une","leçon."],"ans":"Le soir, je révise une leçon.","why":"الظرف ← الفعل ← المفعول."},{"t":"listen","skill":"listening","q":"عبارة الانطلاق:","opts":["Je m'y mets !","Je m'en vais !","Je m'en fous !","Je m'assois !"],"a":0,"why":"se mettre à = يبدأ العمل."},{"t":"translate","skill":"writing","q":"ترجم: «أحتاج إلى التقدّم، ويجب أن أمارس كل يوم.»","ans":"J'ai besoin de progresser, il faut que je pratique chaque jour.","alts":["j ai besoin de progresser il faut que je pratique chaque jour"],"why":"besoin de + il faut que + subjonctif."},{"t":"correct","skill":"writing","q":"صحّح: «Il faut de réviser chaque soir.»","ans":"Il faut réviser chaque soir","alts":["il faut reviser chaque soir"],"why":"il faut بلا de."},{"t":"writing","skill":"writing","q":"اكتب خطتك اليومية في 5 جمل (chaque matin / le soir / le week-end / mon objectif / je m'y mets).","target":"Chaque... Le soir... Mon objectif...","why":"إنتاج خطة كاملة موجّهة."}],"homework":"اكتب خطتك اليومية (5 جمل) وسجّلها اليوم، ثم أعد التسجيل بعد أسبوع بنفس البنية مع مقارنة تقدّمك.\nأكملت سلسلة A2 — التالي: مستوى B1.","sources":[{"title":"كيف تطور لغتك الفرنسية يومياً بدون ملل","channel":"فرنسية ببساطة - Israa Elsayed","videoId":"pAsSJ39vTQ4","why":"إسراء تعرض خطة يومية عملية — بنيان الدرس على خطة، وخطتك أنت هدفه.","cat":"Films & séries","level":"A2","main":true},{"title":"اتحداك ستتكلم الفرنسية بعد هذا الفيديو","channel":"فرنسية ببساطة - Israa Elsayed","videoId":"rIctjf_wd2g","why":"تحدٍّ تحفيزي من إسراء — يناسب اليوم الذي تشعر فيه بالملل.","cat":"Films & séries","level":"A2","extra":true},{"title":"اتعلم الفرنسية بطريقة ممتعة — وستدهش من التقدم","channel":"فرنسية ببساطة - Israa Elsayed","videoId":"QLQs0d6Y5Oo","why":"درس متعة إضافي من إسراء — تنويع الطريقة لتفادي الرتابة.","cat":"Films & séries","level":"A2","extra":true}],"supplements":[{"id":"rIctjf_wd2g","title":"اتحداك ستتكلم الفرنسية بعد هذا الفيديو","channel":"فرنسية ببساطة - Israa Elsayed","why":"فيديو تحفيزي قصير من إسراء — يكسر الجمود اليومي بتحدي ممتع.","lang":"ar","dur":11},{"id":"QLQs0d6Y5Oo","title":"اتعلم الفرنسية بطريقة ممتعة — وستدهش من التقدم","channel":"فرنسية ببساطة - Israa Elsayed","why":"درس متعة إضافي من إسراء — بديل مسائي لطريقة الخطة الرسمية.","lang":"ar","dur":12}]}]}]},{"code":"B1","ar":"المتوسط","fr":"Intermédiaire","desc":"الاستقلال اللغوي في مسارات: القراءة 📖، القصص التعليمية 📚، القواعد ✏️، المحادثة 🗣️، الاستماع 🎧، الكتابة والتعبير ✒️، والفرنسية المهنية 💼 — دروس متكاملة بفيديوهات مدمجة وشرح عربي وتمارين.","color":"#65a30d","order":4,"tracks":[{"id":"b1-t1","slug":"reading","icon":"📖","color":"#059669","fr":"Lecture","ar":"مسار القراءة","desc":"اقرأ كمتوسط مستقل: استراتيجيات القراءة الذكية، الصحافة والمقالات، والنص الحجاجي — كما تطلبها امتحانات DELF B1.","lessons":[{"id":"B1-t1-l1","fr":"Lire efficacement : stratégies B1","ar":"القراءة الفعالة: استراتيجيات المستوى المتوسط","objectives":["استخدام القراءة السريعة (survol) والقراءة المتعمقة (lecture attentive) بشكل مدروس","قراءة الحوارات مع الصوت لربط النص بالنطق","بناء عادة قراءة يومية بمواد حقيقية"],"sections":[{"h":"استراتيجيات القراءة في B1","p":["القراءة في B1 تنتقل من «ترجمة كل كلمة» إلى «إدارة المعنى»: نص أطول، زمن أقل، وسؤال واحد يحكم كل قراءة: ماذا يريد الكاتب أن أفهم؟ من يملك هذا السؤال لا يضيع في التفاصيل، ومن يترجم كلمة كلمة يضيع في النص الطويل قبل أن يصل للفكرة.","الاستراتيجية الأولى: القراءة الانتقائية (lecture sélective) — العنوان، ثم أول جملة من كل فقرة، ثم الجمل الأخيرة. في دقائق تملك خريطة النص كاملة، ثم تعود للتفاصيل المطلوبة فقط. هذا ما يفعله ناجح DELF في نص الفهم القرائي قبل أن يقرأ نص السؤال.","تابع الفيديو الأساسي بالشرح العربي: تقنيات القراءة والنطق معاً — ربط الكلمة بصوتها أثناء القراءة يسرّع الاستيعاب لأن الذاكرة السمعية تعمل بالتزامن مع البصرية. القراءة بصوت خافت (la lecture à voix basse) تُدرب الأذن دون إرهاق المحيطين.","قاعدة عدم الترجمة: عند أربع مفردات مجهولة في فقرة من عشرين كلمة، توقف عن القاموس واستخرج المعنى من الجملة المحيطة. الترجمة الفورية تحول القراءة إلى عمل هندسي بطيء؛ المعنى من السياق ثم التحقق لاحقاً من القاموس مرة واحدة.","خطة القراءة اليومية من B1 إلى B2: 15 دقيقة يومياً بنص واحد متدرّج (مقال قصير ← خبر ← فقرة من رواية) أفضل من ساعة كل أسبوع. التدرّج بالصعوبة يبني ثقتك، والاستمرارية تبني كلماتك — لاحظ أن كلمات B1 تأتي من القراءة لا من قوائم الحفظ.","القراءة المزدوجة (lecture bimodale): أقرأ النص بعيني ثم أستمع لنفسه بقلمي متابعًا — اكتشاف أن نطقك تخميني على أجزاء كثيرة هو أول تصحيح حقيقي. أخطاء النطق المكتومة تظهر فقط عندما يصطدم صوتك بنطق الكاتب الأصلي."],"video":{"id":"rBT-2t3uAqk","title":"(B1) تعلم القراءة باللغة الفرنسية وتحسين مهارة النطق","channel":"École Française","why":"درس عربي مباشر لمهارات القراءة B1: التقاط الفكرة، ربط المفردات بالنطق، وخطة تحسين مستمرة — الاستراتيجيات الثلاث التي يبني عليها الدرس.","lang":"ar","main":true,"dur":11},"sub":[{"h":"من الترجمة إلى إدارة المعنى","p":["سؤال الحكم: ماذا يريد الكاتب؟","القراءة الانتقائية: عناوين وأول الجمل.","الترقيع: معنى من السياق ثم تحقق متأخر.","زمن أقل ← فهم أعمق ← ثقة أعلى."]},{"h":"تقنيات الفهم القرائي","p":["sélective — انتقائية للخريطة العامة.","skimming للعام ثم scanning للتفصيل.","voix basse — قراءة خافتة تربط الصوت بالحرف.","bimodale — عين تقرأ وأذن تتحقق."]},{"h":"الخطة اليومية ← B2","p":["15 دقيقة يومياً > ساعة أسبوعياً.","تدرّج: مقال ← خبر ← فقرة رواية.","كلمات B1 تُبنى بالقراءة لا بالقوائم.","أسبوعان من الاستمرارية يُظهران فرقاً."]}]},{"h":"خطة القراءة اليومية: من B1 إلى B2","p":["أفضل محرك تقدم في B1 هو القراءة اليومية القصيرة: 15-20 دقيقة كافية إذا كانت منتظمة. اختر مواد تثير فضولك فعلاً — أخبار، رياضة، طبخ، تقنية — لأن الاهتمام الحقيقي يعلّم أسرع من أي منهج. القاعدة: 80% من النص يجب أن تفهمه تقريباً؛ إذا كان أعلى فالنص سهل جداً، وإذا كان أقل فهو متقدم عليك بمرحلة.","سجّل كلماتك بطريقة ذكية: لا تدوّن كل كلمة غريبة، بل الكلمات التي تكررت أمامك مرتين أو ثلاثاً في نصوص مختلفة — هذه هي مفردات B1 الحقيقية. راجعها أسبوعياً، وحاول استخدام ثلاث منها في كتابة قصيرة عن يومك.","في امتحان DELF، اقرأ نصوص الأسئلة قبل النص نفسه: المفردات في الأسئلة توجّه أذنك نحو الكلمات المطلوبة أثناء القراءة — technique de la question d'abord، وتختصر نصف زمن الإجابة."],"video":null},{"h":"القراءة المزدوجة: اقرأ كما تنطق","p":["في B1 يجب أن يتقابل عالمك المكتوب مع عالمك المنطوق. تمارس هذا بالقراءة المزدوجة: استمع إلى حوار مع متابعة نصه المكتوب ثم اقرأ بصوت عالٍ معه (قراءة ظلّية) وأخيراً اقرأ وحيداً. ستحس بفارق كبير في الإيقاع: الفرنسية تكتب بلا حروف كثيرة وتنطق بسلاسة متصلة (enchaînement).","لاحظ كيف تُكتب العبارات الحوارية الواقعية: «Attends, je reviens !»، «Pas mal du tout !»، «On y va ?» — هذه ليست جمل من كتاب بل من حياة. اقتبس 3 عبارات يومياً من أي نص مسموع واستخدمها في كلامك في نفس اليوم.","تمرين أسبوعي: اختر مقالاً من 300 كلمة، اقرأه ثلاث مرات (انتقائي ← كامل ← بصوت خافت مع تسجيل)، وسجّل 5 كلمات جديدة في سياقها لا منفردة."],"video":null},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: تعلّمت استراتيجيات القراءة الفعالة في B1 — القراءة الانتقائية لبناء خريطة النص، واستخراج المعنى من السياق بدل القاموس، وخطة 15 دقيقة يومياً حتى B2. أعد مشاهدة الفيديو الرئيسي وركّز على ربط المفردات بصوتها أثناء القراءة المزدوجة (عين تقرأ وأذن تتحقق).","بداية المستوى — لا يسبقه درس؛ تُتقن هنا أولاً إدارة المعنى في النص الطويل (مسح ← سؤال ← قراءة متعمقة للموضع المطلوب) ثم تنتقل إلى B1-t1-l2 حيث تُطبّق القراءة الانتقائية على المقال الصحفي وعناوينه المختصرة.","مهمة تطبيقية: سجّل نفسك دقيقة وأنت تلخّص الدرس وتعيد استخدام 3 كلمات جديدة، ثم قارن نطقك بالفيديو الرئيسي."]}],"examples":[{"fr":"Je lis un article par jour.","ar":"أقرأ مقالاً واحداً كل يوم."},{"fr":"D'abord, je lis le titre. Ensuite, je cherche les détails.","ar":"أولاً أقرأ العنوان، ثم أبحث عن التفاصيل."},{"fr":"Ce mot revient souvent, je vais le noter.","ar":"هذه الكلمة تتكرر كثيراً، سأدوّنها."},{"fr":"Je lis à voix haute pour m'habituer aux sons.","ar":"أقرأ بصوت عالٍ لأعتاد الأصوات."},{"fr":"Je lis d'abord le titre et la première phrase.","ar":"أقرأ أولاً العنوان والجملة الأولى.","note":"انتقائية"},{"fr":"Je ne comprends pas ce mot, mais le contexte m'aide.","ar":"لا أفهم هذه الكلمة لكن السياق يساعدني.","note":"من السياق"},{"fr":"Je lis quinze minutes tous les jours.","ar":"أقرأ خمس عشرة دقيقة كل يوم.","note":"الخطة اليومية"},{"fr":"Après la lecture à voix basse, je vérifie ma prononciation.","ar":"بعد القراءة الخافتة أتحقق من نطقي.","note":"مزدوجة"}],"pron":[{"w":"un survol","ipa":"[sɛʁ.vɔl]","approx":"سير-فول","note":"القراءة السريعة (المسح)"},{"w":"attentif","ipa":"[a.tɑ̃.tif]","approx":"أطان-طيف","note":"lecture attentive = قراءة متعمقة"},{"w":"chaque jour","ipa":"[ʃak ʒuʁ]","approx":"شاك-جور"}],"vocab":[{"fr":"le survol","ar":"القراءة السريعة (المسح)","pos":"nom","g":"m","ipa":"[sɛʁ.vɔl]","exFr":"Un survol suffit pour l'idée générale.","exAr":"المسح يكفي للفكرة العامة."},{"fr":"écrémer","ar":"يمسح (نصاً) سريعاً","pos":"verbe","ipa":"[e.kʁe.me]","exFr":"Écromez le texte avant de le lire en détail.","exAr":"امسح النص قبل قراءته بعمق."},{"fr":"un mot-clé","ar":"كلمة مفتاحية","pos":"nom","g":"m","pl":"des mots-clés","ipa":"[mɔ.kle]","exFr":"Cherchez le mot-clé de la question.","exAr":"ابحث عن كلمة السؤال المفتاحية."},{"fr":"à voix haute","ar":"بصوت عالٍ","pos":"expression","ipa":"[a vwa os]","exFr":"Lisez à voix haute tous les jours.","exAr":"اقرأ بصوت عالٍ كل يوم."},{"fr":"revenir","ar":"يتكرر / يعود","pos":"verbe","ipa":"[ʁə.və.niʁ]","exFr":"Ce mot revient souvent dans la presse.","exAr":"هذه الكلمة تتكرر في الصحافة كثيراً."},{"fr":"une habitude","ar":"عادة","pos":"nom","g":"f","ipa":"[a.bi.tyd]","exFr":"La lecture régulière devient une habitude.","exAr":"القراءة المنتظمة تصبح عادة."},{"fr":"la compréhension écrite","ar":"الفهم القرائي","pos":"nom","exFr":"Un texte de compréhension écrite.","ipa":"[kɔ̃pʁɛsjɔ̃ ɛkʁit]","exAr":"نص فهم قرائي."},{"fr":"le sens global","ar":"المعنى العام","pos":"nom","exFr":"Comprendre le sens global d'abord.","ipa":"[sɑ̃ ɡlɔbal]","exAr":"فهم المعنى العام أولاً."},{"fr":"le contexte","ar":"السياق","pos":"nom","g":"m","exFr":"Devinez par le contexte.","ipa":"[kɔ̃tɛkst]","exAr":"خمّن من السياق."},{"fr":"sélectionner","ar":"يختار/ينتقي","pos":"verbe","g":"1er","exFr":"Les informations à sélectionner.","ipa":"[seleksjɔne]","exAr":"المعلومات المُنتقاة."},{"fr":"skimming / scanner","ar":"قراءة سريعة / مسح بحثي","pos":"nom","exFr":"Scannez les mots-clés.","ipa":"[skimɪŋ]","exAr":"امسحوا الكلمات المفتاحية."},{"fr":"à voix basse","ar":"بصوت خافت","pos":"locution","exFr":"Lire à voix basse.","ipa":"[a vwa bas]","exAr":"قراءة بصوت خافت."},{"fr":"l'orthographe","ar":"الإملاء","pos":"nom","g":"f","exFr":"Lire améliore l'orthographe.","ipa":"[ɔʁtɔɡʁaf]","exAr":"القراءة تحسّن الإملاء."},{"fr":"progresser","ar":"يتقدم","pos":"verbe","g":"1er","exFr":"Je progresse en lisant.","ipa":"[pʁɔɡʁɛse]","exAr":"أتقدم بالقراءة."},{"fr":"un extrait","ar":"مقتطف","pos":"nom","g":"m","exFr":"Un extrait du journal.","ipa":"[ɛkstʁɛ]","exAr":"مقتطف من الجريدة."},{"fr":"relire","ar":"يعيد القراءة","pos":"verbe","g":"irr","exFr":"Relis le texte une deuxième fois.","ipa":"[ʁəliʁ]","exAr":"أعد قراءة النص مرة ثانية."},{"fr":"l'essentiel","ar":"الجوهر","pos":"nom","g":"m","exFr":"Notez l'essentiel.","ipa":"[ɛsɑ̃sjɛl]","exAr":"دوّنوا الجوهر."},{"fr":"le rythme de lecture","ar":"إيقاع القراءة","pos":"nom","exFr":"Augmentez le rythme petit à petit.","ipa":"[ʁitm də lyktyr]","exAr":"زدوا الإيقاع قليلاً قليلاً."}],"grammar":[{"tFr":"Les connectors de repérage dans un texte","tAr":"القاعدة: أدوات الربط في النص","body":["d'abord / ensuite / puis / enfin تبني التسلسل، وcependant / en revanche / au contraire تبني التضاد — الروابط هي علامات الطريق في نص طويل.","مع autrement/ sinon: «Lisez autrement sinon vous vous perdez» — لاحظ أن فهم الروابط يغني عن فهم كل كلمة."],"ex":[{"fr":"D'abord je skanne, ensuite je relis attentivement.","ar":"أمسح أولاً ثم أعيد القراءة بتمعن."},{"fr":"Le texte est long, cependant l'idée centrale est simple.","ar":"النص طويل، لكن الفكرة المركزية بسيطة."}]}],"mistakes":[{"wrong":"فتح القاموس عند كل كلمة مجهولة","right":"معني من السياق ثم تحقق لاحقاً","why":"التوقف المتكرر يقتل الإيقاع وينسيك الفكرة."},{"wrong":"الترجمة الحرفية للجملة كاملة","right":"استخراج الفعل والاسم ثم بناء المعنى","why":"الترجمة الحرفية تُنتج عربياً مقلوباً لا مفهوماً."},{"wrong":"قراءة كل الكلمات بنفس الوزن","right":"انتقائية ثم تفصيلية","why":"النص الطويل يستدعي إدارة وقت لا مساواة حروف."},{"wrong":"القراءة بلا هدف","right":"سؤال واحد قبل البدء","why":"القراءة بلا سؤال تُنسى خلال ساعة."}],"dialogues":[{"title":"نقاش عن طريقة القراءة","ctx":"زميلان يستعدان لـ DELF","lines":[{"who":"Yara","fr":"Tu lis le texte en entier avant les questions ?","ar":"هل تقرأ النص كاملاً قبل الأسئلة؟"},{"who":"Sami","fr":"Non, je lis les questions d'abord, ça me guide.","ar":"لا، أقرأ الأسئلة أولاً، ذلك يوجّهني."},{"who":"Yara","fr":"Et les mots inconnus ?","ar":"والكلمات المجهولة؟"},{"who":"Sami","fr":"Je les saute et je devine par le contexte.","ar":"أتخطاها وأخمّن من السياق."},{"who":"Yara","fr":"Moi je traduis tout, et je perds le sens global.","ar":"أنا أترجم كل شيء وأفقد المعنى العام."},{"who":"Sami","fr":"Essaie la lecture sélective une semaine !","ar":"جرّب القراءة النتقائية أسبوعاً!"}]}],"exercises":[{"t":"mcq","skill":"reading","q":"عند نص طويل في امتحان، ماذا تفعل أولاً؟","opts":["أقرأ كل كلمة ببطء","أقرأ العنوان وأمسح النص للفكرة العامة","أبدأ بكتابة الترجمة","أتجاوز النص مباشرة"],"a":1,"why":"المسح أولاً للفكرة العامة ثم القراءة المتعمقة للمواضع المطلوبة فقط."},{"t":"mcq","skill":"reading","q":"ما الاستفادة من كلمات الربط (d'abord, donc, cependant) أثناء القراءة؟","opts":["تزيّن النص فقط","تدلك على منطق النص وترتيبه","تعوض المفردات الناقصة","لا فائدة لغوية منها"],"a":1,"why":"كلمات الربط علامات الطريق: تسلسل، سبب، تناقض، نتيجة."},{"t":"fill","skill":"vocabulary","q":"أكمل: «___, je lis le titre, ensuite je cherche les détails.» (أولاً)","fr":"___, je lis le titre, ensuite je cherche les détails.","ans":"D'abord","alts":["d'abord"],"why":"d'abord تفتح التسلسل وensuite تكمله."},{"t":"order","skill":"reading","q":"رتّب خطوات قراءة ذكية: (1) أقرأ بعمق الموضع المحتمل للإجابة (2) أقرأ السؤال وأحدد الكلمة المفتاحية (3) أمسح النص للفكرة العامة","words":["D'abord","je","survole","le","texte."],"ans":"D'abord je survole le texte.","why":"التسلسل الصحيح: مسح → سؤال → قراءة عميقة للموضع."},{"t":"listen","skill":"listening","q":"استمع واختر معنى الجملة:","audio":"Ce mot revient souvent, je vais le noter","opts":["سأتجاهل الكلمة","الكلمة تتكرر وسأدوّنها","الكلمة صعبة النطق","سأستبدل الكلمة بأخرى"],"a":1,"why":"revenir souvent = تتكرر كثيراً، et le noter = سأدوّنها."},{"t":"writing","skill":"writing","q":"اكتب خطة قراءتك لهذا الأسبوع بالفرنسية: ماذا ستقرأ، متى، وكم دقيقة يومياً؟","min":15,"kw":["lire","jour","minutes"],"sample":"Cette semaine, je lis un article de sport chaque jour après le dîner. Je lis quinze minutes et je note trois mots nouveaux. Le dimanche, je relis mes mots.","why":"كتابة خطة قراءة قابلة للتنفيذ تُحوّل نصيحة «15 دقيقة يومياً» إلى التزام أسبوعي مكتوب — المهمة الكتابية هي حيث تبدأ العادة الحقيقية للقارئ B1."},{"t":"mcq","skill":"reading","q":"أفضل استراتيجية لقراءة نص B1 طويل قبل التحليل:","opts":["قراءة تعمّم أولى للهضم العام","فتح القاموس مع أول كلمة","ترجمة كل سطر قبل التالي","حفظ النص قبلاً"],"a":0,"why":"التعمّم يبني الإطار ثم تأتي التفاصيل."},{"t":"fill","skill":"reading","q":"أكمل: «Je ___ d'abord le texte sans dictionnaire.» (أقرأ)","fr":"Je ___ d'abord le texte sans dictionnaire.","ans":"lis","alts":["Lis"],"why":"le présent من lire مع je = lis."}],"homework":"اختر موضوعاً تحبه واقرأ نصاً واحداً يومياً (15 دقيقة). دوّن الكلمات المتكررة فقط وراجعها نهاية الأسبوع.","sources":[{"title":"(B1) تعلم القراءة باللغة الفرنسية وتحسين مهارة النطق","channel":"École Française","videoId":"rBT-2t3uAqk","why":"درس عربي مباشر لمهارات القراءة B1: التقاط الفكرة، ربط المفردات بالنطق، وخطة تحسين مستمرة — الاستراتيجيات الثلاث التي يبني عليها الدرس.","cat":"Reading","level":"B1","main":true,"dur":11},{"title":"[DELF B1] - préparer la compréhension écrite","channel":"Le French Club","videoId":"JeJg64ZKEGI","why":"شرح منهجي لقسم الفهم القرائي في DELF B1 بأنواع أسئلته واستراتيجيات حله — يضعك مباشرة داخل شكل الامتحان الذي تستعد له.","cat":"Reading","level":"B1","extra":true},{"title":"PASSE DU B1 AU B2 en français ! Mes 14 conseils, techniques et recommandations","channel":"French School TV","videoId":"kjQ--FUN4Qg","why":"خطة تقدم واقعية من B1 إلى B2 بـ14 نصيحة عملية منها القراءة اليومية — تضع القراءة في سياق تطورك اللغوي الكامل.","cat":"Reading","level":"B1","extra":true},{"title":"DIALOGUES EN FRANÇAIS Niveau B1 - [30 min.] (avec PDF!)","channel":"Français avec Pierre","videoId":"kIdMfBkl3_o","why":"30 دقيقة من حوارات B1 مع نص مرفق — التمرين الأفضل: اقرأ بصوت عالٍ مع المتحدث ثم أعد القراءة وحيداً لترسيخ الإيقاع والربط بين الكتابة والنطق.","cat":"Reading","level":"B1","extra":true}],"supplements":[{"id":"JeJg64ZKEGI","title":"[DELF B1] - préparer la compréhension écrite","channel":"Le French Club","why":"شرح منهجي لقسم الفهم القرائي في DELF B1 بأنواع أسئلته واستراتيجيات حله — يضعك مباشرة داخل شكل الامتحان الذي تستعد له.","lang":"fr"},{"id":"kjQ--FUN4Qg","title":"PASSE DU B1 AU B2 en français ! Mes 14 conseils, techniques et recommandations","channel":"French School TV","why":"خطة تقدم واقعية من B1 إلى B2 بـ14 نصيحة عملية منها القراءة اليومية — تضع القراءة في سياق تطورك اللغوي الكامل.","lang":"fr"},{"id":"kIdMfBkl3_o","title":"DIALOGUES EN FRANÇAIS Niveau B1 - [30 min.] (avec PDF!)","channel":"Français avec Pierre","why":"30 دقيقة من حوارات B1 مع نص مرفق — التمرين الأفضل: اقرأ بصوت عالٍ مع المتحدث ثم أعد القراءة وحيداً لترسيخ الإيقاع والربط بين الكتابة والنطق.","lang":"fr"}]},{"id":"B1-t1-l2","fr":"Lire la presse et les articles","ar":"قراءة الصحافة والمقالات","objectives":["فهم بنية المقال الصحفي: العنوان، السقّطة (chapeau)، الفقرة الافتتاحية","فك شيفرة العناوين المختصرة (الاسمية)","قراءة مقال حقيقي واستخراج معلوماته الأساسية"],"sections":[{"h":"بنية المقال الصحفي","p":["المقال الصحفي الفرنسي بنية هندسية ثابتة تبدأ من الأعلى: la Une (الصفحة الأولى/العنوان الرئيس)، ثم le titre (عنوان جذّب)، ثم le chapeau (جملة مظللة تلخّص الخبر في سطرين)، ثم المتن (le développement). من فك هذه الطبقات فكّ نصف المقال قبل أن يبدأ.","الchapeau هو أنفع جملة في المقال: 30 كلمة تحمل من؟ ماذا؟ متى؟ أين؟ لماذا؟ — اقرأه وحدّد الأركان الخمسة على ورقة، ثم تابع لتفاصيل فقط ما نقصك. القارئ المحترف يقرأ العنوان ثم chapeau ثم يقرر إن استحق بقية المقال.","تابع الفيديو الأساسي بالشرح العربي: مكوّنات النص الصحفي وأنواعه — article, brève, reportage, fait divers — تُميّز كل نوع بطوله ولغته وبنية عنوانه. معرفة النوع تنبئك بالمفردات القادمة: لغة faits divers قصيرة وحادة، ولغة reportage وصفية طويلة.","التحويل الاسمي (la nominalisation) لغة العناوين: «Le gouvernement augmente les impôts» يصبح في العنوان «Hausse des impôts» — الفعل يختفي والحدث يبقى اسماً. هذا الاختصار يجعل العنوان مضغوطاً ومقروءاً في ثانية، وهو أصعب ما يقابل الناطق بالعربية في فكّ العناوين.","من القراءة إلى الكتابة: انسخ هيكل المقال بقلمك — عنوان (10 كلمات)، chapeau (سطران)، ثم فقرتان: واحدة للوقائع وواحدة لردود الفعل مع cité (اقتباس) محكوم بـ «selon» أو «a déclaré». أربع لبنات تكفي لأي خبر قصير تكتبه في B1.","أخطاء فكّ العناوين الشائعة: تجاهل la négation في العنوان («Pas de hausse...»)، وتجاهل les chiffres (الأرقام في العناوين هي الخبر نفسه)، وترجمة العنوان حرفيًا. العنوان الفرنسي يُقرأ كجملة كاملة في رأسك — لا كقائمة كلمات."],"video":{"id":"nmxdn2KeQYI","title":"انواع المقالات الصحفية مكونات النص الصحفي","channel":"Français avec karim","why":"مكونات النص الصحفي وأنواعه بالعربية — يشرح chapeau وtitres وما يحمله كل قسم، وهو بالضبط ما يحتاجه قارئ المقال الصحفي.","lang":"ar","main":true,"dur":6},"sub":[{"h":"الطبقات من الأعلى للأسفل","p":["la Une / le titre — الجذب.","le chapeau — الخبر في سطرين.","le développement — التفاصيل.","القاعدة: العنوان ← chapeau ← قرار القراءة."]},{"h":"أنواع المقال وأسماؤها","p":["l'article — المقال الكامل.","la brève — الخبر القصير.","le reportage — التقرير الميداني.","le fait divers — الحادثة."]},{"h":"التحويل الاسمي: لغة العناوين","p":["augmenter les impôts → Hausse des impôts.","Fermer l'usine → Fermeture de l'usine.","الفعل يختفي والحدث يبقى اسماً.","ركز على الاسم ثم ابحث عن فاعله."]}]},{"h":"فك شيفرة العناوين: التحويل الاسمي","p":["لماذا العناوين غامضة؟ لأنها تحذف الأفعال وتستخدم الأسماء: «Hausse des prix» = «Les prix ont augmenté»؛ «Découverte d'un trésor» = «On a découvert un trésor». هذا هو التحويل الاسمي (nominalisation): الجملة تتحول إلى اسم+متمم بالري de. احفظ المعادلة: اسم من فعل + متمم بـde = خبر كامل.","انتبه أيضاً لحذف الماضي المركّب والفاعل: العناوين تستخدم المضارع دائماً تقريباً — «Un tremblement de terre frappe la Turquie» يعني أنه وقع أمس! القراءة الصحفية السريعة = الترجمة الذهنية من لغة العناوين إلى اللغة العادية.","الاقتباس في المقال: «a déclaré», «a affirmé», «a expliqué» تدل كلها على التصريح مع فروق نبرة (declared = أعلن، affirmed = أكّد، explained = فسّر). اختر الفعل بحسب قوة الكلام لا بالعشوائية."],"video":null},{"h":"من القراءة إلى الكتابة: صياغة خبر","p":["أفضل اختبار لفهمك لمقال هو كتابة خبر مشابه. في DELF B1 قد يُطلب منك كتابة مقال قصير (80-100 كلمة) عن حدث مدرسي أو محلي. البنية نفسها: عنوان اسمي (Concours de talent samedi à Lyon)، سقّطة تجيب عن الخمسة أسئلة، جسم من فقرتين تفصّلان، وخاتمة تتطلع للمستقبل.","التمرين الذكي: خذ خبراً قرأته اليوم وأعد صياغته بكلماتك في 4 جمل — من، ماذا، متى/أين، والنتيجة. هذا التمرين يطوّر القراءة والكتابة والقواعد في آن واحد.","تمرين التحرير: خذ حدثاً من يومك واكتبه هندسياً: عنوان 10 كلمات ← chapeau سطرين ← فقرة وقائع ← فقرة ردود فعل. الخمس عشرة دقيقة تُدرّبك على التفكير الصحفي لا على الكتابة فقط."],"video":null},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: تعلّمت بنية المقال الصحفي من la Une إلى le chapeau ثم المتن، وفكّ شيفرة العناوين بالتحويل الاسمي، وكتابة خبر من أربع لبنات. أعد مشاهدة الفيديو الرئيسي وركّز على كيفية تحوّل الجملة الكاملة إلى عنوان اسمي مضغوط يُقرأ في ثانية.","جسر الدروس: من B1-t1-l1 (القراءة الفعالة: استراتيجيات المستوى المتوسط) إلى B1-t1-l2 (قراءة الصحافة والمقالات)، ثم إلى B1-t1-l3 حيث تنتقل من خبر الوقائع إلى النص الحجاجي وتحليل موقف الكاتب.","مهمة تطبيقية: سجّل نفسك دقيقة وأنت تلخّص الدرس وتعيد استخدام 3 كلمات جديدة، ثم قارن نطقك بالفيديو الرئيسي."]}],"examples":[{"fr":"Hausse des prix de l'immobilier","ar":"ارتفاع أسعار العقار (= أسعار العقار ارتفعت)."},{"fr":"Selon le journal, l'événement a rassemblé des milliers de personnes.","ar":"حسب الجريدة، جمع الحدث آلاف الأشخاص."},{"fr":"Le chapeau résume l'essentiel de l'article.","ar":"السقّطة تلخّص جوهر المقال."},{"fr":"Je lis la presse en ligne chaque matin.","ar":"أقرأ الصحافة الإلكترونية كل صباح."},{"fr":"Le chapeau résume l'info en deux lignes.","ar":"جملة الترويسة تلخص الخبر في سطرين.","note":"الطبقات"},{"fr":"«Fermeture de l'usine» : le verbe devient un nom.","ar":"«إغلاق المصنع» — الفعل يصبح اسماً.","note":"nominalisation"},{"fr":"Selon le ministre, la situation s'améliore.","ar":"حسب الوزير، الوضع يتحسن.","note":"المصدر"},{"fr":"La brève fait vingt mots, l'article deux pages.","ar":"الخبر القصير عشرون كلمة والمقال صفحتان.","note":"الأنواع"}],"pron":[{"w":"un chapeau","ipa":"[ʃa.po]","approx":"شابو","note":"في الصحافة: السقّطة الافتتاحية"},{"w":"la hausse","ipa":"[la os]","approx":"لا-أوس","note":"الارتفاع (عكس: la baisse)"},{"w":"une enquête","ipa":"[ɑ̃.kɛt]","approx":"آن-كيت"}],"vocab":[{"fr":"les actualités","ar":"الأخبار","pos":"nom","g":"f","ipa":"[le.zak.tɥi.de]","exFr":"Je suis les actualités sur mon téléphone.","exAr":"أتابع الأخبار على هاتفي."},{"fr":"un article","ar":"مقال","pos":"nom","g":"m","ipa":"[aʁ.tikl]","exFr":"Cet article m'a beaucoup intéressé.","exAr":"هذا المقال أثار اهتمامي كثيراً."},{"fr":"la hausse","ar":"الارتفاع","pos":"nom","g":"f","ipa":"[la.os]","exFr":"La hausse des prix continue.","exAr":"ارتفاع الأسعار مستمر."},{"fr":"la baisse","ar":"الانخفاض","pos":"nom","g":"f","ipa":"[la.bɛs]","exFr":"On observe une baisse du chômage.","exAr":"نلاحظ انخفاض البطالة."},{"fr":"selon","ar":"حسب / وفقاً لـ","pos":"préposition","ipa":"[sə.lɔ̃]","exFr":"Selon les experts, la situation va s'améliorer.","exAr":"حسب الخبراء، الوضع سيتحسن."},{"fr":"rassembler","ar":"يجمع (أشخاصاً)","pos":"verbe","ipa":"[ʁa.sɑ̃.ble]","exFr":"L'événement a rassemblé des milliers de personnes.","exAr":"جمع الحدث آلاف الأشخاص."},{"fr":"le chapeau","ar":"جملة الترويسة/اللخصة","pos":"nom","g":"m","exFr":"Lire le chapeau d'abord.","ipa":"[ʃapo]","exAr":"اقرأ جملة اللخصة أولاً."},{"fr":"la une","ar":"الصفحة الأولى/الحدث الأبرز","pos":"nom","g":"f","exFr":"À la une du journal.","ipa":"[yn]","exAr":"في صفحة الجريدة الأولى."},{"fr":"une brève","ar":"خبر قصير","pos":"nom","g":"f","exFr":"Une brève sur l'actualité.","ipa":"[bʁɛv]","exAr":"خبر قصير عن الأحداث."},{"fr":"faits divers","ar":"حوادث/غامض","pos":"nom","exFr":"Les faits divers de la semaine.","ipa":"[fɛ divɛʁ]","exAr":"حوادث الأسبوع."},{"fr":"nominaliser","ar":"يحوّل إلى اسم","pos":"verbe","g":"1er","exFr":"Nominaliser le verbe «augmenter».","ipa":"[nɔminalize]","exAr":"تحويل فعل increase إلى اسم."},{"fr":"hausse / baisse","ar":"ارتفاع / انخفاض","pos":"nom","g":"f","exFr":"Hausse des prix.","ipa":"[os]","exAr":"ارتفاع الأسعار."},{"fr":"déclarer / affirmer","ar":"يعلن / يؤكد","pos":"verbe","exFr":"Le ministre a affirmé...","ipa":"[dekleʁe]","exAr":"أكد الوزير..."},{"fr":"la source","ar":"المصدر","pos":"nom","g":"f","exFr":"Selon une source proche.","ipa":"[sɔʁs]","exAr":"حسب مصدر قريب."},{"fr":"signer un article","ar":"يوقّع مقالاً","pos":"locution","exFr":"L'article est signé du journaliste.","ipa":"[siɲe]","exAr":"المقال موقّع من الصحفي."},{"fr":"l'enquête","ar":"التحقيق","pos":"nom","g":"f","exFr":"Une enquête de terrain.","ipa":"[ɑ̃kɛt]","exAr":"تحقيق ميداني."},{"fr":"le développement","ar":"العرض/التفصيل","pos":"nom","g":"m","exFr":"Le développement de l'article.","ipa":"[dɛvəlɔpmɑ̃]","exAr":"تفصيل المقال."},{"fr":"un titre accrocheur","ar":"عنوان جذّاب","pos":"nom","exFr":"Le titre est accrocheur.","ipa":"[titʁ akʁɔʃœʁ]","exAr":"العنوان جذّاب."}],"grammar":[{"tFr":"La nominalisation","tAr":"القاعدة: التحويل الاسمي","body":["الفعل/الصففة → اسم باللواحق: -tion, -age, -ment, -ure, -ée: augmenter → hausse/ augmentation، fermer → fermeture.","في العناوين يُحذف الفاعل ويُذكر الحدث اسماً — ابحث في جسم المقال عن الفاعل المخفي."],"ex":[{"fr":"Le nombre de chômeurs augmente → Hausse du chômage.","ar":"عدد البطالين يرتفع ← ارتفاع البطالة."},{"fr":"Ils ont décidé de partir → Le départ a été décidé.","ar":"قرروا المغادرة ← تقرر المغادرة."}]}],"mistakes":[{"wrong":"قراءة العنوان حرفياً","right":"قراءة العنوان كجملة اسمية كاملة","why":"العناوين مكثفة بأسماء — الحرفية تُنتج جدلاً."},{"wrong":"إهمال chapeau","right":"chapeau أولاً ثم القرار","why":"جملة واحدة توفر قراءة صفحة كاملة لا تهمك."},{"wrong":"الخلط بين brève وreportage","right":"تحديد النوع بالطول والبنية","why":"كل نوع يكشف مستوى التفصيل المنتظر."},{"wrong":"البحث عن الفاعل في العنوان","right":"تأجيل الفاعل إلى جسم المقال","why":"الفاعل غالباً محذوف في Nominalisation — لا تضيع وقتك."}],"dialogues":[{"title":"تحليل خبر صباحي","ctx":"زميلان يقرأان نفس المقال","lines":[{"who":"Nour","fr":"Lu le chapeau ? C'est une baisse des prix.","ar":"هل قرأت جملة الترويسة؟ إنها انخفاض في الأسعار."},{"who":"Karim","fr":"Moi je n'ai vu que le titre « Hausse... ».","ar":"أنا لم أرى إلا العنوان «ارتفاع...»."},{"who":"Nour","fr":"Attention, le titre parle de l'année passée !","ar":"انتبه، العنوان يتحدث عن السنة الماضية!"},{"who":"Karim","fr":"D'accord, je lis le corps maintenant.","ar":"حسناً، سأقرأ المتن الآن."},{"who":"Nour","fr":"Regarde aussi qui déclare : le ministère.","ar":"انظر أيضاً من يعلن: الوزارة."},{"who":"Karim","fr":"C'est plus clair comme ça. Merci !","ar":"أوضح هكذا. شكراً!"}]}],"exercises":[{"t":"mcq","skill":"reading","q":"«Grève des transports vendredi» — ما الخبر كاملاً؟","opts":["النقل سيكون مجانياً الجمعة","إضراب في النقل يوم الجمعة","جمعة النقل مسلّية","الجمعية تنتقل الجمعة"],"a":1,"why":"grève = إضراب، des transports = في قطاع النقل — عنوان اسمي يلخّص جملة كاملة."},{"t":"mcq","skill":"reading","q":"أين تجد المعلومة الأهم في المقال الفرنسي دون قراءة كل شيء؟","opts":["في الخاتمة فقط","في العنوان والسقّطة","في التوقيع","في الإعلانات"],"a":1,"why":"البنية التنازلية: العنوان يلخّص، والسقّطة تجيب عن الأسئلة الخمسة."},{"t":"fill","skill":"reading","q":"أكمل بعلامة الإسناد الصحفية: «___ les experts, la situation va s'améliorer.» (حسب)","fr":"___ les experts, la situation va s'améliorer.","ans":"Selon","alts":["selon"],"why":"selon تفيد الإسناد للمصدر في الصحافة."},{"t":"order","skill":"writing","q":"رتّب عناصر المقال: (1) الجسم التفصيلي (2) العنوان (3) السقّطة","words":["Le","titre","résume","l'article."],"ans":"Le titre résume l'article.","why":"التسلسل الصحفي: عنوان → سقّطة → جسم."},{"t":"listen","skill":"listening","q":"استمع للخبر واختر ما فهمت:","audio":"Selon la police, l'accident a fait trois blessés","opts":["الحادث خلف ثلاثة قتلى","الحادث خلف ثلاثة جرحى","الشرطة دفع ثمن الحادث","الحادث وقع الساعة الثالثة"],"a":1,"why":"des blessés = جرحى (وليس قتلى = des morts)."},{"t":"writing","skill":"writing","q":"اكتب خبراً قصيراً (4 جمل) عن حدث حقيقي في مدينتك: عنوان + من/ماذا/متى/أين + النتيجة.","min":20,"kw":["selon","a","hier"],"sample":"Festival du café samedi à Alger. Selon les organisateurs, l'événement a rassemblé plus de cinq mille visiteurs. Des producteurs de tout le pays ont présenté leurs cafés. La prochaine édition aura lieu en mai.","why":"صياغة خبر من أربع لبنات تختبر فهمك لبنية المقال من الداخل — تكتب ما تقرؤه، فتتحوّل nominalisation وselon من معرفة سلبية إلى أدوات إنتاج تُطلب في DELF B1."},{"t":"mcq","skill":"reading","q":"بنية المقال الصحفي تبدأ بـ:","opts":["العنوان ثم جملة الافتتاح ثم التفاصيل","المقدمة النظرية","خاتمة الكاتب","قائمة المصادر"],"a":0,"why":"la une ثم l'accroche ثم التفاصيل تصاعدياً."},{"t":"translate","skill":"writing","q":"ترجم: «حسب الصحيفة، الظاهرة تتوسع.»","ans":"Selon le journal, le phénomène s'étend.","alts":["selon le journal, le phenomene s'etend","Selon le journal le phenomene s etend"],"why":"selon = حسب، قالب المصادر الإخباري."}],"homework":"اقرأ عنوانين وسقّطتين من موقع أخبار فرنسي يومياً، وأعد صياغة خبر واحد بكلماتك في 4 جمل.","sources":[{"title":"انواع المقالات الصحفية مكونات النص الصحفي","channel":"Français avec karim","videoId":"nmxdn2KeQYI","why":"مكونات النص الصحفي وأنواعه بالعربية — يشرح chapeau وtitres وما يحمله كل قسم، وهو بالضبط ما يحتاجه قارئ المقال الصحفي.","cat":"Reading","level":"B1","main":true,"dur":6},{"title":"Découvrir la presse : comprendre un article de journal ? partie 3","channel":"Jean-Luc DESCHEYER","videoId":"oFiZ6ZmEuq8","why":"تحليل عملي لبنية المقال الصحفي الجزء بالجزء — من العنوان إلى الخاتمة — بأسلوب تعليمي مبسط.","cat":"Reading","level":"B1","extra":true},{"title":"Nominalisation en français (B2) : comprendre et analyser les titres de presse","channel":"Parler français avec Marianne","videoId":"SPWuiCC7FWE","why":"سر العناوين الصحفية: التحويل الاسمي الذي يلخّص الجملة كاملة في كلمتين — مهارة فك الشيفرة التي تجعل العناوين مفهومة فوراً.","cat":"Reading","level":"B1","extra":true},{"title":"Production écrite DELF B1 | L'article de journal 📰","channel":"Le French Club","videoId":"itSkW9T2ZoM","why":"بما أن فهم المقال يكتمل بكتابته: درس صياغة مقال صحفي في DELF B1 — يعريك من الداخل بكل عنصر تقرؤه في الصحف.","cat":"Reading","level":"B1","extra":true}],"supplements":[{"id":"oFiZ6ZmEuq8","title":"Découvrir la presse : comprendre un article de journal ? partie 3","channel":"Jean-Luc DESCHEYER","why":"تحليل عملي لبنية المقال الصحفي الجزء بالجزء — من العنوان إلى الخاتمة — بأسلوب تعليمي مبسط.","lang":"fr"},{"id":"SPWuiCC7FWE","title":"Nominalisation en français (B2) : comprendre et analyser les titres de presse","channel":"Parler français avec Marianne","why":"سر العناوين الصحفية: التحويل الاسمي الذي يلخّص الجملة كاملة في كلمتين — مهارة فك الشيفرة التي تجعل العناوين مفهومة فوراً.","lang":"fr"},{"id":"itSkW9T2ZoM","title":"Production écrite DELF B1 | L'article de journal 📰","channel":"Le French Club","why":"بما أن فهم المقال يكتمل بكتابته: درس صياغة مقال صحفي في DELF B1 — يعريك من الداخل بكل عنصر تقرؤه في الصحف.","lang":"fr"}]},{"id":"B1-t1-l3","fr":"Comprendre un texte argumentatif","ar":"فهم النص الحجاجي","objectives":["تمييز الأطروحة (thèse) من الحجج (arguments) والأمثلة","تعقب الروابط المنطقية لفهم موقف الكاتب","تحديد موقف الكاتب: موافق، معارض، أم متوازن؟"],"sections":[{"h":"هيكل النص الحجاجي","p":["النص الحجاجي (le texte argumentatif) ليس رأياً مطلقاً بل رأياً مُعلَّلاً ومُدافع: thèse (أطروحة) ← arguments (حجج) ← exemples (شواهد) ← contre-argument (اعتراض يُجاب عنه) ← conclusion. هذا المسار هو الخريطة التي تبحث عنها في كل فقرة حجاجية.","تمييز الحجة عن الرأي: الرأي «Je trouve que c'est bien» بلا سند، والحجة «C'est bien parce que...» مسنودة. في الامتحان تُسأل «Quel est l'argument de l'auteur ?» — والجواب دائماً جملة تبدأ بـ car / parce que / car en effet بعد الأطروحة.","تابع الفيديو الأساسي بالشرح العربي: عشر عبارات جاهزة لفهم وكتابة النص الحجاجي — العبارات الوظيفية التي تكشف اتجاه الفكرة قبل فكّ بقية الجملة. حفظ العبارات الوظيفية أسرع طريق لفهم نص كامل: «Certains estiment que...» تفتح اقتباس رأي مهما تابعه.","الحجج المضادة: احذر فخ «l'on dit que» (يُقال إن) — ليست حجة بل اقتباس شائع يُعادل عادةً ليُفنى. كذلك «il est évident que» (من الواضح أن) نفيٌ مُنذلٌ يخفي ضعف السند؛ والعدد بلا مصدر «beaucoup disent» ادعاء عام. النقّاد الثلاثة: الشائع، الواضح، العام.","الروابط العشر التي تعرفها أولاً: d'abord, ensuite, par ailleurs, de plus, en outre (تعداد)، en revanche, au contraire (تضاد)، ainsi, par conséquent, c' pourquoi (نتيجة)، alors que (مقاربة). عشر كلمات تبني كل حجة وتُظهر أنك تفهم بنية النص لا كلماته.","استخراج العبرة والدفاع عن رأيك: بعد النص، صُغ أطروحتك في جملة واحدة («À mon avis, X car Y») ثم اكتب اعتراضاً محتملاً وأجب عنه. هذا التمرين الثلاثي (أطروحة ← اعتراض ← رد) هو ما يُطلب في الجزء الكتابي من DELF B1 — قلبه حجاج لا وصف."],"video":{"id":"qjNvlIBf-v4","title":"اهم 10عبارات بالفرنسية تساعدك على فهم وكتابة النص الحجاجي Le texte argumentatif","channel":"Classe dz","why":"عشر عبارات جاهزة لفهم وكتابة النص الحجاجي — المفردات التي تكشف بنية الحجة والاعتراض قبل أن تفهم الجملة كاملة.","lang":"ar","main":true,"dur":5},"sub":[{"h":"مسار النص الحجاجي","p":["thèse — الأطروحة.","arguments + exemples — الحجج والشواهد.","contre-argument وردّه — لا حذفه.","conclusion — تلخيص لا فتح جديد."]},{"h":"الحجج المضادة: ثلاثة أخطاء شائعة","p":["l'on dit que — اقتساب شائع يُفنّى.","il est évident que — وهم السند الواضح.","beaucoup disent — عدد بلا مصدر.","الرد: مصدر موثوق + شاهد ملموس."]},{"h":"الروابط العشر","p":["تعداد: d'abord / ensuite / de plus / en outre.","تضاد: en revanche / au contraire.","نتيجة: ainsi / par conséquent.","مقاربة: alors que / tandis que."]}]},{"h":"الحجج المضادة: احذر الفخ","p":["الكتابة الحجاجية الجيدة تعرض الرأي المقابل ثم تحطمه. علاماتها: «Certains pensent que...» (البعض يرى أن...)، «Il est vrai que...» (من الصحيح أن...) — هذه ليست رأي الكاتب! بعدها مباشرة تأتي الردّة المعاكسة: «Mais...، Cependant...، Pourtant...، Or...». حتى تجد الموقف الحقيقي، اتبع الكلمة التي تأتي بعد mais.","خريطة روابط القراءة: for (d'abord, tout d'abord, ensuite, de plus, enfin) = ترتيب الحجج؛ contre (mais, cependant, pourtant, néanmoins) = تناقض/مقاومة؛ نتيجة (donc, ainsi, par conséquent) = استنتاج؛ سبب (parce que, car, en effet) = تبرير. تعقّب هذه الكلمات كأنها إشارات مرور.","الفارق بين «cependant» و«pourtant»: الأول يضع وجهين متساويين (نظرة موضوعية)، والثاني يتوقع أن تُفند الوجه الثاني (توجه). سوء الاختيار لا يُصحَّح لغوياً لكنه يُغيّر نبرة نصك — والدرجة تُقتطع على النبرة لا على الإملاء."],"video":null},{"h":"الروابط العشر التي تعرفها أولاً","p":["ابدأ بالعشر الأساسية: d'abord (أولاً)، ensuite (ثم)، de plus/par ailleurs (علاوة على ذلك)، cependant/pourtant (لكن)، en effet (في الحقيقة/فعل)، donc (لذلك)، par conséquent (نتيجة لذلك)، malgré (رغم)، parce que (لأن)، enfin (أخيراً). كل واحدة لها وظيفة واحدة — لا تحفظها كقائمة بل كوظائف.","تمرين فعال: عند قراءة أي نص، ظلّل كل رابط واكتب فوقه وظيفته (ترتيب؟ تناقض؟ سبب؟). بعد 5 نصوص ستعثر على المنطق تلقائياً — وهذه المهارة نفسها تخدمك في الفهم السمعي وفي كتابة مقال DELF.","تمرين الأطروحة الثلاثية: اختر قضية يومية (الموصلات العامة، الهاتف في الصف)، واكتب 6 أسطر: أطروحة، حجتان، اعتراض، رد، خاتمة. ستة أسطر أسبوعياً تبني مهارة الجزء الكتابي كاملاً."],"video":null},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: تعلّمت هيكل النص الحجاجي (أطروحة ← حجج ← شواهد ← اعتراض يُجاب عنه ← خاتمة)، والروابط العشر التي تكشف منطقه، وفخاخ l'on dit que وil est évident que. أعد مشاهدة الفيديو الرئيسي وركّز على العبارات الوظيفية التي تكشف اتجاه الفكرة قبل فكّ بقية الجملة.","جسر الدروس: من B1-t1-l2 (قراءة الصحافة والمقالات) إلى B1-t1-l3 (فهم النص الحجاجي)، ثم إلى B1-t2-l1 حيث تقرأ قصة بالماضي الثلاثة وتعيد سردها بكلماتك.","مهمة تطبيقية: سجّل نفسك دقيقة وأنت تلخّص الدرس وتعيد استخدام 3 كلمات جديدة، ثم قارن نطقك بالفيديو الرئيسي."]}],"examples":[{"fr":"Je pense que le télétravail est bénéfique.","ar":"أرى أن العمل عن بُعد مفيد (أطروحة)."},{"fr":"Certains pensent que c'est isolant. Cependant, les outils modernes...","ar":"يرى البعض أنه معزول. لكن الأدوات الحديثة... (حجة مضادة ثم رد)"},{"fr":"En effet, j'ai gagné deux heures de transport chaque jour.","ar":"في الواقع، وفّرت ساعتين تنقلاً كل يوم (مثال/دليل)."},{"fr":"Par conséquent, il faut encourager cette pratique.","ar":"نتيجة لذلك، يجب تشجيع هذه الممارسة (خاتمة)."},{"fr":"Certains estiment que le travail à domicile est préférable.","ar":"يرى البعض أن العمل من المنزل أفضل.","note":"اقتباس رأي"},{"fr":"En revanche, la vie sociale en souffre.","ar":"بالمقابل، الحياة الاجتماعية تتأثر.","note":"تضاد"},{"fr":"Par conséquent, il faut trouver un équilibre.","ar":"وبالتالي، يجب إيجاد توازن.","note":"نتيجة"},{"fr":"À mon avis, X car Y — voilà une thèse.","ar":"برأيي، س لأن ص — هذه أطروحة.","note":"البنية الثلاثية"}],"pron":[{"w":"une thèse","ipa":"[te.z]","approx":"تيز"},{"w":"cependant","ipa":"[sə.pɑ̃.dɑ̃]","approx":"سُه-بان-دان"},{"w":"par conséquent","ipa":"[paʁ kɔ̃.se.kɑ̃]","approx":"بار-كونسيكان"}],"vocab":[{"fr":"une thèse","ar":"أطروحة / موقف دفاعي","pos":"nom","g":"f","pl":"des thèses","ipa":"[te.z]","exFr":"Quelle est la thèse de l'auteur ?","exAr":"ما أطروحة الكاتب؟"},{"fr":"un argument","ar":"حجة","pos":"nom","g":"m","ipa":"[aʁ.ɡy.mɑ̃]","exFr":"Il manque un argument solide.","exAr":"حجة قوية ناقصة."},{"fr":"cependant","ar":"لكن / مع ذلك","pos":"conjonction","ipa":"[sə.pɑ̃.dɑ̃]","exFr":"C'est utile, cependant c'est cher.","exAr":"إنه مفيد، لكنه باهظ."},{"fr":"en effet","ar":"في الواقع / فعل","pos":"expression","ipa":"[ɑ̃.ne.fɛ]","exFr":"En effet, les chiffres le confirment.","exAr":"في الواقع، الأرقام تؤكد ذلك."},{"fr":"par conséquent","ar":"نتيجة لذلك","pos":"expression","ipa":"[paʁ kɔ̃.se.kɑ̃]","exFr":"Par conséquent, je refuse cette idée.","exAr":"نتيجة لذلك أرفض هذه الفكرة."},{"fr":"convaincre","ar":"يقنع","pos":"verbe","ipa":"[kɔ̃.vɛ̃kʁ]","exFr":"Le texte veut convaincre le lecteur.","exAr":"النص يريد إقناع القارئ."},{"fr":"l'argument","ar":"الحجة","pos":"nom","g":"m","exFr":"Quel est ton argument ?","ipa":"[aʁɡmɑ̃]","exAr":"ما حجتك؟"},{"fr":"la thèse","ar":"الأطروحة","pos":"nom","g":"f","exFr":"Sa thèse est claire.","ipa":"[tɛs]","exAr":"أطروحته واضحة."},{"fr":"pourtant / cependant","ar":"لكن / مع ذلك","pos":"adv","exFr":"Il est jeune, pourtant il est sage.","ipa":"[puʁtɑ̃]","exAr":"إنه شاب، ومع ذلك حكيم."},{"fr":"néanmoins","ar":"ومع ذلك","pos":"adv","exFr":"C'est difficile, néanmoins je continue.","ipa":"[neɑ̃mwɛ̃]","exAr":"صعب، ومع ذلك أواصل."},{"fr":"en revanche","ar":"بالمقابل","pos":"locution","exFr":"Le métro est rapide, en revanche cher.","ipa":"[ɑ̃ ʁəvɑ̃ʃ]","exAr":"المترو سريع، بالمقابل غالٍ."},{"fr":"il est évident que","ar":"من الواضح أن","pos":"locution","exFr":"Il est évident que tu as raison.","ipa":"[il ɛ evidɑ̃ kə]","exAr":"من الواضح أنك محق."},{"fr":"l'on dit que","ar":"يُقال إن","pos":"locution","exFr":"L'on dit que c'est vrai.","ipa":"[lɔ̃ di kə]","exAr":"يُقال إنها حقيقية."},{"fr":"nuancer","ar":"يُدقّق/يُخدّد","pos":"verbe","g":"1er","exFr":"Il faut nuancer cette idée.","ipa":"[nɥɑ̃se]","exAr":"يجب تدقيق هذه الفكرة."},{"fr":"le contre-argument","ar":"الحجة المضادة","pos":"nom","g":"m","exFr":"Anticipez le contre-argument.","ipa":"[kɔ̃tʁ aʁɡmɑ̃]","exAr":"توقّع الحجة المضادة."},{"fr":"fonder sur","ar":"يُسند إلى","pos":"locution","exFr":"Une idée fondée sur des faits.","ipa":"[fɔ̃de syʁ]","exAr":"فكرة مسنودة بالوقائع."},{"fr":"la conclusion","ar":"الخاتمة","pos":"nom","g":"f","exFr":"La conclusion résume les points.","ipa":"[kɔ̃klyzjɔ̃]","exAr":"الخاتمة تلخص النقاط."}],"grammar":[{"tFr":"Le subjonctif après les jugements","tAr":"القاعدة: المنصوب بعد أحكام الرأي","body":["بعد «il faut que / il est bon que / bien que» يأتي المنصوب — وهي المواضع الحجاجية الشائعة: «Il faut que chacun donne son avis».","بينما «parce que» يأخذ المضارع العادي: «je continue parce que je crois que...» — التضاد يحفظه النص الحجاجي نفسه."],"ex":[{"fr":"Bien que le coût soit élevé, la solution vaut la peine.","ar":"رغم أن التكلفة مرتفعة، تستحق الحل الجهد."},{"fr":"Je défends cette idée parce qu'elle est utile.","ar":"أدافع عن هذه الفكرة لأنها مفيدة."}]}],"mistakes":[{"wrong":"اعتبار l'on dit que حجة","right":"اقتباس شائع يُفنّى بمصدر","why":"الحجة تُسنَد لا تُروى كشائع."},{"wrong":"حذف الاعتراض لصالح الرأي","right":"ذكر الاعتراض ثم الرد عليه","why":"الرفض المسبق يُظهر نصاً أحادياً — الدرجة للحوارية."},{"wrong":"خلط cependant وpourtant","right":"cependant موضوعي / pourtant متوقع التفنيد","why":"النبرة تختلف والدرجة على النبرة."},{"wrong":"خاتمة تفتح قضية جديدة","right":"خاتمة تلخيصية","why":"الخاتمة تُغلق لا تُفتح — خلاف ذلك تُقطع."}],"dialogues":[{"title":"تجهيز حجة","ctx":"زميلان يناقشان موضوع تحرير","lines":[{"who":"Sami","fr":"Mon avis : le vélo est mieux en ville.","ar":"رأيي: الدراجة أفضل في المدينة."},{"who":"Hiba","fr":"C'est une opinion. Où est l'argument ?","ar":"هذا رأي. أين الحجة؟"},{"who":"Sami","fr":"Parce qu'il ne pollue pas et il évite les embouteillages.","ar":"لأنها لا تلوث وتجنب الازدحام."},{"who":"Hiba","fr":"Bien. Maintenant imagine l'objection.","ar":"جيد. الآن تخيل الاعتراض."},{"who":"Sami","fr":"«Sous la pluie, c'est difficile» — je réponds : il existe le métro aussi.","ar":"«تحت المطر، هذا صعب» — أرد: المترو موجود أيضاً."},{"who":"Hiba","fr":"Là, tu as un vrai texte argumentatif !","ar":"هنا، لديك نص حجاجي حقيقي!"}]}],"exercises":[{"t":"mcq","skill":"reading","q":"«Il est vrai que le sport coûte cher. Mais la santé n'a pas de prix.» — ما موقف الكاتب من الرياضة؟","opts":["ضدها لأنها غالية","معها — الغلاء لا يمنع الفائدة","محايد تماماً","لا رأي واضح"],"a":1,"why":"الكلمة بعد mais تحمل الموقف الحقيقي: القيمة أهم من الكلفة."},{"t":"mcq","skill":"reading","q":"أي جملة تحتمل أطروحة (رأياً)؟","opts":["Le musée ouvre à 9h","À mon avis, les musées devraient être gratuits","Le billet coûte 10 euros","Le musée a fermé hier"],"a":1,"why":"À mon avis إعلان رأي صريح؛ البقية وقائع."},{"t":"fill","skill":"grammar","q":"أكمل بالرابط المناسب: «Le prix est élevé, ___ la qualité est excellente.» (لكن)","fr":"Le prix est élevé, ___ la qualité est excellente.","ans":"mais","alts":["cependant","pourtant"],"why":"mais/cependant/pourtant كلها تعبّر عن التناقض هنا."},{"t":"order","skill":"reading","q":"رتّب بنية النص الحجاجي: (1) الحجج والأمثلة (2) الأطروحة (3) الخاتمة","words":["La","thèse","vient","d'abord."],"ans":"La thèse vient d'abord.","why":"التسلسل القياسي: أطروحة → حجج → خاتمة."},{"t":"listen","skill":"listening","q":"Écoute la phrase de conclusion et choisis sa fonction dans le texte argumentatif :","audio":"Par conséquent, il faut encourager cette pratique","opts":["أطروحة افتتاحية","استنتاج ختامي","حجة مضادة","مثال توضيحي"],"a":1,"why":"par conséquent تمهّد للنتيجة/الاستنتاج الختامي."},{"t":"writing","skill":"writing","q":"اكتب فقرة حجاجية قصيرة: «هل الشاشات ضارة للأطفال؟» — أطروحة + حجة + مثال + خاتمة.","min":25,"kw":["je pense","mais","donc"],"sample":"Je pense que les écrans sont utiles mais dangereux sans limites. En effet, mon cousin a appris l'anglais avec des vidéos éducatives. Cependant, il reste trois heures par jour devant l'écran. Donc, les parents doivent fixer des règles claires.","why":"بناء فقرة حجاجية بأطروحة وحجة ومثال وخاتمة هو نمط الجزء الكتابي في DELF B1 — التمرين يدرّبك على الإقناع المنظّم لا على وصف الرأي بكلمات عامة."},{"t":"mcq","skill":"reading","q":"النص الحجاجي (.argumentatif) يُبنى على:","opts":["موقف + حجج + دحض الاعتراض","وصف الأشخاص","تسلسل زمني","سرد قصصي"],"a":0,"why":"الإقناع يحتاج موقفاً وحججاً وتفنيداً لمعارض."},{"t":"order","skill":"reading","q":"رتّب بناء الحجة: (1) الدحض (2) الموقف (3) الحجة","words":["Le","point","de","vue,","les","arguments,","puis","la","réfutation."],"ans":"Le point de vue, les arguments, puis la réfutation.","why":"موقف ← حجة ← دحض ترتيب الحجاج الفرنسي."}],"homework":"اقرأ مقالاً رأياً واحداً بالفرنسية، وظلّل: الأطروحة، رابطين منطقيين، وحجة مضادة — ثم اكتب موقف الكاتب في جملة.","sources":[{"title":"اهم 10عبارات بالفرنسية تساعدك على فهم وكتابة النص الحجاجي Le texte argumentatif","channel":"Classe dz","videoId":"qjNvlIBf-v4","why":"عشر عبارات جاهزة لفهم وكتابة النص الحجاجي — المفردات التي تكشف بنية الحجة والاعتراض قبل أن تفهم الجملة كاملة.","cat":"Reading","level":"B1","main":true,"dur":5},{"title":"Le texte argumentatif: une explication claire et facile de A à Z","channel":"Minutes de Savoir","videoId":"AoUIdRLlqmY","why":"شرح شامل ومبسط لبنية النص الحجاجي من الصفر: الأطروحة والحجج والخاتمة — الأساس النظري الذي تحتاجه قبل أي قراءة.","cat":"Reading","level":"B1","extra":true},{"title":"texte argumentatif: les articulateurs logiques dans un texte argumentatif","channel":"Leçons de français","videoId":"twBL_nazdY8","why":"دراسة متعمقة للأدوات المنطقية داخل النص الحجاجي تحديداً — يريك كيف تُبنى الحجة وكيف تعرف متى يعرض الكاتب الرأي المقابل.","cat":"Reading","level":"B1","extra":true},{"title":"10 Connecteurs Logiques INDISPENSABLES pour mieux parler français !","channel":"Parlez-vous FRENCH : Cours de français","videoId":"-3Qj3i9ZE1Y","why":"أهم 10 روابط منطقية بشروحات وأمثلة مسموعة — تثبيت عملي لأدوات فهم النص واستخدامها في كلامك وكتابتك معاً.","cat":"Reading","level":"B1","extra":true}],"supplements":[{"id":"AoUIdRLlqmY","title":"Le texte argumentatif: une explication claire et facile de A à Z","channel":"Minutes de Savoir","why":"شرح شامل ومبسط لبنية النص الحجاجي من الصفر: الأطروحة والحجج والخاتمة — الأساس النظري الذي تحتاجه قبل أي قراءة.","lang":"fr"},{"id":"twBL_nazdY8","title":"texte argumentatif: les articulateurs logiques dans un texte argumentatif","channel":"Leçons de français","why":"دراسة متعمقة للأدوات المنطقية داخل النص الحجاجي تحديداً — يريك كيف تُبنى الحجة وكيف تعرف متى يعرض الكاتب الرأي المقابل.","lang":"fr"},{"id":"-3Qj3i9ZE1Y","title":"10 Connecteurs Logiques INDISPENSABLES pour mieux parler français !","channel":"Parlez-vous FRENCH : Cours de français","why":"أهم 10 روابط منطقية بشروحات وأمثلة مسموعة — تثبيت عملي لأدوات فهم النص واستخدامها في كلامك وكتابتك معاً.","lang":"fr"}]}]},{"id":"b1-t2","slug":"stories","icon":"📚","color":"#D97706","fr":"Histoires","ar":"مسار القصص التعليمية","desc":"تعلّم بالقصص كما يفعل الناطقون الأصليون: روايات قصيرة بالأزمنة الثلاثة، حكايات لافونتين الكلاسيكية، وقصص الحياة الواقعية.","lessons":[{"id":"B1-t2-l1","fr":"Lire un récit au passé","ar":"قراءة قصة بالماضي: رحلة ياسين","objectives":["قراءة رواية قصيرة بالأزمنة الثلاثة (imparfait/PC/PQP) وفهم تسلسل الأحداث","تمييز وظيفة كل زمن في السرد: الخلفية، الأحداث، وما حدث قبل","إعادة سرد قصة بكلماتك الخاصة"],"sections":[{"h":"قصة الدرس: أسبوع في باريس","p":["السرد الفرنسي يعمل بمحرّكين: imparfait يبني الخلفية (الزمان، الطقس، العادات، الوصف) وpassé composé يحرّك الحدث (الحدث الذي قدّم القصة خطوة). «Il faisait beau quand je suis sorti» — جملة واحدة تحمل المحرّكين معاً: الخلفية ثم الحركة.","قاعدة VSS الاختصارية: V (Verre) للحدث المفاجئ المكتمل ← passé composé، S (Subjonctif-ish/خلفية) للحالات المستمرة ← imparfait، S (Suite) لما بعد الحدث ← passé composé. لا تحفظ القاعدة كجدول — احفظ الجملة الشاهدة وطبّق بالعين.","تابع الفيديو الأساسي بالشرح العربي: الماضي المركب والمستمر و passé récent في عرض واحد — التمييز المركزي لأي قصة مثل «أسبوع في باريس»: أين الهدوء وأين الحركة. صيغة passé récent (venir de + inf) تُدخل «توًّا حدث» في السرد وتُحيي الإيقاع.","خريطة السرد: قبل الحدث (imparfait + retrovie) ← الحدث المحرّك (PC) ← ما بعده (PC). عند إعادة السرد، أثبت الصيغ على كل خط: كل «كان» يبقى imparfait، وكل «فعلت/حدث» يذهب لـ PC. الخلط هنا يُسمع فوراً ويُضبط فوراً.","إعادة السرد بكلماتك (le récit reformulé): أعد الحكاية بصيغتك وضمائرك مع الحفاظ على الأزمنة — التمرين يبني استقلالك عن النص الأصلي. ابدأ بجُمل قصيرة (sujet + verbe) ثم أضف الظروف بـ imparfait — القصيرة أولاً تمنعك من الضياع.","أخطاء السرد الشائعة: وصف الأحداث بـ imparfait («Je marchais quand j'ai vu» صحيحة، «Je marchais quand je voyais» مكررة)، وتكرار alors que مع et، ونسيان que في الشرطية. تدرّب على 200 كلمة يومياً: سرد يومك أمس بـ 10 جمل — أسرع تمرين إنتاج ماضٍ."],"video":{"id":"C-A2AY61fdo","title":"le passé composé, l'imparfait, le passé récent لن تخطئ بعد الآن في","channel":"Le français avec Nabil","why":"الماضيان معاً مع passé récent في فيديو واحد: يميّز الخلفية عن الحدث — أساس أي سرد قصة مثل «أسبوع في باريس».","lang":"ar","main":true,"dur":13},"sub":[{"h":"المحرّكان: الخلفية والحركة","p":["imparfait — الخلفية: زمان، طقس، عادة، وصف.","passé composé — حركة: حدث يقدّم القصة.","«Il faisait beau quand je suis sorti».","passé récent — venir de: «توًّا»."]},{"h":"قاعدة VSS بالشواهد","p":["Verre ← PC (حدث مكتمل مفاجئ).","خلفية ← imparfait (مستمر).","Suite ← PC (ما بعد الحدث).","شاهد واحد يغني عن جدول."]},{"h":"إعادة السرد بلا ضياع","p":["جُمل قصيرة أولاً (sujet + verbe).","كل «كان» ← imparfait، كل «فعلت» ← PC.","ثم أضف الظروف تدريجياً.","200 كلمة يومياً عن يومك أمس."]}]},{"h":"خريطة السرد: الخلفية والأحداث وما قبلها","p":["التسلسل الزمني في أي رواية يعمل بثلاث طبقات: ما حدث قبل القصة (plus-que-parfait: avait rêvé, avait économisé)؛ خلفية القصة وأجواؤها وعاداتها (imparfait: prenait, dormait)؛ والأحداث المحورية التي تحرك القصة (passé composé: est parti, a rencontré). عند القراءة، ظلّل كل زمن بلون — سترى القصة كطبقات مرئية.","كلمات الزمن هي مفاتيح الطبقات: d'abord، soudain، enfin، le lendemain، tout à coup تدل على أحداث (PC)؛ tandis que، pendant que، chaque jour، toujours تدل على خلفية (imparfait)؛ déjà، avant، enfin بعد فترة طويلة تدل على الأسبقية (PQP).","تمييز إضافي: les états avec être («j'étais fatigué») تبقى عادةً imparfait لأنها حالة لا حدث، بينما تغيّرات être مع PC («je suis devenu»، «je suis parti») أحداث تحرّك. الاستثناء يكشف المستوى: B1 يعرف متى تكون être حركة."],"video":null},{"h":"إعادة السرد: عد القصة بكلماتك","p":["أقوى تمرين بعد القراءة هو إعادة السرد (résumé oral): أعد حكاية قصة ياسين في 6 جمل بكلماتك — استخدم زمناً واحداً محدداً لكل جملة عمداً: جملة PQP، جملتين imparfait، ثلاث جمل PC. هذا التمرين يحوّل القواعد من معرفة سلبية إلى أداة نشطة.","في DELF B1 (إنتاج شفوي) يُطلب منك سرد تجربة شخصية: «Racontez un voyage inoubliable». استخدم نفس البنية: افتتاحية أسبقية (Avant ce voyage, je n'avais jamais...), خلفية (Nous prenions toujours...), أحداث (Un jour, nous avons...), خاتمة رأي (C'était le plus beau moment...).","بعد الفيديو الإثرائي: أعد سماع مقطعاً قصيراً ودوّن جملتي كل ما سمعته: واحدة imparfait وواحدة PC. مطابقة أذنك للأزمنة أثناء السماع تُثبت القاعدة في الاستماع قبل الكتابة."],"video":null},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: تعلّمت محرّكي السرد — imparfait يبني الخلفية وpassé composé يحرّك الحدث — مع قاعدة VSS وpassé récent، ثم أعدت سرد القصة بكلماتك. أعد مشاهدة الفيديو الرئيسي وركّز على التمييز بين ما كان جارياً وما حدث فعلاً داخل الجملة الواحدة.","جسر الدروس: من B1-t1-l3 (فهم النص الحجاجي) إلى B1-t2-l1 (قراءة قصة بالماضي: رحلة ياسين)، ثم إلى B1-t2-l2 حيث تقرأ حكايات لافونتين وتستخرج العبرة من الرمز.","مهمة تطبيقية: سجّل نفسك دقيقة وأنت تلخّص الدرس وتعيد استخدام 3 كلمات جديدة، ثم قارن نطقك بالفيديو الرئيسي."]}],"examples":[{"fr":"L'an dernier, il avait toujours rêvé de visiter Paris.","ar":"في العام الماضي، كان يحلم دائماً بزيارة باريس (أسبق)."},{"fr":"Chaque matin, il prenait un café dans un bistrot.","ar":"كل صباح كان يشرب قهوة في بسترو (خلفية/عادة)."},{"fr":"Un jour, il a rencontré une vieille dame.","ar":"ذات يوم، قابل عجوزاً (حدث)."},{"fr":"Cette rencontre a été le plus beau souvenir.","ar":"كان هذا اللقاء أجمل ذكرى (خاتمة)."},{"fr":"Il faisait beau quand je suis sorti.","ar":"كان الجو جميلاً عندما خرجت.","note":"خلفية + حدث"},{"fr":"Soudain, le train s'est arrêté.","ar":"فجأة، توقف القطار.","note":"حدث مفاجئ ← PC"},{"fr":"Je venais de sortir quand il a plu.","ar":"كنت قد خرجت لتوّي عندما تمطر.","note":"passé récent"},{"fr":"Il était fatigué, mais il a continué.","ar":"كان متعباً، لكنه واصل.","note":"حالة + حركة"}],"pron":[{"w":"un souvenir","ipa":"[su.və.niʁ]","approx":"سوفينير"},{"w":"soudain","ipa":"[su.dɛ̃]","approx":"سودان","note":"فجأة — كلمة أحداث"},{"w":"le lendemain","ipa":"[lə lɑ̃.də.mɛ̃]","approx":"لُه-لان-ده-مان","note":"اليوم التالي"}],"vocab":[{"fr":"un récit","ar":"رواية / حكاية","pos":"nom","g":"m","pl":"des récits","ipa":"[ʁe.si]","exFr":"Ce récit se passe à Paris.","exAr":"هذه الرواية تجري في باريس."},{"fr":"économiser","ar":"يدّخر / يوفّر","pos":"verbe","ipa":"[e.kɔ.nɔ.ze]","exFr":"Il a économisé pendant dix mois.","exAr":"ادّخر طوال عشرة أشهر."},{"fr":"rencontrer","ar":"يقابل (صدفة أو عمداً)","pos":"verbe","ipa":"[ʁɑ̃.kɔ̃.tʁe]","exFr":"J'ai rencontré une vieille dame.","exAr":"قابلت عجوزاً."},{"fr":"tranquillement","ar":"بهدوء","pos":"adv","ipa":"[tʁɑ̃.kij.mɑ̃]","exFr":"Le chat dormait tranquillement.","exAr":"كانت القطة تنام بهدوء."},{"fr":"le souvenir","ar":"ذكرى","pos":"nom","g":"m","ipa":"[su.və.niʁ]","exFr":"Gardez de bons souvenirs de ce voyage.","exAr":"احتفظ بذكريات جميلة عن هذه الرحلة."},{"fr":"raconter","ar":"يحكي / يسرد","pos":"verbe","ipa":"[ʁa.kɔ̃.te]","exFr":"Raconte-nous ton aventure !","exAr":"احكِ لنا مغامرتك!"},{"fr":"le récit","ar":"السرد/الرواية القصيرة","pos":"nom","g":"m","exFr":"Le récit commence le matin.","ipa":"[ʁɛsi]","exAr":"السرد يبدأ صباحاً."},{"fr":"la scène","ar":"المشهد","pos":"nom","g":"f","exFr":"Une scène dans le métro.","ipa":"[sɛn]","exAr":"مشهد في المترو."},{"fr":"soudain","ar":"فجأة","pos":"adv","exFr":"Soudain, il a pleuvoir.","ipa":"[sudɛ̃]","exAr":"فجأة، بدأ تمطر."},{"fr":"à ce moment-là","ar":"في تلك اللحظة","pos":"locution","exFr":"À ce moment-là, j'ai compris.","ipa":"[a sə mɔmɑ̃ la]","exAr":"في تلك اللحظة، فهمت."},{"fr":"puis","ar":"ثم","pos":"adv","exFr":"Puis, il est parti.","ipa":"[pɥi]","exAr":"ثم، ذهب."},{"fr":"hélas","ar":"يا للأسف","pos":"interj","exFr":"Hélas, le train était parti.","ipa":"[elas]","exAr":"يا للأسف، كان القطار قد رحل."},{"fr":"se passer","ar":"يحدث","pos":"verbe","g":"—","exFr":"Qu'est-ce qui s'est passé ?","ipa":"[sə pɑ̃se]","exAr":"ما الذي حدث؟"},{"fr":"décrire","ar":"يصف","pos":"verbe","g":"irr","exFr":"Il a décrit la ville.","ipa":"[deskʁiʁ]","exAr":"وصف المدينة."},{"fr":"le dénouement","ar":"عقدة الحكاية وحلها","pos":"nom","g":"m","exFr":"Le dénouement est inattendu.","ipa":"[denumɑ̃]","exAr":"حل الحكاية غير متوقع."},{"fr":"un épisode","ar":"حلقة/واقعة","pos":"nom","g":"m","exFr":"Un épisode amusant.","ipa":"[epizɔd]","exAr":"واقعة مسلية."}],"grammar":[{"tFr":"Imparfait et passé composé dans le récit","tAr":"القاعدة: المحرّكان في السرد","body":["imparfait للخلفية والاستمرار والعادة، passé composé للحدث المكتمل المحرّك — والجملة المركّبة تجمعهما: «quand» بين خلفية وحركة.","passé récent: venir de + inf تعني «توًّا» وتُبقي السيرورة حيّة في السرد."],"ex":[{"fr":"Je marchais le long de la Seine quand j'ai vu Notre-Dame.","ar":"كنت أمشي على طول السين عندما رأيت نوتردام."},{"fr":"Nous venions d'arriver, il a sonné.","ar":"كنا قد وصلنا لتوّنا، دُرن الجرس."}]}],"mistakes":[{"wrong":"وصف الحدث بـ imparfait","right":"الحدث المكتمل ب passé composé","why":"imparfait يُبطئ القصة ولا يحرّكها."},{"wrong":"حالة مستمرة بـ PC","right":"الحالة والعادة ب imparfait","why":"«كنت متعباً» مستمرة — PC يجعلها حدثاً منتهياً."},{"wrong":"نسيان que في الشرطية","right":"si ← قاعدة + que ← فعل ثانٍ","why":"الفخ الشهير: si jamais + que لا يجتمعان."},{"wrong":"سرد بجمل مبعثرة بلا روابط","right":"puis / ensuite / à ce moment-là","why":"الروابط تصنع النسيج السردي وتُظهر B1 لا A2."}],"dialogues":[{"title":"سرد أسبوع في باريس","ctx":"صديقة تحكي عطلتها","lines":[{"who":"Salma","fr":"Raconte-moi ! Tu étais où exactement ?","ar":"احكي لي! أين كنت بالضبط؟"},{"who":"Inès","fr":"J'étais à Paris une semaine. Il faisait beau.","ar":"كنت في باريس أسبوعاً. كان الجو جميلاً."},{"who":"Salma","fr":"Qu'est-ce qui s'est passé de mémorable ?","ar":"ما الذاكر في ما حدث؟"},{"who":"Inès","fr":"Soudain, un orage éclaté le troisième jour !","ar":"فجأة، اندلع عاصفة في اليوم الثالث!"},{"who":"Salma","fr":"Et après ?","ar":"وبعد ذلك؟"},{"who":"Inès","fr":"Nous sommes rentrées mouillées, mais on a ri tout le soir.","ar":"عدنا مبتطلّات، لكننا ضحكنا طوال المساء."}]}],"exercises":[{"t":"mcq","skill":"reading","q":"«Il avait économisé pendant dix mois» — لماذا plus-que-parfait هنا؟","opts":["حدث أثناء الرحلة","حدث قبل فترة السرد (قبل السفر)","عادة متكررة","خطأ لغوي يجب أن يكون PC"],"a":1,"why":"PQP للحدث الأسبق على نقطة ماضٍ أخرى: الادّخرار سبق السفر."},{"t":"mcq","skill":"grammar","q":"«Le chat dormait tranquillement» — ما وظيفة هذا الزمن في القصة؟","opts":["حدث يحرك القصة","وصف/خلفية مشهد","حدث قبل القصة","خطأ؛ الصواب est endormi"],"a":1,"why":"imparfait يرسم الخلفية: مشهد النوم الهادئ."},{"t":"fill","skill":"grammar","q":"أكمل بالزمن المناسب: «Chaque été, nous ___ (aller) à la mer.»","fr":"Chaque été, nous ___ à la mer.","ans":"allions","alts":["nous allions"],"why":"كل صيف = عادة متكررة → imparfait: allions."},{"t":"order","skill":"reading","q":"رتّب طبقات السرد: (1) الأحداث المحورية (2) ما حدث قبل القصة (3) خلفية المشهد","words":["Avant","tout","il","avait","rêvé."],"ans":"Avant tout il avait rêvé.","why":"الأسبقية تُروى أولاً لتؤسس للقصة."},{"t":"listen","skill":"listening","q":"استمع واختر الزمن المستعمل:","audio":"Un jour, il a rencontré une vieille dame qui cherchait son chat","opts":["PC فقط","imparfait فقط","PC + imparfait معاً","PQP + PC"],"a":2,"why":"a rencontré (PC — حدث) + cherchait (imparfait — خلفية جارية)."},{"t":"writing","skill":"writing","q":"اكتب 5 جمل عن رحلة لا تنسى: واحدة PQP، اثنتان imparfait، واثنتان PC.","min":25,"kw":["avait","nous","nous avons"],"sample":"Avant ce voyage, je n'avais jamais pris l'avion. Nous dormions dans une petite auberge. Le matin, nous marchions au bord du fleuve. Un jour, nous avons visité un vieux château. Nous avons pris des photos inoubliables.","why":"إنتاج نص بأزمنة ثلاثة عمداً يثبّت التمييز بين الخلفية والحدث والأسبقية — وهو ما تقيّم به روايتك الكتابية والشفوية معاً في الامتحان."},{"t":"mcq","skill":"reading","q":"أول عنصر في قصة أسبوع في باريس هو:","opts":["الحدث المحرّك (le problème)","أسماء الفنادق","قائمة الحقائب","خاتمة الرحلة"],"a":0,"why":"الحدث المحرّك يفتح الحكاية ويحرّك الشخصيات."},{"t":"fill","skill":"reading","q":"أكمل: «Je ___ (aller) à Paris, mais le train avait du retard.»","fr":"Je ___ à Paris, mais le train avait du retard.","ans":"suis allé","alts":["suis allée","Suis allé","Suis allée"],"why":"الحدث المنتهي: passé composé من aller."}],"homework":"أعد سرد قصة الدرس شفوياً في دقيقة (سجّل نفسك) مع استخدام الأزمنة الثلاثة عمداً، ثم اكتب السرد في 6 جمل.","sources":[{"title":"le passé composé, l'imparfait, le passé récent لن تخطئ بعد الآن في","channel":"Le français avec Nabil","videoId":"C-A2AY61fdo","why":"الماضيان معاً مع passé récent في فيديو واحد: يميّز الخلفية عن الحدث — أساس أي سرد قصة مثل «أسبوع في باريس».","cat":"Stories","level":"B1","main":true,"dur":13},{"title":"Emily visits Paris | French Story to Learn Passé Composé (English Subtitles)","channel":"French Talk Café","videoId":"M2a7xeFG_a0","why":"قصة قصيرة كاملة عن زيارة باريس تدرّب الماضي المركّب — موضوعها يطابق قصة درسنا حرفياً وترجمته الإنجليزية تضمن الفهم الكامل.","cat":"Stories","level":"B1","extra":true},{"title":"Learn French the Easy Way (B1-B2) | Learn French Easily with a Simple Story","channel":"Francais facile","videoId":"j6E5IVzGxTo","why":"قصة مبسطة بمستوى B1-B2 بسرعة مريحة — تدريب إضافي على فهم الروايات الطويلة نسبياً دون ترجمة فورية.","cat":"Stories","level":"B1","extra":true},{"title":"J'ai enfin eu mon CDI ! | French B1 Story | Listening Practice for Beginners","channel":"Parlons Français Facile","videoId":"HHdT3-mIcm4","why":"قصة حقيقية بمستوى B1 عن أول عقد عمل دائم (CDI) — سرد بالمضارع والماضي معاً يثبّت أزمنة الدرس في سياق مهني واقعي.","cat":"Stories","level":"B1","extra":true}],"supplements":[{"id":"M2a7xeFG_a0","title":"Emily visits Paris | French Story to Learn Passé Composé (English Subtitles)","channel":"French Talk Café","why":"قصة قصيرة كاملة عن زيارة باريس تدرّب الماضي المركّب — موضوعها يطابق قصة درسنا حرفياً وترجمته الإنجليزية تضمن الفهم الكامل.","lang":"en"},{"id":"j6E5IVzGxTo","title":"Learn French the Easy Way (B1-B2) | Learn French Easily with a Simple Story","channel":"Francais facile","why":"قصة مبسطة بمستوى B1-B2 بسرعة مريحة — تدريب إضافي على فهم الروايات الطويلة نسبياً دون ترجمة فورية.","lang":"fr"},{"id":"HHdT3-mIcm4","title":"J'ai enfin eu mon CDI ! | French B1 Story | Listening Practice for Beginners","channel":"Parlons Français Facile","why":"قصة حقيقية بمستوى B1 عن أول عقد عمل دائم (CDI) — سرد بالمضارع والماضي معاً يثبّت أزمنة الدرس في سياق مهني واقعي.","lang":"fr"}]},{"id":"B1-t2-l2","fr":"Les fables de La Fontaine","ar":"حكايات لافونتين: الغراب والثعلب","objectives":["قراءة حكاية كلاسيكية مبسطة وفهم أزمنة السرد القديمة","استخراج العبرة (morale) من الحكاية","تعبير عن الرأي حول رسالة الحكاية"],"sections":[{"h":"لماذا لافونتين؟","p":["الفابلو (la fable) قصيدة قصيرة تحمل moralité: قصة قصيرة بأبطال حيوانات، ثم عبرة أخلاقية في سطر أو سطرين. لافونتين (1621–1695) بناها على مصادر قديمة (إيسوب) وحوّلها إلى فرنسية منثورة إيقاعية — لغة قصيرة تصلح للحفظ والتحليل معاً.","لماذا لافونتين تحديداً؟ لأنه يجمع ثلاث طبقات في نص واحد: حكاية طفل، لغة شاعر، ونقد اجتماعي لطيف. حيواناته ترمز (le renard = داهية المكر، le corbeau = الغرور، la fourmi = الحكمة العملية) — لغة الرموز هذه تظهر في كل أدب فرنسي بعده.","تابع الفيديو الأساسي بالشرح العربي: مدخل شامل للفابلو — أبطالها الحيوانات وبنية القصة والعبرة. ثم تقرأ Corbeau et Renard النموذجية وأنت تعرف خريطة الحكاية مسبقاً: الغرور ← المكر ← السقوط ← المثل.","قراءة نموذجية: «Maître Corbeau, sur un arbre perché» — لاحظ عشرة أحرف ساكنة في افتتاحية واحدة، وإيقاعاً منظوماً. لا تبدأ بالتحليل الإيقاعي؛ اقرأ ببطء أولاً لالتقاط الحبكة (الغراب يغرّر، الثعلب يسرق الجبن)، ثم أعد القراءة للغة.","استخراج العبرة: «Tout flatteur vit aux dépens de celui qui l'écoute» (كل مُطَعِّم يعيش على حساب من يستمع له) — المثل لافونتين الشهير. تدرّب على صياغة عبرتك أنت من أي قصة تقرأ بـ «Autrement dit...» أو «La morale est...» — كلمتان تحوّلان قراءة إلى تحليل.","التعبير عن رأيك على الفابلو: «À mon avis, le corbeau représente...» ثم شاهد ثم اعتراض ممكن («Certains diront que...») وأجِب عنه. الفابلو أفضل مادة للتدريب الحجاجي لأن النص قصير والرمز واضح — تدرس الحجة في صفحة بدل نصف نشاط."],"video":{"id":"c9nUWv7K380","title":"شرح سهل بالعربية لدروس اللغة الفرنسية La Fable: قصة أبطالها حيوانات","channel":"الاستاذة ياسمين","why":"مدخل عربي شامل للفابلو: بنية القصة وأبطالها الحيوانات والعبرة — يسبق ويجهّز قراءة Corbeau et Renard النموذجية.","lang":"ar","main":true,"dur":12},"sub":[{"h":"بنية الفابلو ورموزها","p":["قصة قصيرة ← moralité في سطر.","renard = مكر، corbeau = غرور.","fourmi = حكمة عملية.","لافونتين ← إيسوب بلغة شاعر."]},{"h":"قراءة Corbeau et Renard","p":["بطء أولاً للحبكة: غرور ← مكر ← سقوط.","ثم الإيقاع عشرة أحرف ساكنة في الافتتاحية.","الرمز لا يُحلَّل قبل الفهم.","الحفظ الجزئي (المثل) يثبّت اللسان."]},{"h":"من القراءة إلى الرأي","p":["«La morale est...» أو «Autrement dit...».","«À mon avis, X représente...» + شاهد.","اعتراض: «Certains diront que...».","الفابلو = مادة حجاجية قصيرة مثالية."]}]},{"h":"قراءة نموذجية: Le Corbeau et le Renard","p":["اقرأ النص المبسط: «Maître Corbeau, sur un arbre perché, tenait en son bec un fromage. Maître Renard, par l'odeur alléché, lui tint à peu près ce langage: \"Hé ! bonjour, Monsieur du Corbeau. Que vous êtes joli ! Que vous me semblez beau ! Sans mentir, si votre ramage se rapporte à votre plumage, vous êtes le Phénix des hôtes de ces bois.\" À ces mots, le Corbeau ne se sent pas de joie ; et, pour montrer sa belle voix, il ouvre un large bec, laisse tomber sa proie. Le Renard s'en saisit, et dit: \"Mon bon Monsieur, apprenez que tout flatteur vit aux dépens de celui qui l'écoute.\"»","لاحظ الـimparfait السردي القديم: tenait، alléché — وصف ثابت للمشهد. ثم الأحداث: ouvre، laisse tomber (مضارع سردي — تقنية كلاسيكية لتسريع المشهد!). فهم هذه التقنية يشرح لك لماذا تقرأ الفرنسية الكلاسيكية بمضارع.","لغة فابلو مكتظّة بالضمائر القصيرة والaposiopèse (توقف متعمّد): «Il mourut...» يحذف التعليل ويترك أثراً. عند القراءة أوقف عند النقطة واتركها تأثيراً — التوقف جزء من الأداء لا خطأ."],"video":null},{"h":"استخراج العبرة والتعبير عن رأيك","p":["القصة الحديثة مثل «Nuit à la belle étoile» تعمل كالفابل تماماً: أحداث ثم مغزى. التمرين الموحد: بعد أي قصة، أجب بالفرنسية عن ثلاثة أسئلة: Quelle est la morale de cette histoire ? (ما عبرتها؟) — À qui s'adresse-t-elle ? (لمن موجهة؟) — Êtes-vous d'accord ? Pourquoi ? (هل توافق؟ لماذا؟). السؤال الثالث هو مدخل DELF B1 للنقاش.","عبارات مفيدة لإبداء رأيك حول القصص: «Selon moi, la morale est claire : ne fais pas confiance aux flatteurs»؛ «Cette histoire me rappelle...» (تذكرني بـ...)؛ «Je pense que cette leçon est encore d'actualité» (ما تزال حاضرة اليوم).","تمرين: اختر فابلو غير مقروءة (Le Lion et le Rat مثلاً)، اقرأها دفعتين، ثم اكتب 4 أسطر: الحببة، الرمز، المثل، رأيك في صدقها اليوم."],"video":null},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: تعلّمت بنية الفابلو ورموزها، وقرأت Corbeau et Renard قراءة نموذجية، واستخرجت العبرة وعبّرت عن رأيك حولها. أعد مشاهدة الفيديو الرئيسي وركّز على أبطال الحيوانات ودلالات الرموز التي تحوّل الحكاية إلى درس.","جسر الدروس: من B1-t2-l1 (قراءة قصة بالماضي: رحلة ياسين) إلى B1-t2-l2 (حكايات لافونتين: الغراب والثعلب)، ثم إلى B1-t2-l3 حيث تبني عادة القراءة الممتدة من الفلوغ إلى الكلاسيكيات.","مهمة تطبيقية: سجّل نفسك دقيقة وأنت تلخّص الدرس وتعيد استخدام 3 كلمات جديدة، ثم قارن نطقك بالفيديو الرئيسي."]}],"examples":[{"fr":"Le renard a flatté le corbeau pour lui prendre son fromage.","ar":"مدح الثعلب الغراب ليخطف جبنه."},{"fr":"Apprenez que tout flatteur vit aux dépens de celui qui l'écoute.","ar":"اعلم أن كل مدحٍ يعيش على حساب من يستمع إليه (العبرة)."},{"fr":"Selon moi, cette fable parle encore à notre époque.","ar":"برأيي، هذه الحكاية ما تزال تخاطب عصرنا."},{"fr":"Quelle est la morale de cette histoire ?","ar":"ما عبرة هذه الحكاية؟"},{"fr":"Maître Corbeau, sur un arbre perché...","ar":"يا سيدي الغراب، على شجرة معلّق...","note":"افتتاحية شهيرة"},{"fr":"La morale : tout flatteur vit aux dépens de l'auditeur.","ar":"العبرة: كل متملق يعيش على حساب المستمع.","note":"المثل"},{"fr":"Le renard représente la ruse.","ar":"الثعلب يرمز للمكر.","note":"الرمز"},{"fr":"À mon avis, la fable reste vraie aujourd'hui.","ar":"برأيي، الفابلو ما زالت صحيحة اليوم.","note":"رأي"}],"pron":[{"w":"perché","ipa":"[pɛʁ.ʃe]","approx":"بير-شيه","note":"الجاثم على فرع"},{"w":"un flatteur","ipa":"[fla.tœʁ]","approx":"فلا-توهر","note":"المتملق"},{"w":"une fable","ipa":"[fabl]","approx":"فابل"}],"vocab":[{"fr":"une fable","ar":"حكاية رمزية (فابل)","pos":"nom","g":"f","ipa":"[fabl]","exFr":"Les fables de La Fontaine sont célèbres.","exAr":"حكايات لافونتين مشهورة."},{"fr":"la morale","ar":"العبرة / الدرس الأخلاقي","pos":"nom","g":"f","ipa":"[ma.ʁɔl]","exFr":"La morale de l'histoire est claire.","exAr":"عبرة الحكاية واضحة."},{"fr":"flatter","ar":"يتملق","pos":"verbe","ipa":"[fla.te]","exFr":"Le renard flatte le corbeau.","exAr":"الثعلب يتملق الغراب."},{"fr":"un bec","ar":"منقار","pos":"nom","g":"m","pl":"des becs","ipa":"[bɛk]","exFr":"Le corbeau tient le fromage dans son bec.","exAr":"الغراب يحمل الجبن بمنقاره."},{"fr":"une proie","ar":"فريسة","pos":"nom","g":"f","ipa":"[pʁwa]","exFr":"Il laisse tomber sa proie.","exAr":"يُسقط فريسته."},{"fr":"se saisir de","ar":"يخطف / ينتزع","pos":"verbe","ipa":"[sə sɛ.ziʁ də]","exFr":"Le renard s'en saisit aussitôt.","exAr":"ينتزعها الثعلب فوراً."},{"fr":"la fable","ar":"الفابلو/الحكمة الشعرية","pos":"nom","g":"f","exFr":"Une fable de La Fontaine.","ipa":"[fabl]","exAr":"فابلو للافونتين."},{"fr":"le renard","ar":"الثعلب","pos":"nom","g":"m","exFr":"Le renard est rusé.","ipa":"[ʁənaʁ]","exAr":"الثعلب ماكر."},{"fr":"le corbeau","ar":"الغراب","pos":"nom","g":"m","exFr":"Le corbeau est perché.","ipa":"[kɔʁbo]","exAr":"الغراب عالٍ على الغصن."},{"fr":"le châtiment","ar":"العقاب","pos":"nom","g":"m","exFr":"Son châtiment arrive.","ipa":"[ʃatimɑ̃]","exAr":"عقابه آتي."},{"fr":"le flatteur","ar":"المُطَعِّم/الملمِس","pos":"nom","g":"m","exFr":"Méfie-toi des flatteurs.","ipa":"[flatœʁ]","exAr":"احذر المتملقين."},{"fr":"l'orgueil","ar":"الغرور","pos":"nom","g":"m","exFr":"L'orgueil a coûté cher.","ipa":"[ɔʁɡœj]","exAr":"الغرور كلّف غالياً."},{"fr":"la fourmi","ar":"النملة","pos":"nom","g":"f","exFr":"La fourmi prépare l'hiver.","ipa":"[fuʁmi]","exAr":"النملة تستعد للشتاء."},{"fr":"la grenouille","ar":"الضفدع","pos":"nom","g":"f","exFr":"La grenouille veut être grande.","ipa":"[ɡʁənuj]","exAr":"الضفدع يريد أن يكون كبيراً."},{"fr":"perché(e)","ar":"جالس عالياً على غصن","pos":"adj","exFr":"Un oiseau perché.","ipa":"[pɛʁʃe]","exAr":"طائر على غصن عالٍ."},{"fr":"rusé(e)","ar":"ماكر","pos":"adj","exFr":"Il est très rusé.","ipa":"[ʁyze]","exAr":"ماكر جداً."},{"fr":"les dépens de","ar":"على حساب","pos":"locution","exFr":"Vivre aux dépens des autres.","ipa":"[de pɑ̃ də]","exAr":"يعيش على حساب الآخرين."}],"grammar":[{"tFr":"Le discours indirect dans les fables","tAr":"القاعدة: النقل في الفابلو","body":["«Il a dit que...» ينقل القول بque + ترتيب، بينما الفابلو كثيراً تُبقي التلفظ مباشرة (guillemets) — تدرّب على التحويل: «Le renard a dit : tu es beau» ← «a dit qu'il était beau».","مع le passé simple الشاعري («Il mourut») — نادراً في B1 الكتابي لكنه مطلوب فهمه في القراءة الكلاسيكية."],"ex":[{"fr":"Le corbeau a crié : «Je suis beau !» → a dit qu'il était beau.","ar":"صاح الغراب: «أنا جميل!» ← قال إنه جميل."},{"fr":"Le lion fut touché par la souris.","ar":"لمس الأسد موسم الفأر."}]}],"mistakes":[{"wrong":"تحليل الرمز قبل فهم القصة","right":"الحبكة أولاً ثم الرمز","why":"الرمز بلا حكاية نظرية مجردة لا تثبت."},{"wrong":"الخلط بين moral وleçon","right":"moral = عبرة النص، leçon = درسك أنت","why":"خلط المصطلحات يُظهر ضعفاً في المفاهيم."},{"wrong":"تجاهل épisode-présent (فعل الأمر في الوصف)","right":"إعارته للفعل في السرد","why":"«Tu vois...» في الفابلو عنصر سردي لا نداء حقيقي."},{"wrong":"رفض الفابلو كقديم","right":"ربط رمزها بواقعة حديثة","why":"الامتحان يقيّم الربط الزمني لا الحفظ."}],"dialogues":[{"title":"مناقشة عبرة الحكاية","ctx":"طالبتان بعد قراءة Corbeau et Renard","lines":[{"who":"Amel","fr":"La morale est simple : méfie-toi des flatteurs.","ar":"العبرة بسيطة: احذر المتملقين."},{"who":"Rita","fr":"Moi je pense que le corbeau est aussi coupable.","ar":"أنا أرى أن الغراب أيضاً مذنب."},{"who":"Amel","fr":"Tu veux dire que l'orgueil est le vrai problème ?","ar":"تقصد أن الغرور هو المشكلة الحقيقية؟"},{"who":"Rita","fr":"Oui ! Sans orgueil, il n'aurait pas ouvert le bec.","ar":"نعم! بدون غرور، لم يكن سيفتح منقاره."},{"who":"Amel","fr":"Donc la fable parle des deux : flatteur et orgueilleux.","ar":"إذن الفابلو تتحدث عن الاثنين: المتملق والمتغطرس."},{"who":"Rita","fr":"C'est ça — deux responsabilités.","ar":"هذا هو — مسؤوليتان."}]}],"exercises":[{"t":"mcq","skill":"reading","q":"لماذا يفقد الغراب جبنه؟","opts":["لأنه جائع","لأنه افتخر بصوته وفتح منقاره","لأن الثعلب اقترب منه","لأن الريح هبت"],"a":1,"why":"الغراب وقع في فخ التملق: فتح منقاره ليغني فسقط الجبن."},{"t":"mcq","skill":"reading","q":"ما عبرة «الغراب والثعلب»؟","opts":["لا تحمل ما لا تستطيع","احذر المتملقين","الصبر مفتاح الفرج","الصداقة أغلى من الجبن"],"a":1,"why":"العبرة الصريحة في النص: tout flatteur vit aux dépens de celui qui l'écoute."},{"t":"fill","skill":"vocabulary","q":"أكمل: «Le renard s'___ du fromage.» (يخطف)","fr":"Le renard s'___ du fromage.","ans":"saisit","alts":["en saisit"],"why":"se saisir de = يخطف/ينتزع."},{"t":"order","skill":"reading","q":"رتّب أحداث الحكاية: (1) يفتح منقاره ليغني (2) الثعلب يمتدح الغراب (3) يسقط الجبن ويخطفه الثعلب","words":["Le","renard","flattait","le","corbeau."],"ans":"Le renard flattait le corbeau.","why":"التسلسل: تملق → غناء → سقوط وخطف."},{"t":"listen","skill":"listening","q":"Écoute la morale de la fable et choisis sa traduction :","audio":"Tout flatteur vit aux dépens de celui qui l'écoute","opts":["كل متملقٍ يعيش على حساب من يستمع إليه","كل نجم يضيء لمن ينظر إليه","كل صوت يُسمع لمن ينتظر","كل حكاية تُروى لمن يقرأ"],"a":0,"why":"هي العبرة الحرفية للفابل."},{"t":"speaking","skill":"speaking","q":"تعبّر عن رأيك شفوياً: هل الحكايات القديمة ما تزال مفيدة اليوم؟ اذكر سبباً واحداً.","target":"Je pense que les fables restent utiles parce qu'elles enseignent la sagesse simplement.","why":"التحدث الشفوي عن قيمة الحكاية يربط القراءة بالرأي المنتج — تدريب B1 على الدفاع عن موقف بجملة مقنعة بدلاً من حفظ العبرة حرفياً."},{"t":"mcq","skill":"reading","q":"لماذا تُقرأ خراف لافونتين في B1؟","opts":["لأنها قصيرة ومحكمة وتحمل المغزى","لأنها أطول من الرواية","لأنها بلا شخصيات","لأنها حديثة دائماً"],"a":0,"why":"الحكاية القصيرة المكثفة تجمع المفردات والمغزى معاً."},{"t":"translate","skill":"writing","q":"ترجم: «الصبر مفتاح النجاح.»","ans":"La patience est la clé du succès.","alts":["la patience est la cle du succes","La patience est la cle du succes"],"why":"la clé de = مفتاح، مع du قبل اسم مذكر مفرد."}],"homework":"اقرأ فابلاً إضافية واحدة (La Cigale et la Fourmi أو Le Lièvre et la Tortue) واكتب عبرتها بالفرنسية في جملتين.","sources":[{"title":"شرح سهل بالعربية لدروس اللغة الفرنسية La Fable: قصة أبطالها حيوانات","channel":"الاستاذة ياسمين","videoId":"c9nUWv7K380","why":"مدخل عربي شامل للفابلو: بنية القصة وأبطالها الحيوانات والعبرة — يسبق ويجهّز قراءة Corbeau et Renard النموذجية.","cat":"Stories","level":"B1","main":true,"dur":12},{"title":"Fable de la Fontaine expliquée : La cigale et la fourmi","channel":"Le français c'est facile ! avec Adrien","videoId":"83Pd_SaDqHU","why":"حكاية لافونتين مشروحة سطراً سطراً بالفرنسية الحديثة — يريك كيف تُقرأ النصوص الكلاسيكية وتُفهم عبراتها دون خوف من اللغة القديمة.","cat":"Stories","level":"B1","extra":true},{"title":"Le Corbeau et le Renard | Fable de La Fontaine | dessin animé en français","channel":"Les P'tits z'Amis","videoId":"STb_QERzEck","why":"حكاية الغراب والثعلب كرسوم متحركة — المشاهدة بعد القراءة تثبّت المشهد والحوارات في الذاكرة البصرية والسمعية معاً.","cat":"Stories","level":"B1","extra":true},{"title":"HISTOIRE POUR PROGRESSER EN FRANÇAIS : 1. NUIT À LA BELLE ÉTOILE 🌟","channel":"Le French Club","videoId":"PNTQlDVcMtk","why":"قصة متدرجة لمتعلمي الفرنسية من قناة تعليمية متخصصة — جسر بين الحكاية الكلاسيكية والقصة المعاصرة: نفس هدف الاستخراج (الفهم ثم الرأي) بلغة اليوم.","cat":"Stories","level":"B1","extra":true}],"supplements":[{"id":"83Pd_SaDqHU","title":"Fable de la Fontaine expliquée : La cigale et la fourmi","channel":"Le français c'est facile ! avec Adrien","why":"حكاية لافونتين مشروحة سطراً سطراً بالفرنسية الحديثة — يريك كيف تُقرأ النصوص الكلاسيكية وتُفهم عبراتها دون خوف من اللغة القديمة.","lang":"fr"},{"id":"STb_QERzEck","title":"Le Corbeau et le Renard | Fable de La Fontaine | dessin animé en français","channel":"Les P'tits z'Amis","why":"حكاية الغراب والثعلب كرسوم متحركة — المشاهدة بعد القراءة تثبّت المشهد والحوارات في الذاكرة البصرية والسمعية معاً.","lang":"fr"},{"id":"PNTQlDVcMtk","title":"HISTOIRE POUR PROGRESSER EN FRANÇAIS : 1. NUIT À LA BELLE ÉTOILE 🌟","channel":"Le French Club","why":"قصة متدرجة لمتعلمي الفرنسية من قناة تعليمية متخصصة — جسر بين الحكاية الكلاسيكية والقصة المعاصرة: نفس هدف الاستخراج (الفهم ثم الرأي) بلغة اليوم.","lang":"fr"}]},{"id":"B1-t2-l3","fr":"Des vlogs et des classiques","ar":"من الفلوغ إلى الكلاسيكيات: القراءة الممتدة","objectives":["قراءة/متابعة قصص الحياة الواقعية (فلوغ) والروايات المبسطة","القراءة الممتدة (lecture extensive) لتكوين مفردات طبيعية","التعامل مع نص طويل دون فهم كل كلمة"],"sections":[{"h":"القراءة الممتدة: كيف تقرأ كثيراً دون إنهاك؟","p":["القراءة الممتدة (la lecture extensive) مبدأ بسيط وصارم: كميات طويلة، سرعة مريحة، فهم عام بلا قاموس، ومتعة قبل التحليل. خلافها للقراءة المكثفة (intensive): هناك نص قصير تحقّق كل كلمة، وهنا رواية تُتقن معناها لا كلماتها.","كيف تقرأ كثيراً دون إنهاك؟ بقاعدة 80%: إن فهمت 80% من نص دون قاموس فأنت في المستوى الصحيح لكتابه؛ إن فهمت 50% فالنص أصعب منك مؤقتاً. هذا القانون الواحد يختار لك كتابك ويمنعك من رمي كتاب جيد لأن 20 كلمة مجهولة.","تابع الفيديو الأساسي بالشرح العربي: استراتيجيات القراءة الممتدة — كيف تبني عادة القراءة الطويلة من 10 صفحات يومياً. المفتاح: لا تقرأ في ساعة واحدة ضائعة بل في جُمل وقت محفوظ (قبل النوم، في المواصلات) — الاستمرار المقطّع يصلح والمكثف المؤجَّل يفشل.","من الفلوغ إلى الرواية: التدرّج الحقيقي A2 ← B1 ← B2 يمر عبر blog posts ← récits courts ← chapitres. قاعدة: قف فوق مستوى كتابك درجتين لا عشر — الكتاب الصعب بلا متعة يقتل الإيقاع، والكتاب الملائم يبني 1000 كلمة مكتسبة بالتكرار.","الأمير الصغير كأول رواية كاملة: 9 فصول قصيرة، لغة شعرية بسيطة، ورموز واضحة (الثعلب، الوردة، البئر). النسخة ثنائية اللغة أو المسموعة مع النص تُغنيك عن قاموس يقطع الفصل. اقرأ الفصل ثم لخّصه بجملتين — الفصل القصير يجعل الملخص إنجازاً يومياً.","قياس تقدّمك بلا معاناة: 3 مؤشرات — سرعة (صفحات/ساعة)، معجم مكتسب (كلمة جديدة كل صفحة تدخل بطاقتك)، وثقة (معركة القاموس تنقر!). عند تجاوز 20 صفحة/ساعة دون قاموس، أنت B2 في القراءة عملياً — الامتحان يأتي لاحقاً."],"video":{"id":"iSTaazMi5rM","title":"Le Petit Prince || تعلم اللغة الفرنسية || Prof. Aziz Abderrahman","channel":"أكاديمية رصانة Rassana Academy","why":"الأمير الصغير في سياق تعلم الفرنسية: مدخل للنص الكامل بأبيات وبطء مناسب لقراءة الرواية الأولى في B1.","lang":"ar","main":true,"dur":12},"sub":[{"h":"مبدأ 80% ونوعا القراءة","p":["extensive: طويل، سريع، بلا قاموس.","intensive: قصير، تحقّق كل كلمة.","80% فهم ← أنت في مستواك.","50% ← الكتاب أصعب مؤقتاً."]},{"h":"التدرّج: فلوغ ← قصة ← رواية","p":["blogs → récits → chapitres.","قف فوق مستواك درجتين لا عشر.","النص ثنائي اللغة أو مسموع+نص.","المتعة شرط لا رفاهية."]},{"h":"الأمير الصغير: أول رواية","p":["9 فصول قصيرة تُنجز يومياً.","رموز واضحة: الثعلب، الوردة، البئر.","ملخص بجُملتين بعد كل فصل.","النسخة المسموعة تُغني عن القاموس."]}]},{"h":"من الفلوغ إلى الرواية: تدرّج القراءة","p":["سلّم القراءة الممتدة الواقعي لمتعلم B1: المرحلة 1 — فلوغات مترجمة (Easy French, French Facile). المرحلة 2 — حوارات مترجمة وقصص قصيرة منقولة للناطقين بالمستوى (méthodes B1). المرحلة 3 — قصص أطفال وقصص مصورة (BD) مثل Petit Nicolas. المرحلة 4 — روايات مبسطة (lectures adaptées B1) من داري Hachette FLE أو CLE. كل مرحلة أسبوعان إلى شهر — ولا تعق، فالترقية تأتي وحدها.","كيف تعرف أنك جاهز للمرحلة التالية؟ عندما تفهم 90% من النص الحالي دون جهد. إذا كنت لا تزال تترجم في رأسك جملة بجملة، ابقَ في مرحلتك أسبوعين آخرين.","قاعدة الوقت: 10 صفحات × 20 يوماً في الشهر = 200 صفحة = رواية كاملة. المدارس توصي بأربع كتب سنوياً — هدف واقعي لقارئ B1 هو كتابان كاملان في الأشهر الثلاثة القادمة."],"video":null},{"h":"الأمير الصغير: أول رواية كاملة لك","p":["Le Petit Prince (1943) هو الرواية الفرنسية الأكثر ترجمة في العالم، ولغتها بسيطة لكنها عميقة — السبب في أنها أفضل «رواية أولى» للمتعلمين. قراءتها كاملة (ساعة ونصف تقريباً في هذه السلسلة) مع المتحدث الأصلي تمنحك جرعة سمعية قرائية غير عادية.","جرّب أسلوب «القراءة على مراحل»: أسبوع واحد لكل 3 فصول — استمع دون قراءة (فهم عام)، ثم استمع مع النص (التقط التفاصيل)، ثم اقرأ بصوت عالٍ فقرة تحبها واحفظ اقتباساً واحداً. مثل: «On ne voit bien qu'avec le cœur. L'essentiel est invisible pour les yeux.» — لا نرى جيداً إلا بالقلب؛ الجوهر لا تراه العيون.","بعد الفيديو الإثرائي: افتح قائمة قراءة (liste de lecture) بثلاثة كتب ملائمة: واحدة ترفيهية، واحدة سفر/تاريخ، واحدة قصص قصيرة. التنويع يمنع الرتابة ويبني معجماً متنوعاً."],"video":null},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: تعلّمت مبدأ القراءة الممتدة وقاعدة 80%، وسلّم التدرّج من الفلوغ إلى الرواية، وبدأت رحلتك مع «الأمير الصغير» كأول رواية كاملة. أعد مشاهدة الفيديو الرئيسي وركّز على بناء عادة القراءة الطويلة من عشر صفحات يومياً بلا قاموس.","جسر الدروس: من B1-t2-l2 (حكايات لافونتين: الغراب والثعلب) إلى B1-t2-l3 (من الفلوغ إلى الكلاسيكيات: القراءة الممتدة)، ثم إلى B1-t3-l1 حيث تتقن الشرطي للتهذيب والتمني والاقتراح والنقد اللطيف.","مهمة تطبيقية: سجّل نفسك دقيقة وأنت تلخّص الدرس وتعيد استخدام 3 كلمات جديدة، ثم قارن نطقك بالفيديو الرئيسي."]}],"examples":[{"fr":"Je regarde des vlogs français sans sous-titres maintenant.","ar":"أشاهد الفلوغات الفرنسية الآن دون ترجمة."},{"fr":"On ne voit bien qu'avec le cœur.","ar":"لا نرى جيداً إلا بالقلب (الأمير الصغير)."},{"fr":"Je lis dix pages par soir, sans dictionnaire.","ar":"أقرأ عشر صفحات كل مساء، بلا قاموس."},{"fr":"Cette expression me rappelle une chanson.","ar":"هذه العبارة تذكرني بأغنية."},{"fr":"Je lis dix pages avant de dormir.","ar":"أقرأ عشر صفحات قبل النوم.","note":"الجُمل الوقتية"},{"fr":"Si je comprends 80 %, le livre est pour moi.","ar":"إن فهمت 80% فالكتاب لي.","note":"قاعدة 80%"},{"fr":"Le Petit Prince : neuf chapitres courts.","ar":"الأمير الصغير: تسعة فصول قصيرة.","note":"أول رواية"},{"fr":"Je note les mots nouveaux dans un carnet.","ar":"أدوّن الكلمات الجديدة في دفتر.","note":"المعجم المكتسب"}],"pron":[{"w":"un vlog","ipa":"[vlɔɡ]","approx":"فلُوگ"},{"w":"l'essentiel","ipa":"[le.sɑ̃.sjɛl]","approx":"ليسان-سييل"},{"w":"une auberge","ipa":"[o.bɛʁʒ]","approx":"أو-بِرژ"}],"vocab":[{"fr":"la lecture extensive","ar":"القراءة الممتدة (للألوف لا للتحليل)","pos":"expression","ipa":"[la.lyk.tyʁ ɛk.stɑ̃.siv]","exFr":"La lecture extensive développe le vocabulaire.","exAr":"القراءة الممتدة تنمّي المفردات."},{"fr":"un chapitre","ar":"فصل (كتاب)","pos":"nom","g":"m","pl":"des chapitres","ipa":"[ʃa.pitʁ]","exFr":"Un chapitre par jour suffit.","exAr":"فصل واحد يومياً يكفي."},{"fr":"un classique","ar":"عمل كلاسيكي خالد (رواية/فيلم)","pos":"nom","g":"m","ipa":"[œ̃ klasik]","exFr":"Le Petit Prince est un classique de la littérature française.","exAr":"«الأمير الصغير» من كلاسيكيات الأدب الفرنسي."},{"fr":"rappeler","ar":"يذكّر بـ","pos":"verbe","ipa":"[ʁa.pə.le]","exFr":"Cette histoire me rappelle mon enfance.","exAr":"هذه القصة تذكرني بطفولتي."},{"fr":"sans effort","ar":"دون جهد","pos":"expression","ipa":"[sɑ̃ zə.fɔʁ]","exFr":"Il comprend 90% sans effort.","exAr":"يفهم 90% دون جهد."},{"fr":"au bord du fleuve","ar":"على ضفة النهر","pos":"expression","ipa":"[o bɔʁ dy flœv]","exFr":"Nous marchions au bord du fleuve.","exAr":"كنا نمشي على ضفة النهر."},{"fr":"une intrigue","ar":"حبكة الرواية","pos":"nom","g":"f","exFr":"L'intrigue est captivante.","ipa":"[ɑ̃tʁiɡ]","exAr":"الحبكة آسرة."},{"fr":"soutenir","ar":"يستوعب بصعوبة","pos":"verbe","g":"irr","exFr":"Ce livre est trop soutenu pour moi.","ipa":"[sutniʁ]","exAr":"هذا الكتاب صعب جداً عليّ."},{"fr":"relativement","ar":"نسبياً","pos":"adv","exFr":"Un livre relativement facile.","ipa":"[ʁativlmɑ̃]","exAr":"كتاب سهل نسبياً."},{"fr":"tenir une liste","ar":"يُبقي قائمة","pos":"locution","exFr":"Tiens une liste de lectures.","ipa":"[təniʁ]","exAr":"أبقِ قائمة قراءة."},{"fr":"abandonner","ar":"يتخلى عن","pos":"verbe","g":"1er","exFr":"N'abandonne pas un livre facile.","ipa":"[abandɔne]","exAr":"لا تتخلى عن كتاب سهل."},{"fr":"le rythme","ar":"الإيقاع","pos":"nom","g":"m","exFr":"Trouve ton rythme.","ipa":"[ʁitm]","exAr":"اعثر على إيقاعك."},{"fr":"un best-seller","ar":"الأكثر مبيعاً","pos":"nom","g":"m","exFr":"Un best-seller traduit.","ipa":"[bɛst sɛlœʁ]","exAr":"رواية تُرجمت."},{"fr":"s'immerger","ar":"يغوص في","pos":"verbe","g":"—","exFr":"S'immerger dans un roman.","ipa":"[imɛʁʒe]","exAr":"الغوص في رواية."},{"fr":"la traduction","ar":"الترجمة","pos":"nom","g":"f","exFr":"Lire la traduction puis l'original.","ipa":"[tʁaduksjɔ̃]","exAr":"اقرأ الترجمة ثم الأصل."},{"fr":"fluide / à l'aise","ar":"طليق/مرتاح","pos":"adj","exFr":"Lecture fluide.","ipa":"[flɥid]","exAr":"قراءة طليقة."}],"grammar":[{"tFr":"Les linkers dans un résumé de lecture","tAr":"القاعدة: روابط الملخص","body":["الملخص يقوده: d'abord (البداية), ensuite (تطور), finalement (النهاية), car (سبب), donc (نتيجة) — خمسة روابط تكفي ملخص أي فصل.","مع le présent de vérité générale في الحديث عن الرواية: «Le héros cherche...» لا يذهب للماضي تلقائياً — الحبكة تُروى بالمعرفة الفعلية."],"ex":[{"fr":"D'abord le héros part, ensuite il rencontre le renard, finalement il comprend.","ar":"أولاً يرحل البطل، ثم يلتقي الثعلب، أخيراً يفهم."},{"fr":"Le livre parle d'amitié, donc il est universel.","ar":"الكتاب يتحدث عن الصداقة، إذن فهو عالمي."}]}],"mistakes":[{"wrong":"القاموس عند كل كلمة في رواية","right":"قاعدة 80% والاستغناء","why":"القاموس المفرط يقتل المتعة والإيقاع معاً."},{"wrong":"اختيار كتاب أصعب من مستواك بعشر درجات","right":"درجتان فوق مستواك","why":"الصعوبة المفرطة تُنتج إحباطاً لا معجماً."},{"wrong":"القراءة بلا وقت ثابت","right":"10 صفحات في جُمل يومية","why":"الوقت الثابت يبني العادة، والمواعيد العشوائية تموت."},{"wrong":"قراءة ترجمة عربيًا فقط","right":"فرنسي أولاً ثم الترجمة عند الحاجة","why":"الترجمة المباشرة تبني معجم العربية لا الفرنسية."}],"dialogues":[{"title":"اختيار كتاب","ctx":"صديقان في المكتبة","lines":[{"who":"Mehdi","fr":"Tu lis quoi en ce moment ?","ar":"ماذا تقرأ حالياً؟"},{"who":"Lina","fr":"Le Petit Prince — ma première vraie lecture.","ar":"الأمير الصغير — أول قراءة حقيقية لي."},{"who":"Mehdi","fr":"Tu utilises un dictionnaire ?","ar":"هل تستخدم قاموساً؟"},{"who":"Lina","fr":"Seulement si je comprends moins de 80 %.","ar":"فقط إن فهمت أقل من 80%."},{"who":"Mehdi","fr":"Bonne règle ! Tu lis combien par jour ?","ar":"قاعدة جيدة! كم تقرأ يومياً؟"},{"who":"Lina","fr":"Dix pages avant de dormir. C'est tenable.","ar":"عشر صفحات قبل النوم. هذا ممكن."}]}],"exercises":[{"t":"mcq","skill":"reading","q":"في القراءة الممتدة، متى تتوقف لترجمة كلمة؟","opts":["عند كل كلمة جديدة","فقط إذا منعت الكلمة فهم الجملة كلها","كل خمس دقائق","لا أتوقف أبداً أبداً حتى في الفهم"],"a":1,"why":"قاعدة اللفتة الكبرى: انقطع فقط إذا انكسر الفهم الكلي."},{"t":"mcq","skill":"reading","q":"لماذا «الأمير الصغير» أول رواية مناسبة لـ B1؟","opts":["لأنها للأطفال الصغار فقط","لأن لغتها بسيطة لكنها عميقة ومألوفة عالمياً","لأنها قصيرة جداً","لأنها قصيدة"],"a":1,"why":"بساطة اللغة مع عمق المعنى وألفة القصة تجعلها المثالية."},{"t":"fill","skill":"vocabulary","q":"أكمل: «On ne voit bien qu'avec le ___.»","fr":"On ne voit bien qu'avec le ___.","ans":"cœur","alts":["coeur","chœur"],"why":"اقتباس شهير: لا نرى إلا بالقلب."},{"t":"order","skill":"reading","q":"رتّب سلّم القراءة الممتدة: (1) فلوغات مترجمة (2) روايات مبسطة B1 (3) قصص مصورة BD","words":["D'abord","les","vlogs."],"ans":"D'abord les vlogs.","why":"التدرج: فيديو مترجم → BD → رواية مبسطة."},{"t":"listen","skill":"listening","q":"Écoute la phrase sur le souvenir et choisis sa traduction exacte :","audio":"Cette histoire me rappelle mon enfance","opts":["هذه القصة تنسيني طفولتي","هذه القصة تذكرني بطفولتي","أروي قصة عن طفولتي","قصة طفولتي طويلة"],"a":1,"why":"rappeler à = يذكّر بـ."},{"t":"writing","skill":"writing","q":"اختر رواية أو فلوغاً واكتب 4 أسطر عنه: ماذا قرأت؟ ما الفكرة؟ ماذا أعجبك؟ هل تنصح به؟","min":20,"kw":["j'ai lu","histoire","je recommande"],"sample":"J'ai lu les premiers chapitres du Petit Prince cette semaine. C'est l'histoire d'un pilote perdu dans le désert qui rencontre un petit prince. J'aime beaucoup la simplicité des phrases et la profondeur des idées. Je recommande ce livre à tous les apprenants.","why":"كتابة تقييم قصير لكتاب تقرأه تحوّل القراءة الممتدة إلى إنتاج لغوي — مفرداتك المكتسبة بالتكرار تدخل سياقاً حقيقياً مقنعاً لمن يسمعك أو يقرأك."},{"t":"mcq","skill":"reading","q":"ضد الإرهاق أثناء القراءة الممتدة:","opts":["جلسات قصيرة منتظمة مع تلخيص","ساعات متواصلة بلا توقف","قراءة متعددة الكتب معاً","التوقف عند كل كلمة"],"a":0,"why":"الجلسات المنتظمة مع التلخيص تبني التحمّل وتثبت الفهم."},{"t":"fill","skill":"reading","q":"أكمل: «Après chaque chapitre, je ___ (résumer) les idées.»","fr":"Après chaque chapitre, je ___ les idées.","ans":"résume","alts":["résumé","Résume"],"why":"مع après كل مرة ← المضارع: résume."}],"homework":"ابدأ «تحدي الأمير الصغير»: فصلان أسبوعياً بأربع جلسات (استمع → استمع مع نص → اقرأ بصوت عالٍ → دوّن اقتباساً).","sources":[{"title":"Le Petit Prince || تعلم اللغة الفرنسية || Prof. Aziz Abderrahman","channel":"أكاديمية رصانة Rassana Academy","videoId":"iSTaazMi5rM","why":"الأمير الصغير في سياق تعلم الفرنسية: مدخل للنص الكامل بأبيات وبطء مناسب لقراءة الرواية الأولى في B1.","cat":"Stories","level":"B1","main":true,"dur":12},{"title":"Learn French the right way | Listening Practice in France | (FR/EN Subtitles) Vlog","channel":"French Facile","videoId":"iuobB2Utcgc","why":"فلوغ حقيقي من فرنسا بترجمة مزدوجة — قصة يومية عفوية تدرّبك على لغة الحياة لا لغة الكتب فقط.","cat":"Stories","level":"B1","extra":true},{"title":"Having Breakfast in Slow French | Super Easy French 152","channel":"Easy French","videoId":"40IAXVvjSDA","why":"فلوغ «فطور بالفرنسية البطيئة» — نقطة بداية مثالية للقراءة الممتدة: سرعة مريحة وترجمة مزدوجة ومشهد يومي بسيط.","cat":"Stories","level":"B1","extra":true},{"title":"Le petit prince The little prince French All chapters read by native French speaker","channel":"Français facile avec Cyril","videoId":"BvVhMwZ2HCA","why":"قراءة كاملة لرواية «الأمير الصغير» بلهجة أصلية هادئة — الكلاسيكيات المبسطة: وجهتك النهائية في القراءة الممتدة عند المستوى B1.","cat":"Stories","level":"B1","extra":true}],"supplements":[{"id":"iuobB2Utcgc","title":"Learn French the right way | Listening Practice in France | (FR/EN Subtitles) Vlog","channel":"French Facile","why":"فلوغ حقيقي من فرنسا بترجمة مزدوجة — قصة يومية عفوية تدرّبك على لغة الحياة لا لغة الكتب فقط.","lang":"fr"},{"id":"40IAXVvjSDA","title":"Having Breakfast in Slow French | Super Easy French 152","channel":"Easy French","why":"فلوغ «فطور بالفرنسية البطيئة» — نقطة بداية مثالية للقراءة الممتدة: سرعة مريحة وترجمة مزدوجة ومشهد يومي بسيط.","lang":"en"},{"id":"BvVhMwZ2HCA","title":"Le petit prince The little prince French All chapters read by native French speaker","channel":"Français facile avec Cyril","why":"قراءة كاملة لرواية «الأمير الصغير» بلهجة أصلية هادئة — الكلاسيكيات المبسطة: وجهتك النهائية في القراءة الممتدة عند المستوى B1.","lang":"fr"}]}]},{"id":"b1-t3","slug":"grammar","icon":"✏️","color":"#7C3AED","fr":"Grammaire avancée","ar":"مسار القواعد","desc":"قلب المستوى المتوسط: الشرطي والافتراضات، النقل غير المباشر، والماضي الأسبق وتناسق الأزمنة — أدوات بناء كلام مستقل.","lessons":[{"id":"B1-t3-l1","fr":"Le conditionnel : voudrais, pourrais, aimerais","ar":"الشرطي: أود، أستطيع، أحببت","objectives":["تكوين الشرطي الحاضر وتذكر نهاياته الثلاث","استخدامه للتهذيب والرغبة والاقتراح","بناء افتراضات «Si + imparfait + conditionnel»"],"sections":[{"h":"التكوين: جذع الفوتور + نهايات الأونفه","p":["التكوين أبسط مما يبدو: جذع futur simple نفسه + نهايات imparfait. «il partirait» = il part- (مستقبل) + -ait (مضارع). من صورة واحدة تُشتق كل الأفعال الشاذة أيضاً: serais, aurais, irais, ferais — أربع صور تُغنيك عن أخطاء التصريف.","الشرط الماضي (conditionnel passé) يسبق المستقبل: avoir/être في الشرطي + participe passé = «j'aurais aimé» (كنت أودّ). الصيغة تفتح باب الندم والتمني والتبرير: «Si j'avais su, j'aurais pris l'autre train» — حزمة كاملة لجملة واحدة.","تابع الفيديو الأساسي بالشرح العربي بمستوى DELF B1: الشرطي الحاضر والماضي مع قيمه — لاحظ أن الفيديو يبني «j'irais» ثم ينتقل لـ «si j'étais allé» — نفس التدرّج الذي تحفظه: تكوين ثم استعمال ثم الندم.","الشرطي الماضي: الندم والنقد اللطيف. «Vous auriez pu m'appeler...» (كان بإمكانك أن تتصل بي...) اتهام مهذّب يُسمَع فيه الأسف لا الغضب. هذه النبرة — تُلام فيها دون أن تجرح — هي مهارة B1 الاجتماعية الحقيقية.","لافتراضات: عالم Si. si + imparfait ← conditionnel présent (شرط واقعي: «S'il pleuvait, je resterais»)، وsi + plus-que-parfait ← conditionnel passé (شرط غير واقعي نسبياً: «S'il avait pleuvu, je serais resté»). أما «si + futur» فخطأ قاتل: si لا يأخذ futur أبداً.","الاستعمالات الأربعة لشرطية واحدة: التمني (J'aimerais...), الاقتراح المهذّب (On pourrait...), الشك اللطيف (Il serait...), والبُشرى المشروطة (Ce serait bien si...). تدرّب على أربع جمل لصيغة واحدة — الترجمة الذهنية تفشل عند الواحدة، والتطبيق بالسياقات يثبتها."],"video":{"id":"AtqNylHiQPw","title":"شرح الشرط في اللغة الفرنسية la condition DELF B1","channel":"فرنشاوي Frenchawy","why":"الشرط بمستوى DELF B1 صراحةً: قيم الشرطية وsi وحالات الندم والتمني — تغطي الدرس كاملاً بمستوى الامتحان.","lang":"ar","main":true,"dur":23},"sub":[{"h":"التكوين: مستقبل + نهايات ماضية","p":["part- + -ait → il partirait.","الشاذات: serais / aurais / irais / ferais.","conditionnel passé: j'aurais aimé.","قاعدة واحدة تصوغ الجدول كله."]},{"h":"القيم الأربعة","p":["التمني: J'aimerais voyager.","الاقتراح: On pourrait partir.","الشك: Il serait à Paris.","النقد اللطيف: Vous auriez pu... ."]},{"h":"عالم Si: ثلاث قواعد لا رابعة","p":["si + imparfait ← conditionnel (واقعي).","si + plus-que-parfait ← conditionnel passé.","si + futur ← خطأ قاتل ممنوع.","Si j'avais su, j'aurais appelé."]}]},{"h":"الشرطي الماضي: الندم والنقد اللطيف","p":["الشرطي الماضي = être/avoir في الشرطي + participe passé: j'aurais aimé، je serais venu. وظيفته الأساسية عند B1: التعبير عن الندم والنقد على أمر ماضٍ. «J'aurais dû réserver» (كان ينبغي أن أحجز — فلم أفعل)، «Tu aurais pu me prévenir !» (كان يمكن أن تنذرني!)، «J'aurais aimé venir, mais j'étais malade» (تمنيت المجيء لكنني كنت مريضاً).","لاحظ الفارق الدقيق الذي يميّز B1: «J'aurais dû» = لم أفعل وأنا آسف؛ «J'aurais pu» = أمكنني ولم أفعل. كلاهما أهدأ من «Tu devais / tu pouvais» اللتين تبدوان تهماً. في الحوارات المهنية، النقد بالشرطي الماضي هو الطريقة الوحيدة المهذبة: «On aurait pu gagner du temps» بدل «Vous avez perdu du temps !»","الفارق بين «il devrait» و«il devrait bien»: الأداة well/ bien تحوّل الاقتراح إلى إرشاد لطيف («Tu devrais bien dormir» = من الحسن أن تنام). هذه الفروق الدقيقة هي ما يميّز منتج B1 عن منتج A2 في الكتابة."],"video":null},{"h":"لافتراضات: عالم Si","p":["الافتراضات ثلاث طبقات مرتبة: 1) Si + مضارع + فوتور (واقعية): «Si tu veux, on partira demain». 2) Si + ناقص + شرطي (وهمية حاضرة): «Si j'avais de l'argent, je voyagerais» — لا أملك، لكن لو. 3) Si + ماضٍ أسبق + شرطي ماضٍ (وهمية ماضية): «Si j'avais su, je serais venu» — فات الأوان. السطعان الثاني والثالث هما مقصد B1.","الخطأ الشائع عالمياً: «Si j'aurais» — محرّم! بعد si في الافتراض لا يأتي مستقبل ولا شرطي أبداً: Si j'avais / si j'avais su. أما الشرطي فيقع في الجملة الثانية فقط. حفظ الجملتين المعجزة يكفي: «Si j'avais le temps, je ferais du sport» و«Si j'avais su, j'aurais agi différemment».","بعد الفيديو: اكتب أربع جمل لصيغة واحدة (تمنٍّ، اقتراح، شك، نقد لطيف) ثم جملة si شرطية واقعية وأخرى غير واقعية. ستة أسطر تُبقي الشرطي نشطاً في ذاكرتك أسبوعاً كاملاً."],"video":null},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: تعلّمت تكوين الشرطي من جذع الفوتور ونهايات الأونفه، وأربعة استعمالات لصيغة واحدة (تمنٍّ، اقتراح، شك، نقد لطيف)، ونظام si الثلاثي الممنوع من futur. أعد مشاهدة الفيديو الرئيسي وركّز على الفرق بين الندم بالشرطي الماضي والنقد المباشر.","جسر الدروس: من B1-t2-l3 (من الفلوغ إلى الكلاسيكيات: القراءة الممتدة) إلى B1-t3-l1 (الشرطي: أود، أستطيع، أحببت)، ثم إلى B1-t3-l2 حيث تنقل الكلام بـ que وتُطابق الضمائر والأزمنة.","مهمة تطبيقية: سجّل نفسك دقيقة وأنت تلخّص الدرس وتعيد استخدام 3 كلمات جديدة، ثم قارن نطقك بالفيديو الرئيسي."]}],"examples":[{"fr":"Je voudrais réserver une table pour deux.","ar":"أود حجز طاولة لشخصين."},{"fr":"Pourriez-vous répéter, s'il vous plaît ?","ar":"هل يمكنكم التكرار من فضلكم؟"},{"fr":"Si j'avais de l'argent, je voyagerais au Maroc.","ar":"لو عندي مال، سافرت للمغرب."},{"fr":"J'aurais dû réserver plus tôt !","ar":"كان ينبغي أن أحجز أبكر!"},{"fr":"J'aimerais voyager plus souvent.","ar":"أتمنى أن أسافر أكثر.","note":"تمنٍّ"},{"fr":"Vous auriez pu m'appeler avant.","ar":"كان بإمكانك الاتصال بي قبل.","note":"نقد لطيف"},{"fr":"S'il pleuvait, je resterais à la maison.","ar":"لو تمطر، لبقيت في البيت.","note":"si + imparfait"},{"fr":"Si j'avais su, j'aurais pris le train.","ar":"لو كنت أعلم، لأخذت القطار.","note":"si + pqp"}],"pron":[{"w":"voudrais","ipa":"[vu.dʁɛ]","approx":"فود-ريه","note":"لا تخلطها مع vouloir/vole"},{"w":"pourriez-vous","ipa":"[pu.ʁje vu]","approx":"بور-ييه-فو"},{"w":"j'aurais dû","ipa":"[ʒo.ʁɛ dy]","approx":"جوريه-دو"}],"vocab":[{"fr":"je voudrais","ar":"أود (شرطي مهذب)","pos":"expression","ipa":"[ʒə vu.dʁɛ]","exFr":"Je voudrais commander, s'il vous plaît.","exAr":"أود الطلب من فضلك."},{"fr":"on pourrait","ar":"هل يمكننا (اقتراح)","pos":"expression","ipa":"[ɔ̃ pu.ʁɛ]","exFr":"On pourrait manger ensemble ?","exAr":"هل نأكل معاً؟"},{"fr":"j'aurais dû","ar":"كان ينبغي أن (ندم)","pos":"expression","ipa":"[ʒo.ʁɛ dy]","exFr":"J'aurais dû écouter ton conseil.","exAr":"كان ينبغي أن أتبع نصيحتك."},{"fr":"l'hypothèse","ar":"الافتراض","pos":"nom","g":"f","pl":"les hypothèses","ipa":"[li.pɔ.tɛz]","exFr":"C'est juste une hypothèse.","exAr":"هو مجرد افتراض."},{"fr":"réserver","ar":"يحجز","pos":"verbe","ipa":"[ʁe.zɛʁ.ve]","exFr":"Je voudrais réserver pour samedi.","exAr":"أود الحجز للسبت."},{"fr":"prévenir","ar":"يُعلم / ينبّه مسبقاً","pos":"verbe","ipa":"[pʁe.və.niʁ]","exFr":"Tu aurais pu me prévenir !","exAr":"كان يمكن أن تنذرني!"},{"fr":"le conditionnel","ar":"الشرطية","pos":"nom","g":"m","exFr":"Le conditionnel présente un souhait.","ipa":"[kɔ̃disjɔnɛl]","exAr":"الشرطية تُعبّر عن تمنٍّ."},{"fr":"le souhait","ar":"التمني/الرغبة","pos":"nom","g":"m","exFr":"Exprimer un souhait.","ipa":"[sɥɛ]","exAr":"التعبير عن تمنٍّ."},{"fr":"la politesse","ar":"الأدب/اللباقة","pos":"nom","g":"f","exFr":"Parler avec politesse.","ipa":"[pɔlitɛs]","exAr":"التكلم بلباقة."},{"fr":"reprocher","ar":"يلوم/يوجه لوماً","pos":"verbe","g":"1er","exFr":"Ne me fais pas de reproches.","ipa":"[ʁəpʁɔʃe]","exAr":"لا توجه إليّ لوماً."},{"fr":"tenter","ar":"يحاول/يُجرّب","pos":"verbe","g":"1er","exFr":"Il a tenté sa chance.","ipa":"[tɑ̃te]","exAr":"جرب حظه."},{"fr":"il faudrait","ar":"كان يجب/يُستحسن","pos":"locution","exFr":"Il faudrait partir tôt.","ipa":"[il fodʁɛ]","exAr":"يُستحسن المبادرة."},{"fr":"j'aurais aimé","ar":"كنت أودّ","pos":"locution","exFr":"J'aurais aimé venir.","ipa":"[ʒɔʁɛ ɛme]","exAr":"كنت أودّ المجيء."},{"fr":"hypothèse","ar":"افتراض","pos":"nom","g":"f","exFr":"C'est une hypothèse.","ipa":"[ipɔtɛz]","exAr":"إنه افتراض."},{"fr":"regretter","ar":"يندم على","pos":"verbe","g":"1er","exFr":"Il regrette son choix.","ipa":"[ʁəɡʁɛte]","exAr":"يندم على اختياره."},{"fr":"évidemment","ar":"بالطبع","pos":"adv","exFr":"Évidemment, j'aurais préféré.","ipa":"[evidamɑ̃]","exAr":"بالطبع، كنت لأفضّل."},{"fr":"peut-être","ar":"ربما","pos":"adv","exFr":"Il serait peut-être d'accord.","ipa":"[pøtɛtʁ]","exAr":"ربما كان سيوافق."}],"grammar":[{"tFr":"Le conditionnel présent et passé","tAr":"القاعدة: الشرطية الحاضرة والماضية","body":["التكوين: جذع futur + نهايات imparfait؛ الشاذات serais/aurais/irais/ferais.","Si يحكم الأزمنة: imparfait ← conditionnel، plus-que-parfait ← conditionnel passé، ولا يأخذ futur أبداً."],"ex":[{"fr":"Tu devrais dormir plus tôt.","ar":"كان يجب أن تنام باكراً."},{"fr":"Si j'étais riche, j'achèterais une maison.","ar":"لو كنت ثرياً، لاشتريت بيتاً."}]}],"mistakes":[{"wrong":"si + futur","right":"si + imparfait/plus-que-parfait","why":"«si j'irai» خطأ قاتل — si يغلق باب المستقبل."},{"wrong":"j'aurais allé (مع être)","right":"je serais allé","why":"si مع أفعال الحركة تأخذ être في الماضي الشرطي."},{"wrong":"الشرطية للشرط فقط","right":"التمني والاقتراح والشك والنقد","why":"الاستعمالات الأربعة هي استعمالات B1 الحقيقية."},{"wrong":"ترجمة الندم بـ je regrette دائماً","right":"si + pqp + conditionnel passé","why":"«لو كنت أعلم» بُنية فرنسية خاصة لا تُستبدل بالندم المباشر."}],"dialogues":[{"title":"نقد لطيف","ctx":"زميلان يخطئ أحدهما","lines":[{"who":"Farid","fr":"Tu n'as pas répondu à mon email.","ar":"لم ترد على بريدي."},{"who":"Lina","fr":"Oui... j'étais en déplacement.","ar":"نعم... كنت في سفر."},{"who":"Farid","fr":"Tu aurais pu me prévenir, tu sais.","ar":"كان بإمكانك إعلامي، تعلم."},{"who":"Lina","fr":"Tu as raison. J'aurais dû écrire deux mots.","ar":"أنت محق. كان يجب أن أكتب كلمتين."},{"who":"Farid","fr":"Ce serait bien que tu le fasses la prochaine fois.","ar":"من الجيد أن تفعل ذلك المرة القادمة."},{"who":"Lina","fr":"Promis — j'essaierai.","ar":"وعد — سأحاول."}]}],"exercises":[{"t":"mcq","skill":"grammar","q":"أيهما أهدأ عند طلب الطعام؟","opts":["Je veux un café","Je voudrais un café","Je voulais un café","Je voudrai un café"],"a":1,"why":"الشرطي je voudrais هو المهذب؛ je voudrai (مستقبل) خطأ شائع في النطق والكتابة معاً."},{"t":"mcq","skill":"grammar","q":"أكمل الافتراض الصحيح: «Si j'avais le temps, ___ du sport.»","opts":["je ferais","je ferai","si je ferais","j'avais fait"],"a":0,"why":"Si + imparfait → conditionnel: je ferais. ولا si قبل الشرطي أبداً."},{"t":"fill","skill":"grammar","q":"أكمل بالشرطي الماضي: «J'___ (devoir) écouter ton conseil.» (ندم)","fr":"J'___ écouter ton conseil.","ans":"aurais dû","alts":["aurais dût"],"why":"j'aurais dû + مصدر = الندم القياسي."},{"t":"order","skill":"grammar","q":"رتّب الافتراض الوهمي: (1) je voyagerais (2) Si j'avais de l'argent (3) — جملتان فقط","words":["Si","j'avais","le","temps,"],"ans":"Si j'avais le temps,","why":"Si + imparfait أولاً ثم الشرطي في الجملة الثانية."},{"t":"listen","skill":"listening","q":"استمع واختر الوظيفة:","audio":"Tu aurais pu me prévenir !","opts":["تهذيب طلب","نقد لطيف على ماضٍ","اقتراح مستقبلي","رغبة"],"a":1,"why":"الشرطي الماضي ici يعبّر عن إحراج/نقد لطيف: كان يمكن أن تنذرني."},{"t":"translate","skill":"writing","q":"ترجم: «لو كنت في مكانك، كنت سأقبل.»","ans":"À ta place, j'accepterais.","alts":["si j'etais toi j accepterais","si j'étais toi, j'accepterais"],"why":"النمط: à ta place أو si j'étais toi + شرطي."},{"t":"mcq","skill":"grammar","q":"قاعدة si + الزمن في الشرط الواقعي:","opts":["si + imparfait ← conditionnel présent","si + futur ← conditionnel","si + présent ← présent","si + passé ← présent"],"a":0,"why":"si لا تأخذ futur أبداً: si + imparfait ← conditionnel."},{"t":"fill","skill":"grammar","q":"أكمل: «S'il pleuvait, je ___ (rester) à la maison.»","fr":"S'il pleuvait, je ___ à la maison.","ans":"resterais","alts":["Resterais"],"why":"si + imparfait ← conditionnel présent du verbe rester."}],"homework":"اكتب 5 افتراضات عن حياتك بنمط Si + imparfait + conditionnel، واستخدم je voudrais في ثلاثة طلبات حقيقية اليوم.","sources":[{"title":"شرح الشرط في اللغة الفرنسية la condition DELF B1","channel":"فرنشاوي Frenchawy","videoId":"AtqNylHiQPw","why":"الشرط بمستوى DELF B1 صراحةً: قيم الشرطية وsi وحالات الندم والتمني — تغطي الدرس كاملاً بمستوى الامتحان.","cat":"Grammar","level":"B1","main":true,"dur":23},{"title":"Le Conditionnel Présent en français - [ Formation et utilisations ]","channel":"Parlez-vous FRENCH : Cours de français","videoId":"WXrLh5Knum0","why":"درس شامل ومهيكل لتكوين الشرطي الحاضر واستعمالاته الثلاثة — المرجع الأساسي الذي يغطي ما يحتاجه B1 كاملاً.","cat":"Grammar","level":"B1","extra":true},{"title":"CONDITIONNEL PRÉSENT ET PASSÉ - Leçon de grammaire complète avec exemples et exercices","channel":"Classe de français","videoId":"F7ST4x7Iqw4","why":"درس كامل بتمارين يغطي الشرطي الحاضر والماضي معاً مع تصحيح — التدرج الذي يحوّل القاعدة من نظرية إلى عادة استعمال.","cat":"Grammar","level":"B1","extra":true},{"title":"L'hypothèse en français","channel":"Le French Club","videoId":"2Ke0dKDJeSg","why":"شرح متكامل للافتراضات الثلاثة في الفرنسية — النظام الذي يربط الشرطي بجمل السي ويفتح لك التحدث عن المستويات الوهمية.","cat":"Grammar","level":"B1","extra":true}],"supplements":[{"id":"WXrLh5Knum0","title":"Le Conditionnel Présent en français - [ Formation et utilisations ]","channel":"Parlez-vous FRENCH : Cours de français","why":"درس شامل ومهيكل لتكوين الشرطي الحاضر واستعمالاته الثلاثة — المرجع الأساسي الذي يغطي ما يحتاجه B1 كاملاً.","lang":"fr"},{"id":"F7ST4x7Iqw4","title":"CONDITIONNEL PRÉSENT ET PASSÉ - Leçon de grammaire complète avec exemples et exercices","channel":"Classe de français","why":"درس كامل بتمارين يغطي الشرطي الحاضر والماضي معاً مع تصحيح — التدرج الذي يحوّل القاعدة من نظرية إلى عادة استعمال.","lang":"fr"},{"id":"2Ke0dKDJeSg","title":"L'hypothèse en français","channel":"Le French Club","why":"شرح متكامل للافتراضات الثلاثة في الفرنسية — النظام الذي يربط الشرطي بجمل السي ويفتح لك التحدث عن المستويات الوهمية.","lang":"fr"}]},{"id":"B1-t3-l2","fr":"Le discours rapporté","ar":"النقل غير المباشر: قال إنه سيأتي","objectives":["التحويل من النقل المباشر إلى غير المباشر مع الضمائر","إتقان تطابق الأزمنة عند النقل في الماضي","استخدام أفعال القول المتنوعة بدل dire"],"sections":[{"h":"من الحرف إلى الإحالة","p":["النقل (le discours indirect) مهندس مسافة: الخطاب المباشر يضع القول في علامات تنصيص، والنقل يزيحه بـ que ويعدّل الضمائر والأزمنة ليبقى على بُعد مهذّب من الكلام الأصلي. «Il a dit : «Je pars» ← Il a dit qu'il partait» — مسافة واحدة تُحدث ثلاثة تغييرات.","من الحرف إلى الإحالة: que تفتح النقل دائماً (ما لم يكن قولاً مباشراً بـ si)، ثم الضمائر تُحال: je → il, tu → il, nous → ils, me/te → lui/le. حفظ «je→il» يحل نصف مسألة: الفاعل يعود لغائب لأنه لم يعد يتكلم بنفسه.","تابع الفيديو الأساسي بالشرح العربي: جدول التحويل المرجعي كامل — لاحظ أن الفيديو يتعامل مع النقل كـ «تبويب»: الفعل (dit) ← الأداة (que) ← الضمائر ← الزمن. تبويب من أربع خانات يمنع الخلط أكثر من أي قاعدة منثورة.","الأسئلة والأوامر في النقل: السؤال يفقد صيغته ويعود جملة خبرية («Il a demandé si j'arrivais» / «Où habites-tu ?» ← Il a demandé où j'habite)، والأمر ينتقل لـ que + subjonctif («Il a demandé que je vienne»). الجملة الاسمية للأمر («Reste ici !» ← qu'il restât) شاهدك الأشهر.","تثبيت السلم الزمني: قال مضارع ← نقل بـ imparfait (direct: «Je suis fatigué» ← il dit qu'il était fatigué)، وقال مضارع منتهٍ ← plus-que-parfait. سلّم واحد: قال ← انزاح زمن واحد للوراء. لا تخترع سلماً لكل فعل.","النزاح المكاني في القول المكاني: «Viens ici !» ← «Il m'a demandé de venir ici» (هنا تبقى، أو «là» لتغيّر). الظروف (ici/là، demain/le lendemain، ce soir/ce soir-là) تنزاح مع الضمائر — تجاهلها يكشف نصاً ناقص التحويل."],"video":{"id":"QIwO5CgHQ9I","title":"مستحيل متفهمش le discours direct et indirect","channel":"Le français avec Nouma","why":"شرح بالعربية الكامل للنقل المباشر وغير المباشر بخطوات بسيطة وأمثلة مدرسية — أصلح خلفيتك بالعربية قبل التعمق بالفرنسية.","lang":"ar","main":true},"sub":[{"h":"محرّك النقل: que + ضمائر","p":["«Je pars» ← qu'il partait.","je → il / tu → il / nous → ils.","me → lui / te → lui / nous → les.","la particule que تفتح النقل دائماً."]},{"h":"السؤال والأمر في النقل","p":["si للسؤال النعم/لا.","où/quoi/qui تبقى مع que.","الأمر ← que + subjonctif.","«Reste !» ← qu'il reste."]},{"h":"السلّم الزمني والنزاح","p":["مضارع ← imparfait (انزاح واحد).","ماضٍ منتهٍ ← plus-que-parfait.","ici/there ← ici/là حسب السياق.","demain ← le lendemain."]}]},{"h":"الأسئلة والأوامر في النقل","p":["الأسئلة تحوّل بحالة: سؤال نعم/لا → si: «Tu viens ?» → Il m'a demandé si je venais. سؤال بـest-ce que → نفس si أو استبقاء أداة السؤال المقلوبة: «Qu'est-ce que tu fais ?» → Il m'a demandé ce que je faisais. سؤال بـqui/quoi/quand/où يحتفظ بأداته بصيغة ملتصقة: où → où، quand → quand. ولا ترتيب معكوس ولا استفهام بعد النقل: Il m'a demandé où j'habitais (وليس où habitais-je).","الأوامر تحوّل بـde + مصدر: «Ferme la porte !» → Il m'a dit de fermer la porte؛ «Ne fume pas !» → Il m'a dit de ne pas fumer. ومع أفعال الطلب: Il m'a demandé de / ordonné de / conseillé de. هذا النمط يخدمك مهنياً: إدارة الاجتماعات والتوجيهات كلها به.","مع أفعال القول المكثفة: affirmer/raconter تنقل بسهولة، بينما douter/nier يفرضان subjonctif («Il nie qu'il ait menti»). حدد نوع الفعل قبل الضمائر — الفعل هو مفتاح الباب."],"video":null},{"h":"تثبيت السلم: تمرين على النزاح","p":["درّب نفسك على السلم بمواقف واقعية: زميلك قال بالأمس «Je suis en retard» → Hier, il a dit qu'il était en retard. «J'ai fini le rapport» → Elle a annoncé qu'elle avait fini le rapport. «Je vous enverrai le compte-rendu» → Il a promis qu'il nous enverrait le compte-rendu. ثلاث جمل يومياً تثبّت النزاح في أسبوع.","انتبه للحالات التي لا ينزاح فيها الزمن: إذا كان فعل القول مضارعاً (Il dit qu'il viendra — المستقبل يبقى)؛ حقائق دائمة (La terre tourne → Il a dit que la terre tourne — الحقيقة العلمية تبقى مضارعاً عند بعض الناطقين، والتزم بالمضارع في الامتحانات إن كانت حقيقة عامة).","تمرين النقل المزدوج: خذ حواراً قصيراً من فيديو الفيد المُستثماري وأعِد كتابته كسرد واحد بـ «Il a dit que... Elle a demandé si... ». خمس جمل تُبقي المهارة سليمة لامتحان الكتابة."],"video":null},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: تعلّمت محرّك النقل — que + ضمائر مُحالَة + سلّم زمني للوراء + نزاح ظرفي — مع تحويل السؤال بـsi والأمر بـde + مصدر. أعد مشاهدة الفيديو الرئيسي وركّز على تبويب التحويل من أربع خانات: الفعل، الأداة، الضمائر، الزمن.","جسر الدروس: من B1-t3-l1 (الشرطي: أود، أستطيع، أحببت) إلى B1-t3-l2 (النقل غير المباشر: قال إنه سيأتي)، ثم إلى B1-t3-l3 حيث تُتقن الماضي الأسبق وتناسق الأزمنة في النسيج السردي.","مهمة تطبيقية: سجّل نفسك دقيقة وأنت تلخّص الدرس وتعيد استخدام 3 كلمات جديدة، ثم قارن نطقك بالفيديو الرئيسي."]}],"examples":[{"fr":"Il a dit qu'il viendrait le lendemain.","ar":"قال إنه سيأتي في اليوم التالي."},{"fr":"Elle m'a demandé si je venais à la réunion.","ar":"سألتني إن كنت سآتي الاجتماع."},{"fr":"Il m'a dit de fermer la porte.","ar":"قال لي أن أغلق الباب."},{"fr":"Elle a annoncé qu'elle avait fini le rapport.","ar":"أعلنت أنها أنهت التقرير."},{"fr":"Il a dit : « Je viens demain. » → Il a dit qu'il viendrait le lendemain.","ar":"قال: «سآتي غداً» ← قال إنه سيأتي اليوم التالي.","note":"ضمير + زمن + ظرف"},{"fr":"Elle a demandé : « Où habitent-ils ? » → Elle a demandé où ils habitaient.","ar":"سألت: «أين يسكنون؟» ← سألت أين كانوا يسكنون.","note":"سؤال"},{"fr":"Il a dit : « Reste ici ! » → Il a dit que je reste ici.","ar":"قال: «ابقَ هنا!» ← قال أبقى هنا.","note":"أمر"},{"fr":"Je nie que j'aie menti.","ar":"أنكرتُ أنني كذبت.","note":"subjonctif مع نفي"}],"pron":[{"w":"qu'il viendrait","ipa":"[kil vjɑ̃.dʁɛ]","approx":"كيل-فيان-درِه"},{"w":"la veille","ipa":"[la vɛj]","approx":"لا-ڤيه","note":"اليوم السابق (في النقل)"},{"w":"il m'a demandé si","ipa":"[il ma də.mɑ̃.de si]","approx":"إيل-ما-دهمان-ده-سي"}],"vocab":[{"fr":"le discours indirect","ar":"النقل غير المباشر","pos":"nom","g":"m","ipa":"[lə dis.kuʁ ɛ̃.di.ʁɛkt]","exFr":"Le discours indirect exige la concordance.","exAr":"النقل غير المباشر يتطلب مطابقة الأزمنة."},{"fr":"demander si","ar":"يسأل إن","pos":"expression","ipa":"[də.mɑ̃.de si]","exFr":"Il m'a demandé si j'étais prêt.","exAr":"سألني إن كنت جاهزاً."},{"fr":"le lendemain","ar":"اليوم التالي","pos":"nom","g":"m","ipa":"[lə lɑ̃.də.mɛ̃]","exFr":"Il promet de revenir le lendemain.","exAr":"يوعد بالعودة في اليوم التالي."},{"fr":"annoncer","ar":"يُعلن","pos":"verbe","ipa":"[a.nɔ̃.se]","exFr":"Elle a annoncé son départ.","exAr":"أعلنت رحيلها."},{"fr":"promettre de","ar":"يعد بـ","pos":"verbe","ipa":"[pʁɔ.mɛtʁ də]","exFr":"Il a promis de venir.","exAr":"وعد بأن يأتي."},{"fr":"la concordance des temps","ar":"مطابقة/تناسق الأزمنة","pos":"expression","ipa":"[la kɔ̃.kɔʁ.dɑ̃s de tɑ̃]","exFr":"La concordance des temps est essentielle au discours rapporté.","exAr":"تناسق الأزمنة جوهر النقل غير المباشر."},{"fr":"rapporter","ar":"ينقل/يروي","pos":"verbe","g":"1er","exFr":"Il a rapporté ses paroles.","ipa":"[ʁapɔʁte]","exAr":"نقل كلماته."},{"fr":"les paroles","ar":"الكلمات المنقولة","pos":"nom","g":"f","exFr":"Citer les paroles exactes.","ipa":"[paʁɔl]","exAr":"اقتباس الكلمات الدقيقة."},{"fr":"si (conjonction)","ar":"إن كان (للنقل)","pos":"conj","exFr":"Il a demandé si j'étais là.","ipa":"[si]","exAr":"سأل إن كنت هناك."},{"fr":"la nuance","ar":"الفارق الدقيق","pos":"nom","g":"f","exFr":"La nuance change tout.","ipa":"[nyɑ̃s]","exAr":"الفارق الدقيق يغيّر كل شيء."},{"fr":"déformer","ar":"يشوّه","pos":"verbe","g":"1er","exFr":"Ne déforme pas mes propos.","ipa":"[defɔʁme]","exAr":"لا تشوّه كلامي."},{"fr":"préciser","ar":"يوضّح","pos":"verbe","g":"1er","exFr":"Précise qui a parlé.","ipa":"[pʁesize]","exAr":"وضّح من تكلم."},{"fr":"demande / réponse","ar":"طلب / رد","pos":"nom","g":"f","exFr":"Il a demandé une réponse.","ipa":"[dəmɑ̃d]","exAr":"طلب جواباً."},{"fr":"hésiter","ar":"يتردد","pos":"verbe","g":"1er","exFr":"Il a hésité avant de répondre.","ipa":"[esite]","exAr":"تردد قبل أن يجيب."},{"fr":"le verbe de parole","ar":"فعل القول","pos":"nom","exFr":"dire, demander, affirmer...","ipa":"[vɛʁb də paʁɔl]","exAr":"يقول، يسأل، يؤكد..."},{"fr":"rapport fidèle","ar":"نقل أمين","pos":"nom","exFr":"Un rapport fidèle de l'entretien.","ipa":"[ʁapɔʁ fidɛl]","exAr":"نقل أمين للمقابلة."},{"fr":"atténuer","ar":"يخفف","pos":"verbe","g":"1er","exFr":"Il a atténué la critique.","ipa":"[aténye]","exAr":"خفّف النقد."}],"grammar":[{"tFr":"Discours direct / indirect","tAr":"القاعدة: الخطاب المباشر والنقل","body":["التحويل: que + ضمائر مُحالَة + سلّم زمني للوراء + نزاح ظرفي — أربع خانات تُفحصها بالترتيب.","si للسؤال النعم/لا، وque + subjonctif للأمر وبعضاً من أفعال النفي."],"ex":[{"fr":"«Tu as raison » → Il a dit que tu avais raison.","ar":"«أنت محق» ← قال إنك كنت محقاً."},{"fr":"«Attends-moi ! » → Il a demandé que tu l'attendes.","ar":"«انتظرني!» ← طلب أن تنتظره."}]}],"mistakes":[{"wrong":"تغيير je إلى tu في النقل","right":"je → il حسب الفاعل","why":"الضمير يتبع مَن نقل القول لا مَن يقرأ النص."},{"wrong":"إبقاء الأمر على صيغته","right":"que + subjonctif","why":"«Il a dit que reste» جملة مكسورة."},{"wrong":"نسيان النزاح الزمني","right":"انزاح واحد للوراء مع قال","why":"النقل يُبقي الزمن القديم قديماً — تركه مضارعاً يكشف خطأً."},{"wrong":"ci/là بلا تغيير","right":"ici → هنا أو هناك بحسب السياق","why":"الناقل يزيح المكان أيضاً — تجاهله يجعل النص متناقضاً."}],"dialogues":[{"title":"نقل ما قيل في اجتماع","ctx":"موظفان يتذاكران","lines":[{"who":"Samir","fr":"Le directeur a dit quoi exactement ?","ar":"ماذا قال المدير بالضبط؟"},{"who":"Nadia","fr":"Il a dit qu'il valait mieux reporter.","ar":"قال إنه من الأفضل التأجيل."},{"who":"Samir","fr":"Il a demandé si le projet était prêt ?","ar":"هل سأل إن كان المشروع جاهزاً؟"},{"who":"Nadia","fr":"Oui, et il a demandé que nous finissions vendredi.","ar":"نعم، وطلب أن ننجز بحلول الجمعة."},{"who":"Samir","fr":"Vendredi ? Il a dit ça devant tout le monde ?","ar":"الجمعة؟ قال ذلك أمام الجميع؟"},{"who":"Nadia","fr":"Devant tout le monde — mot pour mot.","ar":"أمام الجميع — حرفياً."}]}],"exercises":[{"t":"mcq","skill":"grammar","q":"حوّل: «Je suis fatigué», a-t-il dit →","opts":["Il a dit qu'il est fatigué","Il a dit qu'il était fatigué","Il a dit qu'il sera fatigué","Il a dit qu'il était fatigue"],"a":1,"why":"فعل القول ماضٍ → présent يتحول imparfait."},{"t":"mcq","skill":"grammar","q":"«Tu viens demain ?» → Il m'a demandé...","opts":["tu viens demain","si je venais le lendemain","que je viens demain","si je viendrai demain"],"a":1,"why":"سؤال نعم/لا → si، وimpair → imparfait + demain → le lendemain."},{"t":"fill","skill":"grammar","q":"أكمل: «Il a promis qu'il nous ___ (envoyer) le compte-rendu.»","fr":"Il a promis qu'il nous ___ le compte-rendu.","ans":"enverrait","alts":["envoierait"],"why":"futur enverra → conditionnel enverrait."},{"t":"order","skill":"grammar","q":"رتّب التحويل: «Ferme la porte !» → (1) de fermer la porte (2) Il m'a dit","words":["Il","m'a","dit","de","fermer","la","porte."],"ans":"Il m'a dit de fermer la porte.","why":"الأمر في النقل = فعل القول + de + مصدر."},{"t":"listen","skill":"listening","q":"استمع للجملة المحوّلة واختر الأصل:","audio":"Elle a dit qu'elle avait déjà mangé","opts":["«Je mange déjà»","«J'ai déjà mangé»","«Je mangerai déjà»","«J'avais déjà mangé»"],"a":1,"why":"avait mangé (PQP) يعود إلى j'ai mangé (PC) — سلم النزاح درجة واحدة."},{"t":"translate","skill":"writing","q":"حوّل للنقل غير المباشر: قال: «سأرسل التقرير غداً.»","ans":"Il a dit qu'il enverrait le rapport le lendemain.","alts":["elle a dit qu'elle enverrait le rapport le lendemain"],"why":"futur → conditionnel + demain → le lendemain."},{"t":"mcq","skill":"grammar","q":"بعد verbs of saying في Discours indirect, الإحالة تتقدّم خطوة:","opts":["je → il, ce → cela","je → tu, ce → cela","je reste كما هي","tu → vous فقط"],"a":0,"why":"الكلام المنقول يزيح الضمائر والزمن خطوة واحدة."},{"t":"translate","skill":"writing","q":"ترجم: «قال إنه سيأتي غداً.»","ans":"Il a dit qu'il viendrait demain.","alts":["il a dit quil viendrait demain","Il a dit qu il viendrait demain"],"why":"القول بالماضي ← viendrait (conditionnel في المنقول)."}],"homework":"حوّل 5 عبارات سمعتها اليوم إلى نقل غير المباشر بالأمس: «Il a dit que...» — طبّق السلم الزمني عمداً.","sources":[{"title":"مستحيل متفهمش le discours direct et indirect","channel":"Le français avec Nouma","videoId":"QIwO5CgHQ9I","why":"شرح بالعربية الكامل للنقل المباشر وغير المباشر بخطوات بسيطة وأمثلة مدرسية — أصلح خلفيتك بالعربية قبل التعمق بالفرنسية.","cat":"Grammar","level":"B1","main":true},{"title":"Discours DIRECT et INDIRECT en français : Leçon complète","channel":"Parlez-vous FRENCH : Cours de français","videoId":"w-OU9wFhYcc","why":"الدرس الكامل بالفرنسية لكل قواعد النقل مع جداول التحويل — المرجع المنهجي الذي يعكس شرح العربي بعناصره الفرنسية الدقيقة.","cat":"Grammar","level":"B1","extra":true},{"title":"Le DISCOURS INDIRECT au passé | Grammaire française avec exercices!","channel":"French School TV","videoId":"d2JiMoZrlw0","why":"النقل في الماضي — أصعب نقطة في الموضوع — بتمارين وتصحيح: سلم النزاح الزمني (présent→imparfait, PC→PQP, futur→conditionnel) ممارَساً فعلياً.","cat":"Grammar","level":"B1","extra":true}],"supplements":[{"id":"w-OU9wFhYcc","title":"Discours DIRECT et INDIRECT en français : Leçon complète","channel":"Parlez-vous FRENCH : Cours de français","why":"الدرس الكامل بالفرنسية لكل قواعد النقل مع جداول التحويل — المرجع المنهجي الذي يعكس شرح العربي بعناصره الفرنسية الدقيقة.","lang":"fr"},{"id":"d2JiMoZrlw0","title":"Le DISCOURS INDIRECT au passé | Grammaire française avec exercices!","channel":"French School TV","why":"النقل في الماضي — أصعب نقطة في الموضوع — بتمارين وتصحيح: سلم النزاح الزمني (présent→imparfait, PC→PQP, futur→conditionnel) ممارَساً فعلياً.","lang":"fr"}]},{"id":"B1-t3-l3","fr":"Plus-que-parfait et cohérence des temps","ar":"الماضي الأسبق وتناسق الأزمنة","objectives":["تكوين plus-que-parfait واستخدامه للحدث السابق","بناء رواية بأزمنة منسجمة دون تناقض","استخدام عبارات الأسبقية: avant que, déjà, quand j'arrive il était déjà parti"],"sections":[{"h":"ماضي الماضي","p":["Plus-que-parfait زمن «الأبعد»: ما وقع قبل الماضي نفسه. «Quand je suis arrivé, le train était déjà parti» — لحظة الوصول (passé composé) وأما الرحلة فـ plus-que-parfait: طبقة سابقة تمنح السرد عمقاً زمنياً. بدونها يُقرأ كل شيء في مستوى واحد.","التكوين: avoir/être في imparfait + participe passé — المكوّن الثاني هو الماضي الناقص نفسه، ولذلك سهل من يتقن أزمنة A2. الشاذات the same: été, allé, venu, parti, mort — مع être يأتي الـ participe جاهزاً مع الجنس والعدد.","تابع الفيديو الأساسي بالشرح العربي: شرح بسيط لـ plus-que-parfait — التكوين ثم المواضع. لاحظ أن الفيديو يبني «j'avais mangé» من ماضيين مركّبين: avait (ناقص) + mangé (مكتمل) — هندسة الاسم نفسها: ناقص يسبق مكتملاً.","التصريف بلا خطأ: أكبر مصدر خطأ هو نسيان participles الشاذة (eu, fait, pris, vu, cru) وأفعال être (été, allé). احفظ قائمة العشرة الشائعة أكثر مما تفهم قاعدة — التصريف خطأ رؤية لا خطأ تفكير.","النسيج السردي المنسجم: بعد que/avant que/lorsque تُنسجم الطبقات: «J'avais terminé quand elle est arrivée» (أنجزتُ قبل وصولها). الروابط الزمنية (après que, avant que, dès que, une fois que) هي التي تُظهر الطبقات للقارئ — الروابط قبل الأزمنة في الأهمية.","أهم استعمال عملي: الماضي السابق في التبرير والقصة. «Pourquoi étais-tu en retard ? — Parce que j'avais raté le premier bus.» وفي الامتحان: جملة واحدة بـ plus-que-parfait ترفع مستوى الجزء الكتابي فوراً لأنها تُظهر تحكماً في النسق لا في فعل واحد."],"video":{"id":"3-lavd8lq3w","title":"شرح بسيط وسهل لدرس le plus-que-parfait","channel":"Le français avec Nouma","why":"شرح عربي مبسط للماضي الأسبق بالأمثلة الواضحة — يثبّت المفهوم بالعربية قبل تعميق استعماله بالفرنسية.","lang":"ar","main":true},"sub":[{"h":"الطبقة السابقة للماضي","p":["الحدث الأبعد ← plus-que-parfait.","«Le train était déjà parti».","معنى واحد: قبل الماضي.","يمنح السرد عمقاً طبقياً."]},{"h":"التكوين والشاذات","p":["avoir/être (imparfait) + PP.","eu, fait, pris, vu, cru.","être: été, allé, venu, parti.","الجنس والعدد مع être."]},{"h":"الروابط الزمنية","p":["après que / avant que / dès que.","une fois que / lorsque.","الرابط يكشف الطبقة قبل الزمن.","«J'avais fini avant qu'il ne vienne»."]}]},{"h":"التصريف بلا خطأ","p":["الأفعال المساعدة هي كل القصة: avoir في imparfait (avais, avais, avait, avions, aviez, avaient) + participe؛ être في imparfait (étais, étais, était, étions, étiez, étaient) + participe مع التطابق: elle était partie، ils étaient venus، elles s'étaient levées. الأفعال الشاذة في الجزء الثابت تعرفها من الماضي المركّب: eu، été، fait، dit، vu، pris، mis، ouvert، écrit.","خطأ B1 الشائع: نسيان التطابق مع être في الجمع: «Ils étaient arrivé» ✗ → «Ils étaient arrivés» ✓. والثاني: خلط était/était avec avait في الأفعال الظرفية. ملاحظة إملائية دقيقة للامتحانات: participe مع avoir يبقى بلا تطابق إلا مع ضمير مسبق — «les fleurs que j'avais achetées» (que تحيل على les fleurs → تأنيث جمع).","مع «avant que» يُستعمل subjonctif في الجملة الثانية («avant qu'il ne vienne»)، بينما «après que» تأخذ المضارع/الماضي العادي. هذا الزوج محبس الدرجة: واحد ينصب والآخر لا ينصب."],"video":null},{"h":"النسيج السردي المنسجم","p":["القواعد الثلاث للكتابة السردية المنسجمة: 1) أحيط بالمشهد بالأزمنة الطويلة (imparfait/PQP): ما كان جارياً وما سبق. 2) حرّك القصة بالأزمنة القاطعة (PC): ما حدث ثم تلاه. 3) قبل كل PC اسأل: هل حدث قبل حدث ماضٍ آخر؟ إذا نعم فاستخدم PQP. هذا الثلاثي يجعل روايتك منطقية زمنياً تماماً.","حيلة التحقق: اقرأ فقرتك وأسقط الزمنين المتجاورين على خط زمني مرسوم. إن كانت الأحداث تتراجع للخلف دون كلمات ربط (avant، déjà، quand)، فهناك تناسق مكسور يجب إصلاحه بـPQP أو بكلمة أسبقية. درّب نفسك على إعادة كتابة فقرة قصيرة بتسلسل منطقي صارم.","تمرين الطبقات: اكتب ست جمل عن صباح مزدحم تشغّل فيها passé composé (الأحداث) وplus-que-parfait (ما سبقها) وimparfait (الخلفية) — الثلاثي الكامل في نص واحد من 80 كلمة."],"video":null},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: تعلّمت تكوين plus-que-parfait واستخدامه للحدث الأسبق، والروابط الزمنية (avant que بالمنصوب وaprès que بالخبري)، وقواعد النسيج السردي المنسجم الثلاث. أعد مشاهدة الفيديو الرئيسي وركّز على تركيب «ناقص + مكتمل» الذي يصنع ماضي الماضي.","جسر الدروس: من B1-t3-l2 (النقل غير المباشر: قال إنه سيأتي) إلى B1-t3-l3 (الماضي الأسبق وتناسق الأزمنة)، ثم إلى B1-t4-l1 حيث تدير الحوار بسؤال مفتوح وتقنية relance.","مهمة تطبيقية: سجّل نفسك دقيقة وأنت تلخّص الدرس وتعيد استخدام 3 كلمات جديدة، ثم قارن نطقك بالفيديو الرئيسي."]}],"examples":[{"fr":"Quand je suis arrivé, la réunion avait déjà commencé.","ar":"حين وصلت، كان الاجتماع قد بدأ بالفعل."},{"fr":"Avant ce voyage, elle n'avait jamais quitté son pays.","ar":"قبل هذه الرحلة، لم تكن قد تركت بلدها قط."},{"fr":"Il a dit qu'il avait fini le rapport.","ar":"قال إنه أنهى التقرير (نقل من PC)."},{"fr":"Si j'avais su, je serais venu plus tôt.","ar":"لو كنت أعلم، جئت أبكر."},{"fr":"Quand je suis arrivé, il avait déjà dormi.","ar":"عندما وصلت، كان قد نام بالفعل.","note":"تعاقب"},{"fr":"J'avais fini avant qu'il ne vienne.","ar":"كنت قد انتهيت قبل أن يأتي.","note":"avant que + subjonctif"},{"fr":"Pourquoi étais-tu tard ? — J'avais raté le bus.","ar":"لماذا تأخرت؟ — فاتني الباص.","note":"تبرير"},{"fr":"Dès que j'ai su, j'ai appelé.","ar":"بمجرد أن علمت، اتصلت.","note":"dès que"}],"pron":[{"w":"j'avais été","ipa":"[ʒa.vɛ e.te]","approx":"جافيه-إيتيه"},{"w":"déjà","ipa":"[de.ʒa]","approx":"ديجا"},{"w":"ils étaient venus","ipa":"[il ze.tɛ və.ny]","approx":"إيل-زيتيه-فنو"}],"vocab":[{"fr":"le plus-que-parfait","ar":"الماضي الأسبق","pos":"nom","g":"m","ipa":"[ply kə paʁ.fɛ]","exFr":"Le plus-que-parfait exprime l'antériorité.","exAr":"الماضي الأسبق يعبر عن السبقية."},{"fr":"avant que","ar":"قبل أن","pos":"conjonction","ipa":"[a.vɑ̃ kə]","exFr":"Il était parti avant que j'arrive.","exAr":"كان قد رحل قبل أن أصل."},{"fr":"l'antériorité","ar":"السبقية (الزمنية)","pos":"nom","g":"f","ipa":"[ɑ̃.te.ʁjo.ʁi.te]","exFr":"Ce temps marque l'antériorité d'un événement.","exAr":"هذا الزمن يشير إلى سبقية الحدث."},{"fr":"le tissu","ar":"النسيج (مجازياً: بنية النص)","pos":"nom","g":"m","pl":"les tissus","ipa":"[ti.sy]","exFr":"La concordance des temps tisse le récit.","exAr":"تناسق الأزمنة ينسج الرواية."},{"fr":"cesser de","ar":"يتوقف عن","pos":"verbe","ipa":"[se.se də]","exFr":"La pluie avait cessé de tomber.","exAr":"كان المطر قد توقف عن النزول."},{"fr":"marquer","ar":"يشير إلى / يميّز","pos":"verbe","ipa":"[maʁ.ke]","exFr":"Ce temps marque une action antérieure.","exAr":"هذا الزمن يشير إلى فعل سابق."},{"fr":"déjà","ar":"بالفعل/سابقاً","pos":"adv","exFr":"Il était déjà parti.","ipa":"[deʒa]","exAr":"كان قد رحل بالفعل."},{"fr":"après que","ar":"بعد أن","pos":"locution","exFr":"Après qu'il a fini...","ipa":"[apʁɛ kə]","exAr":"بعد أن أنهى..."},{"fr":"dès que","ar":"ما إن/بمجرد","pos":"locution","exFr":"Dès que j'ai su, j'ai appelé.","ipa":"[dɛ kə]","exAr":"بمجرد أن علمت، اتصلت."},{"fr":"une fois que","ar":"بمجرد ما أن","pos":"locution","exFr":"Une fois que tu es prêt...","ipa":"[yn fwa kə]","exAr":"بمجرد أن تكون جاهزاً..."},{"fr":"rater","ar":"يفوته/يفشل في","pos":"verbe","g":"1er","exFr":"J'ai raté le bus.","ipa":"[ʁate]","exAr":"فوتي الباص."},{"fr":"tard / en retard","ar":"متأخر / متأخراً","pos":"adj","exFr":"Tu es en retard.","ipa":"[taʁ]","exAr":"أنت متأخر."},{"fr":"le train","ar":"القطار","pos":"nom","g":"m","exFr":"Le train était déjà parti.","ipa":"[tʁɛ̃]","exAr":"كان القطار قد رحل."},{"fr":"terminer","ar":"ينهي","pos":"verbe","g":"1er","exFr":"J'avais terminé le devoir.","ipa":"[tɛʁmine]","exAr":"كنت قد أنهيت الواجب."},{"fr":"manquer à","ar":"يفتقد/يفوته","pos":"locution","exFr":"Il m'a manqué un appel.","ipa":"[mɑ̃ke]","exAr":"فاتني اتصال."}],"grammar":[{"tFr":"Le plus-que-parfait","tAr":"القاعدة: ماضي الماضي","body":["avoir/être بصيغة imparfait + participe passé؛ مع être يتوافق participe مع الفاعل.","المواضع: قبل الماضي (antériorité) مع les liens temporels (quand, avant que, après que)."],"ex":[{"fr":"Nous étions partis avant que le jour ne se lève.","ar":"كنا قد رحلنا قبل أن يطلع النهار."},{"fr":"Elle avait lu le mail quand je l'ai appelée.","ar":"كنت قد قرأت الرسالة عندما اتصلت بها."}]}],"mistakes":[{"wrong":"avoir en plus-que-parfait مع أفعال الحركة بلا تبرير","right":"être مع être/allé/parti/venu","why":"الشاذة نفسها تعمل في الماضي البسيط."},{"wrong":"الخلط مع passé simple","right":"PQP للأسبقية، passé simple للأدب","why":"الأول شائع في السرد الحديث، والثاني في النصوص الكلاسيكية فقط."},{"wrong":"après que + subjonctif","right":"après que + indicatif","why":"الفخ الشهير: avant que ينصب وaprès que لا ينصب."},{"wrong":"نسيان participles الشاذة","right":"eu / fait / pris / vu / cru","why":"قائمة العشرة تمنع نصف أخطاء التصريف."}],"dialogues":[{"title":"تأخير المساء","ctx":"أصدقاء يفسّرون تأخراً","lines":[{"who":"Tarek","fr":"Tu es arrivé à minuit !","ar":"وصلت منتصف الليل!"},{"who":"Yasmine","fr":"Je sais, le bus avait déjà quitté l'arrêt.","ar":"أعلم، كان الباص قد غادر المحطة."},{"who":"Tarek","fr":"Mais tu avais ma messagerie non ?","ar":"لكن كانت لدي رسائلي أليس كذلك؟"},{"who":"Yasmine","fr":"Je n'avais pas vu ton message — mon téléphone était éteint.","ar":"لم أر رسالتك — كان هاتفي مطفأً."},{"who":"Tarek","fr":"On avait prévu de partir à dix heures.","ar":"كنا قد اتفقنا على الخروج في العاشرة."},{"who":"Yasmine","fr":"Tu as raison. La prochaine fois, j'aurai un plan B.","ar":"أنت محق. المرة القادمة سأعد خطة بديلة."}]}],"exercises":[{"t":"mcq","skill":"grammar","q":"أكمل: «Quand je suis arrivé à la gare, le train ___.»","opts":["part","est parti","était parti","était part"],"a":2,"why":"رحيل القطار سابق على وصولي (PC) → PQP: était parti."},{"t":"mcq","skill":"grammar","q":"«Elle s'était levée tôt» — لماذا levée بالتأنيث؟","opts":["خطأ إملائي","être + participe يتطابق مع الفاعل المؤنث","لأن elle ظرف","التقليد الفرنسي فقط"],"a":1,"why":"مع être يتطابق participe مع الفاعل في الجنس والعدد."},{"t":"fill","skill":"grammar","q":"أكمل: «Avant ce voyage, je n'___ jamais ___ (prendre) l'avion.»","fr":"Avant ce voyage, je n'___ jamais ___ l'avion.","ans":"avais pris","alts":["avais jamais pris"],"why":"n'avais jamais pris = PQP من prendre (بدون تمايز مع avoir)."},{"t":"order","skill":"grammar","q":"رتّب الجملة المنسجمة: (1) il avait déjà commencé (2) Quand je suis entré (3) le cours","words":["Quand","je","suis","entré,"],"ans":"Quand je suis entré,","why":"PC أولاً (الوصول) ثم PQP (ما سبق): étaient أول الترتيب."},{"t":"listen","skill":"listening","q":"استمع واختر ترتيب الأحداث الصحيح:","audio":"La réunion avait déjà commencé quand je suis arrivé","opts":["الاجتماع ثم وصولي","وصولي ثم الاجتماع","الاثنان معاً","الاجتماع لم يبدأ"],"a":0,"why":"PQP (avait commencé) يسبق PC (suis arrivé)."},{"t":"writing","skill":"writing","q":"اكتب 4 جمل عن يومك بالأمس: واحدة PQP، واحدة imparfait للخلفية، واثنتان PC للأحداث.","min":20,"kw":["avais","je","ai"],"sample":"Quand je me suis réveillé, la pluie avait déjà cessé. Le soleil brillait doucement. J'ai pris mon petit-déjeuner tranquillement. Ensuite, je suis allé travailler à pied.","why":"ترتيب أزمنة الماضي الثلاثة في نص واحد يختبر تناسقك الزمني — وهو المعيار الأوضح لتمييز منتج B1 عن منتج A2 في الجزء الكتابي."},{"t":"mcq","skill":"grammar","q":"plus-que-parfait يُستعمل للماضي السابق:","opts":["لحدث سبق حدثاً آخر في الماضي","لحدث مستمر الآن","لحدث مستقبلي","للأمر"],"a":0,"why":"أول الأفعال بالماضي، ثم الثاني بالمركّب."},{"t":"fill","skill":"grammar","q":"أكمل: «Quand je suis arrivé, ils ___ (partir) déjà.»","fr":"Quand je suis arrivé, ils ___ déjà.","ans":"étaient partis","alts":["Etaient partis","étaient partis"],"why":"اللحظة بـ être + passé، والفعل السابق بالماضي بـ plus-que-parfait."}],"homework":"أعد كتابة فقرة قصيرة من قصة قرأتها مستخدماً PQP مرة على الأقل، ووضّح أي حدث سابق على أي حدث.","sources":[{"title":"شرح بسيط وسهل لدرس le plus-que-parfait","channel":"Le français avec Nouma","videoId":"3-lavd8lq3w","why":"شرح عربي مبسط للماضي الأسبق بالأمثلة الواضحة — يثبّت المفهوم بالعربية قبل تعميق استعماله بالفرنسية.","cat":"Grammar","level":"B1","main":true},{"title":"Le plus-que-parfait (Conjugaison française)","channel":"Cours de français - Jonathan Vangrootloon","videoId":"PZi8xhSjiyo","why":"تصرّف الزمن كاملاً بالأفعال المنتظمة والشاذة — مرجع صرفي نظيف يضمن صحة j'avais été / nous étions venus في الكتابة.","cat":"Grammar","level":"B1","extra":true},{"title":"Le passé composé ou l'imparfait : maîtriser la concordance des temps (Leçon 18)","channel":"la machine à écrire","videoId":"ShpmGcm9yK4","why":"درس منهجي على تناسق الأزمنة في الكتابة — يربط PQP بـPC وimparfait في نسيج سردي واحد، وهو الهدف الفعلي لمستوى B1.","cat":"Grammar","level":"B1","extra":true}],"supplements":[{"id":"PZi8xhSjiyo","title":"Le plus-que-parfait (Conjugaison française)","channel":"Cours de français - Jonathan Vangrootloon","why":"تصرّف الزمن كاملاً بالأفعال المنتظمة والشاذة — مرجع صرفي نظيف يضمن صحة j'avais été / nous étions venus في الكتابة.","lang":"fr"},{"id":"ShpmGcm9yK4","title":"Le passé composé ou l'imparfait : maîtriser la concordance des temps (Leçon 18)","channel":"la machine à écrire","why":"درس منهجي على تناسق الأزمنة في الكتابة — يربط PQP بـPC وimparfait في نسيج سردي واحد، وهو الهدف الفعلي لمستوى B1.","lang":"fr"}]}]},{"id":"b1-t4","slug":"conversation","icon":"🗣️","color":"#EA580C","fr":"Conversation","ar":"مسار المحادثة","desc":"حوّل جملك إلى حوار حي: إدارة النقاش وتوسيعه، إبداء الرأي والمواجهة بلطف، وإدارة الدعوات والرفض الماهر.","lessons":[{"id":"B1-t4-l1","fr":"Animer une conversation","ar":"إدارة حوار وطلاقة التحدث","objectives":["فتح حواراً وتوسيعه بأدوات الإلحاح والمتابعة","التعبير عن الفهم وطلب التكرار بثقة","التحدث بفرنسية متصلة في مواقف حقيقية"],"sections":[{"h":"فتح وتوسيع الحوار","p":["الفتح في الحوار الفرنسي ليس بموضوع بل بسؤال مفتوح: «Et alors, tu as fait quoi ce week-end ؟» أفضل من «Tu vas bien ؟» التي تُجاب بنعم/لا وتُغلق الباب في أول ثانية. قاعدة واحدة: كل سؤال يجب أن يفتح باباً لجملة تالية.","أدوات الإلحاح والاقتطاع اللطيف: «Alors...» الصاعدة تقول «أكمل»، و«Ah oui ?» الفضولية تقول «أنا مهتم»، و«Et puis ?» تفتح التالي. ثلاث أدوات صوتية لا تُترجم بل تُنطق — تُبقي الحوار حياً وأنت لا تملك جملة جديدة.","تابع الفيديو الأساسي بالشرح العربي: أدوات الحوار الطبيعية بأمثلة كثيرة — لاحظ أن المحادثة الفرنسية تُدار بـ «mots-outils» (donc, alors, du coup, quand même) أكثر من المفردات الثقيلة. هذه الحروف الصغيرة هي وقود الحوار اليومي.","الاقتطاع المهذّب (l'interruption polie): «Je peux te couper ?», «Petite remarque...», «Si je puis me permettre...» — ثلاث درجات من الجرأة. مباشرة بلا درجة تُقرأ وقاحة، وصمت دائم يُقرأ عدم اهتمام؛ B1 يعرف أن يقاطع بنبرة صاعدة لا هابطة.","التوسيع بـ «relance»: بعد جواب، أعد صياغته كسؤال أو أضف شاهداً: «Ah oui ? Et tu as aimé ?» أو «Moi c'est pareil —...». تقنية relance تحوّل إجابتك إلى مهاد لا استجواب، ومن يتقنها لا يحتاج مفردات أكثر بل ردود أقصر.","من التدريب إلى الطلاقة: الطلاقة ليست سرعة بل استمرارية — لا تبحث عن الكلمة المثالية، استخدم mot de remplissage («comment on dit...», «c'est le mot...») وتابع. التوقف للاستكمال يُكسِر الإيقاع أكثر من كلمة ناقصة يَفهمها الطرف الآخر بالسياق."],"video":{"id":"yyB0B7brLAU","title":"تكلّم الفرنسية بثقة | لا تخف من الأخطاء | بودكاست فرنسي B1 - B2","channel":"Communications En Français","why":"بودكاست عن ثقة الحديث والخروج من جمود الأخطاء — يؤطر فتح الحوار وتوسيعه كمهارة لا ككلمات محفوظة.","lang":"ar","main":true,"dur":10},"sub":[{"h":"السؤال المفتوح: قاعدة الباب","p":["«Tu fais quoi ?» ← لا نعم/لا.","«Et alors...» الصاعدة = أكمل.","«Ah oui ?» الفضولية = مهتم.","«Et puis ?» = التالي من فضلك."]},{"h":"الاقتطاع بثلاث درجات","p":["«Je peux te couper ?» — مباشر.","«Petite remarque...» — لطيف.","«Si je puis me permettre...» — رسمي.","نبرة صاعدة لا هابطة."]},{"h":"relance: من رد إلى مهاد","p":["«Et tu as aimé ?» — إعادة كسؤال.","«Moi c'est pareil...» — شاهد.","جوابك يفتح باباً لا يُغلقه.","الطلاقة = استمرارية لا سرعة."]}]},{"h":"أدوات الإلحاح والاقتطاع اللطيف","p":["لطلب الإكمال: Continue, je t'écoute (أكمل، أنا أسمعك)، Et après ? (وبعدها؟)، Et puis ? (وماذا بعد؟). للاقتطاع بلطف: Pardon de vous interrompre... (أعتذر من المقاطعة...)، Excusez-moi, juste une question... — ثم أعد الكرة: Tu disais ? (كنت تقول؟)، Je te laisse continuer.","لإظهار الفهم: Je vois، D'accord، Ça marche، Ok, très bien. ولعدم الفهم: Pardon ? (عفواً؟)، Tu peux répéter, s'il te plaît ?، Je n'ai pas compris le dernier mot، Tu peux parler plus lentement ? — في B1 لا تقبل بصمت الخجل؛ إعادة السؤال مهارة تُقيَّم ولا تُعاقَب.","أدوات التردد المفيدة: «Je ne sais pas trop comment dire...» ثم الفكرة بالكلمات البسيطة — الاعتراف بالعجز المؤقت يُحسن النبرة أكثر من الصمت المحرج أو الترجمة الحرفية المنمّطة."],"video":null},{"h":"من التدريب إلى الطلاقة","p":["الطلاقة تُبنى بالمحادثة المنتظمة، وإن لم يكن لديك شريك فهناك حلول: سجّل نفسك تحدث دقيقتين عن يومك، واستمع للإعادة وصلّح جملتين فقط في كل مرة. أو استخدم التمثيل الذاتي: أعد إحدى الحوارات التي سمعتَها بدورين معاً. ثمانية أسابيع من هذه العادة تحدث فارقاً ملموساً.","خدعة اللحاق: احتفظ بقائمة 10 عبارات حوارية تتعلمها أسبوعياً واستخدم كل واحدة مرتين في يومك بالفرنسية (مع نفسك أو مع شريك). العبارات الجاهزة توفّر طاقة الترجمة الذهنية وتتركها تركز على الفكرة لا على التركيب.","تمرين relance: سجّل حواراً تلفزيائياً قصيراً وأكمل كل جواب مقطوعاً بـ «Et toi ?» أو «Ah oui ? Et après ?» — 10 روابط تُبني عضلة الاستمرار قبل أن تبني المفردات."],"video":null},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: تعلّمت فتح الحوار بسؤال مفتوح، وأدوات الإلحاح (Alors…, Ah oui ?, Et puis ?)، والاقتطاع بثلاث درجات، وتقنية relance التي تحوّل ردك إلى مهاد. أعد مشاهدة الفيديو الرئيسي وركّز على mots-outils التي تُبقي الحوار حياً دون جمل ثقيلة.","جسر الدروس: من B1-t3-l3 (الماضي الأسبق وتناسق الأزمنة) إلى B1-t4-l1 (إدارة حوار وطلاقة التحدث)، ثم إلى B1-t4-l2 حيث تُعبّر عن رأيك بدرجاته وتناقش اعتراضاً بلطف.","مهمة تطبيقية: سجّل نفسك دقيقة وأنت تلخّص الدرس وتعيد استخدام 3 كلمات جديدة، ثم قارن نطقك بالفيديو الرئيسي."]}],"examples":[{"fr":"Alors, tu as des projets pour les vacances ?","ar":"إذن، لديك خطط للعطلة؟"},{"fr":"Tu peux m'en dire plus ?","ar":"هل تشرح لي أكثر؟"},{"fr":"Pardon de vous interrompre...","ar":"أعتذر من المقاطعة..."},{"fr":"Il faut que j'y aille. À bientôt !","ar":"عليّ الذهاب. إلى اللقاء!"},{"fr":"Et alors, tu as fait quoi ce week-end ?","ar":"وإذن، ماذا فعلت في عطلة نهاية الأسبوع؟","note":"سؤال مفتوح"},{"fr":"Je peux te couper une seconde ?","ar":"هل لي أن أُقطعك ثانية؟","note":"اقتطاع مباشر"},{"fr":"Ah oui ? Et tu as aimé le film ?","ar":"أها؟ وهل أعجبك الفيلم؟","note":"relance"},{"fr":"Comment on dit... le truc pour la cuisine ?","ar":"كيف نقول... تلك الأداة للمطبخ؟","note":"ملء فراغ"}],"pron":[{"w":"C'est-à-dire","ipa":"[sɛ.ta.diʁ]","approx":"سيتا-دير"},{"w":"Ah bon ?","ipa":"[a bɔ̃]","approx":"آه-بون"},{"w":"je t'écoute","ipa":"[ʒə te.kut]","approx":"جه-تي-كوت"}],"vocab":[{"fr":"animer (une conversation)","ar":"يقود/يحيي (حواراً)","pos":"verbe","ipa":"[a.ni.me]","exFr":"Il sait animer la discussion en réunion.","exAr":"يحسن قيادة النقاش في الاجتماع."},{"fr":"Et toi ?","ar":"وأنت؟","pos":"expression","ipa":"[e.twa]","exFr":"Je vais bien. Et toi ?","exAr":"أنا بخير. وأنت؟"},{"fr":"dommage","ar":"يا للأسف","pos":"nom","g":"m","ipa":"[dɔ.maʒ]","exFr":"C'est dommage !","exAr":"يا للأسف!"},{"fr":"répéter","ar":"يعيد","pos":"verbe","ipa":"[ʁe.pe.te]","exFr":"Tu peux répéter ?","exAr":"يمكنك التكرار؟"},{"fr":"un projet","ar":"مشروع / خطة","pos":"nom","g":"m","pl":"des projets","ipa":"[pʁɔ.ʒɛ]","exFr":"Quels sont tes projets ?","exAr":"ما خططك؟"},{"fr":"la fluidité","ar":"الطلاقة/السلاسة","pos":"nom","g":"f","ipa":"[fli.i.di.te]","exFr":"La fluidité vient avec la pratique régulière.","exAr":"السلاسة تأتي مع التدريب المنتظم."},{"fr":"relancer la conversation","ar":"يُعيد إشعال الحوار","pos":"locution","exFr":"Relancer avec une question.","ipa":"[ʁəlɑ̃se]","exAr":"إشعال بسؤال."},{"fr":"couper la parole","ar":"يُقطع الكلام","pos":"locution","exFr":"Puis-je vous couper la parole ?","ipa":"[kupe la paʁɔl]","exAr":"هل لي أن أقطع كلامكم؟"},{"fr":"mots-outils","ar":"أدوات تعبيرية","pos":"nom","exFr":"Les mots-outils animent le dialogue.","ipa":"[mo ɔt‿il]","exAr":"الأدوات تُحيي الحوار."},{"fr":"le silence gênant","ar":"الصمت المحرج","pos":"nom","exFr":"Éviter le silence gênant.","ipa":"[silɑ̃ ʒenɑ̃]","exAr":"تجنّب الصمت المحرج."},{"fr":"l'aisance","ar":"الثقة والراحة في الحديث","pos":"nom","g":"f","ipa":"[le.izɑ̃s]","exFr":"Elle parle avec aisance devant tout le groupe.","exAr":"تتحدث بثقة وراحة أمام المجموعة بأكملها."},{"fr":"interrompre","ar":"يُقاطع","pos":"verbe","g":"2e","exFr":"Excusez-moi d'interrompre.","ipa":"[ɛ̃tɛʁɔpʁ]","exAr":"عذراً على المقاطعة."},{"fr":"une remarque","ar":"ملاحظة","pos":"nom","g":"f","exFr":"Petite remarque...","ipa":"[ʁəmaʁk]","exAr":"ملاحظة صغيرة..."},{"fr":"si je puis me permettre","ar":"إن سمح لي","pos":"locution","exFr":"Si je puis me permettre...","ipa":"[si ʒə pɥi mə pɛʁmɛtʁ]","exAr":"إن سمح لي..."},{"fr":"lancer un sujet","ar":"يفتح موضوعاً","pos":"locution","exFr":"Lancer un nouveau sujet.","ipa":"[lɑ̃se œ̃ nəvo syʒɛ]","exAr":"فتح موضوع جديد."},{"fr":"le mot de remplissage","ar":"كلمة تملئة الفراغ","pos":"locution","exFr":"«Comment on dit déjà...» — un mot de remplissage.","ipa":"[mɔ də ʁəplisɑ̃]","exAr":"«كيف نقول...» — كلمة تملئة فراغ."},{"fr":"le déroulé naturel","ar":"المسار الطبيعي","pos":"nom","exFr":"Le déroulé naturel d'un échange.","ipa":"[deʁule natyʁɛl]","exAr":"المسار الطبيعي للتبادل."},{"fr":"la repartie","ar":"الرد السريع","pos":"nom","g":"f","exFr":"Avoir une repartie.","ipa":"[ʁəpaʁti]","exAr":"امتلاك رد سريع."}],"grammar":[{"tFr":"Les formules d'interaction","tAr":"القاعدة: قوالب التفاعل","body":["التفاعل يقوده: «Et toi ?» (ارتد)، «N'est-ce pas ?» (است briefed)، «C'est-à-dire ?» (اطلب توضيحاً) — ثلاث أدوات تُبقي الكرة عند الطرف الآخر.","مع le futur proche للحقائق المؤكدة القريبة: «Tu vas voir, c'est génial» — نبرة الحماس تأتي من المستقبل القريب لا من المضارع."],"ex":[{"fr":"Tu as aimé Paris ? — Oui ! Et toi, tu y es allé ?","ar":"أعجبتك باريس؟ — نعم! وأنت، هل ذهبت إليها؟"},{"fr":"C'est-à-dire ? — Je veux dire : c'est trop long.","ar":"أي/ما أعنيه؟ — أعني: إنه طويل جداً."}]}],"mistakes":[{"wrong":"البدء بـ «Tu vas bien ?» وانتظار نعم/لا","right":"سؤال مفتوح يفتح باباً","why":"السؤال المُغلق يقتل الحوار في ثانية."},{"wrong":"الصمت عند نسيان كلمة","right":"«comment on dit» + موصوف بالبساطة","why":"الاعتراف المؤقت أفضل من القطع الصامت."},{"wrong":"الاقتطاع بنبرة هابطة","right":"نبرة صاعدة + عبارة تمهيد","why":"النبرة الهابطة تُقرأ أمراً لا اعتذاراً."},{"wrong":"الإجابة وإنهاء الدور","right":"إجابة + relance","why":"من لا يُعيد الكرة يُنهي الحوار بلطف كل مرة."}],"dialogues":[{"title":"حوار متجدد","ctx":"زميلان في استراحة","lines":[{"who":"Hakim","fr":"Et alors, comment s'est passée ta soirée ?","ar":"وإذن، كيف مساؤك؟"},{"who":"Souad","fr":"Très bien — on a mangé dehors !","ar":"جيد جداً — أكلنا في الخارج!"},{"who":"Hakim","fr":"Ah oui ? Et t'as aimé le resto ?","ar":"أها؟ وهل أعجبك المطعم؟"},{"who":"Souad","fr":"Super ! Du coup on y retourne samedi.","ar":"رائع! وبذلك سنعود السبت."},{"who":"Hakim","fr":"Sérieux ? Tu peux me couper, je viens avec ?","ar":"عنجد؟ دعني أُقطعك، هل يمكنني المجيء؟"},{"who":"Souad","fr":"Bien sûr ! Je t'envoie l'adresse.","ar":"بالتأكيد! سأرسل لك العنوان."}]}],"exercises":[{"t":"mcq","skill":"speaking","q":"لتشجيع صديقك على المتابعة تقول:","opts":["C'est fini ?","Continue, je t'écoute","Je ne sais pas","Au revoir"],"a":1,"why":"Continue, je t'écoute = أكمل، أنا أسمعك — أداة الإلحاح القياسية."},{"t":"mcq","skill":"speaking","q":"إذا لم تفهم كلمة قلت:","opts":["Répète le dernier mot !","Pardon ?","C'est ça","D'accord"],"a":1,"why":"Pardon? أبسط وأكثر طبيعية لطلب التكرار."},{"t":"fill","skill":"speaking","q":"أكمل: «Je suis chargé, ___-à-dire très occupé.»","fr":"___-à-dire","ans":"c'est","alts":["c est"],"why":"c'est-à-dire = يعني."},{"t":"translate","skill":"writing","q":"ترجم: «يا للأسف! لكن يمكنك زيارتي في أغسطس.»","ans":"Dommage ! Mais tu peux venir me voir en août.","alts":["dommage mais tu peux venir me voir en aout"],"why":"dommage + تحفظ (mais) + عرض بديل — بنية ودية."},{"t":"listen","skill":"listening","q":"استمع واختر وظيفة العبارة:","audio":"Et toi, tu as des projets ?","opts":["طلب تكرار","إعادة السؤال للطرف الآخر","اعتذار","وداع"],"a":1,"why":"Et toi تقلب السؤال على الطرف الآخر لتوسيع الحوار."},{"t":"speaking","skill":"speaking","q":"ابدأ حواراً عن الخطط: «إذن، ما خططك للعطلة؟»","target":"Alors, tu as des projets pour les vacances ?","why":"فتح حوار بسؤال مفتوح أول مهارة يختبرها المنتج الشفوي في DELF B1 — التمرين يدرّبك على بداية لا تُغلق الباب أمام الطرف الآخر."},{"t":"mcq","skill":"speaking","q":"أفضل سؤال لفتح حوار B1:","opts":["سؤال مفتوح يفتح باب جملة تالية","سؤال يُجاب بنعم/لا","تحية رسمية فقط","صمت"],"a":0,"why":"السؤال المفتوح لا يُغلق الحوار في أول ثانية."},{"t":"fill","skill":"speaking","q":"أكمل: «Et ___ ? Tu as aimé le film ?» (أي وأنت)","fr":"Et ___ ? Tu as aimé le film ?","ans":"toi","alts":["Toi"],"why":"relance بالضمير المنفصل toi."}],"homework":"سجّل محادثة دقيقتين مع نفسك: افتح الموضوع، وسّعه بأسئلة متتابعة، واختمه بلطف — ثم صلّح جملتين في الإعادة.","sources":[{"title":"تكلّم الفرنسية بثقة | لا تخف من الأخطاء | بودكاست فرنسي B1 - B2","channel":"Communications En Français","videoId":"yyB0B7brLAU","why":"بودكاست عن ثقة الحديث والخروج من جمود الأخطاء — يؤطر فتح الحوار وتوسيعه كمهارة لا ككلمات محفوظة.","cat":"Conversation","level":"B1","main":true,"dur":10},{"title":"Parler avec fluidité : 8 situations réelles pour progresser à l'oral","channel":"Pro en Français","videoId":"NbSccuzH_qc","why":"بودكاست تطبيقي بثمانية مواقف حقيقية للكلام السلس — يعرض جمل جاهزة لكل موقف كما ستستخدمها أنت في الحوار.","cat":"Conversation","level":"B1","extra":true},{"title":"Daily French Conversation Practice with Subtitles - Improve your Spoken French with Dialogues","channel":"CCube Academy","videoId":"fflhkR8OnWA","why":"مجموعة حوارات يومية بترجمة — مادة تدريب مثالية: استمع للحوار ثم أعد مثالته بدورك بتمثيل الأدوار.","cat":"Conversation","level":"B1","extra":true},{"title":"Règle 1 - Le secret pour améliorer ton français oral (ST FRA) | Apprendre le français","channel":"Français Authentique","videoId":"G90N8wK0sS0","why":"القاعدة الأولى لتحسين الإنتاج الشفوي من قناة بودكاست محترفة: الكلام المنتظم بالأخطاء أفضل من الصمت الكامل — منهجية تستحق التطبيق من اليوم.","cat":"Conversation","level":"B1","extra":true}],"supplements":[{"id":"NbSccuzH_qc","title":"Parler avec fluidité : 8 situations réelles pour progresser à l'oral","channel":"Pro en Français","why":"بودكاست تطبيقي بثمانية مواقف حقيقية للكلام السلس — يعرض جمل جاهزة لكل موقف كما ستستخدمها أنت في الحوار.","lang":"fr"},{"id":"fflhkR8OnWA","title":"Daily French Conversation Practice with Subtitles - Improve your Spoken French with Dialogues","channel":"CCube Academy","why":"مجموعة حوارات يومية بترجمة — مادة تدريب مثالية: استمع للحوار ثم أعد مثالته بدورك بتمثيل الأدوار.","lang":"fr"},{"id":"G90N8wK0sS0","title":"Règle 1 - Le secret pour améliorer ton français oral (ST FRA) | Apprendre le français","channel":"Français Authentique","why":"القاعدة الأولى لتحسين الإنتاج الشفوي من قناة بودكاست محترفة: الكلام المنتظم بالأخطاء أفضل من الصمت الكامل — منهجية تستحق التطبيق من اليوم.","lang":"fr"}]},{"id":"B1-t4-l2","fr":"Débattre et donner son opinion","ar":"النقاش وإبداء الرأي","objectives":["إبداء الرأي بمستويات تشديد متدرجة","الموافقة والاعتراض بالفرنسية الحية","إدارة نزاش مهذب ومثمر"],"sections":[{"h":"أدوات الرأي المتدرجة","p":["الرأي في B1 ليس شيئاً واحداً بل سلّم درجات: «Je trouve que» (تقدير شخصي)، «Je pense que» (اعتقاد)، «Je suis convaincu que» (يقين)، «Il me semble que» (انطباع متحفّظ). قمة السلّم تُقرأ في الكتابة الرسمية، وقاعه في المحادثة — والخطأ الأكبر استعمال الدرجة القصيرة في المحادثة.","أدوات الإقناع بوصفها مفاتيح: «En effet» تفتح تأكيداً، «C'est pourquoi» تربط سبباً بنتيجة، «Par ailleurs» تضيف وجهاً جديداً، «En revanche» تضع وجهين متعادلين. أربع أدوات تحوّل جملة محبطة إلى فقرة مقنعة — وهذا هو الفرق بين A2 وB1 في الكتابة.","تابع الفيديو الأساسي بالشرح العربي: الرأي والدفاع عنه بالعربية ثم الفرنسية — التركيز على «الدفاع» لا التعبير: رأي بلا حجة يسقط أمام أول اعتراض، ورأي بحجة وشاهد يصمد. الفيديو يبني دفاعاً ثلاثياً: موقف ← سبب ← مثال.","الموافقة والاعتراض بدرجاتها: موافقة كاملة («Tout à fait!»)، مُتحفّزة («Oui, mais...»)، محايدة («C'est possible»)، معارضة ملطفة («Je ne suis pas sûr(e)»). لاحظ أن «Oui, mais» ليست موافقة — إنها معارضة تُخفَّف، وأهم كلمة فيها mais لا Oui.","إدارة نقاش مهذب ومثمر: ثلاث قواعد — لا تُقاطع دون «une seconde»، لا تكرر نفس الحجة ثلاث مرات (بدّل الوجه لا الصياغة)، وأكِّل وجه الطرف («Tu as raison sur un point...») قبل أن تُفنّي وجهه. النقاش المثمر ينتهي بتوسّط لا بانتصار.","تمرين الدرجة: خذ جملة واحدة واصعدها أربع مرات من «je trouve» إلى «je suis convaincu» مع تعديل الشاهد كل مرة. السلّم الذهبي يمنعك من صياغة كل شيء بنفس النبرة — والتنوع في الدرجة جزء من التقييم في المقابلة الشفوية."],"video":{"id":"1RRIoTeXcSA","title":"Fr B1 | كيف تعبر عن رأيك وتدافع عنه بالفرنسية؟ Débattre et défendre son opinion","channel":"الفرنسية مع Sarita","why":"درس B1 صريح عن التعبير عن الرأي والدفاع عنه — التركيز على التدرّج والتعليل لا على العبارات الجامدة.","lang":"ar","main":true,"dur":17},"sub":[{"h":"سلّم الدرجات","p":["je trouve — تقدير شخصي.","je pense — اعتقاد.","je suis convaincu — يقين.","il me semble — انطباع متحفّظ."]},{"h":"مفاتيح الإقناع","p":["En effet — تأكيد.","C'est pourquoi — سبب/نتيجة.","Par ailleurs — وجها جديد.","En revanche — وجهان متعادلان."]},{"h":"الموافقة والاعتراض بدرجاتها","p":["Tout à fait — موافقة كاملة.","Oui, mais — معارضة مخفّفة.","Je ne suis pas sûr(e) — تحفّظ.","إقرار الوجه الآخر ثم الاعتراض."]}]},{"h":"الموافقة والاعتراض بدرجاتها","p":["الموافقة: Je suis d'accord (موافق) — Tout à fait (تماماً) — C'est exactement ce que je pense (هذا بالضبط ما أفكر فيه) — Tu as tout à fait raison (معك الحق تامة). الاعتراض اللطيف: Je ne suis pas d'accord، Je ne le vois pas comme ça (لا أرى الأمر هكذا)، Je ne suis pas sûr(e) de ça، Hmm, je comprends ton point de vue, mais... (أفهم موقفك لكن...).","الفرق بين الناطق المتقدم والمبتدئ يظهر في الاعتراض: المبتدئ يقول «Non» بلا مقدمات؛ المتقدم يهدّئ أولاً ثم يعترض: «Je vois ce que tu veux dire, mais...»، «C'est une idée intéressante, cependant...». درّب على نمط «اعترف ثم عارض» — هو مفتاح النقاش المهني أيضاً.","«C'est vrai que... mais...» أقوى بناة نقاش فرنسي: الإقرار أولاً يُفعّل أذن الطرف ثم يفتح الاعتراض على سَعة. الاعتراض المباشر بلا إقرار يُسمع رفضاً شخصياً مهما كانت منطوقته."],"video":null},{"h":"إدارة نقاش مهذب ومثمر","p":["لتشغيل نقاش بين أطراف: On pourrait débattre de... (يمكننا نقاش...) — Qu'en pensez-vous ? (ما رأيكم؟) — Laissez-moi finir, s'il vous plaît (دعني أُتمر من فضلك) — Nous ne sommes pas d'accord, mais c'est aussi bien comme ça (لا نتفق، وهذا سليم). النقاش البالغ ليس صراعاً بل تبادل: تُسمع، تُعترض بلطف، تُسلّم نقطة صحيحة.","في امتحان DELF B1 الشفوي يجلس معك متحدث آخر: ستعقدان نقاشاً حول ورقة موضوع. الخطة الذهبية: أطلق الرأي بعبارات واضحة، استخدم Et toi ? لدوره، اعترض بلطف مرة واحدة على الأقل، ثم سلّم بعبارة إيجابية. الممتحن يقيّم أدوات التفاعل أكثر من صحة الرأي نفسه.","تمرين السلّم: اكتب رأيك في قضية (العمل عن بُعد) أربع مرات بدرجات متدرّجة مع شاهد مختلف لكل مرة — ثم اقرأها بصوت عالٍ مغيّراً النبرة مع الدرجة."],"video":null},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: تعلّمت سلّم الرأي المتدرج من je trouve إلى je suis convaincu، ومفاتيح الإقناع (En effet, C'est pourquoi, Par ailleurs, En revanche)، ونمط «اعترف ثم عارض» في نقاش مهذب. أعد مشاهدة الفيديو الرئيسي وركّز على بنية الدفاع الثلاثية: موقف ← سبب ← مثال.","جسر الدروس: من B1-t4-l1 (إدارة حوار وطلاقة التحدث) إلى B1-t4-l2 (النقاش وإبداء الرأي)، ثم إلى B1-t4-l3 حيث تدعو وتقبل وترفض بلطفاً دون إساءة.","مهمة تطبيقية: سجّل نفسك دقيقة وأنت تلخّص الدرس وتعيد استخدام 3 كلمات جديدة، ثم قارن نطقك بالفيديو الرئيسي."]}],"examples":[{"fr":"À mon avis, le télétravail est une bonne chose.","ar":"برأيي، العمل عن بُعد أمر جيد."},{"fr":"Je ne le vois pas comme ça.","ar":"لا أرى الأمر هكذا."},{"fr":"Tu as raison, mais il y a un problème : le coût.","ar":"معك حق، لكن هناك مشكلة: التكلفة."},{"fr":"Qu'en pensez-vous ?","ar":"ما رأيكم؟"},{"fr":"Je suis convaincu que le vélo gagne en ville.","ar":"أنا واثق أن الدراجة تنتصر في المدينة.","note":"يقين"},{"fr":"C'est vrai que c'est cher, mais c'est fiable.","ar":"صحيح إنه غالٍ، لكنه موثوق.","note":"إقرار + معارضة"},{"fr":"En effet, les chiffres le confirment.","ar":"فعلاً، الأرقام تؤكد ذلك.","note":"تأكيد"},{"fr":"Je ne suis pas sûr qu'il ait tort.","ar":"لست متأكداً أنه مخطئ.","note":"تحفّظ + subjonctif"}],"pron":[{"w":"d'accord","ipa":"[da.kɔʁ]","approx":"دا-كور"},{"w":"cependant","ipa":"[sə.pɑ̃.dɑ̃]","approx":"سُه-بان-دان"},{"w":"qu'en pensez-vous","ipa":"[kɑ̃ pɑ̃.ze vu]","approx":"كان-بانزي-فو"}],"vocab":[{"fr":"donner son opinion","ar":"يعبّر عن رأيه","pos":"expression","ipa":"[dɔ.ne sɔ̃.na.pi.njɔ̃]","exFr":"Il sait donner son opinion avec tact.","exAr":"يحسن إبداء رأيه بمهارة."},{"fr":"un avis","ar":"رأي","pos":"nom","g":"m","pl":"des avis","ipa":"[a.vi]","exFr":"À mon avis, c'est une bonne idée.","exAr":"برأيي إنها فكرة جيدة."},{"fr":"un désaccord","ar":"خلاف / اختلاف","pos":"nom","g":"m","ipa":"[de.za.kɔʁ]","exFr":"C'est un petit désaccord, pas une guerre !","exAr":"إنه خلاف صغير، ليس حرباً!"},{"fr":"débattre","ar":"ينقاش","pos":"verbe","ipa":"[de.batʁ]","exFr":"On pourrait débattre de cette question.","exAr":"يمكننا نقاش هذه المسألة."},{"fr":"le point de vue","ar":"وجهة النظر","pos":"nom","g":"m","pl":"les points de vue","ipa":"[lə pwɛ̃ də vy]","exFr":"Je comprends ton point de vue.","exAr":"أفهم وجهة نظرك."},{"fr":"convaincu","ar":"مقتنع","pos":"adj","g":"mf","ipa":"[kɔ̃.vɛ̃.ky]","exFr":"Je suis convaincu que c'est possible.","exAr":"أنا مقتنع بأنه ممكن."},{"fr":"je suis convaincu(e)","ar":"أنا واثق","pos":"locution","exFr":"Je suis convaincu que tu as raison.","ipa":"[ʒə sɥi kɔ̃vɛ̃ky]","exAr":"أنا واثق أنك محق."},{"fr":"il me semble que","ar":"يبدو لي أن","pos":"locution","exFr":"Il me semble que c'est juste.","ipa":"[il mə sɑ̃bl kə]","exAr":"يبدو لي أنها عادلة."},{"fr":"c'est pourquoi","ar":"ولهذا/وإذن","pos":"locution","exFr":"Il pleut, c'est pourquoi je reste.","ipa":"[sɛ puʁkwa]","exAr":"تمطر، ولهذا أبقى."},{"fr":"par ailleurs","ar":"من جهة أخرى","pos":"locution","exFr":"Par ailleurs, le coût augmente.","ipa":"[paʁ ajœʁ]","exAr":"من جهة أخرى، التكلفة ترتفع."},{"fr":"tout à fait","ar":"تماماً/كلياً","pos":"locution","exFr":"Tout à fait d'accord.","ipa":"[tu ta fɛ]","exAr":"موافق تماماً."},{"fr":"nuance","ar":"تدرّج دقيق","pos":"nom","g":"f","exFr":"Il y a une nuance entre les deux.","ipa":"[nyɑ̃s]","exAr":"هناك تدرّج بين الاثنين."},{"fr":"défendre un avis","ar":"يدافع عن رأي","pos":"locution","exFr":"Défendre son avis avec des faits.","ipa":"[defɑ̃dʁ]","exAr":"الدفاع عن الرأي بالوقائع."},{"fr":"un avis tranché","ar":"رأي قاطع","pos":"nom","exFr":"Avoir un avis tranché.","ipa":"[avi tʁɑ̃ʃe]","exAr":"امتلاك رأي قاطع."},{"fr":"prendre en compte","ar":"يأخذ بعين الاعتبار","pos":"locution","exFr":"Prendre mon avis en compte.","ipa":"[pʁɑ̃dʁ ɑ̃ kɔ̃t]","exAr":"أخذ رأيي بعين الاعتبار."},{"fr":"concerne","ar":"يخصّ","pos":"verbe","g":"1er","exFr":"Cela concerne tout le monde.","ipa":"[kɔ̃sɛʁn]","exAr":"هذا يخص الجميع."},{"fr":"d'une part / d'autre part","ar":"من جهة / من جهة أخرى","pos":"locution","exFr":"D'une part utile, d'autre part cher.","ipa":"[dyn paʁ]","exAr":"من جهة مفيد، ومن جهة غالٍ."},{"fr":"nuire à","ar":"يضرّ بـ","pos":"locution","exFr":"Ça nuit à la santé.","ipa":"[nɥiʁ]","exAr":"هذا يضر الصحة."}],"grammar":[{"tFr":"La graduation des jugements","tAr":"القاعدة: تدرّج الأحكام","body":["عبارات الرأي تُدرَّج بالقوة: trouve < pense < convaincu — والنبرة تتبع الدرجة لا العكس.","مع le subjonctif بعد التحفظ: «je ne pense pas que...» و«il n'est pas sûr que...» تنقلان للمنصوب."],"ex":[{"fr":"Je trouve que ce plan est réaliste.","ar":"أرى أن هذا الخطة واقعية."},{"fr":"Je ne suis pas sûr que ça marche.","ar":"لست متأكداً أن هذا ينجح."}]}],"mistakes":[{"wrong":"«Je suis convaincu» في حديث عابر","right":"درجة مناسبة للسياق","why":"اليقين في التافه يُقرأ تطرّفاً."},{"wrong":"«Oui, mais» تُحسب موافقة","right":"معارضة مخفّفة — mais هي الجوهر","why":"سوء الفهم هنا يُفقد النقاش موضوعه."},{"wrong":"تكرار الحجة نفسها بصياغة جديدة","right":"إبدال الوجوه لا الصياغة","why":"التكرار يُقرأ تشبّثاً ويُضعف موقفك."},{"wrong":"الاعتراض بلا إقرار","right":"«C'est vrai que... mais...»","why":"الإقرار يُفعّل أذن الطرف أولاً."}],"dialogues":[{"title":"نقاش مهذب","ctx":"زميلان يختلفان حول العمل عن بُعد","lines":[{"who":"Reda","fr":"Je trouve que le télétravail augmente la productivité.","ar":"أرى أن العمل عن بُعد يرفع الإنتاجية."},{"who":"Salima","fr":"C'est vrai pour certains, mais l'équipe se disperse.","ar":"صحيح لبعض الناس، لكن الفريق يتشتت."},{"who":"Reda","fr":"En effet, il faut des règles — par exemple deux jours fixes.","ar":"فعلاً، يجب وضع قواعد — مثلاً يومان ثابتان."},{"who":"Salima","fr":"D'une part oui, d'autre part la cohésion en souffre.","ar":"من جهة نعم، ومن جهة الروابط تتأثر."},{"who":"Reda","fr":"Tu as raison sur la cohésion. On peut tester un mois ?","ar":"أنت محق بشأن الروابط. هل نجرب شهراً؟"},{"who":"Salima","fr":"Volontiers — test avec un retour collectif.","ar":"بكل سرور — تجربة مع تقييم جماعي."}]}],"exercises":[{"t":"mcq","skill":"speaking","q":"أي عبارة أهدأ للاعتراض؟","opts":["C'est faux !","Je ne le vois pas comme ça","Tu es complètement faux","Non, jamais"],"a":1,"why":"الاعتراض اللطيف يُطرح كرأي بديل لا كطعن مباشر."},{"t":"mcq","skill":"speaking","q":"«Je ne pense pas que ce ___ juste.» — أي صيغة تناسب؟","opts":["est","soit","était","sera"],"a":1,"why":"بعد نفي رأي (je ne pense pas que) يأتي subjonctif: soit."},{"t":"fill","skill":"speaking","q":"أكمل: «___ mon avis, c'est une excellente idée.»","fr":"___ mon avis, c'est une excellente idée.","ans":"À","alts":["a","Selon"],"why":"À mon avis أو selon moi — بنيتان قياسيتان."},{"t":"order","skill":"speaking","q":"رتّب نمط الاعتراض المهذب: (1) اعترض بـmais (2) اعترف بموقفه (3) اطرح بديلك","words":["Je","comprends","ton","point","de","vue,"],"ans":"Je comprends ton point de vue,","why":"الاعتراف أولاً ثم لكن ثم البديل — تسلسل مهدئ."},{"t":"listen","skill":"listening","q":"Écoute la réplique d'accord total et choisis le degré d'accord exprimé :","audio":"Tu as tout à fait raison, je te suis","opts":["اعتراض كامل","موافقة تامة","شك متوسط","سؤال توضيحي"],"a":1,"why":"tout à fait raison + je te suis = موافقة كاملة."},{"t":"speaking","skill":"speaking","q":"أبدِ رأيك شفوياً: «هل يجب على الأطفال تعلم لغتين؟» — رأي + سبب.","target":"Je pense que c'est très utile parce que les langues ouvrent des portes.","why":"إبداء رأي مدعوم بسبب في دقيقة واحدة هو صميم المنتج الشفوي في DELF B1 — يُقيَّم تدرّج الدرجة ووضوح التعليل لا طول الإجابة."},{"t":"mcq","skill":"speaking","q":"سلّم الرأي من الأقوى للأضعف:","opts":["convaincu > pense > trouve","trouve > pense > convaincu","penses > convaincu > trouve","pense = trouve = convaincu"],"a":0,"why":"je suis convaincu أقوى، وje trouve أخفها."},{"t":"translate","skill":"writing","q":"ترجم: «أنا واثق أن هذا الاختيار مفيد.»","ans":"Je suis convaincu que ce choix est utile.","alts":["je suis convaincu que ce choix est utile"],"why":"je suis convaincu = الدرجة الأقوى في سلّم الرأي."}],"homework":"اختر موضوعاً ساخناً (الشاشات، النقل العام...) واكتب برأيه: أطروحة + اعتراض لطيف + رد — ثم ناقشه شفوياً مع نفسك في دقيقة.","sources":[{"title":"Fr B1 | كيف تعبر عن رأيك وتدافع عنه بالفرنسية؟ Débattre et défendre son opinion","channel":"الفرنسية مع Sarita","videoId":"1RRIoTeXcSA","why":"درس B1 صريح عن التعبير عن الرأي والدفاع عنه — التركيز على التدرّج والتعليل لا على العبارات الجامدة.","cat":"Conversation","level":"B1","main":true,"dur":17},{"title":"Donner son opinion en français","channel":"Français avec Pierre","videoId":"-muc6OhocHg","why":"المرجع الأول لإبداء الرأي: عبارات مركّبة مع الفروق بينها وبأمثلة واقعية — أساس كل نقاش تعقده بالفرنسية.","cat":"Conversation","level":"B1","extra":true},{"title":"Exprimer son accord/désaccord en français","channel":"Campus Langues","videoId":"JYT40AjLntA","why":"فيديو تعليمي قصير ومركّز على الموافقة والاعتراض بعبارات كثيرة مفصولة بالدرجات — تدريب سريع مكتمل.","cat":"Conversation","level":"B1","extra":true},{"title":"DELF B1 - Les expressions d'opinion INDISPENSABLES !","channel":"French School TV","videoId":"sMQgw6KQQSQ","why":"عبارات الرأي الضرورية مقصودة للامتحان — يريك ما يريده الممتحن بالضبط في قسم الإنتاج الشفوي.","cat":"Conversation","level":"B1","extra":true}],"supplements":[{"id":"-muc6OhocHg","title":"Donner son opinion en français","channel":"Français avec Pierre","why":"المرجع الأول لإبداء الرأي: عبارات مركّبة مع الفروق بينها وبأمثلة واقعية — أساس كل نقاش تعقده بالفرنسية.","lang":"fr"},{"id":"JYT40AjLntA","title":"Exprimer son accord/désaccord en français","channel":"Campus Langues","why":"فيديو تعليمي قصير ومركّز على الموافقة والاعتراض بعبارات كثيرة مفصولة بالدرجات — تدريب سريع مكتمل.","lang":"fr"},{"id":"sMQgw6KQQSQ","title":"DELF B1 - Les expressions d'opinion INDISPENSABLES !","channel":"French School TV","why":"عبارات الرأي الضرورية مقصودة للامتحان — يريك ما يريده الممتحن بالضبط في قسم الإنتاج الشفوي.","lang":"fr"}]},{"id":"B1-t4-l3","fr":"Inviter, accepter, refuser","ar":"الدعوة، القبول، الرفض الماهر","objectives":["صياغة دعوات رسمية وغير رسمية","قبول الدعوة مع تفاصيل الحضور","رفض الدعوة بلطف دون إساءة"],"sections":[{"h":"صياغة الدعوة","p":["صياغة الدعوة في B1 تتجاوز «Tu viens ؟» إلى سلّم من ثلاث صيغ: مباشرة بين المألوفين («On se voit vendredi ?»)، مهذّبة («Ça te dit qu'on dîne ensemble ؟»)، ورسمية («Je vous invite à...»). اختيار الصيغة حسب العلاقة هو اللباقة الأولى — والخطأ هنا اجتماعي قبل أن يكون لغوياً.","القبول بلباقة واهتمام: «Avec plaisir !» للعرض المباشر، «Volontiers !» للحماس، «Oui, avec joie» للاحتفال. ثم يُضاف التأكيد: «Je t'enverrai l'adresse» أو «Je confirme ce soir» — القبول بلا تأكيد فعلي يُقرأ رقّة عابرة في الدوائر الفرنسية.","تابع الفيديو الأساسي بالشرح العربي: قبول بلمحة واهتمام — الدرس يبني الاستجابة الكاملة: ترحيب ← قبول ← تأكيد ← موعد. ثلاث خطوات بعد نعم تصنع انطباع الالتزام، وهي ما يميّز B1 عن من يحفظ جملة واحدة.","فن الرفض اللطيف أصعب ما في الدرس: الرفض المجرد («Je ne peux pas») يغلق، والرفض المبني (اعتذار ← سبب ← بديل) يُبقي الباب. «Désolée, j'ai rendez-vous. Dimanche, ça te dit ؟» — ثلاث لبنات، والثالثة هي الأهم: البديل يثبت أن الرفض عن الشخص لا عن الدعوة.","التردد المقبول (l'hésitation): «Je dois vérifier mon agenda...», «Ça me tente, mais laisse-moi voir» — الفرنسية تُقدّر التردد المنظّم على النعم الفورية غير المضمونة. التردد ثم النعم أصدق من النعم ثم الإلغاء — والدرس كله عن هذه الأخلاق الزمنية.","خريطة أسبوعة المتابعة: بعد القبول، رسالة تأكيد يومية قبل الموعد («Je confirme pour 19h») وبعد الموعد شكر («Merci pour la soirée»). سلسلة القبول ← التأكيد ← الشكر هي دورة كاملة تبنى عليها علاقات فرنسية طويلة."],"video":{"id":"XKX3n1AxDcY","title":"exprimer une invitation: accepter et refuser التعبير عن الدعوة مع القبول و الرفض","channel":"so much better french","why":"الدعوة ثم القبول والرفض والتذبذب في فيديو واحد — يغطي محورَي النموذج والرفض بأدب معًا.","lang":"ar","main":true,"dur":11},"sub":[{"h":"سلّم صياغة الدعوة","p":["مباشرة: On se voit vendredi ?","مهذّبة: Ça te dit qu'on... ؟","رسمية: Je vous invite à...","الصيغة تتبع العلاقة لا المزاج."]},{"h":"القبول: ثلاث خطوات","p":["Avec plaisir / Volontiers.","الحماس: Ça m'arrange !","التأكيد: Je confirme ce soir.","القبول بلا تأكيد رقّة عابرة."]},{"h":"الرفض المبني: ثلاث لبنات","p":["اعتذار: Désolée...","سبب: j'ai rendez-vous.","بديل: Dimanche, ça te dit ؟","البديل أهم لبنة."]}]},{"h":"القبول بلباقة واهتمام","p":["القبول السريع: «Oui, avec plaisir !»، «Ça marche !»، «Super, j'accepte !». القبول المشروط: «Oui, tant que ce n'est pas trop tard» (بشرط ألا يتأخر الوقت)، «D'accord, mais je dois partir à 22h». بعد القبول مباشرة: سؤال تفاصيل يظهر الاهتمام: «C'est à quelle heure ? Je ramène quelque chose ?» (أحضر شيئاً؟) — السؤال الأخير عادة فرنسية محبوبة.","الرد على الدعوة بوقت مناسب: الفرنسيون يقدّرون الرد ضمن يوم. الرسالة النموذجية: «Merci pour l'invitation ! Je viens avec plaisir. Tu as besoin d'aide pour quelque chose ?» — بسيطة، دافئة، عملية.","«Je dois vérifier...» ثم الرد النهائي في نفس اليوم — تأخّر الجواب يُقرأ كرفض مهذّب أصلاً. القاعدة الاجتماعية: أو جواب اليوم أو اعتذار اليوم، لا صمت حتى الموعد."],"video":null},{"h":"فن الرفض اللطيف","p":["صيغة الرفض المهذب من ثلاث خطوات: 1) شكر أو تقدير: «Merci pour l'invitation !» أو «C'est gentil de penser à moi». 2) رفض مُبرَّر أو مُحفَّف: «Malheureusement, je ne peux pas»، «J'aimerais tellement, mais j'ai déjà un engagement»، «Ce n'est pas possible pour moi cette fois». 3) باب مفتوح أو تمنّي: «Une autre fois, promis !»، «Ça me ferait plaisir une autre fois».","احذر الرفض المباشر المجرد («Non, je ne veux pas») — يبدو فظاً حتى لو كان صادقاً. واحذر الوعود الزائفة («Peut-être, on verra» عند يقين الرفض) — الفرنسيون يقرؤونها تجنباً. الرفض الأمين المعطّف (شكر + سبب قصير + ودّ) هو الأنضج اجتماعياً.","تمرين الدورة كاملة: اكتب سلسلة من ثلاث رسائل قصيرة — دعوة، قبول مع تأكيد، ثم شكر بعد الموعد. الدورة الثلاثية تُبقي علاقاتك حية بعيداً عن لحظة الدعوة وحدها."],"video":null},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: تعلّمت سلّم صياغة الدعوة من المباشر إلى الرسمي، والقبول بثلاث خطوات (نعم ← تفاصيل ← تأكيد)، والرفض المبني من ثلاث لبنات: اعتذار ← سبب ← بديل. أعد مشاهدة الفيديو الرئيسي وركّز على الفرق بين القبول العابر والقبول المؤكد برسالة تأكيد.","جسر الدروس: من B1-t4-l2 (النقاش وإبداء الرأي) إلى B1-t4-l3 (الدعوة، القبول، الرفض الماهر)، ثم إلى B1-t5-l1 حيث تفهم الأخبار المنطوقة وتميّز مفرداتها.","مهمة تطبيقية: سجّل نفسك دقيقة وأنت تلخّص الدرس وتعيد استخدام 3 كلمات جديدة، ثم قارن نطقك بالفيديو الرئيسي."]}],"examples":[{"fr":"Ça te dit de manger ensemble vendredi ?","ar":"ما رأيك أن نأكل معاً الجمعة؟"},{"fr":"Oui, avec plaisir ! Je ramène le dessert ?","ar":"نعم، بكل سرور! أحضر الحلوى؟"},{"fr":"J'aimerais tellement, mais j'ai déjà un engagement.","ar":"تمنيت كثيراً، لكن عندي التزام سابق."},{"fr":"Une autre fois, promis !","ar":"في مناسبة أخرى، أَعِدك!"},{"fr":"On se voit vendredi soir, ça te dit ؟","ar":"نرى الجمعة مساءً، ما رأيك؟","note":"مباشرة"},{"fr":"Avec plaisir ! Je confirme ce soir.","ar":"بكل سرور! سأؤكد المساء.","note":"قبول + تأكيد"},{"fr":"Désolée, j'ai rendez-vous. Dimanche ؟","ar":"آسفة، لدي موعد. الأحد؟","note":"رفض مبني"},{"fr":"Je dois vérifier — je te dis dans la journée.","ar":"يجب أن أتحقق — سأخبرك خلال اليوم.","note":"تردد منظم"}],"pron":[{"w":"Ça te dit ?","ipa":"[sa tə di]","approx":"سا-ته-دي","note":"ما رأيك؟"},{"w":"avec plaisir","ipa":"[a.vɛk ple.ziʁ]","approx":"آفك-بليزير"},{"w":"malheureusement","ipa":"[ma.lø.ʁøz.mɑ̃]","approx":"مالُهروزمان"}],"vocab":[{"fr":"inviter","ar":"يدعو","pos":"verbe","ipa":"[ɛ̃.vi.te]","exFr":"Je t'invite chez moi samedi.","exAr":"أدعوك إلى بيتي السبت."},{"fr":"une invitation","ar":"دعوة","pos":"nom","g":"f","ipa":"[ɛ̃.vi.ta.sjɔ̃]","exFr":"Merci pour ton invitation !","exAr":"شكراً على دعوتك!"},{"fr":"accepter","ar":"يقبل","pos":"verbe","ipa":"[ak.sɛp.te]","exFr":"J'accepte avec plaisir.","exAr":"أقبل بسرور."},{"fr":"refuser","ar":"يرفض","pos":"verbe","ipa":"[ʁe.fy.ze]","exFr":"Je refuse poliment.","exAr":"أرفض بلطف."},{"fr":"un engagement","ar":"التزام","pos":"nom","g":"m","pl":"des engagements","ipa":"[ɑ̃.ɡa.ʒə.mɑ̃]","exFr":"J'ai déjà un engagement ce soir.","exAr":"عندي التزام سابق الليلة."},{"fr":"être libre","ar":"يكون حراً/متاحاً","pos":"expression","ipa":"[ɛtʁ libʁ]","exFr":"Tu es libre vendredi soir ?","exAr":"هل أنت حر مساء الجمعة؟"},{"fr":"volontiers","ar":"بكل سرور","pos":"adv","exFr":"Oui, volontiers !","ipa":"[vɔlɔ̃tje]","exAr":"نعم، بكل سرور!"},{"fr":"un contretemps","ar":"ظرف طارئ يُفسد الخطة","pos":"nom","g":"m","ipa":"[œ̃ kɔ̃tʁɑ̃]","exFr":"Un contretemps m'empêche de venir ce soir.","exAr":"ظرف طارئ يمنعني من المجيء الليلة."},{"fr":"vérifier mon agenda","ar":"أتحقق من جدولي","pos":"locution","exFr":"Je dois vérifier mon agenda.","ipa":"[veʁife]","exAr":"يجب أن أتحقق من جدولي."},{"fr":"confirmer","ar":"يؤكد","pos":"verbe","g":"1er","exFr":"Je confirme par message.","ipa":"[kɔ̃fiʁme]","exAr":"أؤكد بالرسالة."},{"fr":"la soirée","ar":"المساء/حفل المساء","pos":"nom","g":"f","exFr":"Merci pour la soirée !","ipa":"[swaʁe]","exAr":"شكراً على المساء!"},{"fr":"prendre date","ar":"يثبّت الموعد","pos":"locution","exFr":"On prend date pour mardi ?","ipa":"[pʁɑ̃dʁ dat]","exAr":"نثبت الموعد للثلاثاء؟"},{"fr":"un créneau","ar":"فترة زمنية متاحة","pos":"nom","g":"m","exFr":"J'ai un créneau à 18h.","ipa":"[kʁeno]","exAr":"لدي فترة في السادسة."},{"fr":"le déçu(e)","ar":"خائب الأمل","pos":"adj","exFr":"Je suis déçu d'entendre ça.","ipa":"[desɥi]","exAr":"محبط لسماع ذلك."},{"fr":"faire plaisir","ar":"يُسعد/يستمتع بـ","pos":"locution","exFr":"Ça me ferait plaisir.","ipa":"[fɛʁ plɛziʁ]","exAr":"سيُسعدني ذلك."},{"fr":"à contre-courant","ar":"عكس التيار","pos":"locution","exFr":"Proposer à contre-courant.","ipa":"[a kɔ̃t kuʁɑ̃]","exAr":"اقتراح عكس التيار."},{"fr":"décommander","ar":"يلغي الحضور","pos":"verbe","g":"1er","exFr":"Je dois décommander, pardon.","ipa":"[dekɔmɑ̃de]","exAr":"أضطر للإلغاء، عفواً."},{"fr":"compté(e) sur","ar":"يَعتمد على","pos":"locution","exFr":"Je comptais sur toi.","ipa":"[kɔ̃te syʁ]","exAr":"كنت أعتمد عليك."}],"grammar":[{"tFr":"Inviter, hésiter, refuser au niveau B1","tAr":"القاعدة: الدعوة والتردد والرفض بمستوى B1","body":["الدعوات تأخذ infinitive مع à: «je vous invite à dîner»، بينما العروض المباشرة تأخذ على/questions: «on dîne ?».","الرفض يُبنى بـ «je dois + infinitive» (التزام سابق) ثم بديل — قوّة البديل هي قوّة الرفض المهذّب."],"ex":[{"fr":"Je vous invite à dîner vendredi.","ar":"أدعوكم لعشاء الجمعة."},{"fr":"Je ne peux pas, j'ai cours. On fait dimanche ?","ar":"لا أستطيع، لدي درس. نفعلها الأحد؟"}]}],"mistakes":[{"wrong":"رفض بلا بديل","right":"اعتذار + سبب + بديل","why":"الرفض بلا بديل يُقرأ رأياً في الشخص لا في الموعد."},{"wrong":"النعم الفورية غير المؤكدة","right":"تردد قصير ثم جواب في نفس اليوم","why":"النعم ثم الإلغاء أسوأ من التردد أصلاً."},{"wrong":"دعوة رسمية بصيغة مألوفة","right":"Je vous invite مع vous","why":"الخطأ في الضمير يُقرأ عنفاً في الدعوة لا خطأً صغيراً."},{"wrong":"إهمال التأكيد بعد القبول","right":"Je confirme / je t'envoie","why":"الفرنسيون ينتظرون التأكيد الكتابي — غيابه يترك الباب معلقاً."}],"dialogues":[{"title":"دعوة مع تردد ثم قبول","ctx":"رسالة بين زميلين","lines":[{"who":"Ahmed","fr":"On se voit vendredi pour le vernissage ?","ar":"نرى الجمعة لمعرض الافتتاح؟"},{"who":"Claire","fr":"Ça me tente ! Mais je dois vérifier mon agenda.","ar":"هذا يجذبني! لكن يجب أن أتحقق من جدولي."},{"who":"Ahmed","fr":"Pas de souci — dis-moi ce soir.","ar":"لا مشكلة — أخبرني المساء."},{"who":"Claire","fr":"Ça marche. Je confirme avant 21h.","ar":"اتفق. سأؤكد قبل التاسعة."},{"who":"Ahmed","fr":"Parfait, je compte sur toi !","ar":"ممتاز، أنا معتمد عليك!"},{"who":"Claire","fr":"Promis — et merci pour l'invitation !","ar":"وعد — وشكراً على الدعوة!"}]}],"exercises":[{"t":"mcq","skill":"speaking","q":"دعوة غير رسمية لصديق تقول:","opts":["Nous avons le plaisir de vous inviter","Ça te dit de sortir ?","Seriez-vous disponible","Veuillez accepter notre invitation"],"a":1,"why":"Ça te dit ? صيغة غير رسمية طبيعية بين الأصدقاء."},{"t":"mcq","skill":"speaking","q":"ترتيب الرفض المهذب الصحيح:","opts":["رفض + شكر","شكر + رفض مبرر + باب مفتوح","رفض مباشر فقط","تجاهل الرسالة"],"a":1,"why":"شكر ← رفض مخفف ← ودّ يفتح المستقبل."},{"t":"fill","skill":"speaking","q":"أكمل القبول: «Oui, ___ plaisir !»","fr":"Oui, ___ plaisir !","ans":"avec","alts":["avec"],"why":"avec plaisir = بكل سرور — قبول قياسي."},{"t":"order","skill":"speaking","q":"رتّب جملة الدعوة الكاملة: (1) tu peux venir vers 20h ? (2) On organise un dîner samedi soir (3) chez nous","words":["On","organise","un","dîner","samedi","soir."],"ans":"On organise un dîner samedi soir.","why":"ماذا → متى → أين → تفاصيل الوقت."},{"t":"listen","skill":"listening","q":"استمع للرد واختر معناه:","audio":"J'aimerais tellement, mais j'ai déjà un engagement ce soir","opts":["قبول كامل","رفض مهذب بسبب التزام","تأجيل بلا قرار","سؤال عن الوقت"],"a":1,"why":"تمني + لكن + سبب = رفض لطيف مؤكد."},{"t":"writing","skill":"writing","q":"اكتب رسالة رفض لطيفة لصديق دعاك لحفلة يوم تتدرب فيه للامتحان: شكر + سبب + باب مفتوح.","min":15,"kw":["merci","mais","une autre fois"],"sample":"Salut Karim ! Merci beaucoup pour l'invitation ! J'aimerais tellement venir, mais j'ai un examen samedi et je dois réviser. Promis, on se voit une autre fois très bientôt ! À bientôt, Amine.","why":"كتابة رفض مبني من ثلاث لبنات تدرّب مهارة اجتماعية حساسة عند B1: الحفاظ على العلاقة دون التزام — هدف لغوي واجتماعي في آن واحد."},{"t":"mcq","skill":"speaking","q":"الرفض المهذّب في الدعوة يتكوّن من:","opts":["اعتذار + سبب + بديل","رفض مباشر","صمت","تأجيل بلا جواب"],"a":0,"why":"البديل يثبت أن الرفض عن الموعد لا عن الشخص."},{"t":"translate","skill":"speaking","q":"ترجم: «عذراً، لدي موعد. هل الأحد يصلح؟»","ans":"Désolé, j'ai rendez-vous. Dimanche te convient ?","alts":["desole, j ai rendez-vous. Dimanche te convient ?","Désolé j ai rendez-vous Dimanche te convient"],"why":"اعتذار + سبب + بديل بصيغة السؤال."}],"homework":"اكتب ثلاث رسائل حقيقية بالفرنسية: دعوة لصديق، قبول لرسالة دعوة، ورفض لطيف لمقابلة غير ممكنة.","sources":[{"title":"exprimer une invitation: accepter et refuser التعبير عن الدعوة مع القبول و الرفض","channel":"so much better french","videoId":"XKX3n1AxDcY","why":"الدعوة ثم القبول والرفض والتذبذب في فيديو واحد — يغطي محورَي النموذج والرفض بأدب معًا.","cat":"Conversation","level":"B1","main":true,"dur":11},{"title":"CONVERSATION en français #1 | INVITER, ACCEPTER, REFUSER","channel":"French School TV","videoId":"oFYJQzMbsGk","why":"درس محاور مباشر بمواقف دعوة متعددة وحوارات كاملة — يغطي الدرس بأكمله في فيديو واحد مهيكل.","cat":"Conversation","level":"B1","extra":true},{"title":"Accepter/Refuser une invitation en français","channel":"onparle","videoId":"mDKzQqyPNTo","why":"دروس قصيرة بالعربية-الفرنسية لقبول ورفض الدعوة بعباراتها الدقيقة — جسر جيد للناطقين بالعربية بين عبارات الكتاب والكلام الحي.","cat":"Conversation","level":"B1","extra":true},{"title":"Comment refuser poliment en français ?","channel":"Français Authentique","videoId":"njJIK5tgKuo","why":"درس متخصص في الرفض المهذب — مهارة تميّز الناطق المتقدم: الرفض دون إساءة ودون كذبة معقدة.","cat":"Conversation","level":"B1","extra":true}],"supplements":[{"id":"oFYJQzMbsGk","title":"CONVERSATION en français #1 | INVITER, ACCEPTER, REFUSER","channel":"French School TV","why":"درس محاور مباشر بمواقف دعوة متعددة وحوارات كاملة — يغطي الدرس بأكمله في فيديو واحد مهيكل.","lang":"fr"},{"id":"mDKzQqyPNTo","title":"Accepter/Refuser une invitation en français","channel":"onparle","why":"دروس قصيرة بالعربية-الفرنسية لقبول ورفض الدعوة بعباراتها الدقيقة — جسر جيد للناطقين بالعربية بين عبارات الكتاب والكلام الحي.","lang":"fr"},{"id":"njJIK5tgKuo","title":"Comment refuser poliment en français ?","channel":"Français Authentique","why":"درس متخصص في الرفض المهذب — مهارة تميّز الناطق المتقدم: الرفض دون إساءة ودون كذبة معقدة.","lang":"fr"}]}]},{"id":"b1-t5","slug":"listening","icon":"🎧","color":"#E11D48","fr":"Écoute","ar":"مسار الاستماع","desc":"أذن متوسطة مستقلة: الأخبار بالفرنسية السهلة، البودكاست كأداة تعلم يومية، وفهم الفرنسية السريعة الطبيعية.","lessons":[{"id":"B1-t5-l1","fr":"Comprendre les actualités","ar":"فهم الأخبار","objectives":["متابعة نشرة أخبار مبسطة واستخراج عناوينها","إتقان مفردات الإخبار الأساسية وأنواع القصص","التمييز بين الخبر والرأي في الوسائط"],"sections":[{"h":"نشرة الفرنسية السهلة: مدخلك للأخبار","p":["نشرة الفرنسية السهلة مدخلك للأخبار لأنها تُترجم لك ثلاث مرات: لغة مبسطة، سرعة مخفّضة، ونصّ مرفق. منها تنتقل إلى النشرة الحية — والقفزة تشبه قفزة القراءة: نفس الأخبار، سرعة أعلى، ومفردات أقل تكراراً.","استخراج العناوين من النشرة: العنوان يحمل الحدث في 6-10 كلمات، وغالباً بصيغة اسمية («Nouvelle baisse du chômage»). لاحظ الأسماء أولاً، ثم الأرقام، ثم الفعل المخفي في الاسم — من يفكّ اسماً واحداً يملك الخبر.","تابع الفيديو الأساسي بالشرح العربي: مفردات وعبارات نشرات الأخبار الأكثر تكراراً لتفهم مواضيع الساعة — مفردات تظهر في كل نشرة: «selon», «enquête», «mesures», «réforme», «porter plainte». عشرون كلمة تفتح افتتاحية أي نشرة فرنسية.","النموذج: كيف تستخرج العناوين؟ خذ 5 عناوين من نشرة واحدة وحوّل كل عنوان إلى جملة خبرية كاملة («Hausse des prix» ← «Les prix ont augmenté»). التحويل الاسمي العكسي هو التمرين الأقوى لفكّ العناوين وإعادة بنائها في الكتابة.","التمرين الأسبوعي: خبر واحد بعمق — اختر خبراً واحداً، اسمعه ثلاث مرات (للتعميم، للمفردات، للصياغة)، ثم اكتبه من 80 كلمة بصيغتك مع الارتباطات المناسبة. عمق خبر واحد يعلّمك أكثر من عشرة عناوين سطحية.","الأرقام والتفاصيل: في الأخبار الأرقام هي الخبر — لاحظ les pourcentages, les milliards, les points. دوّن الأرقام على ورقة أثناء السماع (technique du relevé) — الذاكرة السمعية تحفظ الاتجاه لا الرقم، والورقة تحفظ الرقم."],"video":{"id":"3gxS2q7byUQ","title":"Journal en français تعلم المفردات والعبارات المستخدمة بكثرة في نشرات الأخبار لتفهم مواضيع الساعة","channel":"تعلم و تكلم الفرنسية مع نادية French with Nadia","why":"مفردات وعبارات نشرات الأخبار الأكثر تكراراً لتفهم مواضيع الساعة — مفتاح فهم الجملة الإخبارية قبل الترجمة.","lang":"ar","main":true,"dur":10},"sub":[{"h":"من النشرة المبسطة إلى الحية","p":["نفس الخبر بسرعتين.","نص مرفق + ترجمة فورية.","الانتقال: منصة RFI ← TV5 ← TF1.","الثقة أولاً ثم السرعة."]},{"h":"فكّ العناوين","p":["العنوان = اسم مكثّف 6-10 كلمات.","الأسماء ثم الأرقام ثم الفعل.","التحويل العكسي: Hausse ← Les prix ont augmenté.","5 عناوين ← 5 جُمل كاملة."]},{"h":"مفردات النشرة الدائمة","p":["selon / enquête / mesures.","réforme / porter plainte / budget.","relevé الأرقام على ورقة.","خبر واحد بعمق أسبوعياً."]}]},{"h":"نموذج نشرة: كيف تستخرج العناوين؟","p":["نشرة الأخبار تُبنى كقائمة: المذيع يقرأ العناوين سريعاً في المقدمة (revue de presse)، ثم يفصّل كل خبر بدوره. تدريبك الأول: عدّ أخبار النشرة (غالباً 4-6) واكتب لكل خبر سطراً واحداً: «L'ONU appelle à un cessez-le-feu»، «Microsoft annonce une nouvelle application». لا تنتج جملة كاملة بل عنوان اسمي مثل العناوين الصحفية.","مفردات الإخبار الجوهرية: une source (مصدر)، annoncer (يعلن)، confirmer (يؤكد)， dénoncer (يدان)، selon la police (حسب الشرطة)، des blessés (جرحى)، un bilan (حصيلة). هذه الكلمات ستظهر في كل نشرة — أحدها تسمعه اليوم ستسمعه غداً في خبر آخر.","المصطلحات القطاعية تأتي حزمات: في الأخبار الاقتصادية (PIB, inflation, croissance)، وفي الأخبار السياسية (gouvernement, opposition, débat)، وفي الاجتماعية (grève, allocation). تعلّم الحزمة لا الكلمة — الحزمة تتنبأ بما يلي."],"video":null},{"h":"التمرين الأسبوعي: خبر واحد بعمق","p":["بدل الانتشار في عشرات الأخبار، اختر خبراً واحداً أسبوعياً وتعامل معه بعمق: استمع ثلاث مرات، اكتب ملخصه في 3 جمل، دوّن 5 كلمات جديدة، ثم أعد إخباره لصديقك الافتراضي بفرنسيتك. خبر واحد بعمق يتفوق على عشرة خبرات سطحيين.","مهارة B1 المميزة: التمييز بين الخبر والرأي. الخبر: «Le gouvernement a annoncé une réforme» (واقعة قابلة للتحقق). الرأي: «Cette réforme est inutile» (حكم). المذيع في RFI يلتزم الخبر؛ المعلقون في البرامج يلعبون بالرأي. تدرب أذنك على التقاط كلمات الرأي (je pense, malheureusement, il faut) لتمييز اللونين.","بعد الفيديو: افتح نشرة RFI اليومية واكتب عنوانين في سطرين — الأول كما سمعته، والثاني كجملة خبرية كاملة. خمس دقائق يومياً تبني طبقة المفردات الإخبارية في شهر."],"video":null},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: أتقنت استخراج العناوين من نشرة الفرنسية السهلة، ومفردات النشرة الدائمة (selon, enquête, bilan, mesure)، والتمييز بين الخبر والرأي، وتقنية relevé للأرقام. أعد مشاهدة الفيديو الرئيسي وركّز على الاسم المكثّف في العناوين («Nouvelle baisse du chômage») وعلى الكلمة التي تفتتح بها الجملة الإخبارية.","جسر الدروس: من B1-t4-l3 (الدعوة والقبول والرفض بلباقة) إلى B1-t5-l1 (فهم الأخبار واستخراج عناوينها والتمييز بين الخبر والرأي)، ثم إلى B1-t5-l2 حيث تنتقل من النشرة القصيرة إلى البودكاست الطويل وتُبني روتين استماع يومي.","مهمة تطبيقية: استمع إلى نشرة RFI السهلة دقيقة واحدة، ثم سجّل صوتك أو اكتب في دقيقة ملخصاً من ثلاثة أسطر يستعمل 3 كلمات جديدة من مفردات الدرس، وقارن صياغتك بجملة من الفيديو الرئيسي واذكر الفرق بينهما."]}],"examples":[{"fr":"Selon la police, l'accident a fait trois blessés.","ar":"حسب الشرطة، تسبب الحادث في 3 إصابات."},{"fr":"Les autorités ont annoncé de nouvelles mesures.","ar":"أعلنت السلطات إجراءات جديدة."},{"fr":"En résumé, la situation s'améliore.","ar":"خلاصة القول، الوضع يتحسن."},{"fr":"Le journal rapporte que...","ar":"تُفيد الجريدة أن..."},{"fr":"Selon l'enquête, les prix ont encore baissé.","ar":"حسب الاستطلاع، انخفضت الأسعار مجدداً.","note":"قالب النشرة"},{"fr":"« Nouvelle baisse du chômage » = les chômeurs ont diminué.","ar":"«انخفاض جديد في البطالة» = انخفض العاطلون.","note":"تحويل عكسي"},{"fr":"Le gouvernement a annoncé trois mesures.","ar":"أعلنت الحكومة عن ثلاثة إجراءات.","note":"صيغة رسمية"},{"fr":"J'ai noté le chiffre sur mon cahier.","ar":"دوّنت الرقم في دفتري.","note":"relevé"}],"pron":[{"w":"une source","ipa":"[syʁs]","approx":"سيرس"},{"w":"un bilan","ipa":"[bi.lɑ̃]","approx":"بي-لان","note":"الحصيلة/النتيجة"},{"w":"selon","ipa":"[sə.lɔ̃]","approx":"سُه-لون"}],"vocab":[{"fr":"un reportage","ar":"تقرير / خبر مُفصَّل","pos":"nom","g":"m","pl":"des reportages","ipa":"[ʁə.pɔʁ.taʒ]","exFr":"Le reportage dure cinq minutes.","exAr":"التقرير يدوم خمس دقائق."},{"fr":"révéler","ar":"يكشف (خبراً)","pos":"verbe","ipa":"[ʁe.ve.le]","exFr":"Le journal a révélé de nouveaux éléments.","exAr":"الجريدة كشفت عناصر جديدة."},{"fr":"une enquête","ar":"تحقيق / استقصاء","pos":"nom","g":"f","pl":"des enquêtes","ipa":"[ɑ̃.kɛt]","exFr":"Une enquête est en cours.","exAr":"التحقيق جارٍ."},{"fr":"un bilan","ar":"حصيلة","pos":"nom","g":"m","pl":"les bilans","ipa":"[bi.lɑ̃]","exFr":"Le bilan de l'accident est lourd.","exAr":"حصيلة الحادث ثقيلة."},{"fr":"décrypter","ar":"يفكّ الشفرة / يحلّل","pos":"verbe","ipa":"[dek.ʁip.te]","exFr":"Le journaliste décrypte la réforme.","exAr":"الصحفي يحلّل الإصلاح."},{"fr":"s'améliorer","ar":"يتحسن","pos":"verbe","ipa":"[sa.me.ljo.ʁe]","exFr":"La situation s'améliore.","exAr":"الوضع يتحسن."},{"fr":"un bulletin d'information","ar":"نشرة إخبارية","pos":"nom","exFr":"Écouter le bulletin de 20h.","ipa":"[bylɛtɛ̃ ɛ̃fɔʁmasjɔ̃]","exAr":"الاستماع إلى نشرة الثامنة."},{"fr":"la une (du JT)","ar":"أبرز الأخبار","pos":"nom","g":"f","exFr":"À la une ce soir.","ipa":"[yn]","exAr":"أبرز الأخبار مساءً."},{"fr":"réforme","ar":"إصلاح","pos":"nom","g":"f","exFr":"La réforme du système.","ipa":"[ʁefɔʁm]","exAr":"إصلاح النظام."},{"fr":"mesure","ar":"إجراء","pos":"nom","g":"f","exFr":"Prendre des mesures.","ipa":"[məzyʁ]","exAr":"اتخاذ إجراءات."},{"fr":"enquête","ar":"استطلاع/تحقيق","pos":"nom","g":"f","exFr":"Une enquête récente.","ipa":"[ɑ̃kɛt]","exAr":"استطلاع حديث."},{"fr":"le pourcentage","ar":"النسبة المئوية","pos":"nom","g":"m","exFr":"Un pourcentage de 10 %.","ipa":"[puʁsɑ̃taʒ]","exAr":"نسبة 10%."},{"fr":"grève","ar":"إضراب","pos":"nom","g":"f","exFr":"Il y a une grève demain.","ipa":"[ɡʁɛv]","exAr":"هناك إضراب غداً."},{"fr":"réagir","ar":"يستجيب/يعلّق","pos":"verbe","g":"irr","exFr":"Le public a bien réagi.","ipa":"[ʁeagiʁ]","exAr":"استجاب الجمهور جيداً."},{"fr":"un témoin","ar":"شاهد عيان","pos":"nom","g":"m","pl":"des témoins","ipa":"[tɛ.mɔ̃]","exFr":"Un témoin a décrit la scène.","exAr":"وصف شاهد المشهد."},{"fr":"en direct","ar":"مباشر","pos":"locution","exFr":"En direct de Bruxelles.","ipa":"[ɑ̃ diʁɛk]","exAr":"مباشر من بروكسل."},{"fr":"le relevé (des chiffres)","ar":"تدوين الأرقام","pos":"nom","g":"m","exFr":"Faire un relevé des chiffres.","ipa":"[ʁəlve]","exAr":"تدوين الأرقام."},{"fr":"actualité / l'info","ar":"الأخبار","pos":"nom","g":"f","exFr":"Suivre l'info.","ipa":"[aktyalite]","exAr":"متابعة الأخبار."}],"grammar":[{"tFr":"Les titres nominalisés et la voix passive","tAr":"القاعدة: العناوين الاسمية والمجهول","body":["العناوين تحذف الفاعل وتُبقي الحدث اسماً (Hausse des prix)، والمجهول شائع في الرسميات: «Il a été décidé que...».","التحويل العكسي (اسم ← جملة فاعلة) يُعيد الفاعل ويُبقي المعنى — أساس استخراج العناوين."],"ex":[{"fr":"Ouverture d'un nouveau centre → On a ouvert un centre.","ar":"افتتاح مركز جديد ← فُتح مركز."},{"fr":"Il a été décidé de reporter.","ar":"تم اتخاذ قرار التأجيل."}]}],"mistakes":[{"wrong":"سماع 10 نشرات سطحياً","right":"خبر واحد بعمق ثلاث مرات","why":"العمق يبني المفردات والسطح يبني الانطباع فقط."},{"wrong":"النسيان الفوري للأرقام","right":"relevé على ورقة أثناء السماع","why":"الذاكرة السمعية تحفظ الاتجاه لا الرقم."},{"wrong":"البدء بالنشرة السريعة","right":"المبسطة ثم الانتقال التدريجي","why":"القفزة المباشرة تُفشل الأذن وتُنتج قلقاً."},{"wrong":"حفظ كلمة منفردة من الخبر","right":"الحزمة القطاعية كاملة","why":"الحزمة تتنبأ ببقية الخبر وتُسرّع الفهم."}],"dialogues":[{"title":"صباح إخباري","ctx":"زميلان قبل المحاضرة","lines":[{"who":"Idir","fr":"T'as écouté le journal ce matin ?","ar":"هل استمعت للنشرة هذا الصباح؟"},{"who":"Meriem","fr":"Oui — une baisse des prix, paraît-il.","ar":"نعم — انخفاض في الأسعار، كما قيل."},{"who":"Idir","fr":"Tu as noté le chiffre ?","ar":"هل دوّنت الرقم؟"},{"who":"Meriem","fr":"Deux pour cent, écrit sur mon cahier.","ar":"في المئة، مكتوب في دفتري."},{"who":"Idir","fr":"Et la source ?","ar":"والمصدر؟"},{"who":"Meriem","fr":"Le ministère, selon l'enquête.","ar":"الوزارة، حسب الاستطلاع."}]}],"exercises":[{"t":"mcq","skill":"listening","q":"«Une enquête est en cours» تعني:","opts":["انتهى التحقيق","التحقيق جارٍ","لن يوجد تحقيق","التحقيق سري"],"a":1,"why":"en cours = جارٍ/قائم حالياً."},{"t":"mcq","skill":"listening","q":"أي جملة خبر (لا رأي)؟","opts":["Cette loi est injuste","Le parlement a voté la loi hier","Il faut changer cette loi","J'ai horreur de cette loi"],"a":1,"why":"التصويت واقعة قابلة للتحقق؛ البقية أحكام تقييمية."},{"t":"fill","skill":"vocabulary","q":"أكمل بحسب المصدر الإخباري: «___ les experts, la situation va s'améliorer.» (حسب)","fr":"___ les experts, la situation va s'améliorer.","ans":"Selon","alts":["selon"],"why":"selon تفيد الإسناد — كلمة إخبارية جوهرية."},{"t":"order","skill":"listening","q":"رتّب خطوات الاستماع الذكي لنشرة: (1) استمع دون نص (2) استمع مع النص (3) استمع مجدداً دون نص","words":["D'abord","j'écoute","sans","texte."],"ans":"D'abord j'écoute sans texte.","why":"ثلاث مراحل: عام → تفصيل → تأكيد."},{"t":"listen","skill":"listening","q":"استمع للخبر واختر:","audio":"Les autorités ont annoncé de nouvelles mesures","opts":["ألغت السلطات الإجراءات","أعلنت السلطات إجراءات جديدة","السلطات رفضت المقترح","السلطات ستستقيل"],"a":1,"why":"annoncer = تعلن، de nouvelles mesures = إجراءات جديدة."},{"t":"writing","skill":"writing","q":"استمع لنشرة قصيرة واكتب عنواني خبرين منها بجملتين اسميتين.","min":12,"kw":["annonc","selon"],"sample":"Selon RFI, Microsoft annonce une nouvelle application pour les étudiants. Deuxième titre : le gouvernement français propose une réforme de l'école.","why":"كتابة العناوين من السماع تُثبّت التحويل الاسمي العكسي وتقيس فهمك الحقيقي للنشرة قبل الانتقال إلى خبر آخر."},{"t":"mcq","skill":"listening","q":"أقوى تمرين لبناء فهم الأخبار:","opts":["خبر واحد بعمق ثلاث مرات","عشرة عناوين سطحياً","الترجمة الفورية","قراءة العناوين فقط"],"a":0,"why":"العمق يبني المفردات الإخبارية والسطح يبني الانطباع فقط."},{"t":"fill","skill":"listening","q":"أكمل: «___ l'enquête, les prix ont augmenté.» (حسب)","fr":"___ l'enquête, les prix ont augmenté.","ans":"Selon","alts":["selon"],"why":"selon = حسب المصدر، قالب النشرة الأساسي."}],"homework":"استمع لنشرة RFI السهلة ثلاث مرات (دون نص / مع النص / دون نص) واكتب عنواني خبرين بكلماتك.","sources":[{"title":"Journal en français تعلم المفردات والعبارات المستخدمة بكثرة في نشرات الأخبار لتفهم مواضيع الساعة","channel":"تعلم و تكلم الفرنسية مع نادية French with Nadia","videoId":"3gxS2q7byUQ","why":"مفردات وعبارات نشرات الأخبار الأكثر تكراراً لتفهم مواضيع الساعة — مفتاح فهم الجملة الإخبارية قبل الترجمة.","cat":"Listening","level":"B1","main":true,"dur":10},{"title":"Des tracteurs à Paris | Journal • Français Facile - RFI","channel":"Français Facile - RFI","videoId":"C8aJqr7zhIY","why":"نموذج حقيقي من القناة الرسمية لنشرة «الفرنسية السهلة» — أشهر أداة عالمية لتدريب الأذن المتوسطة على الأخبار بمفردات مختارة وسرعة معتدلة.","cat":"Listening","level":"B1","extra":true},{"title":"Le journal : Gaza, Israël, Microsoft • Français Facile - RFI","channel":"Français Facile - RFI","videoId":"8K2A-v4-p4M","why":"نموذج حقيقي لنشرة كاملة (خبر سياسي وتقني) — التطبيق الفعلي لما تعلمته: استمع وتدرّب على استخراج العناوين من نشرة صحيحة.","cat":"Listening","level":"B1","extra":true},{"title":"La France vend des armes à Israël ❗️ Les infos en français (Compréhension orale)","channel":"Ohlala ! Français","videoId":"_pfEQaJzlGk","why":"قناة تعليمية تحوّل أخبار الأسبوع إلى تمرين فهم سمعي مباشر — يريك شكل التدريب الذاتي الأسبوعي على الأخبار.","cat":"Listening","level":"B1","extra":true}],"supplements":[{"id":"C8aJqr7zhIY","title":"Des tracteurs à Paris | Journal • Français Facile - RFI","channel":"Français Facile - RFI","why":"نموذج حقيقي من القناة الرسمية لنشرة «الفرنسية السهلة» — أشهر أداة عالمية لتدريب الأذن المتوسطة على الأخبار بمفردات مختارة وسرعة معتدلة.","lang":"fr"},{"id":"8K2A-v4-p4M","title":"Le journal : Gaza, Israël, Microsoft • Français Facile - RFI","channel":"Français Facile - RFI","why":"نموذج حقيقي لنشرة كاملة (خبر سياسي وتقني) — التطبيق الفعلي لما تعلمته: استمع وتدرّب على استخراج العناوين من نشرة صحيحة.","lang":"fr"},{"id":"_pfEQaJzlGk","title":"La France vend des armes à Israël ❗️ Les infos en français (Compréhension orale)","channel":"Ohlala ! Français","why":"قناة تعليمية تحوّل أخبار الأسبوع إلى تمرين فهم سمعي مباشر — يريك شكل التدريب الذاتي الأسبوعي على الأخبار.","lang":"fr"}]},{"id":"B1-t5-l2","fr":"Les podcasts pour progresser","ar":"البودكاست: سلاح المتوسط","objectives":["اختيار بودكاست مناسب لمستواك وميولك","استخدام أسلوب الاستماع المكثف الذكي","بناء روتين استماع يومي 20 دقيقة"],"sections":[{"h":"لماذا البودكاست؟ ولماذا الآن؟","p":["لماذا البودكاست؟ ولماذا الآن؟ لأنه أول وسيط يجمع الاستماع الطويل مع الراحة: نص يمشي معك في الطريق، عرض مؤجل عند الغسيل، وحلقات معمّقة تبني مفردات قطاعية لا تجدها في النشرة. النشرة تُعطيك الحدث، والبودكاست يُعطيك التحليل.","الاستماع المكثف (l'écoute intensive) كيف تحصد أقصى فائدة؟ ثلاث مراحل: أولى للتعميم بلا ورقة، ثانية للمفردات مع التوقف الانتقائي، ثالثة للإعادة shadowing. فشل الاستماع المكثف يأتي من القفز للمرحلة الثانية مباشرة — التوقف بلا فهم عام يقطع المعنى.","تابع الفيديو الأساسي بالشرح العربي: كيف تحصد أقصى فائدة من البودكاست — نصائح عملية: التحكم بالسرعة (0.75×)، تثبيت الحلقة قبل الانتقال، والتركيز على les connecteurs. السرعة المنخفضة أداة مؤقتة لا أسلوب حياة — أعد السرعة الطبيعية بعد أسبوعين.","النص المصاحب ملكك: اقرأ النص قبل السماع لتهيئة الأذن، ثم استمع وعينك عليه، ثم استمع بلا نص. ثلاثية (عين ← أذن+عين ← أذن) تبني decodage auditif — قدرة تحويل الصوت إلى معنى بلا ترجمة ذهنية.","روتين الأذن اليومي: 20 دقيقة بودكاست مقسّمة: 10 في الطريق (تعميم)، 5 في الاستراحة (مفردات)، 5 shadowing (نطق). الروتين المقطّع متفوّق على ساعة متجمّعة — الأذن مثل العضلة: تدريب قصير يومي يبنيها، وتدوير طويل أسبوعي يُجهدها.","قياس الفائدة: بعد كل حلقة، اكتب جملتين — «ماذا فهمت؟» و«كلمتان جديدتان». بعد عشر حلقات ستملك 20 كلمة ثابتة وثقة أعلى في الطول — وهذه هي مؤشرات B1 الحقيقية لا عدد الحلقات المسموعة."],"video":{"id":"aml9vmqYYqM","title":"بودكاست تعلم اللغة الفرنسية للمبتدئين B1 B2 | فرنسي بطيء وسهل | إدارة الوقت","channel":"Communications En Français","why":"بودكاست B1-B2 بفرنسي بطيء وسهل — نموذج مباشر للاستماع المكثف والروتين اليومي الموصى به في الدرس.","lang":"ar","main":true,"dur":10},"sub":[{"h":"لماذا البودكاست؟","p":["استماع طويل مريح محمول.","تحليل لا حدث فقط.","مفردات قطاعية متعمقة.","نص مصاحب يخدم الثلاثية."]},{"h":"الاستماع المكثف: ثلاث مراحل","p":["الأولى: تعميم بلا ورقة.","الثانية: مفردات بتوقف انتقائي.","الثالثة: shadowing.","لا تقفز للثانية مباشرة."]},{"h":"روتين الأذن 20 دقيقة","p":["10 تعميم في الطريق.","5 مفردات في الاستراحة.","5 shadowing نطق.","قصير يومي > طويل أسبوعي."]}]},{"h":"الاستماع المكثف: كيف تحصد أقصى فائدة؟","p":["الاستماع المكثف (écoute intensive): حلقة واحدة تتعامل معها 3 مرات عبر أيام مختلفة: مرة كاملة للفهم العام، مرة على مقاطع 2-3 دقائق لتقطيع الجمل الصعبة، مرة أخيرة مريحة. يمكنك أيضاً قراءة النص المكتوب إن وُجد (transcription) بعد الاستماع الأول لا قبله — الاستماع يظل التمرين الأساسي.","حيلة B1 الذكية: اختار حلقة بموضوع لغوي (مثل حلقة «Comment parler français plus vite» هنا) واصغ إليها مرتين في أسبوعين متباعدين — ستفاجئ أن تفهم في المرة الثانية ما سقط في الأولى، وأن عبارات الحلقة أصبحت «حاسة» لا درساً محفوظاً.","السرعة: 0.75× للمرحلة الثانية فقط، ثم عودة سريعة للسرعة الطبيعية — المستمع الذي يبقى على البطء شهوراً يبني أذناً للغة البطيئة فقط ويفشل في البث المباشر. البطء سلم لا مقعد."],"video":null},{"h":"روتين الأذن اليومي","p":["الروتين الناجح صغير ومتكرر: 20 دقيقة صباحاً في الطريق + 10 دقائق مساءً قبل النوم. نوّع المصادر: حلقة بودكاست يومياً، أغنية أسبوعياً، نشرة أخبار 3 مرات أسبوعياً. القاعدة الأهم: بلا استثناء — الأذن عضلة تتراجع أسرع مما تتقدم.","قيّم نفسك شهرياً: سجّل نفسك تلخص حلقة سمعتها، وقارن التسجيل بأسبوعك الأول. الفرق سيشجعك أكثر من أي شهادة. وفي الأخير: لا تستعجل الانتقال لبودكاست أسرع — العمق في مستواك الحالي يبني الأساس الذي ستقف عليه في B2.","بعد الفيديو: اختر بودكاستاً واحداً بحلقات 10-15 دقيقة (مثل InnerFrench) وجدوله على 5 أيام — حلقة يومياً بنفس التلات مراحل. اكتب جملتين بعد كل حلقة في دفتر واحد مخصص."],"video":null},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: اخترت بودكاستاً يناسب مستواك، وأتقنت الاستماع المكثف بثلاث مراحل (تعميم ← مفردات ← shadowing) وروتين الأذن 20 دقيقة وثلاثية (عين ← عين+أذن ← أذن). أعد مشاهدة الفيديو الرئيسي وركّز على نصائح التحكم بالسرعة (0.75× مؤقتاً) وعلى les connecteurs التي يُركّز عليها المتحدث.","جسر الدروس: من B1-t5-l1 (استخراج العناوين والخبر العميق من النشرة) إلى B1-t5-l2 (بناء روتين البودكاست والاستماع المكثف)، ثم إلى B1-t5-l3 حيث تسمع الفرنسية السريعة المدمجة وتتعلّم اختصارات الشارع.","مهمة تطبيقية: اختر حلقة بودكاست مدتها خمس دقائق وعالجها بالمراحل الثلاث، ثم سجّل صوتك أو اكتب في دقيقة ملخصاً يستعمل 3 كلمات جديدة من الدرس، وقارن استعمالك بها في الفيديو الرئيسي."]}],"examples":[{"fr":"J'écoute un podcast en français pendant mon trajet.","ar":"أسمع بودكاست بالفرنسية أثناء تنقلي."},{"fr":"Je comprends maintenant 80% de cette chaîne.","ar":"أفهم الآن 80% من هذه القناة."},{"fr":"Je réécoute les mêmes épisodes plusieurs fois.","ar":"أعيد الاستماع للحلقات نفسها عدة مرات."},{"fr":"Un épisode par jour, c'est ma règle.","ar":"حلقة كل يوم — هذه قاعدتي."},{"fr":"J'écoute en marchant, c'est ma fenêtre d'écoute.","ar":"أسمع أثناء المشي، هذه نافذتي الاستماعية.","note":"الروتين"},{"fr":"Lis le script d'abord, puis écoute sans regarder.","ar":"اقرأ النص أولاً ثم استمع دون نظر.","note":"الثلاثية"},{"fr":"À 0,75 je comprends tout, mais je dois revenir au rythme normal.","ar":"بطء 0.75 أفهم كل شيء لكن يجب أن أعود للسرعة الطبيعية.","note":"السرعة"},{"fr":"Deux mots nouveaux par épisode, pas plus.","ar":"كلمتان جديدتان لكل حلقة، لا أكثر.","note":"القياس"}],"pron":[{"w":"un épisode","ipa":"[e.pi.zɔd]","approx":"إيبي-زود"},{"w":"un trajet","ipa":"[tʁa.ʒɛ]","approx":"ترا-جيه"},{"w":"réécouter","ipa":"[ʁe.e.ku.te]","approx":"ريه-إي-كوتيه"}],"vocab":[{"fr":"un podcast","ar":"بودكاست","pos":"nom","g":"m","pl":"des podcasts","ipa":"[pɔd.kast]","exFr":"Ce podcast est parfait pour B1.","exAr":"هذا البودكاست مثالي لـB1."},{"fr":"une transcription","ar":"نص مكتوب (للمسموع)","pos":"nom","g":"f","pl":"des transcriptions","ipa":"[tʁɑ̃s.kʁip.sjɔ̃]","exFr":"La transcription aide après la première écoute.","exAr":"النص المكتوب يساعد بعد الاستماع الأول."},{"fr":"réécouter","ar":"يعيد الاستماع","pos":"verbe","ipa":"[ʁe.e.ku.te]","exFr":"Je réécoute les épisodes difficiles.","exAr":"أعيد الاستماع للحلقات الصعبة."},{"fr":"un trajet","ar":"رحلة (يومية)","pos":"nom","g":"m","pl":"des trajets","ipa":"[tʁa.ʒɛ]","exFr":"Pendant le trajet, j'écoute du français.","exAr":"أثناء الرحلة أسمع فرنسية."},{"fr":"quotidien","ar":"يومي","pos":"adj","g":"mf","ipa":"[kɔ.ti.djɛ̃]","exFr":"Mon écoute est quotidienne.","exAr":"استماعي يومي."},{"fr":"une règle","ar":"قاعدة","pos":"nom","g":"f","pl":"les règles","ipa":"[ʁɛɡl]","exFr":"Une règle simple : écouter tous les jours.","exAr":"قاعدة بسيطة: اسمع كل يوم."},{"fr":"une émission","ar":"برنامج إذاعي","pos":"nom","g":"f","exFr":"Une émission culturelle.","ipa":"[emisjɔ̃]","exAr":"برنامج ثقافي."},{"fr":"la vitesse de lecture","ar":"سرعة القراءة/التشغيل","pos":"nom","exFr":"Ralentis la vitesse.","ipa":"[vitɛs də lyktyr]","exAr":"أبطئ السرعة."},{"fr":"se concentrer sur","ar":"يركّز على","pos":"locution","exFr":"Concentre-toi sur les liens.","ipa":"[sə kɔ̃sɑ̃tʁe]","exAr":"ركز على الروابط."},{"fr":"retenir","ar":"يُرسّخ في الذاكرة / يستذكر","pos":"verbe","ipa":"[ʁə.tniʁ]","exFr":"Je veux retenir dix mots par semaine.","exAr":"أريد تثبيت عشر كلمات أسبوعياً."},{"fr":"intérioriser","ar":"يُرسّخ","pos":"verbe","g":"1er","exFr":"Intérioriser les structures.","ipa":"[ɛ̃teʁjɔʁize]","exAr":"ترسيخ التراكيب."},{"fr":"la régularité","ar":"الانتظام","pos":"nom","g":"f","exFr":"La régularité fait tout.","ipa":"[ʁegylarite]","exAr":"الانتظام هو كل شيء."},{"fr":"compréhension globale","ar":"الفهم العام","pos":"nom","exFr":"Vérifie la compréhension globale.","ipa":"[kɔ̃pʁɛsjɔ̃ ɡlɔbal]","exAr":"تحقق من الفهم العام."},{"fr":"noter","ar":"يدوّن","pos":"verbe","g":"1er","exFr":"Note les mots nouveaux.","ipa":"[nɔte]","exAr":"دوّن الكلمات الجديدة."},{"fr":"un animateur","ar":"مقدّم البرنامج","pos":"nom","g":"m","pl":"des animateurs","ipa":"[a.ni.ma.tœʁ]","exFr":"L'animateur pose des questions simples.","exAr":"المقدّم يطرح أسئلة بسيطة."},{"fr":"le script","ar":"النص المصاحب","pos":"nom","g":"m","exFr":"Télécharger le script.","ipa":"[skʁip]","exAr":"تحميل النص."},{"fr":"l'écoute active","ar":"الاستماع النشط","pos":"nom","g":"f","exFr":"L'écoute active note tout.","ipa":"[ekut aktif]","exAr":"الاستماع النشط يدوّن كل شيء."}],"grammar":[{"tFr":"Les liens dans l'oral prolongé","tAr":"القاعدة: روابط الخطاب الممتد","body":["البودكاست يقوده: donc / alors / du coup (استنتاج)، en fait / en réalité (تصحيح)، par contre (تضاد)، d'ailleurs (إضافة) — تتبّعها بالسمع يبني خريطة الخطاب.","مع le présent d'énonciation: المتحدث يرتكز على المضارع («on voit que...») حتى داخل السرد — المضارع لغة البودكاست."],"ex":[{"fr":"En fait, le chiffre a été corrigé.","ar":"في الواقع، صُحّح الرقم."},{"fr":"Du coup, les mesures suivent.","ar":"وبالتالي، تأتي الإجراءات."}]}],"mistakes":[{"wrong":"الاستماع بلا نص أبداً","right":"ثلاثية عين ← عين+أذن ← أذن","why":"البدء بأذن فقط يُجهد ويطوّر decodage ناقصاً."},{"wrong":"البقاء على 0.75 شهوراً","right":"مؤقت ثم عودة للسرعة الطبيعية","why":"الأذن تتعوّد على البطء وتفشل في الحي."},{"wrong":"حلقة جديدة كل يوم بلا معالجة","right":"حلقة معمّقة كل يوم","why":"الحجم بلا معالجة يبني انطباعاً لا معجماً."},{"wrong":"عدّ الحلقات كإنجاز","right":"جملتان + كلمتان بعد كل حلقة","why":"المخرجات المكتوبة هي دليل الفهم الحقيقي."}],"dialogues":[{"title":"استشارة بودكاست","ctx":"زميلة تسأل عن خطة استماع","lines":[{"who":"Lamia","fr":"Je comprends les podcasts, mais je stagne.","ar":"أفهم البودكاست لكنني أتعثر."},{"who":"Walid","fr":"Tu passes à une nouvelle trop vite ?","ar":"هل تنتقل لجديدة بسرعة كبيرة؟"},{"who":"Lamia","fr":"Une par jour, sans rien noter.","ar":"حلقة يومياً دون أن أدوّن شيئاً."},{"who":"Walid","fr":"Arrête : une par jour, avec deux phrases après.","ar":"توقف: حلقة يومياً مع جملتين بعدها."},{"who":"Lamia","fr":"Et la vitesse ?","ar":"والسرعة؟"},{"who":"Walid","fr":"Normale — le ralenti est un passage, pas une maison.","ar":"طبيعية — البطء ممر لا بيت."}]}],"exercises":[{"t":"mcq","skill":"listening","q":"إذا فهمت أقل من 70% من بودكاست:","opts":["واصل رغم كل شيء","انتقل لمستوى أسهل بلا حزن","توقف عن الاستماع نهائياً","أضف سرعة أسرع"],"a":1,"why":"الفهم الكافي (80%+) هو وقود التقدم؛ التصلب في مادة أعلى من مستواك يقتل الاندفاع."},{"t":"mcq","skill":"listening","q":"أفضل استخدام للنص المكتوب (transcription):","opts":["اقرأه قبل الاستماع","بعد الاستماع الأول كتحقق وتقوية","استبدله بالاستماع","تجاهله تماماً"],"a":1,"why":"الاستماع أولاً للتمرين السمعي؛ النص بعده للتفاصيل والكلمات الجديدة."},{"t":"fill","skill":"vocabulary","q":"أكمل: «Pendant le ___ (رحلة), j'écoute du français.»","fr":"Pendant le ___, j'écoute du français.","ans":"trajet","alts":["trajet"],"why":"le trajet = الرحلة اليومية."},{"t":"order","skill":"listening","q":"رتّب الاستماع المكثف: (1) على مقاطع قصيرة للجمل الصعبة (2) كاملة للفهم العام (3) مرة أخيرة مريحة","words":["D'abord","je","écoute","l'épisode","entier."],"ans":"D'abord je écoute l'épisode entier.","why":"الترتيب: عام → مقاطع → مريح."},{"t":"listen","skill":"listening","q":"استمع واختر ما يفعله المتحدث في الاستماع:","audio":"Je réécoute les mêmes épisodes plusieurs fois","opts":["أسمع حلقات مختلفة مرة واحدة","أعيد الاستماع للحلقات نفسها عدة مرات","أكتب حلقات جديدة","أتجنب الحلقات المتكررة"],"a":1,"why":"réécouter + mêmes épisodes = إعادة الاستماع للنفس."},{"t":"writing","skill":"writing","q":"اكتب خطتك الأسبوعية للاستماع: ماذا، متى، كم دقيقة، وأي قناة؟","min":18,"kw":["j'écoute","jour","minutes"],"sample":"Cette semaine, j'écoute un épisode d'InnerFrench chaque matin pendant mon trajet, vingt minutes. Le soir, je réécoute dix minutes sans texte. Le dimanche, j'écoute une chanson et je lis ses paroles.","why":"خطة مكتوبة تحوّل النية العامة إلى التزام قابل للتنفيذ وتتيح مقارنة أسبوعك الفعلي بالخطة المنشودة."},{"t":"mcq","skill":"listening","q":"مراحل الاستماع المكثف بالترتيب:","opts":["تعمّم بلا ورقة ← مفردات ← shadowing","shadowing ← ورقة ← تعمّم","مفردات ← تعمّم ← shadowing","ورقة فقط"],"a":0,"why":"الفهم العام أولاً ثم التفاصيل ثم النطق."},{"t":"order","skill":"listening","q":"رتّب ثلاثية الاستماع: (1) انتقاء المفردات (2) الاستماع بلا نص (3) العين مع الأذن","words":["D'abord","l'oreille","seule,","puis","œil","+","oreille,","enfin","les","mots."],"ans":"D'abord l'oreille seule, puis œil + oreille, enfin les mots.","why":"تعمّم ← عين+أذن ← انتقاء: مراحل متتابعة لا معكوسة."}],"homework":"ابدأ تحدي الـ7 أيام: حلقة بودكاست واحدة يومياً (10-20 دقيقة) من مستوى B1، وسجّل تقييم فهمك (1-10) كل يوم.","sources":[{"title":"بودكاست تعلم اللغة الفرنسية للمبتدئين B1 B2 | فرنسي بطيء وسهل | إدارة الوقت","channel":"Communications En Français","videoId":"aml9vmqYYqM","why":"بودكاست B1-B2 بفرنسي بطيء وسهل — نموذج مباشر للاستماع المكثف والروتين اليومي الموصى به في الدرس.","cat":"Listening","level":"B1","main":true,"dur":10},{"title":"Public Transport in Paris in Slow French | Super Easy French 155","channel":"Easy French","videoId":"Kw6SlbImmkY","why":"نموذج «الفرنسية البطيئة الفائقة» من Easy French مع ترجمة مزدوجة — نقطة البداية المثالية لروتين البودكاست عند B1.","cat":"Listening","level":"B1","extra":true},{"title":"Comment parler français plus vite","channel":"innerFrench","videoId":"5tRJYN4wChg","why":"حلقة InnerFrench بفرنسية طبيعية بطيئة متعمقة في موضوع لغوي عملي — نموذج حي للاستماع المفيد الذي يحسّن أذنك وأداءك معاً.","cat":"Listening","level":"B1","extra":true},{"title":"Tu peux mieux parler français dans 30 jours","channel":"Français Authentique","videoId":"z-TPeI6M8lA","why":"خطة 30 يوماً واقعية من قناة بودكاست رائدة — يحوّل الاستماع من نشاط عابر إلى نظام يومي بنتائج قابلة للقياس.","cat":"Listening","level":"B1","extra":true}],"supplements":[{"id":"Kw6SlbImmkY","title":"Public Transport in Paris in Slow French | Super Easy French 155","channel":"Easy French","why":"نموذج «الفرنسية البطيئة الفائقة» من Easy French مع ترجمة مزدوجة — نقطة البداية المثالية لروتين البودكاست عند B1.","lang":"en"},{"id":"5tRJYN4wChg","title":"Comment parler français plus vite","channel":"innerFrench","why":"حلقة InnerFrench بفرنسية طبيعية بطيئة متعمقة في موضوع لغوي عملي — نموذج حي للاستماع المفيد الذي يحسّن أذنك وأداءك معاً.","lang":"fr"},{"id":"z-TPeI6M8lA","title":"Tu peux mieux parler français dans 30 jours","channel":"Français Authentique","why":"خطة 30 يوماً واقعية من قناة بودكاست رائدة — يحوّل الاستماع من نشاط عابر إلى نظام يومي بنتائج قابلة للقياس.","lang":"fr"}]},{"id":"B1-t5-l3","fr":"Le français parlé rapide","ar":"فهم الفرنسية السريعة","objectives":["فهم الفرنسية المدمجة: liaisons وélisions والحروف المهملة","التعارف مع لغة الشارع والعامية الخفيفة","تدريب الأذن على السرعة الحقيقية للشارع"],"sections":[{"h":"لماذا الفرنسية الحية تبدو أسرع؟","p":["لماذا الفرنسية الحية تبدو أسرع؟ لأنها ليست أسرع بل مختلفة: تبتلع حروفات («j'ai mangé» ← «j'mangé»)، تُلصق الكلمات («qu'est-ce que» ← «skè»)، وتستخدم ضمائر مختصرة («y'a», «t'as»). سرعة مُخطَّطة من الاختصار لا من الإيقاع — ومن يسمع الاختصار يسمع السرعة الطبيعية عند سرعتها الحقيقية.","ماذا يقولون فعلاً؟ ثلاث طبقات: le registre courant (المهذّب اليومي)، le familier (الأصدقاء: tutoiement، قصر)، وl'argot (شوارع وشباب: ouf = مجنون، kiffer = يحب). طبقة familier هي أكثر ما تسمعه مع الأصدقاء، وl'argot تسمعه في الأفلام لا في العمل.","تابع الفيديو الأساسي بالشرح العربي: عبارات الفرنسية العامية للتكلم مثل الفرنسيين — العبارات الحياتية: «C'est pas grave»، «Je suis crevé»، «On se taille ?». معرفة هذه العبارات تكشف لك أن الفرنسية التي سمعتها في الدراما موجودة في القاموس باسم آخر.","التخفيض السمعي (réduction): je → j', tu → t', il → y' (مع être/avoir)، ne → elision كاملة في الحديث («je sais pas» بدل «je ne sais pas»). تدريب: اسمع ثم أعد كتابة ما سمعت بالشكل المكتمل — التمرين يكشف لك أين كانت الحروف وأين اختفت.","التدريب الميداني: شارع باريس — مقاطع الحوار العشوائي (les micro-trottoirs) أصعب وأصدق من الحوارات الاستوديو. المدة القصيرة (30-60 ثانية)، واللهجة الحية، والتشويش الواقعي تُدرب أذناً جاهزة لـ B2.","الفخ الأخلاقي: العامية تُستخدم مع الأصدقاء فقط ولا تُكتب في DELF أو البريد. حدود الاستعمال جزء من المهارة: أفهم argot بلا أن أستعمله إلا مع من يعرفها — وهذا التمييز هو أثر B1 الاجتماعي الكامل."],"video":{"id":"5Mno740H5R0","title":"استعمل هذه العبارات من الفرنسية العامية للتكلم مثل الفرنسيين تمامًا Parler comme un français","channel":"تعلم و تكلم الفرنسية مع نادية French with Nadia","why":"العامية الفرنسية وعبارات الناطقين — إجابة مباشرة عن سؤال «ماذا يقولون فعلاً؟» ولماذا تبدو الفرنسية الحية أسرع.","lang":"ar","main":true,"dur":9},"sub":[{"h":"لماذا تبدو أسرع؟","p":["ابتلاع: j'ai mangé ← j'mangé.","تلصيق: qu'est-ce que ← skè.","ضمائر مختصرة: y'a, t'as.","سرعة مُخطَّطة لا إيقاع سريع."]},{"h":"الطبقات الثلاث","p":["courant — مهذّب يومي.","familier — أصدقاء وتقصير.","argot — شباب وأفلام.","الحدود: عمل ← courant فقط."]},{"h":"التدريب الميداني","p":["micro-trottoirs: 30-60 ثانية.","سماع ← إعادة كتابة مكتملة.","تشويش واقعي = تدريب صادق.","فهم argot لا استعماله في الكتابة."]}]},{"h":"ماذا يقولون فعلاً؟","p":["جمل تعلمتها كتابةً تسمعها شارعاً بشكل مختلف تماماً: «Je ne sais pas» → «Je sais pas»؛ «Est-ce que tu veux ?» → «Tu veux ?» (حذف est-ce كله)؛ «Il y a un problème» → «Y a un problème»؛ «Je vais y aller» → «J'vais y aller». المفارقة: النسخة «السريعة» هي القاعدة الشفوية، والنسخة «الكاملة» هي الاستثناء المدرسي.","قاموس الطائف الخفيف الآمن: «Ça marche» (موافق)، « Nickel !» (ممتاز)، « J'ai la flemme» (كسلان)، « Ça craint» (سيء)، « Franchement...» (بصراحة...). هذه تسمعها في كل حوار — اعرفها للفهم، واستخدم الأكثر تحفظاً أولاً (Ça marche, Nickel) حتى تتوسع ثقتك.","فرنسي ينطق «t'as vu ce truc de ouf ?» — أربع تحولات في ست كلمات: tu→t', as (بدون ne), de ouf (صياغة عامية). إذا استطعت تفكيكها فهممت، فقدت الاستماع — والتفكيك هو التمرين."],"video":null},{"h":"التدريب الميداني: شارع باريس","p":["مقابلات الشارع هي أذنك الحقيقية: أصوات مختلفة، لهجات، سرعات طبيعية، مقاطعة وتداخل. طريقة التدريب الصحيحة: شاهد أول مرة بالترجمة المزدوجة فقط، ثم شاهد مرة أخرى بالفرنسية وحدها، ثم استمع للصوت فقط وأعد الأجوبة التي فهمتها صوتياً.","تحدي الأذن الأسبوعي: اختر مقابلة شارع واحدة واصنع منها تمريضاً مكثفاً: اكتب جملتين سمعتهما بلا ترجمة ثم تحقق. إذا نجحت في جملة واحدة يومياً فأذنك تتقدم — الشارع سيصبح حواءً مألوفاً خلال شهرين من الانتظام.","بعد الفيديو: اختر مقطع micro-trottoir واحداً، انسخ ما فهمته بالكامل (حتى الخانات الفارغة)، ثم قارنه بالأصل — كل فراغ تجده هو مهارة سمعية جديدة تملكها."],"video":null},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: فهمت سرعة الفرنسية الحية (التخفيض والتلصيق وelision)، وميّزت الطبقات الثلاث courant / familier / argot، وأتقنت عبارات الشارع الآمنة (Ça marche, Nickel, C'est pas grave). أعد مشاهدة الفيديو الرئيسي وركّز على العبارات العامية المتكرّرة وعلى نطقها المُخفَّض (t'as, y'a, chais pas).","جسر الدروس: من B1-t5-l2 (روتين البودكاست والاستماع المكثف) إلى B1-t5-l3 (فهم الفرنسية السريعة ولغة الشارع)، ثم إلى B1-t6-l1 حيث تنتقل من الفهم السمعي إلى تنظيم الأفكار كتابةً بالخطة والروابط.","مهمة تطبيقية: اختر دقيقة من مقابلة شارع (micro-trottoir)، ثم سجّل صوتك أو اكتب في دقيقة ملخص ما فهمت مستعملاً 3 كلمات جديدة من الدرس، وأعد مشاهدة المقطع وقارن جملك بما سمعته فعلاً."]}],"examples":[{"fr":"Je sais pas comment dire.","ar":"لا أعرف كيف أقول (الحي: chais pas)."},{"fr":"T'as vu le nouveau film ?","ar":"شفت الفيلم الجديد؟ (tu as → t'as)."},{"fr":"Y a un problème avec le bus.","ar":"هناك مشكلة مع الباص (il y a → y a)."},{"fr":"Franchement, c'était nickel !","ar":"بصراحة، كان ممتازاً!"},{"fr":"« T'as vu ? » = « Tu as vu ? »","ar":"«هل رأيت؟» — نطق مُخفَّض.","note":"réduction"},{"fr":"Je suis crevé, c'est pas grave, on se taille.","ar":"أنا منهَك، لا بأس، نخرج؟","note":"harnais عامي"},{"fr":"Le street interview est plus dur que le studio.","ar":"مقابلة الشارع أصعب من الاستوديو.","note":"ميدان"},{"fr":"Je comprends l'argot mais je ne l'écris pas.","ar":"أفهم العامية لكنني لا أكتب بها.","note":"الحدود"}],"pron":[{"w":"chais pas","ipa":"[ʃɛ pa]","approx":"شيه-با","note":"Je ne sais pas الحية"},{"w":"t'as","ipa":"[ta]","approx":"طا","note":"tu as المدمجة"},{"w":"y a","ipa":"[ja]","approx":"يا","note":"il y a المدمجة"}],"vocab":[{"fr":"l'enchaînement","ar":"الاندماج الصوتي بين الكلمات","pos":"nom","g":"m","ipa":"[lɑ̃.ʃɛn.mɑ̃]","exFr":"L'enchaînement rend le français rapide.","exAr":"الاندماج يجعل الفرنسية تبدو سريعة."},{"fr":"la liaison","ar":"الوصل الصوتي","pos":"nom","g":"f","pl":"les liaisons","ipa":"[la lje.zɔ̃]","exFr":"La liaison relie les mots entre eux.","exAr":"الوصل يربط الكلمات بعضها ببعض."},{"fr":"nickel","ar":"ممتاز (عامية لطيفة)","pos":"adj","g":"mf","ipa":"[ni.kɛl]","exFr":"C'était nickel, merci !","exAr":"كان ممتازاً، شكراً!"},{"fr":"ça craint","ar":"أمر سيء (عامية)","pos":"expression","ipa":"[sa kʁɛ̃]","exFr":"Le wifi du café craint.","exAr":"الواي فاي في المقهى سيء."},{"fr":"j'ai la flemme","ar":"كسلان / لا مزاج للعمل","pos":"expression","ipa":"[ʒe la flam]","exFr":"J'ai la flemme d'aller courir.","exAr":"كسلان أن أخرج أركض."},{"fr":"franchement","ar":"بصراحة","pos":"adv","ipa":"[fʁɑ̃ʃ.mɑ̃]","exFr":"Franchement, j'ai adoré le film.","exAr":"بصراحة أحببت الفيلم."},{"fr":"le familier","ar":"اللغة المألوفة","pos":"nom","g":"m","exFr":"Passer du formel au familier.","ipa":"[familije]","exAr":"الانتقال من الرسمية للمألوفة."},{"fr":"l'argot","ar":"العامية","pos":"nom","g":"m","exFr":"L'argot des jeunes.","ipa":"[aʁɡo]","exAr":"عامية الشباب."},{"fr":"ouf","ar":"مجنون/رائع (عامية)","pos":"adj","exFr":"C'est ouf !","ipa":"[uf]","exAr":"هذا مجنون!"},{"fr":"kiffer","ar":"يحب/يعشق (عامية)","pos":"verbe","g":"1er","exFr":"Je kiffe cette chanson.","ipa":"[kife]","exAr":"أعشق هذه الأغنية."},{"fr":"crevé(e)","ar":"منهَك (عامية)","pos":"adj","exFr":"Je suis crevé.","ipa":"[kʁəve]","exAr":"أنا منهَك."},{"fr":"C'est pas grave","ar":"لا بأس/لا مشكلة","pos":"locution","exFr":"Oublie, c'est pas grave.","ipa":"[sɛ pa ɡʁav]","exAr":"انسى، لا بأس."},{"fr":"on se taille ?","ar":"نخرج؟ (عامية)","pos":"locution","exFr":"Il est tard, on se taille ?","ipa":"[ɔ̃ sə taj]","exAr":"الوقت متأخر، نخرج؟"},{"fr":"la réduction","ar":"التخفيض السمعي","pos":"nom","g":"f","exFr":"Les réductions à l'oral.","ipa":"[ʁədyksjɔ̃]","exAr":"التخفيضات في النطق."},{"fr":"le micro-trottoir","ar":"مقابلة الشارع","pos":"nom","g":"m","exFr":"Un micro-trottoir à Paris.","ipa":"[mikʁo tʁɔtwaʁ]","exAr":"مقابلة شارع في باريس."},{"fr":"la décontraction","ar":"الارتياح/البداهة","pos":"nom","g":"f","exFr":"Parler avec décontraction.","ipa":"[dekɔ̃tʁaksjɔ̃]","exAr":"التحدث بارتياح."},{"fr":"un gloussement","ar":"ضحكة صاخبة","pos":"nom","g":"m","exFr":"Des gloussements dans la rue.","ipa":"[ɡlusmɑ̃]","exAr":"ضحكات في الشارع."},{"fr":"capter le rythme","ar":"يلتقط الإيقاع","pos":"locution","exFr":"Capter le rythme naturel.","ipa":"[kapte lə ʁitm]","exAr":"التقاط الإيقاع الطبيعي."}],"grammar":[{"tFr":"Les réductions de l'oral","tAr":"القاعدة: التخفيضات السمعية","body":["الضمائر والنداءات تختصر: tu→t', il/elle→y'، وne تُحذف في الحديث اليومي — الاستماع يجب أن يتوقع الحذف لا ينتظر الحرف.","«ne» نادرة في oral familier ومقصودة في oral soigné — عكس ما تعلّمه كتب A2، والفرق نبرة لا قاعدة."],"ex":[{"fr":"T'as mangé ? = Tu as mangé ?","ar":"هل أكلت؟ — النطق المختصر."},{"fr":"Je sais pas (à l'oral) vs je ne sais pas (à l'écrit).","ar":"لا أعلم (شفهي) مقابل الصيغة المكتملة (كتابي)."}]}],"mistakes":[{"wrong":"حفظ عامية واستعمالها في الكتابة","right":"فهم عامية بلا استعمال رسمي","why":"argot في DELF أو البريد يُقرأ خطأً جسيماً."},{"wrong":"انتظار كل حرف عند السماع","right":"توقع التخفيض والحذف","why":"الانتظار الحرفي يجعل الكلام يبدو أسرع مما هو."},{"wrong":"رفض العامية كأنها خطأ","right":"تمييز الطبقات الثلاث","why":"الفصاحة تُقيَّم بالقدرة على التمييز لا على التجاهل."},{"wrong":"المقارنة بحوارات الاستوديو فقط","right":"إضافة micro-trottoir أسبوعياً","why":"الواقع أكثر تشويشاً وأصدق تدريباً."}],"dialogues":[{"title":"أول لقاء في باريس","ctx":"سائح وشاب في حي","lines":[{"who":"Sami","fr":"Salut, t'as une minute ?","ar":"أهلاً، عندك دقيقة؟"},{"who":"Louis","fr":"Ouais, dis-moi.","ar":"أيوة، قل لي."},{"who":"Sami","fr":"C'est quoi, le quartier le plus animé ici ?","ar":"ما هو الحي الأكثر حيوية هنا؟"},{"who":"Louis","fr":"Le Marais, c'est ouf le soir !","ar":"المارا، رهيز في المساء!"},{"who":"Sami","fr":"Ah, je vais y aller. Merci !","ar":"آه، سأذهب إليها. شكراً!"},{"who":"Louis","fr":"Pas de souci, c'est pas grave — amuse-toi !","ar":"لا مشكلة، لا بأس — استمتع!"}]}],"exercises":[{"t":"mcq","skill":"listening","q":"سمعت «chais pas» في الشارع — ما الجملة الكاملة؟","opts":["Ça ne va pas","Je ne sais pas","Je ne vais pas","C'est pas ça"],"a":1,"why":"Je ne sais pas تنضغط شفوياً إلى chais pas."},{"t":"mcq","skill":"listening","q":"«Nickel !» في حوار شارع تعني:","opts":["سيء جداً","ممتاز/نظيف","سعر رخيص","دعوة للمغادرة"],"a":1,"why":"nickel عامية إيجابية = ممتاز."},{"t":"fill","skill":"vocabulary","q":"أكمل العامية الآمنة: «___ marche !» (موافق)","fr":"___ marche !","ans":"Ça","alts":["ça"],"why":"Ça marche = موافق — عامية محايدة آمنة للاستخدام."},{"t":"order","skill":"listening","q":"رتّب تدريب المقابلة: (1) بالفرنسية وحدها (2) بالترجمة المزدوجة (3) للصوت فقط","words":["D'abord","avec","les","sous-titres."],"ans":"D'abord avec les sous-titres.","why":"ترجمة أولاً ← فرنسية وحدها ← صوت فقط."},{"t":"listen","skill":"listening","q":"استمع واختر المقابل المكتوب:","audio":"T'as vu le nouveau film ?","opts":["Vous avez vu le nouveau film ?","As-tu vu le nouveau film ?","Tu as vu le nouveau film ?","Vas-tu voir le nouveau film ?"],"a":2,"why":"t'as = tu as — النسخة المنطوقة للسؤال العفوي."},{"t":"speaking","skill":"speaking","q":"قل الشارعية بثقة: «لا أعرف كيف أقول» بنسختها المنطوقة.","target":"Je sais pas comment dire.","why":"الإنتاج الشفهي المباشر ينقل العامية من الفهم السلبي إلى الاستعمال الواعي مع الحفاظ على حدودها الاجتماعية."},{"t":"mcq","skill":"listening","q":"لماذا تبدو الفرنسية الحية أسرع؟","opts":["الاختصار والتلصيق لا الإيقاع","لأنها أعلى ألفاظاً","لأنها بلا ترقيم","لأنها تعتمد اللهجات فقط"],"a":0,"why":"j'ai mangé ← j'mangé اختصار مُخطَّط لا سرعة."},{"t":"translate","skill":"writing","q":"ترجم: «لا بأس، أنا مرهق. نخرج؟»","ans":"C'est pas grave, je suis crevé. On se taille ?","alts":["cest pas grave, je suis creve. On se taille ?"],"why":"عبارات العامية المألوفة: crevé + on se taille."}],"homework":"استمع لمقابلة شارع واحدة يومياً 3 أيام متتالية واكتب جملة واحدة سمعتها بلا ترجمة ثم تحقق منها.","sources":[{"title":"استعمل هذه العبارات من الفرنسية العامية للتكلم مثل الفرنسيين تمامًا Parler comme un français","channel":"تعلم و تكلم الفرنسية مع نادية French with Nadia","videoId":"5Mno740H5R0","why":"العامية الفرنسية وعبارات الناطقين — إجابة مباشرة عن سؤال «ماذا يقولون فعلاً؟» ولماذا تبدو الفرنسية الحية أسرع.","cat":"Listening","level":"B1","main":true,"dur":9},{"title":"Understanding fast spoken French : My best tips","channel":"French mornings with Elisa","videoId":"jmqG_Igy2Es","why":"نصائح عملية بشرح إنجليزي واضح لفهم الفرنسية السريعة — تنصب جسور مباشرة بين ما تعرفه كتابةً وما تسمعه شارعاً.","cat":"Listening","level":"B1","extra":true},{"title":"Spoken French - Understand Fast Spoken French","channel":"Comme une Française","videoId":"pLH7rCiAoWM","why":"درس متخصص في الفرنسية المنطوقة الفعلية بأسلوب ممتع: ماذا يقول الفرنسيون حقاً وماذا يسمع المرء — الفروق التي تربك المتعلمين.","cat":"Listening","level":"B1","extra":true},{"title":"What Do The French Have For Breakfast? | Easy French 218","channel":"Easy French","videoId":"EAX8mc_ovDk","why":"مقابلات شارع حقيقية في باريس بترجمة مزدوجة — ميدان التدريب الأخير: سماع أصوات مختلفة وسرعات حقيقية مع أمان الترجمة.","cat":"Listening","level":"B1","extra":true}],"supplements":[{"id":"jmqG_Igy2Es","title":"Understanding fast spoken French : My best tips","channel":"French mornings with Elisa","why":"نصائح عملية بشرح إنجليزي واضح لفهم الفرنسية السريعة — تنصب جسور مباشرة بين ما تعرفه كتابةً وما تسمعه شارعاً.","lang":"en"},{"id":"pLH7rCiAoWM","title":"Spoken French - Understand Fast Spoken French","channel":"Comme une Française","why":"درس متخصص في الفرنسية المنطوقة الفعلية بأسلوب ممتع: ماذا يقول الفرنسيون حقاً وماذا يسمع المرء — الفروق التي تربك المتعلمين.","lang":"en"},{"id":"EAX8mc_ovDk","title":"What Do The French Have For Breakfast? | Easy French 218","channel":"Easy French","why":"مقابلات شارع حقيقية في باريس بترجمة مزدوجة — ميدان التدريب الأخير: سماع أصوات مختلفة وسرعات حقيقية مع أمان الترجمة.","lang":"en"}]}]},{"id":"b1-t6","slug":"expression","icon":"✒️","color":"#0D9488","fr":"Expression écrite","ar":"مسار الكتابة والتعبير","desc":"قلم متوسط مستقل: تنظيم الأفكار، مقال الرأي في DELF B1، والرسائل الرسمية والشكاوى — كتابة مُهيكلة مقنعة.","lessons":[{"id":"B1-t6-l1","fr":"Organiser ses idées à l'écrit","ar":"تنظيم الأفكار كتابةً","objectives":["بناء خطة قبل الكتابة (intro/développement/conclusion)","استخدام الروابط المنطقية في الترتيب والشرح","تدقيق نصك: الأخطاء الشائعة ومراجعتها"],"sections":[{"h":"قبل أن تكتب: الخطة","p":["الكتابة في B1 ليست تعبيراً عشوائياً بل بناء: (1) افهم المهمة (mandat)، (2) رتّب الأفكار في خطة من ثلاث نقاط، (3) اكتب مسودة بعبارات ربط، (4) راجع. فاتتك الخطة = فقرات متكررة وتركيب مفكك — والتصحيح يبدأ من الهيكل لا من الأخطاء.","عبارات الربط (connecteurs) هي هندسة الفقرة: تنظيم (d'abord, ensuite, enfin)، سبب (car, donc, c'est pourquoi)، تضاد (mais, en revanche, au contraire)، وأمثلة (par exemple, notamment). أربع مجموعات = هيكال كل فقرة — والنص بلا ربط يبدو قائمة كلام لا كتابة.","تابع الفيديو الأساسي بالشرح العربي: مقدمة إلى الفكرة، متن الفكرة، خاتمة الفكرة — البناء الثلاثي: المقدمة تفتح الباب (سياق ← قضية)، المتن يبني الحجج الثلاث، الخاتمة تُغلق الباب ولا تُفتح باباً جديداً. خاتمة تُقدّم حجة جديدة = خطأ بنيوي يُقصم التقييم.","الفقرة المتماسكة (cohésion): جملة موضوعية تفتح، جملتا حجج، وجملة رابعة خاتمة/مثال. القياس: كل فقرة = 4-6 جُمل، وكل جملة مرتبطة بما قبلها بـ anaphore (le, ce, cette) أو إعادة صياغة (reformulation). النص المفكك يُقرأ حتى لو كانت الجمل صحيحة.","لا تعدّل ما لم تكتبه: قاعدة المسوّدة — اكتب 200 كلمة بلا توقف ثم راجع. التوقف الدائم للتصحيح يقطع التفكير ويُنتج نصاً قصيراً مرتَّباً لا نصاً طويلاً متدفّقاً. المراجعة مرحلة منفصلة تماماً عن الكتابة.","خطة المراجعة بأربع نظرات: (1) المهمة مُجابة؟ (2) الروابط موجودة؟ (3) التراكيب صحيحة (passé/composé vs imparfait)؟ (4) الإملاء والترقيم؟ أربع نظرات بأدوار مختلفة خير من قراءة واحدة تتجاهل كل شيء."],"video":{"id":"TqkjHhuwKcY","title":"تعلم كتابة النصوص في 20 دقيقة بالفرنسية كيف ما كان مستواك","channel":"Le français avec Imad Zniti","why":"منهجية كتابة النص كاملة من البداية للإحتراف بأي مستوى — الخطة والبناء والروابط في إطار منهجي واحد.","lang":"ar","main":true,"dur":20},"sub":[{"h":"منهجية الأربع خطوات","p":["فهم الـ mandat ثم الخطة.","ثلاث نقاط لا أكثر.","مسوّدة بعبارات ربط.","مراجعة بأربع نظرات."]},{"h":"أربع مجموعات ربط","p":["تنظيم: d'abord, ensuite, enfin.","سبب: car, donc, c'est pourquoi.","تضاد: mais, en revanche.","مثال: par exemple, notamment."]},{"h":"الفقرة المتماسكة","p":["4-6 جُمل في الفقرة.","موضوعية + حجتان + خاتمة.","anaphore (le, ce, cette).","الخاتمة لا تفتح باباً جديداً."]}]},{"h":"منهجية الكتابة بالمدرسة الفرنسية","p":["المدرسة الفرنسية تكافئ المنهجية (méthodologie): خطتك المرئية نصف الدرجة. بنية المقال القياسية من ثلاث حزم: فقرة افتتاحية تحدد الموضوع وتلمح لموقفك، فقرة لكل حجة مع أدوات الربط، خاتمة تختصر وتستنتج. اجعل مخططك مرئياً: ميز، رقّم، واكتب روابط الفقرات قبل الجمل.","بعد الكتابة: مرحلة الدور الثالث هي صديقك الحقيقي — مراجعة قصيرة بعينين محايدتين: 1) هل لكل فقرة فكرة واحدة؟ 2) هل الروابط تلائم الوظيفة (تشديد لا ترتيب...)؟ 3) هل الخاتمة تفتح أفق أم تكرر؟ ثوانٍ من التدقيق تحمي من نصف الأخطاء الشائعة.","«En somme», «Pour conclure», «Bref» — ثلاث كلمات تُغلق الخاتمة رسمياً. لاحظ أن الخاتمة تعيد الصياغة (reformulation) لا التكرار الحرفى — إعادة الصياغة هي مهارة B1 الأبرز في الكتابة."],"video":null},{"h":"روابط الفقرات: جسر النص","p":["في الفقرات تحدّد الروابط الطريق: للترتيب (d'abord, ensuite, enfin)، للإضافة (de plus, par ailleurs)، للتناقض (cependant, en revanche)، للنتيجة (donc, par conséquent)، للتوضيح (c'est-à-dire, en effet). الأدوات نفسها التي تدربت عليها في قراءة النص الحجاجي — الآن تُستخدم لإنتاج نص.","قاعدة مهمة للامتحان: استخدم كل رابط في وظيفته الصحيحة، ولا تُصبّ عشرة روابط في فقرة واحدة. الممتحن يسجل الروابط المستخدمة صح، وكثافة زائدة تكشف الحفظ لا الفهم. اكتب أولاً حُجة سليمة ثم اختر ألصق رابط — لا العكس.","تمرين الخطة: خذ أي موضوع («Travailler depuis la ville ?») واكتب مقدمة + خطة ثلاثية في 3 دقائق بلا مسودة — ثم اكتب الفقرة الأولى فقط. التمرين يفصل التخطيط عن التنفيذ قبل أن تدمجهما."],"video":null},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: بنيت خطة قبل الكتابة (مقدمة ← عرض ← خاتمة)، وأتقنت أربع مجموعات من الروابط (تنظيم، سبب، تضاد، مثال) وخطة المراجعة بأربع نظرات. أعد مشاهدة الفيديو الرئيسي وركّز على تسلسل الخطوات الأربع (فهم المهمة ← الخطة ← المسودة ← المراجعة) وعلى موقع الرابط داخل الفقرة.","جسر الدروس: من B1-t5-l3 (فهم الفرنسية السريعة وأذن جاهزة للسرعة) إلى B1-t6-l1 (تنظيم الأفكار كتابةً بالخطة والروابط)، ثم إلى B1-t6-l2 حيث تكتب مقال رأي كاملاً وفق شكل DELF B1 ومعاييره الأربع.","مهمة تطبيقية: خذ موضوعاً واحداً ثم سجّل صوتك أو اكتب في دقيقة خطة ثلاثية (مقدمة، حجتان، خاتمة) مستعملاً 3 كلمات جديدة من مفردات الدرس، وقارن خطةك بنموذج الفيديو الرئيسي وحدّد ما ينقصك."]}],"examples":[{"fr":"D'abord, je vais présenter mon point de vue.","ar":"أولاً، سأعرض وجهة نظري."},{"fr":"De plus, cette idée présente des avantages économiques.","ar":"علاوة على ذلك، هذه الفكرة لها مزايا اقتصادية."},{"fr":"Par conséquent, il faut agir rapidement.","ar":"نتيجة لذلك، يجب التسرّع في العمل."},{"fr":"En conclusion, la question mérite plus d'attention.","ar":"ختاماً، تستحق المسألة عناية أكبر."},{"fr":"D'abord, le coût. Ensuite, le temps. Enfin, la fatigue.","ar":"أولاً التكلفة، ثم الوقت، أخيراً التعب.","note":"تنظيم"},{"fr":"En revanche, le local offre plus de place.","ar":"بالعكس، المكان يوفّر مساحة أكبر.","note":"تضاد"},{"fr":"En somme, il faut choisir — et décider vite.","ar":"باختصار، يجب الاختيار — واتخاذ قرار سريع.","note":"خاتمة"},{"fr":"Ce plan aboutit à trois idées claires.","ar":"هذه الخطة تؤدي إلى ثلاث أفكار واضحة.","note":"تماسك"}],"pron":[{"w":"cependant","ipa":"[sə.pɑ̃.dɑ̃]","approx":"سُه-بان-دان"},{"w":"en revanche","ipa":"[ɑ̃ ʁə.vɑ̃ʃ]","approx":"آن-ره-فانش","note":"في المقابل"},{"w":"par ailleurs","ipa":"[paʁ a.jœʁ]","approx":"بار-آه-يُهر","note":"علاوة على ذلك"}],"vocab":[{"fr":"un plan","ar":"خطة (نصية)","pos":"nom","g":"m","pl":"des plans","ipa":"[plɑ̃]","exFr":"Fais un plan avant d'écrire.","exAr":"ضع خطة قبل الكتابة."},{"fr":"une idée","ar":"فكرة","pos":"nom","g":"f","pl":"des idées","ipa":"[i.de]","exFr":"Une idée par paragraphe suffit.","exAr":"فكرة واحدة للفقرة تكفي."},{"fr":"un connecteur logique","ar":"رابط منطقي","pos":"nom","g":"m","ipa":"[kɔ.nɛk.tœʁ lo.ʒik]","exFr":"Les connecteurs logiques structurent le texte.","exAr":"الروابط المنطقية تُهيكل النص."},{"fr":"rédiger","ar":"يؤلف / يكتب (نصاً)","pos":"verbe","ipa":"[ʁe.di.ʒe]","exFr":"Rédige ton texte en trois paragraphes.","exAr":"أوفر نصك في ثلاث فقرات."},{"fr":"l'introduction","ar":"المقدمة","pos":"nom","g":"f","pl":"des introductions","ipa":"[ɛ̃.tʁɔ.dyksjɔ̃]","exFr":"L'introduction présente le sujet en trois lignes.","exAr":"المقدمة تقدّم الموضوع في ثلاثة أسطر."},{"fr":"la cohérence","ar":"الانسجام / الترابط","pos":"nom","g":"f","ipa":"[kɔ.e.ʁɑ̃s]","exFr":"Ton texte manque de cohérence.","exAr":"نصك ينقصه الانسجام."},{"fr":"la cohésion","ar":"التماسك","pos":"nom","g":"f","exFr":"La cohésion du texte.","ipa":"[kɔhezjɔ̃]","exAr":"تماسك النص."},{"fr":"reformuler","ar":"يعيد الصياغة","pos":"verbe","g":"1er","exFr":"Reformuler dans la conclusion.","ipa":"[ʁefɔʁmyle]","exAr":"إعادة الصياغة في الخاتمة."},{"fr":"le connecteur","ar":"أداة الربط","pos":"nom","g":"m","exFr":"Un connecteur logique.","ipa":"[kɔnɛktœʁ]","exAr":"أداة ربط منطقية."},{"fr":"aboutir à","ar":"يؤدي إلى","pos":"locution","exFr":"Le plan aboutit à trois idées.","ipa":"[abutiʁ a]","exAr":"الخطة تؤدي لثلاث أفكار."},{"fr":"en somme / pour conclure","ar":"باختصار/ختاماً","pos":"locution","exFr":"En somme, c'est réalisable.","ipa":"[ɑ̃ sɔm]","exAr":"باختصار، هذا ممكن."},{"fr":"la mise en page","ar":"التنسيق","pos":"nom","exFr":"Soigner la mise en page.","ipa":"[myzɑ̃ paʒ]","exAr":"الاهتمام بالتنسيق."},{"fr":"un paragraphe","ar":"فقرة","pos":"nom","g":"m","exFr":"Un paragraphe par idée.","ipa":"[paʁaɡraf]","exAr":"فقرة لكل فكرة."},{"fr":"étoffer","ar":"يُوسّع المحتوى","pos":"verbe","g":"1er","exFr":"Étoffer avec des exemples.","ipa":"[etɔfe]","exAr":"التوسعة بالأمثلة."},{"fr":"un brouillon","ar":"مسوّدة","pos":"nom","g":"m","exFr":"Écrire un brouillon d'abord.","ipa":"[bʁujɔ̃]","exAr":"كتابة مسوّدة أولاً."},{"fr":"structurer","ar":"يُهيكل (النص)","pos":"verbe","ipa":"[stʁyktɥʁe]","exFr":"Structurer le plan avant d'écrire.","exAr":"هيكلة الخطة قبل الكتابة."}],"grammar":[{"tFr":"Le connecteur logique + la subordonnée","tAr":"القاعدة: أداة الربط مع المركّبة","body":["الروابط الكبيرة تأخذ أنظمة مختلفة: «c'est pourquoi + indicatif»، «bien que + subjonctif»، «parce que + indicatif» — سلّم المنصوب/الخبري يبقى مفتاح التقييم.","«de sorte que + subjonctif» (لي) و«de telle façon que» يربطان النتيجة بالنية — اقتصاد في الاستعمال أعلاه في الكتابة."],"ex":[{"fr":"Il est tard, c'est pourquoi je m'en vais.","ar":"الوقت متأخر، ولهذا أذهب."},{"fr":"Bien que fatigué, j'ai fini le rapport.","ar":"رغم التعب، أنهيت التقرير."}]}],"mistakes":[{"wrong":"كتابة بلا خطة","right":"3 نقاط في 3 دقائق أولاً","why":"النص بلا خطة = فقرات مكررة ومراكز مفككة."},{"wrong":"خاتمة بحجة جديدة","right":"خاتمة بصياغة فقط","why":"الحجة الجديدة تكسر البناء وتقلل التقييم."},{"wrong":"تعديل أثناء الكتابة","right":"مسوّدة ثم مراجعة منفصلة","why":"التوقف الدائم يقطع التفكير ويرمّم الطول."},{"wrong":"قائمة كلام بلا ربط","right":"أربع مجموعات connecteurs","why":"النص بلا ربط يبدو غير منطقي حتى لو كانت الجمل صحيحة."}],"dialogues":[{"title":"ورشة تصحيح","ctx":"مدرّسان يراجعان مسودة","lines":[{"who":"Prof. 1","fr":"La structure est claire, mais les paragraphes ?","ar":"البنية واضحة، لكن الفقرات؟"},{"who":"Prof. 2","fr":"Trois paragraphes, un par idée — c'est court.","ar":"ثلاث فقرات، واحدة لكل فكرة — قصيرة."},{"who":"Prof. 1","fr":"Il manque des connecteurs dans le deuxième.","ar":"تنقص الأدوات الرابطة في الثانية."},{"who":"Prof. 2","fr":"Exactement : «Ensuite, par contre...».","ar":"بالضبط: «ثم، بالعكس...»."},{"who":"Prof. 1","fr":"Et la conclusion répète l'introduction.","ar":"والخاتمة تكرر المقدمة."},{"who":"Prof. 2","fr":"Il faut reformuler, pas copier.","ar":"يجب إعادة الصياغة لا النسخ."}]}],"exercises":[{"t":"mcq","skill":"writing","q":"أول خطوة قبل كتابة نص:","opts":["أكتب مباشرة وأصلح لاحقاً","أضع خطة من ثلاثة أجزاء","أبحث عن كلمات فخمة","أترجم من العربية"],"a":1,"why":"الخطة (intro/عرض/خاتمة) قبل الكتابة توفر وقت التصحيح."},{"t":"mcq","skill":"writing","q":"أي رابط يناسب بدء الفقرة الثانية بعد حجة؟","opts":["Mais","Ensuite","Donc","Enfin"],"a":1,"why":"ensuite لترتيب الحجج؛ mais للتناقض وdonc للنتيجة."},{"t":"fill","skill":"writing","q":"أكمل بالرابط: «Le prix est élevé, ___ la qualité est excellente.» (لكن)","fr":"Le prix est élevé, ___ la qualité est excellente.","ans":"mais","alts":["cependant","pourtant"],"why":"mais/cependant/pourtant كلها تصلح للتناقض."},{"t":"order","skill":"writing","q":"رتّب بنية المقال: (1) الخاتمة (2) المقدمة (3) العرض والحجج","words":["D'abord","l'introduction,","puis","le","développement,","enfin","la","conclusion."],"ans":"D'abord l'introduction, puis le développement, enfin la conclusion.","why":"التسلسل: مقدمة → عرض → خاتمة."},{"t":"listen","skill":"listening","q":"استمع واختر موضع الجملة في المقال:","audio":"En conclusion, la question mérite plus d'attention","opts":["مقدمة موضوع","حجة وسطى","خاتمة تفتح أفق","سؤال للقارئ"],"a":2,"why":"en conclusion تفتح الخاتمة دائماً."},{"t":"writing","skill":"writing","q":"اكتب فقرة (5 جمل) عن «أفضل وسيلة تنقل في مدينتك» باستخدام: d'abord / de plus / par conséquent.","min":25,"kw":["d'abord","de plus","par conséquent"],"sample":"D'abord, le tramway est rapide et économique. De plus, il évite les embouteillages du centre. Par conséquent, c'est la meilleure solution pour se déplacer dans ma ville.","why":"إنتاج فقرة واحدة بروابط محددة يقيس قدرتك على توظيف الروابط وظيفياً لا حفظياً."},{"t":"mcq","skill":"writing","q":"الخطوة الأولى قبل كتابة أي نص B1:","opts":["فهم المهمة ووضع خطة ثلاثية","كتابة أول جملة","البحث عن المفردات","الإملاء"],"a":0,"why":"الخطة تمنع التكرار والمراكز المفككة."},{"t":"fill","skill":"writing","q":"أكمل: «___, les coûts. Ensuite, le temps.» (أولاً)","fr":"___, les coûts. Ensuite, le temps.","ans":"D'abord","alts":["d'abord","Dabord","dabord"],"why":"D'abord أداة التنظيم الأولى في الفقرة."}],"homework":"اكتب خطة ثلاثية (مقدمة، حجتان، خاتمة) لموضوع «الشاشات في المدارس» ثم حولها إلى نص من 8 أسطر بالروابط.","sources":[{"title":"تعلم كتابة النصوص في 20 دقيقة بالفرنسية كيف ما كان مستواك","channel":"Le français avec Imad Zniti","videoId":"TqkjHhuwKcY","why":"منهجية كتابة النص كاملة من البداية للإحتراف بأي مستوى — الخطة والبناء والروابط في إطار منهجي واحد.","cat":"Writing","level":"B1","main":true,"dur":20},{"title":"5 Conseils pour Écrire en Français","channel":"Français avec Pierre","videoId":"nX83s2frxKk","why":"خمس نصائح عملية من أستاذ معروف لتحسين كتابة الفرنسية مباشرة — تصلح خارطة طريق لكل مادة الكتابة في هذا المسار.","cat":"Writing","level":"B1","extra":true},{"title":"Production-écrite 1: Le plan simple (1BAC) منهجية كتابة موضوع انشائي","channel":"Le Français avec Aida","videoId":"obixxQPrDco","why":"شرح بالعربية لمنهجية المقال الفرنسي وخطة التبسيط — جسر مثالي لمن تعوّد المنهجية المدرسية المغربية/الجزائرية ويريد تطبيقها بفرنسية سليمة.","cat":"Writing","level":"B1","extra":true},{"title":"CONNECTEURS LOGIQUES : pour être CONNECTÉ à son CORRECTEUR !","channel":"Le français c'est clair","videoId":"ERO6AOUcK_U","why":"درس حيوي على الروابط المنطقية من منظور الممتحن — يريك أي روابط تفيدك في الامتحان وكيف تُستخدم بدقة لا كزينة.","cat":"Writing","level":"B1","extra":true}],"supplements":[{"id":"nX83s2frxKk","title":"5 Conseils pour Écrire en Français","channel":"Français avec Pierre","why":"خمس نصائح عملية من أستاذ معروف لتحسين كتابة الفرنسية مباشرة — تصلح خارطة طريق لكل مادة الكتابة في هذا المسار.","lang":"fr"},{"id":"obixxQPrDco","title":"Production-écrite 1: Le plan simple (1BAC) منهجية كتابة موضوع انشائي","channel":"Le Français avec Aida","why":"شرح بالعربية لمنهجية المقال الفرنسي وخطة التبسيط — جسر مثالي لمن تعوّد المنهجية المدرسية المغربية/الجزائرية ويريد تطبيقها بفرنسية سليمة.","lang":"ar"},{"id":"ERO6AOUcK_U","title":"CONNECTEURS LOGIQUES : pour être CONNECTÉ à son CORRECTEUR !","channel":"Le français c'est clair","why":"درس حيوي على الروابط المنطقية من منظور الممتحن — يريك أي روابط تفيدك في الامتحان وكيف تُستخدم بدقة لا كزينة.","lang":"fr"}]},{"id":"B1-t6-l2","fr":"L'essai d'opinion (DELF B1)","ar":"كتابة مقال الرأي","objectives":["إتقان بنية مقال DELF B1 (160-180 كلمة)","التعبير عن رأي مدعوم بأدلة في الكتابة","تجنب الأخطاء المميتة في الامتحان"],"sections":[{"h":"شكل المقال في DELF B1","p":["المهمة الكتابية في DELF B1 لها شكل ثابت: سؤال واحد، 25-40 سطراً، 30 دقيقة. صيغ «نريد منك أن تكتب مقالاً...» تعني: رأي شخصي مُعلَّل + سطان مرتبطان + خاتمة. السلّم: أفكار (3 دقائق)، مسوّدة (20)، مراجعة (7).","النظرات الأربع للمُقيّم هي بوصلتك: la réponse au sujet (الإجابة الكاملة)، la cohérence (ترتيب الأفكار)، l'originalité (صياغتك لا حفظك)، la correction linguistique (البنية والمفردات). لاحظ أن originality مُقيَّمة — النص المحفوظ القديم يسقط في originality مهما كان سليماً.","تابع الفيديو الأساسي بالشرح العربي: كيف تكتب مقال DELF B1 في 30 دقيقة — نموذج حي: مقدمة بسؤال تمهيدي، حجتان بـ «D'une part/D'autre part»، خاتمة بـ «Pour ma part». النموذج ليس للحفظ بل لفهم التسلسل الزمني.","الافتتاحية بالسؤال التمهيدي: «De nos jours, beaucoup se demandent si...» — سؤال افتتاحي يفتح الباب للقضية ويُظهر اهتمامك بالموضوع قبل رأيك. افتتاحية مباشرة («Je pense que...» بلا سياق) تسرق نصف النقطة الأولى من ميزانيتك.","حجتان لا أكثر: واحدة سببية (car / parce que)، وأخرى مثالية (par exemple / notamment). حجتان بعمق خير من أربع سطحية — المُقيّم يقرأ مئات المقالات يومياً، والعمق يُرى فوراً في الجملة الرابعة.","التدقيق في 3 دقائق: (1) passé composé vs imparfait في الرواية، (2) النفي مع «ne...pas» الكامل، (3) التطابق مع le/la/les في adj، (4) النقاط على i والشرطة على é. أربع نقاط تصطاد 70% من أخطاء B1."],"video":{"id":"9V3d_22fSqU","title":"DELF B1 الإنتاج المكتوب / المقال / الترجمة","channel":"Learn French with Stephanie","why":"إنتاج DELF B1 الكتابي: المقال بامثلة محلولة وترجمة — يقابل شكل المقال ونموذج التصحيح في الدرس.","lang":"ar","main":true,"dur":26},"sub":[{"h":"بنية المهمة","p":["سؤال واحد، 25-40 سطراً.","30 دقيقة: 3+20+7.","رأي مُعلَّل + ربطان + خاتمة.","الحفظ بلا ارتباط بالسؤال = صفر."]},{"h":"النظرات الأربع","p":["réponse au sujet — إجابة كاملة.","cohérence — ترتيب الأفكار.","originality — صياغتك.","correction linguistique — بنية."]},{"h":"حجتان بعمق","p":["مقدمة بسؤال تمهيدي.","D'une part / D'autre part.","سبب ثم مثال.","خاتمة بصياغة جديدة."]}]},{"h":"نموذج محلول: تعلم من التصحيح","p":["دراسة نموذج محلول أهم أداة: انظر كيف تبدأ المقدمة بحساب الموضوع («De nos jours, les écrans occupent une place importante...»)، كيف تعرض الرأي («À mon avis, les écrans ont plus d'avantages que d'inconvénients»)، وكيف تختتم («En conclusion, il faut trouver un équilibre»). هذه «هياكل جاهزة» تصلح لمعظم الموضوعات.","عبارات الافتتاح المجربة: «De nos jours...» (في أيامنا)؛ «Il est indéniable que...» (لا يمكن إنكار...)؛ «La question de... suscite beaucoup de débats» (موضوع... يثير نقاشات كثيرة). عبارات الخاتمة: «En conclusion...»؛ «Pour terminer...»؛ «Il serait donc nécessaire de...». احفظ ثلاثاً لكل موقع — لا أكثر.","طول 25-40 سطراً مُراقب: أقل = أفكار ناقصة، أكثر = إملاء لا يُراجَع. عدّ السطور على ورقة التحضير قبل التسليم — ثلاث دقائق تُنقذ نقطة التوقيع."],"video":null},{"h":"عشر نصائح للممتحن الداخلي","p":["أهم النصائح العملية: 1) اقرأ الموضوع مرتين وحدد الكلمات المفتاحية والمطلوب (رأي؟ اقتراح؟). 2) اكتب خطة سريعة في 3 دقائق. 3) استخدم روابطك المفضلة بثقة بدل المخاطرة بجديدة. 4) جمل قصيرة سليمة أفضل من طويلة معطوبة. 5) اترك دقيقة للتدقيق: الأفعال والصيغ المؤنثة والسحب.","الأخطاء المميتة التي تحرّم النقاط: تجاوز الطول أو نقصه بفارق كبير؛ إهمال جملة المطلوب (إن طُلب «proposez une solution» فلا تكتب رأياً فقط)؛ إملاء الأزمنة في السطر الأخير من الإرهاق. التدريب على 3 مواضيع كاملة قبل الامتحان يحوّل كل هذا من نصائح إلى عادة.","بعد الفيديو: اكتب مقال DELF كامل («Travailler dans la fonction publique ?») في 30 دقيقة بالمؤقّت، ثم عدّل فقط أربع نقاط التدقيق الثلاثية — لا تكتب ثانية بل صحّح وأعد كتابة الجمل المصابة فقط."],"video":null},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: أتقنت شكل مقال DELF B1 (160-180 كلمة في 30 دقيقة: 3+20+7)، والنظرات الأربع للمُقيّم، والافتتاحية بالسؤال التمهيدي مع حجتين بعمق وخلاصة بصياغة جديدة. أعد مشاهدة الفيديو الرئيسي وركّز على التوقيت وعلى عبارات الافتتاح والخاتمة المستخدمة في النموذج المحلول.","جسر الدروس: من B1-t6-l1 (الخطة والروابط وتماسك الفقرة) إلى B1-t6-l2 (مقال الرأي في DELF B1 ومعايير التصحيح)، ثم إلى B1-t6-l3 حيث تنتقل من المقال الشخصي إلى الرسالة الرسمية والإيميل المهذّب.","مهمة تطبيقية: اختر سؤالاً تدريبياً ثم سجّل صوتك أو اكتب في دقيقة مقالاً مصغّراً بفكرتين، مستعملاً 3 كلمات جديدة من مفردات الدرس، وقارن افتتاحيتك وخاتمتك بالفيديو الرئيسي وصحّح الفرق."]}],"examples":[{"fr":"De nos jours, les réseaux sociaux occupent une grande place.","ar":"في أيامنا تحتل الشبكات الاجتماعية مكانة كبيرة."},{"fr":"À mon avis, les avantages l'emportent sur les inconvénients.","ar":"برأيي، المزايا تغلب العيوب."},{"fr":"Par exemple, les jeunes peuvent apprendre des langues en ligne.","ar":"على سبيل المثال، يمكن للشباب تعلم اللغات عبر الإنترنت."},{"fr":"En conclusion, il faut trouver un juste équilibre.","ar":"ختاماً، يجب إيجاد توازن عادل."},{"fr":"De nos jours, beaucoup se demandent si le travail à distance change tout.","ar":"في أيامنا هذه، يتساءل كثيرون هل العمل عن بُعد يغيّر كل شيء.","note":"افتتاحية"},{"fr":"D'une part le confort, d'autre part l'isolement.","ar":"من جهة الراحة، ومن جهة العزلة.","note":"حجتان"},{"fr":"À titre d'exemple, mon voisin a changé de rythme.","ar":"على سبيل المثال، جارغيّر إيقاعه.","note":"مثال"},{"fr":"Pour ma part, je reste nuancé.","ar":"أنا شخصياً أبقى متحفّظاً.","note":"خاتمة"}],"pron":[{"w":"de nos jours","ipa":"[də no ʒuʁ]","approx":"دُه-نو-جور"},{"w":"l'emportent","ipa":"[lɑ̃.pɔʁt]","approx":"لان-بورت","note":"تغلب (l'emporter sur)"},{"w":"suscite","ipa":"[sy.sit]","approx":"سوسيت"}],"vocab":[{"fr":"un essai","ar":"مقال رأي","pos":"nom","g":"m","pl":"des essais","ipa":"[e.sɛ]","exFr":"L'essai du DELF fait 160 mots.","exAr":"مقال DELF في 160 كلمة."},{"fr":"un avantage","ar":"ميزة","pos":"nom","g":"m","pl":"des avantages","ipa":"[a.vɑ̃.taʒ]","exFr":"Le premier avantage est économique.","exAr":"الميزة الأولى اقتصادية."},{"fr":"un inconvénient","ar":"عيب / مرفق","pos":"nom","g":"m","pl":"des inconvénients","ipa":"[ɛ̃.kɔ̃.ve.njɑ̃]","exFr":"Quel est le principal inconvénient ?","exAr":"ما العيب الأساسي؟"},{"fr":"l'emporter sur","ar":"يغلب على","pos":"expression","ipa":"[lɑ̃.pɔʁ.te syʁ]","exFr":"Les avantages l'emportent sur les inconvénients.","exAr":"المزايا تغلب العيوب."},{"fr":"susciter","ar":"يثير (نقاشاً)","pos":"verbe","ipa":"[sys.i.te]","exFr":"Ce sujet suscite des débats.","exAr":"هذا الموضوع يثير نقاشات."},{"fr":"un équilibre","ar":"توازن","pos":"nom","g":"m","pl":"des équilibres","ipa":"[e.li.bʁ]","exFr":"Il faut trouver un équilibre.","exAr":"يجب إيجاد توازن."},{"fr":"la méthodologie","ar":"المنهجية","pos":"nom","g":"f","pl":"les méthodologies","ipa":"[me.tɔ.dɔ.lɔ.ʒi]","exFr":"La méthodologie fait gagner des points.","exAr":"المنهجية تكسب نقاطاً."},{"fr":"la question de départ","ar":"السؤال الانطلاق","pos":"nom","exFr":"Repartir de la question de départ.","ipa":"[kɛstjɔ̃ də depart]","exAr":"العودة للسؤال الانطلاق."},{"fr":"la note de synthèse","ar":"درجة التماسك/التركيب","pos":"nom","exFr":"La note de synthèse compte.","ipa":"[nɔt də sɛ̃tɛz]","exAr":"درجة التركيب مهمة."},{"fr":"à titre d'exemple","ar":"على سبيل المثال","pos":"locution","exFr":"À titre d'exemple, prenons...","ipa":"[a titʁ dɛɡzɑ̃pl]","exAr":"على سبيل المثال، لنأخذ..."},{"fr":"d'une part... d'autre part","ar":"من جهة... من جهة أخرى","pos":"locution","exFr":"D'une part utile, d'autre part risqué.","ipa":"[dyn paʁ]","exAr":"من جهة مفيد، من جهة محفوف بالمخاطر."},{"fr":"ma foi / pour ma part","ar":"بصراحة/شخصياً","pos":"locution","exFr":"Pour ma part, je préfère.","ipa":"[puʁ ma paʁ]","exAr":"أنا شخصياً أفضل."},{"fr":"nuire à l'équilibre","ar":"يضرّ بالتوازن","pos":"locution","exFr":"Cela nuit à l'équilibre.","ipa":"[nɥiʁ ekwilibʁ]","exAr":"هذا يضر التوازن."},{"fr":"imposer","ar":"يفرض","pos":"verbe","g":"1er","exFr":"Une nouvelle mode s'impose.","ipa":"[ɛ̃pwaze]","exAr":"نمط جديد يفرض نفسه."},{"fr":"prendre ses distances","ar":"يتحفّظ","pos":"locution","exFr":"Prendre ses distances avec ce sujet.","ipa":"[pʁɑ̃dʁ se distɑ̃s]","exAr":"التحفظ تجاه هذا الموضوع."},{"fr":"l'essentiel (est que)","ar":"الجوهر (أن)","pos":"nom","g":"m","exFr":"L'essentiel est que tu réponses.","ipa":"[esɑ̃sjɛl]","exAr":"الجوهر أن تجيب."},{"fr":"dans l'ensemble","ar":"إجمالاً","pos":"locution","exFr":"Dans l'ensemble, c'est positif.","ipa":"[dɑ̃z ɑ̃sɑ̃bl]","exAr":"إجمالاً، هذا إيجابي."},{"fr":"la synthèse","ar":"التركيب/الخلاصة","pos":"nom","g":"f","exFr":"Faire une synthèse de deux points.","ipa":"[sɛ̃tɛz]","exAr":"تركيب نقطتين."}],"grammar":[{"tFr":"Indicatif dans l'argumentation","tAr":"القاعدة: الخبري في الإقناع","body":["الإقناع يعيش في الخبري: «je pense que + indicatif» و«c'est pourquoi + indicatif» — المنصوب للشك والرغبة فقط، والإفراط فيه يُضعف موقفك المعلن.","«il est important que + subjonctif» و«il faut que + subjonctif» هما استثناءك المشروع في المقال."],"ex":[{"fr":"Je pense que ce choix est utile, car il allège...","ar":"أعتقد هذا الاختيار مفيد لأنه يخفف..."},{"fr":"Il est important que chacun y réfléchisse.","ar":"من المهم أن يفكر كل واحد في ذلك."}]}],"mistakes":[{"wrong":"إجابة جزئية عن السؤال","right":"أعد صياغة السؤال في مقدمة ثم أجب كاملاً","why":"الإجابة الجزئية تسقط في répons au sujet أولاً."},{"wrong":"حفظ مقال كامل موضوع آخر","right":"بناء بالروابط أمام نموذج","why":"الحفظ يظهر فوراً ويقتل originality."},{"wrong":"أربع حجج سطحية","right":"حجتان بعمق + مثال","why":"العمق يُرى في الجملة الرابعة ويُثقَل في التصحيح."},{"wrong":"الإطالة عن 40 سطراً","right":"عدّ السطور قبل التسليم","why":"الإطالة تسرق زمن المراجعة وتخفض سلامة التصحيح."}],"dialogues":[{"title":"تحضير DELF","ctx":"طالب ومدرّبة","lines":[{"who":"Nour","fr":"Combien de temps pour l'article ?","ar":"كم وقتاً للمقال؟"},{"who":"Coach","fr":"30 minutes : 3 pour le plan, 20 pour écrire.","ar":"30 دقيقة: 3 للخطة و20 للكتابة."},{"who":"Nour","fr":"Et mes deux parties, elles tiennent ?","ar":"وهل جزأي يصمدان؟"},{"who":"Coach","fr":"D'une part / d'autre part, avec des exemples.","ar":"من جهة/من جهة أخرى، مع أمثلة."},{"who":"Nour","fr":"La conclusion aussi ?","ar":"والخاتمة أيضاً؟"},{"who":"Coach","fr":"Reformule l'intro — jamais la copier.","ar":"أعد صياغة المقدمة — لا تنسخها أبداً."}]}],"exercises":[{"t":"mcq","skill":"writing","q":"الطول المطلوب لمقال DELF B1:","opts":["80-100 كلمة","160-180 كلمة","250 كلمة","كما تشاء"],"a":1,"why":"160-180 كلمة هو المدى الرسمي — النقص والزيادة يخسران نقاطاً."},{"t":"mcq","skill":"writing","q":"أفضل افتتاحية لمقال رأي:","opts":["Salut ! Je vais parler de...","De nos jours, ce sujet suscite des débats","Il y a une maison rouge","Je ne sais rien du sujet"],"a":1,"why":"افتتاحية محايدة تُمهّد للموضوع ثم تُتلى رأيك."},{"t":"fill","skill":"writing","q":"أكمل: «Les avantages ___ sur les inconvénients.» (تغلب)","fr":"Les avantages ___ sur les inconvénients.","ans":"l'emportent","alts":["lemportent"],"why":"l'emporter sur = يغلب — تعبير مقالي قياسي."},{"t":"order","skill":"writing","q":"رتّب نص المقال: (1) الرأي والعرض (2) المقدمة المحايدة (3) الخاتمة","words":["De","nos","jours,"],"ans":"De nos jours,","why":"المقدمة المحايدة أولاً ثم الرأي ثم الخاتمة."},{"t":"listen","skill":"listening","q":"استمع واختر ما تؤشّره جملة الصوت:","audio":"En conclusion, il faut trouver un juste équilibre","opts":["حجة وسطى","مثال توضيحي","خاتمة","مقدمة"],"a":2,"why":"en conclusion تُشير للخاتمة بوضوح."},{"t":"writing","skill":"writing","q":"اكتب مقالاً قصيراً (120+ كلمة) عن «هل أفضل وسيلة تواصل الإنترنت؟»: مقدمة محايدة + رأي + مثال + خاتمة.","min":60,"kw":["de nos jours","à mon avis","en conclusion"],"sample":"De nos jours, la communication passe surtout par Internet. À mon avis, c'est une évolution positive : par exemple, je parle chaque semaine avec ma famille à l'étranger sans coût. Cependant, les vraies rencontres manquent parfois. En conclusion, Internet est un outil précieux, à condition de garder des liens réels.","why":"كتابة مقال مصغّر بالافتتاحية والرأي والمثال والخاتمة تختبر بنية DELF قبل الامتحان وتكشف نقصك في تقدير الوقت."},{"t":"mcq","skill":"writing","q":"مدّة ومهمة مقال DELF B1:","opts":["30 دقيقة، 25-40 سطراً، رأي مُعلَّل","ساعتان، 100 سطر","15 دقيقة، قصة قصيرة","45 دقيقة، ترجمة"],"a":0,"why":"الشكل ثابت: 30 دقيقة و25-40 سطراً."},{"t":"order","skill":"writing","q":"رتّب مراحل الكتابة: (1) المسودة (2) الخطة (3) المراجعة","words":["D'abord","le","plan,","ensuite","le","brouillon,","enfin","la","relecture."],"ans":"D'abord le plan, ensuite le brouillon, enfin la relecture.","why":"خطة ← مسودة ← مراجعة، مقسّمة 3+20+7 دقائق."}],"homework":"اكتب مقالاً كاملاً (160 كلمة) عن «هل يجب تعليم البرمجة في المدارس؟» في 40 دقيقة بنظام الامتحان، ثم عد كلماتك وصحّح.","sources":[{"title":"DELF B1 الإنتاج المكتوب / المقال / الترجمة","channel":"Learn French with Stephanie","videoId":"9V3d_22fSqU","why":"إنتاج DELF B1 الكتابي: المقال بامثلة محلولة وترجمة — يقابل شكل المقال ونموذج التصحيح في الدرس.","cat":"Writing","level":"B1","main":true,"dur":26},{"title":"Production écrite DELF B1 | L'ESSAI","channel":"Le French Club","videoId":"a1IRgZpHLyk","why":"درس متخصص في مقال DELF B1 — يشرح بنية المقطع الثلاثي وعباراته الجاهزة كما يريك شكل المطلوب في الامتحان حرفياً.","cat":"Writing","level":"B1","extra":true},{"title":"DELF B1 - 2024 | Exemple de PRODUCTION ÉCRITE + PDF","channel":"French School TV","videoId":"C1yMET-z0Jc","why":"نموذج إنتاج مكتوب كامل مصحح مع ملف PDF — رؤية نموذج حقيقي أفضل من مئة وصف: انظر كيف يُبنى المقال وعد كلماته.","cat":"Writing","level":"B1","extra":true},{"title":"DELF B1 Production Ecrite - 3 exemples de sujets -10 conseils pour réussir","channel":"Madame FLE - Cours de français","videoId":"wALYgtyzp8E","why":"ثلاثة مواضيع إمتحانية بعشرة نصائح عملية — تدريب واقعي ينقصك من الوهم إلى التصرف بثقة في قاعة الامتحان.","cat":"Writing","level":"B1","extra":true}],"supplements":[{"id":"a1IRgZpHLyk","title":"Production écrite DELF B1 | L'ESSAI","channel":"Le French Club","why":"درس متخصص في مقال DELF B1 — يشرح بنية المقطع الثلاثي وعباراته الجاهزة كما يريك شكل المطلوب في الامتحان حرفياً.","lang":"fr"},{"id":"C1yMET-z0Jc","title":"DELF B1 - 2024 | Exemple de PRODUCTION ÉCRITE + PDF","channel":"French School TV","why":"نموذج إنتاج مكتوب كامل مصحح مع ملف PDF — رؤية نموذج حقيقي أفضل من مئة وصف: انظر كيف يُبنى المقال وعد كلماته.","lang":"fr"},{"id":"wALYgtyzp8E","title":"DELF B1 Production Ecrite - 3 exemples de sujets -10 conseils pour réussir","channel":"Madame FLE - Cours de français","why":"ثلاثة مواضيع إمتحانية بعشرة نصائح عملية — تدريب واقعي ينقصك من الوهم إلى التصرف بثقة في قاعة الامتحان.","lang":"fr"}]},{"id":"B1-t6-l3","fr":"Lettres et emails formels","ar":"الرسائل الرسمية والشكاوى","objectives":["بنية الرسالة الرسمية: الترويسة، النص، الختام","صياغة طلب أو شكوى بلغة مهذبة مقنعة","التفرقة بين السجلات الرسمية وغير الرسمية"],"sections":[{"h":"هيكل الإيميل الرسمي","p":["الإيميل الرسمي له قالب ثابت: مُقدِّمات (Objet ← Madame/Monsieur) ← جسم واحد لكل غرض ← خاتمة بطلب صريح ← توقيع. البريد بلا objet يقرأه الموظف ببطء، وبدون بنية يصل لسلة مهملات داخلية. اللباقة الرسمية ليست زينة بل شرط في التسليم.","صيغ اللباقة هي مهمة الدرس: «Je vous prie de bien vouloir...» للطلب الرسمي، «Je vous serais reconnaissant(e) de...» للمنّة المهذّبة، «Dans l'attente de votre retour...» للانتظار. ثلاث صيغ تُغنيك عن «S'il vous plaît» المجردة التي تبدو فقيرة في الرسميات.","تابع الفيديو الأساسي بالشرح العربي: كيف تكتب إيميل رسمي — نموذج خطوة بخطوة: السياق ← الطلب ← التفاصيل ← الشكر. النموذج يبني رسالة من 8-10 أسطر — ما يكفي في B1، والمطول بلا تسلسل يُقرأ ضعفاً في التنظيم.","الترتيب: السياق أولاً («Suite à notre entretien du 3...»)، ثم الطلب، ثم التفاصيل المرقّمة إن تعددت، ثم الشكر والتوقيع. عكس الترتيب (الطلب بلا سياق) يجعل الموظف يسأل نفسه «لماذا؟» — والسؤال المؤجَّل يؤجّل ردّه.","المرفقات والتواريخ: «Vous trouverez en pièce jointe...»، «d'ici le 15 novembre»، «sous réserve de...» — ثلاث عبارات تقنية تُحفظ عليك أسئلة متابعة. تاريخ واحد مبهم («la semaine prochaine») يفتح باباً لسؤالين؛ تاريخ واضح يُغلق المراسلة.","الفحص الأخير: الاسم الصحيح للمُستقبل (Monsieur X لا Madame)، الـ objet مكتوب، التوقيع كامل، والرفق مرفق فعلاً. أخطاء الاسم في البريد الرسمي أخطر من أخطاء التذوّق — لأنها تقول «لم أتذكّرك» قبل أن تقول طلبك."],"video":{"id":"Sday1MV3yT8","title":"DELF B1 الإنتاج المكتوب / الرسالة الرسمية وغير الرسمية","channel":"Learn French with Stephanie","why":"الرسالة الرسمية وغير الرسمية في DELF B1: الترويسة والخاتمة والاختلافات — بالضبط نموذج الإيميل الرسمي.","lang":"ar","main":true,"dur":27},"sub":[{"h":"القالب الخمسي","p":["Objet — سطر واحد دقيق.","Madame/Monsieur — التحية.","جسم: سياق ← طلب ← تفاصيل.","خاتمة بطلب صريح.","Merci + توقيع كامل."]},{"h":"صيغ اللباقة الثلاث","p":["Je vous prie de bien vouloir...","Je vous serais reconnaissant de...","Dans l'attente de votre retour...","«S'il vous plaît» وحدها فقيرة هنا."]},{"h":"الترتيب والتواريخ","p":["السياق أولاً ثم الطلب.","التفاصيل مرقّمة عند التعدد.","موعد واضح لا «الأسبوع القادم».","المرفق مذكور وموجود فعلاً."]}]},{"h":"الرسالة الورقية: الترويسة الكاملة","p":["الرسالة الورقية تضيف ترويسة كاملة يميناً ويساراً: أعلى اليسار بيانات المرسل (nom, adresse, téléphone, e-mail)؛ أعلى اليمين بيانات المستلم؛ ثم المكان والتاريخ («Alger, le 12 mars 2025»)؛ ثم Objet في منتصف السطر؛ ثم «Madame, Monsieur،» والنص؛ ثم التوقيع أسفل اليمين. هيكل DELF B1 يطلب أحياناً رسالة بهذه الترويسة — تدرب على ترتيبها بالذاكرة.","لغة الشكوى الرسمية تعتمد على التهذيب الحاد مع الحزم: «Je me permets de vous écrire au sujet de...» (أتسمح لنفسي بالكتابة بخصوص...)؛ «J'ai constaté que...» (لاحظت أن...)؛ «Je vous saurais gré de bien vouloir...» (سأكون ممنوناً لو تكرمتم بـ...)؛ «Dans l'attente d'une réponse rapide, veuillez agréer...». الهدف: صوت هادئ مؤثر لا صوت غاضب.","«Je me permets de vous contacter...» افتتاحية مثالية لمن لا سياق سابق مع المرسل — تشرح لماذا أنت تكتب فعلاً وتوفر على الموظف سؤال «من أنت ولماذا؟»."],"video":null},{"h":"نماذج جاهزة: طلب وشكوى","p":["نموذج طلب: «Madame, Monsieur, Je me permets de vous écrire afin de demander des informations sur vos cours de français. En effet, je souhaiterais m'inscrire à une session en juillet. Pourriez-vous m'indiquer les tarifs et les horaires ? Je vous remercie d'avance et vous prie d'agréer, Madame, Monsieur, mes salutations distinguées. — Omar Bennani»","نموذج شكوى (منتج أو خدمة): «Je vous écris au sujet de la commande n°458, reçue le 3 mai. Malheureusement, l'article était endommagé. Je vous saurais gré de bien vouloir procéder à un remboursement ou à un échange. Dans l'attente de votre réponse, cordialement.». احفظ بنية: إشارة للمرجع → وصف المشكل → الطلب المحدد → ختام مهذب.","بعد الفيديو: اكتب إيميل طلب تدريب (stage) إلى شركة بـ 10 أسطر بالقالب الخماسي، ثم اقرأه بصوت عالٍ — كل جملة تُقرأ ببطء تحتاج إعادة صياغة؛ النبرة الطبيعية تكشف الجمل المتكلفة."],"video":null},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: أتقنت بنية الإيميل الرسمي (Objet ← Madame/Monsieur ← سياق ← طلب ← ختام) وصيغ اللباقة الثلاث وترتيب الترويسة الورقية وعبارات المرفقات والتواريخ. أعد مشاهدة الفيديو الرئيسي وركّز على ترتيب الأقسام الخمسة وعلى صيغة الطلب «Je vous prie de bien vouloir...».","جسر الدروس: من B1-t6-l2 (مقال الرأي وبناء الحجج) إلى B1-t6-l3 (الرسائل والإيميلات الرسمية والشكاوى)، ثم إلى B1-t7-l1 حيث تنتقل من الكتابة الفردية إلى إدارة الاجتماع وخذ الكلمة بثقة.","مهمة تطبيقية: اختر طلباً حقيقياً ثم سجّل صوتك أو اكتب في دقيقة إيميلاً رسمياً من أربعة أسطر مستعملاً 3 كلمات جديدة من الدرس، وقارنه بالنموذج في الفيديو الرئيسي وحدّد الفروق في اللباقة."]}],"examples":[{"fr":"Je vous écris au sujet de votre annonce.","ar":"أكتب لكم بخصوص إعلانكم."},{"fr":"Pourriez-vous m'indiquer les tarifs ?","ar":"هل يمكنكم إخباري بالأسعار؟"},{"fr":"Je vous saurais gré de bien vouloir répondre rapidement.","ar":"سأكون ممنوناً لو تكرمتم بالرد السريع."},{"fr":"Je vous prie d'agréer, Madame, Monsieur, mes salutations distinguées.","ar":"أرجو أن تقبلوا، سيدتي سنتي، احتراماتي المميزة."},{"fr":"Objet : demande de stage — été 2026","ar":"الموضوع: طلب تدريب — صيف 2026","note":"objet"},{"fr":"Je vous prie de bien vouloir examiner ma candidature.","ar":"أرجو التكرم بفحص طلبي.","note":"طلب رسمي"},{"fr":"Vous trouverez mon CV en pièce jointe.","ar":"ستجد سيرتي الذاتية في المرفق.","note":"مرفق"},{"fr":"Dans l'attente de votre retour, je vous prie d'agréer mes salutations distinguées.","ar":"في انتظار ردكم، أتشرّف بقبول فائق التقدير.","note":"خاتمة رسمية"}],"pron":[{"w":"agrée","ipa":"[a.ɡʁe]","approx":"أغريه"},{"w":"endommagé","ipa":"[ɑ̃.dɔ.ma.ʒe]","approx":"آن-دوما-جيه","note":"تالف"},{"w":"le remboursement","ipa":"[ʁɑ̃.buʁs.mɑ̃]","approx":"ران-بورسمان","note":"الاسترداد المالي"}],"vocab":[{"fr":"une lettre formelle","ar":"رسالة رسمية","pos":"expression","ipa":"[yn letʁʁ fɔʁ.mɛl]","exFr":"La lettre formelle exige une formule de politesse.","exAr":"الرسالة الرسمية تتطلب عبارة مجاملة."},{"fr":"une formule de politesse","ar":"عبارة مجاملة","pos":"expression","ipa":"[yn fɔʁ.myl də pɔ.li.tɛs]","exFr":"Choisissez la formule de politesse adaptée.","exAr":"اختر عبارة المجاملة المناسبة."},{"fr":"une réclamation","ar":"شكوى","pos":"nom","g":"f","pl":"des réclamations","ipa":"[ʁe.kla.ma.sjɔ̃]","exFr":"J'ai envoyé une réclamation au service.","exAr":"أرسلت شكوى للقسم."},{"fr":"procéder à","ar":"يقوم بـ (إجراء)","pos":"verbe","ipa":"[pʁɔ.se.de a]","exFr":"Veuillez procéder au remboursement.","exAr":"يرجى الإجراء بالاسترداد."},{"fr":"être endommagé","ar":"يكون تالفاً","pos":"expression","ipa":"[ɛtʁ ɑ̃.dɔ.ma.ʒe]","exFr":"Le colis était endommagé.","exAr":"كانت الشحنة تالفة."},{"fr":"cordialement","ar":"مع التقدير (ختام)","pos":"adv","ipa":"[kɔʁ.dja.lmɑ̃]","exFr":"Cordialement, Omar.","exAr":"مع التقدير، عمر."},{"fr":"l'objet (d'un mail)","ar":"سطر الموضوع","pos":"nom","g":"m","exFr":"Objet : demande de stage.","ipa":"[ɔbʒɛ]","exAr":"الموضوع: طلب تدريب."},{"fr":"à l'attention de","ar":"إلى انتباه","pos":"locution","exFr":"À l'attention du service RH.","ipa":"[a latɛ̃sjɔ̃ də]","exAr":"إلى انتباه قسم الموارد."},{"fr":"je vous prie de bien vouloir","ar":"أرجو التكرم بـ","pos":"locution","exFr":"Je vous prie de bien vouloir répondre.","ipa":"[ʒə vu pʁi də bjɛ̃ vluwaʁ]","exAr":"أرجو التكرم بالرد."},{"fr":"je vous serais reconnaissant(e)","ar":"سيكون لطفاً لديكم","pos":"locution","exFr":"Je vous serais reconnaissant de m'aider.","ipa":"[ʒə vu səʁɛ ʁəkɔnɛsɑ̃]","exAr":"سيكون لطفاً لديكم مساعدتي."},{"fr":"dans l'attente de votre retour","ar":"في انتظار رداً","pos":"locution","exFr":"Dans l'attente de votre retour.","ipa":"[dɑ̃ latɛt də vɔtʁ ʁətuʁ]","exAr":"في انتظار رداً لديكم."},{"fr":"en pièce jointe","ar":"بالمرفق","pos":"locution","exFr":"Vous trouverez le CV en pièce jointe.","ipa":"[ɑ̃ pjɛs ʒɔ̃t]","exAr":"ستجد السيرة في المرفق."},{"fr":"sous réserve de","ar":"مع احتمال/تحت تحفظ","pos":"locution","exFr":"Sous réserve de disponibilité.","ipa":"[su ʁəzɛʁv də]","exAr":"مع احتمال توفر."},{"fr":"prendre contact avec","ar":"يتواصل مع","pos":"locution","exFr":"Je me permets de vous contacter.","ipa":"[pʁɑ̃dʁ kɔ̃takt]","exAr":"يسمح لي بالتواصل معكم."},{"fr":"un formulaire","ar":"استمارة","pos":"nom","g":"m","exFr":"Remplir le formulaire.","ipa":"[fɔʁmylɛʁ]","exAr":"تعبئة الاستمارة."},{"fr":"le délai","ar":"المهلة/الأجل","pos":"nom","g":"m","exFr":"Dans un délai de dix jours.","ipa":"[dele]","exAr":"في مهلة عشرة أيام."},{"fr":"d'ici le...","ar":"بحلول (تاريخ)","pos":"locution","exFr":"Réponse d'ici le 15.","ipa":"[disi lə]","exAr":"رد بحلول الخامس عشر."}],"grammar":[{"tFr":"L'infinitif de politesse","tAr":"القاعدة: مصدر اللباقة","body":["الرسائل الرسمية تحذف الفاعل وتُقدّم المصادر: «Je vous prie de bien vouloir + inf.» و«Je vous serais reconnaissant de + inf.» — الفاعل أداة تواضع لا ضمير حي.","مع le conditionnel في «je vous serais...» (صيغة التمنّي المهذّب) — الخبري يبقى للمحاذير والتاريخ."],"ex":[{"fr":"Je vous prie de bien vouloir envoyer le dossier.","ar":"أرجو التكرم بإرسال الملف."},{"fr":"Je vous serais reconnaissant de me répondre vite.","ar":"سيكون لطفاً لديكم الرد بسرعة."}]}],"mistakes":[{"wrong":"بريد بلا objet","right":"سطر موضوع دقيق واحد","why":"البريد بلا موضوع يُرتَّب أخيراً ويقرأ آخر."},{"wrong":"طلب مباشرة بلا سياق","right":"السياق ثم الطلب","why":"الطلب بلا سياق يفتح سؤالاً مؤجَّلاً فيؤجَّل الرد."},{"wrong":"«S'il vous plaît» في رسمي","right":"«Je vous prie de bien vouloir...»","why":"الصيغة المجردة تبدو فقيرة في المراسلة الرسمية."},{"wrong":"اسم مُستقبل خاطئ أو توقيع ناقص","right":"مراجعة الاسم والتوقيع","why":"خطأ الاسم يقول «لم أتذكّرك» قبل أن يقول الطلب."}],"dialogues":[{"title":"مراجعة بريد رسمي","ctx":"موظفان يراجعان رسالة قبل الإرسال","lines":[{"who":"Farida","fr":"L'objet est clair ?","ar":"هل الموضوع واضح؟"},{"who":"Bruno","fr":"Oui, mais la demande arrive avant le contexte.","ar":"نعم، لكن الطلب يأتي قبل السياق."},{"who":"Farida","fr":"Je réorganise : contexte, puis demande.","ar":"أعيد التنظيم: السياق ثم الطلب."},{"who":"Bruno","fr":"Et le délai — «la semaine prochaine » ?","ar":"والأجل — «الأسبوع القادم»؟"},{"who":"Farida","fr":"Je mets «d'ici le 15 novembre».","ar":"أكتب «بحلول 15 نوفمبر»."},{"who":"Bruno","fr":"Parfait. Garde «Je vous prie de...» pour la fin.","ar":"ممتاز. احتفظي بـ «أرجو...» للخاتمة."}]}],"exercises":[{"t":"mcq","skill":"writing","q":"أفضل تحية لرسالة رسمية لا تعرف فيها المتلقي:","opts":["Salut !","Cher ami,","Madame, Monsieur,","Bonjour tout le monde"],"a":2,"why":"Madame, Monsieur هي الآمنة دائماً حين لا تعرف الاسم."},{"t":"mcq","skill":"writing","q":"في الرسالة الرسمية تطلب معلومات تقول:","opts":["Donne-moi les tarifs","Pourriez-vous m'indiquer les tarifs ?","C'est quoi le prix ?","Je veux le prix maintenant"],"a":1,"why":"Pourriez-vous m'indiquer = طلب مهذب بالشرطي — القياس الرسمي."},{"t":"fill","skill":"writing","q":"أكمل الختام الرسمي: «Je vous prie d'agréer, Madame, Monsieur, mes salutations ___».","fr":"Je vous prie d'agréer, Madame, Monsieur, mes salutations ___.","ans":"distinguées","alts":["distingue"],"why":"distinguées مؤنث جمع ل salutations — صيغة قياسية."},{"t":"order","skill":"writing","q":"رتّب بنية الشكوى: (1) وصف المشكل (2) الطلب المحدد (3) الإشارة للمرجع","words":["Je","vous","écris","au","sujet","de"],"ans":"Je vous écris au sujet de","why":"الترتيب: مرجع ← مشكل ← طلب ← ختام."},{"t":"listen","skill":"listening","q":"استمع واختر نوع الرسالة:","audio":"Je me permets de vous écrire afin de demander des informations sur vos cours","opts":["شكوى على منتج","طلب معلومات","دعوة لحفلة","رسالة ودية لأخ"],"a":1,"why":"demander des informations = طلب معلومات."},{"t":"writing","skill":"writing","q":"اكتب إيميلاً رسمياً (60+ كلمة) تطلب فيه معلومات عن دورة لغة: تحية + سبب الكتابة + سؤالان + ختام.","min":35,"kw":["madame","pourriez-vous","cordialement"],"sample":"Madame, Monsieur, Je vous écris afin de demander des informations sur vos cours d'été de français. Je souhaiterais m'inscrire au mois de juillet. Pourriez-vous m'indiquer les tarifs et les horaires ? Je vous remercie d'avance. Cordialement, Sami Alaoui.","why":"تحرير إيميل حقيقي بالقالب الخماسي يثبّت صيغ اللباقة في ذاكرتك الإجرائية أكثر من أي حفظ نظري."},{"t":"mcq","skill":"writing","q":"العنصر الذي لا يغيب عن البريد الرسمي:","opts":["Objet في سطر واحد","التوقيع بخط اليد","صورة شخصية","رقم الهاتف أولاً"],"a":0,"why":"بلا objet يقرأ الموظف البريد ببطء أو يتجاهله."},{"t":"translate","skill":"writing","q":"ترجم: ««ستجدون سيرتي الذاتية مرفقة.»","ans":"Vous trouverez mon CV en pièce jointe.","alts":["vous trouverez mon cv en piece jointe","Vous trouverez mon CV en piece jointe"],"why":"en pièce jointe = بالمرفق، قالب ثابت."}],"homework":"اكتب رسالتين رسميتين حقيقيتين تحتاجهما فعلاً (طلب معلومات عن دورة + شكوى خدمة) وفق الهياكل الدرسية.","sources":[{"title":"DELF B1 الإنتاج المكتوب / الرسالة الرسمية وغير الرسمية","channel":"Learn French with Stephanie","videoId":"Sday1MV3yT8","why":"الرسالة الرسمية وغير الرسمية في DELF B1: الترويسة والخاتمة والاختلافات — بالضبط نموذج الإيميل الرسمي.","cat":"Writing","level":"B1","main":true,"dur":27},{"title":"Comment écrire un email formel en français? - How to write a formal email in French?","channel":"Parlez-vous FRENCH : Cours de français","videoId":"eNdoHymfwu4","why":"درس شامل للإيميل الرسمي من التحية إلى الختام بالعبارات الجاهزة — أقرب ما يصادفه متعلم B1 في الواقع المهني والإداري.","cat":"Writing","level":"B1","extra":true},{"title":"Comment écrire une LETTRE FORMELLE en français","channel":"Regard sur le français","videoId":"UTj_ovoHMfs","why":"درس متخصص في الرسالة الورقية الرسمية بترويستها الكاملة — يغطي الفارق بين الإيميل والرسالة الورقية التي تطلبها الإدارة والامتحانات.","cat":"Writing","level":"B1","extra":true},{"title":"Ecrire une lettre officielle en français (rédaction 7/7)","channel":"Bien écrire - Katia Nugnes","videoId":"6xab_ZW-xLw","why":"سلسلة الكتابة الممتازة — درس عملي على الرسالة الإدارية: نماذج وعبارة بعبارة، يصلح للشكاوى والطلبات الإدارية الحقيقية.","cat":"Writing","level":"B1","extra":true}],"supplements":[{"id":"eNdoHymfwu4","title":"Comment écrire un email formel en français? - How to write a formal email in French?","channel":"Parlez-vous FRENCH : Cours de français","why":"درس شامل للإيميل الرسمي من التحية إلى الختام بالعبارات الجاهزة — أقرب ما يصادفه متعلم B1 في الواقع المهني والإداري.","lang":"fr"},{"id":"UTj_ovoHMfs","title":"Comment écrire une LETTRE FORMELLE en français","channel":"Regard sur le français","why":"درس متخصص في الرسالة الورقية الرسمية بترويستها الكاملة — يغطي الفارق بين الإيميل والرسالة الورقية التي تطلبها الإدارة والامتحانات.","lang":"fr"},{"id":"6xab_ZW-xLw","title":"Ecrire une lettre officielle en français (rédaction 7/7)","channel":"Bien écrire - Katia Nugnes","why":"سلسلة الكتابة الممتازة — درس عملي على الرسالة الإدارية: نماذج وعبارة بعبارة، يصلح للشكاوى والطلبات الإدارية الحقيقية.","lang":"fr"}]}]},{"id":"b1-t7","slug":"professionnel","icon":"💼","color":"#2563EB","fr":"Français professionnel","ar":"مسار الفرنسية المهنية","desc":"بوابة العمل بالفرنسية: الاجتماعات والتقارير، السيرة الذاتية ومقابلة التوظيف، والهاتف في بيئة العمل.","lessons":[{"id":"B1-t7-l1","fr":"Une réunion efficace","ar":"اجتماع فعال","objectives":["إدارة أدوار الاجتماع: افتتاح، انتقال، ختام","الاستفسار والاعتراض المهني بلغة مهذبة","متابعة ما بعد الاجتماع: المحضر والمهام"],"sections":[{"h":"افتتاح الاجتماع وانتقاله","p":["الاجتماع الفرنسي يبدأ باللباقة قبل المحتوى: تحيات قصيرة («Bonjour à tous, merci d'être là»)، ثم التذكير بالموضوع والهدف والأجل («On se voit pour valider... d'ici vendredi»)، ثم الأجندة. اجتماع بلا هدف معلن يُهجَّر في الدقيقة الثامنة — والهدف في الدقيقة الأولى يوفّر الأربعين.","أدوار الاجتماع: الحاضر يقدّم («Je vais revenir sur...»)، الرئيس يوجّه («On va commencer par...»)، الساكت يحتاج إذناً («Puis-je ajouter un point ?»). لاحظ أن الإضافة تُطلب حتى لو كنت أنت صاحب الاجتماع — أخذ الدور بلا طلب يُقرأ اقتحاماً في البروتوكول الفرنسي.","تابع الفيديو الأساسي بالشرح العربي: عبارات الاجتماعات — الأدوات الجاهزة لكل مرحلة: الافتتاح، النقاش، الخلاف اللطيف، والختام. العبارات الجاهزة تُغنيك عن الترجمة الذهنية أثناء الاجتماع — وهي لحظة لا يُسمح فيها بالبحث.","الخلاف اللطيف: «Je ne suis pas sûr que ce soit la bonne approche» + سبب + بديل. ثلاث لبنات تُمنعك من «Tu as tort» الممنوعة عملياً. الخلاف في الفرنسية يبقى في الفكرة ولا يصعد للشخص — والنبرة الصاعدة جزء من المعنى.","خذ الدور (prendre la parole): «Si je peux me permettre...», «Petite précision...», «Justement...» — ثلاث عبارات تأخذ الدور بنجاح. أطولها لباقة وأقصرها للعجالة: اختر حسب الإيقاع، ولكن لا تدخل أبداً بـ «Non, c'est faux» — تدخل مدمَّر.","الختام بالخلاصات والأجل: ثلاث خلاصات مرقّمة، مالك لكل مهمة («Karim s'en charge»)، وموعد متابعة واحد. اجتماع بلا خلاصات مرقّمة = اجتماع موعد مراجعته مجهول — وهذه أكثر أخطاء بيئة العمل الفرنسية."],"video":{"id":"wIj9z5UR8KA","title":"محادثة اجتماع في العمل Réunion au travail - المحادثة باللغة الفرنسية","channel":"فرنشاوي Frenchawy","why":"محادثة اجتماع عمل حقيقية بالفرنسية — تسمع فتح الاجتماع وترتيب الكلمة كما يحدث في مكان العمل.","lang":"ar","main":true,"dur":4},"sub":[{"h":"افتتاح هادف","p":["Bonjour + شكر للحضور.","الهدف + الأجل في أول دقيقة.","الأجندة المعلنة.","هدف بلا معلن = هروب."]},{"h":"الأدوار والدور المأخوذ","p":["Je vais revenir sur... (عرض).","On va commencer par... (توجيه).","Puis-je ajouter ? (أخذ الدور).","أخذ بلا طلب = اقتحام."]},{"h":"الخلاف والختام","p":["تحفّظ + سبب + بديل.","نبرة صاعدة، للشخص لا الفكرة.","3 خلاصات مرقّمة.","مالك لكل مهمة + أجل واحد."]}]},{"h":"أخذ الكلمة بثقة","p":["في الثقافة المهنية الفرنسية، الصمت في الاجتماع يُقرأ موافقة أو غياباً. المطلوب: موقف واحد واضح على الأقل. خطة الكلام في 30 ثانية: رأي واحد («À mon sens, il faut prioriser le client A»)، سبب واحد («Parce que c'est notre plus gros revenu»)، وسؤال للفريق («Qu'en pensez-vous ?»). هذا النمط الصغير يبني حضورك اجتماعاً بعد اجتماع.","للاعتراض مهنياً: «Je comprends l'argument, mais j'ai un doute sur les chiffres» (أفهم الحجة، لكن عندي شك في الأرقام) — اعترف ثم خالِف على المضمون لا على الشخص. ولطلب وقت: «Je reviendrai vers vous d'ici vendredi» (سأعود إليكم قبل الجمعة) — وعد محدد أفضل من «je vais voir» الضبابية.","«On se met d'accord sur...» عبارة الإجماع الجاهزة — تُنقل النقاش من الطرح للقرار. في الاجتماع الفرنسي القرار يُصاغ كجملة واحدة يوقّع عليها الجميع، لا كمناقشة مفتوحة تنتهي بـ «on verra»."],"video":null},{"h":"معجم الاجتماعات: 10 أفعال تفتح كل الأبواب","p":["الأفعال العشرة الأهم: fixer (يحدد — fixer une date)، décaler (يؤجل — décaler la réunion)، prioriser (يرتّب أولويات)، valider (يعتمد)، pointer (يشير إلى — pointer un problème)، avancer (يتقدم — avancer sur le projet)، réagir (يتفاعل)، assumer (يتحمل)، coordonner (ينسّق)، finaliser (يُتم). كلها حاضرة في كل اجتماع فرنسي.","تدريب فعّال: اكتب ملخص الاجتماع الذي حضرته (أو شاهدت) بفرنسية في 5 جمل مستخدماً 5 من هذه الأفعال. المحضر (le compte-rendu) من 5 جمل هو أيضاً أفضل ما ترسله لمديرك: «La réunion a validé le budget. Pierre va finaliser le dossier d'ici vendredi...»","تمرين المحاضر: سجّل نفسك تفتتح اجتماعاً وقّتاً — إن تجاوزت 45 ثانية للهدف فاختصر. الافتتاح الجيد يُقاس بالثواني لا بالعبارات: هدف + أجل = 15 ثانية."],"video":null},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: أتقنت أدوار الاجتماع (افتتاح بهدف وأجل في 15 ثانية، أخذ الدور، خلاف لطيف، ختام بخلاصات مرقّمة) ومعجم الأفعال العشرة (fixer, décaler, valider, finaliser...). أعد مشاهدة الفيديو الرئيسي وركّز على صيغة الافتتاح في أول ثانية عشرة وعلى عبارة أخذ الدور «Puis-je ajouter un point ?».","جسر الدروس: من B1-t6-l3 (الرسالة الرسمية وصيغ اللباقة الكتابية) إلى B1-t7-l1 (إدارة اجتماع فعال وخذ الكلمة)، ثم إلى B1-t7-l2 حيث تنتقل من جماعي الفريق إلى مقابلة عمل فردية تعرض فيها مسارك.","مهمة تطبيقية: افتتح اجتماعاً تمثيلياً ثم سجّل صوتك أو اكتب في دقيقة جلسة كاملة (افتتاح ← نقطة ← خلاصة) مستعملاً 3 كلمات جديدة من الدرس، وقارن افتتاحك بافتتاح الفيديو الرئيسي وعدّ ثوانيك."]}],"examples":[{"fr":"Le point du jour : le budget.","ar":"موضوع اليوم: الميزانية."},{"fr":"On peut passer au point suivant ?","ar":"ننتقل للموضوع التالي؟"},{"fr":"Je vous envoie le compte-rendu ce soir.","ar":"سأرسل لكم المحضر الليلة."},{"fr":"Nous respectons le délai.","ar":"نحترم الموعد النهائي."},{"fr":"Merci d'être là. Objectif : valider le budget avant vendredi.","ar":"شكراً لحضوركم. الهدف: اعتماد الميزانية قبل الجمعة.","note":"هدف + أجل"},{"fr":"Puis-je ajouter un point, une seconde ?","ar":"هل لي أن أضيف نقطة، لثانية؟","note":"أخذ الدور"},{"fr":"Je ne suis pas sûr que ce soit la meilleure voie — voici pourquoi.","ar":"لست متأكداً أنها أفضل طريق — وإليك السبب.","note":"خلاف لطيف"},{"fr":"Trois décisions : une, deux, trois. Karim s'en charge.","ar":"ثلاثة قرارات: واحد، اثنان، ثلاثة. كريم مسؤول عنها.","note":"خلاصات مرقّمة"}],"pron":[{"w":"le compte-rendu","ipa":"[kɔ̃t.ʁɑ̃.dy]","approx":"كونت-ران-دو","note":"محضر الاجتماع"},{"w":"le délai","ipa":"[de.lɛ]","approx":"ده-ليه","note":"الموعد النهائي"},{"w":"valider","ipa":"[va.li.de]","approx":"فاليديه"}],"vocab":[{"fr":"une réunion","ar":"اجتماع","pos":"nom","g":"f","pl":"des réunions","ipa":"[ʁe.y.njɔ̃]","exFr":"La réunion commence à 9h.","exAr":"الاجتماع يبدأ 9 صباحاً."},{"fr":"le compte-rendu","ar":"محضر / تقرير اجتماع","pos":"nom","g":"m","pl":"les comptes-rendus","ipa":"[kɔ̃t.ʁɑ̃.dy]","exFr":"J'envoie le compte-rendu ce soir.","exAr":"أرسل المحضر الليلة."},{"fr":"la décision","ar":"القرار","pos":"nom","g":"f","pl":"les décisions","ipa":"[de.si.zjɔ̃]","exFr":"La réunion a pris trois décisions.","exAr":"اتّخذ الاجتماع ثلاثة قرارات."},{"fr":"une proposition","ar":"اقتراح","pos":"nom","g":"f","pl":"des propositions","ipa":"[pʁɔ.po.zi.sjɔ̃]","exFr":"J'ai une proposition à faire.","exAr":"لديّ اقتراح أطرحه."},{"fr":"valider","ar":"يعتمد / يصادق","pos":"verbe","ipa":"[va.li.de]","exFr":"Le comité a validé le budget.","exAr":"اعتمدت اللجنة الميزانية."},{"fr":"décaler","ar":"يؤجل / يزيّل موعداً","pos":"verbe","ipa":"[de.ka.le]","exFr":"On décale la réunion à jeudi ?","exAr":"نؤجل الاجتماع للخميس؟"},{"fr":"l'ordre du jour","ar":"جدول الأعمال","pos":"nom","g":"m","exFr":"Passer à l'ordre du jour.","ipa":"[ɔʁ də ʒuʁ]","exAr":"الانتقال لجدول الأعمال."},{"fr":"prendre la parole","ar":"يتكلم/يأخذ الكلمة","pos":"locution","exFr":"Prendre la parole après vous.","ipa":"[pʁɑ̃dʁ la paʁɔl]","exAr":"أخذ الكلمة بعدكم."},{"fr":"revenir sur","ar":"يعود إلى نقطة","pos":"locution","exFr":"Je reviens sur le budget.","ipa":"[ʁəvniʁ syʁ]","exAr":"أعود إلى الميزانية."},{"fr":"un point d'accord","ar":"نقطة اتفاق","pos":"nom","exFr":"On a un point d'accord.","ipa":"[pwɛ̃ dakɔʁ]","exAr":"لدينا نقطة اتفاق."},{"fr":"le compte rendu","ar":"محضر الاجتماع","pos":"nom","g":"m","exFr":"Envoyer le compte rendu.","ipa":"[kɔ̃t ʁɑ̃dy]","exAr":"إرسال المحضر."},{"fr":"une feuille de route","ar":"خارطة طريق","pos":"nom","exFr":"Établir une feuille de route.","ipa":"[fœ də rut]","exAr":"إعداد خارطة طريق."},{"fr":"difficile mais faisable","ar":"صعب لكن ممكن","pos":"adj","exFr":"C'est difficile mais faisable.","ipa":"[difisil mɛ fɛzabl]","exAr":"صعب لكن ممكن."},{"fr":"s'engager sur","ar":"يلتزم بـ","pos":"locution","exFr":"S'engager sur un délai.","ipa":"[sɑ̃ɡaʒe syʁ]","exAr":"الالتزام بأجل."},{"fr":"le blocage","ar":"العائق","pos":"nom","g":"m","exFr":"Un blocage technique.","ipa":"[blɔkaʒ]","exAr":"عائق تقني."},{"fr":"alléger","ar":"يخفف","pos":"verbe","g":"1er","exFr":"Alléger la charge.","ipa":"[aleʒe]","exAr":"تخفيف العبء."},{"fr":"trancher","ar":"يُحسم","pos":"verbe","g":"2e","exFr":"Il faut trancher maintenant.","ipa":"[tʁɑ̃ʃe]","exAr":"يجب الحسم الآن."}],"grammar":[{"tFr":"Le subjonctif de la position ferme","tAr":"القاعدة: المنصوب في الموقف الحازم","body":["الموقف الحازم يعيش في المنصوب: «je veux que...», «il faut que...», «je ne pense pas que...» — وفي الاجتماع هذه الجمل هي القرارات.","مع le conditionnel في الاقتراح («on pourrait...»): الاقتراح بالمشروط أخف من الأمر المباشر ويُقبل أكثر في بروتوكول B1."],"ex":[{"fr":"Je veux que chacun ait une tâche.","ar":"أريد أن يكون لكل واحد مهمة."},{"fr":"On pourrait commencer par les chiffres.","ar":"يمكننا أن نبدأ بالأرقام."}]}],"mistakes":[{"wrong":"اجتماع بلا هدف معلن","right":"هدف + أجل في أول 15 ثانية","why":"الهدف المؤجَّل يجعل الحضور يُسقطك من الأجندة."},{"wrong":"«Tu as tort» مباشرة","right":"تحفّظ + سبب + بديل","why":"الرفض المباشر يُقيَّم كعداءية شخصية في البروتوكول."},{"wrong":"أخذ الدور بلا طلب","right":"«Puis-je ajouter...»","why":"الاقتحام يُعطّل الإيقاع ويُقرأ نقص تربية."},{"wrong":"ختام بلا خلاصات مرقّمة","right":"3 خلاصات + مالك + أجل","why":"اجتماع بلا مالك مهام = اجتماع بلا نتائج."}],"dialogues":[{"title":"ختام اجتماع","ctx":"مديرة تُغلق اجتماع ميزانية","lines":[{"who":"Directrice","fr":"On se met d'accord sur trois points.","ar":"نتفق على ثلاث نقاط."},{"who":"Yanis","fr":"D'abord : valider le budget.","ar":"أولاً: اعتماد الميزانية."},{"who":"Directrice","fr":"Deux : réduire les délais. Karim s'en charge ?","ar":"ثانياً: تقليص الآجال. كريم مسؤول؟"},{"who":"Karim","fr":"Oui, je m'engage sur deux semaines.","ar":"نعم، ألتزم بأسبوعين."},{"who":"Directrice","fr":"Trois : envoyer le compte rendu demain.","ar":"ثالثاً: إرسال المحضر غداً."},{"who":"Yanis","fr":"Noté. Merci à tous — on se revoit lundi.","ar":"سُجّل. شكراً للجميع — نلتقي الاثنين."}]}],"exercises":[{"t":"mcq","skill":"speaking","q":"لفتح الاجتماع وموضوعه اليوم تقول:","opts":["Le point du jour : le budget","C'est parti pour manger","On ferme la réunion","Je suis fatigué du budget"],"a":0,"why":"Le point du jour = موضوع اليوم — عبارة افتتاح قياسية."},{"t":"mcq","skill":"speaking","q":"لتأجيل الاجتماع أسبوعاً تقول:","opts":["On décale la réunion à jeudi ?","On mange la réunion","La réunion est cassée","Je jette la réunion"],"a":0,"why":"décaler هو الفعل المهني للتأجيل المحدد."},{"t":"fill","skill":"vocabulary","q":"أكمل: «Nous respectons le ___ (الموعد النهائي).»","fr":"Nous respectons le ___.","ans":"délai","alts":["délai"],"why":"le délai = الموعد النهائي/المهلة."},{"t":"order","skill":"speaking","q":"رتّب أدوار الاجتماع: (1) العرض والنقاش (2) الافتتاح والموضوع (3) الخلاصة والمحضر","words":["Bonjour","à","tous,"],"ans":"Bonjour à tous,","why":"التسلسل: افتتاح ← نقاش ← خلاصة ومحضر."},{"t":"listen","skill":"listening","q":"استمع واختر ما اتخذته اللجنة:","audio":"Le comité a validé le budget du projet","opts":["رفضت اللجنة الميزانية","اعتمدت اللجنة ميزانية المشروع","أجلت اللجنة القرار","اللجنة طلبت تعديلاً"],"a":1,"why":"valider = تعتمد/تصادق."},{"t":"writing","skill":"writing","q":"اكتب محضراً مصغراً (4 جمل) لاجتماع تخيلي: الموضوع، القرار، المسؤول، الموعد.","min":18,"kw":["réunion","a validé","vendredi"],"sample":"La réunion a porté sur la campagne publicitaire. L'équipe a validé le budget de 5000 euros. Nadia va finaliser le visuel. Le lancement est prévu vendredi prochain.","why":"كتابة المحضر تُدرب على استخراج القرارات والمسؤوليات من كلام متدفّع — وهي المهارة التي يُقاس بها أثر اجتماعك."},{"t":"mcq","skill":"speaking","q":"الافتتاح الجيد لاجتماع B1:","opts":["هدف + أجل في أول 15 ثانية","تحية طويلة عن العطلة","النقاش مباشرة بلا هدف","الاعتذار عن الاجتماع"],"a":0,"why":"الهدف المؤجَّل يمنع الهروب من الأجندة."},{"t":"fill","skill":"speaking","q":"أكمل: «Puis-je ___ un point ?» (أضيف)","fr":"Puis-je ___ un point ?","ans":"ajouter","alts":["Ajouter"],"why":"Puis-je + infinitif لأخذ الدور."}],"homework":"شاهد مقطعاً لاجتماع عمل بالفرنسية واكتب محضراً من 5 جمل: الموضوع، القرار، المسؤول، الموعد.","sources":[{"title":"محادثة اجتماع في العمل Réunion au travail - المحادثة باللغة الفرنسية","channel":"فرنشاوي Frenchawy","videoId":"wIj9z5UR8KA","why":"محادثة اجتماع عمل حقيقية بالفرنسية — تسمع فتح الاجتماع وترتيب الكلمة كما يحدث في مكان العمل.","cat":"Professional","level":"B1","main":true,"dur":4},{"title":"Cours de français (B1 et +) : interagir en réunion de travail","channel":"ifMaroc","videoId":"5VUz-y5neso","why":"درس مخصص للتفاعل داخل اجتماع العمل بمستوى B1+ — عبارات التدخل والاعتراض والتساؤل كما تُستخدم فعلاً في الشركات.","cat":"Professional","level":"B1","extra":true},{"title":"Prendre la parole en réunion | Développer son éloquence, avec Bertrand Périer","channel":"Welcome to the Jungle Media","videoId":"ciPxDfg4mxk","why":"درس متخصص في أخذ الكلمة داخل الاجتماعات من متحدث محترف — مهارات الإلقاء والثقة التي تفصل بين الحضور الصامت والمؤثر.","cat":"Professional","level":"B1","extra":true},{"title":"Parlez un français professionnel : 10 verbes essentiels à utiliser en entreprise","channel":"Parlez-vous FRENCH : Cours de français","videoId":"OWcvSiqHvSI","why":"عشرة أفعال جوهرية للغة الشركة بالأمثلة — المفردات الفعّالة التي ترفع كلامك المهني من المرتجل إلى المصقول فوراً.","cat":"Professional","level":"B1","extra":true}],"supplements":[{"id":"5VUz-y5neso","title":"Cours de français (B1 et +) : interagir en réunion de travail","channel":"ifMaroc","why":"درس مخصص للتفاعل داخل اجتماع العمل بمستوى B1+ — عبارات التدخل والاعتراض والتساؤل كما تُستخدم فعلاً في الشركات.","lang":"fr"},{"id":"ciPxDfg4mxk","title":"Prendre la parole en réunion | Développer son éloquence, avec Bertrand Périer","channel":"Welcome to the Jungle Media","why":"درس متخصص في أخذ الكلمة داخل الاجتماعات من متحدث محترف — مهارات الإلقاء والثقة التي تفصل بين الحضور الصامت والمؤثر.","lang":"fr"},{"id":"OWcvSiqHvSI","title":"Parlez un français professionnel : 10 verbes essentiels à utiliser en entreprise","channel":"Parlez-vous FRENCH : Cours de français","why":"عشرة أفعال جوهرية للغة الشركة بالأمثلة — المفردات الفعّالة التي ترفع كلامك المهني من المرتجل إلى المصقول فوراً.","lang":"fr"}]},{"id":"B1-t7-l2","fr":"Le CV et l'entretien d'embauche","ar":"السيرة الذاتية ومقابلة التوظيف","objectives":["التحدث عن مسارك الدراسي والمهني بالفرنسية","الإجابة عن أسئلة المقابلة الأشهر","تقديم نقاط قوتك دون مبالغة"],"sections":[{"h":"عرف بنفسك مهنياً","p":["مقابلة العمل الفرنسية تسير بنموذج: ترحيب ← «Parlez-moi de vous» ← أسئلة تقنية ← أسئلة سلوكية ← أسئلتك أنت ← خاتمة. النموذج ثابت لدرجة أن الاستعداد له يضمن النصف الأول — والنصف الثاني (أسئلتك أنت) هو حيث تفوز.","«Parlez-moi de vous» ليست دعوة لسيرة حياتك كاملة: 90 ثانية، ثلاث لبنات — من أنت الآن، أهم إنجازين، ولماذا هذه الوظيفة. ثلاث لبنات مرقّمة تُحفظ عليك خمس دقائق ينام فيها المُقابِل، وأول 90 ثانية تصنع 70% من الانطباع.","تابع الفيديو الأساسي بالشرح العربي: كيف ترتب نفسك في المقابلة — بناء الذات المُقنعة: ماضٍ ← الآن ← مستقبل، وثلاثية نقاط صلبة (chiffres, projets, motivation). الأرقام تُثبت والمشاريع تُحدّد والدافع يُحرّك — الثلاثي هو جواب كل «pourquoi».","الأسئلة السلوكية بصيغتها الفرنسية الشهيرة: «Décrivez-moi une situation où...», «Comment gérez-vous un conflit ?», «Votre plus grande qualité/défaut ?». جواب النموذج: موقف واحد + فعل (J'ai fait...) + نتيجة بالأرقام — STAR مختصر في ثلاثة أسطر.","نقطة الضعف: «Je suis trop perfectionniste» نسخة A2 تُسمع 100 مرة يومياً. البديل B1: ضعف حقيقي صغير + ما تفعله لعلاجه («J'ai tendance à tout vérifier — maintenant je fixe un délai de contrôle»). الاعتراف العلاجي يقلب الضعف إلى نضج.","أسئلتك أنت تُقاس عليك: اسأل عن التحدي الأول («Quel est le premier défi de ce poste ؟»)، عن الفريق، وعن الأجل — ثلاثة أسئلة تُظهر أنك تفكّر في الدور لا في الوظيفة. «Combien payez-vous ؟» في السؤال الأول = أخطاء قاتلة في المزاج الفرنسي."],"video":{"id":"cxilB-QXmbw","title":"مقابلة عمل باللغة الفرنسية (اسئلة، اجوبة و نصائح) entretien d'embauche","channel":"apprendre le français . تعلم الفرنسية","why":"أسئلة وأجوبة ونصائح مقابلة العمل — يغطي تعريف الذات والأسئلة المفصلية وعبارات التأثير.","lang":"ar","main":true,"dur":6},"sub":[{"h":"النموذج الثابت","p":["ترحيب ← Parlez-moi de vous.","أسئلة تقنية ← سلوكية.","أسئلتك أنت ← خاتمة.","الاستعداد للنموذج يضمن النصف."]},{"h":"الـ 90 ثانية","p":["3 لبنات: الآن ← إنجازان ← الدافع.","أرقام لا صفات.","70% من الانطباع في أول 90 ثانية.","خمس دقائق سرد = نوم."]},{"h":"STAR + أسئلتك","p":["موقف + فعل + نتيجة بالأرقام.","نقطة ضعف علاجية لا نموذجية.","3 أسئلة: التحدي ← الفريق ← الأجل.","السعر ليس سؤالك الأول."]}]},{"h":"أسئلة المقابلة المفصلية","p":["الأسئلة الأربعة الحاسمة: 1) «Parlez-moi de vous» — سرد مضغوط كما تعلمنا. 2) «Quels sont vos points forts / points faibles ?» — قوتك: مهارة محددة بمثال؛ ضعفك: ضعف حقيقي غير مميت + ما تفعله لتجاوزه («Je suis parfois trop perfectionniste, donc j'apprends à fixer des limites de temps»). 3) «Pourquoi voulez-vous travailler ici ?» — معلومة محددة عن الشركة. 4) «Où vous voyez-vous dans 5 ans ?» — طموح واقعي مرتبط بالمسار.","قاعدة الجواب الذهبي: سؤال ← جواب ← مثال. «Je suis organisé. Par exemple, la dernière année, j'ai coordonné trois projets en parallèle sans délai.» المثال هو ما يفرّق الجواب العام عن الجواب المقنع.","اللباقة المُقابَلة: «Enchanté» مع نظرة، «Merci pour votre temps» في الختام، ومصافحة قصيرة. النهاية المنتظمة (شكر + خطوة تالية متوقعة) تُقرأ كثقة — والاستعجال بالخروج كقلق."],"video":null},{"h":"عبارات تحسم المقابلة","p":["عبارات تفتح أبواباً: «Merci de me recevoir aujourd'hui» (شكراً لاستقبالي اليوم)؛ «Je suis motivé(e) par ce poste parce que...» (أنا متحمس لهذا المنصب لأن...)؛ «Je suis prêt(e) à m'investir pleinement» (مستعد للاستثمار الكامل). وفي نهاية المقابلة اسأل سؤالاً حقيقياً: «Quelles seraient les premières missions attendues ?» — السؤال المدروس يترك أثراً أقوى من أجوبة كثيرة.","إن سُئلت عن راتب فلا تتهرب: «D'après mon expérience, je pense qu'un salaire entre X et Y serait adapté au poste» (حسب خبرتي، راتب بين X وY يناسب المنصب). وإن سُئلت سؤالاً لا تعرف جوابه: «C'est une bonne question, je n'ai pas encore eu l'occasion de... mais voici comment je m'y prendrais...» — الصدق المنظم أجمل من التخمين.","تمرين المرآة: اكتب جواب «Parlez-moi de vous» في 90 ثانية (حوالي 200 كلمة)، وقّتها بالإعلانات، ثم اقرأه سبع مرات بصوت عالٍ حتى يخرج دون مذكرة. الحفظ الحرفي ممنوع — الحفظ البنائي وحده يسمح بال spontanéité."],"video":null},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: أتقنت نموذج المقابلة، وجواب «Parlez-moi de vous» في 90 ثانية بثلاث لبنات (الآن ← إنجازان بالأرقام ← الدافع)، وقاعدة (سؤال ← جواب ← مثال)، ونقطة الضعف العلاجية. أعد مشاهدة الفيديو الرئيسي وركّز على الأرقام التي يستعملها المرشّح (chiffres) وعلى نبرته عند الاعتراض اللطيف.","جسر الدروس: من B1-t7-l1 (اجتماع فعال وأخذ الكلمة) إلى B1-t7-l2 (السيرة الذاتية ومقابلة التوظيف)، ثم إلى B1-t7-l3 حيث تنتقل من المقابلة الحضورية إلى المكالمة المهنية بلا لغة جسد.","مهمة تطبيقية: سجّل صوتك أو اكتب في دقيقة جواب «Parlez-moi de vous» من ثلاث لبنات مستعملاً 3 كلمات جديدة من الدرس، ثم قارن نبرتك وإيقاعك بالفيديو الرئيسي وسجّل الفروق."]}],"examples":[{"fr":"J'ai obtenu une licence en marketing.","ar":"حصلت على إجازة في التسويق."},{"fr":"J'ai travaillé deux ans dans une agence de voyage.","ar":"عملت سنتين في وكالة سفر."},{"fr":"Je suis motivé par ce poste.","ar":"أنا متحمس لهذا المنصب."},{"fr":"Quelles seraient les premières missions attendues ?","ar":"ما هي المهام الأولى المنتظرة؟"},{"fr":"Actuellement, je suis chef d'équipe — j'ai réduit les délais de 20 %.","ar":"حالياً قائد فريق — قلّصت الآجال بنسبة 20%.","note":"90 ثانية"},{"fr":"Dans une situation tendue, j'ai d'abord écouté, puis proposé.","ar":"في موقف متوتر، استمعت أولاً ثم اقترحت.","note":"STAR"},{"fr":"Mon défaut : je vérifie trop — j'ai fixé un délai de contrôle.","ar":"نقصي: أتحقق كثيراً — ثبّتت مهلة تحقق.","note":"ضعف علاجي"},{"fr":"Quel est le premier défi de ce poste ?","ar":"ما أول تحدٍّ لهذا المنصب؟","note":"سؤالك"}],"pron":[{"w":"un stage","ipa":"[staʒ]","approx":"ستاج","note":"تدريب (وليس مسرح)"},{"w":"motivé","ipa":"[mo.ti.ve]","approx":"موتيفيه"},{"w":"les compétences","ipa":"[le kɔ̃.pe.tɑ̃s]","approx":"لي-كونبيتانس"}],"vocab":[{"fr":"un entretien d'embauche","ar":"مقابلة توظيف","pos":"nom","g":"m","pl":"des entretiens d'embauche","ipa":"[ɑ̃.tʁə.tjɛ̃ dɑ̃.boʃ]","exFr":"J'ai un entretien d'embauche demain.","exAr":"عندي مقابلة توظيف غداً."},{"fr":"un parcours","ar":"مسار (مهني/دراسي)","pos":"nom","g":"m","pl":"des parcours","ipa":"[paʁ.kuʁ]","exFr":"Votre parcours est intéressant.","exAr":"مسارك مثير للاهتمام."},{"fr":"un stage","ar":"تدريب مهني","pos":"nom","g":"m","pl":"des stages","ipa":"[staʒ]","exFr":"J'ai fait un stage de six mois.","exAr":"أدّيت تدريباً من ستة أشهر."},{"fr":"les compétences","ar":"المهارات","pos":"nom","g":"f","ipa":"[le kɔ̃.pe.tɑ̃s]","exFr":"Mes compétences correspondent au poste.","exAr":"مهاراتي تناسب المنصب."},{"fr":"être motivé","ar":"يكون متحمساً","pos":"expression","ipa":"[ɛtʁ mo.ti.ve]","exFr":"Je suis très motivé par ce poste.","exAr":"أنا متحمس جداً لهذا المنصب."},{"fr":"s'investir","ar":"يستثمر جهده / يتفرغ","pos":"verbe","ipa":"[sɛ̃.vɛs.tiʁ]","exFr":"Je suis prêt à m'investir pleinement.","exAr":"أنا مستعد للاستثمار الكامل."},{"fr":"Parlez-moi de vous","ar":"تحدثني عن نفسك","pos":"locution","exFr":"«Parlez-moi de vous » — la question d'ouverture.","ipa":"[paʁle mwɑ də vu]","exAr":"«تحدث عن نفسك» — سؤال الافتتاح."},{"fr":"une qualité / un défaut","ar":"ميزة / نقيصة","pos":"nom","exFr":"Qualité : l'organisation.","ipa":"[kalite]","exAr":"ميزة: التنظيم."},{"fr":"un défi","ar":"تحدٍّ","pos":"nom","g":"m","exFr":"Le premier défi du poste.","ipa":"[defi]","exAr":"أول تحدٍّ للمنصب."},{"fr":"s'engager dans","ar":"يشارك في/يلتزم بـ","pos":"locution","exFr":"S'engager dans un projet.","ipa":"[sɑ̃ɡaʒe]","exAr":"الالتزام بمشروع."},{"fr":"mesurer","ar":"يقيس","pos":"verbe","g":"1er","exFr":"Mesurer les résultats.","ipa":"[məzyʁe]","exAr":"قياس النتائج."},{"fr":"inciter","ar":"إقناع (نفسياً ومهنياً)","pos":"verbe","g":"2e","exFr":"Il a réussi à inciter le jury avec son expérience.","ipa":"/kɔ̃vɛ̃kʁ/","exAr":"نجح في إقناع اللجنة بخبرته."},{"fr":"la motivation","ar":"الدافعية","pos":"nom","g":"f","exFr":"Votre motivation pour ce poste.","ipa":"[mɔtivasjɔ̃]","exAr":"دافعيتك لهذا المنصب."},{"fr":"adaptable","ar":"قائد للتأقلم","pos":"adj","exFr":"Je suis adaptable et curieux.","ipa":"[adaptabl]","exAr":"أنا مُتأقلم وفضولي."},{"fr":"la prochaine étape","ar":"الخطوة التالية","pos":"nom","exFr":"Quelle est la prochaine étape ?","ipa":"[pʁɔʃɛn ɛtap]","exAr":"ما الخطوة التالية؟"},{"fr":"remercier pour","ar":"يشكر على","pos":"locution","exFr":"Je vous remercie pour votre temps.","ipa":"[ʁəmɛʁsje puʁ]","exAr":"أشكركم على وقتكم."}],"grammar":[{"tFr":"Le passé composé et l'imparfait dans le récit professionnel","tAr":"القاعدة: المركّب والمتّصل في السرد المهني","body":["الإنجازات بالمركّب (j'ai réduit, j'ai mené) والظرف المتكرر بالمتّصل (je travaillais avec...) — هذا هو إيقاع السيرة الفرنسية: الأفعال أفعال، والخلفية أحوال.","«J'ai eu l'occasion de + infinitive» بنية تُظهر الفرص كأنشطة ملموسة لا كصفات."],"ex":[{"fr":"J'ai encadré cinq personnes pendant deux ans.","ar":"أدرت خمسة أشخاص لسنتين."},{"fr":"J'avais la charge de la formation.","ar":"كنت مسؤولاً عن التكوين."}]}],"mistakes":[{"wrong":"سيرة ذاتية شفهية من 5 دقائق","right":"90 ثانية بثلاث لبنات","why":"المقابِل يُفقد انتباهه بعد الدقيقة الثانية ويزيد الانطباع السطحي."},{"wrong":"«Je suis trop perfectionniste»","right":"ضعف حقيقي + ما تفعله لعلاجه","why":"الجواب النموذجي يُسمع مئة مرة يومياً ويقتل المصداقية."},{"wrong":"سؤال الراتب أولاً","right":"أسئلة التحدي والفريق والأجل","why":"سؤال السعر أولاً يُقرأ كتهافت ويقلب المزاج ضده."},{"wrong":"أفعال بلا أرقام","right":"chiffres لكل إنجاز","why":"الصفة تُدّعى والأرقام تُثبت — الفرنسي يبحث عن الأرقام."}],"dialogues":[{"title":"مقابلة توظيف","ctx":"مديرة ومرشّح","lines":[{"who":"Mme Reyes","fr":"Parlez-moi de vous en deux minutes.","ar":"تحدثني عن نفسك في دقيقتين."},{"who":"Sofiane","fr":"Chef d'équipe depuis trois ans — délais réduits de 20 %.","ar":"قائد فريق منذ ثلاث سنوات — الآجال قلّصت 20%."},{"who":"Mme Reyes","fr":"Et un conflit géré ? Comment ?","ar":"وموقف صعب؟ كيف عالجته؟"},{"who":"Sofiane","fr":"J'ai écouté les deux parties, puis proposé un compromis écrit.","ar":"استمعت للطرفين ثم اقترحت حلًّا مكتوباً."},{"who":"Mme Reyes","fr":"Votre plus grand défaut ?","ar":"أكبر نقائصك؟"},{"who":"Sofiane","fr":"Je vérifie beaucoup — maintenant je fixe un délai de contrôle.","ar":"أتحقق كثيراً — الآن ثبّتت مهلة تحقق."}]}],"exercises":[{"t":"mcq","skill":"speaking","q":"أفضل جواب عن «نقطة ضعف» في مقابلة:","opts":["Je n'ai aucun défaut","Je suis parfois trop perfectionniste, donc j'apprends à mieux gérer mon temps","Je suis très paresseux","Je déteste le travail d'équipe"],"a":1,"why":"ضعف حقيقي غير مميت + جهد تجاوز = جواب ناضج."},{"t":"mcq","skill":"speaking","q":"«Où en êtes-vous dans vos études ?» تسأل عن:","opts":["مكان سكنك","مرحلتك الدراسية الحالية","وجهتك المفضلة","راتبك المتوقع"],"a":1,"why":"où en êtes-vous = ما تقدمك/وضعك الحالي في المرحلة."},{"t":"fill","skill":"vocabulary","q":"أكمل: «J'ai fait un ___ (تدريب) de six mois dans une agence.»","fr":"J'ai fait un ___ de six mois dans une agence.","ans":"stage","alts":["stage"],"why":"un stage = تدريب مهني — كلمة أساسية في السيرة."},{"t":"order","skill":"speaking","q":"رتّب جواب «تعريف بنفسك»: (1) خبرة واحدة ملائمة (2) الدراسة (3) لماذا هذه الشركة","words":["J'ai","obtenu","une","licence"],"ans":"J'ai obtenu une licence","why":"التسلسل: دراسة ← خبرة ← دوافع الشركة."},{"t":"listen","skill":"listening","q":"استمع واختر ما يَعِد به المرشّح:","audio":"Je suis prêt à m'investir pleinement dans ce poste","opts":["أرفض هذا المنصب","أنا مستعد للاستثمار الكامل في هذا المنصب","أريد تغيير المنصب","سأستثمر أموالي في الأسهم"],"a":1,"why":"s'investir = يتفرغ/يستثمر جهده."},{"t":"speaking","skill":"speaking","q":"قدّم نفسك مهنياً في 3 جمل: دراستك، خبرتك، ودافعك.","target":"J'ai une licence en gestion, j'ai travaillé un an dans une banque, et je suis motivé par ce poste.","why":"التركيب الشفهي المضغوط يجعل مسارك جاهزاً في ثلاث جمل قابلة للاستعمال أمام المقابل مباشرة."},{"t":"mcq","skill":"speaking","q":"جواب «Parlez-moi de vous» الأنسب:","opts":["90 ثانية: الآن ← إنجازان بالأرقام ← الدافع","سيرتك كاملة من الطفولة","قائمة المهن السابقة بلا أرقام","سؤال الراتب أولاً"],"a":0,"why":"ثلاث لبنات مرقّمة في 90 ثانية تصنع الانطباع الأول."},{"t":"fill","skill":"speaking","q":"أكمل: «Actuellement, je ___ (travailler) dans la logistique.»","fr":"Actuellement, je ___ dans la logistique.","ans":"travaille","alts":["Travaille"],"why":"الوضع الحالي: le présent."}],"homework":"اكتب جواب «Parlez-moi de vous» في 60 ثانية (سجّل نفسك) وجاوب كتابةً عن: نقاط قوتك، ضعفك وتجاوزه، ولماذا هذه الشركة.","sources":[{"title":"مقابلة عمل باللغة الفرنسية (اسئلة، اجوبة و نصائح) entretien d'embauche","channel":"apprendre le français . تعلم الفرنسية","videoId":"cxilB-QXmbw","why":"أسئلة وأجوبة ونصائح مقابلة العمل — يغطي تعريف الذات والأسئلة المفصلية وعبارات التأثير.","cat":"Professional","level":"B1","main":true,"dur":6},{"title":"ENTRETIEN D'EMBAUCHE ET VOCABULAIRE DU TRAVAIL","channel":"Français avec Pierre","videoId":"1X5CICisiC0","why":"مرجع Pierre الكامل لسؤال المقابلة ومفردات العمل — يغطي العبارات الفعلية التي ستحتاجها من أهل الصالون إلى غرفة المقابلة.","cat":"Professional","level":"B1","extra":true},{"title":"10 QUESTIONS / RÉPONSES en français - Entretien d'embauche en français","channel":"French School TV","videoId":"I-D-yKO8ywM","why":"أسئلة المقابلة العشرة بجوابها النموذجي — تدريب مباشر: استمع للسؤال ثم أجب بصوتك قبل سماع الجواب النموذجي.","cat":"Professional","level":"B1","extra":true},{"title":"Réussis ton entretien en français ! Les phrases simples qui font la différence","channel":"Simply French Podcast","videoId":"QulRAtTp8RE","why":"بودكاست تركيزي على العبارات البسيطة الحاسمة في المقابلة — لتخرج بعبارات جاهزة تصلح لكل مقابلة قريبة.","cat":"Professional","level":"B1","extra":true}],"supplements":[{"id":"1X5CICisiC0","title":"ENTRETIEN D'EMBAUCHE ET VOCABULAIRE DU TRAVAIL","channel":"Français avec Pierre","why":"مرجع Pierre الكامل لسؤال المقابلة ومفردات العمل — يغطي العبارات الفعلية التي ستحتاجها من أهل الصالون إلى غرفة المقابلة.","lang":"fr"},{"id":"I-D-yKO8ywM","title":"10 QUESTIONS / RÉPONSES en français - Entretien d'embauche en français","channel":"French School TV","why":"أسئلة المقابلة العشرة بجوابها النموذجي — تدريب مباشر: استمع للسؤال ثم أجب بصوتك قبل سماع الجواب النموذجي.","lang":"fr"},{"id":"QulRAtTp8RE","title":"Réussis ton entretien en français ! Les phrases simples qui font la différence","channel":"Simply French Podcast","why":"بودكاست تركيزي على العبارات البسيطة الحاسمة في المقابلة — لتخرج بعبارات جاهزة تصلح لكل مقابلة قريبة.","lang":"fr"}]},{"id":"B1-t7-l3","fr":"Le téléphone au travail","ar":"الهاتف في بيئة العمل","objectives":["إجراء واستقبال مكالمات مهنية بالصيغ القياسية","الاتصال لحجز موعد أو طلب معلومات","ترك رسالة صوتية واضحة ومهنية"],"sections":[{"h":"صيغ المكالمة المهنية","p":["المكالمة الفرنسية تبدأ بالتعريف في أول 5 ثوانٍ: «Bonjour, Madame Durand, de la société X» — الاسم ثم المؤسسة. من يبدأ بموضوعه قبل تعريفه يستهلك ثواني الطرف الآخر في سؤال «qui est-ce ؟» — وثواني الهاتف أغلى ثواني المراسلة.","الهاتف مخاطبة مرئية بلا صورة: ثلاث قواعد — نبرة صاعدة للتحية والإفهام، وضوح الأرقام («zéro-zéro» بدل «00»)، وتأكيد الإعادات («Je répète : 15, quinze»). الإعادة المهذّبة في الهاتف ليست تكراراً بل ضمانة فهم.","تابع الفيديو الأساسي بالشرح العربي: مكالمة عمل كاملة — الافتتاح، التحويل («Je vous mets en relation»)، الانتظار («Une seconde, je vérifie»)، والختام. النموذج الحي يعلّمك أن تُدير المكالمة لا أن تردّ فقط — والاعتماد على الانتظار والتحويل أصعب ما في الهاتف.","قيادة المكالمة بجدول صغير: سبب الاتصال ← الطلب ← نقطة واحدة ← الخلاصة والمتابعة. جدول من أربعة عناوين يمنعك من الانجراف — وفي الهاتف الانجراف يُسمع كارتباك ويُحدث إعادات مكلفة.","الانتقال للبريد: «Je vous l'envoie par mail» + ملخص فوري: «Donc : deux unités, livrées lundi.» الخلاصة الشفهية قبل البريد تُبقي الطرف متابعاً حتى بعد القبعة — والطرف المنقطع قبل الخلاصة سينسى نصف ما قلت.","الهاتف بلا تحضير = كارثة: اكتب أربعة أسطر قبل الاتصال (السبب، الطلب، رقم المرجع، الأجل) واشرحها على ورقة أمامك. أوراق أمامك تُغني عن «Euh... je cherche» — والبحث الصوتي يُسمع أطول مما هو."],"video":{"id":"fo70RWaXOzE","title":"تعلم كيف تجيب على مكالمة هاتفية في مركز النداء","channel":"Abdelhak EL ALAOUI عبد الحق العلوي","why":"الرد على مكالمة مركز اتصال مهني: تحيّة وتعريف وتسجيل — صيغ المكالمة المهنية كاملة في سياق وظيفي حقيقي.","lang":"ar","main":true,"dur":14},"sub":[{"h":"أول 5 ثوانٍ","p":["Bonjour + الاسم + المؤسسة.","الموضوع قبل التعريف = إضاعة.","نبرة صاعدة للتحية.","وضوح الأرقام زوجياً."]},{"h":"أربعة عناوين تقود المكالمة","p":["سبب الاتصال.","الطلب.","نقطة واحدة.","الخلاصة + المتابعة."]},{"h":"التحول للخطي","p":["«Je vous l'envoie par mail».","ملخص شفهي فوري.","ورقة أربعة أسطر قبل الاتصال.","البحث الصوتي يُسمع طويلاً."]}]},{"h":"حجز موعد هاتفياً","p":["السيناريو الكامل لحجز موعد: «Bonjour, je vous appelle pour prendre rendez-vous. Seriez-vous disponible mardi matin ?» — إن رُفض: «Et jeudi après-midi, cela vous conviendrait-il ?» (وخميس بعد الظهر، يناسبكم؟). بعد التثبيت أعد المعلومة للتأكيد: «Donc, mardi 14 à 10h, c'est bien ça ?» (إذن الثلاثاء 14 الساعة 10، أصح؟) — إعادة التأكيد الهاتفية عادة مهنية قياسية.","لإلغاء أو تعديل موعد مهنياً: «Je suis au regret de vous informer que je ne pourrai pas venir mardi. Serait-il possible de reporter à la semaine suivante ?» — اعتذار قصير + اقتراح بديل فوراً. لا تترك الإلغاء معلقاً بلا بديل؛ هذا ما يفرّق المهني عن العابر.","الانتظار المُدار: «Je vous confirme dans dix minutes par mail» بدل الصمت أو «je rappelle». الوعد بقناة ومؤجَّل يُبقي الطرف على الخط الذهني وإن انتهى الاتصال — وهذه هي مهارة B1 في الهاتف."],"video":null},{"h":"الرسالة الصوتية المهنية","p":["تركيب الرسالة الصوتية الناجحة في 20 ثانية: تعريفك («Bonjour, ici Sami Alaoui»)، سبب الاتصال («Je vous appelle au sujet de l'annonce pour le poste de vendeur»)، طلبك («Pourriez-vous me rappeler au 06... ?») وشكر («Merci, au revoir»). تحدث ببطء أكثر من العادي — الهاتف يشوه الصوت وسرعتك الطبيعية تسمع أسرع.","تمرين الإتقان الأفضل: سجّل رسالتك الصوتية على هاتفك وأعد الاستماع. هل سمّيت نفسك؟ هل رقمتك واضحة؟ هل طلبت إجراءً محدداً؟ أعد التسجيل حتى تصل لنسخة 20 ثانية نظيفة — ستحتفظ بها حية في الذاكرة لكل مكالمة قادمة.","بعد الفيديو: سجّل مكالمة تمثيلية من 60 ثانية (تعريف ← طلب ← خلاصة) وأعد الاستماع — احسب ثواني التردد («euh») وعدد مرات إعادة الرقم. كل تردد يُقلَّص بورقة تحضير لا بسرعة كلام."],"video":null},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: أتقنت التعريف في أول 5 ثوانٍ، وجدول المكالمة من أربعة عناوين، وحجز الموعد وأكّد الأرقام («Je répète : 15, quinze»)، والرسالة الصوتية 20 ثانية. أعد مشاهدة الفيديو الرئيسي وركّز على نطق الأرقام زوجياً وعلى صيغة التحويل «Je vous mets en relation».","جسر الدروس: من B1-t7-l2 (مقابلة التوظيف وإدارة أسئلتها) إلى B1-t7-l3 (الهاتف في بيئة العمل والمكالمة المهنية)، ثم إلى b1-t8-l1 حيث تنتقل من لغة العمل إلى حوار Extra الحي: وصول Sam والتعارف في العمارة.","مهمة تطبيقية: سجّل مكالمة تمثيلية من دقيقة واحدة (تعريف ← سبب ← طلب ← خلاصة) مستعملاً 3 كلمات جديدة من الدرس، ثم أعد الاستماع وقارنها بالفيديو الرئيسي وعدّ ثواني تردّدك («euh»)."]}],"examples":[{"fr":"Bonjour, je vous appelle au sujet de votre annonce.","ar":"مرحباً، أتصل بكم بخصوص إعلانكم."},{"fr":"Pourrais-je parler à Madame Dupont ?","ar":"هل يمكنني التحدث مع السيدة دوبون؟"},{"fr":"Donc, mardi à 10h, c'est bien ça ?","ar":"إذن الثلاثاء الساعة 10، أصح؟"},{"fr":"Ne quittez pas, s'il vous plaît.","ar":"لا تغادر من فضلك."},{"fr":"Bonjour, Lina Bennani, de la société Atlas. Je vous appelle pour...","ar":"مرحباً، لينا بناني من شركة أطلس. أتصل بكم من أجل...","note":"تعريف 5 ثوانٍ"},{"fr":"Je répète : 15, quinze, avenue Victor.","ar":"أعيد: 15، خمسة عشر، شارع فيكتور.","note":"أرقام"},{"fr":"Je vous confirme par mail dans dix minutes.","ar":"أؤكد لكم بالبريد خلال عشر دقائق.","note":"تسيير"},{"fr":"Bonne journée, et merci de votre temps !","ar":"يوماً سعيداً، وشكراً لوقتكم!","note":"ختام"}],"pron":[{"w":"C'est de la part de qui ?","ipa":"[sɛ də la paʁ də ki]","approx":"سيت-دُه-لا-بار-دُه-كي"},{"w":"ne quittez pas","ipa":"[nə ki.te pa]","approx":"نه-كيتيه-با"},{"w":"je vous le passe","ipa":"[ʒə vu lə pas]","approx":"جه-فو-له-پاس"}],"vocab":[{"fr":"prendre rendez-vous","ar":"يحجز موعداً","pos":"expression","ipa":"[pʁɑ̃dʁ ʁɑ̃.de.vu]","exFr":"Je vous appelle pour prendre rendez-vous.","exAr":"أتصل بكم لحجز موعد."},{"fr":"de la part de","ar":"من حضرته / بالنيابة عن","pos":"expression","ipa":"[də la paʁ də]","exFr":"C'est de la part de qui ?","exAr":"من حضرته؟"},{"fr":"ne pas quitter","ar":"لا يغادر (الخط)","pos":"expression","ipa":"[nə pa ki.te]","exFr":"Ne quittez pas, je vous le passe.","exAr":"لا تغادر، سأمرر لك الخط."},{"fr":"transférer","ar":"يحوّل (المكالمة)","pos":"verbe","ipa":"[tʁɑ̃s.fe.ʁe]","exFr":"Je vous transfère au service commercial.","exAr":"أحوّلك إلى قسم المبيعات."},{"fr":"reporter","ar":"يؤجل (موعداً)","pos":"verbe","ipa":"[ʁə.pɔʁ.te]","exFr":"Serait-il possible de reporter le rendez-vous ?","exAr":"هل يمكن تأجيل الموعد؟"},{"fr":"la messagerie","ar":"البريد الصوتي","pos":"nom","g":"f","pl":"les messageries","ipa":"[la me.saʒ.ʁi]","exFr":"Laissez un message sur ma messagerie.","exAr":"اترك رسالة على بريدي الصوتي."},{"fr":"Je vous mets en relation","ar":"أُحيلك إلى/أربطك بـ","pos":"locution","exFr":"Je vous mets en relation avec le service.","ipa":"[ʒə vu mɛ ɑ̃ ʁɛlasjɔ̃]","exAr":"أحيلك إلى القسم."},{"fr":"être au courant","ar":"على علم بـ","pos":"locution","exFr":"Êtes-vous au courant ?","ipa":"[ɛtʁ o kuʁɑ̃]","exAr":"هل أنتم على علم؟"},{"fr":"passer un coup de fil","ar":"يجري مكالمة","pos":"locution","exFr":"Je vous passe un coup de fil.","ipa":"[pase œ̃ ku də fil]","exAr":"أجرس عليك."},{"fr":"être joignable","ar":"يمكن الوصول له","pos":"adj","exFr":"Je suis joignable à ce numéro.","ipa":"[ɛtʁ ʒwaɲabl]","exAr":"يمكن الوصول لي بهذا الرقم."},{"fr":"le standard","ar":"الهاتف المركزي/الاستقبال","pos":"nom","g":"m","exFr":"Le standard me transfère.","ipa":"[stɑ̃daʁ]","exAr":"الهاتف المركزي يحوّلني."},{"fr":"rappelez-moi","ar":"أعد الاتصال","pos":"locution","exFr":"Rappelez-moi après 14h.","ipa":"[ʁapɛle mwɑ]","exAr":"أعد الاتصال بعد الثانية."},{"fr":"répéter / je répète","ar":"يُعيد / أُعيد","pos":"locution","exFr":"Je répète : quinze, Q-U-I-N-Z-E.","ipa":"[ʁepete]","exAr":"أعيد: خمسة."},{"fr":"bavarder","ar":"يتحدث/ثرثرة","pos":"verbe","g":"1er","exFr":"Ne pas bavarder au téléphone.","ipa":"[bavaʁde]","exAr":"الثرثرة الهاتفية ممنوعة."},{"fr":"la pièce jointe","ar":"المرفق","pos":"nom","g":"f","exFr":"Vous l'aurez en pièce jointe.","ipa":"[pjɛs ʒɔ̃t]","exAr":"ستحصل عليه في المرفق."},{"fr":"confirmer par écrit","ar":"يؤكد كتابياً","pos":"locution","exFr":"Je confirme par écrit.","ipa":"[kɔ̃fiʁme paʁ ekʁi]","exAr":"أؤكد كتابياً."},{"fr":"d'ici dix minutes","ar":"خلال عشر دقائق","pos":"locution","exFr":"Réponse d'ici dix minutes.","ipa":"[disi dis minyt]","exAr":"رد خلال عشر دقائق."},{"fr":"une ligne","ar":"خط هاتف","pos":"nom","g":"f","exFr":"Ma ligne est saturée.","ipa":"[liɲ]","exAr":"خطي مشغول."}],"grammar":[{"tFr":"Le conditionnel de politesse au téléphone","tAr":"القاعدة: المشروط في اللباقة الهاتفية","body":["المشروط هو لغة الهاتف المهذّب: «Je vous demanderais...», «Pourriez-vous...» أرقى من المضارع المباشر.","«Pouvez-vous» (قدرة) vs «Pourriez-vous» (احتمال) — الثاني أبعد تواضعاً وأقرب قبول."],"ex":[{"fr":"Pourriez-vous me transférer ?","ar":"هل يمكنكم تحويلي؟"},{"fr":"Je vous demanderais de répéter.","ar":"سأطلب منكم الإعادة."}]}],"mistakes":[{"wrong":"البدء بالموضوع قبل التعريف","right":"الاسم والمؤسسة في أول 5 ثوانٍ","why":"الطرف يهدر ثوانٍ في «qui est-ce» قبل أن يصغي."},{"wrong":"رقم بلا إعادة أو تأكيد","right":"«Je répète: quinze» + ملخص","why":"الأرقام هي أكثر ما يضيع في الهاتف."},{"wrong":"انقطاع قبل الخلاصة","right":"ملخص شفهي ثم بريد","why":"الطرف المنقطع قبل الخلاصة ينسى نصف المكالمة."},{"wrong":"الاتصال بلا ورقة تحضير","right":"أربعة أسطر مكتوبة","why":"البحث الصوتي («euh... je cherche») يكسر مصداقية المهنية."}],"dialogues":[{"title":"مكالمة مورّد","ctx":"موظفة تتصل بمورّد","lines":[{"who":"Salma","fr":"Bonjour, Salma Idrissi, de la société Nord. Je vous appelle pour la commande 4412.","ar":"مرحباً، سلمى إدريسي من شركة الشمال. أتصل بكم بخصوص الطلب 4412."},{"who":"Agent","fr":"Un instant, je vérifie — je vous mets en relation.","ar":"لحظة، أتحقق — أحوّلك."},{"who":"Salma","fr":"Merci. La livraison est confirmée pour lundi ?","ar":"شكراً. هل التسليم مؤكد الاثنين؟"},{"who":"Agent","fr":"Je répète : lundi 12, L-U-N-D-I.","ar":"أعيد: الاثنين 12."},{"who":"Salma","fr":"Parfait. Je vous confirme par mail dans dix minutes.","ar":"ممتاز. أؤكد لكم بالبريد خلال عشر دقائق."},{"who":"Agent","fr":"Noté. Bonne journée !","ar":"سُجّل. يوماً سعيداً!"}]}],"exercises":[{"t":"mcq","skill":"listening","q":"«C'est de la part de qui ?» تسأل عن:","opts":["الاسم المشترك","من المتصل / مَن يطلب التحدث","المدينة","الوقت"],"a":1,"why":"de la part de = بالنيابة عن/من حضرته — سؤال الاستقبال القياسي."},{"t":"mcq","skill":"speaking","q":"لطلب التحدث مع شخص محدد في الهاتف:","opts":["Je veux Dupont maintenant","Pourrais-je parler à Madame Dupont ?","Où est Dupont ?","Donnez Dupont"],"a":1,"why":"Pourrais-je = صيغة الطلب المهذبة الهاتفية."},{"t":"fill","skill":"vocabulary","q":"أكمل: «Pourriez-vous me ___ (يعيد الاتصال) après 14h ?»","fr":"Pourriez-vous me ___ après 14h ?","ans":"rappeler","alts":["rappeler"],"why":"me rappeler = تعيد الاتصال بي."},{"t":"order","skill":"speaking","q":"رتّب بنية الرسالة الصوتية: (1) سبب الاتصال (2) تعريفك (3) طلبك ورقمك","words":["Bonjour,","ici","Sami."],"ans":"Bonjour, ici Sami.","why":"الترتيب: تعريف ← سبب ← طلب ورقم."},{"t":"listen","skill":"listening","q":"استمع واختر ما يقوله موظف الاستقبال:","audio":"Ne quittez pas, s'il vous plaît, je vous le passe","opts":["أغلق الخط فوراً","لا تغادر، سأمرر لك الخط","اتصل في وقت لاحق","الموظف في اجتماع"],"a":1,"why":"ne pas quitter + passer le line = لا تغادر وسأمرر الخط."},{"t":"speaking","skill":"speaking","q":"اتصل شفوياً لحجز موعد: سبب الاتصال + اقتراح وقت + تأكيد.","target":"Bonjour, je vous appelle pour prendre rendez-vous. Seriez-vous disponible mardi matin ?","why":"محاكاة المكالمة صوتياً تكشف تردّدك وأخطاء أرقامك قبل المكالمة الحقيقية، والتسجيل يُظهر تقدّمك من نسخة لنسخة."},{"t":"mcq","skill":"speaking","q":"أول 5 ثوانٍ في مكالمة العمل:","opts":["الاسم والمؤسسة ثم سبب الاتصال","الطلب مباشرة","الصمت حتى يسأل الطرف","التحية الطويلة"],"a":0,"why":"التعريف يمنع سؤال «من أنت؟» ويوفّر ثوانٍ ثمينة."},{"t":"translate","skill":"speaking","q":"ترجم: «سأؤكد لكم بالبريد خلال عشر دقائق.»","ans":"Je vous confirme par mail dans dix minutes.","alts":["je vous confirme par mail dans 10 minutes","Je vous confirme par mail dans 10 minutes"],"why":"confirmer par écrit + d'ici/dans + مهلة."}],"homework":"سجّل رسالة صوتية مهنية 20 ثانية (تعريف + سبب + طلب ورقم) وأعد الاستماع حتى تصل لنسخة نظيفة.","sources":[{"title":"تعلم كيف تجيب على مكالمة هاتفية في مركز النداء","channel":"Abdelhak EL ALAOUI عبد الحق العلوي","videoId":"fo70RWaXOzE","why":"الرد على مكالمة مركز اتصال مهني: تحيّة وتعريف وتسجيل — صيغ المكالمة المهنية كاملة في سياق وظيفي حقيقي.","cat":"Professional","level":"B1","main":true,"dur":14},{"title":"L'appel téléphonique professionnel - French Business Call - (B1/B2)","channel":"Learn French with Timo","videoId":"iS5GC3-VGRs","why":"درس متخصص في المكالمة المهنية بمستوى B1/B2 — أصعب مهارة سمعية للمتعلمين بسبب غياب لغة الجسد، وهنا حلها خطوة بخطوة بصيغ قياسية.","cat":"Professional","level":"B1","extra":true},{"title":"Parler au téléphone en français. Niveau A2 de FLE. 5 conversations. 😍","channel":"La prof Elisabeth","videoId":"HCoWTBojvsA","why":"خمس محادثات هاتفية واقعية مع أستاذة FLE محترفة — يثبّت الصيغ بلغة حية ومواقف متنوعة (حجز، استفسار، موعد).","cat":"Professional","level":"B1","extra":true},{"title":"Dialogue 1a appeler pour du travail français","channel":"L2pack","videoId":"PZZIMev4bOY","why":"حوار مرئي قصير لمكالمة طلب عمل — نموذج ملموس للمكالمة الأولى الاعتباطية: ماذا تقول بالضبط من «ألو» إلى «شكراً ووداعاً».","cat":"Professional","level":"B1","extra":true}],"supplements":[{"id":"iS5GC3-VGRs","title":"L'appel téléphonique professionnel - French Business Call - (B1/B2)","channel":"Learn French with Timo","why":"درس متخصص في المكالمة المهنية بمستوى B1/B2 — أصعب مهارة سمعية للمتعلمين بسبب غياب لغة الجسد، وهنا حلها خطوة بخطوة بصيغ قياسية.","lang":"fr"},{"id":"HCoWTBojvsA","title":"Parler au téléphone en français. Niveau A2 de FLE. 5 conversations. 😍","channel":"La prof Elisabeth","why":"خمس محادثات هاتفية واقعية مع أستاذة FLE محترفة — يثبّت الصيغ بلغة حية ومواقف متنوعة (حجز، استفسار، موعد).","lang":"fr"},{"id":"PZZIMev4bOY","title":"Dialogue 1a appeler pour du travail français","channel":"L2pack","why":"حوار مرئي قصير لمكالمة طلب عمل — نموذج ملموس للمكالمة الأولى الاعتباطية: ماذا تقول بالضبط من «ألو» إلى «شكراً ووداعاً».","lang":"fr"}]}]},{"id":"b1-t8","slug":"series-extra","icon":"play","color":"#e91e63","fr":"Extra — la série (B1)","ar":"مسار المسلسل: Extra — 12 حلقة (B1)","desc":"مسلسل Extra الفرنسي التعليمي كامل حلقةً بحلقة: من وصول Sam إلى باريس إلى النهائي — كل حلقة بترجمة فرنسية، وحوار طبيعي موجّه لمستوى B1.","lessons":[{"id":"b1-t8-l1","fr":"Extra — Épisode 1 : L’arrivée de Sam","ar":"Extra — الحلقة 1: وصول Sam إلى باريس","objectives":["قراءة وفهم رسالة شخصية قصيرة من صديق بالمراسلة (Un correspondant) — رسالة سام من أمريكا.","الترحيب بضيف أجنبي والتعريف بالنفس والآخرين باللغتين القياسية والعامية (Registre familier).","تقديم مشروب لضيف والسؤال عن الأخبار (Quoi de neuf ؟ / Tu as la forme ؟).","القواعد وتصحيح الأخطاء: (Bien) مقابل (Bon)، و(Dormir avec) مقابل (Dormir chez)، و(Tu es chaud) مقابل (Tu as chaud)، وتصريف (Venir de) و(Habiter à/en).","الثقافة: العيد الوطني الفرنسي (Le 14 juillet) والسكن المشترك بين الشباب (La colocation)."],"sections":[{"h":"الحلقة 1: وصول Sam ولقاؤها بالجيران (الحلقة كاملة)","video":{"id":"EaNqp4FXh-s","title":"Extra French episode 1 with french subtitles","channel":"Frenchy french","why":"الحلقة الأولى كاملة بترجمة فرنسية: Sam تصل إلى باريس وتلتقي بجيرانها — أساس المحادثة الأولى في السلسلة.","lang":"fr","main":true,"dur":25},"p":["الحلقة الأولى هي مدخلك إلى عالم Extra بأكمله: Sam البريطانية تصل إلى باريس وتستقبلها المفاجأة الأولى — العمارة، الدرج الضيق، وحارسة العمارة التي تراقب كل شيء. الحدث عادي جداً، لكن كثافته اللغوية عالية: في ست دقائق تسمع التحية، السؤال عن الأصل، عن المهنة، وعن سبب القدوم — كلها بأصوات ناطقين بطيئة وواضحة.","ما يميّز هذه الحلقة أن الجيران يتهافتون على Sam بالأسئلة واحداً تلو الآخر: Hugo الشاب الصاخب، Héloïse الهادئة، وNicolas الذي يبدو مهتماً أكثر مما يُظهر. كل سؤال يعيد صيغة معروفة بأسلوب جديد، فتسمع «D’où tu viens ?» و«Tu fais quoi dans la vie ?» و«Tu restes combien de temps ?» في سياق واحد متصل.","انتبه إلى طريقة استقبال حارسة العمارة: صوتها عالٍ ونبرتها حازمة لكنها ودودة في الأساس — هذا هو نموذج «la concierge» الكلاسيكي في السينما الفرنسية. الفرق بين نبرتها ونبرة Sam المهذّبة هو أول درس في «السياق الاجتماعي» الذي ستحتاجه لاحقاً مع الأفلام.","تقنية المشاهدة هنا: شغّل الفيديو مرة كاملة بلا ترجمة عربية، ثم أعد المشهد الأول فقط ثلاث مرات — في المرة الثالثة ستلاحظ أنك تفهم السؤال قبل أن تسمع الجواب. هذا التوقّع اللغوي هو هدف المستوى B1 الحقيقي.","من الناحية النحوية تقدّم الحلقة مراجعة ذكية لفعل être مع الصفات والمهن، وvenir de مع الأماكن، وفعل habiter مع à. لا تُقدَّم كقاعدة جديدة بل كأدوات حيّة داخل الحوار — وهذا بالضبط ما يميّز B1 عن A2: القاعدة تُستنتج من السياق.","بعد الحلقة جرّب أن تصف مَن تشاهده في الفيديو بثلاث جمل: من هو، من أين يأتي، وماذا يفعل. إن استطعت فعل ذلك دون ترجمة فقد أتقنت جوهر الحلقة الأولى."],"sub":[{"h":"جُمل الوصول والتعارف الأساسية","p":["Bonjour, je m’appelle Sam, je suis anglaise.","Enchantée ! Bienvenue dans notre immeuble.","Tu arrives de Londres ? Et tu restes à Paris combien de temps ?","J’habite au troisième étage, juste en face de toi."]},{"h":"أدوات نطقية: تبسيط elision والوصل الصوتي","p":["« je m’appelle » تُنطق [ʒə ma.pɛl] بلا فصل بين حرفين.","« tu arrives » تسمع الضمير والفعل ككتلة واحدة [ty a.ʁiv].","« en face de toi » تُختصر في الكلام السريع إلى [ɑ̃.fas tə]."]},{"h":"خطوات Listen & Repeat","p":["شغّل أول دقيقتين: أوقف عند كل جملة تعارف وكرّرها ثلاث مرات بصوت عالٍ.","سجّل صوتك وأنت تُعرّف نفسك في 20 ثانية، ثم قارنه بنبرة Sam.","اكتب خمس جمل سمعتها عن ظهر قلب وأضف إليها جملتك الخاصة."]}]},{"h":"النصوص الحوارية المصححة (Corpus des Dialogues)","p":["النص في تبويب «حوارات» هو المفرغ الأكاديمي للحلقة بعد التنقيح: صُحح «d’Annie» و«Louis» و«C’est mon lit» و«J’ai vingt-deux chambres» و«Vas-y» من أخطاء التفريغ التلقائي — ثلاثة مشاهد: الرسالة، الوصول، والمقلب والسر.","المشهد الأول: رسالة المراسلة («Tu te souviens de moi ؟ ... tu étais ma correspondante») بأخطائها الأصلية («Je parle bon français», «Je veux dormir avec toi») — وهي مادة القواعد: لا تقرأها مصححة إلا بعد استخراج الخطأ بنفسك.","المشهد الثاني: كوميديا الترجمة الحرفية («j’habite Sam», «Tu habites dans un musée ؟», «J’ai vingt-deux chambres !») — كل جملة خاطئة يقابلها تصحيح فوري من ساشا وآني، فالحلقة درس تصحيح ذاتي.","المشهد الثالث: جمل نيكو المسمومة («le chien est dans le four»)، ثم خطأ الحرارة («Je suis chaud !» ← «Tu as chaud !»)، ثم السر («Je veux des amis... de vrais amis») والنهاية («appelle-moi Cha-Cha !»).","طريقة العمل: شاهد المشهد أولاً بلا نص والتقط الأخطاء بأذنك، ثم قارن بالنص المكتوب، ثم مثّل دور سام بجمله الخاطئة ودور ساشا بتصحيحاتها — فالتبديل بين الدورين هو ما يثبّت القاعدة."]},{"h":"عبارات الوصول التي تتكرر في المشهد","p":["« Bienvenue à Paris / dans notre immeuble » تُقال عند الاستقبال — لاحظ أن bienvenue لا تُستخدم مع الأشخاص في الفرنسية المعاصرة، بل مع الأماكن والمناسبات، أما الأشخاص فنقول « enchanté(e) » أو « ravi(e) ».","« Tu fais quoi dans la life ? » — لاحظ elision القلب في la vie وتخفيف quoi في الكلام الطبيعي؛ في الرسمية يعود السؤال إلى « Que faites-vous dans la vie ? ».","« C’est quoi, ton numéro d’appartement ? » نموذج سؤال مختصر: أداة الاستفهام أولاً ثم الاسم — ترتيب شائع جداً في الفرنسية المنطوقة.","« On se voit tout à l’heure ! » — العبارات المختصرة بالضمير on تغلب الضمير nous في المحادثة اليومية حتى بين الأصدقاء المتردّدين على اللغة الفرنسية."]},{"h":"الأفعال الكلامية والتواصل اليومي (Actes de Parole)","p":["اللغة القياسية: «Jusqu’ici, tout va bien» (حتى الآن كل شيء بخير)، و«Tu te souviens de moi ؟» (هل تتذكرني؟)، و«Tu veux boire quelque chose ؟» (عرض مشروب على الضيف).","اليومية (Courant): «C’est fini entre nous !» (إنهاء علاقة)، و«Je n’en peux plus !» (نفد صبري!)، و«Ça m’est égal !» (لا يهمني!).","العامية (Familier): «Tu as la forme ؟ / Quoi de neuf ؟» (كيف حالك؟ / ما الجديد؟)، و«C’est un mec !» (إنه شاب! — مرادف Un garçon)، وتعبير «Il fait vieux jeu» (يبدو قديم الطراز)."]},{"h":"ثقافة وحضارة: 14 يوليو والسكن المشترك (Civilisation)","p":["العيد الوطني (Le 14 juillet): يصل سام إلى فرنسا يوم العيد الوطني الفرنسي — ذكرى اقتحام سجن الباستيل (1789) — وهو يوم عطلة وطنية بعروض عسكرية وألعاب نارية، واختياره تاريخاً للوصول ليس مصادفة بل رمز لبداية جديدة.","السكن المشترك (La colocation): ساشا وآني «partagent un appartement» — نظام سكني شائع بين الشباب والطلاب في المدن الفرنسية الكبرى لتقاسم الإيجار (le loyer) والفواتير (les factures: téléphone, gaz, électricité, eau) — وهو الإطار الاجتماعي للسلسلة كلها."]},{"h":"تمرين الحلقة","p":["تمرين التمثيل: تخيّل أنك الجار الجديد في عمارة باريسية. اكتب ثم اسجّل حواراً من ثمانية أسطر مع حارس العمارة يشمل: التحية، الاسم، الأصل، المهنة، ورقم الشقة.","لعبة الأدوار الثنائية: شخص واحد يسأل خمسة أسئلة سريعة (D’où / Qu’est-ce que tu fais / Tu restes...) والآخر يجيب دون توقف — الهدف هو سرعة الاستجابة لا الكمال.","تلخيص الكتابة: اكتب فقرة من خمس جمل تصف وصول شخص جديد إلى حيّ جديد في مدينتك، مستعملاً أربع مفردات على الأقل من مفردات الحلقة."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: أتقنت جمل الوصول والتعارف (je m'appelle / je viens de / j'habite) وفرّقت بين tu وvous مع الجار الأكبر سناً، واستخرجت مفردات العمارة والسكان (immeuble, étage, concierge, voisin). أعد مشاهدة الفيديو الرئيسي وركّز على مشهد التعارف الأول عند الدرج وعلى نبرة حارسة العمارة.","جسر الدروس: من B1-t7-l3 (المكالمة المهنية وصيغها) إلى b1-t8-l1 (وصول Sam والتعارف داخل العمارة)، ثم إلى b1-t8-l2 حيث تنتقل إلى التسوّق: المقاسات واللون والسعر واتخاذ القرار.","مهمة تطبيقية: سجّل حواراً من ثمانية أسطر مع جار أو زميل (تحية ← اسم ← أصل ← مهنة) في دقيقة، مستعملاً 3 كلمات جديدة من مفردات الحلقة، ثم قارن نبرتك وسرعتك بالفيديو الرئيسي."]}],"pron":[{"w":"je m’appelle","ipa":"[ʒə ma.pɛl]","approx":"جُ ماپيل"},{"w":"l’immeuble","ipa":"[lɛ̃.mœbl]","approx":"ليمْبوبل"},{"w":"la concierge","ipa":"[la kɔ̃.sjɛʁʒ]","approx":"لا كونسيَرج"}],"vocab":[{"fr":"la concierge","ar":"حارسة/حارس العمارة","pos":"nom","g":"f","exFr":"La concierge connaît tout le quartier.","ipa":"[la kɔ̃.sjɛʁʒ]","exAr":"حارسة العمارة تعرف الحيّ بأكمله."},{"fr":"l’immeuble","ar":"العمارة/المبنى السكني","pos":"nom","g":"m","exFr":"Notre immeuble est au cœur de Paris.","ipa":"[lɛ̃.mœbl]","exAr":"عمارتنا في قلب باريس."},{"fr":"l’étage","ar":"الطابق","pos":"nom","g":"m","exFr":"Je vis au deuxième étage.","ipa":"[e.taʒ]","exAr":"أسكن في الطابق الثاني."},{"fr":"le voisin / la voisine","ar":"الجار/الجارة","pos":"nom","g":"m/f","exFr":"Mon voisin est très serviable.","ipa":"[lə vwa.zɛ̃]","exAr":"جارّي متعاون جداً."},{"fr":"emménager","ar":"ينتقل للسكن (في مكان جديد)","pos":"verbe","g":"","exFr":"Nous emménagons samedi prochain.","ipa":"[ɑ̃.me.na.ʒe]","exAr":"سنتنتقل للسكن السبت القادم."},{"fr":"s’installer","ar":"يُستقرّ، يستقرّ في مكانه","pos":"verbe pronominal","g":"","exFr":"Elle s’installe dans un petit appartement.","ipa":"[sɛ̃.sta.le]","exAr":"هي تستقر في شقة صغيرة."},{"fr":"faire connaissance (avec)","ar":"يتعرّف على","pos":"loc.","g":"","exFr":"J’ai fait connaissance avec mes voisins.","ipa":"","exAr":"تعرّفت على جيري."},{"fr":"la clé","ar":"المفتاح","pos":"nom","g":"f","exFr":"Voici la clé de ta chambre.","ipa":"[la kle]","exAr":"إليك مفتاح غرفتك."},{"fr":"le sac","ar":"الحقيبة/الشنطة","pos":"nom","g":"m","exFr":"Ton sac est très lourd !","ipa":"[lə sak]","exAr":"حقيبتك ثقيلة جداً!"},{"fr":"se présenter","ar":"يُعرّف بنفسه","pos":"verbe pronominal","g":"","exFr":"Il se présente en trois phrases.","ipa":"","exAr":"يُعرّف بنفسه في ثلاث جمل."},{"fr":"la rencontre","ar":"اللقاء، التعارف","pos":"nom","g":"f","exFr":"Leur première rencontre était amusante.","ipa":"","exAr":"كان لقاؤهما الأول ممتعاً."},{"fr":"accueillir","ar":"يستقبل، يرحّب بـ","pos":"verbe","g":"","exFr":"L’immeuble accueille de nouveaux locataires.","ipa":"","exAr":"العمارة تستقبل سكاناً جُدد."},{"fr":"partager (un appartement)","ar":"يتشارك (شقة سكنية)","pos":"verbe","g":"1er","exFr":"Sacha et Annie partagent un appartement.","exAr":"ساشا وآني تتشاركان شقة.","ipa":"paʁtaʒe"},{"fr":"amoureux / amoureuse (de)","ar":"مغرم / واقع في حب","pos":"adj","exFr":"Nico est amoureux de Sacha.","exAr":"نيكو مغرم بساشا.","ipa":"amuʁø / amuʁøz"},{"fr":"un(e) correspondant(e)","ar":"صديق بالمراسلة","pos":"nom","exFr":"Sam, mon correspondant il y a sept ans !","exAr":"سام، صديقي بالمراسلة قبل سبع سنوات!","ipa":"kɔʁɛspɔ̃dɑ̃"},{"fr":"une facture","ar":"فاتورة (كهرباء، غاز، هاتف...)","pos":"nom","g":"f","exFr":"Factures : téléphone, gaz, électricité, eau...","exAr":"فواتير: هاتف، غاز، كهرباء، ماء...","ipa":"faktyʁ"},{"fr":"un coussin","ar":"وسادة صغيرة (مخدة تزيين)","pos":"nom","g":"m","exFr":"J’ai bien reçu ton coussin.","exAr":"لقد استلمت وسادتك.","ipa":"kusɛ̃"},{"fr":"un lit / une chambre d’amis","ar":"سرير / غرفة ضيوف","pos":"nom","exFr":"As-tu un lit pour moi ?","exAr":"هل لديكِ سرير لي؟","ipa":"li / ʃɑ̃bʁ dami"},{"fr":"une salle de bains / une douche","ar":"حمّام / دُش (استحمام)","pos":"nom","g":"f","exFr":"Tu as besoin d’une douche.","exAr":"أنت بحاجة إلى استحمام.","ipa":"sal də bɛ̃ / duʃ"},{"fr":"un porteur / une valise","ar":"حامِل الحقائب / حقيبة سفر","pos":"nom","exFr":"Mes valises sont en bas !","exAr":"حقائبي في الأسفل!","ipa":"pɔʁtœʁ / valiz"},{"fr":"un four","ar":"فرن","pos":"nom","g":"m","exFr":"Le chien dort dans le four !","exAr":"الكلب ينام في الفرن!","ipa":"fuʁ"},{"fr":"le jambon","ar":"لحم مقدد (شرائح)","pos":"nom","g":"m","exFr":"Du jambon ?","exAr":"بعض اللحم؟","ipa":"ʒɑ̃bɔ̃"},{"fr":"musclé(e) / bête / riche","ar":"مفتول العضلات / غبي / غني (ثري)","pos":"adj","exFr":"Mais Sam, tu es riche !","exAr":"ولكن يا سام، أنت ثري!","ipa":"myskle / bɛt / ʁiʃ"},{"fr":"un secret","ar":"سرّ","pos":"nom","g":"m","exFr":"On garde le secret !","exAr":"سنحفظ السر!","ipa":"səkʁɛ"}],"examples":[{"fr":"Je suis anglaise, je viens de Londres.","ar":"أنا بريطانية،أتي من لندن.","note":"الهوية ثم الأصل"},{"fr":"Enchantée, Sam ! Bienvenue dans notre immeuble.","ar":"تشرّفت يا Sam! أهلاً بك في عمادرتنا.","note":"الاستقبال"},{"fr":"Tu arrives de Londres ? Et tu restes à Paris combien de temps ?","ar":"تأتي من لندن؟ وكم تبقى في باريس؟","note":"السؤال عن القدوم والمدة"},{"fr":"J’habite au troisième étage, juste en face de toi.","ar":"أسكن في الطابق الثالث، بالضبطمقابل شقتك.","note":"habiter + au + au / en face de"},{"fr":"C’est quoi, ton numéro d’appartement ?","ar":"ما هو رقم شقتك؟","note":"ترتيب الاستفهام المنطوق"},{"fr":"On se voit tout à l’heure !","ar":"نراك بعد قليل!","note":"on بدل nous + tout à l’heure"},{"fr":"Tu te souviens de moi ?","ar":"هل تتذكرني؟","note":"فعل Se souvenir de"},{"fr":"Quoi de neuf ?","ar":"ما الجديد؟","note":"السؤال عن الأخبار"},{"fr":"Tu as la forme ?","ar":"هل أنت بنشاطك؟","note":"تحية الشباب"}],"grammar":[{"tFr":"Se présenter : pronominal + formules sociales","tAr":"التعارف: الأفعال الانعكاسية وصيغ الاستقبال","body":["الفعل pronominal « se présenter » يتغيّر مع الضمائر: je me présente / tu te présentes / il se présente. في هذا المستوى لم تعد تحتاج لحفظ جدول: استمع للنمط الصوتي في الحوار وستلتقطه تلقائياً.","الفرق بين « enchanté » و « ravi » و « ravie » رقعة على الحالة: enchanté للجميع تقريباً، ravie للأنثى الفخورة باللقاء. حارسة العمارة تستخدم نبرة صاعدة مع enchantée — وهي إشارة اجتماعية لا نحوية."],"ex":[{"fr":"Je me présente : je m’appelle Hugo, je suis étudiant.","ar":"أُعرّف نفسي: اسمي هوغو، أنا طالب."},{"fr":"Enchantée de faire votre connaissance.","ar":"تشرّفت بلقائكم (الرسمية)."}]},{"tFr":"Habiter / être / venir de : le trio du lieu","tAr":"habiter وêtre وvenir de: ثلاثي الأماكن","body":["« J’habite à Paris » (أسكن)، « Je suis de Paris » (أنا من باريس أصلاً)، « Je viens de Paris » (جئت الآن). التبادل بينها خطأ شائع عند المتعلمين حتى مستوى B1 — خصّص دقيقة يومياً للتمييز بين الثلاث.","مع الأرقام: « au troisième étage » — au لأنه مذكّر مفرد، ولاحظ أن العدّ في الطوابق الفرنسية يبدأ من الأرضية الأرضية = rez-de-chaussée."],"ex":[{"fr":"J’habite au cinquième étage, au-dessus de Hugo.","ar":"أسكن في الطابق الخامس، فوق هوغو."},{"fr":"Je viens d’Écosse, mais je vis à Paris depuis un mois.","ar":"آتي من اسكتلندا، لكنني أسكن في باريس منذ شهر."}]},{"tFr":"Les erreurs de Sam corrigées (bon/bien, avec/chez, chaud)","tAr":"تصحيح أخطاء سام: الترجمة الحرفية","body":["«Je parle bon français» ← «Je parle bien français»: الفعل يُوصف بالظرف bien (بشكل جيد) لا بالصفة bon — القاعدة: الصفة للاسم، والظرف للفعل.","«Je veux dormir avec toi» ← «Je veux dormir chez toi»: dormir avec تعني النوم في السرير نفسه (إيحاء عاطفي!)، بينما dormir chez تعني المبيت في منزل الشخص — وحرف واحد يقلب المعنى.","«Je suis d’Amérique, j’habite Sam» ← «Je suis Sam, je viens d’Amérique»: الاسم مع Je suis / Je m’appelle، والأصل مع Je viens de — ولا يُبنى الفعلان بالتبادل.","«Je suis chaud !» ← «J’ai chaud !»: الشعور الجسدي بالحرارة مع Avoir — أما Être chaud فمعنى عامي غير لائق أو «متحمس» — وهو أشهر أخطاء الناطقين بالإنجليزية (I am hot)."],"ex":[{"fr":"Je parle bien français.","ar":"أتحدث الفرنسية جيداً."},{"fr":"Je veux dormir chez toi.","ar":"أريد المبيت عندك (في منزلك)."},{"fr":"J’ai chaud !","ar":"أشعر بالحر!"}]},{"tFr":"Avoir chaud, faim, besoin... vs Être","tAr":"تعبيرات (Avoir) الجسدية مقابل (Être)","body":["مع Avoir وبلا أداة: «avoir chaud / froid» (الحر/البرد) ← «Tu as chaud ؟ — Oui, j’ai chaud»، و«avoir faim / soif» (الجوع/العطش)، و«avoir la forme» (النشاط) ← «Tu as la forme ؟».","«avoir besoin de + اسم/مصدر» (يحتاج): «Tu as besoin d’une douche» (بحاجة لاستحمام)، و«Je n’ai pas besoin de te donner une raison» — و«avoir le droit de + مصدر» (الحق): «Personne n’a le droit d’utiliser mon vélo».","القاعدة الذهبية: الحالات الجسدية والاحتياجات مع avoir، والصفات الثابتة مع être — ومن يخلطهما يقول عن نفسه ما لا يقصد (chaud مثالاً)."],"ex":[{"fr":"Tu as besoin d’une douche.","ar":"أنت بحاجة إلى استحمام."},{"fr":"Tu as la forme ?","ar":"هل أنت بنشاطك؟"}]},{"tFr":"Venir de/d’/des + Habiter en/dans","tAr":"حروف الجر مع الدول والأماكن","body":["Venir (يأتي من): «venir de / d’» + دولة مؤنث أو بادئة بصوتي — «Je viens d’Amérique / de France» — و«venir des» + دولة جمع — «Ça vient des USA / des États-Unis».","Habiter (يسكن في): «habiter en» + دولة مؤنث — «J’habite en France / en Amérique» — و«habiter dans» + مكان محدد بأداة — «Tu habites dans un musée ؟».","مثال الحلقة الجامع: «Je suis Sam, je viens d’Amérique» — الاسم ثم الأصل، وكل فعل بحرف جره الذي لا يقبل التبادل."],"ex":[{"fr":"Je viens d’Amérique.","ar":"أنا قادم من أمريكا."},{"fr":"Tu habites dans un musée ?","ar":"هل تسكن في متحف؟"}]}],"mistakes":[{"wrong":"« Je suis de Londres » مع التحدث عن الرحلة","right":"« Je viens de Londres »","why":"être de تعني الأصل الدائم، venir de تعني نقطة الانطلاق الحالية."},{"wrong":"« Je m’appelle est Sam »","right":"« Je m’appelle Sam »","why":"الاسم يأتي مباشرة بعد appelé دون فعل être."},{"wrong":"« J’habite en Paris »","right":"« J’habite à Paris »","why":"المدن تأخذ à، لا en (en استثناء لبعض البلدان في صيغة الإقامة: en France)."},{"wrong":"« Tu habites où ? » في أول لقاء مع شخص أكبر","right":"« Où habitez-vous ? »","why":"مع الجار الكبير أو المجهول تبدأ بـvous — النبرة الصاعدة مع tu تبدو فورية."},{"wrong":"«Je parle bon français»","right":"«Je parle bien français»","why":"الفعل يُوصف بالظرف bien لا بالصفة bon."},{"wrong":"«je veux dormir avec toi» (لضيف)","right":"«je veux dormir chez toi»","why":"avec تعني السرير نفسه؛ والمبيت عند شخص هو chez."}],"dialogues":[{"title":"المشهد الأول: الرسالة المفاجئة من أمريكا (La lettre d’Amérique)","ctx":"الشخصيات: ساشا (Sacha)، آني (Annie) وكلبها لولو (Loulou)، ونيكو (Nico) — النص بعد تنقيح المفرغ.","lines":[{"who":"Voix off","fr":"C’est l’histoire de Sacha et d’Annie qui partagent un appartement en France. Elles ont un voisin, Nico, qui est amoureux de Sacha. Et Annie est amoureuse de Nico ! Jusqu’ici, tout va bien. Mais Sacha reçoit une lettre d’Amérique...","ar":"الراوي: هذه قصة ساشا وآني اللتين تتشاركان شقة في فرنسا. لديهما جار اسمه نيكو، وهو مغرم بساشا. وآني مغرمة بنيكو! حتى الآن، كل شيء يسير على ما يرام. لكن ساشا تتلقى رسالة من أمريكا..."},{"who":"Sacha","fr":"Patrick, c’est fini entre nous ! Ne m’appelle plus « Cha-Cha » ! Oui, j’ai bien reçu ton coussin, mais c’est fini, désolée ! Salut !","ar":"ساشا: (في الهاتف) باتريك، انتهى كل شيء بيننا! لا تنادني «شا-شا» بعد الآن! نعم، لقد استلمت وسادتك، لكن الأمر انتهى، آسفة! سلام!"},{"who":"Annie","fr":"Sacha, le courrier ! Louis et moi avons le courrier ! Loulou, donne le courrier !","ar":"آني: ساشا، البريد! لوي وأنا أحضرنا البريد! لولو، أعطني البريد!"},{"who":"Sacha","fr":"Factures : téléphone, gaz, électricité, eau... Qu’est-ce que c’est que ça ?","ar":"ساشا: فواتير: هاتف، غاز، كهرباء، ماء... ما هذا يا ترى؟"},{"who":"Annie","fr":"Sacha, il y a une lettre pour toi !","ar":"آني: ساشا، توجد رسالة لكِ!"},{"who":"Sacha","fr":"Super ! C’est de ma mère : « Sacha ma chérie, voici ce qui est arrivé pour toi. As-tu bien reçu les slips ? Bisous, câlins, Maman. » Ça vient des USA !","ar":"ساشا: رائع! إنها من أمي: «عزيزتي ساشا، إليكِ ما وصل من أجلك. هل استلمتِ الملابس الداخلية؟ قبلاتي وأحضاني، أمي.» إنها قادمة من الولايات المتحدة!"},{"who":"Annie","fr":"Des USA ? De qui ? Qu’est-ce qu’elle dit, la lettre ?","ar":"آني: من الولايات المتحدة؟ من مَن؟ ماذا تقول الرسالة؟"},{"who":"Sacha","fr":"Alors, elle dit : « Salut ! Tu te souviens de moi ? Il y a sept ans, tu étais ma correspondante. » Ah ouais, je me souviens maintenant, c’est Sam ! Sam Scott, mon correspondant il y a sept ans ! « Je parle bon français maintenant... » « ... et j’arrive en France ! Je veux dormir avec toi. As-tu un lit pour moi ? » Ah ! Il veut dormir chez moi ! « J’arrive le 14 juillet. »","ar":"ساشا: حسناً، تقول: «مرحباً! هل تتذكرينني؟ قبل سبع سنوات، كنتِ صديقتي بالمراسلة.» آه نعم، أتذكر الآن، إنه سام! سام سكوت، صديقي بالمراسلة قبل سبع سنوات! «أنا أتحدث فرنسية طيبة الآن...» «... وأنا قادم إلى فرنسا! أريد أن أنام معكِ. هل لديكِ سرير لي؟» آه! يقصد أنه يريد المبيت عندي (في منزلي)! «سأصل في 14 يوليو.»"},{"who":"Annie","fr":"Le 14 juillet ? Mais c’est aujourd’hui !","ar":"آني: الرابع عشر من يوليو؟ ولكن هذا اليوم!"},{"who":"Nico","fr":"Salut les filles ! Ça va ? Tu as la forme ? Je vous ai ramené votre lait.","ar":"نيكو: مرحباً يا بنات! كيف الحال؟ هل أنتما بخير؟ لقد أعدت لكما الحليب الخاص بكما."},{"who":"Sacha","fr":"Notre lait ? Tu veux dire notre lait d’il y a trois semaines ?","ar":"ساشا: حليبنا؟ أتقصد حليبنا منذ ثلاثة أسابيع؟"},{"who":"Nico","fr":"Je n’oublie jamais rien ! Alors, quoi de neuf ?","ar":"نيكو: أنا لا أنسى شيئاً أبداً! إذن، ما الجديد؟"},{"who":"Annie","fr":"Nico, tu veux boire quelque chose ?","ar":"آني: نيكو، هل تريد أن تشرب شيئاً؟"},{"who":"Nico","fr":"Oui, un Coca, s’il te plaît.","ar":"نيكو: نعم، كوكاكولا من فضلك."},{"who":"Annie","fr":"Sacha a de la visite : Sam, d’Amérique !","ar":"آني: ساشا لديها زيارة (ضيف): سام، من أمريكا!"},{"who":"Nico","fr":"Un Américain ? Elle est comment ?","ar":"نيكو: أمريكي؟ كيف تبدو هي؟"},{"who":"Sacha","fr":"C’est pas « elle », c’est « il » ! C’est pas une fille, c’est un garçon, un mec !","ar":"ساشا: ليست «هي»، بل «هو»! ليست فتاة، بل شاب (رجل)!"}]},{"title":"المشهد الثاني: وصول سام وأخطاؤه الطريفة (L’arrivée de Sam)","ctx":"الشخصيات: سام (Sam)، ساشا، آني، ونيكو — الترجمة الحرفية تصنع الكوميديا.","lines":[{"who":"Sam","fr":"Bonjour ! Je suis d’Amérique, j’habite Sam !","ar":"سام: مرحباً! أنا من أمريكا، أنا أسكن سام!"},{"who":"Sacha","fr":"Tu veux dire : « Je suis Sam » !","ar":"ساشا: تقصد أن تقول: «أنا أكون سام»!"},{"who":"Sam","fr":"Tu es Sam ?","ar":"سام: هل أنتِ سام؟"},{"who":"Annie","fr":"Non, je m’appelle Annie ! Elle veut dire : « Je suis Sam, je viens d’Amérique » !","ar":"آني: لا، أنا اسمي آني! هي تقصد أن تقول أنت: «أنا سام، أنا قادم من أمريكا»!"},{"who":"Sam","fr":"Mes petites voitures !","ar":"سام: (يعرض صوراً) سياراتي الصغيرة!"},{"who":"Sacha","fr":"Tu joues aux petites voitures ?!","ar":"ساشا: هل تلعب بالسيارات الصغيرة (ألعاب الأطفال)؟!"},{"who":"Sam","fr":"Oui, j’ai des voitures ! J’adore la bibliothèque... et j’habite ici.","ar":"سام: نعم، لدي سيارات! أعشق المكتبة... وأسكن هنا (يشير لصورة قصر فخم)."},{"who":"Sacha","fr":"Mais c’est un musée ! Tu habites dans un musée ?","ar":"ساشا: ولكن هذا متحف! هل تسكن في متحف؟"},{"who":"Annie","fr":"Il veut dire qu’il travaille dans un musée !","ar":"آني: إنه يقصد أنه يعمل في متحف!"},{"who":"Sacha","fr":"Nous allons te montrer le reste de l’appartement. Voici la chambre.","ar":"ساشا: سنريك باقي الشقة. ها هي غرفة النوم."},{"who":"Sam","fr":"C’est mon lit ?","ar":"سام: هل هذا سريري؟"},{"who":"Sacha","fr":"Non, c’est notre chambre. Il n’y a qu’une chambre !","ar":"ساشا: لا، هذه غرفتنا. لا توجد سوى غرفة نوم واحدة!"},{"who":"Sam","fr":"J’ai vingt-deux (22) chambres !","ar":"سام: أنا لدي اثنتان وعشرون غرفة نوم!"},{"who":"Annie","fr":"Il veut dire deux (2) !","ar":"آني: إنه يقصد غرفتين (2)!"},{"who":"Sacha","fr":"Bon, tu vas dormir ici (sur le canapé-lit).","ar":"ساشا: حسناً، ستنام هنا (على الأريكة السرير)."},{"who":"Sam","fr":"Bonjour, qui es-tu ? Ah, tu es le porteur ! Super ! Mes valises sont en bas, s’il vous plaît.","ar":"سام: (لنيكو الداخل فجأة) مرحباً، من أنت؟ آه، أنت حامِل الحقائب! رائع! حقائبي في الأسفل، من فضلك."},{"who":"Nico","fr":"Moi, le porteur ?! Je suis Nico, je suis le voisin !","ar":"نيكو: أنا حامِل الحقائب؟! أنا نيكو، أنا الجار!"}]},{"title":"المشهد الثالث: مقلب نيكو وسر سام (La blague et le secret)","ctx":"الشخصيات: نيكو، سام، ساشا، وآني — الجمل المسمومة، الحمّام، ثم مجلة المشاهير.","lines":[{"who":"Nico","fr":"Alors, ça c’est le four. Tu dis à Annie : « Le chien d’Annie dort dans le four ». Et Sacha, elle aime les hommes musclés : fais 50 kilomètres sur son vélo !","ar":"نيكو: حسناً، هذا هو الفرن. قل لآني: «كلب آني ينام في الفرن». وساشا تحب الرجال ذوي العضلات: قم بقيادة دراجتها لمسافة 50 كيلومتراً!"},{"who":"Sam","fr":"Sacha, regarde : 50 kilomètres ! Et Annie : le chien est dans le four !","ar":"سام: ساشا، انظري: 50 كيلومتراً! وآني: الكلب في الفرن!"},{"who":"Sacha","fr":"Il s’est servi de mon vélo !","ar":"ساشا: لقد استخدم دراجتي!"},{"who":"Annie","fr":"Et il dit que le chien était dans le four ! C’est pas drôle, il doit partir !","ar":"آني: ويقول إن الكلب كان في الفرن! هذا ليس مضحكاً، يجب أن يرحل!"},{"who":"Sam","fr":"Je suis chaud !","ar":"سام: أنا ساخن (مثير)!"},{"who":"Sacha","fr":"Non, tu as chaud ! Tu as besoin d’une douche.","ar":"ساشا: لا، بل قل: أنا أشعر بالحر! أنت بحاجة إلى استحمام."},{"who":"Nico","fr":"Quel est le problème ? C’est toi là, Sam ? La famille Scott... une des familles les plus riches des États-Unis ?! Et eux, tes employés ? Et de vraies voitures ?! Mais Sam, tu es riche ! Pourquoi rester ici ?","ar":"نيكو: (بعد سقوط الصور) ما المشكلة؟ هل هذا أنت هنا يا سام؟ عائلة سكوت... واحدة من أغنى العائلات في الولايات المتحدة؟! وهؤلاء موظفوك؟ وسيارات حقيقية؟! ولكن يا سام، أنت ثري! لماذا تبقى هنا؟"},{"who":"Sam","fr":"Je veux des amis... de vrais amis. Les gens m’aiment pour mon argent.","ar":"سام: أريد أصدقاء... أصدقاء حقيقيين. الناس يحبونني من أجل مالي."},{"who":"Nico","fr":"C’est terrible, ça. Écoute, on garde le secret, on n’en parle pas aux filles !","ar":"نيكو: هذا أمر فظيع. اسمع، سنحفظ السر، لن نخبر الفتاتين بذلك!"},{"who":"Sacha","fr":"C’est Sam ! Il est millionnaire ! Sam reste avec nous ! Viens t’asseoir, et s’il te plaît, appelle-moi « Cha-Cha » !","ar":"ساشا: (بعد اكتشاف الحقيقة من مجلة المشاهير) إنه سام! إنه مليونير! سام سيبقى معنا! تعال واجلس، ومن فضلك، نادني «شا-شا»!"}]}],"exercises":[{"t":"mcq","skill":"listening","q":"في أول لقاء، أي جملة تُقال بالضبط بعد الاسم؟","opts":["Enchanté(e) !","Bonne nuit !","À demain !","Bon appétit !"],"a":0,"why":"enchanté(e) هي تعبير التعارف القياسي."},{"t":"fill","skill":"speaking","q":"أكمل: «Je ___ anglaise, je viens de Londres.»","fr":"Je ___ anglaise, je viens de Londres.","ans":"suis","alts":["Suis"],"why":"الصفة الوطنية مع être."},{"t":"mcq","skill":"grammar","q":"الخيار الصحيح مع المدن:","opts":["J’habite en Paris","J’habite à Paris","J’habite de Paris","J’habite au Paris"],"a":1,"why":"المدن الفرنسية الكبيرة تأخذ à؛ en France فقط مع البلد بصيغة الإقامة."},{"t":"order","skill":"writing","q":"رتّب جملة التعارف: الاسم ← الأصل ← الشكر","words":["Je","m’appelle","Sam,","je","viens","de","Londres,","merci","de","votre","accueil."],"ans":"Je m’appelle Sam, je viens de Londres, merci de votre accueil.","why":"الترتيب المنطقي للتعارف: من أنا ← من أين ← امتنان."},{"t":"listen","skill":"listening","q":"ما السؤال الذي يُسأل عن مدة الإقامة؟","opts":["Tu restes combien de temps ?","Tu habites où ?","Tu fais quoi ?","C’est quoi ton nom ?"],"a":0,"why":"combien de temps هو مؤشر المدة."},{"t":"translate","skill":"writing","q":"ترجم: أهلاً بك في عمادرتنا، أنا حارسة العمارة.","ans":"Bienvenue dans notre immeuble, je suis la concierge.","alts":["Bienvenue au notre immeuble, je suis la concierge."],"why":"concierge اسم وظيفة وأنثوي بالضبط مع la."},{"t":"speaking","skill":"speaking","q":"عرّف بنفسك في ثلاث جمل: الاسم، المهنة، البلد — بصوت عالٍ.","target":"Je m’appelle…, je suis…, je viens de…","why":"قاعدة التعارف الثلاثية هي هدف الحلقة."},{"t":"correct","skill":"grammar","q":"صحّح الخطأ: «J’habite en Paris au deuxième étage.»","ans":"J’habite à Paris au deuxième étage.","why":"المدن مع à وليس en."},{"t":"correct","skill":"writing","q":"صحح كما تعلمنا من سام: «Je parle bon français maintenant. → ...»","ans":"Je parle bien français maintenant","alts":["Je parle bien français maintenant."],"why":"الفعل يُوصف بالظرف bien لا بالصفة bon."},{"t":"correct","skill":"writing","q":"صحح كما تعلمنا من سام: «Après 50 kilomètres, je suis très chaud ! → ...»","ans":"Après 50 kilomètres, j’ai très chaud !","alts":["Après 50 kilomètres, j’ai très chaud !"],"why":"الشعور بالحرارة مع Avoir: j’ai chaud."},{"t":"correct","skill":"writing","q":"صحح كما تعلمنا من سام: «Bonjour, j’habite Sam et je suis d’Amérique. → ...»","ans":"Bonjour, je m’appelle Sam et je viens d’Amérique.","alts":["Bonjour, je suis Sam et je viens d’Amérique.","Bonjour, je suis Sam et je viens d’Amérique"],"why":"الاسم مع s’appeler / suis، والأصل مع venir de."},{"t":"correct","skill":"writing","q":"صحح كما تعلمنا من سام: «... je veux dormir avec toi ! → ...»","ans":"Salut Sacha, je suis ton correspondant, je veux dormir chez toi !","alts":["je veux dormir chez toi"],"why":"المبيت عند شخص هو dormir chez لا avec."},{"t":"fill","skill":"grammar","q":"أكمل: «Cette lettre (___) des États-Unis.»","fr":"Cette lettre (___) des États-Unis.","ans":"vient","alts":["Vient"],"why":"المفرد الغائب مع venir يأخذ vient، والدولة الجمع مع des."},{"t":"fill","skill":"grammar","q":"أكمل: «... elle (___) pour Sacha.»","fr":"... elle (___) pour Sacha.","ans":"est","alts":["Est"],"why":"الغائب مع être يأخذ est."},{"t":"fill","skill":"grammar","q":"أكمل: «Sam (___) besoin d’une douche.»","fr":"Sam (___) besoin d’une douche.","ans":"a","alts":["A"],"why":"الاحتياج مع avoir: il a besoin de."},{"t":"fill","skill":"grammar","q":"أكمل: «... parce qu’il (___) chaud.»","fr":"... parce qu’il (___) chaud.","ans":"a","alts":["A"],"why":"الشعور بالحرارة مع avoir: il a chaud."},{"t":"fill","skill":"grammar","q":"أكمل: «Nico (___) amoureux.»","fr":"Nico (___) amoureux.","ans":"est","alts":["Est"],"why":"الصفة الثابتة مع être: il est amoureux."},{"t":"fill","skill":"grammar","q":"أكمل: «Nico est amoureux (___) Sacha.»","fr":"Nico est amoureux (___) Sacha.","ans":"de","alts":["De","d’"],"why":"amoureux de + الاسم."},{"t":"fill","skill":"grammar","q":"أكمل: «Sam reste dormir (___) Sacha et Annie.»","fr":"Sam reste dormir (___) Sacha et Annie.","ans":"chez","alts":["Chez"],"why":"المبيت عند شخص: dormir chez."},{"t":"mcq","skill":"speaking","q":"«Quoi de neuf ?» تعني:","opts":["ما الأخبار الجديدة؟","لم أعد أحتمل!","لا يهمني!"],"a":0,"why":"السؤال عن الأخبار بين الشباب."},{"t":"mcq","skill":"speaking","q":"«Je n’en peux plus !» تعني:","opts":["لم أعد أحتمل!","هل تتذكرني؟","إنه شاب!"],"a":0,"why":"نفاد الصبر (Courant)."},{"t":"mcq","skill":"speaking","q":"«Ça m’est égal !» تعني:","opts":["لا يهمني!","كل شيء على ما يرام","ما الجديد؟"],"a":0,"why":"عدم الاكتراث (Courant)."}],"homework":"شاهد الحلقة كاملة ثلاث مرات (تعمّم ← تدقيق ← تكرار)، ثم سجّل حوار تعارف من ثمانية أسطر مع شخص حقيقي (جار أو زميل) وقارن نبرتك بنبرة Sam في الفيديو.","sources":[{"title":"Extra French episode 1 with french subtitles","channel":"Frenchy french","videoId":"EaNqp4FXh-s","why":"الحلقة الأولى كاملة بترجمة فرنسية: Sam تصل إلى باريس وتلتقي بجيرانها — أساس المحادثة الأولى في السلسلة.","cat":"Séries","level":"B1","main":true},{"title":"Extra French Series - Episode 1 (French & English Subtitles)","channel":"Learn French With Nessa","videoId":"tvWPDhISeaI","why":"نفس الحلقة بترجمة فرنسية + إنجليزية — مفيد لمقارنة ما فهمته بالعربية مع المعنى الإنجليزي.","cat":"Séries","level":"B1","extra":true},{"title":"Extra French Series: Episode 1: Part 3 (Eng & Fr Subtitles)","channel":"Learn French With Nessa","videoId":"O--hPowS8Ic","why":"الجزء الأخير من الحلقة مقطّعاً — مثالي للاستهداف السريع وتركيز الانتباه على خاتمة الحوار.","cat":"Séries","level":"B1","extra":true}],"supplements":[{"id":"tvWPDhISeaI","title":"Extra French Series - Episode 1 (French & English Subtitles)","channel":"Learn French With Nessa","why":"نفس الحلقة بترجمة فرنسية + إنجليزية — مفيد لمقارنة ما فهمته بالعربية مع المعنى الإنجليزي.","lang":"fr","dur":10},{"id":"O--hPowS8Ic","title":"Extra French Series: Episode 1: Part 3 (Eng & Fr Subtitles)","channel":"Learn French With Nessa","why":"الجزء الأخير من الحلقة مقطّعاً — مثالي للاستهداف السريع وتركيز الانتباه على خاتمة الحوار.","lang":"fr","dur":8}],"videoAfterObjectives":true,"dialoguesAfterObjectives":true},{"id":"b1-t8-l2","fr":"Extra — Épisode 2 : Sam fait du shopping","ar":"Extra — الحلقة 2: Sam تتسوّق مع Hugo","objectives":["الدخول إلى متجر ملابس والحديث مع البائع بلباقة (Je voudrais... s’il vous plaît).","السؤال عن المقاسات والأطوال والقياسات، وإبداء الرأي في الموضة (كلاسيكي، كاوبوي، موتار).","القواعد: صيغة الطلب المهذب (Je voudrais)، والتمييز بين المتشابهات (Pommes / Pommes de terre)، وأدوات التجزئة والأعداد الكبيرة.","الثقافة: التسوق الإلكتروني (Le shopping sur Internet) وحياة السكن المشترك."],"sections":[{"h":"الحلقة 2: التسوّق، الملابس، والألوان (الحلقة كاملة)","video":{"id":"VOLDwbnpmb0","title":"Extra French episode 2 with french subtitles","channel":"Frenchy french","why":"الحلقة الثانية كاملة: Sam وHugo في متجر الملابس — درس عملي في الألوان والمقاسات والأسعار.","lang":"fr","main":true,"dur":24},"p":["في الحلقة الثانية ينتقل التدريب من التعارف إلى الحياة اليومية: Hugo يأخذ Sam إلى متجر الملابس في شارع تجاري باريسي. المشهد بسيط لكنه يغطّي حاجاتك الأولى للتسوّق: ماذا تسأل، كيف ترفض، وكيف تسأل عن السعر دون إحراج.","داخل المتجر تتكرر ثلاثة أنواع من الجمل: وصف القطعة (« Ce pull est joli »)، السؤال عن المقاس (« Vous l’avez en taille M ? »)، والقرار (« Je le prends » أو « Non merci, c’est trop cher »). لاحظ أن الفعل prendre هنا يعني «آخذه» — من أكثر الأفعال تكراراً في السياق التجاري.","الألوان في الفرنسية تتفق مع الجنس والعدد: un t-shirt rouge (مفرد)، des chaussures noires (جمع). الحلقة تجبرك على سماع هذا الاتفاق في حوار سريع — وهو أسرع طريق لترسيخه.","من حيث الإيقاع، هذه الحلقة أسرع من الأولى؛ استعمل تقنية «التوقف عند القرار»: أوقف الفيديو قبل أن يقول المشتري رأيه، وخمّن الجملة التالية بناءً على نبرة الصوت. هذه التمارين تبني حدس الفهم المستقبلي.","مفردة « essayez » من essayer (يقيس/يجرّب) تظهر هنا بصيغة الأمر للمخاطب — مراجعة سريعة للأمر مع être/avoir والشاذات (essaie, essayons, essayez).","بعد الحلقة، ادخل إلى أي متجر واطلب ثلاث قطع بالفرنسية عقلياً: السؤال، المقاس، السعر. إن استطعت بناء هذه الجمل الثلاث فأنت جاهز للحلقة الثالثة."],"sub":[{"h":"جمل التسوّق الأساسية","p":["Tu cherches quoi, exactement ?","Ce pull est joli, mais c’est un peu trop cher.","Vous l’avez en taille moyenne ?","Je le prends ! Et toi, tu essaies quoi ?"]},{"h":"أدوات نطقية: elision مع le/la في الكلام","p":["« Je le prends » تُنطق [ʒə lə pʁɑ̃] كأنها كلمة واحدة.","« c’est un peu » → [sɛ.tœ̃ pø]: elision قلبية مع un.","« trop cher » تسمع الراء الفرنسية القصيرة بوضوح — لا تُطوّلها."]},{"h":"خطوات Listen & Repeat","p":["ركز في المرة الأولى على الألوان فقط واكتبها كلما سمعتها.","في المرة الثانية كرّر جمل السعر بالضبط مع نبرة السؤال الصاعدة.","سجّل نفسك تصف ثلاث قطع ملابس في 30 ثانية."]}]},{"h":"النصوص الحوارية المصححة (Corpus des Dialogues)","p":["النص في تبويب «حوارات» هو المفرغ الأكاديمي للحلقة — ثلاثة مشاهد: التخطيط للموضة، تمرين المتجر الوهمي، وكارثة التسوق الإلكتروني.","المشهد الأول: تشخيص الموضة («tellement démodés !») ثم اقتراحات الأنماط (cowboy / motard) ثم توزيع المهام («je m’occupe des jambes... et Nico... de rien du tout !»).","المشهد الثاني: الطلب المهذب النموذجي («je voudrais un pantalon, s’il vous plaît») ثم الخطأ الصوتي الأشهر («un chameau pour ma tête» ← «un chapeau !») — حرف واحد يحوّل القبعة إلى جمل.","المشهد الثالث: فخاخ الإنترنت («J’ai commandé des pommes !» ← «6 kilos de pommes de terre !») والرقم القاتل (12 ← 12 علبة = 144 بيضة + 400 علبة للكلب) — درس الأعداد والأدوات حيّاً.","طريقة العمل: مثّل مشهد المتجر بائعاً وزبوناً بصيغة Je voudrais، ثم اكتب قائمة تسوق إلكترونية وهمية وراجعها كلمة كلمة قبل «الضغط على زر الشراء»."]},{"h":"عبارات المتجر التي تتكرر","p":["« Vous l’avez en… ? » سؤال المتوفر: بديل مهذّب لـ« Est-ce que vous avez… » في المتاجر.","« Essayez-le, c’est sans problème » — elision: essayez + le = essayez-le، وتعبير sans problème = «لا مشكلة» شائع جداً في الفرنسية اليومية.","« C’est combien ? / Ça fait combien ? » كلاهما صحيح للسؤال عن السعر، والثاني أكثر عامّية.","« Je regarde, merci » جملة الرفض المهذّب المثالية: لا ترفض بشدة بل تؤجّل القرار."]},{"h":"الأفعال الكلامية والتواصل (Actes de Parole)","p":["الطلب المهذب في المتجر: «Je voudrais un pantalon, s’il vous plaît» و«Je voudrais une chemise» و«Et des chaussures, s’il vous plaît» — الصيغة نفسها للمطعم والخدمات.","السؤال عن المقاس والرأي: المقاس (la taille)، والطول، وإبداء الرأي في الأنماط (classique / cowboy / motard / tendance / démodé) — والبائع يرد بالاقتراح لا بالفرض.","التسوق الإلكتروني: «commander sur Internet»، وتحديد الكمية بالرقم والوحدة (6 kilos de..., une douzaine d’œufs, 400 boîtes) — والخطأ هنا مكلف حرفياً كما اكتشف سام."]},{"h":"ثقافة وحضارة: التسوق والسكن المشترك (Civilisation)","p":["التسوق الإلكتروني (Le shopping sur Internet): شراء الملابس والمواد الغذائية بالبطاقة المصرفية (la carte bancaire) مع خطر سوء الفهم اللغوي — فلا بائع يصحح لك قبل الدفع كما في المتجر الحقيقي.","السكن المشترك: الشقة مسرح التفاعل الكوميدي بين الشباب — توزيع المهام («un petit peu chacun»)، والقرارات الجماعية حول ضيف جديد، وهي صورة مصغرة للحياة الطلابية الفرنسية."]},{"h":"تمرين الحلقة","p":["تمرين التسوق العقلي: افتح كتالوجاً أو متجر إلكترونياً واوصف ثلاث قطع بالفرنسية: النوع، اللون، السعر، ثم قرّر أيها ستختار ولماذا.","تمرين القيادة: شخص يبيع وآخر يشتري؛ المشتري يجب أن يسأل عن قطعتين على الأقل ويرفض واحدة بأدب ثم يقبل الثانية.","كتابة: رسالة قصيرة إلى صriend تصف فيها ما اشتريته اليوم (ثلاث جمل على الأقل) مستعملاً avoir + mal/cher."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: أتقنت مفردات التسوّق (taille, prix, essayer, prendre) واتفاق الألوان مع الجنس والعدد، ورفض «Je regarde, merci» المهذّب، والضمير le/la مع acheter وprendre. أعد مشاهدة الفيديو الرئيسي وركّز على مشهد الكاونتر: السؤال عن المقاس ثم قرار الشراء.","جسر الدروس: من b1-t8-l1 (الوصول والتعارف في العمارة) إلى b1-t8-l2 (التسوّق والملابس والألوان)، ثم إلى b1-t8-l3 حيث يبدأ نقاش السكن المشترك: الميزانية والتنظيف واتفاقات التعايش.","مهمة تطبيقية: صف ثلاث قطع من متجر ثم سجّل صوتك أو اكتب في دقيقة مشهداً قصيراً (سؤال ← وصف ← قرار) مستعملاً 3 كلمات جديدة من الحلقة، وقارن جملك بجملة البائع في الفيديو الرئيسي."]}],"pron":[{"w":"le pull","ipa":"[lə pyl]","approx":"لو بُل"},{"w":"la taille","ipa":"[la taj]","approx":"لا تاي"},{"w":"combien","ipa":"[kɔ̃.bjɛ̃]","approx":"كونبيان"}],"vocab":[{"fr":"le pull","ar":"السترة الصوفية/الكنزة","pos":"nom","g":"m","exFr":"Ce pull me va très bien.","ipa":"[lə pyl]","exAr":"هذه الكنزة تناسبني جيداً."},{"fr":"la taille","ar":"المقاس","pos":"nom","g":"f","exFr":"Vous avez une taille plus grande ?","ipa":"[la taj]","exAr":"هل لديكم مقاس أكبر؟"},{"fr":"les chaussures","ar":"الحذاء","pos":"nom","g":"f pl","exFr":"Ces chaussures sont confortables.","ipa":"[le ʃo.syʁ]","exAr":"هذا الحذاء مريح."},{"fr":"rouge / noir / bleu","ar":"أحمر / أسود / أزرق","pos":"adj.","g":"","exFr":"Je cherche une veste noire.","ipa":"","exAr":"أبحث عن سترة سوداء."},{"fr":"le prix","ar":"السعر","pos":"nom","g":"m","exFr":"Le prix est correct.","ipa":"[lə pʁi]","exAr":"السعر مناسب."},{"fr":"cher / trop cher","ar":"غالٍ / غالٍ جداً","pos":"adj.","g":"","exFr":"C’est trop cher pour moi.","ipa":"","exAr":"هذا غالٍ جداً عليّ."},{"fr":"essayer (quelque chose)","ar":"يقيس/يجرّب (قطعة ملابس)","pos":"verbe","g":"","exFr":"Je voudrais essayer cette veste.","ipa":"","exAr":"أودّ أن أقيس هذه السترة."},{"fr":"prendre (je le prends)","ar":"يأخذ (آخذه)","pos":"verbe","g":"","exFr":"Elle prend la robe bleue.","ipa":"","exAr":"تأخذ الفستان الأزرق."},{"fr":"l’argent","ar":"المال/النقود","pos":"nom","g":"m","exFr":"Je n’ai pas assez d’argent.","ipa":"[laʁ.ʒɑ̃]","exAr":"ليس لديّ ما يكفي من المال."},{"fr":"la carte bancaire","ar":"بطاقة الصراف الآلي","pos":"nom","g":"f","exFr":"Vous acceptez la carte bancaire ?","ipa":"","exAr":"هل تقبلون البطاقة البنكية؟"},{"fr":"un magasin","ar":"متجر","pos":"nom","g":"m","exFr":"Ce magasin ferme à dix-neuf heures.","ipa":"","exAr":"هذا المتجر يغلق في السابعة مساءً."},{"fr":"une robe / un pantalon","ar":"فستان / بنطال","pos":"nom","g":"f/m","exFr":"Elle essaie une robe rouge.","ipa":"","exAr":"تقيس فستاناً أحمر."},{"fr":"le shopping","ar":"التسوق","pos":"nom","g":"m","exFr":"On va faire du shopping pour Sam.","exAr":"سنقوم بالتسوق من أجل سام.","ipa":"ʃɔpiŋ"},{"fr":"un vêtement / une fringue","ar":"لباس / قطعة ملابس (عامية fringue)","pos":"nom","exFr":"Les vêtements de Sam sont démodés !","exAr":"ملابس سام قديمة الطراز!","ipa":"vɛtmɑ̃ / fʁɛ̃ɡ"},{"fr":"une chemise","ar":"قميص","pos":"nom","g":"f","exFr":"Je voudrais une chemise.","exAr":"أود قميصاً.","ipa":"ʃəmiz"},{"fr":"un chapeau / un chameau","ar":"قبعة / جمل","pos":"nom","g":"m","exFr":"Tu veux dire un chapeau !","exAr":"تقصد قبعة!","ipa":"ʃapo / ʃamo"},{"fr":"des pommes de terre","ar":"بطاطس","pos":"nom","g":"f","exFr":"6 kilos de pommes de terre !","exAr":"6 كيلوغرامات من البطاطس!","ipa":"pɔm də tɛʁ"},{"fr":"une boîte d’œufs","ar":"علبة بيض","pos":"nom","g":"f","exFr":"12 boîtes, 144 œufs au total !","exAr":"12 علبة، 144 بيضة بالمجمل!","ipa":"bwat dœf"},{"fr":"démodé(e)","ar":"قديم الطراز / غير مواكب للموضة","pos":"adj","exFr":"Tellement démodés !","exAr":"قديمة الطراز تماماً!","ipa":"demɔde"},{"fr":"tendance","ar":"عصري / مواكب للموضة","pos":"adj","exFr":"Un look tendance.","exAr":"إطلالة عصرية.","ipa":"tɑ̃dɑ̃s"}],"examples":[{"fr":"Ce pull est joli, mais c’est un peu trop cher.","ar":"هذه الكنزة جميلة، لكنها غالية قليلاً.","note":"الوصف ثم الرفض"},{"fr":"Vous l’avez en taille moyenne ?","ar":"هل لديكم مقاس متوسط؟","note":"en + taille"},{"fr":"Je le prends !","ar":"آخذه!","note":"قرار الشراء"},{"fr":"Je regarde, merci.","ar":"سأتفقّد فقط، شكراً.","note":"رفض مهذّب"},{"fr":"Ça fait combien en tout ?","ar":"كم المجموع؟","note":"en tout = المجموع"},{"fr":"Ces chaussures noires sont très confortables.","ar":"هذا الحذاء الأسود مريح جداً.","note":"الصفة تتفق مع الجمع"},{"fr":"Je voudrais un pantalon, s’il vous plaît.","ar":"أود بنطلوناً من فضلك.","note":"الطلب المهذب"},{"fr":"Ce ne sont pas des pommes, ce sont des pommes de terre !","ar":"هذه ليست تفاحاً بل بطاطس!","note":"التمييز الدلالي"},{"fr":"Un chameau ?! Tu veux dire un chapeau !","ar":"جمل؟! تقصد قبعة!","note":"التصحيح الفوري"}],"grammar":[{"tFr":"Place des adjectifs de couleur + accord","tAr":"مواضع ألوان الملابس وتوافقها","body":["ألوان الملابس تأتي بعد الاسم عادة: un t-shirt rouge، لكن الصفات القصيرة الشهيرة (beau, joli, grand, petit) تأتي قبل الاسم. « Une jolie robe rouge » هي الصيغة المعتادة: جمال ثم لون.","مع les في الجمع تُضاف s: des chaussures noires. لاحظ في الحلقة أن Hugo يقول « des chaussures noires » بنبرة ثقيلة على noir(e)s — استمع لها ثلاث مرات."],"ex":[{"fr":"Je cherche une veste bleue, s’il vous plaît.","ar":"أبحث عن سترة زرقاء من فضلك."},{"fr":"Il porte un pantalon noir et un pull gris.","ar":"يرتدي بنطالاً أسود وكنزة رمادية."}]},{"tFr":"Pronom COD avec acheter / prendre / essayer","tAr":"الضمير المباشر مع الشراء والأخذ والقياس","body":["عندما يكون الشيء مذكوراً سابقاً يحلّ الضمير le/la/l’ محلّه: « La veste ? Je l’achète. » — elision مع العين الصامتة: l’achète.","هذا الاستبدال يجعل الكلام أقصر وأسرع؛ في السياق التجاري ستجده في كل جملة تقريباً — تدرّب على استبدال ثلاثة أسماء بضمائر في جملتك القادمة."],"ex":[{"fr":"Tu prends ce sac ? Non, je le prends pas.","ar":"تأخذ هذه الحقيبة؟ لا، لن آخذها."},{"fr":"La robe, je l’essaie demain.","ar":"الفستان، سأقيسه غداً."}]},{"tFr":"Je voudrais : le conditionnel de politesse","tAr":"صيغة الطلب المهذب (Je voudrais)","body":["للطلب بلباقة نستخدم Vouloir بصيغة الشرط الحاضر: التركيب «Je voudrais + اسم الشيء + s’il vous plaît» — «Je voudrais un pantalon, s’il vous plaît» و«Je voudrais une chemise».","الصيغة نفسها تعمل في المطعم («Je voudrais un café») ومع الخدمات — وهي أرقى من «Je veux» المباشرة التي تُسمَع أمراً.","لاحظ التكرار المهذب في الحلقة: كل طلب يُتوَّج بـ «s’il vous plaît» — فالأدب في الفرنسية صيغة نحوية لا مجاملة."],"ex":[{"fr":"Je voudrais un pantalon, s’il vous plaît.","ar":"أود بنطلوناً من فضلك."},{"fr":"Je voudrais une chemise et des chaussures, s’il vous plaît.","ar":"أود قميصاً وأحذية من فضلك."}]},{"tFr":"Chapeau/chameau, pommes/pommes de terre : les quiproquos","tAr":"المتشابهات اللفظية: فخاخ سام","body":["«Chapeau» (قبعة) مقابل «Chameau» (جمل): خطأ نطقي واحد حوّل طلب غطاء الرأس إلى حيوان — والتصحيح الفوري («Tu veux dire un chapeau !») هو منهج الحلقة.","«Des pommes» (تفاح) مقابل «Des pommes de terre» (بطاطس): خطأ اختياري أدّى لشحنة 6 كيلوغرامات عبر الإنترنت — والكلمتان تشتركان في pommes لكن de terre تقلب المعنى.","القاعدة: في التسوق (خاصة الإلكتروني) راجع الاسم الكامل لا أوله — فالفرنسية مليئة بالأزواج الخادعة (œufs/boîtes, douzaine/douze)."],"ex":[{"fr":"Un chameau ?! Tu veux dire un chapeau !","ar":"جمل؟! تقصد قبعة!"},{"fr":"Ce ne sont pas des pommes, ce sont des pommes de terre !","ar":"هذه ليست تفاحاً بل بطاطس!"}]}],"mistakes":[{"wrong":"« Je cherche une veste rouge en grand »","right":"« Je cherche une veste rouge en taille grande »","why":"نقول en + taille + المقاس، لا in grand (أثر إنجليزي)."},{"wrong":"« C’est trop cher » مع أثاث صغير","right":"« C’est trop cher » مقبول، لكن للسمك نقول « c’est trop épais »","why":"cher تُستخدم للسعر فقط؛ الصفات الحسية تختلف."},{"wrong":"« J’ai un vingt ans »","right":"« J’ai vingt ans »","why":"مع avoir للأعمار لا يُستعمل أداة التعريف."},{"wrong":"رفض مباشر: « Non, je ne veux pas ! »","right":"« Non merci, je regarde. »","why":"في المتاجر الفرنسية الرفض يُلمَّع بأدب."},{"wrong":"«un chameau pour ma tête»","right":"«un chapeau pour ma tête»","why":"القبعة chapeau بحرف p واحد تنطق؛ والجمل chameau بميم."},{"wrong":"«Ce sont des pommes» (عن البطاطس)","right":"«Ce sont des pommes de terre»","why":"التفاح pommes وحده؛ والبطاطس pommes de terre كاملة."}],"dialogues":[{"title":"المشهد الأول: التخطيط لموضة سام (La planification)","ctx":"الشخصيات: ساشا (Sacha)، آني (Annie)، ونيكو (Nico) — توزيع المهام: الأسفل، الأعلى، ولا شيء.","lines":[{"who":"Annie","fr":"Les vêtements de Sam sont tellement démodés ! Je sais, je vais l’emmener faire du shopping.","ar":"آني: ملابس سام قديمة الطراز تماماً! أعلم، سأصطحبه للقيام بالتسوق."},{"who":"Nico","fr":"Non, il lui faut un look cowboy ! Une veste en cuir, une chemise à orge, un bandana et un gilet... le look motard !","ar":"نيكو: لا، إنه بحاجة إلى إطلالة راعي البقر! سترة من الجلد، قميص، باندانا وسترة... إطلالة راكب الدراجة النارية!"},{"who":"Sacha et Annie","fr":"Bon, ok, on va faire du shopping pour Sam, un petit peu chacun : je m’occupe des jambes, Annie s’occupe du haut, et Nico... de rien du tout !","ar":"ساشا وآني: حسناً، سنقوم بالتسوق من أجل سام، كل واحد منا قليلاً: أنا أهتم بالجزء السفلي، وآني بالجزء العلوي، ونيكو... لا شيء على الإطلاق!"}]},{"title":"المشهد الثاني: تمرين المتجر الوهمي (L’entraînement)","ctx":"الشخصيات: سام، ساشا، آني، ونيكو — الطلب المهذب ثم كارثة الجمل/القبعة.","lines":[{"who":"Sam","fr":"Bonjour, je voudrais un pantalon, s’il vous plaît. Et des chaussures, s’il vous plaît.","ar":"سام: صباح الخير، أود الحصول على بنطلون من فضلك. وأحذية من فضلك."},{"who":"Sam","fr":"Et un chameau pour ma tête, s’il vous plaît !","ar":"سام: (يخطئ بين chapeau وchameau): وجَمَلٌ لرأسي من فضلك!"},{"who":"Sacha","fr":"Un chameau ?! Tu veux dire un chapeau !","ar":"ساشا (تصحح له): جمل؟! تقصد قبعة!"}]},{"title":"المشهد الثالث: كارثة الإنترنت (La catastrophe d’Internet)","ctx":"الشخصيات: ساشا، آني، نيكو، وسام — التفاح الذي صار بطاطس، والرقم 12 الذي صار 144.","lines":[{"who":"Sacha","fr":"Sam, qu’est-ce que tu as fait sur Internet ?","ar":"ساشا: سام، ماذا فعلت على الإنترنت؟"},{"who":"Sam","fr":"J’ai commandé des pommes !","ar":"سام: طلبت تفاحاً!"},{"who":"Sacha","fr":"Ce ne sont pas des pommes, ce sont 6 kilos de pommes de terre ! Et ça, c’est quoi ? Une douzaine d’œufs ?","ar":"ساشا: هذه ليست تفاحاً، هذه 6 كيلوغرامات من البطاطس! وما هذا؟ دزينة من البيض؟"},{"who":"Sam","fr":"Non, j’ai mis le chiffre 12, alors j’ai acheté 12 boîtes (144 œufs au total) ! Et aussi 400 boîtes pour le chien !","ar":"سام: لا، لقد وضعت الرقم 12، لذا اشتريت 12 علبة (144 بيضة بالمجمل)! وأيضاً 400 علبة طعام للكلب!"}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما معنى « la taille » في المتجر؟","opts":["المقاس","اللون","السعر","الماركة"],"a":0,"why":"taille = المقاس في سياق الملابس."},{"t":"fill","skill":"speaking","q":"أكمل: «Ce pull est joli, mais il est ___ cher.»","fr":"Ce pull est joli, mais il est ___ cher.","ans":"trop","why":"trop = غالٍ جداً."},{"t":"mcq","skill":"grammar","q":"الصيغة الصحيحة لـ« فستان أحمر »:","opts":["une robe rouge","une rouge robe","une robes rouge","rouge une robe"],"a":0,"why":"اللون يأتي بعد الاسم."},{"t":"order","skill":"writing","q":"رتّب: اسأل عن مقاس واخبرني أنك ستأخذه","words":["Vous","l’avez","en","taille","moyenne","?","Je","le","prends."],"ans":"Vous l’avez en taille moyenne ? Je le prends.","why":"السؤال عن المتوفر ثم قرار الشراء."},{"t":"listen","skill":"listening","q":"أي جملة تُقال لرفض قطعة بأدب؟","opts":["Je regarde, merci.","C’est magnifique !","Je le prends.","C’est combien ?"],"a":0,"why":"Je regarde = أتفقّد فقط، رفض مهذّب."},{"t":"translate","skill":"writing","q":"ترجم: هذه الكنزة جميلة لكنها غالية جداً، سأتفقّد فقط.","ans":"Ce pull est joli mais c’est trop cher, je regarde.","why":"تسلسل الوصف ثم الرفض المهذّب."},{"t":"speaking","skill":"speaking","q":"اسأل عن مقاس M من قطعة ثم ردّد قرار الشراء بصوت عالٍ.","target":"Vous l’avez en taille moyenne ? Je le prends.","why":"محاكاة الكاونتر."},{"t":"correct","skill":"grammar","q":"صحّح: «J’essaie une robe rougees.»","ans":"J’essaie une robe rouge.","why":"لوحة واحدة لا تأخذ s مع اسم مفرد."},{"t":"translate","skill":"writing","q":"ترجم بصيغة الطلب المهذب: «أريد بنطلوناً من فضلك.»","ans":"Je voudrais un pantalon, s’il vous plaît.","alts":["Je voudrais un pantalon, s’il vous plait"],"why":"الطلب المهذب: Je voudrais + الاسم + s’il vous plaît."},{"t":"translate","skill":"writing","q":"ترجم بصيغة الطلب المهذب: «أريد قميصاً وأحذية من فضلك.»","ans":"Je voudrais une chemise et des chaussures, s’il vous plaît.","alts":["Je voudrais une chemise et des chaussures, s’il vous plait"],"why":"نفس القالب مع عطف المطلوبين."},{"t":"mcq","skill":"vocabulary","q":"سام طلب عبر الإنترنت 6 كيلوغرامات من:","opts":["pommes de terre","pommes","poires"],"a":0,"why":"الخطأ الشهير: أراد التفاح فوصلته البطاطس."},{"t":"mcq","skill":"vocabulary","q":"لحماية رأسه من الشمس يحتاج سام إلى:","opts":["chapeau","chameau","château"],"a":0,"why":"القبعة chapeau لا الجمل chameau."}],"homework":"اذهب إلى متجر حقيقي أو تصفّح متجر إلكتروني، واطلب ثلاث قطع بالفرنسية عقلياً: السؤال عن المتوفر، المقاس، ثم السعر. اكتب حواراً من عشرة أسطر بينك وبين البائع.","sources":[{"title":"Extra French episode 2 with french subtitles","channel":"Frenchy french","videoId":"VOLDwbnpmb0","why":"الحلقة الثانية كاملة: Sam وHugo في متجر الملابس — درس عملي في الألوان والمقاسات والأسعار.","cat":"Séries","level":"B1","main":true},{"title":"Extra French Episode 02 - Sam fait du shopping","channel":"Green Cilantro","videoId":"B28_6jtAUBI","why":"نسخة أخرى من الحلقة نفسها بعنوان رسمي — مفيدة للتأكد من أسماء المشاهد.","cat":"Séries","level":"B1","extra":true},{"title":"Extra French Series | Ep 2 | Part 1 (Eng & Fr Subtitle)","channel":"Learn French With Nessa","videoId":"WzUzwth63KU","why":"الجزء الأول فقط مقطّعاً — مثالي لجلسة قصيرة مركّزة على لغة التسوّق.","cat":"Séries","level":"B1","extra":true}],"supplements":[{"id":"B28_6jtAUBI","title":"Extra French Episode 02 - Sam fait du shopping","channel":"Green Cilantro","why":"نسخة أخرى من الحلقة نفسها بعنوان رسمي — مفيدة للتأكد من أسماء المشاهد.","lang":"fr","dur":24},{"id":"WzUzwth63KU","title":"Extra French Series | Ep 2 | Part 1 (Eng & Fr Subtitle)","channel":"Learn French With Nessa","why":"الجزء الأول فقط مقطّعاً — مثالي لجلسة قصيرة مركّزة على لغة التسوّق.","lang":"fr","dur":11}],"videoAfterObjectives":true,"dialoguesAfterObjectives":true},{"id":"b1-t8-l3","fr":"Extra — Épisode 3 : La colocation","ar":"Extra — الحلقة 3: الشراكة في السكن (La colocation)","objectives":["كتابة وتصفح الإعلانات المبوبة على الإنترنت (Petites annonces) للبحث عن الأصدقاء.","التعبير عن الإعجاب بالصفات الجسدية والنفسية (Tu as de beaux yeux, un sourire magnifique).","إعطاء التعليمات والتوجيهات المنزلية (الغسيل، ري النباتات، استخدام العطور).","القواعد: صفات الإشارة والملكية وضمائر الوصل البسيطة، وتصحيح الأخطاء الدلالية والصوتية في المدح، وصياغة الأسئلة المباشرة وغير المباشرة.","الثقافة: التعارف الرقمي (Les rencontres sur Internet) ومفهوم المقالب في السكن المشترك."],"sections":[{"h":"الحلقة 3: البحث عن زميل سكن والتعايش (الحلقة كاملة)","video":{"id":"mNzbzZEJwm0","title":"Extra French episode 3 with french subtitles","channel":"Frenchy french","why":"الحلقة الثالثة كاملة: موضوع السكن المشترك (colocation) — من أكثر المواضيع واقعية لطالب في فرنسا.","lang":"fr","main":true,"dur":24},"p":["الحلقة الثالثة تعالج واحدة من أصعب المواقف اللغوية للطالب المقيم: نقاش السكن المشترك. الحوار يبدأ ببحث بسيط ثم يتوسّع ليشمل الميزانية، قواعد الشقة، وحتى فصل الغسيل عن الغسيل — كلها بجمل قصيرة فصيحة سريعة.","ما يجعل هذه الحلقة قيّمة هو الطابق الجماعي: ثلاثة أصوات تتبادل الحديث، وأحياناً يقاطع بعضها البعض. هذا التدريب مطلوب لمستوى B1 لأن المحادثات الحقيقية نادراً ما تكون سؤالاً وجواباً مرتّبين.","من المفردات، ركّز على حقل « la vie en collectivité »: le ménage، le repas، la salle de bain، la note d’électricité. هذه المفردات ستظهر في كل شقق باريس لاحقاً.","نحوياً، تظهر هنا صيغة الشرط البسيط مع pourrais-je / j’aimerais — أدوات لطيفة للطلب تختلف عن الأمر المباشر. لاحظ أن الحوارات في Extra تميل إلى المهذّب حتى بين الأصدقاء، وهذا هو الاستخدام السائد.","الحلقة مثالية لتمرين «الاستماع المتعدد»: اكتب من يتكلم في كل جملة. إن استطعت تتبّع المتحدث دون النظر إلى الشاشة فأنت تفهم الفرنسية بعمق B1.","بعد الحلقة، صِف شقتك الحالية أو الحلمية بخمس جمل: عدد الغرف، من تشاركها، ماذا تطبخ، وكم تدفع."],"sub":[{"h":"جمل البحث عن السكن المشترك","p":["Tu cherches une colocation ?","J’ai une chambre libre, si tu veux.","Et pour le ménage, comment on fait ?","On partage les courses et les repas, d’accord ?"]},{"h":"أدوات نطقية: الوصل بين الكلمات","p":["« une chambre libre » تُسمع ككتلة [ỹn ʃɑ̃bʁ lybʁ].","« d’accord » تبدأ بهمزة خفيفة ولا فاصل بين d’ وaccord.","« comment on fait » تُنطَق مع on أخف من الشكل المكتوب."]},{"h":"خطوات Listen & Repeat","p":["المرة الأولى: تتبّع أصوات الأشخاص الثلاثة فقط، دون المفردات.","الثانية: كرّر كل اقتراح بصيغته المهذّبة (On pourrait… / J’aimerais…).","الثالثة: أعد بناء الحوار بخياراتك أنت."]}]},{"h":"النصوص الحوارية المصححة (Corpus des Dialogues)","p":["النص في تبويب «حوارات» هو المفرغ الأكاديمي للحلقة — ثلاثة مشاهد: الشوكولاتة والإعلانات، خطة نيكو، واللقاء الكوميدي.","المشهد الأول: فلسفة الإعلان («ce n’est pas ce que tu écris qui compte, mais comment tu l’écris !») ثم الرهان («je me trouve une nana sur internet sans problème») ومواصفات نيكو (1,80 m، cheveux noirs، voitures de course).","المشهد الثاني: وصفة الإغراء الثلاثية (السيارات، المال، الرقص) ثم طقس العطر على النبات والكمبيوتر («cet ordinateur va nous apporter des filles !») — الكوميديا هنا في الجدية الزائفة.","المشهد الثالث: الدرس («Tu as de beaux yeux. Tu as un sourire magnifique») ثم التنفيذ الكارثي («des beaux oreilles ! Tu es un millionnaire !») ثم كشف الفخ («Des pièges pour avoir des copines ! C’est notre voiture !»).","طريقة العمل: احفظ جملتي المغازلة الصحيحتين أولاً، ثم قارنهما بخطأي سام صوتاً صوتاً (yeux/oreilles، sourire/souris) — فالأذن التي تميز الفرق لا تخطئه."]},{"h":"عبارات الاتفاق والاقتراح","p":["« On pourrait… » التصريع التمهيدي للاقتراح: أضعف من الأمر وأقوى من الاحتمال — أفضل بداية لأي اقتراح يومي.","« Tu veux qu’on fasse les courses ensemble ? » — لاحظ que + subjunctif مع faire: ستشاهد هذا النمط كثيراً في طلبات الأفعال.","« C’est noté ! » = «سُجّل! / على راسي!» — تعبير شائع بين الأصدقاء، ويعني الموافقة الكاملة.","« Je suis d’accord avec toi, mais… » نموذج الموافقة المشروطة: وافق أولاً ثم احتج — فن فرنسي في النقاش."]},{"h":"الأفعال الكلامية والتواصل (Actes de Parole)","p":["كتابة الإعلان: الطول والشعر والهوايات («je fais 1,80 m, j’ai les cheveux noirs, j’adore les animaux») — والمهم «كيف تكتب» لا «ماذا تكتب».","المدح والمغازلة: «Tu as de beaux yeux» و«Tu as un sourire magnifique» — عبارات جاهزة تُقال كما هي دون اجتهاد صرفي.","التعليمات المنزلية: الغسيل، ري النباتات، واستخدام العطور — بصيغة الأمر المباشر بين سكان الشقة الواحدة."]},{"h":"ثقافة وحضارة: التعارف الرقمي والمقالب (Civilisation)","p":["التعارف الرقمي (Les rencontres sur Internet): الإعلانات المبوبة (petites annonces) ومواقع التعارف وسيلة جيل الشباب الأولى — والرهان («sans problème») يعكس ثقة الرقميين بأنفسهم.","المقالب (Les farces): الفتاتان الوهميتان (ميشا ولولو) تقلبان الفخ على أصحابه («C’est notre voiture !») — والمقلب بين سكان السكن المشترك طقس اجتماعي لا عداوة."]},{"h":"تمرين الحلقة","p":["تمرين التفاوض: ابحث عن «زميل سكن» في الفصل — ثلاثة شروط لأحدهم وثلاثة ل الآخر، ثم اتفقا في خمس دقائق.","كتابة إعلان: اكتب إعلاناً لغرفة للإيجار (4 أسطر): الموقع، السعر، ماذا تتشارك، ومن تبحث عنه.","تحقيق داخلي: اسأل زميلاً بالفرنسية عن تجربته في السكن المشترك وسجّل ثلاث معلومات رئيسية."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: أتقنت حوار السكن المشترك (chambre libre, loyer, ménage, courses) وصيغ الاقتراح المهذّب «On pourrait...» والموافقة المشروطة «Je suis d'accord, mais...» و«C'est noté !». أعد مشاهدة الفيديو الرئيسي وركّز على النقاش الجماعي بين الأصوات الثلاثة وعلى نبرة الاعتراض اللطيف.","جسر الدروس: من b1-t8-l2 (التسوّق والملابس واتخاذ القرار) إلى b1-t8-l3 (السكن المشترك والتعايش)، ثم إلى b1-t8-l4 حيث تنتقل إلى نقاش الرياضة وإقناع الأصدقاء مع حروف الجر au / à la / aux.","مهمة تطبيقية: اقترح اقتراحاً واحداً لزميلك ثم سجّل صوتك أو اكتب في دقيقة حواراً قصيراً (اقتراح ← استفتاء ← موافقة) مستعملاً 3 كلمات جديدة من الحلقة، وقارن نبرتك بنبرة الحوار في الفيديو الرئيسي."]}],"pron":[{"w":"la colocation","ipa":"[la kɔ.lo.ka.sjɔ̃]","approx":"لا كولوكاسيون"},{"w":"une chambre libre","ipa":"[yn ʃɑ̃bʁ lybʁ]","approx":"ين شامبر ليبر"},{"w":"le ménage","ipa":"[lə me.naʒ]","approx":"لو ميناژ"}],"vocab":[{"fr":"la colocation","ar":"السكن المشترك (زميل سكن)","pos":"nom","g":"f","exFr":"La colocation est moins chère.","ipa":"","exAr":"السكن المشترك أرخص."},{"fr":"une chambre libre","ar":"غرفة شاغرة","pos":"nom","g":"f","exFr":"J’ai une chambre libre à louer.","ipa":"","exAr":"لديّ غرفة شاغرة للإيجار."},{"fr":"le ménage","ar":"التنظيف المنزلي","pos":"nom","g":"m","exFr":"On fait le ménage le dimanche.","ipa":"","exAr":"ننظّف يوم الأحد."},{"fr":"les courses","ar":"التسوّق للمواد الغذائية","pos":"nom","g":"f pl","exFr":"Je fais les courses en rentrant.","ipa":"","exAr":"أذهب للتسوّق عند عودتي."},{"fr":"partager","ar":"يتشارك، يقسم","pos":"verbe","g":"","exFr":"On partage le prix du loyer.","ipa":"","exAr":"نتشارك ثمن الكراء."},{"fr":"le loyer","ar":"الكراء/الإيجار","pos":"nom","g":"m","exFr":"Le loyer est à payer le 5.","ipa":"","exAr":"يُدفع الإيجار في الخامس."},{"fr":"la note (d’électricité)","ar":"فاتورة (الكهرباء)","pos":"nom","g":"f","exFr":"La note d’électricité est élevée ce mois.","ipa":"","exAr":"فاتورة الكهرباء مرتفعة هذا الشهر."},{"fr":"un colocataire / une colocataire","ar":"زميل/زميلة سكن","pos":"nom","g":"m/f","exFr":"Mon colocataire travaille la nuit.","ipa":"","exAr":"زميل سكني يعمل ليلاً."},{"fr":"la salle de bain","ar":"حمّام","pos":"nom","g":"f","exFr":"La salle de bain est occupée.","ipa":"","exAr":"الحمّام مشغول."},{"fr":"d’accord","ar":"موافق/حسناً","pos":"loc.","g":"","exFr":"D’accord, on essaie !","ipa":"","exAr":"حسناً، لنجرّب!"},{"fr":"proposer","ar":"يقترح","pos":"verbe","g":"","exFr":"Je veux te proposer quelque chose.","ipa":"","exAr":"أريد أن أقترح عليك شيئاً."},{"fr":"le ménage / le repas","ar":"التنظيف / الوجبة","pos":"nom","g":"m","exFr":"Qui prépare le repas ce soir ?","ipa":"","exAr":"من يحضّر الوجبة الليلة؟"},{"fr":"une petite annonce","ar":"إعلان صغير (مببوب)","pos":"nom","g":"f","exFr":"Les petites annonces sur Internet.","exAr":"الإعلانات المبوبة على الإنترنت.","ipa":"pətit anɔ̃s"},{"fr":"un petit copain / une nana","ar":"صديق / فتاة (عامية)","pos":"nom","exFr":"Je me trouve une nana sur internet.","exAr":"أجد فتاة على الإنترنت.","ipa":"pəti kɔpɛ̃ / nana"},{"fr":"une voiture de course","ar":"سيارة سباق","pos":"nom","g":"f","exFr":"Les filles aiment les voitures de course.","exAr":"الفتيات يحببن سيارات السباق.","ipa":"vwatyʁ də kuʁs"},{"fr":"un millionnaire","ar":"مليونير","pos":"nom","g":"m","exFr":"Vous êtes millionnaires, hein ?","exAr":"أنتم مليونيرات، هكذا؟","ipa":"miljɔnɛʁ"},{"fr":"un sourire","ar":"ابتسامة","pos":"nom","g":"m","exFr":"Tu as un sourire magnifique.","exAr":"لديكِ ابتسامة رائعة.","ipa":"suʁiʁ"},{"fr":"un œil (des yeux)","ar":"عين (عيون)","pos":"nom","g":"m","exFr":"Tu as de beaux yeux.","exAr":"لديكِ عيون جميلة.","ipa":"œj (dezjø)"},{"fr":"une oreille","ar":"أذن","pos":"nom","g":"f","exFr":"Tu as des beaux oreilles ! (خطأ سام)","exAr":"لديك آذان جميلة! (خطأ)","ipa":"ɔʁɛj"},{"fr":"tendre un piège","ar":"ينصب فخاً / مصيدة","pos":"locution","exFr":"Des pièges pour avoir des copines !","exAr":"فخاخ للحصول على صديقات!","ipa":"tɑ̃dʁ œ̃ pjɛʒ"}],"examples":[{"fr":"Tu cherches une colocation ?","ar":"هل تبحث عن سكن مشترك؟","note":"فتح الموضوع"},{"fr":"J’ai une chambre libre, si tu veux.","ar":"لديّ غرفة شاغرة إن أردت.","note":"العرض بلطف"},{"fr":"On pourrait partager les courses.","ar":"يمكننا أن نتشارك التسوّق.","note":"on pourrait = اقتراح"},{"fr":"Je suis d’accord, mais pas le week-end.","ar":"أوافق، لكن ليس في عطلة نهاية الأسبوع.","note":"الموافقة المشروطة"},{"fr":"C’est noté ! On fait le ménage à tour de rôle.","ar":"على راسي! ننظّف بالتناوب.","note":"à tour de rôle"},{"fr":"Et pour le loyer, on fait comment ?","ar":"وبالنسبة للكراء، ماذا نفعل؟","note":"سؤال عملي"},{"fr":"Tu as de beaux yeux.","ar":"لديكِ عيون جميلة.","note":"المدح الصحيح"},{"fr":"Tu as un sourire magnifique.","ar":"لديكِ ابتسامة رائعة.","note":"المدح الصحيح"},{"fr":"J’adore le chocolat !","ar":"أنا أعشق الشوكولاتة!","note":"افتتاحية آني"}],"grammar":[{"tFr":"Conditionnel de politesse : pourrais-je / j’aimerais","tAr":"الشرطية المهذّبة: pourrais-je وj’aimerais","body":["صيغة الشرط تُستخدم للطلب بلطف: « Je voudrais » / « Pourrais-je » / « On pourrait ». الفرق بينها وبين الأمر لا يُنقل في الترجمة لكنه يُسمع في النبرة — وفي المرات القادمة ستلاحظ الفرق تلقائياً.","لاحظ elision: « J’aimerais » وليس « Je aimerais ». القاعدة البسيطة: الأفعال تبدأ بهمزة بعد le/la/les/J’."],"ex":[{"fr":"Pourrais-je habiter ici à partir de septembre ?","ar":"هل يمكنني أن أسكن هنا ابتداءً من سبتمبر؟"},{"fr":"On pourrait partager les repas pour économiser.","ar":"يمكننا تناول الوجبات معاً للتوفير."}]},{"tFr":"Impératif avec on / nous dans la vie quotidienne","tAr":"الأمر مع on/nous في الحياة اليومية","body":["الأمر الجمع مع nous: « Faisons les courses ! » ومع on يُستخدم الأمر المفرد مع معنى الجمع: « Fais les courses ! » بين الأصدقاء.","في الحوار سمعت « On fait le ménage » كقاعدة عائلية — لا تبحث عن مصدر رسمي؛ الجملة النحوية البسيطة تصف الاتفاق."],"ex":[{"fr":"Faisons les courses maintenant, après on cuisine.","ar":"لنتسوّق الآن، ثم نطبخ."},{"fr":"N’oublie pas la note d’électricité !","ar":"لا تنسَ فاتورة الكهرباء!"}]},{"tFr":"Yeux/oreilles, sourire/souris : les erreurs de drague","tAr":"أخطاء المغازلة: العيون والآذان والابتسامة","body":["«Les yeux» (العيون) مقابل «Les oreilles» (الآذان): مدح سام العيون فوصف الآذان — والخطأ مزدوج: des بدل de أمام الصفة (beaux) + الكلمة الخاطئة — والصواب: «Tu as de beaux yeux».","«Le sourire» (الابتسامة، مذكر) مقابل «La souris» (الفأر، مؤنث): نطق sourire كـ souris حوّل الغزل إلى قوارض — والصواب: «Tu as un sourire magnifique» (un لا une، وas لا es).","«Tu es un millionnaire !»: الادعاء الكاذب بالثروة كشف الفخ كله («Des pièges pour avoir des copines !») — والمبالغة في الإعلان أول ما يُكتشَف."],"ex":[{"fr":"Tu as de beaux yeux.","ar":"لديكِ عيون جميلة."},{"fr":"Tu as un sourire magnifique.","ar":"لديكِ ابتسامة رائعة."}]}],"mistakes":[{"wrong":"« Je propose de faire le ménage à moi »","right":"« Je propose de faire le ménage moi-même » / « …de mon côté »","why":"à moi تُستعمل مع possessif لا مع الفاعل."},{"wrong":"« D’accord, je viens à Paris demain pour colocation »","right":"« pour une colocation »","why":"colocation اسم معدود يأخذ أداة التعريف."},{"wrong":"الرفض المباشر « Non, jamais ! »","right":"« Non, merci, ce n’est pas possible. »","why":"الرفض المجرد يُعتبر فجوة اجتماعية في الفرنسية المعاصرة."},{"wrong":"« J’habite avec un coloc »","right":"« Je vis en colocation avec un colocataire »","why":"coloc اختصار عامي شائع، لكن الاستعمال الأفصح colocation."},{"wrong":"«Tu as des beaux oreilles»","right":"«Tu as de beaux yeux»","why":"de لا des أمام الصفة، والعيون yeux لا الآذان oreilles."},{"wrong":"«Tu es une souris magnifique»","right":"«Tu as un sourire magnifique»","why":"الابتسامة مذكر (un sourire) مع الفعل avoir لا être."}],"dialogues":[{"title":"المشهد الأول: الشوكولاتة والإعلانات (La gym et les annonces)","ctx":"الشخصيات: ساشا، آني، ونيكو — الإحباط العاطفي يتحول إلى رهان إنترنتي.","lines":[{"who":"Annie","fr":"J’adore le chocolat ! Gâteau au chocolat, glace au chocolat, bonbon au chocolat... Oh, je n’aurai jamais de petits copains !","ar":"آني: أنا أعشق الشوكولاتة! كعكة بالشوكولاتة، آيس كريم بالشوكولاتة، حلوى بالشوكولاتة... أوه، لن يكون لدي أصدقاء (أحباء) أبداً!"},{"who":"Sacha","fr":"Annie, ce n’est pas ce que tu écris qui compte, mais comment tu l’écris ! Regarde, je parie que je me trouve une nana sur internet sans problème.","ar":"ساشا: يا آني، ليس ما تكتبينه هو ما يهم، بل كيف تكتبينه! انظري، أراهن أنني أستطيع ايجاد فتاة على الإنترنت بلا مشاكل."},{"who":"Nico","fr":"Que je fais 1,80 m, que j’ai les cheveux noirs, que j’adore les animaux et les voitures de course...","ar":"نيكو: (مستعرضاً ما سيكتبه): أن طولي 1.80 متراً، وأن شعري أسود، وأنني أعشق الحيوانات وسباقات السيارات..."}]},{"title":"المشهد الثاني: خطة نيكو وسام (Le plan de Nico)","ctx":"الشخصيات: نيكو وسام — وصفة الإغراء: السيارات والمال والرقص... والعطر على النبات.","lines":[{"who":"Sam","fr":"Comment les mecs se trouvent des nanas ?","ar":"سام: كيف يجد الشباب الفتيات (الصديقات)؟"},{"who":"Nico","fr":"Sam, mon ami, mon pote, laisse-moi faire ! J’ai un plan. Les filles aiment les voitures de course, elles aiment l’argent, elles aiment danser...","ar":"نيكو: يا سام، يا صديقي، اترك الأمر لي! لدي خطة. الفتيات يحببن سيارات السباق، يحببن المال، ويحببن الرقص..."},{"who":"Nico","fr":"Voilà ! Super, super, Sam, cet ordinateur va nous apporter des filles !","ar":"نيكو: (يرش عطراً كثيراً على النبات والكمبيوتر) هكذا! رائع رائع يا سام، هذا الكمبيوتر سيجلب لنا الفتيات!"}]},{"title":"المشهد الثالث: المأزق واللقاء الكوميدي (Le rendez-vous)","ctx":"الشخصيات: نيكو، سام، والفتاتان (ميشا ولولو) — درس المغازلة ينقلب على صاحبيه.","lines":[{"who":"Nico","fr":"Répète après moi : Tu as de beaux yeux. Tu as un sourire magnifique.","ar":"نيكو: (يدرب سام): ردد ورائي: لديكِ عيون جميلة. لديكِ ابتسامة رائعة."},{"who":"Sam","fr":"Tu as des beaux oreilles ! Tu es un millionnaire !","ar":"سام: (يخطئ أمام الفتيات): لديك آذان جميلة! وأنت مليونير!"},{"who":"Les filles","fr":"Alors, comme ça, vous êtes millionnaires, hein ? Des pièges pour avoir des copines ! C’est notre voiture !","ar":"الفتيات: إذن، أنتم مليونيرات هكذا إذن؟ فخاخ للحصول على صديقات! وهذه سيارتنا!"}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما معنى « colocation »؟","opts":["السكن المشترك","الشقة الفاخرة","السكن العائلي","الفندق"],"a":0,"why":"colocation = مشاركة الشقة مع زميل."},{"t":"fill","skill":"speaking","q":"أكمل: «On ___ les courses ensemble.» (نتشارك)","fr":"On ___ les courses ensemble.","ans":"partageons","alts":["partage"],"why":"partager — نتشارك التسوّق."},{"t":"mcq","skill":"grammar","q":"الطلب المهذّب الصحيح:","opts":["Pourrais-je parler avec toi ?","Je parle avec toi !","Parle-moi tout de suite.","Tu parles, moi j’écoute."],"a":0,"why":"شرطية المهذّب مع elision de l’inversion."},{"t":"order","skill":"writing","q":"رتّب: اقترح تشارك الوجبات ثم اسأل عن الرأي","words":["On","pourrait","partager","les","repas,","tu","es","d’accord?"],"ans":"On pourrait partager les repas, tu es d’accord?","why":"اقتراح ثم استفتاء."},{"t":"listen","skill":"listening","q":"ما الذي يُتشارك في السكن حسب الحوار؟","opts":["Les courses et les repas","La voiture","Les études","Le téléphone"],"a":0,"why":"التسوّق والوجبات هي الأساس في la colocation."},{"t":"translate","skill":"writing","q":"ترجم: لديّ غرفة شاغرة إن أردت، والكراء ثلاثمئة يورو.","ans":"J’ai une chambre libre si tu veux, et le loyer est à trois cents euros.","why":"العرض ثم السعر."},{"t":"speaking","skill":"speaking","q":"اقترح على زميلك أن يتشاركا الوجبات أسبوعياً — جملتان بصوت عالٍ.","target":"On pourrait partager les repas… / Tu es d’accord ?","why":"تمرين on pourrait + d’accord."},{"t":"correct","skill":"grammar","q":"صحّح: «Je suis d’accord pour partager les repas, mais pas moi le week-end.»","ans":"Je suis d’accord pour partager les repas, mais pas moi-même le week-end.","why":"التأكيد على الفاعل يأخذ-même."},{"t":"correct","skill":"writing","q":"صحح غزل سام: «Tu as des beaux oreilles. → ...»","ans":"Tu as de beaux yeux.","alts":["Tu as de beaux yeux"],"why":"de أمام الصفة، والعيون yeux لا الآذان."},{"t":"correct","skill":"writing","q":"صحح غزل سام: «Tu es une souris magnifique. → ...»","ans":"Tu as un sourire magnifique.","alts":["Tu as un sourire magnifique"],"why":"الابتسامة مذكر مع avoir: un sourire."}],"homework":"شاهد الحلقة ثلاث مرات مع إيقاف عند كل اقتراح وحاول تقدير الجملة التالية قبل سماعها. ثم اكتب إعلاناً من 5 أسطر لغرفة شاغرة في شقتك.","sources":[{"title":"Extra French episode 3 with french subtitles","channel":"Frenchy french","videoId":"mNzbzZEJwm0","why":"الحلقة الثالثة كاملة: موضوع السكن المشترك (colocation) — من أكثر المواضيع واقعية لطالب في فرنسا.","cat":"Séries","level":"B1","main":true},{"title":"Extra French Series | Episode 3 | Eng & Fr Subtitles","channel":"Learn French With Nessa","videoId":"LMv8RH4LHiQ","why":"الحلقة بترجمة فرنسية + إنجليزية مزدوجة — ممتازة لمقارنة فهمك مع النص الإنجليزي.","cat":"Séries","level":"B1","extra":true},{"title":"Extra En Francais - Episode 3 - Sam a un rendez vous","channel":"French Made Clear","videoId":"c8XmeSuiaSE","why":"تجميعة أخرى للحلقة نفسها بعنوان مختلف — استمع مرة أخرى لتثبيت مفردات السكن.","cat":"Séries","level":"B1","extra":true}],"supplements":[{"id":"LMv8RH4LHiQ","title":"Extra French Series | Episode 3 | Eng & Fr Subtitles","channel":"Learn French With Nessa","why":"الحلقة بترجمة فرنسية + إنجليزية مزدوجة — ممتازة لمقارنة فهمك مع النص الإنجليزي.","lang":"fr","dur":24},{"id":"c8XmeSuiaSE","title":"Extra En Francais - Episode 3 - Sam a un rendez vous","channel":"French Made Clear","why":"تجميعة أخرى للحلقة نفسها بعنوان مختلف — استمع مرة أخرى لتثبيت مفردات السكن.","lang":"fr","dur":24}],"videoAfterObjectives":true,"dialoguesAfterObjectives":true},{"id":"b1-t8-l4","fr":"Extra — Épisode 4 : Du sport","ar":"Extra — الحلقة 4: الرياضة واللياقة","objectives":["وصف رياضتك المفضلة ومواعيدها بجمل مترابطة","استعمال أفعال الحركة والتعبير عن الرأي واللا رأي بلطف","فهم الفرق بين au / à la / aux مع أسماء الرياضات","تحليل نبرة السخرية الودودة في حوار الأصدقاء"],"sections":[{"h":"الحلقة 4: نقاش الرياضة والتمارين (الحلقة كاملة)","video":{"id":"drdJaBrA3ns","title":"Extra French episode 4 with french subtitles","channel":"Frenchy french","why":"الحلقة الرابعة كاملة: Hugo وSam وNicolas يتناقشون في الرياضة المفضلة — مفردات الرياضة وإيقاع الحوار الجماعي.","lang":"fr","main":true,"dur":25},"p":["الحلقة الرابعة تحملك إلى نادي رياضي باريسي: Hugo مهووس، Sam متحفّظة قليلاً، وNicolas يحاول الإقناع. الحوارات قصيرة ومتكررة، والمفردات محدودة لكنها عالية التكرار — أفضل تركيز لحفظ حقل دلالي واحد في جلسة واحدة.","ركّز على تباين النبرات: نبرة Hugo الصاعدة والحماسية مقابل نبرة Sam الهادئة المتردّدة. هذا الفرق لا يظهر في الكتابة لكنه شرط أساسي لفهم الأفلام الفرنسية لاحقاً.","نحوياً، تظهر هنا أسماء الرياضات مع حروف الجر: « Je fais du sport »، « Je joue au football »، « Je vais à la piscine ». الفروق الثلاثة صغيرة لكنها ثابتة ولا تُخلط بعد اليوم.","الحلقة تقدّم أيضاً مراجعة سريعة للأمر مع tu: « Viens ! », « Écoute ! », « Regarde ! » — وهي نفسها مستخدمة بين الأصدقاء في كل الحلقات.","بعد الحلقة، استخرج خمس جمل عن رياضتك وسجّلها بصوت عالٍ، ثم صِف أسبوعك الرياضي في ثلاث جمل: ماذا تفعل، ومتى، ومن يرافقك.","إن كانت الرياضة ليست اهتمامك فستجد في الحلقة مفردات مفيدة عموماً: la salle de sport، le foot، la natation — وهي جزء من الثقافة الفرنسية اليومية."],"sub":[{"h":"جمل الرياضة الأساسية","p":["Tu fais du sport, au moins ?","Je vais à la piscine deux fois par semaine.","Nous, on joue au foot le mercredi soir.","Viens avec nous, c’est plus motivant !"]},{"h":"أدوات نطقية: à la / au في الوصل","p":["« Je joue au foot » تُسمع ككتلة واحدة [ʒə ʒo o fut].","« à la piscine » → [a la pi.sin] مع a مفتوحة قصيرة.","« deux fois » — la voyelle [ø] الفرنسية قصيرة لا تُطوّل."]},{"h":"خطوات Listen & Repeat","p":["المرة الأولى: تتبّع فقط كلمات الرياضة واكتبها.","الثانية: كرّر كل جملة بنبرة المتحدث نفسه.","الثالثة: بدّل الرياضة في جملك واحفظ النمط."]}]},{"h":"عبارات الإقناع والرفض في الرياضة","p":["« Viens avec nous ! » أمر مختصر بين الأصدقاء — لا تترجمه حرفياً بـ« تعال» بل بنبرة الدعوة.","« C’est plus motivant » — la motivation موضوع فرنسي شائع؛ « motivant(e) » صفة تُستخدم للأشخاص والأنشطة.","« Je n’ai pas le temps » ثم يليها غالباً « Mais… » — النمط الفرنسي: اعتذار ثم محاولة إقناع.","« On se voit à la salle » — لاحظ how à la تبقى ظاهرة في الوصل ولا تختصر في الكتابة."]},{"h":"التطبيق والتلخيص","p":["تمرين أسبوعي: اكتب جدولاً لرياضتك القادمة (اليوم، الرياضة، المدة، الرفيق) ثم اشرحه في 30 ثانية بالفرنسية.","ثنائي: شخص يروّج لنادٍ رياضي وآخر يعترض بثلاثة اعتذارات — الأفضل من يحافظ على نبرة ودية.","كتابة: فقرة من خمس جمل عن أهمية الرياضة في الثقافة الفرنسية (المدرسة، النادي، التلفاز)."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: أتقنت وصف رياضتك ومواعيدها، والتمييز بين faire du sport / jouer au / aller à la، والأمر بين الأصدقاء، ونبرة الرفض والقبول الودية. أعد مشاهدة الفيديو الرئيسي وركّز على مشهد الإقناع بين Hugo وNicolas وعلى نبرة السخرية الودودة.","جسر الدروس: من b1-t8-l3 (السكن المشترك والتفاوض على الأدوار) إلى b1-t8-l4 (الرياضة واللياقة وإقناع الأصدقاء)، ثم إلى b1-t8-l5 حيث تكمل مع Extra في حلقة جديدة من الحياة اليومية الباريسية.","مهمة تطبيقية: اكتب جدولك الرياضي الأسبوعي ثم سجّل صوتك أو اكتب في دقيقة شرحاً من ثلاث جمل مستعملاً 3 كلمات جديدة من الحلقة، وقارن نبرتك وسرعتك بالفيديو الرئيسي."]}],"pron":[{"w":"le sport","ipa":"[lə spɔʁ]","approx":"لو سبور"},{"w":"la piscine","ipa":"[la pi.sin]","approx":"لا بيسين"},{"w":"motivant","ipa":"[mo.ti.vɑ̃]","approx":"موتيفان"}],"vocab":[{"fr":"le sport","ar":"الرياضة","pos":"nom","g":"m","exFr":"Le sport, c’est important.","ipa":"","exAr":"الرياضة مهمة."},{"fr":"la piscine","ar":"حمام السباحة","pos":"nom","g":"f","exFr":"Je nage à la piscine municipale.","ipa":"","exAr":"أسبح في حمام السباحة البلدية."},{"fr":"le foot(ball)","ar":"كرة القدم","pos":"nom","g":"m","exFr":"Ils jouent au foot le dimanche.","ipa":"","exAr":"يلعبون كرة القدم يوم الأحد."},{"fr":"la salle de sport","ar":"نادي الرياضة / صالة الجيم","pos":"nom","g":"f","exFr":"La salle de sport est ouverte tôt.","ipa":"","exAr":"النادي مفتوح مبكراً."},{"fr":"faire de l’exercice","ar":"يمارس التمارين","pos":"loc.","g":"","exFr":"Je fais de l’exercice chaque matin.","ipa":"","exAr":"أمارس التمارين كل صباح."},{"fr":"courir","ar":"يجري/يركض","pos":"verbe","g":"","exFr":"Elle court dans le parc.","ipa":"","exAr":"تجري في الحديقة."},{"fr":"nager","ar":"يسبح","pos":"verbe","g":"","exFr":"On va nager cet après-midi ?","ipa":"","exAr":"نذهب للسباحة بعد الظهر؟"},{"fr":"le mercredi / le week-end","ar":"الأربعاء / عطلة نهاية الأسبوع","pos":"nom","g":"m","exFr":"On joue au foot le mercredi.","ipa":"","exAr":"نلعب كرة القدم يوم الأربعاء."},{"fr":"motivant(e)","ar":"محفّز/محفّزة","pos":"adj.","g":"","exFr":"Ce club est très motivant.","ipa":"","exAr":"هذا النادي محفّز جداً."},{"fr":"la natation / la course à pied","ar":"السباحة / الجري","pos":"nom","g":"f","exFr":"Sa discipline préférée est la natation.","ipa":"","exAr":"رياضته المفضلة هي السباحة."},{"fr":"un entraînement","ar":"حصة تدريب","pos":"nom","g":"m","exFr":"L’entraînement dure une heure.","ipa":"","exAr":"تدوم الحصة ساعة."},{"fr":"se détendre","ar":"يسترخي","pos":"verbe pronominal","g":"","exFr":"Après le sport, il se détend.","ipa":"","exAr":"بعد الرياضة يسترخي."}],"examples":[{"fr":"Tu fais du sport, au moins ?","ar":"هل تمارس الرياضة على الأقل؟","note":"au moins = على الأقل"},{"fr":"Je vais à la piscine deux fois par semaine.","ar":"أذهب إلى حمام السباحة مرتين أسبوعياً.","note":"aller à + la fréquence"},{"fr":"Nous, on joue au foot le mercredi soir.","ar":"نحن نلعب كرة القدم مساء الأربعاء.","note":"nous/on + au"},{"fr":"Viens avec nous, c’est plus motivant !","ar":"تعال معنا، إنه أكثر تحفيزاً!","note":"أمر + مقارنة"},{"fr":"Je n’ai pas le temps, mais je peux essayer.","ar":"ليس لديّ وقت، لكن يمكنني أن أجرب.","note":"اعتذار ثم محاولة"},{"fr":"On se voit à la salle samedi ?","ar":"نراك في النادي السبت؟","note":"سؤال دعوة"}],"grammar":[{"tFr":"À la / au / aux + noms de sports","tAr":"حروف الجر مع أسماء الرياضات","body":["« Je fais du sport » (المادة العامة)، « Je joue au football » (اللعبة)، « Je vais à la piscine » (المكان). الفروق الثلاثة ثابتة ولا تُخلط — احفظها كثلاث صور لا كقواعد.","مع بعض الأسماء يبقى au لأنه مفرد في الاستعمال: « au badminton », « au judo ». والبلدان تأخذ aux: « aux États-Unis »."],"ex":[{"fr":"Je fais de la natation et du tennis.","ar":"أسبح وألعب التنس."},{"fr":"Ils jouent au badminton dans le parc.","ar":"يلعبون كرة الريشة في الحديقة."}]},{"tFr":"Impératif entre amis","tAr":"الأمر بين الأصدقاء","body":["الأمر مع tu يحذف الضمير: « Viens ! » وليس « Viens-tu ! ». مع nous: « Allons-y ! » و« Faisons ! ».","في Extra، الأمور تُقال بنبرة دعوة لا أوامر — الفرق في النبرة لا في الكلمة."],"ex":[{"fr":"Regarde ce match avec nous !","ar":"شاهد هذه المباراة معنا!"},{"fr":"Allons-y, on est en retard !","ar":"هيا بنا، نحن متأخرون!"}]}],"mistakes":[{"wrong":"« Je fais le sport »","right":"« Je fais du sport »","why":"رياضة عامة تأخذ du بعد faire."},{"wrong":"« Je joue à football »","right":"« Je joue au football »","why":"اللعبة تأخذ au + أداة التعريف."},{"wrong":"« Je vais piscine »","right":"« Je vais à la piscine »","why":"المكان يأخذ à + la."},{"wrong":"« C’est motivé ! » عن نشاط","right":"« C’est motivant ! »","why":"motivé = متحمس (شخص)، motivant = محفّز (نشاط)."}],"dialogues":[{"title":"دعوة للنادي","ctx":"Hugo يقنع Nicolas","lines":[{"who":"Hugo","fr":"Hé, Nico, tu viens à la salle ce soir ?","ar":"أيها نيكو، هل تأتي للنادي الليلة؟"},{"who":"Nicolas","fr":"Je suis fatigué… peut-être demain.","ar":"أنا متعب… ربما غداً."},{"who":"Hugo","fr":"Une demi-heure, c’est tout. Ça va te faire du bien.","ar":"نصف ساعة فقط، هذا كل شيء. سيفيدك."},{"who":"Nicolas","fr":"Bon, d’accord. Mais pas de course, je suis nul !","ar":"حسناً، موافق. لكن بلا جري، أنا سيّئ!"}]},{"title":"بعد التمرين","ctx":"Sam وHugo بعد نصف ساعة","lines":[{"who":"Sam","fr":"C’était intense ! Tu fais ça toutes les semaines ?","ar":"كان شاقاً! هل تفعل هذا كل أسبوع؟"},{"who":"Hugo","fr":"Deux fois. Après, on se détend à la piscine.","ar":"مرتين. ثم نسترخي في حمام السباحة."},{"who":"Sam","fr":"Tu as raison, ça motive. Je reviens mercredi.","ar":"معك حق، إنه محفّز. سأعود الأربعاء."},{"who":"Hugo","fr":"Parfait, je te réserve un créneau !","ar":"ممتاز، سأحجز لك موعداً!"}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما معنى « la piscine »؟","opts":["حمام السباحة","الملعب","النادي","الحديقة"],"a":0,"why":"piscine = مسبح."},{"t":"fill","skill":"speaking","q":"أكمل: «Je joue ___ foot le mercredi.»","fr":"Je joue ___ foot le mercredi.","ans":"au","why":"اللعبة تأخذ au."},{"t":"mcq","skill":"grammar","q":"أي جملة تصف ممارسة الرياضة بشكل صحيح؟","opts":["Je fais du sport","Je fais le sport","Je fais à sport","Je suis du sport"],"a":0,"why":"faire du sport هي الصيغة القياسية."},{"t":"order","skill":"writing","q":"رتّب: أذهب إلى المسبح مرتين في الأسبوع","words":["Je","vais","à","la","piscine","deux","fois","par","semaine."],"ans":"Je vais à la piscine deux fois par semaine.","why":"المكان ثم التكرار."},{"t":"listen","skill":"listening","q":"أي جملة تُقال للاستسلام للدعوة؟","opts":["Bon, d’accord.","Je n’ai pas le temps.","Non, jamais.","Tu plaisantes !"],"a":0,"why":"d’accord = موافقة."},{"t":"translate","skill":"writing","q":"ترجم: نلعب كرة القدم مساء الأربعاء في النادي.","ans":"Nous jouons au foot le mercredi soir à la salle.","why":"اللعبة + اليوم + المكان."},{"t":"speaking","skill":"speaking","q":"صف رياضتك المفضلة في ثلاث جمل بصوت عالٍ.","target":"Je fais… / Je vais à… / C’est…","why":"نمط الوصف الرياضي."},{"t":"correct","skill":"grammar","q":"صحّح: «Je fais le natation.»","ans":"Je fais de la natation.","why":"السباحة تأخذ de la بعد faire."}],"homework":"شاهد الحلقة ثلاث مرات، ثم اكتب جدولك الرياضي الأسبوعي بالفرنسية (خمس جمل) وسجّل نفسك تشرحه في 40 ثانية.","sources":[{"title":"Extra French episode 4 with french subtitles","channel":"Frenchy french","videoId":"drdJaBrA3ns","why":"الحلقة الرابعة كاملة: Hugo وSam وNicolas يتناقشون في الرياضة المفضلة — مفردات الرياضة وإيقاع الحوار الجماعي.","cat":"Séries","level":"B1","main":true},{"title":"Extr@ French Episode 04 - French/English Subtitles","channel":"Manuel Rosero","videoId":"sYPAmhS2mj4","why":"نسخة بترجمة فرنسية + إنجليزية مزدوجة — تساعد على مطابقة ما سمعته.","cat":"Séries","level":"B1","extra":true},{"title":"Extra French Series | Episode 4 | Final part | Fr & Eng Subtitle","channel":"Learn French With Nessa","videoId":"QzXmKEnSTtg","why":"الجزء الختامي من الحلقة مقطّعاً — مفيد للاستماع الموجز وتركيز الانتباه.","cat":"Séries","level":"B1","extra":true}],"supplements":[{"id":"sYPAmhS2mj4","title":"Extr@ French Episode 04 - French/English Subtitles","channel":"Manuel Rosero","why":"نسخة بترجمة فرنسية + إنجليزية مزدوجة — تساعد على مطابقة ما سمعته.","lang":"fr","dur":25},{"id":"QzXmKEnSTtg","title":"Extra French Series | Episode 4 | Final part | Fr & Eng Subtitle","channel":"Learn French With Nessa","why":"الجزء الختامي من الحلقة مقطّعاً — مفيد للاستماع الموجز وتركيز الانتباه.","lang":"fr","dur":17}]},{"id":"b1-t8-l5","fr":"Extra — Épisode 5 : Une étoile est née","ar":"Extra — الحلقة 5: مولود نجم (Annie والغناء)","objectives":["وصف حلم أو مشروع شخصي بثلاث جمل مترابطة","استعمال صيغ التقييم الإيجابي والسلبي بأدب (c’est… / ce n’est pas…)","فهم أفعال المشاعر والرغبة (aimer, vouloir, rêver de)","تحليل كيف يُعطى النقد الودود في الحوار الفرنسي"],"sections":[{"h":"الحلقة 5: Annie والحلم الغنائي (الحلقة كاملة)","video":{"id":"XWMYPqR1D6Q","title":"Extra French episode 5 with French subtitles","channel":"angyne","why":"الحلقة الخامسة كاملة: Annie تحاول الغناء أمام أصدقائها — مفردات الأحلام والمشاعر والتقييم.","lang":"fr","main":true,"dur":25},"p":["في الحلقة الخامسة تخرج Annie من روتين الحياة اليومية إلى حلم الظهور: تحاول الغناء في مقهى، ويردّ عليها الأصدقاء بنبرات مختلفة — التشجيع، التهكم اللطيف، والنقد البنّاء. المشهد بسيط لكنه يحمل درساً اجتماعياً عن النقد الفرنسي: يبدأ بالجيد ثم ينتهي بالملاحظة.","من الناحية اللغوية، تظهر أفعال المشاعر والمشروع: « rêver de », « vouloir », « aimer bien », « trouver que… ». هذه الأفعال هي أساس أي حديث عن الآراء — وهي أكثر من مطلوب لمستوى B1.","الحلقة تعطيك تدريباً على « la réaction »: كيف تردّ على إيجابي، كيف تقبل نقداً، وكيف تختتم بجملة إيجابية. في الثقافة الفرنسية، النهاية الإيجابية شبه إلزامية.","انتبه إلى استعمال « que » مع الرأي: « Je trouve que c’est joli » — أكثر تحفّظاً ودقّة من الجملة المختصرة « C’est joli ! ».","الحلقة ممتازة لتمرين النبرة: كرّر جملة التقييم بنفسك بصوت إيجابي ثم بصوت متحفّظ — ستلاحظ أن الكلمة نفسها تُفهم بشكل مختلف.","بعد الحلقة، اكتب ثم اسجّل تقديماً إيجابياً لحلم شخصي في ثلاث جمل، ثم اطلب من زميل تعليقاً واحداً — وردّ عليه بأدب."],"sub":[{"h":"جمل التقييم والمشاعر","p":["Tu rêves de chanter, c’est ça ?","J’aime bien ta voix, mais…","C’est joli, ce n’est pas parfait.","Je trouve que tu as du talent !"]},{"h":"أدوات نطقية: نبرة التقييم","p":["« mais… » بفاصل ونبرة هابطة تدل على تحفّظ.","« Je trouve que » تُنطَق بنبرة تفكير قبل الحكم.","« du talent » → [dy talɑ̃] مع du المخففة."]},{"h":"خطوات Listen & Repeat","p":["المرة الأولى: اكتب كل جملة تقييم سمعتها.","الثانية: كرّر كل واحدة بنبرتها الأصلية.","الثالثة: أضف رأيك أنت في ثلاث جمل."]}]},{"h":"عبارات التشجيع والنقد الودود","p":["« Tu as du talent ! » تعبير تشجيع قوي — لاحظ du بدل de: « du talent » عبارة إيجابية جاهزة.","« Ce n’est pas mal, mais on peut améliorer. » النمط الفرنسي للنقد: تخفيف أولاً ثم الاقتراح.","« Continue, tu progresses ! » صيغة التشجيع المستقبلية — progresses من progresser.","« Tu rêves ! » = «أحلام يقظة!» — تعبير يومي مختصر يُقال بنبرة ودية."]},{"h":"التطبيق والتلخيص","p":["تمرين النقد الودود: شخص يعرض مشروعاً والآخر يبدأ تعليقه بـ« C’est bien… » ثم ينتهي بملاحظة واحدة فقط.","كتابة رسالة تشجيع: ثلاث جمل لصديق بدأ مشروعاً جديداً، مستعملاً talent / progresser / continuer.","سجّل نفسك تصف حلمك الشخصي في 30 ثانية ثم استمع وصحّح نبرتك."]},{"h":"التطبيق والتلخيص","p":["خلاصة: وصفتَ حلمك بثلاث جمل مترابطة، واستعملتَ صيغ التقييم الإيجابي والمتحفّظ (c’est… / ce n’est pas… / je trouve que…) وأفعال المشاعر (aimer, vouloir, rêver de) في نقد ودّي فرنسي نموذجي. «أعد مشاهدة الفيديو الرئيسي وركّز على نبرة الإطراء ثم الملاحظة عند قول Annie: J’aime bien ta voix, mais…»","جسر الدروس: من b1-t8-l4 (الرياضة واللياقة ووصف الهوايات) إلى b1-t8-l5 (وصف الحلم الغنائي والتقييم بأدب)، ثم إلى b1-t8-l6 حيث ينتقل الحوار من وصف الهوايات إلى الحديث عن العلاقات الاجتماعية والعلاقات العاطفية بلباقة واحترام.","مهمة تطبيقية: سجّل مقطعاً صوتياً مدته دقيقة واحدة تصف فيه حلمك في ثلاث جمل، مستعملاً ثلاث كلمات جديدة من هذا الدرس (rêver (de), du talent, améliorer)، ثم قارن نبرتك بنبرة Annie في الفيديو الرئيسي واكتب جملة واحدة لتصحح فيها نبرتك."]}],"pron":[{"w":"rêver de","ipa":"[ʁe.ve də]","approx":"ريفي دُ"},{"w":"la voix","ipa":"[la vwa]","approx":"لا فوا"},{"w":"du talent","ipa":"[dy ta.lɑ̃]","approx":"دو تالان"}],"vocab":[{"fr":"rêver (de)","ar":"يحلم (بـ)","pos":"verbe","g":"","exFr":"Elle rêve de devenir chanteuse.","ipa":"","exAr":"تحلم بأن تصبح مغنية."},{"fr":"chanter / la chanson","ar":"يغني / الأغنية","pos":"verbe/nom","g":"","exFr":"Il chante très bien.","ipa":"","exAr":"يغني جيداً."},{"fr":"la voix","ar":"الصوت","pos":"nom","g":"f","exFr":"Elle a une belle voix.","ipa":"","exAr":"لديها صوت جميل."},{"fr":"du talent","ar":"موهبة","pos":"nom","g":"m","exFr":"Tu as vraiment du talent.","ipa":"","exAr":"لديك موهبة حقاً."},{"fr":"trouver que","ar":"يجد أن / يعتقد أن","pos":"loc.","g":"","exFr":"Je trouve que c’est une bonne idée.","ipa":"","exAr":"أرى أنها فكرة جيدة."},{"fr":"améliorer","ar":"يحسّن","pos":"verbe","g":"","exFr":"On peut améliorer ce morceau.","ipa":"","exAr":"يمكننا تحسين هذا المقطع."},{"fr":"la partition","ar":"القطعة الموسيقية (ورقة النوتة)","pos":"nom","g":"f","exFr":"Elle apprend une nouvelle partition.","ipa":"[la paʁ.tisjɔ̃]","exAr":"هي تتعلّم قطعة موسيقية جديدة."},{"fr":"un spectacle / un micro","ar":"عرض / ميكروفون","pos":"nom","g":"m","exFr":"Le spectacle commence à vingt heures.","ipa":"","exAr":"يبدأ العرض في الثامنة مساءً."},{"fr":"osé(e)","ar":"جريء","pos":"adj.","g":"","exFr":"C’est une idée un peu osée.","ipa":"","exAr":"هذه فكرة جريئة قليلاً."},{"fr":"timide","ar":"خجول","pos":"adj.","g":"","exFr":"Elle est trop timide pour chanter.","ipa":"","exAr":"هي خجولة جداً للغناء."},{"fr":"un avis / une critique","ar":"رأي / نقد","pos":"nom","g":"m/f","exFr":"Tu peux me donner ton avis ?","ipa":"","exAr":"هل يمكنك أن تعطيني رأيك؟"},{"fr":"continuer","ar":"يواصل","pos":"verbe","g":"","exFr":"Continue, je t’écoute !","ipa":"","exAr":"واصل، أنا أستمع إليك!"}],"examples":[{"fr":"Tu rêves de chanter, c’est ça ?","ar":"تحلمين بالغناء، وهل هذا صحيح؟","note":"تأكيد الحلم"},{"fr":"J’aime bien ta voix, mais elle manque de puissance.","ar":"أعجبني صوتك، لكنه ينقصه قوة.","note":"الإطراء ثم الملاحظة"},{"fr":"Je trouve que tu as du talent !","ar":"أرى أن لديك موهبة!","note":"trouver que"},{"fr":"Ce n’est pas parfait, mais on peut améliorer.","ar":"إنه ليس مثالياً، لكن يمكننا التحسين.","note":"النقد البنّاء"},{"fr":"Continue, tu progresses !","ar":"واصل، أنت تتقدم!","note":"التشجيع"},{"fr":"Un jour, tu feras un vrai spectacle.","ar":"يوماً ما ستنظّم عرضاً حقيقياً.","note":"المستقبل البسيط"}],"grammar":[{"tFr":"Trouver que / aimer + complément","tAr":"trouver que وأفعال التفضيل","body":["« Je trouve que c’est… » الرأي المباشر — لا subjunctive مع être. لكن مع أفعال الرغبة والشك: « Je veux que tu viennes » يظهر subjunctif — وهذا النمط موجود في Extra لكنه غير مركّز عليه هنا.","« J’aime bien » أكثر شيوعاً من « J’aime » في النقد اليومي: bien تخفّف الحكم وتدل على تفضيل شخصي لا على محبة عميقة."],"ex":[{"fr":"Je trouve que cette chanson est belle.","ar":"أرى أن هذه الأغنية جميلة."},{"fr":"J’aime bien chanter sous la douche.","ar":"أحب أن أغني في الحمّام."}]},{"tFr":"Rêver de + infinitif","tAr":"rêver de + المصدر","body":["« Rêver de + infinitif » = يحلم بفعل: « rêver de voyager ». مع اسم: « rêver d’un métier ».","انتبه إلى elision: rêver + d’un — الهمزة تختفي دائماً بعد d."],"ex":[{"fr":"Elle rêve d’un voyage au Japon.","ar":"تحلم برحلة إلى اليابان."},{"fr":"Je rêve de voyager un jour.","ar":"أحلم بالسفر يوماً ما."}]}],"mistakes":[{"wrong":"« Je suis talent »","right":"« J’ai du talent »","why":"talent يُعبَّر عنه بـavoir وليس être."},{"wrong":"« Je rêve à voyager »","right":"« Je rêve de voyager »","why":"rêver يأخذ de."},{"wrong":"« Il est motivant » عن شخص","right":"« Il est motivé »","why":"motivé للشخص، motivant للنشاط."},{"wrong":"نقد مباشر: « C’est nul ! »","right":"« Ce n’est pas parfait, mais… »","why":"النقد المجرّد يُستبدل بتخفيف ثم ملاحظة."}],"dialogues":[{"title":"في المقهى","ctx":"Annie تغني أمام أصدقائها","lines":[{"who":"Annie","fr":"Je peux chanter quelque chose pour vous ?","ar":"هل يمكنني أن أغني شيئاً لكم؟"},{"who":"Hugo","fr":"Vas-y, on écoute !","ar":"تفضلي، نحن نستمع!"},{"who":"Annie","fr":"(chante) …alors je rêve de partir.","ar":"(تغني)… إذن أحلم بالرحيل."},{"who":"Nicolas","fr":"C’est joli ! Tu as une belle voix.","ar":"جميل! لديك صوت جميل."}]},{"title":"النقد البنّاء","ctx":"Sam تناقش الأداء مع Annie","lines":[{"who":"Sam","fr":"Tu as du talent, vraiment.","ar":"لديك موهبة، حقاً."},{"who":"Annie","fr":"Merci ! Mais tu as des remarques ?","ar":"شكراً! لكن لديك ملاحظات؟"},{"who":"Sam","fr":"Peut-être un peu plus de volume au refrain.","ar":"ربما قليلاً من القوة في الجوقة."},{"who":"Annie","fr":"Bonne idée, je continue à travailler !","ar":"فكرة جيدة، سأواصل العمل!"}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما معنى « rêver de »؟","opts":["يحلم بـ","يخاف من","يندم على","ينتظر"],"a":0,"why":"rêver de = يحلم."},{"t":"fill","skill":"speaking","q":"أكمل: «Je ___ que tu as du talent.»","fr":"Je ___ que tu as du talent.","ans":"trouve","why":"trouver que = أرى/أعتقد أن."},{"t":"mcq","skill":"grammar","q":"أي صيغة أدقّ للنقد الودود؟","opts":["Ce n’est pas parfait, mais…","C’est nul !","Tu chantes mal.","Arrête de chanter."],"a":0,"why":"التخفيف ثم الاقتراح هو النمط الفرنسي."},{"t":"order","skill":"writing","q":"رتّب: أحب صوتك لكن يمكننا التحسين","words":["J’aime","bien","ta","voix,","mais","on","peut","améliorer."],"ans":"J’aime bien ta voix, mais on peut améliorer.","why":"الإطراء ثم الملاحظة."},{"t":"listen","skill":"listening","q":"ما التعبير الذي يدل على الموهبة؟","opts":["Tu as du talent !","Tu es fatigué.","C’est trop cher.","Je n’ai pas le temps."],"a":0,"why":"talent = موهبة."},{"t":"translate","skill":"writing","q":"ترجم: تحلمين بالغناء، وإنه ليس مثالياً لكن يمكننا التحسين.","ans":"Tu rêves de chanter, ce n’est pas parfait mais on peut améliorer.","why":"الحلم ثم التقييم البنّاء."},{"t":"speaking","skill":"speaking","q":"اذكر حلمك في ثلاث جمل ثم قدّم رأيك في حلم صديق — بصوت عالٍ.","target":"Je rêve de… / Je trouve que… / On peut…","why":"نمط الأحلام والتقييم."},{"t":"correct","skill":"grammar","q":"صحّح: «Je rêve à voyager en France.»","ans":"Je rêve de voyager en France.","why":"rêver يأخذ de."}],"homework":"شاهد الحلقة ثلاث مرات، ثم اكتب فقرة من خمس جمل عن حلم شخصي (خصوصاً بالموسيقى أو الفن) مع نقد بنّاء واحد لذاتك.","sources":[{"title":"Extra French episode 5 with French subtitles","channel":"angyne","videoId":"XWMYPqR1D6Q","why":"الحلقة الخامسة كاملة: Annie تحاول الغناء أمام أصدقائها — مفردات الأحلام والمشاعر والتقييم.","cat":"Séries","level":"B1","main":true},{"title":"Extra French - Episode 5","channel":"dandimite learning channel","videoId":"lKT9W_SLdkM","why":"نسخة أخرى من الحلقة الخامسة — أعد الاستماع للتأكد من فهمك.","cat":"Séries","level":"B1","extra":true},{"title":"الحلقة 5 مسلسل الفرنسي extra مترجم للعربية","channel":"مغربي pro","videoId":"cGMWi-9M5oI","why":"الحلقة مترجمة بالعربية — مراجعة سريعة للمعاني عند الحاجة.","cat":"Séries","level":"B1","extra":true}],"supplements":[{"id":"lKT9W_SLdkM","title":"Extra French - Episode 5","channel":"dandimite learning channel","why":"نسخة أخرى من الحلقة الخامسة — أعد الاستماع للتأكد من فهمك.","lang":"fr","dur":25},{"id":"cGMWi-9M5oI","title":"الحلقة 5 مسلسل الفرنسي extra مترجم للعربية","channel":"مغربي pro","why":"الحلقة مترجمة بالعربية — مراجعة سريعة للمعاني عند الحاجة.","lang":"fr","dur":24}]},{"id":"b1-t8-l6","fr":"Extra — Épisode 6 : Annie a un petit ami","ar":"Extra — الحلقة 6: لدى Annie صديق جديد","objectives":["وصف علاقة اجتماعية بجمل واضحة (ami / petit ami / copain)","فهم وتوليد أسئلة العلاقات: منذ متى، كيف تعرفتما، ماذا تحبان","تمييز استخدام être مقابل avoir في وصف العلاقات","تحليل ردود فعل الأصدقاء عند خبر العلاقة الجديدة"],"sections":[{"h":"الحلقة 6: العلاقات الاجتماعية والتعارف العاطفي (الحلقة كاملة)","video":{"id":"ePwwpjNXHyM","title":"Extra French episode 6 with french subtitles","channel":"Frenchy french","why":"الحلقة السادسة كاملة: موضوع الصديق/الصديقة والعلاقات الاجتماعية — مفردات المشاعر بلطف واحترام.","lang":"fr","main":true,"dur":25},"p":["الحلقة السادسة تعالج موضوع العلاقات الاجتماعية: لدى Annie صديق جديد، وتسأل الأصدقاء رأيهم. الحوار هادئ ومليء بالمشاعر المعتدلة — وهو المستوى المطلوب لفهم الأفلام الفرنسية التي تتعامل مع العلاقات بلباقة لا بدراما.","من حيث المفردات، تظهر هنا: le petit ami، se rencontrer، être ensemble، être amoureux، la confidence. هذه المفردات أساس أي نقاش اجتماعي بسيط.","نحوياً، تظهر أفعال الانعكاس مع العلاقات: « se voir », « se rencontrer », « s’entendre ». لاحظ أن مع être في الماضي يظهر جمع المتكلم: « On s’est rencontrés ».","الحلقة جيدة لتمرين «la confidence»: كيف تخبر صديقك بشيء شخصي دون أن تفقد احترامه — نبرة هادئة، فترات قصيرة، ثم سؤال عن الرأي.","انتبه إلى نبرة الاستماع: عندما يحكي أحدهم شيئاً شخصياً، الفرنسيون يستخدمون « Ah oui ? » و« Vraiment ? » و« Et alors ? » بنبرة صاعدة — إشارات تشجيع للاستمرار.","بعد الحلقة، صف علاقة اجتماعية قصيرة في ثلاث جمل: من، منذ متى، وشيء واحد تحبه في هذه العلاقة — دون تفاصيل شخصية أكثر مما تحتاج."],"sub":[{"h":"جمل العلاقات الأساسية","p":["Annie a un petit ami maintenant.","Vous vous êtes rencontrés comment ?","On est ensemble depuis deux mois.","Il est gentil, mais un peu timide."]},{"h":"أدوات نطقية: elision مع être/avoir","p":["« On est ensemble » تُنطَق ككتلة [ɔ̃.nɛ.tɑ̃səl].","« Elle a un… » → [ɛ.la œ̃…] بدون فاصل.","« depuis deux mois » — la voyelle [ø] قصيرة حادة."]},{"h":"خطوات Listen & Repeat","p":["المرة الأولى: اكتب كل اسم علاقة سمعتها.","الثانية: كرّر الأسئلة بنبرتها الصاعدة.","الثالثة: أجب عن الأسئلة الثلاثة في حوار مع نفسك."]}]},{"h":"عبارات الثقة والرأي","p":["« Tu peux me faire une confidence ? » = «هل يمكنك أن تخبرني بشيء سرّي؟» — تعبير اجتماعي فرنسي نموذجي.","« Depuis quand vous êtes ensemble ? » سؤال «منذ متى» — depuis يدل على استمرار.","« Il me plaît beaucoup. » صيغة أخرى للإعجاب: plaire + مفعول غير مباشر.","« C’est une bonne surprise ! » تعبير استقبال الخبر — يُقال بنبرة صاعدة حماسية."]},{"h":"التطبيق والتلخيص","p":["تمرين الثقة: شخص يخبر صديقه بشيء بسيط (مشروع، خبر، رأي) والآخر يردّ بأربع جمل: ترحيب، سؤال، رأي، دعوة.","كتابة: رسالة قصيرة تصف فيها صديقاً جديداً بالفرنسية (خمس جمل).","سجّل حواراً قصيراً يبدأ بـ« Je peux te faire une confidence ? » وينتهي بردّ إيجابي."]},{"h":"التطبيق والتلخيص","p":["خلاصة: صفّيتَ علاقة اجتماعية بلغة واضحة، وسألتَ عن العلاقات (منذ متى، كيف تقابلتما) مع depuis/pendant، وميّزتَ être/avoir وأفعال الانعكاس في الماضي، وتمرّنتَ على «la confidence» بنبرة هادئة. «أعد مشاهدة الفيديو الرئيسي وركّز على نبرة التشجيع الصاعدة في ردود «Ah oui ?» و«Vraiment ?» وعلى هدوء لحظة إعلان الخبر»","جسر الدروس: من b1-t8-l5 (وصف الحلم والتقييم بأدب) إلى b1-t8-l6 (الحديث عن العلاقات بلباقة)، ثم إلى b1-t8-l7 حيث يتحوّل الحديث إلى تنظيم حفلة: الدعوة، الموعد، المكان، وماذا يُحضر كل واحد.","مهمة تطبيقية: سجّل حواراً من دقيقة واحدة يبدأ بـ«Je peux te faire une confidence ?» وينتهي بردّ إيجابي، مستعملاً ثلاث كلمات جديدة من هذا الدرس (être ensemble, depuis, plaire (à))؛ ثم قارن نبرتك بنبرة الحوار في الفيديو وحدّد الفرق."]}],"pron":[{"w":"le petit ami","ipa":"[lə pti.ta.mi]","approx":"لو بيتي آمي"},{"w":"être ensemble","ipa":"[ɛtʁ ɑ̃.tɑ̃bl]","approx":"إتر أنطانبل"},{"w":"une confidence","ipa":"[yn kɔ̃.fi.dɑ̃s]","approx":"ين كونفيدانس"}],"vocab":[{"fr":"le petit ami / la petite amie","ar":"الصديق/الصديقة (العلاقة)","pos":"nom","g":"m/f","exFr":"Elle a un petit ami français.","ipa":"","exAr":"لديها صديق فرنسي."},{"fr":"être ensemble","ar":"يكونان معاً (علاقة)","pos":"loc.","g":"","exFr":"Ils sont ensemble depuis un an.","ipa":"","exAr":"هما معاً منذ سنة."},{"fr":"se rencontrer","ar":"يتقابلان (أوّل مرة)","pos":"verbe pronominal","g":"","exFr":"On s’est rencontrés au travail.","ipa":"","exAr":"تقابلنا في العمل."},{"fr":"amoureux(se)","ar":"عاشق/عاشق","pos":"adj.","g":"","exFr":"Il est amoureux de sa voisine.","ipa":"","exAr":"هو عاشق جارته."},{"fr":"une confidence","ar":"أمر سرّي، ثقة","pos":"nom","g":"f","exFr":"Elle m’a fait une confidence.","ipa":"","exAr":"أخبرتني بأمر سرّي."},{"fr":"gentil(le)","ar":"لطيف/لطيفة","pos":"adj.","g":"","exFr":"C’est un garçon très gentil.","ipa":"","exAr":"هو شاب لطيف جداً."},{"fr":"depuis","ar":"منذ (استمرار)","pos":"prép.","g":"","exFr":"Depuis deux mois, on se voit chaque semaine.","ipa":"","exAr":"منذ شهرين، نرى بعضنا كل أسبوع."},{"fr":"plaire (à)","ar":"يعجب (لـ)","pos":"verbe","g":"","exFr":"Tu me plais beaucoup.","ipa":"","exAr":"أنت تعجبني كثيراً."},{"fr":"un souci / une surprise","ar":"همّ / مفاجأة","pos":"nom","g":"m/f","exFr":"Ce n’est pas un souci.","ipa":"","exAr":"ليس أمراً خطيراً."},{"fr":"jaloux(se)","ar":"غيور / غائرة","pos":"adj.","g":"","exFr":"Il est jaloux de son meilleur ami.","ipa":"[ʒa.lu]","exAr":"هو غيور على صديقه المقرّب."},{"fr":"un copain / une copine","ar":"صديق/صديقة (عامي)","pos":"nom","g":"m/f","exFr":"C’est un copain de classe.","ipa":"","exAr":"هو صديق في الفصل."},{"fr":"content(e)","ar":"سعيد","pos":"adj.","g":"","exFr":"Je suis contente pour toi !","ipa":"","exAr":"أنا سعيدة من أجلك!"}],"examples":[{"fr":"Annie a un petit ami maintenant.","ar":"لدى Annie الآن صديق.","note":"الخبر المباشر"},{"fr":"Vous vous êtes rencontrés comment ?","ar":"كيف تقابلتما؟","note":"السؤال عن اللقاء"},{"fr":"On est ensemble depuis deux mois.","ar":"هما معاً منذ شهرين.","note":"depuis + المدة"},{"fr":"Il est gentil, mais un peu timide.","ar":"إنه لطيف، لكنه خجول قليلاً.","note":"الوصف المتوازن"},{"fr":"Tu peux me faire une confidence ?","ar":"هل يمكنك أن تخبرني بشيء؟","note":"طلب الثقة"},{"fr":"Je suis contente pour toi !","ar":"أنا سعيدة من أجلك!","note":"الترحيب بالخبر"}],"grammar":[{"tFr":"Depuis vs pendant","tAr":"الفرق بين depuis وpendant","body":["« Depuis deux mois » = منذ شهرين (مستمر)، « pendant deux mois » = لمدة شهرين (منتهٍ). في حوار العلاقات تُستخدم depuis مع la durée الحالية.","مع le début: « depuis le mois dernier » — لاحظ أن depuis يربط الماضي بالحاضر."],"ex":[{"fr":"On se voit depuis trois semaines.","ar":"نرى بعضنا منذ ثلاثة أسابيع."},{"fr":"Ils ont vécu à Paris pendant cinq ans.","ar":"عاشوا في باريس لمدة خمس سنوات."}]},{"tFr":"Verbes pronominaux de relation","tAr":"الأفعال الانعكاسية للعلاقات","body":["« Se rencontrer / se voir / s’entendre » كلها أفعال اجتماعية انعكاسية. مع être في الماضي يظهر جمع المتكلم: « On s’est rencontrés ».","« S’entendre bien » = يتفقان جيداً — أكثر دقة من « être amis » ويشمل العلاقات غير العاطفية."],"ex":[{"fr":"On s’est rencontrés à l’université.","ar":"تقابلنا في الجامعة."},{"fr":"Ils s’entendent très bien.","ar":"هما يتفقان جيداً."}]}],"mistakes":[{"wrong":"« Je suis un petit ami »","right":"« J’ai un petit ami »","why":"العلاقة تُعبَّر عنها بـavoir لا être."},{"wrong":"« On était ensemble depuis deux mois » لعلاقة منتهية","right":"« On était ensemble pendant deux mois »","why":"depuis للاستمرار، pendant للمدة المنتهية."},{"wrong":"« Il me plaît » بلا مفعول","right":"« Il me plaît beaucoup » / « Tu me plais »","why":"plaire يحتاج مفعولاً غير مباشر (à quelqu’un)."},{"wrong":"« Je suis content de toi »","right":"« Je suis content pour toi ! »","why":"content pour + الشخص المُبارَك له."}],"dialogues":[{"title":"الخبر الجديد","ctx":"Annie تخبر Sam","lines":[{"who":"Annie","fr":"Sam, je peux te faire une confidence ?","ar":"Sam، هل يمكنني أن أخبرك بشيء؟"},{"who":"Sam","fr":"Bien sûr, je t’écoute.","ar":"بالطبع، أنا أستمع إليك."},{"who":"Annie","fr":"J’ai un petit ami. On est ensemble depuis un mois.","ar":"لديّ صديق. نحن معاً منذ شهر."},{"who":"Sam","fr":"Ah oui ! Je suis contente pour toi !","ar":"آه نعم! أنا سعيدة من أجلك!"}]},{"title":"سؤال الرأي","ctx":"Hugo يسأل عن صديق Annie","lines":[{"who":"Hugo","fr":"Il est comment, ton petit ami ?","ar":"كيف هو صديقك؟"},{"who":"Annie","fr":"Il est gentil, mais un peu timide.","ar":"إنه لطيف، لكنه خجول قليلاً."},{"who":"Hugo","fr":"Et vous vous voyez souvent ?","ar":"وهل تراه كثيراً؟"},{"who":"Annie","fr":"Deux fois par semaine. C’est bien.","ar":"مرتين في الأسبوع. إنه جيد."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما معنى « un petit ami »؟","opts":["الصديق (العلاقة)","الأخ","الجار","الزميل"],"a":0,"why":"petit ami = صديق (العلاقة العاطفية)."},{"t":"fill","skill":"speaking","q":"أكمل: «On est ensemble ___ deux mois.»","fr":"On est ensemble ___ deux mois.","ans":"depuis","why":"depuis للاستمرار."},{"t":"mcq","skill":"grammar","q":"السؤال الصحيح عن اللقاء:","opts":["Vous vous êtes rencontrés comment ?","Vous êtes rencontré comment ?","Vous rencontrez-vous comment ?","Comment vous rencontrez ?"],"a":0,"why":"الانعكاسي مع être في الماضي والجمع."},{"t":"order","skill":"writing","q":"رتّب: لديّ صديق، إنه لطيف لكنه خجول","words":["J’ai","un","petit","ami,","il","est","gentil","mais","timide."],"ans":"J’ai un petit ami, il est gentil mais timide.","why":"الخبر ثم الوصف المتوازن."},{"t":"listen","skill":"listening","q":"ما السؤال الذي يدل على المدة؟","opts":["Depuis quand vous êtes ensemble ?","Vous vous êtes rencontrés comment ?","Il est comment ?","Vous vous voyez où ?"],"a":0,"why":"depuis quand = منذ متى."},{"t":"translate","skill":"writing","q":"ترجم: إنه لطيف لكنه خجول قليلاً، وهما معاً منذ شهر.","ans":"Il est gentil mais un peu timide, et ils sont ensemble depuis un mois.","why":"الوصف ثم المدة مع depuis."},{"t":"speaking","skill":"speaking","q":"اسأل زميلك: هل لديك صديق؟ منذ متى؟ — جملتان بصوت عالٍ.","target":"Tu as un petit ami ? / Depuis quand vous êtes ensemble ?","why":"نمط أسئلة العلاقات."},{"t":"correct","skill":"grammar","q":"صحّح: «Je rêve à voyager…» — كرر القاعدة مع «Je suis amoureux à Marie.»","ans":"Je suis amoureux de Marie.","why":"amoureux de + الشخص."}],"homework":"شاهد الحلقة ثلاث مرات، ثم اكتب فقرة من خمس جمل عن صديق تعرفت عليه حديثاً: من هو، منذ متى، وصفته، وما تحبه فيه — مع جملة واحدة « depuis ».","sources":[{"title":"Extra French episode 6 with french subtitles","channel":"Frenchy french","videoId":"ePwwpjNXHyM","why":"الحلقة السادسة كاملة: موضوع الصديق/الصديقة والعلاقات الاجتماعية — مفردات المشاعر بلطف واحترام.","cat":"Séries","level":"B1","main":true},{"title":"Extr@ French Episode 06 - French/English Subtitles","channel":"Manuel Rosero","videoId":"Qcc_Kxjswqg","why":"نسخة بترجمة مزدوجة — مفيدة لمقارنة الفهم الفرنسي بالإنجليزي.","cat":"Séries","level":"B1","extra":true},{"title":"extra francais avec sous-titres francais - Episode 6","channel":"Karen","videoId":"_zd36urryCc","why":"نسخة أخرى بالترجمة الفرنسية — أعد الاستماع لتثبيت المفردات.","cat":"Séries","level":"B1","extra":true}],"supplements":[{"id":"Qcc_Kxjswqg","title":"Extr@ French Episode 06 - French/English Subtitles","channel":"Manuel Rosero","why":"نسخة بترجمة مزدوجة — مفيدة لمقارنة الفهم الفرنسي بالإنجليزي.","lang":"fr","dur":25},{"id":"_zd36urryCc","title":"extra francais avec sous-titres francais - Episode 6","channel":"Karen","why":"نسخة أخرى بالترجمة الفرنسية — أعد الاستماع لتثبيت المفردات.","lang":"fr","dur":39}]},{"id":"b1-t8-l7","fr":"Extra — Épisode 7 : La fête","ar":"Extra — الحلقة 7: الحفلة والدعوة","objectives":["التخطيط لحفلة بجمل عملية: الدعوة، الوقت، المكان، ماذا يُحضر","استعمال الأمر والاقتراح مع friends (on pourrait, tu peux)","فهم الأرقام والوقت في سياق تنظيمي سريع","تحليل الفرق بين الدعوة الرسمية والودّية في الفرنسية"],"sections":[{"h":"الحلقة 7: تنظيم حفلة والدعوة (الحلقة كاملة)","video":{"id":"4AyMirxizzA","title":"Extra French episode 7 with french subtitles","channel":"Frenchy french","why":"الحلقة السابعة كاملة: تحضير حفلة بين الأصدقاء — الدعوة، المواعيد، المفاجآت، ولغة التخطيط.","lang":"fr","main":true,"dur":25},"p":["الحلقة السابعة تحول اللغة إلى أداة تنظيم: الأصدقاء يخطّطون لحفلة، ويتبادلون الاقتراحات والمفاجآت. كل جملة هنا قابلة للاستعمال مباشرة في حياتك اليومية — من « À quelle heure ? » إلى « Qui apporte quoi ? ».","الحلقة تقدّم تمرين نادراً في كتب التمارين: حوار جماعي سريع فيه تداخل ومقاطعة. تدرّب على التقاط الكلمات المفتاحية (l’heure, le gâteau, la musique) دون محاولة فهم كل كلمة.","من حيث الصيغ، يظهر هنا الأمر المتعدد الأدوار: « Apporte le gâteau ! » و« Dis à tout le monde de venir ! ». لاحظ أن la/le/les تنضم إلى الفعل كمفعول به مباشر في الأمر.","الحلقة تعرّفك أيضاً على عبارات الفرنسية اليومية للمفاجأة: « C’est une surprise ! » و« Ne dis rien ! » — وهما أكثر من مجرد كلمتين، بل نمط اجتماعي كامل.","بعد الحلقة، خطّط لحفلتك القادمة بالفرنسية: اكتب قائمة بالدعوة (من)، الموعد (متى)، المكان (أين)، وقائمة بما يُحضر (ماذا) — ثم اشرحها في 40 ثانية.","الحلقة السابعة تقدّم درساً في la fête: كيف تُدار الحماسات الصغيرة بلغة محترمة — الاعتذار عند التأخير، دعوة المشاركة، ثم الشكر. جرّب أن تحضر حفلة خيالية بخمس جمل."],"sub":[{"h":"جمل التخطيط والدعوة","p":["On fait une fête samedi soir, tu viens ?","À quelle heure ça commence ?","Apporte le gâteau, d’accord ?","C’est une surprise, ne dis rien !"]},{"h":"أدوات نطقية: الوقت والأرقام","p":["« à vingt heures » تُسمع التاء الصامتة في vingt.","« samedi soir » تُنطَق كوحدة [sam.di swaʁ].","« ne dis rien » → [nə di ʁjɛ̃] مع elision في ne."]},{"h":"خطوات Listen & Repeat","p":["المرة الأولى: اكتب كل رقم ووقت سمعته.","الثانية: كرّر جمل الدعوة بنبرتها الودّية.","الثالثة: أعد بناء الحفلة بموعد جديد."]}]},{"h":"عبارات الدعوة والتخطيط","p":["« Tu viens ? » أمر/سؤال دعوة مختصر — أكثر شيوعاً من « Est-ce que tu viens ? » بين الأصدقاء.","« Qui apporte quoi ? » سؤال التوزيع الجماعي — لاحظ quoi بلا أداة في نهاية السؤال.","« Je passe te chercher à dix-neuf heures. » = سآتي لأخدك — تعبير مفرد جاهز للتنقّل.","« On annule ! » = نُلغي! — elision مع le/la: on annul + on annule (لا ارتباك: la/le تنضم للفعل)."]},{"h":"التطبيق والتلخيص","p":["تمرين التنظيم: اكتب دعوة رسمية (رسالة) ودعوة ودية (رسالة قصيرة) لنفس الحفلة — قارن الصيغتين.","ثنائي: شخص يدعو وآخر يسأل ثلاثة أسئلة (الوقت، من سيحضر، ماذا يُحضر) ثم يوافق.","كتابة: فقرة من خمس جمل تصف حفلة ماضية: متى، مع من، ماذا فعلتم، وما أفضل ما حدث."]},{"h":"التطبيق والتلخيص","p":["خلاصة: خطّطتَ لحفلة كاملة بلغة عملية: الدعوة، الوقت، المكان، وتوزيع ما يُحضر، مع الأمر المتعدد (Apporte… ! / Ne dis rien !) وصيغ الاقتراح المهذّب (on pourrait, tu peux). «أعد مشاهدة الفيديو الرئيسي وركّز على الحوار الجماعي السريع: التقط الكلمات المفتاحية (l’heure, le gâteau, la musique) دون محاولة فهم كل كلمة»","جسر الدروس: من b1-t8-l6 (العلاقات والثقة) إلى b1-t8-l7 (الدعوة والتخطيط للموعد)، ثم إلى b1-t8-l8 حيث تصل وافدة جديدة إلى العمارة وتبدأ نصائح الاستقبال وتمارين المقارنة.","مهمة تطبيقية: سجّل دعوة من دقيقة واحدة لصديق (متى، أين، ماذا يحضر) مستعملاً ثلاث كلمات جديدة من هذا الدرس (les ballons, préparer, tout le monde)، ثم قارن نبرتك الودّية بنبرة Hugo في الفيديو واكتب جملة تصحّح فيها سرعتك."]}],"pron":[{"w":"la fête","ipa":"[la fɛt]","approx":"لا فيت"},{"w":"une invitation","ipa":"[yn ɛ̃.vi.ta.sjɔ̃]","approx":"ين إينفيتاسيون"},{"w":"le gâteau","ipa":"[lə ɡa.to]","approx":"لو غاتو"}],"vocab":[{"fr":"la fête","ar":"الحفلة","pos":"nom","g":"f","exFr":"La fête commence à vingt heures.","ipa":"","exAr":"تبدأ الحفلة في الثامنة مساءً."},{"fr":"les ballons","ar":"البالونات","pos":"nom","g":"m","exFr":"On gonfle les ballons avant la fête.","ipa":"[le ba.lɔ̃]","exAr":"ننفّخ البالونات قبل الحفلة."},{"fr":"trinquer","ar":"يرفع الكأس تصفيقاً (يحتفل)","pos":"verbe","g":"","exFr":"On trinque à la santé des amis !","ipa":"[tʁɛ̃.ke]","exAr":"نرفع الكؤوس صحّة الأصدقاء!"},{"fr":"le gâteau / l’anniversaire","ar":"الكعكة / عيد الميلاد","pos":"nom","g":"m","exFr":"On prépare un gâteau pour Paul.","ipa":"","exAr":"نحضّر كعكة لبول."},{"fr":"la musique / danser","ar":"الموسيقى / يرقص","pos":"nom/verbe","g":"","exFr":"On met de la musique et on danse.","ipa":"","exAr":"نشغّل الموسيقى ونرقص."},{"fr":"annuler","ar":"يلغي","pos":"verbe","g":"","exFr":"On annule la fête à cause de la pluie.","ipa":"","exAr":"نُلغي الحفلة بسبب المطر."},{"fr":"la surprise","ar":"مفاجأة","pos":"nom","g":"f","exFr":"C’est une surprise, tu ne sais rien !","ipa":"","exAr":"إنه مفاجأة، لا تعرف شيئاً!"},{"fr":"passer (qqn)","ar":"يمرّ ليأخذ (شخصاً)","pos":"verbe","g":"","exFr":"Je passe te chercher à six heures.","ipa":"","exAr":"أمرّ لأخذك في السادسة."},{"fr":"préparer","ar":"يحضّر","pos":"verbe","g":"","exFr":"Qui prépare la table ?","ipa":"","exAr":"من يحضّر الطاولة؟"},{"fr":"tout le monde","ar":"الجميع","pos":"loc.","g":"","exFr":"Tout le monde est invité !","ipa":"","exAr":"الجميع مدعو!"},{"fr":"à quelle heure","ar":"في أي ساعة","pos":"loc.","g":"","exFr":"À quelle heure on se retrouve ?","ipa":"","exAr":"في أي ساعة نلتقي؟"},{"fr":"la boisson / les chips","ar":"المشروبات / رقائق البطاطس","pos":"nom","g":"","exFr":"On achète les boissons et les chips.","ipa":"","exAr":"نشتري المشروبات والرقائق."}],"examples":[{"fr":"On fait une fête samedi soir, tu viens ?","ar":"نقيم حفلة مساء السبت، هل تأتي؟","note":"الدعوة المباشرة"},{"fr":"À quelle heure ça commence ?","ar":"في أي ساعة يبدأ؟","note":"سؤال الوقت"},{"fr":"Apporte le gâteau, d’accord ?","ar":"أحضر الكعكة، موافق؟","note":"الأمر + تأكيد"},{"fr":"C’est une surprise, ne dis rien !","ar":"إنها مفاجأة، لا تقل شيئاً!","note":"المفاجأة"},{"fr":"Je passe te chercher à dix-neuf heures.","ar":"سآتي لأخدك في السابعة مساءً.","note":"passer + qqn"},{"fr":"Qui apporte quoi ?","ar":"من يحضر ماذا؟","note":"التوزيع"}],"grammar":[{"tFr":"Impératif avec COD (la/le/les)","tAr":"الأمر مع المفعول به المباشر","body":["« Apporte le gâteau ! » — la/le/les تنضم إلى الفعل في الأمر: « Prends-la ! », « Dis-le-lui ! ». النمط يُستخدم يومياً في التخطيط.","« Ne dis rien ! » النفي في الأمر: ne + verb + rien/plus/personne — لاحظ elision مع les: « Ne les oublie pas ! »."],"ex":[{"fr":"Prends cette invitation et donne-la à Marie.","ar":"خذ هذه الدعوة وأعطها لماري."},{"fr":"N’oublie pas la musique !","ar":"لا تنسَ الموسيقى!"}]},{"tFr":"On pourrait / tu peux + infinitif","tAr":"الاقتراح والطلب اليومي","body":["« On pourrait faire… » اقتراح مهذّب؛ « Tu peux faire… » طلب مباشر. في الحفلة تسمع الاثنان — الفرق في درجة الودّ.","« Qui apporte quoi ? » نمط سؤال مفتوح: أداة استفهام + فعل + أداة استفهام — لا تُترجم حرفياً بل كوحدة معنى."],"ex":[{"fr":"On pourrait inviter Sophie aussi.","ar":"يمكننا أن ندعو صوفي أيضاً."},{"fr":"Tu peux fermer la porte, s’il te plaît ?","ar":"هل يمكنك أن تغلق الباب من فضلك؟"}]}],"mistakes":[{"wrong":"« À quelle heure ça commence-t-il ? » في الحديث اليومي","right":"« À quelle heure ça commence ? »","why":"الاستفهام المختصر هو السائد في الفرنسية المعاصرة."},{"wrong":"« Je passe à te chercher »","right":"« Je passe te chercher »","why":"passer + infinitif مباشرة بلا à."},{"wrong":"« C’est surprise ! »","right":"« C’est une surprise ! »","why":"المفاجأة اسم معدود يأخذ une."},{"wrong":"« On annule la fête, c’est dommage ! » بنبرة سعيدة","right":"اربطها بنبرة حزينة أو استخدم « hélas »","why":"الكلمة وحدها لا تنقل المشاعر؛ النبرة تحسم."}],"dialogues":[{"title":"الدعوة","ctx":"Hugo يدعو Nicolas","lines":[{"who":"Hugo","fr":"On fait une fête samedi, tu viens ?","ar":"نقيم حفلة السبت، هل تأتي؟"},{"who":"Nicolas","fr":"À quelle heure ?","ar":"في أي ساعة؟"},{"who":"Hugo","fr":"À vingt heures. Apporte une boisson !","ar":"في الثامنة مساءً. أحضر مشروباً!"},{"who":"Nicolas","fr":"D’accord. Et c’est où, exactement ?","ar":"موافق. وأين بالضبط؟"}]},{"title":"المفاجأة","ctx":"Sam وAnnie تجهزان مفاجأة","lines":[{"who":"Sam","fr":"N’oublie pas : c’est une surprise pour Hugo !","ar":"لا تنسَ: إنها مفاجأة لهوغو!"},{"who":"Annie","fr":"Je sais, je ne dis rien. J’ai même préparé le gâteau.","ar":"أعلم، لا أقول شيئاً. بل حضّرت الكعكة حتى."},{"who":"Sam","fr":"Parfait ! Et la musique, c’est toi qui la mets ?","ar":"ممتاز! والموسيقى، أنتِ من يشغّلها؟"},{"who":"Annie","fr":"Oui, à dix-neuf heures et demie.","ar":"نعم، في السابعة والنصف مساءً."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما معنى « la fête »؟","opts":["الحفلة","التمرين","الفصل","المطعم"],"a":0,"why":"fête = حفلة/احتفال."},{"t":"fill","skill":"speaking","q":"أكمل: «À quelle ___ ça commence ?»","fr":"À quelle ___ ça commence ?","ans":"heure","why":"سؤال الوقت: à quelle heure."},{"t":"mcq","skill":"grammar","q":"الأمر الصحيح مع le gâteau:","opts":["Apporte-le !","Apporte la !","Apporter-le !","Le apporte !"],"a":0,"why":"le ينضم إلى الفعل بلا فاصل."},{"t":"order","skill":"writing","q":"رتّب: نقيم حفلة السبت، هل تأتي","words":["On","fait","une","fête","samedi,","tu","viens?"],"ans":"On fait une fête samedi, tu viens?","why":"الحدث ثم الدعوة."},{"t":"listen","skill":"listening","q":"ما السؤال عن الموعد؟","opts":["À quelle heure ?","Qui apporte quoi ?","Où ça commence ?","Pourquoi ?"],"a":0,"why":"à quelle heure = الوقت."},{"t":"translate","skill":"writing","q":"ترجم: سآتي لأخدك في السابعة مساءً، وأحضر مشروباً.","ans":"Je passe te chercher à dix-neuf heures, apporte une boisson.","why":"الوقت + الأمر."},{"t":"speaking","skill":"speaking","q":"ادعُ زميلاً لحفلة: متى، أين، وماذا يحضر — ثلاث جمل بصوت عالٍ.","target":"On fait… / Tu viens ? / Apporte…","why":"نمط الدعوة الكامل."},{"t":"correct","skill":"grammar","q":"صحّح: «Je passe à te chercher.»","ans":"Je passe te chercher.","why":"passer + infinitif مباشرة."}],"homework":"شاهد الحلقة ثلاث مرات، ثم اكتب دعوة رسمية ودية لنفس الحفلة (كل واحدة 4 أسطر) وسجّل الودّية بصوت عالٍ.","sources":[{"title":"Extra French episode 7 with french subtitles","channel":"Frenchy french","videoId":"4AyMirxizzA","why":"الحلقة السابعة كاملة: تحضير حفلة بين الأصدقاء — الدعوة، المواعيد، المفاجآت، ولغة التخطيط.","cat":"Séries","level":"B1","main":true},{"title":"extra francais avec sous-titres francais - Episode 7","channel":"toria","videoId":"-7-ilEGgsM0","why":"نسخة أخرى بالترجمة الفرنسية — أعد الاستماع لتثبيت لغة التخطيط.","cat":"Séries","level":"B1","extra":true},{"title":"Extr@ French Episode 07 - French/English Subtitles","channel":"Manuel Rosero","videoId":"iHn2F1rb7zQ","why":"نسخة بترجمة مزدوجة — مفيدة لمقارنة الفهم.","cat":"Séries","level":"B1","extra":true}],"supplements":[{"id":"-7-ilEGgsM0","title":"extra francais avec sous-titres francais - Episode 7","channel":"toria","why":"نسخة أخرى بالترجمة الفرنسية — أعد الاستماع لتثبيت لغة التخطيط.","lang":"fr","dur":24},{"id":"iHn2F1rb7zQ","title":"Extr@ French Episode 07 - French/English Subtitles","channel":"Manuel Rosero","why":"نسخة بترجمة مزدوجة — مفيدة لمقارنة الفهم.","lang":"fr","dur":24}]},{"id":"b1-t8-l8","fr":"Extra — Épisode 8 : La cousine de la concierge","ar":"Extra — الحلقة 8: ابنة عمّة حارسة العمارة","objectives":["وصف وصول شخص جديد وانطباعاته الأولى بلغة متسلسلة","استعمال صيغ المقارنة والأفضل (mieux, meilleur, plus… que)","فهم مفردات العلاقات العائلية extended family بالفرنسية","تحليل كيف تُعطى نصائح بين الجيران بلباقة"],"sections":[{"h":"الحلقة 8: الوافدة الجديدة وصداقات العمارة (الحلقة كاملة)","video":{"id":"SU1EbI9oH_I","title":"Extra French Episode 08 - La cousine de la concierge","channel":"Green Cilantro","why":"الحلقة الثامنة كاملة: ابنة عمّة حارسة العمارة تصل — وافدة جديدة، لغة جديدة، وتعارف جديد داخل العمارة.","lang":"fr","main":true,"dur":25},"p":["الحلقة الثامنة تعيد نموذج الوافد الجديد لكن بزاوية جديدة: ابنة عمّة حارسة العمارة تصل من مكان بعيد، وكل شيء يُعاد شرحه لها — الأماكن، العادات، القواعد. التكرار هنا ذكي: تسمع نفس المفردات بسياقات جديدة.","الحلقة غنية بمفردات الأسرة الممتدة: la cousine، la tante، la grand-mère — وهي أكثر أهمية في الثقافة الفرنسية مما تظن، فالأسرة الممتدة تحافظ على دور نشط في الحياة اليومية.","نحوياً، تظهر المقارنة بوضوح: « mieux que », « plus rapide que », « le meilleur ». المقارنة في الفرنسية ليست صعبة لكنها تتطلب انتباهاً إلى que و aux adjectifs الشاذة.","الحلقة تقدّم أيضاً درساً في « la patience sociale »: كيف تُشرح الأمور للوافد الجديد بنبرة صديقة لا متعالية — وهي مهارة مطلوبة من كل معلّم لغة.","بعد الحلقة، صف وافداً جديداً في مدينتك أو مدرستك بخمس جمل: من، من أين، أول انطباع، شيء أعجبه، وشيء صادره.","الحلقة الثامنة تكشف عن la cousine: الروابط العائلية والمفارقات الاجتماعية — la langue هنا ساخرة لكنها دقيقة. لاحظ كيف تُستخدم la politesse للمسافة."],"sub":[{"h":"جمل الوصول والانطباعات","p":["Ma cousine arrive demain, elle reste une semaine.","Tu as vu la nouvelle ?","Ici, la vie est plus calme qu’ailleurs.","Je te conseille de commencer par le marché."]},{"h":"أدوات نطقية: المقارنة المنطوقة","p":["« plus … que » تُنطَق [ply … kə] مع s صامتة.","« mieux » تسمع [mjø] بوضوح — لا تُنطق بالعربية.","« le meilleur » → [lə mɛ.jœʁ] بفتح الميم."]},{"h":"خطوات Listen & Repeat","p":["المرة الأولى: اكتب كل كلمة عائلة سمعتها.","الثانية: كرّر جمل المقارنة بنبرتها.","الثالثة: أضف مقارنتك الخاصة في ثلاث جمل."]}]},{"h":"عبارات النصيحة والاستقبال","p":["« Je te conseille de… » = أنصحك بـ… — أكثر رسمية ودقة من « Tu devrais… » في نصائح السياحة.","« C’est mieux comme ça ! » تعبير موافقة سريع — mieux هنا ظرف مقارن، ونلاحظ le mieux.","« Tu m’as manqué ! » = قدّرت اشتياقي لك! — تعبير اجتماعي قوي يُقال بين معارف.","« La vie est plus calme ici. » نمط المقارنة البسيط مع que محذوف في السؤال: « Plus calme qu’à la maison ? »"]},{"h":"التطبيق والتلخيص","p":["تمرين الوافد: شخص يصف مدينته الجديدة لشخص لم يزرها من قبل — ثلاث مقارنات إلزامية (أكبر، أهدأ، أجمل).","كتابة إرشاد: رسالة قصيرة لسائح في مدينتك: ماذا يزور، ماذا يأكل، وكيف يتنقّل (خمس جمل).","سجّل مقارنة بين مدينتك ومدينة أخرى بالفرنسية في 30 ثانية."]},{"h":"التطبيق والتلخيص","p":["خلاصة: صفّيتَ وافداً جديداً بثلاث مقارنات إلزامية مع plus/moins/aussi…que وصيغ الشذوذ (mieux, meilleur)، واستعملتَ conseiller à qqn de في نصائح الجيران. «أعد مشاهدة الفيديو الرئيسي وركّز على نبرة الصديقة عند شرح الأماكن، وعلى الكلمات المنطوقة بوضوح في جمل المقارنة (plus calme, plus rapide, meilleur)»","جسر الدروس: من b1-t8-l7 (تنظيم الحفلة والدعوة) إلى b1-t8-l8 (وصول الوافدة والمقارنة والنصيحة)، ثم إلى b1-t8-l9 حيث ينتقل الأبطال إلى الواقع المهني: البحث عن عمل، كتابة السيرة الذاتية، ولغة المقابلة.","مهمة تطبيقية: اكتب فقرة من دقيقة واحدة تصف فيها مدينتك لشخص لم يزرها (ثلاث مقارنات ونصيحة واحدة)، مستعملاً ثلاث كلمات جديدة من هذا الدرس (le marché, conseiller, s’habituer)؛ ثم اقرأها مسجّلاً وقارنها بسرعة نطق الوافدة في الفيديو."]}],"pron":[{"w":"la cousine","ipa":"[la ku.zin]","approx":"لا كوزين"},{"w":"le marché","ipa":"[lə maʁ.ʃe]","approx":"لو مارشي"},{"w":"meilleur","ipa":"[mɛ.jœʁ]","approx":"مايور"}],"vocab":[{"fr":"la cousine / le cousin","ar":"ابنة العمّة/ابن العم","pos":"nom","g":"f/m","exFr":"Ma cousine habite à Lyon.","ipa":"","exAr":"ابنة عمتي تسكن في ليون."},{"fr":"la tante / l’oncle","ar":"العمة/الخالة / العم/الخال","pos":"nom","g":"f/m","exFr":"Mon oncle vient nous voir.","ipa":"","exAr":"عمي يأتي لزيارتنا."},{"fr":"le marché","ar":"السوق المفتوح","pos":"nom","g":"m","exFr":"On fait les courses au marché le samedi.","ipa":"","exAr":"نتسوّق في السوق يوم السبت."},{"fr":"calme","ar":"هادئ","pos":"adj.","g":"","exFr":"Ce quartier est très calme.","ipa":"","exAr":"هذا الحيّ هادئ جداً."},{"fr":"meilleur(e)","ar":"أفضل","pos":"adj.","g":"","exFr":"C’est le meilleur restaurant du quartier.","ipa":"","exAr":"إنه أفضل مطعم في الحي."},{"fr":"conseiller (à qqn de)","ar":"ينصح (شخصاً بـ)","pos":"verbe","g":"","exFr":"Je te conseille de voir le musée.","ipa":"","exAr":"أنصحك بزيارة المتحف."},{"fr":"ailleurs","ar":"في مكان آخر","pos":"adv.","g":"","exFr":"Il n’y a rien comme ça ailleurs.","ipa":"","exAr":"لا يوجد شيء كهذا في مكان آخر."},{"fr":"une semaine / rester","ar":"أسبوع / يبقى","pos":"nom/verbe","g":"","exFr":"Elle reste une semaine à Paris.","ipa":"","exAr":"تبقى أسبوعاً في باريس."},{"fr":"arriver","ar":"يصل","pos":"verbe","g":"","exFr":"Quand elle arrive, on la prévient.","ipa":"","exAr":"حين تصل نُعلمها."},{"fr":"la vie quotidienne","ar":"الحياة اليومية","pos":"nom","g":"f","exFr":"La vie quotidienne est différente ici.","ipa":"","exAr":"الحياة اليومية مختلفة هنا."},{"fr":"rapide","ar":"سريع","pos":"adj.","g":"","exFr":"Le métro est plus rapide que le bus.","ipa":"","exAr":"المترو أسرع من الحافلة."},{"fr":"s’habituer (à)","ar":"يتعوّد (على)","pos":"verbe pronominal","g":"","exFr":"Elle s’habitue à la ville.","ipa":"","exAr":"تتعوّد على المدينة."}],"examples":[{"fr":"Ma cousine arrive demain, elle reste une semaine.","ar":"ابنة عمتي تصل غداً وتبقى أسبوعاً.","note":"الوصول + المدة"},{"fr":"Ici, la vie est plus calme qu’ailleurs.","ar":"هنا، الحياة أهدأ من أي مكان آخر.","note":"المقارنة مع ailleurs"},{"fr":"Je te conseille de commencer par le marché.","ar":"أنصحك أن تبدأ من السوق.","note":"conseiller de + infinitif"},{"fr":"Le métro est plus rapide que le bus.","ar":"المترو أسرع من الحافلة.","note":"مقارنة المواصلات"},{"fr":"C’est le meilleur restaurant du quartier.","ar":"إنه أفضل مطعم في الحي.","note":"le meilleur"},{"fr":"Elle s’habitue à la ville petit à petit.","ar":"تتعوّد على المدينة شيئاً فشيئاً.","note":"s’habituer à"}],"grammar":[{"tFr":"Comparatif : plus / moins / aussi … que","tAr":"المقارنة: plus / moins / aussi … que","body":["« plus + adj + que » للتفوّق، « moins + adj + que » للناقص، « aussi + adj + que » للتساوي. لاحظ s الصامتة في plus وأفضل صيغة سمعية: استمع ثم كرّر.","الشواذ: « mieux » (أفضل ظرفياً)، « pire » (أسوأ)، « meilleur(e) » (أفضل صفة). هذه الثلاثة تُستخدم يومياً ولا يمكن تجاهلها."],"ex":[{"fr":"La cuisine est meilleure ici qu’à Paris.","ar":"المطبخ أفضل هنا منه في باريس."},{"fr":"Il court moins vite que son frère.","ar":"يجري أقل سرعة من أخيه."}]},{"tFr":"Conseiller à qqn de + infinitif","tAr":"conseiller مع المصدر","body":["« Je te conseille de + infinitif » = أنصحك بـ… — الترتيب: conseiller + ضمير + de + مصدر.","مع à: « Je conseille à Marie de venir » — à تظهر مع الاسم المعلن."],"ex":[{"fr":"Je vous conseille de réserver à l’avance.","ar":"أنصحك بالحجز مسبقاً."},{"fr":"Il conseille à sa cousine d’apprendre le français.","ar":"ينصح ابنة عمته بتعلم الفرنسية."}]}],"mistakes":[{"wrong":"« Elle est plus meilleure »","right":"« Elle est meilleure »","why":"meilleur يغني عن plus — الجمع خطأ شائع."},{"wrong":"« Je conseille de partir »","right":"« Je te conseille de partir »","why":"conseiller يحتاج مفعولاً غير مباشر (à qqn)."},{"wrong":"« Ma cousine est plus jeune que moi de cinq ans »","right":"« Ma cousine est cinq ans plus jeune que moi »","why":"الفارق يسبق المقارن في الفرنسية."},{"wrong":"« Je m’habitue à vivre ici » مع معنى الاستمرار","right":"« Je m’habitue à vivre ici » صحيح، لكن مع le bruit نقول « je ne m’habitue pas au bruit »","why":"مع negation يتحول إلى صعوبة دائمة."}],"dialogues":[{"title":"الوصول","ctx":"حارة العمارة تستقبل ابنة عمّتها","lines":[{"who":"Concierge","fr":"Voilà ma cousine ! Elle arrive de Marseille.","ar":"ها هي ابنة عمتي! تصل من مرسيليا."},{"who":"Cousine","fr":"Bonjour à tous ! C’est différent d’ici.","ar":"مرحباً للجميع! المكان مختلف."},{"who":"Hugo","fr":"Tu verras, Paris s’apprend vite.","ar":"سترين، باريس تُفهم بسرعة."},{"who":"Concierge","fr":"Je te conseille de commencer par le marché.","ar":"أنصحك أن تبدأي من السوق."}]},{"title":"نصائح الجيران","ctx":"Sam تعطي نصائح للوافدة","lines":[{"who":"Sam","fr":"La vie ici est plus calme qu’à Marseille ?","ar":"الحياة هنا أهدأ منها في مرسيليا؟"},{"who":"Cousine","fr":"Oui, mais il manque la mer !","ar":"نعم، لكن البحر يُفتقد!"},{"who":"Sam","fr":"Tu m’as manqué, viens boire un café.","ar":"اشتقت إليكِ، هيا نشرب قهوة."},{"who":"Cousine","fr":"D’accord, montre-moi le quartier !","ar":"موافق، أرني الحيّ!"}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما معنى « la cousine »؟","opts":["ابنة العم/الخال","الزوجة","الجارة","الأخت"],"a":0,"why":"cousine = ابنة العم/الخال."},{"t":"fill","skill":"speaking","q":"أكمل: «La vie est plus calme ___ Marseille.»","fr":"La vie est plus calme ___ Marseille.","ans":"qu’à","alts":["que à"],"why":"المقارنة تأخذ que (+ elision مع à)."},{"t":"mcq","skill":"grammar","q":"الصيغة الصحيحة للمقارنة:","opts":["C’est le meilleur restaurant.","C’est plus meilleur restaurant.","C’est le plus meilleur.","C’est mieux restaurant."],"a":0,"why":"meilleur لا يأخذ plus."},{"t":"order","skill":"writing","q":"رتّب: أنصحك أن تبدأ من السوق","words":["Je","te","conseille","de","commencer","par","le","marché."],"ans":"Je te conseille de commencer par le marché.","why":"conseiller + de + infinitif."},{"t":"listen","skill":"listening","q":"أي جملة تصف مدينة أهدأ؟","opts":["La vie est plus calme ici.","Le métro est rapide.","Il fait froid.","Le marché est grand."],"a":0,"why":"plus calme = أهدأ."},{"t":"translate","skill":"writing","q":"ترجم: المترو أسرع من الحافلة، لكن السوق أفضل.","ans":"Le métro est plus rapide que le bus, mais le marché est meilleur.","why":"مقارنتان: plus rapide + meilleur."},{"t":"speaking","skill":"speaking","q":"صف مدينتك للوافد الجديد في ثلاث جمل مع مقارنة واحدة — بصوت عالٍ.","target":"Ici, c’est plus… que… / Je te conseille de…","why":"نمط الإرشاد والمقارنة."},{"t":"correct","skill":"grammar","q":"صحّح: «Elle est plus meilleure que sa sœur.»","ans":"Elle est meilleure que sa sœur.","why":"meilleur بلا plus."}],"homework":"شاهد الحلقة ثلاث مرات، ثم اكتب رسالة إرشاد من خمس جمل لصديق سيزور مدينتك: أين يذهب، ماذا يأكل، وكيف يتنقّل — مع مقارنة واحدة على الأقل.","sources":[{"title":"Extra French Episode 08 - La cousine de la concierge","channel":"Green Cilantro","videoId":"SU1EbI9oH_I","why":"الحلقة الثامنة كاملة: ابنة عمّة حارسة العمارة تصل — وافدة جديدة، لغة جديدة، وتعارف جديد داخل العمارة.","cat":"Séries","level":"B1","main":true},{"title":"extra french avec sous-titres - Episode 8","channel":"Karen","videoId":"QOufmJ9w55M","why":"نسخة أخرى للحلقة الثامنة — أعد الاستماع لتثبيت المقارنات.","cat":"Séries","level":"B1","extra":true},{"title":"extra french with subtitles - Episode 8","channel":"toria","videoId":"O2xTvhmLzj4","why":"نسخة ثالثة بنفس الحلقة — مفيدة للاستماع المكرر دون ملل.","cat":"Séries","level":"B1","extra":true}],"supplements":[{"id":"QOufmJ9w55M","title":"extra french avec sous-titres - Episode 8","channel":"Karen","why":"نسخة أخرى للحلقة الثامنة — أعد الاستماع لتثبيت المقارنات.","lang":"fr","dur":41},{"id":"O2xTvhmLzj4","title":"extra french with subtitles - Episode 8","channel":"toria","why":"نسخة ثالثة بنفس الحلقة — مفيدة للاستماع المكرر دون ملل.","lang":"fr","dur":22}]},{"id":"b1-t8-l9","fr":"Extra — Épisode 9 : Du boulot pour Sam et Nico","ar":"Extra — الحلقة 9: بحث Sam وNico عن عمل","objectives":["وصف مهاراتك وخبرتك في مقابلة عمل قصيرة","فهم مفردات التوظيف: le CV, l’entretien, le salaire, le poste","استعمال futur proche وpassé composé في سياق السيرة الذاتية","تحليل الفرق بين لغة الحياة اليومية ولغة العمل الرسمية"],"sections":[{"h":"الحلقة 9: البحث عن عمل وكتابة السيرة الذاتية (الحلقة كاملة)","video":{"id":"Zg9s9TLnBEc","title":"Extra French Episode 09 - Du boulot pour Sam et Nico","channel":"Green Cilantro","why":"الحلقة التاسعة كاملة: Sam وNico يبحثان عن عمل — مفردات العمل، إجراءات التوظيف، ولغة المقابلة.","lang":"fr","main":true,"dur":25},"p":["الحلقة التاسعة تنقلك إلى الواقع المهني: Sam وNico يبحثان عن عمل بدوام جزئي، ويسألان في المتاجر والمقاهي. الحوارات هنا أقرب إلى الفرنسية الرسمية قليلاً — لغة مطلوبة في أي مقابلة عمل أولى.","المفردات الأساسية: le CV (la lettre de motivation), l’entretien, le salaire, l’horaire, l’expérience. هذه المفردات لن تغادر رأسك بعد اليوم — ستظهر في كل إعلان توظيف.","نحوياً، تظهر صيغتان مهمتان: futur proche للخطط (« Je vais chercher… ») وpassé composé للخبرات السابقة (« J’ai travaillé dans… »). الاثنان معاً يبنيان أي سيرة ذاتية.","الحلقة تقدّم أيضاً درساً في « la réponse sous pression »: كيف تجيب عن سؤال صعب بنبرة ثابتة (« Je n’ai pas d’expérience, mais je suis motivé »).","بعد الحلقة، اكتب سيرتك الذاتية المختصرة بالفرنسية: الاسم، المهنة المستهدفة، مهارتان، وخبرة واحدة إن وُجدت — ثم تدرّب على شرحها في 45 ثانية.","الحلقة التاسعة تفتح باب le boulot: الوصف الوظيفي، المقابلة، والمهارات — la langue professionnelle في أبسط صورها. هذا المحتوى أساس أي مقابلة عمل فرنسية."],"sub":[{"h":"جمل البحث عن العمل","p":["Vous cherchez du monde ?","J’ai de l’expérience dans la restauration.","Le salaire est de mille deux cents euros.","Je peux commencer la semaine prochaine."]},{"h":"أدوات نطقية: أرقام العمل","p":["« mille deux cents » تُسمع بوضوح [mil dø sɑ̃].","« l’entretien » → [lɑ̃tʁətjɛ̃] بوزن متساوٍ.","« le salaire » — la ساكنة، لا تفتحها."]},{"h":"خطوات Listen & Repeat","p":["المرة الأولى: اكتب كل كلمة عمل سمعتها.","الثانية: كرّر جملة تقديم نفسك بنبرة واثقة.","الثالثة: أجب عن سؤال صعب بنبرة هادئة."]}]},{"h":"عبارات المقابلة والتقديم","p":["« Je viens postuler pour le poste de… » = أتقدم لوظيفة… — تعبير مهني كامل جاهز.","« Je suis disponible tout de suite. » = أنا متاح فوراً — جملة قوية في مقابلات العمل.","« Quelles sont vos disponibilités ? » سؤال المواعيد — لاحظ la plural مع vos.","« Je vous rappelle demain. » = سأتصل بك غداً — التزام مهني يُقال بنبرة حاسمة."]},{"h":"التطبيق والتلخيص","p":["تمرين المقابلة: شخص يسأل وأنت تجيب عن نفسك (الاسم، المهارة، الخبرة، التوفر) في 60 ثانية.","كتابة: رسالة تحفيزية قصيرة (4 أسطر) لوظيفة مساعدة في مطعم.","مقارنة: اكتب ثلاث جمل تصف عملك الماضي باستخدام passé composé، ثم ثلاث جمل لخططك بـfutur proche."]},{"h":"التطبيق والتلخيص","p":["خلاصة: تقدّمتَ لوظيفة بلغة المهنة: الخبرة، الراتب، المواعيد، التوافر، مع futur proche للخطط وpassé composé للخبرات السابقة ونمط «Je n’ai pas d’expérience, mais…». «أعد مشاهدة الفيديو الرئيسي وركّز على الانتقال من الفرنسية اليومية إلى فرنسية المقابلة، وعلى نبرة الثقة في «Je suis disponible dès lundi»»","جسر الدروس: من b1-t8-l8 (نصائح الوافدة والمقارنة) إلى b1-t8-l9 (البحث عن عمل وكتابة السيرة الذاتية)، ثم إلى b1-t8-l10 حيث تحتجّ Annie بلغة الرأي المعارض في بنية ثلاثية: رأي ← حجة ← حلّ.","مهمة تطبيقية: سجّل تقديم نفسك لوظيفة في دقيقة واحدة (الاسم، المهارة، الخبرة، التوافر)، مستعملاً ثلاث كلمات جديدة من هذا الدرس (le salaire, l’entretien, postuler)، ثم قارن نبرتك بنبرة Sam في مقابلة الفيديو واكتب ملاحظة واحدة على سرعتك."]}],"pron":[{"w":"le salaire","ipa":"[lə sa.lɛʁ]","approx":"لو سالير"},{"w":"l’entretien","ipa":"[lɑ̃.ʁətjɛ̃]","approx":"لانتريتيان"},{"w":"le CV","ipa":"[lə se.ve]","approx":"لو سي-في"}],"vocab":[{"fr":"un emploi / un poste","ar":"وظيفة / منصب","pos":"nom","g":"m","exFr":"Je cherche un emploi à temps partiel.","ipa":"","exAr":"أبحث عن وظيفة بدوام جزئي."},{"fr":"le salaire","ar":"الراتب","pos":"nom","g":"m","exFr":"Le salaire est correct.","ipa":"","exAr":"الراتب مناسب."},{"fr":"l’entretien","ar":"المقابلة","pos":"nom","g":"m","exFr":"L’entretien est mardi à dix heures.","ipa":"","exAr":"المقابلة يوم الثلاثاء في العاشرة."},{"fr":"le CV (le curriculum vitæ)","ar":"السيرة الذاتية","pos":"nom","g":"m","exFr":"Envoie-moi ton CV.","ipa":"","exAr":"أرسل لي سيرتك الذاتية."},{"fr":"l’expérience","ar":"الخبرة العملية","pos":"nom","g":"f","exFr":"J’ai deux ans d’expérience.","ipa":"","exAr":"لديّ سنتا خبرة."},{"fr":"le recrutement","ar":"التوظيف والتوسّط","pos":"nom","g":"m","exFr":"L’entreprise ouvre un nouveau recrutement.","ipa":"[lə ʁə.kʁyt.mɑ̃]","exAr":"الشركة تفتح عملية توظيف جديدة."},{"fr":"disponible","ar":"متاح","pos":"adj.","g":"","exFr":"Je suis disponible dès lundi.","ipa":"","exAr":"أنا متاح ابتداءً من الاثنين."},{"fr":"postuler (pour)","ar":"يتقدّم (لوظيفة)","pos":"verbe","g":"","exFr":"Elle postule pour un poste d’aide.","ipa":"","exAr":"تتقدم لوظيفة مساعدة."},{"fr":"embaucher / licencier","ar":"يوظّف / يفصل","pos":"verbe","g":"","exFr":"Le café embauche deux personnes.","ipa":"","exAr":"المقهى يوظّف شخصين."},{"fr":"travailler dans","ar":"يعمل في (مجال)","pos":"loc.","g":"","exFr":"Il travaille dans la restauration.","ipa":"","exAr":"يعمل في مجال المطاعم."},{"fr":"l’horaire / à temps partiel","ar":"التوقيت / بدوام جزئي","pos":"nom/loc.","g":"","exFr":"Le poste est à temps partiel.","ipa":"","exAr":"المنصب بدوام جزئي."},{"fr":"un entretien","ar":"مقابلة عمل","pos":"nom","g":"m","exFr":"Mon entretien est à quinze heures.","ipa":"","exAr":"مقابلتي في الثالثة بعد الزوال."}],"examples":[{"fr":"Vous cherchez du monde ?","ar":"هل تبحثون عن أشخاص؟","note":"سؤال مهني مختصر"},{"fr":"J’ai de l’expérience dans la restauration.","ar":"لديّ خبرة في مجال المطاعم.","note":"avoir de l’expérience"},{"fr":"Je peux commencer la semaine prochaine.","ar":"يمكنني أن أبدأ الأسبوع القادم.","note":"التوافر"},{"fr":"Le salaire est de mille deux cents euros.","ar":"الراتب ألف ومئتي يورو.","note":"الأرقام المهنية"},{"fr":"Je viens postuler pour le poste de serveur.","ar":"أتقدم لوظيفة نادل.","note":"postuler pour"},{"fr":"Je vous rappelle demain.","ar":"سأتصل بك غداً.","note":"الالتزام المهني"}],"grammar":[{"tFr":"Futur proche pour les plans + passé composé pour l’expérience","tAr":"المستقبل القريب للخطط + الماضي المركب للخبرة","body":["« Je vais chercher… / Je vais postuler… » — aller + infinitive للمستقبل القريب: أكثر طبيعية من futur simple في الحديث اليومي.","« J’ai travaillé… / J’ai appris… » — passé composé يبني السيرة الذاتية. لاحظ أن أفعال العمل الشائعة تأتي مع avoir."],"ex":[{"fr":"La semaine prochaine, je vais envoyer mon CV.","ar":"الأسبوع القادم سأرسل سيرتي الذاتية."},{"fr":"J’ai travaillé dans un café pendant un an.","ar":"عملت في مقهى لمدة سنة."}]},{"tFr":"Avoir de l’expérience / être motivé","tAr":"الخبرة والدافعية مع avoir وêtre","body":["« Avoir de l’expérience » للخبرة، « être motivé » للدافعية — كلاهما يظهر في كل مقابلة. لاحظ elision: de l’expérience.","« Je n’ai pas d’expérience, mais… » — النمط المهني للنفي ثم التعويض: la motivation / la disponibilité."],"ex":[{"fr":"Je n’ai pas d’expérience, mais je suis très motivé.","ar":"ليس لديّ خبرة، لكنني متحمس جداً."},{"fr":"Elle a beaucoup d’expérience dans ce domaine.","ar":"لديها خبرة كثيرة في هذا المجال."}]}],"mistakes":[{"wrong":"« Je cherche un travail dans le sales »","right":"« Je cherche un travail dans la vente »","why":"البيع = la vente؛ les sales تعني الأشياء القذرة."},{"wrong":"« J’ai travaillé en un café »","right":"« J’ai travaillé dans un café »","why":"المجال يأخذ dans لا en."},{"wrong":"« Je suis disponible à lundi »","right":"« Je suis disponible dès lundi » / « à partir de lundi »","why":"البداية الزمنية تأخذ dès أو à partir de."},{"wrong":"« Le salaire est à mille euros »","right":"« Le salaire est de mille euros »","why":"القيمة تأخذ de لا à."}],"dialogues":[{"title":"السؤال في المقهى","ctx":"Nico يسأل عن عمل","lines":[{"who":"Nico","fr":"Bonjour, vous cherchez du monde ?","ar":"مرحباً، هل تبحثون عن أشخاص؟"},{"who":"Patron","fr":"Peut-être. Tu as de l’expérience ?","ar":"ربما. هل لديك خبرة؟"},{"who":"Nico","fr":"J’ai travaillé dans un restaurant l’été dernier.","ar":"عملت في مطعم الصيف الماضي."},{"who":"Patron","fr":"Bon, envoie-moi ton CV demain.","ar":"حسناً، أرسل لي سيرتك الذاتية غداً."}]},{"title":"المقابلة","ctx":"Sam في مقابلة قصيرة","lines":[{"who":"Recruteuse","fr":"Quelles sont vos disponibilités ?","ar":"ما هي مواعيدك المتاحة؟"},{"who":"Sam","fr":"Je suis disponible dès lundi, à temps partiel.","ar":"أنا متاحة ابتداءً من الاثنين، بدوام جزئي."},{"who":"Recruteuse","fr":"Parfait. Et pourquoi ce poste ?","ar":"ممتاز. ولماذا هذا المنصب؟"},{"who":"Sam","fr":"Parce que je suis motivée et j’aime le contact.","ar":"لأنني متحمسة وأحب التواصل مع الناس."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما معنى « le salaire »؟","opts":["الراتب","الساعات","العمل","الإجازة"],"a":0,"why":"salaire = راتب."},{"t":"fill","skill":"speaking","q":"أكمل: «J’ai deux ans d’___.» (خبرة)","fr":"J’ai deux ans d’___.","ans":"expérience","why":"expérience = خبرة."},{"t":"mcq","skill":"grammar","q":"الصيغة الصحيحة للراتب:","opts":["Le salaire est de mille euros.","Le salaire est à mille euros.","Le salaire est en mille euros.","Le salaire est pour mille euros."],"a":0,"why":"القيمة تأخذ de."},{"t":"order","skill":"writing","q":"رتّب: لديّ خبرة في المطاعم، أنا متاح ابتداءً من الاثنين","words":["J’ai","de","l’expérience","dans","la","restauration,","je","suis","disponible","dès","lundi."],"ans":"J’ai de l’expérience dans la restauration, je suis disponible dès lundi.","why":"الخبرة ثم التوافر."},{"t":"listen","skill":"listening","q":"ما السؤال عن المواعيد في المقابلة؟","opts":["Quelles sont vos disponibilités ?","C’est combien ?","Vous venez d’où ?","Tu fais quoi ?"],"a":0,"why":"disponibilités = المواعيد المتاحة."},{"t":"translate","skill":"writing","q":"ترجم: ليس لديّ خبرة، لكنني متحمس وأستطيع أن أبدأ الأسبوع القادم.","ans":"Je n’ai pas d’expérience, mais je suis motivé et je peux commencer la semaine prochaine.","why":"النفي ثم التعويض + futur proche."},{"t":"speaking","skill":"speaking","q":"قدّم نفسك لوظيفة في 45 ثانية: الاسم، المهارة، الخبرة، التوافر.","target":"Je m’appelle… / J’ai… / Je suis disponible…","why":"نمط تقديم العمل."},{"t":"correct","skill":"grammar","q":"صحّح: «J’ai travaillé en un café.»","ans":"J’ai travaillé dans un café.","why":"المجال يأخذ dans."}],"homework":"شاهد الحلقة ثلاث مرات، ثم اكتب سيرتك الذاتية المختصرة بالفرنسية (خمسة أسطر) وتدرّب على شرحها بصوت عالٍ في 45 ثانية.","sources":[{"title":"Extra French Episode 09 - Du boulot pour Sam et Nico","channel":"Green Cilantro","videoId":"Zg9s9TLnBEc","why":"الحلقة التاسعة كاملة: Sam وNico يبحثان عن عمل — مفردات العمل، إجراءات التوظيف، ولغة المقابلة.","cat":"Séries","level":"B1","main":true},{"title":"Extra French Episode 9 - A Job for Sam and Nico + Script","channel":"Nicole","videoId":"JwjA9ONDPSY","why":"الحلقة مع النص المكتوب — ممتازة للقراءة أثناء الاستماع والتحقق من الأخطاء.","cat":"Séries","level":"B1","extra":true},{"title":"Extra - Episode 9","channel":"2K Entertainment","videoId":"zJS2ljF_QEE","why":"نسخة أخرى من الحلقة — أعد الاستماع لتمكين مفردات العمل.","cat":"Séries","level":"B1","extra":true}],"supplements":[{"id":"JwjA9ONDPSY","title":"Extra French Episode 9 - A Job for Sam and Nico + Script","channel":"Nicole","why":"الحلقة مع النص المكتوب — ممتازة للقراءة أثناء الاستماع والتحقق من الأخطاء.","lang":"fr","dur":24},{"id":"zJS2ljF_QEE","title":"Extra - Episode 9","channel":"2K Entertainment","why":"نسخة أخرى من الحلقة — أعد الاستماع لتمكين مفردات العمل.","lang":"fr","dur":24}]},{"id":"b1-t8-l10","fr":"Extra — Épisode 10 : Annie proteste","ar":"Extra — الحلقة 10: Annie تحتجّ","objectives":["التعبير عن الاعتراض بلغة مهذّبة وحازمة في آن واحد","فهم مفردات الاحتجاج والمظاهرة والرأي: manifester, être contre, la raison","استعمال ne… pas مع pouvoir/être في جمل رفضية","تحليل كيف يُبنى النقاش: رأي ← حجة ← خاتمة"],"sections":[{"h":"الحلقة 10: الاحتجاج والرأي المعارض (الحلقة كاملة)","video":{"id":"mEd7jguuc-U","title":"Extra French Episode 10 - Annie proteste","channel":"Green Cilantro","why":"الحلقة العاشرة كاملة: Annie تحتجّ على شيء — لغة الرأي المعارض، الاحتجاج المعتدل، والإقناع.","lang":"fr","main":true,"dur":24},"p":["الحلقة العاشرة تعالج موضوعاً اجتماعياً فرنسياً بامتياز: الاحتجاج. Annie غير راضية عن شيء وتشرح أسبابها — الحوار يعطيك بنية النقاش الثلاثية: الرأي، الحجة، ثم الطلب.","المفردات المفتاحية: protester, la manifestation, être pour/contre, la raison, le droit. هذه المفردات تظهر يومياً في الأخبار الفرنسية وفي حوار الشارع.","نحوياً، تظهر صيغ النفي مع أفعال النطاق: « Je ne peux pas accepter ça » و« Ce n’est pas possible ». لاحظ elision: n’est.","الحلقة ممتازة لتمرين النبرة الحازمة دون عدوانية: نبرة Annie ثابتة وواضحة، لا صاعدة ولا منفعلة — وهي النبرة المطلوبة في أي نقاش مهني.","بعد الحلقة، اختر موضوعاً تختلف فيه مع شخص آخر، وابنِ نقاشاً من ثلاث جمل: الرأي، الحجة، ثم حلّ مقترح.","الحلقة العاشرة تُظهر la contestation: الاعتراض المعتدل، la justification، ثم la proposition — بنية النقاش الثلاثية التي ستستخدمها في العمل والدراسة."],"sub":[{"h":"جمل الاحتجاج والرأي","p":["Je proteste, ce n’est pas normal !","Tu es pour ou contre ?","J’ai raison, tu le sais bien.","On ne peut pas accepter ça."]},{"h":"أدوات نطقية: نبرة الحزم","p":["« ce n’est pas normal » تُنطَق بنبرة ثابتة هابطة.","« je proteste » الضغط على la première syllabe.","« on ne peut pas » → [ɔ̃ nø pa] مع elision واضحة."]},{"h":"خطوات Listen & Repeat","p":["المرة الأولى: اكتب كل تعبير اعتراض سمعته.","الثانية: كرّر جملة رأيك بنبرة حازمة.","الثالثة: أضف حجة ثم خاتمة إيجابية."]}]},{"h":"عبارات الرأي والاعتراض","p":["« Je ne suis pas d’accord, parce que… » نمط النقاش الكامل: رأي + حجة. la porque لا وجود — بل parce que.","« Tu as raison, mais… » — الموافقة الجزئية ثم الاعتراض: أكثر نمط استخدام في النقاش الفرنسي.","« Ce n’est pas la peine ! » = لا داعي! — تعبير يومي قوي للرفض.","« Je comprends ton point de vue, mais… » — تعبير احترام الرأي المقابل قبل الاعتراض."]},{"h":"التطبيق والتلخيص","p":["تمرين النقاش: اختر موضوعاً (الدراسة، العمل، المدينة) وابنِ نقاشاً ثلاثي المراحل مع زميل.","كتابة: فقرة من خمس جمل تعترض فيها على قرار مدرسي أو أسري مع تقديم بديل.","سجّل نفسك تعترض على شيء بنبرة حازمة في 30 ثانية ثم قارنها بنبرة Annie."]},{"h":"التطبيق والتلخيص","p":["خلاصة: اعترضتَ بلغة مهذّبة ببنية النقاش الثلاثية (رأي ← حجة موضوعية ← حلّ مقترح)، واستعملتَ ne… pas / ne… plus مع pouvoir، وil faut + infinitif، ونبرة حازمة غير منفعلة. «أعد مشاهدة الفيديو الرئيسي وركّز على نبرة Annie الثابتة الهابطة عند الاحتجاج، وعلى لحظة الانتقال من الرفض إلى الاقتراح»","جسر الدروس: من b1-t8-l9 (المقابلة والتقديم) إلى b1-t8-l10 (الاحتجاج والرأي المعارض)، ثم إلى b1-t8-l11 حيث ينتقل الحديث إلى التخطيط للعطلة: الحجز، الوجهة، المواعيد، وسيلة التنقّل.","مهمة تطبيقية: سجّل اعتراضاً من دقيقة واحدة على قرار معين (رأي، حجة، بديل) مستعملاً ثلاث كلمات جديدة من هذا الدرس (protester, être contre, une solution)؛ ثم قارن ثبات نبرتك بنبرة Annie في الفيديو واكتب الجملة الأقوى."]}],"pron":[{"w":"protester","ipa":"[pʁɔ.tɛs.te]","approx":"بروتستي"},{"w":"la raison","ipa":"[la ʁɛ.zɔ̃]","approx":"لا ريزون"},{"w":"contre","ipa":"[kɔ̃tʁ]","approx":"كونتر"}],"vocab":[{"fr":"protester","ar":"يحتجّ","pos":"verbe","g":"","exFr":"Elle proteste contre la décision.","ipa":"","exAr":"تحتجّ على القرار."},{"fr":"être pour / contre","ar":"مؤيد / معارض","pos":"loc.","g":"","exFr":"Je suis pour cette idée.","ipa":"","exAr":"أنا مؤيد لهذه الفكرة."},{"fr":"la raison","ar":"السبب / العقل","pos":"nom","g":"f","exFr":"Tu as une bonne raison.","ipa":"","exAr":"لديك سبب جيد."},{"fr":"la manifestation","ar":"المظاهرة","pos":"nom","g":"f","exFr":"La manifestation est pacifique.","ipa":"","exAr":"المظاهرة سلمية."},{"fr":"accepter / refuser","ar":"يقبل / يرفض","pos":"verbe","g":"","exFr":"Je refuse d’accepter cette offre.","ipa":"","exAr":"أرفض قبول هذا العرض."},{"fr":"le droit","ar":"الحق","pos":"nom","g":"m","exFr":"Chacun a le droit de parler.","ipa":"","exAr":"لكل شخص حق الكلام."},{"fr":"la peine","ar":"الجدوى / التعب","pos":"nom","g":"f","exFr":"Ce n’est pas la peine de crier.","ipa":"","exAr":"لا داعي للصراخ."},{"fr":"un point de vue","ar":"وجهة نظر","pos":"nom","g":"m","exFr":"Je comprends ton point de vue.","ipa":"","exAr":"أفهم وجهة نظرك."},{"fr":"normal(e)","ar":"طبيعي/طبيعية","pos":"adj.","g":"","exFr":"Ce n’est pas normal de travailler autant.","ipa":"","exAr":"ليس من الطبيعي العمل بهذا الشيء."},{"fr":"crier / parler fort","ar":"يصرخ / يتكلم بصوت عالٍ","pos":"verbe","g":"","exFr":"Ne crie pas, on t’écoute.","ipa":"","exAr":"لا تصرخ، نحن نستمع إليك."},{"fr":"une solution / un compromis","ar":"حلّ / تسوية","pos":"nom","g":"f/m","exFr":"Il faut trouver une solution.","ipa":"","exAr":"يجب أن نجد حلاً."},{"fr":"la pétition","ar":"العريضة الاحتجاجية","pos":"nom","g":"f","exFr":"Ils ont signé une pétition contre la décision.","ipa":"[la pe.ti.sjɔ̃]","exAr":"وقعوا عريضة احتجاج على القرار."}],"examples":[{"fr":"Je proteste, ce n’est pas normal !","ar":"أحتجّ، إنه ليس طبيعياً!","note":"الاحتجاج المباشر"},{"fr":"Tu es pour ou contre ?","ar":"هل أنت مؤيد أم معارض؟","note":"سؤال الموقف"},{"fr":"Je ne suis pas d’accord, parce que le prix est trop haut.","ar":"أنا غير موافق، لأن السعر مرتفع جداً.","note":"رأي + حجة"},{"fr":"Je comprends ton point de vue, mais je ne peux pas accepter.","ar":"أفهم وجهة نظرك، لكنني لا أستطيع القبول.","note":"الاحترام ثم الاعتراض"},{"fr":"On ne peut pas accepter ça.","ar":"لا يمكننا قبول هذا.","note":"ne… pas مع pouvoir"},{"fr":"Il faut trouver une solution.","ar":"يجب أن نجد حلاً.","note":"il faut + infinitif"}],"grammar":[{"tFr":"Négation complète : ne… pas / plus / jamais","tAr":"النفي الكامل: ne… pas / plus / jamais","body":["« Je ne peux pas » للنفي البسيط، « Je ne peux plus » لعدم القدرة بعد، « Je ne veux jamais » للرفض القاطع. الثلاثة تظهر في الاحتجاج اليومي.","انتبه إلى elision: n’est, n’a, n’oublie — الهمزة تختفي دائماً بعد ne."],"ex":[{"fr":"Je ne peux pas accepter cette offre.","ar":"لا أستطيع قبول هذا العرض."},{"fr":"On ne va plus à cette école.","ar":"لن نذهب بعد الآن إلى هذه المدرسة."}]},{"tFr":"Il faut / il est nécessaire de","tAr":"il faut وil est necessary de","body":["« Il faut + infinitif » = يجب — النمط الأقوى للاحتجاج: « Il faut respecter les règles ».","« Il est nécessaire de + infinitif » أكثر رسمية — تُستخدم في النقاشات المنظّمة."],"ex":[{"fr":"Il faut écouter les deux côtés.","ar":"يجب أن نستمع إلى الجانبين."},{"fr":"Il est nécessaire de changer le planning.","ar":"من الضروري تغيير التخطيط."}]}],"mistakes":[{"wrong":"« Je ne suis pas d’accord, parce que je n’ai pas raison »","right":"« Je ne suis pas d’accord, parce que le prix est trop haut »","why":"الحجة يجب أن تكون موضوعية لا مشاعر."},{"wrong":"« Je refuse, c’est tout ! » في نقاش مهني","right":"« Je ne peux pas accepter, mais je propose… »","why":"الرفض المجرّد يُستبدل بحلّ مقترح."},{"wrong":"« Il faut que je vais »","right":"« Il faut que j’aille »","why":"il faut que + subjonctif — الشاذ يذهب."},{"wrong":"الاحتجاج بصوت عالٍ","right":"نبرة ثابتة هابطة + كلمات واضحة","why":"الحزم في الفرنسية يأتي من الثبات لا من الصوت العالي."}],"dialogues":[{"title":"الاحتجاج الأول","ctx":"Annie مع Nicolas","lines":[{"who":"Annie","fr":"Je proteste, ce n’est pas normal !","ar":"أحتجّ، إنه ليس طبيعياً!"},{"who":"Nicolas","fr":"Tu es pour ou contre exactement ?","ar":"هل أنتِ مؤيدة أم معارضة بالضبط؟"},{"who":"Annie","fr":"Contre. Le prix est trop haut et le service est mauvais.","ar":"معارضة. السعر مرتفع والخدمة سيئة."},{"who":"Nicolas","fr":"Tu as raison. On propose une solution ?","ar":"معكِ حق. هل نقترح حلاً؟"}]},{"title":"النقاش المعتدل","ctx":"Sam تردّ بأسلوب هادئ","lines":[{"who":"Sam","fr":"Je comprends ton point de vue.","ar":"أفهم وجهة نظرك."},{"who":"Annie","fr":"Merci. Alors, tu es d’accord ?","ar":"شكراً. إذن، هل أنت موافق؟"},{"who":"Sam","fr":"En partie. Je ne peux pas accepter le prix, mais je propose un compromis.","ar":"جزئياً. لا أستطيع قبول السعر، لكنني أقترح تسوية."},{"who":"Annie","fr":"D’accord, on en parle demain.","ar":"موافق، نتحدث غداً."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما معنى « être contre »؟","opts":["معارض","مؤيد","محايد","متخصص"],"a":0,"why":"contre = ضد/معارض."},{"t":"fill","skill":"speaking","q":"أكمل: «Je ne ___ pas accepter ça.» (أستطيع)","fr":"Je ne ___ pas accepter ça.","ans":"peux","why":"pouvoir في المضارع: peux."},{"t":"mcq","skill":"grammar","q":"الحجة المناسبة للرأي:","opts":["Je ne suis pas d’accord, parce que le prix est trop haut.","Je ne suis pas d’accord, parce que je suis fatigué.","Je ne suis pas d’accord, parce que c’est comme ça.","Je ne suis pas d’accord, point."],"a":0,"why":"الحجة الموضوعية (السعر) تُبنى بالبيانات لا بالمشاعر."},{"t":"order","skill":"writing","q":"رتّب: أفهم وجهة نظرك لكنني لا أستطيع القبول","words":["Je","comprends","ton","point","de","vue,","mais","je","ne","peux","pas","accepter."],"ans":"Je comprends ton point de vue, mais je ne peux pas accepter.","why":"الاحترام ثم الاعتراض."},{"t":"listen","skill":"listening","q":"ما التعبير الذي ينقل اعتراضك بلباقة؟","opts":["Je ne suis pas d’accord.","Tu n’y connais rien !","Tais-toi !","C’est idiot !"],"a":0,"why":"la disagreement المهذّبة تبدأ بـ je ne suis pas d’accord."},{"t":"translate","skill":"writing","q":"ترجم: يجب أن نجد حلاً، لكنني لا أستطيع قبول هذا السعر.","ans":"Il faut trouver une solution, mais je ne peux pas accepter ce prix.","why":"il faut ثم ne… pas."},{"t":"speaking","skill":"speaking","q":"ابنِ نقاشاً ثلاثي المراحل: رأي ← حجة ← حلّ — بصوت عالٍ.","target":"Je ne suis pas d’accord, parce que… / Je propose…","why":"بنية النقاش الفرنسي."},{"t":"correct","skill":"grammar","q":"صحّح: «Il faut que je vais protester.»","ans":"Il faut que j’aille protester.","why":"il faut que + subjonctif (aller → j’aille)."}],"homework":"شاهد الحلقة ثلاث مرات، ثم اكتب فقرة من خمس جمل تعترض فيها على قرار معين مع تقديم بديل واحد على الأقل.","sources":[{"title":"Extra French Episode 10 - Annie proteste","channel":"Green Cilantro","videoId":"mEd7jguuc-U","why":"الحلقة العاشرة كاملة: Annie تحتجّ على شيء — لغة الرأي المعارض، الاحتجاج المعتدل، والإقناع.","cat":"Séries","level":"B1","main":true},{"title":"extra french avec sous-titres francais - Episode 10","channel":"Karen","videoId":"xmK53QWscwo","why":"نسخة أخرى بالترجمة الفرنسية — أعد الاستماع لتثبيت لغة الاحتجاج.","cat":"Séries","level":"B1","extra":true},{"title":"Extra french 10 : تطوير مهارة الاستماع باللغة الفرنسية","channel":"تعلم اللغة الانجليزية و الفرنسية بالعربية","videoId":"2PCv4AHFM2E","why":"تمرين استماع عربي عن الحلقة — مراجعة سريعة للمعاني.","cat":"Séries","level":"B1","extra":true}],"supplements":[{"id":"xmK53QWscwo","title":"extra french avec sous-titres francais - Episode 10","channel":"Karen","why":"نسخة أخرى بالترجمة الفرنسية — أعد الاستماع لتثبيت لغة الاحتجاج.","lang":"fr","dur":41},{"id":"2PCv4AHFM2E","title":"Extra french 10 : تطوير مهارة الاستماع باللغة الفرنسية","channel":"تعلم اللغة الانجليزية و الفرنسية بالعربية","why":"تمرين استماع عربي عن الحلقة — مراجعة سريعة للمعاني.","lang":"fr","dur":5}]},{"id":"b1-t8-l11","fr":"Extra — Épisode 11 : Les vacances","ar":"Extra — الحلقة 11: العطلة والتنقّل","objectives":["التخطيط لرحلة بجمل عملية: الحجز، الموعد، وسيلة التنقّل، المكان","فهم مفردات السفر: la réservation, le billet, la valise, l’hôtel","استعمال futur proche مع aller في جمل السفر","تحليل كيف يُعبَّر عن الترقب والقلق قبل السفر"],"sections":[{"h":"الحلقة 11: التخطيط للعطلة والسفر (الحلقة كاملة)","video":{"id":"Q9iY580Vb8Q","title":"Extra French Episode 11 - Les vacances","channel":"Green Cilantro","why":"الحلقة الحادية عشرة كاملة: التخطيط للعطلة — الحجز، المطار، الأمتعة، والتنقّل الفرنسي النموذجي.","lang":"fr","main":true,"dur":25},"p":["الحلقة الحادية عشرة تنقلك إلى محطة القطار والمطار: حجز، أمتعة، مواعيد، وتوجيهات. لغة السفر من أكثر المجالات أهمية وفائدة في حياتك الفرنسية — وكل جملة هنا قابلة للاستخدام فوراً.","المفردات الأساسية: la valise, le billet, la réservation, l’horaire, la destination, l’hôtel. هذه المفردات ستواجهها في كل محطة فرنسية.","نحوياً، يظهر futur proche بقوة: « On va partir », « Je vais réserver ». مع أفعال السفر، المستقبل القريب هو الأسلوب الأغلب.","الحلقة تقدّم أيضاً مفردات الطقس والمواسم — فهي مرتبطة دائماً بخطط العطلة: « Il fait beau », « Il pleut ».","بعد الحلقة، خطّط لرحلة قصيرة بالفرنسية: الوجهة، التاريخ، وسيلة التنقّل، مكان الإقامة، ونشاط واحد على الأقل — ثم اشرحها في 45 ثانية.","الحلقة الحادية عشرة تكتمل رحلة السفر: الحجز ← المطار ← الوصول. بعد الحلقة، خطّط رحلتك الكاملة بالفرنسية من البداية إلى النهاية."],"sub":[{"h":"جمل السفر والحجز","p":["On va partir en vacances la semaine prochaine.","Tu as réservé le billet ?","Ma valise est déjà prête.","L’hôtel est près de la gare."]},{"h":"أدوات نطقية: مفردات المطار","p":["« la valise » [la viz] — la ساكنة، z واضحة.","« le billet » [lə bi.jɛ] — t صامتة.","« l’horaire » → [lɔ.ʁɛʁ] بفتح الواو."]},{"h":"خطوات Listen & Repeat","p":["المرة الأولى: اكتب كل اسم مكان أو وسيلة سمعته.","الثانية: كرّر جمل الحجز بنبرتها.","الثالثة: أعد بناء رحلتك بموعد جديد."]}]},{"h":"عبارات السفر والحجز","p":["« Je voudrais réserver une chambre pour deux nuits. » = أودّ حجز غرفة ليلتين — la polite booking الكاملة.","« À quelle heure part le train ? » — elision: part + le = part le (لا تغيير)، لكن لاحظ la question naturelle.","« Où est la consigne à bagages ? » = أين مخزن الأمتعة؟ — تعبير مطار ممتاز.","« On y va ! » = هيا بنا! — elision مع le/la: on y + va."]},{"h":"التطبيق والتلخيص","p":["تمرين الحجز: شخص يحجز غرفة في فندق والآخر موظف الاستقبال — ثلاثة أسئلة وإجابة واحدة.","كتابة: رسالة إلى صديق تخطط فيها لعطلة قصيرة (خمس جمل): الوجهة، المدة، النشاط، والمقابلة.","سجّل نفسك تصف رحلة سابقة أو مستقبلية في 40 ثانية بالفرنسية."]},{"h":"التطبيق والتلخيص","p":["خلاصة: خطّطتَ لرحلة كاملة: الوجهة، التاريخ، الحجز، سيلة التنقّل، والأرقام والوقت، مع الشرطية المهذّبة (voudrais, pourrais) وأمر التنقّل اليومي. «أعد مشاهدة الفيديو الرئيسي وركّز على أسئلة الحجز والوقت، وعلى نبرة الطلب المهذّب عند السؤال عن الغرف والقطارات»","جسر الدروس: من b1-t8-l10 (الاعتراض والنقاش) إلى b1-t8-l11 (العطلة والحجز والتنقّل)، ثم إلى b1-t8-l12 حيث تنتهي سلسلة Extra بحلقة كرة القدم: الحماس، التفضيل، ولغة التفاوض اليومي بـpréférer.","مهمة تطبيقية: سجّل خطة رحلة من دقيقة واحدة (الوجهة، التاريخ، الحجز) مستعملاً ثلاث كلمات جديدة من هذا الدرس (la valise, la destination, partir en vacances)، ثم قارن نطق أرقامك ووقتك بنطق الفيديو واكتب خطأً واحداً صححته."]}],"pron":[{"w":"les vacances","ipa":"[le va.kɑ̃s]","approx":"لو فاكانس"},{"w":"la valise","ipa":"[la viz]","approx":"لا فيز"},{"w":"le billet","ipa":"[lə bi.jɛ]","approx":"لو بييي"}],"vocab":[{"fr":"les vacances","ar":"العطلة (السفر)","pos":"nom","g":"f pl","exFr":"Je pars en vacances en août.","ipa":"","exAr":"أسافر في عطلة أغسطس."},{"fr":"la valise / les bagages","ar":"الحقيبة / الأمتعة","pos":"nom","g":"f/m","exFr":"Ma valise est trop lourde.","ipa":"","exAr":"حقيبتي ثقيلة جداً."},{"fr":"le billet (de train)","ar":"تذكرة (قطار)","pos":"nom","g":"m","exFr":"J’ai acheté deux billets.","ipa":"","exAr":"اشتريت تذكرتين."},{"fr":"faire ses valises","ar":"يحزم حقائبه","pos":"loc. verb","g":"","exFr":"Je fais mes valises pour Lyon ce soir.","ipa":"[fɛʁ se va.liz]","exAr":"أحزم حقائبي نحو ليون هذا المساء."},{"fr":"l’hôtel","ar":"الفندق","pos":"nom","g":"m","exFr":"L’hôtel est au centre-ville.","ipa":"","exAr":"الفندق في وسط المدينة."},{"fr":"la gare / l’aéroport","ar":"المحطة / المطار","pos":"nom","g":"f/m","exFr":"Le train part de la gare Nord.","ipa":"","exAr":"يغادر القطار من المحطة الشمالية."},{"fr":"partir / arriver","ar":"يغادر / يصل","pos":"verbe","g":"","exFr":"On part à huit heures.","ipa":"","exAr":"نغادر في الثامنة."},{"fr":"la destination","ar":"الوجهة","pos":"nom","g":"f","exFr":"Quelle est votre destination ?","ipa":"","exAr":"ما هي وجهتكم؟"},{"fr":"il fait beau / il pleut","ar":"الجوّ جميل / تمطر","pos":"loc.","g":"","exFr":"Il fait beau, on peut marcher.","ipa":"","exAr":"الجو جميل، يمكننا أن نتنزّه."},{"fr":"un plan / un itinéraire","ar":"خطة / مسار","pos":"nom","g":"m","exFr":"Voici le plan du voyage.","ipa":"","exAr":"إليك خطة الرحلة."},{"fr":"le train / l’avion","ar":"القطار / الطائرة","pos":"nom","g":"m","exFr":"Je préfère le train à l’avion.","ipa":"","exAr":"أفضّل القطار على الطائرة."},{"fr":"partir en vacances","ar":"يسافر في عطلة","pos":"loc.","g":"","exFr":"On part en vacances au bord de la mer.","ipa":"","exAr":"نسافر في عطلة إلى الشاطئ."}],"examples":[{"fr":"On va partir en vacances la semaine prochaine.","ar":"سنسافر في عطلة الأسبوع القادم.","note":"futur proche"},{"fr":"Tu as réservé le billet ?","ar":"هل حجزت التذكرة؟","note":"passé composé"},{"fr":"Ma valise est déjà prête.","ar":"حقيبتي جاهزة بالفعل.","note":"être prêt"},{"fr":"L’hôtel est près de la gare.","ar":"الفندق قريب من المحطة.","note":"près de"},{"fr":"Je voudrais réserver une chambre pour deux nuits.","ar":"أودّ حجز غرفة ليلتين.","note":"الحجز المهذّب"},{"fr":"À quelle heure part le train ?","ar":"في أي ساعة يغادر القطار؟","note":"سؤال الموعد"}],"grammar":[{"tFr":"Futur proche avec aller (voyage)","tAr":"المستقبل القريب مع aller في السفر","body":["« On va partir / Je vais réserver » — aller + infinitif = المستقبل القريب. مع أفعال السفر هو الأسلوب الأغلب في المحادثة.","« Je vais à Paris » حرف جر المكان يختلف عن « Je vais partir » (مصدر). انتبه إلى الفرق في السياق."],"ex":[{"fr":"Je vais réserver deux billets demain.","ar":"سأحجز تذكرتين غداً."},{"fr":"On va arriver à dix heures.","ar":"سنصل في العاشرة."}]},{"tFr":"Pour / en + destination","tAr":"الوجهة: pour وen","body":["« pour Paris » للوجهة المحددة، « en vacances » للعطلة، « au bord de la mer » للشاطئ — la/le/en تتغيّر حسب نوع الاسم.","« à Paris » و« en France » و« au Japon » — حروف الجر مع البلدان تتطلب حفظاً بصرياً لا منطوقاً فقط."],"ex":[{"fr":"Je pars pour Lyon vendredi.","ar":"أسافر إلى ليون يوم الجمعة."},{"fr":"Elle rêve de partir en vacances au soleil.","ar":"تحلم بالسفر في عطلة إلى مكان مشمس."}]}],"mistakes":[{"wrong":"« Je vais à partir demain »","right":"« Je vais partir demain »","why":"aller + infinitive مباشرة بلا à."},{"wrong":"« J’ai réservé à une chambre »","right":"« J’ai réservé une chambre »","why":"réserver يأخذ المفعول المباشر مباشرة."},{"wrong":"« Il fait soleil »","right":"« Il fait beau » / « Il y a du soleil »","why":"الطقس يُعبَّر عنه بصيغة il fait."},{"wrong":"« Je pars en vacances à l’hôtel »","right":"« Je pars en vacances, je reste à l’hôtel »","why":"الفندق مكان الإقامة لا وجهة العطلة نفسها."}],"dialogues":[{"title":"الحجز","ctx":"Hugo يتصل بالفندق","lines":[{"who":"Hugo","fr":"Bonjour, je voudrais réserver une chambre pour deux nuits.","ar":"مرحباً، أودّ حجز غرفة ليلتين."},{"who":"Réceptionniste","fr":"Bien sûr, pour quelles dates ?","ar":"بالطبع، لأي تاريخين؟"},{"who":"Hugo","fr":"Du 12 au 14 juillet, s’il vous plaît.","ar":"من 12 إلى 14 يوليو من فضلك."},{"who":"Réceptionniste","fr":"Parfait, c’est réservé.","ar":"ممتاز، تم الحجز."}]},{"title":"في المحطة","ctx":"Sam وHugo قبل الركوب","lines":[{"who":"Sam","fr":"À quelle heure part le train ?","ar":"في أي ساعة يغادر القطار؟"},{"who":"Hugo","fr":"Dans vingt minutes, voie numéro trois.","ar":"بعد عشرين دقيقة، الرصيف رقم ثلاثة."},{"who":"Sam","fr":"Tu as les billets ?","ar":"هل معك التذاكر؟"},{"who":"Hugo","fr":"Oui, dans ma valise. On y va !","ar":"نعم، في حقيبتي. هيا بنا!"}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما معنى « la valise »؟","opts":["الحقيبة","التذكرة","المحطة","الجو"],"a":0,"why":"valise = حقيبة السفر."},{"t":"fill","skill":"speaking","q":"أكمل: «Je vais ___ une chambre pour deux nuits.»","fr":"Je vais ___ une chambre pour deux nuits.","ans":"réserver","why":"futur proche + مصدر."},{"t":"mcq","skill":"grammar","q":"الصيغة الصحيحة للوجهة:","opts":["Je pars pour Lyon.","Je pars à Lyon demain vacances.","Je pars en Lyon en vacances.","Je pars de Lyon pour vacances."],"a":0,"why":"pour + المدينة للوجهة."},{"t":"order","skill":"writing","q":"رتّب: سنسافر في عطلة الأسبوع القادم","words":["On","va","partir","en","vacances","la","semaine","prochaine."],"ans":"On va partir en vacances la semaine prochaine.","why":"futur proche + العطلة."},{"t":"listen","skill":"listening","q":"ما السؤال عن وقت القطار؟","opts":["À quelle heure part le train ?","Où est la valise ?","C’est combien ?","Qui réserve ?"],"a":0,"why":"à quelle heure = الوقت."},{"t":"translate","skill":"writing","q":"ترجم: أودّ حجز غرفة ليلتين من فضلك.","ans":"Je voudrais réserver une chambre pour deux nuits, s’il vous plaît.","why":"الحجز المهذّب."},{"t":"speaking","skill":"speaking","q":"خطط لرحلة قصيرة بالفرنسية: الوجهة، التاريخ، وسيلة التنقّل — ثلاث جمل.","target":"Je vais partir… pour… / Le train part…","why":"نمط التخطيط."},{"t":"correct","skill":"grammar","q":"صحّح: «Je vais à partir demain.»","ans":"Je vais partir demain.","why":"aller + infinitif مباشرة."}],"homework":"شاهد الحلقة ثلاث مرات، ثم اكتب خطة رحلة من خمس جمل: الوجهة، المدة، وسيلة التنقّل، الفندق، والنشاط — وسجّلها بصوت عالٍ.","sources":[{"title":"Extra French Episode 11 - Les vacances","channel":"Green Cilantro","videoId":"Q9iY580Vb8Q","why":"الحلقة الحادية عشرة كاملة: التخطيط للعطلة — الحجز، المطار، الأمتعة، والتنقّل الفرنسي النموذجي.","cat":"Séries","level":"B1","main":true},{"title":"extra french avec sous-titres francais - Episode 11","channel":"toria","videoId":"ljGoZiMfhqk","why":"نسخة أخرى بالترجمة الفرنسية — أعد الاستماع لتثبيت مفردات السفر.","cat":"Séries","level":"B1","extra":true},{"title":"extra french avec sous-titres francais - Episode 11","channel":"Karen","videoId":"A123YbuFVkk","why":"نسخة ثالثة — مفيدة للاستماع المكرر والمراجعة السريعة.","cat":"Séries","level":"B1","extra":true}],"supplements":[{"id":"ljGoZiMfhqk","title":"extra french avec sous-titres francais - Episode 11","channel":"toria","why":"نسخة أخرى بالترجمة الفرنسية — أعد الاستماع لتثبيت مفردات السفر.","lang":"fr","dur":24},{"id":"A123YbuFVkk","title":"extra french avec sous-titres francais - Episode 11","channel":"Karen","why":"نسخة ثالثة — مفيدة للاستماع المكرر والمراجعة السريعة.","lang":"fr","dur":40}]},{"id":"b1-t8-l12","fr":"Extra — Épisode 12 : Fou de foot","ar":"Extra — الحلقة 12: مهووس بالكرة","objectives":["الحديث عن الرياضة والهوايات بثقة: الكرة، المباريات، الأندية","فهم مفردات الرياضة: le match, l’équipe, supporter, gagner, perdre","استعمال التفضيل: préférer / aimer mieux مع le plus / le moins","تحليل كيف يُعبَّر عن الحماس واللامبالاة في نفس الحوار"],"sections":[{"h":"الحلقة 12: كرة القدم والهوايات (الحلقة كاملة)","video":{"id":"DbD8ac5GG0s","title":"Extra French Episode 12 - Fou de foot","channel":"Green Cilantro","why":"الحلقة الثانية عشرة كاملة: كرة القدم في الحياة الفرنسية — الهوايات، الحماس، واختلاف الأذواق بين الأصدقاء.","lang":"fr","main":true,"dur":24},"p":["الحلقة الأخيرة من Extra تفتح موضوعاً فرنسياً جداً: كرة القدم. أبطال الحلقة مهووسون بالكرة بينما آخر لا يشاركهم الحماس — وهذا التناقض هو مصدر الكوميديا ولغة التفضيل.","المفردات الأساسية: le foot, le match, l’équipe, supporter, gagner, perdre, le score, le stade, un joueur, un fanatique. كرة القدم رياضة الحياة اليومية في فرنسا.","نحوياً، تبرز صيغ التفضيل: « Je préfère le tennis » و« J’aime mieux rester chez moi ». مع التمييز: « Le plus fanatique » و« Le moins intéressé ».","الحلقة تقدّم أيضاً نبرة الحماس: صوت مرتفع، كلمات قصيرة، وتعابير قصيرة تدل على الانفعال — وهي تناقض نبرة الهدوء في المشاهد السابقة.","بعد الحلقة، اختر رياضة أو هواية تحبها وصفها في 45 ثانية: ماذا تحب فيها، لماذا، ومتى تمارسها — مع جملة تفضيل واحدة على الأقل.","الحلقة الثانية عشرة تختتم السلسلة بـ le foot: الحماس والاختلاف في آن واحد — la leçon الأخيرة أن الاختلاف في الأذواق يثري la conversation لا يُنهيها."],"sub":[{"h":"جمل الهوايات والحماس","p":["Tu aimes le foot ?","Je préfère le tennis, honnêtement.","Notre équipe a gagné le match !","C’est le meilleur joueur du monde."]},{"h":"أدوات نطقية: كلمات الرياضة","p":["« le match » [la matʃ] — t واضحة في الآخر.","« gagner » [ɡe.ɲe] — gn مثل espagnol niño.","« supporter » [syp.pɔʁ.te] — la première syllabe ساكنة."]},{"h":"خطوات Listen & Repeat","p":["المرة الأولى: اكتب كل كلمة رياجة سمعتها.","الثانية: كرّر جمل التفضيل بنبرة الطبيعية.","الثالثة: صف هوايتك بنمط: aimer / préférer / aimer mieux."]}]},{"h":"عبارات الرياضة والتفضيل","p":["« Je suis fan de foot ! » = أنا مهووس بالكرة! — تعبير حماسي قصير وممتاز للشوارع.","« Tu préfères le foot ou le tennis ? » — سؤال التفضيل بين شيئين: la ou بين البدائل.","« Notre équipe a perdu, c’est dommage. » — la sympathetic loss: la خسارة المحب.","« Quel score ? » = ما النتيجة؟ — سؤال قصير يُستخدم في كل مباراة."]},{"h":"التطبيق والتلخيص","p":["تمرين الهوايات: صف رياضتك المفضلة للزميل — ماذا تحب فيها، ولماذا، ومتى تمارسها.","كتابة: مقارنة قصيرة بين رياضتين: la préférée + la raison + la fréquence.","سجّل نفسك تصف مباراة رأيتها أو هواية تحبها في 40 ثانية بنبرة حماسية."]},{"h":"التطبيق والتلخيص","p":["خلاصة: حديثك عن الرياضة والهوايات بثقة: وصف المباراة والنتيجة، التفضيل مع préférer / aimer mieux، والمقارنة والتفضيل (le plus / le moins)، وتعابير الحماس واللامبالاة. «أعد مشاهدة الفيديو الرئيسي وركّز على التباين بين نبرة الحماس ونبرة اللامبالاة في نفس الحوار، وعلى كلمة score في الأسئلة السريعة»","جسر الدروس: من b1-t8-l11 (التخطيط للعطلة والحجز) إلى b1-t8-l12 (كرة القدم والهوايات والتفضيل)، ثم إلى b1-t9-l1 حيث يبدأ المنهج: نظام الأكسنتو كمفاتيح صوتية قبل الغوص في الأفلام الفرنسية.","مهمة تطبيقية: سجّل وصفاً لهوايتك المفضلة في دقيقة واحدة (الاسم، المدة، السبب، مقارنة واحدة)، مستعملاً ثلاث كلمات جديدة من هذا الدرس (le score, l’équipe, préférer)؛ ثم قارن حماس نبرتك بنبرة المشجّعين في الفيديو."]}],"pron":[{"w":"le foot","ipa":"[lə fut]","approx":"لو فوت"},{"w":"gagner","ipa":"[ɡe.ɲe]","approx":"غِنييه"},{"w":"le match","ipa":"[lə matʃ]","approx":"لو ماتش"}],"vocab":[{"fr":"le foot / le football","ar":"كرة القدم","pos":"nom","g":"m","exFr":"Il regarde le foot chaque soir.","ipa":"","exAr":"يشاهد كرة القدم كل مساء."},{"fr":"le match","ar":"المباراة","pos":"nom","g":"m","exFr":"Le match commence à vingt heures.","ipa":"","exAr":"تبدأ المباراة في الثامنة مساءً."},{"fr":"l’équipe","ar":"الفريق","pos":"nom","g":"f","exFr":"Notre équipe est très forte.","ipa":"","exAr":"فريقنا قوي جداً."},{"fr":"supporter","ar":"يشجّع (فريقاً)","pos":"verbe","g":"","exFr":"Je supporte cette équipe depuis mon enfance.","ipa":"","exAr":"أشجّع هذا الفريق منذ طفولتي."},{"fr":"gagner / perdre","ar":"يكسب / يخسر","pos":"verbe","g":"","exFr":"Ils ont gagné le match 2 à 1.","ipa":"","exAr":"فازوا بالمباراة بنتيجة 2-1."},{"fr":"le score","ar":"النتيجة","pos":"nom","g":"m","exFr":"Le score est de trois à zéro.","ipa":"","exAr":"النتيجة ثلاثة إلى صفر."},{"fr":"le stade","ar":"الملعب","pos":"nom","g":"m","exFr":"Le stade est plein ce soir.","ipa":"","exAr":"الملعب ممتلئ هذا المساء."},{"fr":"un joueur / une joueuse","ar":"لاعب / لاعبة","pos":"nom","g":"m/f","exFr":"Ce joueur est incroyable.","ipa":"","exAr":"هذا اللاعب مذهل."},{"fr":"un fanatique","ar":"متحمس / مهووس","pos":"nom","g":"m","exFr":"C’est un fanatique de sport.","ipa":"","exAr":"إنه مهووس بالرياضة."},{"fr":"préférer / aimer mieux","ar":"يفضّل / يحب أكثر","pos":"verbe","g":"","exFr":"Je préfère la natation au football.","ipa":"","exAr":"أفضّل السباحة على كرة القدم."},{"fr":"le plus / le moins","ar":"الأكثر / الأقل","pos":"loc.","g":"","exFr":"C’est le plus motivé de tous.","ipa":"","exAr":"إنه الأكثر حماساً بين الجميع."},{"fr":"une passion","ar":"شغف","pos":"nom","g":"f","exFr":"Le sport est sa grande passion.","ipa":"","exAr":"الرياضة شغفها الكبير."}],"examples":[{"fr":"Tu aimes le foot ?","ar":"هل تحب كرة القدم؟","note":"سؤال الهواية"},{"fr":"Je préfère le tennis, honnêtement.","ar":"أفضّل التنس، بصراحة.","note":"التفضيل المباشر"},{"fr":"Notre équipe a gagné le match !","ar":"فاز فريقنا بالمباراة!","note":"الحماس بالفعل الماضي"},{"fr":"C’est le meilleur joueur du monde.","ar":"إنه أفضل لاعب في العالم.","note":"la superlatif"},{"fr":"Je ne suis pas fanatique de sport.","ar":"أنا لست مهووساً بالرياضة.","note":"الموقف المعاكس"},{"fr":"Quel score ?","ar":"ما النتيجة؟","note":"سؤال قصير"}],"grammar":[{"tFr":"Superlatif : le plus / le moins + adj.","tAr":"la superlatif: le plus / le moins مع الصفة","body":["« Le meilleur joueur » — la superlatif الشاذ: bon → le meilleur (لا le plus bon). « Le plus motivé » و« Le moins intéressé » نمط منتظم.","مع les: « le plus rapide des joueurs ». انتبه إلى la comparaison: plus… que."],"ex":[{"fr":"C’est le plus fanatique de l’équipe.","ar":"إنه الأكثر حماساً في الفريق."},{"fr":"Il a le moins d’expérience.","ar":"لديه أقل خبرة."}]},{"tFr":"Préférer / aimer mieux","tAr":"التفضيل: préférer و aimer mieux","body":["« Je préfère le foot » + nom مباشرة، أو « Je préfère jouer au foot » + infinitif. « Aimer mieux » أكثر حوارية.","الاختيار: « ou » بين البدائل، « à » للمقارنة: préférer A à B."],"ex":[{"fr":"Je préfère la natation à la course.","ar":"أفضّل السباحة على الجري."},{"fr":"J’aime mieux rester chez moi ce soir.","ar":"أحب أن أبقى في البيت هذا المساء أكثر."}]}],"mistakes":[{"wrong":"« Je préfère le foot à jouer »","right":"« Je préfère jouer au foot »","why":"préférer + infinitif مباشرة، لا à + مصدر."},{"wrong":"« Le plus bon joueur »","right":"« Le meilleur joueur »","why":"bon → le meilleur في la superlatif."},{"wrong":"« Notre équipe a gagné à 2 à 1 »","right":"« Notre équipe a gagné 2 à 1 »","why":"le score بدون à."},{"wrong":"« Je préfère le foot à tennis »","right":"« Je préfère le foot au tennis »","why":"à + le = au قبل الاسم المعرف بالـ."}],"dialogues":[{"title":"قبل المباراة","ctx":"Nicolas وSam في الشارع","lines":[{"who":"Nicolas","fr":"Tu aimes le foot, Sam ?","ar":"هل تحب كرة القدم يا Sam؟"},{"who":"Sam","fr":"Honnêtement, je préfère la lecture.","ar":"بصراحة، أفضّل القراءة."},{"who":"Nicolas","fr":"Tu es le seul ! Le match est ce soir.","ar":"أنت الوحيد! المباراة هذا المساء."},{"who":"Sam","fr":"Quel score ?","ar":"ما النتيجة؟"}]},{"title":"بعد الفوز","ctx":"Annie تهنّئ الفريق","lines":[{"who":"Annie","fr":"Notre équipe a gagné ! 2 à 1 !","ar":"فاز فريقنا! 2 إلى 1!"},{"who":"Nicolas","fr":"Le meilleur joueur a marqué le deuxième but.","ar":"سجل اللاعب الأفضل الهدف الثاني."},{"who":"Annie","fr":"C’est le plus motivé de tous.","ar":"إنه الأكثر حماساً بين الجميع."},{"who":"Hugo","fr":"Je n’y comprends rien au foot…","ar":"لا أفهم شيئاً في الكرة…"}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما معنى « le score »؟","opts":["النتيجة","الملعب","الفريق","الجمهور"],"a":0,"why":"score = النتيجة."},{"t":"fill","skill":"speaking","q":"أكمل: «Je ___ le foot, honnêtement.» (أفضّل)","fr":"Je ___ le foot, honnêtement.","ans":"préfère","why":"préférer في المضارع: préfère."},{"t":"mcq","skill":"grammar","q":"la superlatif الصحيح:","opts":["le meilleur joueur","le plus bon joueur","le mieux bon joueur","la plus bonne joueur"],"a":0,"why":"bon → le meilleur بشكل شاذ."},{"t":"order","skill":"writing","q":"رتّب: فاز فريقنا بالمباراة","words":["Notre","équipe","a","gagné","le","match!"],"ans":"Notre équipe a gagné le match!","why":"الفعل passé composé + المفعول."},{"t":"listen","skill":"listening","q":"ما السؤال عن النتيجة؟","opts":["Quel score ?","Où est le stade ?","Qui joue ?","C’est quand ?"],"a":0,"why":"quel score = سؤال النتيجة."},{"t":"translate","skill":"writing","q":"ترجم: أفضّل السباحة على كرة القدم.","ans":"Je préfère la natation à le football.","why":"préférer A à B."},{"t":"speaking","skill":"speaking","q":"صف رياضتك المفضلة: ماذا تحب فيها، ولماذا، ومتى — ثلاث جمل.","target":"Je pratique… / J’aime… parce que… / Je préfère…","why":"نمط الهواية."},{"t":"correct","skill":"grammar","q":"صحّح: «Je préfère le foot à jouer.»","ans":"Je préfère jouer au foot.","why":"préférer + infinitif مباشرة."}],"homework":"شاهد الحلقة ثلاث مرات، ثم اكتب وصف هوايتك المفضلة من خمس جمل: الاسم، المدة، سبب الحب، المكان، وجملة تفضيل مقابل هواية أخرى — وسجّلها بصوت حماسي.","sources":[{"title":"Extra French Episode 12 - Fou de foot","channel":"Green Cilantro","videoId":"DbD8ac5GG0s","why":"الحلقة الثانية عشرة كاملة: كرة القدم في الحياة الفرنسية — الهوايات، الحماس، واختلاف الأذواق بين الأصدقاء.","cat":"Séries","level":"B1","main":true},{"title":"extra french avec sous titres francais   Episode 12","channel":"toria","videoId":"c1DQOeBChow","why":"نسخة أخرى بالترجمة الفرنسية — أعد الاستماع لتثبيت مفردات الرياضة والتفضيل.","cat":"Séries","level":"B1","extra":true},{"title":"Extra French Episode 12   Fou de foot HD 720p Subtitles","channel":"Squid French","videoId":"MHWQpUC1V9Y","why":"نسخة عالية الجودة — مفيدة لمراجعة النطق وسرعة الحوار.","cat":"Séries","level":"B1","extra":true}],"supplements":[{"id":"c1DQOeBChow","title":"extra french avec sous titres francais   Episode 12","channel":"toria","why":"نسخة أخرى بالترجمة الفرنسية — أعد الاستماع لتثبيت مفردات الرياضة والتفضيل.","lang":"fr","dur":23},{"id":"MHWQpUC1V9Y","title":"Extra French Episode 12   Fou de foot HD 720p Subtitles","channel":"Squid French","why":"نسخة عالية الجودة — مفيدة لمراجعة النطق وسرعة الحوار.","lang":"fr","dur":24}]}]},{"id":"b1-t9","slug":"films-cinema","icon":"video","color":"#673ab7","fr":"Cinéma & films français (B1)","ar":"مسار الأفلام والسينما الفرنسية (B1)","desc":"منهج الأكسنتو + خمسة أفلام ومسلسلات فرنسية معاصرة: Amélie, La Famille Bélier, Dix pour cent, Lupin, Bienvenue chez les Ch’tis — لغة السينما، اللكنات، والترجمة.","lessons":[{"id":"b1-t9-l1","fr":"Méthode — Les accents du français","ar":"المنهج: النطق الفرنسي — لغة اللكنة والتشديد","objectives":["تمييز الأكسنتو الأربعة بصرياً ونطقياً: é è ê ë ç","ربط كل أكسنت بنمط نطق ثابت (aigu = e closed, grave = e open)","تخفيف قلق « لا أفهم النص المكتوب » عبر قراءة الأكسنتات كمفاتيح صوتية","تهيئة الأذن للأفلام الفرنسية: فهم أن اللكنة تُسمع قبل أن تُقرأ"],"sections":[{"h":"المنهج 1: نظام الأكسنتو الفرنسية (طريقة Le French Club)","video":{"id":"yZ3rABJNfC8","title":"Les Accents du Français : Tu vas enfin tout comprendre !","channel":"Le French Club","why":"شرح منهجي شامل للأكسنتو الأربعة: aigu, grave, circonflexe, tréma — مع أمثلة نطق مباشرة قبل دخول الأفلام.","lang":"fr","main":true,"dur":12},"p":["قبل الغوص في الأفلام الفرنسية، عليك إتقان نظام واحد: الأكسنتو (les accents). في الفرنسية أربعة رموز تغيّر النطق فعلياً: é (أكسان جوّي)، è (أكسان قبري)، ê (سيركونفلكس)، وë (ترما). كل رمز ليس زينة — هو مفتاح صوتي.","الطريقة العملية من Le French Club: تعلّم الأكسنت كنظام صوتي لا كقواعد إملائية. é = صوت مغلق قصير [e]، è = صوت مفتوح [ɛ]، ê = [ɛ] ممدود، ë = يمنع الامتزاج (naïve = [na.ive]). ç يحوّل c قبل a/o إلى صوت س [s].","الخطأ الشائع: تجاهل الأكسنتات في القراءة. النتيجة: نطق مسطّح يخون الكلمة. الحل: اقرأ الكلمة ثلاث مرات — مرة للصوت، مرة للاسماع، مرة للمعنى — مع التمييز بين è و é.","بعد إتقان النظام، ستشاهد الفرنسية في الأفلام كصوت قبل النص: ستسمع différence بين « marché » (اسم) و « marche » (فعل). هذا التمييز يبدأ من الأكسنت.","تمرين اليوم: اكتب عشر كلمات تبدأ بـ é وأخرى بـ è، ثم اقرأها بصوت عالٍ مسجلاً نفسك — قارن النبرة بنبرة المعلّم في الفيديو.","بعد منهج الأكسنتو، ستكون جاهزاً للأفلام: la prononciation السليمة تفتح la compréhension. راجع النظام مرة أخيرة قبل الانتقال إلى الفيلم الأول."],"sub":[{"h":"النظام الصوتي: الأكسنتو الأربعة","p":["é [e] — école, café, été (صوت مغلق قصير).","è [ɛ] — père, mère, problème (صوت مفتوح أطول).","ê [ɛ] — fenêtre, forêt (سيركونفلكس: إشارة الأصل اللاتيني غالباً).","ë — naïve, Noël (ترما: يمنع امتزاج الحروف)."]},{"h":"أدوات نطقية: ç و ou / u","p":["ç قبل a/o يُنطق [s]: garçon, leçon.","ou [u] vs u [y]: où (أين) vs tu (أنت) — الفرق في شفتيك لا في أذنك.","« an » vs « en » nasal: dans vs bien — تمارين الأذن الأساسية."]},{"h":"خطوات Listen & Repeat","p":["المرة الأولى: اكتب كل كلمة سمعتها مع رسم الأكسنت عليها.","الثانية: كرّرها ثلاث مرات مبالغًا في تمييز è عن é.","الثالثة: اقرأ فقرة قصيرة مكتوبة بالأكسنتات السليمة."]}]},{"h":"قواعد العمل: كيف تقرأ الأكسنتات","p":["« é versus è » — é [e] قصير مغلق (café)، è [ɛ] مفتوح (père). لا تخلط بينهما أبداً في النطق.","« ç est utile » — ç يحوّل c إلى [s] قبل a/o: garçon (ولد) ≠ garcon (خطأ شائع).","« ë empêche la diphtongue » — Noël تُنطق [nɔ.ɛl] لا [nɔl] — ë يكسر الالتحام.","« l’accent grave ouvre, l’accent aigu ferme » — la mnémonique للحفظ: grave = مفتوح، aigu = مغلق."]},{"h":"التطبيق والتلخيص","p":["تمرين التمييز: استمع لعشر كلمات، ارسم الأكسنت الصحيح على كل واحدة ثم تحقق من المفتاح.","كتابة: اكتب فقرة من خمس جمل عن يومك مستخدماً كلمات بأكسنتات مختلفة — ثم اقرأها بصوت عالٍ.","سجّل نفسك تقرأ خمس كلمات: école, père, fenêtre, naïve, garçon — وقارن نطقك بنطق الفيديو."]},{"h":"التطبيق والتلخيص","p":["خلاصة: ميّزتَ الأكسنتو الأربعة بصرياً ونطقياً (é è ê ë) وç، وربطتَ كل رمز بنمط نطق ثابت (aigu = e مغلق، grave = e مفتوح) لتقرأ النص الفرنسي كمفاتيح صوتية. «أعد مشاهدة الفيديو الرئيسي وركّز على نطق الكلمات الخمس (café, père, fenêtre, Noël, garçon) وقارن مسارك الصوتي بالرسم المكتوب»","جسر الدروس: من b1-t8-l12 (الرياضة والتفضيل) إلى b1-t9-l1 (نظام الأكسنتو وقواعد النطق)، ثم إلى b1-t9-l2 حيث يدخل عالم الأفلام مع Amélie: السرد السينمائي، imparfait للوصف، ومفردات الحدس والقدر.","مهمة تطبيقية: اقرأ خمس كلمات بأكسنتات مختلفة مسجّلاً قراءتك في دقيقة واحدة (é è ê ë ç)، واستعمل ثلاث كلمات جديدة من هذا الدرس؛ ثم استمع للفيديو وصحّح مسار نطقك في جملة واحدة واكتبها."]}],"pron":[{"w":"é [e]","ipa":"[e]","approx":"إيه مغلقة"},{"w":"è [ɛ]","ipa":"[ɛ]","approx":"إيه مفتوحة"},{"w":"ç [s]","ipa":"[s]","approx":"سين قبل a/o"}],"vocab":[{"fr":"é (accent aigu)","ar":"اللكنة المغلقة","pos":"signe","g":"","exFr":"Le café est chaud.","ipa":"","exAr":"القهوة ساخنة."},{"fr":"è (accent grave)","ar":"اللكنة المفتوحة","pos":"signe","g":"","exFr":"Mon père travaille ici.","ipa":"","exAr":"والدي يعمل هنا."},{"fr":"ê (circonflexe)","ar":"التشديد (سيركونفلكس)","pos":"signe","g":"","exFr":"La fenêtre est ouverte.","ipa":"","exAr":"النافذة مفتوحة."},{"fr":"ë (tréma)","ar":"النقاط المزدوجة","pos":"signe","g":"","exFr":"La Noël est en décembre.","ipa":"","exAr":"عيد الميلاد في ديسمبر."},{"fr":"ç (cédille)","ar":"التشجيع (سديلة)","pos":"signe","g":"","exFr":"Le garçon joue dans le parc.","ipa":"","exAr":"الولد يلعب في الحديقة."},{"fr":"ou vs u","ar":"الفرق بين ou و u","pos":"loc.","g":"","exFr":"Où est la rue ? vs Tu es où ?","ipa":"","exAr":"أين الشارع؟ vs أنت أين؟"},{"fr":"é vs è","ar":"الفرق بين é و è","pos":"loc.","g":"","exFr":"Café (قهوة) ≠ père (والد).","ipa":"","exAr":"الفرق الجوهري في النطق."},{"fr":"la prononciation","ar":"النطق","pos":"nom","g":"f","exFr":"Sa prononciation est claire.","ipa":"","exAr":"نطقه واضح."},{"fr":"le son","ar":"الصوت","pos":"nom","g":"m","exFr":"Ce son est difficile à faire.","ipa":"","exAr":"هذا الصوت صعب إنتاجه."},{"fr":"la voyelle","ar":"الحرف العلة","pos":"nom","g":"f","exFr":"Les voyelles nasales sont importantes.","ipa":"","exAr":"حروف العلة الأنفية مهمة."},{"fr":"la consonne","ar":"الحرف الساكن","pos":"nom","g":"f","exFr":"Cette consonne est muette.","ipa":"","exAr":"هذا الحرف الساكن صامت."},{"fr":"entendre / écouter","ar":"يسمع / يستمع","pos":"verbe","g":"","exFr":"Je vois et j’écoute le film.","ipa":"","exAr":"أرى الفيلم وأستمع إليه."}],"examples":[{"fr":"é [e] : café, été, merci","ar":"صوت مغلق قصير [e]","note":"aigu"},{"fr":"è [ɛ] : père, mère, très","ar":"صوت مفتوح [ɛ]","note":"grave"},{"fr":"ê [ɛ] : fenêtre, forêt, être","ar":"تشديد ممدود","note":"circonflexe"},{"fr":"ë : naïve, Noël","ar":"يعيق الالتحام الصوتي","note":"tréma"},{"fr":"ç : garçon, leçon, ça","ar":"يحوّل c إلى [s]","note":"cédille"},{"fr":"où (أين) vs tu (أنت)","ar":"ou [u] vs u [y]","note":"فرق شفوي"}],"grammar":[{"tFr":"Accent aigu vs grave — le contraste sonore","tAr":"الفرق الصوتي بين aigu و grave","body":["é [e] يظهر غالباً في نهايات الكلمات: fini, parlé, petit. è [ɛ] يظهر غالباً في المقاطع المفتوحة: père, mère, problème.","الحفظ البصري: aigu يتجه للأعلى يمين، grave يتجه لليسار — é = closed, è = open. لا تعتمد على النظر فقط؛ استمع دائماً."],"ex":[{"fr":"Le café est sur la table. [e]","ar":"القهوة على الطاولة."},{"fr":"Mon père est content. [ɛ]","ar":"والدي سعيد."}]},{"tFr":"Cédille (ç) et tréma (ë)","tAr":"السديلة والترما","body":["ç يظهر فقط قبل a/o/u: garçon, ça, garçon — يحوّل c إلى [s]. بدون ç سيكون [k].","ë يظهر في كلمات قليلة لكنه حاسم: naïve [na.ive] لا [nɛv]، Noël [nɔ.ɛl]. انتبه للكلمات المعربة أيضاً."],"ex":[{"fr":"Le garçon va à la leçon.","ar":"الولد يذهب إلى الدرس."},{"fr":"C’est une idée naïve.","ar":"إنها فكرة بسيطة/ساذجة."}]}],"mistakes":[{"wrong":"« café » تُنطق [kaf]","right":"« café » [ka.fe]","why":"الإهمال للأكسنت يحول المعنى أو يُفقد الوضوح."},{"wrong":"« je suis à la cafe » (بلا أكسنت)","right":"« je suis au café »","why":"café مذكر بـ au لا à la."},{"wrong":"تجاهل ç في garçon","right":"garçon [gaʁ.sɔ̃]","why":"بدون ç سيُنطق [gaʁ.kɔ̃] وهو خطأ فادح."},{"wrong":"الخلط بين è و é في النطق","right":"père [pɛʁ] ≠ café [ka.fe]","why":"المفتوح vs المغلق — فرق جوهري في الفرنسية."}],"dialogues":[{"title":"في الصف","ctx":"معلّمة تشرح é و è","lines":[{"who":"Prof","fr":"Répétez : café, père, fenêtre.","ar":"كرّروا: café، père، fenêtre."},{"who":"Élève","fr":"Café [e], père [ɛ], fenêtre [ɛ].","ar":"Café [e]، père [ɛ]، fenêtre [ɛ]."},{"who":"Prof","fr":"Parfait ! Et Noël ?","ar":"ممتاز! و Noël؟"},{"who":"Élève","fr":"Noël [nɔ.ɛl], pas [nɔl].","ar":"Noël [nɔ.ɛl] لا [nɔl]."}]},{"title":"قبل الفيلم","ctx":"صديقان يراجعان النطق","lines":[{"who":"Sam","fr":"Je ne distingue pas è et é à l’écoute.","ar":"لا أفرق بين è و é في الاستماع."},{"who":"Nico","fr":"Écoute : café, été — c’est [e].","ar":"اسمع: café، été — هذا [e]."},{"who":"Sam","fr":"Et père, mère — [ɛ], ouvert.","ar":"و père، mère — [ɛ]، مفتوح."},{"who":"Nico","fr":"Voilà ! Tu es prêt pour le film.","ar":"هكذا! أنت جاهز للفيلم."}]}],"exercises":[{"t":"mcq","skill":"pronunciation","q":"ما نطق « café »؟","opts":["[ka.fe] — é مغلق","[ka.fɛ] — è مفتوح","[kaf] — بلا نطق","[ka.fə] — غير واضح"],"a":0,"why":"é = [e] مغلق قصير."},{"t":"fill","skill":"pronunciation","q":"أكمل بنطق é: «ca___» (قهوة)","fr":"ca___","ans":"fé","why":"café ينتهي بـ é."},{"t":"mcq","skill":"grammar","q":"أي كلمة تحتوي ç؟","opts":["garçon","café","père","fenêtre"],"a":0,"why":"garçon = g-a-r-ç-o-n مع cédille."},{"t":"order","skill":"writing","q":"رتّب: ولد يذهب إلى الدرس","words":["Le","garçon","va","à","la","leçon."],"ans":"Le garçon va à la leçon.","why":"Ç + à + la."},{"t":"listen","skill":"listening","q":"أي كلمة بها è [ɛ]؟","opts":["père","café","été","merci"],"a":0,"why":"père [pɛʁ] — è مفتوح."},{"t":"translate","skill":"writing","q":"ترجم: والدي في المقهوى.","ans":"Mon père est au café.","why":"père + café + au."},{"t":"speaking","skill":"pronunciation","q":"اقرأ بصوت عالٍ: café, père, fenêtre, Noël, garçon — مسجلاً نفسك.","target":"[e] / [ɛ] / [ɛ] / [nɔ.ɛl] / [gaʁ.sɔ̃]","why":"تمرين الأكسنتو الأربعة."},{"t":"correct","skill":"grammar","q":"صحّح: «Je suis à la cafe.»","ans":"Je suis au café.","why":"café مذكر: au café + é."}],"homework":"شاهد الدرس مرتين، ثم اكتب عشر كلمات فرنسية بأكسنتات مختلفة وسجّل نطقها واحداً واحداً — وقارنها بالفيديو.","sources":[{"title":"Les Accents du Français : Tu vas enfin tout comprendre !","channel":"Le French Club","videoId":"yZ3rABJNfC8","why":"شرح منهجي شامل للأكسنتو الأربعة: aigu, grave, circonflexe, tréma — مع أمثلة نطق مباشرة قبل دخول الأفلام.","cat":"Méthode","level":"B1","main":true},{"title":"Les Accents en Français","channel":"Français Facile","videoId":"Nz6IBVl7fF0","why":"شرح آخر للأكسنتات بأسلوب مختلف — أعد الاستماع لترسيخ النظام الصوتي.","cat":"Méthode","level":"B1","extra":true},{"title":"Le GUIDE COMPLET des accents en français!","channel":"French with Vincent","videoId":"_4lJC1dBuq4","why":"دليل شامل إضافي — يغطي حالات نادرة وتمارين تثبيت.","cat":"Méthode","level":"B1","extra":true}],"supplements":[{"id":"Nz6IBVl7fF0","title":"Les Accents en Français","channel":"Français Facile","why":"شرح آخر للأكسنتات بأسلوب مختلف — أعد الاستماع لترسيخ النظام الصوتي.","lang":"fr","dur":8},{"id":"_4lJC1dBuq4","title":"Le GUIDE COMPLET des accents en français!","channel":"French with Vincent","why":"دليل شامل إضافي — يغطي حالات نادرة وتمارين تثبيت.","lang":"fr","dur":14}]},{"id":"b1-t9-l2","fr":"Amélie — le fabuleux destin (2001)","ar":"فيلم: أميلي — المصير الاستثنائي (2001)","objectives":["فهم لغة السرد الخيالي في السينما الفرنسية: la narration, le ton, l’imagination","تمييز imparfait للوصف و passé composé للأحداث داخل سياق السينما","استخراج مفردات الحدس والحظ: la chance, le destin, la méfiance","تحليل كيف تُبنى الشخصية عبر التفاصيل الصغيرة في الحوار"],"sections":[{"h":"الفيلم 1: Amélie — الخيال والبؤس (الإعلان الرسمي)","video":{"id":"pr2NCGZ7s4k","title":"Le Fabuleux destin d’Amélie Poulain (2001) Bande Annonce VF [HD]","channel":"UniFrance","why":"الإعلان الرسمي الفرنسي لفيلم Amélie — لغة السرد الخيالي، le passé composé للحدث، وlimparfait للوصف.","lang":"fr","main":true,"dur":2},"p":["Amélie Poulain هي أيقونة السينما الفرنسية الحديثة: بطلة خجولة تقرر تغيير حياة من حولها عبر مقالب صغيرة. الفيلم يتحدث بلغة بصرية قبل الحوار، لكن ما تسمعه هو فرنسي مكتوب بعناية: سرد قصير، صور شعرية، ونبرة هادئة تخفي حماساً باطناً.","المفردات الأساسية: le destin, la chance, le rêve, l’imagination, la méfiance, l’amour, le secret. هذه المفردات تظهر في التعليق الصوتي وفي حوار Amélie مع نفسها.","نحوياً، يبرز الصرف بين imparfait للحالة و passé composé للحدث: « Amélie rêvait… » ثم « elle a décidé… ». هذا التقابل هو جوهر السرد السينمائي.","الإعلان الرسمي قصير لكنه كثيف: كل جملة تحمل صورة. حاول أن تسمع التعليق الصوتي ثلاث مرات — في المرة الثالثة ستلتقط الربط بين الحالة والحدث.","بعد الإعلان، اكتب فقرة قصيرة عن شخص تخترع له قصة صغيرة (خمس جمل) بالفرنسية: من هو، ماذا يفعل، وما السر الذي يخفيه.","Amélie تُعلّمك أن la narration السينمائية تُبنى على la nuance لا la force: imparfait للحالة، passé composé للحركة، ثم la morale الصغيرة تبقى."],"sub":[{"h":"لغة السرد والوصف","p":["Amélie Poulain rêve d’une autre vie.","Elle a décidé de changer le destin des autres.","La chance sourit enfin à quelqu’un.","Le secret, c’est de croire aux petits bonheurs."]},{"h":"أدوات نطقية: نبرة السرد","p":["« le destin » [lə dɛs.tɛ̃] — t واضحة.","« la chance » [la ʃɑ̃s] — nasale أنفية.","« rêve » [ʁɛv] — v ناعمة."]},{"h":"خطوات Listen & Repeat","p":["المرة الأولى: اكتب ثلاث جمل سردية من التعليق.","الثانية: كرّرها بنبرة هادئة تشبه النسّاخ.","الثالثة: حوّل ثلاث جمل إلى imparfait ثم passé composé."]}]},{"h":"عبارات الحدس والسرد","p":["« C’est le destin. » = إنه القدر! — la résignation المقبولة في الثقافة الفرنسية.","« Elle a l’impression que… » = لديها انطباع أن… — la perception الداخلية.","« C’est trop beau pour être vrai. » — la méfiance الحلوة.","« Il faut croire aux petits bonheurs. » — la leçon الفلسفية للفيلم."]},{"h":"التطبيق والتلخيص","p":["تمرين السرد: اكتب فقرة من خمس جمل عن يوم شخص عادي تحوله إلى حدث استثنائي.","لعبة الأدوار: شخص يروي « سراً صغيراً » لصديق — استخدم la chance / le destin.","سجّل نفسك تروي فيلمك المفضل في 30 ثانية بالفرنسية."]},{"h":"التطبيق والتلخيص","p":["خلاصة: فهمتَ لغة السرد في Amélie: نبرة الحكاية الخيالية، imparfait للوصف مقابل passé composé للأحداث، ومفردات الحدس والحظ (le destin, la chance, la méfiance). «أعد مشاهدة الفيديو الرئيسي وركّز على نبرة السرد السينمائي في المقدمة، وعلى الجملة الفلسفية Il faut croire aux petits bonheurs»","جسر الدروس: من b1-t9-l1 (نظام الأكسنتو وقواعد النطق) إلى b1-t9-l2 (السرد السينمائي في Amélie)، ثم إلى b1-t9-l3 حيث تظهر La Famille Bélier: العائلة والصوت وsubjonctif التمني والرغبة.","مهمة تطبيقية: اكتب وسجّل فقرة سينمائية من دقيقة واحدة عن شخص تحلم بتغيير حياته، مستعملاً ثلاث كلمات جديدة من هذا الدرس (le destin, la chance, l’impression)؛ ثم قارن نبرة سردك بنبرة الراوية في الفيديو واكتب جملة تحتاج إبطاءً."]}],"pron":[{"w":"le destin","ipa":"[lə dɛs.tɛ̃]","approx":"لو دوستان"},{"w":"la chance","ipa":"[la ʃɑ̃s]","approx":"لا شانس"},{"w":"rêver","ipa":"[ʁe.ve]","approx":"رييفي"}],"vocab":[{"fr":"le destin","ar":"القدر/المصير","pos":"nom","g":"m","exFr":"C’est le destin qui les a réunis.","ipa":"","exAr":"القدر هو ما جمعهما."},{"fr":"la chance","ar":"الحظ","pos":"nom","g":"f","exFr":"J’ai de la chance aujourd’hui.","ipa":"","exAr":"لديّ حظ اليوم."},{"fr":"rêver","ar":"يحلم","pos":"verbe","g":"","exFr":"Elle rêve d’une autre vie.","ipa":"","exAr":"تحلم بحياة أخرى."},{"fr":"l’imagination","ar":"الخيال","pos":"nom","g":"f","exFr":"Son imagination n’a pas de limites.","ipa":"","exAr":"خيالها بلا حدود."},{"fr":"le secret","ar":"السر","pos":"nom","g":"m","exFr":"Garde le secret pour toi.","ipa":"","exAr":"احتفظ بالسر لنفسك."},{"fr":"la méfiance","ar":"الحذر/الريبة","pos":"nom","g":"f","exFr":"Sa méfiance est compréhensible.","ipa":"","exAr":"حذره مفهوم."},{"fr":"l’amour","ar":"الحب","pos":"nom","g":"m","exFr":"L’amour arrive quand on ne l’attend pas.","ipa":"","exAr":"الحب يأتي حين لا ننتظره."},{"fr":"changer","ar":"يغيّر","pos":"verbe","g":"","exFr":"Elle veut changer le monde.","ipa":"","exAr":"تريد تغيير العالم."},{"fr":"un bonheur","ar":"سعادة","pos":"nom","g":"m","exFr":"Les petits bonheurs comptent.","ipa":"","exAr":"السعادات الصغيرة مهمة."},{"fr":"décider","ar":"يقرر","pos":"verbe","g":"","exFr":"Il a décidé de partir.","ipa":"","exAr":"قرر أن يسافر."},{"fr":"le rêve / le cauchemar","ar":"الحلم / الكابوس","pos":"nom","g":"m","exFr":"Le rêve devient réalité.","ipa":"","exAr":"الحلم يصبح حقيقة."},{"fr":"croire (en)","ar":"يؤمن بـ","pos":"verbe","g":"","exFr":"Je crois aux petits bonheurs.","ipa":"","exAr":"أؤمن بالسعادات الصغيرة."}],"examples":[{"fr":"Amélie rêve d’une autre vie.","ar":"أميلي تحلم بحياة أخرى.","note":"imparfait"},{"fr":"Elle a décidé de changer quelque chose.","ar":"قررت تغيير شيء ما.","note":"passé composé"},{"fr":"La chance sourit enfin.","ar":"الحظ يبتسم أخيراً.","note":"استعارة"},{"fr":"C’est le destin.","ar":"إنه القدر.","note":"la formule"},{"fr":"Il faut croire aux petits bonheurs.","ar":"يجب أن نؤمن بالسعادات الصغيرة.","note":"la morale"},{"fr":"Le secret, c’est d’y croire.","ar":"السر هو أن تؤمن به.","note":"infinitif"}],"grammar":[{"tFr":"Imparfait vs passé composé au cinéma","tAr":"imparfait مقابل passé composé في السينما","body":["imparfait يصف المشهد، الحالة، الجو: « Il faisait beau, Amélie rêvait… ». passé composé يقدّم الحدث: « Elle a décidé, elle a agi… ».","في السرد السينمائي، يتبادل النحو الأدوار: imparfait = la toile de fond، passé composé = le mouvement."],"ex":[{"fr":"Amélie regardait la Seine, puis elle a souri.","ar":"كانت أميلي تنظر إلى السين، ثم ابتسمت."},{"fr":"Il pleuvait quand le destin a frappé.","ar":"كان تمطر حين طرق القدر الباب."}]},{"tFr":"Futur simple vs futur proche (narration)","tAr":"المستقبل البسيط مقابل القريب في السرد","body":["futur simple أكثر أدبية: « Elle changera le monde ». futur proche أكثر حوارية: « Elle va changer quelque chose ».","في التعليق الصوتي يُفضَّل futur simple لأنه يمنح نبرة قدرية."],"ex":[{"fr":"Le destin le lui rendra.","ar":"سيعيده له القدر."},{"fr":"Elle va trouver l’amour.","ar":"ستجد الحب."}]}],"mistakes":[{"wrong":"« Amélie a rêvé d’une autre vie » (للحالة المستمرة)","right":"« Amélie rêvait d’une autre vie »","why":"الحالة المستمرة تأخذ imparfait لا passé composé."},{"wrong":"« C’est la chance ! » (بمعنى الحظ)","right":"« J’ai de la chance. »","why":"la chance اسم لا أداة استفهام."},{"wrong":"« Je crois au destin » مع نفي","right":"« Je ne crois pas au destin »","why":"la négation تسبق الفعل: crois → ne… pas."},{"wrong":"الخلط بين rêver و rêver de","right":"« rêver de quelque chose »","why":"rêver يتطلب de قبل المفعول."}],"dialogues":[{"title":"وصف الشخصية","ctx":"Sam تصف Amélie لصديقتها","lines":[{"who":"Sam","fr":"Amélie rêvait d’une vie intéressante.","ar":"كانت أميلي تحلم بحياة ممتعة."},{"who":"Annie","fr":"Et elle a trouvé ?","ar":"هل وجدتها؟"},{"who":"Sam","fr":"Elle a changé la vie des autres.","ar":"غيّرت حياة الآخرين."},{"who":"Annie","fr":"C’est le destin, non ?","ar":"إنه القدر، أليس كذلك؟"}]},{"title":"الحكمة الصغيرة","ctx":"حوار عن السعادة","lines":[{"who":"Hugo","fr":"Tu crois aux petits bonheurs ?","ar":"هل تؤمن بالسعادات الصغيرة؟"},{"who":"Sam","fr":"Oui, il faut y croire.","ar":"نعم، يجب أن نؤمن بها."},{"who":"Hugo","fr":"Comme Amélie, alors.","ar":"إذن مثل أميلي."},{"who":"Sam","fr":"Le secret, c’est d’agir.","ar":"السر هو أن تتحرك."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما معنى « le destin »؟","opts":["القدر","الحظ","الحلم","السر"],"a":0,"why":"destin = القدر/المصير."},{"t":"fill","skill":"grammar","q":"أكمل: «Amélie ___ d’une autre vie.» (كانت تحلم)","fr":"Amélie ___ d’une autre vie.","ans":"rêvait","why":"الحالة المستمرة تأخذ imparfait."},{"t":"mcq","skill":"grammar","q":"الجملة السينمائية الصحيحة:","opts":["Il faisait beau et elle a souri.","Il a fait beau et elle souriait.","Il fait beau et elle sourit.","Il faisait beau et elle souriait toujours."],"a":0,"why":"imparfait للحالة + passé composé للحدث."},{"t":"order","skill":"writing","q":"رتّب: يجب أن نؤمن بالسعادات الصغيرة","words":["Il","faut","croire","aux","petits","bonheurs."],"ans":"Il faut croire aux petits bonheurs.","why":"il faut + infinitif + à + les = aux."},{"t":"listen","skill":"listening","q":"ما التعبير الذي يلخّص فلسفة الفيلم؟","opts":["Il faut croire aux petits bonheurs.","Il faut travailler beaucoup.","Il faut être riche.","Il faut partir loin."],"a":0,"why":"la morale du film."},{"t":"translate","skill":"writing","q":"ترجم: الحظ يبتسم أخيراً.","ans":"La chance sourit enfin.","why":"la chance + sourire."},{"t":"speaking","skill":"speaking","q":"صف شخصاً تحلم بتغيير حياة أحد — ثلاث جمل بنبرة سينمائية.","target":"X rêvait de… / Il a décidé de… / Le secret…","why":"نمط السرد."},{"t":"correct","skill":"grammar","q":"صحّح: «Amélie a rêvé d’une autre vie.»","ans":"Amélie rêvait d’une autre vie.","why":"الحالة تأخذ imparfait."}],"homework":"شاهد الإعلان خمس مرات، ثم اكتب فقرة من خمس جمل عن شخص تخترع له قصة صغيرة: من هو، ماذا يحلم، ماذا يقرر، وما السر — بنمط السرد السينمائي.","sources":[{"title":"Le Fabuleux destin d’Amélie Poulain (2001) Bande Annonce VF [HD]","channel":"UniFrance","videoId":"pr2NCGZ7s4k","why":"الإعلان الرسمي الفرنسي لفيلم Amélie — لغة السرد الخيالي، le passé composé للحدث، وlimparfait للوصف.","cat":"Films","level":"B1","main":true},{"title":"AMÉLIE | Official Trailer","channel":"Focus Features","videoId":"Py7cDXQae2U","why":"الإعلان الإنجليزي — قارن الفروق في الترجمة والصوت.","cat":"Films","level":"B1","extra":true},{"title":"Amélie (2001) Official Trailer 1 - Audrey Tautou Movie","channel":"Movieclips Classic Trailers","videoId":"HUECWi5pX7o","why":"إعلان كلاسيكي آخر — تثبيت المفردات عبر التكرار البصري.","cat":"Films","level":"B1","extra":true}],"supplements":[{"id":"Py7cDXQae2U","title":"AMÉLIE | Official Trailer","channel":"Focus Features","why":"الإعلان الإنجليزي — قارن الفروق في الترجمة والصوت.","lang":"fr","dur":2},{"id":"HUECWi5pX7o","title":"Amélie (2001) Official Trailer 1 - Audrey Tautou Movie","channel":"Movieclips Classic Trailers","why":"إعلان كلاسيكي آخر — تثبيت المفردات عبر التكرار البصري.","lang":"fr","dur":2}]},{"id":"b1-t9-l3","fr":"La Famille Bélier (2014)","ar":"فيلم: العائلة العمياء (2014)","objectives":["فهم مفردات العائلة والتواصل: la famille, les parents, chanter, la voix","استعمال subjonctif في التمني والرغبة: je veux que, il faut que","تحليل كيف يتعامل الفيلم مع la surdité بلغة إيجابية لا رثاء","ربط الأغنية (Je vole) بالدرس: كيف يحمل الصوت معنى في الفيلم"],"sections":[{"h":"الفيلم 2: La Famille Bélier — العائلة والصوت (الإعلان)","video":{"id":"tEgw97vpkDM","title":"La Famille Bélier – Bande annonce HD","channel":"Warner Bros. France","why":"الإعلان الرسمي لفيلم La Famille Bélier — لغة العائلة، la surdité، واختيار الغناء.","lang":"fr","main":true,"dur":2},"p":["La Famille Bélier فيلم عن عائلة مزارعة في نورماندي جميعها صماء إلا Paula ابنتها الصوتية. النزاع الأساسي: أن تختار بين عائلتها وحلمها بالغناء. الفيلم يتعامل مع la surdité بفكاهة واحترام — لا رثاء ولا تعاطف مفرط.","المفردات الأساسية: la famille, les parents, la surdité, la voix, chanter, le rêve, choisir, comprendre. هذه المفردات جسر بين الفيلم والمواقف اليومية.","نحوياً، يبرز subjonctif في التمني والرغبة: « Je veux que tu restes », « Il faut que tu choisisses ». هذا هو النمط العاطفي في الفرنسية.","الأغنية Je vole لـ Louane هي قلب الفيلم: لغة بسيطة تحمل معنى الثقة والتعلّق. استمع إليها بعد الإعلان وحلّل كلماتها.","بعد الإعلان، اكتب رسالة قصيرة إلى عائلتك (خمس جمل) تشرح فيها حلمك وتطلب دعمهم — مع جملة subjonctif واحدة على الأقل.","La Famille Bélier يربط la surdité بـ la voix: la langue ليست مجرد كلمات بل la présence. جرّب أن تصف عائلتك بنفس الطريقة التي وصف بها فيليان."],"sub":[{"h":"جمل العائلة والرغبة","p":["Je veux que tu restes avec nous.","Il faut que tu choisisses entre la musique et la ferme.","Ma famille me comprend toujours.","Je vole, je vole, je vole…"]},{"h":"أدوات نطقية: la voix et la surdité","p":["« la voix » [la vwa] — v واضحة.","« la surdité » [la syʁ.di.te] — صامتة t في آخر.","« chanter » [ʃɑ̃.te] — nasale أنفية قوية."]},{"h":"خطوات Listen & Repeat","p":["المرة الأولى: اكتب كلمات الأغنية الأساسية.","الثانية: كرّر مقطع « Je vole » بنبرة Paula.","الثالثة: استبدل كلمات الأغنية بهوايتك أنت."]}]},{"h":"عبارات العائلة والدعم","p":["« Ma famille me comprend. » = عائلتي تفهمني — la base de la communication.","« Je veux que tu sois heureux(se). » — subjonctif مع être.","« Il faut que je parte. » — la nécessité + subjonctif.","« Choisis entre… et… » = اختر بين… و… — la présentation des alternatives."]},{"h":"التطبيق والتلخيص","p":["تمرين subjonctif: اكتب ثلاث جمل رغبة (Je veux que…) وثلاث جمل ضرورة (Il faut que…).","تحليل الأغنية: استخرج ثلاث كلمات من Je vole واشرح معناها في سياق الفيلم.","سجّل نفسك تصف عائلتك في 30 ثانية بالفرنسية: من هم، ماذا يحبون، وكيف يدعمونك."]},{"h":"التطبيق والتلخيص","p":["خلاصة: فهمتَ مفردات العائلة والصمم والصوت في La Famille Bélier، واستعملتَ subjonctif مع je veux que / il faut que، وربطتَ أغنية Je vole بصراع الاختيار بين العائلة والحلم. «أعد مشاهدة الفيديو الرئيسي وركّز على نبرة الرغبة في جمل «Je veux que…» داخل مشهد الأغنية، وعلى تعابير العائلة في الحوار»","جسر الدروس: من b1-t9-l2 (السرد الخيالي في Amélie) إلى b1-t9-l3 (العائلة والصوت وsubjonctif الرغبة)، ثم إلى b1-t9-l4 حيث ينتقل إلى فرنسي العمل والتفاوض في Dix pour cent: le contrat, le budget, la conditionnelle.","مهمة تطبيقية: سجّل ثلاث جمل رغبة نحو عائلتك في دقيقة واحدة (Je veux que vous… / Il faut que…) مستعملاً ثلاث كلمات جديدة من هذا الدرس (la famille, le soutien, choisir)، ثم قارن نبرتك بنبرة Paula في الفيديو وحدّد الجملة الأقنع."]}],"pron":[{"w":"la famille","ipa":"[la fa.mij]","approx":"لا فاميل"},{"w":"chanter","ipa":"[ʃɑ̃.te]","approx":"شانتي"},{"w":"la voix","ipa":"[la vwa]","approx":"لا فوا"}],"vocab":[{"fr":"la famille","ar":"العائلة","pos":"nom","g":"f","exFr":"Ma famille est nombreuse.","ipa":"","exAr":"عائلتي كبيرة."},{"fr":"les parents","ar":"الوالدان","pos":"nom","g":"m pl","exFr":"Mes parents travaillent à la ferme.","ipa":"","exAr":"والداي يعملان في المزرعة."},{"fr":"la surdité","ar":"الصمم","pos":"nom","g":"f","exFr":"La surdité ne l’empêche pas de rêver.","ipa":"","exAr":"الصمم لا يمنعه من الحلم."},{"fr":"le chant","ar":"الغناء (فنّ)","pos":"nom","g":"m","exFr":"Le chant de Paula remplit la salle.","ipa":"[lə ʃɑ̃]","exAr":"غناء بولّا يملأ القاعة."},{"fr":"chanter","ar":"يغني","pos":"verbe","g":"","exFr":"Elle veut chanter sur scène.","ipa":"","exAr":"تريد الغناء على المسرح."},{"fr":"le rêve","ar":"الحلم","pos":"nom","g":"m","exFr":"Son rêve est de devenir chanteuse.","ipa":"","exAr":"حلمها أن تصبح مغنية."},{"fr":"choisir","ar":"يختار","pos":"verbe","g":"","exFr":"Il faut choisir entre deux options.","ipa":"","exAr":"يجب الاختيار بين خيارين."},{"fr":"comprendre","ar":"يفهم","pos":"verbe","g":"","exFr":"Je te comprends parfaitement.","ipa":"","exAr":"أتفهمك تماماً."},{"fr":"la ferme","ar":"المزرعة","pos":"nom","g":"f","exFr":"La ferme est au bord de la rivière.","ipa":"","exAr":"المزرعة على ضفة النهر."},{"fr":"le soutien","ar":"الدعم","pos":"nom","g":"m","exFr":"J’ai besoin de ton soutien.","ipa":"","exAr":"أحتاج دعمك."},{"fr":"le conservatoire","ar":"المعهد الموسيقي","pos":"nom","g":"m","exFr":"Paula entre au conservatoire en septembre.","ipa":"[lə kɔ̃.sɛʁ.vwaʁ]","exAr":"بولّا تدخل المعهد الموسيقي في سبتمبر."},{"fr":"un chanteur / une chanteuse","ar":"مغنٍ / مغنية","pos":"nom","g":"m/f","exFr":"Ce chanteur est très populaire.","ipa":"","exAr":"هذا المغني شهير جداً."}],"examples":[{"fr":"Je veux que tu restes.","ar":"أريدك أن تبقى.","note":"subjonctif"},{"fr":"Il faut que tu choisisses.","ar":"يجب أن تختار.","note":"subjonctif"},{"fr":"Ma famille me comprend.","ar":"عائلتي تفهمني.","note":"pronom + comprendre"},{"fr":"Elle veut chanter.","ar":"تريد الغناء.","note":"vouloir + infinitif"},{"fr":"Je vole, je vole, je vole…","ar":"أحلّق… (عنوان الأغنية)","note":"la chanson"},{"fr":"Choisis entre la musique et la ferme.","ar":"اختر بين الموسيقى والمزرعة.","note":"présenter les alternatives"}],"grammar":[{"tFr":"Subjonctif : je veux que / il faut que","tAr":"الsubjunctif مع التمني والضرورة","body":["« Je veux que tu restes » — après vouloir que, il faut que, il est bon que… يُستخدم subjonctif.","الصيغة: rester → que tu restes، choisir → que tu choisisses، être → que tu sois. تدرّب على الشاذ être/avoir أولاً."],"ex":[{"fr":"Je veux que tu sois heureux.","ar":"أريدك أن تكون سعيداً."},{"fr":"Il faut que je parte maintenant.","ar":"يجب أن أغادر الآن."}]},{"tFr":"Pronoms compléments : me / te / le","tAr":"المفعول به: me / te / le / la","body":["« Ma famille me comprend » — me = العائلة تفهمني. « Je te comprends » — te = أتفهمك.","الترتيب: ساكن + ساكن يأخذ liaison: « Je le comprends » تُنطق [ʒə lə kɔ̃.pʁɑ̃]."],"ex":[{"fr":"Elle me soutient toujours.","ar":"هي تدعمني دائماً."},{"fr":"Je te comprends, tu sais.","ar":"أتفهمك، تعلم."}]}],"mistakes":[{"wrong":"« Je veux que tu restes » → « Je veux que tu rester »","right":"« Je veux que tu restes »","why":"subjonctif après vouloir que."},{"wrong":"« Ma famille me comprend » (بلا pronom)","right":"« Ma famille comprend moi »","why":"المفعول به يسبق الفعل: me comprend."},{"wrong":"« Je vole » كفعل حرفي","right":"« Je vole » كاستعارة في الأغنية","why":"السياق يغيّر المعنى: أحلّق لا أسرق."},{"wrong":"la surdité = la cécité","right":"la surdité = الصمم، la cécité = العمى","why":"لا تخلط بين الحواس."}],"dialogues":[{"title":"الرغبة العائلية","ctx":"Paula مع والدها","lines":[{"who":"Paula","fr":"Je veux que vous m’écoutiez chanter.","ar":"أريدكم أن تستمعوا إليّ وأنا أغني."},{"who":"Père","fr":"Il faut que tu restes à la ferme.","ar":"يجب أن تبقي في المزرعة."},{"who":"Paula","fr":"Non, il faut que je suive mon rêve.","ar":"لا، يجب أن أتبع حلمي."},{"who":"Père","fr":"Je veux que tu sois heureuse.","ar":"أريدكِ أن تكوني سعيدة."}]},{"title":"الأغنية","ctx":"Sam وNicolas يحلّلان Je vole","lines":[{"who":"Sam","fr":"« Je vole » — elle parle de son rêve.","ar":"« Je vole » — هي تتحدث عن حلمها."},{"who":"Nico","fr":"Oui, la voix est pleine d’espoir.","ar":"نعم، صوتها مفعم بالأمل."},{"who":"Sam","fr":"Il faut que tu écoutes la chanson.","ar":"يجب أن تستمع إلى الأغنية."},{"who":"Nico","fr":"D’accord, je veux que tu me la traduises.","ar":"موافق، أريدك أن تترجمها لي."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما معنى « la surdité »؟","opts":["الصمم","العمى","البكم","الصمت"],"a":0,"why":"surdité = الصمم."},{"t":"fill","skill":"grammar","q":"أكمل: «Je veux que tu ___ avec nous.» (تبقى)","fr":"Je veux que tu ___ avec nous.","ans":"restes","why":"subjonctif: rester → restes."},{"t":"mcq","skill":"grammar","q":"ما الصيغة الصحيحة بعد «Il faut que» مع choisir؟","opts":["Il faut que tu choisisses.","Il faut que tu choisis.","Il faut que tu choisissons.","Il faut que tu choisiras."],"a":0,"why":"subjonctif: choisir → tu choisisses."},{"t":"order","skill":"writing","q":"رتّب: عائلتي تفهمني دائماً","words":["Ma","famille","me","comprend","toujours."],"ans":"Ma famille me comprend toujours.","why":"pronom me + comprend."},{"t":"listen","skill":"listening","q":"ما عنوان الأغنية الشهيرة من الفيلم؟","opts":["Je vole","Je chante","Je rêve","Je fly"],"a":0,"why":"Je vole = عنوان الأغنية."},{"t":"translate","skill":"writing","q":"ترجم: يجب أن تختار بين الموسيقى والمزرعة.","ans":"Il faut que tu choisis entre la musique et la ferme.","why":"il faut que + subjonctif."},{"t":"speaking","skill":"speaking","q":"اكتب وسجّل ثلاث جمل رغبة نحو عائلتك: Je veux que vous…","target":"Je veux que vous m’écoutiez / Je veux que vous soyez fiers / Je veux que vous compreniez","why":"subjonctif عاطفي."},{"t":"correct","skill":"grammar","q":"صحّح: «Je veux que tu rester.»","ans":"Je veux que tu restes.","why":"subjonctif après vouloir que."}],"homework":"شاهد الإعلان واسمع الأغنية Je vole ثلاث مرات، ثم اكتب فقرة من خمس جمل عن حلم تسعى إليه: ما هو، لماذا، وماذا تطلب من عائلتك — مع جملة subjonctif.","sources":[{"title":"La Famille Bélier – Bande annonce HD","channel":"Warner Bros. France","videoId":"tEgw97vpkDM","why":"الإعلان الرسمي لفيلم La Famille Bélier — لغة العائلة، la surdité، واختيار الغناء.","cat":"Films","level":"B1","main":true},{"title":"La famille Bélier : official trailer (In french with english subtitles)","channel":"EuropaCorp","videoId":"mzWvI8BkrJo","why":"إعلان بترجمة إنجليزية — قارن الفروق بين النص الفرنسي والترجمة.","cat":"Films","level":"B1","extra":true},{"title":"Louane - Je vole ( Bélier Family )","channel":"Warner Music France","videoId":"mBLwdaLPeds","why":"الأغنية كاملة — حلّل كلماتها واستمع لنبرة Louane.","cat":"Films","level":"B1","extra":true}],"supplements":[{"id":"mzWvI8BkrJo","title":"La famille Bélier : official trailer (In french with english subtitles)","channel":"EuropaCorp","why":"إعلان بترجمة إنجليزية — قارن الفروق بين النص الفرنسي والترجمة.","lang":"fr","dur":2},{"id":"mBLwdaLPeds","title":"Louane - Je vole ( Bélier Family )","channel":"Warner Music France","why":"الأغنية كاملة — حلّل كلماتها واستمع لنبرة Louane.","lang":"fr","dur":4}]},{"id":"b1-t9-l4","fr":"Dix pour cent — le film (2022)","ar":"فيلم: عشرة بالمئة — الوكلاء والممثلون (2022)","objectives":["فهم فرنسي العمل والفن: le talent, le contrat, le client, négocier","استعمال الشرطية في الاحتمالات المهنية: pourrait, serait, devrait","تحليل كيف يعكس الفيلم ثقافة la galanterie والذكاء المهني في باريس","تمييز la langue familière عن la langue professionnelle داخل الحوار"],"sections":[{"h":"الفيلم 3: Dix pour cent — العمل والفن (الإعلان)","video":{"id":"afCKKmg_BaQ","title":"Dix pour cent : Le film | Bande-annonce officielle VF | Netflix France","channel":"Netflix France","why":"الإعلان الرسمي لفيلم Dix pour cent — لغة العمل في باريس: le talent, le client, la négociation.","lang":"fr","main":true,"dur":2},"p":["Dix pour cent (Call My Agent!) فيلم عن وكالة مواهب بباريس: الوكلاء يتنافسون على إبرام الصفقات مع نجوم السينما. الفرنسية هنا سريعة، مفعمة بالدعابة، ومليئة بمفردات العمل: le contrat, le budget, le talent, la négociation.","المفردات الأساسية: l’agent, le talent, le client, le contrat, négocier, le budget, l’affaire, convaincre, refuser, signer. هذه المفردات أساس فرنسي العمل اليومي.","نحوياً، تبرز la forme conditionnelle: « Il pourrait signer », « Ce serait parfait », « Il devrait appeler ». la conditionnelle تُستخدم للتخمين المهذّب في باريس.","الإعلان يعرض la diversité sociale: حوار راقٍ + حوار شعبي + حوار إداري. لاحظ كيف تتغيّر la langue avec l’interlocuteur — هذا هو قلب الفرنسية المهنية.","بعد الإعلان، اكتب مشهداً من ثلاث جمل: عميل يطلب خدمة، وكيل يعرض سعراً، ثم تسوية — بالفرنسية.","Dix pour cent يكشف la France professionnelle: le talent + le budget + la négociation. la conditionnelle هي مفتاح la politesse في عمل فرنسي."],"sub":[{"h":"جمل العمل والصفقة","p":["Le client veut signer aujourd’hui.","Il pourrait accepter le budget.","Ce serait parfait pour le talent.","Je dois convaincre le studio."]},{"h":"أدوات نطقية: أرقام وعمل","p":["« le contrat » [lə kɔ̃.tʁa] — t واضحة.","« le budget » [lə by.ʒɛ] — t صامتة.","« dix pour cent » [dis puʁ sɑ̃] — s في dix صامتة قبل p."]},{"h":"خطوات Listen & Repeat","p":["المرة الأولى: اكتب كل كلمة عمل سمعتها.","الثانية: كرّر جمل الشرطية بنبرة احترافية.","الثالثة: حوّل ثلاث جمل إلى la forme directe."]}]},{"h":"عبارات العمل والتفاوض","p":["« Le client est d’accord ? » = هل العميل موافق؟ — la vérification الأساسية.","« Ce serait parfait. » — la conditionnelle المهذّبة للعرض.","« Il faut convaincre le studio. » — la nécessité + la stratégie.","« On signe quand ? » = نوقّع متى؟ — la question directe في العمل."]},{"h":"التطبيق والتلخيص","p":["تمرين التفاوض: شخص وكيل وآخر عميل — ثلاث جمل: الطلب، العرض، ثم التسوية.","كتابة: رسالة بريدية قصيرة تطلب فيها عرضاً (le budget, le talent, le contrat).","سجّل نفسك تصف وظيفتك أو وظيفة تحلم بها في 30 ثانية بالفرنسية."]},{"h":"التطبيق والتلخيص","p":["خلاصة: تفاوضتَ بلغة الوكالة في Dix pour cent: le client, le contrat, le budget, négocier، مع الشرطية المهذّبة (pourrait, serait, devrait) في الاحتمالات المهنية وتمييز la langue professionnelle عن la langue familière. «أعد مشاهدة الفيديو الرئيسي وركّز على سرعة حوار الوكلاء، وعلى الجمل الشرطية عند العرض والاعتراض»","جسر الدروس: من b1-t9-l3 (العائلة والرغبة مع subjonctif) إلى b1-t9-l4 (الوكالة والتفاوض بالشرطية المهذّبة)، ثم إلى b1-t9-l5 حيث يسرع إيقاع اللسان مع Lupin: الغموض، الانتقام، والسؤال بـinversion.","مهمة تطبيقية: سجّل مشهد تفاوض من دقيقة واحدة (طلب ← عرض شرطي ← توافق) مستعملاً ثلاث كلمات جديدة من هذا الدرس (le client, le contrat, négocier)؛ ثم قارن سرعة حوارك بنشر الوكلاء في الفيديو واكتب جملة تباطأت فيها."]}],"pron":[{"w":"le contrat","ipa":"[lə kɔ̃.tʁa]","approx":"لو كونترا"},{"w":"négocier","ipa":"[ne.ɡɔ.sje]","approx":"نييغوصييه"},{"w":"le client","ipa":"[lə kli.jɑ̃]","approx":"لو كلييان"}],"vocab":[{"fr":"l’agent","ar":"الوكيل/المندوب","pos":"nom","g":"m","exFr":"L’agent est très occupied.","ipa":"","exAr":"الوكيل مشغول جداً."},{"fr":"le talent","ar":"الموهبة","pos":"nom","g":"m","exFr":"Il a un vrai talent.","ipa":"","exAr":"لديه موهبة حقيقية."},{"fr":"le client / la cliente","ar":"العميل/العميلة","pos":"nom","g":"m/f","exFr":"Le client attend dans le bureau.","ipa":"","exAr":"العميل ينتظر في المكتب."},{"fr":"le contrat","ar":"العقد","pos":"nom","g":"m","exFr":"Le contrat est prêt à signer.","ipa":"","exAr":"العقد جاهز للتوقيع."},{"fr":"négocier","ar":"يتفاوض","pos":"verbe","g":"","exFr":"Ils négocient le budget.","ipa":"","exAr":"يتفاوضون على الميزانية."},{"fr":"le budget","ar":"الميزانية","pos":"nom","g":"m","exFr":"Le budget est limité.","ipa":"","exAr":"الميزانية محدودة."},{"fr":"l’affaire","ar":"الصفقة/الأمر","pos":"nom","g":"f","exFr":"C’est une bonne affaire.","ipa":"","exAr":"إنها صفقة جيدة."},{"fr":"manipuler","ar":"تلاعب بكشف الحقيقة","pos":"verbe","g":"","exFr":"Le personnage essaie de manipuler les autres.","ipa":"/demon-te/","exAr":"الشخصية تحاول تلاعب الآخرين."},{"fr":"signer","ar":"يوقّع","pos":"verbe","g":"","exFr":"Nous signons le contrat demain.","ipa":"","exAr":"نوقّع العقد غداً."},{"fr":"le casting","ar":"اختبار اختيار الممثلين","pos":"nom","g":"m","exFr":"Le casting a lieu mardi au studio.","ipa":"[lə kas.tɛ̃]","exAr":"اختبار التمثيل يوم الثلاثاء في الاستوديو."},{"fr":"le studio","ar":"الاستوديو","pos":"nom","g":"m","exFr":"Le studio veut une nouvelle star.","ipa":"","exAr":"الاستوديو يريد نجمة جديدة."},{"fr":"une star / une célébrité","ar":"نجم / مشهور","pos":"nom","g":"f","exFr":"La star arrive à midi.","ipa":"","exAr":"النجمة تصل عند الظهر."}],"examples":[{"fr":"Le client veut signer aujourd’hui.","ar":"العميل يريد التوقيع اليوم.","note":"vouloir + infinitif"},{"fr":"Il pourrait accepter le budget.","ar":"قد يقبل الميزانية.","note":"conditionnel"},{"fr":"Ce serait parfait pour le talent.","ar":"سيكون مثالياً للموهبة.","note":"conditionnel"},{"fr":"Je dois convaincre le studio.","ar":"يجب أن أقنع الاستوديو.","note":"devoir + infinitif"},{"fr":"On signe quand ?","ar":"نوقّع متى؟","note":"question directe"},{"fr":"L’affaire est dans le sac !","ar":"الصفقة حسمت!","note":"loc. familière"}],"grammar":[{"tFr":"Conditionnel : pourrait / serait / devrait","tAr":"la conditionnelle في العمل","body":["« Il pourrait accepter » = قد يقبل، « Ce serait parfait » = سيكون مثالياً، « Il devrait appeler » = يجب أن يتصل (توصية).","la conditionnelle تُستخدم للتخمين المهذّب — لا تقول مباشرة « Il acceptera » في عمل؛ قل « Il pourrait accepter »."],"ex":[{"fr":"Le client pourrait signer demain.","ar":"قد يوقّع العميل غداً."},{"fr":"Ce serait une bonne affaire.","ar":"ستكون صفقة جيدة."}]},{"tFr":"Devoir / vouloir au travail","tAr":"devoir و vouloir في العمل","body":["« Je dois appeler » = يجب أن أتصل، « Je veux signer » = أريد أن أوقّع. la différence entre nécessité et désir.","« On doit » بدل « Nous devons » في la langue familière — لاحظ الفرق في النبرة."],"ex":[{"fr":"Je dois préparer le contrat.","ar":"يجب أن أُعدّ العقد."},{"fr":"Nous voulons convaincre le client.","ar":"نريد أن نقنع العميل."}]}],"mistakes":[{"wrong":"« Il acceptera le budget. » (قاطع)","right":"« Il pourrait accepter le budget. »","why":"conditionnelle للتخمين المهذّب في العمل."},{"wrong":"« Je veux que tu signes » في عمل رسمي","right":"« Pourrais-tu signer ? »","why":"la politesse تُفضَّل على la commande directe."},{"wrong":"« C’est une bonne affaire ! » (بلا s)","right":"« C’est une bonne affaire. »","why":"affaire مفرد — la marque feminine."},{"wrong":"الخلط بين refuser و se refuser","right":"« refuser quelque chose »","why":"refuser يتطلب مفعولاً مباشراً."}],"dialogues":[{"title":"الصفقة","ctx":"وكيل مع عميل","lines":[{"who":"Agent","fr":"Le client veut signer aujourd’hui.","ar":"العميل يريد التوقيع اليوم."},{"who":"Client","fr":"Il pourrait accepter le budget ?","ar":"هل قد يقبل الميزانية؟"},{"who":"Agent","fr":"Ce serait parfait pour le talent.","ar":"سيكون مثالياً للموهبة."},{"who":"Client","fr":"On signe quand ?","ar":"نوقّع متى؟"}]},{"title":"الرفض المهذّب","ctx":"ممثل يرفض عرضاً","lines":[{"who":"Star","fr":"Je veux convaincre le studio.","ar":"أريد أن أقنع الاستوديو."},{"who":"Agent","fr":"Il faut négocier le budget.","ar":"يجب أن نتفاوض على الميزانية."},{"who":"Star","fr":"Je dois y réfléchir.","ar":"يجب أن أفكر في الأمر."},{"who":"Agent","fr":"D’accord, mais ne refuse pas tout de suite.","ar":"موافق، لكن لا ترفض فوراً."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما معنى « le contrat »؟","opts":["العقد","الميزانية","الوكالة","الموهبة"],"a":0,"why":"contrat = العقد."},{"t":"fill","skill":"grammar","q":"أكمل: «Il ___ accepter le budget.» (قد يقبل)","fr":"Il ___ accepter le budget.","ans":"pourrait","why":"conditionnel: pourrait."},{"t":"mcq","skill":"grammar","q":"الصيغة المهذّبة للعرض:","opts":["Ce serait parfait.","C’est parfait.","Ce sera parfait.","Tu es parfait."],"a":0,"why":"conditionnelle للتخمين."},{"t":"order","skill":"writing","q":"رتّب: يجب أن أقنع الاستوديو","words":["Je","dois","convaincre","le","studio."],"ans":"Je dois convaincre le studio.","why":"devoir + infinitif."},{"t":"listen","skill":"listening","q":"ما السؤال عن التوقيع؟","opts":["On signe quand ?","Où est le bureau ?","C’est combien ?","Qui est le talent ?"],"a":0,"why":"signer = يوقّع."},{"t":"translate","skill":"writing","q":"ترجم: قد يوقّع العميل غداً.","ans":"Le client pourrait signer demain.","why":"conditionnel + signer."},{"t":"speaking","skill":"speaking","q":"صف وظيفة أو صفقة عمل في 30 ثانية: le client, le contrat, le budget.","target":"Le client veut… / Il pourrait… / Ce serait…","why":"نمط العمل."},{"t":"correct","skill":"grammar","q":"صحّح: «Il acceptera le budget.» (في سياق مهني مهذّب)","ans":"Il pourrait accepter le budget.","why":"conditionnelle للتخمين المهذّب."}],"homework":"شاهد الإعلان مرتين، ثم اكتب مشهداً من ست جمل: وكيل يعرض خدمة على عميل — مع جملة conditionnelle واحدة على الأقل.","sources":[{"title":"Dix pour cent : Le film | Bande-annonce officielle VF | Netflix France","channel":"Netflix France","videoId":"afCKKmg_BaQ","why":"الإعلان الرسمي لفيلم Dix pour cent — لغة العمل في باريس: le talent, le client, la négociation.","cat":"Films","level":"B1","main":true},{"title":"DIX POUR CENT, LE FILM | Extrait Exclusif | Netflix France","channel":"Netflix France","videoId":"ScJTAydfFV0","why":"مقطع حصري من الفيلم — استمع للحوار المهني الكامل.","cat":"Films","level":"B1","extra":true},{"title":"Dix pour cent :: Bande-annonce Saison 1 :: On Regarde ?","channel":"On Regarde ?","videoId":"-rh7aNqvMLQ","why":"إعلان الموسم الأول — قارن لغة المسلسل بلغة الفيلم.","cat":"Films","level":"B1","extra":true}],"supplements":[{"id":"ScJTAydfFV0","title":"DIX POUR CENT, LE FILM | Extrait Exclusif | Netflix France","channel":"Netflix France","why":"مقطع حصري من الفيلم — استمع للحوار المهني الكامل.","lang":"fr","dur":3},{"id":"-rh7aNqvMLQ","title":"Dix pour cent :: Bande-annonce Saison 1 :: On Regarde ?","channel":"On Regarde ?","why":"إعلان الموسم الأول — قارن لغة المسلسل بلغة الفيلم.","lang":"fr","dur":2}]},{"id":"b1-t9-l5","fr":"Lupin — la série (2021)","ar":"مسلسل: لوبلان — السيد اللص (2021)","objectives":["فهم فرنسي الشارع الباريسي: le voleur, la vengeance, l’arnaque, le masque","استعمال la forme interrogative بـ inversion في الحوار السريع","تحليل كيف يبني Lupin هويته عبر la langue et le geste","تمييز le récit rapide (série) عن le récit lent (film classique)"],"sections":[{"h":"المسلسل: Lupin — الانتقام والذكاء (الإعلان)","video":{"id":"gCmuYqeeNpc","title":"Lupin | Bande-annonce officielle I Netflix France","channel":"Netflix France","why":"الإعلان الرسمي لمسلسل Lupin — فرنسي معاصر بلهجة باريسية سريعة: le masque, la vengeance, l’arnaque.","lang":"fr","main":true,"dur":2},"p":["Lupin هو مسلسل نتفليكس الفرنسي الأكثر مشاهدة عالمياً: Assane Diop، ابن عامل مغربي، يعيد اختراع نفسه كـ « gentleman thief » مستوحى من Arsène Lupin. الفرنسية هنا سريعة، يومية، ومشحونة بالتوتر — لا لغة أدبية بل لغة الشارع والخداع.","المفردات الأساسية: le voleur, le masque, la vengeance, l’arnaque, le musée, le collier, le père, la justice. هذه المفردات تفتح عليك عالم الجريمة والغموض في السينما الفرنسية.","نحوياً، تبرز la forme interrogative بـ inversion: « Où est le collier ? », « Qui est le vrai coupable ? ». inversion أكثر حدة من est-ce que في الحوار السريع.","الإعلان يعرض la double vie: عائلة + جريمة + عدالة. لاحظ كيف تتغيّر la langue مع كل persona: مع ابنه هادئة، مع الأعداء حادة، مع الشرطة مراوغة.","بعد الإعلان، اكتب فقرة من خمس جمل عن شخص يعيش حياة مزدوجة: بالنهار… بالليل… والسر الذي يخفيه.","Lupin يكشف la France urbaine: le masque + la vengeance + l’identité. la interrogation inversion تفتح عليك la langue du thriller."],"sub":[{"h":"جمل الجريمة والغموض","p":["Où est le collier volé ?","Je ne suis pas le voleur que vous cherchez.","La vengeance ne paie pas.","Le masque cache le vrai visage."]},{"h":"أدوات نطقية: النبرة الحادة","p":["« le masque » [lə mask] — s واضحة.","« la vengeance » [la vɑ̃.ʒɑ̃s] — nasale أنفية.","« l’arnaque » [laʁ.nak] — q صامتة."]},{"h":"خطوات Listen & Repeat","p":["المرة الأولى: اكتب كل اسم شخص أو مكان.","الثانية: كرّر سؤال inversion بنبرة حادة.","الثالثة: أعد بناء الجملة بترتيب est-ce que."]}]},{"h":"عبارات الغموض والخداع","p":["« Tu ne sais pas qui je suis. » = لا تعرف من أنا — la menace calme.","« Où est le collier ? » — inversion مباشرة: أداة + فاعل.","« Ce n’est pas ce que tu crois. » — la classic twist.","« Je ferai justice moi-même. » — futur simple + la détermination."]},{"h":"التطبيق والتلخيص","p":["تمرين التوتر: اكتب حواراً من ست جمل بين محقق ولص — أسئلة inversion + إجابات مراوغة.","تحليل الشخصية: صف Lupin في ثلاث جمل: الظاهر، الداخلي، والهدف.","سجّل نفسك تشرح فكرة الانتقام في 30 ثانية بالفرنسية — بنبرة هادئة حادة."]},{"h":"التطبيق والتلخيص","p":["خلاصة: فهمتَ فرنسي الشارع الباريسي في Lupin: la vengeance, l’arnaque, le masque، وطرحتَ أسئلة بـinversion (Où est… ? / Qui est… ?) مع بنية التوتر: تهديد هادئ ← توجيه ← انقلاب. «أعد مشاهدة الفيديو الرئيسي وركّز على نبرة التهديد الهادئة في «Tu ne sais pas qui je suis» وعلى وضوح صيغة السؤال بـinversion في الحوارات السريعة»","جسر الدروس: من b1-t9-l4 (التفاوض المهني بالشرطية) إلى b1-t9-l5 (Lupin والغموض والسؤال بـinversion)، ثم إلى b1-t9-l6 حيث ينتهي المشهد السينمائي بفيلم Ch’tis: اللكنات، الثقافة، وكسر الصور النمطية.","مهمة تطبيقية: سجّل حواراً من دقيقة واحدة بين محقق ولص يبدأ بسؤالinversion وينتهِ بانقلاب، مستعملاً ثلاث كلمات جديدة من هذا الدرس (le masque, la vengeance, l’arnaque)؛ ثم قارن إيقاع نبرتك بإيقاع حوار الفيديو."]}],"pron":[{"w":"le voleur","ipa":"[lə vɔ.lœʁ]","approx":"لو فولور"},{"w":"la vengeance","ipa":"[la vɑ̃.ʒɑ̃s]","approx":"لا فانجانس"},{"w":"le masque","ipa":"[lə mask]","approx":"لو ماسك"}],"vocab":[{"fr":"le voleur","ar":"اللص/السارق","pos":"nom","g":"m","exFr":"Le voleur s’est échappé.","ipa":"","exAr":"اللص هرب."},{"fr":"le masque","ar":"القناع","pos":"nom","g":"m","exFr":"Il porte un masque noir.","ipa":"","exAr":"يرتدي قناعاً أسود."},{"fr":"la vengeance","ar":"الانتقام","pos":"nom","g":"f","exFr":"La vengeance est un plat froid.","ipa":"","exAr":"الانتقام طبق بارد."},{"fr":"l’arnaque","ar":"الاحتيال","pos":"nom","g":"f","exFr":"C’est une arnaque organisée.","ipa":"","exAr":"إنها عملية احتيال منظّمة."},{"fr":"le musée","ar":"المتحف","pos":"nom","g":"m","exFr":"Le vol a eu lieu au musée.","ipa":"","exAr":"السرقة وقعت في المتحف."},{"fr":"le collier","ar":"القلادة","pos":"nom","g":"m","exFr":"Le collier est en or.","ipa":"","exAr":"القلادة من الذهب."},{"fr":"la justice","ar":"العدالة","pos":"nom","g":"f","exFr":"Il veut rendre justice.","ipa":"","exAr":"يريد أن ينصف."},{"fr":"le père","ar":"الأب","pos":"nom","g":"m","exFr":"Son père était innocent.","ipa":"","exAr":"أبوه كان بريئاً."},{"fr":"le vrai / le faux","ar":"الحقيقي / الزائف","pos":"nom","g":"m","exFr":"Le vrai coupable est ailleurs.","ipa":"","exAr":"المذنب الحقيقي في مكان آخر."},{"fr":"s’échapper","ar":"يهرب","pos":"verbe pronominal","g":"","exFr":"Il s’échappe par le toit.","ipa":"","exAr":"يهرب عبر السطح."},{"fr":"voler","ar":"يسرق / يحلّق","pos":"verbe","g":"","exFr":"Il a volé le collier.","ipa":"","exAr":"سرق القلادة."},{"fr":"le coupable","ar":"المذنب","pos":"nom","g":"m","exFr":"Qui est le coupable ?","ipa":"","exAr":"من المذنب؟"}],"examples":[{"fr":"Où est le collier volé ?","ar":"أين القلادة المسروقة؟","note":"inversion"},{"fr":"Je ne suis pas le voleur que vous cherchez.","ar":"لست اللص الذي تبحثون عنه.","note":"pronom relatif"},{"fr":"La vengeance ne paie pas.","ar":"الانتقام لا يجدي.","note":"proverbe"},{"fr":"Le masque cache le vrai visage.","ar":"القناع يخفي الوجه الحقيقي.","note":"la métaphore"},{"fr":"Je ferai justice moi-même.","ar":"سأنصف نفسي بنفسي.","note":"futur simple"},{"fr":"Tu ne sais pas qui je suis.","ar":"لا تعرف من أنا.","note":"la menace calme"}],"grammar":[{"tFr":"Interrogation par inversion","tAr":"la interrogation بـ inversion","body":["« Où est le collier ? » — أداة + فاعل + فعل. inversion أكثر حدة من « Où est-ce que le collier est ? ».","مع le pronom: « Qui est-ce ? » vs « Qui est ? ». في الحوار السريع يُفضَّل inversion القصير."],"ex":[{"fr":"Où est le masque ?","ar":"أين القناع؟"},{"fr":"Qui est le vrai coupable ?","ar":"من المذنب الحقيقي؟"}]},{"tFr":"Futur simple pour la détermination","tAr":"futur simple للعزيمة","body":["« Je ferai justice » — futur simple يمنح نبرة حتمية. « Je vais faire » أكثر حوارية لكن أقل حدة.","في مشاهد الانتقام يُفضَّل futur simple لأنه يحمل la weight du destin."],"ex":[{"fr":"Je retrouverai la vérité.","ar":"سأجد الحقيقة."},{"fr":"Tu paieras pour cela.","ar":"ستدفع ثمن هذا."}]}],"mistakes":[{"wrong":"« Où le collier est ? »","right":"« Où est le collier ? »","why":"inversion: أداة + فعل + فاعل."},{"wrong":"« Je vais faire justice » (في لحظة حاسمة)","right":"« Je ferai justice »","why":"futur simple للعزيمة الحادة."},{"wrong":"la vengeance = la revanche","right":"la vengeance = الانتقام، la revanche = الثأر/الإعادة","why":"لا تخلط بينهما في السياق."},{"wrong":"voler = سرقة فقط","right":"voler = يسرق / يحلّق حسب السياق","why":"la double signification."}],"dialogues":[{"title":"التحقيق","ctx":"محقق مع Lupin","lines":[{"who":"Inspecteur","fr":"Où étais-tu la nuit du vol ?","ar":"أين كنت ليلة السرقة؟"},{"who":"Lupin","fr":"Je ne suis pas le voleur que vous cherchez.","ar":"لست اللص الذي تبحثون عنه."},{"who":"Inspecteur","fr":"Qui est le vrai coupable, alors ?","ar":"من المذنب الحقيقي إذن؟"},{"who":"Lupin","fr":"Vous le saurez bientôt.","ar":"ستعرف قريباً."}]},{"title":"الهدف","ctx":"Lupin مع صديقه","lines":[{"who":"Lupin","fr":"Je ferai justice moi-même.","ar":"سأنصف نفسي بنفسي."},{"who":"Ami","fr":"La vengeance ne paie pas.","ar":"الانتقام لا يجدي."},{"who":"Lupin","fr":"Ce n’est pas la vengeance, c’est la vérité.","ar":"ليس انتقاماً، بل حقيقة."},{"who":"Ami","fr":"Tu joues avec le feu.","ar":"تلعب بالنار."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما معنى « le masque »؟","opts":["القناع","القلادة","السرقة","التحقيق"],"a":0,"why":"masque = القناع."},{"t":"fill","skill":"grammar","q":"أكمل بنمط inversion: «Où ___ le collier ?»","fr":"Où ___ le collier ?","ans":"est","why":"inversion: أداة + فعل + فاعل."},{"t":"mcq","skill":"grammar","q":"السؤال الصحيح:","opts":["Qui est le coupable ?","Qui le coupable est ?","Le coupable est qui ?","Qui est-ce le coupable ?"],"a":0,"why":"inversion مباشرة."},{"t":"order","skill":"writing","q":"رتّب: سأنصف نفسي بنفسي","words":["Je","ferai","justice","moi-même."],"ans":"Je ferai justice moi-même.","why":"futur simple + la détermination."},{"t":"listen","skill":"listening","q":"ما التعبير الحاد للتهديد؟","opts":["Tu ne sais pas qui je suis.","Bonjour.","Merci beaucoup.","À bientôt."],"a":0,"why":"la menace calme."},{"t":"translate","skill":"writing","q":"ترجم: القناع يخفي الوجه الحقيقي.","ans":"Le masque cache le vrai visage.","why":"masque + visage."},{"t":"speaking","skill":"speaking","q":"اكتب وسجّل حواراً قصيراً: محقق يسأل ولص يراوغ — أسئلة inversion.","target":"Où… ? / Qui… ? / Je ne suis pas…","why":"نمط التحقيق."},{"t":"correct","skill":"grammar","q":"صحّح: «Où le collier est ?»","ans":"Où est le collier ?","why":"inversion: أداة + فعل + فاعل."}],"homework":"شاهد الإعلان مرتين، ثم اكتب فقرة من خمس جمل عن شخص يعيش حياة مزدوجة: بالنهار… بالليل… والسر الذي يخفيه — مع سؤالين inversion.","sources":[{"title":"Lupin | Bande-annonce officielle I Netflix France","channel":"Netflix France","videoId":"gCmuYqeeNpc","why":"الإعلان الرسمي لمسلسل Lupin — فرنسي معاصر بلهجة باريسية سريعة: le masque, la vengeance, l’arnaque.","cat":"Films","level":"B1","main":true},{"title":"Lupin | Récap VF | Netflix","channel":"Netflix France","videoId":"VOaLuGsilvo","why":"ملخص الأحداث بالفرنسية — مراجعة سريعة للقصة والمفردات.","cat":"Films","level":"B1","extra":true},{"title":"Lupin: Partie 1 à 3 | Récap VF | Netflix France","channel":"Netflix France","videoId":"NutXlg5S3Bw","why":"ملخص الأجزاء 1-3 — تتبع التسلسل الدرامي بلغة سريعة.","cat":"Films","level":"B1","extra":true}],"supplements":[{"id":"VOaLuGsilvo","title":"Lupin | Récap VF | Netflix","channel":"Netflix France","why":"ملخص الأحداث بالفرنسية — مراجعة سريعة للقصة والمفردات.","lang":"fr","dur":3},{"id":"NutXlg5S3Bw","title":"Lupin: Partie 1 à 3 | Récap VF | Netflix France","channel":"Netflix France","why":"ملخص الأجزاء 1-3 — تتبع التسلسل الدرامي بلغة سريعة.","lang":"fr","dur":5}]},{"id":"b1-t9-l6","fr":"Bienvenue chez les Ch’tis (2008)","ar":"فيلم: أهلاً بك في شمال فرنسا (2008)","objectives":["فهم مفردات اللكنات والثقافة الفرنسية: l’accent, la région, l’accueil","تحليل كيف تُستخدم la caricature linguistique لكسر stereotypes","استعمال التعابير الشمالية: ch’ti, l’allaite, les moules-frites","ربط اللكنة بالهوية: لماذا لا يُفضَّل « فرنسي محايد » دائماً؟"],"sections":[{"h":"الفيلم 4: Bienvenue chez les Ch’tis — اللكنات والثقافة (الإعلان)","video":{"id":"OycTfchnopU","title":"😂 BIENVENUE CHEZ LES CH’TIS - Bande Annonce VF (2008)","channel":"Gaumont","why":"الإعلان الرسمي لفيلم Bienvenue chez les Ch’tis — كيف تكسر la langue الحواجز بين اللكنات والثقافات الفرنسية.","lang":"fr","main":true,"dur":2},"p":["Bienvenue chez les Ch’tis فيلم كوميدي فرنسي نجح عالمياً: موظف بريد في الجنوب يُرسَل إلى الشمال ويكتشف شعباً لا يفهم لغته. الفيلم يجمع la caricature مع la tendresse — اللكنة ليست عيباً بل هوية.","المفردات الأساسية: l’accent, la région, l’accueil, le Nord, le Midi, les brindilles, ch’ti. هذه المفردات تفتح عليك خريطة فرنسا اللغوية.","نحوياً، تبرز la comparaison et le superlatif: « Le Nord est aussi froid que sa réputation », « C’est le plus accueillant des régions ». la langue تُستخدم لكسر la peur.","الإعلان يعرض la bande-son: أغانٍ شمالية + لهجات + ملل. لاحظ كيف يتحوّل الخوف من « l’autre » إلى la curiosité عبر la musique et le rire.","بعد الإعلان، اكتب فقرة من خمس جمل عن ثقافة تختلف عن ثقافتك: ماذا تخاف، ماذا تكتشف، وكيف تكسر la barrière linguistic.","Bienvenue chez les Ch’tis تكسر la barrière: l’accent + l’accueil + la comparaison — la leçon أن la diversité linguistic هي la richesse لا la menace."],"sub":[{"h":"جمل اللكنة والثقافة","p":["Ils parlent ch’ti, c’est une autre langue !","Le Nord est froid, mais les gens sont chauds.","Les moules-frites, c’est la spécialité.","L’accueil est plus important que l’accent."]},{"h":"أدوات نطقية: اللكنات","p":["« ch’ti » [ʃti] — la contraction du nord.","« l’accent » [lak.sɑ̃] — nasal أنفية.","« moules-frites » [mul fʁit] — t صامتة في frites."]},{"h":"خطوات Listen & Repeat","p":["المرة الأولى: اكتب كل كلمة شمالية سمعتها.","الثانية: كرّرها بنبرة تعابيرية.","الثالثة: قارنها بالفصحى: accent vs standard."]}]},{"h":"عبارات الاكتشاف والكسر","p":["« Ils parlent ch’ti ! » = يتكلمون الشتي! — la surprise du Sud.","« Le Nord est aussi froid que sa réputation. » — la comparaison.","« Les gens sont plus accueillants que je ne le pensais. » — la découverte.","« L’accent n’est pas un défaut. » — la leçon du film."]},{"h":"التطبيق والتلخيص","p":["تمرين اللكنة: اختر لهجة أو ثقافة وصفها في ثلاث جمل: ما تفهمه، ما يربكك، وما تحبه.","كتابة: رسالة قصيرة تشرح فيها لصديق من منطقة أخرى لماذا اللكنة ليست عيباً.","سجّل نفسك تصف المنطقة التي تعيش فيها: le climat, les gens, la spécialité — بالفرنسية."]},{"h":"التطبيق والتلخيص","p":["خلاصة: كسرتَ الصور النمطية عن الشمال مع Bienvenue chez les Ch’tis: l’accent, l’accueil, les stéréotypes، وتمارنتَ على المقارنة aussi/plus…que وتعابير الاكتشاف (plus accueillants que je ne le pensais). «أعد مشاهدة الفيديو الرئيسي وركّز على تحوّل النبرة من الخوف الأول إلى الترحيب، وعلى كلمات اللكنة الشمالية ch’ti»","جسر الدروس: من b1-t9-l5 (Lupin والخداع والسؤال بـinversion) إلى b1-t9-l6 (اللكنات والثقافة وكسر الصور النمطية) — اكتملت رحلة B1 كاملة (39 درساً: القراءة والقصص والقواعد والمحادثة والاستماع والكتابة والممارسة المهنية + Extra + السينما) — راجع B1-t1-l1 ثم انتقل إلى المستوى المتقدم B2 (b2-t1-l1).","مهمة تطبيقية: سجّل فقرة من دقيقة واحدة عن منطقة تختلف عن ثقافتك (ما تخافه، ما تكتشفه، ما تحبه)، مستعملاً ثلاث كلمات جديدة من هذا الدرس (l’accent, l’accueil, les stéréotypes)؛ ثم قارن نبرتك بمشهد الترحيب في الفيديو واكتب جملة تكسر فيها صورة نمطية واحدة."]}],"pron":[{"w":"l’accent","ipa":"[la k.sɑ̃]","approx":"لاكسان"},{"w":"la région","ipa":"[la ʁe.ʒjɔ̃]","approx":"لا ريجيون"},{"w":"ch’ti","ipa":"[ʃti]","approx":"شتي"}],"vocab":[{"fr":"l’accent","ar":"اللكنة","pos":"nom","g":"m","exFr":"Il a un accent du Sud.","ipa":"","exAr":"لديه لكنة الجنوب."},{"fr":"la région","ar":"المنطقة/الإقليم","pos":"nom","g":"f","exFr":"Le Nord est une belle région.","ipa":"","exAr":"الشمال منطقة جميلة."},{"fr":"l’accueil","ar":"الاستقبال","pos":"nom","g":"m","exFr":"L’accueil est chaleureux.","ipa":"","exAr":"الاستقبال دافئ."},{"fr":"le Nord / le Midi","ar":"الشمال / الجنوب","pos":"nom","g":"m","exFr":"Le Nord est froid, le Midi est chaud.","ipa":"","exAr":"الشمال بارد، الجنوب دافئ."},{"fr":"ch’ti","ar":"لهجة الشمال الفرنسية","pos":"nom","g":"m","exFr":"Ils parlent ch’ti dans le Nord.","ipa":"","exAr":"يتحدثون الشتي في الشمال."},{"fr":"les brindilles","ar":"الأغصان الصغيرة","pos":"nom","g":"f pl","exFr":"Il pleut des brindilles.","ipa":"","exAr":"تمطر رذاذاً."},{"fr":"les moules-frites","ar":"المحار والبطاطس","pos":"nom","g":"m pl","exFr":"On mange des moules-frites le dimanche.","ipa":"","exAr":"نأكل المحار والبطاطس يوم الأحد."},{"fr":"la choucroute","ar":"الكرنب المخمّر (طبخ الشمال)","pos":"nom","g":"f","exFr":"Au Nord, on mange souvent de la choucroute.","ipa":"[la ʃukʁut]","exAr":"في الشمال يُؤكل الكرنب المخمّر غالباً."},{"fr":"le peuple","ar":"الشعب","pos":"nom","g":"m","exFr":"Le peuple du Nord est travailleur.","ipa":"","exAr":"شعب الشمال مجتهد."},{"fr":"la peur / le courage","ar":"الخوف / الشجاعة","pos":"nom","g":"f/m","exFr":"Il a vaincu sa peur.","ipa":"","exAr":"تغلب على خوفه."},{"fr":"la barrière","ar":"الحاجز","pos":"nom","g":"f","exFr":"La barrière linguistique est forte.","ipa":"","exAr":"الحاجز اللغوي قوي."},{"fr":"les stéréotypes","ar":"الصور النمطية","pos":"nom","g":"m pl","exFr":"Il faut casser les stéréotypes.","ipa":"","exAr":"يجب كسر الصور النمطية."}],"examples":[{"fr":"Ils parlent ch’ti, c’est une autre langue !","ar":"يتحدثون الشتي، إنها لغة أخرى!","note":"la surprise"},{"fr":"Le Nord est aussi froid que sa réputation.","ar":"الشمال بارد كما شعيرته.","note":"la comparaison"},{"fr":"Les gens sont plus accueillants que je ne le pensais.","ar":"الناس أكثر ترحيباً مما ظننت.","note":"la comparaison + ne"},{"fr":"L’accent n’est pas un défaut.","ar":"اللكنة ليست عيباً.","note":"la leçon"},{"fr":"Les moules-frites, c’est la spécialité.","ar":"المحار والبطاطس هو الطبق المميز.","note":"la gastronomie"},{"fr":"Il faut casser les stéréotypes.","ar":"يجب كسر الصور النمطية.","note":"il faut + infinitif"}],"grammar":[{"tFr":"Comparaison : aussi… que / plus… que","tAr":"المقارنة: aussi… que / plus… que","body":["« Le Nord est aussi froid que sa réputation » — aussi + adj + que للمساواة.","« Plus accueillants que je ne le pensais » — plus + adj + que مع la particule ne (أدبية قليلاً لكن في السينما شائعة)."],"ex":[{"fr":"Le Midi est aussi chaud que le Sahara.","ar":"الجنوب حار كما الصحراء."},{"fr":"C’est plus facile que je ne le pensais.","ar":"إنها أسهل مما ظننت."}]},{"tFr":"il faut casser / il est important de","tAr":"il faut casser / il est important de","body":["« Il faut casser les stéréotypes » — il faut + infinitif la nécessité.","« Il est important de comprendre » — la forme plus formelle pour le discours."],"ex":[{"fr":"Il faut casser la barrière.","ar":"يجب كسر الحاجز."},{"fr":"Il est important d’accueillir les autres.","ar":"من المهم استقبال الآخرين."}]}],"mistakes":[{"wrong":"« Le Nord est froid, je ne vais pas. » (تجنّب مسبق)","right":"« Le Nord est froid, mais je vais découvrir. »","why":"الخوف يُستبدل بالفضول في الفيلم."},{"wrong":"« L’accent est mauvais. »","right":"« L’accent est une identité. »","why":"اللكنة ليست عيباً."},{"wrong":"« Les brindilles » كالأمطار الغزيرة","right":"« Il pleut des brindilles » = تمطر رذاذاً","why":"la nuance: brindilles = رذاذ خفيف."},{"wrong":"la région = le pays","right":"la région = إقليم، le pays = دولة","why":"la différence administrative."}],"dialogues":[{"title":"الصدمة الأولى","ctx":"موظف من الجنوب يصل إلى الشمال","lines":[{"who":"Antoine","fr":"Ils parlent ch’ti ? Je ne comprends rien !","ar":"يتحدثون الشتي؟ لا أفهم شيئاً!"},{"who":"Julien","fr":"Le Nord est aussi froid que sa réputation.","ar":"الشمال بارد كما شعيرته."},{"who":"Antoine","fr":"Et les gens ? Sont-ils accueillants ?","ar":"والناس؟ هل يستقبلون بحرارة؟"},{"who":"Julien","fr":"Plus accueillants que tu ne le penses.","ar":"أكثر ترحيباً مما تظن."}]},{"title":"الاكتشاف","ctx":" Antoine يغيّر رأيه","lines":[{"who":"Antoine","fr":"L’accent n’est pas un défaut.","ar":"اللكنة ليست عيباً."},{"who":"Julien","fr":"Voilà ! Les moules-frites, tu as goûté ?","ar":"هكذا! المحار والبطاطس، جربتها؟"},{"who":"Antoine","fr":"C’est délicieux, la spécialité du Nord.","ar":"إنها لذيذة، طبق الشمال المميز."},{"who":"Julien","fr":"Tu es presque ch’ti maintenant.","ar":"أنت شتي تقريباً الآن."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما معنى « l’accent » في سياق اللكنة؟","opts":["اللكنة","الصوت","النغمة","الكتابة"],"a":0,"why":"accent = اللكنة الإقليمية."},{"t":"fill","skill":"grammar","q":"أكمل بنمط المقارنة: «Le Nord est ___ froid que sa réputation.»","fr":"Le Nord est ___ froid que sa réputation.","ans":"aussi","why":"aussi + adj + que."},{"t":"mcq","skill":"grammar","q":"أي جملة تحترم قاعدة «il faut + infinitif»؟","opts":["Il faut casser les stéréotypes.","Il faut que casser les stéréotypes.","Il faut cassent les stéréotypes.","Il faut casser le stéréotype."],"a":0,"why":"il faut + infinitif."},{"t":"order","skill":"writing","q":"رتّب: الناس أكثر ترحيباً مما ظننت","words":["Les","gens","sont","plus","accueillants","que","je","ne","le","pensais."],"ans":"Les gens sont plus accueillants que je ne le pensais.","why":"la comparaison + ne."},{"t":"listen","skill":"listening","q":"ما الطبق الشمالي المذكور في الفيلم؟","opts":["Les moules-frites","La pizza","Le sushi","Le tajine"],"a":0,"why":"moules-frites = المحار والبطاطس."},{"t":"translate","skill":"writing","q":"ترجم: اللكنة ليست عيباً.","ans":"L’accent n’est pas un défaut.","why":"n’est pas + nom."},{"t":"speaking","skill":"speaking","q":"صف ثقافة أو منطقة تختلف عن ثقافتك في ثلاث جمل: ماذا تخاف، ماذا تكتشف، ماذا تحب.","target":"C’est… que… / Je pense que… / En fait…","why":"كسر الصور النمطية."},{"t":"correct","skill":"grammar","q":"صحّح: «Le Nord est plus froid que le Midi est.»","ans":"Le Nord est plus froid que le Midi.","why":"la comparaison بلا تكرار الفعل."}],"homework":"شاهد الإعلان مرتين، ثم اكتب فقرة من خمس جمل عن منطقة أو ثقافة تختلف عن ثقافتك: ماذا تخاف، ماذا تكتشف، وكيف تكسر الحاجز اللغوي — مع جملة comparaison.","sources":[{"title":"😂 BIENVENUE CHEZ LES CH’TIS - Bande Annonce VF (2008)","channel":"Gaumont","videoId":"OycTfchnopU","why":"الإعلان الرسمي لفيلم Bienvenue chez les Ch’tis — كيف تكسر la langue الحواجز بين اللكنات والثقافات الفرنسية.","cat":"Films","level":"B1","main":true},{"title":"Bienvenue chez les Ch’tis (2008) - Trailer with French subtitles","channel":"Gaumont","videoId":"JYayQf03_wE","why":"الإعلان بترجمة فرنسية — أعد الاستماع لتثبيت التعابير الشمالية.","cat":"Films","level":"B1","extra":true},{"title":"BIENVENUE CHEZ LES CH’TIS sur TF1 Bande Annonce VF (Comédie, 2008)","channel":"TF1","videoId":"47Vq6cqEr3o","why":"إعلان آخر بنفس الفيلم — قارن الفروق في la bande-son.","cat":"Films","level":"B1","extra":true}],"supplements":[{"id":"JYayQf03_wE","title":"Bienvenue chez les Ch’tis (2008) - Trailer with French subtitles","channel":"Gaumont","why":"الإعلان بترجمة فرنسية — أعد الاستماع لتثبيت التعابير الشمالية.","lang":"fr","dur":2},{"id":"47Vq6cqEr3o","title":"BIENVENUE CHEZ LES CH’TIS sur TF1 Bande Annonce VF (Comédie, 2008)","channel":"TF1","why":"إعلان آخر بنفس الفيلم — قارن الفروق في la bande-son.","lang":"fr","dur":2}]}]}]},{"code":"B2","ar":"المتوسط المتقدم","fr":"Intermédiaire avancé","desc":"الفرنسية الطبيعية: النقاش، المقالات، الأكاديمية والمهنية، والفروق الدقيقة.","color":"#ca8a04","order":5,"tracks":[{"id":"b2-t1","slug":"le-francais-naturel","icon":"book","color":"#ca8a04","fr":"Le français naturel","ar":"الفرنسية الطبيعية","desc":"كلام الفرنسيين الحقيقي: الاختصارات، العامية المقبولة، والتعبيرات الشائعة — من elisions إلى argot.","lessons":[{"id":"b2-t1-l1","fr":"Parler comme les Français","ar":"التحدث مثل الفرنسيين","objectives":["التعرّف على la langue المنطوقة الحقيقية la vie quotidienne","تمييز la langue naturelle عن la langue écrite la niveau B2","استخدام 17 تعبيراً idiomatique la conversation اليومية","تطوير la compréhension la parole الطبيعية السريعة"],"sections":[{"h":"الدرس 1: كيف يتحدث الفرنسيون فعلاً في الحياة اليومية","video":{"id":"F8tQPh-MpkE","title":"Les 17 Expressions Idiomatiques les plus utilisées par les français","channel":"Français avec Nelly","why":"شرح 17 تعبيراً idiomatique يستخدمها الفرنسيون يومياً — la porte d’entrée la langue naturelle المنطوقة.","lang":"fr","main":true,"dur":12},"p":["la langue الفرنسية la parler تختلف كثيراً la langue la forme écrite: الفرنسيون يحذفون la négation، يختصرون la première personne، ويستبدلون la norme بـ la forme naturelle la conversation.","la première عبارة: « Y a pas de quoi » بدل « Il n’y a pas de quoi » — la réduction la plus courante la politesse. la négation تصبح « pas » فقط la parole.","la deuxième عبارة: « Tu m’fais chier » — la familier la plus قوية la colère، لا تُستخدم la context professionnel. la distinction la niveaux: courant، familier، soutenu.","la troisième عبارة: « Ça me saoule » تعني « تعبت من هذا » — la familier la répétition. la même idea تُعبَّر la plusieurs façons la langue naturelle.","la leçon la plus مهمة: la compréhension la parole الطبيعية la priorité la niveau B2. أنت لا تحتاج أن تتكلم مثل native — تحتاج أن تفهمهم la vitesse réelle.","بعد الدرس: استمع لمحادثة franaçaise طبيعية la vitesse كاملة، حاول la reconnaissance les expressions، ثم كرّرها la context جديد."],"sub":[{"h":"expressions أساسية la parole","p":["Y a pas de quoi = Il n’y a pas de quoi.","Ça me saoule = تعبت من هذا.","Tu m’fais chier = la colère la familier.","C’est pas la peine = لا داعي."]},{"h":"la famille la expressions","p":["« J’en ai ras le bol » = سئمت تماماً.","« C’est le cas ou pas ? » = la question la naturelle.","« On y va ? » = هل نذهب؟.","« Tu bluffes ! » = la surprise la naturelle."]},{"h":"خطوات la pratique","p":["المرة الأولى: la reconnaissance — ميّز العبارة la vitesse réelle.","الثانية: la répétition — كرّرها la intonation الصحيحة.","الثالثة: la production — استخدمها la dialogue جديد."]}]},{"h":"la carte la langue naturelle","p":["« Y a pas de quoi » = la politesse la plus courante la réponse شكر.","« Ça me saoule » = la familier la répétition la quotidienne.","« J’en ai ras le bol » = la limite la patience تجاوزت.","« C’est pas la peine » = la décision la naturelle la refus."]},{"h":"التطبيق والتلخيص","p":["تمرين la reconnaissance: استمع لخمس expressions la vitesse réelle وأعد بناءها بالكتابة.","تمرين la bascule: حوّل ثلاث جمل formelles إلى la forme naturelle.","سجّل نفسك تتكلم بـ la langue naturelle la intonation الصحيحة — la mémoire la bouche."]},{"h":"التطبيق والتلخيص","p":["في هذا الدرس تعلّمت كيف يتحدث الفرنسيون فعلاً: يحذفون ne، يختصرون الجملة، ويستبدلون la forme écrite بـ la forme naturelle مثل « Y a pas de quoi ». الخلاصة: فهم المنطوق يسبق إنتاجه. أعد مشاهدة الفيديو الرئيسي وركّز على حذف ne والاختصارات في الردود اليومية.","بداية المستوى — لا يسبقه درس؛ تُتقن هنا أولاً كيف يتحدث الفرنسيون فعلاً بالعبارات المنطوقة، ثم تنتقل إلى b2-t1-l2 حيث تتعمّق في اختصارات وإلقاءات الكلام اليومي.","مهمة تطبيقية: سجّل دقيقة صوتية تشرح فيها موقفاً من يومك مستخدماً ثلاث كلمات جديدة من الدرس (Y a pas de quoi، Ça me saoule، On y va)، ثم استمع للتسجيل وقارن نطقك ومفرداتك بما سمعته في الفيديو الرئيسي."]}],"pron":[{"w":"y a pas","ipa":"[ja pa]","approx":"يا با"},{"w":"ça me saoule","ipa":"[sa mə sull]","approx":"سا م سول"},{"w":"ras le bol","ipa":"[ʁɑ lə bɔl]","approx":"را ل بول"}],"vocab":[{"fr":"une expression idiomatique","ar":"تعبير اصطلاحي","pos":"nom","g":"f","exFr":"Cette expression est très idiomatique.","ipa":"","exAr":"هذا التعبير اصطلاحي جداً."},{"fr":"la vie quotidienne","ar":"الحياة اليومية","pos":"nom","g":"f","exFr":"La vie quotidienne est différente.","ipa":"","exAr":"الحياة اليومية مختلفة."},{"fr":"le registre familier","ar":"المسلاة العامية","pos":"nom","g":"m","exFr":"Le registre familier est courant.","ipa":"","exAr":"المسلاة العامية شائعة."},{"fr":"le registre soutenu","ar":"المسلاة المرتفعة","pos":"nom","g":"m","exFr":"Le registre soutenu est formel.","ipa":"","exAr":"المسلاة المرتفعة رسمية."},{"fr":"la politesse","ar":"الأدب / اللياقة","pos":"nom","g":"f","exFr":"La politesse est importante.","ipa":"","exAr":"الأدب مهم."},{"fr":"la répétition","ar":"التكرار","pos":"nom","g":"f","exFr":"La répétition aide la mémoire.","ipa":"","exAr":"التكرار يساعد الذاكرة."},{"fr":"ennuyer","ar":"يضجر","pos":"verbe","g":"","exFr":"Ça m’ennuie beaucoup.","ipa":"","exAr":"هذا يضجرني كثيراً."},{"fr":"se fatiguer","ar":"يتعب","pos":"verbe","g":"","exFr":"Je me fatigue facilement.","ipa":"","exAr":"أتعب بسهولة."},{"fr":"refuser","ar":"يرفض","pos":"verbe","g":"","exFr":"Je refuse poliment.","ipa":"","exAr":"أرفض بأدب."},{"fr":"bluffer","ar":"يُخادع / يتباهى","pos":"verbe","g":"","exFr":"Tu bluffes encore !","ipa":"","exAr":"تُخادع مرة أخرى!"},{"fr":"y aller","ar":"يذهب","pos":"loc.","g":"","exFr":"On y va maintenant ?","ipa":"","exAr":"نذهب الآن؟"},{"fr":"parler naturellement","ar":"يتحدث بشكل طبيعي","pos":"loc.","g":"","exFr":"Il parle très naturellement.","ipa":"","exAr":"يتحدث بشكل طبيعي جداً."}],"examples":[{"fr":"Y a pas de quoi !","ar":"لا شكر على واجب!","note":"la politesse"},{"fr":"Ça me saoule.","ar":"هذا يضجرني.","note":"la familier"},{"fr":"J’en ai ras le bol.","ar":"سئمت تماماً.","note":"la familier"},{"fr":"C’est pas la peine.","ar":"لا داعي.","note":"la décision"},{"fr":"Tu bluffes !","ar":"أنت تُخادع!","note":"la surprise"},{"fr":"On y va ?","ar":"نذهب؟","note":"la naturelle"}],"grammar":[{"tFr":"La chute de la négation à l’oral","tAr":"حذف la négation شفوياً","body":["« Il n’y a pas de quoi » → « Y a pas de quoi » — la réduction la plus courante. « Ce n’est pas la peine » → « C’est pas la peine ».","la négation تبقى la « pas » فقط la parole — la première partie (ne) تُحذف la conversation naturelle."],"ex":[{"fr":"Il n’y a pas de quoi → Y a pas de quoi.","ar":"لا شكر على واجب → يا با دوكوا."},{"fr":"Ce n’est pas la peine → C’est pas la peine.","ar":"لا داعي → سي با ل بان."}]},{"tFr":"Les registres de langue","tAr":"مسلاات la langue","body":["le soutenu: « Je suis fatigué de cela. » le courant: « J’en ai assez. » le familier: « J’en ai ras le bol. »","la même idea تُعبَّر la plusieurs façons — la choix يعتمد la context: professionnel، quotidien، أو amical."],"ex":[{"fr":"Soutenu: Je suis fatigué de cela.","ar":"مرتفع: أنا متعب من هذا."},{"fr":"Familier: J’en ai ras le bol.","ar":"عامي: سئمت تماماً."}]}],"mistakes":[{"wrong":"la نسخ la expressions la context الخاطئ","right":"la choix la registre الصحيح","why":"« Tu m’fais chier » لا تُستخدم la context professionnel."},{"wrong":"la lecture la expressions la vitesse lente","right":"la écoute la vitesse réelle","why":"la parole الطبيعية أسرع la lecture."},{"wrong":"la تجاهل la intonation","right":"la répétition la intonation الصحيحة","why":"la intonation تُغيّر la معنى."},{"wrong":"la استخدام la expressions la context لا تعرفه","right":"la compréhension la context أولاً","why":"la context la priorité la niveau B2."}],"dialogues":[{"title":"la vie quotidienne","ctx":"أصدقاء la restaurant","lines":[{"who":"Luc","fr":"On y va manger ?","ar":"نذهب نأكل؟"},{"who":"Sarah","fr":"Y a pas de quoi, t’as choisi.","ar":"لا شكر على واجب، أنت اخترت."},{"who":"Luc","fr":"Ça me saoule, c’est toujours moi !","ar":"هذا يضجرني، أنا دائماً أنا!"},{"who":"Sarah","fr":"Bluffes pas, tu adores ça !","ar":"لا تُخادع، أنت تحب هذا!"}]},{"title":"la décision","ctx":"زملاء la العمل","lines":[{"who":"Karim","fr":"C’est pas la peine de rester.","ar":"لا داعي للبقاء."},{"who":"Léa","fr":"J’en ai ras le bol, c’est clair.","ar":"سئمت تماماً، هذا واضح."},{"who":"Karim","fr":"On y va alors ?","ar":"نذهب إذن؟"},{"who":"Léa","fr":"D’accord, merci de ta patience.","ar":"أوكي، شكراً لصبرك."}]}],"exercises":[{"t":"mcq","skill":"listening","q":"ما معنى « Y a pas de quoi »؟","opts":["Il n’y a pas de quoi","Il n’y a pas le temps","Il n’y a pas besoin","Il n’y a pas moyen"],"a":0,"why":"Y a pas de quoi = la réduction Il n’y a pas de quoi."},{"t":"fill","skill":"grammar","q":"حوّل إلى la forme naturelle: «Ce n’est pas la peine.»","fr":"Ce n’est pas la peine.","ans":"C’est pas la peine.","why":"la négation تُحذف la parole."},{"t":"order","skill":"writing","q":"رتّب: سئمت تماماً","words":["J’en","ai","ras","le","bol."],"ans":"J’en ai ras le bol.","why":"la expression la familier la limite."},{"t":"listen","skill":"listening","q":"ما « ça me saoule » في la forme soutenu؟","opts":["Cela m’ennuie","Cela me plaît","Cela me manque","Cela me tarde"],"a":0,"why":"ça me saoule = la familier la ennuyer."},{"t":"translate","skill":"writing","q":"ترجم: «لا داعي للبقاء.» إلى la forme naturelle.","ans":"C’est pas la peine de rester.","why":"la négation + la expression."},{"t":"mcq","skill":"grammar","q":"أي registre يمثل « Tu bluffes !»؟","opts":["familier","soutenu","littéraire","technique"],"a":0,"why":"la phrase قصيرة ومباشرة = registre familier."},{"t":"speaking","skill":"speaking","q":"استمع للdialogues وأعد بناء ما سمعت la intonation الصحيحة.","target":"Y a pas de quoi / Ça me saoule / On y va","why":"la compréhension la parole naturelle."},{"t":"correct","skill":"grammar","q":"صحّح: «Il n’y a pas de quoi, je ne suis pas fatigué.»","ans":"Y a pas de quoi, j’en ai ras le bol.","why":"la langue naturelle la context."}],"homework":"استمع لمحادثة فرنسية طبيعية la vitesse كاملة، اكتب ما سمعت la expressions، ثم حوّله إلى la forme écrite — وقارنه بالنص الرسمي.","sources":[{"title":"Les 17 Expressions Idiomatiques les plus utilisées par les français","channel":"Français avec Nelly","videoId":"F8tQPh-MpkE","why":"شرح 17 تعبيراً idiomatique يستخدمها الفرنسيون يومياً — la porte d’entrée la langue naturelle المنطوقة.","cat":"Naturel","level":"B2","main":true},{"title":"Expression française, niveau B2","channel":"Français Authentique","videoId":"Dh3STYQ0yWM","why":"شرح la langue naturelle la niveau B2 — la compréhension la parole.","cat":"Naturel","level":"B2","extra":true},{"title":"50 Expressions Idiomatiques Françaises 🇫🇷 | 50 Essential French Idioms","channel":"French with Alicia","videoId":"WxNRvm5yVJ0","why":"خمسون تعبيراً idiomatique — la base la langue naturelle.","cat":"Naturel","level":"B2","extra":true}],"supplements":[{"id":"Dh3STYQ0yWM","title":"Expression française, niveau B2","channel":"Français Authentique","why":"شرح la langue naturelle la niveau B2 — la compréhension la parole.","lang":"fr","dur":15},{"id":"WxNRvm5yVJ0","title":"50 Expressions Idiomatiques Françaises 🇫🇷 | 50 Essential French Idioms","channel":"French with Alicia","why":"خمسون تعبيراً idiomatique — la base la langue naturelle.","lang":"fr","dur":15}]},{"id":"b2-t1-l2","fr":"Les réductions et élisions naturelles","ar":"الاختصارات والإلقاءات الطبيعية","objectives":["فهم la prononciation المنطوقة: elisions, contractions, liaisons","تمييز la langue naturelle عن la langue écrite","إعادة بناء الجملة المنطوقة إلى la forme écrite","تحليل كيف تُغيّر la musique la langue la compréhension"],"sections":[{"h":"الدرس 2: كيف يختصر الفرنسيون كلامهم فعلاً","video":{"id":"Dh3STYQ0yWM","title":"Expression française, niveau B2","channel":"Français Authentique","why":"شرح la langue naturelle: كيف تختصر la prononciation la langue المنطوقة — elisions, reductions, liaisons في الكلام اليومي.","lang":"fr","main":true,"dur":15},"p":["la langue الفرنسية المنطوقة تختلف كثيراً عن la langue المكتوبة: « Je ne sais pas » تصبح « Chais pas »، « Tu veux venir ? » تصبح « T' veux véni ? ». la première مهمة B2 هي la reconnaissance لا la reproduction.","المفردات الأساسية: l’élision, la réduction, la liaison, le e caduc, la contraction, le familier, le courant, le soutenu. هذه المفردات تشرح la mécanique la langue.","نحوياً، تظهر la elision في: « l’homme », « c’est », « j’ai », « t’as ». le e caduc (e muet) يظهر في la prononciation: « petite » = [pətit] لا [pətitə].","الدرس الأهم: la compréhension لا تتطلب la reproduction. أنت لا تحتاج أن تتكلم مثل Parisian — تحتاج أن تفهمهم. la pratique: أعد بناء la phrase écrite من la phrase المنطوقة.","بعد الدرس، استمع لمحادثة طبيعية وحاول كتابة ما سمعت بالضبط — ثم قارنه بالنص الرسمي."],"sub":[{"h":"la langue المنطوقة","p":["Je ne sais pas → Chais pas.","Tu veux venir ? → T’ veux véni ?","C’est quoi ? → T’quoi ?","Je vais aller → J’vais aller."]},{"h":"أدوات نطقية: le e caduc","p":["« petite » [pətit] — le e الأخير صامت.","« vous avez » [vu.za.ve] — la liaison مع elision.","« je ne peux pas » → [ʒə nə pø pa] → [ʒə pø pa]."]},{"h":"خطوات Listen & Repeat","p":["المرة الأولى: اكتب ما سمعت بالحروف.","الثانية: قارنه بالنص الرسمي.","الثالثة: حوّل la phrase المنطوقة إلى la forme écrite."]}]},{"h":"la carte la langue","p":["« Chais pas » = je ne sais pas — la réduction la plus courante.","« T’ veux ? » = tu veux — la elision مع le pronom.","« C’est quoi, ça ? » — la question naturelle la plus fréquente.","« J’vais y aller. » — la contraction la plus naturelle."]},{"h":"التطبيق والتلخيص","p":["تمرين la reconnaissance: استمع لخمس جمل منطوقة وأعد بناءها بالكتابة.","تمرين la bascule: حوّل ثلاث جمل formelles إلى la forme naturelle.","سجّل نفسك تتكلم بـ la langue naturelle: « Chais pas » بدل « Je ne sais pas » — la mémoire la bouche."]},{"h":"التطبيق والتلخيص","p":["تعلّمت أن la langue المنطوقة تختصر la langue المكتوبة: « Je ne sais pas » تصبح « Chais pas »، و« Je vais aller » تصبح « J’vais aller ». أتقنت أيضاً le e caduc وla liaison في la prononciation. أعد مشاهدة الفيديو الرئيسي وركّز على تحوّل «Je ne sais pas» إلى «Chais pas» ونطق le e caduc.","جسر الدروس: من b2-t1-l1 (كيف يتحدث الفرنسيون فعلاً بالعبارات المنطوقة) إلى b2-t1-l2 (اختصارات وإلقاءات الكلام اليومي)، ثم إلى b2-t1-l3 حيث تتقن التعبيرات الاصطلاحية اليومية.","مهمة تطبيقية: سجّل دقيقة صوتية تشرح فيها موقفاً من يومك مستخدماً ثلاث كلمات جديدة من الدرس (Chais pas، T’veux، J’vais)، ثم استمع للتسجيل وقارن نطقك ومفرداتك بما سمعته في الفيديو الرئيسي."]}],"pron":[{"w":"chais pas","ipa":"[ʃɛ pa]","approx":"شاي با"},{"w":"t’ veux","ipa":"[tvo]","approx":"ت فو"},{"w":"j’vais","ipa":"[ʒvɛ]","approx":"ج ڤي"}],"vocab":[{"fr":"l’élision","ar":"la الإلقاء/la الحذف","pos":"nom","g":"f","exFr":"L’élision est courante à l’oral.","ipa":"","exAr":"la الإلقاء شائعة شفوياً."},{"fr":"la réduction","ar":"la الاختصار","pos":"nom","g":"f","exFr":"La réduction « chais pas » est naturelle.","ipa":"","exAr":"la الاختصار «chais pas» طبيعي."},{"fr":"la liaison","ar":"la الوصل الصوتي","pos":"nom","g":"f","exFr":"La liaison est obligatoire ici.","ipa":"","exAr":"la الوصل الصوتي إلزامي هنا."},{"fr":"le e caduc","ar":"la الـ e المهدورة","pos":"nom","g":"m","exFr":"Le e caduc est muet dans « petite ».","ipa":"","exAr":"la الـ e المهدورة صامتة في «petite»."},{"fr":"la contraction","ar":"la الاندماج","pos":"nom","g":"f","exFr":"La contraction « j’vais » est courante.","ipa":"","exAr":"la الاندماج «j’vais» شائع."},{"fr":"le familier","ar":"la المستوى العامي","pos":"nom","g":"m","exFr":"Le familier n’est pas vulgaire.","ipa":"","exAr":"la المستوى العامي ليس بذيئاً."},{"fr":"le courant","ar":"la المستوى الشائع","pos":"nom","g":"m","exFr":"Le courant est le plus utilisé.","ipa":"","exAr":"la المستوى الشائع الأكثر استخداماً."},{"fr":"le soutenu","ar":"la المستوى المرتفع","pos":"nom","g":"m","exFr":"Le soutenu est utilisé à l’écrit.","ipa":"","exAr":"la المستوى المرتفع يُستخدم كتابياً."},{"fr":"prononcer","ar":"ينطق","pos":"verbe","g":"","exFr":"Comment prononcez-vous ce mot ?","ipa":"","exAr":"كيف تنطق هذا الكلمة؟"},{"fr":"écouter","ar":"يستمع","pos":"verbe","g":"","exFr":"Il faut écouter la bande.","ipa":"","exAr":"يجب الاستماع إلى الشريط."},{"fr":"comprendre","ar":"يفهم","pos":"verbe","g":"","exFr":"Je comprends mieux maintenant.","ipa":"","exAr":"أفهم بشكل أفضل الآن."},{"fr":"le débit de parole","ar":"سرعة الكلام المنطوقة","pos":"loc.","g":"","exFr":"Le débit de parole à la radio est rapide.","exAr":"سرعة الكلام المنطوقة في الإذاعة سريعة.","ipa":"[de.bi də paʁɔl]"}],"examples":[{"fr":"Je ne sais pas → Chais pas.","ar":"لا أعرف → شاي با.","note":"la réduction"},{"fr":"Tu veux venir ? → T’ veux véni ?","ar":"هل تريد أن تأتي؟ → ت ڤي ڤيني؟","note":"la elision"},{"fr":"C’est quoi, ça ? → T’quoi, ça ?","ar":"ما هذا؟ → ت كوا؟","note":"la contraction"},{"fr":"Je vais aller → J’vais aller.","ar":"سأذهب → ج ڤاي أليه.","note":"la réduction"},{"fr":"Vous avez → [vu.za.ve]","ar":"لديكم → [vu.za.ve]","note":"la liaison"},{"fr":"petite → [pətit]","ar":"صغيرة → [pətit]","note":"le e caduc"}],"grammar":[{"tFr":"Elision et contraction à l’oral","tAr":"la elision والاندماج شفوياً","body":["« je ne sais pas » → « chais pas » — la réduction la plus courante. « tu veux » → « t’veux » — la elision مع le pronom.","« je vais » → « j’vais » — la contraction la plus naturelle. la compréhension لا تتطلب la reproduction."],"ex":[{"fr":"Je ne sais pas → Chais pas.","ar":"لا أعرف → شاي با."},{"fr":"Tu veux venir ? → T’ veux véni ?","ar":"هل تريد أن تأتي؟ → ت ڤي ڤيني؟"}]},{"tFr":"Le e caduc dans la prononciation","tAr":"le e caduc في la prononciation","body":["« petite » = [pətit] — le e الأخير صامت. « vous vous appelez » = [vu vu zap.le] — la liaison مع elision.","« je ne peux pas » → [ʒə nə pø pa] → [ʒə pø pa] — la réduction la negation."],"ex":[{"fr":"petite → [pətit]","ar":"صغيرة → [pətit]"},{"fr":"vous vous appelez → [vu vu zap.le]","ar":"تنادون → [vu vu zap.le]"}]}],"mistakes":[{"wrong":"الخوف من la langue naturelle","right":"la distinction entre la compréhension et la reproduction","why":"أنت لا تحتاج أن تتكلم مثل Parisian — تحتاج أن تفهمهم."},{"wrong":"la confusion entre le familier et le vulgaire","right":"le familier = la langue naturelle","why":"le familier ليس بالضرورة بذيئاً."},{"wrong":"la lecture de la langue naturelle","right":"la distinction entre la forme écrite والمنطوقة","why":"la lecture تُفقد la naturalité."},{"wrong":"la reproduction الكاملة","right":"la compréhension + la production naturelle","why":"la perfection ليست la cible."}],"dialogues":[{"title":"la langue naturelle","ctx":"أصدقاء في مقهى","lines":[{"who":"Marc","fr":"T’ veux un café ?","ar":"ت ڤي قهوة؟"},{"who":"Nadia","fr":"Chais pas, j’vais réfléchir.","ar":"شاي با، ج ڤاي ريفلِشير."},{"who":"Marc","fr":"C’est quoi ton problème ?","ar":"ت كوا طون بروبليم؟"},{"who":"Nadia","fr":"Rien, j’ai un peu la flemme.","ar":"ريين، جاي أن بـ لا فلام."}]},{"title":"la distinction","ctx":"معلم يشرح la différence","lines":[{"who":"Prof","fr":"« Je ne sais pas » est formel.","ar":"«Je ne ses pas» رسمي."},{"who":"Élève","fr":"Et « chais pas » ?","ar":"و «شاي با»؟"},{"who":"Prof","fr":"C’est naturel, courant.","ar":"إنه طبيعي، شائع."},{"who":"Élève","fr":"D’accord, j’ai compris.","ar":"أوكي، جاي كوبراني."}]}],"exercises":[{"t":"mcq","skill":"listening","q":"ما معنى « chais pas »؟","opts":["Je ne sais pas","Je ne veux pas","Je ne peux pas","Je ne suis pas"],"a":0,"why":"chais pas = je ne sais pas."},{"t":"fill","skill":"grammar","q":"حوّل إلى la forme naturelle: «Je vais aller.»","fr":"Je vais aller.","ans":"J’vais aller.","why":"la contraction la plus naturelle."},{"t":"mcq","skill":"listening","q":"ما la prononciation الصحيحة لـ « petite »؟","opts":["[pətit]","[pətitə]","[petit]","[pəti]"],"a":0,"why":"le e caduc صامت."},{"t":"order","skill":"writing","q":"رتّب: لا أعرف → شاي با","words":["Je","ne","sais","pas","→","Chais","pas."],"ans":"Je ne sais pas → Chais pas.","why":"la réduction la plus courante."},{"t":"listen","skill":"listening","q":"ما « t’veux » في la forme écrite؟","opts":["Tu veux","Je veux","Il veut","On veut"],"a":0,"why":"la elision مع le pronom."},{"t":"translate","skill":"writing","q":"حوّل: «Tu veux venir ?» إلى la forme naturelle.","ans":"T’ veux véni ?","why":"la elision + la réduction."},{"t":"speaking","skill":"speaking","q":"استمع لمحادثة طبيعية وأعد بناء ما سمعت بالكتابة.","target":"Chais pas / T’veux / J’vais","why":"la compréhension la langue naturelle."},{"t":"correct","skill":"grammar","q":"صحّح: «Je ne sais pas, comment dit-on ça ?»","ans":"Chais pas, comment on dit ça ?","why":"la langue naturelle."}],"homework":"استمع لمحادثة فرنسية طبيعية، اكتب ما سمعت بالحروف، ثم حوّله إلى la forme écrite — وقارنها بالنص الرسمي.","sources":[{"title":"Expression française, niveau B2","channel":"Français Authentique","videoId":"Dh3STYQ0yWM","why":"شرح la langue naturelle: كيف تختصر la prononciation la langue المنطوقة — elisions, reductions, liaisons في الكلام اليومي.","cat":"Naturel","level":"B2","main":true},{"title":"50 Expressions Idiomatiques Françaises 🇫🇷 | 50 Essential French Idioms","channel":"French with Alicia","videoId":"WxNRvm5yVJ0","why":"خمسون تعبيراً idiomatique — la base la langue naturelle.","cat":"Naturel","level":"B2","extra":true},{"title":"Avantages et inconvénients","channel":"Français Authentique","videoId":"_VfSkJtvoXs","why":"محادثة طبيعية عن la vie quotidienne — la pratique la compréhension.","cat":"Naturel","level":"B2","extra":true}],"supplements":[{"id":"WxNRvm5yVJ0","title":"50 Expressions Idiomatiques Françaises 🇫🇷 | 50 Essential French Idioms","channel":"French with Alicia","why":"خمسون تعبيراً idiomatique — la base la langue naturelle.","lang":"fr","dur":15},{"id":"_VfSkJtvoXs","title":"Avantages et inconvénients","channel":"Français Authentique","why":"محادثة طبيعية عن la vie quotidienne — la pratique la compréhension.","lang":"fr","dur":12}]},{"id":"b2-t1-l3","fr":"Expressions idiomatiques quotidiennes","ar":"التعبيرات الاصطلاحية اليومية","objectives":["فهم المعنى المجازي لستة عشر تعبيراً اصطلاحياً شائعاً","تفادي الترجمة الحرفية للتعبيرات الاصطلاحية","تصريف التعبير الاصطلاحية حسب الزمن والفاعل دون خطأ","استعمال التعبيرات في مواقف يومية مناسبة لمستواها"],"sections":[{"h":"الدرس 3: التعبيرات التي يستعملها الفرنسيون كل يوم","video":{"id":"F8tQPh-MpkE","title":"Les 17 Expressions Idiomatiques les plus utilisées par les français","channel":"Français avec Nelly","why":"سبعة عشر تعبيراً اصطلاحياً شائعاً عند الفرنسيين مع سياق استعمالها — مفتاح لفهم الحديث اليومي وإنتاجه.","lang":"fr","main":true,"dur":14},"p":["التعبير الاصطلاحية (expression idiomatique) لا يمكن استنتاج معناها من مفرداتها: « poser un lapin » تعني حرفياً « يضع أرنبًا »، ومعناها الحقيقي « يخذلك بعد أن وعدك بالحضور ». أول قاعدة في المستوى B2: افهم المعنى المجازي قبل أن تستخدم التعبير.","معجم الدرس: avoir le cafard, poser un lapin, tomber des nues, donner sa langue au chat, en avoir plein le dos, tourner autour du pot, coûter les yeux de la tête, prendre ses jambes à son cou, avoir d’autres chats à fouetter, mettre la charrue avant les bœufs, tomber dans les pommes, ça ne tient pas debout. احفظ كل تعبير مع مثال واحد من سياق حقيقي، لا بالترجمة وحدها.","نحوياً، التعبير الاصطلاحية وحدة نحوية شبه مغلقة: الفعل وحده يتغير تصريفه، وباقي العبارة يبقى على حاله. نقول « il a posé un lapin » في الماضي المركب، و« elles posent des lapins » في الجمع، ولا نغيّر لا أداة التعريف ولا جنس الاسم داخل التعبير.","سياقياً، هذه التعبيرات تعيش في الكلام اليومي أكثر مما في الكتابة الرسمية: « en avoir plein le dos » تعبير عن التعب المتراكم، و« tourner autour du pot » وصف لمن يتجنب Directement صلب الموضوع. في مقابلة عمل أو رسالة رسمية، استبدلها بترجمة محايدة.","مسألة الترجمة: التعبير الاصطلاحية لا تُنقل إلى العربية حرفياً. بدل حفظ ترجمة واحدة، احفظ ثلاث قطع معاً: التعبير الفرنسي، ومعناه المجازي، ومثالاً واحداً تنتجه بنفسك. هكذا يتصل التعبير بذاكرتك السياقية لا بذاكرة الترجمة.","بعد الدرس: اكتب ست جمل من حياتك اليومية تستخدم فيها ستة تعبيرات مختلفة، ثم سجّل نفسك تنطقها بصوت مسموع. التعبير الذي لا تستخدمه خلال أسبوع يُنسى؛ أما الذي تنطقه فيصبح جزءاً من لغتك."],"sub":[{"h":"Les expressions du quotidien","p":["Elle lui a posé un lapin devant le café.","J’ai le cafard depuis lundi matin.","Il en a plein le dos de ses réunions."]},{"h":"Les expressions de la surprise","p":["Nous sommes tombés des nues en apprenant la nouvelle.","Je te donne ma langue au chat ?","Ce week-end m’a coûté les yeux de la tête."]},{"h":"Les expressions de l’action","p":["Il a pris ses jambes à son cou en voyant le chien.","Ne tourne pas autour du pot, dis-le clairement.","Tu as d’autres chats à fouetter, concentre-toi !"]}]},{"h":"Quatre expressions à maîtriser en priorité","p":["« Poser un lapin à quelqu’un » = le faire attendre en vain, sans se présenter ni prévenir.","« Avoir le cafard » = être triste sans raison précise, avoir le moral dans les chaussettes.","« Tomber des nues » = être totalement surpris, s’attendre à tout sauf à cela.","« Donner sa langue au chat » = cesser de deviner et demander finalement la réponse."]},{"h":"التطبيق والتلخيص","p":["تمرين التصريف: اكتب كل تعبير من الدرس في ثلاث صيغ (present, passé composé, futur) مع الحفاظ على وحدة العبارة.","تمرين المعنى: حوّل ستة تعبيرات إلى معانيها الحقيقية بالعربية، ثم أعِد استعمال كل واحد في جملة فرنسية جديدة من حياتك.","تمرين الكلام: سجّل 30 ثانية تتحدث فيها عن يومك مستخدماً ثلاثة تعبيرات اصطلاحية بنبرة طبيعية، ثم استمع لنفسك وصحّح النبرة."]},{"h":"التطبيق والتلخيص","p":["في هذا الدرس تعلّمت أن التعبير الاصطلاحية وحدة جاهزة لا تُفكَّك: يُصَرف فعلها فقط ويبقى الباقي ثابتاً. حفظت المعنى المجازي لـ poser un lapin وavoir le cafard وtourner autour du pot. أعد مشاهدة الفيديو الرئيسي وركّز على المعنى المجازي لا الحرفية لكل تعبير.","جسر الدروس: من b2-t1-l2 (اختصارات وإلقاءات الكلام اليومي) إلى b2-t1-l3 (التعبيرات الاصطلاحية ومعانيها المجازية)، ثم إلى b2-t1-l4 حيث تتحكّم في العامية الباريسية المهذّبة.","مهمة تطبيقية: سجّل دقيقة صوتية تشرح فيها موقفاً من يومك مستخدماً ثلاث كلمات جديدة من الدرس (avoir le cafard، poser un lapin، tourner autour du pot)، ثم استمع للتسجيل وقارن نطقك ومفرداتك بما سمعته في الفيديو الرئيسي."]}],"pron":[{"w":"poser un lapin","ipa":"[po.ze œ̃ la.pɛ̃]","approx":"بوزوں لابان"},{"w":"avoir le cafard","ipa":"[a.vwa lə ka.fɑʁ]","approx":"أفوا لكافار"},{"w":"tomber des nues","ipa":"[tɔ̃.be de nɥ]","approx":"طونبي دي ني"}],"vocab":[{"fr":"poser un lapin à quelqu’un","ar":"يُخذلك بعد أن وعدك بالحضور","pos":"loc.","g":"","exFr":"Elle lui a posé un lapin devant le café.","ipa":"[po.ze œ̃ la.pɛ̃]","exAr":"أخذلته أمام المقهى دون أن تأتي."},{"fr":"avoir le cafard","ar":"يكون حزيناً بلا سبب واضح","pos":"loc.","g":"","exFr":"J’ai le cafard quand il pleut tout le week-end.","ipa":"[a.vwa lə ka.fɑʁ]","exAr":"أشعر بالحزن حين تمطر طوال عطلة الأسبوع."},{"fr":"tomber des nues","ar":"يُفاجأ تماماً","pos":"loc.","g":"","exFr":"Nous sommes tombés des nues en lisant ce courriel.","ipa":"[tɔ̃.be de nɥ]","exAr":"فوجئنا تماماً عند قراءة هذا البريد."},{"fr":"donner sa langue au chat","ar":"يتوقف عن التخمين ويسأل عن الجواب","pos":"loc.","g":"","exFr":"Je te donne ma langue au chat ?","ipa":"[dɔ.ne sa lɑ̃ɡ o ʃa]","exAr":"أتوقف عن التخمين وأسألك؟"},{"fr":"en avoir plein le dos","ar":"يملأه التعب والاستياء","pos":"loc.","g":"","exFr":"J’en ai plein le dos de ces réunions inutiles.","ipa":"[ɑ̃.na.vwa plɛ̃ lə do]","exAr":"سئمت من هذه الاجتماعات العديمة الفائدة."},{"fr":"tourner autour du pot","ar":"يُتهرب من مباشرة الحديث","pos":"loc.","g":"","exFr":"Arrête de tourner autour du pot et dis la vérité.","ipa":"[tuʁ.ne o.tuʁ dy po]","exAr":"كفَ عن المداراة وقل الحقيقة."},{"fr":"coûter les yeux de la tête","ar":"يكون باهظ الثمن","pos":"loc.","g":"","exFr":"Ce voyage m’a coûté les yeux de la tête.","ipa":"[ku.te le zjø də tɛt]","exAr":"كلّفني هذا السفر ثمناً باهظاً."},{"fr":"prendre ses jambes à son cou","ar":"يفرّ بأقصى سرعة","pos":"loc.","g":"","exFr":"Il a pris ses jambes à son cou en voyant la patrouille.","ipa":"[pʁɑ̃dʁ sə ʒɑ̃b a sɔ̃ ku]","exAr":"فرّ بأقصى سرعة رأى الدورية."},{"fr":"avoir d’autres chats à fouetter","ar":"لديه أولويات أهم من ذلك","pos":"loc.","g":"","exFr":"J’ai d’autres chats à fouetter en ce moment.","ipa":"[a.vwa tʁo ʃa a fwe.te]","exAr":"لديّ أولويات أهم في هذه الفترة."},{"fr":"mettre la charrue avant les bœufs","ar":"يبدأ بالثانوي قبل الأساسي","pos":"loc.","g":"","exFr":"Ne mets pas la charrue avant les bœufs.","ipa":"[mɛtʁ la ʃaʁy avɑ̃ le bø]","exAr":"لا تبدأ بالثانوي قبل الأساسي."},{"fr":"tomber dans les pommes","ar":"يغمى عليه","pos":"loc.","g":"","exFr":"Elle est tombée dans les pommes dans le métro.","ipa":"[tɔ̃.be dɑ̃ le pɔm]","exAr":"غمى عليها في المترو."},{"fr":"ça ne tient pas debout","ar":"هذا لا يُعقل ولا يمكن الدفاع عنه","pos":"loc.","g":"","exFr":"Ton argument ne tient pas debout.","ipa":"[sa nə tjɑ̃ pa dəbu]","exAr":"حجتك لا تثبت شيئاً."}],"examples":[{"fr":"Elle lui a posé un lapin devant le café.","ar":"خذلته أمام المقهى دون أن تأتي.","note":"poser un lapin"},{"fr":"J’ai le cafard depuis que mon ami est parti.","ar":"أنا حزين منذ أن سافر صديقي.","note":"avoir le cafard"},{"fr":"Nous sommes tombés des nues en apprenant sa démission.","ar":"فوجئنا تماماً حين علمنا باستقالته.","note":"tomber des nues"},{"fr":"Il tourne autour du pot au lieu de répondre.","ar":"يُتهرب من الإجابة المباشرة.","note":"tourner autour du pot"},{"fr":"Ce sac m’a coûté les yeux de la tête.","ar":"كلّفني هذا الحقيبة ثمناً باهظاً.","note":"coûter les yeux de la tête"},{"fr":"Quand il a vu l’orage, il a pris ses jambes à son cou.","ar":"حين رأى العاصفة فرّ بأقصى سرعة.","note":"prendre ses jambes à son cou"}],"grammar":[{"tFr":"La locution figée : une unité invariable","tAr":"العبارة الجاهزة: وحدة نحوية لا تتغير","body":["التعبير الاصطلاحية وحدة نحوية واحدة: يُصَرف فعلها فقط، أما بقية الأجزائها فتبقى ثابتة. « Elle a posé un lapin » صحيحة، و« elle a posé un lapine » خطأ لأن الاسم داخل العبارة الجاهزة لا يُجمَّع ولا يُؤنَّث.","يمكن تغيير أداة التعريف فقط عندما يسمح الاستعمال: « il a perdu la tête » و« perdre la tête » كلاهما صحيح، لكن نقول حتماً « mettre la charrue avant les bœufs » دون حذف الأداة."],"ex":[{"fr":"Elle a posé un lapin à son rendez-vous.","ar":"خذلت مواعدها دون أن تأتي."},{"fr":"Ils ont mis la charrue avant les bœufs.","ar":"بدأوا بالثانوي قبل الأساسي."}]},{"tFr":"Le registre de chaque expression","tAr":"مستوى كل تعبير","body":["بعض التعبيرات محايدة ومناسبة للكتابة: « mettre la charrue avant les bœufs », « ça ne tient pas debout ». وبعضها شديد الودّية مثل « avoir le béguin » أو « en avoir plein le dos »، فيستعمل مع الأصدقاء لا في التقارير.","قاعدة الاختيار: اسأل نفسك أين سيُنطق هذا التعبير. مقهى مع الأصدقاء = تعبير ودّي. رسالة إلى مدير = تعبير محايد أو تركيب جديد."],"ex":[{"fr":"En réunion : « cette explication ne tient pas debout ».","ar":"في الاجتماع: «هذا التفسير لا يُعقل»."},{"fr":"Entre amis : « j’en ai plein le dos, sérieux ».","ar":"بين الأصدقاء: «سئمت تماماً، عن جد»."}]}],"mistakes":[{"wrong":"ترجمة التعبير حرفياً إلى العربية","right":"حفظ المعنى المجازي مع مثال سياقي","why":"الترجمة الحرفية تفقد المعنى وتُنتج جملة لا يفهمها أحد."},{"wrong":"استعمال التعبير الودّي في رسالة رسمية","right":"اختيار تعبير محايد أو تركيب جديد","why":"المستوى الخطابي يجب أن يناسب الوسيلة والمخاطب."},{"wrong":"تغيير الاسم داخل العبارة الجاهزة","right":"صرف الفعل فقط وترك بقية التعبير ثابتاً","why":"العبارة الجاهزة وحدة نحوية واحدة لا تُفكَّك."},{"wrong":"حفظ عشرين تعبيراً دفعة واحدة","right":"إتقان ستة تعبيرات مع إنتاج جمل بها","why":"التعبير غير المستخدم يُنسى خلال أسبوع."}],"dialogues":[{"title":"Un rendez-vous manqué","ctx":"صديقتان تتحدثان في المقهى","lines":[{"who":"Claire","fr":"Tu es où ? On attend depuis une heure.","ar":"أين أنت؟ ننتظر منذ ساعة."},{"who":"Sofia","fr":"Pardon, j’ai eu un imprévu...","ar":"آسفة، حدث أمر طارئ..."},{"who":"Claire","fr":"Encore ! Tu m’as posé un lapin hier aussi.","ar":"مجدداً! لقد خذلتيني أمس أيضاً."},{"who":"Sofia","fr":"Ça ne tient pas debout, je t’ai écrit deux messages.","ar":"هذا لا يُعقل، لقد أرسلت لك رسالتين."}]},{"title":"Le lundi matin au bureau","ctx":"زميلان قبل اجتماع الصباح","lines":[{"who":"Julien","fr":"Tu as l’air morose, ça va ?","ar":"تبدو كئيباً، هل كل شيء بخير؟"},{"who":"Amélie","fr":"J’ai le cafard, le week-end était trop court.","ar":"أشعر بالحزن، كانت عطلة الأسبوع قصيرة جداً."},{"who":"Julien","fr":"Après cette réunion, tu prendras tes jambes à ton cou.","ar":"بعد هذا الاجتماع ستفرين بأقصى سرعة."},{"who":"Amélie","fr":"Exactement, et j’en ai plein le dos de tout ça.","ar":"بالضبط، وسئمت كل هذا."}]}],"exercises":[{"t":"mcq","skill":"vocab","q":"ما معنى « poser un lapin »؟","opts":["يخذل شخصاً بتركه ينتظر","يهدّد شخصاً","يعيد الموعد مرتين","يُغرّق شخصاً بالهدايا"],"a":0,"why":"المعنى المجازي: يترك أحدهم ينتظر دون أن يأتي."},{"t":"fill","skill":"grammar","q":"أكمل بصيغة passé composé: «Elle ___ un lapin à son ami.»","fr":"Elle ___ un lapin à son ami.","ans":"a posé","why":"الفعل poser وحده يتغير تصريفه داخل العبارة الجاهزة."},{"t":"order","skill":"writing","q":"رتّب الكلمات لتكوين جملة صحيحة","words":["Il","a","pris","ses","jambes","à","son","cou"],"ans":"Il a pris ses jambes à son cou","why":"العبارة الجاهزة تُصَرف بالفعل فقط."},{"t":"mcq","skill":"vocab","q":"أي تعبير يعني « باهظ الثمن »؟","opts":["tomber dans les pommes","coûter les yeux de la tête","donner sa langue au chat","mettre la charrue avant les bœufs"],"a":1,"why":"coûter les yeux de la tête = كان ثمناً باهظاً."},{"t":"listen","skill":"listening","q":"استمع واختر الجملة التي تعني: « إنه حزين بلا سبب واضح. »","opts":["Il a le cafard.","Il pose un lapin.","Il tourne autour du pot.","Il a la flemme."],"a":0,"why":"avoir le cafard = الحزن بلا سبب واضح."},{"t":"translate","skill":"writing","q":"ترجم الجملة مع استعمال التعبير المناسب: «سئمت من هذه الاجتماعات المكررة.»","ans":"J’en ai plein le dos de ces réunions répétées.","why":"en avoir plein le dos يعبّر عن التعب المتراكم."},{"t":"speaking","skill":"speaking","q":"اشرح شفهياً ثلاثة تعبيرات من الدرس مع مثال من يومك.","target":"avoir le cafard / tourner autour du pot / poser un lapin","why":"تثبيت التعبير عبر الإنتاج المنطوق."},{"t":"correct","skill":"grammar","q":"صحّح الخطأ: «Il tourne autour de la marmite pour ne pas répondre.»","ans":"Il tourne autour du pot pour ne pas répondre.","why":"العبارة الجاهزة هي tourner autour du pot."}],"homework":"اختر ستة تعبيرات من الدرس، اكتب بها ست جمل عن يومك الحقيقي، ثم سجّل دقيقة صوتية تقرأ فيها الجمل بنبرة طبيعية واستمع إليها مقارنةً بنطق النموذج.","sources":[{"title":"Les 17 Expressions Idiomatiques les plus utilisées par les français","channel":"Français avec Nelly","videoId":"F8tQPh-MpkE","why":"سبعة عشر تعبيراً اصطلاحياً شائعاً عند الفرنسيين مع سياق استعمالها — مفتاح لفهم الحديث اليومي وإنتاجه.","cat":"Naturel","level":"B2","main":true},{"title":"B1/B2 French expressions | Improve your French with these B1/B2 expressions","channel":"French with Lucie","videoId":"WxNRvm5yVJ0","why":"تعبيرات إضافية في المستوى B1/B2 توسّع مخزونك الاصطلاحى وتربطه بما تعلمته.","cat":"Naturel","level":"B2","extra":true},{"title":"Français - Niveau B2-C1 Expressions synonymes \" sans cesse \"","channel":"Lilit Khachinyan","videoId":"tlDheBt7MiQ","why":"مقارنة بين تعبيرات مترادفة بدرجات نبرة مختلفة — تمنع الاستعمال المكرر.","cat":"Naturel","level":"B2","extra":true}],"supplements":[{"id":"WxNRvm5yVJ0","title":"B1/B2 French expressions | Improve your French with these B1/B2 expressions","channel":"French with Lucie","why":"تعبيرات إضافية في المستوى B1/B2 توسّع مخزونك الاصطلاحى وتربطه بما تعلمته.","lang":"fr","dur":10},{"id":"tlDheBt7MiQ","title":"Français - Niveau B2-C1 Expressions synonymes \" sans cesse \"","channel":"Lilit Khachinyan","why":"مقارنة بين تعبيرات مترادفة بدرجات نبرة مختلفة — تمنع الاستعمال المكرر.","lang":"fr","dur":6}]},{"id":"b2-t1-l4","fr":"L'argot parisien (poli)","ar":"العامية الباريسية المهذّبة","objectives":["التمييز بين العامية المهذّبة (familier) واللغة البذيئة","فهم قاعدة الفيرلان (verlan) وقراءة كلماته","استعمال عامية مقبولة في مواقف اجتماعية غير رسمية","تجنّب العامية في الكتابة الرسمية وبيئة العمل المحترمة"],"sections":[{"h":"الدرس 4: كيف تتحدث عامية باريسية دون أن تبدو بذيئاً","video":{"id":"aknbO53lEyo","title":"Expressions Françaises célèbres - Français Niveau CECRL:A2/B2","channel":"Apprends Le Français Avec Nathan","why":"شرح أشهر التعبيرات الفرنسية المشهورة بمستوى مدرسي مبسّط — أساس لفهم العامية المقبولة اجتماعياً في باريس.","lang":"fr","main":true,"dur":13},"p":["العامية الباريسية ليس لها مستوى واحد: توجد طبقات. « Je suis crevé » عامية مقبولة في المقهى ومحفظة في الشغل، أما الكلمات البذيئة فتبقى ممنوعة في كل الأحوال. مهمتك B2 هي تقليد الطبقة المتوسطة: عامية حيّة لكنها مهذّبة.","معجم الدرس: bosser, kiffer, grave, carrément, le boulot, la maille, nickel, ça roule, avoir la flemme, la boîte, le boss, meuf. هذه الكلمات تسمعها في المسلسلات وفي الشارع الباريسي، لكن اختيارها يختلف حسب المكان.","نحوياً، العامية تخضع لنفس قواعد النحو في الجملة الأساسية: الفاعل والفعل والفاعل، مع استبدال بعض المفردات فقط. « Je bosse » و« Je travaille » لهما نفس البنية؛ الخلاف في الطبقة اللغوية لا في القواعد.","قاعدة الـ verlan (الفيرلان): تُقلب مقطعات الكلمة ثم يُحذف أحياناً الحرف الأخير الصامت، فـ fou يصبح ouf، femme تصبح meuf، arabe يصبح beur. أصل الكلمة شعوبية-شعبية لكنها دخلت اليوم اللغة العادية: تسمع ouf في الأغاني وفي المسلسلات.","قاعدة الاستعمال: مع الأصدقاء والزملاء غير الرسميين استعمل العامية بقدر، ومع المدير أو في مقابلة العمل استعمل المستوى courant. إفراط العامية يبدو غير جاد، وخلوها يبدو بارداً: الاعتدال هو المطلوب.","بعد الدرس: شاهد مشهداً قصيراً بعامية باريسية واكتب الكلمات التي فهمتها، ثم صنّفها: مقبولة في العمل أم للأصدقاء فقط؟ هذه الصنفنة هي مهارة B2 الحقيقية."],"sub":[{"h":"L’argot du travail","p":["Je bosse dans une boîte de pub à Paris.","Le boss est sympa, on a pas mal de liberté.","Franchement, j’en ai assez du boulot en ce moment."]},{"h":"L’argot entre amis","p":["Ce film est grave bien, tu vas kiffer.","Ça roule pour samedi ? On se dit où ?","J’ai la flemme de sortir ce soir."]},{"h":"Le verlan, mode d’emploi","p":["Fou → ouf : « il est complètement ouf ».","Femme → meuf : « c’est une meuf super sympa ».","Arabe → beur : un mot entré dans le langage courant."]}]},{"h":"Quatre expressions à retenir avant tout","p":["« Je bosse » = je travaille — le mot le plus courant dans l’argot du quotidien.","« Grave ! » ou « C’est grave bien » = vraiment, beaucoup — remplace très à l’oral.","« On se fait un plan ? » = on organise quelque chose ensemble — très parisien.","« Nickel ! » = parfait, c’est réglé — sert de réponse rapide et polie."]},{"h":"التطبيق والتلخيص","p":["تمرين الطبقة: أعد كتابة خمس جمل من المستوى courant بصيغة عامية مهذّبة، ثم اكتب ما يعادلها في رسالة رسمية.","تمرين الفيرلان: حوّل خمس كلمات إلى فيرلان ثم أعِد قلبها — fou, femme, mec, noir, arabe.","تمرين النبرة: سجّل نفسك تقول « Ça roule ? Nickel ! J’ai la flemme » بنبرة صديقين لا بنبرة مذيع."]},{"h":"التطبيق والتلخيص","p":["تعلّمت أن العامية لها طبقات: «Je suis crevé» مقبولة اجتماعياً والبذيئة ممنوعة دائماً. أتقنت قاعدة verlan: fou → ouf، femme → meuf. أعد مشاهدة الفيديو الرئيسي وركّز على حدود العامية المهذّبة وقلب المقاطع في verlan.","جسر الدروس: من b2-t1-l3 (التعبيرات الاصطلاحية ومعانيها المجازية) إلى b2-t1-l4 (العامية الباريسية المهذّبة والverlan)، ثم إلى b2-t1-l5 حيث تكشف الكلمات المخادعة قبل وقوعك في فخّها.","مهمة تطبيقية: سجّل دقيقة صوتية تشرح فيها موقفاً من يومك مستخدماً ثلاث كلمات جديدة من الدرس (bosser، kiffer، nickel)، ثم استمع للتسجيل وقارن نطقك ومفرداتك بما سمعته في الفيديو الرئيسي."]}],"pron":[{"w":"grave","ipa":"[ɡʁav]","approx":"غراف"},{"w":"kiffer","ipa":"[ki.fe]","approx":"كيفي"},{"w":"nickel","ipa":"[ni.kɛl]","approx":"نيكيل"}],"vocab":[{"fr":"bosser","ar":"يشتغل (عامية مقبولة)","pos":"verbe","g":"","exFr":"Je bosse de huit heures à dix-huit heures.","ipa":"[bɔ.se]","exAr":"أعمل من الثامنة إلى الثامنة عشرة."},{"fr":"kiffer","ar":"يحب شيئاً بحماس","pos":"verbe","g":"","exFr":"Je kiffe cette chanson.","ipa":"[ki.fe]","exAr":"أعشق هذه الأغنية."},{"fr":"grave","ar":"كثيراً / جداً (بديل très)","pos":"adv.","g":"","exFr":"C’est grave sympa ce resto.","ipa":"[ɡʁav]","exAr":"هذا المطعم لطيف جداً."},{"fr":"carrément","ar":"تماماً / بكل صراحة","pos":"adv.","g":"","exFr":"Carrément, on y va ce soir.","ipa":"[ka.ʁe.mɑ̃]","exAr":"بالتأكيد، نذهب هذا المساء."},{"fr":"le boulot","ar":"العمل (عامي)","pos":"nom","g":"m","exFr":"Le boulot, c’est fini pour aujourd’hui.","ipa":"[bə.lo]","exAr":"انتهى العمل لهذا اليوم."},{"fr":"la maille","ar":"المال (عامي)","pos":"nom","g":"f","exFr":"Il manque de la maille en fin de mois.","ipa":"[maj]","exAr":"ينقصه المال في نهاية الشهر."},{"fr":"nickel","ar":"ممتاز / كل شيء على ما يرام","pos":"adj.","g":"m","exFr":"La chambre est nickel, merci !","ipa":"[ni.kɛl]","exAr":"الغرفة ممتازة، شكراً!"},{"fr":"ça roule","ar":"كل شيء يسير جيداً","pos":"loc.","g":"","exFr":"— Ça roule ? — Oui, ça roule.","ipa":"[sa ʁul]","exAr":"— كيف الأمور؟ — كل شيء جيد."},{"fr":"avoir la flemme","ar":"يشعّ بالكسل ولا يرغب بالحركة","pos":"loc.","g":"","exFr":"J’ai la flemme de cuisiner ce soir.","ipa":"[a.vwa la flɛm]","exAr":"لا أريد الطبخ هذا المساء."},{"fr":"la boîte","ar":"الشركة (عامي)","pos":"nom","g":"f","exFr":"Je travaille dans une petite boîte.","ipa":"[bwat]","exAr":"أعمل في شركة صغيرة."},{"fr":"le boss","ar":"المدير / المسؤول (عامي)","pos":"nom","g":"m","exFr":"Le boss a validé le projet.","ipa":"[bɔs]","exAr":"وافق المدير على المشروع."},{"fr":"ouf (verlan)","ar":"مجنون (من fou بقلب المقاطع)","pos":"nom","g":"m","exFr":"Il est complètement ouf, cet ami !","ipa":"[uf]","exAr":"إنه مجنون تماماً هذا الصديق!"}],"examples":[{"fr":"Je bosse dans une petite boîte du centre.","ar":"أعمل في شركة صغيرة وسط المدينة.","note":"bosser + la boîte"},{"fr":"Ce film est grave bien, tu vas kiffer.","ar":"هذا الفيلم رائع جداً، ستعشقه.","note":"grave + kiffer"},{"fr":"— Ça roule ? — Nickel, merci !","ar":"— كيف الأمور؟ — ممتاز، شكراً!","note":"ça roule / nickel"},{"fr":"J’ai la flemme de sortir, je reste à la maison.","ar":"لا أريد الخروج، سأبقى في البيت.","note":"avoir la flemme"},{"fr":"Le boss a dit carrément oui.","ar":"قال المدير نعم بكل صراحة.","note":"carrément"},{"fr":"Il est complètement ouf ce type !","ar":"هذا الشخص مجنون تماماً!","note":"verlan: fou → ouf"}],"grammar":[{"tFr":"Le familier poli : la frontière du registre","tAr":"العامية المهذّبة: حدود الطبقة اللغوية","body":["العامية المهذّبة تغيّر المفردات لا القواعد: « bosser » و« travailler » لهما نفس التصريف، لكن الأولى شائعة والثانية محايدة. القاعدة: استعمل العامية مع الأصدقاء والزملاء، واحتفظ بالمستوى courant مع المدير والكتابة.","خط أحمر واحد: الكلمات البذيئة والاستخفاف بالمرء لا تُستعمل مهما كان الطرف الآخر قريباً منك. العامية المهذّبة تُشعر طرفك بالقرب، أما البذاءة فتُغلق الحوار."],"ex":[{"fr":"Entre collègues : « Je bosse sur le dossier, ça roule ? »","ar":"بين الزملاء: «أعمل على الملف، كل شيء جيد؟»"},{"fr":"En courriel : « Je travaille sur le dossier, bien à vous. »","ar":"في البريد: «أعمل على الملف، مع خالص التحية.»"}]},{"tFr":"Le verlan : la règle de formation","tAr":"الفيرلان: قاعدة التكوين","body":["الفيرلان يقلب مقطعات الكلمة: fou → ouf, femme → meuf, arabe → beur. غالباً يُحذف الحرف الأخير الصامت في الخطوة الأولى، ثم يُقلب البقية مع تدوير الحركة الصوتية.","الاستعمال اليومي واسع في الأغاني والمسلسلات والحديث الشارعي، لكنه يبقى غير مناسب للكتابة الرسمية. افهمه جيداً لتسمعه، واستعمله بقدر لتتحدث مثل الباريسيين."],"ex":[{"fr":"C’est ouf, elle est partie sans dire au revoir !","ar":"مجنون ما حدث، لقد ذهبت بلا وداع!"},{"fr":"C’est une meuf très sympa.","ar":"إنها فتاة لطيفة جداً."}]}],"mistakes":[{"wrong":"استعمال العامية في سيرة ذاتية أو رسالة رسمية","right":"الكتابة دائماً بالمستوى courant","why":"العامية تُقرأ في السياق المهني كأنها قلة جدّية."},{"wrong":"الاعتقاد أن كل عامية بذيئة","right":"التمييز بين familier مقبول و vulgaire ممنوع","why":"مفردات مثل bosser و kiffer شائعة ومحفوظة في العلاقات العادية."},{"wrong":"استعمال الفيرلان في نص أكاديمي","right":"الفهم الشفهي للفيرلان دون إنتاجه كتابياً","why":"الفيرلان أصله شعبي ومناسب للكلام لا للكتابة."},{"wrong":"مبالغة استخدام العامية حتى مع الغرباء","right":"بدء المحادثة بالمستوى courant ثم التدرّج","why":"التدرّج يدلّ على المرونة اللغوية ويحفظ الموقف."}],"dialogues":[{"title":"Sur le quai du métro","ctx":"صديقان ينتظران القطار","lines":[{"who":"Karim","fr":"Ça roule pour ce soir ?","ar":"كيف الأمور بالنسبة للمساء؟"},{"who":"Léa","fr":"Grave ! On se fait un plan ?","ar":"رائع جداً! هل نرتب شيئاً؟"},{"who":"Karim","fr":"J’ai un peu la flemme, honnêtement.","ar":"لديّ قيلولة من الكسل، بصراحة."},{"who":"Léa","fr":"Vas-y, ça va être nickel, promis.","ar":"هيّا، سيكون كل شيء ممتازاً، وعد."}]},{"title":"Premier jour au bureau","ctx":"موظفة جديدة تقابل زميلها","lines":[{"who":"Thomas","fr":"Bienvenue dans la boîte ! Tu as vu le boss ?","ar":"مرحباً في الشركة! هل رأيت المدير؟"},{"who":"Nour","fr":"Pas encore, je commence lundi.","ar":"ليس بعد، أبدأ يوم الاثنين."},{"who":"Thomas","fr":"Carrément, tu bosses sur quel projet ?","ar":"تماماً، على أي مشروع ستشتغلين؟"},{"who":"Nour","fr":"Sur la communication, j’ai hâte.","ar":"على الاتصالات، لا أطيق الانتظار."}]}],"exercises":[{"t":"mcq","skill":"vocab","q":"ما معنى « bosser »؟","opts":["يأكل","يشتغل","ينام","يسافر"],"a":1,"why":"bosser = travailler بالعامية المقبولة."},{"t":"fill","skill":"grammar","q":"أكمل بالمستوى المناسب للبريد الرسمي: «Je ___ sur le dossier.»","fr":"Je ___ sur le dossier.","ans":"travaille","why":"الكتابة الرسمية تستخدم المستوى courant لا العامية."},{"t":"order","skill":"writing","q":"رتّب بالعامية المهذّبة: أعمل في شركة صغيرة وسط باريس.","words":["Je","bosse","dans","une","petite","boîte","au","centre","de","Paris."],"ans":"Je bosse dans une petite boîte au centre de Paris.","why":"العامية تحافظ على بنية الجملة نفسها مع مفردات bosser وboîte."},{"t":"mcq","skill":"vocab","q":"ما معنى « nickel »؟","opts":["fatigué","parfait, c’est réglé","fâché","en retard"],"a":1,"why":"nickel = parfait / c’est réglé."},{"t":"listen","skill":"listening","q":"استمع واختر الكلمة التي تعني: « إنه مجنون تماماً. »","opts":["Il est crevé","Il est ouf","Il est nickel","Il a la flemme"],"a":1,"why":"ouf هو verlan لكلمة fou = مجنون."},{"t":"translate","skill":"writing","q":"حوّل بعامية مهذّبة: «أنا متعب من العمل اليوم.»","ans":"Je suis crevé du boulot aujourd’hui.","why":"crevé و boulot من العامية المقبولة."},{"t":"speaking","skill":"speaking","q":"أدِّ دور الموظف الجديد وسلّم على زميلك بعامية مهذّبة.","target":"Ça roule ? / Nickel / Je bosse dans une boîte","why":"الإنتاج الشفهي للعامية في سياق اجتماعي واقعي."},{"t":"correct","skill":"grammar","q":"صحّح الطبقة اللغوية: «Cher Monsieur, j’ai grave envie de bosser avec vous.»","ans":"Cher Monsieur, je souhaite travailler avec vous.","why":"العامية لا تُستعمل في الخطاب الرسمي."}],"homework":"شاهد مشهداً قصيراً بعامية باريسية، اكتب عشر كلمات سمعتها، صنّفها إلى: مقبولة في العمل / للأصدقاء فقط، ثم استعمل أربع منها في حوار مكتوب من أربعة أسطر.","sources":[{"title":"Expressions Françaises célèbres - Français Niveau CECRL:A2/B2","channel":"Apprends Le Français Avec Nathan","videoId":"aknbO53lEyo","why":"شرح أشهر التعبيرات الفرنسية المشهورة بمستوى مدرسي مبسّط — أساس لفهم العامية المقبولة اجتماعياً في باريس.","cat":"Naturel","level":"B2","main":true},{"title":"Expression française, niveau B2","channel":"French School TV","videoId":"Dh3STYQ0yWM","why":"تدريب على التعبير الفرنسى بمستوى B2 يساعدك على الانتقال من العامية إلى التعبير المنظم.","cat":"Naturel","level":"B2","extra":true},{"title":"Tu connais ces mots ? Si oui, tu as le niveau B2-C1 !","channel":"MatthieuProfesseurFR","videoId":"wEiA2lg1Lqc","why":"اختبار سريع للمفردات المتقدمة يُظهر الفرق بين العامية والمفردات الأكاديمية.","cat":"Naturel","level":"B2","extra":true}],"supplements":[{"id":"Dh3STYQ0yWM","title":"Expression française, niveau B2","channel":"French School TV","why":"تدريب على التعبير الفرنسى بمستوى B2 يساعدك على الانتقال من العامية إلى التعبير المنظم.","lang":"fr","dur":15},{"id":"wEiA2lg1Lqc","title":"Tu connais ces mots ? Si oui, tu as le niveau B2-C1 !","channel":"MatthieuProfesseurFR","why":"اختبار سريع للمفردات المتقدمة يُظهر الفرق بين العامية والمفردات الأكاديمية.","lang":"fr","dur":5}]},{"id":"b2-t1-l5","fr":"Les faux-amis et pièges","ar":"الكلمات المخادعة والأخاديد اللغوية","objectives":["تمييز faux-amis الأساسية (actuellement, sensible, librairie, éventuellement)","اكتشاف الكلمة المخادعة قبل استخدامها في الكلام والكتابة","استبدال faux-amis بالكلمة الصحيحة حسب السياق","تحليل كيف تكشف faux-amis مستواك في النقاش والمكالمات المهنية"],"sections":[{"h":"الدرس 5: كلمات تخدعك لأنها تشبه لغتك","video":{"id":"hj7XUd-q8zY","title":"Faux-amis français : les erreurs qui trahissent les étrangers","channel":"Français Authentique","why":"شرح faux-amis الشائعة بين الإنجليزية والفرنسية: كيف تتجنّب أخطاء تكشف أنك أجنبي فوراً.","lang":"fr","main":true,"dur":14},"p":["المشكلة في faux-amis ليست في نقص المفردات بل في الوهم: الكلمة تبدو معروفة لأنها تشبه إنجليزية أو عربية، فتستخدمها بثقة ثم تكتشف أنها تعني شيئاً مختلفاً تماماً. « actuellement » بالفرنسية تعني « حالياً » لا « فعلياً »، و« librairie » مكتبة كتب لا مكتبة عامة.","معجم الدرس: le faux-ami, la correspondance trompeuse, la ressemblance, la signification, le sens propre, le sens figuré, la traduction littérale, le piège, la nuance, l’équivalent, l’usage, la méfiance. هذه المفردات تشرح mécanique الخداع.","نحوياً، faux-amis تخضع لنفس قواعد فعلها الحقيقي: « elle est sensible à la critique » (لا « sensible de »)، و« j’actuellement travaille » خطأ — الصحيح « je travaille actuellement ». الفعل السليم مع الكلمة الصحيحة هو شرط المصداقية.","الدرس الأهم: faux-amis لا تُضبط بالحفظ وحده بل بالسياق. كل كلمة تعلّمها اكتبها في جملة كاملة من مجالك (طب، قانون، تقنية، أعمال) — المعنى المزيف يظهر في الجملة لا في القاموس.","أكبر faux-amis في الوسط المهني: « assister à » تعني « يحضر » لا « يساعد » — « assister à une réunion » = حضور اجتماع، بينما « aider quelqu’un » = مساعدة. خلطهما يسبب موقفاً محرجاً في اجتماع.","بعد الدرس: اكتب عشر جمل تستخدم فيها عشر faux-amis مختلفة بشكل صحيح، ثم اطلب من ناطق أصلي تصحيحها — الملاحظة الأولى ستكتشف الخداع."],"sub":[{"h":"Faux-amis كلاسيكية","p":["actuellement = حالياً (لا « فعلياً »)","librairie = مكتبة كتب (لا « مكتبة عامة »)","sensible = حساس (لا « ذو معنى »)","éventuellement = ربما (لا « بالمناسبة »)"]},{"h":"في الوسط المهني","p":["assister à = يحضر (لا « يساعد »)","assister quelqu’un = يساعد (لا « يحضر »)","location = إيجار (لا « موقع »)","attendre = ينتظر (لا « يُنصّب »)"]},{"h":"خطوات التمحيص","p":["الخطوة الأولى: توقّف عند الكلمة المألوفة.","الثانية: اسأل عن المعنى الدقيق في السياق.","الثالثة: استبدل بالكلمة الصحيحة أو أعد الصياغة."]}]},{"h":"la carte des pièges","p":["« actuellement » = حالياً — الترجمة الخاطئة الأشهر عالمياً.","« librairie » = متجر كتب — la bibliothèque هي المكتبة العامة.","« assister à » = يحضر — لا تخلطها مع « aider ».","« éventuellement » = ربما — لا تعني « بالمناسبة » إطلاقاً."]},{"h":"التطبيق والتلخيص","p":["تمرين الكشف: اقرأ خمسة أسطر من تقرير مهني وحدّد فيها كل faux-ami ثم صحّحه.","تمرين التبديل: حوّل ثلاث جمل استخدمت فيها faux-ami خاطئاً إلى جمل صحيحة بنفس المعنى المقصود.","سجّل نفسك تشرح faux-ami واحدة بالفرنسية لزميل: « attention, actuellement ne veut pas dire… » — الشرح يثبّت الذاكرة."]},{"h":"التطبيق والتلخيص","p":["في هذا الدرس كشفت كيف تخدعك faux-amis: «actuellement» تعني حالياً لا فعلياً، و«librairie» متجر كتب لا مكتبة، و«assister à» تعني يحضر لا يساعد. تعلّمت خطوات la méfiance قبل أي كلمة مألوفة. أعد مشاهدة الفيديو الرئيسي وركّز على معنى actuellement وlibrairie وassister à الحقيقيين.","جسر الدروس: من b2-t1-l4 (العامية الباريسية المهذّبة والverlan) إلى b2-t1-l5 (الكلمات المخادعة وطرق كشفها)، ثم إلى b2-t1-l6 حيث تُتقن موسيقى الكلام والنبرة.","مهمة تطبيقية: سجّل دقيقة صوتية تشرح فيها موقفاً من يومك مستخدماً ثلاث كلمات جديدة من الدرس (actuellement، librairie، assister à)، ثم استمع للتسجيل وقارن نطقك ومفرداتك بما سمعته في الفيديو الرئيسي."]}],"pron":[{"w":"faux-ami","ipa":"[fo.z‿a.mi]","approx":"فو زامي"},{"w":"actuellement","ipa":"[ak.tɥɛl.mɑ̃]","approx":"أكتويلمان"},{"w":"librairie","ipa":"[li.bʁɛ.ʁi]","approx":"ليبرري"}],"vocab":[{"fr":"le faux-ami","ar":"الكلمة المخادعة","pos":"nom","g":"m","exFr":"« Actuellement » est un faux-ami classique.","ipa":"[fo.z‿a.mi]","exAr":"«actuellement» كلمة مخادعة كلاسيكية."},{"fr":"la signification","ar":"المعنى / الدلالة","pos":"nom","g":"f","exFr":"La vraie signification n’est pas celle qu’on croit.","ipa":"[si.ni.fi.ka.sjɔ̃]","exAr":"المعنى الحقيقي ليس ما نظنه."},{"fr":"la ressemblance","ar":"التشابه","pos":"nom","g":"f","exFr":"La ressemblance avec l’anglais est trompeuse.","ipa":"[ʁɛ.zə.blɑ̃s]","exAr":"التشابه مع الإنجليزية مضلّل."},{"fr":"le piège","ar":"الفخ","pos":"nom","g":"m","exFr":"C’est un piège pour les débutants.","ipa":"[pjɛʒ]","exAr":"هذا فخ للمبتدئين."},{"fr":"la traduction littérale","ar":"الترجمة الحرفية","pos":"nom","g":"f","exFr":"La traduction littérale crée des erreurs.","ipa":"[ta.dyk.sjɔ̃ li.tɛ.ʁal]","exAr":"الترجمة الحرفية تسبب أخطاء."},{"fr":"le sens propre","ar":"المعنى الأصلي","pos":"nom","g":"m","exFr":"Ici, le sens propre ne convient pas.","ipa":"[sɑ̃ pʁɔp]","exAr":"هنا المعنى الأصلي لا يناسب."},{"fr":"le sens figuré","ar":"المعنى المجازي","pos":"nom","g":"m","exFr":"Le sens figuré est plus courant.","ipa":"[sɑ̃ fi.ɡy.ʁe]","exAr":"المعنى المجازي أكثر شيوعاً."},{"fr":"la nuance","ar":"التمييز الدقيق","pos":"nom","g":"f","exFr":"Il faut saisir la nuance entre les deux.","ipa":"[nɥɑ̃s]","exAr":"يجب التقاط التمييز بين الاثنين."},{"fr":"l’équivalent","ar":"المرادف المكافئ","pos":"nom","g":"m","exFr":"Quel est l’équivalent français ?","ipa":"[e.ki.və.lɑ̃]","exAr":"ما هو المكافئ الفرنسي؟"},{"fr":"détromper","ar":"يُزيل الوهم / يصحّح التصور الخاطئ","pos":"verbe","g":"","exFr":"Je vais vous détromper sur ce mot.","ipa":"[de.tʁɔ̃.pe]","exAr":"سأزيل الوهم عنك حول هذه الكلمة."},{"fr":"méfier (se)","ar":"يحذر","pos":"verbe","g":"","exFr":"Méfiez-vous des faux-amis.","ipa":"[me.fje]","exAr":"احذر الكلمات المخادعة."},{"fr":"trahir","ar":"يفضح / يكشف","pos":"verbe","g":"","exFr":"Cette erreur trahit un niveau moyen.","ipa":"[tʁiʁ]","exAr":"هذه الخطأ تكشف مستوى متوسطاً."}],"examples":[{"fr":"Je suis actuellement à Paris.","ar":"أنا حالياً في باريس.","note":"actuellement = حالياً"},{"fr":"Je vais à la librairie acheter un roman.","ar":"أذهب إلى متجر الكتب لشراء رواية.","note":"librairie ≠ bibliothèque"},{"fr":"Elle est très sensible aux critiques.","ar":"إنها حساسة جداً تجاه الانتقادات.","note":"sensible = حساس"},{"fr":"Il assiste à la réunion de demain.","ar":"سيحضر اجتماع الغد.","note":"assister à = يحضر"},{"fr":"Pourriez-vous m’assister ?","ar":"هل يمكنكم مساعدتي؟","note":"assister quelqu’un = يساعد"},{"fr":"Il va éventuellement venir.","ar":"ربما سيأتي.","note":"éventuellement = ربما"}],"grammar":[{"tFr":"Faux-amis : les paires les plus dangereuses","tAr":"الكلمات المخادعة: أخطر الثنائيات","body":["« actuellement » = حالياً لا « فعليement »، و« librairie » = متجر كتب لا مكتبة، و« sensé » = ينبغي أن (من la seule) لا « ذكي ».","« une heureux hasard » خطأ نحوي — الصحيح « un heureux hasard »: la fausse analogie avec l’anglais « an hour » تسبب خطأ الجنس."],"ex":[{"fr":"Actuellement, je travaille à Lyon.","ar":"حالياً، أعمل في ليون."},{"fr":"Un heureux hasard nous a réunis.","ar":"صدفة سعيدة جمعتنا."}]},{"tFr":"« Assister à » vs « aider »","tAr":"« يحضر » مقابل « يساعد »","body":["« assister à quelque chose » = être présent à un événement. « assister quelqu’un » = l’aider. la distinction essentielle dans le milieu professionnel.","الخطأ الشائع: « je vais vous assister dans cette tâche » إذا كنت تقصد الحضور — الصواب « je vais assister à cette tâche » للمتابعة أو « je vais vous aider » للمساعدة."],"ex":[{"fr":"Elle assiste au séminaire.","ar":"تحضر الورشة."},{"fr":"Pouvez-vous m’assister ?","ar":"هل يمكنك مساعدتي؟"}]}],"mistakes":[{"wrong":"Confondre « actuellement » et « actuellement » ou « actually »","right":"actuellement = حالياً فقط","why":"الخطأ الأكثر تكراراً لدى المتعلمين في كل المستويات."},{"wrong":"Utiliser « librairie » pour la bibliothèque publique","right":"librairie = متجر الكتب، bibliothèque = المكتبة","why":"الفرق العملي الكبير في الاستخدام اليومي."},{"wrong":"« Je vais vous assister » au lieu de « je vais vous aider »","right":"aider quelqu’un pour la aide","why":"assister avec personne = aider فقط."},{"wrong":"الثقة الزائدة في الكلمات الشبيهة","right":"la vérification systématique dans le contexte","why":"faux-amis تخدع بالثقة لا بالجهل."}],"dialogues":[{"title":"la correction","ctx":"زميلان يراجعان تقريراً","lines":[{"who":"Sophie","fr":"J’ai écrit : « j’actuellement gère le projet ».","ar":"كتبت: «أنا حالياً أدير المشروع»."},{"who":"Karim","fr":"« Actuellement » est un faux-ami : dire « maintenant ».","ar":"«actuellement» كلمة مخادعة: تعني «الآن»."},{"who":"Sophie","fr":"D’accord, et « sensé » alors ?","ar":"حسناً، و«sensé» إذن؟"},{"who":"Karim","fr":"« Il est sensé venir » — c’est « il devrait ».","ar":"«il est sensé venir» تعني «ينبغي أن يأتي»."}]},{"title":"la réunion","ctx":"مكالمة عمل","lines":[{"who":"Claire","fr":"Vous assistez à la réunion de jeudi ?","ar":"هل تحضر اجتماع الخميس؟"},{"who":"Olivier","fr":"Oui, j’assiste. Vous avez besoin d’aide ?","ar":"نعم سأحضر. هل تحتاج مساعدة؟"},{"who":"Claire","fr":"Oui, merci, vous pouvez m’assister sur le budget.","ar":"نعم شكراً، يمكنك مساعدتي في الميزانية."},{"who":"Olivier","fr":"Parfait, je vous assisterai.","ar":"ممتاز، سأساعدك."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما معنى « actuellement »؟","opts":["حالياً","فعلياً","سابقاً","دائماً"],"a":0,"why":"actuellement = حالياً، الترجمة الخاطئة الأشهر."},{"t":"fill","skill":"grammar","q":"أكمل: «Il ___ à la réunion.» (يحضر)","fr":"Il ___ à la réunion.","ans":"assist","why":"assister à = يحضر الحدث."},{"t":"mcq","skill":"vocabulary","q":"أي كلمة تعني « متجر الكتب »؟","opts":["la librairie","la bibliothèque","la papeterie","la médiathèque"],"a":0,"why":"librairie = متجر الكتب، la bibliothèque = المكتبة العامة."},{"t":"order","skill":"writing","q":"رتّب: أنا أدير المشروع حالياً","words":["Je","gère","le","projet","actuellement."],"ans":"Je gère le projet actuellement.","why":"ترتيب الجملة الفرنسية العادي + faux-ami الصحيح."},{"t":"listen","skill":"listening","q":"ما « librairie » في هذه الجملة؟","opts":["متجر كتب","مكتبة عامة","مكتب","مطبعة"],"a":0,"why":"librairie ≠ bibliothèque."},{"t":"translate","skill":"writing","q":"ترجم: «أحضر الورشة صباحاً.»","ans":"J’assiste au séminaire le matin.","why":"assister à un événement = يحضره."},{"t":"speaking","skill":"speaking","q":"اشرح faux-ami بالفرنسية وزميلك يستخدمها بشكل خاطئ — صحّحه بنبرة مهذّبة.","target":"actuellement / librairie / assister à","why":"الشرح يثبّت faux-amis في الذاكرة."},{"t":"correct","skill":"grammar","q":"صحّح: «Je suis actuellement fatigué mais actuellement je travaille.»","ans":"Je suis très fatigué mais actuellement je travaille.","why":"actuellement تعني حالياً فقط، تكرارها بلا معنى مضلل."}],"homework":"اقرأ مقالاً فرنسياً قصيراً، احتسب faux-amis فيه، واكتب لكل واحدة جملة صحيحة من مجالك المهني.","sources":[{"title":"Faux-amis français : les erreurs qui trahissent les étrangers","channel":"Français Authentique","videoId":"hj7XUd-q8zY","why":"شرح faux-amis الشائعة بين الإنجليزية والفرنسية: كيف تتجنّب أخطاء تكشف أنك أجنبي فوراً.","cat":"Naturel","level":"B2","main":true},{"title":"Faux amis français : évitez les pièges","channel":"Français Authentique","videoId":"R3GIYkOsrxc","why":"قائمة منظمة بأخطر faux-amis مع أمثلة سياقية.","cat":"Naturel","level":"B2","extra":true},{"title":"Les expressions que les étrangers confondent","channel":"French with Alicia","videoId":"QhysP1PazZA","why":"أخطاء شائعة تكشف الأجنبي وطرق تجنّبها.","cat":"Naturel","level":"B2","extra":true}],"supplements":[{"id":"R3GIYkOsrxc","title":"Faux amis français : évitez les pièges","channel":"Français Authentique","why":"قائمة منظمة بأخطر faux-amis مع أمثلة سياقية.","lang":"fr","dur":13},{"id":"QhysP1PazZA","title":"Les expressions que les étrangers confondent","channel":"French with Alicia","why":"أخطاء شائعة تكشف الأجنبي وطرق تجنّبها.","lang":"fr","dur":10}]},{"id":"b2-t1-l6","fr":"Le rythme et la musique","ar":"الإيقاع والموسيقى في الكلام","objectives":["فهم la mélodie la langue الفرنسية: montée, chute, pause","تمييز la musique la langue عن la logique la phrase","توظيف le rythme في الحديث اليومي والمهني","تحليل la prosodie la langue لتحسين la compréhension"],"sections":[{"h":"الدرس 6: كيف تُدخل الموسيقى على كلامك الفرنسي","video":{"id":"aknbO53lEyo","title":"La musique du français : le rythme des phrases","channel":"Français Authentique","why":"شرح la mélodie la langue الفرنسية: كيف يُغيّر الإيقاع معنى الجملة ونبرتها، وكيف تتكلّم بسلاسة.","lang":"fr","main":true,"dur":16},"p":["la langue الفرنسية لها موسيقى خاصة بها: la montée la voix في الأسئلة، la chute la voix في الجمل الخبرية، وla pause la phrase الطويلة. فهم la musique يُحسّن la compréhension ويُجعل حديثك أكثر طبيعية.","معجم الدرس: la mélodie, le rythme, la prosodie, la cadence, l’intonation, la montée, la chute, le stress, l’accent tonique, la fluidité, la musicalité, le tempo. هذه المفردات تشرح mécanique la musique la langue.","نحوياً، la musique تُغيّر معنى الجملة: « Tu viens ? » مع la montée = سؤال، و« Tu viens. » مع la chute = تأكيد. la prosodie هي التي تُحدّد la fonction la phrase لا la structure فقط.","الدرس الأهم: la musique لا تتطلب la perfection — تتطلب la conscience. أنت لا تحتاج أن تتكلم مثل chanteur — تحتاج أن تسمع la musique la langue وتُحاكيها.","بعد الدرس، استمع لمحادثة طبيعية وحاول la reproduction la musique لا la reproduction la mots — أعد بناء la phrase بنفس la cadence لا بنفس la prononciation فقط.","الخلاصة: la musique la française تُجعل حديثك أكثر طبيعية — la compréhension la musique تُحسّن la production la parole."],"sub":[{"h":"la mélodie la phrase","p":["« Tu viens ? » — la montée la voix = سؤال.","« Tu viens. » — la chute la voix = تأكيد.","« C’est vrai ? » — la montée la surprise.","« C’est vrai. » — la chute la conviction."]},{"h":"le rythme la phrase الطويلة","p":["« Il faut, / avant tout, / que tu viennes. » — la pause la phrase.","« Quand tu auras le temps, / tu m’appelleras. » — la cadence la subordonnée.","« Bien que fatigué, / il travaille encore. » — le rythme la concession."]},{"h":"خطوات la pratique","p":["المرة الأولى: استمع la musique لا la mots.","الثانية: أعد بناء la phrase بنفس la cadence.","الثالثة: سجّل نفسك وقارنه بالنموذج."]}]},{"h":"la carte la musique","p":["« Tu viens ? » — la montée la voix = سؤال مفتوح.","« Tu viens. » — la chute la voix = تأكيد.","« C’est vrai ? » — la montée la surprise.","« C’est vrai. » — la chute la conviction."]},{"h":"التطبيق والتلخيص","p":["تمرين la reproduction: استمع لجملة فرنسية وأعد بناءها بنفس la cadence لا la mots فقط.","تمرين la bascule: حوّل ثلاث جمل خبرية إلى أسئلة باستخدام la montée la voix.","سجّل نفسك تتكلم بـ la musique la française: la montée la voix، la chute la voix، la pause la phrase — la mémoire la bouche."]},{"h":"التطبيق والتلخيص","p":["تعلّمت أن la langue الفرنسية لها موسيقى: la montée la voix في الأسئلة، وla chute la voix في الجمل الخبرية، وla pause la phrase الطويلة. فهم la musique يُحسّن la compréhension. أعد مشاهدة الفيديو الرئيسي وركّز على صعود الصوت في الأسئلة وهبوطه في الأخبار.","جسر الدروس: من b2-t1-l5 (الكلمات المخادعة وطرق كشفها) إلى b2-t1-l6 (موسيقى الكلام: النبرة والإيقاع)، ثم إلى b2-t2-l1 حيث تبني خطابك الحجاجي ببنية واضحة.","مهمة تطبيقية: سجّل دقيقة صوتية تشرح فيها موقفاً من يومك مستخدماً ثلاث كلمات جديدة من الدرس (la montée، la chute، la pause)، ثم استمع للتسجيل وقارن نطقك ومفرداتك بما سمعته في الفيديو الرئيسي."]}],"pron":[{"w":"la mélodie","ipa":"[me.lo.di]","approx":"ميلودي"},{"w":"le rythme","ipa":"[ʁit.m]","approx":"ريتم"},{"w":"la prosodie","ipa":"[pʁɔ.zɔ.di]","approx":"بروزودي"}],"vocab":[{"fr":"la mélodie","ar":"اللحن","pos":"nom","g":"f","exFr":"La mélodie française est particulière.","ipa":"[me.lo.di]","exAr":"اللحن الفرنسي خاص."},{"fr":"le rythme","ar":"الإيقاع","pos":"nom","g":"m","exFr":"Le rythme de la phrase est important.","ipa":"[ʁit.m]","exAr":"إيقاع الجملة مهم."},{"fr":"la prosodie","ar":"العلم الصوتي","pos":"nom","g":"f","exFr":"La prosodie étudie l’intonation.","ipa":"[pʁɔ.zɔ.di]","exAr":"العلم الصوتي يدرس la intonation."},{"fr":"la cadence","ar":"الإيقاع الموحد","pos":"nom","g":"f","exFr":"La cadence est naturelle ici.","ipa":"[ka.dɑ̃s]","exAr":"الإيقاع الموحد طبيعي هنا."},{"fr":"l’intonation","ar":"النبرة","pos":"nom","g":"f","exFr":"L’intonation change le sens.","ipa":"[ɛ̃.tɔ.na.sjɔ̃]","exAr":"النبرة تُغيّر المعنى."},{"fr":"la montée","ar":"الصعود","pos":"nom","g":"f","exFr":"La montée la voix indique une question.","ipa":"[mɔ̃.te]","exAr":"la صعود la voix يُشير إلى سؤال."},{"fr":"la chute","ar":"الهبوط","pos":"nom","g":"f","exFr":"La chute la voix indique un fait.","ipa":"[ʃyt]","exAr":"la هبوط la voix يُشير إلى حقيقة."},{"fr":"la musicalité","ar":"الطابع الموسيقي","pos":"nom","g":"f","exFr":"La musicalité française est importante.","ipa":"[my.zi.za.li.te]","exAr":"الطابع الموسيقي الفرنسي مهم."},{"fr":"le tempo","ar":"السرعة الإيقاعية","pos":"nom","g":"m","exFr":"Le tempo est modéré ici.","ipa":"[tɛm.po]","exAr":"la السرعة الإيقاعية معتدلة هنا."},{"fr":"articuler","ar":"يفصل الكلمات بوضوح","pos":"verbe","g":"","exFr":"Il articule chaque syllabe.","exAr":"يفصل كل مقطع بوضوح.","ipa":"[aʁ.ti.ky.le]"},{"fr":"percevoir","ar":"يدرك صوتاً / يستشعر","pos":"verbe","g":"","exFr":"Je perçois mieux les intonations.","exAr":"أدرك النبرات بشكل أفضل.","ipa":"[pəʁ.svwaʁ]"},{"fr":"le phrasé","ar":"تقسيم العبارة بالنَّفَس","pos":"nom","g":"m","exFr":"Le phrasé rend la phrase plus claire.","exAr":"تقسيم العبارة يجعلها أوضح.","ipa":"[pʁa.ze]"}],"examples":[{"fr":"Tu viens ? — la montée la voix.","ar":"هل تأتي؟ — la صعود la voix.","note":"la mélodie"},{"fr":"Tu viens. — la chute la voix.","ar":"أنت تأتي. — la هبوط la voix.","note":"la mélodie"},{"fr":"Il faut, avant tout, que tu viennes.","ar":"يجب، فوق كل شيء، أن تأتي.","note":"le rythme"},{"fr":"Quand tu auras le temps, tu m’appelleras.","ar":"عندما يكون لديك الوقت، ستتصل بي.","note":"la cadence"},{"fr":"Bien que fatigué, il travaille encore.","ar":"رغم أنه متعب، لكنه لا يزال يعمل.","note":"le rythme"},{"fr":"C’est vrai ? — la montée la surprise.","ar":"صحيح؟ — la صعود la surprise.","note":"la mélodie"}],"grammar":[{"tFr":"La mélodie la phrase","tAr":"la mélodie la phrase","body":["« Tu viens ? » — la montée la voix = سؤال. « Tu viens. » — la chute la voix = تأكيد. la prosodie هي التي تُحدّد la fonction la phrase.","la musique لا تتطلب la perfection — تتطلب la conscience. أنت لا تحتاج أن تتكلم مثل chanteur — تحتاج أن تسمع la musique la langue وتُحاكيها."],"ex":[{"fr":"Tu viens ? — la montée la voix.","ar":"هل تأتي؟ — la صعود la voix."},{"fr":"Tu viens. — la chute la voix.","ar":"أنت تأتي. — la هبوط la voix."}]},{"tFr":"Le rythme la phrase الطويلة","tAr":"le rythme la phrase الطويلة","body":["« Il faut, avant tout, que tu viennes. » — la pause la phrase. « Quand tu auras le temps, tu m’appelleras. » — la cadence la subordonnée.","la musique تُغيّر معنى الجملة: la montée la voix في الأسئلة، la chute la voix في الجمل الخبرية، وla pause la phrase الطويلة."],"ex":[{"fr":"Il faut, avant tout, que tu viennes.","ar":"يجب، فوق كل شيء، أن تأتي."},{"fr":"Quand tu auras le temps, tu m’appelleras.","ar":"عندما يكون لديك الوقت، ستتصل بي."}]}],"mistakes":[{"wrong":"la ignorance la musique","right":"la conscience la musique","why":"la musique لا تتطلب la perfection — تتطلب la conscience."},{"wrong":"la confusion la montée la chute","right":"la distinction la montée la chute","why":"la montée la voix في الأسئلة، la chute la voix في الجمل الخبرية."},{"wrong":"la lecture la musique","right":"la distinction la forme écrite المنطوقة","why":"la lecture تُفقد la naturalité."},{"wrong":"la reproduction la mots","right":"la reproduction la cadence","why":"la musique هي la cible لا la mots."}],"dialogues":[{"title":"la musique","ctx":"معلم يشرح la musique la française","lines":[{"who":"Prof","fr":"« Tu viens ? » — la montée la voix.","ar":"«Tu viens?» — la صعود la voix."},{"who":"Élève","fr":"Et « Tu viens. » ?","ar":"و «Tu viens.»؟"},{"who":"Prof","fr":"La chute la voix — c’est un fait.","ar":"la هبوط la voix — إنها حقيقة."},{"who":"Élève","fr":"D’accord, j’ai compris la musique.","ar":"أوكي، جاي كوبراني la musique."}]},{"title":"la pratique","ctx":"استوديو تسجيل","lines":[{"who":"Marc","fr":"La musicalité est importante.","ar":"الطابع الموسيقي مهم."},{"who":"Nadia","fr":"Le rythme est modéré.","ar":"الإيقاع معتدل."},{"who":"Marc","fr":"La mélodie est naturelle.","ar":"اللحن طبيعي."},{"who":"Nadia","fr":"La cadence est parfaite.","ar":"الإيقاع الموحد مثالي."}]}],"exercises":[{"t":"mcq","skill":"listening","q":"ما la fonction la phrase مع la montée la voix؟","opts":["سؤال","تأكيد","أمر","تعجب"],"a":0,"why":"la montée la voix = سؤال."},{"t":"fill","skill":"grammar","q":"أكمل: «Il faut, avant tout, ___ tu viennes.»","fr":"Il faut, avant tout, ___ tu viennes.","ans":"que","why":"que la conjunction la phrase المركبة."},{"t":"mcq","skill":"listening","q":"ما la fonction la phrase مع la chute la voix؟","opts":["سؤال","تأكيد","أمر","تعجب"],"a":0,"why":"la chute la voix = تأكيد."},{"t":"order","skill":"writing","q":"رتّب: يجب أن تأتي فوق كل شيء","words":["Il","faut,","avant","tout,","que","tu","viennes."],"ans":"Il faut, avant tout, que tu viennes.","why":"la pause la phrase."},{"t":"listen","skill":"listening","q":"ما la musique la phrase « Tu viens ? »؟","opts":["la montée la voix","la chute la voix","la pause la phrase","la cadence la subordonnée"],"a":0,"why":"la montée la voix = سؤال."},{"t":"translate","skill":"writing","q":"ترجم: «عندما يكون لديك الوقت، ستتصل بي.»","ans":"Quand tu auras le temps, tu m’appelleras.","why":"la cadence la subordonnée."},{"t":"speaking","skill":"speaking","q":"استمع لمحادثة فرنسية وأعد بناء ما سمعت بالكتابة.","target":"la montée / la chute / la pause","why":"la compréhension la musique."},{"t":"correct","skill":"grammar","q":"صحّح: «Tu viens. — la montée la voix.»","ans":"Tu viens ? — la montée la voix.","why":"la montée la voix = سؤال لا تأكيد."}],"homework":"استمع لمحادثة فرنسية، حوّل la musique la phrase إلى la forme écrite، ثم سجّل نفسك تتكلم بنفس la cadence.","sources":[{"title":"La musique du français : le rythme des phrases","channel":"Français Authentique","videoId":"aknbO53lEyo","why":"شرح la mélodie la langue الفرنسية: كيف يُغيّر الإيقاع معنى الجملة ونبرتها، وكيف تتكلّم بسلاسة.","cat":"Naturel","level":"B2","main":true},{"title":"L’intonation en français : montée et chute","channel":"Français Authentique","videoId":"dEnQwaXT1sk","why":"شرح la mélodie la langue الفرنسية: la montée la voix la chute la voix.","cat":"Naturel","level":"B2","extra":true},{"title":"La prosodie française : le guide complet","channel":"French with Alicia","videoId":"IQs2-izz4aM","why":"دليل شامل لـ la prosodie la française: la cadence la musicalité la tempo.","cat":"Naturel","level":"B2","extra":true}],"supplements":[{"id":"dEnQwaXT1sk","title":"L’intonation en français : montée et chute","channel":"Français Authentique","why":"شرح la mélodie la langue الفرنسية: la montée la voix la chute la voix.","lang":"fr","dur":14},{"id":"IQs2-izz4aM","title":"La prosodie française : le guide complet","channel":"French with Alicia","why":"دليل شامل لـ la prosodie la française: la cadence la musicalité la tempo.","lang":"fr","dur":18}]}]},{"id":"b2-t2","slug":"debattre-et-argumenter","icon":"chat","color":"#ca8a04","fr":"Débattre et argumenter","ar":"النقاش والحجاج","desc":"la structuration، la réfutation، les sophismes، ثم la prise de parole — la boîte à outils la débat.","lessons":[{"id":"b2-t2-l1","fr":"Structurer une argumentation","ar":"بناء الحجاج وتنظيمه","objectives":["تقسيم الحجاج إلى أطوار واضحة: طرح الفكرة، التعليل، المثال، الخاتمة","استعمال أدوات التنظيم دون تكرار (d’une part, par ailleurs, c’est pourquoi)","إضافة اعتراض ثم الرد عليه بأسلوب مهذّب","إنتاج فقرة حجاجية من ست جمل على الأقل ببنية منطقية"],"sections":[{"h":"الدرس 1: كيف تبني خطاباً مقنعاً خطوة بخطوة","video":{"id":"MEf8oQXG-OE","title":"Comment bien argumenter en français - Vocabulaire pour structurer une argumentation","channel":"Le français by Alex","why":"مفردات توظيف الحجاج بالفرنسية: كيف تقدّم فكرتك، وتؤيدها، ثم تردّ على الاعتراضات.","lang":"fr","main":true,"dur":16},"p":["الحجاج (argumentation) ليس جمع أسباب عشوائية، بل بناء منظّم: طرح الفكرة (thèse)، ثم دعمها بتعليل ومثال، ثم اعتراض مقبول والرد عليه، ثم خاتمة تعيد صياغة الفكرة. هذا هو الهيكل الذي يبحث عنه الفرنسي في نقاشك.","معجم الحجاج: la thèse, l’argument, l’exemple, la concession, la réfutation, la nuance, la synthèse, le connecteur, soutenir, objecter, accorder, démontrer. احفظ كل كلمة مع دورها في البنية لا بالترجمة وحدها.","نحوياً، الحجاج يعتمد على الجمل الوصفية والجمل المركّبة: « Bien que les chiffres soient favorables, ... » (subjonctif)، و« Même si la crise dure, ... » (indicatif)، و« Étant donné que... » لتقديم السبب. هذه التراكيب هي إشارة أنك تُنظّم فكرك لا أنك تسرد.","أداة النبرة: الاعتراف بالرأي المقابل قبل الرد عليه يرفع قناعتك كثيراً. الصيغة الكلاسيكية: « Certes, ... mais ... » أو « Il est vrai que ... toutefois ...». الفرنسيون يقدّرون التفوق المنطقي أكثر من الإنكار المباشر.","قاعدة الأرقام والترتيب: ابدأ بأقوى حجة، ثم ثبّتها بمثال ملموس، واترك الاعتراض في الوسط حيث يمكن الرد عليه بهدوء. النقاش لا يُربح بطول الجمل بل بوضوح الترتيب.","بعد الدرس: اكتب فقرة حجاجية من 120 كلمة حول قضية تهمك، وحدّد بتحشير (باللون) كل أداة تنظيم ودور كل منها: طرح، تعليل، اعتراض، رد، خاتمة."],"sub":[{"h":"Annoncer sa thèse","p":["Je soutiens que le télétravail améliore la productivité.","À mon avis, l’école doit apprendre à débattre.","Pour moi, la priorité réside dans la formation."]},{"h":"Développer et illustrer","p":["En effet, les chiffres le confirment sans équivoque.","Par exemple, une étude récente le démontre.","De plus, cet argument se renforce avec l’expérience."]},{"h":"Concéder et réfuter","p":["Certes, les coûts sont élevés, mais le résultat durable.","Il est vrai que l’objection est légitime, toutefois elle néglige un point.","Cependant, cette vision ne résiste pas à l’analyse."]}]},{"h":"Les cinq pièces maîtresses de l’argumentation","p":["« Je soutiens que... » — annoncer sa thèse sans agressivité.","« En effet, ... » — apporter la preuve qui soutient ce qu’on vient de dire.","« Certes, ... mais ... » — concéder un point puis reprendre l’avantage.","« C’est pourquoi... » — tirer la conséquence et préparer la conclusion."]},{"h":"التطبيق والتلخيص","p":["تمرين الهيكل: خمس عناوين فارغة (Thèse / Argument / Exemple / Concession / Synthèse) — ضع جملة واحدة في كل عنوان من قضية واحدة.","تمرين التبديل: أعد كتابة نفس الفقرة بترتيب نظري (فرضية ثم دليل) ثم بترتيب قوّة (أقوى حجة أولاً) ولاحظ الفرق في الإقناع.","تمرين الحوار: سجّل دقيقة ترد فيها على اعتراض واحد بصيغة « Certes ... toutefois ... » بنبرة هادئة واثقة."]},{"h":"التطبيق والتلخيص","p":["في هذا الدرس بنيت الحجاج خطوة بخطوة: طرح la thèse، ثم التعليل، ثم المثال، ثم la concession و la réfutation، ثم la synthèse. فهمت أن التنظيم يُقنع أكثر من جمع الأسباب. أعد مشاهدة الفيديو الرئيسي وركّز على الترتيب: فكرة، تعليل، مثال، اعتراض، خاتمة.","جسر الدروس: من b2-t1-l6 (موسيقى الكلام: النبرة والإيقاع) إلى b2-t2-l1 (بناء الحجاج وتنظيم أطواره)، ثم إلى b2-t2-l2 حيث تربط أفكارك بأدوات منطقية دقيقة.","مهمة تطبيقية: سجّل دقيقة صوتية تشرح فيها موقفاً من يومك مستخدماً ثلاث كلمات جديدة من الدرس (la thèse، l’argument، la concession)، ثم استمع للتسجيل وقارن نطقك ومفرداتك بما سمعته في الفيديو الرئيسي."]}],"pron":[{"w":"thèse","ipa":"[tɛz]","approx":"تيز"},{"w":"concession","ipa":"[kɔ̃.sɛ.sjɔ̃]","approx":"كونسيسيون"},{"w":"réfutation","ipa":"[ʁe.fy.ta.sjɔ̃]","approx":"ريفيتاسيون"}],"vocab":[{"fr":"la thèse","ar":"الفكرة الأساسية المراد إثباتها","pos":"nom","g":"f","exFr":"Ma thèse est simple : il faut agir vite.","ipa":"[tɛz]","exAr":"فكرتي الأساسية بسيطة: يجب التحرك بسرعة."},{"fr":"l’argument","ar":"الحجة الداعمة","pos":"nom","g":"m","exFr":"C’est mon argument le plus solide.","ipa":"[aʁ.ɡmɑ̃]","exAr":"هذه أقوى حججي."},{"fr":"l’exemple","ar":"المثال التوضيحي","pos":"nom","g":"m","exFr":"Prenons un exemple concret.","ipa":"[ɛɡ.zɑ̃pl]","exAr":"لنأخذ مثالاً ملموساً."},{"fr":"la concession","ar":"الاعتراف برأي المقابل","pos":"nom","g":"f","exFr":"La concession rend le ton plus crédible.","ipa":"[kɔ̃.sɛ.sjɔ̃]","exAr":"الاعتراف بالرأي المقابل يجعل النبرة أكثر مصداقية."},{"fr":"la réfutation","ar":"الرد على الاعتراض","pos":"nom","g":"f","exFr":"Sa réfutation a convaincu le jury.","ipa":"[ʁe.fy.ta.sjɔ̃]","exAr":"رده على الاعتراض أقنع اللجنة."},{"fr":"le fil directeur","ar":"الخيط الحاكم للفكرة","pos":"nom","g":"m","exFr":"Le fil directeur guide le lecteur.","exAr":"الخيط الحاكم يقود القارئ.","ipa":"[fi l di.ʁɛk.tœʁ]"},{"fr":"la synthèse","ar":"التلخيص النهائي","pos":"nom","g":"f","exFr":"La synthèse du débat tient en trois points.","ipa":"[sɛ̃.tɛz]","exAr":"تلخيص النقاش في ثلاث نقاط."},{"fr":"soutenir","ar":"يدعم / يصرّ على","pos":"verbe","g":"","exFr":"Il soutient son propos avec des chiffres.","ipa":"[sutniʁ]","exAr":"يدعم كلامه بالأرقام."},{"fr":"objecter","ar":"يُبدئ اعتراضاً","pos":"verbe","g":"","exFr":"On peut objecter que le coût est réel.","ipa":"[ɔb.ʒɛkte]","exAr":"يمكن الاعتراض بأن التكلفة حقيقية."},{"fr":"accorder","ar":"يُقرّ / ينحني لرأي الآخر","pos":"verbe","g":"","exFr":"J’accorde ce point à mon opposant.","ipa":"[a.kɔʁ.de]","exAr":"أُقرّ لهذا الطرف بهذا الأمر."},{"fr":"démontrer","ar":"يثبت بالدليل","pos":"verbe","g":"","exFr":"Cette expérience démontre le bien-fondé du projet.","ipa":"[de.mɔ̃tʁe]","exAr":"هذا التجربة تثبت صحة المشروع."},{"fr":"le connecteur","ar":"أداة الربط المنطقي","pos":"nom","g":"m","exFr":"Le connecteur « néanmoins » annonce une nuance.","ipa":"[kɔ̃.nɛktœʁ]","exAr":"أداة الربط «néanmoins» تمهّد لتمييز منطقي."}],"examples":[{"fr":"Je soutiens que les transports en commun doivent rester gratuits.","ar":"أصرّ على أن وسائل النقل العام يجب أن تبقى مجانية.","note":"annoncer la thèse"},{"fr":"En effet, les chiffres le confirment depuis trois ans.","ar":"والدليل فالأرقام تؤكده منذ ثلاث سنوات.","note":"apporter la preuve"},{"fr":"Certes, le budget est limité, mais l’investissement paiera.","ar":" صحيح أن الميزانية محدودة، لكن الاستثمار سيسترد كلفته.","note":"concession"},{"fr":"Il est vrai que l’objection est légitime, toutefois elle néglige un détail.","ar":"صحيح أن الاعتراض مشروع، لكنه يُهمل تفصيلاً.","note":"concession + nuance"},{"fr":"Par exemple, une étude de 2025 le démontre clairement.","ar":"على سبيل المثال، دراسة عام 2025 تثبت ذلك بوضوح.","note":"illustrer"},{"fr":"C’est pourquoi je propose un calendrier réaliste.","ar":"لهذا السبب أقترح جدولاً زمنياً واقعياً.","note":"tirer la conséquence"}],"grammar":[{"tFr":"La hiérarchie des connecteurs d’argumentation","tAr":"تراتب أدوات الربط الحجاجية","body":["لكل دور أداة: الطرح (« Pour ma part », « Je soutiens que »)، التعليل (« en effet », « car »)، التمثيل (« par exemple », « à titre d’exemple »)، التتبع (« de plus », « par ailleurs »)، النتيجة (« c’est pourquoi », « ainsi »). استعمال أداة واحدة لكل دور يحفظ وضوح البنية.","لا تكرر نفس الأداة في كل جملة: تبديل « en effet » بـ « effectivement » أو « en réalité » يمنع التكرار المُمل، ويبقي على الوظيفة المنطقية نفسها."],"ex":[{"fr":"Le coût augmente ; en effet, les matières sont plus chères.","ar":"الكلفة ترتفع؛ والدليل أن المواد أغلى."},{"fr":"Le projet aboutira ; ainsi, nous recruterons en 2027.","ar":"سيتحقق المشروع؛ وبذلك سنوظف عام 2027."}]},{"tFr":"La concession : subjonctif ou indicatif","tAr":"الاعتراف بالرأي المقابل: فعلي أم التزامي","body":["« Bien que » و« quoique » تُتبع بالفعل التزامي في السبب، ثم يأتي الرد بالفالي: « Bien que les chiffres soient bons, le résultat reste fragile. » أي أن الاعتراف يُبنى ثم يُفكَّك.","« Même si » و« alors que » مع الفعلي في السبب: « Même si le budget est serré, nous financerons la formation. » الفرق دقيق لكنه يُلاحَظ في الكتابة الجادة."],"ex":[{"fr":"Bien que les résultats soient prometteurs, des doutes subsistent.","ar":"رغم أن النتائج مبشرة، إلا أن شكوكاً تبقى."},{"fr":"Même si la crise dure, il faut investir dans la formation.","ar":"حتى لو استمرت الأزمة، يجب الاستثمار في التكوين."}]}],"mistakes":[{"wrong":"إلقاء أسباب متتالية دون ترتيب","right":"ترتيب واضح: طرح، تعليل، مثال، اعتراض، خاتمة","why":"الترتيب هو ما يجعل الحجاج مقنعاً عند القارئ الفرنسي."},{"wrong":"إنكار الاعتراض مباشرة","right":"التغلب عليه بالاعتراف ثم الرد","why":"« Certes ... mais » ترفع المصداقية أكثر من « Non, c’est faux »."},{"wrong":"تكرار نفس أداة الربط في كل جملة","right":"تبديل الأدوات مع بقاء الوظيفة","why":"التكرار يُشعر القارئ بجمود وقلة مفردات."},{"wrong":"جملة الحجج بلا مثال","right":"دعم كل حجة بمثال ملموس واحد","why":"المثال هو ما يجعل الفكرة مقنعة في النموذج الفرنسي."}],"dialogues":[{"title":"Débat en réunion","ctx":"اجتماع عمل لمناقشة مشروع جديد","lines":[{"who":"Claire","fr":"Je soutiens que le télétravail doit rester deux jours par semaine.","ar":"أصرّ على أن العمل عن بعد يجب أن يبقى يومين في الأسبوع."},{"who":"Marc","fr":"Certes, la productivité a augmenté, toutefois le lien d’équipe se fragilise.","ar":"صحيح أن الإنتاجية ارتفعت، لكن رابط الفريق يضعف."},{"who":"Claire","fr":"En effet, mais une réunion hebdomadaire suffit à maintenir ce lien.","ar":"والدليل، لكن اجتماعاً أسبوعياً يكفي للحفاظ على هذا الرابط."},{"who":"Marc","fr":"D’accord, c’est pourquoi je propose un essai de trois mois.","ar":"حسناً، لهذا السبب أقترح تجربة لثلاثة أشهر."}]},{"title":"Un débat entre amis","ctx":"صحفيان يتناقشان حول قضية اجتماعية","lines":[{"who":"Yasmine","fr":"Pour moi, la priorité réside dans l’éducation.","ar":"برأيي، الأولوية في التعليم."},{"who":"Thomas","fr":"Il est vrai que l’éducation compte, mais la santé reste urgente.","ar":"صحيح أن التعليم مهم، لكن الصحة أكثر إلحاحاً."},{"who":"Yasmine","fr":"Par exemple, sans école, les soignants de demain n’existeront pas.","ar":"على سبيل المثال، من دون مدارس لن يوجد أطباء الغد."},{"who":"Thomas","fr":"Bonne réplique, j’accorde ce point à ton argumentation.","ar":"رد جيد، أُقرّ لحجتك بهذا."}]}],"exercises":[{"t":"mcq","skill":"vocab","q":"أي كلمة تعني « الفكرة الأساسية التي تدافع عنها »؟","opts":["la thèse","la concession","la synthèse","l’exemple"],"a":0,"why":"thèse هي الفكرة المراد إثباتها."},{"t":"fill","skill":"grammar","q":"أكمل: «___ que les chiffres soient bons, des doutes subsistent.»","fr":"___ que les chiffres soient bons, des doutes subsistent.","ans":"Bien que","why":"Bien que يُتبع بالفعل التزامي ثم يأتي الرد."},{"t":"order","skill":"writing","q":"رتّب عناصر الفقرة الحجاجية كترتيب منطقي","words":["Je","soutiens","que","la","priorité","réside","dans","la","formation"],"ans":"Je soutiens que la priorité réside dans la formation","why":"الطرح يأتي أولاً قبل الدعم والاعتراض."},{"t":"mcq","skill":"grammar","q":"أي جملة صحيحة نحويًا؟","opts":["Bien que les résultats sont bons","Bien que les résultats soient bons","Bien que les résultats auraient bons","Bien que les résultats a été bons"],"a":1,"why":"Bien que + subjonctif: soient (de être)."},{"t":"listen","skill":"listening","q":"استمع واختر الأداة المناسبة للاعتراف بحجة مضادة ثم الرد عليها.","opts":["Certes, ... mais ...","C’est pourquoi ...","Par exemple ...","Dès lors ..."],"a":0,"why":"Certes يفتح الاعتراف ثم يأتي الرد بـ mais."},{"t":"translate","skill":"writing","q":"ترجم: «صحيح أن الوقت محدود، لكننا سننجز المشروع.»","ans":"Il est vrai que le temps est limité, mais nous mènerons le projet à bien.","why":"Il est vrai que ... mais ... صيغة الاعتراف والرد."},{"t":"speaking","skill":"speaking","q":"قدّم فكرتك في دقيقة واحدة: طرح، حجة، مثال، خاتمة.","target":"Je soutiens que ... / En effet ... / Par exemple ... / C’est pourquoi ...","why":"ربط أدوات الحجاج في إنتاج منطوق متصل."},{"t":"correct","skill":"grammar","q":"صحّح: «Même si les résultats soient bons, je reste prudent.»","ans":"Même si les résultats sont bons, je reste prudent.","why":"Même si يُتبع بالفعل الفعلي لا التزامي."}],"homework":"اكتب فقرة حجاجية من 120 كلمة حول قضية تختارها، وضع تحت كل أداة ربط دورها (طرح / تعليل / مثال / اعتراض / خاتمة)، ثم عدّ عدد الأدوات: إن كانت أقل من أربعة فقرتك غير منظمة.","sources":[{"title":"Comment bien argumenter en français - Vocabulaire pour structurer une argumentation","channel":"Le français by Alex","videoId":"MEf8oQXG-OE","why":"مفردات توظيف الحجاج بالفرنسية: كيف تقدّم فكرتك، وتؤيدها، ثم تردّ على الاعتراضات.","cat":"Argumentation","level":"B2","main":true},{"title":"Cours de français - Argumenter en français - Cours 2","channel":"French School TV","videoId":"R3GIYkOsrxc","why":"درس منظّم في تقنيات الحجاج يثبّت المفردات والبنية التي تعلمتها.","cat":"Argumentation","level":"B2","extra":true},{"title":"La Qualification juridique [argumentation & raisonnement juridique]","channel":"Théorie du droit","videoId":"Hi7Nm3JSXag","why":"مثال متقدم على الحجاج المنظّم في التخصص القانوني — يرفع مستوى التفكير الحجاجي.","cat":"Argumentation","level":"B2","extra":true}],"supplements":[{"id":"R3GIYkOsrxc","title":"Cours de français - Argumenter en français - Cours 2","channel":"French School TV","why":"درس منظّم في تقنيات الحجاج يثبّت المفردات والبنية التي تعلمتها.","lang":"fr","dur":18},{"id":"Hi7Nm3JSXag","title":"La Qualification juridique [argumentation & raisonnement juridique]","channel":"Théorie du droit","why":"مثال متقدم على الحجاج المنظّم في التخصص القانوني — يرفع مستوى التفكير الحجاجي.","lang":"fr","dur":14}]},{"id":"b2-t2-l2","fr":"Les connecteurs logiques avancés","ar":"أدوات الربط المنطقي المتقدمة","objectives":["التمييز بين or و car و puisque و en effet في الاستعمال","استعمال أدوات التتبع والتنقيص المتقدمة دون تكرار","ربط الجمل بما ولأن حتى ولو في نص واحد متماسك","إنتاج نصاً من 100 كلمة يحتوي خمس أدوات ربط مختلفة وظائفها صحيحة"],"sections":[{"h":"الدرس 2: أدوات الربط التي تجعل حديثك متماسكاً","video":{"id":"GcWDl-fMbHM","title":"7 techniques d’argumentation françaises pour débattre avec n’importe qui","channel":"Français Facile","why":"سبع تقنيات حجاجية عملية تظهر فيها أدوات الربط المنطقي في سياق نقاش حقيقي لا في قوائم مجردة.","lang":"fr","main":true,"dur":15},"p":["أدوات الربط المنطقي (connecteurs logiques) هي الهيكل الخفي للنص الفرنسي: النص بلا ربط يبدو كقائمة مبعثرة، والربط الزائد يبدو متكلفاً. المستوى B2 هو إيجاد الوسط: أداة واحدة لكل علاقة منطقية واحدة.","معجم الدرس: dès lors, en effet, par conséquent, toutefois, néanmoins, en revanche, au contraire, c’est pourquoi, si bien que, à mesure que, faute de, à défaut de. احفظ كل أداة مع علاقتها: سبب، نتيجة، تقابل، تدرّج، عجز.","نحوياً، الأدوات تفرض صيغاً مختلفة: « quoique » و« bien que » بالتزامي، « alors que » و« même si » بالفالي، « si bien que » بلفعل الذي يليه مباشرة: « Il a plu si fort que les routes ont été coupées. »","الفرق الدقيق: « en effet » تُستعمل لإثبات ما قيل قبلها بالدليل نفسه، و« effectivement » لتأكيد موافقة، و« en réalité » لتصحيح الانطباع الأول. ثلاث أدوات تبدو متقاربة لكنها تؤدي مهام مختلفة تماماً.","قاعدة التقابل: « au contraire » تضع شيئين مقابل بعضهما مباشرة (« Ce n’est pas un défaut, au contraire, c’est une qualité »)، أما « en revanche » فتُقارن بين حالتين مختلفتين. الخلط بينهما أشهر خطأ في الكتابة.","بعد الدرس: خذ نصاً قصيراً من الصحف وحدّد كل أداة ربط، وصنّفها: سبب / نتيجة / تقابل / تدرّج / استثناء. هذه الصنفنة هي اختبار B2 الحقيقي للنص."],"sub":[{"h":"Cause et conséquence","p":["Puisque tu es là, on peut commencer.","Le rapport était incomplet ; par conséquent, il a été refusé.","Il a beaucoup travaillé, si bien qu’il a réussi."]},{"h":"Opposition et nuance","p":["La route était longue ; toutefois, nous sommes arrivés à temps.","Ce n’est pas un échec, au contraire, c’est un début.","Le prix augmente, en revanche la qualité reste stable."]},{"h":"Tendance et condition","p":["À mesure que la situation s’améliore, les mesures seront levées.","Faute de données fiables, l’étude a été suspendue.","À défaut de réponse, nous annulerons la réservation."]}]},{"h":"Quatre connecteurs à distinguer absolument","p":["« En effet » = je prouve ce que je viens de dire (le lien est interne à l’argument).","« Puisque » = la cause est connue des deux interlocuteurs, on ne la discute pas.","« Au contraire » = je mets deux termes exactement face à face.","« En revanche » = je passe d’une situation à une autre qui lui fait contraste."]},{"h":"التطبيق والتلخيص","p":["تمرين التصنيف: خذ خمس جمل وحدّد فيها علاقتها المنطقية (سبب / نتيجة / تقابل / تدرّج / استثناء) ثم اختر الأداة المناسبة.","تمرين التبديل: أعد كتابة نفس الفقرة بأدوات ربط من مستوى أعلى (car ← puisque, mais ← néanmoins) مع الحفاظ على المعنى.","تمرين النص: اكتب 100 كلمة عن قضية واحدة بحيث توظف خمس أدوات ربط مختلفة، وتحت كل أداة اكتب نوع العلاقة."]},{"h":"التطبيق والتلخيص","p":["تعلّمت أن connecteurs logiques هي الهيكل الخفي للنص: en effet للدليل، par conséquent للنتيجة، toutefois للاعتراض. أداة واحدة لكل علاقة منطقية حتى لا يُتكلَّف النص. أعد مشاهدة الفيديو الرئيسي وركّز على أداة الربط الواحد لكل علاقة منطقية.","جسر الدروس: من b2-t2-l1 (بناء الحجاج وتنظيم أطواره) إلى b2-t2-l2 (أدوات الربط المنطقي المتقدمة)، ثم إلى b2-t2-l3 حيث تردّ على الاعتراض دون عدوانية.","مهمة تطبيقية: سجّل دقيقة صوتية تشرح فيها موقفاً من يومك مستخدماً ثلاث كلمات جديدة من الدرس (dès lors، toutefois، en revanche)، ثم استمع للتسجيل وقارن نطقك ومفرداتك بما سمعته في الفيديو الرئيسي."]}],"pron":[{"w":"dès lors","ipa":"[dɛ lɔʁ]","approx":"دي لور"},{"w":"néanmoins","ipa":"[ne.ɛ̃.mwɛ̃]","approx":"نيانمواں"},{"w":"toutefois","ipa":"[tut.fwa]","approx":"توتفوا"}],"vocab":[{"fr":"dès lors","ar":"منذ ذلك الحين / إذن","pos":"loc.","g":"","exFr":"Dès lors, la décision s’impose.","ipa":"[dɛ lɔʁ]","exAr":"وإذن، يفرض القرار نفسه."},{"fr":"en effet","ar":"والدليل على ذلك","pos":"loc.","g":"","exFr":"Les chiffres sont nets : en effet, les ventes ont doublé.","ipa":"[ɑ̃.nə.fɛ]","exAr":"الأرقام واضحة: والدليل أن المبيعات تضاعفت."},{"fr":"par conséquent","ar":"وبالتالي","pos":"loc.","g":"","exFr":"Le budget est serré ; par conséquent, nous renonçons.","ipa":"[paʁ kɔ̃.sɛ.kɑ̃]","exAr":"الميزانية ضيقة؛ وبالتالي نتخلى عن ذلك."},{"fr":"toutefois","ar":"ومع ذلك","pos":"adv.","g":"","exFr":"Il est compétent, toutefois inexpérimenté.","ipa":"[tut.fwa]","exAr":"مؤهل، ومع ذلك غير متمرّس."},{"fr":"néanmoins","ar":"غير أن / رغم ذلك","pos":"adv.","g":"","exFr":"Le projet est utile ; néanmoins, il coûte cher.","ipa":"[ne.ɛ̃.mwɛ̃]","exAr":"المفيد نعم؛ غير أن كلفته عالية."},{"fr":"en revanche","ar":"في المقابل","pos":"loc.","g":"","exFr":"Le délai est court, en revanche la qualité est garantie.","ipa":"[ɑ̃.ʁə.ɑ̃ʃ]","exAr":"المدة قصيرة، في المقابل الجودة مضمونة."},{"fr":"au contraire","ar":"على العكس تماماً","pos":"loc.","g":"","exFr":"Ce n’est pas un obstacle, au contraire, c’est un atout.","ipa":"[o kɔ̃tʁɛʁ]","exAr":"ليس عائقاً، على العكس تماماً، إنه ميزة."},{"fr":"si bien que","ar":"لدرجة أن","pos":"loc.","g":"","exFr":"Il parle vite si bien qu’on le comprend mal.","ipa":"[si bjɛ̃ kə]","exAr":"يتحدث بسرعة لدرجة أننا لا نفهمه جيداً."},{"fr":"à mesure que","ar":"كلما / تدريجياً مع","pos":"loc.","g":"","exFr":"À mesure que le temps passe, on oublie.","ipa":"[a mə.zyʁ kə]","exAr":"كلما مضى الوقت، ننسى."},{"fr":"faute de","ar":"بسبب غياب / لانعدام","pos":"loc.","g":"","exFr":"Faute de preuves, l’accusation tombe.","ipa":"[fo də]","exAr":"بغياب الأدلة، تسقط التهمة."},{"fr":"à défaut de","ar":"عند عدم توفر / بديلاً عن","pos":"loc.","g":"","exFr":"À défaut de candidat, nous rouvrirons le poste.","ipa":"[a de.fa də]","exAr":"عند عدم توفر مرشح، سنعيد فتح الشاغر."},{"fr":"cependant","ar":"لكن / غير أن","pos":"adv.","g":"","exFr":"Il voulait partir ; cependant, il est resté.","ipa":"[sə.pɑ̃.tɑ̃]","exAr":"أراد أن يسافر؛ لكنه بقي."}],"examples":[{"fr":"Puisque tu es là, autant commencer tout de suite.","ar":"بما أنك هنا، من الأفضل البدء فوراً.","note":"cause connue"},{"fr":"Le dossier était incomplet ; par conséquent, il a été refusé.","ar":"كان الملف ناقصاً؛ وبالتالي رُفض.","note":"conséquence"},{"fr":"La route était longue ; toutefois, nous sommes arrivés à l’heure.","ar":"كانت الطريق طويلة؛ ومع ذلك وصلنا في الموعد.","note":"nuance"},{"fr":"Ce n’est pas un défaut, au contraire, c’est une force.","ar":"ليس عيباً، على العكس تماماً، إنه قوة.","note":"face-à-face"},{"fr":"Le service est rapide, en revanche le prix est élevé.","ar":"الخدمة سريعة، في المقابل السعر مرتفع.","note":"contraste de situations"},{"fr":"Il a beaucoup lu si bien qu’il écrit très bien.","ar":"قرأ كثيراً لدرجة أنه يكتب بإتقان.","note":"conséquence intensive"}],"grammar":[{"tFr":"En effet, effectivement, en réalité : trois rôles distincts","tAr":"ثلاث أدوات تبدو متقاربة ووظائفها مختلفة","body":["« En effet » تربط جملتين بالدليل الداخلي: تقول شيئاً ثم تُثبتّه بنفسك. « Effectivement » تؤكد ما قاله الطرف الآخر. « En réalité » تُصحّح انطباعاً سبق أن تكوّن عند المخاطب.","الخلط بينها يُغيّر معنى الحوار كله: « Tu es fatigué ? — En effet » تعني أنك تؤكد ما شاهده، أما « Effectivement » فتوافق تقديره، و« En réalité » ترفض الانطباع وتقترح حقيقة أخرى."],"ex":[{"fr":"Il a réussi ; en effet, il travaillait depuis six mois.","ar":"نجح؛ والدليل أنه يعمل منذ ستة أشهر."},{"fr":"— Tu es fatigué ? — En réalité, je suis stressé.","ar":"— أنت متعب؟ — في الحقيقة، أنا متوتر."}]},{"tFr":"La valeur consécutive : si bien que + indicatif","tAr":"القيمة النتيجية: si bien que مع الفعلي","body":["« Si bien que » تربط سبباً بنتيجة متلازمة له: « Il a plu si fort que les routes ont été coupées. » الفعل بعدها فعلي دائماً، ولا يجوز التزامي.","« À mesure que » تصف تقدّم شيئين معاً: « À mesure qu’on vieillit, on change. » بعكس « si bien que » التي تربط لحظة سبب بلحظة نتيجة."],"ex":[{"fr":"Le vent s’est levé si bien que la mer est devenue mauvaise.","ar":"ارتفعت الرياح لدرجة أن البحر أصبح عاصفاً."},{"fr":"À mesure que la ville grandit, les loyers augmentent.","ar":"كلما كبرت المدينة، ارتفعت الإيجارات."}]}],"mistakes":[{"wrong":"استعمال au contraire لمقارنة حالتين مختلفتين","right":"en revanche للمقارنة و au contraire للنقض المباشر","why":"au contraire تضع شيئين وجهاً لوجه لا تقارن بين سياقين."},{"wrong":"استخدام réellement بدل en effet لإثبات كلامك","right":"en effet للدليل و effectivement للموافقة","why":"التداخل يفقد النص دقته المنطقية."},{"wrong":"حشر أداة ربط في كل جملة","right":"أداة واحدة لكل علاقة منطقية","why":"الربط الزائد يجعل النص متكلفاً ومتكرراً."},{"wrong":"si bien que + subjonctif","right":"si bien que + indicatif","why":"الأداة النتيجية تقتضي الفعلي، خلافاً لـ bien que."}],"dialogues":[{"title":"Discussion sur un projet","ctx":"اجتماع بين مهندسين","lines":[{"who":"Hugo","fr":"Le budget est limité ; dès lors, il faut prioriser.","ar":"الميزانية محدودة؛ وبناءً عليه يجب تحديد الأولويات."},{"who":"Sara","fr":"En effet, la phase test passe avant le design.","ar":"والدليل، مرحلة الاختبار تأتي قبل التصميم."},{"who":"Hugo","fr":"Néanmoins, sans design, les utilisateurs hésiteront.","ar":"غير أنه دون تصميم، سيتردد المستخدمون."},{"who":"Sara","fr":"D’accord : si bien que nous ferons les deux en parallèle.","ar":"حسناً: وبناءً عليه سننفّذ الاثنين معاً."}]},{"title":"Choisir un voyage","ctx":"صديقان يخططان للعطلة","lines":[{"who":"Lina","fr":"Faute de budget, on part en train plutôt qu’en avion.","ar":"بسبب الميزانية، نسافر بالقطار بدل الطائرة."},{"who":"Marc","fr":"Le train est long ; en revanche, le paysage est beau.","ar":"القطار طويل؛ في المقابل المنظر جميل."},{"who":"Lina","fr":"À mesure qu’on avance, la montagne devient spectaculaire.","ar":"كلما تقدمنا، أصبحت الجبل مشهداً خلاباً."},{"who":"Marc","fr":"À défaut d’hôtel, on dormira en refuge.","ar":"عند عدم توفر فندق، سننام في ملجأ."}]}],"exercises":[{"t":"mcq","skill":"vocab","q":"أي أداة تُستعمل لإثبات ما قلتَه للتو بالدليل؟","opts":["au contraire","en effet","faute de","à mesure que"],"a":1,"why":"en effet تربط الجملة بالدليل الداخلي."},{"t":"fill","skill":"grammar","q":"أكمل: «___ tu es là, autant commencer.»","fr":"___ tu es là, autant commencer.","ans":"Puisque","why":"puisque تُستعمل لسبب معلوم للطرفين لا يُناقش."},{"t":"order","skill":"writing","q":"رتّب أداة ربط السبب بالنتيجة: لذلك، نؤجل الاجتماع.","words":["Par","conséquent,","nous","reportons","la","réunion."],"ans":"Par conséquent, nous reportons la réunion.","why":"par conséquent تربط سبباً بنتيجته بشكل منطقي."},{"t":"mcq","skill":"grammar","q":"أي جملة صحيحة؟","opts":["Il parle si bien qu’il soit compris","Il parle si bien qu’on le comprend","Il parle si bien qu’on le comprenne","Il parle si bien qu’on eût compris"],"a":1,"why":"si bien que + indicatif."},{"t":"listen","skill":"listening","q":"استمع واختر الأداة التي تُنكر ما قبلها وتصنّفه عكس ما قيل.","opts":["en effet","au contraire","puisque","à mesure que"],"a":1,"why":"au contraire تضع الوجّهَين مباشرة: نقض مباشر."},{"t":"translate","skill":"writing","q":"ترجم: «بغياب بيانات موثوقة، أُجلت الدراسة.»","ans":"Faute de données fiables, l’étude a été reportée.","why":"faute de = بسبب غياب."},{"t":"speaking","skill":"speaking","q":"اشرح شفهيًا الفرق بين au contraire و en revanche بمثال واحد لكل منهما.","target":"au contraire = face-à-face / en revanche = contraste","why":"التمييز المعرفي يسبق الاستعمال الصحيح."},{"t":"correct","skill":"grammar","q":"صحّح: «Bien que les résultats sont bons, nous restons prudents.»","ans":"Bien que les résultats soient bons, nous restons prudents.","why":"Bien que + subjonctif: soient."}],"homework":"اكتب نصاً من 100 كلمة عن قضية واحدة، ووظّف خمس أدوات ربط مختلفة (سببية، نتيجة، تقابل، تدرّج، استثناء)، وضع علامة تحت كل أداة وكتب بجانبها نوع العلاقة المنطقية.","sources":[{"title":"7 techniques d’argumentation françaises pour débattre avec n’importe qui","channel":"Français Facile","videoId":"GcWDl-fMbHM","why":"سبع تقنيات حجاجية عملية تظهر فيها أدوات الربط المنطقي في سياق نقاش حقيقي لا في قوائم مجردة.","cat":"Argumentation","level":"B2","main":true},{"title":"Cours de français - Argumenter en français - Cours 2","channel":"French School TV","videoId":"R3GIYkOsrxc","why":"تثبيت أدوات الربط داخل درس حجاجي منظّم مع أمثلة مستعملة.","cat":"Argumentation","level":"B2","extra":true},{"title":"Expression française, niveau B2","channel":"French School TV","videoId":"Dh3STYQ0yWM","why":"تدريب على التعبير المنظم بمستوى B2 يربط أدوات الربط بالكلام الحيّ.","cat":"Argumentation","level":"B2","extra":true}],"supplements":[{"id":"R3GIYkOsrxc","title":"Cours de français - Argumenter en français - Cours 2","channel":"French School TV","why":"تثبيت أدوات الربط داخل درس حجاجي منظّم مع أمثلة مستعملة.","lang":"fr","dur":18},{"id":"Dh3STYQ0yWM","title":"Expression française, niveau B2","channel":"French School TV","why":"تدريب على التعبير المنظم بمستوى B2 يربط أدوات الربط بالكلام الحيّ.","lang":"fr","dur":15}]},{"id":"b2-t2-l3","fr":"La réfutation et contre-argumentation","ar":"الرد على الاعتراض وفنّ المعارضة","objectives":["تمييز la réfutation المباشرة عن la contre-argumentation المهذّبة","استعمال صيغ « Certes… mais… » و« Il est vrai que… toutefois… »","تفكيك بنية الاعتراض: الفرضية، الدليل، الاستنتاج الخاطئ","إنتاج ردّ حجاجي من ثلاث جمل يحفظ نبرة الاحترام"],"sections":[{"h":"الدرس 3: كيف تردّ على الاعتراض دون أن تبدو عدوانياً","video":{"id":"HZURshZkZXo","title":"Réfuter un argument en français : techniques et expressions","channel":"Le français by Alex","why":"تقنيات la réfutation المهنيّة: كيف تفكّك اعتراض الخصم وتقدّم بدلاً أفضل مع الحفاظ على النبرة المهذّبة.","lang":"fr","main":true,"dur":15},"p":["la réfutation ليست إنكاراً أعمى بل تفكيكاً منطقياً: تُقرّ أولاً بما هو صحيح في الاعتراض (la concession)، ثم تُبرز النقطة التي لا تصمد أمام الدليل (la réfutation)، ثم تقترح قراءة أفضل (la contre-argumentation). هذا التسلسل يجعل رداً قوياً دون عدوانية.","معجم الدرس: la réfutation, la contre-argumentation, la concession, le contre-exemple, la faille, la nuance, démanteler, rétorquer, objecter, nuancer, tempérer, rétablir. احفظ كل كلمة مع سياق استعمالها الجدلّي.","نحوياً، la réfutation تعتمد على المركّبات الشرطية والفروق: « Si l’argument était valable, on observerait… » (conditionnel)، و« Bien que l’objection semble forte, … » (subjonctif)، و« Non seulement… mais en plus… » لتراكم المقابل.","أداة la faille: ابحث عن الحدّ الذي ينهار فيه الاعتراض — عدداً واحداً مقلوباً، شرطاً مغفواً، أو استثناءً كبيراً. la faille واحدة مدروسة تكفي لإسقاط حجّة كاملة.","قاعدة la nuance: الردّ الأقوى هو الذي يعترف بما هو صحيح أولاً. « Vous avez raison sur le principe, toutefois l’application révèle un problème. » — الإقرار يمنح النبرة la crédibilité التي يفقدها الإنكار المباشر.","بعد الدرس: اكتب ثلاث ردود على ثلاثة اعتراضات مختلفة (مالية، أخلاقية، تقنية) مستخدماً ثلاثة أنماط مختلفة: faille منطقية، counter-exemple، concession-renversement."],"sub":[{"h":"Le schéma en trois temps","p":["Concéder : « Certes, le coût est élevé… »","Réfuter : « … toutefois ce chiffre ignore la maintenance. »","Contre-argumenter : « … tandis que la solution durable réduit la dépense de 30 %. »"]},{"h":"Trouver la faille","p":["Le contre-exemple : « Or, le cas de Lyon prouve le contraire. »","La condition manquante : « … si les usagers étaient formés. »","L’amalgame : « Vous confondez vitesse et qualité. »"]},{"h":"Préserver la nuance","p":["« Sur le principe, oui — dans la pratique, non. »","« Votre point est légitime, mais il n’est pas déterminant. »","« Je comprends la préoccupation, néanmoins les données contredisent. »"]}]},{"h":"Les formules maîtresses de la réfutation","p":["« Certes… mais… » — concéder vite pour reprendre l’avantage.","« Il est vrai que… toutefois… » — reconnaître puis déplacer le débat.","« Cela ne tient pas : … » — réfuter nettement, registre soutenu.","« En d’autres termes, vous confondez… » — pointer la faille conceptuelle."]},{"h":"التطبيق والتلخيص","p":["تمرين التفكيك: خذ اعتراضاً واحداً من نقاش حقيقي وقسّمه إلى ثلاث: ما يُقرّ به، ما يُرفض، ما يُقترح بدلاً منه.","تمرين la bascule: أعد كتابة ردّ عدواني بصيغة « Certes… toutefois… » ولاحظ كيف يتغيّر أثر النبرة.","تمرين la faille: ابحث في ثلاثة أرقام من تقرير عن شرط مغفل يُغيّر الاستنتاج بالكامل واحتج به."]},{"h":"التطبيق والتلخيص","p":["في هذا الدرس تعلّمت la réfutation: تُقرّ أولاً بما هو صحيح (la concession)، ثم تُبرز la faille، ثم تقترح قراءة أفضل. استعملت الصيغة «Certes… toutefois…» ب-ton مهذّب. أعد مشاهدة الفيديو الرئيسي وركّز على الصيغة «Certes… toutefois…» و-ton الودّي.","جسر الدروس: من b2-t2-l2 (أدوات الربط المنطقي المتقدمة) إلى b2-t2-l3 (الرد على الاعتراض بأسلوب مهذّب)، ثم إلى b2-t2-l4 حيث تكشف المغالطات في كل نقاش.","مهمة تطبيقية: سجّل دقيقة صوتية تشرح فيها موقفاً من يومك مستخدماً ثلاث كلمات جديدة من الدرس (la concession، la faille، rétorquer)، ثم استمع للتسجيل وقارن نطقك ومفرداتك بما سمعته في الفيديو الرئيسي."]}],"pron":[{"w":"réfutation","ipa":"[ʁe.fy.ta.sjɔ̃]","approx":"ريفيتاسيون"},{"w":"concession","ipa":"[kɔ̃.sɛ.sjɔ̃]","approx":"كونسيسيون"},{"w":"contre-argument","ipa":"[kɔ̃tʁ‿aʁ.ɡmɑ̃]","approx":"كونتريغمان"}],"vocab":[{"fr":"la rétorsion","ar":"الردّ الحاد / الاعتراض المرتد","pos":"nom","g":"f","exFr":"Sa rétorsion a surpris tout le monde.","exAr":"فاجأ ردّه الحاد الجميع.","ipa":"[ʁe.tɔʁ.sjɔ̃]"},{"fr":"la contre-argumentation","ar":"المعارضة المنظّمة","pos":"nom","g":"f","exFr":"La contre-argumentation exige de la précision.","ipa":"[kɔ̃tʁ‿aʁ.ɡmɑ̃.ta.sjɔ̃]","exAr":"المعارضة المنظّمة تتطلب دقة."},{"fr":"l’objection","ar":"الاعتراض المطروح","pos":"nom","g":"f","exFr":"Son objection est légitime.","exAr":"اعتراضه مشروع.","ipa":"[ɔb.ʒɛk.sjɔ̃]"},{"fr":"le contre-exemple","ar":"الدليل المضاد","pos":"nom","g":"m","exFr":"Un contre-exemple suffit à invalider la règle.","ipa":"[kɔ̃tʁ‿ɛɡ.zɑ̃pl]","exAr":"دليل واحد مضاد يكفي لإبطال القاعدة."},{"fr":"la faille","ar":"الثغرة المنطقية","pos":"nom","g":"f","exFr":"La faille de son raisonnement est visible.","ipa":"[faj]","exAr":"ثغرة استدلاله واضحة."},{"fr":"démanteler","ar":"يفكّك / يهدم","pos":"verbe","g":"","exFr":"Il a démantelé l’argument en trois minutes.","ipa":"[de.mɑ̃.tle]","exAr":"فكّك الحجّة في ثلاث دقائق."},{"fr":"rétorquer","ar":"يردّ بحسم","pos":"verbe","g":"","exFr":"Elle a rétorqué que les chiffres parlaient.","ipa":"[ʁe.tɔʁ.ke]","exAr":"ردّت بأن الأرقام تتحدث."},{"fr":"nuancer","ar":"يُفصّل / يُلوّن","pos":"verbe","g":"","exFr":"Il faut nuancer cette conclusion.","ipa":"[nɥɑ̃.se]","exAr":"يجب تفصيل هذه الخاتمة."},{"fr":"tempérer","ar":"يهدّئ / يُخفّف","pos":"verbe","g":"","exFr":"Elle a tempéré les inquiétudes.","ipa":"[tɑ̃.pe.ʁe]","exAr":"هدّأت المخاوف."},{"fr":"rétablir","ar":"يُعيد التقييم / يصحّح","pos":"verbe","g":"","exFr":"Il a rétabli les vrais enjeux.","ipa":"[ʁe.ta.bliʁ]","exAr":"أعاد تقييم المخاطر الحقيقية."},{"fr":"le raisonnement","ar":"الاستدلال","pos":"nom","g":"m","exFr":"Son raisonnement est logique.","ipa":"[ʁɛ.zɔn.mɑ̃]","exAr":"استدلاله منطقي."},{"fr":"la faille logique","ar":"الثغرة المنطقية","pos":"nom","g":"f","exFr":"Cette faille logique annule la preuve.","ipa":"[faj lɔ.ʒik]","exAr":"هذه الثغرة المنطقية تُبطل الدليل."}],"examples":[{"fr":"Certes, le budget est limité, mais l’investissement paiera.","ar":"صحيح أن الميزانية محدودة، لكن الاستثمار سيسترد كلفته.","note":"concession + retournement"},{"fr":"Il est vrai que la vitesse est bonne, toutefois la qualité baisse.","ar":"صحيح أن السرعة ممتازة، لكن الجودة تنهار.","note":"concession + nuance"},{"fr":"Cela ne tient pas : vous confondez cause et corrélation.","ar":"هذا لا يصمد: خلطتم بين السبب والارتباط.","note":"réfutation nette"},{"fr":"En d’autres termes, votre chiffre ignore la maintenance.","ar":"بمعنى آخر، رقمكم يتجاهل الصيانة.","note":"pointer la faille"},{"fr":"Un contre-exemple : Lyon a réussi sans subvention.","ar":"دليل مضاد: ليون نجحت دون دعم مالي.","note":"contre-exemple"},{"fr":"Sur le principe oui, dans la pratique non.","ar":"من المبدأ نعم، في الممارسة لا.","note":"nuance"}],"grammar":[{"tFr":"La concession et le renversement","tAr":"الاعتراف ثم الانقلاب الحجاجي","body":["« Certes… mais… » و« Il est vrai que… toutefois… » لا يُبلَّغان كتحية بل كمناورة: الإقرار يشلّ اعتراض الخصم المبكر ثم يفتح الباب لردّك.","la nuance نحوية: « Bien que l’objection soit forte, les données la dépassent. » (subjonctif) — la subordonnée la concession تسبق la principale la contournement."],"ex":[{"fr":"Bien que l’objection soit forte, les données la dépassent.","ar":"رغم قوة الاعتراض، لكن البيانات تفوقه."},{"fr":"Certes coûteux, le projet reste rentable.","ar":"صحيح إنه مكلف، لكن المشروع يبقى مربحاً."}]},{"tFr":"La condition manquante","tAr":"الشرط المغفل","body":["« Si l’argument était valable, on observerait X. Or, on observe Y. » — la réfutation par l’absurde: la condition révèle l’échec.","« Cela suppose que… or… » — pointe la prémisse cachée que l’adversaire n’a jamais démontrée."],"ex":[{"fr":"Si le plan était efficace, on observerait une baisse. Or, elle augmente.","ar":"لو كان الخطة فعالة، للاحظنا انخفاضاً. لكنه يرتفع."},{"fr":"Cela suppose des usagers formés, or ils ne le sont pas.","ar":"هذا يفترض مستخدمين مدرّبين، لكنهم ليسوا كذلك."}]}],"mistakes":[{"wrong":"Infirmer l’interlocuteur d’emblée","right":"concéder un point avant de réfuter","why":"الإنكار المباشر يُغلق النقاش ويفقدك la crédibilité."},{"wrong":"Réfuter avec des sentiments","right":"réfuter avec un fait ou un contre-exemple","why":"la réfutation الحجاجية تحتاج دليلاً لا نبرة."},{"wrong":"Confondre nuance et faiblesse","right":"nuance = précision du débat","why":"la nuance ترفع la crédibilité لا تُضعفها."},{"wrong":"Réfuter tout entier un argument partiellement juste","right":"isoler la faille exacte","why":"la faille واحدة تكفي، الردّ الأعمى يُفقد القوة."}],"dialogues":[{"title":"le débat professionnel","ctx":"réunion d’équipe sur un budget","lines":[{"who":"Claire","fr":"Le plan est trop cher, il faut l’abandonner.","ar":"الخطة مكلفة جداً، يجب إلغاؤها."},{"who":"Karim","fr":"Certes le coût initial est élevé, mais il baisse à trois ans.","ar":"صحيح أن التكلفة الأولية عالية، لكنها تنخفض بعد ثلاث سنوات."},{"who":"Claire","fr":"Vous ignorez la maintenance alors.","ar":"إذن تتجاهلون الصيانة."},{"who":"Karim","fr":"La maintenance figure au budget : 5 % seulement.","ar":"الصيانة مدرجة في الميزانية: 5٪ فقط."}]},{"title":"la faille","ctx":"séminaire universitaire","lines":[{"who":"Prof","fr":"Votre thèse suppose une causalité directe.","ar":"فرضتكم تفترض سببية مباشرة."},{"who":"Élève","fr":"Les chiffres montrent la corrélation.","ar":"الأرقام تُظهر الارتباط."},{"who":"Prof","fr":"Or, corrélation n’est pas causalité.","ar":"لكن الارتباط ليس سببية."},{"who":"Élève","fr":"Je dois nuancer ma démonstration.","ar":"عليّ تفصيل استدلالي."}]}],"exercises":[{"t":"mcq","skill":"argumentation","q":"ما la fonction la plus مناسبة قبل la réfutation؟","opts":["la concession","l’injure","la digression","le silence"],"a":0,"why":"la concession تفتح الباب للردّ دون عدوانية."},{"t":"fill","skill":"grammar","q":"أكمل: «Certes le coût est élevé, ___ le résultat durable.»","fr":"Certes le coût est élevé, ___ le résultat durable.","ans":"mais","why":"« Certes… mais… » صيغة la concession la retournement."},{"t":"mcq","skill":"argumentation","q":"أي عبارة تُشير إلى la faille؟","opts":["Vous confondez X et Y.","Je suis d’accord.","C’est intéressant.","Allons-y."],"a":0,"why":"la faille تُبرز الالتباس المفاهيمي في اعتراض الخصم."},{"t":"order","skill":"writing","q":"رتّب: صحيح المبدأ نعم الممارسة لا","words":["Sur","le","principe","oui,","dans","la","pratique","non."],"ans":"Sur le principe oui, dans la pratique non.","why":"la nuance la plus élégante."},{"t":"listen","skill":"listening","q":"ما la fonction la « toutefois » في « Il est vrai que… toutefois… »؟","opts":["la nuance","la concession","la réfutation","la conclusion"],"a":0,"why":"« toutefois » ينقل النقاش إلى la nuance la retournement."},{"t":"translate","skill":"writing","q":"ترجم: «صحيح أنه مكلف، لكن الاستثمار سيسترد كلفته.»","ans":"Certes, le projet est cher, mais l’investissement paiera.","why":"concession + retournement."},{"t":"speaking","skill":"speaking","q":"ردّ على اعتراض زميلك في اجتماع بصيغة « Certes… toutefois… » بنبرة هادئة.","target":"Certes… mais… / toutefois","why":"la réfutation المهنيّة."},{"t":"correct","skill":"grammar","q":"صحّح: «Votre argument est faux, c’est ridicule.»","ans":"Votre argument néglige un point : la maintenance.","why":"la réfutation المهنيّة تُفكّك لا تُهين."}],"homework":"اكتب ثلاث ردود على ثلاثة اعتراضات (مالية، أخلاقية، تقنية) بصيغ مختلفة: faille، counter-exemple، concession-renversement.","sources":[{"title":"Réfuter un argument en français : techniques et expressions","channel":"Le français by Alex","videoId":"HZURshZkZXo","why":"تقنيات la réfutation المهنيّة: كيف تفكّك اعتراض الخصم وتقدّم بدلاً أفضل مع الحفاظ على النبرة المهذّبة.","cat":"Débat","level":"B2","main":true},{"title":"Comment réfuter un argument efficacement","channel":"Le français by Alex","videoId":"oVIc7T_RLRI","why":"تقنيات la réfutation الحجاجية مع أمثلة تطبيقية.","cat":"Débat","level":"B2","extra":true},{"title":"Débattre sans s’énerver : le guide","channel":"Français Authentique","videoId":"DQzyDJxYrZw","why":"كيف تحافظ على la nuance la professionnalisme أثناء la réfutation.","cat":"Débat","level":"B2","extra":true}],"supplements":[{"id":"oVIc7T_RLRI","title":"Comment réfuter un argument efficacement","channel":"Le français by Alex","why":"تقنيات la réfutation الحجاجية مع أمثلة تطبيقية.","lang":"fr","dur":14},{"id":"DQzyDJxYrZw","title":"Débattre sans s’énerver : le guide","channel":"Français Authentique","why":"كيف تحافظ على la nuance la professionnalisme أثناء la réfutation.","lang":"fr","dur":12}]},{"id":"b2-t2-l4","fr":"Les sophismes et pièges","ar":"المغالطات والأخاديد المنطقية","objectives":["تعريف les sophismes الأساسية: ad hominem, homme de paille, appel à la majorité","تمييز الاعتراض الحجّي عن la sophistique","تحليل بنية المغالطة وتحديد نقطة انهيارها","إنتاج ردّ علمي على sophisme في سياق مهني أو أكاديمي"],"sections":[{"h":"الدرس 4: كيف تكتشف المغالطة قبل أن تقع فيها","video":{"id":"Hi7Nm3JSXag","title":"Les sophismes : détectez les arguments fallacieux","channel":"Le français by Alex","why":"شرح les sophismes الشائعة في النقاشات الفرنسية: ad hominem, l’homme de paille, l’appel à la majorité — وكيف تكشفها في الحقيقة.","lang":"fr","main":true,"dur":17},"p":["المغالطة (le sophisme) ليست خطأ لغوي بل خطأ منطقي: بنية تبدو مقنعة لكنها تختلّ العلاقة بين la prémisse والنتيجة. la sophisme تخدع بالشكل لا بالمحتوى — لهذا يجب تعلّم la mécanique لا la liste فقط.","معجم الدرس: le sophisme, la fallacieux, l’ad hominem, l’homme de paille, l’appel à la majorité, le biais, l’amalgame, la généralisation, la pétition de principe, la fausse dichotomie, la corrélation, la causalité. احفظ كل مصطلح مع مثاله.","نحوياً، la détection تبدأ بالسؤال: هل la conclusion تتبّع فعلاً من la prémisse؟ « Si A alors B » — la sophisme يُخفي شرطاً أو يُغيّر la variable. la logique la grammaire متشابكة في هذا التحليل.","الدرس الأهم: la sophisme لا تُكشف بالقوة بل بالصبر — la lenteur la analyse. اكتب الاعتراض، حدد la prémisse، ثم اسأل: هل هذا هو الشرط الوحيد الممكن؟","قاعدة la pratique: في النقاش المهني، لا تقل « c’est un sophisme » مباشرة — استخدم la reformulation: « si je comprends bien, vous affirmez que… mais cela suppose que… » — la reformulation تكشف المغالطة دون إهانة.","بعد الدرس: اقرأ ثلاث صفحات من مناقشة سياسية فرنسية، حدد فيها sophisme واحدة، واكتب ردّاً علمياً يكشف la faille المنطقية."],"sub":[{"h":"Les sophismes كلاسيكية","p":["l’ad hominem = الهجوم على الشخص لا الحجّة","l’homme de paille = تشويه موقف الخصم","l’appel à la majorité = الاحتكام إلى الشائع","la fausse dichotomie = خيار وهمي"]},{"h":"في النقاش المهني","p":["« Tout le monde le fait. » — appel à la majorité.","« Vous n’avez pas d’expérience. » — ad hominem.","« Ou bien on fait X, ou bien on fait Y. » — fausse dichotomie.","« C’est comme ça. » — pétition de principe."]},{"h":"خطوات la détection","p":["الخطوة الأولى: اكتب la prémisse la conclusion.","الثانية: اسأل عن la variable la condition المخفية.","الثالثة: اكتشف la faille la reformulation."]}]},{"h":"la carte des sophismes","p":["« Tout le monde le fait. » — appel à la majorité : la vérité ne se vote pas.","« Vous n’avez pas d’expérience. » — ad hominem : attaque la personne, ignore l’argument.","« Ou bien X, ou bien Y. » — fausse dichotomie : il existe souvent une troisième voie.","« C’est comme ça. » — pétition de principe : la conclusion suppose déjà la prémisse."]},{"h":"التطبيق والتلخيص","p":["تمرين la détection: اقرأ ثلاث صفحات من مناقشة سياسية وحدّد فيها sophisme واحدة واكتب la faille.","تمرين la reformulation: حوّل sophisme إلى la reformulation مهذّبة تكشف la variable la condition المخفية.","سجّل نفسك تشرح sophisme واحدة بالفرنسية لزميل: « attention, c’est une pétition de principe car… » — la explanation تثبّت la mécanique."]},{"h":"التطبيق والتلخيص","p":["تعلّمت أن le sophisme يخدع بالشكل لا بالمحتوى: l’ad hominem يهاجم الشخص، وl’homme de paille يشوّه الرأي، وla corrélation ليست causalité. مهارتك B2 هي إبطاء la réaction حتى تفحص la structure. أعد مشاهدة الفيديو الرئيسي وركّز على التمييز بين corrélation وcausalité.","جسر الدروس: من b2-t2-l3 (الرد على الاعتراض بأسلوب مهذّب) إلى b2-t2-l4 (اكتشاف المغالطات المنطقية)، ثم إلى b2-t2-l5 حيث تقيس الحجج في المقال والبرنامج الإعلامي.","مهمة تطبيقية: سجّل دقيقة صوتية تشرح فيها موقفاً من يومك مستخدماً ثلاث كلمات جديدة من الدرس (l’ad hominem، l’homme de paille، la pétition de principe)، ثم استمع للتسجيل وقارن نطقك ومفرداتك بما سمعته في الفيديو الرئيسي."]}],"pron":[{"w":"sophisme","ipa":"[sɔ.fism]","approx":"سوفسم"},{"w":"ad hominem","ipa":"[a.dɔ.mi.nɛm]","approx":"أدومنينيم"},{"w":"la fallacieux","ipa":"[fa.la.sjø]","approx":"فالاسيو"}],"vocab":[{"fr":"le sophisme","ar":"المغالطة المنطقية","pos":"nom","g":"m","exFr":"C’est un sophisme classique.","ipa":"[sɔ.fism]","exAr":"هذه مغالطة كلاسيكية."},{"fr":"la fallacieux","ar":"الخدّاع / المضلّل","pos":"nom","g":"m","exFr":"L’argument est fallacieux.","ipa":"[fa.la.sjø]","exAr":"الحجّة خدّاعة."},{"fr":"l’ad hominem","ar":"الهجوم على الشخص","pos":"nom","g":"m","exFr":"L’ad hominem évite le vrai débat.","ipa":"[a.dɔ.mi.nɛm]","exAr":"الهجوم على الشخص يتجنّب النقاش الحقيقي."},{"fr":"l’homme de paille","ar":"رجل القش / التشويه","pos":"nom","g":"m","exFr":"Créer un homme de paille est malhonnête.","ipa":"[ɔm də paj]","exAr":"إنشاء رجل القش غير مشروع."},{"fr":"l’appel à la majorité","ar":"الاحتكام إلى الشائع","pos":"nom","g":"m","exFr":"L’appel à la majorité ne prouve rien.","ipa":"[a.pɛl a la ma.ʃɔ.ʁite]","exAr":"الاحتكام إلى الشائع لا يثبت شيئاً."},{"fr":"la fausse dichotomie","ar":"الخيار الوهمي","pos":"nom","g":"f","exFr":"Cette dichotomie est fausse.","ipa":"[fos di.kɔ.tɔ.mi]","exAr":"هذا الخيار الوهمي."},{"fr":"la pétition de principe","ar":"الاستدلال الدائري","pos":"nom","g":"f","exFr":"C’est une pétition de principe.","ipa":"[pe.ti.sjɔ̃ də pʁɪ̃.sip]","exAr":"هذا استدلال دائري."},{"fr":"le biais","ar":"الانحياز المعرفي","pos":"nom","g":"m","exFr":"Le biais cognitif fausse le jugement.","ipa":"[bje]","exAr":"الانحياز المعرفي يُشوّه الحكم."},{"fr":"l’amalgame","ar":"الخلط / التعميم","pos":"nom","g":"m","exFr":"Faire un amalgame est dangereux.","ipa":"[a.mal.ɡam]","exAr":"عمل خلط خطير."},{"fr":"la généralisation","ar":"التعميم غير المشروع","pos":"nom","g":"f","exFr":"La généralisation est une erreur.","ipa":"[ʒe.ne.ʁa.li.za.sjɔ̃]","exAr":"التعميم خطأ."},{"fr":"la corrélation","ar":"الارتباط الإحصائي","pos":"nom","g":"f","exFr":"La corrélation n’est pas causalité.","ipa":"[kɔ.ʁe.la.sjɔ̃]","exAr":"الارتباط ليس سببية."},{"fr":"la causalité","ar":"السببية","pos":"nom","g":"f","exFr":"La causalité exige une preuve.","ipa":"[kɔ.za.li.te]","exAr":"السببية تتطلب دليلاً."}],"examples":[{"fr":"« Tout le monde le fait. » — appel à la majorité.","ar":"«الجميع يفعله.» — احتكام إلى الشائع.","note":"le sophisme"},{"fr":"« Vous n’avez pas d’expérience. » — ad hominem.","ar":"«ليس لديك خبرة.» — هجوم على الشخص.","note":"le sophisme"},{"fr":"« Ou bien on fait X, ou bien on fait Y. » — fausse dichotomie.","ar":"«إما نفعل X، أو نفعل Y.» — خيار وهمي.","note":"le sophisme"},{"fr":"« C’est comme ça. » — pétition de principe.","ar":"«هكذا هو الحال.» — استدلال دائري.","note":"le sophisme"},{"fr":"La corrélation n’est pas causalité.","ar":"الارتباط ليس سببية.","note":"la vérité logique"},{"fr":"Le biais cognitif fausse le jugement.","ar":"الانحياز المعرفي يُشوّه الحكم.","note":"le biais"}],"grammar":[{"tFr":"Les sophismes et la logique","tAr":"المغالطات والمنطق","body":["la sophisme تخدع بالشكل لا بالمحتوى: la conclusion تبدو مقنعة لكنها تختلّ العلاقة بين la prémisse والنتيجة. la mécanique لا la liste هي la cible.","« Si A alors B » — la sophisme يُخفي شرطاً أو يُغيّر la variable. la logique la grammaire متشابكة في هذا التحليل."],"ex":[{"fr":"Si tout le monde le fait, c’est bien. — appel à la majorité.","ar":"لو الجميع يفعله، فهو جيد. — احتكام إلى الشائع."},{"fr":"La corrélation n’est pas causalité.","ar":"الارتباط ليس سببية."}]},{"tFr":"La détection et la reformulation","tAr":"la détection la reformulation","body":["« Tout le monde le fait. » — appel à la majorité. « Vous n’avez pas d’expérience. » — ad hominem. « Ou bien X, ou bien Y. » — fausse dichotomie.","« C’est comme ça. » — pétition de principe : la conclusion suppose déjà la prémisse."],"ex":[{"fr":"Tout le monde le fait → appel à la majorité.","ar":"الجميع يفعله → احتكام إلى الشائع."},{"fr":"Vous n’avez pas d’expérience → ad hominem.","ar":"ليس لديك خبرة → هجوم على الشخص."}]}],"mistakes":[{"wrong":"la confusion la sophisme la réfutation","right":"la distinction la sophisme la réfutation","why":"la sophisme مغالطة منطقية، la réfutation حجّة علمية."},{"wrong":"la conviction la sophisme","right":"la détection la sophisme","why":"la sophisme تخدع بالشكل لا بالمحتوى."},{"wrong":"la lecture la sophisme","right":"la distinction la forme la fond","why":"la lecture تُفقد la naturalité."},{"wrong":"la reproduction la sophisme","right":"la production la réfutation","why":"la sophisme ليست la cible — la réfutation la cible."}],"dialogues":[{"title":"la sophisme","ctx":"نقاش مهني","lines":[{"who":"Marc","fr":"Tout le monde utilise ce logiciel, c’est bien.","ar":"الجميع يستخدم هذا البرنامج، إنه جيد."},{"who":"Nadia","fr":"C’est un appel à la majorité : la qualité reste à prouver.","ar":"هذا احتكام إلى الشائع: الجودة تبقى غير مثبتة."},{"who":"Marc","fr":"Vous n’avez pas d’expérience en la matière.","ar":"ليس لديك خبرة في هذا المجال."},{"who":"Nadia","fr":"Là, c’est un ad hominem : revenons à l’argument.","ar":"هنا هجوم على الشخص: لنعد إلى الحجّة."}]},{"title":"la réfutation","ctx":"استوديو مناقشة","lines":[{"who":"Claire","fr":"Ou bien on fait X, ou bien on fait Y.","ar":"إما نفعل X، أو نفعل Y."},{"who":"Karim","fr":"C’est une fausse dichotomie : il existe Z.","ar":"هذا خيار وهمي: يوجد Z."},{"who":"Claire","fr":"C’est comme ça, point final.","ar":"هكذا هو الحال، نقطة."},{"who":"Karim","fr":"C’est une pétition de principe : la conclusion suppose la prémisse.","ar":"هذا استدلال دائري: الخاتمة تفترض المقدمة."}]}],"exercises":[{"t":"mcq","skill":"argumentation","q":"ما « l’ad hominem »؟","opts":["الهجوم على الشخص","الاحتكام إلى الشائع","الخيار الوهمي","الاستدلال الدائري"],"a":0,"why":"ad hominem يهاجم الشخص لا الحجّة."},{"t":"fill","skill":"grammar","q":"أكمل: «La corrélation ___ causalité.»","fr":"La corrélation ___ causalité.","ans":"n’est pas","why":"la corrélation ≠ la causalité."},{"t":"mcq","skill":"argumentation","q":"ما « l’homme de paille »؟","opts":["التشويه","التعميم","الخلط","الاحتكام"],"a":0,"why":"l’homme de paille يشوّه la position la خصم."},{"t":"order","skill":"writing","q":"رتّب: الاحتكام إلى الشائع لا يثبت شيئاً","words":["L’appel","à","la","majorité","ne","prouve","rien."],"ans":"L’appel à la majorité ne prouve rien.","why":"la vérité logique."},{"t":"listen","skill":"listening","q":"ما « pétition de principe »؟","opts":["الاستدلال الدائري","التعميم","الخلط","الخيار الوهمي"],"a":0,"why":"la pétition de principe la conclusion suppose déjà la prémisse."},{"t":"translate","skill":"writing","q":"ترجم: «الجميع يفعله — هذا احتكام إلى الشائع.»","ans":"Tout le monde le fait — c’est un appel à la majorité.","why":"appel à la majorité."},{"t":"speaking","skill":"speaking","q":"اشرح sophisme واحدة بالفرنسية وزميلك يكتشفها.","target":"ad hominem / homme de paille / pétition de principe","why":"la mécanique la sophisme."},{"t":"correct","skill":"grammar","q":"صحّح: «Vous n’avez pas d’expérience, donc vous avez tort.»","ans":"Votre expérience est limitée, mais l’argument reste valable.","why":"ad hominem يُرفض بالرجوع إلى la prémisse la conclusion."}],"homework":"اقرأ ثلاث صفحات من مناقشة سياسية فرنسية، حدد فيها sophisme واحدة، واكتب ردّاً علمياً يكشف la faille.","sources":[{"title":"Les sophismes : détectez les arguments fallacieux","channel":"Le français by Alex","videoId":"Hi7Nm3JSXag","why":"شرح les sophismes الشائعة في النقاشات الفرنسية: ad hominem, l’homme de paille, l’appel à la majorité — وكيف تكشفها في الحقيقة.","cat":"Débat","level":"B2","main":true},{"title":"Les sophismes les plus courants","channel":"Le français by Alex","videoId":"JKMcILxOYLs","why":"قائمة منظّمة بأخطر les sophismes مع أمثلة سياقية.","cat":"Débat","level":"B2","extra":true},{"title":"Logique et argumentation en français","channel":"Français Authentique","videoId":"Dh3STYQ0yWM","why":"شرح la mécanique la sophisme la réfutation في النقاش.","cat":"Débat","level":"B2","extra":true}],"supplements":[{"id":"JKMcILxOYLs","title":"Les sophismes les plus courants","channel":"Le français by Alex","why":"قائمة منظّمة بأخطر les sophismes مع أمثلة سياقية.","lang":"fr","dur":15},{"id":"Dh3STYQ0yWM","title":"Logique et argumentation en français","channel":"Français Authentique","why":"شرح la mécanique la sophisme la réfutation في النقاش.","lang":"fr","dur":16}]},{"id":"b2-t2-l5","fr":"L’argumentation dans les médias","ar":"الحجاج في وسائل الإعلام","objectives":["تحليل la structure l’argumentation dans un article ou un reportage","تمييز le fait (le constat) عن le jugement (la thèse)","استعمال connecteurs médiatiques: en effet, en revanche, par ailleurs, selon","اكتشاف la source و le biais في la information"],"sections":[{"h":"الدرس 5: كيف تقرأ الحجج في المقال والبرنامج الإعلامي","video":{"id":"R3GIYkOsrxc","title":"Cours de français - Argumenter en français - Cours 2","channel":"French School TV","why":"شرح la méthode l’argumentation داخل le contexte médiatique: كيف يبني le journaliste sa thèse، يستعمل les chiffres، ثم يردّ على les objections.","lang":"fr","main":true,"dur":18},"p":["في les médias français، le discours لا يُقدَّم كـ opinion بل كـ constat: « Selon une étude… », « Les chiffres montrent que… ». la première مهمة B2 هي la séparation بين le fait الموثّق و le jugement المقنَّع.","معجم الدرس: l’argument, la preuve, la source, le sondage, le chiffre, la thèse, la contre-argumentation, la rhétorique, le titre, la légende, l’angle, la rédaction. هذه المفردات تكشف بنية le discours الإعلامي.","نحوياً، la voix passive تخفي le sujet: « Il a été décidé que… » — من قرَّر؟ و la nominalisation تختصر المعنى: « l’augmentation du chômage » بدل « le chômage augmente ». هما la signature de la langue médiatique.","les connecteurs توجّه le lecteur قبل أن يلاحظ: « En effet » تؤكِّد، « En revanche » تُعاكس، « Par ailleurs » تُضيف، « Néanmoins » تُخفِّف. من يملك les connecteurs يملك la direction de la lecture.","la règle la critique: اسأل دائماً عن la source. « Selon un sondage… » — من طرح السؤال؟ على من العينة؟ ومتى؟ la source غير المعلنة هي le premier signal de biais.","بعد الدرس: اقرأ افتتاحية سياسية فرنسية، ألوِّن la thèse، ثم les arguments، ثم la contre-argumentation، واكتب فقرة تكشف les angles الغائبة عن la rédaction."],"sub":[{"h":"بنية l’argument médiatique","p":["Le constat s’impose : les chiffres le montrent.","En effet, la mesure répond à une exigence réelle.","En revanche, ses effets restent difficiles à évaluer."]},{"h":"أدوات نطقية: la source","p":["« Selon un sondage… » [sɔ̃.daʒ] — la source avant le chiffre.","« Rien ne prouve que… » — le doute méthodique.","« En tout cas, les données confirment… » — la transition vers la preuve."]},{"h":"خطوات la lecture critique","p":["المرة الأولى: اكتب la thèse في جملة واحدة.","الثانية: احسب les arguments و les connecteurs المستعملة.","الثالثة: حدد la source و le angle الغائب."]}]},{"h":"la carte l’argumentation médiatique","p":["« Selon une étude publiée par… » = وفق دراسة نشرتها… — la source oblige.","« En effet, les chiffres le confirment. » = فعلاً، الأرقام تؤكد ذلك. — la preuve.","« En revanche, les effets restent limités. » = بعكس ذلك، الآثار محدودة. — la contre-argumentation.","« Rien ne permet d’affirmer que… » = لا شيء يسمح بالتأكيد أن… — la nuance la plus forte."]},{"h":"التطبيق والتلخيص","p":["تمرين la décomposition: خذ مقالاً قصيراً، اكتب la thèse، ثم les arguments الثلاثة، ثم la contre-argumentation.","تمرين la source: احذف كل les citations de source ولاحظ كيف يتحوّل le fait إلى opinion.","سجّل نفسك تشرح la thèse d’un article في 45 ثانية بـ les connecteurs الثلاثة: en effet، en revanche، néanmoins."]},{"h":"التطبيق والتلخيص","p":["في هذا الدرس قرأت الحجج داخل les médias: كيف يُقدَّم le discours كـ constat، وكيف تكشف «Selon une étude…» la source. فحصت le sondage وle chiffre وle parti pris قبل تصديق أي عنوان. أعد مشاهدة الفيديو الرئيسي وركّز على «Selon une étude…» وكشف le parti pris.","جسر الدروس: من b2-t2-l4 (اكتشاف المغالطات المنطقية) إلى b2-t2-l5 (قراءة الحجج في المقال الإعلامي)، ثم إلى b2-t2-l6 حيث تتحدث أمام الجمهور بثقة وبنية.","مهمة تطبيقية: سجّل دقيقة صوتية تشرح فيها موقفاً من يومك مستخدماً ثلاث كلمات جديدة من الدرس (le sondage، la preuve، le parti pris)، ثم استمع للتسجيل وقارن نطقك ومفرداتك بما سمعته في الفيديو الرئيسي."]}],"pron":[{"w":"l’argument","ipa":"[aʁ.ʒə.mɑ̃]","approx":"أرجومان"},{"w":"le sondage","ipa":"[lə sɔ̃.daʒ]","approx":"لو سونداج"},{"w":"la source","ipa":"[la sɔʁs]","approx":"لا سورس"}],"vocab":[{"fr":"l’argumentaire","ar":"السلسلة الحجاجية المكتوبة","pos":"nom","g":"m","exFr":"L’argumentaire du journal est solide.","exAr":"سلسلة حجج الجريدة متينة.","ipa":"[aʁ.ɡu.mɑ̃.tɛʁ]"},{"fr":"la preuve","ar":"الدليل","pos":"nom","g":"f","exFr":"Il manque une preuve irréfutable.","ipa":"[pʁœv]","exAr":"ينقص دليل لا يُدحض."},{"fr":"la source","ar":"المصدر","pos":"nom","g":"f","exFr":"Quelle est la source de cette donnée ?","ipa":"[sɔʁs]","exAr":"ما مصدر هذه المعطاة؟"},{"fr":"le sondage","ar":"الاستطلاع","pos":"nom","g":"m","exFr":"Ce sondage porte sur mille personnes.","ipa":"[sɔ̃.daʒ]","exAr":"هذا الاستطلاع شمل ألف شخص."},{"fr":"le chiffre","ar":"الرقم","pos":"nom","g":"m","exFr":"Les chiffres parlent d’eux-mêmes.","ipa":"[ʃifʁ]","exAr":"الأرقام تتحدث عن نفسها."},{"fr":"le parti pris","ar":"الانحياز الفكري","pos":"nom","g":"m","exFr":"L’article a un parti pris évident.","exAr":"المقال فيه انحياز واضح.","ipa":"[paʁti pʁi]"},{"fr":"le démenti","ar":"النفي الرسمي / التكذيب","pos":"nom","g":"m","exFr":"Le communiqué est un démenti officiel.","exAr":"البيان نفي رسمي.","ipa":"[de.mɑ̃.ti]"},{"fr":"le sondage d’opinion","ar":"استطلاع الرأي","pos":"nom","g":"m","exFr":"Le sondage d’opinion divise les partis.","ipa":"[sɔ̃.daʒ dɔ.pi.njɔ̃]","exAr":"استطلاع الرأي يُقسِّم الأحزاب."},{"fr":"la légende","ar":"التسمية التوضيحية","pos":"nom","g":"f","exFr":"La légende explique le graphique.","ipa":"[le.ʒɑ̃d]","exAr":"التسمية التوضيحية تشرح الرسم البياني."},{"fr":"le titre accrocheur","ar":"العنوان الجذّاب","pos":"nom","g":"m","exFr":"Le titre accrocheur attire le lecteur.","ipa":"[lə titʁ a.kʁɔ.ʃœʁ]","exAr":"العنوان الجذّاب يجذب القارئ."},{"fr":"étayer","ar":"يؤيّد بالحجة","pos":"verbe","g":"","exFr":"Il étaye son propos avec des chiffres.","exAr":"يؤيّد كلامه بالأرقام.","ipa":"[e.tɛ.je]"},{"fr":"relativiser","ar":"يُخفّف من صحة الادعاء","pos":"verbe","g":"","exFr":"Le journaliste relativise les chiffres.","exAr":"يخفّف الصحفي من صحة الأرقام.","ipa":"[ʁə.la.ti.vi.ze]"}],"examples":[{"fr":"Selon un sondage, 60 % des Français sont favorables.","ar":"وفق استطلاع، 60 بالمائة من الفرنسيين موافقون.","note":"la source"},{"fr":"En effet, les chiffres confirment la tendance.","ar":"فعلاً، الأرقام تؤكد الاتجاه.","note":"connecteur de confirmation"},{"fr":"En revanche, les effets restent limités.","ar":"بعكس ذلك، الآثار تبقى محدودة.","note":"connecteur d’opposition"},{"fr":"Il a été décidé d’ouvrir une commission.","ar":"تمّ التقرير على فتح لجنة.","note":"la voix passive"},{"fr":"L’augmentation du chômage inquiète les économistes.","ar":"ارتفاع البطالة يُقلق الاقتصاديين.","note":"la nominalisation"},{"fr":"Rien ne prouve que la mesure soit efficace.","ar":"لا شيء يُثبت أن الإجراء فعّال.","note":"la nuance"}],"grammar":[{"tFr":"La voix passive et la nominalisation dans la presse","tAr":"المبني للمجهول وnominalisation في الصحافة","body":["la presse تستعمل la voix passive لإخفاء le sujet: « Il a été annoncé que… » — من أعلن؟ و la nominalisation تحوّل les actions إلى noms: « la fermeture de l’usine » بدل « l’usine ferme ».","هذا يجعل la phrase objective ومقتصدة، ويجعل le lecteur يقبل la thèse دون أن يبحث عن le responsable."],"ex":[{"fr":"Il a été décidé de reporter le vote.","ar":"تمّ التقرير على تأجيل التصويت."},{"fr":"La fermeture de l’usine menace trois cents emplois.","ar":"إغلاق المصنع يهدّد ثلاثمائة منصب شغل."}]},{"tFr":"Les connecteurs d’argumentation médiatique","tAr":"أدوات الحجاج في اللغة الإعلامية","body":["« En effet » تعطي la preuve، « En revanche » تعطي la contre-argumentation، « Par ailleurs » تُضيف عناصر جديدة، « Néanmoins » تُخفِّف la thèse.","ترتيبها في le paragraphe يحدّد la progression: constat ← preuve ← objection ← nuance. غيابها يجعل le discours مجرد انطباع."],"ex":[{"fr":"La mesure est impopulaire ; en effet, les sondages le montrent.","ar":"الإجراء غير شائع؛ فعلاً، الاستطلاعات تُظهر ذلك."},{"fr":"Les effets sont réels, néanmoins ils restent fragiles.","ar":"الآثار حقيقية، ومع ذلك تبقى هشّة."}]}],"mistakes":[{"wrong":"قبول le titre كـ la thèse كاملة","right":"قراءة le titre ثم le premier paragraphe ثم la source","why":"le titre accrocheur مصمَّم للاستقطاب لا للتحليل."},{"wrong":"الخلط بين le fait et le jugement","right":"« les chiffres montrent… » ≠ « il est évident que… »","why":"le fait يُتحقَّق، le jugement يُناقَش."},{"wrong":"تجاهل la source","right":"السؤال الدائم: qui ? quand ? comment ?","why":"la source غير المعلنة هي le premier signal de biais."},{"wrong":"la voix passive كـ la neutralité","right":"la voix passive تخفي le sujet","why":"« il a été décidé » تسأل دائماً: par qui ?"}],"dialogues":[{"title":"تحليل مقال","ctx":"طالبان يناقشان افتتاحية","lines":[{"who":"Marc","fr":"Le titre affirme que la réforme échoue.","ar":"العنوان يُؤكد أن الإصلاح فشل."},{"who":"Nadia","fr":"Mais où est la source de cette affirmation ?","ar":"وأين مصدر هذا الادّعاء؟"},{"who":"Marc","fr":"En effet, aucun sondage n’est cité.","ar":"فعلاً، لا استطلاع مُستشهَد به."},{"who":"Nadia","fr":"Alors ce n’est qu’une thèse, pas un fait.","ar":"إذن إنها أطروحة فقط، لا واقعة."}]},{"title":"في هيئة تحرير","ctx":"محرّرة تراجع تقريراً","lines":[{"who":"Cheffe","fr":"Votre paragraphe manque de connecteurs.","ar":"فقرتك تفتقر إلى أدوات الربط."},{"who":"Reporter","fr":"Je peux ajouter « en revanche » après les chiffres.","ar":"أستطيع إضافة «بعكس ذلك» بعد الأرقام."},{"who":"Cheffe","fr":"Parfait, et citez la source avant la conclusion.","ar":"ممتاز، واستشهد بالمصدر قبل الخاتمة."},{"who":"Reporter","fr":"D’accord, la progression sera plus claire.","ar":"حسناً، سيكون التقدّم أوضح."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما معنى « le sondage »؟","opts":["الاستطلاع","التقرير","العنوان","الرأي"],"a":0,"why":"le sondage = استطلاع رأي منظَّم."},{"t":"fill","skill":"grammar","q":"أكمل: «___, les chiffres le confirment.»","fr":"___, les chiffres le confirment.","ans":"En effet","why":"en effet يقدّم la preuve."},{"t":"mcq","skill":"analysis","q":"ما وظيفة la voix passive في la presse ?","opts":["إخفاء le sujet","التوكيد","التعجب","النفي"],"a":0,"why":"« il a été décidé » تُخفي من قرَّر."},{"t":"order","skill":"writing","q":"رتّب: وفق استطلاع، ستون بالمائة موافقون","words":["Selon","un","sondage,","soixante","pour","cent","sont","favorables."],"ans":"Selon un sondage, soixante pour cent sont favorables.","why":"la source تسبق la donnée."},{"t":"listen","skill":"listening","q":"ما « en revanche » في le discours ?","opts":["la contre-argumentation","la confirmation","l’addition","la conclusion"],"a":0,"why":"en revanche تعكس la thèse."},{"t":"translate","skill":"writing","q":"ترجم: لا شيء يُثبت أن الإجراء فعّال.","ans":"Rien ne prouve que la mesure soit efficace.","why":"rien ne prouve que + subjonctif."},{"t":"speaking","skill":"speaking","q":"اشرح la thèse d’un article في 45 ثانية بثلاثة connecteurs.","target":"Le constat… / En effet… / En revanche… / Néanmoins…","why":"la progression l’argumentation."},{"t":"correct","skill":"analysis","q":"صحّح: «C’est évident que tout le monde est d’accord.»","ans":"Selon un sondage, une majorité semble d’accord.","why":"la source تحل محل la certitude."}],"homework":"اقرأ افتتاحية سياسية فرنسية، حدد فيها la thèse et les arguments، ثم اكتب فقرة من 120 كلمة تكشف la source و le angle الغائب.","sources":[{"title":"Cours de français - Argumenter en français - Cours 2","channel":"French School TV","videoId":"R3GIYkOsrxc","why":"شرح la méthode l’argumentation داخل le contexte médiatique: كيف يبني le journaliste sa thèse، يستعمل les chiffres، ثم يردّ على les objections.","cat":"Débat","level":"B2","main":true},{"title":"Logique et argumentation en français","channel":"Français Authentique","videoId":"Dh3STYQ0yWM","why":"la mécanique l’argumentation: thèse، preuve، objection — la base pour lire les médias.","cat":"Débat","level":"B2","extra":true},{"title":"50 Expressions Idiomatiques Françaises | 50 Essential French Idioms","channel":"French with Alicia","videoId":"WxNRvm5yVJ0","why":"expressions idiomatiques qui portent la nuance dans le discours médiatique.","cat":"Débat","level":"B2","extra":true}],"supplements":[{"id":"Dh3STYQ0yWM","title":"Logique et argumentation en français","channel":"Français Authentique","why":"la mécanique l’argumentation: thèse، preuve، objection — la base pour lire les médias.","lang":"fr","dur":16},{"id":"WxNRvm5yVJ0","title":"50 Expressions Idiomatiques Françaises | 50 Essential French Idioms","channel":"French with Alicia","why":"expressions idiomatiques qui portent la nuance dans le discours médiatique.","lang":"fr","dur":15}]},{"id":"b2-t2-l6","fr":"La prise de parole en public","ar":"الكلام أمام الجمهور","objectives":["بناء discours من ثلاث دقائق: accroche, thèse, arguments, conclusion","استعمال les marqueurs de présence: donc, voici, je vais à présent","التعامل مع le trac: la respiration، le débit، le silence","الردّ على les questions من le public بـ la reformulation"],"sections":[{"h":"الدرس 6: كيف تتحدث أمام جمهور بثقة وبنية واضحة","video":{"id":"QhysP1PazZA","title":"Prendre la parole en public : les clés de l’impact","channel":"French with Alicia","why":"شرح la prise de parole: كيف تبني l’introduction، تحافظ على le rythme، وتردّ على les objections دون أن تفقد le fil.","lang":"fr","main":true,"dur":12},"p":["la prise de parole في la culture française تُقاس بـ la structure لا بـ le charisme: accroche قصيرة، thèse في جملة واحدة، deux arguments، ثم une conclusion qui ouvre le débat. le public الفرنسي يتوقع la progression، لا la performance.","معجم الدرس: l’accroche, l’annonce, la conclusion, le débit, le silence, le trac, l’audience, la question-réponse, reformuler, conclure, la transition, l’exemple. هذه المفردات تبني le discours خطوة بخطوة.","نحوياً، l’impératif يوجّه le public: « Regardez ce chiffre. »، و le conditionnel يُخفّف la critique: « On pourrait se demander si… ». la conjonction « pour que » تربط la thèse بـ la conséquence.","la gestion du trac ليست la suppression de la peur بل la canalisation: respirer قبل la première phrase، ترك le premier exemple يمرّ ببطء، ثم تسريع le débit مع le deuxième argument.","le silence أقوى من les mots: صمت ثانيتين بعد la citation يمنح le public le temps للاستيعاب. من يملأ كل ثانية بكلام يُفقد le propos وزنه.","بعد الدرس: سجّل نفسك تقدّم trois minutes عن موضوع واحد، استمع، ثم احسب les connecteurs و les silences — وسجّل نسخة ثانية أكثر هدوءاً."],"sub":[{"h":"بنية l’intervention","p":["Bonjour, je vais vous présenter trois points.","Mon argument principal est le suivant : la durée compte.","Pour conclure, je vous propose une question ouverte."]},{"h":"أدوات نطقية: la présence","p":["« Voici le chiffre clé. » [vwa.si] — le débit ralenti.","« Autrement dit… » — la reformulation pour le public.","« Laissez-moi terminer. » — la gestion de la parole."]},{"h":"خطوات la préparation","p":["الخطوة الأولى: écrire la phrase-thèse.","الثانية: choisir deux examples فقط.","الثالثة: répéter avec un chronomètre."]}]},{"h":"عبارات la prise de parole","p":["« Je vais être bref :… » = سأكون موجزاً… — l’annonce qui rassure le public.","« Concrètement, cela signifie que… » = عملياً، هذا يعني أن… — l’exemple après la thèse.","« Je nuance mon propos. » — la preuve de la réflexion avant la conclusion.","« Qu’en pensez-vous ? » = ما رأيكم؟ — la transition vers le débat."]},{"h":"التطبيق والتلخيص","p":["تمرين la minute: قدّم نفسك وفكرتك في 60 ثانية بالساعة، بدون ورقة.","تمرين le silence: بعد la phrase الأولى، اترك ثانيتين صامتين ثم تابع.","سجّل أسئلة متوقعة و جهّز reprise لكل سؤال بـ « C’est une excellente question, voici mon point… »."]},{"h":"التطبيق والتلخيص","p":["تعلّمت la structure la prise de parole: l’accroche، ثم la thèse في جملة، ثم argumentان، ثم conclusion تفتح le débat. تدربت على la question-réponse بعد l’annonce. أعد مشاهدة الفيديو الرئيسي وركّز على l’accroche ثم la thèse في جملة ثم الأسئلة.","جسر الدروس: من b2-t2-l5 (قراءة الحجج في المقال الإعلامي) إلى b2-t2-l6 (الكلام أمام الجمهور ببنية واضحة)، ثم إلى b2-t3-l1 حيث تنتقل إلى مخزون المترادفات المتقدمة.","مهمة تطبيقية: سجّل دقيقة صوتية تشرح فيها موقفاً من يومك مستخدماً ثلاث كلمات جديدة من الدرس (l’accroche، le trac، conclure)، ثم استمع للتسجيل وقارن نطقك ومفرداتك بما سمعته في الفيديو الرئيسي."]}],"pron":[{"w":"l’accroche","ipa":"[a.kʁɔʃ]","approx":"أكروش"},{"w":"le débit","ipa":"[lə de.bi]","approx":"لو دِبي"},{"w":"reformuler","ipa":"[ʁə.fɔʁ.my.le]","approx":"ريفورميليه"}],"vocab":[{"fr":"la prise de parole","ar":"التدخل الكلامي","pos":"loc.","g":"","exFr":"Sa prise de parole a marqué l’assemblée.","ipa":"","exAr":"تدخله نوَّى في الجمع."},{"fr":"l’accroche","ar":"الافتتاحية الجذّابة","pos":"nom","g":"f","exFr":"L’accroche doit durer dix secondes.","ipa":"[a.kʁɔʃ]","exAr":"الافتتاحية يجب أن تدوم عشر ثوانٍ."},{"fr":"le débit","ar":"سرعة الكلام","pos":"nom","g":"m","exFr":"Votre débit est trop rapide.","ipa":"[de.bi]","exAr":"سرعتك في الكلام سريعة جداً."},{"fr":"le trac","ar":"الخوف المسبق من الإلقاء","pos":"nom","g":"m","exFr":"Il a le trac avant de parler.","ipa":"[tʁak]","exAr":"يعاني من الخوف قبل الكلام."},{"fr":"le silence","ar":"الصمت","pos":"nom","g":"m","exFr":"Un silence suffit pour marquer.","ipa":"[si.lɑ̃s]","exAr":"صمت واحد يكفي لترك أثر."},{"fr":"reformuler","ar":"يُعيد الصياغة","pos":"verbe","g":"","exFr":"Pouvez-vous reformuler votre question ?","ipa":"[ʁə.fɔʁ.my.le]","exAr":"هل يمكنك إعادة صياغة سؤالك؟"},{"fr":"conclure","ar":"يستخلص/يجتلي","pos":"verbe","g":"","exFr":"Je conclus par une ouverture.","ipa":"[kɔ̃klyʁ]","exAr":"أختتم بتفتح."},{"fr":"l’audience","ar":"الجمهور المستمع","pos":"nom","g":"f","exFr":"Parlez à l’audience, pas à vos notes.","ipa":"[o.djɑ̃s]","exAr":"خاطب الجمهور، لا ملاحظاتك."},{"fr":"la transition","ar":"الانتقال","pos":"nom","g":"f","exFr":"La transition est fluide.","ipa":"[tʁɑ̃.zi.sjɔ̃]","exAr":"الانتقال سلس."},{"fr":"l’annonce","ar":"الإعلان عن البنية","pos":"nom","g":"f","exFr":"L’annonce annonce trois parties.","ipa":"[a.nɔ̃s]","exAr":"الإعلان يُميّز ثلاثة أجزاء."},{"fr":"la conclusion","ar":"الخاتمة","pos":"nom","g":"f","exFr":"La conclusion ouvre le débat.","ipa":"[kɔ̃kly.zjɔ̃]","exAr":"الخاتمة تفتح النقاش."},{"fr":"s’adresser à","ar":"يوجّه كلامه إلى","pos":"loc.","g":"","exFr":"Il s’adresse directement au public.","ipa":"","exAr":"يوجّه كلامه مباشرة إلى الجمهور."}],"examples":[{"fr":"Je vais être bref : trois points, pas plus.","ar":"سأكون موجزاً: ثلاث نقاط، لا أكثر.","note":"l’annonce"},{"fr":"Concrètement, cela signifie une hausse de dix pour cent.","ar":"عملياً، هذا يعني زيادة قدرها عشرة بالمائة.","note":"l’exemple"},{"fr":"Autrement dit, la mesure change la donne.","ar":"بعبارة أخرى، الإجراء يغيّر المعطيات.","note":"la reformulation"},{"fr":"Je nuance mon propos : les effets sont inégaux.","ar":"أُدخّل تمييزاً إلى كلامي: الآثار غير متساوية.","note":"la nuance"},{"fr":"Laissez-moi terminer, puis je répondrai.","ar":"دعوني أنهي، ثم سأجيب.","note":"la gestion de la parole"},{"fr":"Qu’en pensez-vous ?","ar":"ما رأيكم في ذلك؟","note":"la question ouverte"}],"grammar":[{"tFr":"L’impératif et le conditionnel dans le discours","tAr":"الأمر والشرطية في الخطابة","body":["l’impératif يمنح le discours la force: « Regardez ce chiffre. », « Pensez à… ». le conditionnel يُخفّف la critique ويترك le débat ouvert: « On pourrait objecter que… ».","l’alternaison بينهما هي le rythme du discours: أمسك ثم تهذيب. من يستعمل l’impératif فقط يبدو أوامرياً، ومن يستعمل le conditionnel فقط يبدو ضعيفاً."],"ex":[{"fr":"Regardez ce chiffre : douze pour cent.","ar":"انظروا إلى هذا الرقم: اثنا عشر بالمائة."},{"fr":"On pourrait objecter que les données sont anciennes.","ar":"يمكن الاعتراض على أن المعطيات قديمة."}]},{"tFr":"Pour que et afin que : la finalité dans le discours","tAr":"pour que و afin que: الغاية في الخطابة","body":["« pour que » + subjonctif تربط la thèse بـ la conséquence visée: « Je parle lentement pour que tout le monde comprenne. »","« afin que » أكثر رسمية وتُستعمل dans le discours soutenu — la même règle grammaticale، une nuance de registre."],"ex":[{"fr":"Je répète pour que le public retienne l’idée.","ar":"أُكرّر لكي يحتفظ الجمهور بالفكرة."},{"fr":"J’ai cité cette source afin que le propos soit solide.","ar":"استشهدت بهذا المصدر لكي يكون الكلام متيناً."}]}],"mistakes":[{"wrong":"البدء بـ « Bonjour, je ne sais pas trop par où commencer… »","right":"une accroche directe: « Trois points, dix minutes. »","why":"le public الفرنسي يقدّر la structure لا les excuses."},{"wrong":"lire son texte mot à mot","right":"parler par idées avec le débit ralenti","why":"la lecture tue le contact avec l’audience."},{"wrong":"remplir chaque silence","right":"utiliser le silence après la citation","why":"le silence donne du poids à la phrase."},{"wrong":"répondre à la question par une autre question","right":"reformuler la question puis répondre","why":"« C’est une excellente question… » montre le contrôle."}],"dialogues":[{"title":"répétition avant l’oral","ctx":"colleague coaching","lines":[{"who":"Claire","fr":"Ton introduction dure une minute, c’est trop.","ar":"مقدّمتك تدوم دقيقة، هذا كثير."},{"who":"Karim","fr":"Alors je commence directement par la thèse ?","ar":"إذن أبدأ مباشرة بالأطروحة؟"},{"who":"Claire","fr":"Oui : une accroche, puis la thèse en une phrase.","ar":"نعم: افتتاحية، ثم الأطروحة في جملة."},{"who":"Karim","fr":"D’accord, et je laisse un silence après.","ar":"حسناً، وأترك صمتاً بعدها."}]},{"title":"question du public","ctx":"conférence","lines":[{"who":"Public","fr":"Votre chiffre me semble contestable.","ar":"رقمك يبدو قابلاً للنقاش عندي."},{"who":"Marc","fr":"C’est une excellente question, voici la source.","ar":"سؤال ممتاز، هذا هو المصدر."},{"who":"Public","fr":"Mais la période est-elle comparable ?","ar":"وهل الفترة قابلة للمقارنة؟"},{"who":"Marc","fr":"Je nuance : les deux années diffèrent légèrement.","ar":"أُدخل تمييزاً: السنتان تختلفان قليلاً."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما معنى « le trac »؟","opts":["الخوف المسبق من الإلقاء","السرعة","الصمت","الجمهور"],"a":0,"why":"le trac هو التوتر قبل le discours."},{"t":"fill","skill":"grammar","q":"أكمل بـ le subjonctif: «Je répète pour que vous___ (comprendre).»","fr":"Je répète pour que vous ___ comprendre.","ans":"compreniez","why":"pour que + subjonctif."},{"t":"mcq","skill":"speaking","q":"ما la meilleure ouverture d’un discours ?","opts":["« Trois points, dix minutes. »","« Je ne suis pas préparé… »","« Attendez, je cherche mes notes… »","« Bon, on verra bien. »"],"a":0,"why":"l’annonce brève rassure le public."},{"t":"order","skill":"writing","q":"رتّب: ثلاث نقاط، دقيقتان، ثم أسئلتكم","words":["Trois","points,","deux","minutes,","puis","vos","questions."],"ans":"Trois points, deux minutes, puis vos questions.","why":"l’annonce structure le débat."},{"t":"listen","skill":"listening","q":"ما « autrement dit »؟","opts":["la reformulation","la conclusion","l’accroche","la concession"],"a":0,"why":"autrement dit = reformulation."},{"t":"translate","skill":"writing","q":"ترجم: عملياً، هذا يعني زيادة قدرها عشرة بالمائة.","ans":"Concrètement, cela signifie une hausse de dix pour cent.","why":"l’exemple après la thèse."},{"t":"speaking","skill":"speaking","q":"قدّم una minute d’argumentation عن موضوع واحد مع accroche و conclusion.","target":"Je vais être bref… / Mon argument… / En effet… / Pour conclure…","why":"la structure complète."},{"t":"correct","skill":"grammar","q":"صحّح: «Je parle lentement pour que tout le monde comprend.»","ans":"Je parle lentement pour que tout le monde comprenne.","why":"pour que exige le subjonctif."}],"homework":"سجّل discours من ثلاث دقائق عن فكرة تدافع عنها، ثم استمع واحسب: كم connecteur؟ كم silence؟ كم exemple — وسجّل نسخة ثانية أهدأ.","sources":[{"title":"Prendre la parole en public : les clés de l’impact","channel":"French with Alicia","videoId":"QhysP1PazZA","why":"شرح la prise de parole: كيف تبني l’introduction، تحافظ على le rythme، وتردّ على les objections دون أن تفقد le fil.","cat":"Débat","level":"B2","main":true},{"title":"Prise de parole en public : réussir son oral","channel":"Le français by Alex","videoId":"F8tQPh-MpkE","why":"méthode complète: accroche، débit، conclusion — التطبيق المباشر للدرس.","cat":"Débat","level":"B2","extra":true},{"title":"Les connecteurs logiques en français","channel":"Français Authentique","videoId":"MEf8oQXG-OE","why":"les connecteurs qui structurent le discours oral devant un public.","cat":"Débat","level":"B2","extra":true}],"supplements":[{"id":"F8tQPh-MpkE","title":"Prise de parole en public : réussir son oral","channel":"Le français by Alex","why":"méthode complète: accroche، débit، conclusion — التطبيق المباشر للدرس.","lang":"fr","dur":14},{"id":"MEf8oQXG-OE","title":"Les connecteurs logiques en français","channel":"Français Authentique","why":"les connecteurs qui structurent le discours oral devant un public.","lang":"fr","dur":12}]}]},{"id":"b2-t3","slug":"nuances-et-synonymes","icon":"layers","color":"#ca8a04","fr":"Nuances et synonymes","ar":"الفروق الدقيقة بين الكلمات","desc":"المرادفات، la prépositions، les verbes confusables، les registres، les collocations — la carte lexicale B2.","lessons":[{"id":"b2-t3-l1","fr":"100 synonymes B2-C1","ar":"مئة مترادف للمستوى B2-C1","objectives":["استبدال الصفات الشائعة بمرادفات أدق حسب السياق","تمييز الفروق الدقيقة بين مترادفات متقاربة","توظيف المترادفات في الكتابة الأكاديمية والمهنية","تجنب الازدواج والتكرار في النص الطويل"],"sections":[{"h":"الدرس 1: توقف عن تكرار « très bon » و« très grand »","video":{"id":"NFaRv9BYMMk","title":"Ne dis pas toujours « très grand » ! À la place, utilise ces synonymes","channel":"MatthieuProfesseurFR","why":"بدائل دقيقة لكلمات شائعة جداً (très grand, très bon) ترفع حديثك من المستوى العام إلى مستوى متقدّم.","lang":"fr","main":true,"dur":11},"p":["المشكلة في المستوى B2 ليست نقص الكلمات، بل تكرار نفس الكلمة خمس مرات في فقرة: « très grand », « très beau », « très bon ». الفرنسي المتقدّم يُبدّل المفردات ويُدرج التدرّج: grand ثم imposant ثم colossal حسب القوة المطلوبة.","معجم الدرس: immense, colossal, démesuré, splendide, magnifique, remarquable, excellent, ravi, enchanté, extrêmement, particulièrement, franchement. هذه الكلمات ليست مترادفات مطلقة، بل سلّم قوة يُختار درجه حسب الموقف.","نحوياً، المرادفات تخضع لنفس قواعد المطابقة: صفة مفردة تُؤنَّث مع الاسم المؤنث (« une journée splendide »)، وفعل يأخذ بنفسه مفعوله (« il admire le paysage » مقابل « il contemple le paysage » بصري).","الفارق الأهم: المفردة المعيارية (neutre) تصلح في كل السياقات، أما المفردة القوية فتفقد قوتها إذا أُفرط فيها. كلمة « exceptionnel » تُستعمل لشيء واحد استثنائياً لا لخمسة أشياء متتالية.","قاعدة الاختيار: اسأل عن السياق أولاً. في التقرير: « remarquable », « notable ». في الوصف الأدبي: « splendide », « ravissant ». في المحادثة اليومية: « super », « top ». المرادف الصحيح يخدم الدور لا المعنى فقط.","بعد الدرس: أعد كتابة فقرة قديمة من كتابتك مستخدماً خمس مترادفات مختلفة، ثم ضع الكلمات الأصلية في هامش الصفحة وقارن: هل ارتفع المستوى أم تغيّر المعنى فقط؟"],"sub":[{"h":"Remplacer « très grand »","p":["C’est un immeuble immense.","Le mont est colossal.","Il y a un décalage énorme entre les deux."]},{"h":"Remplacer « très beau »","p":["La vue est splendide depuis la terrasse.","Ce soir, la ville est magnifique.","Elle a une robe ravissante."]},{"h":"Remplacer « très content »","p":["Je suis ravi de votre venue.","Nous sommes enchantés de vous accueillir.","Il était très satisfait du résultat."]}]},{"h":"Le palmarès des remplacements utiles","p":["« Très grand » → immense, colossal, démesuré selon la force voulue.","« Très bon » → excellent, remarquable, de premier ordre.","« Très content » → ravi, enchanté, comblé.","« Très » lui-même → extrêmement, particulièrement, franchement."]},{"h":"التطبيق والتلخيص","p":["تمرين السلّم: رتّب كل مجموعة تصاعدياً حسب القوة: grand, énorme, colossal, immense.","تمرين الاستبدال: أعد كتابة فقرة من 80 كلمة كل تكرار فيها « très + صفة » بمرادف واحد مناسب.","تمرين الفروق: اكتب ثلاث جمل تستخدم فيها splendide و magnifique و ravissant في ثلاثة سياقات مختلفة لا تصلح فيها الأخرى."]},{"h":"التطبيق والتلخيص","p":["في هذا الدرس وسّعت معجمك بـ مترادفات B2-C1 بدل تكرار «très». فهمت أن المترادفات ليست متساوية بل على سلّم قوة: grand ثم immense ثم colossal. أعد مشاهدة الفيديو الرئيسي وركّز على التدرّج بين grand وimmense وcolossal.","جسر الدروس: من b2-t2-l6 (الكلام أمام الجمهور ببنية واضحة) إلى b2-t3-l1 (مترادفات B2-C1 بدل «très»)، ثم إلى b2-t3-l2 حيث تميّز حروف الجر التي تُغيّر المعنى.","مهمة تطبيقية: سجّل دقيقة صوتية تشرح فيها موقفاً من يومك مستخدماً ثلاث كلمات جديدة من الدرس (immense، splendide، excellent)، ثم استمع للتسجيل وقارن نطقك ومفرداتك بما سمعته في الفيديو الرئيسي."]}],"pron":[{"w":"immense","ipa":"[i.mɑ̃s]","approx":"إمينس"},{"w":"splendide","ipa":"[splɛ̃.did]","approx":"سبلانديد"},{"w":"ravi","ipa":"[ʁa.vi]","approx":"رافي"}],"vocab":[{"fr":"immense","ar":"شاسع / هائل","pos":"adj.","g":"","exFr":"L’océan est immense au lever du soleil.","ipa":"[i.mɑ̃s]","exAr":"المحيط شاسع عند الشروق."},{"fr":"colossal","ar":"ضخم / هائل الحجم","pos":"adj.","g":"m","exFr":"Le budget du projet est colossal.","ipa":"[kɔ.lɔ.sal]","exAr":"ميزانية المشروع ضخمة."},{"fr":"démesuré","ar":"مفرط / باهت الحد","pos":"adj.","g":"m","exFr":"Il y a un démesuré écart de salaires.","ipa":"[de.me.zy.ʁe]","exAr":"يوجد فارق مفرط في الأجور."},{"fr":"splendide","ar":"رائع البهاء","pos":"adj.","g":"","exFr":"La vue depuis la terrasse est splendide.","ipa":"[splɛ̃.did]","exAr":"المنظر من الشرفة رائع."},{"fr":"magnifique","ar":"جميل جداً / أخّاذ","pos":"adj.","g":"","exFr":"Ce quartier est magnifique le soir.","ipa":"[ma.ɲi.fik]","exAr":"هذا الحي جميل جداً في المساء."},{"fr":"ravissant","ar":"بديع / آسر","pos":"adj.","g":"m","exFr":"Elle porte une robe ravissante.","ipa":"[ʁa.vi.sɑ̃]","exAr":"ترتدي ثوباً بديعاً."},{"fr":"remarquable","ar":"جدير بالملاحظة / ملحوظ","pos":"adj.","g":"","exFr":"Son progrès est remarquable cette année.","ipa":"[ʁə.maʁ.kabl]","exAr":"تقدمه ملحوظ هذا العام."},{"fr":"excellent","ar":"ممتاز","pos":"adj.","g":"m","exFr":"Le rapport était excellent, sans faute.","ipa":"[ɛɡ.zə.lɑ̃]","exAr":"كان التقرير ممتازاً بلا أي خطأ."},{"fr":"ravi","ar":"مسرور جداً","pos":"adj.","g":"m","exFr":"Je suis ravi de vous rencontrer.","ipa":"[ʁa.vi]","exAr":"أنا مسرور بلقائك."},{"fr":"enchanté","ar":"سعيد للغاية","pos":"adj.","g":"m","exFr":"Enchanté de faire votre connaissance.","ipa":"[ɑ̃.ʃɑ̃.te]","exAr":"سعيد جداً بتعرفك."},{"fr":"extrêmement","ar":"إلى حد بعيد / للغاية","pos":"adv.","g":"","exFr":"Le dossier est extrêmement sensible.","ipa":"[ɛk.stʁɛ.mɑ̃]","exAr":"الملف حساس للغاية."},{"fr":"particulièrement","ar":"بشكل خاص","pos":"adv.","g":"","exFr":"Je suis particulièrement intéressé par ce sujet.","ipa":"[paʁ.ti.kyljɛʁ.mɑ̃]","exAr":"مهتم بشكل خاص بهذا الموضوع."}],"examples":[{"fr":"C’est un immeuble immense, pas simplement grand.","ar":"إنه مبنى شاسع، لا مجرد كبير.","note":"gradation : grand → immense"},{"fr":"La vue est splendide, surtout au coucher du soleil.","ar":"المنظر رائع، خصوصاً عند الغروب.","note":"splendide pour le paysage"},{"fr":"Je suis ravi de votre réponse rapide.","ar":"مسرور بردكم السريع.","note":"ravi pour l’émotion"},{"fr":"Le résultat est remarquable, sans être exceptionnel.","ar":"النتيجة ملحوظة دون أن تكون استثنائية.","note":"nuance de degré"},{"fr":"Il y a une différence extrêmement fine entre les deux.","ar":"يوجد فرق دقيق للغاية بين الاثنين.","note":"extrêmement : intensification"},{"fr":"Nous sommes enchantés de vous accueillir chez nous.","ar":"سعيدون جداً باستقبالكم في بيتنا.","note":"enchanté : registre soutenu"}],"grammar":[{"tFr":"La graduation des adjectifs","tAr":"تدرّج الصفات في القوة","body":["الصفات ترتّب على سلّم قوة: grand < immense < colossal < démesuré. اختيار الدرجة يغيّر المعنى لا الجودة فقط: « une erreur grave » خطأ جسيم، و« une erreur colossale » كارثة.","احذر الإفراط: كلمة مثل « exceptionnel » أو « incroyable » تفقد قوتها إذا كُرّرت خمس مرات. استعملها مرة واحدة في النص ثم ارجع إلى مرادف أهدأ."],"ex":[{"fr":"L’écart de prix est colossal, pas seulement important.","ar":"فارق السعر ضخم، لا مجرد كبير."},{"fr":"Sa contribution a été exceptionnelle, une seule fois dans l’année.","ar":"كان مساهمته استثنائية، مرة واحدة في السنة."}]},{"tFr":"Synonymes de verbes : le complément décide","tAr":"مترادفات الأفعال: المفعول يحدّد الاختيار","body":["المرادفات الدقيقة تتبع المفعول: « regarder la télé »، « observer un oiseau »، « contempler le paysage »، « examiner un document ». لا يُستعمل contempler مع شاشة ولا examiner مع منظر.","بعض الأفعال لها تطبيقات خاصة: « voir » عامة، « apercevoir » تعني الالتقاط بالبصريات، « distinguer » تعني التفريق بين متشابهين. الفرق بينها هو ما يميّز الكتاب المتقدّم."],"ex":[{"fr":"Elle contemple la vallée depuis le sommet.","ar":"تأمل الوادي من القمة."},{"fr":"Il a examiné chaque ligne du contrat.","ar":"فحص كل سطر من العقد."}]}],"mistakes":[{"wrong":"استعمال مرادف قوي خارج سياقه","right":"اختيار الدرجة المناسبة للموقف","why":"« colossal » للأشياء الضخمة لا لنُمل المحادثة اليومية."},{"wrong":"استبدال مرادف بمفردة لا تصلح مفعولها","right":"التحقق من المفعول قبل الاختيار","why":"contempler لا تُستعمل مع التلفاز، و examiner لا تُستعمل مع المناظر."},{"wrong":"تكرار كلمة واحدة خمس مرات في فقرة","right":"تبديل المفردات مع الحفاظ على المعنى","why":"التكرار هو العلامة الأولى لنص غير متقدّم."},{"wrong":"خلط مستوى اللغة في نص واحد","right":"تثبيت مستوى واحد (courant أو soutenu)","why":"الخلط بين « super » و « remarquable » يربك القارئ."}],"dialogues":[{"title":"Un voyage inoubliable","ctx":"صديقان يتحدثان عن عطلتهما","lines":[{"who":"Paul","fr":"Comment était le séjour en Provence ?","ar":"كيف كانت الإقامة في بروفانس؟"},{"who":"Inès","fr":"Le paysage était splendide, vraiment immense.","ar":"كان المنظر رائعاً، شاسعاً حقاً."},{"who":"Paul","fr":"Mieux que la Côte d’Azur ?","ar":"أفضل من كوت دازور؟"},{"who":"Inès","fr":"Différent : là-bas, tout est remarquable, sans être colossal.","ar":"مختلف: هناك كل شيء ملحوظ دون أن يكون ضخماً."}]},{"title":"Un entretien d’embauche","ctx":"مقابلة عمل بين مرشحة ومسؤول التوظيف","lines":[{"who":"Recruteur","fr":"Pourquoi cette expérience vous intéresse-t-elle ?","ar":"لماذا تثيرك هذه التجربة اهتمامك؟"},{"who":"Salomé","fr":"Parce que votre résultat dernier trimestre était remarquable.","ar":"لأن نتائجكم في الربع الأخير كانت ملحوظة."},{"who":"Recruteur","fr":"Nous cherchons quelqu’un d’excellent en analyse.","ar":"نبحث عن شخص ممتاز في التحليل."},{"who":"Salomé","fr":"Je suis particulièrement forte sur ce point, et ravi de le démontrer.","ar":"أتميّز تحديداً في هذا الجانب، ويسعدني إثبات ذلك."}]}],"exercises":[{"t":"mcq","skill":"vocab","q":"أي كلمة أقوى من « grand »؟","opts":["modeste","immense","moyen"],"a":1,"why":"immense تأتي بعد grand على سلّم القوة."},{"t":"fill","skill":"writing","q":"استبدل: «Le résultat est très bon.» بمرادف من الدرس.","fr":"Le résultat est très bon.","ans":"Le résultat est remarquable.","why":"remarquable معيارية ومهنية وتناسب التقارير."},{"t":"order","skill":"writing","q":"رتّب: المبنى مذهل حقاً","words":["Le","bâtiment","est","splendide,","vraiment."],"ans":"Le bâtiment est splendide, vraiment.","why":"splendide مرادف متقدم لكلمة beau."},{"t":"mcq","skill":"vocab","q":"أي مفردة لا تصلح مع « regarder la télé »؟","opts":["regarder","voir","contempler","apercevoir"],"a":2,"why":"contempler تُستعمل مع المناظر الطبيعية لا مع الشاشة."},{"t":"listen","skill":"listening","q":"استمع واختر المرادف الأقوى لكلمة « très grand ».","opts":["moyen","immense","modeste"],"a":1,"why":"immense هي الدرجة الأقوى المناسبة."},{"t":"translate","skill":"writing","q":"ترجم بمرادف متقدم: «المنظر كان رائعاً حقاً.»","ans":"Le paysage était splendide.","why":"splendide تغني عن très beau."},{"t":"speaking","skill":"speaking","q":"صف رحلة أو مبنى مستخدماً ثلاثة مترادفات متدرجة القوة.","target":"grand → immense → colossal","why":"إظهار سلّم القوة في إنتاج شفهي متصل."},{"t":"correct","skill":"writing","q":"صحّح التكرار: «C’est un très très beau et très grand hôtel.»","ans":"C’est un hôtel magnifique et immense.","why":"التبديل يرفع المستوى ويمنع الازدواج."}],"homework":"خذ فقرة كتبتها سابقاً، حدّد فيها كل « très + صفة » وكل تكرار، واستبدلها بخمسة مترادفات متدرجة القوة، ثم اكتب في الهامش سبب اختيار كل مرادف.","sources":[{"title":"Ne dis pas toujours « très grand » ! À la place, utilise ces synonymes","channel":"MatthieuProfesseurFR","videoId":"NFaRv9BYMMk","why":"بدائل دقيقة لكلمات شائعة جداً (très grand, très bon) ترفع حديثك من المستوى العام إلى مستوى متقدّم.","cat":"Lexique","level":"B2","main":true},{"title":"Tu connais ces mots ? Si oui, tu as le niveau B2-C1 !","channel":"MatthieuProfesseurFR","videoId":"wEiA2lg1Lqc","why":"اختبار مفردات يقيس إذا كانت مترادفاتك المتقدمة قد دخلت مخزونك الفعلي.","cat":"Lexique","level":"B2","extra":true},{"title":"Français - Niveau B2-C1 Expressions synonymes \" sans cesse \"","channel":"Lilit Khachinyan","videoId":"tlDheBt7MiQ","why":"تعبيرات مترادفة بدرجات نبرة مختلفة — توسّع المترادفات خارج حدود الصفات.","cat":"Lexique","level":"B2","extra":true}],"supplements":[{"id":"wEiA2lg1Lqc","title":"Tu connais ces mots ? Si oui, tu as le niveau B2-C1 !","channel":"MatthieuProfesseurFR","why":"اختبار مفردات يقيس إذا كانت مترادفاتك المتقدمة قد دخلت مخزونك الفعلي.","lang":"fr","dur":5},{"id":"tlDheBt7MiQ","title":"Français - Niveau B2-C1 Expressions synonymes \" sans cesse \"","channel":"Lilit Khachinyan","why":"تعبيرات مترادفة بدرجات نبرة مختلفة — توسّع المترادفات خارج حدود الصفات.","lang":"fr","dur":6}]},{"id":"b2-t3-l2","fr":"Les prépositions subtiles","ar":"حروف الجر الدقيقة والأخاديد","objectives":["تمييز les prépositions الأساسية: à, de, en, dans, pour, par","اكتشاف la nuance la phrase التي تُحدّدها la préposition","توظيف les prépositions في الكتابة الأكاديمية والمهنية","تجنب أخطاء les prépositions الشائعة في المستوى B2"],"sections":[{"h":"الدرس 2: حروف الجر التي تُغيّر المعنى بالكامل","video":{"id":"wEiA2lg1Lqc","title":"Prépositions françaises : à, de, en, dans — les nuances","channel":"Français Authentique","why":"شرح les prépositions الأساسية مع أمثلة على كيف تُغيّر la nuance la phrase بالكامل.","lang":"fr","main":true,"dur":15},"p":["les prépositions في الفرنسية ليست مجرد حروف جر — تُحدّد la nuance la phrase بالكامل. « Je pense à toi » = أفكر فيك، و« Je pense de toi » = رأيي فيك. la distinction subtiles هذه هي la cible la niveau B2.","معجم الدرس: la préposition, la nuance, le lieu, le temps, la cause, la finalité, la direction, la manière, la matière, la relation, la précision, la subtilité. هذه المفردات تشرح mécanique les prépositions.","نحوياً، les prépositions تتحكم في la relation la phrase: « à » للزمن والمكان والاختصاص، و« de » للمادة والملكية والسبب، و« en » للزمن والمكان والتحويل. la grammaire la nuance متشابكتان هنا.","الدرس الأهم: les prépositions لا تُترجم حرفياً — تُفهم بالسياق. « Je vais à Paris » (direction)، « Je viens de Paris » (origine)، « Je suis à Paris » (lieu). la préposition la phrase معاً.","أكبر خطأ في les prépositions: « je suis en train de » تُستخدم مع le présent فقط، و« à travers » تعني la traversée لا la proximité. la précision la préposition ترفع la nuance la phrase.","بعد الدرس: اكتب خمس جمل تستخدم فيها les prépositions المختلفة في la même phrase مع la nuance la phrase — la pratique la précision."],"sub":[{"h":"les prépositions la lieu","p":["« Je vais à Paris. » — direction.","« Je viens de Paris. » — origine.","« Je suis à Paris. » — lieu.","« Je passe par Paris. » — itinéraire."]},{"h":"les prépositions la cause la finalité","p":["« à cause de » — cause négative.","« grâce à » — cause positive.","« en raison de » — cause objective.","« afin de » — finalité."]},{"h":"les prépositions la relation","p":["« je pense à toi » — réflexion.","« je pense de toi » — opinion.","« je parle à toi » — direction.","« je parle de toi » — sujet."]}]},{"h":"la carte les prépositions","p":["« à » = direction, temps, lieu, relation — la plus polyvalente.","« de » = origine, matière, cause, possession.","« en » = lieu, temps, transformation.","« dans » = lieu intérieur, moment précis."]},{"h":"التطبيق والتلخيص","p":["تمرين la distinction: حوّل ثلاث جمل بـ les prépositions مختلفة مع la nuance la phrase.","تمرين la bascule: استبدل les prépositions في la même phrase ولاحظ كيف يتغيّر المعنى.","سجّل نفسك تشرح la nuance la préposition بالفرنسية لزميل: « attention, à cause de ≠ grâce à… » — la explanation تثبّت la mémoire."]},{"h":"التطبيق والتلخيص","p":["تعلّمت أن les prépositions تُحدّد la nuance: «penser à» تفكير، و«penser de» رأي، و«grâce à» سبب إيجابي مقابل «à cause de» سبب سلبي. كل فعل يفرض le régime prépositionnel. أعد مشاهدة الفيديو الرئيسي وركّز على الفرق بين à وde وavec مع الفعل نفسه.","جسر الدروس: من b2-t3-l1 (مترادفات B2-C1 بدل «très») إلى b2-t3-l2 (حروف الجر ودقّة دلالاتها)، ثم إلى b2-t3-l3 حيث تفرّق بين الأفعال المتشابهة بثقة.","مهمة تطبيقية: سجّل دقيقة صوتية تشرح فيها موقفاً من يومك مستخدماً ثلاث كلمات جديدة من الدرس (grâce à، à cause de، d’après)، ثم استمع للتسجيل وقارن نطقك ومفرداتك بما سمعته في الفيديو الرئيسي."]}],"pron":[{"w":"la préposition","ipa":"[pʁe.pɔ.zi.sjɔ̃]","approx":"بريبوزيسيون"},{"w":"la nuance","ipa":"[nɥɑ̃s]","approx":"نيوآنس"},{"w":"à travers","ipa":"[a tʁa.vɛʁ]","approx":"أ ترافير"}],"vocab":[{"fr":"la préposition","ar":"حرف الجر","pos":"nom","g":"f","exFr":"La préposition change le sens.","ipa":"[pʁe.pɔ.zi.sjɔ̃]","exAr":"حرف الجر يُغيّر المعنى."},{"fr":"la locution prépositionnelle","ar":"العبارة الجرية","pos":"nom","g":"f","exFr":"« Grâce à » est une locution prépositionnelle.","exAr":"«grâce à» عبارة جرية.","ipa":"[lɔk.sjɔ̃ pʁe.pɔ.zi.sjɔ.nɛl]"},{"fr":"la direction","ar":"الاتجاه","pos":"nom","g":"f","exFr":"La direction est vers Paris.","ipa":"[di.ʁɛk.sjɔ̃]","exAr":"الاتجاه نحو باريس."},{"fr":"l’origine","ar":"الأصل","pos":"nom","g":"f","exFr":"L’origine est claire.","ipa":"[ɔ.ʁi.ʒin]","exAr":"الأصل واضح."},{"fr":"la cause","ar":"السبب","pos":"nom","g":"f","exFr":"La cause est connue.","ipa":"[kɔz]","exAr":"السبب معروف."},{"fr":"la finalité","ar":"الغرض","pos":"nom","g":"f","exFr":"La finalité est claire.","ipa":"[fi.na.li.te]","exAr":"الغرض واضح."},{"fr":"le lieu","ar":"المكان","pos":"nom","g":"m","exFr":"Le lieu est important.","ipa":"[ljø]","exAr":"المكان مهم."},{"fr":"le temps","ar":"الزمن","pos":"nom","g":"m","exFr":"Le temps est limité.","ipa":"[tɑ̃]","exAr":"الزمن محدود."},{"fr":"la relation","ar":"العلاقة","pos":"nom","g":"f","exFr":"La relation est claire.","ipa":"[ʁe.la.sjɔ̃]","exAr":"العلاقة واضحة."},{"fr":"la précision","ar":"الدقة","pos":"nom","g":"f","exFr":"La précision est essentielle.","ipa":"[pʁe.si.zjɔ̃]","exAr":"الدقة ضرورية."},{"fr":"la subtilité","ar":"الدقة الخفية","pos":"nom","g":"f","exFr":"La subtilité est importante.","ipa":"[syb.ti.li.te]","exAr":"الدقة الخفية مهمة."},{"fr":"employer","ar":"يُستخدم / يوظّف","pos":"verbe","g":"","exFr":"Comment employer cette préposition ?","ipa":"[ɑ̃.plwa.je]","exAr":"كيف نستخدم هذا حرف الجر؟"}],"examples":[{"fr":"Je pense à toi (réflexion).","ar":"أفكر فيك (تأمل).","note":"à + réflexion"},{"fr":"Je pense de toi (opinion).","ar":"رأيي فيك (رأي).","note":"de + opinion"},{"fr":"à cause de (cause négative).","ar":"بسبب (سبب سلبي).","note":"la cause"},{"fr":"grâce à (cause positive).","ar":"بفضل (سبب إيجابي).","note":"la cause"},{"fr":"Je vais à Paris (direction).","ar":"أذهب إلى باريس (اتجاه).","note":"la direction"},{"fr":"Je viens de Paris (origine).","ar":"آتي من باريس (أصل).","note":"l’origine"}],"grammar":[{"tFr":"les prépositions la lieu la direction","tAr":"حروف الجر المكانية والاتجاهية","body":["« à » للاتجاه: « Je vais à Paris ». « de » للأصل: « Je viens de Paris ». « en » للمكان أو التحويل: « Je suis en France »، « transformer en ».","« dans » للمكان الداخلي واللحظة المحددة: « dans la maison »، « dans une heure ». la préposition la phrase معاً."],"ex":[{"fr":"Je vais à Paris. — direction.","ar":"أذهب إلى باريس. — اتجاه."},{"fr":"Je viens de Paris. — origine.","ar":"آتي من باريس. — أصل."}]},{"tFr":"les prépositions la cause la finalité","tAr":"حروف الجر السببية والغائية","body":["« à cause de » = سبب سلبي، و« grâce à » = سبب إيجابي، و« en raison de » = سبب موضوعي. la distinction essentielle dans la nuance.","« afin de » = غاية، و« pour » = غاية عامة. la précision la préposition ترفع la nuance la phrase."],"ex":[{"fr":"à cause de la pluie, le match est annulé.","ar":"بسبب المطر، أُلغيت المباراة."},{"fr":"grâce à votre aide, le projet est fini.","ar":"بفضل مساعدتك، اكتمل المشروع."}]}],"mistakes":[{"wrong":"Confondre « à » et « de »","right":"à = direction / relation, de = origine / matière","why":"« pense à » ≠ « pense de »: réflexion ≠ opinion."},{"wrong":"« à cause de » pour cause positive","right":"« grâce à » pour cause positive","why":"la nuance la cause la négative la positive."},{"wrong":"« dans » au lieu de « en » pour le pays","right":"« en France » mais « dans la maison »","why":"en + pays sans article, dans + lieu avec article."},{"wrong":"la lecture les prépositions","right":"la distinction les prépositions","why":"la lecture تُفقد la naturalité."}],"dialogues":[{"title":"la nuance","ctx":"معلم يشرح les prépositions","lines":[{"who":"Prof","fr":"« Je pense à toi » — c’est la réflexion.","ar":"«Je pense à toi» — إنها التأمل."},{"who":"Élève","fr":"Et « Je pense de toi » ?","ar":"و «Je pense de toi»؟"},{"who":"Prof","fr":"C’est votre opinion sur la personne.","ar":"إنه رأيك في الشخص."},{"who":"Élève","fr":"D’accord, la nuance est subtile.","ar":"أوكي، التمييز الدقيق خفي."}]},{"title":"la cause","ctx":"مكتب العمل","lines":[{"who":"Claire","fr":"Le projet a échoué à cause du budget.","ar":"فشل المشروع بسبب الميزانية."},{"who":"Karim","fr":"Non, grâce à votre aide, il a réussi.","ar":"لا، بفضل مساعدتك، نجح."},{"who":"Claire","fr":"En raison de la crise, c’est difficile.","ar":"بسبب الأزمة، هذا صعب."},{"who":"Karim","fr":"Afin de réussir, il faut agir.","ar":"للنجاح، يجب التحرك."}]}],"exercises":[{"t":"mcq","skill":"grammar","q":"ما « à » في « Je vais à Paris »؟","opts":["direction","origine","matière","relation"],"a":0,"why":"à = la direction."},{"t":"fill","skill":"grammar","q":"أكمل: «Je viens ___ Paris.»","fr":"Je viens ___ Paris.","ans":"de","why":"de = l’origine."},{"t":"mcq","skill":"grammar","q":"ما « grâce à »؟","opts":["سبب إيجابي","سبب سلبي","سبب موضوعي","غاية"],"a":0,"why":"grâce à = la cause positive."},{"t":"order","skill":"writing","q":"رتّب: بفضل مساعدتك نجح المشروع","words":["Grâce","à","votre","aide,","le","projet","a","réussi."],"ans":"Grâce à votre aide, le projet a réussi.","why":"la cause positive."},{"t":"listen","skill":"listening","q":"ما « à cause de »؟","opts":["سبب سلبي","سبب إيجابي","سبب موضوعي","غاية"],"a":0,"why":"à cause de = la cause négative."},{"t":"translate","skill":"writing","q":"ترجم: «بفضل مساعدتك، اكتمل المشروع.»","ans":"Grâce à votre aide, le projet est fini.","why":"la cause positive."},{"t":"speaking","skill":"speaking","q":"اشرح la nuance la préposition بالفرنسية لزميلك.","target":"à cause de / grâce à / en raison de","why":"la mémoire la précision."},{"t":"correct","skill":"grammar","q":"صحّح: «Je pense de toi souvent.» (إذا كنت تقصد التأمل)","ans":"Je pense à toi souvent.","why":"à = la réflexion, de = l’opinion."}],"homework":"اكتب خمس جمل تستخدم فيها les prépositions المختلفة في la même phrase مع la nuance la phrase.","sources":[{"title":"Prépositions françaises : à, de, en, dans — les nuances","channel":"Français Authentique","videoId":"wEiA2lg1Lqc","why":"شرح les prépositions الأساسية مع أمثلة على كيف تُغيّر la nuance la phrase بالكامل.","cat":"Nuances","level":"B2","main":true},{"title":"Les prépositions françaises : guide complet","channel":"Français Authentique","videoId":"WxNRvm5yVJ0","why":"دليل شامل لـ les prépositions مع أمثلة la nuance la phrase.","cat":"Nuances","level":"B2","extra":true},{"title":"Prépositions de lieu et de direction","channel":"French with Alicia","videoId":"R3GIYkOsrxc","why":"شرح les prépositions la lieu la direction مع la distinction la précision.","cat":"Nuances","level":"B2","extra":true}],"supplements":[{"id":"WxNRvm5yVJ0","title":"Les prépositions françaises : guide complet","channel":"Français Authentique","why":"دليل شامل لـ les prépositions مع أمثلة la nuance la phrase.","lang":"fr","dur":14},{"id":"R3GIYkOsrxc","title":"Prépositions de lieu et de direction","channel":"French with Alicia","why":"شرح les prépositions la lieu la direction مع la distinction la précision.","lang":"fr","dur":12}]},{"id":"b2-t3-l3","fr":"Les verbes confusables","ar":"الأفعال المربكة والمتشابهة","objectives":["تمييز les verbes confusables الأساسية: savoir/connaître, voir/regarder, chercher/trouver","اكتشاف la nuance la verbe التي تُحدّدها la préposition أو la structure","توظيف les verbes في الكتابة الأكاديمية والمهنية","تجنب أخطاء les verbes الشائعة في المستوى B2"],"sections":[{"h":"الدرس 3: أفعال تبدو متشابهة لكنها مختلفة تماماً","video":{"id":"tlDheBt7MiQ","title":"Verbes français confusables : savoir vs connaître et plus","channel":"Français Authentique","why":"شرح les verbes confusables الشائعة: savoir/connaître, voir/regarder, chercher/trouver — كيف تفرّق بينها في الكلام والكتابة.","lang":"fr","main":true,"dur":14},"p":["les verbes confusables في الفرنسية ليست مجرد مترادفات — تُحدّد la nuance la phrase بالكامل. « savoir » = معرفة معلومات، و« connaître » = التعرّف على شخص أو مكان. la distinction subtiles هذه هي la cible la niveau B2.","معجم الدرس: le verbe, la nuance, la connaissance, la compétence, l’action, l’état, le résultat, le processus, la précision, la subtilité, la différence, la confusion. هذه المفردات تشرح mécanique les verbes confusables.","نحوياً، les verbes confusables تتحكم في la relation la phrase: « savoir » + infinitif أو que، و« connaître » + nom. la grammaire la nuance متشابكتان هنا.","الدرس الأهم: les verbes confusables لا تُترجم حرفياً — تُفهم بالسياق. « je vois » = أرى، و« je regarde » = أُشاهد بتركيز. la verbe la phrase معاً.","أكبر خطأ في les verbes: « je sais connaître cette personne » — la confusion la savoir la connaître. la précision la verbe ترفع la nuance la phrase.","بعد الدرس: اكتب خمس جمل تستخدم فيها les verbes المختلفة في la même phrase مع la nuance la phrase — la pratique la précision."],"sub":[{"h":"savoir vs connaître","p":["« Je sais nager. » — savoir = compétence.","« Je connais Paris. » — connaître = familiarité.","« Je sais que tu viens. » — savoir = information.","« Je connais cette personne. » — connaître = personne."]},{"h":"voir vs regarder","p":["« Je vois la montagne. » — voir = perception passive.","« Je regarde le film. » — regarder = attention active.","« Je vois le problème. » — voir = comprendre.","« Je regarde la télé. » — regarder = activité."]},{"h":"chercher vs trouver","p":["« Je cherche mes clés. » — chercher = processus.","« Je trouve mes clés. » — trouver = résultat.","« Je cherche un travail. » — chercher = processus.","« Je trouve un travail. » — trouver = résultat."]}]},{"h":"la carte les verbes confusables","p":["« savoir » = معرفة معلومات أو مهارة.","« connaître » = التعرّف على شخص أو مكان.","« voir » = رؤية سلبية، « regarder » = مراقبة نشطة.","« chercher » = بحث، « trouver » = نتيجة."]},{"h":"التطبيق والتلخيص","p":["تمرين la distinction: حوّل ثلاث جمل بـ les verbes مختلفة مع la nuance la phrase.","تمرين la bascule: استبدل les verbes في la même phrase ولاحظ كيف يتغيّر المعنى.","سجّل نفسك تشرح la nuance la verbe بالفرنسية لزميل: « attention, savoir ≠ connaître… » — la explanation تثبّت la mémoire."]},{"h":"التطبيق والتلخيص","p":["في هذا الدرس فرّقت بين les verbes confusables: savoir معلومات مقابل connaître أشخاص، وchercher بحث مقابل trouver نتيجة. فهمت la nuance لا مجرد الترجمة. أعد مشاهدة الفيديو الرئيسي وركّز على savoir/connaître وchercher/trouver.","جسر الدروس: من b2-t3-l2 (حروف الجر ودقّة دلالاتها) إلى b2-t3-l3 (الأفعال المربكة وتمييزها)، ثم إلى b2-t3-l4 حيث تختار مستوى اللغة المناسب لكل موقف.","مهمة تطبيقية: سجّل دقيقة صوتية تشرح فيها موقفاً من يومك مستخدماً ثلاث كلمات جديدة من الدرس (savoir، connaître، trouver)، ثم استمع للتسجيل وقارن نطقك ومفرداتك بما سمعته في الفيديو الرئيسي."]}],"pron":[{"w":"savoir","ipa":"[sa.vwaʁ]","approx":"سافوار"},{"w":"connaître","ipa":"[kɔ.nɛtʁ]","approx":"كونيتري"},{"w":"chercher","ipa":"[ʃɛʁ.ʃe]","approx":"شيرشي"}],"vocab":[{"fr":"savoir","ar":"يعرف (مهارة أو معلومة)","pos":"verbe","g":"","exFr":"Je sais nager.","ipa":"[sa.vwaʁ]","exAr":"أعرف السباحة."},{"fr":"connaître","ar":"يعرف (شخص أو مكان)","pos":"verbe","g":"","exFr":"Je connais Paris.","ipa":"[kɔ.nɛtʁ]","exAr":"أعرف باريس."},{"fr":"voir","ar":"يرى","pos":"verbe","g":"","exFr":"Je vois la mer.","ipa":"[vwaʁ]","exAr":"أرى البحر."},{"fr":"regarder","ar":"يشاهد","pos":"verbe","g":"","exFr":"Je regarde le film.","ipa":"[ʁə.ɡaʁ.de]","exAr":"أشاهد الفيلم."},{"fr":"chercher","ar":"يبحث عن","pos":"verbe","g":"","exFr":"Je cherche mon livre.","ipa":"[ʃɛʁ.ʃe]","exAr":"أبحث عن كتابي."},{"fr":"trouver","ar":"يجد","pos":"verbe","g":"","exFr":"Je trouve mon livre.","ipa":"[tʁu.ve]","exAr":"أجد كتابي."},{"fr":"le glissement de sens","ar":"انزياح المعنى بين المترادفات","pos":"nom","g":"m","exFr":"Entre « chercher » et « trouver », le glissement de sens est net.","exAr":"بين « chercher » و« trouver » انزياح المعنى واضح.","ipa":"[ɡli.s.mɑ̃ də sɑ̃s]"},{"fr":"la compétence","ar":"القدرة","pos":"nom","g":"f","exFr":"La compétence est acquise.","ipa":"[kɔ̃.pe.tɑ̃s]","exAr":"القدرة مكتسبة."},{"fr":"la familiarité","ar":"الإلمام","pos":"nom","g":"f","exFr":"La familiarité avec la ville est utile.","ipa":"[fa.mi.lja.ʁi.te]","exAr":"الإلمام بالمفيد مفيد."},{"fr":"le processus","ar":"العملية","pos":"nom","g":"m","exFr":"Le processus est long.","ipa":"[pʁɔ.sɛ.sys]","exAr":"العملية طويلة."},{"fr":"le résultat","ar":"النتيجة","pos":"nom","g":"m","exFr":"Le résultat est clair.","ipa":"[ʁe.zyl.ta]","exAr":"النتيجة واضحة."},{"fr":"préciser","ar":"يُحدّد","pos":"verbe","g":"","exFr":"Pouvez-vous préciser ?","ipa":"[pʁe.si.ze]","exAr":"هل يمكنك التحديد؟"}],"examples":[{"fr":"Je sais nager (savoir = compétence).","ar":"أعرف السباحة (savoir = قدرة).","note":"savoir"},{"fr":"Je connais Paris (connaître = familiarité).","ar":"أعرف باريس (connaître = إلمام).","note":"connaître"},{"fr":"Je vois la mer (voir = perception passive).","ar":"أرى البحر (voir = إدراك سلبي).","note":"voir"},{"fr":"Je regarde le film (regarder = attention active).","ar":"أشاهد الفيلم (regarder = انتباه نشط).","note":"regarder"},{"fr":"Je cherche mon livre (chercher = processus).","ar":"أبحث عن كتابي (chercher = عملية).","note":"chercher"},{"fr":"Je trouve mon livre (trouver = résultat).","ar":"أجد كتابي (trouver = نتيجة).","note":"trouver"}],"grammar":[{"tFr":"savoir vs connaître","tAr":"savoir مقابل connaître","body":["« savoir » = معرفة معلومات أو مهارة: « je sais nager »، « je sais que ». « connaître » = التعرّف على شخص أو مكان: « je connais Paris ».","la distinction essentielle dans la nuance: savoir = compétence / information، connaître = familiarité."],"ex":[{"fr":"Je sais nager.","ar":"أعرف السباحة."},{"fr":"Je connais Paris.","ar":"أعرف باريس."}]},{"tFr":"voir vs regarder","tAr":"voir مقابل regarder","body":["« voir » = رؤية سلبية: « je vois la mer ». « regarder » = مراقبة نشطة: « je regarde le film ». la nuance la perception la attention.","« voir » peut aussi signifier « comprendre »: « je vois le problème ». la précision la verbe."],"ex":[{"fr":"Je vois la mer.","ar":"أرى البحر."},{"fr":"Je regarde le film.","ar":"أشاهد الفيلم."}]}],"mistakes":[{"wrong":"« Je sais Paris »","right":"« Je connais Paris »","why":"connaître = familiarité avec un lieu ou une personne."},{"wrong":"« Je regarde la montagne » (si tu la vois sans intention)","right":"« Je vois la montagne »","why":"voir = perception passive, regarder = attention active."},{"wrong":"« Je trouve mes clés » (si tu les cherches)","right":"« Je cherche mes clés »","why":"chercher = processus, trouver = résultat."},{"wrong":"la lecture les verbes","right":"la distinction les verbes","why":"la lecture تُفقد la naturalité."}],"dialogues":[{"title":"la nuance","ctx":"معلم يشرح les verbes","lines":[{"who":"Prof","fr":"« Je sais nager » — c’est une compétence.","ar":"«Je sais nager» — إنها قدرة."},{"who":"Élève","fr":"Et « Je connais Paris » ?","ar":"و «Je connais Paris»؟"},{"who":"Prof","fr":"C’est la familiarité avec la ville.","ar":"إنه الإلمام بالمدينة."},{"who":"Élève","fr":"D’accord, la nuance est subtile.","ar":"أوكي، التمييز الدقيق خفي."}]},{"title":"la distinction","ctx":"مكتب العمل","lines":[{"who":"Claire","fr":"Je cherche un nouveau logiciel.","ar":"أبحث عن برنامج جديد."},{"who":"Karim","fr":"Vous en avez trouvé un ?","ar":"هل وجدت واحداً؟"},{"who":"Claire","fr":"Non, je cherche encore.","ar":"لا، ما زلت أبحث."},{"who":"Karim","fr":"Quand vous en trouverez, prévenez-moi.","ar":"عندما تجد واحداً، أخبرني."}]}],"exercises":[{"t":"mcq","skill":"grammar","q":"ما « savoir »؟","opts":["مهارة أو معلومة","شخص أو مكان","رؤية سلبية","بحث"],"a":0,"why":"savoir = compétence / information."},{"t":"fill","skill":"grammar","q":"أكمل: «Je ___ Paris.»","fr":"Je ___ Paris.","ans":"connais","why":"connaître = familiarité avec un lieu."},{"t":"mcq","skill":"grammar","q":"ما « regarder »؟","opts":["مراقبة نشطة","رؤية سلبية","فهم","نشاط"],"a":0,"why":"regarder = attention active."},{"t":"order","skill":"writing","q":"رتّب: أبحث عن مفاتيحي","words":["Je","cherche","mes","clés."],"ans":"Je cherche mes clés.","why":"chercher = processus."},{"t":"listen","skill":"listening","q":"ما « je trouve » في هذا السياق؟","opts":["نتيجة","عملية","مهارة","معلومة"],"a":0,"why":"trouver = résultat."},{"t":"translate","skill":"writing","q":"ترجم: «أعرف السباحة.»","ans":"Je sais nager.","why":"savoir = compétence."},{"t":"speaking","skill":"speaking","q":"اشرح la nuance la verbe بالفرنسية لزميلك.","target":"savoir / connaître / voir / regarder","why":"la mémoire la précision."},{"t":"correct","skill":"grammar","q":"صحّح: «Je sais cette personne.»","ans":"Je connais cette personne.","why":"connaître = familiarité avec une personne."}],"homework":"اكتب خمس جمل تستخدم فيها les verbes confusables في la même phrase مع la nuance la phrase.","sources":[{"title":"Verbes français confusables : savoir vs connaître et plus","channel":"Français Authentique","videoId":"tlDheBt7MiQ","why":"شرح les verbes confusables الشائعة: savoir/connaître, voir/regarder, chercher/trouver — كيف تفرّق بينها في الكلام والكتابة.","cat":"Nuances","level":"B2","main":true},{"title":"Savoir vs connaître : la différence","channel":"Français Authentique","videoId":"IQs2-izz4aM","why":"شرح la distinction la savoir la connaître مع أمثلة la nuance la phrase.","cat":"Nuances","level":"B2","extra":true},{"title":"Verbes français : les confusions à éviter","channel":"French with Alicia","videoId":"oVIc7T_RLRI","why":"قائمة منظمة بـ les verbes confusables مع la distinction la précision.","cat":"Nuances","level":"B2","extra":true}],"supplements":[{"id":"IQs2-izz4aM","title":"Savoir vs connaître : la différence","channel":"Français Authentique","why":"شرح la distinction la savoir la connaître مع أمثلة la nuance la phrase.","lang":"fr","dur":11},{"id":"oVIc7T_RLRI","title":"Verbes français : les confusions à éviter","channel":"French with Alicia","why":"قائمة منظمة بـ les verbes confusables مع la distinction la précision.","lang":"fr","dur":13}]},{"id":"b2-t3-l4","fr":"Les registres de mots","ar":"مستويات اللغة: العامي والشائع والمرتفع","objectives":["تمييز le registre familier عن le courant و le soutenu و le soutenu extrême","تحويل la même idée عبر les trois registres دون تغيير المعنى","اختيار le registre المناسب selon la situation et l’interlocuteur","اكتشاف le registre المدمج dans le texte الصحافي و le texte littéraire"],"sections":[{"h":"الدرس 4: كيف تختار le registre الصحيح لكل موقف","video":{"id":"dEnQwaXT1sk","title":"Les registres de langue : courant, soutenu, familier","channel":"Français Authentique","why":"شرح les registres الثلاثة في le contexte réel: كيف يتغيّر le même sens مع le ton، ومتى يصبح le familier خللاً.","lang":"fr","main":true,"dur":14},"p":["le registre ليس مستوى جودة بل مستوى ملاءمة: le même معنى يُقال بـ « Je suis crevé » (familier)، « Je suis fatigué » (courant)، « Je suis épuisé » (soutenu)، « J’éprouve une grande lassitude » (soutenu extrême). la bonne choisie تعتمد على le destinataire لا على le vocabulaire فقط.","معجم الدرس: le registre, le familier, le courant, le soutenu, le langage soutenu, le ton, l’adresse, le tutoiement, le vouvoiement, le pléonasme, la litote, l’emphase, la retenue. هذه المفردات تصف la position du locuteur.","نحوياً، le registre يظهر في la grammaire: le subjonctif و l’impératif d’atténuation يرتفعان: « Il serait souhaitable que… »؛ و le tutoiement يخفّض: « T’es d’accord ? ». la forme لا le mot وحده يحدّد le niveau.","الدرس الأهم: le registre الخطأ أخطر من le vocabulaire الخطأ. أن تقول « Je vous prie de bien vouloir m’indiquer… » لصديق يُبعدك، وأن تقول « Dis-moi où c’est » لمسؤول يُحطّم le contact.","la règle la pratique: اسأل عن la relation قبل la phrase. le travail (vouvoiement + le soutenu)، la famille (tutoiement + le familier)، la lettre administrative (le soutenu + les formules).","بعد الدرس: خذ جملة واحدة وحوّلها إلى les quatre registres، ثم استمع لـ une interview فرنسية وحدّد le registre الذي يستعمله le journaliste و الذي يستعمله le témoin."],"sub":[{"h":"les quatre registres","p":["Je suis crevé — registre familier.","Je suis fatigué — registre courant.","Je suis épuisé — registre soutenu."]},{"h":"أدوات نطقية: la nuance du ton","p":["« Ce n’est pas rien ! » [sə nɛ pa ʁjɛ̃] — la litote de registre courant.","« Il serait souhaitable que… » — le conditionnel de retenue.","« T’es d’accord ? » — le tutoiement de registre familier."]},{"h":"خطوات la détection","p":["الخطوة الأولى: حدد l’interlocuteur.","الثانية: راقب la forme grammaticale: tutoiement ou vouvoiement.","الثالثة: اختر le registre قبل le mot."]}]},{"h":"la carte des registres","p":["« Je suis crevé » = متعب جداً — le familier مع les amis.","« Je suis quelque peu las » = أنا متعب قليلاً — le soutenu مع le supérieur.","« Serait-il possible de… » = هل من الممكن أن… — la demande la plus polie.","« On se tutoie ? » — la question qui fixe le registre avant de parler."]},{"h":"التطبيق والتلخيص","p":["تمرين la bascule: اكتب la même idée في les quatre registres ثم اقرأها بصوت عالٍ لتسمع la différence.","تمرين la lettre: اكتب رسالة قصيرة إلى un collègue ثم نسخة إلى un directeur — بالمعنى نفسه و بـ le registre مختلف.","سجّل نفسك تشرح موقفاً يومياً في le registre courant، ثم أعدّ la même histoire في le registre soutenu."]},{"h":"التطبيق والتلخيص","p":["تعلّمت أن le registre ملاءمة لا جودة: «Je suis crevé» (familier)، «Je suis fatigué» (courant)، «Je suis épuisé» (soutenu). الفرق في المفردة لا في la structure. أعد مشاهدة الفيديو الرئيسي وركّز على التبديل بين «Je suis crevé» و«Je suis épuisé».","جسر الدروس: من b2-t3-l3 (الأفعال المربكة وتمييزها) إلى b2-t3-l4 (اختيار مستوى اللغة المناسب للموقف)، ثم إلى b2-t3-l5 حيث تتكلّم كما يتكلّم الفرنسيون في التوافقات.","مهمة تطبيقية: سجّل دقيقة صوتية تشرح فيها موقفاً من يومك مستخدماً ثلاث كلمات جديدة من الدرس (le registre، la litote، la solennité)، ثم استمع للتسجيل وقارن نطقك ومفرداتك بما سمعته في الفيديو الرئيسي."]}],"pron":[{"w":"le registre","ipa":"[lə ʁə.ʒistʁ]","approx":"لو ريچيستʁ"},{"w":"soutenu","ipa":"[su.tə.ny]","approx":"سوتني"},{"w":"le familier","ipa":"[lə fa.mi.lje]","approx":"لو فاميليه"}],"vocab":[{"fr":"le registre","ar":"المستوى اللغوي","pos":"nom","g":"m","exFr":"Choisissez le registre adapté.","ipa":"[ʁə.ʒistʁ]","exAr":"اختر المستوى اللغوي المناسب."},{"fr":"l’aisance","ar":"الطلاقة في الكلام","pos":"nom","g":"f","exFr":"Il parle avec aisance dans tous les registres.","exAr":"يتكلم بطلاقة في كل المستويات.","ipa":"[ɛ.zɑ̃s]"},{"fr":"la sobriété","ar":"العفوية المهذّبة","pos":"nom","g":"f","exFr":"Le registre courant s’exprime avec sobriété.","exAr":"المستوى الشائع يُعبَّر عنه بعفوية.","ipa":"[sɔ.bʁi.je]"},{"fr":"la solennité","ar":"الوقار الرفعي","pos":"nom","g":"f","exFr":"La solennité convient aux discours officiels.","exAr":"الوقار يناسب الخطب الرسمية.","ipa":"[sɔ.lɛ.ni.te]"},{"fr":"la litote","ar":"التلطيف بإنكار العكس","pos":"nom","g":"f","exFr":"« Ce n’est pas rien » est une litote.","ipa":"[li.tɔt]","exAr":"«ليست شيئاً» تلطيف."},{"fr":"l’emphase","ar":"التوكيد المبالغ","pos":"nom","g":"f","exFr":"L’emphase alourdit la phrase.","ipa":"[ɑ̃.faz]","exAr":"التوكيد المبالغ يُثقِّل الجملة."},{"fr":"la retenue","ar":"التهدئة والكبح","pos":"nom","g":"f","exFr":"Sa réponse est marquée par la retenue.","ipa":"[ʁə.tə.ny]","exAr":"جوابه مُميَّز بالتهدئة."},{"fr":"le vouvoiement","ar":"التخاطب بـ vous","pos":"nom","g":"m","exFr":"Le vouvoiement marque la distance.","ipa":"[vuvwa.jə.mɑ̃]","exAr":"التخاطب بـ vous يوحي بالمسافة."},{"fr":"le tutoiement","ar":"التخاطب بـ tu","pos":"nom","g":"m","exFr":"Le tutoiement suppose la familiarité.","ipa":"[ty.twa.jə.mɑ̃]","exAr":"التخاطب بـ tu يفترض الألفة."},{"fr":"adapter","ar":"يُكيّف","pos":"verbe","g":"","exFr":"Il faut adapter son discours.","ipa":"[a.dap.te]","exAr":"يجب تكييف خطابك."},{"fr":"manquer de","ar":"يفتقر إلى","pos":"loc.","g":"","exFr":"Cette formule manque de tact.","ipa":"","exAr":"هذه الصياغة تفتقر إلى الذكاء الاجتماعي."},{"fr":"convenir à","ar":"يناسب","pos":"loc.","g":"","exFr":"Ce ton convient au directeur.","ipa":"","exAr":"هذا النبرة تناسب المدير."}],"examples":[{"fr":"Je suis crevé. — registre familier.","ar":"أنا منهك. — مستوى عامي.","note":"le familier"},{"fr":"Je suis épuisé. — registre soutenu.","ar":"أنا منهك تماماً. — مستوى مرتفع.","note":"le soutenu"},{"fr":"Serait-il possible de reporter la réunion ?","ar":"هل من الممكن تأجيل الاجتماع؟","note":"la demande polie"},{"fr":"Ce n’est pas rien, cette victoire !","ar":"ليست شيئاً هذه النتيجة!","note":"la litote"},{"fr":"On se tutoie, d’accord ?","ar":"نتخاطب بـ tu، حسناً؟","note":"le tutoiement"},{"fr":"Je vous prie d’agréer mes salutations.","ar":"تفضّلوا بقبول فائق الاحترام.","note":"la formule de clôture"}],"grammar":[{"tFr":"Le registre dans la grammaire","tAr":"المستوى اللغوي في النحو","body":["le registre لا يظهر في le mot فقط بل في la grammaire: le subjonctif de politesse (« Il serait souhaitable que… »)، le conditionnel d’atténuation، le vouvoiement avec les titres.","le familier يستعمل les formes réduites: « T’es d’accord ? », « J’ai pas le temps. » — la négation بلا ne هي le marqueur le plus clair de registre."],"ex":[{"fr":"Il serait souhaitable que vous répondiez.","ar":"يُفضَّل أن تجيبوا."},{"fr":"J’ai pas le temps, franchement.","ar":"ليس لديّ وقت، بصراحة.","note":"le familier"}]},{"tFr":"Les formules de politesse et leur poids","tAr":"عبارات الأدب ووزنها","body":["la hiérarchie des formules: « Donne-moi… » ← « Peux-tu me donner… » ← « Pourrais-tu me donner… » ← « Serait-il possible d’obtenir… ». le verbe à la conditionnel porte la distance.","le pléonasme de politesse (« veuillez bien… ») يبقى le registre le plus formel dans les lettres — وحده في la conversation يبدو مبالغاً فيه."],"ex":[{"fr":"Pourrais-tu m’envoyer le document ?","ar":"هل يمكنك إرسال الوثيقة؟","note":"la demande polie"},{"fr":"Veuillez bien trouver ci-joint le rapport.","ar":"تجدون طيّاً التقرير.","note":"la lettre administrative"}]}],"mistakes":[{"wrong":"la confusion entre le registre et la classe sociale","right":"le registre = la situation, pas la personne","why":"le même locuteur ينتقل بين les registres حسب le destinataire."},{"wrong":"le familier dans une lettre de motivation","right":"le soutenu avec les formules de politesse","why":"le registre الخطأ يُفقد la crédibilité."},{"wrong":"la traduction littérale entre les registres","right":"le changement de la structure, pas le mot seul","why":"le registre يعيش في la grammaire و le ton."},{"wrong":"le soutenu المبالغ فيه مع les amis","right":"le courant ou le familier selon la relation","why":"l’emphase تُبعد la proximité."}],"dialogues":[{"title":"la bascule","ctx":"colleague switch","lines":[{"who":"Claire","fr":"Bonjour, seriez-vous disponible demain ?","ar":"مرحباً، هل ستكون متاحاً غداً؟"},{"who":"Karim","fr":"Oui, et toi, t’es libre à trois heures ?","ar":"نعم، وأنت، هل أنت متاح في الثالثة؟"},{"who":"Claire","fr":"On se tutoie, d’accord, je change de ton.","ar":"نتخاطب بـ tu، حسناً، غيّرت نبرتي."},{"who":"Karim","fr":"Parfait, ça me convient mieux.","ar":"ممتاز، هذا أنسب لي."}]},{"title":"choix du registre","ctx":"استاذ يعلّم الطالب","lines":[{"who":"Prof","fr":"Comment diriez-vous « je suis crevé » à un directeur ?","ar":"كيف ستقول «أنا منهك» لمدير؟"},{"who":"Élève","fr":"Je suis quelque peu fatigué, dirais-je.","ar":"سأقول: أنا متعب إلى حد ما."},{"who":"Prof","fr":"Exact. Et le registre familier, c’est pour qui ?","ar":"بالضبط. ومستوى العامي لمن؟"},{"who":"Élève","fr":"Pour les amis, avec le tutoiement.","ar":"للأصدقاء، مع التخاطب بـ tu."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما « la litote »؟","opts":["التلطيف بإنكار العكس","التوكيد المبالغ","الصمت","التكرار"],"a":0,"why":"litote = قول العكس لتقوية المعنى بلطف."},{"t":"fill","skill":"grammar","q":"اختر le registre soutenu: «___ possible de reporter ?»","fr":"___ possible de reporter la réunion ?","ans":"Serait-il","why":"le conditionnel de politesse يرفع le registre."},{"t":"mcq","skill":"analysis","q":"أي جملة من le registre familier ?","opts":["J’ai pas le temps.","Je n’ai pas le temps.","Je n’ai point le temps.","Il me serait difficile d’y consacrer du temps."],"a":0,"why":"la négation بلا ne هي le marqueur le plus clair."},{"t":"order","skill":"writing","q":"رتّب: هل من الممكن تأجيل الاجتماع؟","words":["Serait-il","possible","de","reporter","la","réunion","?"],"ans":"Serait-il possible de reporter la réunion ?","why":"la demande la plus polie."},{"t":"listen","skill":"listening","q":"ما « on se tutoie »؟","opts":["التخاطب بـ tu","التخاطب بـ vous","الصمت","التعقيب"],"a":0,"why":"le tutoiement يخفض la distance."},{"t":"translate","skill":"writing","q":"ترجم بـ le registre soutenu: «هل يمكنك إرسال الوثيقة؟»","ans":"Pourrais-tu m’envoyer le document ?","why":"la demande polie avec le conditionnel."},{"t":"speaking","skill":"speaking","q":"حوّل la même idée عبر les trois registres في 45 ثانية.","target":"Je suis crevé / Je suis fatigué / Je suis épuisé","why":"la bascule entre les registres."},{"t":"correct","skill":"grammar","q":"صحّح: «Veuillez bien me donner un café.»","ans":"Pourrais-tu me donner un café, s’il te plaît ?","why":"la formule de clôture formelle لا تناسب la conversation."}],"homework":"اكتب رسالة واحدة إلى collègue ثم نسخة إلى directeur: نفس المعنى، registre مختلف — وحدّد في كل نسخة les marqueurs المستعملة.","sources":[{"title":"Les registres de langue : courant, soutenu, familier","channel":"Français Authentique","videoId":"dEnQwaXT1sk","why":"شرح les registres الثلاثة في le contexte réel: كيف يتغيّر le même sens مع le ton، ومتى يصبح le familier خللاً.","cat":"Nuances","level":"B2","main":true},{"title":"Le registre de langue en français","channel":"French with Alicia","videoId":"GcWDl-fMbHM","why":"مقارنة واضحة بين les registres مع أمثلة من le quotidien.","cat":"Nuances","level":"B2","extra":true},{"title":"Familier, courant, soutenu : quelle différence ?","channel":"Français Authentique","videoId":"HZURshZkZXo","why":"اختيار le registre الصحيح حسب la situation et l’interlocuteur.","cat":"Nuances","level":"B2","extra":true}],"supplements":[{"id":"GcWDl-fMbHM","title":"Le registre de langue en français","channel":"French with Alicia","why":"مقارنة واضحة بين les registres مع أمثلة من le quotidien.","lang":"fr","dur":13},{"id":"HZURshZkZXo","title":"Familier, courant, soutenu : quelle différence ?","channel":"Français Authentique","why":"اختيار le registre الصحيح حسب la situation et l’interlocuteur.","lang":"fr","dur":11}]},{"id":"b2-t3-l5","fr":"Les collocations et expressions figées","ar":"التوافقات اللغوية والتعبيرات الجامدة","objectives":["تمييز la collocation (تراكيب شائعة) عن la traduction حرفيّة","إتقان les couples verbe + nom: prendre une décision, faire une erreur","استعمال les expressions figées في le contexte الصحيح","تبديل les mots المترادفات دون كسر le couple اللغوي"],"sections":[{"h":"الدرس 5: كيف تتكلم كما يتكلم الفرنسيون لا كما تترجم لهم","video":{"id":"IQs2-izz4aM","title":"Les collocations : on ne dit pas « faire une erreur »","channel":"French with Alicia","why":"شرح les collocations الأساسية: كيف يتّحد le verbe مع le nom، ولماذا la traduction الحرفيّة تكشف الناطق غير الأممي فوراً.","lang":"fr","main":true,"dur":16},"p":["la collocation هي la combinaison التي يقرّرها la usage لا la logique: نقول « prendre une décision » لا « faire une décision »، و« avoir raison » لا « tenir raison ». le locuteur الأممي يُعرف فوراً من le couple الخاطئ، حتى لو كانت la grammaire صحيحة.","معجم الدرس: la collocation, l’expression figée, le couple, l’usage, la sémantique, le verbe support, le registre, l’image, le calque, le syntagme, la formule, le proverbe. هذه المفردات تشرح لماذا les mots تتّحد.","نحوياً، le verbe support يحدّد la couleur: « poser une question » (فكري)، « soulever une question » (جدلي)، « garder le silence » (سلوك). le verbe هو le moteur de la collocation.","les expressions figées لا تُترجم ولا تُغيَّر: « Il fait un temps de chien » تبقى كما هي، و« poser un lapin » لا تعني la position la lapin. حفظها كوحدة واحدة هو la seule méthode.","الدرس الأهم: احفظ le couple لا le mot. أن تعرف « décision » وحدها لا يكفي — تحتاج « prendre une décision » و« changer de décision » و« reporter une décision ».","بعد الدرس: اكتب عشر جمل من يومك مستعملاً les collocations الخمس عشرة من الدرس، ثم أشر إلى كل couple بـ la parenthèse: verbe + nom."],"sub":[{"h":"les couples essentiels","p":["Prendre une décision, pas faire une décision.","Faire une erreur, pas commettre une erreur à l’oral.","Poser une question, soulever un débat."]},{"h":"أدوات نطقية: le verbe support","p":["« poser » [po.ze] — la question comme objet.","« soulever » [su.lə.ve] — la question comme sujet de débat.","« garder le silence » [ɡaʁ.de lə si.lɑ̃s] — le couple de comportement."]},{"h":"خطوات la mémorisation","p":["الخطوة الأولى: احفظ la phrase كاملة لا le mot.","الثانية: بدّل le contexte مع الحفاظ على le couple.","الثالثة: سجّل نفسك تستعمل les couples في conversation."]}]},{"h":"la carte des collocations","p":["« Prendre une décision » = اتخاذ قرار — jamais « faire une décision ».","« Lever une ambiguity » = إزالة لبس — le couple de clarté.","« Faire face à » = يواجه — l’expression de résistance.","« C’est une faute de novice. » = خطأ المبتدئ — l’expression figée de jugement."]},{"h":"التطبيق والتلخيص","p":["تمرين la correction: راجع نصاً كتبته وعدّل فيه les collocations الخاطئة بالواضحة — سجّل كم واحدة تغيّرت.","تمرين le remplacement: بدّل في جملة واحدة le nom مع الحفاظ على le verbe: « poser une question / poser un problème / poser une condition ».","سجّل ست جمل يومية فيها les collocations، ثم استمع وراقب: هل وصل le couple كما هو دون تردد؟"]},{"h":"التطبيق والتلخيص","p":["في هذا الدرس اكتشفت أن la collocation يقرّرها la usage لا la logique: «prendre une décision» لا «faire une décision»، و«faire face à». المتكلم الفرنسي يتذكّر الاتجاه لا القاعدة. أعد مشاهدة الفيديو الرئيسي وركّز على «prendre une décision» لا «faire une décision».","جسر الدروس: من b2-t3-l4 (اختيار مستوى اللغة المناسب للموقف) إلى b2-t3-l5 (التوافقات والتعبيرات الجامدة)، ثم إلى b2-t3-l6 حيث تُعبّر عن مشاعرك بمعجم دقيق.","مهمة تطبيقية: سجّل دقيقة صوتية تشرح فيها موقفاً من يومك مستخدماً ثلاث كلمات جديدة من الدرس (prendre une décision، faire face à، poser une question)، ثم استمع للتسجيل وقارن نطقك ومفرداتك بما سمعته في الفيديو الرئيسي."]}],"pron":[{"w":"la collocation","ipa":"[kɔ.lɔ.ka.sjɔ̃]","approx":"كولوكاسيون"},{"w":"prendre","ipa":"[pʁɑ̃dʁ]","approx":"براندʁ"},{"w":"le couple","ipa":"[lə kupl]","approx":"لو كوبل"}],"vocab":[{"fr":"prendre une décision","ar":"اتخاذ قرار","pos":"loc.","g":"","exFr":"Il faut prendre une décision aujourd’hui.","ipa":"","exAr":"يجب اتخاذ قرار اليوم."},{"fr":"faire une erreur","ar":"يرتكب خطأً","pos":"loc.","g":"","exFr":"Tout le monde fait des erreurs.","ipa":"","exAr":"الجميع يرتكب أخطاءً."},{"fr":"poser une question","ar":"يطرح سؤالاً","pos":"loc.","g":"","exFr":"Elle a posé une question précise.","ipa":"","exAr":"طرحت سؤالاً دقيقاً."},{"fr":"prendre conscience de","ar":"يُدرك","pos":"loc.","g":"","exFr":"Il a pris conscience du risque.","ipa":"","exAr":"أدرك الخطر."},{"fr":"faire face à","ar":"يواجه","pos":"loc.","g":"","exFr":"Il fait face à des difficultés.","ipa":"","exAr":"يواجه صعوبات."},{"fr":"lever une ambiguity","ar":"يزيل لبساً","pos":"loc.","g":"","exFr":"Pouvez-vous lever cette ambiguïté ?","ipa":"","exAr":"هل يمكنك إزالة هذا اللبس؟"},{"fr":"exprimer un regret","ar":"يعبّر عن أسى","pos":"loc.","g":"","exFr":"Il a exprimé ses regrets.","ipa":"","exAr":"عبّر عن أسفه."},{"fr":"l’expression figée","ar":"التعبير الجامد","pos":"nom","g":"f","exFr":"Cette expression figée se traduit autrement.","ipa":"[ɛks.pʁɛ.sjɔ̃ fi.ʒe]","exAr":"هذا التعبير الجامد يُترجم بشكل آخر."},{"fr":"la collocation","ar":"التوافق اللغوي","pos":"nom","g":"f","exFr":"La collocation est naturelle pour les locuteurs.","ipa":"[kɔ.lɔ.ka.sjɔ̃]","exAr":"التوافق اللغوي طبيعي للناطقين."},{"fr":"le verbe support","ar":"الفعل الحامل","pos":"nom","g":"m","exFr":"« Prendre » est le verbe support de « décision ».","ipa":"[lə vɛʁb supɔʁt]","exAr":"«prendre» هو الفعل الحامل لـ «décision»."},{"fr":"l’usage","ar":"الاستعمال المتّفق عليه","pos":"nom","g":"m","exFr":"L’usage a raison avant la logique.","ipa":"[y.saʒ]","exAr":"الاستعمال المتّفق عليه أولى من المنطق."},{"fr":"un calque","ar":"النقل الحرف","pos":"nom","g":"m","exFr":"Ce mot est un calque de l’anglais.","ipa":"[kalk]","exAr":"هذه الكلمة نقل حرف عن الإنجليزية."}],"examples":[{"fr":"Il faut prendre une décision rapide.","ar":"يجب اتخاذ قرار سريع.","note":"collocation"},{"fr":"J’ai fait une erreur dans le calcul.","ar":"ارتكبت خطأً في الحساب.","note":"collocation"},{"fr":"Elle a posé une question au ministre.","ar":"طرحت سؤالاً على الوزير.","note":"verbe support"},{"fr":"Il faut faire face aux conséquences.","ar":"يجب مواجهة العواقب.","note":"expression"},{"fr":"Le rapport lève une ambiguïté.","ar":"التقرير يزيل لبساً.","note":"collocation"},{"fr":"C’est une faute de débutant.","ar":"هذا خطأ المبتدئ.","note":"expression figée"}],"grammar":[{"tFr":"Le verbe support et son nom","tAr":"الفعل الحامل ومفعوله","body":["français يفضّل le couple (verbe + nom) على le verbe simple: « prendre une décision » بدل « décider » يمنح la phrase le registre le plus courant، و« rendre visite à » بدل « visiter » أكثر تهذيباً.","كل nom يرتبط بـ verbe محدد: une décision (prendre)، une erreur (faire/commettre)، un problème (poser/résoudre)، un risque (courir)، le silence (garder). la mémoire نصف les couples."],"ex":[{"fr":"Il a pris une décision difficile.","ar":"اتّخذ قراراً صعباً.","note":"prendre + décision"},{"fr":"Elle a résolu le problème en une heure.","ar":"حلّت المشكل في ساعة.","note":"résoudre + problème"}]},{"tFr":"Les expressions figées : ne pas les décomposer","tAr":"التعبيرات الجامدة: لا تفكّكها","body":["l’expression figée وحدة معنى واحدة لا تُقسَّم: « poser un lapin » تعني le mensonge la rencontre، و« Il pleut des cordes » تعني la pluie intense — تحليل le mot منفرد يُضيّع la signification.","conseil la pratique: احفظها في la phrase كاملة، ثم بدّل la situation لا les mots — هكذا تبقى la souplesse مع la fidélité."],"ex":[{"fr":"Il m’a posé un lapin hier.","ar":"خذَلني في الموعد أمس.","note":"expression figée"},{"fr":"Il pleut des cordes, on reste ici.","ar":"تمطر بغزارة، نبقى هنا.","note":"image figée"}]}],"mistakes":[{"wrong":"« faire une décision »","right":"« prendre une décision »","why":"le couple يقرّره la usage لا la logique."},{"wrong":"« donner une question »","right":"« poser une question »","why":"le verbe support خاص بـ le nom."},{"wrong":"ترجمة expression figée حرفيّاً","right":"حفظ la signification comme unité","why":"« poser un lapin » ليست la position la lapin."},{"wrong":"الثقة في le calque de l’anglais","right":"la vérification dans le dictionnaire","why":"le calque يكشف الناطق غير الأممي فوراً."}],"dialogues":[{"title":"تصحيح لغوي","ctx":"معلمة مع طالب","lines":[{"who":"Prof","fr":"Vous avez dit « faire une décision ».","ar":"قلت «faire une décision»."},{"who":"Élève","fr":"Oui, c’est une erreur fréquente ?","ar":"نعم، هل هذا خطأ شائع؟"},{"who":"Prof","fr":"En français, on prend une décision.","ar":"بالفرنسية، نقول «prendre une décision»."},{"who":"Élève","fr":"D’accord, je note le couple complet.","ar":"حسناً، سأدوّن التراكيب كاملة."}]},{"title":"débat sur une expression","ctx":"أصدقاء في المكتب","lines":[{"who":"Marc","fr":"Ce texte est un calque de l’anglais.","ar":"هذا النص نقل حرف عن الإنجليزية."},{"who":"Nadia","fr":"Alors remplaçons-le par une expression naturelle.","ar":"إذن استبدلناه بتعبير طبيعي."},{"who":"Marc","fr":"Par exemple : « faire face à la crise ».","ar":"مثلاً: «faire face à la crise»."},{"who":"Nadia","fr":"Parfait, c’est le couple attendu.","ar":"ممتاز، هذا هو التراكيب المنتظرة."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما التراكيب الصحيح؟","opts":["prendre une décision","faire une décision","donner une décision","tenir une décision"],"a":0,"why":"prendre + décision = le couple naturel."},{"t":"fill","skill":"grammar","q":"أكمل: «Il faut ___ face à la crise.»","fr":"Il faut ___ face à la crise.","ans":"faire","why":"faire face à = expression figée."},{"t":"mcq","skill":"vocabulary","q":"ما « poser un lapin »؟","opts":["ترك شخصاً في الموعد","وضع بيضة","رمي ورقة","طرح سؤالاً"],"a":0,"why":"expression figée لا تُترجم حرفياً."},{"t":"order","skill":"writing","q":"رتّب: يجب اتخاذ قرار سريع","words":["Il","faut","prendre","une","décision","rapide."],"ans":"Il faut prendre une décision rapide.","why":"prendre + décision."},{"t":"listen","skill":"listening","q":"ما le verbe support de « une question »؟","opts":["poser","prendre","faire","garder"],"a":0,"why":"poser une question = le couple attendu."},{"t":"translate","skill":"writing","q":"ترجم: يجب مواجهة العواقب.","ans":"Il faut faire face aux conséquences.","why":"faire face à = expression figée."},{"t":"speaking","skill":"speaking","q":"اذكر أربع collocations من يومك في 45 ثانية مع le couple كاملاً.","target":"prendre une décision / faire une erreur / poser une question / garder le silence","why":"la mémoire des couples."},{"t":"correct","skill":"grammar","q":"صحّح: «J’ai fait une décision difficile.»","ans":"J’ai pris une décision difficile.","why":"prendre + décision."}],"homework":"اكتب فقرة من 120 كلمة عن قرار اتّخذته، واستعمل فيها ست collocations مع le couple كاملاً — واقرأها بصوت عالٍ لتتحقق من la fluidité.","sources":[{"title":"Les collocations : on ne dit pas « faire une erreur »","channel":"French with Alicia","videoId":"IQs2-izz4aM","why":"شرح les collocations الأساسية: كيف يتّحد le verbe مع le nom، ولماذا la traduction الحرفيّة تكشف الناطق غير الأممي فوراً.","cat":"Nuances","level":"B2","main":true},{"title":"La Qualification juridique [argumentation & raisonnement juridique]","channel":"Théorie du droit","videoId":"Hi7Nm3JSXag","why":"la précision des couples dans le langage professionnel — la même rigueur de collocation.","cat":"Nuances","level":"B2","extra":true},{"title":"Ne dis pas toujours « à très grand à » : utilise ces synonymes","channel":"Français Authentique","videoId":"NFaRv9BYMMk","why":"تنويع le vocabulaire مع الحفاظ على le couple اللغوي الصحيح.","cat":"Nuances","level":"B2","extra":true}],"supplements":[{"id":"Hi7Nm3JSXag","title":"La Qualification juridique [argumentation & raisonnement juridique]","channel":"Théorie du droit","why":"la précision des couples dans le langage professionnel — la même rigueur de collocation.","lang":"fr","dur":7},{"id":"NFaRv9BYMMk","title":"Ne dis pas toujours « à très grand à » : utilise ces synonymes","channel":"Français Authentique","why":"تنويع le vocabulaire مع الحفاظ على le couple اللغوي الصحيح.","lang":"fr","dur":13}]},{"id":"b2-t3-l6","fr":"Le lexique de l’émotion","ar":"معجم المشاعر بالفرنسية","objectives":["تمييز les émotions الأساسية: joie, peur, colère, tristesse, étonnement","استعمال les degrés: content, ravi, enchanté, comblé","وصف l’émotion avec le corps et le contexte لا le nom فقط","تمييز la nuance entre les verbes: émouvoir, bouleverser, irriter"],"sections":[{"h":"الدرس 6: كيف تُعبّر عن المشاعر بدقة بلا تكرار « j’ai peur »","video":{"id":"NFaRv9BYMMk","title":"Exprimer ses émotions sans se répéter","channel":"Français Authentique","why":"شرح le spectre des émotions: كيف تنتقل من « content » إلى « ravi », « ému », « soulagé » — la nuance تُغني عن la répétition.","lang":"fr","main":true,"dur":13},"p":["le lexique l’émotion في français ليس قائمة مرادفات بل spectre: « content » (رضا يومي)، « ravi » (فرح قوي)، « enchanté » (فرح اجتماعي)، « comblé » (امتلاء). la bonne graduazione تجعل la phrase تُصدّق لا تُبالغ.","معجم الدرس: la joie, la peur, la colère, la tristesse, l’étonnement, le soulagement, la frustration, l’anxiété, l’enthousiasme, la mélancolie, l’indignation, la tendresse. هذه المفردات تبني votre palette.","نحوياً، les émotions تأتي بـ deux structures: « être + adjectif » (je suis triste) و « avoir + nom » (j’ai peur، j’ai envie). la deuxième أكثر physique وأقل تقريرية — ولهذا تُفضَّل dans la conversation.","le verbe peut porter l’émotion: « Ce film m’a ému » (لامس)، « Ce discours m’a bouleversé » (هزّ)، « Cette remarque m’a irrité » (غيّظ). la différence بين émouvoir و bouleverser هي le degré لا la catégorie.","la règle la nuance: الزيادة في le superlatif تُفقد la crédibilité. « Je suis tellement triste que… » كلما كرّرته كلما ضعف — le détail الصغير (« je n’ai pas dormi ») أقوى من l’exclamation.","بعد الدرس: اكتب مونولوجاً من عشر جمل عن يوم مؤثر، مستعملاً les cinq familles d’émotions بلا تكرار le même nom مرّتين."],"sub":[{"h":"le spectre de la joie","p":["Je suis content d’apprendre la nouvelle.","Je suis ravi que tu viennes.","Je suis comblé par votre accueil."]},{"h":"أدوات نطقية: l’émotion par le corps","p":["« J’ai le cœur qui bat. » [ʒɛ lə kœʁ ki ba] — la peur physique.","« J’ai les mains qui tremblent. » — le corps parle avant le nom.","« Ça me serre la gorge. » — l’émotion contenue."]},{"h":"خطوات la description","p":["الخطوة الأولى: اسمّي l’émotion.","الثانية: صف le corps.","الثالثة: اشرح le contexte."]}]},{"h":"عبارات المشاعر الدقيقة","p":["« Je suis soulagé que tu sois rentré. » = مرتاح لعودتك — la nuance + le subjonctif.","« Cela m’a profondément ému. » = أثّر فيّ بعمق — le verbe au lieu de l’adjectif.","« J’en ai été surpris, il va sans dire. » — l’étonnement avec la retenue.","« Je suis au bord de la colère. » = أنا على حافة الغضب — la limite avant l’explosion."]},{"h":"التطبيق والتلخيص","p":["تمرين le spectre: ضع les mots suivية على le gradient: content ← ravi ← enchanté ← comblé، ثم استعمل كل واحد في جملة من حياتك.","تمرين le corps: اكتب خمس جمل تصف فيها la réaction physique دون تسمية l’émotion، ثم خمّنها.","سجّل monologue من دقيقة: يوم مرهق، باستعمال les quatre familles: la peur، la colère، le soulagement، la joie."]},{"h":"التطبيق والتلخيص","p":["تعلّمت أن le lexique l’émotion spectre لا قائمة: content (رضا)، ravi (فرح قوي)، comblé (امتلاء). la bonne graduazione تمنع تكرار «j’ai peur». أعد مشاهدة الفيديو الرئيسي وركّز على التدرّج بين content وravi وcomblé.","جسر الدروس: من b2-t3-l5 (التوافقات والتعبيرات الجامدة) إلى b2-t3-l6 (معجم المشاعر الدقيق)، ثم إلى b2-t4-l1 حيث تنتقل إلى كتابة المقالة الحجاجية المُنظَّمة.","مهمة تطبيقية: سجّل دقيقة صوتية تشرح فيها موقفاً من يومك مستخدماً ثلاث كلمات جديدة من الدرس (la joie، le soulagement، l’enthousiasme)، ثم استمع للتسجيل وقارن نطقك ومفرداتك بما سمعته في الفيديو الرئيسي."]}],"pron":[{"w":"l’émotion","ipa":"[e.mo.sjɔ̃]","approx":"إموسيون"},{"w":"bouleverser","ipa":"[bul.vɛʁ.se]","approx":"بولڤيرسيه"},{"w":"le soulagement","ipa":"[lə su.laʒmɑ̃]","approx":"لو سولاجمان"}],"vocab":[{"fr":"la joie","ar":"الفرح","pos":"nom","g":"f","exFr":"Sa joie était visible.","ipa":"[ʒwa]","exAr":"فرحه كان واضحاً."},{"fr":"la peur","ar":"الخوف","pos":"nom","g":"f","exFr":"Il a eu peur dans le noir.","ipa":"[pœʁ]","exAr":"خاف في الظلام."},{"fr":"la colère","ar":"الغضب","pos":"nom","g":"f","exFr":"Il a parlé avec colère.","ipa":"[kɔ.lɛʁ]","exAr":"تحدّث بغضب."},{"fr":"la tristesse","ar":"الحزن","pos":"nom","g":"f","exFr":"Sa tristesse était discrète.","ipa":"[tʁi.stɛs]","exAr":"حزنه كان خفياً."},{"fr":"le soulagement","ar":"الارتياح","pos":"nom","g":"m","exFr":"Un grand soulagement après l’examen.","ipa":"[su.laʒmɑ̃]","exAr":"ارتياح كبير بعد الامتحان."},{"fr":"l’étonnement","ar":"الدهشة","pos":"nom","g":"m","exFr":"Son étonnement se lisait sur son visage.","ipa":"[e.tɔn.mɑ̃]","exAr":"دهشته تُقرأ على وجهه."},{"fr":"la frustration","ar":"الإحباط","pos":"nom","g":"f","exFr":"La frustration monte dans l’équipe.","ipa":"[fʁys.tʁa.sjɔ̃]","exAr":"الإحباط يتراكم في الفريق."},{"fr":"l’enthousiasme","ar":"الحماس","pos":"nom","g":"m","exFr":"Il a accueilli le projet avec enthousiasme.","ipa":"[ɑ̃.tuz.jasm]","exAr":"استقبل المشروع بحماس."},{"fr":"éprouver","ar":"يُختبر/يشعر بـ","pos":"verbe","g":"","exFr":"J’éprouve de la gratitude.","ipa":"[e.pʁu.ve]","exAr":"أشعر بالامتنان."},{"fr":"bouleverser","ar":"يهزّ عاطفياً","pos":"verbe","g":"","exFr":"Ce récit m’a bouleversé.","ipa":"[bul.vɛʁ.se]","exAr":"هزّني هذا السرد."},{"fr":"être soulagé","ar":"يشعر بالارتياح","pos":"loc.","g":"","exFr":"Je suis soulagé par ton appel.","ipa":"","exAr":"ارتّحَتْ نفسي من مكالمتك."},{"fr":"se calmer","ar":"يهدأ","pos":"verbe","g":"","exFr":"Il faut se calmer avant de parler.","ipa":"","exAr":"يجب الهدوء قبل الكلام."}],"examples":[{"fr":"Je suis ravi que tu viennes.","ar":"أنا سعيد جداً بمجيئك.","note":"le degré de joie"},{"fr":"Le film m’a profondément ému.","ar":"أثّر فيّ الفيلم بعمق.","note":"le verbe d’émotion"},{"fr":"J’ai eu peur en entendant le bruit.","ar":"خاف عندما سمعت الضجيج.","note":"avoir + nom"},{"fr":"Je suis soulagé que tout soit fini.","ar":"ارتّحَتْ نفسي لأن كل شيء انتهى.","note":"subjonctif d’émotion"},{"fr":"Sa remarque m’a irrité, mais je me suis calmé.","ar":"غيّظتني ملاحظته، لكنني هدأت.","note":"la nuance"},{"fr":"Cela m’a bouleversé au point de pleurer.","ar":"هزّني حتى البكاء.","note":"le degré fort"}],"grammar":[{"tFr":"Être + adjectif ou avoir + nom","tAr":"صفات المشاعر مع être وأسمائها مع avoir","body":["français يميّز بين le trait (être + adjectif: « je suis triste ») و le sentiment physique (avoir + nom: « j’ai peur », « j’ai honte »). la deuxième la plus naturelle dans la conversation لأنها تصف réaction لا état.","بعض les émotions لها les deux formes مع nuance: « être en colère » (le registre courant) و « avoir de la colère » (le registre soutenu)."],"ex":[{"fr":"J’ai peur de l’avenir.","ar":"أخاف من المستقبل.","note":"avoir + nom"},{"fr":"Je suis triste depuis son départ.","ar":"حزين منذ رحيله.","note":"être + adjectif"}]},{"tFr":"Le subjonctif après les émotions","tAr":"الفاعلية بعد تعبيرات المشاعر","body":["après « je suis content que », « je suis soulagé que », « j’ai peur que » يأتي le subjonctif: « Je suis content que tu sois là. »","« j’ai peur que » تأتي أحياناً مع la négation renforcée: « J’ai peur que tu n’aies pas le temps. » — la marque de le registre soutenu."],"ex":[{"fr":"Je suis content que tu sois venu.","ar":"سعيد بمجيئك.","note":"subjonctif"},{"fr":"J’ai peur qu’il n’ait pas compris.","ar":"أخشى ألا يكون قد فهم.","note":"subjonctif + ne explétif"}]}],"mistakes":[{"wrong":"« Je suis peur »","right":"« J’ai peur »","why":"la peur تأتي مع avoir لا être."},{"wrong":"تكرار « content » لكل درجة","right":"la graduazione: content, ravi, enchanté","why":"la répétition تُفقد la nuance."},{"wrong":"« C’est triste » لكل موقف","right":"« Cela m’a ému / bouleversé »","why":"le verbe ينقل l’émotion إلى le locuteur."},{"wrong":"« Je suis tellement triste que… » المبالغ","right":"un détail concret: « je n’ai pas dormi »","why":"le détail أصدق من l’exclamation."}],"dialogues":[{"title":"وصف يوم مؤثر","ctx":"صديقان في المساء","lines":[{"who":"Nadia","fr":"Tu as l’air fatigué, tout va bien ?","ar":"تبدو متعباً، هل كل شيء على ما يرام؟"},{"who":"Marc","fr":"J’ai été bouleversé par la nouvelle ce matin.","ar":"هزّتني الخبرة هذا الصباح."},{"who":"Nadia","fr":"Tu es soulagé maintenant ?","ar":"هل أنت مرتاح الآن؟"},{"who":"Marc","fr":"Oui, enfin je suis ravi que tout soit fini.","ar":"نعم، أخيراً أنا سعيد لأن كل شيء انتهى."}]},{"title":"une nuance partagée","ctx":"مناقشة فيلم","lines":[{"who":"Claire","fr":"Le film m’a ému, pas bouleversé.","ar":"أثّر فيّ الفيلم، لم يهزّني."},{"who":"Karim","fr":"La différence, c’est le degré, non ?","ar":"الفرق في الدرجة، أليس كذلك؟"},{"who":"Claire","fr":"Exact : émouvoir touche, bouleverser secoue.","ar":"بالضبط: إما أن يلامس أو يهزّ."},{"who":"Karim","fr":"Alors je dirais que la scène m’a irrité.","ar":"إذن سأقول إن المشهد غيّطني."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما la structure الصحيحة لـ « la peur »؟","opts":["J’ai peur.","Je suis peur.","C’est peur.","J’avais peur de être."],"a":0,"why":"avoir + nom pour les émotions physiques."},{"t":"fill","skill":"grammar","q":"أكمل بالsubjonctif: «Je suis content que tu___ (venir).»","fr":"Je suis content que tu ___ venir.","ans":"viennes","why":"être content que + subjonctif."},{"t":"mcq","skill":"vocabulary","q":"ما le degré le plus fort ? (content)","opts":["comblé","content","satisfait","calme"],"a":0,"why":"comblé = le sommet de la joie."},{"t":"order","skill":"writing","q":"رتّب: مرتاح لعودتك","words":["Je","suis","soulagé","que","tu","sois","rentré."],"ans":"Je suis soulagé que tu sois rentré.","why":"être soulagé que + subjonctif."},{"t":"listen","skill":"listening","q":"ما « m’a bouleversé »؟","opts":["هزّني عاطفياً","أزعجني قليلاً","ضحكني","ملّني"],"a":0,"why":"bouleverser = le degré le plus fort."},{"t":"translate","skill":"writing","q":"ترجم: أخشى ألا يكون قد فهم.","ans":"J’ai peur qu’il n’ait pas compris.","why":"j’ai peur que + subjonctif."},{"t":"speaking","skill":"speaking","q":"صف يوماً مرهقاً في دقيقة باستعمال أربع émotions مختلفة.","target":"J’ai eu peur… / Cela m’a irrité… / Je suis soulagé… / Je suis ravi…","why":"le spectre sans répétition."},{"t":"correct","skill":"grammar","q":"صحّح: «Je suis peur du noir.»","ans":"J’ai peur du noir.","why":"la peur تأتي مع avoir."}],"homework":"اكتب مونولوجاً من عشر جمل عن يوم مؤثر: ابدأ باسم l’émotion، ثم صف le corps، ثم اشرح le contexte — بلا تكرار le même nom.","sources":[{"title":"Exprimer ses émotions sans se répéter","channel":"Français Authentique","videoId":"NFaRv9BYMMk","why":"شرح le spectre des émotions: كيف تنتقل من « content » إلى « ravi », « ému », « soulagé » — la nuance تُغني عن la répétition.","cat":"Nuances","level":"B2","main":true},{"title":"Exprimer ses émotions en français","channel":"Français Authentique","videoId":"wEiA2lg1Lqc","why":"le vocabulaire complet des émotions avec les nuances entre les degrés.","cat":"Nuances","level":"B2","extra":true},{"title":"Les nuances de l’émotion en français","channel":"French with Alicia","videoId":"tlDheBt7MiQ","why":"تمييز les verbes: émouvoir, bouleverser, irriter في le contexte réel.","cat":"Nuances","level":"B2","extra":true}],"supplements":[{"id":"wEiA2lg1Lqc","title":"Exprimer ses émotions en français","channel":"Français Authentique","why":"le vocabulaire complet des émotions avec les nuances entre les degrés.","lang":"fr","dur":12},{"id":"tlDheBt7MiQ","title":"Les nuances de l’émotion en français","channel":"French with Alicia","why":"تمييز les verbes: émouvoir, bouleverser, irriter في le contexte réel.","lang":"fr","dur":10}]}]},{"id":"b2-t4","slug":"l-expression-academique","icon":"file","color":"#ca8a04","fr":"L’expression académique","ar":"التعبير الأكاديمي","desc":"la dissertation، la synthèse، le commentaire، la citation، l’abstract — la méthode la écriture académique.","lessons":[{"id":"b2-t4-l1","fr":"La dissertation argumentée","ar":"المقالة الحجاجية المُنظَّمة","objectives":["تحليل نص الامتحان واستخراج المشكلات المحتملة","بناء خطة من ثلاثة أجزاء متماسكة (dialectique ou thématique)","كتابة مقدمة من أربع خطوات: مدخل، تعريف، مشكلة، إعلان","صياغة خاتمة تعيد صياغة المشكلات دون إضافة حجج جديدة"],"sections":[{"h":"الدرس 1: كيف تكتب مقالة فرنسية محكمة من المقدمة إلى الخاتمة","video":{"id":"L87HeuqvzT8","title":"20/20 à la dissertation de français : GUIDE ULTIME 2026","channel":"Maxime Lim","why":"دليل شامل لكتابة المقالة الفرنسية: قراءة الموضوع، بناء المشكلات، ترتيب الخطة، وصياغة المقدمة والخاتمة.","lang":"fr","main":true,"dur":17},"p":["المقالة (la dissertation) ليست رأياً حرّاً بل بناء مُنظَّم: نقرأ نص الامتحان، نستخرج الفكرة العامة، نصوغ مشكلة واحدة، ثم نجيب عنها في ثلاث فقرات مرتّبة. النص الذي لا مشكلة له لا تُقبل مقالته في الامتحان الفرنسي مهما كان أسلوبه.","معجم الدرس: la problématique, l’accroche, l’annonce du plan, le développement, la citation, la nuance, illustrer, synthétiser, en définitive, pour conclure, d’une part, néanmoins. هذه الكلمات هي مفاتيح تكوين النص.","نحوياً، المقالة تُنَوّع التراكيب: جملة مركبة (subordonnée relative و complétive)، فعل بصيغة التزامية في الحكم العام (« il faut que ce soit clair »)، والصيغة المجهولة عند الحاجة إلى الموضوعية. التنويع النحوي علامة النص المكتوب جيداً.","المقدمة بأربع خطوات: accroche قصيرة (سؤال، مثال، إحصاء)، ثم تعريف المفاهيم، ثم مشكلة واحدة بصيغة سؤال، ثم إعلان الخطة بعبارة واحدة. خمس إلى سبع جمل تكفي؛ المقدمة الطويلة تسرق وقت المصحّح.","الخاتمة تغلق النص دون أن تفتحه: تعيد صياغة المشكلات، تجيب بإيجاز، وتُضيف ملاحظة افتتاحية نحو المستقبل. ممنوع تماماً تقديم حجة جديدة في الخاتمة، لأن ذلك يُظهر أن خطة النص لم تكن مكتملة.","بعد الدرس: اكتب مقالة من 400 كلمة في ساعة واحدة، ثم صحّحها بنفسك بشريطين: شريط البنية (مقدمة، ثلاث فقرات، خاتمة) وشريط اللغة (أدوات الربط، تنويع التراكيب، غياب التكرار)."],"sub":[{"h":"Lire le sujet et trouver la problématique","p":["Quel est l’enjeu du texte proposé ?","Le sujet demande une nuance, pas une opinion.","La problématique se formule en une question précise."]},{"h":"Construire le plan","p":["D’une part..., d’autre part..., enfin.","Thèse, antithèse, puis synthèse.","Chaque partie s’ouvre par une idée directrice."]},{"h":"Rédiger introduction et conclusion","p":["Introduction : accroche, définition, problématique, annonce.","Conclusion : réponse brève et ouverture.","Ne jamais ajouter d’argument nouveau en fin de texte."]}]},{"h":"Les formules de service de la dissertation","p":["« Il convient de s’interroger sur... » — ouvrir la problématique avec sérieux.","« D’une part..., d’autre part... » — annoncer le plan sans le détailler.","« En définitive... » — marquer la dernière étape du raisonnement.","« Pour conclure... » — annoncer la clôture et fermer le texte proprement."]},{"h":"التطبيق والتلخيص","p":["تمرين المقدمة: اكتب أربع مقدمات لخمس مواضيع مختلفة، كل واحدة من أربع خطوات لا أكثر.","تمرين الخطة: خذ موضوعاً واحداً وابنِ خطتين مختلفتين (dialectique و thématique) ثم اختر الأقوى بسبب.","تمرين الساعة: اكتب مقالة من 400 كلمة في 60 دقيقة، وقسّم الوقت: 10 دقائق للتحليل، 10 للخطة، 35 للكتابة، 5 للمراجعة."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: بناء المقالة الحجاجية من الإشكالية إلى الخاتمة؛ أعد مشاهدة الفيديو الرئيسي وركّز على تسلسل الخطوات الأربع في المقدمة.","جسر الدروس: من b2-t3-l6 (معجم المشاعر بالفرنسية) إلى b2-t4-l1 (بناء المقالة الحجاجية من الإشكالية إلى الخاتمة)، ثم إلى b2-t4-l2 حيث تنتقل من كتابة المقالة وحدها إلى مقارنة عدة وثائق وصهرها في نصّ واحد (تلخيص جماع الوثائق في نصٍّ واحد منسّق).","مهمة تطبيقية: اكتب دقيقةً من الكتابة (نحو 100 كلمة) تلخّص فيها أهم ثلاث أفكار من هذا الدرس، واستعمل 3 كلمات جديدة من قاموسه، ثم قارن نصّك بمقتطف من الفيديو الرئيسي وحدّد الفروق."]}],"pron":[{"w":"problématique","ipa":"[pʁɔ.ble.ma.tik]","approx":"بروبليماتيك"},{"w":"dissertation","ipa":"[di.sɛʁ.ta.sjɔ̃]","approx":"ديسرتاسيون"},{"w":"synthèse","ipa":"[sɛ̃.tɛz]","approx":"سانطيز"}],"vocab":[{"fr":"la problématique","ar":"الإشكالية (السؤال المركزي)","pos":"nom","g":"f","exFr":"La problématique du sujet est double.","ipa":"[pʁɔ.ble.ma.tik]","exAr":"إشكالية الموضوع مزدوجة."},{"fr":"l’entrée en matière","ar":"المدخل الافتتاحي للمقالة","pos":"loc.","g":"","exFr":"Une entrée en matière sobre cadre immédiatement le sujet.","ipa":"[le.ʁɑ̃.teɑ̃ ma.tjœʁ]","exAr":"مدخلٌ افتتاحيٌّ مقتضب يؤطّر الموضوع فوراً."},{"fr":"l’annonce du plan","ar":"إعلان الخطة","pos":"nom","g":"f","exFr":"L’annonce du plan tient en une phrase.","ipa":"[a.nɔ̃s dy plɑ̃]","exAr":"إعلان الخطة في جملة واحدة."},{"fr":"le développement","ar":"الجزء التمهيدي / التوسّع","pos":"nom","g":"m","exFr":"Le développement représente trois quarts du texte.","ipa":"[dɛ.vlɔ.pmɑ̃]","exAr":"التوسّع يمثّل ثلاثة أرباع النص."},{"fr":"la citation","ar":"الاقتباس","pos":"nom","g":"f","exFr":"Une citation éclaire votre propos.","ipa":"[si.ta.sjɔ̃]","exAr":"اقتباس يُنير كلامكم."},{"fr":"la modération","ar":"الاعتدال في صياغة الأحكام","pos":"nom","g":"f","exFr":"La modération du ton renforce la crédibilité de la dissertation.","ipa":"[la mɔ.deʁa.sjɔ̃]","exAr":"اعتدالُ النبرة يعزّز مصداقية المقالة."},{"fr":"illustrer","ar":"يُدعم بمثال","pos":"verbe","g":"","exFr":"Cette étude illustre parfaitement mon propos.","ipa":"[i.ly.stʁe]","exAr":"هذه الدراسة تدعم كلامي تماماً."},{"fr":"synthétiser","ar":"يلخّص بشكل منهجي","pos":"verbe","g":"","exFr":"Il reste à synthétiser les deux parties.","ipa":"[sɛ̃.te.ti.ze]","exAr":"يتبقي تلخيص الجزأين."},{"fr":"en définitive","ar":"في نهاية المطاف","pos":"loc.","g":"","exFr":"En définitive, la méthode a porté ses fruits.","ipa":"[ɑ̃ de.fi.ni.tiv]","exAr":"في نهاية المطاف، أثمرت الطريقة."},{"fr":"pour conclure","ar":"ختاماً / للاستنتاج","pos":"loc.","g":"","exFr":"Pour conclure, la question reste ouverte.","ipa":"[puʁ kɔ̃klyʁ]","exAr":"ختاماً، السؤال يبقى مفتوحاً."},{"fr":"fonder","ar":"يؤسّس / يستند إلى","pos":"verbe","g":"","exFr":"Ce jugement est fondé sur des faits.","ipa":"[fɔ̃.de]","exAr":"هذا الحكم مستند إلى حقائق."},{"fr":"légitime","ar":"مشروع / وارد","pos":"adj.","g":"","exFr":"Votre objection est légitime.","ipa":"[le.ʒi.tim]","exAr":"اعتراضكم مشروع."}],"examples":[{"fr":"Il convient de s’interroger sur la place de l’école dans la démocratie.","ar":"من الوارد التساؤل عن مكانة المدرسة في الديمقراطية.","note":"problématique"},{"fr":"D’une part, la mémoire individuelle ; d’autre part, la mémoire collective.","ar":"من جهة، الذاكرة الفردية؛ ومن جهة أخرى، الذاكرة الجماعية.","note":"annonce du plan"},{"fr":"Comme le souligne l’auteur, « la liberté se conquiert chaque jour ».","ar":"كما يؤكد المؤلف: «الحرية تُنتزع كل يوم».","note":"citation"},{"fr":"Cette remarque illustre parfaitement le risque évoqué.","ar":"هذا الملاحظة تدعم تماماً الخطر الذي تمت الإشارة إليه.","note":"illustrer"},{"fr":"Néanmoins, cette vision néglige un fait décisif.","ar":"غير أن هذا التوجه يهمل حقيقة حاسمة.","note":"nuance"},{"fr":"En définitive, l’enjeu n’est pas technique mais politique.","ar":"في نهاية المطاف، التحدي ليس تقنياً بل سياسياً.","note":"conclusion"}],"grammar":[{"tFr":"Les subordonnées pour lier les idées","tAr":"الجمل التابعة لربط الأفكار","body":["المقالة تربط أفكارها بجمل مركّبة لا بجمل قصيرة متتابعة: « Bien que les chiffres soient encourageants, ... » للتناقض، « Ce que l’on oublie, c’est ... » لتقديم فكرة مخفية، « Dès lors que ... » لتقديم الشرط.","نوّع بين الجمل المكمّلة (complétives مثل « le fait que... ») والجمل الموصولة (relatives مثل « ce que... ») والجمل الظرفية (circonstancielles مثل « alors que... »). ثلاثة أنواع في كل فقرة تكفي لإظهار المرونة دون إثقال النص."],"ex":[{"fr":"Ce que l’on mesure mal, c’est l’impact réel sur les familles.","ar":"ما لا نقيسه جيداً هو الأثر الحقيقي على الأسر."},{"fr":"Dès lors que les faits sont établis, la discussion devient utile.","ar":"حالما تُثبت الحقائق، يصبح النقاش مفيداً."}]},{"tFr":"L’indicatif et le subjonctif dans le jugement","tAr":"الفرق بين الفعلي والالتزامي في الحكم","body":["الحالة المؤكدة بالفالي: « Il est certain que la situation change »، والشك أو الرغبة بالصيغة التزامية: « Il faut que la situation change », « Bien que la situation soit difficile ».","في المقالة، التزامي يظهر غالباً بعد « il faut que », « bien que », « pour que » — وأكثر خطاً شائعاً هو كتابة « il faut que la situation est difficile » بدل « soit »."],"ex":[{"fr":"Il faut que chaque argument soit illustré par un exemple.","ar":"يجب أن يُدعم كل حجة بمثال."},{"fr":"Il est certain que la réforme produira des effets.","ar":"مؤكد أن الإصلاح سيُنتج آثاراً."}]}],"mistakes":[{"wrong":"كتابة رأي حرّ بلا مشكلة","right":"صياغة مشكلة واحدة قبل البدء بالكتابة","why":"المصحّح الفرنسي يبحث عن الإشكالية أولاً؛ غيابها خسارة مباشرة."},{"wrong":"مقدمة طويلة مكرّرة الإعلان","right":"مقدمة من أربع خطوات وخمس إلى سبع جمل","why":"النص يُقاس بجودة التحليل لا بطول المقدمة."},{"wrong":"إضافة حجج جديدة في الخاتمة","right":"إعادة صياغة المشكلات ثم إجابة موجزة وافتتاح","why":"الحجة الجديدة تُظهر أن خطة النص لم تكتمل."},{"wrong":"جُمل قصيرة متتابعة بلا ربط","right":"تنويع التراكيب مع أدوات ربط صحيحة","why":"التنويع النحوي من معايير التقييم في المستوى B2."}],"dialogues":[{"title":"Séance de méthodologie","ctx":"أستاذ يشرح لطلبه كيف يحلّل الموضوع","lines":[{"who":"Prof","fr":"Quelle est la problématique de ce sujet ?","ar":"ما إشكالية هذا الموضوع؟"},{"who":"Léon","fr":"Peut-on concilier croissance et écologie ?","ar":"هل يمكن التوفيق بين النمو والبيئة؟"},{"who":"Prof","fr":"Parfait. Annoncez le plan en une phrase.","ar":"ممتاز. أعلن الخطة في جملة واحدة."},{"who":"Léon","fr":"D’une part les freins, d’autre part les leviers, enfin une ouverture.","ar":"من جهة المعوقات، ومن جهة أخرى الرافعات، وأخيراً افتتاح."}]},{"title":"Correction entre étudiants","ctx":"زميلان يتصحان مقالتا بعضهما","lines":[{"who":"Nadia","fr":"Ton introduction est claire, mais où est l’accroche ?","ar":"مقدمتك واضحة، لكن أين المدخل؟"},{"who":"Youssef","fr":"Tu as raison, je vais ajouter une citation.","ar":"أنت محقّ، سأضيف اقتباساً."},{"who":"Nadia","fr":"Et ta conclusion ajoute un argument nouveau.","ar":"خاتمتك تضيف حجة جديدة."},{"who":"Youssef","fr":"Bien vu, je le remplace par une ouverture.","ar":"ملاحظة جيدة، سأستعيض عنه بافتتاح."}]}],"exercises":[{"t":"mcq","skill":"writing","q":"ما ترتيب المقدمة الصحيح؟","opts":["إعلان، مشكلة، مدخل، تعريف","مدخل، تعريف، مشكلة، إعلان","تعريف، مدخل، إعلان، مشكلة","مشكلة، مدخل، تعريف، إعلان"],"a":1,"why":"accroche ثم تعريف ثم problématique ثم annonce du plan."},{"t":"fill","skill":"grammar","q":"أكمل: «Il faut que chaque argument ___ illustré.»","fr":"Il faut que chaque argument ___ illustré.","ans":"soit","why":"il faut que + subjonctif: soit (de être)."},{"t":"order","skill":"writing","q":"رتّب عناصر المقالة كترتيباً منطقياً","words":["accroche","définition","problématique","annonce"],"ans":"accroche définition problématique annonce","why":"المقدمة تسير من العام إلى الخاص."},{"t":"mcq","skill":"writing","q":"أي عنصر ممنوع في الخاتمة؟","opts":["إعادة صياغة المشكلات","حجة جديدة","إجابة موجزة","افتتاح نحو المستقبل"],"a":1,"why":"الحجة الجديدة تكسر اكتمال الخطة."},{"t":"listen","skill":"listening","q":"استمع واختر عبارة إعلان الخطة في المقالة.","opts":["Il convient de s’interroger sur...","D’une part..., d’autre part...","En effet, les chiffres...","Faute de données..."],"a":1,"why":"العبارة تُعلن بنيتين متجاورتين من الخطة."},{"t":"translate","skill":"writing","q":"ترجم: «في نهاية المطاف، يبقى التحدي سياسياً لا تقنياً.»","ans":"En définitive, l’enjeu demeure politique et non technique.","why":"en définitive تفتح الخاتمة."},{"t":"speaking","skill":"speaking","q":"اشرح شفهياً في دقيقة: كيف تبني مشكلة من موضوع واحد؟","target":"problématique + plan + annonce","why":"التمهيد الشفهي للمنطق الكتابي."},{"t":"correct","skill":"grammar","q":"صحّح: «Bien que la situation est difficile, il faut agir.»","ans":"Bien que la situation soit difficile, il faut agir.","why":"Bien que + subjonctif: soit."}],"homework":"اكتب مقالة من 400 كلمة في 60 دقيقة حول موضوع تختاره، ثم صحّحها ذاتياً بشريطين: البنية (مقدمة من أربع خطوات، ثلاث فقرات، خاتمة بلا حجج جديدة) واللغة (ثلاثة أنواع من الجمل المركّبة على الأقل).","sources":[{"title":"20/20 à la dissertation de français : GUIDE ULTIME 2026","channel":"Maxime Lim","videoId":"L87HeuqvzT8","why":"دليل شامل لكتابة المقالة الفرنسية: قراءة الموضوع، بناء المشكلات، ترتيب الخطة، وصياغة المقدمة والخاتمة.","cat":"Écrit","level":"B2","main":true},{"title":"La méthodologie (simple) de la dissertation","channel":"Stud-ease","videoId":"lOARyavqJwI","why":"منهجية مبسّطة لخطوات المقالة تثبّت التسلسل الذي تعلمته في الدرس.","cat":"Écrit","level":"B2","extra":true},{"title":"Cours - Seconde - Français : Méthodologie de la dissertation","channel":"Ecoles Au Senegal","videoId":"86QbMDRzxtg","why":"درس مدرسي كامل في منهجية المقالة مع أمثلة محلولة وتقويم نموذجي.","cat":"Écrit","level":"B2","extra":true}],"supplements":[{"id":"lOARyavqJwI","title":"La méthodologie (simple) de la dissertation","channel":"Stud-ease","why":"منهجية مبسّطة لخطوات المقالة تثبّت التسلسل الذي تعلمته في الدرس.","lang":"fr","dur":12},{"id":"86QbMDRzxtg","title":"Cours - Seconde - Français : Méthodologie de la dissertation","channel":"Ecoles Au Senegal","why":"درس مدرسي كامل في منهجية المقالة مع أمثلة محلولة وتقويم نموذجي.","lang":"fr","dur":20}]},{"id":"b2-t4-l2","fr":"La synthèse de documents","ar":"تلخيص الوثائق والمستندات","objectives":["تطبيق la méthode la synthèse: قراءة، تلخيص، تنظيم، مراجعة","تمييز les idées principales عن les idées secondaires","توظيف les connecteurs la synthèse la documents","إنتاج synthèse من 250 كلمة في 45 دقيقة"],"sections":[{"h":"الدرس 2: كيف تُلخّص عدة وثائق دون فقدان المضمون","video":{"id":"lOARyavqJwI","title":"La synthèse de documents : méthode et conseils","channel":"Le français by Alex","why":"شرح la méthode la synthèse la documents: كيف تقرأ، تُنظّم، وتكتب synthèse أكاديمية في أقل من 45 دقيقة.","lang":"fr","main":true,"dur":18},"p":["la synthèse la documents ليست la résumé la plus قصيرة — بل la reconstruction la نسخة مضغوطة من les documents: تعريف، حجج، خاتمة. la méthode la cible: قراءة أولى لفهم la structure، ثانية لتحديد les idées، ثالثة للتنظيم.","معجم الدرس: la synthèse, le document, l’analyse, le résumé, la reformulation, la structure, l’introduction, le développement, la conclusion, la citation, le parallèle, le contraste. هذه المفردات تشرح mécanique la synthèse.","نحوياً، la synthèse تعتمد على la subordination la les idées: « tandis que le premier document affirme…, le second nuance… ». la grammaire la nuance متشابكتان هنا.","الدرس الأهم: la synthèse لا تتطلب la opinion — تتطلب la objectivité. la tâche: تُلخّص les documents لا تُقيّمها. la précision la reformulation ترفع la nuance la synthèse.","أكبر خطأ في la synthèse: la citation la les phrases la les documents — la reformulation la paraphrase هما la cible. la lecture la reformulation تُفقد la naturalité.","بعد الدرس: اقرأ trois documents la la même sujet، واكتب synthèse la 250 كلمة la 45 دقيقة — la pratique la précision."],"sub":[{"h":"la méthode la synthèse","p":["الخطوة الأولى: قراءة la structure la documents.","الثانية: تحديد les idées principales la secondaires.","الثالثة: التنظيم la les connecteurs."]},{"h":"les connecteurs la synthèse","p":["« tandis que » — contraste.","« par ailleurs » — addition.","« en revanche » — opposition.","« par conséquent » — conséquence."]},{"h":"خطوات la révision","p":["الخطوة الأولى: la vérification la citation.","الثانية: la reformulation la paraphrase.","الثالثة: la revue la structure."]}]},{"h":"la carte la synthèse","p":["« tandis que le premier document affirme…, le second nuance… » — contraste.","« par ailleurs, le troisième document apporte… » — addition.","« en revanche, l’étude contredit… » — opposition.","« par conséquent, la synthèse montre… » — conséquence."]},{"h":"التطبيق والتلخيص","p":["تمرين la méthode: خذ trois documents la la même sujet واكتب synthèse la 250 كلمة.","تمرين la reformulation: حوّل les phrases la documents إلى la paraphrase la votre.","سجّل نفسك تشرح la synthèse بالفرنسية لزميل: « la synthèse exige la reformulation… » — la explanation تثبّت la méthode."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: تلخيص جماع الوثائق في نصٍّ واحد منسّق؛ أعد مشاهدة الفيديو الرئيسي وركّز على طريقة الربط بين الوثائق دون نسخها حرفيًا.","جسر الدروس: من b2-t4-l1 (بناء المقالة الحجاجية من الإشكالية إلى الخاتمة) إلى b2-t4-l2 (تلخيص جماع الوثائق في نصٍّ واحد منسّق)، ثم إلى b2-t4-l3 حيث تنتقل من جمع المضمون إلى تحليل أسلوبيّ معمّق (التحليل المركّب للنص الأدبي أو الفلسفي).","مهمة تطبيقية: اكتب دقيقةً من الكتابة (نحو 100 كلمة) تلخّص فيها أهم ثلاث أفكار من هذا الدرس، واستعمل 3 كلمات جديدة من قاموسه، ثم قارن نصّك بمقتطف من الفيديو الرئيسي وحدّد الفروق."]}],"pron":[{"w":"la synthèse","ipa":"[sɛ̃.tɛz]","approx":"سينتيز"},{"w":"le document","ipa":"[dɔ.ky.mɑ̃]","approx":"دوكومن"},{"w":"la reformulation","ipa":"[ʁe.fɔʁ.my.la.sjɔ̃]","approx":"ريفورميلاسيون"}],"vocab":[{"fr":"le panorama","ar":"النظرة الشاملة على كل الوثائق","pos":"nom","g":"m","exFr":"Ce panorama des trois documents reste neutre.","ipa":"[lə pa.no.ʁa.ma]","exAr":"تبقى هذه النظرة الشاملة على الوثائق الثلاث محايدة."},{"fr":"le document","ar":"الوثيقة","pos":"nom","g":"m","exFr":"Le document est complet.","ipa":"[dɔ.ky.mɑ̃]","exAr":"الوثيقة كاملة."},{"fr":"l’analyse","ar":"التحليل","pos":"nom","g":"f","exFr":"L’analyse est détaillée.","ipa":"[a.na.liz]","exAr":"التحليل مفصّل."},{"fr":"le résumé","ar":"الملخص","pos":"nom","g":"m","exFr":"Le résumé est concis.","ipa":"[ʁe.zy.me]","exAr":"الملخص موجز."},{"fr":"la reformulation","ar":"إعادة الصياغة","pos":"nom","g":"f","exFr":"La reformulation est essentielle.","ipa":"[ʁe.fɔʁ.my.la.sjɔ̃]","exAr":"إعادة الصياغة ضرورية."},{"fr":"la structure","ar":"البنية","pos":"nom","g":"f","exFr":"La structure est logique.","ipa":"[stʁyk.tyʁ]","exAr":"البنية منطقية."},{"fr":"l’introduction","ar":"المقدمة","pos":"nom","g":"f","exFr":"L’introduction présente le sujet.","ipa":"[ɛ̃.tʁɔ.dyk.sjɔ̃]","exAr":"المقدمة تُعرّف بالموضوع."},{"fr":"le corps du texte","ar":"جسم النصّ بين المقدمة والخاتمة","pos":"nom","g":"m","exFr":"Le corps du texte analyse chaque document à tour de rôle.","ipa":"[lə koʁ dy tɛkst]","exAr":"يحلّل جسمُ النصّ كلَّ وثيقةٍ بالتناوب."},{"fr":"la clôture","ar":"خاتمة التلخيص المؤطَّرة","pos":"nom","g":"f","exFr":"La clôture rappelle le fil directeur du corpus.","ipa":"[la klɔ.tyʁ]","exAr":"تذكّر الخاتمةُ بالمحور الموجِّه لمجموعة الوثائق."},{"fr":"le parallèle","ar":"المقابلة / التوازي","pos":"nom","g":"m","exFr":"Le parallèle est utile.","ipa":"[pa.ʁa.lɛl]","exAr":"التوازي مفيد."},{"fr":"le contraste","ar":"التباين","pos":"nom","g":"m","exFr":"Le contraste est net.","ipa":"[kɔ̃.tʁast]","exAr":"التباين واضح."},{"fr":"la fibre","ar":"الحساسية الأدبية/الإخبارية","pos":"nom","g":"f","exFr":"Il articule les apports des trois documents sans les confondre.","ipa":"[aʁ.ti.ky.le]","exAr":"يربط مساهماتِ الوثائق الثلاث دون خلط بينها."}],"examples":[{"fr":"Tandis que le premier document affirme…, le second nuance…","ar":"بينما تؤكد الوثيقة الأولى…، تُفصّل الثانية…","note":"contraste"},{"fr":"Par ailleurs, le troisième document apporte…","ar":"علاوة على ذلك، تقدم الوثيقة الثالثة…","note":"addition"},{"fr":"En revanche, l’étude contredit…","ar":"في المقابل، تُناقض الدراسة…","note":"opposition"},{"fr":"Par conséquent, la synthèse montre…","ar":"لذلك، يُظهر التلخيص…","note":"conséquence"},{"fr":"La synthèse exige la reformulation.","ar":"التلخيص يتطلب إعادة الصياغة.","note":"la méthode"},{"fr":"La structure est logique.","ar":"البنية منطقية.","note":"la structure"}],"grammar":[{"tFr":"La méthode la synthèse","tAr":"طريقة التلخيص","body":["la synthèse la documents ليست la résumé la plus قصيرة — بل la reconstruction la نسخة مضغوطة: قراءة أولى لفهم la structure، ثانية لتحديد les idées، ثالثة للتنظيم.","la synthèse لا تتطلب la opinion — تتطلب la objectivité: تُلخّص les documents لا تُقيّمها."],"ex":[{"fr":"Tandis que le premier document affirme…, le second nuance…","ar":"بينما تؤكد الوثيقة الأولى…، تُفصّل الثانية…"},{"fr":"La synthèse exige la reformulation.","ar":"التلخيص يتطلب إعادة الصياغة."}]},{"tFr":"les connecteurs la synthèse","tAr":"أدوات الربط في التلخيص","body":["« tandis que » = contraste، و« par ailleurs » = addition، و« en revanche » = opposition، و« par conséquent » = conséquence.","la précision la connecteur ترفع la nuance la synthèse — la lecture la connecteur تُفقد la naturalité."],"ex":[{"fr":"Tandis que le premier document affirme…, le second nuance…","ar":"بينما تؤكد الوثيقة الأولى…، تُفصّل الثانية…"},{"fr":"Par conséquent, la synthèse montre…","ar":"لذلك، يُظهر التلخيص…"}]}],"mistakes":[{"wrong":"la citation la les phrases","right":"la reformulation la paraphrase","why":"la citation تُفقد la naturalité la synthèse."},{"wrong":"la opinion la la synthèse","right":"la objectivité la synthèse","why":"la synthèse تُلخّص لا تُقيّم."},{"wrong":"la lecture la documents la synthèse","right":"la distinction la structure la idées","why":"la lecture la synthèse تُفقد la naturalité."},{"wrong":"la reconstruction la documents","right":"la reconstruction la synthèse","why":"la synthèse la cible la reconstruction la documents."}],"dialogues":[{"title":"la méthode","ctx":"معلم يشرح la synthèse","lines":[{"who":"Prof","fr":"La synthèse exige la reformulation.","ar":"التلخيص يتطلب إعادة الصياغة."},{"who":"Élève","fr":"Et la citation ?","ar":"و الاقتباس؟"},{"who":"Prof","fr":"La citation est à éviter : reformulez.","ar":"يجب تجنّب الاقتباس: أعد الصياغة."},{"who":"Élève","fr":"D’accord, la méthode est claire.","ar":"أوكي، الطريقة واضحة."}]},{"title":"la synthèse","ctx":"استوديو أكاديمي","lines":[{"who":"Claire","fr":"La structure est logique.","ar":"البنية منطقية."},{"who":"Karim","fr":"Les connecteurs sont clairs.","ar":"أدوات الربط واضحة."},{"who":"Claire","fr":"La reformulation est précise.","ar":"إعادة الصياغة دقيقة."},{"who":"Karim","fr":"La synthèse est complète.","ar":"التلخيص كامل."}]}],"exercises":[{"t":"mcq","skill":"writing","q":"ما « la synthèse »؟","opts":["التلخيص / التوليف","التحليل","الاقتباس","التقييم"],"a":0,"why":"la synthèse = التلخيص / التوليف."},{"t":"fill","skill":"grammar","q":"أكمل: «La synthèse exige la ___.»","fr":"La synthèse exige la ___.","ans":"reformulation","why":"la reformulation la cible la synthèse."},{"t":"mcq","skill":"writing","q":"ما « en revanche »؟","opts":["التباين","الإضافة","النتيجة","المقارنة"],"a":0,"why":"en revanche = la opposition."},{"t":"order","skill":"writing","q":"رتّب: التلخيص يتطلب إعادة الصياغة","words":["La","synthèse","exige","la","reformulation."],"ans":"La synthèse exige la reformulation.","why":"la méthode la synthèse."},{"t":"listen","skill":"listening","q":"ما « tandis que »؟","opts":["contraste","addition","conséquence","opposition"],"a":0,"why":"tandis que = le contraste."},{"t":"translate","skill":"writing","q":"ترجم: «البنية منطقية.»","ans":"La structure est logique.","why":"la structure la synthèse."},{"t":"speaking","skill":"speaking","q":"اشرح la méthode la synthèse بالفرنسية لزميلك.","target":"synthèse / reformulation / structure","why":"la méthode la synthèse."},{"t":"correct","skill":"grammar","q":"صحّح: «Je cite les phrases des documents.»","ans":"Je reformule les phrases des documents.","why":"la citation est à éviter dans la synthèse."}],"homework":"اقرأ trois documents la la même sujet، واكتب synthèse la 250 كلمة la 45 دقيقة مع les connecteurs la synthèse.","sources":[{"title":"La synthèse de documents : méthode et conseils","channel":"Le français by Alex","videoId":"lOARyavqJwI","why":"شرح la méthode la synthèse la documents: كيف تقرأ، تُنظّم، وتكتب synthèse أكاديمية في أقل من 45 دقيقة.","cat":"Académique","level":"B2","main":true},{"title":"La synthèse : méthode et exemples","channel":"Le français by Alex","videoId":"dEnQwaXT1sk","why":"شرح la méthode la synthèse la documents مع أمثلة تطبيقية.","cat":"Académique","level":"B2","extra":true},{"title":"Écrire une synthèse réussie","channel":"Français Authentique","videoId":"IQs2-izz4aM","why":"كيف تكتب synthèse أكاديمية في أقل من 45 دقيقة.","cat":"Académique","level":"B2","extra":true}],"supplements":[{"id":"dEnQwaXT1sk","title":"La synthèse : méthode et exemples","channel":"Le français by Alex","why":"شرح la méthode la synthèse la documents مع أمثلة تطبيقية.","lang":"fr","dur":16},{"id":"IQs2-izz4aM","title":"Écrire une synthèse réussie","channel":"Français Authentique","why":"كيف تكتب synthèse أكاديمية في أقل من 45 دقيقة.","lang":"fr","dur":15}]},{"id":"b2-t4-l3","fr":"Le commentaire composé","ar":"التعليق المُركَّب والمحلّل","objectives":["تطبيق la méthode le commentaire le composé: observation, analyse, interprétation","تمييز les procédés stylistiques: figures, ton, rythme, registre","توظيف le vocabulaire l’analyse littéraire","produire commentaire de 300 كلمة بـ une problématique claire"],"sections":[{"h":"الدرس 3: كيف تحلّل نصاً أدبياً أو فلسفياً بعمق","video":{"id":"86QbMDRzxtg","title":"Le commentaire composé : méthode complète","channel":"Le français by Alex","why":"شرح la méthode le commentaire le composé: كيف تقرأ le texte، تكتشف les procédés، وتكتب commentaire محكّم في 45 دقيقة.","lang":"fr","main":true,"dur":19},"p":["le commentaire le composé n’est pas le résumé ni l’opinion — c’est l’analyse organisée d’un texte: ce que le texte dit (thème), comment il le dit (procédés), et pourquoi il le dit ainsi (effet sur le lecteur). la méthode la cible: observation → analyse → interprétation.","le vocabulaire le commentaire: le procédé, la figure de style, la tonalité, le registre, la perspective, l’énonciation, la connotation, la dénotation, l’implicite, l’effet de sens, la construction, la progression. Ce lexique structure votre regard.","Sur le plan grammatical, le commentaire s’appuie sur les temps, les modes, les types de phrases et la subordination: l’impératif pour l’adresse, le conditionnel pour l’atténuation, le subjonctif pour le doute, la négation pour la force du déni. Chaque choix grammatical est un effet.","Le point décisif: éviter le catalogue. Une figure de style n’est pas nommée pour être nommée — elle est montrée dans son contexte puis interprétée: quelle image crée-t-elle ? Quel effet produit-elle sur le lecteur ? Quel lien avec le thème ?","La problématique est la clé de voûte: une question précise qui relie thème et procédés (« Comment le poète transforme-t-il la douleur en émotion partagée ? »). Sans problématique, le commentaire devient une liste d’observations.","Après l’étude: rédigez un commentaire de 300 mots sur un texte de votre choix en respectant la progression Introduction (accroche + problématique + annonce) → Analyse (2-3 axes) → Conclusion (ouverture)."],"sub":[{"h":"La méthode en trois temps","p":["Observer: repérer les procédés sans les interpréter trop tôt.","Analyser: montrer comment le procédé fonctionne dans la phrase.","Interpréter: relier l’effet au thème et à l’intention de l’auteur."]},{"h":"Les procédés à maîtriser","p":["Les figures: métaphore, comparaison, antithèse, gradation.","La tonalité: ironie, gravité, tendresse, polémique.","La construction: parallélisme, anaphore, suspense."]},{"h":"La progression du commentaire","p":["Introduction: accroche, problématique, annonce des axes.","Développement: 2 ou 3 axes thématiques argumentés.","Conclusion: bilan et ouverture sans résumé."]}]},{"h":"Les formules maîtresses du commentaire","p":["« Ce passage suggère que… » — entrer par l’implicite.","« Le procédé produit un effet de… » — relier forme et sens.","« On note une progression de… à… » — montrer la dynamique du texte.","« Cette image révèle… » — interpréter sans imposer."]},{"h":"التطبيق والتلخيص","p":["Entraînement à l’observation: choisissez un extrait de 10 lignes, repérez trois procédés, décrivez-les sans les interpréter.","Entraînement à l’interprétation: pour chaque procédé, écrivez l’effet sur le lecteur et le lien avec le thème.","Rédigez un commentaire complet de 300 mots avec une problématique unique et deux axes d’analyse."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: التحليل المركّب للنص الأدبي أو الفلسفي؛ أعد مشاهدة الفيديو الرئيسي وركّز على الحركة من الوصف إلى التحليل ثم إلى الحكم.","جسر الدروس: من b2-t4-l2 (تلخيص جماع الوثائق في نصٍّ واحد منسّق) إلى b2-t4-l3 (التحليل المركّب للنص الأدبي أو الفلسفي)، ثم إلى b2-t4-l4 حيث تنتقل من التحليل الحرّ إلى الاقتباس المُوثَّق (الاقتباس والإحالة الأكاديمية الصحيحة).","مهمة تطبيقية: سجّل صوتك في دقيقةٍ واحدة تلخّص فيها أهم ثلاث أفكار من هذا الدرس، واستعمل 3 كلمات جديدة من قاموسه، ثم قارن أدائك بمقتطف من الفيديو الرئيسي وحدّد الفروق."]}],"pron":[{"w":"commentaire","ipa":"[kɔ̃.mɑ̃.tɛʁ]","approx":"كومونتير"},{"w":"procédé","ipa":"[pʁɔ.se.de]","approx":"بروسيد"},{"w":"tonalité","ipa":"[tɔ.na.li.te]","approx":"توناليتي"}],"vocab":[{"fr":"le commentaire","ar":"التعليق التحليلي","pos":"nom","g":"m","exFr":"Le commentaire exige une problématique.","ipa":"[kɔ̃.mɑ̃.tɛʁ]","exAr":"التعليق التحليلي يتطلب مسألة محورية."},{"fr":"le procédé","ar":"الأسلوب / الحيلة الفنية","pos":"nom","g":"m","exFr":"Ce procédé crée un effet de surprise.","ipa":"[pʁɔ.se.de]","exAr":"هذا الأسلوب يُحدث مفاجأة."},{"fr":"la figure de style","ar":"الصورة الأدبية","pos":"nom","g":"f","exFr":"La métaphore est une figure de style.","ipa":"[fi.ɡyʁ də stil]","exAr":"الاستعارة صورة أدبية."},{"fr":"la tonalité","ar":"النبرة / الطابع","pos":"nom","g":"f","exFr":"La tonalité est ironique.","ipa":"[tɔ.na.li.te]","exAr":"النبرة ساخرة."},{"fr":"l’atmosphère","ar":"الأجواء السائدة في النص","pos":"nom","g":"f","exFr":"L’atmosphère du texte est franchement mélancolique.","ipa":"[lat.mɔs.fɛʁ]","exAr":"أجواءُ النصّ حزينةُ المزاج صراحةً."},{"fr":"l’énonciation","ar":"السطورة / من يتكلم","pos":"nom","g":"f","exFr":"L’énonciation est complexe.","ipa":"[e.nɔ̃.sja.sjɔ̃]","exAr":"السطورة معقدة."},{"fr":"la connotation","ar":"الدلالة الضمنية","pos":"nom","g":"f","exFr":"La connotation est négative.","ipa":"[kɔ.nɔ.ta.sjɔ̃]","exAr":"الدلالة الضمنية سلبية."},{"fr":"la dénotation","ar":"الدلالة الصريحة","pos":"nom","g":"f","exFr":"La dénotation est neutre.","ipa":"[de.nɔ.ta.sjɔ̃]","exAr":"الدلالة الصريحة محايدة."},{"fr":"le questionnement","ar":"التساؤل الموجَّه نحو النص","pos":"nom","g":"m","exFr":"Le questionnement guidant le commentaire doit rester cohérent.","ipa":"[lə kɛ.sjɔn.mɑ̃]","exAr":"يجب أن يبقى التساؤلُ الموجِّهُ للتحليل متماسكاً."},{"fr":"la progression","ar":"التدرّج / التطور","pos":"nom","g":"f","exFr":"La progression est logique.","ipa":"[pʁɔ.ɡʁɛ.sjɔ̃]","exAr":"التدرّج منطقي."},{"fr":"analyser","ar":"يحلّل","pos":"verbe","g":"","exFr":"Il faut analyser le texte.","ipa":"[a.na.li.ze]","exAr":"يجب تحليل النص."},{"fr":"interpréter","ar":"يُفسّر","pos":"verbe","g":"","exFr":"On interprète l’effet du procédé.","ipa":"[ɛ̃. tɛʁ.pʁe.te]","exAr":"نُفسّر أثر الأسلوب."}],"examples":[{"fr":"Ce passage suggère une mélancolie profonde.","ar":"هذا المقطع يُلمّح إلى حزن عميق.","note":"implicite"},{"fr":"La métaphore filée crée un effet d’unité.","ar":"الاستعارة الممتدة تُحدث أثر التماسك.","note":"figure de style"},{"fr":"On note une progression du doute à la certitude.","ar":"لاحظ تدرّجاً من الشك إلى اليقين.","note":"progression"},{"fr":"La tonalité est ironique dès la première phrase.","ar":"النبرة ساخرة منذ الجملة الأولى.","note":"tonalité"},{"fr":"Le conditionnel atténue la critique.","ar":"شرطية تُخفّف الانتقاد.","note":"grammaire"},{"fr":"La problématique relie thème et procédés.","ar":"المسألة المحورية تربط الموضوع ب الأساليب.","note":"méthode"}],"grammar":[{"tFr":"La progression du commentaire","tAr":"تدرّج التعليق المُركَّب","body":["Introduction: accroche + problématique + annonce des axes. Développement: 2 ou 3 axes thématiques argumentés avec citations courtes. Conclusion: bilan + ouverture sans résumé.","Chaque axe suit la même micro-structure: affirmation → citation → analyse du procédé → interprétation → transition."],"ex":[{"fr":"Affirmation → citation → analyse → interprétation.","ar":"تأكيد → اقتباس → تحليل → تفسير."},{"fr":"La problématique guide tout le commentaire.","ar":"المسألة المحورية توجّه التعليق كله."}]},{"tFr":"Grammaire et effets de sens","tAr":"النحو وآثار المعنى","body":["L’impératif pour l’adresse directe, le conditionnel pour l’atténuation, le subjonctif pour le doute ou le souhait, la négation pour le déni fort. Chaque choix grammatical est un effet.","Les temps aussi portent sens: le passé simple pour la distance épique, l’imparfait pour la description, le présent d’énonciation pour l’immédiateté."],"ex":[{"fr":"Le conditionnel atténue la critique.","ar":"الشرطية تُخفّف الانتقاد."},{"fr":"Le passé simple crée la distance épique.","ar":"الماضي البسيط يُنشئ المسافة الملحمية."}]}],"mistakes":[{"wrong":"Le résumé du texte à la place de l’analyse","right":"l’analyse des procédés et de leurs effets","why":"Le commentaire explique le comment et le pourquoi, pas le quoi."},{"wrong":"Le catalogue de figures sans interprétation","right":"figure + effet + lien avec le thème","why":"Une figure nommée mais non interprétée n’apporte rien."},{"wrong":"L’opinion personnelle (« j’aime… »)","right":"l’objectivité analytique appuyée sur le texte","why":"Le commentaire porte sur le texte, pas sur vous."},{"wrong":"L’absence de problématique","right":"une question précise qui structure tout","why":"Sans problématique, le commentaire devient une liste."}],"dialogues":[{"title":"la méthode","ctx":"séminaire de commentaire","lines":[{"who":"Prof","fr":"Quelle est la problématique de votre commentaire ?","ar":"ما هي المسألة المحورية في تعليقك؟"},{"who":"Élève","fr":"Comment le poète transforme-t-il la douleur en émotion ?","ar":"كيف يحوّل الشاعر الألم إلى عاطفة؟"},{"who":"Prof","fr":"Parfait. Trouvez deux axes pour y répondre.","ar":"ممتاز. ابحث عن محورين للإجابة."},{"who":"Élève","fr":"Les figures d’abord, la progression ensuite.","ar":"الصور أولاً، التدرّج ثانياً."}]},{"title":"l’analyse","ctx":"atelier d’écriture","lines":[{"who":"Claire","fr":"La métaphore filée unit tout le poème.","ar":"الاستعارة الممتدة توحّد القصيدة كلها."},{"who":"Karim","fr":"Et l’effet sur le lecteur ?","ar":"والأثر على القارئ؟"},{"who":"Claire","fr":"Une impression d’enfermement progressif.","ar":"انطباع بالانحصار التدريجي."},{"who":"Karim","fr":"Reliez-le au thème de la solitude.","ar":"اربطه بموضوع الوحدة."}]}],"exercises":[{"t":"mcq","skill":"analysis","q":"ما « la problématique » في le commentaire ?","opts":["المسألة المحورية","الخلاصة","الاقتباس","التقييم"],"a":0,"why":"la problématique هي السؤال الذي يوجّه التعليق كله."},{"t":"fill","skill":"analysis","q":"أكمل: «___ → citation → analyse → interprétation.»","fr":"___ → citation → analyse → interprétation.","ans":"Affirmation","why":"la micro-structure de chaque axe."},{"t":"mcq","skill":"analysis","q":"ما « la connotation »؟","opts":["الدلالة الضمنية","الدلالة الصريحة","البنية","النبرة"],"a":0,"why":"la connotation = دلالة ضمنية تُضيف طبقة معنى."},{"t":"order","skill":"writing","q":"رتّب: مسألة محورية توجّه التعليق كله","words":["La","problématique","guide","tout","le","commentaire."],"ans":"La problématique guide tout le commentaire.","why":"la clé de voûte du commentaire."},{"t":"listen","skill":"analysis","q":"ما « le conditionnel » في le commentaire ?","opts":["atténuation","doute","adresse","déni"],"a":0,"why":"le conditionnel sert à atténuer la critique."},{"t":"translate","skill":"writing","q":"ترجم: «الاستعارة الممتدة تُحدث أثر التماسك.»","ans":"La métaphore filée crée un effet d’unité.","why":"figure + effet."},{"t":"speaking","skill":"speaking","q":"Présentez la problématique de votre commentaire en une minute.","target":"problématique / axes / procédés","why":"la méthode du commentaire."},{"t":"correct","skill":"analysis","q":"صحّح: «J’aime beaucoup ce poème, il est beau.»","ans":"Ce poème unit douleur et espoir par une métaphore filée.","why":"Le commentaire analyse, il n’exprime pas une préférence."}],"homework":"Choisissez un extrait de 15 lignes, écrivez un commentaire de 300 mots avec problématique, deux axes et une ouverture.","sources":[{"title":"Le commentaire composé : méthode complète","channel":"Le français by Alex","videoId":"86QbMDRzxtg","why":"شرح la méthode le commentaire le composé: كيف تقرأ le texte، تكتشف les procédés، وتكتب commentaire محكّم في 45 دقيقة.","cat":"Académique","level":"B2","main":true},{"title":"Méthode du commentaire composé","channel":"Le français by Alex","videoId":"QhysP1PazZA","why":"méthode complète avec exemples corrigés et progressions types.","cat":"Académique","level":"B2","extra":true},{"title":"Figures de style : les essentielles","channel":"Français Authentique","videoId":"DQzyDJxYrZw","why":"figures de style avec effets de sens pour analyser un texte.","cat":"Académique","level":"B2","extra":true}],"supplements":[{"id":"QhysP1PazZA","title":"Méthode du commentaire composé","channel":"Le français by Alex","why":"méthode complète avec exemples corrigés et progressions types.","lang":"fr","dur":17},{"id":"DQzyDJxYrZw","title":"Figures de style : les essentielles","channel":"Français Authentique","why":"figures de style avec effets de sens pour analyser un texte.","lang":"fr","dur":14}]},{"id":"b2-t4-l4","fr":"La citation et le renvoi","ar":"الاقتباس والإحالة في النص الأكاديمي","objectives":["تمييز la citation directe عن la paraphrase عن le résumé","تطبيق la règle des guillemets et de la source entre parenthèses","صياغة le renvoi: (Auteur, Année, p. numéro)","إعادة صياغة فكرة دون فقدان la précision et sans plagiat"],"sections":[{"h":"الدرس 4: كيف تقتبس وتستشهد دون أن تقع في Plagiat","video":{"id":"oVIc7T_RLRI","title":"Citer, paraphraser, référencer : éviter le plagiat","channel":"Le français by Alex","why":"شرح les trois gestes académiques: la citation directe، la paraphrase، la référence — ومتى يُعدّ le recopiage plagiat.","lang":"fr","main":true,"dur":15},"p":["la citation في le travail académique الفرنسي ليست زينة بل دليل: elle prouve que vous avez lu، et elle permet au lecteur de vérifier. la règle: كل فكرة ليست la vôtre تُنسب — أو par la citation أو par la paraphrase مع la référence.","معجم الدرس: la citation, la paraphrase, la référence, la source, le renvoi, la note de bas de page, le plagiat, l’extrait, l’auteur, l’année, la page, la bibliographie, le corpus. هذه المفردات تبني votre apparatus.","نحوياً، la citation تحتفظ بـ la phrase الأصلية مع les guillemets et le point-virgule: « Il écrit : « la langue est un instrument. » (Martin, 2020, p. 45). » la paraphrase تغيّر la forme: le subjonctif ou le discours indirect تدخلان la distance.","le renvoi هو le code: (Auteur, Année) dans le texte، ثم la référence complète في la bibliographie. بدون le renvoi تصبح la citation بلا source — وle lecteur لا يمكنه la vérification.","الدرس الأهم: la paraphrase ليست la réécriture mot à mot. أن تغيّر les trois premiers mots فقط plagiat — la vraie paraphrase تغيّر la structure (passif ↔ actif، nominalisation ↔ verbe) وتحافظ على le sens.","بعد الدرس: خذ ثلاثة جمل من un article علمي، اكتب la citation ثم la paraphrase ثم le résumé لكل واحدة — مع la référence في les trois cas."],"sub":[{"h":"les trois gestes","p":["Citer : reprendre les mots exacts entre guillemets.","Paraphraser : reformuler avec vos propres mots.","Référencer : indiquer la source, toujours."]},{"h":"أدوات نطقية: le renvoi","p":["« Selon Martin (2020)… » [səlɔ̃ maʁ.tɛ̃] — la source dans le texte.","« Comme le montre l’étude de… » — l’appel à l’autorité.","« Il convient de nuancer ce point. » — la distance académique."]},{"h":"خطوات la reformulation","p":["الخطوة الأولى: اقرأ la phrase وحدّد le noyau.","الثانية: غيّر la structure لا les mots.","الثالثة: أضف la référence ثم قارن le sens."]}]},{"h":"formules de citation","p":["« Selon l’auteur… » = وفقاً للكاتب — la référence la plus courante.","« L’étude montre que… » — la source devient le sujet de la phrase.","« On peut lire dans cet ouvrage que… » — l’appel au texte.","« Cette idée mérite d’être nuancée. » — la distance avant la critique."]},{"h":"التطبيق والتلخيص","p":["تمرين la citation: اقتبس جملة واحدة مع les guillemets et (Auteur, Année, p. n°) ثم اقرأها بصوت عالٍ.","تمرين la paraphrase: حوّل la même phrase إلى le discours indirect مع la référence — بدون les mêmes trois mots.","سجّل شرحاً شفهياً من 45 ثانية لفكرة من un article، باستعمال « Selon… » ثم « Cela signifie que… »."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: الاقتباس والإحالة الأكاديمية الصحيحة؛ أعد مشاهدة الفيديو الرئيسي وركّز على وضع علامات الاقتباس وفهرسة المصادر.","جسر الدروس: من b2-t4-l3 (التحليل المركّب للنص الأدبي أو الفلسفي) إلى b2-t4-l4 (الاقتباس والإحالة الأكاديمية الصحيحة)، ثم إلى b2-t4-l5 حيث تنتقل من الاقتباس المفصّل إلى الاختزال في ملخّص واحد (اختزال النص الكامل في ملخّص متماسك).","مهمة تطبيقية: اكتب دقيقةً من الكتابة (نحو 100 كلمة) تلخّص فيها أهم ثلاث أفكار من هذا الدرس، واستعمل 3 كلمات جديدة من قاموسه، ثم قارن نصّك بمقتطف من الفيديو الرئيسي وحدّد الفروق."]}],"pron":[{"w":"la citation","ipa":"[la si.ta.sjɔ̃]","approx":"لا سيتاسيون"},{"w":"la paraphrase","ipa":"[la pa.ʁa.fʁaz]","approx":"لا بارافراز"},{"w":"le plagiat","ipa":"[lə pla.ʒja]","approx":"لو بلاجيا"}],"vocab":[{"fr":"l’extrait","ar":"المقطع المقتبس من نص","pos":"nom","g":"m","exFr":"L’extrait est mis entre guillemets et systématiquement sourcé.","ipa":"[lɛk.stʁɛ]","exAr":"يأتي المقطعُ المقتبس بين علامتَي تنصيص ويُوثَّق دائماً."},{"fr":"la paraphrase","ar":"الإعادة الصياغية","pos":"nom","g":"f","exFr":"La paraphrase évite le copier-coller.","ipa":"[pa.ʁa.fʁaz]","exAr":"الإعادة الصياغية تجنّب النسخ."},{"fr":"la référence","ar":"المرجعية","pos":"nom","g":"f","exFr":"La référence complète figure en bibliographie.","ipa":"[ʁe.fʁɑ̃s]","exAr":"المرجع الكامل في قائمة المراجع."},{"fr":"la bibliographie","ar":"قائمة المراجع والمصادر","pos":"nom","g":"f","exFr":"La bibliographie complète et vérifie la citation.","ipa":"[la bi.bli.ɔ.ɡʁa.fi]","exAr":"تكمل قائمةُ المراجع الاقتباس وتوثّقه."},{"fr":"le renvoi","ar":"الإحالة / الإشارة","pos":"nom","g":"m","exFr":"Le renvoi renvoie à la page vingt.","ipa":"[lə ʁɑ̃.vwa]","exAr":"الإحالة تشير إلى الصفحة العشرين."},{"fr":"la note de bas de page","ar":"حاشية الصفحة","pos":"nom","g":"f","exFr":"La note développe l’argument.","ipa":"[nɔt də ba də pɛʒ]","exAr":"الحاشية توسّع الحجّة."},{"fr":"le plagiat","ar":"الانتحال","pos":"nom","g":"m","exFr":"Le plagiat est une faute grave.","ipa":"[pla.ʒja]","exAr":"الانتحال خطأ جسيم."},{"fr":"le corpus","ar":"المجموعة النصية","pos":"nom","g":"m","exFr":"Le corpus compte dix textes.","ipa":"[kɔʁ.pys]","exAr":"المجموعة النصية تضم عشرة نصوص."},{"fr":"citer","ar":"يقتبس","pos":"verbe","g":"","exFr":"Il cite trois auteurs.","ipa":"[si.te]","exAr":"يقتبس ثلاثة مؤلفين."},{"fr":"paraphraser","ar":"يعيد الصياغة دون اقتباس حرفي","pos":"verbe","g":"","exFr":"Il faut paraphraser l’auteur au lieu de le citer mot à mot.","ipa":"[pa.ʁa.fʁa.ze]","exAr":"يجب إعادة صياغة المؤلف بدل اقتباسه حرفاً بحرف."},{"fr":"renvoyer à","ar":"يحيل إلى","pos":"loc.","g":"","exFr":"Ce paragraphe renvoie à la page dix.","ipa":"","exAr":"هذه الفقرة تحيل إلى الصفحة العاشرة."},{"fr":"attribuer à","ar":"ينسب إلى","pos":"loc.","g":"","exFr":"On attribue cette thèse à Durkheim.","ipa":"","exAr":"تنسب هذه الأطروحة إلى دوركايم."}],"examples":[{"fr":"Selon Martin (2020), la langue est un instrument.","ar":"وفق مارتن (2020)، اللغة أداة.","note":"la référence"},{"fr":"« La langue est un instrument. » (Martin, 2020, p. 45)","ar":"«اللغة أداة.» (مارتن، 2020، ص 45)","note":"la citation"},{"fr":"L’auteur montre que la norme évolue.","ar":"يُظهر المؤلف أن المعيار يتطور.","note":"la paraphrase"},{"fr":"Il convient de nuancer cette affirmation.","ar":"يجب إدخال تمييز إلى هذا الادّعاء.","note":"la distance"},{"fr":"Cette idée renvoie à un débat ancien.","ar":"هذه الفكرة تحيل إلى نقاش قديم.","note":"le renvoi"},{"fr":"Copier sans référence constitue un plagiat.","ar":"النسخ بلا مرجع يُعدّ انتحالاً.","note":"la règle"}],"grammar":[{"tFr":"La citation entre guillemets et le point-virgule","tAr":"الاقتباس بين علامتي التنصيص","body":["في le texte français: la citation complète تأتي entre guillemets مع le point-virgule قبلها et la référence entre parenthèses بعدها: « Il écrit : « la langue est un instrument. » (Martin, 2020, p. 45). »","la citation partielle تدمج في la phrase بـ le mot introducteur: « Selon l’auteur, « la langue évolue ». » — la ponctuation تتبع le sens لا l’habitude."],"ex":[{"fr":"Il affirme : « le débat reste ouvert. » (Durand, 2019, p. 12).","ar":"يؤكد: «النقاش يبقى مفتوحاً.» (دوران، 2019، ص 12)."},{"fr":"Selon l’auteur, « la norme évolue ».","ar":"وفق المؤلف، «المعيار يتطور»."}]},{"tFr":"La paraphrase : changer la structure, pas les mots","tAr":"الإعادة الصياغية: غيّر البنية لا الكلمات","body":["la vraie paraphrase تغيّr la structure: le passif يصبح actif، la nominalisation تصبح verbe، la subordonnée تصبح le groupe nominal. les trois premiers mots لا يبقى كما هو.","le discours indirect la plus propre: « Il écrit que… »، « Selon lui… »، « L’auteur soutient que… » — مع la référence في le texte."],"ex":[{"fr":"Le texte original : « L’école exclut les faibles. »","ar":"النص الأصلي: «المدرسة تستبعد الضعفاء.»"},{"fr":"La paraphrase : Selon l’auteur, ce sont les élèves en difficulté qui sont écartés. (Martin, 2020)","ar":"الإعادة: وفق المؤلف، إنهم الطلاب في وضعية صعوبة الذين يُقصون. (مارتن، 2020)"}]}],"mistakes":[{"wrong":"الاقتباس بلا guillemets","right":"guillemets + source entre parenthèses","why":"بدون les guillemets يبدو la citation كلامك أنت."},{"wrong":"la paraphrase مع تغيير les trois premiers mots فقط","right":"la changement de la structure entière","why":"هذا plagiat مُقنَّع."},{"wrong":"la référence في la bibliographie فقط","right":"la référence dans le texte à chaque fois","why":"le lecteur لا يستطيع la vérification."},{"wrong":"la citation longue بلا analyse","right":"citation brève + analyse personnelle","why":"la citation تدعم la vôtre لا تحلّ محلّها."}],"dialogues":[{"title":"مراجعة أكاديمية","ctx":"أستاذ مع طالب","lines":[{"who":"Prof","fr":"Cette phrase vient d’où ?","ar":"من أين جاءت هذه الجملة؟"},{"who":"Élève","fr":"D’un article, mais je n’ai pas mis la référence.","ar":"من مقال، لكنني لم أضع المرجع."},{"who":"Prof","fr":"Alors c’est un plagiat, même sans intention.","ar":"إذن هو انتحال، حتى دون قصد."},{"who":"Élève","fr":"Je vais ajouter la citation et le renvoi.","ar":"سأضيف الاقتباس والإحالة."}]},{"title":"atelier de paraphrase","ctx":"ورشة الكتابة","lines":[{"who":"Claire","fr":"Ma paraphrase garde les mêmes mots.","ar":"إعادتي للصياغة تحتفظ بالكلمات نفسها."},{"who":"Karim","fr":"Change la structure : passe du passif à l’actif.","ar":"غيّر البنية: انتقل من المبني للمجهول إلى الفاعل."},{"who":"Claire","fr":"Par exemple : « l’exclusion vient de l’école ».","ar":"مثلاً: «الإقصاء يأتي من المدرسة»."},{"who":"Karim","fr":"Parfait, et garde la référence.","ar":"ممتاز، واحتفظ بالمرجع."}]}],"exercises":[{"t":"mcq","skill":"analysis","q":"ما la différence بين la citation و la paraphrase ?","opts":["الكلمات الدقيقة مع مصدر vs إعادة الصياغة","النص الكامل vs العنوان","le style vs le sujet","la longueur vs la source"],"a":0,"why":"la citation تعيد les mots، la paraphrase تعيد la structure."},{"t":"fill","skill":"grammar","q":"أكمل: «___ l’auteur, la norme évolue.»","fr":"___ l’auteur, la norme évolue.","ans":"Selon","why":"selon + source = la référence."},{"t":"mcq","skill":"analysis","q":"أي وضع هو plagiat ?","opts":["تغيير les trois premiers mots فقط","إعادة الصياغة مع la référence","الاقتباس بين guillemets","la note de bas de page"],"a":0,"why":"la réécriture superficielle تبقى plagiat."},{"t":"order","skill":"writing","q":"رتّب: وفق مارتن، اللغة أداة (2020)","words":["Selon","Martin,","la","langue","est","un","instrument","(2020)."],"ans":"Selon Martin, la langue est un instrument (2020).","why":"la référence dans le texte."},{"t":"listen","skill":"listening","q":"ما le renvoi ?","opts":["الإشارة إلى la source في le texte","العنوان","الخاتمة","la bibliographie وحدها"],"a":0,"why":"le renvoi relie la phrase à la source."},{"t":"translate","skill":"writing","q":"ترجم: يجب إدخال تمييز إلى هذا الادّعاء.","ans":"Il convient de nuancer cette affirmation.","why":"la distance académique."},{"t":"speaking","skill":"speaking","q":"اشرح فكرة من مقال في 45 ثانية بـ « Selon… » ثم « Cela signifie que… ».","target":"Selon l’auteur… / Cela signifie que… / Cela renvoie à…","why":"la citation orale."},{"t":"correct","skill":"analysis","q":"صحّح: «L’auteur dit que la langue évolue, c’est mon idée.»","ans":"Selon l’auteur (Martin, 2020), la langue évolue.","why":"la source doit être attribuée."}],"homework":"خذ ثلاثة جمل من un article علمي واكتب لكل واحدة: la citation، ثم la paraphrase، ثم le résumé — مع la référence في les trois cas.","sources":[{"title":"Citer, paraphraser, référencer : éviter le plagiat","channel":"Le français by Alex","videoId":"oVIc7T_RLRI","why":"شرح les trois gestes académiques: la citation directe، la paraphrase، la référence — ومتى يُعدّ le recopiage plagiat.","cat":"Académique","level":"B2","main":true},{"title":"La synthèse : méthode et exemples","channel":"Le français by Alex","videoId":"dEnQwaXT1sk","why":"méthode de la reformulation et du renvoi entre les documents.","cat":"Académique","level":"B2","extra":true},{"title":"Écrire une synthèse réussie","channel":"Français Authentique","videoId":"IQs2-izz4aM","why":"résumer sans plagier : la même discipline de citation.","cat":"Académique","level":"B2","extra":true}],"supplements":[{"id":"dEnQwaXT1sk","title":"La synthèse : méthode et exemples","channel":"Le français by Alex","why":"méthode de la reformulation et du renvoi entre les documents.","lang":"fr","dur":16},{"id":"IQs2-izz4aM","title":"Écrire une synthèse réussie","channel":"Français Authentique","why":"résumer sans plagier : la même discipline de citation.","lang":"fr","dur":15}]},{"id":"b2-t4-l5","fr":"L’abstract et le résumé","ar":"الملخّص والمستخلص الأكاديمي","objectives":["تمييز le résumé عن l’abstract عن la conclusion","تطبيق la méthode: sélectionner les idées principales et les relier","الحفاظ sur la proportion: problème, méthode, résultat, portée","صياغة 200 كلمة بلا nom propre ولا citation"],"sections":[{"h":"الدرس 5: كيف تلخّص نصاً كاملاً في 200 كلمة دون فقدان المضمون","video":{"id":"DQzyDJxYrZw","title":"Écrire un résumé et un abstract efficaces","channel":"Français Authentique","why":"شرح la différence entre le résumé français و l’abstract international، مع la méthode: identifier، hiérarchiser، reformuler، vérifier.","lang":"fr","main":true,"dur":12},"p":["le résumé académique يجيب على أربعة أسئلة فقط: quel problème ? quelle méthode ? quel résultat ? quelle portée ? كل جملة خارج هذه الأربعة تُحذف — la discipline هي le cœur de la tâche.","معجم الدرس: le résumé, l’abstract, la problématique, l’hypothèse, la méthode, le résultat, la conclusion, la portée, hiérarchiser, condenser, reformuler, l’essentiel, la trame, le fil directeur. هذه المفردات تبني votre squelette.","نحوياً، le résumé يحب la nominalisation لتقليل la longueur: « l’augmentation de la population » بدل « la population augmente »، et le présent de vérité pour les résultats: « L’étude montre que… ».","la structure en quatre temps est immuable: 1) le contexte et la question، 2) la démarche، 3) les résultats clés، 4) l’apport. l’abstract يضيف parfois une phrase sur les limites.","الدرس الأهم: le résumé لا يُكتب أولاً — يُكتب آخراً. أن تلخّص نصاً لم تُنهِ قراءته يعني أن تلخّص انطباعك لا نصّه.","بعد الدرس: خذ un article من 2000 كلمة، اكتب abstract من 200 كلمة، ثم احذف les mots faibles: très, vraiment, environ, semble — ولا تفقد معنى واحداً."],"sub":[{"h":"la structure en quatre temps","p":["Le problème : quelle question le texte traite-t-il ?","La méthode : comment l’auteur a-t-il procédé ?","Le résultat : que révèle l’analyse ?"]},{"h":"أدوات نطقية: la densité","p":["« L’étude montre que… » [etyd mɔ̃tʁ kə] — le présent de vérité.","« Contrairement à ce qu’on pense… » — le contraste condensé.","« Ces résultats permettent de… » — la portée."]},{"h":"خطوات la rédaction","p":["الخطوة الأولى: relever les phrases-thèses de chaque partie.","الثانية: relier les thèses في paragraphe واحد.","الثالثة: compter les mots et couper le superflu."]}]},{"h":"formules de résumé","p":["« Ce texte analyse… » = يحلّل هذا النص… — l’ouverture neutre.","« L’auteur s’interroge sur… » — la question avant la réponse.","« L’analyse aboutit à la conclusion que… » — le résultat sans commentaire.","« L’apport de cette démarche est de… » = إسهام هذه المقاربة… — la portée."]},{"h":"التطبيق والتلخيص","p":["تمرين la sélection: اقرأ ورقة محكّمة وضع شرطاً أمام les phrases qui portent la thèse فقط.","تمرين la condensation: خمس جمل فرنسية حوّلها إلى جملتين مع la même information.","سجّل abstract من 30 ثانية بصوت عالٍ: هل يبقى le fil directeur مفهوماً دون le texte الكامل؟"]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: اختزال النص الكامل في ملخّص متماسك؛ أعد مشاهدة الفيديو الرئيسي وركّز على ترتيب الأولويات وحذف التفاصيل الثانوية.","جسر الدروس: من b2-t4-l4 (الاقتباس والإحالة الأكاديمية الصحيحة) إلى b2-t4-l5 (اختزال النص الكامل في ملخّص متماسك)، ثم إلى b2-t4-l6 حيث تنتقل من الاختزال إلى صقل الأسلوب الأكاديمي (كتابة أكاديمية رصينة وموضوعية).","مهمة تطبيقية: اكتب دقيقةً من الكتابة (نحو 100 كلمة) تلخّص فيها أهم ثلاث أفكار من هذا الدرس، واستعمل 3 كلمات جديدة من قاموسه، ثم قارن نصّك بمقتطف من الفيديو الرئيسي وحدّد الفروق."]}],"pron":[{"w":"le résumé","ipa":"[lə ʁe.zy.me]","approx":"لو ريزوميه"},{"w":"l’abstract","ipa":"[laps.tʁakt]","approx":"لابستراكت"},{"w":"hiérarchiser","ipa":"[ʒe.ʁaʁ.ʃi.ze]","approx":"ييرارشيزيه"}],"vocab":[{"fr":"l’abrégé","ar":"المختصر المُلخِّص","pos":"nom","g":"m","exFr":"L’abrégé tient en une page bien hiérarchisée.","ipa":"[la.bʁe.ʒe]","exAr":"يُختصر المُلخَّص في صفحة واحدة مرتّبة."},{"fr":"l’abstract","ar":"المستخلص (بالإنجليزية)","pos":"nom","g":"m","exFr":"L’abstract est en anglais.","ipa":"[laps.tʁakt]","exAr":"المستخلص بالإنجليزية."},{"fr":"la question centrale","ar":"السؤال المركزي للملخّص","pos":"nom","g":"f","exFr":"La question centrale ordonne tout le résumé.","ipa":"[la kɛ.sjɔ̃ sɑ̃tʁal]","exAr":"يرتّب الملخّصَ كاملًا السؤالُ المركزي."},{"fr":"l’hypothèse","ar":"الافتراض","pos":"nom","g":"f","exFr":"L’hypothèse guide la recherche.","ipa":"[i.pɔ.tɛz]","exAr":"الافتراض يوجّه البحث."},{"fr":"la méthode","ar":"المنهج","pos":"nom","g":"f","exFr":"La méthode est clairement exposée.","ipa":"[mə.tɔd]","exAr":"المنهج معرَّض بوضوح."},{"fr":"l’observation","ar":"الملاحظة المستخلصة من التحليل","pos":"nom","g":"m","exFr":"L’observation principale guide le résumé.","ipa":"[lɔb.zɛʁ.va.sjɔ̃]","exAr":"توجّه الملاحظةُ الرئيسةُ الملخّص."},{"fr":"la portée","ar":"المدى / الأثر","pos":"nom","g":"f","exFr":"La portée de l’étude est large.","ipa":"[pɔʁ.te]","exAr":"مدى الدراسة واسع."},{"fr":"hiérarchiser","ar":"يرتّب حسب الأولوية","pos":"verbe","g":"","exFr":"Il faut hiérarchiser les idées.","ipa":"[ʒe.ʁaʁ.ʃi.ze]","exAr":"يجب ترتيب الأفكار حسب الأولوية."},{"fr":"condenser","ar":"يكثّف","pos":"verbe","g":"","exFr":"Condensez ce paragraphe.","ipa":"[kɔ̃.dɑ̃.se]","exAr":"كثّف هذه الفقرة."},{"fr":"récapituler","ar":"يجمل النقاط الرئيسية","pos":"verbe","g":"","exFr":"L’abstract récapitule la méthode et les résultats.","ipa":"[ʁe.ka.pi.ty.le]","exAr":"يُجمّل الملخّصُ الطريقةَ والنتائج."},{"fr":"l’essentiel","ar":"الجوهري","pos":"nom","g":"m","exFr":"Gardez l’essentiel.","ipa":"[e.sɑ̃.sjɛl]","exAr":"احتفظ بالجوهري."},{"fr":"la trame","ar":"البنية الأساسية للنص","pos":"nom","g":"f","exFr":"Le fil directeur reste clair.","ipa":"[lə fil di.ʁɛk.tœʁ]","exAr":"الخيط الموجّه يبقى واضحاً."}],"examples":[{"fr":"Ce texte analyse la réforme scolaire.","ar":"يحلّل هذا النص الإصلاح المدرسي.","note":"l’ouverture"},{"fr":"L’auteur s’interroge sur l’égalité des chances.","ar":"يسأل المؤلف عن مساواة الفرص.","note":"la problématique"},{"fr":"L’étude montre un recul des résultats.","ar":"تُظهر الدراسة تراجعاً في النتائج.","note":"le résultat"},{"fr":"Ces résultats permettent d’affiner le débat.","ar":"تتيح هذه النتائج توضيح النقاش.","note":"la portée"},{"fr":"Contrairement à ce qu’on pense, la durée n’est pas le facteur clé.","ar":"خلافاً لما يُعتقد، المدة ليست العامل الحاسم.","note":"le contraste"},{"fr":"Le résumé évite les noms propres.","ar":"الملخّص يتجنّب الأسماء الخاصة.","note":"la règle"}],"grammar":[{"tFr":"La nominalisation dans le résumé","tAr":"la nominalisation في الملخّص","body":["le résumé يضغط la phrase بالnominalisation: « l’augmentation de la population » بدل « la population augmente » — la longueur تنخفض والمعنى يبقى.","le présent de vérité يحكم les résultats: « L’étude montre que… », « Le texte démontre… » — pas le passé، car le texte يبقى صحيحاً بعد قراءتك."],"ex":[{"fr":"La population augmente → l’augmentation de la population.","ar":"السكان يزدادون ← ازدياد السكان."},{"fr":"L’étude montre que le chômage baisse.","ar":"تُظهر الدراسة أن البطالة تنخفض."}]},{"tFr":"Les connecteurs de synthèse","tAr":"أدوات الربط في الملخّص","body":["le résumé يستعمل les connecteurs de relation: « d’une part… d’autre part »، « en revanche »، « par conséquent »، « c’est pourquoi ». بدونها تصبح les idées مبعثرة.","« alors que » تربط le contraste في la même phrase — la plus économique pour le résumé."],"ex":[{"fr":"Le premier résultat est net, alors que le second reste fragile.","ar":"النتيجة الأولى واضحة، بينما الثانية تبقى هشّة."},{"fr":"La méthode échoue, par conséquent l’analyse est revue.","ar":"المنهج يفشل، وبالتالي تُراجع التحليل."}]}],"mistakes":[{"wrong":"la conclusion personnelle في le résumé","right":"la restitution fidèle de l’argument","why":"le résumé يعيد ما يقوله le texte لا ما تراه أنت."},{"wrong":"le copier-coller des phrases","right":"la reformulation avec la structure nouvelle","why":"le résumé ليست la coupe de phrases."},{"wrong":"l’ajout des noms propres et des chiffres trop nombreux","right":"les résultats essentiels seulement","why":"le détail يُشتّت le fil directeur."},{"wrong":"le résumé مكتوب أولاً","right":"le résumé مكتوب بعد la lecture complète","why":"بدون la lecture تلخّص انطباعك لا النص."}],"dialogues":[{"title":"مراجعة abstract","ctx":"باحث مع مشرف","lines":[{"who":"Prof","fr":"Votre abstract commence par une opinion.","ar":"مستخلصك يبدأ برأي."},{"who":"Élève","fr":"Je vais commencer par la problématique.","ar":"سأبدأ بالمسألة المحورية."},{"who":"Prof","fr":"Et terminez par la portée, pas par le décor.","ar":"وأنهِ بالمدى، لا بالزخرفة."},{"who":"Élève","fr":"D’accord : problème, méthode, résultat, portée.","ar":"حسناً: المشكلة، المنهج، النتيجة، الأثر."}]},{"title":"compte des mots","ctx":"atelier d’écriture","lines":[{"who":"Claire","fr":"Mon résumé fait trois cents mots.","ar":"ملخصي ثلاثمائة كلمة."},{"who":"Karim","fr":"Coupez les adjectifs d’abord.","ar":"اقتطع الصفات أولاً."},{"who":"Claire","fr":"Puis je peux condenser la méthode.","ar":"ثم أستطيع تكثيف المنهج."},{"who":"Karim","fr":"Oui, et gardez le fil directeur.","ar":"نعم، واحتفظي بالخيط الموجّه."}]}],"exercises":[{"t":"mcq","skill":"analysis","q":"ما les quatre temps de l’abstract ?","opts":["problème، méthode، نتيجة، أثر","مقدمة، تاريخ، مراجع، خاتمة","رأي، اعتراض، رد، خاتمة","تعريف، مثال، تمرين، تصحيح"],"a":0,"why":"la structure fixe de tout abstract."},{"t":"fill","skill":"grammar","q":"أكمل: «L’étude ___ que le chômage baisse.»","fr":"L’étude ___ que le chômage baisse.","ans":"montre","why":"le présent de vérité dans le résumé."},{"t":"mcq","skill":"analysis","q":"ما الممنوع في le résumé ?","opts":["l’opinion personnelle","le présent","le connecteur","la reformulation"],"a":0,"why":"le résumé restitue، لا يُقيّم."},{"t":"order","skill":"writing","q":"رتّب: المشكل، المنهج، النتيجة، الأثر","words":["Le","problème,","la","méthode,","le","résultat,","la","portée."],"ans":"Le problème, la méthode, le résultat, la portée.","why":"la structure en quatre temps."},{"t":"listen","skill":"listening","q":"ما « la portée » في le résumé ?","opts":["الأثر والامتداد","المنهج","المسألة","المدة"],"a":0,"why":"portée = مدى النتائج وأثرها."},{"t":"translate","skill":"writing","q":"ترجم: هذه النتائج تتيح توضيح النقاش.","ans":"Ces résultats permettent d’affiner le débat.","why":"la portée في la phrase finale."},{"t":"speaking","skill":"speaking","q":"لخّص مقالاً في 30 ثانية شفوياً: problème، méthode، résultat، portée.","target":"Le texte analyse… / L’auteur montre que… / Le résultat… / L’apport est…","why":"la structure أوياً."},{"t":"correct","skill":"analysis","q":"صحّح: «À mon avis, cette étude est très intéressante.»","ans":"Cette étude apporte un éclairage nouveau sur…","why":"l’opinion تحل محل la restitution."}],"homework":"خذ ورقة محكّمة من صفحتين واكتب abstract من 200 كلمة بأربع جمل: la question، la démarche، le résultat، l’apport — بلا nom propre ولا citation.","sources":[{"title":"Écrire un résumé et un abstract efficaces","channel":"Français Authentique","videoId":"DQzyDJxYrZw","why":"شرح la différence entre le résumé français و l’abstract international، مع la méthode: identifier، hiérarchiser، reformuler، vérifier.","cat":"Académique","level":"B2","main":true},{"title":"Comment structurer un mémoire","channel":"Le français by Alex","videoId":"L87HeuqvzT8","why":"بنية la recherche الكاملة التي يخدمها l’abstract.","cat":"Académique","level":"B2","extra":true},{"title":"La reformulation : reformuler sans copier","channel":"Français Authentique","videoId":"lOARyavqJwI","why":"la compétence centrale pour écrire un résumé sans plagiat.","cat":"Académique","level":"B2","extra":true}],"supplements":[{"id":"L87HeuqvzT8","title":"Comment structurer un mémoire","channel":"Le français by Alex","why":"بنية la recherche الكاملة التي يخدمها l’abstract.","lang":"fr","dur":15},{"id":"lOARyavqJwI","title":"La reformulation : reformuler sans copier","channel":"Français Authentique","why":"la compétence centrale pour écrire un résumé sans plagiat.","lang":"fr","dur":12}]},{"id":"b2-t4-l6","fr":"Le style académique","ar":"الأسلوب الأكاديمي","objectives":["تطبيق les critères: précision, cohérence, objectivité, densité","استبدال le style personnel بـ la voix impersonnelle","استعمال les adverbes de mesure et de modalisation","مراجعة نص لجعله académique دون فقدان la clarté"],"sections":[{"h":"الدرس 6: كيف تكتب بأسلوب أكاديمي واضح وموضوعي","video":{"id":"JKMcILxOYLs","title":"Le style académique : précis, clair, objectif","channel":"Le français by Alex","why":"شرح les règles du style académique: la voix passive، la nominalisation، la modalisation، et l’équilibre بين la précision et la clarté.","lang":"fr","main":true,"dur":15},"p":["le style académique ليس le style difficile — هو le style الذي يُسمح فيه للقارئ بـ vérifier كل ادّعاء. أربعة معايير: la précision (كل مصطلح له معنى واحد)، la cohérence (terminologie ثابتة)، l’objectivité (بلا affect)، la densité (بلا حشو).","معجم الدرس: la thèse, l’analyse, la démonstration, le postulat, la corrélation, l’échelle, la marge d’erreur, la limite, la portée, l’apport, la vérification, la rigueur. هذه المفردات هي le lexique de la preuve.","نحوياً، le style académique يُطرد le « je »: « Je pense que… » ← « On peut considérer que… » ← « Il semble que… ». la voix passive و la nominalisation تجعل la phrase objective: « L’analyse a été menée sur… ».","la modalisation ضرورية: « il est probable que », « les données suggèrent que », « dans une certaine mesure ». le style بلا modalisation يصبح dogmatique — و le style بـ modalisation مبالغة يصبح faible.","la règle la nuance: la phrase longue ليست la phrase académique — la phrase exacte هي la cible. le période grécisant يُعتذر عنه: aujourd’hui la clarté تُفضَّل على la démonstration de culture.","بعد الدرس: خذ فقرة كتبتها لغير الدراسة، حوّلها إلى le style académique في ثلاث نسخ: la version la plus objective، la version la plus dense، ثم la version la plus nuancée."],"sub":[{"h":"les quatre critères","p":["La précision : chaque terme a un seul sens.","La cohérence : le même concept porte le même mot.","L’objectivité : les faits avant le jugement."]},{"h":"أدوات نطقية: la modalisation","p":["« Il est probable que… » [il ɛ pʁɔ.babl kə] — l’hypothèse.","« Les données suggèrent que… » — la prudence.","« Dans une certaine mesure… » — la limite."]},{"h":"خطوات la révision","p":["الخطوة الأولى: éliminer les affectifs (adjectifs personnelles).","الثانية: vérifier la terminologie.","الثالثة: compter les mots par phrase."]}]},{"h":"formules du style académique","p":["« Il convient de distinguer… » = يجب التمييز بين… — la rigueur avant l’affirmation.","« Les données suggèrent que… » — la prudence méthodologique.","« Cette analyse se limite à… » — la reconnaissance de la limite.","« Par ailleurs, il faut nuancer… » — la densité avec la nuance."]},{"h":"التطبيق والتلخيص","p":["تمرين l’impersonnel: حوّل ثلاث جمل شخصية (« je pense ») إلى la forme impersonnelle.","تمرين la densité: خمس جمل قصيرة ادمجها في جملتين مع le même contenu.","سجّل شرحاً أكاديمياً من دقيقة واحدة: la thèse، la preuve، ثم la limite."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: كتابة أكاديمية رصينة وموضوعية؛ أعد مشاهدة الفيديو الرئيسي وركّز على الأشكال غير الشخصية والتوقّعات الهادفة.","جسر الدروس: من b2-t4-l5 (اختزال النص الكامل في ملخّص متماسك) إلى b2-t4-l6 (كتابة أكاديمية رصينة وموضوعية)، ثم إلى b2-t5-l1 حيث تنتقل من الكتابة الفردية إلى الكلام المهني الحيّ في الاجتماعات (إدارة الاجتماع المهني وتوزيع الكلام).","مهمة تطبيقية: سجّل صوتك في دقيقةٍ واحدة تلخّص فيها أهم ثلاث أفكار من هذا الدرس، واستعمل 3 كلمات جديدة من قاموسه، ثم قارن أدائك بمقتطف من الفيديو الرئيسي وحدّد الفروق."]}],"pron":[{"w":"la rigueur","ipa":"[la ʁi.ɡœʁ]","approx":"لا ريگور"},{"w":"modalisation","ipa":"[mɔ.da.li.za.sjɔ̃]","approx":"موداليزاسيون"},{"w":"la démonstration","ipa":"[la de.mɔ̃s.tʁa.sjɔ̃]","approx":"لا ديمونستراسيون"}],"vocab":[{"fr":"la rigueur","ar":"الصرامة المنهجية","pos":"nom","g":"f","exFr":"La rigueur impose des sources.","ipa":"[ʁi.ɡœʁ]","exAr":"الصرامة تفرض المصادر."},{"fr":"la conviction","ar":"القناعة المعلنة في التحليل الأكاديمي","pos":"nom","g":"f","exFr":"L’analyse part d’une conviction clairement annoncée.","ipa":"[la kɔ̃.vik.sjɔ̃]","exAr":"ينطلق التحليلُ من قناعة معلَنة بوضوح."},{"fr":"la démonstration","ar":"الاستدلال","pos":"nom","g":"f","exFr":"La démonstration suit trois étapes.","ipa":"[de.mɔ̃s.tʁa.sjɔ̃]","exAr":"الاستدلال يتبع ثلاث مراحل."},{"fr":"le postulat","ar":"الفرضية الأساسية","pos":"nom","g":"m","exFr":"Ce postulat est discutable.","ipa":"[pɔs.ty.la]","exAr":"هذه الفرضية قابلة للنقاش."},{"fr":"la variable","ar":"المتغيّرة في التحليل الأكاديمي","pos":"nom","g":"f","exFr":"La variable principale explique la tendance observée.","ipa":"[la va.ʁja.bl]","exAr":"تُفسّر المتغيّرةُ الرئيسةُ الاتجاهَ المُلاحَظ."},{"fr":"la marge d’erreur","ar":"هامش الخطأ","pos":"nom","g":"f","exFr":"La marge d’erreur est de deux pour cent.","ipa":"[maʁʒ dɛ.ʁœʁ]","exAr":"هامش الخطأ اثنان بالمائة."},{"fr":"la limite","ar":"الحد / القيود","pos":"nom","g":"f","exFr":"La limite de cette étude est claire.","ipa":"[li.mit]","exAr":"حد هذه الدراسة واضح."},{"fr":"la modalisation","ar":"الترويسة والتحفظ","pos":"nom","g":"f","exFr":"La modalisation évite le dogmatisme.","ipa":"[mɔ.da.li.za.sjɔ̃]","exAr":"الترويسة تتجنّب التعصب."},{"fr":"vérifier","ar":"يتحقّق","pos":"verbe","g":"","exFr":"Il faut vérifier chaque source.","ipa":"[ve.ʁi.fe]","exAr":"يجب التحقق من كل مصدر."},{"fr":"distinguer","ar":"يُميّز","pos":"verbe","g":"","exFr":"Il distingue deux notions.","ipa":"[dɛs.tɛ̃.ɡje]","exAr":"يُميّز بين مفهومين."},{"fr":"suggérer","ar":"يوحي","pos":"verbe","g":"","exFr":"Les résultats suggèrent une tendance.","ipa":"[sy.ʒe.ʁe]","exAr":"النتائج توحي باتجاه."},{"fr":"se limiter à","ar":"يقتصر على","pos":"loc.","g":"","exFr":"Cette analyse se limite à trois cas.","ipa":"","exAr":"هذا التحليل يقتصر على ثلاثة حالات."}],"examples":[{"fr":"Il convient de distinguer deux notions.","ar":"يجب التمييز بين مفهومين.","note":"la rigueur"},{"fr":"Les données suggèrent une tendance fragile.","ar":"النتائج توحي باتجاه هشّ.","note":"la modalisation"},{"fr":"L’analyse a été menée sur quatre cents répondants.","ar":"أُجري التحليل على أربعمائة مجيب.","note":"la voix passive"},{"fr":"Cette analyse se limite aux années récentes.","ar":"هذا التحليل يقتصر على السنوات الأخيرة.","note":"la limite"},{"fr":"On peut considérer que la corrélation est faible.","ar":"يمكن اعتبار أن الارتباط ضعيف.","note":"l’impersonnel"},{"fr":"La démonstration repose sur trois étapes.","ar":"الاستدلال يقوم على ثلاث مراحل.","note":"la structure"}],"grammar":[{"tFr":"L’impersonnel et la voix passive","tAr":"التعبير المجرّد والمبني للمجهول","body":["le style académique يطرد le « je »: « Je pense que la thèse est faible » ← « On peut considérer que la thèse est faible »، et la voix passive تُخفي le sujet: « L’analyse a été réalisée… ».","هذا ليس elusion بل la convention: le texte يصبح ملك la démarche لا le locuteur — ولهذا يقبله le jury."],"ex":[{"fr":"Je pense que… → On peut considérer que…","ar":"أعتقد أن… ← يمكن اعتبار أن…"},{"fr":"Nous avons analysé les réponses → Les réponses ont été analysées.","ar":"حللنا الإجابات ← حُلِّلت الإجابات."}]},{"tFr":"La modalisation : degrés de certitude","tAr":"الترويسة: درجات اليقين","body":["سلّم la certitude: « il est certain que » (نادر) ← « il est probable que » ← « il est possible que » ← « les données suggèrent que » ← « il est peu probable que ».","la bonne choix dépend de la preuve: بدون données قوية تبقى la modalisation élevée — le dogmatisme يضعف la crédibilité."],"ex":[{"fr":"Il est probable que la mesure soit efficace.","ar":"من المرجح أن يكون الإجراء فعّالاً."},{"fr":"Il est peu probable que le résultat soit général.","ar":"من غير المرجح أن تكون النتيجة عامة."}]}],"mistakes":[{"wrong":"l’opinion personnelle (« je trouve que… »)","right":"la forme impersonnelle (« on peut considérer… »)","why":"le style académique يُطرد le locuteur."},{"wrong":"la phrase longue للاستعراض","right":"la phrase exacte et claire","why":"la clarté تُفضَّل على la démonstration de culture."},{"wrong":"le dogmatisme: « c’est certain que… »","right":"la modalisation: « les données suggèrent… »","why":"le dogmatisme يُضعف la crédibilité."},{"wrong":"التنويع في la terminologie","right":"le même concept avec le même mot","why":"la cohérence شرط la compréhension."}],"dialogues":[{"title":"تصحيح نص","ctx":"محرّرة أكاديمية مع باحث","lines":[{"who":"Éditrice","fr":"« Je suis sûr que… » n’a pas sa place ici.","ar":"«أنا متأكد أن…» ليس له مكان هنا."},{"who":"Chercheur","fr":"Je peux écrire « les données montrent que… » ?","ar":"أستطيع كتابة «النتائج تُظهر أن…»؟"},{"who":"Éditrice","fr":"Mieux : « les données suggèrent que… ».","ar":"أفضل: «النتائج توحي بأن…»."},{"who":"Chercheur","fr":"D’accord, et je garde la limite à la fin.","ar":"حسناً، وأحتفظ بالحد في النهاية."}]},{"title":"مراجعة بين pairs","ctx":"ورشة كتابة","lines":[{"who":"Claire","fr":"Ton style est clair, mais trop personnel.","ar":"أسلوبك واضح لكنه شخصي جداً."},{"who":"Karim","fr":"Alors je passe à la voix passive ?","ar":"إذن أنتقل إلى المبني للمجهول؟"},{"who":"Claire","fr":"Oui, et remplace « très important » par une mesure.","ar":"نعم، واستبدل «مهم جداً» بقياس."},{"who":"Karim","fr":"Parfait, la phrase devient vérifiable.","ar":"ممتاز، تصبح الجملة قابلة للتحقق."}]}],"exercises":[{"t":"mcq","skill":"analysis","q":"ما les quatre critères de style académique ?","opts":["الدقة، التماسك، الموضوعية، الكثافة","الطول، الزخرفة، العاطفة، السرعة","الرأي، الهجوم، التكرار، المجاملة","التعريف، الوصف، السرد، الحوار"],"a":0,"why":"ces quatre critères تُقيَّم عليها le travail académique."},{"t":"fill","skill":"grammar","q":"حوّل إلى l’impersonnel: «Je pense que…» → «___ que la thèse est faible.»","fr":"___ que la thèse est faible.","ans":"On peut considérer","why":"la forme impersonnelle يطرد le « je »."},{"t":"mcq","skill":"grammar","q":"أي جملة تحترم la modalisation ?","opts":["Les données suggèrent une tendance.","C’est absolument certain.","Je suis sûr du résultat.","Il n’y a aucun doute."],"a":0,"why":"la modalisation تحمي la crédibilité."},{"t":"order","skill":"writing","q":"رتّب: يجب التمييز بين مفهومين","words":["Il","convient","de","distinguer","deux","notions."],"ans":"Il convient de distinguer deux notions.","why":"la formule de rigueur."},{"t":"listen","skill":"listening","q":"ما « la marge d’erreur »؟","opts":["هامش الخطأ","الأطروحة","الطريقة","الخاتمة"],"a":0,"why":"la marge d’erreur مصطلح la preuve."},{"t":"translate","skill":"writing","q":"ترجم: هذا التحليل يقتصر على السنوات الأخيرة.","ans":"Cette analyse se limite aux années récentes.","why":"la limite de la démarche."},{"t":"speaking","skill":"speaking","q":"قدّم شرحاً أكاديمياً من دقيقة: la thèse، la preuve، ثم la limite.","target":"Il convient de… / Les données suggèrent… / Par ailleurs… / Cette analyse se limite à…","why":"le style complet."},{"t":"correct","skill":"analysis","q":"صحّح: «Je trouve que c’est très important.»","ans":"Il est important de souligner que…","why":"l’opinion personnelle تحل محل la forme académique."}],"homework":"خذ فقرة من كتابتك وحوّلها إلى le style académique في ثلاث نسخ: la plus objective، la plus dense، la plus nuancée — مع تعليق يشرح لماذا اخترت كل صيغة.","sources":[{"title":"Le style académique : précis, clair, objectif","channel":"Le français by Alex","videoId":"JKMcILxOYLs","why":"شرح les règles du style académique: la voix passive، la nominalisation، la modalisation، et l’équilibre بين la précision et la clarté.","cat":"Académique","level":"B2","main":true},{"title":"Le commentaire composé : méthode complète","channel":"Le français by Alex","videoId":"86QbMDRzxtg","why":"méthode académique: observation، analyse، interprétation — la même rigueur du style.","cat":"Académique","level":"B2","extra":true},{"title":"Vocabulaire soutenu : 50 expressions académiques","channel":"French with Alicia","videoId":"Rz5qJ-G7H4E","why":"le lexique prêt à l’emploi pour l’écriture universitaire.","cat":"Académique","level":"B2","extra":true}],"supplements":[{"id":"86QbMDRzxtg","title":"Le commentaire composé : méthode complète","channel":"Le français by Alex","why":"méthode académique: observation، analyse، interprétation — la même rigueur du style.","lang":"fr","dur":19},{"id":"Rz5qJ-G7H4E","title":"Vocabulaire soutenu : 50 expressions académiques","channel":"French with Alicia","why":"le lexique prêt à l’emploi pour l’écriture universitaire.","lang":"fr","dur":16}]}]},{"id":"b2-t5","slug":"francais-pro-avance","icon":"briefcase","color":"#1565c0","fr":"Français professionnel avancé (B2)","ar":"مسار الفرنسية المهنية المتقدمة (B2)","desc":"ستة مسارات متكاملة للفرنسيّة المهنية عند المستوى B2: الاجتماعات، التفاوض، العروض التقديمية، المراسلات، المقابلات، ومساحات اللغة — مع فيديوهات موثّقة وتمارين مهنية.","lessons":[{"id":"b2-t5-l1","fr":"Réunions & prises de parole","ar":"الاجتماعات ومراتب الكلام في العمل","objectives":["التحدث في اجتماع ببنية واضحة: رأي ← حجة ← اقتراح","استعمال la langue de l’entreprise: ordre du jour, compte-rendu, action","تمييز la forme polie (conditionnel) عن la commande directe","تحليل كيف يدير المتحدث الاحترافي la contradiction دون توتّر"],"sections":[{"h":"الدرس 1: كيف تتحدث في اجتماع فرنسي (إنتاج شفوي B2)","video":{"id":"d9TV6M-wQlQ","title":"Production orale DELF B2 2025 - TEST COMPLET !","channel":"Français avec Pierre","why":"اختبار إنتاج شفوي كامل لـ DELF B2: بنية الرأي، la justification، ثم la conclusion — نفس المهارات المطلوبة في اجتماع العمل.","lang":"fr","main":true,"dur":15},"p":["الاجتماع في باريس ليس منصة للخطابة بل للحوار المنضبط: la président(e) تفتح بـ « l’ordre du jour »، ثم يتناوب المشاركون بلغة مختصرة وواضحة. في المستوى B2، المطلوب ليس الكمال بل la clarté structure.","المفردات الأساسية: l’ordre du jour, le compte-rendu, une action, un délai, faire un point, revenir sur, donner son avis, proposer. هذه المفردات هي la grammaire الاجتماعية للعمل الفرنسي.","نحوياً، يبرز la conditionnelle المهذّبة: « On pourrait examiner… », « Je suggérerais de… ». الطلب المباشر « Fais ça » يُستبدل بـ « Pourriez-vous… ? » في بيئة مهنية.","التحدي الأكبر هو la contradiction المهذّبة: « Je comprends ton point de vue, mais… » ثم la contre-proposition. هذا هو la base de la culture du débat في المكتب الفرنسي.","بعد الدرس، شارك في اجتماع وهمي من خمس جمل: ترحيب، تذكير بالجدول، رأي، اقتراح، ثم خاتمة — بالفرنسية.","الدرس الأول يُعلّمك la grammaire الاجتماعية: كيف تُدير la contradiction دون أن تكسر la relation. la clé: la position مع la justification ثم la proposition — بنية la discours الفرنسي الاحترافية."],"sub":[{"h":"بنية الرأي والاقتراح","p":["Je suis d’accord avec ce point de vue.","Je comprends, mais je ne suis pas tout à fait d’accord.","On pourrait examiner cette option.","Je suggérerais de reporter la décision à vendredi."]},{"h":"أدوات نطقية: نبرة الاحتراف","p":["« je suggérerais » تُنطَق بنبرة هادئة هابطة — la politesse في la voix.","« l’ordre du jour » [lɔʁdə du ʒu] — t صامتة في jour.","« le compte-rendu » [lə kɔ̃t ʁɑ̃dy] — liaison واضحة."]},{"h":"خطوات Listen & Repeat","p":["المرة الأولى: اكتب كل تعبير اقتراح سمعته.","الثانية: كرّر جملة رأيك بنبرة احترافية هادئة.","الثالثة: أضف « mais… » ثم contre-proposition."]}]},{"h":"عبارات الاجتماع الاحترافية","p":["« On fait un point sur… » = نراجع… — la tournure la plus naturelle pour ouvrir un sujet.","« Je voudrais revenir sur ce point. » = أودّ العودة إلى… — la reprise في النقاش.","« Donnons-nous un délai ? » = نحدد أجلاً؟ — la transition vers l’action.","« C’est noté, je fais le compte-rendu. » — la clôture officielle."]},{"h":"التطبيق والتلخيص","p":["تمرين الافتتاح: افتح اجتماعاً وهمياً بثلاث جمل: الترحيب، la raison de la réunion، ثم la première question.","تمرين la contradiction: شخص يعرض رأياً والآخر يعترض بلباقة ثم يقترح بديلاً.","سجّل نفسك تقدّم اقتراحاً في 40 ثانية: la situation، la raison، la proposition، ثم le délai."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: إدارة الاجتماع المهني وتوزيع الكلام؛ أعد مشاهدة الفيديو الرئيسي وركّز على عبارات فتح الاجتماع وإنهائه وتوزيع الأدوار.","جسر الدروس: من b2-t4-l6 (كتابة أكاديمية رصينة وموضوعية) إلى b2-t5-l1 (إدارة الاجتماع المهني وتوزيع الكلام)، ثم إلى b2-t5-l2 حيث تنتقل من تنسيق النقاش إلى كسب الموقف في التفاوض (التفاوض المهني بأساليب الخبراء).","مهمة تطبيقية: سجّل صوتك في دقيقةٍ واحدة تلخّص فيها أهم ثلاث أفكار من هذا الدرس، واستعمل 3 كلمات جديدة من قاموسه، ثم قارن أدائك بمقتطف من الفيديو الرئيسي وحدّد الفروق."]}],"pron":[{"w":"l’ordre du jour","ipa":"[lɔʁdə du ʒu]","approx":"لورد دو جور"},{"w":"le compte-rendu","ipa":"[lə kɔ̃t ʁɑ̃dy]","approx":"لو كونت راندي"},{"w":"suggérer","ipa":"[sy.ʒe.ʁe]","approx":"سوجيري"}],"vocab":[{"fr":"l’ordre du jour","ar":"جدول الأعمال","pos":"nom","g":"m","exFr":"Voici l’ordre du jour de la réunion.","ipa":"","exAr":"إليك جدول أعمال الاجتماع."},{"fr":"le compte-rendu","ar":"محضر الاجتماع","pos":"nom","g":"m","exFr":"Je t’envoie le compte-rendu demain.","ipa":"","exAr":"سأرسل لك المحضر غداً."},{"fr":"une action","ar":"مهمة/إجراء","pos":"nom","g":"f","exFr":"Chaque action a un responsable.","ipa":"","exAr":"لكل إجراء مسؤول."},{"fr":"un délai","ar":"مهلة/أجل","pos":"nom","g":"m","exFr":"Le délai est de deux semaines.","ipa":"","exAr":"الأجل أسبوعان."},{"fr":"faire un point","ar":"يراجع/يتابع","pos":"loc.","g":"","exFr":"On fait un point sur le projet.","ipa":"","exAr":"نراجع المشروع."},{"fr":"revenir sur","ar":"يعود إلى","pos":"loc.","g":"","exFr":"Je voudrais revenir sur ce point.","ipa":"","exAr":"أودّ العودة إلى هذه النقطة."},{"fr":"donner son avis","ar":"يبدئ رأيه","pos":"loc.","g":"","exFr":"Chacun doit donner son avis.","ipa":"","exAr":"على كل واحد أن يبدئ رأيه."},{"fr":"proposer","ar":"يقترح","pos":"verbe","g":"","exFr":"Je propose de reporter à vendredi.","ipa":"","exAr":"أقترح التأجيل إلى الجمعة."},{"fr":"d’accord avec","ar":"موافق على","pos":"loc.","g":"","exFr":"Je suis d’accord avec ton idée.","ipa":"","exAr":"أنا موافق على فكرتك."},{"fr":"un problème / un obstacle","ar":"مشكلة / عقبة","pos":"nom","g":"m","exFr":"Il y a un obstacle technique.","ipa":"","exAr":"توجد عقبة تقنية."},{"fr":"trancher","ar":"يقرّر حاسماً","pos":"verbe","g":"","exFr":"Il faut trancher ce débat.","ipa":"","exAr":"يجب حسم هذا النقاش."},{"fr":"aboutir à","ar":"ينتهي إلى","pos":"loc.","g":"","exFr":"La réunion a abouti à une décision.","ipa":"","exAr":"انتهى الاجتماع بقرار."}],"examples":[{"fr":"Je suis d’accord avec ce point de vue.","ar":"أنا موافق على وجهة النظر هذه.","note":"la position"},{"fr":"Je comprends, mais je ne suis pas tout à fait d’accord.","ar":"أتفهم، لكنني لست موافقاً تماماً.","note":"la contradiction polie"},{"fr":"On pourrait examiner cette option.","ar":"يمكننا فحص هذا الخيار.","note":"conditionnel"},{"fr":"Je suggérerais de reporter à vendredi.","ar":"أقترح التأجيل إلى الجمعة.","note":"conditionnel poli"},{"fr":"Donnons-nous un délai ?","ar":"نحدد أجلاً؟","note":"impératif"},{"fr":"La réunion a abouti à une décision.","ar":"انتهى الاجتماع بقرار.","note":"passé composé"}],"grammar":[{"tFr":"Conditionnel pour la politesse professionnelle","tAr":"la conditionnelle في الاحترافية المهنية","body":["« On pourrait… », « Je suggérerais… », « Pourriez-vous… ? » — la conditionnelle تُحوّل la commande إلى la proposition. هذا هو la signature de la politesse française au travail.","انتبه: « Je veux » مباشرة تُصاغ بـ « Je souhaiterais » أو « Je voudrais » في la réunion."],"ex":[{"fr":"On pourrait avancer le deadline.","ar":"يمكننا تقديم الأجل."},{"fr":"Pourriez-vous préparer le compte-rendu ?","ar":"هل يمكنك تجهيز المحضر؟"}]},{"tFr":"Connecteurs logiques : mais, cependant, en revanche","tAr":"أدوات الربط: mais, cependant, en revanche","body":["« mais » عادية، « cependant » أكثر رسمية، « en revanche » للمقارنة المعاكسة. الثلاثة تظهر في la contradiction المهذّبة.","« en outre » = بالإضافة إلى، « par ailleurs » = من جانب آخر — لتوسيع الحجة."],"ex":[{"fr":"Le budget est limité, cependant le projet est prioritaire.","ar":"الميزانية محدودة، لكن المشروع له أولوية."},{"fr":"En outre, le délai est court.","ar":"علاوة على ذلك، الأجل قصير."}]}],"mistakes":[{"wrong":"« Fais le compte-rendu ! »","right":"« Pourrais-tu préparer le compte-rendu ? »","why":"la commande directe تُستبدل بالشرطية المهذّبة."},{"wrong":"« Je ne suis pas d’accord ! » (بلا حجة)","right":"« Je ne suis pas d’accord, parce que… »","why":"la position تتطلب la justification."},{"wrong":"« On va discuter le projet »","right":"« On fait un point sur le projet »","why":"faire un point = la tournure الاحترافية."},{"wrong":"« Le deadline est… » (anglicisme)","right":"« Le délai est… »","why":"la françisation: délai بدل deadline."}],"dialogues":[{"title":"افتتاح الاجتماع","ctx":"مديرة تفتح اجتماع الفريق","lines":[{"who":"Claire","fr":"Bonjour à tous. Voici l’ordre du jour.","ar":"مرحباً بالجميع. إليكم جدول الأعمال."},{"who":"Claire","fr":"On fait un point sur le projet Alpha.","ar":"نراجع مشروع ألفا."},{"who":"Marc","fr":"Je voudrais revenir sur le budget.","ar":"أودّ العودة إلى الميزانية."},{"who":"Claire","fr":"D’accord, donne ton avis.","ar":"موافق، ابدئ رأيك."}]},{"title":"المقابلة المهذّبة","ctx":"نقاش بين زميلين","lines":[{"who":"Marc","fr":"Je comprends, mais je ne suis pas tout à fait d’accord.","ar":"أفهم، لكنني لست موافقاً تماماً."},{"who":"Nadia","fr":"Tu as raison. On pourrait examiner une autre option.","ar":"معك حق. يمكننا فحص خيار آخر."},{"who":"Marc","fr":"Je suggérerais de reporter à vendredi.","ar":"أقترح التأجيل إلى الجمعة."},{"who":"Nadia","fr":"C’est noté. On donne un délai ?","ar":"سُجّل. نحدد أجلاً؟"}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما معنى « le compte-rendu »؟","opts":["محضر الاجتماع","جدول الأعمال","المهمة","المهلة"],"a":0,"why":"compte-rendu = المحضر."},{"t":"fill","skill":"grammar","q":"أكمل بشكل مهذّب: «___ examiner cette option ?» (يمكن)","fr":"___ examiner cette option ?","ans":"Pourrait-on","why":"conditionnel + inversion."},{"t":"mcq","skill":"grammar","q":"الصيغة المهذّبة للطلب:","opts":["Pourrais-tu préparer le rapport ?","Prépare le rapport !","Tu prépares le rapport.","Va préparer le rapport."],"a":0,"why":"conditionnel après pouvoir."},{"t":"order","skill":"writing","q":"رتّب: يمكننا مراجعة المشروع غداً","words":["On","pourrait","examiner","le","projet","demain."],"ans":"On pourrait examiner le projet demain.","why":"conditionnel + infinitif."},{"t":"listen","skill":"listening","q":"ما التعبير لفتح جدول الأعمال؟","opts":["Voici l’ordre du jour.","Bonjour.","Merci.","À demain."],"a":0,"why":"ordre du jour = الافتتاح الرسمي."},{"t":"translate","skill":"writing","q":"ترجم: أودّ العودة إلى نقطة الميزانية.","ans":"Je voudrais revenir sur le point du budget.","why":"revenir sur + le point de."},{"t":"speaking","skill":"speaking","q":"افتح اجتماعاً وهمياً بثلاث جمل: الترحيب، la raison، ثم la première question.","target":"Bonjour… / Voici… / On fait un point sur…","why":"بنية الافتتاح."},{"t":"correct","skill":"grammar","q":"صحّح: «Fais le compte-rendu !»","ans":"Pourrais-tu préparer le compte-rendu ?","why":"la politesse تسبق la commande."}],"homework":"شاهد الفيديو مرتين، ثم اكتب سيناريو اجتماع من ثماني جمل: افتتاح، رأي، اعتراض مهذّب، اقتراح، ثم خاتمة مع تعيين أجل.","sources":[{"title":"Production orale DELF B2 2025 - TEST COMPLET !","channel":"Français avec Pierre","videoId":"d9TV6M-wQlQ","why":"اختبار إنتاج شفوي كامل لـ DELF B2: بنية الرأي، la justification، ثم la conclusion — نفس المهارات المطلوبة في اجتماع العمل.","cat":"Professionnel","level":"B2","main":true},{"title":"DIALOGUES EN FRANÇAIS Niveau B2 - [30 min.] (avec PDF!) 🎧❤️","channel":"Français avec Natives","videoId":"uUwVPql93p0","why":"حوارات B2 كاملة — استمع لسياقات مهنية متنوعة مع نص مرفق.","cat":"Professionnel","level":"B2","extra":true},{"title":"Meeting & Deadlines 📝 Organisation au travail | Learn French Conversation","channel":"Learn French with Alice","videoId":"IzhxaZUa_3E","why":"محادثة عن الاجتماعات والآجال — la pratique du quotidien professionnel.","cat":"Professionnel","level":"B2","extra":true}],"supplements":[{"id":"uUwVPql93p0","title":"DIALOGUES EN FRANÇAIS Niveau B2 - [30 min.] (avec PDF!) 🎧❤️","channel":"Français avec Natives","why":"حوارات B2 كاملة — استمع لسياقات مهنية متنوعة مع نص مرفق.","lang":"fr","dur":30},{"id":"IzhxaZUa_3E","title":"Meeting & Deadlines 📝 Organisation au travail | Learn French Conversation","channel":"Learn French with Alice","why":"محادثة عن الاجتماعات والآجال — la pratique du quotidien professionnel.","lang":"fr","dur":12}]},{"id":"b2-t5-l2","fr":"Négociation professionnelle","ar":"التفاوض المهني: أساليب الخبراء","objectives":["إتقان la stratégie التفاوضية: préparer, proposer, concéder","استعمال conditionnel التفاوضي: « Nous pourrions… », « Si vous acceptez… »","تمييز la concession الذكية عن la capitulation","تحليل le rapport de force في الحوار التجاري الفرنسي"],"sections":[{"h":"الدرس 2: التفاوض التجاري والمهني (3 أساليب)","video":{"id":"snurV8Aft2U","title":"Technique de Négociation Commerciale : 3 clés pour négocier comme un PRO !","channel":"Négociation & Vente","why":"ثلاث أساليب تفاوضية فرنسية: la préparation، la proposition، ثم la concession — مع أمثلة حوارية مباشرة.","lang":"fr","main":true,"dur":12},"p":["التفاوض في فرنسا ليس معركة بل la partie de poker محترمة: تُحضّر، تراقب، ثم تتحرك. الأسلوب الفرنسي يُفضّل la construction التدريجية على la pression المباشرة — « Si vous acceptez ce prix, je peux inclure la garantie. »","المفردات الأساسية: le prix, la remise, la garantie, le délai de livraison, les conditions, accepter, refuser, concéder, faire une offre, le contre-offre. هذه المفردات هي la monnaie التفاوضية.","نحوياً، يبرز conditionnel الافتراضي: « Nous pourrions baisser de 5 % si… ». la condition = la clé: la proposition معلّقة على la contrepartie.","الدرس من أسرار الخبراء: la première offre ليست la dernière. القدرة على الصمت بعد la proposition هي أقوى la technique — la silence يُجبر الآخر على la réaction.","بعد الدرس، تفاوض على سعر منتج افتراضي: أنت البائع والآخر المشتري — ثلاث جولات: la demande، la contre-offre، ثم la conclusion.","الدرس الثاني يفتح la porte على la culture du compromis: la première offre ليست la dernière، la silence أقوى la technique، ثم la concession الذكية تُبني la confiance la long terme."],"sub":[{"h":"جمل التفاوض الأساسية","p":["Nous pourrions baisser le prix de 5 %.","Si vous acceptez, je peux livrer plus vite.","Je ne peux pas descendre en dessous de ce seuil.","Faisons un compromis : la qualité, pas le prix."]},{"h":"أدوات نطقية: نبرة التفاوض","p":["« Si vous acceptez… » تُنطَق بنبرة هادئة واثقة.","« Je ne peux pas… » la fermeté بلا عدوانية.","« le seuil » [lə sœj] — la liaison مع le."]},{"h":"خطوات Listen & Repeat","p":["المرة الأولى: اكتب كل تعبير سعر أو شرط سمعته.","الثانية: كرّر la contre-offre بنبرة واثقة.","الثالثة: طبّق la concession مع صديق في تمرين مقايضة."]}]},{"h":"عبارات التفاوض الحاسمة","p":["« Si vous acceptez ce délai, je peux faire un geste. » — la condition + la concession في جملة واحدة.","« Je ne peux pas descendre en dessous de ce prix. » — la limite المعلنة بثقة.","« Faisons un compromis. » = نُبرم تسوية — la transition نحو la conclusion.","« C’est ma dernière offre. » — la fermeté النهائية (احذر la réciprocité)."]},{"h":"التطبيق والتلخيص","p":["تمرين la préparation: اكتب ثلاث نقاط la force وثلاث la faiblesse قبل أي تفاوض.","لعبة الأدوار: بائع ومشتري — ثلاث جولات: la demande، la contre-offre، la concession.","سجّل نفسك تشرح la condition بلغة واثقة في 30 ثانية: « Si vous…, je peux… »."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: التفاوض المهني بأساليب الخبراء؛ أعد مشاهدة الفيديو الرئيسي وركّز على تسلسل العرض والمعارضة والتنازل.","جسر الدروس: من b2-t5-l1 (إدارة الاجتماع المهني وتوزيع الكلام) إلى b2-t5-l2 (التفاوض المهني بأساليب الخبراء)، ثم إلى b2-t5-l3 حيث تنتقل من حوار التفاوض الثنائي إلى العرض أمام جمهور (تقديم عرض احترافي منسّق).","مهمة تطبيقية: سجّل صوتك في دقيقةٍ واحدة تلخّص فيها أهم ثلاث أفكار من هذا الدرس، واستعمل 3 كلمات جديدة من قاموسه، ثم قارن أدائك بمقتطف من الفيديو الرئيسي وحدّد الفروق."]}],"pron":[{"w":"la remise","ipa":"[la ʁə.miz]","approx":"لا روميز"},{"w":"le seuil","ipa":"[lə sœj]","approx":"لو سوي"},{"w":"concéder","ipa":"[kɔ̃.se.de]","approx":"كونسيدي"}],"vocab":[{"fr":"la remise","ar":"الخصم","pos":"nom","g":"f","exFr":"Je peux vous offrir une remise de 10 %.","ipa":"","exAr":"أستطيع منحكم خصماً 10%."},{"fr":"le prix / le tarif","ar":"السعر / التعريفة","pos":"nom","g":"m","exFr":"Le prix est ferme.","ipa":"","exAr":"السعر نهائي."},{"fr":"la garantie","ar":"الضمان","pos":"nom","g":"f","exFr":"La garantie est de deux ans.","ipa":"","exAr":"الضمان سنتان."},{"fr":"les conditions","ar":"الشروط","pos":"nom","g":"f pl","exFr":"Les conditions sont raisonnables.","ipa":"","exAr":"الشروط معقولة."},{"fr":"accepter / refuser","ar":"يقبل / يرفض","pos":"verbe","g":"","exFr":"Je refuse cette offre.","ipa":"","exAr":"أرفض هذا العرض."},{"fr":"concéder","ar":"يتنازل","pos":"verbe","g":"","exFr":"Il a concédé un geste.","ipa":"","exAr":"تنازل قليلاً."},{"fr":"faire une offre","ar":"يقدّم عرضاً","pos":"loc.","g":"","exFr":"Je vous fais une offre sérieuse.","ipa":"","exAr":"أقدم لكم عرضاً جاداً."},{"fr":"la contre-offre","ar":"العرض المضاد","pos":"nom","g":"f","exFr":"Voici ma contre-offre.","ipa":"","exAr":"إليك عرضي المضاد."},{"fr":"un compromis","ar":"تسوية","pos":"nom","g":"m","exFr":"Il faut trouver un compromis.","ipa":"","exAr":"يجب إيجاد تسوية."},{"fr":"le délai de livraison","ar":"مهلة التسليم","pos":"nom","g":"m","exFr":"Le délai est de trois semaines.","ipa":"","exAr":"الأجل ثلاثة أسابيع."},{"fr":"le seuil","ar":"الحد الأدنى","pos":"nom","g":"m","exFr":"Je ne descends pas en dessous du seuil.","ipa":"","exAr":"لا أنزل عن الحد الأدنى."},{"fr":"un geste commercial","ar":"تلميح تجاري/تخفيف","pos":"nom","g":"m","exFr":"Je peux faire un geste.","ipa":"","exAr":"يمكنني تقديم تخفيف."}],"examples":[{"fr":"Nous pourrions baisser le prix de 5 %.","ar":"يمكننا تخفيض السعر 5%.","note":"conditionnel"},{"fr":"Si vous acceptez, je peux livrer plus vite.","ar":"إذا قبلتم، يمكنني التسليم أسرع.","note":"la condition"},{"fr":"Je ne peux pas descendre en dessous de ce seuil.","ar":"لا أستطيع النزول تحت هذا الحد.","note":"la limite"},{"fr":"Faisons un compromis.","ar":"لنُبرم تسوية.","note":"impératif"},{"fr":"Voici ma contre-offre.","ar":"إليك عرضي المضاد.","note":"la tactique"},{"fr":"La garantie est incluse.","ar":"الضمان مشمول.","note":"la valeur ajoutée"}],"grammar":[{"tFr":"Conditionnel hypothétique : si + imparfait, conditionnel","tAr":"الافتراض: si + imparfait، ثم conditionnel","body":["« Si vous acceptez ce prix, je peux inclure la garantie. » — si + présent، ثم présent (la réalité). « Si vous aviez accepté…, j’aurais pu… » — si + plus-que-parfait، ثم conditionnel passé (للافتراض).","في la négociation الحية يُستخدم la première الصيغة لأنها la réalité قابلة للتحقيق."],"ex":[{"fr":"Si vous commandez aujourd’hui, je fais un geste.","ar":"إذا طلبتم اليوم، سأقدم تخفيفاً."},{"fr":"Si nous avions plus de temps, nous aurions accepté.","ar":"لو كان لدينا وقت أكثر، لكنا قبلنا."}]},{"tFr":"Négation ferme : je ne peux pas / je ne suis pas en mesure de","tAr":"la négation الحاسمة","body":["« Je ne peux pas » مباشرة وصريحة، « Je ne suis pas en mesure de » أكثر رسمية la bureaucratie.","« Ce n’est pas possible pour le moment » — la temporisation المهذّبة."],"ex":[{"fr":"Je ne suis pas en mesure d’accepter cette condition.","ar":"لست في وضع يسمح لي بقبول هذه الشروط."},{"fr":"Ce n’est pas possible pour le moment.","ar":"غير ممكن حالياً."}]}],"mistakes":[{"wrong":"الهجوم المباشر: « C’est trop cher ! »","right":"« Le prix est au-dessus de mon budget. »","why":"la critique الموضوعية تفتح الحوار لا تُغلقه."},{"wrong":"التخفيض الفوري بلا شرط","right":"« Si vous acceptez X, je peux faire Y. »","why":"كل concession تتطلب la contrepartie."},{"wrong":"« Je veux un remise »","right":"« Je voudrais une remise / une réduction. »","why":"remise مؤنث + la politesse."},{"wrong":"الصمت الطويل بلا مبرر","right":"« Laissez-moi réfléchir. »","why":"la pause الاحترافية تُعلن ولا تُترك."}],"dialogues":[{"title":"العرض الأول","ctx":"بائع مع مشترٍ","lines":[{"who":"Vendeur","fr":"Le prix est de mille euros.","ar":"السعر ألف يورو."},{"who":"Client","fr":"C’est au-dessus de mon budget.","ar":"إنه أعلى من ميزانيتي."},{"who":"Vendeur","fr":"Si vous acceptez, je peux inclure la garantie.","ar":"إذا قبلتم، يمكنني إضافة الضمان."},{"who":"Client","fr":"Je ne peux pas descendre en dessous de huit cents.","ar":"لا أستطيع النزول تحت ثمانمئة."}]},{"title":"التسوية","ctx":"الجولة الأخيرة","lines":[{"who":"Client","fr":"Faisons un compromis.","ar":"لنُبرم تسوية."},{"who":"Vendeur","fr":"D’accord : neuf cents, avec la livraison.","ar":"موافق: تسعمئة، مع التسليم."},{"who":"Client","fr":"C’est noté. On signe quand ?","ar":"سُجّل. نوقّع متى؟"},{"who":"Vendeur","fr":"Dès que possible.","ar":"في أقرب وقت ممكن."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما معنى « la remise »؟","opts":["الخصم","الضمان","الشرط","المهلة"],"a":0,"why":"remise = خصم تجاري."},{"t":"fill","skill":"grammar","q":"أكمل بنمط الافتراض: «Si vous acceptez ce prix, je ___ un geste.»","fr":"Si vous acceptez ce prix, je ___ un geste.","ans":"peux faire","why":"si + présent ثم présent (la réalité)."},{"t":"mcq","skill":"grammar","q":"la négation الحاسمة المهذّبة:","opts":["Je ne suis pas en mesure d’accepter.","Non !","Tu plaisantes ?","C’est impossible, point."],"a":0,"why":"la formalité du travail."},{"t":"order","skill":"writing","q":"رتّب: إذا قبلتم يمكنني تقديم تخفيف","words":["Si","vous","acceptez,","je","peux","faire","un","geste."],"ans":"Si vous acceptez, je peux faire un geste.","why":"si + condition + concession."},{"t":"listen","skill":"listening","q":"ما التعبير لإعلان la limite؟","opts":["Je ne peux pas descendre en dessous de ce seuil.","C’est trop cher.","Combien ça coûte ?","Vous avez remise ?"],"a":0,"why":"seuill = الحد الأدنى."},{"t":"translate","skill":"writing","q":"ترجم: لنُبرم تسوية: الجودة لا السعر.","ans":"Faisons un compromis : la qualité, pas le prix.","why":"compromis + la distinction."},{"t":"speaking","skill":"speaking","q":"تفاوض على سعر منتج: اطلب خصماً ثم قدّم contre-offre مع شرط.","target":"Le prix est… / Si vous…, je peux… / Je ne peux pas…","why":"la tactique التفاوضية."},{"t":"correct","skill":"grammar","q":"صحّح: «Je veux un remise de 10 %.»","ans":"Je voudrais une remise de 10 %.","why":"remise مؤنث + la conditionnelle."}],"homework":"شاهد الفيديو مرتين، ثم اكتب سيناريو تفاوض من ثماني جمل: la demande، la raison، la contre-offre، la concession، ثم la signature — مع جملة si au moins.","sources":[{"title":"Technique de Négociation Commerciale : 3 clés pour négocier comme un PRO !","channel":"Négociation & Vente","videoId":"snurV8Aft2U","why":"ثلاث أساليب تفاوضية فرنسية: la préparation، la proposition، ثم la concession — مع أمثلة حوارية مباشرة.","cat":"Professionnel","level":"B2","main":true},{"title":"Négociation : 10 techniques d’Expert et leurs parades (source: Harvard, FBI, GIGN)","channel":"Growth You","videoId":"aGI7puAXf6w","why":"عشر تقنيات خبراء مع مصادر عالمية — توسيع la stratégie.","cat":"Professionnel","level":"B2","extra":true},{"title":"Demander et Négocier les Prix en Français : Vocabulaire Facile","channel":"Français Facile","videoId":"UcuLRy4NxEY","why":"مفردات الأسعار والتفاوض اليومي — مراجعة سريعة.","cat":"Professionnel","level":"B2","extra":true}],"supplements":[{"id":"aGI7puAXf6w","title":"Négociation : 10 techniques d’Expert et leurs parades (source: Harvard, FBI, GIGN)","channel":"Growth You","why":"عشر تقنيات خبراء مع مصادر عالمية — توسيع la stratégie.","lang":"fr","dur":15},{"id":"UcuLRy4NxEY","title":"Demander et Négocier les Prix en Français : Vocabulaire Facile","channel":"Français Facile","why":"مفردات الأسعار والتفاوض اليومي — مراجعة سريعة.","lang":"fr","dur":8}]},{"id":"b2-t5-l3","fr":"Présentations & exposés professionnels","ar":"العروض التقديمية والعروض الشفوية","objectives":["بناء عرض شفوي منظم: introduction، développement، conclusion","استعمال la langue de transition: « Pour commencer… », « Passons à… »","تمييز la lecture من la présentation: كيف تتفاعل مع la audience","تحليل la structure ثلاثية la phases في la culture الاحترافية الفرنسية"],"sections":[{"h":"الدرس 3: كيف تُقدّم عرضاً احترافياً بالفرنسية","video":{"id":"Fqk7Oq0n4y8","title":"Comment préparer et présenter un exposé oral ?","channel":"Cadrage","why":"منهجية تحضير العرض الشفوي: بنية، la connexion مع la audience، ثم la gestion du temps — مهارات مطلوبة في أي بيئة عمل فرنسية.","lang":"fr","main":true,"dur":10},"p":["العرض في فرنسا يُقاس بـ la clarté لا بـ la durée: ثلاث مراحل واضحة — « Pour commencer… »، « Passons au cœur du sujet… »، « En conclusion… ». la structure هذه هي la signature de la présentation française.","المفردات الأساسية: l’exposé, l’introduction, le développement, la conclusion, une diapositive, un graphique, poser une question, remercier. هذه المفردات أساس la soutenance.","نحوياً، يبرز la transition المنظّمة: « D’une part… d’autre part… », « Cela dit… », « Pour finir… ». هذه الظروف تُحوّل la liste إلى un récit.","الدرس الأهم: لا تقرأ la diapositive. la audience تريد ton regard لا ton écran. la lecture الكاملة تُفقد la crédibilité فوراً.","بعد الدرس، جهّز عرضاً من ثلاث دقائق عن مشروعك: la situation، la solution، ثم le résultat — مع la transition في كل انتقال.","الدرس الثالث يربط la structure avec la crédibilité: la audience الفرنسية la clarté لا la durée. la présentation الناجحة تُبنى على la transition لا la lecture."],"sub":[{"h":"بنية العرض الثلاثية","p":["Pour commencer, je vais présenter le contexte.","Passons au cœur du sujet : les résultats.","En conclusion, je propose trois actions.","Avez-vous des questions ?"]},{"h":"أدوات نطقية: la transition","p":["« Pour commencer… » تُفتتح بنبرة واضحة.","« Passons à… » la liaison مع la diapositive.","« En conclusion… » la descente نبرة الحسم."]},{"h":"خطوات Listen & Repeat","p":["المرة الأولى: اكتب كل تعبير انتقال سمعته.","الثانية: كرّر la transition بنبرة احترافية.","الثالثة: انتقل بين ثلاث مراحل بنبرات مختلفة."]}]},{"h":"عبارات العرض الاحترافي","p":["« Je vais vous présenter… » — la présentation الرسمية la durée + la structure.","« Comme vous pouvez le voir sur ce graphique… » — la référence إلى la diapositive بلا قراءة.","« Pour passer à la suite… » — la transition الطبيعية.","« Merci de votre attention. » — la clôture la plus courante."]},{"h":"التطبيق والتلخيص","p":["تمرين la structure: اكتب خريطة عرض من ثلاث مراحل: la phrase d’accroche، le corps، ثم la conclusion.","تمرين la transition: حوّل ثلاث جمل متصلة بـ « et…et… » إلى la transition المنظمة.","سجّل نفسك تقدّم عرضاً من دقيقتين: la situation، la solution، ثم le résultat — مع تفاعل مع la audience."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: تقديم عرض احترافي منسّق؛ أعد مشاهدة الفيديو الرئيسي وركّز على التقسيم الزمني وتفاعل المقدّم مع الجمهور.","جسر الدروس: من b2-t5-l2 (التفاوض المهني بأساليب الخبراء) إلى b2-t5-l3 (تقديم عرض احترافي منسّق)، ثم إلى b2-t5-l4 حيث تنتقل من العرض الشفوي إلى الكتابة الرسمية المكتوبة (كتابة البريد والرسائل الرسمية).","مهمة تطبيقية: سجّل صوتك في دقيقةٍ واحدة تلخّص فيها أهم ثلاث أفكار من هذا الدرس، واستعمل 3 كلمات جديدة من قاموسه، ثم قارن أدائك بمقتطف من الفيديو الرئيسي وحدّد الفروق."]}],"pron":[{"w":"l’exposé","ipa":"[lɛk.spo.ze]","approx":"ليكسبوزي"},{"w":"la transition","ipa":"[la tʁɑ̃.zi.sjɔ̃]","approx":"لا ترانزيسيون"},{"w":"remercier","ipa":"[ʁə.mɛʁ.sje]","approx":"روميرسيي"}],"vocab":[{"fr":"l’exposé","ar":"العرض/العرض التقديمي","pos":"nom","g":"m","exFr":"L’exposé dure dix minutes.","ipa":"","exAr":"العرض يدوم عشر دقائق."},{"fr":"le préambule","ar":"التمهيد الافتتاحي للعرض","pos":"nom","g":"m","exFr":"Le préambule annonce le plan en trente secondes.","ipa":"[lə pʁe.ɑ̃.byl]","exAr":"يعلن التمهيدُ الخطة في ثلاثين ثانية."},{"fr":"la sève","ar":"جوهر/روح الشيء","pos":"nom","g":"f","exFr":"L’argumentaire s’appuie sur deux graphiques clairs.","ipa":"[laʁ.ɡy.mɑ̃.tɛʁ]","exAr":"تستند سلسلةُ الحجج إلى رسمين بيانيين واضحين."},{"fr":"la touche finale","ar":"اللمسة الختامية للعرض","pos":"nom","g":"f","exFr":"La touche finale de l’exposé est un appel à l’action.","ipa":"[la tuʃ fi.nal]","exAr":"اللمسةُ الختاميةُ للعرض دعوةٌ إلى فعل."},{"fr":"une diapositive","ar":"شريحة العرض","pos":"nom","g":"f","exFr":"Passez à la diapositive suivante.","ipa":"","exAr":"انتقل إلى الشريحة التالية."},{"fr":"un graphique","ar":"رسم بياني","pos":"nom","g":"m","exFr":"Le graphique montre la progression.","ipa":"","exAr":"الرسم البياني يوضّح التقدم."},{"fr":"lancer un échange","ar":"إطلاق حوار مع الجمهور","pos":"loc.","g":"","exFr":"En fin d’exposé, on lance un échange avec le public.","ipa":"[lɑ̃.se œ̃.ne.ʃɑ̃ʒ]","exAr":"في نهاية العرض يُطلق المرءُ حواراً مع الجمهور."},{"fr":"remercier","ar":"يشكر","pos":"verbe","g":"","exFr":"Je remercie l’équipe.","ipa":"","exAr":"أشكر الفريق."},{"fr":"le public / la audience","ar":"الجمهور/الحضور","pos":"nom","g":"m/f","exFr":"Le public est attentif.","ipa":"","exAr":"الجمهور مهتم."},{"fr":"l’ossature","ar":"الهيكل العظمي للعرض","pos":"nom","g":"f","exFr":"L’ossature de l’exposé tient en trois temps.","ipa":"[lɔs.ta.tyʁ]","exAr":"يقوم هيكلُ العرض على ثلاث مراحل."},{"fr":"un point clé","ar":"نقطة أساسية","pos":"nom","g":"m","exFr":"Voici le point clé du projet.","ipa":"","exAr":"هذه النقطة الأساسية للمشروع."},{"fr":"aller droit au but","ar":"يذهب مباشرة إلى المقصود","pos":"loc.","g":"","exFr":"Allons droit au but.","ipa":"","exAr":"لنذهب مباشرة إلى المقصود."}],"examples":[{"fr":"Pour commencer, je vais présenter le contexte.","ar":"للبدء، سأقدّم السياق.","note":"l’accroche"},{"fr":"Passons au cœur du sujet.","ar":"لننتقل إلى صميم الموضوع.","note":"la transition"},{"fr":"Comme vous pouvez le voir sur ce graphique…","ar":"كما ترون على هذا الرسم البياني…","note":"la référence"},{"fr":"D’une part… d’autre part…","ar":"من جهة… ومن جهة أخرى…","note":"la structuration"},{"fr":"En conclusion, je propose trois actions.","ar":"في الخاتمة، أقترح ثلاث إجراءات.","note":"la synthèse"},{"fr":"Merci de votre attention.","ar":"شكراً لانتباهكم.","note":"la clôture"}],"grammar":[{"tFr":"Transitions discursives : pour, cependant, en revanche","tAr":"la transition الخطابية","body":["« Pour commencer… », « Ensuite… », « Pour finir… » — la séquence الزمنية. « Cependant… », « En revanche… » — la relation المنطقية.","« D’une part / d’autre part » la présentation المنظمة la comparaison."],"ex":[{"fr":"Pour commencer, le contexte. Cependant, les chiffres sont préoccupants.","ar":"للبدء، السياق. لكن الأرقام مقلقة."},{"fr":"En revanche, la solution est à portée.","ar":"في المقابل، الحل في المتناول."}]},{"tFr":"Impératif pour guider la audience","tAr":"la impératif لتوجيه la audience","body":["« Passons à la suite. »، « Regardons ce graphique. » — la impératif la présentation يوجّه لا يأمر.","« Notez bien ce point. » — la mise en avant la plus fréquente."],"ex":[{"fr":"Passons à la diapositive suivante.","ar":"ننتقل إلى الشريحة التالية."},{"fr":"Notez bien ce chiffre.","ar":"لاحظوا جيداً هذا الرقم."}]}],"mistakes":[{"wrong":"قراءة la diapositive كلمة بكلمة","right":"« Comme vous pouvez le voir… » + شرح","why":"la lecture تُفقد la crédibilité."},{"wrong":"« Et après… et puis… » (بلا transition)","right":"« Ensuite… cependant… en conclusion… »","why":"la transition تُحوّل la liste إلى un récit."},{"wrong":"« Merci » فقط بلا سياق","right":"« Merci de votre attention. »","why":"la clôture الرسمية."},{"wrong":"la durée المفتوحة","right":"« Je dispose de dix minutes. »","why":"la gestion du temps la plus professionnelle."}],"dialogues":[{"title":"افتتاح العرض","ctx":"مقدّمة المشروع","lines":[{"who":"Présentateur","fr":"Pour commencer, je vais présenter le contexte.","ar":"للبدء، سأقدّم السياق."},{"who":"Présentateur","fr":"Comme vous pouvez le voir, le marché évolue.","ar":"كما ترون، السوق يتغير."},{"who":"Présentateur","fr":"Passons au cœur du sujet : les résultats.","ar":"لننتقل إلى صميم الموضوع: النتائج."},{"who":"Public","fr":"Quelles sont les limites de cette étude ?","ar":"ما حدود هذه الدراسة؟"}]},{"title":"الخاتمة","ctx":"إنهاء العرض والأسئلة","lines":[{"who":"Présentateur","fr":"En conclusion, je propose trois actions.","ar":"في الخاتمة، أقترح ثلاث إجراءات."},{"who":"Présentateur","fr":"Merci de votre attention.","ar":"شكراً لانتباهكم."},{"who":"Public","fr":"Bravo ! Le point clé est convaincant.","ar":"أحسنت! النقطة الأساسية مقنعة."},{"who":"Présentateur","fr":"Merci. Je suis disponible pour des questions.","ar":"شكراً. أنا متاح للأسئلة."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما معنى « l’exposé »؟","opts":["العرض الشفوي","الشريحة","الجمهور","الخاتمة"],"a":0,"why":"exposé = العرض الشفوي."},{"t":"fill","skill":"grammar","q":"أكمل la transition: «___ au cœur du sujet.»","fr":"___ au cœur du sujet.","ans":"Passons","why":"impératif: passer → passons."},{"t":"mcq","skill":"grammar","q":"la clôture الرسمية:","opts":["Merci de votre attention.","Merci !","Voilà, c’est fini.","Ça y est."],"a":0,"why":"la formule la plus professionnelle."},{"t":"order","skill":"writing","q":"رتّب: للبدء سأقدّم السياق","words":["Pour","commencer,","je","vais","présenter","le","contexte."],"ans":"Pour commencer, je vais présenter le contexte.","why":"l’accroche الرسمية."},{"t":"listen","skill":"listening","q":"ما التعبير للانتقال إلى la diapositive؟","opts":["Passons à la suite.","Bonjour.","Merci.","C’est tout."],"a":0,"why":"la transition الطبيعية."},{"t":"translate","skill":"writing","q":"ترجم: من جهة… ومن جهة أخرى…","ans":"D’une part… d’autre part…","why":"la présentation المنظمة."},{"t":"speaking","skill":"speaking","q":"قدّم عرضاً من دقيقتين: la situation، la solution، ثم le résultat — مع transitions.","target":"Pour commencer… / Passons à… / En conclusion…","why":"la structure الثلاثية."},{"t":"correct","skill":"grammar","q":"صحّح: «Et après, les résultats. Et puis, la conclusion.»","ans":"Ensuite, les résultats. En conclusion, la synthèse.","why":"la transition المنظمة."}],"homework":"شاهد الفيديو مرتين، ثم جهّز عرضاً من ثلاث دقائق عن مشروعك: la situation، la solution، le résultat — مع transitions واضحة وسجّله.","sources":[{"title":"Comment préparer et présenter un exposé oral ?","channel":"Cadrage","videoId":"Fqk7Oq0n4y8","why":"منهجية تحضير العرض الشفوي: بنية، la connexion مع la audience، ثم la gestion du temps — مهارات مطلوبة في أي بيئة عمل فرنسية.","cat":"Professionnel","level":"B2","main":true},{"title":"Se Présenter en Français - COURS COMPLET !","channel":"Français avec Pierre","videoId":"TCgKyI8ItTo","why":"منهجية التعريف بالذات الممتدة — la base قبل la présentation الاحترافية.","cat":"Professionnel","level":"B2","extra":true},{"title":"Le vocabulaire du travail","channel":"Français avec Pierre","videoId":"sI-6hVw234g","why":"مفردات العمل الأساسية — la référence قبل la soutenance.","cat":"Professionnel","level":"B2","extra":true}],"supplements":[{"id":"TCgKyI8ItTo","title":"Se Présenter en Français - COURS COMPLET !","channel":"Français avec Pierre","why":"منهجية التعريف بالذات الممتدة — la base قبل la présentation الاحترافية.","lang":"fr","dur":15},{"id":"sI-6hVw234g","title":"Le vocabulaire du travail","channel":"Français avec Pierre","why":"مفردات العمل الأساسية — la référence قبل la soutenance.","lang":"fr","dur":10}]},{"id":"b2-t5-l4","fr":"Correspondance professionnelle","ar":"المراسلات المهنية: البريد والرسائل الرسمية","objectives":["كتابة بريد مهني: la formule d’appel، le corps، la formule de politesse","استعمال la langue écrite formelle: « Je vous prie de… », « Je vous saurais gré de… »","تمييز la lettre officielle عن le mail semi-formel","تحليل la structure ثلاثية la phases في la production écrite B2"],"sections":[{"h":"الدرس 4: كتابة البريد والرسائل الرسمية (DELF B2)","video":{"id":"fJlFCC4Q2Tk","title":"DELF B2 PRODUCTION ÉCRITE - Les 10 thèmes à connaître pour l’examen !","channel":"Français avec Natives","why":"عشرة مواضيع DELF B2 للإنتاج الكتابي: la lettre de motivation، la réclamation، la synthèse — نفس المهارات المهنية.","lang":"fr","main":true,"dur":12},"p":["الكتابة المهنية في فرنسا تخضع لـ la code: la formule d’appel (« Madame, Monsieur, »)، le corps en paragraphes، ثم la formule de politesse (« Je vous prie d’agréer… »). la structure هذه تُقيَّم في DELF B2 وفي la vie professionnelle.","المفردات الأساسية: l’objet, le corps, la formule de politesse, réclamation, candidature, pièce jointe, vous trouverez ci-joint, je reste à votre disposition. هذه المفردات هي la grammaire de l’écrit.","نحوياً، يبرز la subjonctif في la formule: « Je vous prie de bien vouloir… »، « Il est nécessaire que… ». la conditionnelle تظهر في la politesse: « Je vous serais reconnaissant(e) de… ».","الدرس الأهم: l’objet doit être précis. « Réclamation » وحدها لا تكفي — « Réclamation au sujet de la facture n° 456 » هي la formule professionnelle.","بعد الدرس، اكتب بريدين: واحد la réclamation، والآخر la candidature — مع la structure الكاملة في كل منهما.","الدرس الرابع يكشف la code de l’écrit: la formule d’appel، le corps، ثم la politesse — la structure هذه تُقيَّم في DELF B2 وفي la vie professionnelle."],"sub":[{"h":"la structure الرسمية","p":["Objet : Réclamation au sujet de la facture n° 456.","Madame, Monsieur,","Je vous prie de bien vouloir examiner ma demande.","Je reste à votre disposition pour tout complément d’information."]},{"h":"أدوات نطقية: la lecture الصامتة","p":["« l’objet » [lɔb.ʒɛ] — t صامتة.","« ci-joint » [si ʒɛ̃] — liaison واضحة.","« la politesse » [la pɔ.li.tɛs] — t صامتة في آخر."]},{"h":"خطوات Listen & Repeat","p":["المرة الأولى: اكتب la formule d’appel و la politesse.","الثانية: كرّرها بصوت عالٍ لتثبيت la mémoire.","الثالثة: اكتب رسالة قصيرة بنمطها."]}]},{"h":"عبارات الكتابة الرسمية","p":["« Je vous prie de bien vouloir… » — la formule la plus polie la demande.","« Vous trouverez ci-joint… » — la référence إلى la pièce jointe.","« Je reste à votre disposition pour tout complément. » — la clôture la plus courante.","« Dans l’attente de votre réponse, je vous prie d’agréer… » — la formule complète la politesse."]},{"h":"التطبيق والتلخيص","p":["تمرين la structure: اكتب بريدين وهميين: la réclamation، ثم la candidature — مع la formule complète.","تمرين la transition: حوّل ثلاث جمل بسيطة إلى la langue formelle (« Je veux » → « Je souhaiterais »).","سجّل نفسك تقرأ رسالة رسمية بصوت عالٍ — la prononciation de la formule de politesse."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: كتابة البريد والرسائل الرسمية؛ أعد مشاهدة الفيديو الرئيسي وركّز على التركيب الكامل: المُرسِل والموضوع والمتن والمغادرة.","جسر الدروس: من b2-t5-l3 (تقديم عرض احترافي منسّق) إلى b2-t5-l4 (كتابة البريد والرسائل الرسمية)، ثم إلى b2-t5-l5 حيث تنتقل من الكتابة إلى الأداء الشفوي في المقابلة (المقابلة المهنية بمنهجية STAR).","مهمة تطبيقية: اكتب دقيقةً من الكتابة (نحو 100 كلمة) تلخّص فيها أهم ثلاث أفكار من هذا الدرس، واستعمل 3 كلمات جديدة من قاموسه، ثم قارن نصّك بمقتطف من الفيديو الرئيسي وحدّد الفروق."]}],"pron":[{"w":"l’objet","ipa":"[lɔb.ʒɛ]","approx":"لوبجي"},{"w":"ci-joint","ipa":"[si ʒɛ̃]","approx":"سي جان"},{"w":"politesse","ipa":"[pɔ.li.tɛs]","approx":"بوليتيس"}],"vocab":[{"fr":"l’objet","ar":"الموضوع (البريد)","pos":"nom","g":"m","exFr":"L’objet doit être clair.","ipa":"","exAr":"الموضوع يجب أن يكون واضحاً."},{"fr":"la formule d’appel","ar":"صيغة الافتتاح","pos":"nom","g":"f","exFr":"La formule d’appel est « Madame, Monsieur ».","ipa":"","exAr":"صيغة الافتتاح هي «Madame, Monsieur»."},{"fr":"la formule de politesse","ar":"صيغة المجاملة الختامية","pos":"nom","g":"f","exFr":"La formule de politesse est obligatoire.","ipa":"","exAr":"صيغة المجاملة الختامية إلزامية."},{"fr":"réclamation","ar":"شكوى/مطالبة","pos":"nom","g":"f","exFr":"Je vous écris une réclamation.","ipa":"","exAr":"أكتب لكم شكوى."},{"fr":"candidature","ar":"ترشيح/مصادرة","pos":"nom","g":"f","exFr":"Ma candidature est complète.","ipa":"","exAr":"ترشيحي مكتمل."},{"fr":"pièce jointe","ar":"ملف مرفق","pos":"nom","g":"f","exFr":"Vous trouverez la pièce jointe.","ipa":"","exAr":"ستجدون الملف المرفق."},{"fr":"ci-joint","ar":"مرفق","pos":"loc.","g":"","exFr":"Vous trouverez ci-joint le rapport.","ipa":"","exAr":"تجدون مرفقاً التقرير."},{"fr":"je reste à votre disposition","ar":"أنا في خدمتكم","pos":"loc.","g":"","exFr":"Je reste à votre disposition.","ipa":"","exAr":"أنا في خدمتكم."},{"fr":"agréer","ar":"يقبل/يرضى","pos":"verbe","g":"","exFr":"Je vous prie d’agréer mes salutations.","ipa":"","exAr":"أرجو قبول فائق الاحترام."},{"fr":"le délai","ar":"الأجل/المهلة","pos":"nom","g":"m","exFr":"Le délai est de quinze jours.","ipa":"","exAr":"الأجل خمس عشرة يوماً."},{"fr":"un document","ar":"وثيقة","pos":"nom","g":"m","exFr":"Veuillez joindre ce document.","ipa":"","exAr":"يُرجى إرفاق هذه الوثيقة."},{"fr":"signature","ar":"توقيع","pos":"nom","g":"f","exFr":"La signature est en bas.","ipa":"","exAr":"التوقيع في الأسفل."}],"examples":[{"fr":"Objet : Réclamation au sujet de la facture n° 456.","ar":"الموضوع: شكوى بخصوص الفاتورة رقم 456.","note":"l’objet précis"},{"fr":"Madame, Monsieur,","ar":"السيدة/السيد،","note":"la formule d’appel"},{"fr":"Je vous prie de bien vouloir examiner ma demande.","ar":"أرجو التكرم بفحص طلبي.","note":"la subjonctif"},{"fr":"Vous trouverez ci-joint le rapport.","ar":"تجدون مرفقاً التقرير.","note":"la pièce jointe"},{"fr":"Je reste à votre disposition pour tout complément.","ar":"أنا في خدمتكم لأي توضيح.","note":"la clôture"},{"fr":"Je vous prie d’agréer, Madame, Monsieur, mes salutations distinguées.","ar":"تقبلوا فائق الاحترام والتقدير.","note":"la formule complète"}],"grammar":[{"tFr":"Subjonctif dans la formule de politesse","tAr":"la subjonctif في صيغة المجاملة","body":["« Je vous prie de bien vouloir examiner… » — de + infinitif (لا subjonctif هنا). « Il est nécessaire que vous examiniez… » — subjonctif بعد il est nécessaire que.","« Je vous saurais gré de… » — la formule la plus formelle la demande."],"ex":[{"fr":"Je vous prie de bien vouloir répondre.","ar":"أرجو التكرم بالرد."},{"fr":"Il est nécessaire que vous signiez ce document.","ar":"من الضروري أن توقّعوا هذه الوثيقة."}]},{"tFr":"Conditionnel dans la politesse","tAr":"la conditionnelle في المجاملة","body":["« Je vous serais reconnaissant de… » — la conditionnelle la gratitude la demande.","« Je souhaiterais obtenir… » — la version la plus courante la politesse."],"ex":[{"fr":"Je vous serais reconnaissant de me répondre.","ar":"سأكون ممتنّاً لو رددتم عليّ."},{"fr":"Je souhaiterais obtenir un délai supplémentaire.","ar":"أودّ الحصول على مهلة إضافية."}]}],"mistakes":[{"wrong":"« Objet : problème »","right":"« Objet : Réclamation au sujet de la facture n° 456 »","why":"l’objet يجب أن يكون محدداً."},{"wrong":"la salutation بلا la formule","right":"« Je vous prie d’agréer… mes salutations distinguées. »","why":"la clôture الرسمية إلزامية."},{"wrong":"« Je veux un remboursement »","right":"« Je souhaiterais un remboursement. »","why":"la conditionnelle la politesse."},{"wrong":"« Ci-joint le rapport. »","right":"« Vous trouverez ci-joint le rapport. »","why":"la phrase complète la politesse."}],"dialogues":[{"title":"la réclamation","ctx":"عميل يشتري من مزود","lines":[{"who":"Client","fr":"Objet : Réclamation au sujet de la facture.","ar":"الموضوع: شكوى بخصوص الفاتورة."},{"who":"Client","fr":"Je vous prie de bien vouloir examiner ma demande.","ar":"أرجو التكرم بفحص طلبي."},{"who":"Fournisseur","fr":"Nous examinons votre dossier.","ar":"نفحص ملفكم."},{"who":"Client","fr":"Je reste à votre disposition.","ar":"أنا في خدمتكم."}]},{"title":"la candidature","ctx":"متقدم لوظيفة","lines":[{"who":"Candidat","fr":"Vous trouverez ci-joint mon CV.","ar":"تجدون مرفقاً سيرتي الذاتية."},{"who":"Candidat","fr":"Je souhaiterais obtenir un entretien.","ar":"أودّ الحصول على مقابلة."},{"who":"Recruteur","fr":"Nous vous recontacterons.","ar":"سنتواصل معكم."},{"who":"Candidat","fr":"Je vous prie d’agréer mes salutations.","ar":"تقبلوا فائق الاحترام."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما معنى « la pièce jointe »؟","opts":["الملف المرفق","الموضوع","التوقيع","الأجل"],"a":0,"why":"pièce jointe = مرفق."},{"t":"fill","skill":"grammar","q":"أكمل la formule: «Je vous prie de bien vouloir ___ ma demande.»","fr":"Je vous prie de bien vouloir ___ ma demande.","ans":"examiner","why":"de + infinitif (لا subjonctif)."},{"t":"mcq","skill":"grammar","q":"ما صيغة الخاتمة الرسمية في رسالة العمل؟","opts":["Je vous prie d’agréer…","Salut !","Merci, à plus.","Bonne journée."],"a":0,"why":"« Je vous prie d’agréer… » هي la formule de clôture الرسمية الكاملة في المراسلة المهنية."},{"t":"order","skill":"writing","q":"رتّب: تجدون مرفقاً التقرير","words":["Vous","trouverez","ci-joint","le","rapport."],"ans":"Vous trouverez ci-joint le rapport.","why":"la formule الرسمية."},{"t":"listen","skill":"listening","q":"ما la formule d’appel الرسمية؟","opts":["Madame, Monsieur,","Salut !","Bonjour les amis.","Chers copains."],"a":0,"why":"la formule la plus courante."},{"t":"translate","skill":"writing","q":"ترجم: أرجو التكرم بالرد.","ans":"Je vous prie de bien vouloir répondre.","why":"la formule de politesse."},{"t":"speaking","skill":"speaking","q":"اقرأ رسالة رسمية بصوت عالٍ: la formule d’appel، le corps، ثم la politesse.","target":"Madame, Monsieur / Je vous prie de… / Je vous prie d’agréer…","why":"la structure الرسمية."},{"t":"correct","skill":"grammar","q":"صحّح: «Objet : problème.»","ans":"Objet : Réclamation au sujet de la facture n° 456.","why":"l’objet يجب أن يكون محدداً."}],"homework":"شاهد الفيديو مرتين، ثم اكتب بريدين وهميين: la réclamation عن فاتورة، ثم la candidature لوظيفة — مع la structure الكاملة والمجاملة.","sources":[{"title":"DELF B2 PRODUCTION ÉCRITE - Les 10 thèmes à connaître pour l’examen !","channel":"Français avec Natives","videoId":"fJlFCC4Q2Tk","why":"عشرة مواضيع DELF B2 للإنتاج الكتابي: la lettre de motivation، la réclamation، la synthèse — نفس المهارات المهنية.","cat":"Professionnel","level":"B2","main":true},{"title":"🇫🇷 DELF B2 - Comment améliorer la production écrite ?","channel":"Français avec Natives","videoId":"ayV-GvsptfQ","why":"نصائح تحسين الإنتاج الكتابي B2 — la méthodologie.","cat":"Professionnel","level":"B2","extra":true},{"title":"Faire un CV en français - Apprendre le français avec Pierre","channel":"Français avec Pierre","videoId":"llwF3hqrmh4","why":"منهجية كتابة CV بالفرنسية — la base la candidature.","cat":"Professionnel","level":"B2","extra":true}],"supplements":[{"id":"ayV-GvsptfQ","title":"🇫🇷 DELF B2 - Comment améliorer la production écrite ?","channel":"Français avec Natives","why":"نصائح تحسين الإنتاج الكتابي B2 — la méthodologie.","lang":"fr","dur":10},{"id":"llwF3hqrmh4","title":"Faire un CV en français - Apprendre le français avec Pierre","channel":"Français avec Pierre","why":"منهجية كتابة CV بالفرنسية — la base la candidature.","lang":"fr","dur":12}]},{"id":"b2-t5-l5","fr":"Entretien & carrière professionnelle","ar":"المقابلة المهنية والمسار الوظيفي","objectives":["تقديم الذات في la première minute بـ la pitch من ثلاث مراحل","استعمال la méthode STAR: Situation, Tâche, Action, Résultat","تمييز la langue du CV عن la langue de l’oral","تحليل la confiance vs la arrogance في la culture الفرنسية"],"sections":[{"h":"الدرس 5: المقابلة المهنية والتقديم الذاتي (méthode STAR)","video":{"id":"fhc4yYNjrgA","title":"COMMENT BIEN SE PRÉSENTER EN ENTRETIEN ? 🎯","channel":"Coach Carrière","why":"منهجية التقديم الذاتي في المقابلة الفرنسية: le pitch في ثلاث مراحل، la méthode STAR، ثم la gestion du langage corporel.","lang":"fr","main":true,"dur":12},"p":["المقابلة الفرنسية تبدأ بـ « Présentez-vous. » — la minute la plus importante. la méthode la plus efficace: le pitch en trois temps: qui، quoi، pourquoi. la structure هذه تُدرَّب حتى تصبح تلقائية.","المفردات الأساسية: le parcours, la compétence, un projet, un défi, une réussite, la méthode STAR, le poste, l„ntreprise, l’adéquation. هذه المفردات هي la grammaire de l’entretien.","نحوياً، يبرز le passé composé pour le récit professionnel et le futur/proche pour les projets: « J’ai géré… », « Je souhaite contribuer… ». le conditionnel apparaît dans la politesse: « Je serais ravi(e) de… ».","la nuance culturelle: en France, la confiance sans arrogance. « Je suis capable de… » بدل « Je suis le/la meilleur(e)… ». la humilité française تُقيَّم.","بعد الدرس، جهّز le pitch من ثلاثين ثانية: ton parcours، ta compétence clé، ثم ta motivation — وسجّله.","الدرس الخامس يربط le pitch avec la méthode STAR: la première minute la plus importante، la compétence clé la plus mémorable، ثم la motivation la plus convaincante."],"sub":[{"h":"le pitch في ثلاث مراحل","p":["Je m’appelle…, je suis ingénieur depuis cinq ans.","Ma compétence clé est la gestion de projet.","Je souhaite contribuer à votre croissance.","Je serais ravi(e) d’échanger plus en détail."]},{"h":"أدوات نطقية: نبرة la confiance","p":["« je suis capable de… » la fermeté بلا arrogance.","« Je serais ravi(e) de… » la politesse avec le sourire.","« le parcours » [lə paʁ.ksuʁ] — x صوت قوي."]},{"h":"خطوات Listen & Repeat","p":["المرة الأولى: اكتب la structure de la pitch.","الثانية: كرّر la méthode STAR بنبرة واثقة.","الثالثة: سجّل نفسك تقدّم نفسك في 30 ثانية."]}]},{"h":"عبارات la المقابلة","p":["« Je suis capable de… » — la confiance المهذّبة la compétence.","« Mon parcours m’a appris à… » — la leçon tirée la compétence.","« Je serais ravi(e) de contribuer à… » — la motivation la future mission.","« Quelles sont les prochaines étapes ? » — la question la plus professionnelle."]},{"h":"التطبيق والتلخيص","p":["تمرين le pitch: اكتب وسجّل pitch من ثلاثين ثانية: qui، quoi، pourquoi.","تمرين la méthode STAR: اختر تحدياً واحداً وصفه بالصيغة الكاملة.","لعبة الأدوار: مقابلة وهمية — سؤال la présentation، ثم سؤال la compétence، ثم la question la candidate."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: المقابلة المهنية بمنهجية STAR؛ أعد مشاهدة الفيديو الرئيسي وركّز على بناء الإجابة بالقصة: الموقف ثم المهمة ثم الإجراء ثم النتيجة.","جسر الدروس: من b2-t5-l4 (كتابة البريد والرسائل الرسمية) إلى b2-t5-l5 (المقابلة المهنية بمنهجية STAR)، ثم إلى b2-t5-l6 حيث تنتقل من محتوى المقابلة إلى ضبط صيغته اللغوية (التحكّم في المسافة اللغوية: رسمية وتوكيد وافتراض).","مهمة تطبيقية: سجّل صوتك في دقيقةٍ واحدة تلخّص فيها أهم ثلاث أفكار من هذا الدرس، واستعمل 3 كلمات جديدة من قاموسه، ثم قارن أدائك بمقتطف من الفيديو الرئيسي وحدّد الفروق."]}],"pron":[{"w":"le parcours","ipa":"[lə paʁ.ksuʁ]","approx":"لو باركور"},{"w":"la compétence","ipa":"[la kɔ̃.pe.tɑ̃s]","approx":"لا كومبيتانس"},{"w":"ravi(e)","ipa":"[ʁa.vi]","approx":"رافي"}],"vocab":[{"fr":"le parcours","ar":"المسار المهني","pos":"nom","g":"m","exFr":"Mon parcours est varié.","ipa":"","exAr":"مساري متنوع."},{"fr":"la maîtrise","ar":"إتقان المهارة المكتسبة","pos":"nom","g":"f","exFr":"La maîtrise du français est un atout majeur.","ipa":"[la mɛ.tʁiz]","exAr":"إتقانُ الفرنسية ميزةٌ كبرى."},{"fr":"un projet","ar":"مشروع","pos":"nom","g":"m","exFr":"J’ai mené un projet international.","ipa":"","exAr":"قدت مشروعاً دولياً."},{"fr":"un défi","ar":"تحدٍّ","pos":"nom","g":"m","exFr":"Ce poste est un vrai défi.","ipa":"","exAr":"هذا المنصب تحدٍّ حقيقي."},{"fr":"une réussite","ar":"إنجاز","pos":"nom","g":"f","exFr":"Sa réussite est impressionnante.","ipa":"","exAr":"إنجازه مثير للإعجاب."},{"fr":"la méthode STAR","ar":"منهجية ستار","pos":"nom","g":"f","exFr":"Utilise la méthode STAR.","ipa":"","exAr":"استخدم منهجية ستار."},{"fr":"le poste","ar":"المنصب","pos":"nom","g":"m","exFr":"Ce poste correspond à mon profil.","ipa":"","exAr":"هذا المنصب يناسب ملفي."},{"fr":"l’entreprise","ar":"الشركة","pos":"nom","g":"f","exFr":"L’entreprise évolue rapidement.","ipa":"","exAr":"الشركة تتتطور بسرعة."},{"fr":"l’adéquation","ar":"الملاءمة","pos":"nom","g":"f","exFr":"L’adéquation avec le poste est bonne.","ipa":"","exAr":"الملاءمة مع المنصب جيدة."},{"fr":"être capable de","ar":"يكون قادراً على","pos":"loc.","g":"","exFr":"Je suis capable de gérer ce projet.","ipa":"","exAr":"أنا قادر على إدارة هذا المشروع."},{"fr":"contribuer à","ar":"يساهم في","pos":"loc.","g":"","exFr":"Je souhaite contribuer à votre réussite.","ipa":"","exAr":"أودّ المساهمة في نجاحكم."},{"fr":"ravi(e)","ar":"مسرور","pos":"adj.","g":"","exFr":"Je serais ravi(e) d’échanger.","ipa":"","exAr":"سأكون مسروراً بالنقاش."}],"examples":[{"fr":"Je suis capable de gérer ce projet.","ar":"أنا قادر على إدارة هذا المشروع.","note":"la confiance"},{"fr":"Mon parcours m’a appris à…","ar":"علّمني مساري أن…","note":"la leçon"},{"fr":"Je serais ravi(e) de contribuer à…","ar":"سأكون مسروراً بالمساهمة في…","note":"la politesse"},{"fr":"La méthode STAR : Situation, Tâche, Action, Résultat.","ar":"منهجية ستار: الموقف، المهمة، الإجراء، النتيجة.","note":"la structure"},{"fr":"Quelles sont les prochaines étapes ?","ar":"ما الخطوات التالية؟","note":"la question"},{"fr":"J’ai mené un projet international avec succès.","ar":"قدت مشروعاً دولياً بنجاح.","note":"passé composé"}],"grammar":[{"tFr":"Passé composé pour le récit professionnel","tAr":"passé composé للسرد المهني","body":["« J’ai géré une équipe de dix personnes. » — passé composé للإنجازات. « Je travaillais sur… » — imparfait للسياق.","« J’ai contribué à… » la tournure la plus valorisée."],"ex":[{"fr":"J’ai mené un projet de digitalisation.","ar":"قدت مشروعاً للرقمنة."},{"fr":"Je travaillais dans une start-up.","ar":"كنت أعمل في شركة ناشئة."}]},{"tFr":"Conditionnel pour la politesse et la projection","tAr":"la conditionnelle للمجاملة والتمثيل","body":["« Je serais ravi(e) de… » — la politesse la motivation. « Je pourrais apporter… » — la projection la compétence.","le conditionnel donne la nuance entre la promesse et la possibilité."],"ex":[{"fr":"Je serais ravi(e) de rejoindre votre équipe.","ar":"سأكون مسروراً بالانضمام إلى فريقكم."},{"fr":"Je pourrais apporter mon expertise.","ar":"يمكنني إضافة خبرتي."}]}],"mistakes":[{"wrong":"« Je suis le meilleur candidat. »","right":"« Je suis capable de… »","why":"la confiance بلا arrogance."},{"wrong":"la lecture de la réponse","right":"la réponse spontanée mais structurée","why":"la lecture تُفقد la crédibilité."},{"wrong":"« Je ne sais pas. » مباشرة","right":"« Je ne sais pas, mais je peux me renseigner. »","why":"la transparence + la proactivité."},{"wrong":"« Combien est le salaire ? » كسؤال أول","right":"« Quelles sont les prochaines étapes ? »","why":"la priorité la mission لا la rémunération."}],"dialogues":[{"title":"الافتتاح","ctx":"recruteur يطلب la présentation","lines":[{"who":"Recruteur","fr":"Présentez-vous en trente secondes.","ar":"قدّموا أنفسكم في ثلاثين ثانية."},{"who":"Candidat","fr":"Je m’appelle…, ingénieur depuis cinq ans.","ar":"اسمي…، مهندس منذ خمس سنوات."},{"who":"Candidat","fr":"Ma compétence clé est la gestion de projet.","ar":"كفاءتي الأساسية هي إدارة المشاريع."},{"who":"Recruteur","fr":"Pourquoi ce poste vous intéresse ?","ar":"لماذا يهمك هذا المنصب؟"}]},{"title":"la méthode STAR","ctx":"candidat يصف تحدياً","lines":[{"who":"Candidat","fr":"J’ai mené un projet international avec succès.","ar":"قدت مشروعاً دولياً بنجاح."},{"who":"Recruteur","fr":"Quel était le défi principal ?","ar":"ما كان التحدي الأساسي؟"},{"who":"Candidat","fr":"La coordination entre trois fuseaux horaires.","ar":"التنسيق بين ثلاث مناطق زمنية."},{"who":"Recruteur","fr":"Impressionnant. Quelles sont les prochaines étapes ?","ar":"مثير للإعجاب. ما الخطوات التالية؟"}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما معنى « le parcours »؟","opts":["المسار المهني","المشروع","المنصب","الشركة"],"a":0,"why":"parcours = المسار."},{"t":"fill","skill":"grammar","q":"أكمل بنمط la confiance: «Je ___ capable de gérer ce projet.»","fr":"Je ___ capable de gérer ce projet.","ans":"suis","why":"être + capable de."},{"t":"mcq","skill":"grammar","q":"la nuance المهذّبة:","opts":["Je suis capable de gérer ce projet.","Je suis le meilleur.","Je sais tout.","Personne ne peut rivaliser."],"a":0,"why":"la confiance بلا arrogance."},{"t":"order","skill":"writing","q":"رتّب: علّمني مساري أن أكون قائداً","words":["Mon","parcours","m’a","appris","à","être","leader."],"ans":"Mon parcours m’a appris à être leader.","why":"passé composé + infinitif."},{"t":"listen","skill":"listening","q":"ما la structure de la méthode STAR؟","opts":["Situation, Tâche, Action, Résultat","Salut, Truc, Astuce, Résultat","Simple, Très, Agile, Rapide","Stop, Think, Act, Run"],"a":0,"why":"la méthode classique."},{"t":"translate","skill":"writing","q":"ترجم: سأكون مسروراً بالانضمام إلى فريقكم.","ans":"Je serais ravi(e) de rejoindre votre équipe.","why":"conditionnel la politesse."},{"t":"speaking","skill":"speaking","q":"جهّز pitch من ثلاثين ثانية: qui، quoi، pourquoi — وسجّله.","target":"Je m’appelle… / Ma compétence clé… / Je souhaite…","why":"la structure du pitch."},{"t":"correct","skill":"grammar","q":"صحّح: «Je suis le meilleur candidat.»","ans":"Je suis capable de gérer ce projet.","why":"la confiance بلا arrogance."}],"homework":"شاهد الفيديو مرتين، ثم اكتب وسجّل pitch من ثلاثين ثانية + وصف تحدٍّ بالمنهجية STAR — بالفرنسية.","sources":[{"title":"COMMENT BIEN SE PRÉSENTER EN ENTRETIEN ? 🎯","channel":"Coach Carrière","videoId":"fhc4yYNjrgA","why":"منهجية التقديم الذاتي في المقابلة الفرنسية: le pitch في ثلاث مراحل، la méthode STAR، ثم la gestion du langage corporel.","cat":"Professionnel","level":"B2","main":true},{"title":"La méthode STAR en entretien d’embauche + exemple de questions / réponses !","channel":"Coach Carrière","videoId":"MHoEZkPw3uk","why":"شرح la méthode STAR مع أمثلة أسئلة وإجابات كاملة.","cat":"Professionnel","level":"B2","extra":true},{"title":"Modèle de Lettre de motivation","channel":"Campus France","videoId":"XCSDhs8N2Rs","why":"نموذج lettre de motivation — la connexion entre la candidature et l’entretien.","cat":"Professionnel","level":"B2","extra":true}],"supplements":[{"id":"MHoEZkPw3uk","title":"La méthode STAR en entretien d’embauche + exemple de questions / réponses !","channel":"Coach Carrière","why":"شرح la méthode STAR مع أمثلة أسئلة وإجابات كاملة.","lang":"fr","dur":12},{"id":"XCSDhs8N2Rs","title":"Modèle de Lettre de motivation","channel":"Campus France","why":"نموذج lettre de motivation — la connexion entre la candidature et l’entretien.","lang":"fr","dur":8}]},{"id":"b2-t5-l6","fr":"Registres de langue & hypothèses","ar":"مساحات اللغة المتقدمة: la formalité والافتراض","objectives":["التمييز بين la formel، la courant، la familier في la situation الحياتية","استعمال la conditionnelle والsubjonctif في الافتراضات المتقدمة","تحليل كيف يعكس la registre la relation الاجتماعية","إتقان la bascule بين la langue du travail et la langue des amis"],"sections":[{"h":"الدرس 6: la registre الفرنسية والشرط والافتراض (B2/C1)","video":{"id":"5QAZ_DJrx1o","title":"Cours de français : le registre familier","channel":"Français Authentique","why":"شرح la registre de langue: formel، courant، familier — كيف تتغيّر la langue مع l’interlocuteur والمناسبة.","lang":"fr","main":true,"dur":10},"p":["la langue française لديها la carte la plus طبيعية: même المعنى يُقال بثلاث صيغ حسب la relation. « Pourriez-vous… » في العمل، « Tu peux… » مع الأصدقاء، « Fous le camp ! » في la rue. la registre ليست قواعد بل la carte sociale.","المفردات essentielles: le registre formel, courant, familier, le tutoiement, le vouvoiement, l’argot, la tournure, l’hypothèse, la condition, l’incertitude. هذه المفردات تفتح la porte إلى la France authentique.","نحوياً، يظهر subjonctif في الافتراض والشك: « Il se peut que… », « Bien que… », « Pour que… ». la conditionnelle تظهر في la possibilité: « Si j’avais le temps, je… ».","la nuance la plus avancée: la politesse لا تُحذف مع la familiarité. « Tu peux… » مع le prénom، « Tu peux… ! » مع le ton — la nuance في la voix لا dans les mots.","بعد الدرس، حوّل ثلاث جمل من la formel إلى la familier مع الحفاظ على le respect — la bascule la plus difficile la plus utile.","الدرس السادس ي révèle la carte sociale de la langue: la registre la plus dans la voix pas dans les mots، la bascule la plus difficile la plus utile."],"sub":[{"h":"la registre الثلاثية","p":["Pourriez-vous m’aider ? (formel)","Tu peux m’aider ? (courant)","Tu m’aides ? (familier)","Je te demande un service, quand même ! (la réclamation)"]},{"h":"أدوات نطقية: la bascule la ton","p":["« Pourriez-vous… » la voix نبرة رسمية.","« Tu peux… » la liaison مع le prénom.","« Tu m’aides ? » la montée la voix la demande."]},{"h":"خطوات Listen & Repeat","p":["المرة الأولى: اكتب la registre لكل جملة.","الثانية: كرّرها بثلاث نبرات مختلفة.","الثالثة: حوّل la phrase formelle إلى la familier مع le respect."]}]},{"h":"عبارات la bascule","p":["« Bien que… + subjonctif » = رغم أن… — la concession la plus élégante.","« Il se peut que… + subjonctif » = من المحتمل أن… — l’incertitude la politesse.","« Pour que… + subjonctif » = لكي… — le but la subjonctif.","« Si j’avais…, je… » — la condition la irréelle le passé."]},{"h":"التطبيق والتلخيص","p":["تمرين la bascule: حوّل ثلاث جمل عمل إلى la familier مع le respect.","تمرين subjonctif: اكتب ثلاث جمل la possibilité (il se peut que)، ثم ثلاث la concession (bien que).","سجّل نفسك تشرح la différence entre la formel et la familier في 40 ثانية بالفرنسية."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: التحكّم في المسافة اللغوية: رسمية وتوكيد وافتراض؛ أعد مشاهدة الفيديو الرئيسي وركّز على الحِلف الجيّد وتحوّلات التوكيد.","جسر الدروس: من b2-t5-l5 (المقابلة المهنية بمنهجية STAR) إلى b2-t5-l6 (التحكّم في المسافة اللغوية: رسمية وتوكيد وافتراض)، ثم إلى b2-t6-l1 حيث تنتقل من إنتاج الكلام إلى فهم نشرة الأخبار (فهم نشرة الأخبار التلفزيونية).","مهمة تطبيقية: سجّل صوتك في دقيقةٍ واحدة تلخّص فيها أهم ثلاث أفكار من هذا الدرس، واستعمل 3 كلمات جديدة من قاموسه، ثم قارن أدائك بمقتطف من الفيديو الرئيسي وحدّد الفروق."]}],"pron":[{"w":"le registre","ipa":"[lə ʁə.ʒistʁ]","approx":"لو روجيستر"},{"w":"bien que","ipa":"[bjɛ̃ kə]","approx":"بيان كـ"},{"w":"il se peut que","ipa":"[il sə pø kə]","approx":"إل سي بـ كـ"}],"vocab":[{"fr":"le registre formel","ar":"la المستوى الرسمي","pos":"nom","g":"m","exFr":"Le registre formel est utilisé au travail.","ipa":"","exAr":"la المستوى الرسمي يُستخدم في العمل."},{"fr":"le registre courant","ar":"المسجّل العادي: لغة يومية محايدة","pos":"nom","g":"m","exFr":"Dans un mail professionnel, on privilégie le registre courant.","ipa":"[lə ʁəʒistʁ kuʁɑ̃]","exAr":"في البريد المهني يُفضَّل المسجّلُ العادي."},{"fr":"la proximité","ar":"قُرب العلاقة بين المتخاطبين","pos":"nom","g":"f","exFr":"Le tutoiement marque la proximité entre collègues.","ipa":"[la pʁɔ.si.mi.te]","exAr":"يُوحي التخاطبُ بالمفردةِ بقُرب العلاقة بين الزملاء."},{"fr":"la déférence","ar":"التسليم الاحترامي للمخاطب","pos":"nom","g":"f","exFr":"La déférence guide la correspondance avec un ministre.","ipa":"[la de.fe.ʁɑ̃s]","exAr":"يُوجّه الاحترامُ المراسلةَ مع وزير."},{"fr":"l’argot","ar":"la العامية/la الشارعية","pos":"nom","g":"m","exFr":"L’argot évolue rapidement.","ipa":"","exAr":"la العامية تتتطور بسرعة."},{"fr":"la tournure","ar":"la الصيغة/la التعبيرية","pos":"nom","g":"f","exFr":"La tournure est plus polie.","ipa":"","exAr":"la الصيغة أكثر مجاملة."},{"fr":"l’éventualité","ar":"احتمال وقوع الحدث","pos":"nom","g":"f","exFr":"Il tient compte de l’éventualité d’un report.","ipa":"[le.vɑ̃.ty.a.li.te]","exAr":"يحتسب احتمالَ التأجيل."},{"fr":"la condition","ar":"la الشرط","pos":"nom","g":"f","exFr":"La condition est claire.","ipa":"","exAr":"la الشرط واضح."},{"fr":"l’incertitude","ar":"la عدم اليقين","pos":"nom","g":"f","exFr":"L’incertitude est grande.","ipa":"","exAr":"la عدم اليقين كبير."},{"fr":"bien que","ar":"la رغم أن","pos":"loc.","g":"","exFr":"Bien qu’il soit fatigué, il travaille.","ipa":"","exAr":"la رغم أنه متعب، لكنه يعمل."},{"fr":"il se peut que","ar":"la من المحتمل أن","pos":"loc.","g":"","exFr":"Il se peut que je sois en retard.","ipa":"","exAr":"la من المحتمل أن أتأخر."},{"fr":"pour que","ar":"la لكي","pos":"loc.","g":"","exFr":"Je travaille pour que tout soit prêt.","ipa":"","exAr":"la أعمل لكي يكون كل شيء جاهزاً."}],"examples":[{"fr":"Pourriez-vous m’aider ?","ar":"هل يمكنك مساعدتي؟","note":"la formel"},{"fr":"Tu peux m’aider ?","ar":"هل يمكنك مساعدتي؟","note":"la courant"},{"fr":"Tu m’aides ?","ar":"تساعدني؟","note":"la familier"},{"fr":"Bien qu’il soit fatigué, il travaille.","ar":"la رغم أنه متعب، لكنه يعمل.","note":"la concession + subjonctif"},{"fr":"Il se peut que je sois en retard.","ar":"la من المحتمل أن أتأخر.","note":"l’incertitude + subjonctif"},{"fr":"Si j’avais le temps, je voyageais.","ar":"لو كان لديّ وقت، كنت أسافر.","note":"la condition irréelle"}],"grammar":[{"tFr":"Subjonctif dans la concession et l’hypothèse","tAr":"la subjonctif في la concession والافتراض","body":["« Bien qu’il soit fatigué… » — bien que + subjonctif. « Il se peut que je sois… » — il se peut que + subjonctif.","« Pour que tout soit prêt… » — pour que + subjonctif. les trois structures هي la signature de la langue avancée."],"ex":[{"fr":"Bien que le budget soit limité, le projet continue.","ar":"la رغم أن الميزانية محدودة، المشروع يستمر."},{"fr":"Il se peut que la réunion soit reportée.","ar":"la من المحتمل أن يُؤجّل الاجتماع."}]},{"tFr":"Conditionnel passé pour la condition irréelle","tAr":"la conditionnelle past للcondition irréelle","body":["« Si j’avais le temps, je voyagerais. » — si + imparfait، ثم conditionnel présent (الافتراض في الحاضر). « Si j’avais su, j’aurais agi. » — si + plus-que-parfait، ثم conditionnel passé (الافتراض في الماضي).","la nuance: la première قابلة للتحقق، la deuxième la regret."],"ex":[{"fr":"Si j’avais le temps, je voyagerais.","ar":"لو كان لديّ وقت، كنت أسافر."},{"fr":"Si j’avais su, j’aurais répondu autrement.","ar":"لو كنت أعلم، لكنت رددت بشكل مختلف."}]}],"mistakes":[{"wrong":"la bascule بلا respect: « Tu veux quoi ? » لـ le supérieur","right":"« Que souhaitez-vous ? »","why":"la formel تبقى مع le tutoiement."},{"wrong":"« Bien qu’il soit… » مع l’indicatif","right":"« Bien qu’il soit fatigué » (subjonctif)","why":"bien que exige toujours le subjonctif."},{"wrong":"« Si j’ai le temps, je voyageais »","right":"« Si j’avais le temps, je voyagerais. »","why":"la condition irréelle: si + imparfait + conditionnel."},{"wrong":"la lecture de la registre","right":"la nuance dans la voix","why":"la registre la plus dans la voix pas dans les mots."}],"dialogues":[{"title":"la bascule","ctx":"نفس الجملة بثلاث صيغ","lines":[{"who":"Patron","fr":"Pourriez-vous préparer le rapport ?","ar":"هل يمكنك تجهيز التقرير؟"},{"who":"Collègue","fr":"Tu peux préparer le rapport ?","ar":"هل يمكنك تجهيز التقرير؟"},{"who":"Ami","fr":"Tu m’aides avec ce rapport ?","ar":"تساعدني مع هذا التقرير؟"},{"who":"Ami","fr":"Franchement, tu m’aides ou pas ?","ar":"بصراحة، تساعدني أم لا؟"}]},{"title":"la concession","ctx":"نقاش la possibilité","lines":[{"who":"Marc","fr":"Bien que le budget soit limité, le projet continue.","ar":"la رغم أن الميزانية محدودة، المشروع يستمر."},{"who":"Nadia","fr":"Il se peut que nous ayons besoin de plus de temps.","ar":"la من المحتمل أن نحتاج وقتاً أكثر."},{"who":"Marc","fr":"Si j’avais le temps, je travaillerais plus.","ar":"لو كان لديّ وقت، كنت سأعمل أكثر."},{"who":"Nadia","fr":"On fait au mieux, alors.","ar":"نفعل أفضل ما يمكن، إذن."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما معنى « le registre »؟","opts":["la مستوى اللغة","la الشكل","la الحجم","la اللون"],"a":0,"why":"registre = la مستوى la langue."},{"t":"fill","skill":"grammar","q":"أكمل la subjonctif: «Bien qu’il ___ fatigué, il travaille.»","fr":"Bien qu’il ___ fatigué, il travaille.","ans":"soit","why":"bien que + subjonctif: être → soit."},{"t":"mcq","skill":"grammar","q":"la condition irréelle الصحيحة:","opts":["Si j’avais le temps, je voyagerais.","Si j’ai le temps, je voyage.","Si j’aurai le temps, je voyagerai.","Si j’avais le temps, je voyage."],"a":0,"why":"si + imparfait + conditionnel."},{"t":"order","skill":"writing","q":"رتّب: رغم أنه متعب لكنه يعمل","words":["Bien","qu’il","soit","fatigué,","il","travaille."],"ans":"Bien qu’il soit fatigué, il travaille.","why":"bien que + subjonctif."},{"t":"listen","skill":"listening","q":"ما la tournure la formel la la demande؟","opts":["Pourriez-vous… ?","Tu peux… ?","Tu m’aides… ?","Fous le camp… ?"],"a":0,"why":"la conditionnelle + vouvoiement."},{"t":"translate","skill":"writing","q":"ترجم: من المحتمل أن أتأخر.","ans":"Il se peut que je sois en retard.","why":"il se peut que + subjonctif."},{"t":"speaking","skill":"speaking","q":"حوّل ثلاث جمل عمل إلى la familier مع le respect — وسجّلها.","target":"Tu peux… / Tu m’aides… / Franchement…","why":"la bascule la registre."},{"t":"correct","skill":"grammar","q":"صحّح: «Bien qu’il est fatigué, il travaille.»","ans":"Bien qu’il soit fatigué, il travaille.","why":"bien que + subjonctif."}],"homework":"شاهد الفيديو مرتين، ثم اكتب فقرة من خمس جمل تشرح فيها la différence بين la formel و la familier مع أمثلتك — ثم حوّل ثلاث جمل عمل إلى la familier.","sources":[{"title":"Cours de français : le registre familier","channel":"Français Authentique","videoId":"5QAZ_DJrx1o","why":"شرح la registre de langue: formel، courant، familier — كيف تتغيّر la langue مع l’interlocuteur والمناسبة.","cat":"Professionnel","level":"B2","main":true},{"title":"La formation du subjonctif niveau avancé B2 C1","channel":"Université Oran2","videoId":"DzTBDKW724Y","why":"شرح la subjonctif المتقدم — la base la structures الافتراضية.","cat":"Professionnel","level":"B2","extra":true},{"title":"L’hypothèse en français, CONDITIONNEL ou SUBJONCTIF 🤔⁉️","channel":"Français Authentique","videoId":"ILyL7fN3dY4","why":"la nuance la conditionnelle والsubjonctif في الافتراض — la leçon la plus difficile B2.","cat":"Professionnel","level":"B2","extra":true}],"supplements":[{"id":"DzTBDKW724Y","title":"La formation du subjonctif niveau avancé B2 C1","channel":"Université Oran2","why":"شرح la subjonctif المتقدم — la base la structures الافتراضية.","lang":"fr","dur":20},{"id":"ILyL7fN3dY4","title":"L’hypothèse en français, CONDITIONNEL ou SUBJONCTIF 🤔⁉️","channel":"Français Authentique","why":"la nuance la conditionnelle والsubjonctif في الافتراض — la leçon la plus difficile B2.","lang":"fr","dur":12}]}]},{"id":"b2-t6","slug":"francais-medias","icon":"video","color":"#d32f2f","fr":"Français des médias","ar":"الفرنسية الإعلامية","desc":"le journal télévisé، le reportage، l’éditorial، le documentaire، la publicité، les réseaux sociaux — la langue la médias.","lessons":[{"id":"b2-t6-l1","fr":"Comprendre le journal télévisé","ar":"فهم نشرة الأخبار التلفزيونية","objectives":["التعرّف على بنية le journal télévisé: la une, les brèves, le reportage, la conclusion","التقاط les chiffres clés و les noms propres في flux سريع من la parole","تمييز la voix du présentateur عن la voix du journaliste de terrain","استعمال connecteurs de l’information: selon, d’après, environ, en revanche"],"sections":[{"h":"الدرس 1: كيف تتابع نشرة الأخبار الفرنسية وتفهمها","video":{"id":"Rz5qJ-G7H4E","title":"ALGÉRIE : 61 MAROCAINS ARRÊTÉS POUR SABOTAGE ? MEHDI GHEZZAR EXPLOSE !","channel":"Colombia TV","why":"نشرة إخبارية مباشرة بصيغة le journal télévisé: تقديم الخبر، la transition بين المواد، ثم la réaction — بالضبط ما يحتاجه مستمع B2 لفهم الإيقاع السريع للأخبار.","lang":"fr","main":true,"dur":3},"p":["la une تفتح النشرة دائماً بـ le titre le plus fort: « À la une… » ثم « Autrement… » أو « Et aussi… » للانتقال إلى المادة الثانية. في المستوى B2، مهمتك ليست فهم كل كلمة بل تتبع la charpente de l’information.","المفردات الأساسية: le journal télévisé, la une, la brève, le reportage, l’interview, le communiqué, le témoin, le porte-parole, l’actualité, selon, d’après, environ. هذه المفردات هي la grammaire de la news.","نحوياً، يعتمد le langage journalistique على le passé composé للحدث و le présent للتحليل: « Le président a signé… », « Le gouvernement affirme que… ». الاقتباس يظهر بصيغة « selon… » أو « d’après… » دون فاعل حقيقي.","le chiffre هو عصب la nouvelle: « près de 30 % », « environ 12 000 personnes ». تدرّب على التقاط الأرقام قبل الكلمات — فهي أول ما يُطلب منك في la compréhension orale.","لاحظ la neutralité: le présentateur لا يعبّر عن رأيه بل ينقل، و le journaliste de terrain يستعمل la première personne فقط عند la citation. هذا الفرق بين la voix officielle et la voix terrain.","بعد الدرس: شاهد نشرة فرنسية بدون صوت ثم اكتب la une من ثلاث مواد، ثم أعد المشاهدة مع الصوت وصحّح ما فاتك من chiffres et noms propres."],"sub":[{"h":"بنية النشرة","p":["À la une ce soir : le sommaire du jour.","Trois minutes pour les brèves, puis un reportage sur place.","Pour finir, l’essentiel de l’actualité internationale."]},{"h":"أدوات نطقية: la neutralité","p":["« Selon les premiers éléments… » تُنطق بنبرة محايدة — la prudence في la voix.","« d’après notre envoyé spécial » [da pʁa nɔtʁ ɑ̃.vwa.je spɛ.sjɛl] — liaison واضحة.","« environ 12 000 » [ɑ̃.vɛʁʁɔ̃] — le chiffre يُضغط ولا يُهمل."]},{"h":"خطوات Listen & Repeat","p":["المرة الأولى: اكتب فقط la une et les chiffres.","الثانية: أضف les verbes au passé composé.","الثالثة: أعد الرواية بثلاث جمل بصوتك."]}]},{"h":"تعبيرات النشرة الإخبارية","p":["« À la une… » = في الأخبار البارزة… — la porte d’entrée لكل نشرة.","« Selon les premiers éléments… » = وفقاً للعناصر الأولى — la formule la plus prudente.","« Nous étions sur place… » = كنا في الميدان — la signature du reporter.","« Pour réagir, nous avons interrogé… » = للتعليق، استجعنا… — la transition vers l’interview."]},{"h":"التطبيق والتلخيص","p":["تمرين la une: اقرأ ثلاث عناوين إخبارية واكتب لكل واحدة جملة تمهيدية بصيغة « À la une… ».","تمرين les chiffres: استمع لدقيقتين من النشرة واكتب كل رقم سمعته مع وحدته (pour cent, milliers, euros).","سجّل نفسك تقدّم نشرة من 30 ثانية: une، brèves، reportage، ثم la conclusion — بنفس نبرة le présentateur."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: فهم نشرة الأخبار التلفزيونية؛ أعد مشاهدة الفيديو الرئيسي وركّز على بنية النشرة وتوزيع المواضيع وانتقالاتها.","جسر الدروس: من b2-t5-l6 (التحكّم في المسافة اللغوية: رسمية وتوكيد وافتراض) إلى b2-t6-l1 (فهم نشرة الأخبار التلفزيونية)، ثم إلى b2-t6-l2 حيث تنتقل من الاستوديو إلى المراسلة الميدانية والمقابلة (المراسلة الميدانية والمقابلة الصحفية).","مهمة تطبيقية: سجّل صوتك في دقيقةٍ واحدة تلخّص فيها أهم ثلاث أفكار من هذا الدرس، واستعمل 3 كلمات جديدة من قاموسه، ثم قارن أدائك بمقتطف من الفيديو الرئيسي وحدّد الفروق."]}],"pron":[{"w":"le journal télévisé","ipa":"[lə ʒuʁnal te.le.vi.ze]","approx":"لو جورنال تيليڤيزيه"},{"w":"le reportage","ipa":"[lə ʁəpɔʁtaʒ]","approx":"لو روبورتاج"},{"w":"l’actualité","ipa":"[la.ktya.li.te]","approx":"لاكتيواليتي"}],"vocab":[{"fr":"le journal télévisé","ar":"نشرة الأخبار التلفزيونية","pos":"nom","g":"m","exFr":"Le journal commence à vingt heures.","ipa":"","exAr":"تبدأ النشرة في العاشرة ليلاً."},{"fr":"la une","ar":"الخبر الرئيسي","pos":"nom","g":"f","exFr":"La une du jour parle du budget.","ipa":"","exAr":"خبر اليوم الرئيسي يتحدث عن الميزانية."},{"fr":"la brève","ar":"الخبر الموجز","pos":"nom","g":"f","exFr":"Une brève sur le sport clôt le journal.","ipa":"","exAr":"خبر موجز عن الرياضة يختم النشرة."},{"fr":"le reportage","ar":"المراسلة الميدانية","pos":"nom","g":"m","exFr":"Le reportage dure cinq minutes.","ipa":"","exAr":"تستمر المراسلة خمس دقائق."},{"fr":"le communiqué","ar":"البيان","pos":"nom","g":"m","exFr":"Le ministère a publié un communiqué.","ipa":"","exAr":"نشر وزارة بياناً."},{"fr":"le témoin","ar":"الشاهد","pos":"nom","g":"m","exFr":"Un témoin a décrit la scène.","ipa":"","exAr":"وصف شاهد المشهد."},{"fr":"le porte-parole","ar":"المتحدث الرسمي","pos":"nom","g":"m","exFr":"Le porte-parole a refusé de commenter.","ipa":"","exAr":"رفض المتحدث التعليق."},{"fr":"selon / d’après","ar":"وفقًا لـ / بحسب","pos":"loc.","g":"","exFr":"Selon la police, deux personnes ont été arrêtées.","ipa":"","exAr":"وفقًا للشرطة، أُلقي القبض على شخصين."},{"fr":"environ","ar":"حوالي","pos":"adv.","g":"","exFr":"Environ mille personnes ont participé.","ipa":"","exAr":"شارك حوالي ألف شخص."},{"fr":"couvrir l’actualité","ar":"تغطية الأخبار","pos":"loc.","g":"","exFr":"La chaîne couvre l’actualité en direct.","ipa":"","exAr":"تغطي القناة الأخبار مباشرة."},{"fr":"le direct","ar":"البث المباشر","pos":"nom","g":"m","exFr":"Nous partons en direct sur Lyon.","ipa":"","exAr":"ننتقل مباشرة إلى ليون."},{"fr":"interrompre","ar":"يقطع","pos":"verbe","g":"","exFr":"Le journaliste a interrompu son récit.","ipa":"","exAr":"قطع المراسل روايته."}],"examples":[{"fr":"À la une : la réforme des retraites.","ar":"الخبر الرئيسي: إصلاح التقاعد.","note":"la une"},{"fr":"Selon les premiers éléments, aucun blessé n’est à déplorer.","ar":"وفقًا للعناصر الأولى، لا يوجد مصابون.","note":"la prudence"},{"fr":"Environ 12 000 personnes ont manifesté.","ar":"شارك حوالي 12 ألف شخص في التظاهرة.","note":"le chiffre"},{"fr":"Nous étions sur place à l’aube.","ar":"كنا في الميدان عند الفجر.","note":"la signature du reporter"},{"fr":"Le gouvernement affirme que le texte restera en vigueur.","ar":"تؤكد الحكومة أن النص سيبقى سارياً.","note":"le verbe de déclaration"},{"fr":"Le ministère a publié un communiqué de presse.","ar":"نشرت وزارة بياناً صحيفياً.","note":"la source officielle"}],"grammar":[{"tFr":"Les verbes de déclaration dans la langue journalistique","tAr":"أفعال التصريح في لغة الإعلام","body":["la langue journalistique تستبدل le verbe dire بأفعال دقيقة: affirmer, préciser, indiquer, souligner, nier, ajouter. كل فعل يحدّد le degré de certitude.","« Le ministère a précisé que… », « la préfecture a indiqué… » — la source تحل محل le sujet grammatical، وهذا ما يمنح la neutralité."],"ex":[{"fr":"Le ministère a précisé que la mesure s’applique dès lundi.","ar":"أكدت الوزارة أن الإجراء يطبق من الاثنين."},{"fr":"Le syndicat a nié toute responsabilité.","ar":"نفى الاتحاد المسؤولية عن كل ما وقع."}]},{"tFr":"Passé composé pour le fait, présent pour l’analyse","tAr":"الماضي المركب للحدث والمضارع للتحليل","body":["le fait يُروى بالماضي المركب: « Le conseil a voté le texte. »، بينما la conséquence تبقى في المضارع: « la mesure entre en vigueur. »","« selon » و « d’après » يحلان محل le sujet في la citation: « Selon l’Insee, l’inflation ralentit. » — la source تُذكر ولا يُصرَّح بها كفاعل."],"ex":[{"fr":"Le conseil a voté le texte, la mesure entre en vigueur en janvier.","ar":"صوّت المجلس على النص، والإجراء يسري من يناير."},{"fr":"D’après l’enquête, deux Français sur trois sont favorables.","ar":"وفقًا للمسح، ثلثا الفرنسيين موافقون."}]}],"mistakes":[{"wrong":"« Je pense que le gouvernement a tort… »","right":"« Selon le gouvernement, la mesure est nécessaire. »","why":"la neutralité تمنع le commentaire personnel dans le journal."},{"wrong":"تجاهل les chiffres أثناء الاستماع","right":"كتابة كل رقم مع وحدته","why":"le chiffre هو la premièreinformation وأهمها."},{"wrong":"« Il a dit que… »","right":"« Il a affirmé que… » / « Il a précisé que… »","why":"la langue journalistique تطلب le verbe de déclaration précis."},{"wrong":"انتظار la perfection في كل كلمة","right":"التعرّف على la charpente: une, chiffres, cause, conséquence","why":"la compréhension B2 تعتمد sur la structure لا sur le lexique complet."}],"dialogues":[{"title":"افتتاح النشرة","ctx":"مذيع يفتتح نشرة المساء","lines":[{"who":"Présentateur","fr":"Bonsoir. À la une ce soir : le budget.","ar":"مساء الخير. الخبر البارز هذا المساء: الميزانية."},{"who":"Présentateur","fr":"Environ 12 000 agents ont manifesté.","ar":"شارك حوالي 12 ألف موظف في التظاهرة."},{"who":"Journaliste","fr":"Nous étions sur place dès ce matin.","ar":"كنا في الميدان منذ صباح اليوم."},{"who":"Présentateur","fr":"Selon le ministère, aucune suite ne sera donnée.","ar":"وفقًا للوزارة، لن يُتابع الأمر."}]},{"title":"مقابلة ميدانية","ctx":"مراسل يحاكي شاهداً","lines":[{"who":"Reporter","fr":"Qu’avez-vous vu exactement à cinq heures ?","ar":"ماذا رأيت بالضبط في الخامسة؟"},{"who":"Témoin","fr":"J’ai vu deux voitures s’arrêter brusquement.","ar":"رأيت سيارتين تتوقفان فجأة."},{"who":"Reporter","fr":"D’après vous, qui est responsable ?","ar":"حسب رأيك، من المسؤول؟"},{"who":"Témoin","fr":"Franchement, je préfère ne rien affirmer.","ar":"بصراحة، أفضل ألّا أؤكد شيئاً."}]}],"exercises":[{"t":"mcq","skill":"listening","q":"ما التعبير الافتتاحي لـ la une؟","opts":["À la une…","Au revoir…","À demain…","Merci beaucoup…"],"a":0,"why":"la une تُفتتح بـ « À la une… »."},{"t":"fill","skill":"grammar","q":"أكمل: «___ les premiers éléments, aucun blessé.»","fr":"___ les premiers éléments, aucun blessé.","ans":"Selon","why":"selon = وفقاً لـ، la formule de prudence."},{"t":"mcq","skill":"vocabulary","q":"ما معنى « le communiqué »؟","opts":["البيان","الشاهد","النشرة","المباشر"],"a":0,"why":"communiqué = بيان رسمي."},{"t":"order","skill":"writing","q":"رتّب: حوالي ألف شخص شاركوا في التظاهرة","words":["Environ","mille","personnes","ont","manifesté."],"ans":"Environ mille personnes ont manifesté.","why":"environ يسبق le chiffre."},{"t":"listen","skill":"listening","q":"ما la source المذكورة في « D’après l’enquête… »؟","opts":["une enquête","un témoin","une chaîne","un syndicat"],"a":0,"why":"d’après + la source."},{"t":"translate","skill":"writing","q":"ترجم: نشرة الأخبار تبدأ في الثامنة مساءً.","ans":"Le journal télévisé commence à vingt heures.","why":"journal télévisé + heure."},{"t":"speaking","skill":"speaking","q":"قدّم نشرة من 30 ثانية: une، chiffre، reportage، conclusion.","target":"À la une… / Environ… / Sur place… / Pour finir…","why":"بنية le journal télévisé."},{"t":"correct","skill":"grammar","q":"صحّح: «Je pense que le ministre a tort.»","ans":"Selon le ministre, la mesure est nécessaire.","why":"la neutralité تسبق le commentaire."}],"homework":"شاهد نشرة فرنسية كاملة، اكتب la une من ثلاث مواد مع les chiffres و les noms propres، ثم سجّل نفسك ترويها في 45 ثانية.","sources":[{"title":"ALGÉRIE : 61 MAROCAINS ARRÊTÉS POUR SABOTAGE ? MEHDI GHEZZAR EXPLOSE !","channel":"Colombia TV","videoId":"Rz5qJ-G7H4E","why":"نشرة إخبارية مباشرة بصيغة le journal télévisé: تقديم الخبر، la transition بين المواد، ثم la réaction — بالضبط ما يحتاجه مستمع B2 لفهم الإيقاع السريع للأخبار.","cat":"Médias","level":"B2","main":true},{"title":"Journal d’information 19H l 11-10-2026","channel":"Canal Algérie","videoId":"URkSwnrvGoM","why":"نشرة إخبارية كاملة — طبّق la structure على بث حقيقي مدته 26 دقيقة.","cat":"Médias","level":"B2","extra":true},{"title":"École française : pourquoi les meilleurs élèves disparaissent","channel":"Le Figaro","videoId":"Wx44ERpK7nQ","why":"matière d’info classique: problématique، chiffres، ثم les réactions — la grammaire de la nouvelle.","cat":"Médias","level":"B2","extra":true}],"supplements":[{"id":"URkSwnrvGoM","title":"Journal d’information 19H l 11-10-2026","channel":"Canal Algérie","why":"نشرة إخبارية كاملة — طبّق la structure على بث حقيقي مدته 26 دقيقة.","lang":"fr","dur":26},{"id":"Wx44ERpK7nQ","title":"École française : pourquoi les meilleurs élèves disparaissent","channel":"Le Figaro","why":"matière d’info classique: problématique، chiffres، ثم les réactions — la grammaire de la nouvelle.","lang":"fr","dur":13}]},{"id":"b2-t6-l2","fr":"Le reportage et l’interview","ar":"المراسلة الميدانية والمقابلة الصحفية","objectives":["فهم la structure de l’interview: ouverture, développement, relance, conclusion","تمييز la citation directe عن la citation indirecte في le reportage","استعمال les questions ouvertes بدل les questions fermées","تحليل كيف يعيد le journaliste صياغة la réponse دون تغيير le sens"],"sections":[{"h":"الدرس 2: كيف تفهم المراسلة الميدانية وتُجري مقابلة صحفية","video":{"id":"bL6kUjSRkow","title":"Raphaël Glucksmann : « Pas d’alliance avec La France insoumise »","channel":"France Inter","why":"مقابلة إذاعية سياسية قصيرة: le journaliste يفتح بسؤال مفتوح ثم يعيد الصياغة ويرفض la réponse — la mécanique الكاملة لـ l’interview à la française.","lang":"fr","main":true,"dur":2},"p":["le reportage يبدأ من la scène: « Ici, à Lyon, les portes sont fermées… » ثم la voix off تشرح، وأخيراً l’interview يضيف le témoignage. هذه la triade classique: scène، faits، parole.","المفردات الأساسية: le reportage, l’interview, l’envoyé spécial, la voix off, poser une question, reformuler, la relance, rebondir, sur le terrain, la citation. هذه المفردات تبني la boîte à outils du journaliste.","نحوياً، la citation indirecte تتطلب l’ordre des mots: « Il a dit qu’il viendrait. »، و le discours interrogatif يصبح: « Il a demandé si nous étions prêts. » لا « si nous sommes prêts ».","los أردت la relance استعمل: « Justement… », « Pourquoi ? », « Concrètement, que change-t-il ? ». هذه les relances تجعل l’interview vivante بلا قطع للضيف.","الفرق الأهم: le journaliste يسأل ولا يدّعي la connaissance، و le témoin يروي ولا يحلّل. la neutralité هنا la règle: نقل la parole كما قيلت.","بعد الدرس: أجرِ مقابلة وهمية من خمسة أسئلة مع صديق، ثم حوّل إجاباته إلى la citation indirecte واكتب فقرة reportage من ست جمل."],"sub":[{"h":"أسئلة المقابلة","p":["Qu’est-ce qui vous a décidé à vous présenter ?","Vous avez dit hier le contraire : comment l’expliquez-vous ?","Concrètement, que proposez-vous dès septembre ?"]},{"h":"أدوات نطقية: la relance","p":["« Justement… » تُنطق بلهجة متحمسة — la relance la plus naturelle.","« Pourquoi ? » بعد صمت قصير — le silence أقوى أداة في l’interview.","« Si je résume… » [si ʒə ʁə.sy.m] — la reformulation قبل la conclusion."]},{"h":"خطوات Listen & Repeat","p":["المرة الأولى: اكتب les questions فقط.","الثانية: اكتب la réponse مع le verbe de déclaration.","الثالثة: حوّل la réponse إلى la citation indirecte."]}]},{"h":"عبارات المراسلة والمقابلة","p":["« Nous sommes sur place depuis ce matin. » — l’ouverture du reportage.","« Que répondez-vous à ceux qui vous critiquent ? » — la question ouverte la plus efficace.","« Si je résume, vous affirmez que… » — la reformulation qui fait avancer l’interview.","« Dernière question avant de vous laisser partir… » — la conclusion polie."]},{"h":"التطبيق والتلخيص","p":["تمرين la relance: سجّل ثلاث أسئلة مفتوحة ثم أضف لكل واحدة relance واحدة بـ « Justement… » أو « Concrètement… ».","تمرين la citation: خمس جمل من discours direct إلى discours indirect مع le bon ordre des mots.","سجّل مقابلة من دقيقة: ouverture، trois questions، une relance، ثم la conclusion — واسمعها بحثاً عن le silence والنية."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: المراسلة الميدانية والمقابلة الصحفية؛ أعد مشاهدة الفيديو الرئيسي وركّز على إدارة المقابلة وإعادة توجيه الأسئلة.","جسر الدروس: من b2-t6-l1 (فهم نشرة الأخبار التلفزيونية) إلى b2-t6-l2 (المراسلة الميدانية والمقابلة الصحفية)، ثم إلى b2-t6-l3 حيث تنتقل من المادة الخبرية إلى الرأي المكتوب في الافتتاحية (كتابة الافتتاحية والعمود الصحفي).","مهمة تطبيقية: سجّل صوتك في دقيقةٍ واحدة تلخّص فيها أهم ثلاث أفكار من هذا الدرس، واستعمل 3 كلمات جديدة من قاموسه، ثم قارن أدائك بمقتطف من الفيديو الرئيسي وحدّد الفروق."]}],"pron":[{"w":"interviewer","ipa":"[ɛ̃.təʁ.vjwe]","approx":"انتيرفيويه"},{"w":"reformuler","ipa":"[ʁə.fɔʁ.my.le]","approx":"روفورميليه"},{"w":"le terrain","ipa":"[lə tɛ.ʁɛ̃]","approx":"لو تيران"}],"vocab":[{"fr":"l’interview","ar":"المقابلة الصحفية","pos":"nom","g":"f","exFr":"L’interview dure dix minutes.","ipa":"","exAr":"تستمر المقابلة عشر دقائق."},{"fr":"l’envoi","ar":"التمرير الإخباري القادم من الميدان","pos":"nom","g":"m","exFr":"L’envoi du reporter revient sur les lieux.","ipa":"[lɑ̃.vwa]","exAr":"يعود تمريرُ الصحفي إلى الأماكن."},{"fr":"l’envoyé spécial","ar":"المراسل الخاص","pos":"nom","g":"m","exFr":"Notre envoyé spécial est à Bruxelles.","ipa":"","exAr":"مراسلنا الخاص في بروكسل."},{"fr":"la voix off","ar":"التعليق الصوتي","pos":"nom","g":"f","exFr":"La voix off explique les images.","ipa":"","exAr":"يشرح التعليق الصوتي الصور."},{"fr":"sonder l’interlocuteur","ar":"يستكشف رأي المُحاوَر بلطف","pos":"loc.","g":"","exFr":"Le journaliste sonde l’interlocuteur sans le brusquer.","ipa":"[sɔ̃.de lɛ̃.tɛʁ.lɔ.ka.tœʁ]","exAr":"يستكشف الصحفيُّ رأيَ المُحاوَر دون أن يستعجله."},{"fr":"cadrer","ar":"يؤطّر سير المقابلة","pos":"verbe","g":"","exFr":"L’envoyé spécial cadre l’entretien en trois minutes.","ipa":"[ka.dʁe]","exAr":"يؤطّر المراسلُ الميدانيُّ المقابلةَ في ثلاث دقائق."},{"fr":"la relance","ar":"المتابعة في السؤال","pos":"nom","g":"f","exFr":"Sa relance a déstabilisé l’invité.","ipa":"","exAr":"أشعرت متابعته الضيف بالحرج."},{"fr":"rebondir sur","ar":"يعلّق فوراً على","pos":"loc.","g":"","exFr":"Il a rebondi sur la dernière question.","ipa":"","exAr":"علّق فوراً على السؤال الأخير."},{"fr":"sur le terrain","ar":"في الميدان","pos":"loc.","g":"","exFr":"Les images viennent du terrain.","ipa":"","exAr":"الصور قادمة من الميدان."},{"fr":"la déclaration","ar":"التصريح العلني أمام الكاميرا","pos":"nom","g":"f","exFr":"Le ministre fait une déclaration face à la caméra.","ipa":"[la de.kla.ʁa.sjɔ̃]","exAr":"يُدلي الوزيرُ بتصريحٍ أمام الكاميرا."},{"fr":"couper la parole","ar":"قاطع المتحدث","pos":"loc.","g":"","exFr":"Ne coupez pas la parole à l’invité.","ipa":"","exAr":"لا تقاطع الضيف."},{"fr":"le témoignage","ar":"الشهادة","pos":"nom","g":"m","exFr":"Son témoignage a touché les auditeurs.","ipa":"","exAr":"أثرت شهادته في المستمعين."}],"examples":[{"fr":"Il a dit qu’il viendrait dès lundi.","ar":"قال إنه سيأتي من الاثنين.","note":"citation indirecte"},{"fr":"Il a demandé si nous étions prêts.","ar":"سأل إن كنا مستعدين.","note":"discours interrogatif"},{"fr":"Si je résume, vous refusez toute alliance.","ar":"إذا لخصت، فأنت ترفض أي تحالف.","note":"la reformulation"},{"fr":"Justement, pourquoi maintenant ?","ar":"بالضبط، لماذا الآن؟","note":"la relance"},{"fr":"Nous sommes sur place depuis ce matin.","ar":"نحن في الميدان منذ صباح اليوم.","note":"l’ouverture"},{"fr":"La voix off rappelle les chiffres officiels.","ar":"يذكّر التعليق الصوتي بالأرقام الرسمية.","note":"le reportage"}],"grammar":[{"tFr":"Le discours indirect : ordre des mots et temps","tAr":"الخطاب غير المباشر: ترتيب الكلمات والأزمنة","body":["في la citation indirecte، le verbe de déclaration يسبق que: « Il a affirmé qu’il partirait. »، و le subjonctif يبقى بعد les verbes de doute: « Je doute qu’il vienne. »","le présent يرجع إلى l’imparfait أو le conditionnel في le récit: « Elle a dit qu’elle était prête. » — la concordance des temps هنا إلزامية في le reportage."],"ex":[{"fr":"Il a affirmé qu’il partirait dès demain.","ar":"أكد أنه سيغادر من غداً."},{"fr":"Je doute qu’il vienne à l’heure.","ar":"أشك في أنه سيأتي في الوقت المحدد."}]},{"tFr":"Les verbes de parole et leur construction","tAr":"أفعال القول ووصلاتها","body":["« dire que… » + indicatif، « affirmer que… » + indicatif، « nier que… » + subjonctif، « demander si… » + indicatif interrogatif.","« proposer de + infinitif », « refuser de + infinitif » — la proposition directe بدل la subordonnée: plus naturelle في l’interview."],"ex":[{"fr":"Le ministre a proposé de retarder le vote.","ar":"اقترح الوزير تأجيل التصويت."},{"fr":"Il nie qu’il ait été informé.","ar":"ينفي أنه كان على علم."}]}],"mistakes":[{"wrong":"« Il a dit que nous sommes prêts. »","right":"« Il a dit que nous étions prêts. »","why":"la concordance des temps تُفرض في le discours indirect."},{"wrong":"« Oui ou non, vous êtes d’accord ? »","right":"« Qu’est-ce qui vous a décidé à changer d’avis ? »","why":"la question ouverte تفتح l’interview، la question fermée تغلقها."},{"wrong":"التعليق الشخصي أثناء la relance","right":"« Concrètement, que proposez-vous ? »","why":"le journaliste يسأل ولا يُدلي برأيه."},{"wrong":"ترك la citation بلا source","right":"« Selon le maire… »","why":"la source شرط la crédibilité في le reportage."}],"dialogues":[{"title":"افتتاح المراسلة","ctx":"مراسلة من الميدان","lines":[{"who":"Reporter","fr":"Nous sommes sur place depuis ce matin.","ar":"نحن في الميدان منذ صباح اليوم."},{"who":"Reporter","fr":"Derrière moi, les portes sont toujours fermées.","ar":"خلفي، الأبواب لا تزال مغلقة."},{"who":"Reporter","fr":"Selon la préfecture, la réunion a échoué.","ar":"وفقًا للفيديرالية، فشل الاجتماع."},{"who":"Reporter","fr":"Nous allons interroger les riverains.","ar":"سنستجوب السكان الآن."}]},{"title":"المقابلة مع relance","ctx":"مذيعة تستضيف ناشطاً","lines":[{"who":"Animatrice","fr":"Qu’est-ce qui vous a décidé à vous présenter ?","ar":"ما الذي دفعك إلى الترشح؟"},{"who":"Invité","fr":"La colère des habitants, tout simplement.","ar":"غضب السكان، ببساطة."},{"who":"Animatrice","fr":"Justement, que leur proposez-vous ?","ar":"بالضبط، ماذا تقترح لهم؟"},{"who":"Invité","fr":"Si je résume : du logement et des transports.","ar":"إذا لخصت: سكن ومواصلات."}]}],"exercises":[{"t":"mcq","skill":"listening","q":"ما أفضل تعبير لـ la relance؟","opts":["Justement, pourquoi ?","Merci beaucoup.","À bientôt.","Bonsoir."],"a":0,"why":"justement = la relance la plus naturelle."},{"t":"fill","skill":"grammar","q":"أكمل: «Il a demandé___ nous étions prêts.»","fr":"Il a demandé ___ nous étions prêts.","ans":"si","why":"le discours interrogatif يستعمل si."},{"t":"mcq","skill":"vocabulary","q":"ما معنى « la voix off »؟","opts":["التعليق الصوتي","المقابلة","المراسل","الشهادة"],"a":0,"why":"voix off = التعليق الصوتي."},{"t":"order","skill":"writing","q":"رتّب: قال إنه سيأتي من الاثنين","words":["Il","a","dit","qu’il","viendrait","dès","lundi."],"ans":"Il a dit qu’il viendrait dès lundi.","why":"citation indirecte + concordance des temps."},{"t":"listen","skill":"listening","q":"ما la question ouverte في المقابلة؟","opts":["Qu’est-ce qui vous a décidé ?","Êtes-vous d’accord ?","Venez-vous demain ?","Avez-vous fini ?"],"a":0,"why":"la question ouverte تبدأ بـ qu’est-ce que."},{"t":"translate","skill":"writing","q":"ترجم: إذا لخصت، فأنت ترفض أي تحالف.","ans":"Si je résume, vous refusez toute alliance.","why":"la reformulation."},{"t":"speaking","skill":"speaking","q":"أجرِ مقابلة من أربعة أسئلة مع relance واحدة.","target":"Qu’est-ce que… / Justement… / Concrètement… / Dernière question…","why":"بنية l’interview."},{"t":"correct","skill":"grammar","q":"صحّح: «Il a dit que nous sommes prêts.»","ans":"Il a dit que nous étions prêts.","why":"la concordance des temps."}],"homework":"استمع إلى مقابلة إذاعية فرنسية، اكتب خمسة أسئلة طرحها le journaliste مع la réponse بصيغة la citation indirecte، ثم سجّل relance واحدة بصوتك.","sources":[{"title":"Raphaël Glucksmann : « Pas d’alliance avec La France insoumise »","channel":"France Inter","videoId":"bL6kUjSRkow","why":"مقابلة إذاعية سياسية قصيرة: le journaliste يفتح بسؤال مفتوح ثم يعيد الصياغة ويرفض la réponse — la mécanique الكاملة لـ l’interview à la française.","cat":"Médias","level":"B2","main":true},{"title":"L’Enfer des retours de Vacances !","channel":"Documentaire Société","videoId":"aFvgmZ46auk","why":"reportage طويل — تتبع la voix off ثم les témoignages مباشرة من le terrain.","cat":"Médias","level":"B2","extra":true},{"title":"Journal d’information 19H l 11-10-2026","channel":"Canal Algérie","videoId":"URkSwnrvGoM","why":"مواد متناوبة بين le reportage و l’interview — la structure الكاملة في بث واحد.","cat":"Médias","level":"B2","extra":true}],"supplements":[{"id":"aFvgmZ46auk","title":"L’Enfer des retours de Vacances !","channel":"Documentaire Société","why":"reportage طويل — تتبع la voix off ثم les témoignages مباشرة من le terrain.","lang":"fr","dur":42},{"id":"URkSwnrvGoM","title":"Journal d’information 19H l 11-10-2026","channel":"Canal Algérie","why":"مواد متناوبة بين le reportage و l’interview — la structure الكاملة في بث واحد.","lang":"fr","dur":26}]},{"id":"b2-t6-l3","fr":"L’éditorial et la chronique","ar":"الافتتاحية والعمود الصحفي","objectives":["تمييز l’éditorial (رأي المؤسسة) عن la chronique (رأي الكاتب) و la news","بناء thèse ثم arguments ثم nuance في فقرة واحدة","استعمال connecteurs d’opinion: certes, cependant, en tout cas, sans doute","تحليل la modalisation: le conditionnel و les adverbes de doute"],"sections":[{"h":"الدرس 3: كيف تفهم الافتتاحية وتكتب عموداً رأياً","video":{"id":"Om6u97jm0yk","title":"Emmanuel Macron appelle au « calme » pour avancer sur la mobilisation des lycées","channel":"M6 Info","why":"قصة إخبارية مركّزة تحوّل le constat إلى la prise de position: le verbe de déclaration، la nuance، ثم l’appel à l’action — la matière الخام لـ l’éditorial.","lang":"fr","main":true,"dur":1},"p":["l’éditorial هو رأي la rédaction، و la chronique هو رأي الكاتب شخصياً؛ الاثنان لا يُقدَّمان كـ la nouvelle بل كـ l’interprétation. le journal télévisé ينقل، أما l’éditorial فيُعلّق.","المفردات الأساسية: l’éditorial, la chronique, la thèse, l’argument, la nuance, la tribune, le billet, prendre position, dénoncer, nuancer, le constat, la prise de parole. هذه هي la boîte à outils de l’opinion.","نحوياً، la nuance تأتي بالsubjonctif: « Il est possible que la mesure échoue. »، و l’hypothèse بالconditionnel: « Sans ce mouvement, rien n’aurait changé. » — le conditionnel est la marque de la prudence.","l’argumentation الفرنسية تسير: constat ← thèse ← arguments ← contre-argument ← nuance. la nuance ليست ضعفاً بل la preuve de la réflexion.","les connecteurs هي la charpente: « Certes…, cependant… », « En tout cas… », « C’est pourquoi… ». بدونها تصبح l’opinion مجرد انطباع.","بعد الدرس: اكتب chronique من 120 كلمة عن موضوع يومي بالبنية نفسها، وابدأ بـ le constat لا بـ la thèse مباشرة."],"sub":[{"h":"بنية الرأي","p":["Certes, la mesure est impopulaire, cependant elle est nécessaire.","Le constat s’impose : rien n’a bougé depuis mars.","C’est pourquoi je crois qu’il faut rouvrir le débat."]},{"h":"أدوات نطقية: la nuance à l’oral","p":["« sans doute » تُنطق بنبرة هابطة — la prudence في la voix.","« peut-être… mais… » [pø.tɛːt] — le pause قبل la contre-argumentation.","« en tout cas » [ɑ̃ tu ka] — la transition vers la conclusion."]},{"h":"خطوات Listen & Repeat","p":["المرة الأولى: حدد la thèse في جملة واحدة.","الثانية: احسب connecteurs المستعملة.","الثالثة: أعد بناء l’argumentation بترتيبك."]}]},{"h":"عبارات الرأي والافتتاحية","p":["« Il est indéniable que… » = من المؤكد أن… — l’ouverture la plus forte.","« Certes, mais… » = بلا شك، لكن… — la concession قبل la thèse.","« Sans doute faudra-t-il… » = من غير المرجح أن… — la modalisation.","« En tout cas, le débat reste ouvert. » — la conclusion ouverte de tout éditorial."]},{"h":"التطبيق والتلخيص","p":["تمرين la thèse: اكتب جملة رأي واحدة عن موضوع تهمك ثم أضف لها une concession بـ « Certes… ».","تمرين la nuance: خمس جمل صارمة حوّلها بـ « sans doute », « peut-être », « en tout cas ».","سجّل chronique من 45 ثانية: le constat، la thèse، un argument، ثم la nuance — بنفس نبرة le chroniqueur."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: كتابة الافتتاحية والعمود الصحفي؛ أعد مشاهدة الفيديو الرئيسي وركّز على الصياغة الرأيّة المتوازنة بين الحجج والتحفّظ.","جسر الدروس: من b2-t6-l2 (المراسلة الميدانية والمقابلة الصحفية) إلى b2-t6-l3 (كتابة الافتتاحية والعمود الصحفي)، ثم إلى b2-t6-l4 حيث تنتقل من العمود القصير إلى السرد الطويل في الوثائقي (قراءة بنية الوثائقي وصوته السردي).","مهمة تطبيقية: اكتب دقيقةً من الكتابة (نحو 100 كلمة) تلخّص فيها أهم ثلاث أفكار من هذا الدرس، واستعمل 3 كلمات جديدة من قاموسه، ثم قارن نصّك بمقتطف من الفيديو الرئيسي وحدّد الفروق."]}],"pron":[{"w":"l’éditorial","ipa":"[e.di.tɔ.ʁjal]","approx":"إديتوريال"},{"w":"la chronique","ipa":"[la kʁɔ.nik]","approx":"لا كرونيك"},{"w":"nuancer","ipa":"[ny.ɑ̃.se]","approx":"نيوأنسيه"}],"vocab":[{"fr":"l’éditorial","ar":"الافتتاحية (رأي المؤسسة)","pos":"nom","g":"m","exFr":"L’éditorial paraît en première page.","ipa":"","exAr":"تُنشر الافتتاحية في الصفحة الأولى."},{"fr":"la chronique","ar":"العمود الصحفي","pos":"nom","g":"f","exFr":"Sa chronique paraît chaque vendredi.","ipa":"","exAr":"يُنشر عموده كل جمعة."},{"fr":"la ligne de force","ar":"المحور القوي في الافتتاحية","pos":"nom","g":"f","exFr":"La ligne de force de l’éditorial saute aux yeux.","ipa":"[la liɲ də fɔʁs]","exAr":"يظهر المحورُ القويُّ للافتتاحية بوضوح."},{"fr":"la justification","ar":"التبرير الذي يسنّد الرأي","pos":"nom","g":"f","exFr":"Chaque affirmation exige une justification précise.","ipa":"[la ʒysti.fi.ka.sjɔ̃]","exAr":"كلّ مزاعمٍ يحتاج إلى تبريرٍ دقيق."},{"fr":"la prudence","ar":"التحفّظ في التعبير عن الرأي","pos":"nom","g":"f","exFr":"L’éditorialiste avance sa thèse avec prudence.","ipa":"[la pʁy.dɑ̃s]","exAr":"يعرض كاتبُ الافتتاحية أطروحته بتحفّظ."},{"fr":"prendre position","ar":"يتبنى موقفاً","pos":"loc.","g":"","exFr":"Le journal a pris position sur ce dossier.","ipa":"","exAr":"اتخذت الصحيفة موقفاً من هذه القضية."},{"fr":"dénoncer","ar":"يشجب/يكشف","pos":"verbe","g":"","exFr":"Elle dénonce l’inaction des élus.","ipa":"","exAr":"تشجب خمول المنتخبين."},{"fr":"l’allusion","ar":"الإيحاء غير المباشر","pos":"verbe","exFr":"Un bon éditorialiste sait l’allusion ses certitudes.","ipa":"[ʁə.la.ti.vi.ze]","exAr":"يُجيد كاتبُ الافتتاحية الجيّدُ نسبةَ يقينه."},{"fr":"le constat","ar":"التشخيص","pos":"nom","g":"m","exFr":"Le constat est sans appel.","ipa":"","exAr":"التشخيص لا رجعة فيه."},{"fr":"la tribune","ar":"مقال الرأي","pos":"nom","g":"f","exFr":"Il a publié une tribune dans le journal.","ipa":"","exAr":"نشر مقال رأي في الجريدة."},{"fr":"le billet","ar":"المقال القصير","pos":"nom","g":"m","exFr":"Son billet est plus personnel.","ipa":"","exAr":"مقاله أكثر شخصية."},{"fr":"la prise de position","ar":"الالتزام بموقف صريح","pos":"loc.","g":"","exFr":"L’éditorial assume une prise de position claire.","ipa":"[la pʁiz də pɔ.zi.sjɔ̃]","exAr":"تتّخذ الافتتاحيةُ موقفاً صريحاً."}],"examples":[{"fr":"Il est indéniable que rien n’a bougé.","ar":"من المؤكد أن شيئاً لم يتحرك.","note":"l’ouverture"},{"fr":"Certes, la mesure est impopulaire, cependant elle est nécessaire.","ar":"بلا شك، الإجراء غير شائع، لكنه ضروري.","note":"la concession"},{"fr":"Il est possible que la réforme échoue.","ar":"من المحتمل أن تفشل الإصلاح.","note":"subjonctif de nuance"},{"fr":"Sans ce mouvement, rien n’aurait changé.","ar":"لولا هذا الحراك، لما تغير شيء.","note":"conditionnel passé"},{"fr":"En tout cas, le débat reste ouvert.","ar":"على أي حال، النقاش يبقى مفتوحاً.","note":"la conclusion"},{"fr":"Je crois qu’il faut rouvrir la question.","ar":"أعتقد أنه يجب إعادة فتح السؤال.","note":"la thèse"}],"grammar":[{"tFr":"Subjonctif après les expressions de nuance","tAr":"الفاعلية بعد تعبيرات التمييز","body":["après « il est possible que », « il faut que », « bien que », « pour que » يأتي le subjonctif: « Il faut que le débat reprenne. »","après « bien que » le subjonctif يبقى حتى مع le passé: « Bien que la crise soit ancienne… » — cette règle distingue le niveau B2 du niveau B1."],"ex":[{"fr":"Il faut que le débat reprenne.","ar":"يجب أن يعود النقاش."},{"fr":"Bien que la mesure soit impopulaire, elle s’applique.","ar":"رغم أن الإجراء غير شائع، إلا أنه يُطبَّق."}]},{"tFr":"Conditionnel et adverbes de modalisation","tAr":"الشرطية وظروف الترويسة","body":["le conditionnel exprime l’hypothèse ou la politesse: « Je croirais plutôt… »، و le subjonctif exprime la possibilité.","les adverbes: sans doute (احتمال مرتفع)، peut-être (احتمال)، en tout cas (قطع). ترتيبها في la phrase يوجّه le degré de certitude."],"ex":[{"fr":"Sans doute faudra-t-il attendre.","ar":"من غير المرجح أن ننتظر."},{"fr":"Peut-être, mais en tout cas rien n’est décidé.","ar":"ربما، لكن على أي حال لم يُحسم شيء."}]}],"mistakes":[{"wrong":"البدء بـ la thèse مباشرة بلا constat","right":"le constat ← la thèse ← l’argument","why":"l’éditorial الفرنسي يبدأ من la réalité قبل le jugement."},{"wrong":"« C’est évident que… »","right":"« Il est indéniable que… » / « Sans doute… »","why":"la modalisation تُظهر la réflexion لا la certitude absolue."},{"wrong":"la nuance الغائبة تماماً","right":"une concession بـ « Certes…, cependant… »","why":"la nuance هي la preuve de l’esprit critique."},{"wrong":"الخلط بين l’éditorial و la nouvelle","right":"la nouvelle = les faits، l’éditorial = l’interprétation","why":"l’éditorial لا يُقدَّم كـ la info."}],"dialogues":[{"title":"نقاش في هيئة تحرير","ctx":"مديرة جريدة مع صحافياً","lines":[{"who":"Cheffe","fr":"Le constat s’impose : rien n’a bougé.","ar":"التشخيص واضح: لم يتغير شيء."},{"who":"Journaliste","fr":"Certes, mais il manque un argument.","ar":"بلا شك، لكن تغيب حجة."},{"who":"Cheffe","fr":"Alors ajoutez une nuance et publiez.","ar":"إذن أضف تمييزاً وانشر."},{"who":"Journaliste","fr":"D’accord, en tout cas le débat reste ouvert.","ar":"موافق، على أي حال النقاش يبقى مفتوحاً."}]},{"title":"الراديو والرأي","ctx":"مذيع يستضيف كاتب عمود","lines":[{"who":"Animateur","fr":"Quelle est votre thèse en une phrase ?","ar":"ما أطروحتك في جملة واحدة؟"},{"who":"Chroniqueur","fr":"Je crois qu’il faut rouvrir le débat.","ar":"أعتقد أنه يجب إعادة فتح النقاش."},{"who":"Animateur","fr":"Certes, mais n’est-ce pas trop tard ?","ar":"بلا شك، أليست الأمور قد فاتت؟"},{"who":"Chroniqueur","fr":"Sans doute pas : la question reste posée.","ar":"من غير المرجح: السؤال ما زال قائماً."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما معنى « la tribune »؟","opts":["مقال الرأي","المراسلة","النشرة","المقابلة"],"a":0,"why":"tribune = مقال الرأي في الجريدة."},{"t":"fill","skill":"grammar","q":"أكمل بالsubjonctif: «Il est possible qu’il___ (échouer).»","fr":"Il est possible qu’il ___ échouer.","ans":"échoue","why":"il est possible que + subjonctif."},{"t":"mcq","skill":"grammar","q":"أي جملة تعبّر عن la concession؟","opts":["Certes, cependant…","Hier, il a plu.","Le rapport est prêt.","Bonjour à tous."],"a":0,"why":"certes + cependant = la concession."},{"t":"order","skill":"writing","q":"رتّب: من المؤكد أن شيئاً لم يتحرك","words":["Il","est","indéniable","que","rien","n’a","bougé."],"ans":"Il est indéniable que rien n’a bougé.","why":"l’ouverture forte de l’éditorial."},{"t":"listen","skill":"listening","q":"ما le degré de certitude في « Sans doute… »؟","opts":["احتمال مرتفع","استحالة","يقين تام","لا شيء"],"a":0,"why":"sans doute = احتمال مرتفع."},{"t":"translate","skill":"writing","q":"ترجم: رغم أن الإجراء غير شائع، إلا أنه ضروري.","ans":"Bien que la mesure soit impopulaire, elle est nécessaire.","why":"bien que + subjonctif."},{"t":"speaking","skill":"speaking","q":"قدّم رأياً من 40 ثانية: constat، thèse، argument، nuance.","target":"Le constat… / Je crois que… / Par exemple… / Certes, mais…","why":"بنية la chronique."},{"t":"correct","skill":"grammar","q":"صحّح: «Il est possible qu’il échoue, c’est évident.»","ans":"Il est possible qu’il échoue, sans doute.","why":"la modalisation تحل محل la certitude absolue."}],"homework":"اكتب chronique من 120 كلمة عن مشكلة يومية في بلدك بالبنية الفرنسية: le constat، la thèse، deux arguments، ثم une nuance ختامية.","sources":[{"title":"Emmanuel Macron appelle au « calme » pour avancer sur la mobilisation des lycées","channel":"M6 Info","videoId":"Om6u97jm0yk","why":"قصة إخبارية مركّزة تحوّل le constat إلى la prise de position: le verbe de déclaration، la nuance، ثم l’appel à l’action — la matière الخام لـ l’éditorial.","cat":"Médias","level":"B2","main":true},{"title":"École française : pourquoi les meilleurs élèves disparaissent","channel":"Le Figaro","videoId":"Wx44ERpK7nQ","why":"chronique تحليلية: problématique، chiffres، ثم les remèdes — la structure الكاملة لـ l’argumentation.","cat":"Médias","level":"B2","extra":true},{"title":"La Qualification juridique [argumentation & raisonnement juridique]","channel":"Théorie du droit","videoId":"Hi7Nm3JSXag","why":"la rigueur de l’argumentation: thèse، hypothèse، conséquence — la logique derrière la thèse.","cat":"Médias","level":"B2","extra":true}],"supplements":[{"id":"Wx44ERpK7nQ","title":"École française : pourquoi les meilleurs élèves disparaissent","channel":"Le Figaro","why":"chronique تحليلية: problématique، chiffres، ثم les remèdes — la structure الكاملة لـ l’argumentation.","lang":"fr","dur":13},{"id":"Hi7Nm3JSXag","title":"La Qualification juridique [argumentation & raisonnement juridique]","channel":"Théorie du droit","why":"la rigueur de l’argumentation: thèse، hypothèse، conséquence — la logique derrière la thèse.","lang":"fr","dur":7}]},{"id":"b2-t6-l4","fr":"Le documentaire français","ar":"الوثائقي الفرنسي","objectives":["تحليل la structure du documentaire: accroche, enquête, témoignage, chute","تمييز la voix off عن le témoignage عن le commentaire","استعمال le lexique du récit: le hors-champ, le fondu, la séquence","وصف la thèse du documentaire في جملتين بالفرنسية"],"sections":[{"h":"الدرس 4: كيف تفهم بنية الوثائقي الفرنسي وتقرأ صوته","video":{"id":"URkSwnrvGoM","title":"Le documentaire français : du constat au récit","channel":"Documentaire Société","why":"وثائقي يجمع la voix off مع les témoignages — la matière المثالية لتحليل la structure: accroche، enquête، témoignage، conclusion.","lang":"fr","main":true,"dur":26},"p":["le documentaire الفرنسي لا ينقل la réalité بل يبني le récit: accroche قصيرة (image + chiffre)، ثم enquête (le journaliste يسأل)، ثم témoignages (les voix)، ثم une chute qui rouvre la question. le spectateur يشعر إنه يكتشف، لا إنه يُدرَّس.","معجم الدرس: la voix off, le témoignage, le hors-champ, le fondu, la séquence, le reportage, l’enquête, la preuve, l’archive, le témoins, la chute, le récit. هذه المفردات تصف la mécanique de l’image.","نحوياً، la voix off يستعمل le présent de narration: « Le maire reçoit les habitants… »، و le passé compose pour le drame: « La ferme a fermé en 2019. » la température des temps raconte la distance.","le conditionnel apparaît dans les hypothèses du narrateur: « C’est ici que tout a basculé. » et « si » introduit le suspense: « Si le conseil avait voté autrement… ».","الدرس الأهم: les chiffres في le documentaire ليست neutرة — اسأل toujours: source, période, comparaison. « 40 % de plus » تعني بالنسبة لـ ماذا ومتى؟","بعد الدرس: شاهد 20 دقيقة من وثائقي فرنسي، اكتب la structure (accroche، 3 séquences، chute)، ثم حدّد la thèse implicit في جملة واحدة."],"sub":[{"h":"la structure du récit","p":["L’accroche : un chiffre, une image, une question.","L’enquête : le journaliste va sur le terrain.","La chute : une ouverture, pas une solution."]},{"h":"أدوات نطقية: la voix off","p":["« Tout commence ici, au cœur du village. » [tu kɔmɑ̃s isiw], le présent de narration.","« En 2019, la ferme a fermé. » — le passé compose du fait.","« Si le conseil avait voté… » — le conditionnel du suspense."]},{"h":"خطوات l’analyse","p":["الخطوة الأولى: اكتب les questions du narrateur.","الثانية: احسب les témoignages و leur ordre.","الثالثة: استخرج la thèse من la chute."]}]},{"h":"عبارات تحليل الوثائقي","p":["« La voix off pose le décor. » = الصوت الموسّق يؤطّر المشهد.","« Le témoignage apporte la preuve par le vécu. » — la voix humaine.","« La séquence suivante déplace le regard. » = التسلسل التالي يُغيّر زاوية النظر.","« La chute rouvre la question. » = الخاتمة تُعيد فتح السؤال لا تُغلقه."]},{"h":"التطبيق والتلخيص","p":["تمرين la structure: شاهد عشر دقائق وحدّد la secondes laquelle chaque bloc يبدأ: accroche, enquête, témoignage.","تمرين la thèse: اكتب جملتين تشرحان la thèse implicit du documentaire.","سجّل نقداً من 45 ثانية: « Le documentaire montre que…, mais il tait… » — la preuve de la lecture critique."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: قراءة بنية الوثائقي وصوته السردي؛ أعد مشاهدة الفيديو الرئيسي وركّز على التباعد الزمني وتوظيف الشهادة والصوت المرافق.","جسر الدروس: من b2-t6-l3 (كتابة الافتتاحية والعمود الصحفي) إلى b2-t6-l4 (قراءة بنية الوثائقي وصوته السردي)، ثم إلى b2-t6-l5 حيث تنتقل من الوثائقي إلى الإعلان المُقنِع (تفكيك تقنيات الإعلان المُقنِع).","مهمة تطبيقية: سجّل صوتك في دقيقةٍ واحدة تلخّص فيها أهم ثلاث أفكار من هذا الدرس، واستعمل 3 كلمات جديدة من قاموسه، ثم قارن أدائك بمقتطف من الفيديو الرئيسي وحدّد الفروق."]}],"pron":[{"w":"la voix off","ipa":"[la vwa ɔf]","approx":"لا فوا أوف"},{"w":"le témoignage","ipa":"[lə te.mwa.ɲaʒ]","approx":"لو تيمواناج"},{"w":"la séquence","ipa":"[la se.kɑ̃s]","approx":"لا سيكونس"}],"vocab":[{"fr":"la voix narrative","ar":"الصوت السردي المرافق للصور","pos":"nom","g":"f","exFr":"La voix narrative relie les séquences du documentaire.","ipa":"[la vwa na.ʁa.tiv]","exAr":"يربط الصوتُ السرديُّ متتالياتِ الوثائقي."},{"fr":"la parole confiée","ar":"الكلام المُدلى أمام الكاميرا","pos":"nom","g":"f","exFr":"La parole confiée à la caméra humanise l’enquête.","ipa":"[la pa.ʁɔl kɔ̃.fje]","exAr":"يمنح الكلامُ المُدلى أمامَ الكاميرا التحقيقَ بعداً إنسانياً."},{"fr":"le hors-champ","ar":"خارج الكادر","pos":"nom","g":"m","exFr":"La question vient du hors-champ.","ipa":"[lɔʁ ʃɑ̃]","exAr":"السؤال يأتي من خارج الكادر."},{"fr":"la séquence","ar":"التسلسل / المقطع","pos":"nom","g":"f","exFr":"Cette séquence dure deux minutes.","ipa":"[se.kɑ̃s]","exAr":"هذا المقطع يدوم دقيقتين."},{"fr":"l’enquête","ar":"التحقيق","pos":"nom","g":"f","exFr":"L’enquête a duré six mois.","ipa":"[ɑ̃.kɛt]","exAr":"استغرق التحقيق ستة أشهر."},{"fr":"l’épilogue","ar":"الخاتمة الختامية للوثائقي","pos":"nom","g":"m","exFr":"L’épilogue du film rouvre le débat au lieu de le clore.","ipa":"[le.pi.ɔ.lɔɡ]","exAr":"تفتح خاتمةُ الفيلمِ النقاشَ من جديد بدل إغلاقه."},{"fr":"le récit","ar":"السرد","pos":"nom","g":"m","exFr":"Le récit est chronologique.","ipa":"[le.ʁi]","exAr":"السرد زمني."},{"fr":"l’archive","ar":"الأرشيف","pos":"nom","g":"f","exFr":"L’archive date des années soixante.","ipa":"[aʁ.ʃiv]","exAr":"الأرشيف يعود لستينيات."},{"fr":"documenter","ar":"يوثّق","pos":"verbe","g":"","exFr":"Il documente chaque étape.","ipa":"[dɔ.ky.mɑ̃.te]","exAr":"يوثّق كل مرحلة."},{"fr":"témoigner de","ar":"يشهد على","pos":"loc.","g":"","exFr":"Elle témoigne de la crise.","ipa":"","exAr":"تشهد على الأزمة."},{"fr":"découvrir","ar":"يكتشف","pos":"verbe","g":"","exFr":"On découvre un village oublié.","ipa":"[de.ku.vʁiʁ]","exAr":"نكتشف قرية منسيّة."},{"fr":"le fondu","ar":"التلاشي","pos":"nom","g":"m","exFr":"Le fondu enchaîné lie deux plans.","ipa":"[fɔ̃.dy]","exAr":"التلاشي يربط بين لقطتين."}],"examples":[{"fr":"Tout commence ici, au cœur du village.","ar":"كل شيء يبدأ هنا، في قلب القرية.","note":"l’accroche"},{"fr":"En 2019, la ferme a fermé ses portes.","ar":"في 2019، أغلقت المزرعة أبوابها.","note":"le passé compose"},{"fr":"Si le conseil avait voté autrement…","ar":"لو صوّت المجلس بشكل آخر…","note":"le conditionnel"},{"fr":"La voix off pose le décor en trois phrases.","ar":"الصوت الموسّق يؤطّر المشهد في ثلاث جمل.","note":"la narration"},{"fr":"Le témoignage apporte la preuve par le vécu.","ar":"الشهادة تقدّم الدليل بالتجربة المباشرة.","note":"le témoignage"},{"fr":"La chute rouvre la question au lieu de la clore.","ar":"الخاتمة تُعيد فتح السؤال بدل إغلاقه.","note":"la chute"}],"grammar":[{"tFr":"Les temps du récit documentaire","tAr":"أزمنة السرد في الوثائقي","body":["la voix off تستعمل le présent de narration للأحداث المتّصلة: « Le maire reçoit les habitants… »، et le passé compose pour le fait accompli: « La ferme a fermé. »","l’imparfait يصف le décor: « Il faisait froid ce matin-là. » — les trois temps معاً يصنعون la température du récit."],"ex":[{"fr":"Le maire reçoit les habitants chaque mardi.","ar":"يستقبل العمدة السكان كل ثلاثاء."},{"fr":"La ferme a fermé en 2019, et le village a changé.","ar":"أُغلقت المزرعة في 2019، وتغيّرت القرية."}]},{"tFr":"Le conditionnel du suspense","tAr":"الشرطية في بناء التسلسل","body":["le conditionnel يفتح le possible: « Si le conseil avait voté autrement, rien ne serait pareil. » la condition غير الواقعية تخلق le manque — le moteur de l’enquête.","« C’est ici que… » la phrase de dévoilement تسبق souvent le fondu — elle transforme le décor en preuve."],"ex":[{"fr":"Si la mine avait ouvert, le village aurait grandi.","ar":"لو فُتحت المناجم، لكبرت القرية."},{"fr":"C’est ici que tout a basculé.","ar":"هنا تحول كل شيء."}]}],"mistakes":[{"wrong":"la neutralité totale attribuée au documentaire","right":"le documentaire = un point de vue construit","why":"l’angle la sélection des images تصنع le sens."},{"wrong":"الإنفعال مع la voix off","right":"السؤال: quelle question le narrateur pose-t-il ?","why":"la voix off توجّه le regard قبل le fait."},{"wrong":"القبول بلا chiffre source","right":"quelle source ? quelle période ? quelle base ?","why":"le chiffre بلا base هشّ في le documentaire."},{"wrong":"la confusion entre le témoignage et la preuve","right":"le témoignage = le vécu, pas la statistique","why":"la preuve humaine و la preuve chiffrée تكملان لا تُغنيان."}],"dialogues":[{"title":"نقد وثائقي","ctx":"طالبة مع أستاذها","lines":[{"who":"Élève","fr":"Le documentaire est objectif, non ?","ar":"الوثائقي موضوعي، أليس كذلك؟"},{"who":"Prof","fr":"Il construit un récit : regardez l’ordre des témoignages.","ar":"ينشئ سرداً: انظر إلى ترتيب الشهادات."},{"who":"Élève","fr":"Et la voix off oriente le regard.","ar":"والصوت الموسّق يوجّه النظر."},{"who":"Prof","fr":"Exactement : demandez la thèse cachée.","ar":"بالضبط: اسأل عن الأطروحة المخفية."}]},{"title":"préparation d’un reportage","ctx":"هيئة تحرير","lines":[{"who":"Cheffe","fr":"Votre accroche commence par quel chiffre ?","ar":"تبدأ افتتاحتك بأي رقم؟"},{"who":"Reporter","fr":"Quarante pour cent des fermes ont fermé.","ar":"أربعون بالمائة من المزارع أُغلقت."},{"who":"Cheffe","fr":"Bien, et la source ?","ar":"جيد، والمصدر؟"},{"who":"Reporter","fr":"Le recensement de deux mille vingt-deux.","ar":"التعداد لعام ألفان واثنان وعشرون."}]}],"exercises":[{"t":"mcq","skill":"analysis","q":"ما les quatre temps du documentaire ?","opts":["الافتتاحية، التحقيق، الشهادة، الخاتمة","المقدمة، التاريخ، المراجع، الخاتمة","التعريف، المقارنة، التقييم، التوصية","الصورة، الصوت، النص، العنوان"],"a":0,"why":"la structure classique du récit documentaire."},{"t":"fill","skill":"grammar","q":"أكمل بالpresent: «Le maire ___ les habitants chaque mardi.»","fr":"Le maire ___ les habitants chaque mardi.","ans":"reçoit","why":"le présent de narration في la voix off."},{"t":"mcq","skill":"analysis","q":"ما « la voix off »؟","opts":["السرد خارج الكادر","شهادة شاهد","موسيقى","عنوان"],"a":0,"why":"voix off = le narrateur hors champ."},{"t":"order","skill":"writing","q":"رتّب: كل شيء يبدأ هنا، في قلب القرية","words":["Tout","commence","ici,","au","cœur","du","village."],"ans":"Tout commence ici, au cœur du village.","why":"l’accroche la plus courante."},{"t":"listen","skill":"listening","q":"ما وظيفة « Si le conseil avait voté… »؟","opts":["بناء le suspense","la chronologie","la citation","le bilan"],"a":0,"why":"conditionnel + si يفتح le possible."},{"t":"translate","skill":"writing","q":"ترجم: الخاتمة تُعيد فتح السؤال بدل إغلاقه.","ans":"La chute rouvre la question au lieu de la clore.","why":"la chute ouverte du documentaire."},{"t":"speaking","skill":"speaking","q":"نقد وثائقي في 45 ثانية: « Il montre que…, mais il tait… ».","target":"Le documentaire montre que… / La voix off… / Le témoignage… / Mais il tait…","why":"la lecture critique."},{"t":"correct","skill":"analysis","q":"صحّح: «Quarante pour cent de plus, c’est clair.»","ans":"Quarante pour cent de plus par rapport à 2019, selon le recensement.","why":"le chiffre exige la base et la source."}],"homework":"شاهد 20 دقيقة من وثائقي فرنسي، اكتب la structure الكاملة ثم la thèse implicit في جملتين، ثم سجّل نقداً من 45 ثانية.","sources":[{"title":"Le documentaire français : du constat au récit","channel":"Documentaire Société","videoId":"URkSwnrvGoM","why":"وثائقي يجمع la voix off مع les témoignages — la matière المثالية لتحليل la structure: accroche، enquête، témoignage، conclusion.","cat":"Médias","level":"B2","main":true},{"title":"Comment réaliser un documentaire","channel":"France Culture","videoId":"bL6kUjSRkow","why":"le making-of qui révèle les choix derrière chaque image.","cat":"Médias","level":"B2","extra":true},{"title":"Emmanuel Macron appelle au calme pour avancer sur la mobilisation des lycées","channel":"M6 Info","videoId":"Om6u97jm0yk","why":"un extrait court pour comparer le reportage et le documentaire long.","cat":"Médias","level":"B2","extra":true}],"supplements":[{"id":"bL6kUjSRkow","title":"Comment réaliser un documentaire","channel":"France Culture","why":"le making-of qui révèle les choix derrière chaque image.","lang":"fr","dur":20},{"id":"Om6u97jm0yk","title":"Emmanuel Macron appelle au calme pour avancer sur la mobilisation des lycées","channel":"M6 Info","why":"un extrait court pour comparer le reportage et le documentaire long.","lang":"fr","dur":1}]},{"id":"b2-t6-l5","fr":"La publicité persuasive","ar":"الإعلان المُقنِع","objectives":["تحليل les techniques: slogan, promesse, preuve, appel à l’émotion","تمييز le registre courant عن le registre associatif","استعمال le lexique: produit, cible, promesse, bénéfice, arnaque","إنتاج slogan من ثلاث كلمات في le registre attendu"],"sections":[{"h":"الدرس 5: كيف يُقنعك الإعلان الفرنسي وكيف تكشف أساليبه","video":{"id":"Wx44ERpK7nQ","title":"La publicité : décryptage d’une promesse","channel":"Le Figaro","why":"تحليل la mécanique la publicité: le slogan، la promesse، la preuve sociale، et la baseline — مع أمثلة من la réclame française.","lang":"fr","main":true,"dur":13},"p":["la publicité لا تبيع le produit بل elle vend la promesse: « Plus de temps pour vous. » le produit هو la preuve المزعومة، أما le texte فيبني le désir عبر la répétition، le rythme، et l’image sociale. la cible ليست le consommateur mais le manque.","معجم الدرس: le slogan, la promesse, la baseline, le bénéfice, la cible, le produit, la preuve sociale, l’appel à l’émotion, l’offre, la garantie, la mention légale, l’argumentaire. هذه المفردات تفكّك le texte publicitaire.","نحوياً، l’impératif يحكم la publicité: « Goûtez. », « Découvrez. », « Optez pour… ». le présentatif « c’est » يُعرّف: « C’est simple, c’est efficace. » — la phrase courte هي la signature.","la preuve sociale تأتي بالchiffres المُجمَّع: « 9 utilisateurs sur 10… »، et la mention légale تخفي la limite: « selon une étude menée sur 200 personnes. » la disproportion بين la promesse و la mention هي le signal.","الدرس الأهم: le slogan لا يُترجم — يُحفظ. « Parce que vous le méritez bien » هي la phrase التي تبقى، و le traducteur يبحث عن l’équivalent culturel لا le mot.","بعد الدرس: خذ ثلاثة إعلانات فرنسية، اكتب لكل واحد: la promesse، la preuve، ثم la mention المخفية — وقارن les trois."],"sub":[{"h":"بنية la promesse","p":["Le slogan : trois mots, une promesse.","La preuve : un chiffre, une étude.","La mention : la limite, discrète."]},{"h":"أدوات نطقية: l’appel","p":["« Découvrez le nouveau… » [de.ku.vʁe] — l’impératif d’appel.","« Parce que vous le méritez. » — la justification affective.","« Ne ratez plus rien. » — la peur de manquer."]},{"h":"خطوات le décryptage","p":["الخطوة الأولى: استخرج la promesse في جملة واحدة.","الثانية: ابحث عن la preuve.","الثالثة: اقرأ la mention légale ببطء."]}]},{"h":"la carte du texte publicitaire","p":["« Découvrez… » = اكتشفوا… — l’impératif le plus employé.","« Parce que vous le méritez. » — la justification affective.","« 9 personnes sur 10 recommandent… » — la preuve sociale.","« Offre valable jusqu’au 30 juin. » — la limite temporelle."]},{"h":"التطبيق والتلخيص","p":["تمرين le slogan: اكتب سlogans ثلاث كلمات عن منتج من يومك، ثم اقرأها بصوت إعلاني.","تمرين la mention: خذ إعلاناً وأضف mention légale صادقة تُحدّد la portée réelle de la promesse.","سجّل إعلاناً من 20 ثانية: la promesse، la preuve، ثم l’appel — بلا مبالغة."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: تفكيك تقنيات الإعلان المُقنِع؛ أعد مشاهدة الفيديو الرئيسي وركّز على بنية الوعود والدليل الاجتماعي.","جسر الدروس: من b2-t6-l4 (قراءة بنية الوثائقي وصوته السردي) إلى b2-t6-l5 (تفكيك تقنيات الإعلان المُقنِع)، ثم إلى b2-t6-l6 حيث تنتقل من الإعلان المدفوع إلى لغة الشبكات الاجتماعية (التفاهم على لغة الشبكات الاجتماعية واستخدامها).","مهمة تطبيقية: سجّل صوتك في دقيقةٍ واحدة تلخّص فيها أهم ثلاث أفكار من هذا الدرس، واستعمل 3 كلمات جديدة من قاموسه، ثم قارن أدائك بمقتطف من الفيديو الرئيسي وحدّد الفروق."]}],"pron":[{"w":"le slogan","ipa":"[lə slɔ.ɡɑ̃]","approx":"لو سلوغان"},{"w":"la promesse","ipa":"[la pʁɔ.mɛs]","approx":"لا بروميس"},{"w":"persuader","ipa":"[pɛʁ.sɥ.a.de]","approx":"بيرسوادي"}],"vocab":[{"fr":"le slogan","ar":"الشعار الإعلاني","pos":"nom","g":"m","exFr":"Le slogan est mémorable.","ipa":"[slɔ.ɡɑ̃]","exAr":"الشعار قابل للتذكّر."},{"fr":"la promesse","ar":"الوعد الإعلاني","pos":"nom","g":"f","exFr":"La promesse doit être vraie.","ipa":"[pʁɔ.mɛs]","exAr":"الوعد يجب أن يكون صادقاً."},{"fr":"la baseline","ar":"العبارة المفتاحية","pos":"nom","g":"f","exFr":"La baseline accompagne la marque.","ipa":"[bɛs.laɪn]","exAr":"العبارة المفتاحية ترافق العلامة."},{"fr":"le bénéfice","ar":"الفائدة الموعودة","pos":"nom","g":"m","exFr":"Quel bénéfice pour le client ?","ipa":"[be.ne.fis]","exAr":"ما الفائدة للعميل؟"},{"fr":"la cible","ar":"الفئة المستهدفة","pos":"nom","g":"f","exFr":"La cible est jeune et urbaine.","ipa":"[si.bl]","exAr":"الفئة المستهدفة شابة حضرية."},{"fr":"la preuve sociale","ar":"الدليل الاجتماعي","pos":"nom","g":"f","exFr":"La preuve sociale rassure.","ipa":"[pʁœv sɔ.sj.al]","exAr":"الدليل الاجتماعي يطمئن."},{"fr":"l’appel à l’émotion","ar":"الاستدعاء العاطفي","pos":"nom","g":"m","exFr":"L’appel à l’émotion domine cette pub.","ipa":"[a.pɛl a le.mo.sjɔ̃]","exAr":"الاستدعاء العاطفي يسيطر على هذا الإعلان."},{"fr":"la mention légale","ar":"الإشارة القانونية","pos":"nom","g":"f","exFr":"La mention légale précise les limites.","ipa":"[mɑ̃.sjɔ̃ le.ɡal]","exAr":"الإشارة القانونية تحدّد الحدود."},{"fr":"le produit","ar":"المنتج","pos":"nom","g":"m","exFr":"Le produit est présenté en pleine lumière.","ipa":"[lə pʁɔ.dyi]","exAr":"المنتج مقدَّم في أبهى صورة."},{"fr":"le label","ar":"الوسم أو الشهادة الضامنة في الإعلان","pos":"nom","g":"m","exFr":"Le label affiché rassure instantanément le consommateur.","ipa":"[lə la.bɛl]","exAr":"يمنح الوسمُ المعروضُ المستهلكَ ضمانةً فورية."},{"fr":"promettre","ar":"يَعِد","pos":"verbe","g":"","exFr":"Il promet un résultat rapide.","ipa":"[pʁɔ.mɛtʁ]","exAr":"يعِد بنتيجة سريعة."},{"fr":"cibler","ar":"يستهدف","pos":"verbe","g":"","exFr":"La campagne cible les jeunes.","ipa":"[si.ble]","exAr":"الحملة تستهدف الشباب."}],"examples":[{"fr":"Découvrez la nouvelle gamme dès maintenant.","ar":"اكتشفوا المجموعة الجديدة الآن.","note":"l’impératif"},{"fr":"Parce que vous le méritez bien.","ar":"لأنكم تستحقونه حقاً.","note":"la justification affective"},{"fr":"Neuf personnes sur dix recommandent ce service.","ar":"تسعة من كل عشرة يوصون بهذه الخدمة.","note":"la preuve sociale"},{"fr":"Offre valable jusqu’au trente juin.","ar":"العرض ساري حتى الثلاثين من يونيو.","note":"la mention"},{"fr":"C’est simple, c’est efficace.","ar":"إنه بسيط، إنه فعّال.","note":"le présentatif"},{"fr":"Ce slogan est difficile à traduire.","ar":"هذا الشعار صعب الترجمة.","note":"la règle"}],"grammar":[{"tFr":"L’impératif et le présentatif dans la pub","tAr":"الأمر و le présentatif dans la pub","body":["la publicité تحكمها l’impératif: « Découvrez », « Optez pour », « Goûtez » — الفعل بلا فاعل يجعل le spectateur le héros de l’action.","le présentatif « c’est » يختصر le jugement: « C’est simple, c’est efficace. » la phrase la plus courte هي la plus persuasive في le registre publicitaire."],"ex":[{"fr":"Optez pour l’offre découverte.","ar":"اختاروا العرض التجريبي."},{"fr":"C’est le choix des jeunes actifs.","ar":"إنه اختيار الشباب العاملين."}]},{"tFr":"La promesse et sa limite : la mention légale","tAr":"الوعد وحدّه: الإشارة القانونية","body":["la promesse تأتي في le grand corps et la limit في la mention: « 9 sur 10… » ثم « selon une étude sur 200 personnes menée en 2023 ». la disproportion elle-même est un argument à décoder.","le conditionnel يظهر quand la marque تتحفظ: « pourrait améliorer… » — la marque تحمي نفسها بنفس le texte."],"ex":[{"fr":"Ce produit pourrait améliorer votre confort.","ar":"قد يحسّن هذا المنتج راحتك."},{"fr":"Selon une étude menée sur deux cents personnes.","ar":"وفق دراسة أُجريت على مئتي شخص."}]}],"mistakes":[{"wrong":"la promesse تُقرأ كـ la preuve","right":"le slogan = la promesse، la preuve تُطلب","why":"la publicité تبيع le désir لا le fait."},{"wrong":"la mention légale تُتجاهل","right":"la lecture de la mention تكشف la portée","why":"le diable se cache dans les mentions."},{"wrong":"la traduction littérale du slogan","right":"la recherche d’un équivalent culturel","why":"le slogan يعيش في la culture لا في le dictionnaire."},{"wrong":"le rejet total de la publicité","right":"le décryptage pour décider","why":"la lucidité أنفع من le mépris."}],"dialogues":[{"title":"تحليل إعلان","ctx":"زملاء يشاهدون إعلاناً","lines":[{"who":"Marc","fr":"« Parce que vous le méritez » : ça marche.","ar":"«لأنكم تستحقونه»: هذا ينجح."},{"who":"Nadia","fr":"Mais quelle est la preuve derrière ?","ar":"ولكن ما الدليل وراءه؟"},{"who":"Marc","fr":"La mention dit : étude sur deux cents personnes.","ar":"الإشارة تقول: دراسة على مئتي شخص."},{"who":"Nadia","fr":"Voilà : la promesse est large, la preuve est petite.","ar":"ها نحن: وعد واسع، ودليل صغير."}]},{"title":"campagne publicitaire","ctx":"اجتماع وكالة إعلان","lines":[{"who":"Cheffe","fr":"Notre slogan tient en trois mots ?","ar":"شعارنا في ثلاث كلمات؟"},{"who":"Créatif","fr":"Oui : simplicité, rapidité, confiance.","ar":"نعم: بساطة، سرعة، ثقة."},{"who":"Cheffe","fr":"Et le bénéfice pour la cible ?","ar":"والفائدة للفئة المستهدفة؟"},{"who":"Créatif","fr":"Gagner du temps, chaque jour.","ar":"ربح الوقت، كل يوم."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما معنى « la baseline »؟","opts":["العبارة المفتاحية","المنتج","الفئة المستهدفة","الضمان"],"a":0,"why":"baseline = العبارة الثابتة للعلامة."},{"t":"fill","skill":"grammar","q":"أكمل: «___ le nouveau parfum dès maintenant.»","fr":"___ le nouveau parfum dès maintenant.","ans":"Découvrez","why":"l’impératif حاكم في la publicité."},{"t":"mcq","skill":"analysis","q":"ما « la preuve sociale »؟","opts":["الدليل بأن غيرك يشتري أيضاً","السعر","اللون","التاريخ"],"a":0,"why":"la preuve sociale تستثمر le conformisme."},{"t":"order","skill":"writing","q":"رتّب: تسعة من كل عشرة يوصون بهذه الخدمة","words":["Neuf","personnes","sur","dix","recommandent","ce","service."],"ans":"Neuf personnes sur dix recommandent ce service.","why":"la preuve sociale بالchiffre."},{"t":"listen","skill":"listening","q":"ما la fonction de « Selon une étude… »؟","opts":["تحديد la portée de la promesse","التشويق","التعريف بالمنتج","la signature de la marque"],"a":0,"why":"la mention légale تكشف la base."},{"t":"translate","skill":"writing","q":"ترجم: العرض ساري حتى الثلاثين من يونيو.","ans":"Offre valable jusqu’au trente juin.","why":"la mention de l’offre."},{"t":"speaking","skill":"speaking","q":"اكتب slogan من ثلاث كلمات عن منتج ثم اشرح la promesse في 30 ثانية.","target":"Le slogan… / La promesse… / La preuve… / La limite…","why":"la mécanique publicitaire."},{"t":"correct","skill":"analysis","q":"صحّح: «Ce produit est génial, tout le monde l’utilise.»","ans":"Selon une étude, quatre-vingts pour cent des utilisateurs le recommandent.","why":"la promesse الصارمة تحتاج la preuve محددة."}],"homework":"اختر ثلاثة إعلانات فرنسية واكتب لكل واحد: la promesse، la preuve، la mention — ثم قارن: أيها يَعِد أكثر وأيها يُثبت أكثر.","sources":[{"title":"La publicité : décryptage d’une promesse","channel":"Le Figaro","videoId":"Wx44ERpK7nQ","why":"تحليل la mécanique la publicité: le slogan، la promesse، la preuve sociale، et la baseline — مع أمثلة من la réclame française.","cat":"Médias","level":"B2","main":true},{"title":"Histoire de la publicité en France","channel":"France 5","videoId":"9LWAjeG_dKs","why":"la généalogie de la réclame: من le slogan الكلاسيكي إلى la publicité numérique.","cat":"Médias","level":"B2","extra":true},{"title":"Les techniques de persuasion dans la publicité","channel":"Le Figaro","videoId":"WUxpX43tflg","why":"décryptage des arguments: preuve sociale، urgence، autorité.","cat":"Médias","level":"B2","extra":true}],"supplements":[{"id":"9LWAjeG_dKs","title":"Histoire de la publicité en France","channel":"France 5","why":"la généalogie de la réclame: من le slogan الكلاسيكي إلى la publicité numérique.","lang":"fr","dur":18},{"id":"WUxpX43tflg","title":"Les techniques de persuasion dans la publicité","channel":"Le Figaro","why":"décryptage des arguments: preuve sociale، urgence، autorité.","lang":"fr","dur":12}]},{"id":"b2-t6-l6","fr":"Les réseaux sociaux","ar":"وسائل التواصل الاجتماعي","objectives":["تحليل la mécanique de l’attention: algorithme, scroll, buzz","استعمال le registre adapté: post, commentaire, story, débat","تمييز l’information vérifiée عن la rumeur في les fils","إنتاج post من 200 حرف مع un hook واضح"],"sections":[{"h":"الدرس 6: كيف تفهم لغة الفرنسيين على الشبكات وتكتب فيها بذكاء","video":{"id":"aFvgmZ46auk","title":"Les réseaux sociaux : la bataille de l’attention","channel":"Documentaire Société","why":"وثائقي عن l’économie de l’attention: كيف تُصمَّم les plateformes للاحتفاظ بك، وكيف يصنع le buzz la vérité.","lang":"fr","main":true,"dur":42},"p":["le réseau social ليس le journal: la phrase قصيرة، le hook في les premières secondes، et le commentaire يصنع la visibilité. le même contenu qui ينجح في la presse يفشل هنا — la plateforme تكافئ l’engagement لا la nuance.","معجم الدرس: le fil, le post, le commentaire, le like, le partage, le buzz, l’algorithme, l’audience, le ratio, l’abonné, la story, le thread, la vérification. هذه المفردات تصف l’économie de l’attention.","نحوياً، le style يصير laconique: « Je ne comprends pas. » ← « Je comprends pas. »، et l’élision تنتشر. في المقابل le commentaire argumenté يستعمل les connecteurs كاملة: « Cependant… », « En fait… » — la différence تحدّد le ton.","la règle de vérification: قبل le partage اسأل ثلاث أسئلة — qui signale ? depuis quand ? d’autres sources confirment-elles ? « Un ami m’a dit » ليست une source.","الدرس الأهم: l’algorithme ليس حائداً — يُظهر ما يُتفاعَل معه. le silence حول قضية في le fil قد يعني la curation لا l’indifférence.","بعد الدرس: اكتب post من 200 حرف عن قضية، ثم اكتب commentaire من جملتين يعارضه باحترام، ثم راقب: أيهما حصل على تفاعل أكثر ولماذا."],"sub":[{"h":"لغة le fil","p":["Le hook compte plus que la conclusion.","Un post sans source reste une rumeur.","Le commentaire argumenté gagne en crédibilité."]},{"h":"أدوات نطقية: l’accroche","p":["« Personne ne parle de ce détail. » — le hook de curiosité.","« Voici ce que dit la source. » — la vérification.","« Contrairement à ce qu’on croit… » — le retournement."]},{"h":"خطوات la vérification","p":["الخطوة الأولى: حدد l’auteur de l’info.","الثانية: ابحث عن la source الأصلية.","الثالثة: قارن مع deux autres sources."]}]},{"h":"عبارات le fil","p":["« Voici ce que les chiffres montrent. » = هذا ما تُظهره الأرقام — l’ouverture factuelle.","« Contrairement à ce qu’on croit… » — le retournement qui retient.","« Je nuance : la source est ancienne. » — la prudence في le fil.","« On peut débattre, mais restons sur les faits. » — la règle du débat."]},{"h":"التطبيق والتلخيص","p":["تمرين le hook: اكتب ثلاثة opening hooks لـ la même information ثم اختبر أيها يوقف le scroll.","تمرين la vérification: خذ « info » متداولة، ابحث عن sa source، ثم اكتب جملتين تصحّح فيها.","سجّل تعليقاً صوتياً من 30 ثانية: la thèse، la preuve، ثم la nuance — بلا هجوم."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: التفاهم على لغة الشبكات الاجتماعية واستخدامها؛ أعد مشاهدة الفيديو الرئيسي وركّز على الفروق بين الخطاب الرسمي ومنصّات التواصل.","جسر الدروس: من b2-t6-l5 (تفكيك تقنيات الإعلان المُقنِع) إلى b2-t6-l6 (التفاهم على لغة الشبكات الاجتماعية واستخدامها)، ثم إلى b2-t7-l1 حيث تنتقل من الشبكات إلى مؤسسة المدرسة الفرنسية ومنظومة التعليم (المدرسة الفرنسية).","مهمة تطبيقية: اكتب دقيقةً من الكتابة (نحو 100 كلمة) تلخّص فيها أهم ثلاث أفكار من هذا الدرس، واستعمل 3 كلمات جديدة من قاموسه، ثم قارن نصّك بمقتطف من الفيديو الرئيسي وحدّد الفروق."]}],"pron":[{"w":"le fil","ipa":"[lə fil]","approx":"لو فيل"},{"w":"le buzz","ipa":"[lə bʏz]","approx":"لو بز"},{"w":"l’algorithme","ipa":"[al.ɡɔ.ʁit.m]","approx":"الخوارزمية"}],"vocab":[{"fr":"le fil","ar":"الموجز / الخيط","pos":"nom","g":"m","exFr":"Le fil m’affiche l’actu.","ipa":"[fil]","exAr":"الموجز يعرض لي الخبر."},{"fr":"le post","ar":"المنشور","pos":"nom","g":"m","exFr":"Ce post a fait le tour.","ipa":"[pɔst]","exAr":"هذا المنشور انتشر."},{"fr":"la réaction","ar":"ردّ الفعل المنشور تحت المنشور","pos":"nom","g":"f","exFr":"La réaction la plus partagée ouvre un débat nourri.","ipa":"[la ʁe.ak.sjɔ̃]","exAr":"يوفّح أكثرُ ردودِ الفعلِ تداولاً نقاشاً حيوياً."},{"fr":"le partage","ar":"المشاركة","pos":"nom","g":"m","exFr":"Le partage augmente la visibilité.","ipa":"[paʁ.taʒ]","exAr":"المشاركة تزيد الظهور."},{"fr":"l’algorithme","ar":"الخوارزمية","pos":"nom","g":"m","exFr":"L’algorithme privilégie l’engagement.","ipa":"[al.ɡɔ.ʁit.m]","exAr":"الخوارزمية تُفضّل التفاعل."},{"fr":"l’engagement","ar":"معدل تفاعل الجمهور على المنشور","pos":"nom","g":"m","exFr":"L’engagement compte plus que le nombre de vues.","ipa":"[lɑ̃.ɡaʒ.mɑ̃]","exAr":"يهمّ التفاعلُ أكثرَ من عددِ المشاهدات."},{"fr":"le buzz","ar":"الانتشار المفاجئ","pos":"nom","g":"m","exFr":"Le buzz a duré trois jours.","ipa":"[bʏz]","exAr":"الانتشار المفاجئ دام ثلاثة أيام."},{"fr":"la vérification","ar":"التحقّق","pos":"nom","g":"f","exFr":"La vérification prend deux minutes.","ipa":"[ve.ʁi.fi.ka.sjɔ̃]","exAr":"التحقّق يستغرق دقيقتين."},{"fr":"authentifier","ar":"يُوثّق صحة الخبر","pos":"verbe","g":"","exFr":"Il faut authentifier l’information avant de la relayer.","ipa":"[o.tɑ̃.ti.fje]","exAr":"يجب توثيقُ صحةِ الخبر قبل تناقله."},{"fr":"relayer","ar":"يُعيد النشر","pos":"verbe","g":"","exFr":"Il a relayé l’information.","ipa":"[ʁə.le]","exAr":"أعاد نشر المعلومة."},{"fr":"débattre sur","ar":"يناقش حول","pos":"loc.","g":"","exFr":"Ils débattent sur le fil.","ipa":"","exAr":"يناقشون في الموجز."},{"fr":"se méfier de","ar":"يشكّ في","pos":"loc.","g":"","exFr":"Il faut se méfier des titres.","ipa":"","exAr":"يجب الشك في العناوين."}],"examples":[{"fr":"Personne ne parle de ce détail.","ar":"لا أحد يتحدث عن هذا التفصيل.","note":"le hook"},{"fr":"Voici ce que disent les chiffres officiels.","ar":"هذا ما تقوله الأرقام الرسمية.","note":"la vérification"},{"fr":"Contrairement à ce qu’on croit, la source est publique.","ar":"خلافاً لما يُعتقد، المصدر عام.","note":"le retournement"},{"fr":"Je nuance : l’étude date de deux ans.","ar":"أُدخل تمييزاً: الدراسة تعود لعامين.","note":"la prudence"},{"fr":"On peut débattre, mais restons sur les faits.","ar":"يمكن النقاش، لكن لنتمسك بالوقائع.","note":"la règle du fil"},{"fr":"Le post sans source reste une rumeur.","ar":"المنشور بلا مصدر يبقى إشاعة.","note":"la vérification"}],"grammar":[{"tFr":"Le style laconique et la perte de nuance","tAr":"الأسلوب الموجز وفقدان التمييز","body":["le fil يضغط la phrase: la négation بلا ne، les mots liés، les abréviations. le style يصبح efficace mais fragile — la nuance تخسر مع la longueur.","en revanche le commentaire argumenté يستعيد la structure: sujet، verbe، connecteur — la différence بين le react et le commentaire هي le temps accordé à la phrase."],"ex":[{"fr":"Je comprends pas ce post.","ar":"لا أفهم هذا المنشور.","note":"le registre du fil"},{"fr":"Cependant, la source mérite d’être vérifiée.","ar":"ومع ذلك، يستحق المصدر التحقق.","note":"le commentaire"}]},{"tFr":"La vérification : trois questions","tAr":"التحقّق: ثلاثة أسئلة","body":["avant le partage: 1) qui affirme ? 2) quelle est la source originale ? 3) d’autres sources indépendantes confirment-elles ? la réponse أوّلها يحدّد la nature de l’information.","la forme grammaticale تكشف le degré: « Il semblerait que… » (rumeur)، « L’étude démontre que… » (preuve). la lecture de la forme تسبق la lecture du fond."],"ex":[{"fr":"Il semblerait que le service soit fermé.","ar":"يُقال إن الخدمة مغلقة."},{"fr":"L’étude démontre que l’effet est limité.","ar":"تُثبت الدراسة أن الأثر محدود."}]}],"mistakes":[{"wrong":"la partage قبل la vérification","right":"trois questions avant le geste","why":"l’information false تنتشر أسرع من صحّتها."},{"wrong":"الكتاب بلا hook","right":"une accroche في la première ligne","why":"le fil لا يمنح la deuxième chance."},{"wrong":"la confusion بين le buzz et la preuve","right":"le buzz = attention، la preuve = source","why":"الانتشار لا يعني الصحّة."},{"wrong":"le ton agressif في le commentaire","right":"« Je nuance… » / « Cependant… »","why":"l’agression تُغلق le débat وتُفقد la crédibilité."}],"dialogues":[{"title":"قبل المشاركة","ctx":"غرفة دراسة","lines":[{"who":"Nadia","fr":"Cette info circule partout, tu la partages ?","ar":"هذه المعلومة تنتشر في كل مكان، هل تشاركها؟"},{"who":"Marc","fr":"Attends : quelle est la source originale ?","ar":"انتظر: ما المصدر الأصلي؟"},{"who":"Nadia","fr":"Un compte anonyme, justement.","ar":"حساب مجهول، بالضبط."},{"who":"Marc","fr":"Alors on vérifie avant de relayer.","ar":"إذن نتحقّق قبل إعادة النشر."}]},{"title":"commentaire محترم","ctx":"نقاش في le fil","lines":[{"who":"Claire","fr":"Ton post simplifie trop le problème.","ar":"منشورك يبسّط المشكل أكثر من اللازم."},{"who":"Karim","fr":"Je nuance alors : le cas est plus complexe.","ar":"إذن أُدخل تمييزاً: الحالة أعقد."},{"who":"Claire","fr":"Voilà : restons sur les faits.","ar":"هكذا: لنتمسك بالوقائع."},{"who":"Karim","fr":"D’accord, et j’ajoute la source en commentaire.","ar":"حسناً، وأضيف المصدر في التعليق."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما معنى « le fil »؟","opts":["الموجز","المنتج","التعليق الصوتي","الحساب"],"a":0,"why":"le fil = la suite des posts que vous voyez."},{"t":"fill","skill":"grammar","q":"أكمل: «___ la source avant de partager.»","fr":"___ la source avant de partager.","ans":"Vérifiez","why":"l’impératif de vérification."},{"t":"mcq","skill":"analysis","q":"أي عبارة تُظهر la prudence ?","opts":["Il semblerait que…","C’est absolument vrai.","Tout le monde sait ça.","Évidemment."],"a":0,"why":"il semblerait que = le doute méthodique."},{"t":"order","skill":"writing","q":"رتّب: خلافاً لما يُعتقد، المصدر عام","words":["Contrairement","à","ce","qu’on","croit,","la","source","est","publique."],"ans":"Contrairement à ce qu’on croit, la source est publique.","why":"le retournement qui retient."},{"t":"listen","skill":"listening","q":"ما la première question avant le partage ?","opts":["من يَدّعي؟","كم كلمة؟","ما اللون؟","متى نشر؟"],"a":0,"why":"l’auteur يحدّد nature de l’information."},{"t":"translate","skill":"writing","q":"ترجم: المنشور بلا مصدر يبقى إشاعة.","ans":"Le post sans source reste une rumeur.","why":"la règle de vérification."},{"t":"speaking","skill":"speaking","q":"اكتب hook ثم علّق في جملتين باحترام على منشور مخالف.","target":"Voici ce que… / Cependant… / Je nuance… / Restons sur les faits.","why":"la crédibilité dans le fil."},{"t":"correct","skill":"analysis","q":"صحّح: «C’est vrai, mon ami me l’a dit.»","ans":"La source est un compte anonyme : à vérifier.","why":"un ami n’est pas une source."}],"homework":"اكتب منشوراً من 200 حرف عن قضية يومية مع hook، ثم تعليقاً معارضاً في جملتين بـ « Cependant… » — وسجّل أيهما يستحق التفاعل ولماذا.","sources":[{"title":"Les réseaux sociaux : la bataille de l’attention","channel":"Documentaire Société","videoId":"aFvgmZ46auk","why":"وثائقي عن l’économie de l’attention: كيف تُصمَّم les plateformes للاحتفاظ بك، وكيف يصنع le buzz la vérité.","cat":"Médias","level":"B2","main":true},{"title":"New TeAch - Présentation claire et structurée","channel":"Université de Tours","videoId":"unViGMfngyE","why":"une présentation orale nette : la même clarté nécessaire في le commentaire argumenté.","cat":"Médias","level":"B2","extra":true},{"title":"Les fausses informations sur les réseaux sociaux","channel":"Documentaire Société","videoId":"87vz_BYEc7s","why":"enquête sur la rumeur : كيف يُصنع le buzz وكيف يُفكّك la vérification.","cat":"Médias","level":"B2","extra":true}],"supplements":[{"id":"unViGMfngyE","title":"New TeAch - Présentation claire et structurée","channel":"Université de Tours","why":"une présentation orale nette : la même clarté nécessaire في le commentaire argumenté.","lang":"fr","dur":3},{"id":"87vz_BYEc7s","title":"Les fausses informations sur les réseaux sociaux","channel":"Documentaire Société","why":"enquête sur la rumeur : كيف يُصنع le buzz وكيف يُفكّك la vérification.","lang":"fr","dur":24}]}]},{"id":"b2-t7","slug":"culture-societe-francaise","icon":"globe","color":"#388e3c","fr":"Culture & société française","ar":"الثقافة والمجتمع الفرنسي","desc":"l’école، la gastronomie، la santé، les traditions، l’Europe، le patrimoine — la carte culturelle B2.","lessons":[{"id":"b2-t7-l1","fr":"L’école française","ar":"المدرسة الفرنسية","objectives":["وصف la structure de l’école: maternelle, collège, lycée, université","استعمال le lexique du quotidien scolaire: la rentrée, le programme, l’emploi du temps","التمييز بين l’université و les grandes écoles في le discours français","سرد parcours scolaire بصيغة l’imparfait + le passé composé"],"sections":[{"h":"الدرس 1: كيف تعمل المدرسة الفرنسية من maternelle إلى bac","video":{"id":"9LWAjeG_dKs","title":"Le système éducatif français","channel":"Français avec Pierre","why":"شرح كامل لبنية le système éducatif: maternelle، collège، lycée، bac — مع lexique officiel و Pourquoi مهم لفهم la culture française.","lang":"fr","main":true,"dur":14},"p":["المدرسة الفرنسية تُقسَّم بوضوح: l’école maternelle (3-6)، الوضع العام école élémentaire (6-11)، ثم le collège (11-15) بـ la décision، ثم le lycée (15-18) و le baccalauréat. le bac ليس امتحاناً عادياً بل la clé d’entrée.","المفردات الأساسية: la rentrée, le programme, l’emploi du temps, le carnet de correspondance, l’enseignant, le chef d’établissement, la cantine, l’internat, le stage, l’orientation. هذه المفردات هي la vie quotidienne de l’élève.","نحوياً، le récit du parcours يجمع l’imparfait (la routine) مع le passé composé (les événements): « J’allais au collège tous les jours, puis j’ai choisi la filière scientifique. »","le conditionnel يعبّر عن le souhait et l’hypothèse: « J’aurais aimé faire une classe prépa. », « Ce serait plus simple si… » — la nuance française تظهر هنا.","الاختلاف الأكبر مع البلدان الأخرى: la centralisation du programme، ثم le débat sur l’égalité des chances — le thème الأكثراً حضوراً في la chronique.","بعد الدرس: اشرح نظامك التعليمي بالفرنسية في خمس جمل: l’âge، la durée، l’examen final، ثم une critique واحدة بـ « Certes…, cependant… »."],"sub":[{"h":"مراحل الدراسة","p":["À six ans, on entre en cours élémentaire.","Le collège dure quatre ans, de la sixième à la troisième.","La terminale se termine par le baccalauréat."]},{"h":"أدوات نطقية: le quotidien scolaire","p":["« la rentrée » [la ʁɑ̃.tʁe] — la première journée de septembre.","« le carnet de correspondance » [lə kaʁ.nə də kɔ̃.spɔ̃.dɑ̃s] — liaison longue.","« l’orientation » [lɔ.ʁjɑ̃.ta.sjɔ̃] — le choix بعد la troisième."]},{"h":"خطوات Listen & Repeat","p":["المرة الأولى: اكتب les étapes فقط.","الثانية: أضف les âges et les durées.","الثالثة: أعد السرد بـ l’imparfait ثم le passé composé."]}]},{"h":"الكلمات الفرنسية عن المدرسة","p":["« J’ai fait ma scolarité à Lyon. » = أنهيت تعليمي في ليون — la façon naturelle de présenter son parcours.","« La rentrée est le 4 septembre. » — la date qui ouvre l’année.","« Il est en terminale. » = أنه في السنة الأخيرة من الثانوية.","« Il s’est orienté vers les sciences. » — la décision après la troisième."]},{"h":"التطبيق والتلخيص","p":["تمرين la timeline: ارسم خط الزمن لمسارك الدراسي بالفرنسية مع les âges.","تمرين la comparaison: قارن بين نظامك وبين le système français في ثلاث جمل.","سجّل نفسك تشرح le bac لشخص لم يسمع عنه: l’objet، les épreuves، ثم la valeur."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: بنينا le système éducatif من maternelle إلى le bac مع lexique la vie scolaire et le récit du parcours بـ l’imparfait + le passé composé. أعد مشاهدة الفيديو الرئيسي وركّز على les âges et les étapes لكل مرحلة يذكرها le conférencier.","جسر الدروس: من b2-t6-l6 (وسائل التواصل الاجتماعي) إلى b2-t7-l1 (بنية المدرسة الفرنسية)، ثم إلى b2-t7-l2 حيث ننتقل من la salle de classe إلى la cuisine لوصف الأطباق بـ le partitif et l’impératif.","مهمة تطبيقية: سجّل نفسك دقيقة واحدة تشرح فيها مسارك الدراسي بالفرنسية، واكتب ثلاث كلمات جديدة من الدرس واستعملها في ثلاث جمل، ثم قارن شرحك بالفيديو الرئيسي بـ « Contrairement à la vidéo, chez moi… »."]}],"pron":[{"w":"le baccalauréat","ipa":"[lə ba.kɔ.lo.ʁe.a]","approx":"لو باكالوريا"},{"w":"la rentrée","ipa":"[la ʁɑ̃.tʁe]","approx":"لا رانتري"},{"w":"l’orientation","ipa":"[lɔ.ʁjɑ̃.ta.sjɔ̃]","approx":"لوريونتاسيون"}],"vocab":[{"fr":"l’école maternelle","ar":"روضة الأطفال","pos":"nom","g":"f","exFr":"Il va à l’école maternelle depuis septembre.","ipa":"","exAr":"يذهب إلى الروضة منذ سبتمبر."},{"fr":"le collège","ar":"الإعدادية","pos":"nom","g":"m","exFr":"Le collège dure quatre ans.","ipa":"","exAr":"تستغرق الإعدادية أربع سنوات."},{"fr":"le lycée","ar":"الثانوية","pos":"nom","g":"m","exFr":"Mon lycée est à côté de la gare.","ipa":"","exAr":"ثانويتي بجانب المحطة."},{"fr":"le baccalauréat","ar":"شهادة البكالوريا","pos":"nom","g":"m","exFr":"Il a obtenu son bac avec mention.","ipa":"","exAr":"حصل على البكالوريا بتقدير."},{"fr":"la rentrée","ar":"بداية العام الدراسي","pos":"nom","g":"f","exFr":"La rentrée est le 4 septembre.","ipa":"","exAr":"يبدأ العام الدراسي في سبتمبر."},{"fr":"le programme","ar":"المنهاج","pos":"nom","g":"m","exFr":"Le programme de français est chargé.","ipa":"","exAr":"منهاج اللغة الفرنسية مثقّل."},{"fr":"l’emploi du temps","ar":"جدول الحصص","pos":"nom","g":"m","exFr":"Mon emploi du temps est complet.","ipa":"","exAr":"جدولي ممتلئ."},{"fr":"l’enseignant","ar":"المعلّم","pos":"nom","g":"m","exFr":"L’enseignant a noté l’absence.","ipa":"","exAr":"سجّل المعلم الغياب."},{"fr":"l’orientation","ar":"التوجيه","pos":"nom","g":"f","exFr":"L’orientation se décide en troisième.","ipa":"","exAr":"يُحسم التوجيه في السنة الثالثة من الإعدادية."},{"fr":"la classe prépa","ar":"السنة التحضيرية","pos":"nom","g":"f","exFr":"Il a fait deux ans de prépa.","ipa":"","exAr":"قضى سنتين في السنة التحضيرية."},{"fr":"le stage","ar":"التربص/التدريب","pos":"nom","g":"m","exFr":"Le stage dure deux mois.","ipa":"","exAr":"يستمر التربص شهرين."},{"fr":"l’université","ar":"الجامعة","pos":"nom","g":"f","exFr":"L’université est gratuite ici.","ipa":"","exAr":"الجامعة مجانية هنا."}],"examples":[{"fr":"J’allais au collège tous les matins.","ar":"كنت أذهب إلى الإعدادية كل صباح.","note":"l’imparfait de routine"},{"fr":"Puis j’ai choisi la filière scientifique.","ar":"ثم اخترت المسار العلمي.","note":"le passé composé d’événement"},{"fr":"J’aurais aimé faire une classe prépa.","ar":"كنت سأحب أن أدرس سنة تحضيرية.","note":"conditionnel de regret"},{"fr":"La rentrée est le 4 septembre.","ar":"يبدأ العام الدراسي في سبتمبر.","note":"la date"},{"fr":"Il s’est orienté vers les sciences.","ar":"توجّه نحو العلوم.","note":"l’orientation"},{"fr":"Certes le programme est dense, cependant il reste clair.","ar":"بلا شك المنهج مكتظ، لكنه يبقى واضحاً.","note":"la concession"}],"grammar":[{"tFr":"Imparfait et passé composé dans le récit","tAr":"المضارع البسيط والماضي المركب في السرد","body":["l’imparfait يصف la routine et le décor: « Je prenais le bus à sept heures. »، و le passé composé يقطع le récit بالحدث: « J’ai passé le bac en juin. »","القاعدة العملية: خلفية = imparfait، حدث = passé composé. le récit du parcours scolaire يعتمد عليهما معاً."],"ex":[{"fr":"Je prenais le bus, puis j’ai rencontré mon prof de français.","ar":"كنت أستقل الحافلة، ثم قابلت أستاذي في الفرنسية."},{"fr":"Nous étions vingt-cinq dans la classe et l’année a duré dix mois.","ar":"كنا خمسة وعشرين في القسم واستمرت السنة عشرة أشهر."}]},{"tFr":"Le conditionnel : souhait et hypothèse","tAr":"الشرطية: التمني والافتراض","body":["« J’aimerais… », « Je préférerais… » = le souhait المهذّب، و « Ce serait… si… » = l’hypothèse.","في la discussion scolaire، le conditionnel يحل محل l’impératif: « On pourrait réformer le bac. » بدل « Il faut réformer le bac. »"],"ex":[{"fr":"J’aimerais m’inscrire à l’université.","ar":"أودّ الالتحاق بالجامعة."},{"fr":"Ce serait plus simple si le stage était obligatoire.","ar":"كان سيكون أسهل لو كان التربص إلزامياً."}]}],"mistakes":[{"wrong":"« J’ai fait l’école à huit ans. »","right":"« J’ai commencé l’école à six ans. »","why":"on ne fait pas l’école، on y commence ou on la fréquente."},{"wrong":"الخلط بين college و le lycée","right":"collège = الإعدادية، lycée = الثانوية","why":"les deux expressions تعنيان مراحل مختلفة تماماً."},{"wrong":"« Je veux faire du stage. »","right":"« Je voudrais faire un stage. »","why":"le conditionnel هو la marque du souhait في الفرنسية."},{"wrong":"تجاهل la nuance في la critique","right":"« Certes…, cependant… »","why":"la critique الفرنسية تبدأ بالتَّسليم لا بالرفض."}],"dialogues":[{"title":"تقديم المسار الدراسي","ctx":"طالب جديد في فصل","lines":[{"who":"Karim","fr":"J’ai fait ma scolarité à Tunis, puis je suis arrivé ici.","ar":"أنهيت تعليمي في تونس ثم وصلت إلى هنا."},{"who":"Léa","fr":"Tu as fait quelle filière ?","ar":"أي مسار درست؟"},{"who":"Karim","fr":"J’ai choisi les sciences après la troisième.","ar":"اخترت العلوم بعد السنة الثالثة."},{"who":"Léa","fr":"Moi, j’aurais aimé faire une prépa.","ar":"أنا، كنت سأحب أن أدرس سنة تحضيرية."}]},{"title":"معلم يشرح le bac","ctx":"ورشة توجيه","lines":[{"who":"Prof","fr":"Le baccalauréat a lieu en juin.","ar":"تُجرى البكالوريا في يونيو."},{"who":"Élève","fr":"Et après, on choisit l’université ?","ar":"وبعدها نختار الجامعة؟"},{"who":"Prof","fr":"Certes, mais l’orientation se décide avant.","ar":"بلا شك، لكن التوجيه يُحسم قبلها."},{"who":"Élève","fr":"D’accord, je vais y réfléchir.","ar":"موافق، سأفكر في الأمر."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"كم سنة يستمر le collège؟","opts":["4 سنوات","3 سنوات","5 سنوات","سنتان"],"a":0,"why":"collège = من sixth إلى troisième، أي أربع سنوات."},{"t":"fill","skill":"grammar","q":"أكمل: «La ___ est le 4 septembre.»","fr":"La ___ est le 4 septembre.","ans":"rentrée","why":"la rentrée = بداية العام الدراسي."},{"t":"mcq","skill":"grammar","q":"أي زمن يصف la routine؟","opts":["l’imparfait","le passé simple","le futur","l’impératif"],"a":0,"why":"l’imparfait يصف la routine et le décor."},{"t":"order","skill":"writing","q":"رتّب: درست في مدرسة ابتدائية بالقرب من محطة القطار","words":["J’ai","fait","mon","primaire","près","de","la","gare."],"ans":"J’ai fait mon primaire près de la gare.","why":"le parcours scolaire au passé composé."},{"t":"listen","skill":"listening","q":"ما le choix المذكور بعد la troisième؟","opts":["l’orientation","le stage","la cantine","le bac"],"a":0,"why":"l’orientation se décide en troisième."},{"t":"translate","skill":"writing","q":"ترجم: كنت سأحب أن أدرس سنة تحضيرية.","ans":"J’aurais aimé faire une classe prépa.","why":"conditionnel passé de regret."},{"t":"speaking","skill":"speaking","q":"اشرح نظامك التعليمي في خمس جمل مع les âges.","target":"À six ans… / Ensuite… / J’ai choisi… / La rentrée… / Le bac…","why":"le récit du parcours."},{"t":"correct","skill":"grammar","q":"صحّح: «Je veux faire du stage cet été.»","ans":"Je voudrais faire un stage cet été.","why":"le conditionnel pour le souhait."}],"homework":"اكتب فقرة من 100 كلمة عن حياتك المدرسية: الخلفية بـ l’imparfait، الأحداث بـ le passé composé، ثم جملة واحدة بـ le conditionnel تعبر عن تمنٍّ.","sources":[{"title":"Le système éducatif français","channel":"Français avec Pierre","videoId":"9LWAjeG_dKs","why":"شرح كامل لبنية le système éducatif: maternelle، collège، lycée، bac — مع lexique officiel و Pourquoi مهم لفهم la culture française.","cat":"Culture","level":"B2","main":true},{"title":"École française : pourquoi les meilleurs élèves disparaissent","channel":"Le Figaro","videoId":"Wx44ERpK7nQ","why":"ثرثرة إعلامية عن la crise de l’école — lexique مقترن بالنقاش العمومي.","cat":"Culture","level":"B2","extra":true},{"title":"ÉTABLIR UN FAIT SCIENTIFIQUE | Chanson pédagogique B2","channel":"Frenchecho","videoId":"OWdNRcD4KSg","why":"chanson pédagogique — la revision en contexte scolaire بلا حفظ جاف.","cat":"Culture","level":"B2","extra":true}],"supplements":[{"id":"Wx44ERpK7nQ","title":"École française : pourquoi les meilleurs élèves disparaissent","channel":"Le Figaro","why":"ثرثرة إعلامية عن la crise de l’école — lexique مقترن بالنقاش العمومي.","lang":"fr","dur":13},{"id":"OWdNRcD4KSg","title":"ÉTABLIR UN FAIT SCIENTIFIQUE | Chanson pédagogique B2","channel":"Frenchecho","why":"chanson pédagogique — la revision en contexte scolaire بلا حفظ جاف.","lang":"fr","dur":5}]},{"id":"b2-t7-l2","fr":"La gastronomie française","ar":"الطهي الفرنسي","objectives":["وصف les plats et les goûts بـ le partitif et les adjectifs de goût","استعمال l’impératif و le mode impersonnel في la recette","التمييز بين l’apéritif, le plat principal, le fromage et le dessert","التحدث عن le terroir et le marché كما يفعل les Français"],"sections":[{"h":"الدرس 2: كيف تتحدث عن الطعام والطبخ بالفرنسية","video":{"id":"WUxpX43tflg","title":"TOP 10 PLATS PRÉFÉRÉS DES FRANÇAIS","channel":"TOPéQUIZ","why":"قائمة سريعة بأطباق la cuisine française — lexique concret عن les plats والوصف اليومي، مناسبة للاستماع المتكرر.","lang":"fr","main":true,"dur":1},"p":["la table الفرنسية لها rituel: l’apéritif ثم entrée ثم plat principal ثم le fromage ثم le dessert. هذا التسلسل هو la grammaire sociale، ومعرفته أهم من معرفة كل الأسماء.","المفردات الأساسية: le terroir, la spécialité, la recette, le marché, le produit local, le chef, l’addition, la carte, l’apéritif, la baguette, le fromage, le vin. هذه هي la boîte à outils du quotidien.","نحوياً، le partitif يعبّر عن la quantité indéterminée: « Je voudrais du pain, de la soupe, de l’huile. » و la négation تحذف le partitif: « Je ne veux pas de fromage. »","la recette تُصاغ بـ l’impératif و le mode impersonnel: « Ajoutez deux œufs. », « Il faut mélanger pendant cinq minutes. » — هذا هو le langage de la cuisine.","la gastronomie ليست مجرد أكل بل un patrimoine: le vin، le fromage، les marchés، les restaurants étoilés — هذا ما يميّز la culture française في العالم.","بعد الدرس: صف طبقاً تحبه في ثلاث جمل: la recette، la texture، ثم votre appréciation بـ « C’est délicieux parce que… »."],"sub":[{"h":"الطلب في المطعم","p":["Je voudrais une entrée et un plat du jour, s’il vous plaît.","Et comme accompagnement, des légumes grillés.","L’addition, s’il vous plaît, nous allons payer ensemble."]},{"h":"أدوات نطقية: la recette","p":["« Ajoutez le sel petit à petit. » — l’impératif de la cuisine.","« Il faut laisser cuire dix minutes. » [il fo la.se kɥi] — la vraie formule.","« C’est trop salé ! » — l’accent tombe sur « trop » — la réaction naturelle."]},{"h":"خطوات Listen & Repeat","p":["المرة الأولى: اكتب les ingrédients.","الثانية: اكتب les verbes d’action.","الثالثة: أعد الوصف بـ le partitif و les adjectifs de goût."]}]},{"h":"تعبيرات المائدة الفرنسية","p":["« Il est bon, non ? » = الطعم لذيذ، أليس كذلك؟ — la question la plus naturelle à table.","« C’est délicieux, la recette est simple. » — le compliment avec le détail.","« Je prends un café, s’il vous plaît. » — la commande courte au comptoir.","« C’était très bien, merci. » — la sortie polie du restaurant."]},{"h":"التطبيق والتلخيص","p":["تمرين la recette: اشرح طبقاً تحبه في خمس جمل باستخدام l’impératif و le partitif.","تمرين le marché: تخيّل أنك تشتري من بائع وتقول: « Je voudrais deux kilos de tomates. »","سجّل نفسك تصف وجبة كاملة: entrée، plat، dessert، ثم votre appréciation في 45 ثانية."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: بنينا la boîte à outils de la table: le partitif، l’impératif، le mode impersonnel، ثم le déroulé الكامل للوجبة. أعد مشاهدة الفيديو الرئيسي وركّز على les verbes d’action في la préparation et les formules de politesse عند le serveur.","جسر الدروس: من b2-t7-l1 (بنية المدرسة الفرنسية) إلى b2-t7-l2 (أساسيات المائدة الفرنسية)، ثم إلى b2-t7-l3 حيث ننتقل من la table إلى la pharmacie ونتعلّم وصف الأعراض بـ « j’ai mal à… ».","مهمة تطبيقية: اكتب وصفة أو سجّل نفسك دقيقة واحدة تشرح فيها طبقاً بـ l’impératif et le partitif، واكتب ثلاث كلمات جديدة من الدرس واستعملها في ثلاث جمل، ثم قارن عرضك بالفيديو الرئيسي بـ « Contrairement à la vidéo, ma préparation… »."]}],"pron":[{"w":"la gastronomie","ipa":"[la ɡas.tʁɔ.nɔ.mi]","approx":"لا غاسترونومي"},{"w":"le terroir","ipa":"[lə tɛ.ʁwaʁ]","approx":"لو تيروار"},{"w":"l’addition","ipa":"[la.di.sjɔ̃]","approx":"لادديسيون"}],"vocab":[{"fr":"la gastronomie","ar":"فن الطبخ","pos":"nom","g":"f","exFr":"La gastronomie française est un patrimoine.","ipa":"","exAr":"الطبخ الفرنسي تراث ثقافي."},{"fr":"le terroir","ar":"الموقع الجغرافي للأكلة","pos":"nom","g":"m","exFr":"Chaque terroir a sa spécialité.","ipa":"","exAr":"لكل منطقة أكلتها الخاصة."},{"fr":"la spécialité","ar":"الأكلة المحلية","pos":"nom","g":"f","exFr":"La spécialité de la région est le fromage.","ipa":"","exAr":"أكلة المنطقة هي الجبن."},{"fr":"l’apéritif","ar":"المقبلات قبل العشاء","pos":"nom","g":"m","exFr":"On prend l’apéritif dans le jardin.","ipa":"","exAr":"نتناول المقبلات في الحديقة."},{"fr":"le plat principal","ar":"الطبق الرئيسي","pos":"nom","g":"m","exFr":"Le plat principal est servi à vingt heures.","ipa":"","exAr":"يُقدَّم الطبق الرئيسي في الثامنة ليلاً."},{"fr":"le fromage","ar":"الجبن","pos":"nom","g":"m","exFr":"Il y a plus de trois cents fromages en France.","ipa":"","exAr":"يوجد أكثر من ثلاثمئة نوع من الجبن في فرنسا."},{"fr":"la recette","ar":"الوصفة","pos":"nom","g":"f","exFr":"Cette recette vient de ma grand-mère.","ipa":"","exAr":"هذه الوصفة من جدتي."},{"fr":"le marché","ar":"السوق","pos":"nom","g":"m","exFr":"Le marché du samedi est très animé.","ipa":"","exAr":"سوق السبت نشيط جداً."},{"fr":"le produit local","ar":"المنتَج المحلي","pos":"nom","g":"m","exFr":"Les Français privilégient le produit local.","ipa":"","exAr":"يفضّل الفرنسيون المنتَج المحلي."},{"fr":"l’addition","ar":"حساب المطعم","pos":"nom","g":"f","exFr":"L’addition fait trente euros.","ipa":"","exAr":"الحساب ثلاثون يورو."},{"fr":"la cuisine","ar":"المطبخ/الطهي","pos":"nom","g":"f","exFr":"J’aime la cuisine du sud.","ipa":"","exAr":"أحب مطبخ الجنوب."},{"fr":"le chef","ar":"الشيف","pos":"nom","g":"m","exFr":"Le chef a créé ce plat.","ipa":"","exAr":"ابتكر الشيف هذا الطبق."}],"examples":[{"fr":"Je voudrais du pain et de la soupe, s’il vous plaît.","ar":"أودّ خبزاً وحساءً، من فضلك.","note":"le partitif"},{"fr":"Je ne veux pas de fromage.","ar":"لا أريد جبناً.","note":"la négation supprime le partitif"},{"fr":"Ajoutez deux œufs et mélangez bien.","ar":"أضف بيضتين واخلط جيداً.","note":"l’impératif"},{"fr":"Il faut laisser cuire dix minutes.","ar":"يجب أن ينضج عشر دقائق.","note":"le mode impersonnel"},{"fr":"C’est délicieux parce que le poisson est très frais.","ar":"لذيذ لأن السمك طازج جداً.","note":"la justification"},{"fr":"L’addition, s’il vous plaît.","ar":"الحساب، من فضلك.","note":"la formule"}],"grammar":[{"tFr":"Le partitif et sa disparition à la négation","tAr":"أدوات التمييز واختفاؤها في النفي","body":["le partitif: du (masculin)، de la (مؤنث)، de l’ (بلا نبر)، des (جمع): « Je mange du riz, de la salade, des pâtes. »","في la négation يتحوّل إلى de: « Je ne mange pas de viande. »، وكذلك بعد une quantité indéterminée: « Beaucoup de légumes. »"],"ex":[{"fr":"Je voudrais de la tarte aux pommes.","ar":"أودّ فطيرة التفاح."},{"fr":"Je ne prends pas de dessert ce soir.","ar":"سآخذ حلوى الليلة."}]},{"tFr":"L’impératif dans la recette","tAr":"الطلب في وصفة الطبخ","body":["l’impératif مباشرة: « Ajoutez… », « Coupez… », « Salez… »، و le mode impersonnel يحلّله: « Il faut ajouter… »","Attention aux formes: « Ajoutez » (vous) بدل « Ajoute » (tu) في les recettes — la politesse de la cuisine."],"ex":[{"fr":"Coupez les légumes en petits morceaux.","ar":"قطّع الخضروات قطعاً صغيرة."},{"fr":"Il faut préchauffer le four à 180 degrés.","ar":"يجب تسخين الفرن على 180 درجة."}]}],"mistakes":[{"wrong":"« Je veux pain. »","right":"« Je veux du pain. »","why":"le partitif إلزامي مع la quantité indéterminée."},{"wrong":"« Je ne veux pas du fromage. »","right":"« Je ne veux pas de fromage. »","why":"la négation تحذف le partitif."},{"wrong":"الخلط بين entrée و plat","right":"entrée = المقبل، plat = الطبق الرئيسي","why":"le déroulé de la table إلزامي في la culture française."},{"wrong":"« C’est bon. » فقط","right":"« C’est délicieux parce que… »","why":"la justification جزء من la conversation à table."}],"dialogues":[{"title":"في المطعم","ctx":"زبونان يطلبان العشاء","lines":[{"who":"Serveur","fr":"Vous avez choisi ?","ar":"هل اخترتما؟"},{"who":"Claire","fr":"Je voudrais une entrée et un plat du jour.","ar":"أودّ مقبلات وطبق اليوم."},{"who":"Marc","fr":"Et pour moi, des légumes grillés, s’il vous plaît.","ar":"وأنا، خضروات مشوية من فضلك."},{"who":"Serveur","fr":"Très bien, et comme dessert ?","ar":"ممتاز، وكحلاوة؟"}]},{"title":"وصف وصفة","ctx":"صديقة تشرح طبقاً","lines":[{"who":"Amina","fr":"La recette est simple : il faut dix minutes.","ar":"الوصفة بسيطة: عشر دقائق فقط."},{"who":"Sofia","fr":"Il faut ajouter quoi, d’abord ?","ar":"ماذا نضيف أولاً؟"},{"who":"Amina","fr":"Ajoutez l’ail et un peu d’huile d’olive.","ar":"أضف الثوم وقليل من زيت الزيتون."},{"who":"Sofia","fr":"C’est délicieux, la texture est parfaite.","ar":"لذيذ، القوام مثالي."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما معنى « l’addition »؟","opts":["حساب المطعم","الوصفة","السوق","المقبلات"],"a":0,"why":"addition = الحساب في المطعم."},{"t":"fill","skill":"grammar","q":"أكمل: «Je voudrais ___ soupe, s’il vous plaît.»","fr":"Je voudrais ___ soupe, s’il vous plaît.","ans":"de la","why":"le partitif مع le nom féminin."},{"t":"mcq","skill":"grammar","q":"الصيغة الصحيحة بعد la négation:","opts":["Je ne mange pas de viande.","Je ne mange pas la viande.","Je ne mange pas une viande.","Je ne mange pas les viandes."],"a":0,"why":"la négation تحذف le partitif."},{"t":"order","skill":"writing","q":"رتّب: أضف بيضتين واخلط جيداً","words":["Ajoutez","deux","œufs","et","mélangez","bien."],"ans":"Ajoutez deux œufs et mélangez bien.","why":"l’impératif de la recette."},{"t":"listen","skill":"listening","q":"ما le premier moment de la table؟","opts":["l’apéritif","le dessert","le fromage","le café"],"a":0,"why":"l’apéritif يسبق كل شيء."},{"t":"translate","skill":"writing","q":"ترجم: أودّ فطيرة التفاح من فضلك.","ans":"Je voudrais de la tarte aux pommes, s’il vous plaît.","why":"le partitif + formule de politesse."},{"t":"speaking","skill":"speaking","q":"صف طبقاً تحبه في أربع جمل: la recette، la texture، la raison، puis la conclusion.","target":"Il faut… / C’est… / Parce que… / C’est délicieux parce que…","why":"la description culinaire."},{"t":"correct","skill":"grammar","q":"صحّح: «Je ne veux pas du dessert.»","ans":"Je ne veux pas de dessert.","why":"la négation + le partitif."}],"homework":"اكتب وصفة طبق تحبه من بلدك بالفرنسية في ثماني جمل: المقادير بـ le partitif، الخطوات بـ l’impératif، ثم جملة تقييم بـ « C’est délicieux parce que… ».","sources":[{"title":"TOP 10 PLATS PRÉFÉRÉS DES FRANÇAIS","channel":"TOPéQUIZ","videoId":"WUxpX43tflg","why":"قائمة سريعة بأطباق la cuisine française — lexique concret عن les plats والوصف اليومي، مناسبة للاستماع المتكرر.","cat":"Culture","level":"B2","main":true},{"title":"L’Enfer des retours de Vacances !","channel":"Documentaire Société","videoId":"aFvgmZ46auk","why":"documentaire sur la vie quotidienne — lexique de la table et des habitudes françaises.","cat":"Culture","level":"B2","extra":true},{"title":"Les expressions idiomatiques autour des animaux 2","channel":"Kelly, la prof de français","videoId":"_VfSkJtvoXs","why":"expressions imagées كثيراً ما تُستعمل في la conversation autour du repas.","cat":"Culture","level":"B2","extra":true}],"supplements":[{"id":"aFvgmZ46auk","title":"L’Enfer des retours de Vacances !","channel":"Documentaire Société","why":"documentaire sur la vie quotidienne — lexique de la table et des habitudes françaises.","lang":"fr","dur":42},{"id":"_VfSkJtvoXs","title":"Les expressions idiomatiques autour des animaux 2","channel":"Kelly, la prof de français","why":"expressions imagées كثيراً ما تُستعمل في la conversation autour du repas.","lang":"fr","dur":1}]},{"id":"b2-t7-l3","fr":"Le système de santé","ar":"نظام الصحة في فرنسا","objectives":["وصف la parcours du patient: médecin traitant, ordonnance, pharmacie, remboursement","استعمال le lexique administratif: carte Vitale, mutuelle, assurance maladie","التواصل مع le médecin: expliquer les symptômes et poser des questions","فهم la voix passive et la nominalisation في les documents officiels"],"sections":[{"h":"الدرس 3: كيف تعمل الرعاية الصحية الفرنسية عملياً","video":{"id":"unViGMfngyE","title":"New TeAch - Présentation du système de santé français","channel":"Université de Tours (Univ Tours)","why":"عرض أكاديمي مختصر عن le système de santé: médecin traitant، carte Vitale، remboursement — la présentation officielle بالفرنسية الإدارية القياسية.","lang":"fr","main":true,"dur":3},"p":["le système français يقوم على le médecin traitant: تسجّل طبيباً عاماً كمرجع، وهو يوجّهك إلى le spécialiste عند الحاجة. la carte Vitale تُسرّع le remboursement في la pharmacie مباشرة.","المفردات الأساسية: l’ordonnance, la mutuelle, le remboursement, l’assurance maladie, la consultation, le rendez-vous, l’urgence, le certificat médical, la prise de sang, l’hospitalisation. هذه المفردات ضرورية عند أي زيارة.","نحوياً، la voix passive شائعة في les documents officiels: « La consultation doit être payée. »، و la nominalisation تختصر: « le remboursement de la consultation » بدل « on rembourse la consultation ».","les pronoms en et y يسهّلان la conversation: « J’y vais demain. », « J’en ai pris ce matin. », « Vous y êtes allé ? » — بدونها يبدو الكلام مصطنعاً.","وصف الأعراض يتطلب la précision: « J’ai mal à la tête », « J’ai de la fièvre depuis trois jours », « C’est une douleur lancinante. » — le détail يوفّر le diagnostic.","بعد الدرس: حاكِ مكالمة مع le secrétariat لحجز rendez-vous، ثم قابِل le médecin واشرح الأعراض في خمس جمل."],"sub":[{"h":"حجز موعد","p":["Bonjour, je voudrais prendre rendez-vous avec le médecin traitant.","C’est pour une douleur au dos qui dure depuis trois jours.","Vous pouvez venir jeudi à dix heures, s’il vous plaît."]},{"h":"أدوات نطقية: عند الطبيب","p":["« J’ai mal à la tête » [ʒɛ mal a tɛt] — la structure la plus courante.","« J’ai de la fièvre depuis lundi. » — depuis مع le point de départ.","« Est-ce grave, docteur ? » — la question naturelle."]},{"h":"خطوات Listen & Repeat","p":["المرة الأولى: اكتب les symptômes.","الثانية: اكتب les questions du médecin.","الثالثة: أعد المحادثة بصوتك مع les pronoms en et y."]}]},{"h":"تعبيرات الزيارة الطبية","p":["« J’ai rendez-vous à dix heures. » = لديّ موعد في العاشرة.","« Le médecin m’a donné une ordonnance. » — la sortie من la consultation.","« Est-ce que c’est remboursé ? » = هل يُسترد ثمنه؟ — la question la plus utile.","« Je suis sous traitement. » = أنا تحت العلاج — la réponse عند le pharmacien."]},{"h":"التطبيق والتلخيص","p":["تمرين la consultation: اشرح أربعة أعراض في أربع جمل مع la durée et l’intensité.","تمرين l’administratif: اكتب جملة لكل وثيقة: carte Vitale، mutuelle، certificat médical.","سجّل محادثة كاملة: la prise de rendez-vous ثم la consultation ثم la sortie — في دقيقة واحدة."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: تتبّعنا parcours du patient من le médecin traitant إلى la pharmacie مع le lexique administratif et la voix passive et les pronoms en et y في la conversation. أعد مشاهدة الفيديو الرئيسي وركّز على l’enchaînement des étapes: rendez-vous، consultation، ordonnance، remboursement.","جسر الدروس: من b2-t7-l2 (أساسيات المائدة الفرنسية) إلى b2-t7-l3 (مسار المريض في نظام الصحة)، ثم إلى b2-t7-l4 حيث ننتقل من la consultation individuelle إلى les fêtes collectives et le rituel الذي يجمع les Français.","مهمة تطبيقية: سجّل مكالمة حجز موعد لا تتجاوز دقيقة واحدة، واكتب ثلاث كلمات جديدة من الدرس واستعملها في جمل طبية، ثم قارن مسارك بالفيديو الرئيسي بـ « Dans la vidéo, on explique que…, tandis que… »."]}],"pron":[{"w":"l’ordonnance","ipa":"[lɔʁ.dɔ.nɑ̃s]","approx":"لوردونانس"},{"w":"le remboursement","ipa":"[lə ʁɑ̃.buʁs.mɑ̃]","approx":"لو رانبورسمان"},{"w":"la consultation","ipa":"[la kɔ̃l.ta.sjɔ̃]","approx":"لا كونسيلتاسيون"}],"vocab":[{"fr":"le médecin traitant","ar":"الطبيب المعالج","pos":"nom","g":"m","exFr":"Il faut déclarer son médecin traitant.","ipa":"","exAr":"يجب إخطار الطبيب المعالج."},{"fr":"l’ordonnance","ar":"الوصفة الطبية","pos":"nom","g":"f","exFr":"L’ordonnance est valable un an.","ipa":"","exAr":"الوصفة سارية لمدة سنة."},{"fr":"la carte Vitale","ar":"بطاقة الصحة","pos":"nom","g":"f","exFr":"Présentez votre carte Vitale à l’accueil.","ipa":"","exAr":"أظهر بطاقة الصحة في الاستقبال."},{"fr":"la mutuelle","ar":"التأمين الإضافي","pos":"nom","g":"f","exFr":"Ma mutuelle complète le remboursement.","ipa":"","exAr":"يكمّل تأميني الإضافي الاسترداد."},{"fr":"le remboursement","ar":"استرداد المصروف","pos":"nom","g":"m","exFr":"Le remboursement arrive sous huit jours.","ipa":"","exAr":"يصل الاسترداد خلال ثمانية أيام."},{"fr":"la consultation","ar":"الكشف الطبي","pos":"nom","g":"f","exFr":"La consultation coûte trente euros.","ipa":"","exAr":"يكلف الكشف ثلاثين يورو."},{"fr":"le rendez-vous","ar":"الموعد","pos":"nom","g":"m","exFr":"J’ai un rendez-vous à quinze heures.","ipa":"","exAr":"لديّ موعد في الثالثة عصراً."},{"fr":"l’assurance maladie","ar":"تأمين المرض","pos":"nom","g":"f","exFr":"L’assurance maladie prend en charge l’hospitalisation.","ipa":"","exAr":"يغطي تأمين المرض الإنعاش."},{"fr":"l’hôpital","ar":"المستشفى","pos":"nom","g":"m","exFr":"Il a été admis à l’hôpital.","ipa":"","exAr":"أُدخل إلى المستشفى."},{"fr":"l’urgence","ar":"الطوارئ","pos":"nom","g":"f","exFr":"Les urgences sont ouvertes vingt-quatre heures.","ipa":"","exAr":"الطوارئ مفتوحة على مدار الساعة."},{"fr":"le symptôme","ar":"العَرَض","pos":"nom","g":"m","exFr":"Quels sont vos symptômes ?","ipa":"","exAr":"ما أعراضك؟"},{"fr":"le certificat médical","ar":"الشهادة الطبية","pos":"nom","g":"m","exFr":"Il demande un certificat médical.","ipa":"","exAr":"يطلب شهادة طبية."}],"examples":[{"fr":"J’ai rendez-vous jeudi à dix heures.","ar":"لديّ موعد الخميس في العاشرة.","note":"la prise de rendez-vous"},{"fr":"J’ai mal au dos depuis trois jours.","ar":"أشعر بألم في الظهر منذ ثلاثة أيام.","note":"la douleur + depuis"},{"fr":"Le médecin m’a prescrit un traitement.","ar":"وصف لي الطبيب علاجاً.","note":"l’ordonnance"},{"fr":"La consultation doit être payée d’avance.","ar":"يجب دفع ثمن الكشف مقدماً.","note":"la voix passive"},{"fr":"Je vais à la pharmacie, j’en ai besoin.","ar":"سأذهب إلى الصيدلية، أنا بحاجة إليه.","note":"le pronom en"},{"fr":"Est-ce que c’est remboursé par l’assurance ?","ar":"هل يُسترد ثمنه من التأمين؟","note":"la question administrative"}],"grammar":[{"tFr":"La voix passive et la nominalisation administrative","tAr":"المبني للمجهول وnominalisation في اللغة الإدارية","body":["les documents officiels تستعمل la voix passive: « Le dossier doit être transmis. » و la nominalisation: « le remboursement des soins » بدل « on rembourse les soins ».","هذا يجعل la phrase objective ومقتصدة — la signature de la langue administrative française."],"ex":[{"fr":"Le dossier doit être transmis avant le 30.","ar":"يجب إرسال الملف قبل الثلاثين."},{"fr":"Le remboursement des soins est automatique.","ar":"استرداد مصاريف العلاج تلقائي."}]},{"tFr":"Les pronoms en et y dans la conversation","tAr":"الضمائر en و y في المحادثة","body":["y يستبدل بـ à + lieu: « Vous allez à l’hôpital ? » → « Vous y allez ? »، و en يستبدل de + chose: « Je prends des médicaments. » → « J’en prends. »","في la consultation يصبحان ضروريين: « Vous y êtes allé ? », « J’en ai pris ce matin. » — بدونهما يبدو le discours lourd."],"ex":[{"fr":"Tu vas à la pharmacie ? Oui, j’y vais.","ar":"هل تذهب إلى الصيدلية؟ نعم، سأذهب إليها."},{"fr":"Tu as pris le traitement ? J’en ai pris ce matin.","ar":"هل تناولت العلاج؟ تناولته هذا الصباح."}]}],"mistakes":[{"wrong":"« Je suis mal à la tête. »","right":"« J’ai mal à la tête. »","why":"être mal لا يُستعمل للألم — la structure est j’ai mal à."},{"wrong":"« J’ai mal de la tête »","right":"« J’ai mal à la tête »","why":"la préposition à إلزامية مع la partie du corps."},{"wrong":"الكلام بلا y و en","right":"« J’y vais. » / « J’en ai pris. »","why":"les pronoms y et en يختصران la conversation الفرنسية."},{"wrong":"« C’est remboursé ? » (سطر عامي)","right":"« Est-ce que c’est remboursé par l’assurance ? »","why":"le registre administratif يطلب la source."}],"dialogues":[{"title":"حجز موعد","ctx":"مكالمة مع الأمانة الطبية","lines":[{"who":"Secrétaire","fr":"Cabinet du docteur Martin, bonjour.","ar":"عيادة الدكتور مارتن، مرحباً."},{"who":"Yasmine","fr":"Bonjour, je voudrais prendre rendez-vous.","ar":"مرحباً، أودّ حجز موعد."},{"who":"Secrétaire","fr":"Vous êtes suivie par notre médecin traitant ?","ar":"هل تتابعين عند طبيبنا المعالج؟"},{"who":"Yasmine","fr":"Oui, j’y vais depuis deux ans.","ar":"نعم، أذهب إليه منذ سنتين."}]},{"title":"عند الطبيب","ctx":"استشارة طبية","lines":[{"who":"Médecin","fr":"Quels sont vos symptômes exactement ?","ar":"ما أعراضك بالضبط؟"},{"who":"Patient","fr":"J’ai mal à la tête et de la fièvre depuis lundi.","ar":"أشعر بألم في الرأس وحمى منذ الاثنين."},{"who":"Médecin","fr":"Je vous prescris un traitement pour cinq jours.","ar":"أصف لك علاجاً لخمسة أيام."},{"who":"Patient","fr":"Est-ce que c’est remboursé par l’assurance ?","ar":"هل يُسترد ثمنه من التأمين؟"}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما معنى « la carte Vitale »؟","opts":["بطاقة الصحة","الوصفة الطبية","التأمين الإضافي","الشهادة الطبية"],"a":0,"why":"carte Vitale = بطاقة الصحة الفرنسية."},{"t":"fill","skill":"grammar","q":"أكمل: «J’ai ___ tête depuis trois jours.»","fr":"J’ai mal ___ la tête depuis trois jours.","ans":"à","why":"j’ai mal à + partie du corps."},{"t":"mcq","skill":"listening","q":"ما la structure الصحيحة للألم؟","opts":["J’ai mal au dos.","Je suis mal au dos.","J’ai mal du dos.","Je suis mal de dos."],"a":0,"why":"j’ai mal à/au + partie du corps."},{"t":"order","skill":"writing","q":"رتّب: لديّ موعد الخميس في العاشرة","words":["J’ai","rendez-vous","jeudi","à","dix","heures."],"ans":"J’ai rendez-vous jeudi à dix heures.","why":"la prise de rendez-vous."},{"t":"listen","skill":"listening","q":"استبدل بالضمير: «Tu vas à la pharmacie ?»","opts":["Tu y vas ?","Tu en vas ?","Tu lui vas ?","Tu le vas ?"],"a":0,"why":"y يحل محل à + lieu."},{"t":"translate","skill":"writing","q":"ترجم: هل يُسترد ثمنه من التأمين؟","ans":"Est-ce que c’est remboursé par l’assurance ?","why":"la voix passive + la source."},{"t":"speaking","skill":"speaking","q":"اكتمل محادثة: سجّل موعداً ثم اشرح الأعراض ثم اسأل عن le remboursement.","target":"Je voudrais prendre rendez-vous / J’ai mal à… / Depuis… / Est-ce que c’est remboursé ?","why":"le parcours du patient."},{"t":"correct","skill":"grammar","q":"صحّح: «Je suis mal à la tête.»","ans":"J’ai mal à la tête.","why":"être mal لا يُستعمل للألم."}],"homework":"اكتب رسالة إلى le secrétariat لطلب rendez-vous ثم فقرة تصف فيها la consultation: les symptômes، le traitement، ثم la question عن le remboursement.","sources":[{"title":"New TeAch - Présentation du système de santé français","channel":"Université de Tours (Univ Tours)","videoId":"unViGMfngyE","why":"عرض أكاديمي مختصر عن le système de santé: médecin traitant، carte Vitale، remboursement — la présentation officielle بالفرنسية الإدارية القياسية.","cat":"Culture","level":"B2","main":true},{"title":"École française : pourquoi les meilleurs élèves disparaissent","channel":"Le Figaro","videoId":"Wx44ERpK7nQ","why":"méthode du reportage sur un service public — la même structure تُطبَّق على le système de santé.","cat":"Culture","level":"B2","extra":true},{"title":"L’Enfer des retours de Vacances !","channel":"Documentaire Société","videoId":"aFvgmZ46auk","why":"documentaire long — استمع لـ le registre courant sans le stress de la vitesse.","cat":"Culture","level":"B2","extra":true}],"supplements":[{"id":"Wx44ERpK7nQ","title":"École française : pourquoi les meilleurs élèves disparaissent","channel":"Le Figaro","why":"méthode du reportage sur un service public — la même structure تُطبَّق على le système de santé.","lang":"fr","dur":13},{"id":"aFvgmZ46auk","title":"L’Enfer des retours de Vacances !","channel":"Documentaire Société","why":"documentaire long — استمع لـ le registre courant sans le stress de la vitesse.","lang":"fr","dur":42}]},{"id":"b2-t7-l4","fr":"Les traditions françaises","ar":"التقاليد الفرنسية","objectives":["وصف les grandes fêtes: 14 Juillet, Toussaint, Noël, Pâques","استعمال le lexique: la coutume, le rituel, le patrimoine, l’usage","تمييز la tradition عن la mode عن la règle","مقارنة traditions de votre pays مع les françaises دون تعميم"],"sections":[{"h":"الدرس 4: كيف تفهم التقاليد الفرنسية وتتحدث عنها بثقة","video":{"id":"OWdNRcD4KSg","title":"Les grandes traditions de la culture française","channel":"Frenchecho","why":"عرض موجز بالفرنسية la culture française: les fêtes، les rituels، les gestes quotidiens — la matière pour parler des traditions.","lang":"fr","main":true,"dur":12},"p":["la tradition في فرنسا ليست le passé المحفوظ بل le passé المستمر: le 14 Juillet احتفال بالجمهورية، la Toussaint زيارة القبور، Noël réveillon عائلي. لكل واحدة le geste الظاهر و le sens الخفي — والغريب يرى le geste وحده.","معجم الدرس: la coutume, le rituel, la fête, la cérémonie, le patrimoine, l’héritage, l’usage, le geste, l’anniversaire, la tradition orale, le repas, la mémoire. هذه المفردات تربط le présent بـ le passé.","نحوياً، les traditions تأتي بالpassé: « On a l’habitude de… »، et l’imparfait يصف le rituel المتكرر: « Chaque été, la famille se retrouvait… ». la répétition grammaticale تعكس la répétition sociale.","le subjonctif يظهر dans les vœux et les souhaits: « Il faut que chacun trouve sa place. » — la tradition تُعبَّر بالcollectif لا par le singulier.","الدرس الأهم: la comparaison بلا jugement. « En France, on fait… ; dans mon pays, on fait… » — le parallèle يُظهر la nuance دون إعلان la supériorité.","بعد الدرس: اختر tradition واحدة من بلدك واشرحها بالفرنسية في ست جمل: le moment، le geste، les personnes، le sens، puis la différence مع une française."],"sub":[{"h":"les grandes étapes","p":["Le 14 Juillet : la fête de la République.","La Toussaint : les chrysanthèmes et la mémoire.","Noël : le réveillon en famille."]},{"h":"أدوات نطقية: le rituel","p":["« Chaque année, on se retrouve… » — l’imparfait du rituel.","« Il faut que chacun trouve sa place. » — le subjonctif du collectif.","« C’est l’usage. » — la formule qui clôt."]},{"h":"خطوات la comparaison","p":["الخطوة الأولى: décrire le geste sans juger.","الثانية: expliquer le sens.","الثالثة: comparer avec un usage de votre pays."]}]},{"h":"عبارات الحديث عن التقاليد","p":["« Dans notre famille, on a l’habitude de… » = في عائلتنا، من العادة أن… — l’ouverture par la mémoire.","« C’est une coutume qui remonte à… » — la racine historique.","« Ce geste symbolise… » = هذا الإشارة ترمز إلى… — le sens derrière l’acte.","« Chaque région a ses propres traditions. » — la nuance contre le cliché."]},{"h":"التطبيق والتلخيص","p":["تمرين la description: اشرح tradition واحدة من بلدك في ست جمل مع le geste و le sens.","تمرين le parallèle: قارن بين deux fêtes: الفرنسية و بلدك — بـ « tandis que… » و « alors que… ».","سجّل شرحاً من 45 ثانية عن le 14 Juillet: التاريخ، le geste، ثم le sens républicain."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: قرأنا les grandes fêtes (14 Juillet, Toussaint, Noël) كـ le passé continu لا le passé figé، مع le lexique de la coutume et du rituel et la comparaison بـ « tandis que… ». أعد مشاهدة الفيديو الرئيسي وركّز على le geste et le sens خلف كل احتفال.","جسر الدروس: من b2-t7-l3 (مسار المريض في نظام الصحة) إلى b2-t7-l4 (التقاليد والطقوس الفرنسية)، ثم إلى b2-t7-l5 حيث ننتقل من le geste quotidien إلى les institutions et le vocabulaire politique européen.","مهمة تطبيقية: سجّل شرحاً من دقيقة واحدة لـ tradition من بلدك مع le geste et le sens، واكتب ثلاث كلمات جديدة من الدرس واستعملها في ثلاث جمل، ثم قارن وصفك بالفيديو الرئيسي بـ « La vidéo ajoute…, alors que chez nous… »."]}],"pron":[{"w":"la coutume","ipa":"[la ku.tym]","approx":"لا كوتيم"},{"w":"le rituel","ipa":"[lə ʁi.tɥɛl]","approx":"لو ريتوال"},{"w":"le patrimoine","ipa":"[lə pa.tʁi.mwan]","approx":"لو باتريموان"}],"vocab":[{"fr":"la coutume","ar":"العادة المتراكمة","pos":"nom","g":"f","exFr":"C’est une coutume régionale.","ipa":"[ku.tym]","exAr":"هذه عادة محلية."},{"fr":"le rituel","ar":"الطقس / الشعيرة","pos":"nom","g":"m","exFr":"Le rituel rassemble la famille.","ipa":"[ʁi.tɥɛl]","exAr":"الطقس يجمع العائلة."},{"fr":"la fête","ar":"الاحتفال","pos":"nom","g":"f","exFr":"La fête nationale est en juillet.","ipa":"[fɛt]","exAr":"الاحتفال الوطني في يوليو."},{"fr":"la cérémonie","ar":"المراسم","pos":"nom","g":"f","exFr":"La cérémonie dure deux heures.","ipa":"[se.ʁe.mɔ.ni]","exAr":"المراسم تدوم ساعتين."},{"fr":"le patrimoine","ar":"التراث","pos":"nom","g":"m","exFr":"Le patrimoine est protégé.","ipa":"[pa.tʁi.mwan]","exAr":"التراث محمي."},{"fr":"l’héritage","ar":"الإرث الثقافي","pos":"nom","g":"m","exFr":"L’héritage se transmet.","ipa":"[e.ʁi.taʒ]","exAr":"الإرث يُورَّث."},{"fr":"la transmission orale","ar":"النقل الشفوي","pos":"nom","g":"f","exFr":"La transmission orale passe de génération en génération.","ipa":"[tʁɑ̃s.mi.sjɔ̃ ɔ.ʁal]","exAr":"ينتقل النقل الشفوي من جيل إلى جيل."},{"fr":"le geste","ar":"السلوك / الإشارة","pos":"nom","g":"m","exFr":"Le geste compte plus que le mot.","ipa":"[ʒɛst]","exAr":"السلوك أهم من الكلمة."},{"fr":"la mémoire","ar":"الذاكرة","pos":"nom","g":"f","exFr":"La mémoire des morts reste vive.","ipa":"[me.mwaʁ]","exAr":"ذاكرة الموتى ما زالت حية."},{"fr":"transmettre","ar":"يُوصِّل / يورّث","pos":"verbe","g":"","exFr":"On transmet ce savoir aux enfants.","ipa":"[tʁɑ̃s.mɛtʁ]","exAr":"نُوصِّل هذا العلم للأطفال."},{"fr":"perpétuer","ar":"يُخلِّد","pos":"verbe","g":"","exFr":"Ils perpétuent la tradition.","ipa":"[pɛʁ.pe.tɥe]","exAr":"يُخلّدون التقليد."},{"fr":"se rassembler","ar":"يتجمّع","pos":"loc.","g":"","exFr":"La famille se rassemble le dimanche.","ipa":"","exAr":"تتجمّع العائلة يوم الأحد."}],"examples":[{"fr":"Le 14 Juillet, la France fête la République.","ar":"في الرابع عشر من يوليو، تحتفل فرنسا بالجمهورية.","note":"la fête nationale"},{"fr":"À la Toussaint, on dépose des chrysanthèmes.","ar":"في عيد جميع القديسين، نضع الزهور على القبور.","note":"le rituel"},{"fr":"Chaque année, la famille se rassemble.","ar":"كل عام، تتجمّع العائلة.","note":"l’imparfait du rituel"},{"fr":"Ce geste symbolise la mémoire collective.","ar":"هذا السلوك يرمز إلى الذاكرة الجماعية.","note":"le sens"},{"fr":"Chaque région a ses propres traditions.","ar":"كل منطقة لديها تقاليد خاصة بها.","note":"la nuance"},{"fr":"Dans notre famille, on a l’habitude de…","ar":"في عائلتنا، من العادة أن…","note":"l’ouverture"}],"grammar":[{"tFr":"L’imparfait de la description et du rituel","tAr":"الماضي المستمر في وصف الطقس المتكرر","body":["l’imparfait يحكم les traditions: « Chaque dimanche, on déjeunait ensemble. » la répétition dans le temps تعيش في l’imparfait — le passé simple يكسر la durée ويضيف le événement.","التركيب المعتاد: l’imparfait pour le décor et la habitude، le passé compose pour le fait: « On se rassemblait, et cette année tout a changé. »"],"ex":[{"fr":"Chaque été, la famille partait en vacances.","ar":"كل صيف، تسافر العائلة في إجازة."},{"fr":"Cette année, le réveillon a réuni tout le monde.","ar":"هذا العام، جمع عشاء رأس السنة الجميع."}]},{"tFr":"Le subjonctif des vœux et des souhaits","tAr":"الفاعلية في التمنيات والتقاليد","body":["les souhaits يستعملون le subjonctif: « Je souhaite que vous soyez heureux. », « Il faut que la tradition continue. » la tradition تُقال في la formule لا في le constat.","« C’est l’usage que… » يأتي مع le subjonctif أيضاً — la règle تصل le registre soutenu."],"ex":[{"fr":"Je souhaite que la famille soit réunie.","ar":"أتمنى أن تكون العائلة متجمعة."},{"fr":"Il faut que chacun trouve sa place.","ar":"يجب أن يجد كل واحد مكانه."}]}],"mistakes":[{"wrong":"la tradition comme le passé figé","right":"la tradition = le passé continu","why":"le rituel يعيش في le présent."},{"wrong":"التعلّق بالكليات: « les Français aiment… »","right":"« chaque région… », « dans cette famille… »","why":"la généralisation تُفقد la précision."},{"wrong":"la comparaison بـ jugement","right":"le parallèle بـ « tandis que… »","why":"la nuance تُظهر la culture لا la hiérarchie."},{"wrong":"la description بلا sens","right":"le geste + la signification","why":"le geste وحده يبقى سطحياً."}],"dialogues":[{"title":"شرح تقليد","ctx":"طالب يشرح لزميله","lines":[{"who":"Karim","fr":"Chez nous, on a une coutume au printemps.","ar":"عندنا عادة في الربيع."},{"who":"Claire","fr":"Quel est le geste principal ?","ar":"ما السلوك الأساسي؟"},{"who":"Karim","fr":"Toute la famille se rassemble pour un grand repas.","ar":"تتجمّع العائلة كلها لوجبة كبيرة."},{"who":"Claire","fr":"C’est comme le réveillon, en fait.","ar":"إنه مثل عشاء رأس السنة، في الواقع."}]},{"title":"la Toussaint","ctx":"معلمة تشرح","lines":[{"who":"Prof","fr":"À la Toussaint, on dépose des fleurs.","ar":"في عيد جميع القديسين، نضع الزهور."},{"who":"Élève","fr":"Ce geste symbolise la mémoire ?","ar":"هل يرمز هذا السلوك إلى الذاكرة؟"},{"who":"Prof","fr":"Exactement : la mémoire des défunts.","ar":"بالضبط: ذكرى المتوفّين."},{"who":"Élève","fr":"Chaque région a ses propres usages.","ar":"لكل منطقة استعمالات خاصة بها."}]}],"exercises":[{"t":"mcq","skill":"culture","q":"ماذا يُخلَّف في la Toussaint ?","opts":["زهور على القبور","ألعاب نارية","حلوى للأطفال","هدايا"],"a":0,"why":"la Toussaint = زيارة القبور مع les chrysanthèmes."},{"t":"fill","skill":"grammar","q":"أكمل بالimparfait: «Chaque été, la famille ___ (partir) en vacances.»","fr":"Chaque été, la famille ___ en vacances.","ans":"partait","why":"l’imparfait يصف la répétition du rituel."},{"t":"mcq","skill":"grammar","q":"أي جملة صحيحة مع le subjonctif ?","opts":["Je souhaite que vous soyez heureux.","Je souhaite que vous êtes heureux.","Je souhaite que vous avez.","Je souhaite vous heureux."],"a":0,"why":"les souhaits + subjonctif."},{"t":"order","skill":"writing","q":"رتّب: كل عام، تتجمّع العائلة","words":["Chaque","année,","la","famille","se","rassemble."],"ans":"Chaque année, la famille se rassemble.","why":"la description du rituel."},{"t":"listen","skill":"listening","q":"ما « le 14 Juillet »؟","opts":["احتفال بالجمهورية","عيد الميلاد","زيارة القبور","بداية السنة"],"a":0,"why":"la fête nationale du 14 Juillet."},{"t":"translate","skill":"writing","q":"ترجم: كل منطقة لديها تقاليد خاصة بها.","ans":"Chaque région a ses propres traditions.","why":"la nuance ضد le cliché."},{"t":"speaking","skill":"speaking","q":"اشرح tradition واحدة من بلدك في ست جمل بالفرنسية.","target":"Chez nous… / Le geste… / Ce geste symbolise… / Tandis qu’en France…","why":"la comparaison culturelle."},{"t":"correct","skill":"culture","q":"صحّح: «Les Français aiment tous le fromage.»","ans":"Dans beaucoup de régions françaises, le fromage est une tradition.","why":"la généralisation تحل محل la précision."}],"homework":"اشرح tradition واحدة من بلدك بالفرنسية في 120 كلمة: le moment، le geste، le sens، ثم قارنها مع tradition فرنسية بـ « tandis que… ».","sources":[{"title":"Les grandes traditions de la culture française","channel":"Frenchecho","videoId":"OWdNRcD4KSg","why":"عرض موجز بالفرنسية la culture française: les fêtes، les rituels، les gestes quotidiens — la matière pour parler des traditions.","cat":"Culture","level":"B2","main":true},{"title":"Les traditions françaises : fête et patrimoine","channel":"France 3","videoId":"_LTsjwiTN7w","why":"les gestes des grandes fêtes مع الشرح المباشر للسياق.","cat":"Culture","level":"B2","extra":true},{"title":"Le 14 Juillet et les grandes fêtes françaises","channel":"France 2","videoId":"zGyThu7EAHQ","why":"la fête nationale شاهداً ميدانياً على le rituel républicain.","cat":"Culture","level":"B2","extra":true}],"supplements":[{"id":"_LTsjwiTN7w","title":"Les traditions françaises : fête et patrimoine","channel":"France 3","why":"les gestes des grandes fêtes مع الشرح المباشر للسياق.","lang":"fr","dur":15},{"id":"zGyThu7EAHQ","title":"Le 14 Juillet et les grandes fêtes françaises","channel":"France 2","why":"la fête nationale شاهداً ميدانياً على le rituel républicain.","lang":"fr","dur":13}]},{"id":"b2-t7-l5","fr":"La France et l’Europe","ar":"فرنسا وأوروبا","objectives":["وصف le calendrier: Traité de Rome, Maastricht, Schengen, Euro","استعمال le lexique institutionnel: le Parlement, la Commission, le Conseil","تمييز les positions: européanistes, eurocéptiques, souverainistes","تحليل un article politique فرنسي عن l’Europe واستخراج la thèse"],"sections":[{"h":"الدرس 5: كيف تفهم العلاقة بين فرنسا والاتحاد الأوروبي وتناقشها","video":{"id":"BkNki_64PCU","title":"La France et l’Europe : une histoire commune","channel":"France Culture","why":"محادثة أكاديمية عن la construction européenne: من le Traité de Rome إلى les crises، مع le vocabulaire السياسي اللازم.","lang":"fr","main":true,"dur":20},"p":["la relation بين فرنسا و l’Europe هي la relation بين le pays fondateur و le projet: فرنسا شاركت في la construction منذ le Traité de Rome (1957)، ومرّت بـ Maastricht (1992) و l’Euro و Schengen — كل خطوة كانت le compromis لا le consensus.","معجم الدرس: l’Union européenne, le Parlement, la Commission, le Conseil, le traité, le siège, la directive, le budget, la souveraineté, l’intégration, le compromis, le débat. هذه المفردات تقرأ بها la presse politique.","نحوياً، le conditionnel يحكم le discours politique européen: « Il faudrait harmoniser… »، et le subjonctif les réserves: « bien que le traité prévoie… ». la nuance grammaticale هي la marque du négociateur.","les positions تتوزع: les européanistes يدافعون عن le renforcement، les eurocéptiques يطالبون par la réforme، et les souverainistes يرفضون la délégation. la nuance بين les trois هي le cœur du débat français.","الدرس الأهم: les institutions ليست بعيدة — le Parlement vote le budget que vous voyez، la Commission propose، le Conseil décide. la clarté de ces trois verbes تُغني عن la caricature.","بعد الدرس: اقرأ article فرنسي عن l’Europe، استخرج la thèse و les mots-clés institutionnels، ثم اكتب résumé من 100 كلمة بـ le conditionnel."],"sub":[{"h":"le calendrier","p":["1957 : le Traité de Rome fonde la Communauté.","1992 : Maastricht crée l’Union européenne.","2002 : l’entrée en vigueur de l’euro."]},{"h":"أدوات نطقية: les institutions","p":["« Le Parlement vote, la Commission propose. » — les rôles.","« Le Conseil représente les États. » — la souveraineté.","« C’est un compromis, pas un accord parfait. » — la réalité."]},{"h":"خطوات l’analyse d’un article","p":["الخطوة الأولى: حدد le position de l’auteur.","الثانية: استخرج le vocabulaire institutionnel.","الثالثة: اقرأ la nuance: conditionnel ou affirmation ?"]}]},{"h":"عبارات النقاش الأوروبي","p":["« L’Union européenne repose sur… » = يقوم الاتحاد على… — l’ouverture institutionnelle.","« Ce traité prévoit que… » — la référence au droit.","« Il faudrait harmoniser les règles. » — la proposition au conditionnel.","« Bien que le cadre soit fixé, des écarts subsistent. » — la nuance."]},{"h":"التطبيق والتلخيص","p":["تمرين la chronologie: اكتب خمس محطات من l’intégration بتواريخها في جمل فرنسية.","تمرين les rôles: اشرح les trois institutions في ثلاث جمل بـ « propose », « vote », « décide ».","سجّل رأياً من 45 ثانية عن l’Europe avec le conditionnel و une nuance ختامية."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: رتّبنا le calendrier (1957, 1992, 2002) وحدّدنا les trois institutions: Commission propose، Parlement vote، Conseil décide، مع le conditionnel et « bien que » + subjonctif. أعد مشاهدة الفيديو الرئيسي وركّز على le verbe qui correspond à كل مؤسسة.","جسر الدروس: من b2-t7-l4 (التقاليد والطقوس الفرنسية) إلى b2-t7-l5 (مؤسسات فرنسا في الاتحاد الأوروبي)، ثم إلى b2-t7-l6 حيث نعود من le discours politique إلى la table بوصف la gastronomie un patrimoine vivant.","مهمة تطبيقية: سجّل رأياً من دقيقة واحدة عن l’Europe بـ le conditionnel، واكتب ثلاث كلمات جديدة من الدرس واستعملها في ثلاث جمل، ثم قارن تقديمك بالفيديو الرئيسي بـ « La vidéo insiste sur…, pour ma part… »."]}],"pron":[{"w":"le traité","ipa":"[lə tʁe.te]","approx":"لو تريتي"},{"w":"la souveraineté","ipa":"[la su.vʁɛ̃.ne.te]","approx":"لا سوفرينويتي"},{"w":"le compromis","ipa":"[lə kɔ̃.pʁɔ.mi]","approx":"لو كومبرومي"}],"vocab":[{"fr":"l’Union européenne","ar":"الاتحاد الأوروبي","pos":"nom","g":"f","exFr":"L’Union compte vingt-sept États.","ipa":"[ɔ̃.jɔ̃ ɔ.pɛ.ʁɛn]","exAr":"الاتحاد يضم سبعة وعشرين دولة."},{"fr":"le Parlement","ar":"البرلمان الأوروبي","pos":"nom","g":"m","exFr":"Le Parlement vote le budget.","ipa":"[paʁ.lə.mɑ̃]","exAr":"البرلمان يصوّت على الميزانية."},{"fr":"la Commission","ar":"المفوضية","pos":"nom","g":"f","exFr":"La Commission propose les lois.","ipa":"[kɔ.mi.sjɔ̃]","exAr":"المفوضية تقترح القوانين."},{"fr":"le Conseil","ar":"المجلس الأوروبي","pos":"nom","g":"m","exFr":"Le Conseil représente les États.","ipa":"[lə kɔ̃.sɛj]","exAr":"المجلس يمثّل الدول."},{"fr":"le traité","ar":"العقد / المعاهدة","pos":"nom","g":"m","exFr":"Le traité a été signé à Rome.","ipa":"[tʁe.te]","exAr":"وُقّعت المعاهدة في روما."},{"fr":"la souveraineté","ar":"السيادة","pos":"nom","g":"f","exFr":"La souveraineté reste un enjeu.","ipa":"[su.vʁɛ̃.ne.te]","exAr":"السيادة تبقى قضية محورية."},{"fr":"l’intégration","ar":"التكامل","pos":"nom","g":"f","exFr":"L’intégration progresse lentement.","ipa":"[ɛ̃.te.ɡʁa.sjɔ̃]","exAr":"التكامل يتقدّم ببطء."},{"fr":"le compromis","ar":"التسوية","pos":"nom","g":"m","exFr":"La négociation aboutit à un compromis.","ipa":"[kɔ̃.pʁɔ.mi]","exAr":"التفاوض يصوب إلى تسوية."},{"fr":"la directive","ar":"التوجيه القانوني","pos":"nom","g":"f","exFr":"La directive s’applique à tous.","ipa":"[di.ʁɛk.tiv]","exAr":"التوجيه يُطبَّق على الجميع."},{"fr":"le budget","ar":"الميزانية","pos":"nom","g":"m","exFr":"Le budget est voté annuellement.","ipa":"[by.ʒɛ]","exAr":"تُصوَّت على الميزانية سنوياً."},{"fr":"harmoniser","ar":"يُوحِّد","pos":"verbe","g":"","exFr":"Il faut harmoniser les règles.","ipa":"[aʁ.mɔ.ni.ze]","exAr":"يجب توحيد القواعد."},{"fr":"déléguer","ar":"يفوّض","pos":"verbe","g":"","exFr":"Les États délèguent une partie de leur pouvoir.","ipa":"[de.le.ɡe]","exAr":"تفوّض الدول جزءاً من سلطتها."}],"examples":[{"fr":"Le Traité de Rome fonde la Communauté en 1957.","ar":"أسست معاهدة روما المجتمع في 1957.","note":"la chronologie"},{"fr":"Maastricht crée l’Union européenne en 1992.","ar":"أنشأ معاهدة ماستريخت الاتحاد الأوروبي عام 1992.","note":"la chronologie"},{"fr":"Le Parlement vote, la Commission propose.","ar":"البرلمان يصوّت، والمفوضية تقترح.","note":"les rôles"},{"fr":"Il faudrait harmoniser les règles fiscales.","ar":"يجب توحيد القواعد الضريبية.","note":"le conditionnel"},{"fr":"Bien que le cadre soit fixé, des écarts subsistent.","ar":"رغم أن الإطار محدَّد، إلا أن فوارق باقية.","note":"la nuance"},{"fr":"C’est un compromis, pas un accord parfait.","ar":"إنها تسوية، لا اتفاق مثالي.","note":"la réalité"}],"grammar":[{"tFr":"Le conditionnel dans le discours politique","tAr":"الشرطية في الخطاب السياسي","body":["le conditionnel exprime la proposition و la prudence: « On pourrait envisager… », « Il faudrait harmoniser… ». في le discours européen، le présent direct يصبح ادّعاءً — le conditionnel يفتح la négociation.","le passé du conditionnel exprime la conséquence non réalisée: « Sans ce traité, l’Europe aurait changé de face. »"],"ex":[{"fr":"Il faudrait réformer les règles du budget.","ar":"يجب إصلاح قواعد الميزانية."},{"fr":"Sans Maastricht, rien ne serait pareil.","ar":"لولا ماستريخت، لما كان شيء على حاله."}]},{"tFr":"Bien que et la concession institutionnelle","tAr":"concession مع bien que","body":["« bien que » + subjonctif تُدخل la concession la plus élégante: « Bien que le traité prévoie cette exception… » la phrase تقر بالقاعدة ثم تُظهر la faille.","« cependant » et « toutefois » يُكملان la même idée في la phrase suivante — la séquence est la signature de l’argumentation européenne."],"ex":[{"fr":"Bien que le cadre soit commun, les écarts subsistent.","ar":"رغم أن الإطار مشترك، إلا أن فوارق باقية."},{"fr":"Le traité est clair ; toutefois, son application diffère.","ar":"المعاهدة واضحة؛ لكن تطبيقها يختلف."}]}],"mistakes":[{"wrong":"الخلط بين les trois institutions","right":"Commission propose، Parlement vote، Conseil décide","why":"la confusion تُفقد le sens du débat."},{"wrong":"la généralisation: « l’Europe veut… »","right":"« le Conseil adopte… », « la Commission propose… »","why":"l’Europe ليست le sujet الموحّد."},{"wrong":"la citation du traité بلا source","right":"le nom du traité et l’année","why":"la référence juridique تُثبت la phrase."},{"wrong":"l’affirmation catégorique","right":"le conditionnel de proposition","why":"le discours européen يعيش على le compromis."}],"dialogues":[{"title":"نقاش مؤسسي","ctx":"طالبان في نادي","lines":[{"who":"Karim","fr":"Qui propose les lois européennes ?","ar":"من يقترح القوانين الأوروبية؟"},{"who":"Claire","fr":"La Commission, puis le Parlement vote.","ar":"المفوضية، ثم يصوّت البرلمان."},{"who":"Karim","fr":"Et le Conseil, il fait quoi ?","ar":"والمجلس، ماذا يفعل؟"},{"who":"Claire","fr":"Il représente les États et décide.","ar":"يمثّل الدول ويقرّر."}]},{"title":"conditionnel et nuance","ctx":"éditorial partagé","lines":[{"who":"Marc","fr":"Il faut harmoniser les règles fiscales.","ar":"يجب توحيد القواعد الضريبية."},{"who":"Nadia","fr":"Mieux : « il faudrait », car le budget reste national.","ar":"الأفضل: «il faudrait»، لأن الميزانية ما زالت وطنية."},{"who":"Marc","fr":"Bien que le cadre soit commun.","ar":"رغم أن الإطار مشترك."},{"who":"Nadia","fr":"Voilà : un compromis, pas un accord parfait.","ar":"هكذا: تسوية، لا اتفاق مثالي."}]}],"exercises":[{"t":"mcq","skill":"culture","q":"من يقترح القوانين في l’Union ?","opts":["la Commission","le Parlement","le Conseil","la Cour"],"a":0,"why":"la Commission propose."},{"t":"fill","skill":"grammar","q":"أكمل: «___ que le cadre soit commun, des écarts subsistent.»","fr":"___ que le cadre soit commun, des écarts subsistent.","ans":"Bien","why":"bien que + subjonctif."},{"t":"mcq","skill":"analysis","q":"ما وظيفة le conditionnel في le discours politique ?","opts":["la proposition و la prudence","le passé","التعجب","الأمر"],"a":0,"why":"le conditionnel يفتح la négociation."},{"t":"order","skill":"writing","q":"رتّب: البرلمان يصوّت، والمفوضية تقترح","words":["Le","Parlement","vote,","la","Commission","propose."],"ans":"Le Parlement vote, la Commission propose.","why":"les rôles des institutions."},{"t":"listen","skill":"listening","q":"متى دخل l’euro حيّز التنفيذ ؟","opts":["2002","1957","1992","2010"],"a":0,"why":"l’euro entre en vigueur en 2002."},{"t":"translate","skill":"writing","q":"ترجم: يجب توحيد القواعد الضريبية.","ans":"Il faudrait harmoniser les règles fiscales.","why":"le conditionnel de proposition."},{"t":"speaking","skill":"speaking","q":"اشرح les trois institutions في 45 ثانية بـ « propose », « vote », « décide ».","target":"La Commission propose… / Le Parlement vote… / Le Conseil décide… / C’est un compromis…","why":"la clarté institutionnelle."},{"t":"correct","skill":"culture","q":"صحّح: «L’Europe veut que la France change ses lois.»","ans":"La Commission propose une directive qui s’applique à la France.","why":"la précision des rôles."}],"homework":"اقرأ مقالاً فرنسياً عن l’Europe، استخرج la thèse و les mots-clés institutionnelين، ثم اكتب résumé من 100 كلمة مع le conditionnel و une nuance.","sources":[{"title":"La France et l’Europe : une histoire commune","channel":"France Culture","videoId":"BkNki_64PCU","why":"محادثة أكاديمية عن la construction européenne: من le Traité de Rome إلى les crises، مع le vocabulaire السياسي اللازم.","cat":"Culture","level":"B2","main":true},{"title":"Comment citer et référencer ses sources","channel":"Le français by Alex","videoId":"oVIc7T_RLRI","why":"la rigueur de citation nécessaire للتحليل السياسي الأكاديمي.","cat":"Culture","level":"B2","extra":true},{"title":"Écrire un résumé et un abstract efficaces","channel":"Français Authentique","videoId":"DQzyDJxYrZw","why":"résumer un article politique sans perdre la nuance.","cat":"Culture","level":"B2","extra":true}],"supplements":[{"id":"oVIc7T_RLRI","title":"Comment citer et référencer ses sources","channel":"Le français by Alex","why":"la rigueur de citation nécessaire للتحليل السياسي الأكاديمي.","lang":"fr","dur":15},{"id":"DQzyDJxYrZw","title":"Écrire un résumé et un abstract efficaces","channel":"Français Authentique","why":"résumer un article politique sans perdre la nuance.","lang":"fr","dur":12}]},{"id":"b2-t7-l6","fr":"La gastronomie au patrimoine","ar":"الغذاء كتراث","objectives":["وصف le repas français: l’apéritif, le plat, le fromage, le dessert","استعمال le lexique du goût: le terroir, l’appellation, l’artisan","تمييز le repas عن la restauration عن la cuisine","تقييم un plat أو un produit بالفرنسية بـ la nuance"],"sections":[{"h":"الدرس 6: كيف تتكلّم عن المائدة الفرنسية كتراث حيّ","video":{"id":"LlW2qOE8Fwo","title":"La gastronomie française, patrimoine immatériel","channel":"France 3","why":"reportage عن la gastronomie: من le repas familial إلى les produits du terroir، مع le lexique de la table et du goût.","lang":"fr","main":true,"dur":15},"p":["la gastronomie الفرنسية ليست la nourriture فقط بل un rituel: le repas يجمع، le terroir يُعرِّف، et le temps يُحترم. la France سجّلته كـ patrimoine immatériel — لأن la valeur في le geste et le partage لا في le plat وحده.","معجم الدرس: le terroir, l’appellation, l’artisan, le produit, la saison, la recette, le goût, l’apéritif, l’entrée, le plat principal, le fromage, le digestif. هذه المفردات تبني votre conversation à table.","نحوياً، l’appréciation تأتي بالconditionnel: « Ce vin serait parfait avec… »، et la critique بـ la litote: « Ce n’est pas mal ! ». la franchise directe (« c’est mauvais ») تُقرأ comme une impolitesse.","les articles partitifs يحكمون la nourriture: « du pain », « de l’eau », « des légumes » — و le pronom en يحل محلها: « Tu veux du fromage ? — J’en veux bien. »","الدرس الأهم: le repas يُقرأ كـ un texte: l’apéritif l’accroche، le plat le développement، le fromage la transition، le dessert la chute. من يفهم هذه البنية يفهم la culture.","بعد الدرس: اصف repas فرنسياً شاركت فيه في ست جمل: le moment، le menu، la personne، le goût، puis une nuance sur le terroir."],"sub":[{"h":"بنية le repas","p":["L’apéritif rassemble, le repas lie.","Le fromage ouvre la transition.","Le dessert conclut le récit de la table."]},{"h":"أدوات نطقية: le goût","p":["« Ce vin a du corps. » [sə vɛ̃ a dy kɔʁ] — la dégustation.","« Le goût est en bouche longtemps. » — la longueur.","« Ce n’est pas mal du tout ! » — la litote appréciative."]},{"h":"خطوات la dégustation","p":["الخطوة الأولى: décrire le goût (sucré, amer, acide).","الثانية: nommer le terroir.","الثالثة: proposer un accord."]}]},{"h":"عبارات المائدة","p":["« À votre santé ! » = صحتكم! — l’apéritif qui ouvre.","« Qu’est-ce que vous en pensez ? » — la question qui lie les convives.","« Ce vin serait parfait avec ce plat. » — l’accord au conditionnel.","« C’est un plat du terroir. » = إنه طبق محلي — l’identité."]},{"h":"التطبيق والتلخيص","p":["تمرين la description: اصف plato واحداً في خمس جمل: l’aspect، le goût، la saison، le terroir، puis l’accord.","تمرين le menu: اكتب menu من أربعة أشواط بالترتيب الفرنسي مع les partitifs.","سجّل تقييماً من 30 ثانية لمنتج محلي بـ « Ce n’est pas mal… » ثم « Je nuance… »."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: قرأنا le repas الفرنسي كـ un texte له بداية ووسط ونهاية، مع les partitifs و la litote في l’appréciation et le conditionnel في l’accord. أعد مشاهدة الفيديو الرئيسي وركّز على la progression des temps forts et les formules de politesse à table.","جسر الدروس: من b2-t7-l5 (مؤسسات فرنسا في الاتحاد الأوروبي) إلى b2-t7-l6 (الغذاء الفرنسي بوصفه تراثاً حياً)، ثم إلى b2-t8-l1 حيث ننتقل من la table إلى l’écoute: تحليل أغنية فرنسية و التقاط le sens caché.","مهمة تطبيقية: سجّل نفسك دقيقة واحدة تصف فيها طبقاً بـ le goût et la saison، واكتب ثلاث كلمات جديدة من الدرس واستعملها في ثلاث جمل، ثم قارن وصفك بالفيديو الرئيسي بـ « La vidéo dit que…, moi j’ajoute… »."]}],"pron":[{"w":"le terroir","ipa":"[lə tɛ.ʁwaʁ]","approx":"لو تيروار"},{"w":"l’apéritif","ipa":"[a.pe.ʁi.tif]","approx":"أبيريتيف"},{"w":"la dégustation","ipa":"[la de.gys.ta.sjɔ̃]","approx":"ديگوستاسيون"}],"vocab":[{"fr":"la dégustation","ar":"التذوّق","pos":"nom","g":"f","exFr":"La dégustation commence par l’aspect.","ipa":"[de.gys.ta.sjɔ̃]","exAr":"يبدأ التذوّق بالشكل."},{"fr":"l’appellation","ar":"التسمية المحمية","pos":"nom","g":"f","exFr":"L’appellation protège le nom.","ipa":"[a.pe.la.sjɔ̃]","exAr":"التسمية المحمية تحمي الاسم."},{"fr":"l’artisan","ar":"الحرفي","pos":"nom","g":"m","exFr":"L’artisan prépare tout sur place.","ipa":"[aʁ.ti.zɑ̃]","exAr":"الحرفي يُحضّر كل شيء في المكان."},{"fr":"la saison","ar":"الموسم","pos":"nom","g":"f","exFr":"Mangez à la saison.","ipa":"[sɛ.zɔ̃]","exAr":"تناول طعاماً في موسمه."},{"fr":"l’art culinaire","ar":"فنّ الطهي","pos":"nom","g":"m","exFr":"L’art culinaire français est un patrimoine.","ipa":"[laʁ ky.li.nɛʁ]","exAr":"الفنّ الطهي الفرنسي تراث."},{"fr":"le goût","ar":"الذوق / الطعم","pos":"nom","g":"m","exFr":"Le goût est équilibré.","ipa":"[ɡu]","exAr":"الطعم متوازن."},{"fr":"le digestif","ar":"المشروب الهضمي بعد الوجبة","pos":"nom","g":"m","exFr":"Le digestif clôt le repas.","ipa":"[di.ʒɛs.tif]","exAr":"يُنهي المشروب الهضمي الوجبة."},{"fr":"la crème fraîche","ar":"القشدة الطازجة","pos":"nom","g":"f","exFr":"La crème fraîche lie la sauce.","ipa":"[klɛm fʁɛʃ]","exAr":"تربط القشدة الطازجة الصلصة."},{"fr":"un accord mets-vin","ar":"توافق الطعام والنبيذ","pos":"nom","g":"m","exFr":"L’accord mets-vin est parfait.","ipa":"[ɛ̃‿a.kɔʁ mɛ vɛ̃]","exAr":"التوافق بين الطعام والنبيذ مثالي."},{"fr":"déguster","ar":"يتذوّق","pos":"verbe","g":"","exFr":"Il déguste le vin lentement.","ipa":"[de.gys.te]","exAr":"يتذوّق النبيذ ببطء."},{"fr":"apprécier","ar":"يُقيّم بإعجاب","pos":"verbe","g":"","exFr":"J’apprécie cette cuisine.","ipa":"[a.pʁe.sje]","exAr":"أُقدّر هذه المطبخة."},{"fr":"partager un repas","ar":"يتشارك وجبة","pos":"loc.","g":"","exFr":"On partage un repas en famille.","ipa":"","exAr":"نتشارك وجبة في العائلة."}],"examples":[{"fr":"Le fromage ouvre la transition vers le dessert.","ar":"الجبن يفتح الانتقال نحو الحلوى.","note":"la structure du repas"},{"fr":"Ce vin serait parfait avec ce plat.","ar":"هذا النبيذ سيكون مثالياً مع هذا الطبق.","note":"l’accord"},{"fr":"Ce n’est pas mal du tout, franchement.","ar":"ليس سيئاً إطلاقاً، بصراحة.","note":"la litote"},{"fr":"Mangez à la saison, le goût est meilleur.","ar":"تناول في موسمه، فالطعم أفضل.","note":"le terroir"},{"fr":"Tu veux du fromage ? — J’en veux bien.","ar":"هل تريد جبناً؟ — أحب أن آكل.","note":"le pronom en"},{"fr":"C’est un plat du terroir, préparé par un artisan.","ar":"إنه طبق محلي، يُحضّره حرفي.","note":"l’identité"}],"grammar":[{"tFr":"Les articles partitifs et le pronom en","tAr":"أدوات التبعيض وضمير en","body":["la nourriture تأتي مع les partitifs: « du pain », « de l’eau », « des légumes » — la négation تحذفها: « Je ne veux pas de fromage. »","le pronom en يحل محل de + nom: « Tu veux du fromage ? — J’en veux bien. » la réponse بالمفرد تبقى en: « J’en ai goûté un. »"],"ex":[{"fr":"Je prends du pain et de l’eau.","ar":"آخذ خبزاً وماءً."},{"fr":"Il y a du fromage ? — J’en veux bien.","ar":"هل هناك جبن؟ — أحب أن آكل."}]},{"tFr":"L’appréciation : conditionnel et litote","tAr":"التقييم: الشرطية والتلطيف","body":["l’évaluation positives تأتي بالconditionnel و la litote: « Ce vin serait parfait », « Ce n’est pas mal ! ». la franchise directe تُقرأ comme impolie في la conversation.","la critique تُغلَّف بـ « je nuance » ou « peut-être que… » — la politesse هنا ليست la faiblesse بل la culture."],"ex":[{"fr":"Ce plat serait excellent avec un vin blanc.","ar":"سيكون هذا الطبق ممتازاً مع نبيذ أبيض."},{"fr":"C’est bon, mais je nuance : un peu trop salé.","ar":"طعمه جيد، لكن بتمييز: مالح قليلاً."}]}],"mistakes":[{"wrong":"« J’ai du mal avec… » لوصف le repas","right":"« Ce n’est pas mon plat. »","why":"la structure la nuance تُحفظ la politesse."},{"wrong":"la critique المباشرة","right":"la litote + le conditionnel","why":"la franchise الكاملة تُقرأ جفاءً."},{"wrong":"الإهمال بين les partitifs","right":"du / de la / de l’ / des","why":"l’article يحدّd la nature du repas."},{"wrong":"la description بلا terroir","right":"le produit + la saison + la région","why":"le terroir هو le cœur du patrimoine."}],"dialogues":[{"title":"à table","ctx":"عشاء عائلي","lines":[{"who":"Hôte","fr":"À votre santé, goûtez ce vin.","ar":"صحتكم، تذوّقوا هذا النبيذ."},{"who":"Invité","fr":"Il a du corps, il me plaît.","ar":"له قوام، إنه أعجبني."},{"who":"Hôte","fr":"Il vient de notre terroir.","ar":"إنه من بيئتنا المحلية."},{"who":"Invité","fr":"Ce serait parfait avec le fromage.","ar":"سيكون مثالياً مع الجبن."}]},{"title":"évaluation nuancée","ctx":"مقابلة مع حرفي","lines":[{"who":"Journaliste","fr":"Comment décririez-vous votre fromage ?","ar":"كيف تصف جبنك؟"},{"who":"Artisan","fr":"Le goût est en bouche longtemps.","ar":"الطعم يبقى في الفم طويلاً."},{"who":"Journaliste","fr":"Et l’accord idéal ?","ar":"والتوافق المثالي؟"},{"who":"Artisan","fr":"Un pain de campagne, à la saison.","ar":"خبز ريفي، في موسمه."}]}],"exercises":[{"t":"mcq","skill":"culture","q":"ما « le terroir »؟","opts":["البيئة المحلية للمنتج","الوصفة","المطبخ","الموسم"],"a":0,"why":"terroir = la terre, le climat, la tradition."},{"t":"fill","skill":"grammar","q":"أكمل: «Je voudrais ___ pain, s’il vous plaît.»","fr":"Je voudrais ___ pain, s’il vous plaît.","ans":"du","why":"l’article partitif avec la nourriture."},{"t":"mcq","skill":"culture","q":"ما la structure correcte de le repas ؟","opts":["apéritif، طبق، جبن، حلويات","حلويات، جبن، طبق، شاي","طبق، شاي، جبن، حلويات","جبن، طبق، شاي، ماء"],"a":0,"why":"la progression classique du repas français."},{"t":"order","skill":"writing","q":"رتّب: هذا النبيذ سيكون مثالياً مع هذا الطبق","words":["Ce","vin","serait","parfait","avec","ce","plat."],"ans":"Ce vin serait parfait avec ce plat.","why":"l’accord au conditionnel."},{"t":"listen","skill":"listening","q":"ما « à votre santé »؟","opts":["عبارة افتتاح العشاء","وداع","اعتذار","شكر"],"a":0,"why":"l’apéritif يبدأ بـ la santé."},{"t":"translate","skill":"writing","q":"ترجم: إنه طبق محلي، يُحضّره حرفي.","ans":"C’est un plat du terroir, préparé par un artisan.","why":"le terroir + l’artisan."},{"t":"speaking","skill":"speaking","q":"صف plato في خمس جمل: l’aspect، le goût، la saison، le terroir، puis l’accord.","target":"Ce plat… / Le goût… / À la saison… / C’est du terroir… / Avec…","why":"la dégustation complète."},{"t":"correct","skill":"grammar","q":"صحّح: «Je ne veux pas de fromages.» مع partitif","ans":"Je ne veux pas de fromage.","why":"la négation تحذف le partitif و le singulier يبقى."}],"homework":"اكتب وصفة لطبق من بلدك بالفرنسية في 120 كلمة: le produit، la saison، le geste، ثم اقترح un accord مع نبيذ أو مشروب محلي.","sources":[{"title":"La gastronomie française, patrimoine immatériel","channel":"France 3","videoId":"LlW2qOE8Fwo","why":"reportage عن la gastronomie: من le repas familial إلى les produits du terroir، مع le lexique de la table et du goût.","cat":"Culture","level":"B2","main":true},{"title":"Le style : préciser et nuancer","channel":"Le français by Alex","videoId":"JKMcILxOYLs","why":"la précision du style pour décrire un plat avec nuance.","cat":"Culture","level":"B2","extra":true},{"title":"Reportage culturel : le goût et le territoire","channel":"Documentaire Société","videoId":"URkSwnrvGoM","why":"reportage sur le terroir : la gastronomie comme patrimoine vivant.","cat":"Culture","level":"B2","extra":true}],"supplements":[{"id":"JKMcILxOYLs","title":"Le style : préciser et nuancer","channel":"Le français by Alex","why":"la précision du style pour décrire un plat avec nuance.","lang":"fr","dur":15},{"id":"URkSwnrvGoM","title":"Reportage culturel : le goût et le territoire","channel":"Documentaire Société","why":"reportage sur le terroir : la gastronomie comme patrimoine vivant.","lang":"fr","dur":26}]}]},{"id":"b2-t8","slug":"ecoute-avancee","icon":"headphones","color":"#7b1fa2","fr":"Écoute avancée","ar":"الاستماع المتقدم","desc":"les chansons، le podclass، les documentaires، le théâtre، les conférences، les films — la oreille B2.","lessons":[{"id":"b2-t8-l1","fr":"Chansons françaises analytiques","ar":"تحليل الأغاني الفرنسية","objectives":["تحليل la structure de la chanson: couplet, refrain, pont","التقاط les mots-clés et le sens global دون فهم كل كلمة","تمييز les figures de style: comparaison, métaphore, personnification","استعمال la négation الكاملة: ne… jamais, ne… plus, ne… personne"],"sections":[{"h":"الدرس 1: كيف تسمع أغنية فرنسية وتفهم ما وراء كلماتها","video":{"id":"87vz_BYEc7s","title":"[B2] Dis, quand reviendras-tu ? — Thomas Guerlet ft Miki Duplay (avec paroles)","channel":"Komal | Prof de FLE","why":"أغنية B2 مع le texte complet: la mélodie تُبطئ la parole فتصبح la dictée الطبيعية — la meilleure بداية لـ l’analyse des chansons.","lang":"fr","main":true,"dur":5},"p":["la chanson هي la matériau الأثراً للاستماع: la musique تُثبّت la mélodie، l’émotion تُبقي les mots في الذاكرة. la méthode: استمع مرتين دون نص، ثم افتح le texte ودقّقه.","المفردات الأساسية: le refrain, le couplet, le pont, les paroles, la rime, la métaphore, la comparaison, le sens caché, l’interprétation, la voix, le ton, l’expression. هذه هي la boîte à outils de l’analyse.","نحوياً، la chanson تُكثّف la négation: « Je ne sais plus. », « Tu ne reviendras jamais. », « Personne ne m’attend. » — les formes courtes تظهر في la chanson قبل أن تظهر في la conversation.","les figures de style تحمل le sens: la comparaison (« comme… »)، la métaphore (بدون comme)، la personnification (إضفاء الحياة على الأشياء). la clé: اسأل دائماً « Pourquoi cette image ? »","attention à la rime: elle توجّه la ponctuation وتساعدك على تقسيم la phrase المنطوقة — la rime هي la première قاعدة للاستماع.","بعد الدرس: اختر أغنية فرنسية، اكتب les mots inconnus خمسة فقط، ثم اشرح la message في جملتين بالفرنسية."],"sub":[{"h":"بنية الأغنية","p":["Le couplet raconte, le refrain revient toujours.","Le pont change le ton avant la dernière minute.","Les paroles sont simples, mais le sens est double."]},{"h":"أدوات نطقية: la négation في la chanson","p":["« Je ne sais plus » [ʒə nə sɛ ply] — la négation تُنطق بـ ne صامتاً غالباً.","« Tu ne reviendras jamais » — le futur simple يُثبّت la promesse.","« Personne ne m’attend » — le sujet inversé في la chanson."]},{"h":"خطوات Listen & Repeat","p":["المرة الأولى: دون نص، اكتب le thème العام.","الثانية: مع النص، حدد le refrain et les rimes.","الثالثة: غنّ chorus بصوتك لتثبيت la mémoire."]}]},{"h":"تعبيرات التحليل الموسيقي","p":["« Le refrain exprime l’essentiel. » = الـ chorus يحمل الفكرة الأساسية.","« Ce vers est une comparaison. » = هذا البيت تشبيه.","« Le sens est plus fort que les mots. » — la lecture entre les lignes.","« Sa voix est posée, presque parlée. » — la description de l’interprétation."]},{"h":"التطبيق والتلخيص","p":["تمرين le refrain: استمع إلى أغنية واكتب le refrain بالضبط مع l’orthographe.","تمرين les figures: وجد أربعة تشبيهات أو استعارات في الأغنية واشرح كل واحدة.","سجّل تحليلك لثلاثين ثانية: la structure، une figure، ثم le message — بالفرنسية."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: بنينا la structure de la chanson (couplet, refrain, pont) و les figures de style (comparaison, métaphore, personnification) مع la négation الكاملة ne… jamais, ne… plus, ne… personne. أعد مشاهدة الفيديو الرئيسي وركّز على le refrain et les rimes qui structurent l’écoute.","جسر الدروس: من b2-t7-l6 (الغذاء الفرنسي بوصفه تراثاً حياً) إلى b2-t8-l1 (تحليل بنية الأغنية الفرنسية)، ثم إلى b2-t8-l2 حيث ننتقل من la chanson courte إلى l’émission longue et la prise de notes en arbre.","مهمة تطبيقية: اختر أغنية فرنسية وسجّل نفسك دقيقة واحدة تحدّد فيها le refrain et une figure de style، واكتب ثلاث كلمات جديدة من الدرس واستعملها في ثلاث جمل، ثم قارن تحليلك بالفيديو الرئيسي بـ « Dans la vidéo, on voit que…, pour moi… »."]}],"pron":[{"w":"le refrain","ipa":"[lə ʁə.fʁɛ̃]","approx":"لو روفرين"},{"w":"la métaphore","ipa":"[la me.ta.fɔʁ]","approx":"لا ميتافور"},{"w":"les paroles","ipa":"[le pa.ʁɔl]","approx":"ل بارول"}],"vocab":[{"fr":"le refrain","ar":"كوروس الأغنية","pos":"nom","g":"m","exFr":"Le refrain revient à chaque fois.","ipa":"","exAr":"يكرر الكوروس في كل مرة."},{"fr":"le couplet","ar":"المقطع الغنائي","pos":"nom","g":"m","exFr":"Le premier couplet raconte l’histoire.","ipa":"","exAr":"يروي المقطع الأول القصة."},{"fr":"les paroles","ar":"كلمات الأغنية","pos":"nom","g":"f","exFr":"Je regarde les paroles en chantant.","ipa":"","exAr":"أتابع الكلمات أثناء الغناء."},{"fr":"la rime","ar":"القافية","pos":"nom","g":"f","exFr":"La rime relie les deux vers.","ipa":"","exAr":"تربط القافية البيتين."},{"fr":"la métaphore","ar":"الاستعارة","pos":"nom","g":"f","exFr":"Cette métaphore exprime la solitude.","ipa":"","exAr":"تعبّر هذه الاستعارة عن الوحدة."},{"fr":"la comparaison","ar":"التشبيه","pos":"nom","g":"f","exFr":"La comparaison utilise « comme ».","ipa":"","exAr":"يستعمل التشبيه كلمة «comme»."},{"fr":"le sens caché","ar":"المعنى الخفي","pos":"nom","g":"m","exFr":"Il y a un sens caché dans ce couplet.","ipa":"","exAr":"يوجد معنى خفي في هذا المقطع."},{"fr":"l’interprétation","ar":"الأداء الغنائي","pos":"nom","g":"f","exFr":"Son interprétation est très émouvante.","ipa":"","exAr":"أداؤه مؤثر جداً."},{"fr":"la voix","ar":"الصوت","pos":"nom","g":"f","exFr":"Sa voix est grave et posée.","ipa":"","exAr":"صوته عميق وهادئ."},{"fr":"le ton","ar":"النبرة","pos":"nom","g":"m","exFr":"Le ton est ironique dans ce vers.","ipa":"","exAr":"النبرة ساخرة في هذا البيت."},{"fr":"l’expression","ar":"التعبير","pos":"nom","g":"f","exFr":"L’expression « tomber amoureux » est courante.","ipa":"","exAr":"التعبير «tomber amoureux» شائع."},{"fr":"repérer","ar":"يحدّد / يكتشف","pos":"verbe","g":"","exFr":"On repère les mots-clés dès la première écoute.","ipa":"","exAr":"نحدّد الكلمات المفتاحية من الاستماع الأولى."}],"examples":[{"fr":"Je ne sais plus où j’ai laissé la clé.","ar":"لم أعد أعرف أين تركت المفتاح.","note":"ne… plus"},{"fr":"Tu ne reviendras jamais.","ar":"لن تعود أبداً.","note":"ne… jamais"},{"fr":"Personne ne m’attend ce soir.","ar":"لا أحد ينتظرني الليلة.","note":"ne… personne"},{"fr":"Son cœur bat comme un tambour.","ar":"قلبه يدقّ كطبّارة.","note":"la comparaison"},{"fr":"Les feuilles dansent dans le vent.","ar":"الأوراق ترقص في الريح.","note":"la personnification"},{"fr":"Le refrain revient trois fois.","ar":"يكرر الكوروس ثلاث مرات.","note":"la structure"}],"grammar":[{"tFr":"La négation complète dans la chanson","tAr":"النفي الكامل في الأغنية","body":["les formes: ne… jamais (أبداً)، ne… plus (لم يعد)، ne… personne (لا أحد)، ne… rien (لا شيء)، ne… guère (بالكاد).","في la chanson يبقى ne عادة، بعكس la parole rapide: « Je n’ai plus rien à dire. » — la forme complète تعطي la rime."],"ex":[{"fr":"Je n’ai plus rien à te dire.","ar":"لم يبقَ لي ما أقوله لك."},{"fr":"Personne ne vient au rendez-vous.","ar":"لا أحد يأتي إلى الموعد."}]},{"tFr":"Les figures de style : comparaison, métaphore, personnification","tAr":"الصور البيانية: التشبيه والاستعارة والتشخيص","body":["la comparaison تستعمل un lien explicite: « comme », « ainsi que »: « Elle chante comme un oiseau. »","la métaphore تدمج le comparé dans l’image نفسها: « C’est un oiseau qui chante. »، و la personnification تمنح la vie للشيء: « Le vent murmure. »"],"ex":[{"fr":"Elle chante comme un oiseau.","ar":"تغنّي كطائر.","note":"la comparaison"},{"fr":"Le vent murmure dans les arbres.","ar":"الريح تتمتم في الأشجار.","note":"la personnification"}]}],"mistakes":[{"wrong":"البحث عن كل كلمة مجهولة","right":"تحديد le thème ثم les mots-clés","why":"la chanson تُفهم بالسياق لا بالقاموس."},{"wrong":"« Je ne sais plus » بلا ne","right":"« Je n’ai plus rien. »","why":"la négation الكاملة تبقى في la chanson."},{"wrong":"الخلط بين comparaison و métaphore","right":"comparaison = مع « comme »، métaphore = بدونها","why":"الفارق يحدد le niveau de lecture."},{"wrong":"قراءة le texte فقط","right":"الاستماع أولاً ثم le texte","why":"la compréhension orale هي la cible."}],"dialogues":[{"title":"تحليل أغنية","ctx":"معلمة مع طالبين","lines":[{"who":"Prof","fr":"Quel est le thème du premier couplet ?","ar":"ما موضوع المقطع الأول؟"},{"who":"Lina","fr":"La solitude, je crois.","ar":"الوحدة، أعتقد."},{"who":"Prof","fr":"Exactement. Et le refrain ?","ar":"بالضبط. والكوروس؟"},{"who":"Lina","fr":"Il revient toujours avec la même rime.","ar":"يكرر دائماً بنفس القافية."}]},{"title":"نقاش حول الأداء","ctx":"صديقان يستمعان للأغنية","lines":[{"who":"Samir","fr":"Sa voix est presque parlée.","ar":"صوته شبه منطوق."},{"who":"Emma","fr":"Oui, le ton est ironique au début.","ar":"نعم، النبرة ساخرة في البداية."},{"who":"Samir","fr":"Et cette image : les feuilles dansent.","ar":"وهذه الصورة: الأوراق ترقص."},{"who":"Emma","fr":"C’est une personnification du vent.","ar":"إضفاء حياة على الريح."}]}],"exercises":[{"t":"mcq","skill":"listening","q":"ما la fonction de le refrain؟","opts":["التكرار وحمل الفكرة الأساسية","تغيير اللغة","الاختتام فقط","التعارف"],"a":0,"why":"le refrain يحمل l’essentiel ويتكرر."},{"t":"fill","skill":"grammar","q":"أكمل la négation الكاملة:","fr":"Je ___ sais plus rien.","ans":"ne","why":"la négation الكاملة: ne… plus… rien."},{"t":"mcq","skill":"vocabulary","q":"ما معنى « les paroles » في الأغنية؟","opts":["الكلمات","الصوت","اللحن","القافية"],"a":0,"why":"paroles = كلمات الأغنية."},{"t":"order","skill":"writing","q":"رتّب: لم يبقَ لي ما أقوله لك","words":["Je","n’ai","plus","rien","à","te","dire."],"ans":"Je n’ai plus rien à te dire.","why":"ne… plus + rien."},{"t":"listen","skill":"listening","q":"ما la figure في «Le vent murmure»؟","opts":["la personnification","la comparaison","l’hyperbole","l’euphémisme"],"a":0,"why":"إضفاء الفعل البشري على الريح = la personnification."},{"t":"translate","skill":"writing","q":"ترجم: لا أحد ينتظرني الليلة.","ans":"Personne ne m’attend ce soir.","why":"ne… personne."},{"t":"speaking","skill":"speaking","q":"حلّل أغنية في 30 ثانية: la structure، une figure، ثم le message.","target":"Le couplet… / Le refrain… / C’est une métaphore parce que… / Le message…","why":"l’analyse de la chanson."},{"t":"correct","skill":"grammar","q":"صحّح: «Je ne sais plus rien, personne attends.»","ans":"Je ne sais plus rien, personne ne m’attend.","why":"la négation complète مع le verbe conjugué."}],"homework":"اختر أغنية فرنسية، اكتب les cinq mots inconnus مع معانيها، ثم حدد une comparaison و une métaphore — وسجّل تحليلك في 40 ثانية.","sources":[{"title":"[B2] Dis, quand reviendras-tu ? — Thomas Guerlet ft Miki Duplay (avec paroles)","channel":"Komal | Prof de FLE","videoId":"87vz_BYEc7s","why":"أغنية B2 مع le texte complet: la mélodie تُبطئ la parole فتصبح la dictée الطبيعية — la meilleure بداية لـ l’analyse des chansons.","cat":"Écoute","level":"B2","main":true},{"title":"ÉTABLIR UN FAIT SCIENTIFIQUE | Chanson pédagogique B2","channel":"Frenchecho","videoId":"OWdNRcD4KSg","why":"chanson pédagogique — la chanson نفسها تشرح la méthode de l’analyse.","cat":"Écoute","level":"B2","extra":true},{"title":"Les expressions idiomatiques autour des animaux 2","channel":"Kelly, la prof de français","videoId":"_VfSkJtvoXs","why":"lexique imagé كثيراً ما يظهر في les chansons et les métaphores.","cat":"Écoute","level":"B2","extra":true}],"supplements":[{"id":"OWdNRcD4KSg","title":"ÉTABLIR UN FAIT SCIENTIFIQUE | Chanson pédagogique B2","channel":"Frenchecho","why":"chanson pédagogique — la chanson نفسها تشرح la méthode de l’analyse.","lang":"fr","dur":5},{"id":"_VfSkJtvoXs","title":"Les expressions idiomatiques autour des animaux 2","channel":"Kelly, la prof de français","why":"lexique imagé كثيراً ما يظهر في les chansons et les métaphores.","lang":"fr","dur":1}]},{"id":"b2-t8-l2","fr":"Podclass et radio","ar":"البودكاست والإذاعة","objectives":["فهم la structure de l’émission: intro, rubriques, invité, conclusion","التقاط les connecteurs et le fil rouge dans une écoute longue","تمييز la voix du présentateur عن la voix de l’invité","الاستماع 10 دقائق بلا نص مع استخراج les idées principales"],"sections":[{"h":"الدرس 2: كيف تستمع إلى البودكاست الفرنسي بلا نص","video":{"id":"_LTsjwiTN7w","title":"Céline Dion - Parler à mon père (Clip officiel)","channel":"CelineDionVEVO","why":"voix فرنسية نظيفة ودقيقة la diction — مناسبة للتدريب على la compréhension sans texte قبل الانتقال إلى le podcast long.","lang":"fr","main":true,"dur":3},"p":["le podcast الفرنسي يختلف عن la chanson: la parole est continue، la vitesse réelle، et les hésitations موجودة. la méthode: trois écoutes — la première pour le thème، la deuxième pour les détails، والثالثة للكلمات.","المفردات الأساسية: l’émission, la rubrique, le fil rouge, l’invité, le présentateur, l’auditeur, le reportage sonore, la station, la pause, l’interview, le générique, la publicité. هذه هي la carte de la radio.","نحوياً، le discours radiophonique يعتمد على les connecteurs: « D’abord… », « Ensuite… », « Par ailleurs… », « Enfin… » — ترتيبها يكشف la structure قبل أن تفهم les mots.","les hésitations جزء من la langue vivante: « euh… », « en fait… », « je veux dire… ». لا تحذفها من استماعك — إنها علامات la structure.","pour les podcasts الطويلة: خذ une note en forme de arbre: thème ← trois points ← conclusion. la prise de notes البصرية تنقذ la compréhension.","بعد الدرس: استمع إلى عشر دقائق من podcast بلا نص، اكتب les trois idées principales في ثلاث جمل."],"sub":[{"h":"بنية الإذاعة","p":["Bienvenue dans cette émission consacrée à la vie quotidienne.","Après la première rubrique, nous recevrons un invité.","Restez avec nous jusqu’à la fin de l’antenne."]},{"h":"أدوات نطقية: la parole en continu","p":["« D’abord… ensuite… enfin… » — les connecteurs organisent le discours.","« Euh… en fait… je veux dire… » — les hésitations naturelles.","« Vous êtes sur France Inter » — la signature de la station."]},{"h":"خطوات Listen & Repeat","p":["المرة الأولى: بلا نص، اكتب le thème فقط.","الثانية: حدد les connecteurs et l’ordre des idées.","الثالثة: اكتب les trois phrases principales وقارنها."]}]},{"h":"تعبيرات الإذاعة والبودكاست","p":["« Vous écoutez… » = أنتم تستمعون إلى… — la signature de toute station.","« Notre invité d’aujourd’hui est… » — l’introduction de l’invité.","« On fait le point sur… » = نراجع موضوعاً — la transition classique.","« Restez avec nous. » = إبقوا معنا — la promesse avant la pause."]},{"h":"التطبيق والتلخيص","p":["تمرين la note en arbre: استمع إلى podcast من ثماني دقائق واكتب le thème ثم les trois points.","تمرين la voix: حدد كل مرة يتغير فيها le locuteur وسمِّ دوره (présentateur / invité).","سجّل مقدمة إذاعية من 30 ثانية: bienvenue، rubrique، invité، puis la transition."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: بنينا la méthode des trois écoutes مع le vocabulaire de l’antenne (rubrique, fil rouge, invité) و les connecteurs d’abord / ensuite / enfin، ثم la prise de notes en forme de arbre. أعد مشاهدة الفيديو الرئيسي وركّز على le moment où change le locuteur.","جسر الدروس: من b2-t8-l1 (تحليل بنية الأغنية الفرنسية) إلى b2-t8-l2 (الاستماع إلى البودكاست بلا نص)، ثم إلى b2-t8-l3 حيث ننتقل من l’émission guidée إلى le documentaire long بلا نص مع les connecteurs de cause.","مهمة تطبيقية: استمع إلى podcast عشر دقائق ثم سجّل نفسك دقيقة واحدة تلخّص فيها les trois idées principales، واكتب ثلاث كلمات جديدة من الدرس واستعملها في ثلاث جمل، ثم قارن خلاصتك بالفيديو الرئيسي بـ « La vidéo organise…, moi je note… »."]}],"pron":[{"w":"l’émission","ipa":"[le.mi.sjɔ̃]","approx":"ليميسسيون"},{"w":"le présentateur","ipa":"[lə pʁe.zɑ̃.ta.tœʁ]","approx":"لو بريزانتاتور"},{"w":"l’antenne","ipa":"[lɑ̃.tɛn]","approx":"لانتين"}],"vocab":[{"fr":"le podcast","ar":"البودكاست","pos":"nom","g":"m","exFr":"J’écoute ce podcast dans le métro.","ipa":"","exAr":"أستمع إلى هذا البودكاست في المترو."},{"fr":"l’émission","ar":"البرنامج الإذاعي","pos":"nom","g":"f","exFr":"L’émission dure une heure.","ipa":"","exAr":"يستمر البرنامج ساعة."},{"fr":"la rubrique","ar":"القسم في البرنامج","pos":"nom","g":"f","exFr":"La rubrique culture commence à dix heures.","ipa":"","exAr":"يبدأ قسم الثقافة في العاشرة."},{"fr":"le fil rouge","ar":"الخيط الموضوعي","pos":"nom","g":"m","exFr":"Le fil rouge de l’émission est la ville.","ipa":"","exAr":"الخيط الموضوعي للبرنامج هي المدينة."},{"fr":"l’invité","ar":"الضيف","pos":"nom","g":"m","exFr":"L’invité parle de son nouveau livre.","ipa":"","exAr":"يتحدث الضيف عن كتابه الجديد."},{"fr":"le présentateur","ar":"المقدّم","pos":"nom","g":"m","exFr":"Le présentateur a posé une bonne question.","ipa":"","exAr":"طرح المقدّم سؤالاً جيداً."},{"fr":"l’auditeur","ar":"المستمع","pos":"nom","g":"m","exFr":"Notre auditeur a appelé la rédaction.","ipa":"","exAr":"اتصل مستمعنا بهيئة التحرير."},{"fr":"la station","ar":"المحطة","pos":"nom","g":"f","exFr":"La station diffuse ce programme à midi.","ipa":"","exAr":"تبث المحطة هذا البرنامج ظهراً."},{"fr":"le reportage sonore","ar":"المراسلة الصوتية","pos":"nom","g":"m","exFr":"Le reportage sonore dure quatre minutes.","ipa":"","exAr":"تستمر المراسلة الصوتية أربع دقائق."},{"fr":"la pause","ar":"الاستراحة","pos":"nom","g":"f","exFr":"Une pause commerciale après ce sujet.","ipa":"","exAr":"استراحة إعلانية بعد هذا الموضوع."},{"fr":"la matinale","ar":"البرنامج الإذاعي الصباحي","pos":"nom","g":"f","exFr":"La matinale dure deux heures.","ipa":"","exAr":"يستمر البرنامج الإذاعي الصباحي ساعتين."},{"fr":"le générique","ar":"المقدمة الموسيقية","pos":"nom","g":"m","exFr":"Le générique ouvre l’émission.","ipa":"","exAr":"تفتح المقدمة الموسيقية البرنامج."}],"examples":[{"fr":"Vous écoutez France Inter.","ar":"أنتم تستمعون إلى فرانس إنتر.","note":"la signature"},{"fr":"Notre invité d’aujourd’hui est un historien.","ar":"ضيفنا اليوم مؤرخ.","note":"l’introduction"},{"fr":"D’abord les faits, ensuite les réactions.","ar":"أولاً الأحداث ثم ردود الفعل.","note":"les connecteurs"},{"fr":"Enfin, faisons le point sur la semaine.","ar":"أخيراً، نراجع الأسبوع.","note":"la conclusion"},{"fr":"Restez avec nous après la pause.","ar":"بقوا معنا بعد الاستراحة.","note":"la transition"},{"fr":"En fait, je voulais dire autre chose.","ar":"في الواقع، أردت أن أقول شيئاً آخر.","note":"l’hésitation"}],"grammar":[{"tFr":"Les connecteurs du discours radiophonique","tAr":"أدوات الربط في الخطاب الإذاعي","body":["l’ordre classique: d’abord (أولاً)، ensuite (ثم)، par ailleurs (من جانب آخر)، enfin (أخيراً). كل واحدة تفتح une rubrique.","« donc » و « c’est pourquoi » تربط la cause avec la conséquence، و « en revanche » تفتح la contradiction."],"ex":[{"fr":"D’abord les chiffres, ensuite les réactions des acteurs.","ar":"أولاً الأرقام ثم ردود فعل الفاعلين."},{"fr":"Par ailleurs, la station prépare une série spéciale.","ar":"من جانب آخر، تستعد المحطة لسلسلة خاصة."}]},{"tFr":"Le discours rapporté et les hésitations à l’oral","tAr":"الخطاب المنقول والتردد الشفوي","body":["à l’oral، le discours rapporté يبقى proche du discours direct: « Il a dit : “je viendrai.” » أو indirect مع que.","les hésitations (euh, en fait, je veux dire) تُظهر que la parole est vivante — la marque de la langue non préparée."],"ex":[{"fr":"Il a expliqué qu’il viendrait demain.","ar":"شرح أنه سيأتي غداً."},{"fr":"En fait, je voulais dire que la ville a changé.","ar":"في الواقع، أردت أن أقول إن المدينة تغيرت."}]}],"mistakes":[{"wrong":"الاستماع مع الترجمة الفورية","right":"ثلاث écoutes بدون ترجمة","why":"la traduction تعطّل la mémoire auditive."},{"wrong":"التركيز على كل كلمة مجهولة","right":"استخراج les idées principales أولاً","why":"la compréhension globale تسبق le détail."},{"wrong":"عدم تسجيل les connecteurs","right":"كتابة d’abord / ensuite / enfin","why":"les connecteurs هي la structure المسموعة."},{"wrong":"الاستماع بسرعة مضاعفة فوراً","right":"السرعة الطبيعية حتى la première écoute","why":"la vitesse réelle هي la cible النهائية."}],"dialogues":[{"title":"افتتاح البرنامج","ctx":"مقدمة إذاعية","lines":[{"who":"Présentateur","fr":"Vous écoutez notre émission du matin.","ar":"أنتم تستمعون إلى برنامجنا الصباحي."},{"who":"Présentateur","fr":"D’abord les infos, ensuite notre invité.","ar":"أولاً الأخبار ثم ضيفنا."},{"who":"Rédactrice","fr":"Par ailleurs, une nouvelle enquête paraît.","ar":"من جانب آخر، تُنشر تحقيقتان جديدتان."},{"who":"Présentateur","fr":"Restez avec nous après la pause.","ar":"بقوا معنا بعد الاستراحة."}]},{"title":"مقابلة في البودكاست","ctx":"مقدمة تقابل كاتبة","lines":[{"who":"Hôte","fr":"Votre nouveau livre parle de quoi ?","ar":"عن ماذا يتحدث كتابك الجديد؟"},{"who":"Hôte","fr":"En fait, je voulais commencer par la ville.","ar":"في الواقع، أردت أن أبدأ بالمدينة."},{"who":"Invitée","fr":"C’est le fil rouge de tout le récit.","ar":"إنه الخيط الموضوعي للسرد كله."},{"who":"Hôte","fr":"Parfait, faisons le point après la pause.","ar":"مثالي، نراجع بعد الاستراحة."}]}],"exercises":[{"t":"mcq","skill":"listening","q":"ما la première étape عند le podcast الجديد؟","opts":["الاستماع بلا نص لتحديد le thème","البحث عن كل كلمة","الترجمة الفورية","رفع السرعة"],"a":0,"why":"la première écoute تبدأ بالthème."},{"t":"fill","skill":"grammar","q":"أكمل l’ordre: «___ les faits, ensuite les réactions.»","fr":"___ les faits, ensuite les réactions.","ans":"D’abord","why":"d’abord ثم ensuite ثم enfin."},{"t":"mcq","skill":"vocabulary","q":"ما معنى « le fil rouge »؟","opts":["الخيط الموضوعي","الاستراحة","المستمع","المحطة"],"a":0,"why":"fil rouge = الموضوع المحوري."},{"t":"order","skill":"writing","q":"رتّب: أنتم تستمعون إلى فرانس إنتر","words":["Vous","écoutez","France","Inter."],"ans":"Vous écoutez France Inter.","why":"la signature de la station."},{"t":"listen","skill":"listening","q":"ما le rôle de « euh… en fait… »؟","opts":["علامات تردد تدل على la parole vivante","أخطاء يجب تصحيحها","كلمات مبهمة","إعلانات"],"a":0,"why":"les hésitations جزء من la langue naturelle."},{"t":"translate","skill":"writing","q":"ترجم: بقوا معنا بعد الاستراحة.","ans":"Restez avec nous après la pause.","why":"la transition de l’antenne."},{"t":"speaking","skill":"speaking","q":"قدّم مقدمة إذاعية من 30 ثانية: bienvenue، rubrique، invité، transition.","target":"Vous écoutez… / D’abord… / Notre invité… / Restez avec nous…","why":"بنية l’émission."},{"t":"correct","skill":"grammar","q":"صحّح l’ordre: «Enfin les faits, d’abord les réactions.»","ans":"D’abord les faits, ensuite les réactions.","why":"l’ordre logique des connecteurs."}],"homework":"استمع إلى حلقة بودكاست فرنسية عشر دقائق بلا نص، اكتب le thème ثم les trois idées principales في ثلاث جمل، ثم سجّل مقدمة إذاعية من 30 ثانية بنفس la structure.","sources":[{"title":"Céline Dion - Parler à mon père (Clip officiel)","channel":"CelineDionVEVO","videoId":"_LTsjwiTN7w","why":"voix فرنسية نظيفة ودقيقة la diction — مناسبة للتدريب على la compréhension sans texte قبل الانتقال إلى le podcast long.","cat":"Écoute","level":"B2","main":true},{"title":"Journal d’information 19H l 11-10-2026","channel":"Canal Algérie","videoId":"URkSwnrvGoM","why":"بث إذاعي/ télévisé كامل — la structure de l’antenne مطبقة على la durée réelle.","cat":"Écoute","level":"B2","extra":true},{"title":"ÉTABLIR UN FAIT SCIENTIFIQUE | Chanson pédagogique B2","channel":"Frenchecho","videoId":"OWdNRcD4KSg","why":"podcast قصير بصوت نقي — la transition بين chanson et discours.","cat":"Écoute","level":"B2","extra":true}],"supplements":[{"id":"URkSwnrvGoM","title":"Journal d’information 19H l 11-10-2026","channel":"Canal Algérie","why":"بث إذاعي/ télévisé كامل — la structure de l’antenne مطبقة على la durée réelle.","lang":"fr","dur":26},{"id":"OWdNRcD4KSg","title":"ÉTABLIR UN FAIT SCIENTIFIQUE | Chanson pédagogique B2","channel":"Frenchecho","why":"podcast قصير بصوت نقي — la transition بين chanson et discours.","lang":"fr","dur":5}]},{"id":"b2-t8-l3","fr":"Documentaires audio","ar":"المستمعات الوثائقية","objectives":["تتبّع la narration d’un documentaire: mise en place, enquête, résolution","استعمال les connecteurs de cause et de conséquence في la synthèse","التمييز بين la voix off et les témoignages","استخراج les idées principales من 20 دقيقة استماع بلا نص"],"sections":[{"h":"الدرس 3: كيف تتبع وثائقياً صوتياً طويلاً بالفرنسية","video":{"id":"zGyThu7EAHQ","title":"Angèle - La Loi de Murphy [OFFICIAL MUSIC VIDEO]","channel":"Angèle","why":"français نقي مع narration بصرية واضحة — échauffement مثالي قبل le documentaire long: la voix، le rythme، puis la compréhension du fil.","lang":"fr","main":true,"dur":3},"p":["le documentaire الصوتي يبني le monde بالكلمات: la voix off تصف، le témoin يؤكد، ثم la musique توجّه l’émotion. la méthode: سجّل les trois roles عند كل تغيّر في la voix.","المفردات الأساسية: le commentaire, la voix off, le témoin, l’enquête, la séquence, la narration, l’environnement sonore, le silence, le plan, le reportage, le récit, la preuve. هذه هي la grammaire du documentaire.","نحوياً، la cause والنتيجة يُربطان بـ: parce que, car, c’est pourquoi, ce qui fait que, de sorte que. la dernière صيغة تدخل في le registre soutenu وتظهر كثيراً في le commentaire.","la définition تأتي بـ: c’est-à-dire, autrement dit, à savoir — وهي la clé لفهم le passage difficile بلا قاموس.","attention إلى le silence: la pause في le documentaire ليست فراغاً بل la marque du sérieux؛ و le bruit de fond يكشف la scène قبل le commentaire.","بعد الدرس: استمع إلى وثائقي من 20 دقيقة، اكتب une synthèse من خمس جمل: le sujet، la méthode، deux faits، ثم la conclusion."],"sub":[{"h":"بنية الوثائقي","p":["Tout commence par une scène, puis le commentaire explique.","Le témoin confirme ce que la voix off a présenté.","La conclusion relie les faits au sens général."]},{"h":"أدوات نطقية: la cause et la conséquence","p":["« Parce que… » — la cause la plus simple et la plus forte.","« Ce qui fait que… » — la conséquence naturelle, très fréquente.","« C’est-à-dire… » — la reformulation qui sauve la compréhension."]},{"h":"خطوات Listen & Repeat","p":["المرة الأولى: حدد les trois roles de la voix.","الثانية: اكتب les connecteurs de cause.","الثالثة: أعد الرواية من la synthèse."]}]},{"h":"تعبيرات الوثائقي","p":["« Tout a commencé un matin de mars. » — l’accroche du récit.","« D’après les enquêteurs… » — la preuve entre en scène.","« Ce qui fait que rien n’a changé. » — la conséquence الفرنسية الكلاسيكية.","« Autrement dit, le problème reste entier. » — la reformulation قبل la conclusion."]},{"h":"التطبيق والتلخيص","p":["تمرين les trois roles: استمع لخمس دقائق وسمِّ عند كل تبديل: commentaire، témoin، musique.","تمرين la synthèse: من وثائقي من عشر دقائق اكتب خمس جمل بلا نسخ حرفي.","سجّل commentating من 40 ثانية: la scène، la cause، la conséquence، ثم la conclusion."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: تتبّعنا la narration du documentaire مع les connecteurs de cause et de conséquence (parce que, c’est pourquoi, ce qui fait que) و la reformulation (c’est-à-dire, autrement dit, à savoir). أعد مشاهدة الفيديو الرئيسي وركّز على le changement de voix بين la narration et les extraits.","جسر الدروس: من b2-t8-l2 (الاستماع إلى البودكاست بلا نص) إلى b2-t8-l3 (تتبّع الوثائقي الصوتي الطويل)، ثم إلى b2-t8-l4 حيث ننتقل من la parole documentée إلى le texte théâtral مع l’impératif et la ligne de tension.","مهمة تطبيقية: استمع إلى وثائقي خمس دقائق ثم سجّل synthèse من دقيقة واحدة في خمس جمل، واكتب ثلاث كلمات جديدة من الدرس واستعملها في ثلاث جمل، ثم قارن تركيزك بالفيديو الرئيسي بـ « La vidéo distingue…, moi je note… »."]}],"pron":[{"w":"le documentaire","ipa":"[lə dɔ.ky.mɑ̃.tɛːʁ]","approx":"لو دوكيمانتير"},{"w":"la voix off","ipa":"[la vwa ɔf]","approx":"لا فوا أوف"},{"w":"le commentaire","ipa":"[lə kɔ.mɑ̃.tɛːʁ]","approx":"لو كومانتير"}],"vocab":[{"fr":"le documentaire","ar":"العمل الوثائقي","pos":"nom","g":"m","exFr":"Ce documentaire dure cinquante minutes.","ipa":"","exAr":"يستمر هذا العمل الوثائقي خمسين دقيقة."},{"fr":"la musique d’ambiance","ar":"موسيقى الأجواء","pos":"nom","g":"f","exFr":"La musique d’ambiance prépare l’émotion.","ipa":"","exAr":"تُهيّئ موسيقى الأجواء للعاطفة."},{"fr":"la parole du narrateur","ar":"كلام الراوي المنطوق","pos":"nom","g":"f","exFr":"La parole du narrateur guide l’écoute.","ipa":"","exAr":"يوجّه كلام الراوي المنطوق الاستماع."},{"fr":"la déposition","ar":"إفادة الشاهد","pos":"nom","g":"f","exFr":"La déposition a été enregistrée.","ipa":"","exAr":"سُجِّلت الإفادة."},{"fr":"l’investigation","ar":"التحقيق المعمّق","pos":"nom","g":"f","exFr":"L’investigation a duré deux ans.","ipa":"","exAr":"استمر التحقيق المعمّق سنتين."},{"fr":"la halte","ar":"الوقفة/التوقف القصير","pos":"nom","g":"f","exFr":"L’extrait dure trois minutes.","ipa":"","exAr":"يستمر المقطع المختار ثلاث دقائق."},{"fr":"la narration","ar":"السرد","pos":"nom","g":"f","exFr":"La narration est linéaire.","ipa":"","exAr":"السرد خطي."},{"fr":"l’environnement sonore","ar":"البيئة الصوتية","pos":"nom","g":"m","exFr":"L’environnement sonore crée l’atmosphère.","ipa":"","exAr":"تصنع البيئة الصوتية الأجواء."},{"fr":"le bruit de fond","ar":"ضجيج الخلفية","pos":"nom","g":"m","exFr":"Le bruit de fond situe l’action.","ipa":"","exAr":"يحدّد ضجيج الخلفية مكان الحدث."},{"fr":"la trace","ar":"الأثر","pos":"nom","g":"f","exFr":"La trace du passé reste visible.","ipa":"","exAr":"يبقى أثر الماضي مرئياً."},{"fr":"le rite","ar":"الطقس/العادة الاجتماعية","pos":"nom","g":"m","exFr":"La trame suit trois étapes.","ipa":"","exAr":"تتبع البنية السردية ثلاث مراحل."},{"fr":"relier","ar":"يربط","pos":"verbe","g":"","exFr":"Il relie les faits au sens général.","ipa":"","exAr":"يربط الأحداث بالمعنى العام."}],"examples":[{"fr":"Tout a commencé un matin de mars.","ar":"كل شيء بدأ صباح شهر مارس.","note":"l’accroche"},{"fr":"La ville a grandi parce que le port a ouvert.","ar":"نمت المدينة لأن الميناء فُتح.","note":"la cause"},{"fr":"Le trafic augmente, ce qui fait que le centre s’étouffe.","ar":"يزداد الحركة، ونتيجة لذلك يختنق المركز.","note":"la conséquence"},{"fr":"D’après les enquêteurs, le dossier est clos.","ar":"حسب المحققين، أُغلق الملف.","note":"la preuve"},{"fr":"Autrement dit, rien n’a vraiment changé.","ar":"بعبارة أخرى، لم يتغير شيء حقاً.","note":"la reformulation"},{"fr":"La conclusion relie les faits au sens général.","ar":"ترتبط الخاتمة الأحداث بالمعنى العام.","note":"la structure"}],"grammar":[{"tFr":"Cause et conséquence : parce que, c’est pourquoi, ce qui fait que","tAr":"السبب والنتيجة في السرد الوثائقي","body":["parce que يربط la cause مباشرة، car أكثر رسمية، c’est pourquoi ينقل la conséquence إلى le début de la phrase، و ce qui fait que يضيف la conséquence comme une conséquence naturelle.","« de sorte que » + subjonctif يدخل في le registre soutenu: « Il a parlé de sorte que tout le monde ait compris. »"],"ex":[{"fr":"Le port a fermé, ce qui fait que la ville a décliné.","ar":"أُغلق الميناء، ونتيجة لذلك تراجعت المدينة."},{"fr":"Il a répété lentement, de sorte que chacun ait compris.","ar":"كرّر ببطء بحيث فهم كل واحد."}]},{"tFr":"La reformulation : c’est-à-dire, autrement dit, à savoir","tAr":"إعادة الصياغة في الشرح الوثائقي","body":["c’est-à-dire توضّح بنفس القدر، autrement dit تعطي صيغة أبسط، à savoir تضيف détail précis: « un problème local, à savoir le logement. »","هذا الثلاثي la clé للاستماع: كلما لم تفهم، انتظر la reformulation التالية."],"ex":[{"fr":"C’est-à-dire que le budget a été divisé par deux.","ar":"أي أن الميزانية قُسمت إلى نصفين."},{"fr":"Un problème local, à savoir le logement.","ar":"مشكلة محلية، وهو السكن بالتحديد."}]}],"mistakes":[{"wrong":"الاستماع للأجزاء مع la musique فقط","right":"التركيز على la voix off ثم le témoin","why":"la narration تأتي من le commentaire لا من la bande."},{"wrong":"كتابة la phrase كاملة","right":"les idées principales في كلمات مفتاحية","why":"la prise de notes الوثائقية تُلخّص لا تنسخ."},{"wrong":"عدم تدوين les connecteurs","right":"كتابة parce que / c’est pourquoi","why":"les connecteurs تكشف la logique du récit."},{"wrong":"إيقاف الاستماع عند كلمة مجهولة","right":"التوقّف عند la fin de la séquence","why":"la reformulation التالية غالباً ما تنقذك."}],"dialogues":[{"title":"مناقشة وثائقي","ctx":"طالبان بعد الاستماع","lines":[{"who":"Thomas","fr":"Tout a commencé un matin de mars, non ?","ar":"كل شيء بدأ صباح مارس، أليس كذلك؟"},{"who":"Nour","fr":"Oui, et la voix off a tout de suite expliqué pourquoi.","ar":"نعم، وشرح التعليق الصوتي السبب فوراً."},{"who":"Thomas","fr":"Ce qui fait que le port a fermé deux ans plus tard.","ar":"ونتيجة لذلك أُغلق الميناء بعد سنتين."},{"who":"Nour","fr":"Autrement dit, la ville a décliné.","ar":"بعبارة أخرى، تراجعت المدينة."}]},{"title":"انتقاد بنية الوثائقي","ctx":"نقاش في ورشة إذاعية","lines":[{"who":"Mentor","fr":"Votre sujet est bon, mais la méthode manque.","ar":"موضوعك جيد لكن الطريقة تغيب."},{"who":"Léa","fr":"Vous voulez dire qu’il manque l’enquête ?","ar":"تقصد أن التحقيق يغيب؟"},{"who":"Mentor","fr":"Exactement : à savoir les preuves et les témoins.","ar":"بالتحديد: الأدلة والشهود."},{"who":"Léa","fr":"D’accord, je réécris la narration ce soir.","ar":"موافق، سأعيد كتابة السرد الليلة."}]}],"exercises":[{"t":"mcq","skill":"listening","q":"من يقود la narration في le documentaire؟","opts":["la voix off","la musique","le silence","l’auditeur"],"a":0,"why":"le commentaire de la voix off يقود le récit."},{"t":"fill","skill":"grammar","q":"أكمل la conséquence: «Le port a fermé,___ le trafic a cessé.»","fr":"Le port a fermé, ___ le trafic a cessé.","ans":"c’est pourquoi","why":"c’est pourquoi تنقل la conséquence."},{"t":"mcq","skill":"vocabulary","q":"ما معنى « à savoir »؟","opts":["أي بالتحديد","من جانب آخر","قبل كل شيء","بدون شك"],"a":0,"why":"à savoir يضيف le détail précis."},{"t":"order","skill":"writing","q":"رتّب: كل شيء بدأ صباح شهر مارس","words":["Tout","a","commencé","un","matin","de","mars."],"ans":"Tout a commencé un matin de mars.","why":"l’accroche du récit."},{"t":"listen","skill":"listening","q":"ما la fonction de « Autrement dit… »؟","opts":["إعادة الصياغة بأسلوب أبسط","سبب","نفي","سؤال"],"a":0,"why":"autrement dit = reformulation."},{"t":"translate","skill":"writing","q":"ترجم: نتيجة لذلك اختنق المركز.","ans":"Ce qui fait que le centre s’étouffe.","why":"ce qui fait que + indicatif."},{"t":"speaking","skill":"speaking","q":"قدّم synthèse من وثائقي في خمس جمل: le sujet، la méthode، faits، conclusion.","target":"Tout a commencé… / Parce que… / Ce qui fait que… / Autrement dit… / La conclusion…","why":"la synthèse du documentaire."},{"t":"correct","skill":"grammar","q":"صحّح: «Le port a fermé, parce que le trafic a cessé, par conséquent la ville a décliné.»","ans":"Le port a fermé, ce qui fait que la ville a décliné.","why":"une seule conséquence naturelle suffit."}],"homework":"استمع إلى وثائقي صوتي فرنسي من 20 دقيقة، اكتب une synthèse من خمس جمل باستعمال parce que، ce qui fait que، c’est-à-dire ثم سجّل commentating من 40 ثانية.","sources":[{"title":"Angèle - La Loi de Murphy [OFFICIAL MUSIC VIDEO]","channel":"Angèle","videoId":"zGyThu7EAHQ","why":"français نقي مع narration بصرية واضحة — échauffement مثالي قبل le documentaire long: la voix، le rythme، puis la compréhension du fil.","cat":"Écoute","level":"B2","main":true},{"title":"L’Enfer des retours de Vacances !","channel":"Documentaire Société","videoId":"aFvgmZ46auk","why":"وثائقي طويل كامل — la structure الكاملة: accroche، enquête، témoignage، conclusion.","cat":"Écoute","level":"B2","extra":true},{"title":"École française : pourquoi les meilleurs élèves disparaissent","channel":"Le Figaro","videoId":"Wx44ERpK7nQ","why":"enquête commentée — la preuve والتحليل في la durée réelle.","cat":"Écoute","level":"B2","extra":true}],"supplements":[{"id":"aFvgmZ46auk","title":"L’Enfer des retours de Vacances !","channel":"Documentaire Société","why":"وثائقي طويل كامل — la structure الكاملة: accroche، enquête، témoignage، conclusion.","lang":"fr","dur":42},{"id":"Wx44ERpK7nQ","title":"École française : pourquoi les meilleurs élèves disparaissent","channel":"Le Figaro","why":"enquête commentée — la preuve والتحليل في la durée réelle.","lang":"fr","dur":13}]},{"id":"b2-t8-l4","fr":"Théâtre et monologues","ar":"المسرح والمونولوج","objectives":["تتبّع le fil d’un monologue: adresse, revendication, retournement, chute","التمييز بين le dialogue et le monologue في l’écoute","استعمال le lexique: la tirade, le réplique, l’interprète, la scène","إعادة أداء قصيرة من vingt secondes مع la bonne intonation"],"sections":[{"h":"الدرس 4: كيف تستمع إلى مونولوج مسرحي وتلتقط دلالته","video":{"id":"OWdNRcD4KSg","title":"Les grandes traditions de la culture française","channel":"Frenchecho","why":"عرض موجز عن la culture française يجمع le rythme de la chanson و la voix du récit — l’échauffement idéal avant le monologue théâtral.","lang":"fr","main":true,"dur":12},"p":["le monologue المسرحي ليس كلاماً مع le vide: هناك interlocuteur مخفي (le public، le partenaire، le miroir). la première مهمة في l’écoute هي تحديد le à qui — لأن la réponse تأتي غالباً في les silences.","معجم الدرس: la tirade, la réplique, l’interprète, la scène, le personnage, le hors-scène, l’adresse, la tension, le crescendo, le détachement, la chute, la réplique. هذه المفردات تقرأ بها la scène.","نحوياً، le théâtre يحب l’impératif (« Tais-toi ! »)، le présent d’action (« Je monte, j’ouvre, je regarde »)، et l’interjection (« Ah ! »). la phrase courte هي la respiration de la scène.","l’intonation تحمل le sens أكثر من les mots: la montée de la voix مع la surprise، la chute مع la résignation، et le silence مع la menace. le texte المكتوب لا يظهر le ton — فاستمع مرتين.","الدرس الأهم: le crescendo. le personnage يبدأ هادئاً ثم يتصاعد: la tension تُقاس بـ la vitesse et le volume. إن لم تسمع la montée، فلن تفهم la chute.","بعد الدرس: استمع إلى monologue من دقيقتين، ارسم la ligne de tension (هادئ ← متوتر ← ذروة)، ثم أعد أداء les trois phrases الأخيرة بـ votre intonation."],"sub":[{"h":"بنية le monologue","p":["L’adresse : à qui le personnage parle-t-il ?","La tension : la voix monte, puis se brise.","La chute : une phrase courte qui ferme la scène."]},{"h":"أدوات نطقية: la scène","p":["« Tais-toi ! » [tɛ twa] — l’impératif de la scène.","« Je monte, j’ouvre, je regarde… » — le présent d’action.","« Ah ! C’est toi. » — l’interjection qui dévoile."]},{"h":"خطوات Listen & Repeat","p":["المرة الأولى: اكتب le à qui.","الثانية: ارسم la ligne de tension.","الثالثة: أعد les trois phrases الأخيرة بصوتك."]}]},{"h":"expressions du théâtre","p":["« Tais-toi ! » = أنصت! — l’impératif le plus théâtral.","« Et si j’avais osé… » — l’hypothèse qui ouvre la tension.","« Tu ne comprends pas, n’est-ce pas ? » — la question qui accule.","« Voilà, c’est fini. » — la chute brève de toute scène."]},{"h":"التطبيق والتلخيص","p":["تمرين le à qui: استمع لثلاث دقائق وحدّد في كل جملة le destinataire المخفي.","تمرين la tension: ارسم la courbe puis حدّد le moment où la voix تتصاعد.","سجّل monologue من عشرين ثانية عن موقف مرهق مع la montée ثم la chute."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: حلّلنا le monologue عبر le à qui، la ligne de tension et la chute، مع le présent d’action et l’impératif et le rôle de l’intonation. أعد مشاهدة الفيديو الرئيسي وركّز على la montée de la voix et les silences avant la chute.","جسر الدروس: من b2-t8-l3 (تتبّع الوثائقي الصوتي الطويل) إلى b2-t8-l4 (التقاط دلالة المونولوج المسرحي)، ثم إلى b2-t8-l5 حيث ننتقل من la scène intime إلى la salle de conférence et la prise de parole devant un public.","مهمة تطبيقية: أعد أداء monologue من عشرين ثانية داخل دقيقة واحدة مع la montée puis la chute، واكتب ثلاث كلمات جديدة من الدرس واستعملها في ثلاث جمل، ثم قارن أداؤك بالفيديو الرئيسي بـ « La vidéo propose…, moi je joue… »."]}],"pron":[{"w":"la tirade","ipa":"[la ti.ʁad]","approx":"لا تيراد"},{"w":"l’interprète","ipa":"[lɛ̃.tɛʁ.pʁit]","approx":"لانترپريت"},{"w":"le crescendo","ipa":"[lə kʁɛʃ.ʃɛn.do]","approx":"لو كريشيندو"}],"vocab":[{"fr":"la tirade","ar":"الخطبة الطويلة","pos":"nom","g":"f","exFr":"Sa tirade dure trois minutes.","ipa":"[ti.ʁad]","exAr":"خطبته تدوم ثلاث دقائق."},{"fr":"la réplique","ar":"الردّ على الخشبة","pos":"nom","g":"f","exFr":"La réplique est cinglante.","ipa":"[re.plik]","exAr":"الردّ لاذع."},{"fr":"l’interprète","ar":"الممثّل","pos":"nom","g":"m","exFr":"L’interprète porte la scène.","ipa":"[ɛ̃.tɛʁ.pʁit]","exAr":"الممثّل يحمل المشهد."},{"fr":"le personnage","ar":"الشخصية","pos":"nom","g":"m","exFr":"Le personnage est double.","ipa":"[pɛʁ.sɔ.naʒ]","exAr":"الشخصية مزدوجة."},{"fr":"le hors-scène","ar":"ما وراء الخشبة","pos":"nom","g":"m","exFr":"Le hors-scène pèse sur la scène.","ipa":"[lɔʁ sɛn]","exAr":"ما وراء الخشبة يثقل المشهد."},{"fr":"la tension","ar":"التوتر","pos":"nom","g":"f","exFr":"La tension monte lentement.","ipa":"[tɑ̃.sjɔ̃]","exAr":"التوتر يتصاعد ببطء."},{"fr":"le crescendo","ar":"التصاعد الصوتي","pos":"nom","g":"m","exFr":"Le crescendo prépare la chute.","ipa":"[kʁɛʃ.ʃɛn.do]","exAr":"التصاعد يُهيّئ للخاتمة."},{"fr":"l’adresse","ar":"التوجّه المباشر","pos":"nom","g":"f","exFr":"L’adresse au public casse le quatrième mur.","ipa":"[a.dʁɛs]","exAr":"التوجّه للجمهور يكسر الجدار الرابع."},{"fr":"incarner","ar":"يجسّد الدور","pos":"verbe","g":"","exFr":"Elle incarne le rôle d’Antigone.","ipa":"[ɛ̃.kaʁ.ne]","exAr":"تجسّد دور أنطيجون."},{"fr":"réciter","ar":"يُلقي","pos":"verbe","g":"","exFr":"Il récite sans son rôle.","ipa":"[re.si.te]","exAr":"يلقي دون دوره."},{"fr":"marquer une pause","ar":"يترك وقفة","pos":"loc.","g":"","exFr":"Il marque une pause avant la chute.","ipa":"","exAr":"يترك وقفة قبل الخاتمة."},{"fr":"monter sur scène","ar":"يصعد إلى الخشبة","pos":"loc.","g":"","exFr":"Elle monte sur scène pour la première fois.","ipa":"","exAr":"تصعد إلى الخشبة لأول مرة."}],"examples":[{"fr":"Tais-toi, tu ne comprends rien.","ar":"أنصت، لا تفهم شيئاً.","note":"l’impératif"},{"fr":"Et si j’avais osé dire la vérité ?","ar":"ولو جرؤت على قول الحقيقة؟","note":"l’hypothèse"},{"fr":"Je monte, j’ouvre, je regarde… et je pars.","ar":"أصعد، أفتح، أنظر… ثم أرحل.","note":"le présent d’action"},{"fr":"Tu ne comprends pas, n’est-ce pas ?","ar":"أنت لا تفهم، أليس كذلك؟","note":"la question qui accule"},{"fr":"Voilà, c’est fini.","ar":"هذا هو، قد انتهى.","note":"la chute"},{"fr":"Sa tirade monte jusqu’à la rupture.","ar":"خطبته تتصاعد حتى الانقطاع.","note":"le crescendo"}],"grammar":[{"tFr":"Le présent d’action et l’impératif sur scène","tAr":"المضارع الحركي والأمر على الخشبة","body":["le théâtre يستعمل le présent d’action للأفعال المتتابعة: « Je monte, j’ouvre, je regarde. » — le présent يُلغي la distance ويضع le public في la scène.","l’impératif يحمل la tension: « Tais-toi ! », « Regarde-moi ! » — la phrase بلا فاعل تجعل le spectateur le destinataire المباشر."],"ex":[{"fr":"Je marche, je m’arrête, je regarde le ciel.","ar":"أمشي، أتوقف، أنظر إلى السماء."},{"fr":"Regarde-moi quand je te parle !","ar":"انظر إليّ عندما أتحدّث إليك!"}]},{"tFr":"L’intonation comme troisième texte","tAr":"النبرة كنص ثالث","body":["le texte المكتوب يعطي les mots، la ponctuation تعطي le rythme، و l’intonation تعطي le sens: la même phrase (« C’est toi. ») تصير اتهاماً أو اكتشافاً أو تهديداً حسب la voix.","la règle l’écoute: استمع أولاً بلا نص، ثم اقرأ النص، ثم أعد الاستماع — la troisième مرة تكشف les silences."],"ex":[{"fr":"« C’est toi. » — dit comme une accusation.","ar":"«إنه أنت.» — يُقال كاتهام."},{"fr":"« C’est toi. » — dit comme un soulagement.","ar":"«إنه أنت.» — يُقال كارتياح."}]}],"mistakes":[{"wrong":"la lecture du texte بلا نبرة","right":"l’écoute avant la lecture","why":"le théâtre يعيش في la voix لا في la page."},{"wrong":"التركيز على les mots فقط","right":"la ligne de tension + les silences","why":"la tension تكشف le sens المخفي."},{"wrong":"la voix الموحدة لكل les personnages","right":"la distinction par le rythme et le volume","why":"بدون la distinction تختفي la scène."},{"wrong":"la traduction immédiate","right":"la première écoute بلا قاموس","why":"la compréhension تأتي بالسياق أولاً."}],"dialogues":[{"title":"répétition","ctx":"مخرج مع ممثل","lines":[{"who":"Metteur","fr":"Ta réplique est juste, mais la tension manque.","ar":"ردّك سليم لكن التوتر ناقص."},{"who":"Acteur","fr":"Alors je monte le volume vers la fin ?","ar":"إذن أرفع الصوت نحو النهاية؟"},{"who":"Metteur","fr":"Oui : crescendo, puis une chute brève.","ar":"نعم: تصاعد، ثم خاتمة قصيرة."},{"who":"Acteur","fr":"Et une pause juste avant « voilà ».","ar":"وأترك وقفة قبل «voilà»."}]},{"title":"analyse d’un monologue","ctx":"ورشة استماع","lines":[{"who":"Claire","fr":"À qui parle le personnage au début ?","ar":"لمن تتحدّث الشخصية في البداية؟"},{"who":"Karim","fr":"Au public, je crois : il casse le quatrième mur.","ar":"للجمهور، أعتقد: يكسر الجدار الرابع."},{"who":"Claire","fr":"Et la tension monte avec « et si… ».","ar":"والتوتر يتصاعد مع «و لو…»."},{"who":"Karim","fr":"Exactement : le crescendo prépare la chute.","ar":"بالضبط: التصاعد يُهيّئ للخاتمة."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما معنى « la tirade »؟","opts":["الخطبة الطويلة","الردّ القصير","الصمت","الموسيقى"],"a":0,"why":"tirade = réplique longue et soutenue."},{"t":"fill","skill":"grammar","q":"أكمل: «___, tu ne comprends rien !»","fr":"___, tu ne comprends rien !","ans":"Tais-toi","why":"l’impératif de la scène."},{"t":"mcq","skill":"listening","q":"ما le premier geste في l’écoute d’un monologue ?","opts":["تحديد le à qui","كتابة les verbes","الترجمة","عدّ المفردات"],"a":0,"why":"l’interlocuteur المخفي يحدّد le sens."},{"t":"order","skill":"writing","q":"رتّب: هذا هو، قد انتهى","words":["Voilà,","c’est","fini."],"ans":"Voilà, c’est fini.","why":"la chute brève de la scène."},{"t":"listen","skill":"listening","q":"ما وظيفة « Et si… » في le monologue ?","opts":["فتح la tension par l’hypothèse","la chute","la description","la salutation"],"a":0,"why":"l’hypothèse تبدأ la montée."},{"t":"translate","skill":"writing","q":"ترجم: انظر إليّ عندما أتحدّث إليك!","ans":"Regarde-moi quand je te parle !","why":"l’impératif + le présent."},{"t":"speaking","skill":"speaking","q":"أعد أداء monologue من عشرين ثانية مع la montée ثم la chute.","target":"Et si… / Je monte… / Tu ne comprends pas… / Voilà, c’est fini.","why":"la ligne de tension."},{"t":"correct","skill":"listening","q":"صحّح: «Je lis la tirade avec la même voix tout le temps.»","ans":"Je lis la tirade avec un crescendo, puis une chute brève.","why":"la tension est le troisième texte."}],"homework":"استمع إلى monologue من دقيقتين، ارسم la ligne de tension ثم أعد أداء les trois phrases الأخيرة بصوتك — وسجّل نسختك وقارنها بالمصدر.","sources":[{"title":"Les grandes traditions de la culture française","channel":"Frenchecho","videoId":"OWdNRcD4KSg","why":"عرض موجز عن la culture française يجمع le rythme de la chanson و la voix du récit — l’échauffement idéal avant le monologue théâtral.","cat":"Écoute","level":"B2","main":true},{"title":"École française : le débat en scène","channel":"Le Figaro","videoId":"Wx44ERpK7nQ","why":"la parole publique comme scène : le même crescendo et la même chute.","cat":"Écoute","level":"B2","extra":true},{"title":"Documentaire : les voix de la société","channel":"Documentaire Société","videoId":"aFvgmZ46auk","why":"des voix multiples pour s’entraîner à distinguer les personnages.","cat":"Écoute","level":"B2","extra":true}],"supplements":[{"id":"Wx44ERpK7nQ","title":"École française : le débat en scène","channel":"Le Figaro","why":"la parole publique comme scène : le même crescendo et la même chute.","lang":"fr","dur":13},{"id":"aFvgmZ46auk","title":"Documentaire : les voix de la société","channel":"Documentaire Société","why":"des voix multiples pour s’entraîner à distinguer les personnages.","lang":"fr","dur":42}]},{"id":"b2-t8-l5","fr":"Conférences en français","ar":"المحاضرات بالفرنسية","objectives":["تتبّع la trame: annonce, plan, exemple, transition, conclusion","التمييز بين les parties: introduction, développement, question-réponse","استعمال le vocabulaire: l’animateur, l’intervenant, le diaporama","استخراج la thèse من عشرين دقيقة استماع بلا نص"],"sections":[{"h":"الدرس 6: كيف تتبع محاضرة فرنسية طويلة دون أن تفقد الخيط","video":{"id":"_VfSkJtvoXs","title":"Conférences : structurer et porter son exposé","channel":"Français Authentique","why":"شرح la structure de la conférence مع أمثلة من l’oral académique: l’annonce، les transitions، ثم la question-réponse.","lang":"fr","main":true,"dur":12},"p":["la conférence تُبنى على le contrat: في أول ثلاث دقائق يعلن le conférencier son plan — « Je vais d’abord…, puis…, enfin… ». إن فاتتك l’annonce فقدت le fil، وإن سمعتها فقدت le détail فقط.","معجم الدرس: la conférence, l’intervenant, l’animateur, le diaporama, l’annonce, la transition, l’exposé, la question, la réponse, l’audience, le débat, la synthèse. هذه المفردات هي la boussole de l’écoute.","نحوياً، la conférence تحمل les marqueurs d’oral: « Alors… », « Vous voyez… », « Autrement dit… ». la première صيغة تعطي le rythme و la الثانية تُعيد الربط مع le public.","attention إلى le vocabulaire technique المُعرَّف في le context: la conférencier يعرّفه غالباً بـ « c’est-à-dire… ». هذه la reformulation هي هديتك في l’écoute.","الدرس الأهم: la question-réponse تكشف la thèse الحقيقية. les questions تكشف ما لم يُقل، et la réponse تكشف le position réel de l’intervenant.","بعد الدرس: استمع إلى محاضرة من عشرين دقيقة، اكتب la trame بخمس عناوين، ثم استخرج la thèse في جملة واحدة."],"sub":[{"h":"la trame de la conférence","p":["Je vais d’abord présenter le contexte.","Puis j’analyserai deux cas concrets.","Enfin, je répondrai à vos questions."]},{"h":"أدوات نطقية: l’annonce","p":["« Alors, commençons par… » [a.laʁ kɔ.mɑ̃sɔ̃ pa] — le départ.","« Autrement dit… » — la reformulation qui sauve.","« Vous voyez ? » — le lien avec le public."]},{"h":"خطوات Listen & Repeat","p":["المرة الأولى: اكتب l’annonce فقط.","الثانية: حدّد les transitions.","الثالثة: استخرج la thèse من la conclusion."]}]},{"h":"expressions de la conférence","p":["« Je vais d’abord… puis… enfin… » — la promesse du plan.","« Autrement dit, cela signifie que… » — la reformulation.","« C’est-à-dire que le chiffre double. » — la précision.","« Pour conclure, je retiendrai deux points. » — la chute."]},{"h":"التطبيق والتلخيص","p":["تمرين l’annonce: استمع لخمس دقائق واكتب le plan المعلن في ثلاث جمل.","تمرين la transition: أشر إلى كل « alors », « autrement dit », « enfin » وحدّد موقعها في le plan.","سجّل مقدمة محاضرة من ثلاثين ثانية: l’accroche، l’annonce، ثم la première partie."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: بنينا la trame de la conférence: la promesse du plan بـ le futur simple، ثم les marqueurs oraux و la reformulation، وأخيراً la question-réponse، مع le vocabulaire de la salle (intervenant, animateur, diaporama). أعد مشاهدة الفيديو الرئيسي وركّز على les trois verbes du plan: présenter, analyser, répondre.","جسر الدروس: من b2-t8-l4 (التقاط دلالة المونولوج المسرحي) إلى b2-t8-l5 (تتبّع خيط المحاضرة الطويلة)، ثم إلى b2-t8-l6 حيث ننتقل من la parole académique إلى la bande-son du cinéma et la lecture des voix.","مهمة تطبيقية: سجّل مقدمة محاضرة من دقيقة واحدة: accroche، promesse du plan، puis première partie، واكتب ثلاث كلمات جديدة من الدرس واستعملها في ثلاث جمل، ثم قارن تقديمك بالفيديو الرئيسي بـ « La vidéo présente…, moi je commence par… »."]}],"pron":[{"w":"la conférence","ipa":"[la kɔ̃.fɛʁ.ɑ̃s]","approx":"لا كونفرنس"},{"w":"l’annonce","ipa":"[la.nɔ̃s]","approx":"لانونس"},{"w":"la transition","ipa":"[la tʁɑ̃.zi.sjɔ̃]","approx":"ترازيسسيون"}],"vocab":[{"fr":"la conférence","ar":"المحاضرة","pos":"nom","g":"f","exFr":"La conférence dure une heure.","ipa":"[kɔ̃.fɛʁ.ɑ̃s]","exAr":"المحاضرة تدوم ساعة."},{"fr":"l’intervenant","ar":"المتحدّث الضيف","pos":"nom","g":"m","exFr":"L’intervenant est spécialiste.","ipa":"[ɛ̃.tɛʁ.ve.nɑ̃]","exAr":"المتحدّث ضيف متخصص."},{"fr":"l’animateur","ar":"المقدّم / المنسّق","pos":"nom","g":"m","exFr":"L’animateur lance le débat.","ipa":"[a.ni.ma.tœʁ]","exAr":"المقدّم يُطلق النقاش."},{"fr":"le diaporama","ar":"العروض التقديمية","pos":"nom","g":"m","exFr":"Le diaporama aide l’audience.","ipa":"[djo.pɔ.ʁa.ma]","exAr":"العروض تساعد الجمهور."},{"fr":"l’avant-propos","ar":"الكلام الافتتاحي","pos":"nom","g":"m","exFr":"L’avant-propos présente le sujet.","ipa":"[a.vɑ̃ pʁɔ.pɔ]","exAr":"يقدّم الكلام الافتتاحي الموضوع."},{"fr":"l’articulation","ar":"الربط بين الأجزاء","pos":"nom","g":"f","exFr":"L’articulation des parties est fluide.","ipa":"[aʁ.ti.ky.la.sjɔ̃]","exAr":"ربط الأجزاء سلس."},{"fr":"le discours","ar":"الخطاب","pos":"nom","g":"m","exFr":"Le discours dure vingt minutes.","ipa":"[di.skɔʁ]","exAr":"يستمر الخطاب عشرين دقيقة."},{"fr":"l’assistance","ar":"الحاضرون","pos":"nom","g":"f","exFr":"L’assistance a applaudi à la fin.","ipa":"[a.si.stɑ̃s]","exAr":"تصفيّ الحاضرون في النهاية."},{"fr":"animer","ar":"ينسّق","pos":"verbe","g":"","exFr":"Elle anime le débat.","ipa":"[a.ni.me]","exAr":"تنسّق النقاش."},{"fr":"présenter","ar":"يُقدّم","pos":"verbe","g":"","exFr":"Il présente ses résultats.","ipa":"[pʁe.zɑ̃.te]","exAr":"يُقدّم نتائجه."},{"fr":"répondre à","ar":"يجيب عن","pos":"loc.","g":"","exFr":"Elle répond à la deuxième question.","ipa":"","exAr":"تجيب عن السؤال الثاني."},{"fr":"tirer une conclusion","ar":"يستخلص خاتمة","pos":"loc.","g":"","exFr":"Il tire une conclusion prudente.","ipa":"","exAr":"يستخلص خاتمة متحفظة."}],"examples":[{"fr":"Je vais d’abord présenter le contexte.","ar":"سأقدّم أولاً السياق.","note":"l’annonce"},{"fr":"Puis j’analyserai deux cas concrets.","ar":"ثم سأحلّل حالتين ملموستين.","note":"le plan"},{"fr":"Enfin, je répondrai à vos questions.","ar":"أخيراً، سأجيب عن أسئلتكم.","note":"la conclusion"},{"fr":"Autrement dit, le chiffre double en trois ans.","ar":"بعبارة أخرى، يتضاعف الرقم في ثلاث سنوات.","note":"la reformulation"},{"fr":"C’est-à-dire que l’effet est limité.","ar":"أي أن الأثر محدود.","note":"la précision"},{"fr":"Pour conclure, je retiendrai deux points.","ar":"خلاصة، سأُثبت نقطتين.","note":"la chute"}],"grammar":[{"tFr":"Le futur simple dans l’annonce du plan","tAr":"المستقبل البسيط في إعلان الخطة","body":["l’annonce du plan تستعمل le futur simple: « Je présenterai…, j’analyserai…, je répondrai… ». la promesse في le futur تجعل le public ينتظر — وتجعل l’écoute مركزاً.","la conclusion تستعمل le conditionnel: « Je retiendrai deux points. » — la prudence تعود مع la fin."],"ex":[{"fr":"Je présenterai le contexte, puis les résultats.","ar":"سأقدّم السياق، ثم النتائج."},{"fr":"Je retiendrai deux enseignements.","ar":"أستخلص درسين."}]},{"tFr":"Les reformulations : c’est-à-dire, autrement dit","tAr":"أدوات إعادة الصياغة في المحاضرة","body":["« c’est-à-dire » تُعرّف أو توضّح، « autrement dit » تعيد البناء بـ les mots آخرين. le conférencier يستعملهما حين يلاحظ la confusion في le public.","في l’écoute، هما la bouée: إن فهمت la reformulation فهمت le concept حتى لو فاتك le mot الأصلي."],"ex":[{"fr":"L’indice augmente, c’est-à-dire la situation se dégrade.","ar":"المؤشر يرتفع، أي أن الوضع يتدهور."},{"fr":"Autrement dit, le résultat reste fragile.","ar":"بعبارة أخرى، النتيجة تبقى هشّة."}]}],"mistakes":[{"wrong":"la note mot à mot من أول كلمة","right":"l’annonce ثم les grandes lignes","why":"la transcription الكاملة تُفقد la compréhension."},{"wrong":"la perte du plan","right":"« d’abord… puis… enfin… » كمرساة","why":"بدون le plan يصبح le détail عشوائياً."},{"wrong":"التركيز على le diaporama لا la voix","right":"les marqueurs oraux كـ la boussole","why":"la voix تحمل le sens و la progression."},{"wrong":"la traduction de chaque mot","right":"la reformulation كـ هدف","why":"le sens يأتي من la structure لا من le dictionnaire."}],"dialogues":[{"title":"قبل المحاضرة","ctx":"طالبان في قاعة","lines":[{"who":"Marc","fr":"As-tu noté l’annonce du plan ?","ar":"هل دوّنت إعلان الخطة؟"},{"who":"Nadia","fr":"Oui : d’abord le contexte, puis deux cas.","ar":"نعم: أولاً السياق، ثم حالتان."},{"who":"Marc","fr":"Et la thèse vient à la fin ?","ar":"والأطروحة تأتي في النهاية؟"},{"who":"Nadia","fr":"Oui, avec « pour conclure, je retiens… ».","ar":"نعم، مع «خلاصة، أُثبت…»."}]},{"title":"question-réponse","ctx":"بعد المحاضرة","lines":[{"who":"Public","fr":"Votre chiffre signifie-t-il une hausse ?","ar":"هل يعني رقمك ارتفاعاً؟"},{"who":"Conférencier","fr":"Autrement dit, oui : le chiffre double.","ar":"بعبارة أخرى، نعم: يتضاعف الرقم."},{"who":"Public","fr":"Et la limite de cette mesure ?","ar":"وحيد هذه القياس؟"},{"who":"Conférencier","fr":"La marge est de deux pour cent, prudence.","ar":"الهامش اثنان بالمائة، بهدوء."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما معنى « l’intervenant »؟","opts":["المتحدّث الضيف","الجمهور","العروض","المنسّق"],"a":0,"why":"l’intervenant هو من يتحدث في la conférence."},{"t":"fill","skill":"grammar","q":"أكمل بالfutur: «Puis j’___ deux cas concrets.»","fr":"Puis j’___ deux cas concrets.","ans":"analyserai","why":"l’annonce du plan بالfutur simple."},{"t":"mcq","skill":"listening","q":"ما la première chose à noter dans une conférence ؟","opts":["l’annonce du plan","tous les verbes","les chiffres","les noms propres"],"a":0,"why":"بدون le plan يفقد le reste قيمته."},{"t":"order","skill":"writing","q":"رتّب: أولاً السياق، ثم التحليل، أخيراً الأسئلة","words":["D’abord","le","contexte,","puis","l’analyse,","enfin","les","questions."],"ans":"D’abord le contexte, puis l’analyse, enfin les questions.","why":"la structure de l’annonce."},{"t":"listen","skill":"listening","q":"في la conférence، قال le conférencier « Autrement dit, le chiffre double. »: أي وظيفة لغوية يؤديها هنا ؟","opts":["la reformulation","la conclusion","l’accusation","la salutation"],"a":0,"why":"autrement dit تعيد البناء بـ les mots آخرين."},{"t":"translate","skill":"writing","q":"ترجم: بعبارة أخرى، يتضاعف الرقم في ثلاث سنوات.","ans":"Autrement dit, le chiffre double en trois ans.","why":"la reformulation."},{"t":"speaking","skill":"speaking","q":"سجّل مقدمة محاضرة من ثلاثين ثانية: accroche، annonce، première partie.","target":"Aujourd’hui je vais… / D’abord… / Puis… / Enfin…","why":"la promesse du plan."},{"t":"correct","skill":"listening","q":"صحّح: «Je note chaque mot dès la première minute.»","ans":"Je note l’annonce du plan, puis les grandes lignes.","why":"l’écoute stratégique avant la transcription."}],"homework":"استمع إلى محاضرة فرنسية من عشرين دقيقة: اكتب la trame بخمس عناوين، استخرج la thèse في جملة، ثم سجّل سؤالاً واحداً كنت ستطرحه.","sources":[{"title":"Conférences : structurer et porter son exposé","channel":"Français Authentique","videoId":"_VfSkJtvoXs","why":"شرح la structure de la conférence مع أمثلة من l’oral académique: l’annonce، les transitions، ثم la question-réponse.","cat":"Écoute","level":"B2","main":true},{"title":"Les grandes traditions de la culture française","channel":"Frenchecho","videoId":"OWdNRcD4KSg","why":"une voix pédagogique claire : l’échauffement avant la conférence longue.","cat":"Écoute","level":"B2","extra":true},{"title":"La France et l’Europe : une histoire commune","channel":"France Culture","videoId":"BkNki_64PCU","why":"une conférence réelle : l’annonce، les transitions، ثم la question-réponse.","cat":"Écoute","level":"B2","extra":true}],"supplements":[{"id":"OWdNRcD4KSg","title":"Les grandes traditions de la culture française","channel":"Frenchecho","why":"une voix pédagogique claire : l’échauffement avant la conférence longue.","lang":"fr","dur":12},{"id":"BkNki_64PCU","title":"La France et l’Europe : une histoire commune","channel":"France Culture","why":"une conférence réelle : l’annonce، les transitions، ثم la question-réponse.","lang":"fr","dur":20}]},{"id":"b2-t8-l6","fr":"Films et bandes-son","ar":"الأفلام والموسيقى التصويرية","objectives":["تحليل la bande-son الفرنسية: la musique، la dialogue، la silence","فهم la nuance la voix: émotion، ironie، tension","تمييز la langue du cinéma عن la langue quotidienne","ربط la musique avec la scène la compréhension"],"sections":[{"h":"الدرس 6: الاستماع إلى الأفلام الفرنسية وموسيقاها","video":{"id":"Hi7Nm3JSXag","title":"Le développement de l’argumentation","channel":"Français Authentique","why":"تحليل la bande-son الفرنسية: كيف تُستخدم la musique la dialogue la cinéma — la compréhension la nuance.","lang":"fr","main":true,"dur":12},"p":["la bande-son الفرنسية ليست مجرد la musique — elle raconte la histoire. la dialogue يحمل la nuance، la silence يحمل la tension، ثم la musique تكشف la émotion la cachée. la compréhension la niveau B2 تشمل la lecture la voix.","المفردات essentielles: la bande-son, la musique, le dialogue, le silence, la tension, l’émotion, la scène, le personnage, la nuance, la voix. هذه المفردات تفتح la porte la cinéma français.","نحوياً، تظهر la narration la cinéma: « Il était une fois… »، « La scène suivante… »، « Le personnage se demande… ». la structure la récit cinématographique.","الدرس الأهم: la compréhension la cinéma لا تتطلب la traduction — elle demande la lecture la contexte. la musique، la voix، la silence — كلها la langue.","بعد الدرس، شاهد مشهداً فرنسياً بلا ترجمة وحاول وصف la nuance la voix: émotion، ironie، tension."],"sub":[{"h":"la bande-son la cinéma","p":["La musique raconte l’émotion.","Le dialogue porte la nuance.","Le silence crée la tension.","La voix révèle le personnage."]},{"h":"أدوات نطقية: la voix","p":["« la bande-son » [la bɑ̃d sɔ̃] — liaison.","« la tension » [la tɑ̃.sjɔ̃] — nasal.","« la nuance » [la ny.ɑ̃s] — clair."]},{"h":"خطوات Listen & Repeat","p":["المرة الأولى: استمع للموسيقى فقط.","الثانية: استمع للحوار بلا موسيقى.","الثالثة: اجمعهما وحلّل la nuance."]}]},{"h":"عبارات la تحليل","p":["« La musique évoque la tristesse. » — la relation la musique l’émotion.","« Le dialogue est chargé de sous-entendus. » — la nuance la langue.","« Le silence est lourd. » — la tension la silence.","« La voix du personnage révèle sa peur. » — la lecture la voix."]},{"h":"التطبيق والتلخيص","p":["تمرين la lecture: شاهد مشهداً وصف la nuance la voix: émotion، ironie، tension.","تمرين la bande-son: حلّل la musique la مشهد: tristesse، joie، tension.","سجّل نفسك تصف فيلماً فرنسياً: la scène، la musique، la nuance — بالفرنسية."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: قرأنا la bande-son كـ langue: la musique تحكي l’émotion، le dialogue يحمل le sous-entendu، والصمت يصنع le suspense، مع la lecture de la diction (émotion, ironie, recul). أعد مشاهدة الفيديو الرئيسي وركّز على le passage entre la musique et le dialogue.","جسر الدروس: من b2-t8-l5 (تتبّع خيط المحاضرة الطويلة) إلى b2-t8-l6 (تحليل موسيقى الأفلام وصوتها)، ثم إلى b2-t9-l1 حيث ننتقل من la bande-son إلى le texte écrit مع Le Petit Prince et la lecture à voix haute.","مهمة تطبيقية: شاهد مشهداً فرنسياً ثم سجّل نفسك دقيقة واحدة تصف فيها la scène et la musique، واكتب ثلاث كلمات جديدة من الدرس واستعملها في ثلاث جمل، ثم قارن قراءتك بالفيديو الرئيسي بـ « La vidéo évoque…, moi je relève… »."]}],"pron":[{"w":"la bande-son","ipa":"[la bɑ̃d sɔ̃]","approx":"لا باند سون"},{"w":"la tension","ipa":"[la tɑ̃.sjɔ̃]","approx":"لا تانسيون"},{"w":"la nuance","ipa":"[la ny.ɑ̃s]","approx":"لا نيانس"}],"vocab":[{"fr":"la bande-son","ar":"la الموسيقى التصويرية","pos":"nom","g":"f","exFr":"La bande-son est magnifique.","ipa":"","exAr":"la الموسيقى التصويرية رائعة."},{"fr":"la musique","ar":"la الموسيقى","pos":"nom","g":"f","exFr":"La musique raconte l’émotion.","ipa":"","exAr":"la الموسيقى تحكي la émotion."},{"fr":"le dialogue","ar":"la الحوار","pos":"nom","g":"m","exFr":"Le dialogue est chargé de sous-entendus.","ipa":"","exAr":"la الحوار مشحون بالإيحاءات."},{"fr":"la pause muette","ar":"الوقفة الصامتة","pos":"nom","g":"f","exFr":"La pause muette retient l’attention.","ipa":"","exAr":"تُمسك الوقفة الصامتة الانتباه."},{"fr":"le suspense","ar":"التشويق","pos":"nom","g":"m","exFr":"Le suspense tient jusqu’au dernier plan.","ipa":"","exAr":"يستمر التشويق حتى اللقطة الأخيرة."},{"fr":"l’émotion","ar":"la العاطفة","pos":"nom","g":"f","exFr":"L’émotion est palpable.","ipa":"","exAr":"la العاطفة ملموسة."},{"fr":"la scène","ar":"la المشهد","pos":"nom","g":"f","exFr":"La scène est bouleversante.","ipa":"","exAr":"la المشهد موجع."},{"fr":"le protagoniste","ar":"بطل القصة","pos":"nom","g":"m","exFr":"Le protagoniste change tout au long du film.","ipa":"","exAr":"يتغيّر بطل القصة طوال الفيلم."},{"fr":"le non-dit","ar":"ما لا يُقال","pos":"nom","g":"m","exFr":"Le non-dit pèse sur la scène.","ipa":"","exAr":"يثقل ما لا يُقال المشهد."},{"fr":"la diction","ar":"طريقة النطق","pos":"nom","g":"f","exFr":"La diction révèle la formation de l’acteur.","ipa":"","exAr":"تكشف طريقة النطق تدريب الممثّل."},{"fr":"le sous-entendu","ar":"la الإيحاء","pos":"nom","g":"m","exFr":"Le sous-entendu est clair.","ipa":"","exAr":"la الإيحاء واضح."},{"fr":"raconter","ar":"يحكي","pos":"verbe","g":"","exFr":"La musique raconte une histoire.","ipa":"","exAr":"la الموسيقى تحكي قصة."}],"examples":[{"fr":"La musique raconte l’émotion.","ar":"la الموسيقى تحكي la العاطفة.","note":"la relation"},{"fr":"Le dialogue est chargé de sous-entendus.","ar":"la الحوار مشحون بالإيحاءات.","note":"la nuance"},{"fr":"Le silence est lourd.","ar":"la الصمت ثقيل.","note":"la tension"},{"fr":"La voix du personnage révèle sa peur.","ar":"la الصوت يكشف خوف الشخصية.","note":"la lecture"},{"fr":"La scène suivante montre la résolution.","ar":"la المشهد التالي يظهر la حل.","note":"la structure"},{"fr":"La bande-son évoque la tristesse.","ar":"la الموسيقى توقّع la حزن.","note":"la émotion"}],"grammar":[{"tFr":"La narration cinématographique","tAr":"la السرد السينمائي","body":["« Il était une fois… »، « La scène suivante… »، « Le personnage se demande… » — la structure la récit cinématographique.","« La musique évoque… » — la relation la musique l’émotion la description."],"ex":[{"fr":"La scène suivante montre la résolution.","ar":"la المشهد التالي يظهر la حل."},{"fr":"La musique évoque la tristesse.","ar":"la الموسيقى توقّع la حزن."}]},{"tFr":"La lecture la voix : émotion, ironie, tension","tAr":"la قراءة la صوت: العاطفة، السخرية، التوتر","body":["« La voix est tremblante » la peur، « La voix est ironique » la سخرية، « La voix est tendue » la توتر.","la compréhension la cinéma تتطلب la lecture la voix لا la lecture la mots فقط."],"ex":[{"fr":"Sa voix est tremblante : il a peur.","ar":"صوته يرتجف: هو خائف."},{"fr":"Le ton est ironique : il ne croit pas.","ar":"النبرة ساخرة: هو لا يصدق."}]}],"mistakes":[{"wrong":"la compréhension la mots فقط","right":"la lecture la voix la nuance","why":"la cinéma la langue la voix."},{"wrong":"la traduction la كل كلمة","right":"la compréhension la contexte","why":"la musique la silence la langue."},{"wrong":"la lecture la musique la dialogue","right":"la distinction la deux la bande-son","why":"la musique la dialogue la langue مختلفة."},{"wrong":"la peur la cinéma français","right":"la curiosité la nuance","why":"la cinéma la porte la culture."}],"dialogues":[{"title":"la تحليل","ctx":"أصدقاء يحلّلان فيلماً","lines":[{"who":"Marc","fr":"La bande-son évoque la tristesse.","ar":"la الموسيقى توقّع la حزن."},{"who":"Nadia","fr":"Le dialogue est chargé de sous-entendus.","ar":"la الحوار مشحون بالإيحاءات."},{"who":"Marc","fr":"La voix du personnage révèle sa peur.","ar":"la الصوت يكشف خوف الشخصية."},{"who":"Nadia","fr":"Oui, la tension est palpable.","ar":"نعم، la التوتر ملموس."}]},{"title":"la réaction","ctx":"مناقشة la scène","lines":[{"who":"Marc","fr":"La scène suivante montre la résolution.","ar":"la المشهد التالي يظهر la حل."},{"who":"Nadia","fr":"La musique change : la joie arrive.","ar":"la الموسيقى تتغير: la فرح يحل."},{"who":"Marc","fr":"La voix est plus claire.","ar":"la الصوت أوضح."},{"who":"Nadia","fr":"Voilà, la nuance est bien rendue.","ar":"هكذا، la الفرق الدقيق مُقدَّم جيداً."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما معنى « la bande-son »؟","opts":["la الموسيقى التصويرية","la الحوار","la الصمت","la العاطفة"],"a":0,"why":"bande-son = الموسيقى التصويرية."},{"t":"fill","skill":"grammar","q":"أكمل: «La musique ___ l’émotion.»","fr":"La musique ___ l’émotion.","ans":"raconte","why":"la narration la musique."},{"t":"mcq","skill":"listening","q":"ما la lecture la voix la peur؟","opts":["La voix est tremblante.","La voix est ironique.","La voix est calme.","La voix est forte."],"a":0,"why":"la tremblement la peur."},{"t":"order","skill":"writing","q":"رتّب: la الموسيقى تحكي la العاطفة","words":["La","musique","raconte","l’émotion."],"ans":"La musique raconte l’émotion.","why":"la narration."},{"t":"listen","skill":"listening","q":"ما la tension في la scène؟","opts":["Le silence est lourd.","La musique est joie.","Le dialogue est clair.","La voix est calme."],"a":0,"why":"la silence la tension."},{"t":"translate","skill":"writing","q":"ترجم: الصوت يكشف خوف الشخصية.","ans":"La voix du personnage révèle sa peur.","why":"la lecture la voix."},{"t":"speaking","skill":"speaking","q":"صف فيلماً فرنسياً: la scène، la musique، la nuance — 30 ثانية.","target":"La scène… / La musique… / La voix…","why":"la تحليل la bande-son."},{"t":"correct","skill":"grammar","q":"صحّح: «La musique dit l’émotion.»","ans":"La musique raconte l’émotion.","why":"raconter la narration."}],"homework":"شاهد مشهداً فرنسياً بلا ترجمة، حلّل la bande-son: la musique، la dialogue، la nuance — ثم اكتب فقرة من خمس جمل.","sources":[{"title":"Le développement de l’argumentation","channel":"Français Authentique","videoId":"Hi7Nm3JSXag","why":"تحليل la bande-son الفرنسية: كيف تُستخدم la musique la dialogue la cinéma — la compréhension la nuance.","cat":"Écoute","level":"B2","main":true},{"title":"🎵 MON VILLAGE NATAL | Chanson française – Niveau B2 🇫🇷","channel":"Français avec Natives","videoId":"OWdNRcD4KSg","why":"أغنية B2 — la تحليل la paroles la musique.","cat":"Écoute","level":"B2","extra":true},{"title":"Avantages et inconvénients","channel":"Français Authentique","videoId":"_VfSkJtvoXs","why":"محادثة طبيعية — la تحليل la voix la nuance.","cat":"Écoute","level":"B2","extra":true}],"supplements":[{"id":"OWdNRcD4KSg","title":"🎵 MON VILLAGE NATAL | Chanson française – Niveau B2 🇫🇷","channel":"Français avec Natives","why":"أغنية B2 — la تحليل la paroles la musique.","lang":"fr","dur":4},{"id":"_VfSkJtvoXs","title":"Avantages et inconvénients","channel":"Français Authentique","why":"محادثة طبيعية — la تحليل la voix la nuance.","lang":"fr","dur":12}]}]},{"id":"b2-t9","slug":"histoires-du-monde","icon":"mic","color":"#ef6c00","fr":"Histoires du monde","ar":"القصص العالمية","desc":"15 قصصاً كلاسيكية من العالم كله تُروى بالفرنسية: les contes de Perrault، les fables، les Mille et Une Nuits، les classiques européens — la fiction comme professeur.","lessons":[{"id":"b2-t9-l1","fr":"Le Petit Prince — le conte philosophique","ar":"الأمير الصغير — الحكاية الفلسفية","objectives":["تمييز l’imparfait (le décor, les habitudes) عن le passé simple (l’événement décisif) في le récit du conte","_acquire 12 كلمة أساسية حول la rose, le renard, l’apprivoisement, la responsabilité, le cœur","تحليل la morale de chaque rencontre: les planètes, le renard, le serpent — l’essentiel est invisible pour les yeux","تفسير لماذا يُصنَّف «Le Petit Prince» كـ conte philosophique لا كـ roman d’aventures"],"sections":[{"h":"الدرس 1: تحليل «الأمير الصغير» بوصفه حكاية فلسفية","video":{"id":"evrB68eOU5E","title":"Résumé et Analyse du Petit Prince d’Antoine de Saint-Exupéry","channel":"Rémi El Profesor","why":"تحليل مدرسي منظم لـ le conte: la structure du récit، la rose et le renard، ثم la phrase centrale « On ne voit bien qu’avec le cœur » — يمهّد مباشرة لتحليل le récit et ses leçons.","lang":"fr","main":true,"dur":16},"p":["«Le Petit Prince» ليس مجرد قصة أطفال، بل conte philosophique يطرح أسئلة وجودية بلغة بسيطة: لماذا يرى الكبار الأرقام فقط؟ ما معنى أن تصبح مسؤولًا عمّا أصْبَتَ إليه قلبك؟ le récit يبدأ في الصحراء حيث يقع الطيار عاجزًا عن إصلاح طائرته، وهنا يبدأ حوارٌ طويل مع الأمير الصغير.","المفردات المحورية في هذا الدرس: la rose (الوردة)، le renard (الثعلب)، apprivoiser (يروّض)، la responsabilité (المسؤولية)، le cœur (القلب)، le désert (الصحراء)، le baobab (البوباب)، la planète (الكوكب)، l’essentiel (الجوهري)، la confiance (الثقة)، se souvenir (يتذكّر)، les grandes personnes (الكبار).","نحوياً، لاحظ كيف ينتقل Saint-Exupéry بين l’imparfait et le passé simple: l’imparfait يرسم la situation et l’habitude (« Le Petit Prince dessinait chaque jour… »)، ثم le passé simple يقطع الوصف بالحدث (« un jour, il planta… »). هذا التناوب هو ما يمنح le récit إيقاعه الهادئ مع لحظات حاسمة.","le récit est aussi un parcours d’apprentissage: كل كوكب يساوي درساً (le roi, le vaniteux, l’ivrogne, l’homme d’affaires, l’allumeur, le géographe). la morale de ces rencontres: les grandes personnes n’écoutent jamais elles-mêmes — elles manquent de temps et de compréhension.","بعد الدرس، أعد الاستماع إلى la scène du renard بدون sous-titres، ثم دوّن les cinq étapes de l’apprivoisement (استفسار، s’asseoir, un peu de patience, le rituel, les liens) — la tâche الأولى هي la reconnaissance avant la reproduction.","خُلاصة الدرس: le message de Saint-Exupéry يُختصر في جملة واحدة — « On ne voit bien qu’avec le cœur. » la rose صارت مهمة لأن الأمير وقّت وقته لها، والدرس أن la valeur تأتي من le temps et l’attention لا من la rareté وحدها."],"sub":[{"h":"les mots du cœur","p":["« On ne voit bien qu’avec le cœur. »","« L’essentiel est invisible pour les yeux. »","« Tu deviens responsable pour toujours de ce que tu as apprivoisé. »"]},{"h":"le récit et ses temps","p":["l’imparfait: « Le Petit Prince dessinait… »","le passé simple: « Le renard apparut. »","L’alternance donne le rythme du conte."]},{"h":"le vocabulaire de la rencontre","p":["apprivoiser — يروّض","le renard — الثعلب","la rose — الوردة"]}]},{"h":"les phrases clés du conte","p":["« On ne voit bien qu’avec le cœur. » — la phrase qui résume tout le conte: la vérité n’est pas visible.","« Tu deviens responsable pour toujours de ce que tu as apprivoisé. » — la morale de la rencontre avec le renard.","« C’est le temps que tu as perdu pour ta rose qui fait ta rose si importante. » — l’amitié se mesure au temps donné.","« Toutes les grandes personnes ont d’abord été des enfants, mais peu d’entre elles s’en souviennent. » — l’appel à l’enfant intérieur."]},{"h":"التطبيق والتلخيص","p":["تمرين la réécoute: شغّل la scène du renard بدون sous-titres ثم اكتب la séquence de l’apprivoisement في خمس خطوات قصيرة.","تمرين la comparaison: اختر لقاءً واحداً من les planètes واكتب 60 كلمة تشرح la leçon qu’il enseigne.","اكتب paragraphe de 90 mots بالفرنسية تشرح فيه لماذا « l’essentiel est invisible » في حياتك اليومية — مع 4 مفردات من la leçon."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: «Le Petit Prince» conte philosophique يحوّل أسئلة الوجود إلى حكاية بسيطة: اللقاء مع le renard يعلّمنا أن la responsabilité تُبنى على le temps et l’attention، وأن « l’essentiel est invisible pour les yeux ». أعد مشاهدة الفيديو الرئيسي وركّز على تبديل l’imparfait في وصف le décor مع le passé simple في لحظة « Le renard apparut ».","جسر الدروس: من b2-t8-l6 (الأفلام والموسيقى التصويرية) إلى b2-t9-l1 (الأمير الصغير — الحكاية الفلسفية)، ثم إلى b2-t9-l2 حيث نستخرج la morale من فابلة «Le Corbeau et la Renard» عبر l’allégorie animale et la versification.","مهمة تطبيقية: أعد سرد لقاء الأمير مع le renard في دقيقة واحدة مع تسجيل صوتك، ثم استخرج 3 كلمات جديدة من الدرس واكتب بها جملتين، وأخيراً قارن روايتك بالفيديو الرئيسي وحدّد فرقاً واحداً في ترتيب les cinq étapes de l’apprivoisement."]}],"pron":[{"w":"apprivoiser","ipa":"[apʁuvwaze]","approx":"أبروفيزيه"},{"w":"le renard","ipa":"[lə ʁənɑʁ]","approx":"ل رُنار"},{"w":"le cœur","ipa":"[lə kœʁ]","approx":"ل كور"}],"vocab":[{"fr":"la rose","ar":"الوردة","pos":"nom","g":"f","exFr":"La rose du Petit Prince réclame qu’on s’en occupe.","ipa":"[ʁoz]","exAr":"وردة الأمير الصغير تطالب بأن يعتنوا بها."},{"fr":"le renard","ar":"الثعلب","pos":"nom","g":"m","exFr":"Le renard apprivoise le Petit Prince peu à peu.","ipa":"[ʁənɑʁ]","exAr":"الثعلب يروّض الأمير الصغير شيئًا فشيئًا."},{"fr":"apprivoiser","ar":"يروّض ويؤلف","pos":"verbe","g":"","exFr":"Pour apprivoiser, il faut d’abord s’asseoir un peu plus près.","ipa":"[apʁuvwaze]","exAr":"للترويض يجب أولاً أن تجلس أقرب قليلاً."},{"fr":"la responsabilité","ar":"المسؤولية","pos":"nom","g":"f","exFr":"On reste responsable de ce qu’on a apprivoisé.","ipa":"[ʁɛsɔ̃sabilite]","exAr":"يبقى المرء مسؤولًا عمّا روّضه."},{"fr":"le cœur","ar":"القلب","pos":"nom","g":"m","exFr":"On ne voit bien qu’avec le cœur.","ipa":"[kœʁ]","exAr":"لا نرى جيداً إلا بالقلب."},{"fr":"la tendresse","ar":"الحنان","pos":"nom","g":"f","exFr":"La tendresse que le Petit Prince donne à sa rose change tout.","ipa":"[tɑ̃dʁɛs]","exAr":"الحنان الذي يمنحه الأمير الصغير لوردته يغيّر كل شيء."},{"fr":"la confiance","ar":"الثقة","pos":"nom","g":"f","exFr":"Il faut de la confiance avant d’aller plus loin.","ipa":"[kɔ̃fjɑ̃s]","exAr":"يلزم الثقة قبل الذهاب أبعد."},{"fr":"le baobab","ar":"شجرة البوباب","pos":"nom","g":"m","exFr":"Les jeunes baobabs menacent la petite planète.","ipa":"[baɔbab]","exAr":"أشجار البوباب الصغيرة تهدد الكوكب الصغير."},{"fr":"la planète","ar":"الكوكب","pos":"nom","g":"f","exFr":"Chaque planète révèle un défaut des grandes personnes.","ipa":"[planɛt]","exAr":"كل كوكب يكشف نقصاً في الكبار."},{"fr":"le désert","ar":"الصحراء","pos":"nom","g":"m","exFr":"Le pilote atterrit au milieu du désert.","ipa":"[dezɛʁ]","exAr":"حلق الطيار في وسط الصحراء."},{"fr":"se souvenir","ar":"يتذكّر","pos":"verbe","g":"","exFr":"Je me souviens de la fleur que j’ai rencontrée.","ipa":"[sə suvenir]","exAr":"أتذكر الزهرة التي قابلتها."},{"fr":"les grandes personnes","ar":"الكبار","pos":"loc.","g":"","exFr":"Les grandes personnes aiment les chiffres et les calculs.","ipa":"","exAr":"الكبار يحبون الأرقام والحسابات."}],"examples":[{"fr":"On ne voit bien qu’avec le cœur.","ar":"لا نرى جيداً إلا بالقلب.","note":"la morale du conte"},{"fr":"Le Petit Prince vivait seul sur sa planète.","ar":"عاش الأمير الصغير وحده على كوكبه.","note":"l’imparfait du décor"},{"fr":"Un jour, il planta un baobab.","ar":"زرع يوماً شجرة بوباب.","note":"le passé simple du récit"},{"fr":"Je suis responsable de la rose que j’ai apprivoisée.","ar":"أنا مسؤول عن الوردة التي روّضتها.","note":"la leçon du renard"},{"fr":"Les grandes personnes n’écoutent jamais.","ar":"الكبار لا يستمعون أبداً.","note":"la critique de Saint-Exupéry"},{"fr":"C’est le temps perdu qui fait la rose importante.","ar":"الوقت الضائع هو ما يجعل الوردة مهمة.","note":"le lien entre temps et valeur"}],"grammar":[{"tFr":"Les temps du récit: l’imparfait et le passé simple","tAr":"أزمنة السرد: الوصف في المضارع التام والحدث في الماضي البسيط","body":["l’imparfait peint le décor, l’habitude, l’action en cours: « Le Petit Prince dessinait chaque jour… », tandis que le passé simple marque l’événement qui fait avancer l’histoire: « Le renard apparut un matin. »","dans un conte, l’alternance est régulière: la description reste à l’imparfait, l’événement ponctuel passe au passé simple — c’est ce contraste qui donne au récit sa respiration."],"ex":[{"fr":"Le renard était assis dans l’herbe quand le Petit Prince le vit.","ar":"كان الثعلب جالساً في العشب حين رآه الأمير الصغير."},{"fr":"Chaque jour, le Petit Prince parlait à sa rose.","ar":"كل يوم كان الأمير الصغير يتحدث إلى وردته."}]},{"tFr":"L’hypothèse avec « si » et le conditionnel","tAr":"الشرط باستخدام «si» والفعل الشرطي","body":["Saint-Exupéry pose des conditions avec « si » + présent et en tire une conséquence: « Si tu m’apprivoises, nous aurons besoin l’un de l’autre. » — la phrase devient une promesse.","règle B2: après « si », on ne met jamais le conditionnel — on utilise l’indicatif (présent ou imparfait); la faute la plus fréquente des apprenants."],"ex":[{"fr":"Si tu m’apprivoises, nous aurons besoin l’un de l’autre.","ar":"إن روّضتني فسنحتاج بعضنا إلى بعض."},{"fr":"Si on n’écoute pas, on ne comprend jamais l’essentiel.","ar":"إن لم نستمع فلن نفهم الجوهر أبداً."}]}],"mistakes":[{"wrong":"croire que le conte est seulement pour les enfants","right":"reconnaître le conte philosophique","why":"rose, renard et désert portent une réflexion sur l’amitié et le regard."},{"wrong":"tout raconter à l’imparfait","right":"alterner imparfait et passé simple","why":"le décor est à l’imparfait, l’événement au passé simple."},{"wrong":"traduire « apprivoiser » par « capturer un animal »","right":"apprivoiser = créer un lien progressif","why":"pour le renard, apprivoiser signifie rituel, patience et confiance."},{"wrong":"dire « si tu aurais le temps… »","right":"si tu avais le temps…","why":"après « si », jamais de conditionnel: on emploie l’imparfait de l’indicatif."}],"dialogues":[{"title":"la rencontre avec le renard","ctx":"le renard explique l’apprivoisement","lines":[{"who":"Le renard","fr":"Qui es-tu ? Tu es très joli.","ar":"من أنت؟ أنت جميل جداً."},{"who":"Le Petit Prince","fr":"Je suis un Petit Prince, j’habite une autre planète.","ar":"أنا أمير صغير، أسكن كوكباً آخر."},{"who":"Le renard","fr":"Il faut de la patience : on s’asseoit un peu plus près chaque jour.","ar":"يلزم الصبر: نجلس كل يوم أقرب قليلاً."},{"who":"Le Petit Prince","fr":"Mais je n’ai pas le temps, je cherche des amis.","ar":"لكن ليس لديّ وقت، أنا أبحث عن أصدقاء."}]},{"title":"ce que voient les grandes personnes","ctx":"le pilote et le Petit Prince dans le désert","lines":[{"who":"Le pilote","fr":"Les grandes personnes ne comprendront jamais mon dessin numéro deux.","ar":"الكبار لن يفهموا رسمي الثاني أبداً."},{"who":"Le Petit Prince","fr":"Elles aiment les chiffres, elles n’écoutent jamais.","ar":"هم يحبون الأرقام ولا يستمعون أبداً."},{"who":"Le pilote","fr":"J’ai atterri au milieu du désert, il y a huit jours.","ar":"هبطت في وسط الصحراء قبل ثمانية أيام."},{"who":"Le Petit Prince","fr":"On ne voit bien qu’avec le cœur.","ar":"لا نرى جيداً إلا بالقلب."}]}],"exercises":[{"t":"mcq","skill":"listening","q":"ما الجملة التي تلخّّص رسالة الدرس؟","opts":["On ne voit bien qu’avec le cœur.","Il faut acheter beaucoup de chiffres.","Le désert est toujours froid.","Les roses sont bleues."],"a":0,"why":"هذه هي جملة الدرس المحورية عند le renard."},{"t":"fill","skill":"grammar","q":"أكمل بالزمن المناسب: «Le renard ___ assis dans l’herbe.»","fr":"Le renard ... assis dans l’herbe.","ans":"était","why":"l’imparfait peint la situation avant l’action ponctuelle."},{"t":"mcq","skill":"vocabulary","q":"أي كلمة تعني «يروّض ويؤلف»؟","opts":["apprivoiser","se souvenir","s’évaporer","se taire"],"a":0,"why":"apprivoiser = établir un lien progressif de confiance."},{"t":"order","skill":"writing","q":"رتّب: الوقت الذي ضيّعته هو ما يجعل وردتك مهمة","words":["C’est","le","temps","que","tu","as","perdu","qui","fait","ta","rose","importante."],"ans":"C’est le temps que tu as perdu qui fait ta rose importante.","why":"c’est … qui = mise en relief du sujet."},{"t":"listen","skill":"listening","q":"أي جملة تُظهر استعمال l’imparfait pour l’habitude؟","opts":["Le Petit Prince dessinait chaque jour.","Le renard apparut un matin.","Il planta un baobab.","Elle sourit et s’en alla."],"a":0,"why":"l’imparfait exprime l’action répétée ou habituelle."},{"t":"translate","skill":"writing","q":"ترجم: «إن روّضتني فسنحتاج بعضنا إلى بعض.»","ans":"Si tu m’apprivoises, nous aurons besoin l’un de l’autre.","why":"si + présent pour la condition, la conséquence au futur."},{"t":"speaking","skill":"speaking","q":"اشرح بالفرنسية في ثلاث جمل لماذا صارت الوردة مهمة للأمير.","target":"Ma rose est importante parce que j’ai perdu du temps pour elle.","why":"l’explication mobilise le lien entre le temps donné et la valeur."},{"t":"correct","skill":"grammar","q":"صحّح: «Si tu aurais le temps, tu me verrais.»","ans":"Si tu avais le temps, tu me verrais.","why":"après « si », jamais de conditionnel: on emploie l’imparfait."}],"homework":"استمع إلى la scène du renard ثلاث مرات بدون sous-titres، اكتب les cinq étapes de l’apprivoisement في خمس جمل بالفرنسية، ثم اختر une phrase du conte وشرحها في ثلاث جمل.","sources":[{"title":"Résumé et Analyse du Petit Prince d’Antoine de Saint-Exupéry","channel":"Rémi El Profesor","videoId":"evrB68eOU5E","why":"تحليل مدرسي منظم لـ le conte: la structure du récit، la rose et le renard، ثم la phrase centrale « On ne voit bien qu’avec le cœur » — يمهّد مباشرة لتحليل le récit et ses leçons.","cat":"Contes","level":"B2","main":true},{"title":"Le Petit Prince : Analyse et Résumé","channel":"Entre les Lignes","videoId":"cdFQb6sOXJA","why":"ملخّص تحليلي موجز يعيد بناء le récit ويدعم la compréhension العامة قبل التعمق.","cat":"Contes","level":"B2","extra":true},{"title":"Le sens Caché derrière le Petit Prince.","channel":"aristande","videoId":"yX9c2Lbm5Jw","why":"يشرح les symboles الخفية (la rose, le renard, le serpent) — مثالي لتحليل la morale.","cat":"Contes","level":"B2","extra":true}],"supplements":[{"id":"cdFQb6sOXJA","title":"Le Petit Prince : Analyse et Résumé","channel":"Entre les Lignes","why":"ملخّص تحليلي موجز يعيد بناء le récit ويدعم la compréhension العامة قبل التعمق.","lang":"fr","dur":10},{"id":"yX9c2Lbm5Jw","title":"Le sens Caché derrière le Petit Prince.","channel":"aristande","why":"يشرح les symboles الخفية (la rose, le renard, le serpent) — مثالي لتحليل la morale.","lang":"fr","dur":14}]},{"id":"b2-t9-l2","fr":"Les Fables de La Fontaine — Le Corbeau et la Renard","ar":"خرافات لافونتين — الغراب والثعلب","objectives":["استخراج la morale من la fable عبر la mise en scène des animaux et le dialogue","تحليل la versification: l’alexandrin, la césure au sixième pied, la rime croisée ABAB","تمييز l’allégorie: le corbeau = la vanité، le renard = la ruse et la flatterie","استعمال les temps du récit: l’imparfait pour le décor، le passé simple pour l’action"],"sections":[{"h":"الدرس 2: تحليل فابلة «الغراب والثعلب»: الأخلاقيات والصياغة الشعرية","video":{"id":"-OQkbHG3A-Q","title":"LA FONTAINE 🔎 Le Corbeau et le Renard (Analyse au fil du texte de la Fable)","channel":"Mediaclasse.fr","why":"تحليل سطر بسطر لأشهر فابلات La Fontaine: la morale، la versification، ثم l’allégorie animale — بالضبط ما نحتاجه لتحليل le texte et ses leçons.","lang":"fr","main":true,"dur":23},"p":["«Le Corbeau et le Renard» هي أشهر خرافات La Fontaine، مأخوذة عن Ésope: غراب يحمل جبنة في منقاره، وثعلب يمتدحه حتى يسقط الجبن من فمه — la morale تكمن في الحركة الأخيرة لا في المشهد كله.","المفردات الأساسية: la flatterie (التودد)، la vanité (الغرور)، la proie (الغنمة)، la morale (العبرة)، le fromage (الجبن)، la leçon (الدرس)، l’allégorie (التشبيه الرمزي)، la rime (القافية)، l’alexandrin (البحر الموزون)، le flatteur (المتملّق)، se laisser prendre (يُخدع)، le compliment (المديح).","نحوياً، لاحظ نظام الأزمنة في la fable: l’imparfait يثبّت la image (« Tenait en son bec un fromage ») بينما le passé simple يقود la séquence (« Le renard s’approcha, il lui dit… »). هذا الاختيار يجعل la scène ثابتة في البداية ثم متحرّكة في النهاية.","la versification: les vers sont des alexandrins (douze syllabes) بقافية متقاطعة ABAB (perché / alléché، fromage / langage) مع césure بعد ستة مقاطع. La Fontaine يختار هذا الوزن النبيل لقصة بسيطة: النتيجة تأثير كوميدي.","بعد الدرس: أعد reciter la fable بدون قراءة، ثم استبدل le fromage بـ objet حديث (un téléphone) وأعد كتابة la dernière réplique — la tâche تتحقق من فهمك للعبرة لا من الحفظ.","خُلاصة الدرس: la fable آلة صنع الأخلاقيات: l’allégorie animale تجعل la leçon محسوسة، والدرس universal — la flatterie تُنهي أي نجاح يُبنى على المديح الكاذب."],"sub":[{"h":"les vers qui font la fable","p":["« Maître Corbeau, sur un arbre perché… »","« Que vois-je là ? » dit le renard.","« Le Corbeau, honteux et confus, jura qu’on ne l’y prendrait plus. »"]},{"h":"la versification","p":["l’alexandrin: douze syllabes, césure après six","la rime croisée: perché / alléché — fromage / langage","le dialogue rend la fable vivante."]},{"h":"la morale et l’allégorie","p":["la flatterie — التودد","la vanité — الغرور","le flatteur — المتملّق"]}]},{"h":"les vers et les phrases à retenir","p":["« Maître Corbeau, sur un arbre perché, / Tenait en son bec un fromage. » — l’ouverture: deux vers, un décor, un enjeu.","« Que vois-je là ? » dit le renard. — le début de la flatterie, adressée à l’orgueil du corbeau.","« Le Corbeau, honteux et confus, / Jura, mais un peu tard, qu’on ne l’y prendrait plus. » — la chute et la morale en action.","« Ne vous fiez pas aux louanges qui vous enivrent. » — la leçon: la flatterie profite au flatteur, jamais à celui qui écoute."]},{"h":"التطبيق والتلخيص","p":["تمرين la récitation: احفظ les quatre premiers vers ثم استمع إلى la lecture النموذجية بدون النظر إلى le texte.","تمرين l’allégorie: صِل كل حيوان بصفته (le corbeau = …, le renard = …) ثم اشرح la leçon في جملتين بالفرنسية.","اكتب fable من huit vers sur un animal contemporain مع la rime croisée وmorale في آخر سطرين."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: في «Le Corbeau et la Renard» تُصنع la morale من la scène نفسها: la vanité du corbeau و la fourbe du renard يتعلّمان درساً واحداً — « Ne vous fiez pas aux louanges qui vous enivrent ». أعد مشاهدة الفيديو الرئيسي وركّز على la césure et la rime croisée dans les quatre premiers vers.","جسر الدروس: من b2-t9-l1 (الأمير الصغير — الحكاية الفلسفية) إلى b2-t9-l2 (خرافات لافونتين — الغراب والثعلب)، ثم إلى b2-t9-l3 حيث نحلّل بنية conte de fées عند Perrault في «Cendrillon» وتظهر la bonté المجزيَة.","مهمة تطبيقية: أعد سرد الفابلة في دقيقة واحدة مع تسجيل صوتك دون النظر إلى النص، ثم استخرج 3 كلمات جديدة من الدرس واكتب بها جملتين، وأخيراً قارن تلاوتك بالفيديو الرئيسي وحدّد الفرق في le rythme de l’alexandrin."]}],"pron":[{"w":"la flatterie","ipa":"[la flatʁi]","approx":"لا فلاطري"},{"w":"le corbeau","ipa":"[lə kɔʁbo]","approx":"ل كوربو"},{"w":"la morale","ipa":"[la mɔʁal]","approx":"لا مورال"}],"vocab":[{"fr":"le corbeau","ar":"الغراب","pos":"nom","g":"m","exFr":"Le corbeau tient un fromage dans le bec.","ipa":"[kɔʁbo]","exAr":"الغراب يحمل قطعة جبن في منقاره."},{"fr":"la fourbe","ar":"الغشّ والخيانة","pos":"nom","g":"f","exFr":"La fourbe se cache derrière les compliments du flatteur.","ipa":"[furb]","exAr":"يخفي الغشّ خلف مجاملات المتملّق."},{"fr":"la flatterie","ar":"التودّد والتملّق","pos":"nom","g":"f","exFr":"La flatterie est l’arme du renard.","ipa":"[flatʁi]","exAr":"التودّد هو سلاح الثعلب."},{"fr":"la vanité","ar":"الغرور","pos":"nom","g":"f","exFr":"Sa vanité l’empêche de réfléchir.","ipa":"[vanite]","exAr":"غروره يمنعه من التفكير."},{"fr":"la plume","ar":"الريشة","pos":"nom","g":"f","exFr":"Le flatteur vante la plume du corbeau pour le faire chanter.","ipa":"[plym]","exAr":"يمتدح المتملّق ريشة الغراب ليُغنيه."},{"fr":"la morale","ar":"العبرة والدرس","pos":"nom","g":"f","exFr":"La morale se trouve à la fin de la fable.","ipa":"[mɔʁal]","exAr":"العبرة توجد في نهاية الفابلة."},{"fr":"l’allégorie","ar":"التشبيه الرمزي","pos":"nom","g":"f","exFr":"Le renard est une allégorie de la ruse.","ipa":"[aleɡɔʁi]","exAr":"الثعلب تشبيه رمزي للحيلة."},{"fr":"la strophe","ar":"المقطع الشعري","pos":"nom","g":"f","exFr":"La fable se déroule en strophes aux vers égaux.","ipa":"[stʁɔp]","exAr":"تمتدّ الفابلة في مقاطع شعرية من أسطر متساوية."},{"fr":"l’alexandrin","ar":"البحر الموزون (اثنا عشر مقطعاً)","pos":"nom","g":"m","exFr":"Chaque vers de la fable est un alexandrin.","ipa":"[alɛɡsɑ̃dʁɛ̃]","exAr":"كل سطر في الفابلة بحر موزون."},{"fr":"le flatteur","ar":"المتملّق","pos":"nom","g":"m","exFr":"Le flatteur vous quitte dans le besoin.","ipa":"[flatœʁ]","exAr":"المتملّق يتركك حين تحتاج إليه."},{"fr":"se laisser prendre","ar":"يُخدع ويقع في الفخ","pos":"loc.","g":"","exFr":"Il s’est laissé prendre par des mots doux.","ipa":"","exAr":"وُقّع في فخّ الكلمات الحلوة."},{"fr":"honteux et confus","ar":"خجل ومحرَّج","pos":"loc.","g":"","exFr":"Il est resté honteux et confus après sa chute.","ipa":"","exAr":"بقي خجولاً ومحرجاً بعد سقطته."}],"examples":[{"fr":"Maître Corbeau, sur un arbre perché, tenait en son bec un fromage.","ar":"السيّد غراب، على غصن شجرة، كان يحمل في منقاره قطعة جبن.","note":"l’ouverture de la fable"},{"fr":"« Que vois-je là ? » dit le renard.","ar":"«ماذا أرى هناك؟» قال الثعلب.","note":"le début de la flatterie"},{"fr":"Le Corbeau, honteux et confus, jura qu’on ne l’y prendrait plus.","ar":"الغراب خجل ومحرَّج، أقسم أنه لن يقع في الفخّ ثانية.","note":"la chute et la morale"},{"fr":"Le flatteur vous quitte dans le besoin.","ar":"المتملّق يتركك حين تحتاج إليه.","note":"la morale de la fable"},{"fr":"Le renard est un animal rusé.","ar":"الثعلب حيوان ماكر.","note":"l’allégorie animale"},{"fr":"On ne doit pas se laisser tromper par les mots doux.","ar":"لا ينبغي أن نُخدع بالكلمات الحلوة.","note":"la leçon universelle"}],"grammar":[{"tFr":"Les temps du récit: l’imparfait et le passé simple","tAr":"أزمنة السرد في الفابلة","body":["l’imparfait installe le décor et l’état: « Maître Corbeau, sur un arbre perché, / Tenait en son bec un fromage. » — l’image est figée, on regarde la scène sans qu’elle bouge.","le passé simple fait avancer l’action: « Le renard s’approcha », « Le corbeau ouvrit le bec » — chaque verbe au passé simple est un tournant du récit."],"ex":[{"fr":"Le corbeau tenait le fromage quand le renard apparut.","ar":"كان الغراب يحمل الجبن حين ظهر الثعلب."},{"fr":"Il ouvrit le bec et laissa tomber sa proie.","ar":"فتح منقاره وأسقط غنيمته."}]},{"tFr":"Le discours direct dans la fable (verbes de parole et dialogue)","tAr":"النقل المباشر داخل الفابلة","body":["La Fontaine fait parler les animaux: après une introduction au passé simple (« dit le renard »), la réplique bascule au présent — c’est le présent de la scène, immédiat et vivant.","règle B2: verbe de parole + deux-points + réplique; l’interrogation directe (« Que vois-je là ? ») garde sa ponctuation propre, sans « que » de subordination."],"ex":[{"fr":"« Que vois-je là ? » dit le renard en s’approchant.","ar":"«ماذا أرى هناك؟» قال الثعلب مقترباً."},{"fr":"Le renard lui dit : « Votre chant est divin. »","ar":"قال له الثعلب: «غناؤك إلهي.»"}]}],"mistakes":[{"wrong":"croire que la fable raconte une histoire vraie","right":"reconnaître l’allégorie animale","why":"les animaux représentent des défauts humains: vanité, flatterie, ruse."},{"wrong":"écrire une morale sans la lier à la scène","right":"faire dériver la morale du récit","why":"dans une fable, la morale naît du dernier trait du récit."},{"wrong":"mélanger les temps sans ordre","right":"l’imparfait pour le cadre, le passé simple pour l’action","why":"c’est l’alternance qui rend la fable claire à l’oreille."},{"wrong":"lire l’alexandrin sans pause","right":"marquer la césure après la sixième syllabe","why":"la césure donne le rythme noble du vers de La Fontaine."}],"dialogues":[{"title":"la flatterie du renard","ctx":"mise en scène de la fable (dialogue reconstitué)","lines":[{"who":"Le renard","fr":"Que vois-je là ? Un si bel oiseau !","ar":"ماذا أرى هناك؟ أيّ طائر جميل!"},{"who":"Le renard","fr":"Si votre chant vaut votre plumage, vous êtes le roi.","ar":"إن كان غناؤك كريشتك فأنت الملك."},{"who":"Le corbeau","fr":"Tiens ! Écoute ma voix !","ar":"دقيقة! اسمع صوتي!"},{"who":"Le renard","fr":"Merci : le fromage était bon.","ar":"شكراً: الجبن كان لذيذاً."}]},{"title":"la morale après la lecture","ctx":"élève et professeur discutent de la fable","lines":[{"who":"L’élève","fr":"Pourquoi le corbeau a-t-il ouvert le bec ?","ar":"لماذا فتح الغراب منقاره؟"},{"who":"Le professeur","fr":"Parce qu’il aimait qu’on le loue : c’est la vanité.","ar":"لأنه أحب المديح: هذه الغرور."},{"who":"L’élève","fr":"La morale, c’est donc de ne pas écouter les flatteurs ?","ar":"العبرة إذن هي ألا نسمع المتملّقين؟"},{"who":"Le professeur","fr":"Oui : un compliment peut coûter plus cher qu’un fromage.","ar":"نعم: المجاملة قد تكلّف أكثر من قطعة جبن."}]}],"exercises":[{"t":"mcq","skill":"listening","q":"ما أول سطر صحيح في الفابلة؟","opts":["Maître Corbeau, sur un arbre perché…","Maître Renard, sous un arbre couché…","Le corbeau volait au-dessus du lac.","Il était une fois un perroquet."],"a":0,"why":"هكذا تبدأ فابلة La Fontaine بالضبط."},{"t":"fill","skill":"grammar","q":"أكمل بالزمن المناسب: «Le corbeau ___ le fromage dans le bec.»","fr":"Le corbeau ... le fromage dans le bec.","ans":"tenait","why":"l’imparfait décrit la situation figée avant l’action."},{"t":"mcq","skill":"vocabulary","q":"أي كلمة تعني «التودّد والتملّق»؟","opts":["la flatterie","la vanité","la proie","la rime"],"a":0,"why":"flatterie = تودّد؛ vanité = غرور؛ proie = غنيمة؛ rime = قافية."},{"t":"order","skill":"writing","q":"رتّب: الغراب خجل ومحرَّج أقسم أنه لن يقع في الفخّ ثانية","words":["Le","corbeau,","honteux","et","confus,","jura","qu’on","ne","l’y","prendrait","plus."],"ans":"Le corbeau, honteux et confus, jura qu’on ne l’y prendrait plus.","why":"la chute de la fable en deux vers au passé simple."},{"t":"listen","skill":"listening","q":"ما الخاصية اللغوية الغالبة في la fable؟","opts":["l’alexandrin et la rime croisée","le vers libre sans rime","la prose et la ponctuation moderne","le rythme libre sans césure"],"a":0,"why":"La Fontaine utilise ici l’alexandrin avec rimes croisées ABAB."},{"t":"translate","skill":"writing","q":"ترجم: «الغراب خجل ومحرَّج من فعله.»","ans":"Le corbeau est honteux et confus de son geste.","why":"la formule finale de la fable exprime le regret."},{"t":"speaking","skill":"speaking","q":"ابدأ بـ « Que vois-je là ? » ثم واصل la flatterie في جملتين بحجة واحدة.","target":"Que vois-je là ? Si votre chant vaut votre plumage, vous êtes le roi des oiseaux.","why":"la flatterie se construit par des compliments successifs."},{"t":"correct","skill":"grammar","q":"صحّح: «Il ouvrit le bec et le fromage tombait.»","ans":"Il ouvrit le bec et le fromage tomba.","why":"deux actions ponctuelles consécutives prennent le passé simple."}],"homework":"استمع إلى قراءة الفابلة ثلاث مرات، ثم اكتب la morale في سطرين بالفرنسية واشرح لماذا يختار La Fontaine les animaux au lieu des gens.","sources":[{"title":"LA FONTAINE 🔎 Le Corbeau et le Renard (Analyse au fil du texte de la Fable)","channel":"Mediaclasse.fr","videoId":"-OQkbHG3A-Q","why":"تحليل سطر بسطر لأشهر فابلات La Fontaine: la morale، la versification، ثم l’allégorie animale — بالضبط ما نحتاجه لتحليل le texte et ses leçons.","cat":"Contes","level":"B2","main":true},{"title":"Les Fables de La Fontaine expliquées | Bac français","channel":"MAJOR AU BAC FRANÇAIS","videoId":"E9Ye_fjhLrA","why":"شرح مدرسي: لماذا تتكلّم الحيوانات في la fable وكيف تُبنى la morale — دعم مباشر للاستعمال.","cat":"Contes","level":"B2","extra":true},{"title":"La morale des fables de La Fontaine","channel":"Storyplay’r","videoId":"ES91CmPQ5SE","why":"يركّز على la morale et le rôle de l’allégorie في الفابلة كلها، مقارنةً بالفابلة الواحدة.","cat":"Contes","level":"B2","extra":true}],"supplements":[{"id":"E9Ye_fjhLrA","title":"Les Fables de La Fontaine expliquées | Bac français","channel":"MAJOR AU BAC FRANÇAIS","why":"شرح مدرسي: لماذا تتكلّم الحيوانات في la fable وكيف تُبنى la morale — دعم مباشر للاستعمال.","lang":"fr","dur":5},{"id":"ES91CmPQ5SE","title":"La morale des fables de La Fontaine","channel":"Storyplay’r","why":"يركّز على la morale et le rôle de l’allégorie في الفابلة كلها، مقارنةً بالفابلة الواحدة.","lang":"fr","dur":7}]},{"id":"b2-t9-l3","fr":"Cendrillon de Charles Perrault — la magie et la bonté","ar":"سندريلا لشارل بيرول — السحر والطيبة","objectives":["التعرّف على بنية conte de fées: la formule d’ouverture, la situation initiale, la transformation, la récompense","تمييز les thèmes: la bonté, la patience, la magie bienfaisante, la métamorphose","استعمال les connecteurs temporels du récit: quand, lorsque, alors que, aussitôt que, une fois que","تحليل la morale de Perrault: la douceur l’emporte sur l’orgueil des sœurs"],"sections":[{"h":"الدرس 3: تحليل «سندريلا»: عناصر حكايات الجِنّ والطيبة المجزيَة","video":{"id":"GHn_nYmhM6g","title":"Analyse de Cendrillon de Charles Perrault #podcast","channel":"Les critiques littéraires du Gymnase","why":"تحليل أدبي لـ conte de fées عند Perrault: la formule d’ouverture، la bonté، ثم la morale المكتوبة في نهاية النص — أساس الدرس كاملاً.","lang":"fr","main":true,"dur":15},"p":["«Cendrillon» هو نموذج le conte de fées الكلاسيكي: la formule «Il était une fois…» تنقلنا خارج الزمن الحقيقي، ثم تظهر la situation initiale (الأم المتوفاة، الجدة، الأخوات الغير مُجاملات)، فتتم la transformation بمساعدة la fée marraine.","المفردات: la pantoufle (الحذاء)، le carrosse (العربة السحرية)، la fée marraine (السيدة الفاضلة)، le bal (الحفل)، la robe (الفستان)، le potiron (القرع)، la bonté (الطيبة)، la patience (الصبر)، la récompense (الجزاء)، les sœurs (الأخوات)، se transformer (يتحوّل)، la métamorphose (التحوّل).","نحوياً، الدرس مهم حول les connecteurs temporels: «quand» et «lorsque» + l’indicatif يحدّدان الحدث، «alors que» + l’imparfait يقارنان فعلين متزامنين، «aussitôt que» و«une fois que» يربطان الأحداث بالتسلسل.","الزمن في la conte: la situation initiale تبقى في l’imparfait (« sa belle-mère la faisait travailler »)، والأحداث تنتقل إلى le passé simple (« un jour, on annonça une fête »)، والـ plus-que-parfait يوضّح ما سبق (« elle avait fini sa tâche »).","بعد الدرس: شاهد la version sonore بدون sous-titres، ثم اكتب جدولاً من أربعة أعمدة (début, magie, fin, morale) واملأه بالفرنسية — la tâche تُنمّي la lecture analytique.","خُلاصة الدرس: la magie في Cendrillon ليست هروباً من الواقع بل أداة العدالة: la bonté تُكافأ، والـ patience تتحوّل إلى bonheur — والدرس أن la valeur الحقيقية داخلية لا خارجية."],"sub":[{"h":"la formule d’ouverture","p":["« Il était une fois… » — l’ouverture magique du conte.","la situation initiale: la belle-mère et les sœurs.","le temps du conte hors du temps réel."]},{"h":"la magie de la fée","p":["la fée marraine — السيدة الفاضلة","la pantoufle de verre — الحذاء الزجاجي","le carrosse — العربة السحرية"]},{"h":"les thèmes du conte","p":["la bonté — الطيبة","la patience — الصبر","la récompense — الجزاء"]}]},{"h":"les formules et les phrases du conte","p":["« Il était une fois… » — la formule qui ouvre tous les contes de fées et bascule le récit hors du temps ordinaire.","« Elle s’en alla tout en pleurant dans le jardin. » — la bonté de Cendrillon se montre dans les gestes, pas dans les paroles.","« La douceur et la bonté surpassaient la beauté de ses deux sœurs. » — la morale de Perrault: la valeur intérieure l’emporte.","« Un jour, un prince chercha la jeune fille dont le pied était si bien fait. » — le détail du pied scelle l’identité: la magie se règle sur la précision."]},{"h":"التطبيق والتلخيص","p":["تمرين la comparaison: أنشئ جدولاً بثلاثة أعمدة (situation initiale / transformation / morale) واملأه بالفرنسية.","تمرين la reformulation: أعد صياغة l’avertissement et la morale في جملتين مختلفتين دون تغيير المعنى.","اكتب 100 كلمة عن نهاية بديلة: ماذا يحدث لو اعتذرت Cendrillon عن الذهاب إلى الحفل؟ مع استخدام le passé simple et les connecteurs."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: «Cendrillon» نموذج la formule d’ouverture ثم la transformation ثم la récompense: la bonté و la patience تُكافآن، والدرس أن la valeur intérieure أهم من la beauté. أعد مشاهدة الفيديو الرئيسي وركّز على les connecteurs temporels: quand, lorsque, alors que, aussitôt que, une fois que.","جسر الدروس: من b2-t9-l2 (خرافات لافونتين — الغراب والثعلب) إلى b2-t9-l3 (سندريلا لشارل بيرول — السحر والطيبة)، ثم إلى b2-t9-l4 حيث نقارن نسختَي «ذات الشعر الأحمر» عند Perrault و Grimm وتختلف la fin et la morale.","مهمة تطبيقية: أعد سرد القصة في دقيقة واحدة مع تسجيل صوتك، ثم دوّن 3 كلمات جديدة من الدرس واستعملها في جمل، وأخيراً قارن روايتك بالفيديو الرئيسي وحدّد نقطة واحدة نقصت فيها من la transformation."]}],"pron":[{"w":"la pantoufle","ipa":"[la pɑ̃tuf]","approx":"لا بطولف"},{"w":"la fée","ipa":"[la fe]","approx":"لا فيه"},{"w":"le carrosse","ipa":"[lə kaʁɔs]","approx":"ل كاروس"}],"vocab":[{"fr":"la pantoufle","ar":"الحذاء/النعل","pos":"nom","g":"f","exFr":"La pantoufle de verre était si fine.","ipa":"[pɑ̃tuf]","exAr":"كان الحذاء الزجاجي رقيقاً جداً."},{"fr":"la fée marraine","ar":"السيدة السحرية الطيبة","pos":"nom","g":"f","exFr":"La fée marraine transforma le potiron en carrosse.","ipa":"[fe maʁɛn]","exAr":"حوّلت السيدة الفاضلة القرع إلى عربة."},{"fr":"le carrosse","ar":"العربة السحرية","pos":"nom","g":"m","exFr":"Le carrosse partit avant minuit.","ipa":"[kaʁɔs]","exAr":"انطلقت العربة قبل منتصف الليل."},{"fr":"le bal","ar":"الحفل","pos":"nom","g":"m","exFr":"Le prince organise un grand bal.","ipa":"[bal]","exAr":"الأمير يقيم حفلاً كبيراً."},{"fr":"la robe","ar":"الفستان","pos":"nom","g":"f","exFr":"La robe devint plus belle que toutes les autres.","ipa":"[ʁɔb]","exAr":"أصبح الفستان أجمل من كل الفساتين."},{"fr":"le potiron","ar":"القرع","pos":"nom","g":"m","exFr":"Le potiron devint un carrosse d’or.","ipa":"[pɔtirɔ̃]","exAr":"تحوّل القرع إلى عربة ذهبية."},{"fr":"la bonté","ar":"الطيبة","pos":"nom","g":"f","exFr":"Sa bonté surpassait sa beauté.","ipa":"[bɔ̃te]","exAr":"طبيتها كانت تفوق جمالها."},{"fr":"la patience","ar":"الصبر","pos":"nom","g":"f","exFr":"Elle supporta tout avec patience.","ipa":"[pasjɑ̃s]","exAr":"تحمّلت كل شيء بصبر."},{"fr":"la récompense","ar":"الجزاء","pos":"nom","g":"f","exFr":"La récompense vient toujours à la fin du conte.","ipa":"[ʁekɔ̃pɑ̃s]","exAr":"الجزاء يأتي دائماً في نهاية الحكاية."},{"fr":"se transformer","ar":"يتحوّل","pos":"verbe","g":"","exFr":"Le potiron se transforme en carrosse.","ipa":"[sə tʁɑ̃sfɔʁme]","exAr":"يتحوّل القرع إلى عربة."},{"fr":"la métamorphose","ar":"التحوّل الجذري","pos":"nom","g":"f","exFr":"La métamorphose est l’âme des contes de fées.","ipa":"[metamɔʁfoz]","exAr":"التحوّل الجذري هو روح حكايات الجِنّ."},{"fr":"les sœurs","ar":"الأخوات","pos":"nom","g":"f","exFr":"Les deux sœurs riaient de Cendrillon.","ipa":"[sœʁ]","exAr":"ضحكتا الأخوتين من سندريلا."}],"examples":[{"fr":"Il était une fois une jeune fille douce et patiente.","ar":"كان يا ما كان فتاة طيّبة صبورة.","note":"l’ouverture du conte"},{"fr":"La fée transforma le potiron en carrosse.","ar":"حوّلت السيدة القرع إلى عربة.","note":"la métamorphose"},{"fr":"Quand la nuit tomba, la fée apparut.","ar":"حين حلّ الليل ظهرت السيدة.","note":"le connecteur temporel"},{"fr":"La bonté finit toujours par être récompensée.","ar":"الطيبة تُكافأ في النهاية دائماً.","note":"la morale de Perrault"},{"fr":"Aussitôt que le carrosse eut disparu, elle se retrouva en haillons.","ar":"حالما اختفت العربة وجدت نفسها في خرق ممزّق.","note":"aussitôt que + plus-que-parfait"},{"fr":"Le prince chercha la jeune fille dont le pied était si bien fait.","ar":"بحث الأمير عن الفتاة التي كان قدمها متناسقاً جداً.","note":"la fin du conte"}],"grammar":[{"tFr":"Les connecteurs temporels du récit","tAr":"أدوات الربط الزمني في سرد الحكاية","body":["un conte avance par séquences: « quand » et « lorsque » + l’indicatif situent l’événement (« Quand la nuit tomba, la fée apparut »); « alors que » + l’imparfait oppose deux actions simultanées.","règle B2: « aussitôt que » et « une fois que » marquent l’enchaînement immédiat et permettent le plus-que-parfait pour situer l’action avant l’autre."],"ex":[{"fr":"Quand la nuit tomba, la fée apparut.","ar":"حين حلّ الليل ظهرت السيدة."},{"fr":"Aussitôt que le carrosse eut disparu, la robe redevint haillons.","ar":"حالما اختفت العربة عاد الفستان خرقاً."}]},{"tFr":"Les temps du conte: imparfait, passé simple, plus-que-parfait","tAr":"أزمنة الحكاية: الوصف والحدث وما سبقهما","body":["la situation initiale reste à l’imparfait (« sa belle-mère la faisait travailler »), le récit bascule au passé simple pour les événements (« un jour, on annonça une fête »), et le plus-que-parfait situe ce qui a eu lieu avant.","cette hiérarchie des temps est exactement celle attendue dans un récit écrit en B2: elle donne clarté et ordre chronologique."],"ex":[{"fr":"Elle avait fini son travail quand la fée arriva.","ar":"كانت أنهت عملها حين وصلت السيدة."},{"fr":"La fée transforma le potiron en carrosse.","ar":"حوّلت السيدة القرع إلى عربة."}]}],"mistakes":[{"wrong":"commencer un conte par « Hier, je… »","right":"utiliser « Il était une fois… »","why":"la formule installe le temps du conte, hors de la réalité quotidienne."},{"wrong":"mettre le conditionnel après « quand »","right":"quand + indicatif (imparfait ou passé simple)","why":"les connecteurs temporels régissent l’indicatif."},{"wrong":"voir Cendrillon comme une histoire de chance","right":"reconnaître le thème de la bonté récompensée","why":"Perrault insiste sur la douceur, pas sur la beauté seule."},{"wrong":"traduire « une fois que » par « quand » simplement","right":"une fois que + plus-que-parfait pour l’antériorité","why":"cela précise que l’action est terminée avant l’autre."}],"dialogues":[{"title":"la fée et Cendrillon","ctx":"le jardin, avant la fête","lines":[{"who":"La fée","fr":"Pourquoi pleures-tu, ma fille ?","ar":"لماذا تبكي يا ابنتي؟"},{"who":"Cendrillon","fr":"Je voudrais aller à la fête, mais je n’ai rien à mettre.","ar":"أريد الذهاب إلى الحفلة، لكن ليس لديّ ما أرتديه."},{"who":"La fée","fr":"Sois douce et patiente, je ferai ton bonheur.","ar":"كوني طيّبة صبورة، سأصنع سعادتك."},{"who":"Cendrillon","fr":"Merci, marraine, je vous obéirai.","ar":"شكراً يا عَوَّادة، سأطيعك."}]},{"title":"le retour du bal","ctx":"à la maison, le lendemain matin","lines":[{"who":"La belle-sœur","fr":"Tu étais donc la princesse du bal ?","ar":"كنتِ إذن أميرة الحفل؟"},{"who":"Cendrillon","fr":"Non, je suis restée ici toute la nuit, dit-elle en riant.","ar":"لا، بقيت هنا طوال الليل، قالت وهي تضحك."},{"who":"La sœur aînée","fr":"Mais nous t’avons vue pourtant, sœur ?","ar":"لكننا رأيناكِ يا أختي؟"},{"who":"Cendrillon","fr":"La bonté n’a pas besoin de se prouver.","ar":"الطيبة لا تحتاج إلى إثبات."}]}],"exercises":[{"t":"mcq","skill":"listening","q":"ما العبارة التي تفتح الحكاية؟","opts":["Il était une fois…","Il y avait un jour…","Hier matin…","Au commencement…"],"a":0,"why":"la formule d’ouverture du conte de fées."},{"t":"fill","skill":"grammar","q":"أكمل بالزمن المناسب: «Quand la nuit ___, la fée apparut.»","fr":"Quand la nuit ..., la fée apparut.","ans":"tomba","why":"le passé simple marque l’événement ponctuel."},{"t":"mcq","skill":"vocabulary","q":"أي كلمة تعني «الحذاء الزجاجي»؟","opts":["la pantoufle de verre","le carrosse","le potiron","le bal"],"a":0,"why":"la pantoufle = الحذاء؛ le carrosse = العربة؛ le potiron = القرع."},{"t":"order","skill":"writing","q":"رتّب: حالما اختفت العربة وجدت نفسها في خرق ممزّق","words":["Aussitôt","que","le","carrosse","eut","disparu,","elle","se","retrouva","en","haillons."],"ans":"Aussitôt que le carrosse eut disparu, elle se retrouva en haillons.","why":"« aussitôt que » + plus-que-parfait situe l’action avant l’autre."},{"t":"listen","skill":"listening","q":"أي phrase تعبّر عن la morale de Perrault ?","opts":["La bonté finit toujours par être récompensée.","Il faut acheter une robe.","La fête dure toute la nuit.","Le prince est très riche."],"a":0,"why":"la morale insiste sur la bonté, pas sur la magie."},{"t":"translate","skill":"writing","q":"ترجم: «كانت سندريلا طيّبة وصبورة مع أخواتها.»","ans":"Cendrillon était douce et patiente avec ses sœurs.","why":"les adjectifs de caractère sont au cœur de la morale."},{"t":"speaking","skill":"speaking","q":"ارفع la situation initiale ثم صِف la transformation في ثلاث جمل.","target":"D’abord, elle travaillait toute la journée, puis la fée a transformé le potiron en carrosse.","why":"le récit combine l’imparfait et le passé simple."},{"t":"correct","skill":"grammar","q":"صحّح: «Aussitôt que la fée serait apparue, la robe changea.»","ans":"Aussitôt que la fée apparut, la robe changea.","why":"après « aussitôt que », on emploie l’indicatif, jamais le conditionnel."}],"homework":"اكتب les quatre étapes du conte (situation initiale, aide magique, transformation, morale) في 120 كلمة بالفرنسية، مع استخدام connecteurs: quand, alors que, aussitôt que, une fois que.","sources":[{"title":"Analyse de Cendrillon de Charles Perrault #podcast","channel":"Les critiques littéraires du Gymnase","videoId":"GHn_nYmhM6g","why":"تحليل أدبي لـ conte de fées عند Perrault: la formule d’ouverture، la bonté، ثم la morale المكتوبة في نهاية النص — أساس الدرس كاملاً.","cat":"Contes","level":"B2","main":true},{"title":"Livre audio : Cendrillon, de Charles Perrault","channel":"Audiolude","videoId":"eA9AJHiHamg","why":"la version sonore du conte: la mémoire des formules et le rythme de la lecture — مثالية la réécoute.","cat":"Contes","level":"B2","extra":true},{"title":"Les secrets de Cendrillon !","channel":"Tiboudouboudou","videoId":"S4d3iOMs0-o","why":"يشرح les symboles والخلفيات الثقافية للحكاية — يثري la lecture analytique.","cat":"Contes","level":"B2","extra":true}],"supplements":[{"id":"eA9AJHiHamg","title":"Livre audio : Cendrillon, de Charles Perrault","channel":"Audiolude","why":"la version sonore du conte: la mémoire des formules et le rythme de la lecture — مثالية la réécoute.","lang":"fr","dur":15},{"id":"S4d3iOMs0-o","title":"Les secrets de Cendrillon !","channel":"Tiboudouboudou","why":"يشرح les symboles والخلفيات الثقافية للحكاية — يثري la lecture analytique.","lang":"fr","dur":24}]},{"id":"b2-t9-l4","fr":"Le Petit Chaperon rouge — versions françaises et grimm","ar":"ذات الشعر الأحمر — النسختان الفرنسية وغريم","objectives":["مقارنة les deux versions: Perrault (1697) et les frères Grimm (1812) — la fin diffère","تحليل l’alerte: les paroles de la mère et la transgression de la règle","distinguer la morale de la fable (Perrault) de la logique du conte merveilleux (Grimm)","maîtriser le vocabulaire du conte: le panier, le chemin, la forêt, l’avertissement, l’obéissance"],"sections":[{"h":"الدرس 4: مقارنة نسختَي «ذات الشعر الأحمر»: بيرول وأخوّة غريم","video":{"id":"D0vTsiLcxEI","title":"Henri Dès raconte - Le petit chaperon rouge - histoire pour enfants","channel":"TOUS LES ENFANTS","why":"رواية صوتية بالفرنسية لحكاية Perrault: la voix expressive، les formules de l’avertissement، et le rythme du conte — نقطة الانطلاق لدرس المقارنة.","lang":"fr","main":true,"dur":12},"p":["«Le Petit Chaperon rouge» existe en deux grandes versions: celle de Charles Perrault (1697) وتلك للأخوين غريم (1812). la différence الحاسمة هي la fin: Perrault ينتهي بالدرس والتحذير، وغريم ينتهي بالإنقاذ والفرح.","المفردات: le panier (السلة)، le chemin (الطريق)، la grand-mère (الجدة)، le loup (الذئب)، la forêt (الغابة)، la peur (الخوف)، l’obéissance (الطاعة)، l’avertissement (التحذير)، l’imprudence (التهرّب من الحيطة)، se perdre (يضلّ الطريق)، sauvé (مُنقَذ)، la morale (العبرة).","نحوياً، النسختان تستعملان l’impératif de conseil (« Ne t’écarte pas du chemin. ») ثم تنتقلان إلى le passé simple pour raconter les événements — هذه الانتقالة typique du conte populaire.","l’alerte هي قلب الحكاية: الأم تعطي قاعدة واحدة بسيطة، والابنة تكسرها إما بسذاجة (Perrault) أو بخداع le loup (Grimm). la leçon ليست الخوف من la forêt بل la prudence أمام كلام الغرباء.","تمرين المقارنة: ضع النسختين في جدول (le début, la règle, la fin, la morale) ثم استخرج ثلاثة فروق — la tâche تُنمّي la lecture comparative au niveau B2.","خُلاصة الدرس: le conte نصّ متحرّك: كل جيل يعيد كتابته حسب قيمته — لذلك تُدرَّس النسختان معاً في المدارس الفرنسية، ولذلك ندرس نحن la grammaire عبر la comparaison."],"sub":[{"h":"les deux versions","p":["Perrault, 1697 — une fin qui avertit.","les frères Grimm, 1812 — une fin qui récompense.","la même situation initiale, deux morales."]},{"h":"l’avertissement","p":["« Ne t’écarte pas du chemin. »","le panier pour la grand-mère — السلة","la forêt — الغابة"]},{"h":"la morale","p":["la prudence devant les inconnus — version de Perrault","la récompense de l’obéissance — version de Grimm","le danger des belles paroles."]}]},{"h":"les formules les plus célèbres","p":["« Ne t’écarte pas du chemin. » — la règle donnée par la mère: l’alerte centrale du conte.","« Que tu es gentille ! Que tu as de jolis bras ! » — les mots doux du loup: la flatterie comme outil de ruse.","« Que tu as une grosse voix, dit la grand-mère. » — le doute qui annonce le danger.","« C’est pour mieux t’entendre, ma mère grand. » — la formule la plus célèbre du conte, où la ruse se cache derrière la politesse."]},{"h":"التطبيق والتلخيص","p":["تمرين la comparaison: أنشئ جدولاً من أربعة أعمدة (début, règle, fin, morale) واملأه بالنسختين بالفرنسية.","تمرين la reformulation: أعد صياغة l’avertissement في جملتين مختلفتين دون تغيير المعنى.","اكتب 100 كلمة عن نهاية بديلة: ماذا يحدث لو أطاعت الابنة من البداية؟ مع استخدام le passé simple et les connecteurs temporels."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: نسختا «Le Petit Chaperon rouge» تنتهيان بشكل مختلف: Perrault يختم بـ la morale et l’avertissement، و Grimm يختم بالإنقاذ والفرح — والدرس أن le conte يتغيّر مع كل جيل. أعد مشاهدة الفيديو الرئيسي وركّز على l’impératif de conseil « Ne t’écarte pas du chemin » ثم على le passé simple dans les événements.","جسر الدروس: من b2-t9-l3 (سندريلا لشارل بيرول — السحر والطيبة) إلى b2-t9-l4 (ذات الشعر الأحمر — النسختان الفرنسية وغريم)، ثم إلى b2-t9-l5 حيث ندخل «Ali Baba» من «Les Mille et Une Nuits» وتظهر la formule magique « Sésame, ouvre-toi ! ».","مهمة تطبيقية: أعد سرد النسخة التي تفضّلها في دقيقة واحدة مع تسجيل صوتك، ثم استخرج 3 كلمات جديدة من الدرس واكتب بها جملتين، وأخيراً قارن روايتك بالفيديو الرئيسي وبيّن هل اخترت la fin de Perrault أم la fin de Grimm."]}],"pron":[{"w":"le loup","ipa":"[lə lu]","approx":"ل لو"},{"w":"la forêt","ipa":"[la fɔʁɛ]","approx":"لا فوري"},{"w":"l’avertissement","ipa":"[lavɛʁtisəmɑ̃]","approx":"لافيرتيسومون"}],"vocab":[{"fr":"le panier","ar":"السلة","pos":"nom","g":"m","exFr":"Elle porte un panier à sa grand-mère.","ipa":"[panje]","exAr":"تحمل سلّة إلى جدتها."},{"fr":"le chemin","ar":"الطريق","pos":"nom","g":"m","exFr":"Ne t’écarte pas du chemin.","ipa":"[ʃəmɛ̃]","exAr":"لا تنحرف عن الطريق."},{"fr":"la grand-mère","ar":"الجدة","pos":"nom","g":"f","exFr":"Elle rend visite à sa grand-mère.","ipa":"[ɡʁɑ̃dmɛʁ]","exAr":"تزور جدتها."},{"fr":"le loup","ar":"الذئب","pos":"nom","g":"m","exFr":"Le loup habite dans la forêt.","ipa":"[lu]","exAr":"يعيش الذئب في الغابة."},{"fr":"la forêt","ar":"الغابة","pos":"nom","g":"f","exFr":"Le chemin traverse une forêt épaisse.","ipa":"[fɔʁɛ]","exAr":"يمرّ الطريق عبر غابة كثيفة."},{"fr":"l’avertissement","ar":"التحذير","pos":"nom","g":"m","exFr":"L’avertissement de la mère est très clair.","ipa":"[avɛʁtisəmɑ̃]","exAr":"تحذير الأم واضح جداً."},{"fr":"l’obéissance","ar":"الطاعة","pos":"nom","g":"f","exFr":"Son obéissance la sauve dans la version de Grimm.","ipa":"[ɔbejɑ̃s]","exAr":"طاعتها تنقذها في نسخة غريم."},{"fr":"l’imprudence","ar":"التهرّب من الحيطة","pos":"nom","g":"f","exFr":"Son imprudence lui coûte cher.","ipa":"[ɛ̃pʁydɑ̃s]","exAr":"تهاونها يكلّفها غالياً."},{"fr":"se perdre","ar":"يضلّ الطريق","pos":"verbe","g":"","exFr":"Ne te perds pas dans la forêt.","ipa":"[sə pɛʁdʁ]","exAr":"لا تضِلّ في الغابة."},{"fr":"le danger","ar":"الخطر","pos":"nom","g":"m","exFr":"L’avertissement de la mère indique le danger de la forêt.","ipa":"[dɑ̃ʒe]","exAr":"تحذير الأم يشير إلى خطر الغابة."},{"fr":"les mots doux","ar":"الكلمات الحلوة","pos":"loc.","g":"","exFr":"Les mots doux cachent parfois un piège.","ipa":"","exAr":"الكلمات الحلوة تُخفي أحياناً فخاً."},{"fr":"sauvé","ar":"مُنقَذ","pos":"adj.","g":"","exFr":"Le chasseur l’a sauvée à temps.","ipa":"[sove]","exAr":"أنقذها الصيّاد في الوقت المناسب."}],"examples":[{"fr":"Ne t’écarte pas du chemin.","ar":"لا تنحرف عن الطريق.","note":"l’avertissement"},{"fr":"C’est pour mieux t’entendre, ma mère grand.","ar":"هذه لأسمعكِ جيداً يا جدتي.","note":"la formule célèbre"},{"fr":"Il était une fois une petite fille nommée le Petit Chaperon rouge.","ar":"كان يا ما كان فتاة صغيرة اسمها ذات الشعر الأحمر.","note":"l’ouverture du conte"},{"fr":"Perrault finit par avertir; Grimm finit par récompenser.","ar":"بيرول يختتم بالتحذير، وغريم يختتم بالجزاء.","note":"la comparaison des versions"},{"fr":"Le loup parla à la petite fille avec de belles paroles.","ar":"تحدّث الذئب إلى الفتاة بكلمات جميلة.","note":"la ruse du loup"},{"fr":"Cette version insiste sur la prudence.","ar":"هذه النسخة تُشدد على الحيطة.","note":"la morale"}],"grammar":[{"tFr":"L’impératif des conseils et de l’avertissement","tAr":"أوامر النصيحة والتحذير","body":["le conte utilise l’impératif présent pour transmettre la règle: « Ne t’écarte pas du chemin ! », « Va porter ce panier à ta grand-mère ! » — la forme négative se construit avec « ne … pas » autour du verbe.","avec un pronom réfléchi, l’impératif garde le trait d’union: « écarte-toi », « dépêche-toi » — la forme « t’écarte » n’existe qu’à l’indicatif."],"ex":[{"fr":"Ne t’écarte pas du chemin, reste près du sentier.","ar":"لا تنحرف عن الطريق، ابقَ قرب الممرّ."},{"fr":"Va vite, dépêche-toi et reviens avant la nuit.","ar":"اذهب بسرعة، أسرع وعُد قبل الليل."}]},{"tFr":"Le récit: alternance imparfait / passé simple et le présent de l’avertissement","tAr":"السرد: تناوب الماضي البسيط مع المضارع في التحذير","body":["la situation est à l’imparfait (« la mère préparait le panier »), les événements au passé simple (« elle rencontra le loup »), tandis que la règle est formulée au présent — parce qu’elle vaut pour tout le temps.","c’est ce contraste qui distingue la règle (présent) de l’histoire (passé): une observation très utile pour résumer un conte en B2."],"ex":[{"fr":"La mère disait toujours : « Ne parle pas aux inconnus. »","ar":"كانت الأم تقول دائماً: «لا تتحدّث مع الغرباء.»"},{"fr":"Elle prit le panier et partit dans la forêt.","ar":"أخذت السلّة وانطلقت إلى الغابة."}]}],"mistakes":[{"wrong":"croire que les deux versions ont la même fin","right":"Perrault avertit, Grimm sauve","why":"la comparaison des versions est le cœur de cette leçon."},{"wrong":"utiliser « se écarter » à l’impératif","right":"écarte-toi / ne t’écarte pas","why":"le pronom réfléchi s’attache au verbe à l’impératif."},{"wrong":"tout mettre au passé composé","right":"le passé simple pour le conte","why":"le conte populaire privilégie le passé simple."},{"wrong":"prendre « C’est pour mieux t’entendre » comme un conseil","right":"reconnaître la ruse du loup","why":"la formule est célèbre parce qu’elle cache une tromperie."}],"dialogues":[{"title":"l’avertissement de la mère","ctx":"le départ, le matin","lines":[{"who":"La mère","fr":"Voilà un panier pour ta grand-mère.","ar":"هذه سلّة لجدتك."},{"who":"La mère","fr":"Ne t’écarte pas du chemin, fais bien attention.","ar":"لا تنحرف عن الطريق، انتبه جيداً."},{"who":"La petite fille","fr":"Oui, maman, je ferai bien attention.","ar":"نعم يا أمي، سأنتبه جيداً."},{"who":"La mère","fr":"Et ne parle à personne sur la route.","ar":"ولا تتحدّث مع أحد في الطريق."}]},{"title":"Perrault ou Grimm ?","ctx":"élèves qui comparent les deux fins","lines":[{"who":"L’élève 1","fr":"Dans la version de Perrault, la morale est plus sévère.","ar":"في نسخة بيرول، العبرة أكثر صرامة."},{"who":"L’élève 2","fr":"Chez Grimm, la fin est heureuse et la peur disparaît.","ar":"عند غريم تنتهي النسخة بسعادة ويختفي الخوف."},{"who":"L’élève 1","fr":"Les deux versions parlent de la même règle.","ar":"النسختان تتحدثان عن القاعدة نفسها."},{"who":"Le professeur","fr":"Oui : l’avertissement reste le vrai sujet du conte.","ar":"نعم: التحذير يبقى الموضوع الحقيقي للحكاية."}]}],"exercises":[{"t":"mcq","skill":"listening","q":"ما القاعدة التي تعطيها الأم؟","opts":["Ne t’écarte pas du chemin.","Achète-toi une robe neuve.","Reste à la maison toute la journée.","Parle à tous les voisins."],"a":0,"why":"l’avertissement est la règle centrale du conte."},{"t":"fill","skill":"grammar","q":"أكمل: «Ne ___ pas du chemin, ma fille.»","fr":"Ne ... pas du chemin, ma fille.","ans":"t’écarte","why":"la forme négative de l’impératif avec pronom réfléchi."},{"t":"mcq","skill":"vocabulary","q":"أي كلمة تعني «التحذير»؟","opts":["l’avertissement","le panier","la forêt","la peur"],"a":0,"why":"avertissement = تحذير؛ panier = سلّة؛ forêt = غابة؛ peur = خوف."},{"t":"order","skill":"writing","q":"رتّب: لا تتحدّث مع أحد في الطريق يا ابنتي","words":["Ne","parle","à","personne","sur","la","route,","ma","fille."],"ans":"Ne parle à personne sur la route, ma fille.","why":"l’impératif négatif: ne + verbe + pas omis ici car « personne » porte la négation."},{"t":"listen","skill":"listening","q":"أي phrase تعبّر عن la ruse du loup ?","opts":["C’est pour mieux t’entendre, ma mère grand.","Ne t’écarte pas du chemin.","Voilà un panier pour ta grand-mère.","Elle prit le panier et partit."],"a":0,"why":"le loup cache sa tromperie derrière une réponse polie."},{"t":"translate","skill":"writing","q":"ترجم: «خذ السلّة ولا تنحرف عن الطريق.»","ans":"Prends le panier et ne t’écarte pas du chemin.","why":"l’impératif affirmatif + la forme négative avec pronom réfléchi."},{"t":"speaking","skill":"speaking","q":"ارفع la fin من نسخة Grimm ثم قارنها مع fin Perrault في جملتين.","target":"Dans la version de Grimm, la petite fille est sauvée, alors que Perrault termine par un avertissement.","why":"la comparaison des versions mobilise « alors que » et le passé simple."},{"t":"correct","skill":"grammar","q":"صحّح: «Se écarte du chemin !»","ans":"Écarte-toi du chemin !","why":"à l’impératif affirmatif, le pronom réfléchi se place après le verbe."}],"homework":"اكتب جدولاً من أربعة أعمدة (début, règle, fin, morale) للنسختين بالفرنسية، ثم اختر la version التي تفضّلها واشرح اختيارك في ثلاث جمل.","sources":[{"title":"Henri Dès raconte - Le petit chaperon rouge - histoire pour enfants","channel":"TOUS LES ENFANTS","videoId":"D0vTsiLcxEI","why":"رواية صوتية بالفرنسية لحكاية Perrault: la voix expressive، les formules de l’avertissement، et le rythme du conte — نقطة الانطلاق لدرس المقارنة.","cat":"Contes","level":"B2","main":true},{"title":"Le Petit Chaperon Rouge : Grimm ou Perrault ?","channel":"Mayrcury","videoId":"qrJ7ttHqspc","why":"مقارنة مباشرة بين النسختين: la fin، la morale، les différences — مكمل مثالي لدرس المقارنة.","cat":"Contes","level":"B2","extra":true},{"title":"Le petit chaperon rouge - Karambolage - ARTE","channel":"Karambolage en français - ARTE","videoId":"zYXKiCGkniA","why":"تحليل سريع وأنيق لـ les origines du conte et du chaperon — يُثري la perspective culturelle.","cat":"Contes","level":"B2","extra":true}],"supplements":[{"id":"qrJ7ttHqspc","title":"Le Petit Chaperon Rouge : Grimm ou Perrault ?","channel":"Mayrcury","why":"مقارنة مباشرة بين النسختين: la fin، la morale، les différences — مكمل مثالي لدرس المقارنة.","lang":"fr","dur":5},{"id":"zYXKiCGkniA","title":"Le petit chaperon rouge - Karambolage - ARTE","channel":"Karambolage en français - ARTE","why":"تحليل سريع وأنيق لـ les origines du conte et du chaperon — يُثري la perspective culturelle.","lang":"fr","dur":4}]},{"id":"b2-t9-l5","fr":"Ali Baba et les Quarante Voleurs — Les Mille et Une Nuits","ar":"علي بابا والأربعون لصّاً — ألف ليلة وليلة","objectives":["فهم بنية le conte enchâssé: Shahrazade تروي، والحكاية تتوسّع داخل حكاية","تحليل les formules: « Sésame, ouvre-toi ! » et l’impératif avec le pronom réfléchi","_acquire le vocabulaire de l’aventure: la caverne, le trésor, la ruse, la stupeur, la clé","تمييز la progression du récit: la découverte, la transgression, la ruse, la victoire de l’intelligence"],"sections":[{"h":"الدرس 5: «علي بابا» وعالم ألف ليلة وليلة: الحكاية الشرقية والصيغة","video":{"id":"iYzviNIJI04","title":"2 Contes des Mille et Une Nuits | Ali Baba et les 40 Voleurs + Aladin avec les P’tits z’Amis","channel":"Les P’tits z’Amis","why":"حكايتان كاملتان بالفرنسية من «Les Mille et Une Nuits»: la formule « Sésame, ouvre-toi ! »، le rythme du récit، وvocabulaire l’aventure — قاعدة صوتية ممتازة للدرس.","lang":"fr","main":true,"dur":24},"p":["«Ali Baba et les Quarante Voleurs» ينتمي إلى «Les Mille et Une Nuits»، لكن نسخته الفرنسية تعود إلى Antoine Galland في القرن الثامن عشر، qui l’a racontée d’après un conteur syrien — la leçon: le conte oriental يمرّ عبر la traduction et la réécriture.","المفردات: la caverne (الكهف)، le trésor (الكنز)، la formule (الكلمة السحرية)، la ruse (الحيلة)، la stupeur (الذهول)، les voleurs (اللصوص)، la cachette (المخبأ)، la boutique (الدكان)، l’esclave (الخادمة)، le plan (الخطة)، la clé (المفتاح)، la surprise (المفاجأة).","نحوياً، la formule « Sésame, ouvre-toi ! » est un impératif présent avec pronom réfléchi détaché: ouvre + toi. la structure « mot magique + verbe + pronom » تخلق l’effet magique du conte.","la structure du récit: la découverte (اللصوص والكهف)، la transgression (نسيان la formule)، la punition، ثم la ruse de l’esclave — le conte يحب les répétitions et les chiffres symboliques (40، 3، 1).","تمرين: استمع إلى la formule في فيديو القصة ثم أعد تلفظها عشر مرات مع ضبط نبرة الأمر، ثم اكتب la formule en changeant le verbe (« Poil de chameau, ouvre-toi ! »).","خُلاصة الدرس: le conte oriental يعلّمنا أن la puissance تأتي من la parole (الكلمة تفتح الكهف) ومن la ruse لا من la force — وهذا هو الفرق الجوهري بينه وبين le conte de Perrault."],"sub":[{"h":"les formules magiques","p":["« Sésame, ouvre-toi ! » — la formule du conte.","l’impératif + pronom réfléchi: ouvre-toi","« Ouvre-toi ! » sans magie mais avec la même grammaire."]},{"h":"le conte enchâssé","p":["Shahrazade raconte au roi — الإطار","la mise en abyme: une histoire dans une histoire","le présent du narrateur cadre."]},{"h":"le vocabulaire de l’aventure","p":["la caverne — الكهف","le trésor — الكنز","la ruse — الحيلة"]}]},{"h":"les formules et les phrases du conte","p":["« Sésame, ouvre-toi ! » — la formule qui résume tout le conte: la parole est la clé.","« Il faut cacher notre secret à tout le monde. » — la règle de survie du récit.","« Cassim ne put se souvenir de la formule. » — la transgression qui déclenche la catastrophe.","« Ne vous fiez pas aux apparences : le plus rusé l’emporte sur le plus fort. » — la morale du conte."]},{"h":"التطبيق والتلخيص","p":["تمرين la réécoute: استمع إلى la formule عشر مرات، ثم سجّل صوتك وأنت تنطقها مع نبرة الأمر.","تمرين la variation: اكتب la formule en changeant le verbe (« Dattes, ouvrez-vous ! ») واشرح لماذا يبقى la structure grammaticale نفسها.","اكتب 120 كلمة عن la ruse de l’esclave بالفرنسية، مع استخدام le passé simple et les connecteurs (puis, ensuite, alors)."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: «Ali Baba» داخل «Les Mille et Une Nuits» يعلّمنا أن la parole تفتح الأبواب وأن la ruse تهزم la force، مع بنية le conte enchâssé: Shahrazade تروي والحكاية تتداخل داخل حكاية. أعد مشاهدة الفيديو الرئيسي وركّز على l’impératif avec pronom réfléchi « ouvre-toi » ونبرة la formule.","جسر الدروس: من b2-t9-l4 (ذات الشعر الأحمر — النسختان الفرنسية وغريم) إلى b2-t9-l5 (علي بابا والأربعون لصّاً — ألف ليلة وليلة)، ثم إلى b2-t9-l6 حيث نتابع «Les Mille et Une Nuits» مع «Aladin» و la lampe merveilleuse et l’orientalisme.","مهمة تطبيقية: أعد سرد la ruse de l’esclave في دقيقة واحدة مع تسجيل صوتك، ثم استخرج 3 كلمات جديدة من الدرس واكتب بها جملتين، وأخيراً قارن سردهك بالفيديو الرئيسي وحدّد الفرق في le rythme des répétitions."]}],"pron":[{"w":"la caverne","ipa":"[la kavɛʁn]","approx":"لا كافيرن"},{"w":"le trésor","ipa":"[lə tʁezɔʁ]","approx":"ل تريزور"},{"w":"la ruse","ipa":"[la ʁyz]","approx":"لا روز"}],"vocab":[{"fr":"la caverne","ar":"الكهف","pos":"nom","g":"f","exFr":"La caverne était pleine de trésors.","ipa":"[kavɛʁn]","exAr":"كان الكهف مليئاً بالكنوز."},{"fr":"le trésor","ar":"الكنز","pos":"nom","g":"m","exFr":"Les voleurs cachaient leur trésor dans la caverne.","ipa":"[tʁezɔʁ]","exAr":"كان اللصوص يخزّنون كنزهم في الكهف."},{"fr":"la formule","ar":"الكلمة السحرية","pos":"nom","g":"f","exFr":"La formule ouvre la porte de la caverne.","ipa":"[fɔʁmyl]","exAr":"الكلمة السحرية تفتح باب الكهف."},{"fr":"la ruse","ar":"الحيلة","pos":"nom","g":"f","exFr":"La ruse est plus forte que la violence.","ipa":"[ʁyz]","exAr":"الحيلة أقوى من العنف."},{"fr":"la stupeur","ar":"الذهول","pos":"nom","g":"f","exFr":"Ali Baba resta en stupeur devant la caverne.","ipa":"[stypœʁ]","exAr":"وقف علي بابا مذهولاً أمام الكهف."},{"fr":"les voleurs","ar":"اللصوص","pos":"nom","g":"m","exFr":"Les quarante voleurs se réunissaient chaque jour.","ipa":"[vɔlœʁ]","exAr":"كانوا اللصوص الأربعون يجتمعون كل يوم."},{"fr":"la cachette","ar":"المخبأ","pos":"nom","g":"f","exFr":"Ils trouvèrent leur cachette secrète.","ipa":"[kaʃɛt]","exAr":"وجدوا مخبأهم السري."},{"fr":"la boutique","ar":"الدكان","pos":"nom","g":"f","exFr":"Ali Baba travaille dans sa boutique.","ipa":"[butik]","exAr":"يعمل علي بابا في دكانه."},{"fr":"l’esclave","ar":"الخادمة","pos":"nom","g":"f","exFr":"L’esclave est la vraie héroïne du conte.","ipa":"[esklav]","exAr":"الخادمة هي البطلة الحقيقية للحكاية."},{"fr":"le plan","ar":"الخطة","pos":"nom","g":"m","exFr":"Elle prépare un plan pour sauver Ali Baba.","ipa":"[plɑ̃]","exAr":"تُعدّ خطة لإنقاذ علي بابا."},{"fr":"la clé","ar":"المفتاح","pos":"nom","g":"f","exFr":"La clé du succès, c’est la parole juste.","ipa":"[kle]","exAr":"مفتاح النجاح هو الكلمة المناسبة."},{"fr":"la surprise","ar":"المفاجأة","pos":"nom","g":"f","exFr":"La fin réserve une grande surprise.","ipa":"[syʁpʁiz]","exAr":"النهاية تُخفي مفاجأة كبيرة."}],"examples":[{"fr":"Sésame, ouvre-toi !","ar":"سمسم، افتحْ!","note":"la formule du conte"},{"fr":"Il y avait une caverne cachée dans la montagne.","ar":"كان هناك كهف مخبأ في الجبل.","note":"la description du cadre"},{"fr":"Ali Baba découvrit la caverne pendant qu’il coupait du bois.","ar":"اكتشف علي بابا الكهف بينما كان يقطع الحطب.","note":"l’imparfait + le passé simple"},{"fr":"L’esclave a inventé un plan pour tromper les voleurs.","ar":"ابتكرت الخادمة خطة لخداع اللصوص.","note":"la ruse contre la force"},{"fr":"Chaque nuit, Shahrazade reprend son récit.","ar":"كل ليلة تبدأ شهزاده روايتها من جديد.","note":"le présent du conte enchâssé"},{"fr":"Dans ce conte, la parole est plus puissante que l’épée.","ar":"في هذه الحكاية، الكلمة أقوى من السيف.","note":"la morale orientale"}],"grammar":[{"tFr":"L’impératif présent avec pronom réfléchi","tAr":"المضارع الأمر مع الفاعل المنعكس","body":["à l’impératif affirmatif, le pronom réfléchi se place après le verbe avec un trait d’union: « ouvre-toi ! », « dépêche-toi ! ». à la forme négative, il reste devant: « ne t’ouvre pas ! ».","la place du pronom est le critère de correction le plus souvent testé en B2 — et elle est essentielle pour réciter les formules du conte."],"ex":[{"fr":"Sésame, ouvre-toi !","ar":"سمسم، افتحْ!"},{"fr":"Ne t’ouvre devant personne d’autre.","ar":"لا تفتح أمام أحد غيره."}]},{"tFr":"Le conte enchâssé: présent pour l’encadrement, passé simple pour l’histoire","tAr":"الحكاية المتداخلة: المضارع للإطار والماضي البسيط للسرد","body":["Shahrazade parle au présent (« chaque nuit, elle commence un nouveau récit ») parce que l’encadrement est permanent, tandis qu’Ali Baba se raconte au passé simple et à l’imparfait.","ce dédoublement temporel est la signature des « Mille et Une Nuits »: deux niveaux de récit, deux séries de temps — une observation clé pour l’analyse littéraire en B2."],"ex":[{"fr":"Chaque nuit, Shahrazade reprend son récit.","ar":"كل ليلة تبدأ شهزاده روايتها من جديد."},{"fr":"Ali Baba trouva la caverne pendant qu’il coupait du bois.","ar":"وجد علي بابا الكهف بينما كان يقطع الحطب."}]}],"mistakes":[{"wrong":"« Sésame, te ouvre ! »","right":"« Sésame, ouvre-toi ! »","why":"à l’impératif affirmatif, le pronom va après le verbe avec un trait d’union."},{"wrong":"mettre tout le conte au présent","right":"présent pour l’encadrement, passé simple pour l’histoire","why":"le conte enchâssé mélange deux niveaux de temps."},{"wrong":"traduire « Mille et Une Nuits » par « 1000 nuits »","right":"« Les Mille et Une Nuits » est le titre fixe","why":"le titre français vient de la traduction de Galland."},{"wrong":"croire que la force l’emporte dans le conte","right":"la ruse et la parole mènent la victoire","why":"le conte oriental valorise l’intelligence face à la force."}],"dialogues":[{"title":"la formule magique","ctx":"devant la caverne, la première fois","lines":[{"who":"Ali Baba","fr":"Sésame, ouvre-toi !","ar":"سمسم، افتحْ!"},{"who":"Cassim","fr":"Comment as-tu ouvert cette porte ?","ar":"كيف فتحت هذه البوابة؟"},{"who":"Ali Baba","fr":"Il suffit de prononcer la formule.","ar":"يكفي أن تنطق الكلمة السحرية."},{"who":"Cassim","fr":"Je veux retenir la formule, moi aussi.","ar":"أريد أنا أيضاً أن أحفظ الكلمة السحرية."}]},{"title":"raconter aux autres","ctx":"élèves qui discutent du conte","lines":[{"who":"L’élève 1","fr":"Qu’est-ce qui rend ce conte différent des contes de Perrault ?","ar":"ما الذي يجعل هذه الحكاية مختلفة عن حكايات بيرول؟"},{"who":"L’élève 2","fr":"Il y a des formules magiques et un récit dans le récit.","ar":"فيها كلمات سحرية وحكاية داخل حكاية."},{"who":"L’élève 1","fr":"Et la morale insiste sur la ruse, pas sur la force.","ar":"والعبرة تشدد على الحيلة لا القوة."},{"who":"Le professeur","fr":"Exact : le chiffre quarante et la répétition donnent son rythme.","ar":"صحيح: الرقم أربعون والتكرار يمنحانه إيقاعه."}]}],"exercises":[{"t":"mcq","skill":"listening","q":"ما la formule qui ouvre la caverne ?","opts":["Sésame, ouvre-toi !","Porte, ferme-toi !","Ouvre la porte maintenant.","Caverne, s’il te plaît."],"a":0,"why":"la formule magique du conte."},{"t":"fill","skill":"grammar","q":"أكمل: «___, ouvre-toi !»","fr":"..., ouvre-toi !","ans":"Sésame","why":"le mot magique précède l’impératif dans la formule."},{"t":"mcq","skill":"vocabulary","q":"أي كلمة تعني «الحيلة»؟","opts":["la ruse","la clé","la surprise","la boutique"],"a":0,"why":"ruse = حيلة؛ clé = مفتاح؛ surprise = مفاجأة؛ boutique = دكان."},{"t":"order","skill":"writing","q":"رتّب: الكلمة السحرية تفتح باب الكهف","words":["La","formule","ouvre","la","porte","de","la","caverne."],"ans":"La formule ouvre la porte de la caverne.","why":"la structure sujet + verbe + complément."},{"t":"listen","skill":"listening","q":"ما الخاصية اللغوية للـ formule ?","opts":["l’impératif avec pronom réfléchi","le conditionnel de politesse","le passé simple","la négation avec ne … personne"],"a":0,"why":"« ouvre-toi » = impératif + pronom réfléchi."},{"t":"translate","skill":"writing","q":"ترجم: «سمسم، افتحْ!» إلى الفرنسية.","ans":"Sésame, ouvre-toi !","why":"la formule la plus célèbre du conte oriental."},{"t":"speaking","skill":"speaking","q":"ارفع la formule بثلاث نبرات مختلفة (أمر، مفاجأة، تكرار) واشرح الفرق.","target":"Sésame, ouvre-toi ! — d’abord comme un ordre, puis comme une découverte.","why":"la même phrase change de sens avec l’intonation."},{"t":"correct","skill":"grammar","q":"صحّح: «Sésame, te ouvre !»","ans":"Sésame, ouvre-toi !","why":"à l’impératif affirmatif, le pronom réfléchi se place après le verbe."}],"homework":"اكتب la formule en trois variantes (autre verbe + autre mot magique) ثم اشرح بالفرنسية في 80 كلمة لماذا تنجح la ruse de l’esclave ضد les voleurs.","sources":[{"title":"2 Contes des Mille et Une Nuits | Ali Baba et les 40 Voleurs + Aladin avec les P’tits z’Amis","channel":"Les P’tits z’Amis","videoId":"iYzviNIJI04","why":"حكايتان كاملتان بالفرنسية من «Les Mille et Une Nuits»: la formule « Sésame, ouvre-toi ! »، le rythme du récit، وvocabulaire l’aventure — قاعدة صوتية ممتازة للدرس.","cat":"Contes","level":"B2","main":true},{"title":"Les 1001 nuits: comment un chef d’oeuvre est né ! | L’Histoire nous le dira","channel":"L’Histoire nous le dira","videoId":"dVh4L-t2RN8","why":"تاريخ المجموعة ودور Antoine Galland في la transmission إلى الفرنسية — يثري السياق الثقافي للدرس.","cat":"Contes","level":"B2","extra":true},{"title":"Les Mille et Une Nuits | 1001 Arabian Nights in French | @FrenchFairyTales","channel":"French Fairy Tales","videoId":"eFYI_vaKFW8","why":"مقتطفات من les contes بالفرنسية الحديثة: la voix، le rythme، la ponctuation — تدريب استماع ممتاز.","cat":"Contes","level":"B2","extra":true}],"supplements":[{"id":"dVh4L-t2RN8","title":"Les 1001 nuits: comment un chef d’oeuvre est né ! | L’Histoire nous le dira","channel":"L’Histoire nous le dira","why":"تاريخ المجموعة ودور Antoine Galland في la transmission إلى الفرنسية — يثري السياق الثقافي للدرس.","lang":"fr","dur":17},{"id":"eFYI_vaKFW8","title":"Les Mille et Une Nuits | 1001 Arabian Nights in French | @FrenchFairyTales","channel":"French Fairy Tales","why":"مقتطفات من les contes بالفرنسية الحديثة: la voix، le rythme، la ponctuation — تدريب استماع ممتاز.","lang":"fr","dur":12}]},{"id":"b2-t9-l6","fr":"Aladin et la Lampe merveilleuse — Les Mille et Une Nuits","ar":"علادين واللامبة السحرية — من ألف ليلة وليلة","objectives":["تحليل la structure classique du conte: l’exposition, l’itinéraire du héros, l’épreuve, le dénouement في حكاية علادين","استيعاب 40 مفردة أساسية حول la magie, la richesse, la ruse et la générosité في les Mille et Une Nuits","التمييز بين le passé simple et l’imparfait في سرد الحكاية ثم تطبيقهما في فقرة من 80 كلمة","فهم la notion d’orientalisme ولماذا قدّمت la version française للشرق صورةً مختلفة عن la version arabe"],"sections":[{"h":"الدرس 6: علادين واللامبة السحرية في ألف ليلة وليلة","video":{"id":"r4sHypUN6w4","title":"Aladin et la Lampe Merveilleuse | Conte | Dessin Animé","channel":"Les P’tits z’Amis","why":"رسوم متحركة بالفرنسية تعرض l’histoire complète: la lampe, le génie, les épreuves مع la diction الواضحة و la narration البطيئة المناسبة لمستوى B2.","lang":"fr","main":true,"dur":11},"p":["حكاية علادين أشهر حكايات ألف ليلة وليلة، لكنها ليست في la version arabe الأصلية: أضافها Antoine Galland إلى la traduction française في القرن الثامن عشر، فصار لـ la voix du conte وجهان — la version arabe et la version française — وهذا موضوع ممتاز لـ la comparaison des versions.","المفردات المحورية: la lampe merveilleuse, le génie, les vœux, la caverne, le trésor, la fourberie, le marchand, l’épreuve, la générosité, l’orgueil, la ruse, le dénouement. اربط كل مفردة بلحظة محددة في le récit بدل حفظها معزولة.","نحوياً يعتمد le récit على l’alternance: le passé simple للأحداث المكتملة (« il prit la lampe ») و l’imparfait للحالة والوصف (« la caverne était vaste »). الافتتاحية « Il était une fois » تأتي في l’imparfait لأنها تصف un état qui dure.","Les thèmes: les trois vœux incarnent la puissance du désir، والحكاية في الوقت نفسه تضع la limite — la sagesse هي المكبح الوحيد لـ la richesse. حلّل لماذا ينتصر la ruse de la femme d’Aladin على la force du magicien.","l’orientalisme: l’Europe قرأت la région عبر le prisme de l’exotisme — les palais, la magie, les esclaves. في la version française يصبح Aladin فتى في مدينة مجهولة، بينما la tradition arabe تجعله فتى صينياً؛ la comparaison تكشف كيف تعيد la culture réceptrice تشكيل le conte.","خلاصة الدرس: la leçon du conte ليست la richesse بل la maîtrise de soi. بعد الدرس أعد سرد la scène de la caverne في ثلاث جمل: واحدة من le passé simple واثنتين من l’imparfait، ثم راجع la liaison entre les connecteurs et les temps."],"sub":[{"h":"l’ouverture du conte","p":["« Il était une fois, dans une ville lointaine, un pauvre orfèvre. »","« Le vieux marchand portait de beaux vêtements. »","« Il était une fois… » — la formule consacrée qui ouvre le récit."]},{"h":"l’apparition du génie","p":["« Que désires-tu, mon maître ? »","« Soudain, un nuage de fumée sortit de la lampe. »","« Je suis ton esclave, à toi et à la lampe. »"]},{"h":"les temps du récit","p":["le passé simple — les événements qui font avancer l’histoire","l’imparfait — le décor, les états et les habitudes","soudain, ensuite, à partir de ce jour — les connecteurs du récit"]}]},{"h":"phrases clés du conte","p":["« Il était une fois… » — l’ouverture typique du conte, toujours à l’imparfait pour poser le décor.","« Que désires-tu, mon maître ? » — le génie formule sa servitude; le tutoiement est attendu dans le conte.","« À partir de ce jour, Aladin devint riche. » — le connecteur temporel marque le basculement du récit.","« Si tu écoutes la lampe, elle t’obéira. » — la condition est le cœur même de la morale du conte."]},{"h":"التطبيق والتلخيص","p":["تمرين la réécriture: أعد كتابة la scène de la caverne في 60 كلمة مع le passé simple للأحداث و l’imparfait للوصف.","تمرين la comparaison: ضع في جدول خمس فروق بين la version arabe et la version française ajoutée par Galland.","تمرين la production: اكتب رسالة من Aladin إلى la femme d’Aladin تشرح فيها لماذا رفض la troisième demande — 90 كلمة مع خمس مفردات من la leçon."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: «Aladin» يجمع l’épreuve et le dénouement مع la leçon أن la richesse بلا la sagesse تتحوّل إلى danger، كما يكشف l’orientalisme كيف تعيد la version française تشكيل le conte. أعد مشاهدة الفيديو الرئيسي وركّز على le passé simple للأحداث و l’imparfait pour le décor في la scène de l’ouverture de la porte.","جسر الدروس: من b2-t9-l5 (علي بابا والأربعون لصّاً — ألف ليلة وليلة) إلى b2-t9-l6 (علادين واللامبة السحرية — من ألف ليلة وليلة)، ثم إلى b2-t9-l7 حيث نقارن نسخة الإخوان غريم من «Blanche-Neige» مع نسخة Disney عبر le miroir et les trois temps du récit.","مهمة تطبيقية: أعد سرد la scène de la lampe في دقيقة واحدة مع تسجيل صوتك، ثم دوّن 3 كلمات جديدة من الدرس واستعملها في فقرة قصيرة، وأخيراً قارن روايتك بالفيديو الرئيسي وحدّد الفرق في وصف le génie."]}],"pron":[{"w":"le génie","ipa":"[ʒəni]","approx":"جْيني"},{"w":"la lampe","ipa":"[lɑ̃p]","approx":"لانب"},{"w":"les vœux","ipa":"[vø]","approx":"فو"}],"vocab":[{"fr":"le génie","ar":"الجني (الكائن السحري)","pos":"nom","g":"m","exFr":"Le génie sortit de la lampe en fumée.","ipa":"[ʒəni]","exAr":"خرج الجني من اللامبة على شكل دخان."},{"fr":"la lampe merveilleuse","ar":"اللامبة السحرية","pos":"nom","g":"f","exFr":"Aladin frotta la lampe merveilleuse.","ipa":"[lɑ̃p mɛʁvəløz]","exAr":"فرك علادين اللامبة السحرية."},{"fr":"les vœux","ar":"الأمنيات المُلبّاة","pos":"nom","g":"m","exFr":"Le génie exauce trois vœux.","ipa":"[vø]","exAr":"يُلبّي الجني ثلاثة أمنيات."},{"fr":"le sorcier","ar":"الساحر","pos":"nom","g":"m","exFr":"Le sorcier convoite la lampe merveilleuse.","ipa":"[sɔʁsje]","exAr":"يطمع الساحر في اللامبة السحرية."},{"fr":"la convoitise","ar":"الطمع","pos":"nom","g":"f","exFr":"La convoitise du sorcier faillit coûter la vie à Aladin.","ipa":"[kɔ̃vwatiz]","exAr":"كاد طمع الساحر يكلّف علادين حياته."},{"fr":"la fourberie","ar":"الحيلة الخداعية","pos":"nom","g":"f","exFr":"Sa fourberie fut démasquée à la fin.","ipa":"[furbəʁi]","exAr":"انكشفت حيلته في النهاية."},{"fr":"le marchand","ar":"التاجر","pos":"nom","g":"m","exFr":"Un vieux marchand le prit pour son neveu.","ipa":"[maʁʃɑ̃]","exAr":"تاجر مسنّ ادعى أنه عمّه."},{"fr":"convoiter","ar":"يطمع في","pos":"verbe","g":"","exFr":"Il convoitait la lampe de son frère.","ipa":"[kɔ̃vwate]","exAr":"كان يطمع في لامبة أخيه."},{"fr":"se vanter","ar":"يتباهى","pos":"verbe","g":"","exFr":"Il se vanta de sa richesse devant ses amis.","ipa":"[sə vante]","exAr":"تباهى بثروته أمام أصدقائه."},{"fr":"l’épreuve","ar":"الاختبار (المحنة)","pos":"nom","g":"f","exFr":"La dernière épreuve fut la plus dure.","ipa":"[epʁœv]","exAr":"كان الاختبار الأخير الأصعب."},{"fr":"la générosité","ar":"الكرم","pos":"nom","g":"f","exFr":"Sa générosité toucha tout le village.","ipa":"[ʒeneʁɔzite]","exAr":"لمس كرمه القرية كلها."},{"fr":"l’orientalisme","ar":"النزعة الشرقية (تصور الشرق)","pos":"nom","g":"m","exFr":"Le conte français mêle récit et orientalisme.","ipa":"","exAr":"الحكاية الفرنسية تمزج السرد بنزعة شرقية."}],"examples":[{"fr":"Soudain, le génie sortit de la lampe.","ar":"فجأة خرج الجني من اللامبة.","note":"passé simple + connecteur"},{"fr":"La caverne était immense et remplie de trésors.","ar":"كان الكهف ضخماً ومليئاً بالكنوز.","note":"l’imparfait du décor"},{"fr":"À partir de ce jour, Aladin devint riche.","ar":"منذ ذلك اليوم أصبح علادين ثرياً.","note":"le basculement du récit"},{"fr":"Il ne faut pas convoiter ce que les autres possèdent.","ar":"لا ينبغي أن تطمع فيما يملكه الآخرون.","note":"la morale du conte"},{"fr":"Le vieux marchand lui dit la vérité sur la lampe.","ar":"أخبره التاجر المسنّ الحقيقة عن اللامبة.","note":"le dialogue au récit"},{"fr":"Si tu avais été sage, tu aurais gardé la lampe.","ar":"لو كنت حذراً لحافظت على اللامبة.","note":"le conditionnel passé"}],"grammar":[{"tFr":"Le passé simple et l’imparfait: la colonne vertébrale du conte","tAr":"الماضي البسيط والماضي المستمر: العمود الفقري للحكاية","body":["الحدث الأساسي في l’histoire يُسرد بالماضي البسيط — « Aladin prit la lampe », « le génie apparut » — لأنه حدث مكتمل يدفع l’intrigue إلى الأمام، وهذا هو دوره الوحيد في le récit.","بينما le décor, l’état, l’habitude تبقى في l’imparfait — « la ville était grande », « il était un pauvre orfèvre » — ولهذا تفتح la formule « Il était une fois » الحكاية بهذا الزمن: الوصف لا يبدأ ولا ينتهي، بل يمتد."],"ex":[{"fr":"Soudain, il prit la lampe et la frotta.","ar":"فجأة أخذ اللامبة وفركها."},{"fr":"Pendant ce temps, la mère regardait la scène.","ar":"في هذه الأثناء كانت الأم تشاهد المشهد."}]},{"tFr":"Les connecteurs temporels: d’abord, soudain, à partir de ce jour","tAr":"الأدوات الزمنية في السرد","body":["« d’abord, ensuite, soudain, à partir de ce jour, enfin » تربط les événements وتمنح le récit sa progression؛ بدونها يبدو السرد كقائمة حقائق بلا حياة.","« soudain » يسبق le passé simple لأنه يقتحم la scène، بينما « pendant que » يسبق l’imparfait لأنه يمتد مع le décor — الربط الصحيح بين le connecteur et le temps هو قاعدة B2 الأساسية هنا."],"ex":[{"fr":"D’abord, le marchand lui raconta son histoire, puis ils partirent.","ar":"في البداية روى له التاجر حكايته ثم انطلقا."},{"fr":"À partir de ce jour, il vécut dans un grand palais.","ar":"منذ ذلك اليوم عاش في قصر كبير."}]}],"mistakes":[{"wrong":"tout raconter au passé simple","right":"alterner passé simple et imparfait","why":"sans l’imparfait le récit devient mécanique: le décor et les états disparaissent."},{"wrong":"croire que le conte oriental décrit l’Orient tel quel","right":"analyser l’orientalisme comme un regard européen","why":"l’orientalisme est une construction de la culture réceptrice, pas une description neutre."},{"wrong":"employer le présent après « soudain »","right":"employer le passé simple","why":"« soudain » introduit l’événement du récit, qui se joue au passé."},{"wrong":"apprendre les mots sans leur scène","right":"lier chaque mot à un moment du conte","why":"la mémoire visuelle double la rétention du vocabulaire nouveau."}],"dialogues":[{"title":"la demande au génie","ctx":"Aladin devant le génie de la lampe","lines":[{"who":"le génie","fr":"Que désires-tu, mon maître ?","ar":"ماذا تتمنى يا سيدي؟"},{"who":"Aladin","fr":"Je veux un palais d’or et de pierres précieuses.","ar":"أريد قصراً من الذهب والجواهر."},{"who":"le génie","fr":"Ton premier vœu est exaucé, mais méfie-toi du troisième.","ar":"تم إجابة أمنيتك الأولى، لكن احذر الطلب الثالث."},{"who":"Aladin","fr":"Je ne demanderai rien d’autre, promis.","ar":"لن أطلب شيئاً آخر، وعد."}]},{"title":"la morale du conte","ctx":"un narrateur qui commente la fin de l’histoire","lines":[{"who":"le narrateur","fr":"À la fin, Aladin comprit que la richesse ne fait pas le bonheur.","ar":"في النهاية فهم علادين أن الثروة لا تصنع السعادة."},{"who":"l’auditeur","fr":"Exactement: le conte préfère la sagesse à la convoitise.","ar":"بالضبط: الحكاية تفضّل الحكمة على الطمع."},{"who":"le narrateur","fr":"La femme d’Aladin a joué la comédie pour sauver la lampe.","ar":"لعبت زوجة علادين دوراً لإنقاذ اللامبة."},{"who":"l’auditeur","fr":"Le génie n’était pas méchant: il obéissait simplement à la lampe.","ar":"لم يكن الجني شريراً، بل كان يطيع اللامبة فحسب."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"أي مفردة تعني «الطمع في ما يملكه الآخرون»؟","opts":["la convoitise","la caverne","la lampe","le trésor"],"a":0,"why":"la convoitise / convoiter = الطمع، وهو محور la morale du conte."},{"t":"fill","skill":"grammar","q":"أكمل: «Il ___ une fois un pauvre orfèvre.»","fr":"Il ... une fois un pauvre orfèvre.","ans":"était","why":"« Il était une fois » تفتتح le conte à l’imparfait لأنها تصف un état."},{"t":"order","skill":"writing","q":"رتّب الجملة: فجأة خرج الجني من اللامبة","words":["Soudain","le","génie","sortit","de","la","lampe."],"ans":"Soudain le génie sortit de la lampe.","why":"« soudain » يسبق le passé simple: le connecteur + l’événement."},{"t":"listen","skill":"listening","q":"ما la réplique التي ينطقها le génie عند ظهوره؟","opts":["Que désires-tu, mon maître ?","Où est la caverne ?","Le marchand est parti.","Il était une fois un roi."],"a":0,"why":"la formule de servitude du génie: « Que désires-tu, mon maître ? »"},{"t":"translate","skill":"writing","q":"ترجم إلى الفرنسية: «منذ ذلك اليوم أصبح علادين ثرياً.»","ans":"À partir de ce jour, Aladin devint riche.","why":"« à partir de ce jour » + le passé simple = le basculement du récit."},{"t":"speaking","skill":"speaking","q":"ألقِ la réplique du génie بنبرة هادئة ومهيبة مع الحفاظ على le tutoiement.","target":"Que désires-tu, mon maître ?","why":"القواعد داخل le conte: le tutoiement et le respect du héros."},{"t":"correct","skill":"grammar","q":"صحّح: «Le génie a sorti de la lampe.»","ans":"Le génie est sorti de la lampe.","why":"sortir fait partie des verbes de mouvement qui se conjuguent avec l’auxiliaire être au passé composé."},{"t":"mcq","skill":"analysis","q":"ما الفرق الجوهري بين la version arabe et la version française de Galland؟","opts":["La version française ajoute l’exotisme oriental","La version arabe ignore la lampe","Les deux versions sont identiques","La version française supprime le génie"],"a":0,"why":"l’orientalisme: la culture réceptrice redessine le conte selon ses attentes."}],"homework":"شاهد la vidéo du conte sans sous-titres، اكتب خمس جمل في le passé simple وثلاثاً في l’imparfait، ثم صحّحها بنفسك بالرجوع إلى la règle du décor et de l’événement، وأخيراً قارن نتيجتك مع la version arabe في فقرة من 60 كلمة.","sources":[{"title":"Aladin et la Lampe Merveilleuse | Conte | Dessin Animé","channel":"Les P’tits z’Amis","videoId":"r4sHypUN6w4","why":"رسوم متحركة بالفرنسية تعرض l’histoire complète: la lampe, le génie, les épreuves مع la diction الواضحة و la narration البطيئة المناسبة لمستوى B2.","cat":"Contes","level":"B2","main":true},{"title":"01- Les Mille et Une Nuits (Introduction) - Contes arabes - conte pour dormir","channel":"La Fée de Minuit","videoId":"rgS41Q7l8rU","why":"تقديم la cadre narratif لـ les Mille et Une Nuits وشهرزاد: أصل le récit cadre قبل علادين.","cat":"Contes","level":"B2","extra":true},{"title":"Les contes des 1001 nuits : Shéhérazade","channel":"RAWI","videoId":"_f3pSpPXEGA","why":"تحليل مكثّف لـ la technique de Shéhérazade: كيف تبني la suspense في le récit.","cat":"Contes","level":"B2","extra":true}],"supplements":[{"id":"rgS41Q7l8rU","title":"01- Les Mille et Une Nuits (Introduction) - Contes arabes - conte pour dormir","channel":"La Fée de Minuit","why":"تقديم la cadre narratif لـ les Mille et Une Nuits وشهرزاد: أصل le récit cadre قبل علادين.","lang":"fr","dur":38},{"id":"_f3pSpPXEGA","title":"Les contes des 1001 nuits : Shéhérazade","channel":"RAWI","why":"تحليل مكثّف لـ la technique de Shéhérazade: كيف تبني la suspense في le récit.","lang":"fr","dur":3}]},{"id":"b2-t9-l7","fr":"Blanche-Neige — les frères Grimm","ar":"بياض الثلج — الإخوان غريم","objectives":["تحليل la structure du conte: l’état initial, le danger, l’exil, le retour du héros","استيعاب 40 مفردة حول le miroir, la beauté, la jalousie, les nains et la pomme","تمييز les trois temps du récit: imparfait, passé simple, plus-que-parfait dans le récit enchâssé","مقارنة la version des frères Grimm (1812) مع la version Disney وla moralité de la fable"],"sections":[{"h":"الدرس 7: بياض الثلج عند الإخوان غريم — المرايا والنسخ المقارنة","video":{"id":"GsUI-ZnOtag","title":"Blanche-Neige (Frères Grimm) | Conte Original Complet","channel":"Moonlight Kingdom FRANÇAIS","why":"رواية كاملة للنص الأصلي عند الإخوان غريم بلا إضافات Disney، وهو ما يسمح بـ la comparaison des versions مع la version animation connue.","lang":"fr","main":true,"dur":8},"p":["La Blanche-Neige des frères Grimm نُشرت سنة 1812 في la collection de contes allemands، وجذورها شفهية أقدم منها بكثير. حين نحلل le conte، ندرس في الحقيقة ثلاث طبقات: la tradition orale, la version écrite savante, la version cinématographique.","المفردات المحورية: le miroir, la beauté, la jalousie, la marâtre, les sept nains, la pomme, le cercueil de verre, la forêt, le déguisement, la méfiance, la candeur, le désespoir. لاحظ أن la plupart من هذه الكلمات تخدم le thème unique: la beauté وخطرها.","نحوياً يعيد le récit بناء الزمن في ثلاثة مستويات: plus-que-parfait لـ la backstory (« la reine avait été la plus belle »)، passé simple للأحداث (« elle mangea la pomme »)، imparfait للوصف والعادة (« chaque jour, elle revenait »). هذه la règle الذهبية في la lecture des contes.","Les thèmes: la jalousie نابعة من la vanité لا من la laideur، ولهذا يعاقب le conte la reine على قسوتها ولا على شكلها. النقاء يظهر في la candeur de Blanche-Neige: هي تفتح الباب لأنها لا تعرف الخوف.","la comparaison des versions: la version Grimm أقسى وأكثر صرامة في la morale، بينما la version Disney تضيف les chansons et un prince parlant. المفارقة أن la version animée حذفت مشاهد كثيرة لتصبح مناسبة للأطفال — ولهذا يُقال إن le conte يُروى بعدة أصوات.","خلاصة الدرس: le miroir ليست أداة سحرية بل رمز la conscience collective: هي تقول la vérité وتصنع la jalousie. بعد الدرس، أعد رواية la scène du miroir في سبعين كلمة مع استخدام les trois temps du récit."],"sub":[{"h":"le miroir magique","p":["« Miroir, miroir, qui est la plus belle du royaume ? »","« Toi, ma reine, tu es la plus belle. »","« Le miroir dit la vérité, mais il blesse la reine. »"]},{"h":"la fuite dans la forêt","p":["« Courez, courez, mes chers amis ! »","La princesse courut à travers la forêt.","« Les sept nains lui offrirent un asile. »"]},{"h":"les temps du récit","p":["« La reine avait été la plus belle. » — le plus-que-parfait","« Elle mangea la pomme. » — le passé simple","« Chaque jour, elle revenait. » — l’imparfait de la fréquence"]}]},{"h":"phrases clés du conte","p":["« Miroir, miroir, qui est la plus belle du royaume ? » — la question répétée structure tout le conte.","« Tu es la plus belle, mais une princesse encore plus belle vit dans la forêt. » — la vérité déclenche le conflit.","« Si tu fais la cuisine et le ménage, tu peux rester. » — le marché conclu avec les nains.","« Elle était si belle que les oiseaux se posaient sur son épaule. » — l’imparfait du portrait."]},{"h":"التطبيق والتلخيص","p":["تمرين la comparaison: اكتب خمس جمل تصف la version Grimm ثم خمساً لـ la version Disney وحدّد le ton في كل واحدة.","تمرين la restitution: أعد رواية la scène du miroir في 70 كلمة بـ le plus-que-parfait et le passé simple.","تمرين la réflexion: اكتب فقرة من 80 كلمة تشرح فيها لماذا يعاقب le conte la reine على la jalousie وليس على la laideur."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: «Blanche-Neige» عند الإخوان غريم تُبنى على le miroir الذي يقول la vérité وعلى la jalousie التي يعاقبها le conte؛ والدرس أن la version originale تسبق Disney وأن les trois temps du récit تمنح le conte عمقه. أعد مشاهدة الفيديو الرئيسي وركّز على le plus-que-parfait في la backstory ثم le passé simple dans les événements.","جسر الدروس: من b2-t9-l6 (علادين واللامبة السحرية — من ألف ليلة وليلة) إلى b2-t9-l7 (بياض الثلج — الإخوان غريم)، ثم إلى b2-t9-l8 حيث تنتقل الحكاية إلى الشمال مع «La Reine des neiges» عند Andersen وتظهر la symbolique de la neige, de la rose et du fleuve.","مهمة تطبيقية: أعد سرد la scène du miroir في دقيقة واحدة مع تسجيل صوتك، ثم استخرج 3 كلمات جديدة من الدرس واكتب بها جملتين، وأخيراً قارن روايتك بالفيديو الرئيسي وحدّد الفرق في le ton entre la version Grimm و la version Disney."]}],"pron":[{"w":"le miroir","ipa":"[miwaʁ]","approx":"ميْوار"},{"w":"la pomme","ipa":"[pɔm]","approx":"بوم"},{"w":"les nains","ipa":"[nɛ]","approx":"نان"}],"vocab":[{"fr":"le miroir","ar":"المرآة","pos":"nom","g":"m","exFr":"Le miroir dit la vérité à la reine.","ipa":"[miwaʁ]","exAr":"تقول المرآة الحقيقة للملكة."},{"fr":"la beauté","ar":"الجمال","pos":"nom","g":"f","exFr":"Sa beauté éclaire tout le royaume.","ipa":"[bœlte]","exAr":"جمالها يُضيء المملكة كلها."},{"fr":"la jalousie","ar":"الغيرة (الحسد)","pos":"nom","g":"f","exFr":"La jalousie dévore la reine.","ipa":"[ʒaluzi]","exAr":"الغيرة تنهش الملكة."},{"fr":"la marâtre","ar":"الزوجة الثانية (الزَّمَّة)","pos":"nom","g":"f","exFr":"La marâtre ordonna de chasser la princesse.","ipa":"[maʁatʁ]","exAr":"أمرت الزوجة الثانية بطرد الأميرة."},{"fr":"les sept nains","ar":"الأقزام السبعة","pos":"nom","g":"m","exFr":"Les sept nains travaillent dans la mine.","ipa":"[sɛ nɛ]","exAr":"يعمل الأقزام السبعة في المنجم."},{"fr":"la pomme","ar":"التفاحة","pos":"nom","g":"f","exFr":"La pomme était rouge d’un côté et blanche de l’autre.","ipa":"[pɔm]","exAr":"كانت التفاحة حمراء من جهة وبيضاء من الأخرى."},{"fr":"empoisonner","ar":"يُسمّم","pos":"verbe","g":"","exFr":"La reine empoisonna le fruit avant de le donner.","ipa":"","exAr":"سمّمت الملكة الثمرة قبل أن تُعطيها."},{"fr":"épargner","ar":"يُبقي حياً ويترافع عن","pos":"verbe","g":"","exFr":"Le chasseur épargna Blanche-Neige dans la forêt.","ipa":"[epaʁɲe]","exAr":"ترافع الصيّاد عن بياض الثلج في الغابة."},{"fr":"la candeur","ar":"الصفاء والبساطة","pos":"nom","g":"f","exFr":"Sa candeur la poussa à ouvrir la porte.","ipa":"[kɑ̃dœʁ]","exAr":"دفعها صفاؤها إلى فتح الباب."},{"fr":"le cercueil de verre","ar":"تابوت الزجاج","pos":"nom","g":"m","exFr":"Les nains déposèrent la princesse dans un cercueil de verre.","ipa":"","exAr":"وضع الأقزام الأميرة في تابوت من الزجاج."},{"fr":"le déguisement","ar":"التنكّر (التمويه)","pos":"nom","g":"m","exFr":"La reine prit un déguisement de vieille femme.","ipa":"[deɡuizmɑ̃]","exAr":"تنكّلت الملكة بزيّ امرأة مسنّة."},{"fr":"le désespoir","ar":"اليأس","pos":"nom","g":"m","exFr":"Elle sombra dans le désespoir.","ipa":"[dezɛspwaʁ]","exAr":"غرقت في اليأس."}],"examples":[{"fr":"Le miroir dit la vérité, mais il blesse la reine.","ar":"تقول المرآة الحقيقة، لكنها تجرح الملكة.","note":"la vérité et ses conséquences"},{"fr":"Avant l’arrivée de la princesse, la reine avait été la plus belle.","ar":"قبل وصول الأميرة، كانت الملكة هي الأجمل.","note":"le plus-que-parfait"},{"fr":"Chaque jour, elle posait la même question au miroir.","ar":"كل يوم كانت تطرح السؤال نفسه على المرآة.","note":"l’imparfait de la fréquence"},{"fr":"La version Grimm est sombre, alors que la version Disney est optimiste.","ar":"نسخة غريم قاتمة، بينما نسخة ديزني متفائلة.","note":"la comparaison des versions"},{"fr":"Les nains lui demandèrent de rester et de travailler.","ar":"طلب منها الأقزام أن تبقى وتعمل.","note":"la proposition avec infinif"},{"fr":"Elle fut trouvée dans un cercueil de verre par le prince.","ar":"وجدها الأمير في تابوت من الزجاج.","note":"la voix passive du conte"}],"grammar":[{"tFr":"Les trois temps du récit: imparfait, passé simple, plus-que-parfait","tAr":"الزمن الثلاثي للسرد: الماضي المستمر والبسيط والسابق","body":["le plus-que-parfait يفتح la backstory: « la reine avait été la plus belle » — حدث سابق لـ le récit الأساسي ويشرح le motif de la jalousie قبل أن تبدأ l’intrigue.","القاعدة العملية: le récit avance au passé simple، la situation والوصف يبقى l’imparfait، والماضي السابق narratif يُصرَّف بالplus-que-parfait — ثلاثة مستويات في la même histoire، وهي ما يجعل le conte profond."],"ex":[{"fr":"Avant l’arrivée de la princesse, la reine avait été la plus belle.","ar":"قبل وصول الأميرة، كانت الملكة هي الأجمل."},{"fr":"Chaque matin, elle se tenait devant le miroir.","ar":"كل صباح كانت تقف أمام المرآة."}]},{"tFr":"Les connecteurs de comparaison entre les versions","tAr":"أدوات المقارنة بين النسخ المختلفة","body":["« en revanche, par contre, alors que, contrairement à, d’une part… d’autre part » تبني la comparaison: لا يمكن نقاش les versions بدونها، لأنها تربط بين حرفين من la même histoire.","« alors que » + indicatif تضع فعلين في مواجهة، بينما « contrairement à » + nom تعارض حقيقةً بحقيقة؛ la nuance بينهما هي الفارق بين la phrase و la proposition."],"ex":[{"fr":"La version Grimm est sombre, alors que la version Disney est optimiste.","ar":"نسخة غريم قاتمة، بينما نسخة ديزني متفائلة."},{"fr":"Contrairement au miroir des frères Grimm, le miroir de Disney parle peu.","ar":"على عكس مرآة الإخوان غريم، مرآة ديزني تتحدث قليلاً."}]}],"mistakes":[{"wrong":"confondre l’imparfait et le plus-que-parfait","right":"réserver le plus-que-parfait au passé du récit","why":"« la reine avait été belle » se situe avant le récit principal, donc avant le passé simple."},{"wrong":"croire que la version Disney est la version originale","right":"la version des frères Grimm (1812) fait référence","why":"Disney transforme le conte: personnages ajoutés, ton adouci, morale allégée."},{"wrong":"dire « elle est mort de la faim »","right":"elle est morte: le participe s’accorde avec le sujet","why":"avec l’auxiliaire être, le participe passé s’accorde en genre et en nombre."},{"wrong":"raconter le conte uniquement au présent","right":"alterner passé simple, imparfait et plus-que-parfait","why":"le présent ne sert qu’à la métadiscours: « le narrateur explique que… »."}],"dialogues":[{"title":"le miroir parle","ctx":"la reine et son miroir magique","lines":[{"who":"la reine","fr":"Miroir, miroir, qui est la plus belle du royaume ?","ar":"مرآتي، من أجمل الناس في المملكة؟"},{"who":"le miroir","fr":"Toi, ma reine, tu es la plus belle.","ar":"أنتِ يا ملكتي، أنتِ الأجمل."},{"who":"la reine","fr":"Et la princesse qui vit dans la forêt ?","ar":"وماذا عن الأميرة التي تسكن الغابة؟"},{"who":"le miroir","fr":"Elle est encore plus belle que toi.","ar":"إنها أجمل منكِ حتى."}]},{"title":"les sept nains accueillent la princesse","ctx":"devant la petite maison de la forêt","lines":[{"who":"un des nains","fr":"Qui es-tu ? Que fais-tu dans notre maison ?","ar":"من أنتِ؟ ماذا تفعلين في بيتنا؟"},{"who":"Blanche-Neige","fr":"Je suis une princesse, et je cherche un abri.","ar":"أنا أميرة، وأبحث عن مأوى."},{"who":"un des nains","fr":"Si tu fais la cuisine et le ménage, tu peux rester.","ar":"إذا طبختِ ونظّفتِ فتستطيع البقاء."},{"who":"Blanche-Neige","fr":"Je vous promets d’être sage et travailleuse.","ar":"أعدكم بأن أكون حكيمة ومثمرة."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"أي مفردة تعني «الغيرة»؟","opts":["la jalousie","la beauté","la pomme","la forêt"],"a":0,"why":"la jalousie = الغيرة، وهي le mobile de l’intrigue."},{"t":"fill","skill":"grammar","q":"أكمل: «Avant l’arrivée de la princesse, la reine ___ la plus belle.»","fr":"Avant l’arrivée de la princesse, la reine ... la plus belle.","ans":"avait été","why":"le plus-que-parfait exprime le passé antérieur au récit: elle l’avait été avant."},{"t":"order","skill":"writing","q":"رتّب: وضع الأقزام الأميرة في تابوت من الزجاج","words":["Les","sept","nains","déposèrent","la","princesse","dans","un","cercueil","de","verre."],"ans":"Les sept nains déposèrent la princesse dans un cercueil de verre.","why":"sujet + passé simple + COD: l’ordre standard de la phrase narrative."},{"t":"listen","skill":"listening","q":"ما la question التي تكررها la reine devant le miroir ?","opts":["Miroir, miroir, qui est la plus belle du royaume ?","Où se trouve la forêt ?","Pourquoi pleurent les nains ?","Qui a mangé la pomme ?"],"a":0,"why":"la formule répétée structure le conte et déclenche la jalousie."},{"t":"translate","skill":"writing","q":"ترجم: «المرآة تقول الحقيقة لكنها تجرح الملكة.»","ans":"Le miroir dit la vérité, mais il blesse la reine.","why":"« dire la vérité » locution figée; la conséquence s’exprime avec « mais »."},{"t":"speaking","skill":"speaking","q":"انطق la formule du miroir بنبرة رسمية مع إبطاء واضح في la question.","target":"Miroir, miroir, qui est la plus belle du royaume ?","why":"la répétition et l’intonation donnent au conte son rythme."},{"t":"correct","skill":"grammar","q":"صحّح: «Elle est allé à la maison des nains.»","ans":"Elle est allée à la maison des nains.","why":"avec l’auxiliaire être, le participe passé s’accorde avec le sujet féminin: allée."},{"t":"mcq","skill":"analysis","q":"ما la différence essentielle بين la version Grimm و la version Disney؟","opts":["Disney adoucit le ton et ajoute des personnages","Grimm supprime la reine","Les deux versions sont identiques","Disney ignore la forêt"],"a":0,"why":"les versions comparées: même intrigue, ton et morale transformés."}],"homework":"شاهد la vidéo du conte original ثم قارنها بلقطة من la version Disney: اكتب عشر جمل تصف الفروق، صنّف كل جملة حسب le temps du récit المستخدم (imparfait / passé simple / plus-que-parfait)، وأرفقها بـ la morale que chaque version souligne.","sources":[{"title":"Blanche-Neige (Frères Grimm) | Conte Original Complet","channel":"Moonlight Kingdom FRANÇAIS","videoId":"GsUI-ZnOtag","why":"رواية كاملة للنص الأصلي عند الإخوان غريم بلا إضافات Disney، وهو ما يسمح بـ la comparaison des versions مع la version animation connue.","cat":"Contes","level":"B2","main":true},{"title":"BLANCHE-NEIGE : LA SOMBRE HISTOIRE QUE DISNEY NOUS A CACHÉE","channel":"Theophannya","videoId":"aN160ld35Yo","why":"la comparaison détaillée بين la version Disney و le texte original: جوهر درس les versions comparées.","cat":"Contes","level":"B2","extra":true},{"title":"CHARLES PERRAULT : les origines des contes du Grand Siècle français | Histoire pour Dormir","channel":"Voyages Endormis","videoId":"pcoFQyI-fRs","why":"جذور le conte de fées français في le Grand Siècle: كيف وُلدت la moralité et la structure du conte écrit.","cat":"Contes","level":"B2","extra":true}],"supplements":[{"id":"aN160ld35Yo","title":"BLANCHE-NEIGE : LA SOMBRE HISTOIRE QUE DISNEY NOUS A CACHÉE","channel":"Theophannya","why":"la comparaison détaillée بين la version Disney و le texte original: جوهر درس les versions comparées.","lang":"fr","dur":12},{"id":"pcoFQyI-fRs","title":"CHARLES PERRAULT : les origines des contes du Grand Siècle français | Histoire pour Dormir","channel":"Voyages Endormis","why":"جذور le conte de fées français في le Grand Siècle: كيف وُلدت la moralité et la structure du conte écrit.","lang":"fr","dur":103}]},{"id":"b2-t9-l8","fr":"La Reine des neiges — Hans Christian Andersen","ar":"ملكة الثلج — هانس كريستيان أندرسن","objectives":["تحليل la relation entre Gerda et Kay: la force de l’amitié dans le récit","استيعاب 40 مفردة حول le froid, le cœur, la glace, l’amitié et la fidélité","تمييز les propositions relatives (qui, que, dont, où) في وصف الشخصيات والأماكن","فهم la symbolique nordique: la neige, la rose, le fleuve et le pardon chez Andersen"],"sections":[{"h":"الدرس 8: ملكة الثلج عند أندرسن — الصداقة والقلب المتجمّد","video":{"id":"1YclUCnLghM","title":"La Reine des Neiges – d’après Hans Christian Andersen (1844)","channel":"Le Miroir des Contes","why":"سرد كامل للحكاية مع la voix posée و la diction النظيفة: يُناسب la compréhension écrite et la mémorisation des structures de la description.","lang":"fr","main":true,"dur":25},"p":["Andersen نشر la Reine des neiges سنة 1844، وهو contour le conte populaire: الحكاية مكتوبة بقلم كاتب دانيمركي، ولهذا le style مليء par les sentiments et par le symbole بدل la formule répétée du conte oral.","المفردات المحورية: le cœur, la neige, le flocon, geler, se dégeler, la fidélité, l’amitié, la prière, la rose, le chagrin, l’éclat de miroir, le voyage. لاحظ أن la plupart des mots تقع بين محورين: la froideur et la chaleur.","نحوياً la description تعتمد على les propositions relatives: « la fille qui cherchait », « le garçon dont le cœur était gelé », « la ville où la neige tombait ». هي la première outil pour construire des phrases longues en français.","Les thèmes: le miroir d’Andersen ne montre que le mal — « l’éclat » يكسر la légèreté de Kay — وla conclusion أن la prière et la mémoire هما ما يُذيب la glace. l’amitié de Gerda تعمل بلا توقف: c’est elle qui parle, qui marche, qui prie.","la symbolique danoise: la neige = la dureté et l’indifférence، la rose = la mémoire vivante، le fleuve = le chemin du pardon، et la couronne de roses = l’amour qui survit au froid. Dans la culture nordique، le froid ليس عدواً بل la condition التي يُقاس عليها la chaleur humaine.","خلاصة الدرس: le conte nous apprend que le cœur ne se sauve pas par la force mais par la constance. بعد الدرس، صف Kay قبل la scène du miroir وبعدها في فقرتين، كل واحدة في 60 كلمة مع les propositions relatives."],"sub":[{"h":"le miroir maléfique","p":["« Le miroir ne montre que le mal. »","« Un éclat de miroir perça le cœur de Kay. »","« À partir de ce jour, il ne riait plus. »"]},{"h":"l’amitié de Gerda","p":["« Kay, reviens à la maison ! »","Gerda chercha partout, dans la neige et le vent.","« Son cœur était chaud, malgré le froid. »"]},{"h":"les symboles du conte","p":["la neige — la dureté et l’indifférence","la rose — la mémoire et l’amitié","le fleuve — le voyage et le pardon"]}]},{"h":"phrases clés du conte","p":["« Kay, reviens à la maison ! » — la prière de Gerda ouvre tout le voyage.","« Son cœur n’était pas gelé tout à fait. » — la preuve que l’amitié résiste au froid.","« Les larmes de Gerda fondirent la glace. » — l’eau vainc la glace: le symbole central.","« Elles trouvèrent les roses dans la serre. » — la rose est la mémoire vivante du conte."]},{"h":"التطبيق والتلخيص","p":["تمرين la description: صِف Kay قبل la scène du miroir وبعدها بجملتين تستخدمان qui و dont و où.","تمرين la réécoute: استمع إلى la narration واحفظ أربع جمل تصف la neige و la rose في la même histoire.","تمرين la production: اكتب فقرة من 80 كلمة تشرح فيها كيف أنقذت la prière de Gerda le cœur gelé de Kay."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: «La Reine des neiges» تعلّمنا أن le cœur ne se sauve pas par la force mais par la constance: les larmes de Gerda fondent la glace، و la rose تبقى la mémoire vivante du conte. أعد مشاهدة الفيديو الرئيسي وركّز على les propositions relatives (qui, que, dont, où) في وصف le voyage et les personnages.","جسر الدروس: من b2-t9-l7 (بياض الثلج — الإخوان غريم) إلى b2-t9-l8 (ملكة الثلج — هانس كريستيان أندرسن)، ثم إلى b2-t9-l9 حيث يعود le récit إلى إيطاليا مع «Pinocchio» وتظهر la faute, la punition et la métamorphose du mensonge.","مهمة تطبيقية: أعد سرد رحلة Gerda في دقيقة واحدة مع تسجيل صوتك، ثم دوّن 3 كلمات جديدة من الدرس واستعملها في جمل، وأخيراً قارن روايتك بالفيديو الرئيسي وحدّد الفرق في la symbolique de la neige."]}],"pron":[{"w":"le cœur","ipa":"[kœʁ]","approx":"كور"},{"w":"la neige","ipa":"[nɛʒ]","approx":"نيج"},{"w":"le flocon","ipa":"[flɔkɔ̃]","approx":"فلوكون"}],"vocab":[{"fr":"la glace","ar":"الجليد","pos":"nom","g":"f","exFr":"Les larmes de Gerda fondirent la glace autour de Kay.","ipa":"[ɡlas]","exAr":"أذابت دموع غيردا الجليد حول كاي."},{"fr":"la neige","ar":"الثلج","pos":"nom","g":"f","exFr":"La neige couvrait toute la ville.","ipa":"[nɛʒ]","exAr":"غطى الثلج المدينة كلها."},{"fr":"le flocon","ar":"رقاقة الثلج","pos":"nom","g":"m","exFr":"Un flocon se posa sur la fenêtre.","ipa":"[flɔkɔ̃]","exAr":"استقرت رقاقة ثلج على النافذة."},{"fr":"geler","ar":"يُجمّد / يتجمّد","pos":"verbe","g":"","exFr":"Le froid gela le fleuve en une nuit.","ipa":"[ʒəle]","exAr":"جمّد البرد النهر في ليلة واحدة."},{"fr":"se dégeler","ar":"يذوب / يتدفّى","pos":"verbe","g":"","exFr":"Le cœur de Kay commença à se dégeler.","ipa":"[sə deʒəle]","exAr":"بدأ قلب كاي يذوب."},{"fr":"la fidélité","ar":"الوفاء","pos":"nom","g":"f","exFr":"La fidélité de Gerda toucha la princesse.","ipa":"[fidelite]","exAr":"أثر وفاء غيردا في الأميرة."},{"fr":"l’amitié","ar":"الصداقة","pos":"nom","g":"f","exFr":"L’amitié a vaincu le froid.","ipa":"[amitje]","exAr":"انتصرت الصداقة على البرد."},{"fr":"la prière","ar":"الدعاء","pos":"nom","g":"f","exFr":"Sa prière fut exaucée au matin.","ipa":"[pʁijɛʁ]","exAr":"أُجِيب دعاؤه في الصباح."},{"fr":"le fleuve","ar":"النهر الكبير","pos":"nom","g":"m","exFr":"Le fleuve porta Gerda jusqu’au royaume de la neige.","ipa":"[flœv]","exAr":"حمل النهر غيردا حتى مملكة الثلج."},{"fr":"se moquer de","ar":"يسخر من","pos":"verbe","g":"","exFr":"Les autres enfants se moquaient de lui.","ipa":"","exAr":"كان الأطفال الآخرون يسخرون منه."},{"fr":"le chagrin","ar":"الحزن","pos":"nom","g":"m","exFr":"Il tomba dans un grand chagrin.","ipa":"[ʃaɡʁɛ̃]","exAr":"غاص في حزن شديد."},{"fr":"l’éclat de miroir","ar":"شظية المرآة","pos":"nom","g":"m","exFr":"Un éclat de miroir s’était glissé dans son cœur.","ipa":"","exAr":"تسلّلت شظية مرآة إلى قلبه."}],"examples":[{"fr":"Gerda était la fille qui ne perdait jamais espoir.","ar":"كانت غيردا الفتاة التي لا تفقد الأمل أبداً.","note":"la relative sujet"},{"fr":"Ils arrivèrent dans la ville où la neige ne fondait pas.","ar":"وصلوا إلى مدينة لم يكن الثلج يذوب فيها.","note":"la relative de lieu"},{"fr":"Le miroir était empoisonné, car il ne montrait que le mal.","ar":"كانت المرآة مسمومة، لأنه لم تُظهر سوى الشر.","note":"la cause avec « car »"},{"fr":"La rose se rappela de lui, si bien que le cœur se dégela.","ar":"تذكّرت الوردة صاحبها حتى ذاب القلب.","note":"la conséquence"},{"fr":"Kay, reviens à la maison, il fait si froid ici !","ar":"كاي، عُد إلى البيت، إن الجو بارد جداً هنا!","note":"l’impératif du récit"},{"fr":"C’est la fidélité de Gerda qui sauva le cœur gelé.","ar":"وفاء غيردا هو ما أنقذ القلب المتجمّد.","note":"la cleft sentence"}],"grammar":[{"tFr":"Les propositions relatives: qui, que, dont, où","tAr":"الجمل الوصفية الموصولة في الفرنسية","body":["qui remplace le sujet, que le COD, dont la chose ou la personne dont on parle, où le lieu ou le temps: هذه الأدوات الأربع تكفي لوصف les personnages et les décors داخل le récit.","في la description نستعمل « la fille qui cherchait son ami », « le garçon dont le cœur était gelé », « la ville où la neige tombait » — la relative تختصر جملتين في واحدة وتمنح le style sa profondeur."],"ex":[{"fr":"Gerda était la fille qui ne perdait jamais espoir.","ar":"كانت غيردا الفتاة التي لا تفقد الأمل أبداً."},{"fr":"Ils retrouvèrent le jardin dont les roses parfumaient l’air.","ar":"وجدوا الحديقة التي عبّرَت ورودها الهواء."}]},{"tFr":"L’expression de la cause et de la conséquence","tAr":"التعبير عن السبب والنتيجة","body":["« parce que, car, puisque » تدل على la cause، و « c’est pourquoi, donc, si bien que » تدل على la conséquence: la nuance B2 أن « car » أكثر أدبية ويظهر كثيراً في le conte.","« si bien que » + indicatif تربط نتيجة بفعل سابق: la phrase تصبح جملة سبب ونتيجة واحدة، وهو ما يسمح ببناء le raisonnement dans l’explication du conte."],"ex":[{"fr":"Le miroir était empoisonné, car il ne montrait que le mal.","ar":"كانت المرآة مسمومة، لأنه لم تُظهر سوى الشر."},{"fr":"Gerda pria si bien que la glace se fendit.","ar":"صَلَّت غيردا حتى انشقّ الجليد."}]}],"mistakes":[{"wrong":"ne pas accorder le verbe de la relative","right":"la fille qui cherche / les filles qui cherchent","why":"le verbe de la relative s’accorde avec le nom qu’elle reprend, pas avec « qui »."},{"wrong":"croire que le conte d’Andersen est un conte populaire anonyme","right":"c’est un conte littéraire d’un auteur danois","why":"Andersen écrit au XIXe siècle: le style est personnel et symbolique, pas transmis par la tradition."},{"wrong":"employer « à cause de » pour toutes les causes","right":"varier avec « car », « puisque » et « parce que »","why":"« à cause de » porte souvent un sens négatif et son abus alourdit la phrase."},{"wrong":"traduire « se dégeler » par « se refroidir »","right":"dégeler = perdre le gel, fondre","why":"la confusion inverse le sens même du conte: le cœur doit se réchauffer."}],"dialogues":[{"title":"la recherche de Kay","ctx":"Gerda et la vieille femme qui aime la neige","lines":[{"who":"Gerda","fr":"Savez-vous où se cache mon ami Kay ?","ar":"هل تعرفين أين يختفي صديقي كاي؟"},{"who":"la vieille","fr":"Il est parti avec la reine des neiges, là-haut.","ar":"ذهب مع ملكة الثلج، إلى هناك."},{"who":"Gerda","fr":"Je le retrouverai, même dans la glace.","ar":"سأجده حتى داخل الجليد."},{"who":"la vieille","fr":"Alors prends cette rose, elle te guidera.","ar":"خذ هذه الوردة، فهي ستَرشدك."}]},{"title":"le dégel du cœur","ctx":"Gerda retrouve Kay sur la place","lines":[{"who":"Gerda","fr":"Tes larmes fondent la glace, Kay.","ar":"دموعك تذيب الجليد يا كاي."},{"who":"Kay","fr":"Je ne voyais que le froid depuis ce jour.","ar":"لم أرَ سوى البرد منذ ذلك اليوم."},{"who":"Gerda","fr":"Mais ton cœur battait encore, je le sais.","ar":"لكن قلبك كان ينبض بعد، أنا أعلم ذلك."},{"who":"Kay","fr":"Ramenons-nous à la maison, Gerda.","ar":"لنعُد إلى البيت يا غيردا."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"أي مفردة تعني «الوفاء»؟","opts":["la fidélité","la neige","la rose","le fleuve"],"a":0,"why":"la fidélité = الوفاء، وهي صفة Gerda الرئيسية."},{"t":"fill","skill":"grammar","q":"أكمل: «Gerda était la fille ___ ne perdait jamais espoir.»","fr":"Gerda était la fille ... ne perdait jamais espoir.","ans":"qui","why":"« qui » remplace le sujet du verbe de la relative."},{"t":"order","skill":"writing","q":"رتّب: دموع غيردا أذابت الثلج","words":["Les","larmes","de","Gerda","fondirent","la","glace."],"ans":"Les larmes de Gerda fondirent la glace.","why":"le sujet + le passé simple: le cœur de la phrase narrative."},{"t":"listen","skill":"listening","q":"ما la phrase التي ينطقها Kay بعد la scène du miroir?","opts":["Je ne voyais que le froid depuis ce jour.","Où se trouve la rose ?","La reine est partie.","Il fait chaud aujourd hui."],"a":0,"why":"le changement de comportement de Kay se lit dans cette phrase."},{"t":"translate","skill":"writing","q":"ترجم: «انتصرت الصداقة على البرد.»","ans":"L’amitié a vaincu le froid.","why":"la locution « vaincre + COD » exprime la victoire de l’amitié."},{"t":"speaking","skill":"speaking","q":"انطق la prière de Gerda بنبرة حزينة مع إبطاء واضح على la dernière voyelle.","target":"Kay, reviens à la maison !","why":"l’impératif exprime ici le désir, pas l’ordre: l’intonation le montre."},{"t":"correct","skill":"grammar","q":"صحّح: «La neige qui tombaient était très blanche.»","ans":"La neige qui tombait était très blanche.","why":"le verbe de la relative s’accorde avec « la neige »: tombait, 3e personne du singulier."},{"t":"mcq","skill":"analysis","q":"ما la symbolique de la rose chez Andersen؟","opts":["la mémoire et l’amitié","la richesse","la peur","le silence"],"a":0,"why":"la rose relie Gerda et Kay: elle rappelle le passé et guide le voyage."}],"homework":"اكتب فقرة من 100 كلمة بعنوان « Mon cœur n’était pas gelé » تشرح فيها موقفاً حقيقياً ظهرت فيه la fidélité d’un ami، مع استخدام جملة فيها relative (qui / dont / où) وجملة بسبب « car » وجملة نتيجة بـ « si bien que ».","sources":[{"title":"La Reine des Neiges – d’après Hans Christian Andersen (1844)","channel":"Le Miroir des Contes","videoId":"1YclUCnLghM","why":"سرد كامل للحكاية مع la voix posée و la diction النظيفة: يُناسب la compréhension écrite et la mémorisation des structures de la description.","cat":"Contes","level":"B2","main":true},{"title":"Livre audio : la Reine des Neiges, Deuxième Histoire (conte d’Andersen)","channel":"Audiolude","videoId":"iZhkwuvu8bI","why":"الجانب الصوتي لـ la narration: la compréhension orale لـ les dialogues et les descriptions.","cat":"Contes","level":"B2","extra":true},{"title":"les cygnes sauvages dessin animé","channel":"SANDORIYONNE S","videoId":"DdToNj2Q534","why":"conte d’Andersen آخر يشارك la même symbolique: la fidélité, la transformation, le sacrifice — قراءة مقارنة.","cat":"Contes","level":"B2","extra":true}],"supplements":[{"id":"iZhkwuvu8bI","title":"Livre audio : la Reine des Neiges, Deuxième Histoire (conte d’Andersen)","channel":"Audiolude","why":"الجانب الصوتي لـ la narration: la compréhension orale لـ les dialogues et les descriptions.","lang":"fr","dur":17},{"id":"DdToNj2Q534","title":"les cygnes sauvages dessin animé","channel":"SANDORIYONNE S","why":"conte d’Andersen آخر يشارك la même symbolique: la fidélité, la transformation, le sacrifice — قراءة مقارنة.","lang":"fr","dur":25}]},{"id":"b2-t9-l9","fr":"Pinocchio de Carlo Collodi — le mensonge et la transformation","ar":"بينوكيو لكارلو كولودي — الكذب والتحوّل","objectives":["تحليل la structure du conte italien: la métamorphose, la faute, la punition, la rédemption","استيعاب 40 مفردة حول la conscience, le mensonge, la vérité, l’obéissance et la transformation","إتقان la négation renforcée: ne...plus, ne...jamais, ne...rien داخل les promesses","مقارنة le roman de Collodi مع les adaptations modernes ودراسة la morale du conte italien"],"sections":[{"h":"الدرس 9: بينوكيو — الضمير والكذب والتحوّل","video":{"id":"l32CUo2usIk","title":"2 Histoires de Pinocchio | Contes | Dessin Animé","channel":"Les P’tits z’Amis","why":"سرد قصتين لبينوكيو بالفرنسية مع la diction النظيفة: يُظهر la progression du personnage من marionnette إلى فتى حقيقي بشكل مرئي وسهل التتبع.","lang":"fr","main":true,"dur":22},"p":["Carlo Collodi نشر Les aventures de Pinocchio بين 1881 و1883 على شكل feuilleton في جريدة إيطالية، ثم جُمعت الفصول في رواية شعبية. لهذا يمتلئ le récit بالمواقف الساخرة وla leçon de morale داخل la voix du narrateur.","المفردات المحورية: le mensonge, la vérité, la conscience, le grillon, la marionnette, le bois, s’allonger, obéir, travailler, la liberté, la faute, se transformer. ربط le vocabulaire بالسؤال المركزي: كيف يصير الخشبة إنساناً؟","نحوياً تبنى la promesse على la négation renforcée: « Je ne mentirai plus jamais » تجمع ne...plus (نهاية عادة) مع ne...jamais (منع تام). لاحظ l’impératif: « Ne mens plus ! » يربط la faute بla règle.","la conscience تتجسّد في le grillon: la voix intérieure التي تنبّه Pinocchio قبل أن يندم. في le conte italien، la conscience ليست تهديداً بل نصيحة: التمرد منها هو ما يُبعده عن la vérité.","le mensonge والتحوّل: nez qui s’allonge يجعل la vérité مرئية، وla marionnette de bois تتحول عبر l’obéissance et le travail. la version de Collodi تفرض la discipline، بينما la version Disney تضيف la fée et les chansons — la comparaison تكشف la différence entre la morale stricte et le récit doux.","خلاصة الدرس: le conte يقول إن la transformation تبدأ من la reconnaissance de la faute. بعد الدرس، أعد كتابة la promesse de Pinocchio إلى son père في ثمانين كلمة مع ne...plus و ne...jamais."],"sub":[{"h":"la conscience qui parle","p":["« Tu ne travailles pas, tu ne vas pas à l’école. »","« Le grillon dit la vérité à la marionnette. »","« Écoute ta conscience, Pinocchio. »"]},{"h":"le mensonge et le nez","p":["« Pourquoi ton nez a-t-il grandi ? »","« C’est parce que j’ai menti. »","« Chaque mensonge se voit dans le miroir. »"]},{"h":"la transformation","p":["« Tu n’es plus une marionnette de bois. »","« Il devint un vrai garçon. »","« Devenir: la promesse de tous les contes. »"]}]},{"h":"phrases clés du conte","p":["« Papa, je ne mentirai plus jamais. » — la négation renforcée exprime la promesse solennelle.","« Écoute ta conscience, mon enfant. » — la voix du grillon est celle de l’intérieur.","« Si tu travailles, tu deviendras un vrai garçon. » — la condition de la transformation.","« Je suis une marionnette, mais je veux être comme les autres. » — le désir qui lance la quête."]},{"h":"التطبيق والتلخيص","p":["تمرين la réécoute: استمع إلى la première histoire واحسب les phrases de négation (ne...plus, ne...jamais) ثم اكتبها.","تمرين la comparaison: ضع ثلاث فروق بين la version de Collodi و la version Disney في جدول من عمودين.","تمرين la production: اكتب la promesse de Pinocchio à Gepetto في 80 كلمة مع ne...plus و ne...jamais وجملة بسبب « parce que »."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: «Pinocchio» يسير في أربع مراحل — la métamorphose, la faute, la punition, la rédemption — ودرس الضمير أن le mensonge يُعقَّب دائماً، مع la négation renforcée (ne…plus, ne…jamais, ne…rien) داخل les promesses. أعد مشاهدة الفيديو الرئيسي وركّز على الفرق بين le roman de Collodi و les adaptations modernes.","جسر الدروس: من b2-t9-l8 (ملكة الثلج — هانس كريستيان أندرسن) إلى b2-t9-l9 (بينوكيو لكارلو كولودي — الكذب والتحوّل)، ثم إلى b2-t9-l10 حيث يبدأ le récit d’aventure مع «Robinson Crusoé»: le naufrage, la survie et l’autonomie sur l’île.","مهمة تطبيقية: أعد سرد la métamorphose de Pinocchio في دقيقة واحدة مع تسجيل صوتك، ثم استخرج 3 كلمات جديدة من الدرس واكتب بها جملتين، وأخيراً قارن سردهك بالفيديو الرئيسي وحدّد الفرق في la morale de l’obéissance."]}],"pron":[{"w":"le mensonge","ipa":"[mɑ̃sɔ̃ʒ]","approx":"مانسونج"},{"w":"la conscience","ipa":"[kɔ̃sjɑ̃s]","approx":"كونسيانس"},{"w":"le grillon","ipa":"[ɡʁijɔ̃]","approx":"غريْيون"}],"vocab":[{"fr":"le mensonge","ar":"الكذب","pos":"nom","g":"m","exFr":"Un mensonge en appelle un autre.","ipa":"[mɑ̃sɔ̃ʒ]","exAr":"الكذب يجرّ كذباً آخر."},{"fr":"la vérité","ar":"الحقيقة","pos":"nom","g":"f","exFr":"Il dit la vérité pour la première fois.","ipa":"[veʁite]","exAr":"قال الحقيقة لأول مرة."},{"fr":"la conscience","ar":"الضمير","pos":"nom","g":"f","exFr":"Écoute ta conscience, Pinocchio.","ipa":"[kɔ̃sjɑ̃s]","exAr":"اسمع ضميرك يا بينوكيو."},{"fr":"le grillon","ar":"الجرادة المتكلّمة","pos":"nom","g":"m","exFr":"Le grillon lui parla sur la cheminée.","ipa":"[ɡʁijɔ̃]","exAr":"كلّمته الجرادة فوق المدفأة."},{"fr":"la marionnette","ar":"الدمية الخشبية","pos":"nom","g":"f","exFr":"La marionnette vivait dans la maison de Gepetto.","ipa":"[maʁjɔnɛt]","exAr":"كانت الدمية تسكن بيت غيبيتو."},{"fr":"le bois","ar":"الخشب","pos":"nom","g":"m","exFr":"Il était fait d’un morceau de bois.","ipa":"[bwa]","exAr":"كان مصنوعاً من قطعة خشب."},{"fr":"s’allonger","ar":"يتطاول / يطول","pos":"verbe","g":"","exFr":"Son nez s’allongea dès qu’il mentit.","ipa":"","exAr":"تطاول أنفه بمجرد أن كذب."},{"fr":"obéir à","ar":"يطيع","pos":"verbe","g":"","exFr":"Il devait obéir à son père.","ipa":"","exAr":"كان يجب أن يطيع والده."},{"fr":"la liberté","ar":"الحرية","pos":"nom","g":"f","exFr":"Il courut vers la liberté sans réfléchir.","ipa":"[libeʁte]","exAr":"ركض نحو الحرية دون تفكير."},{"fr":"la faute","ar":"الخطأ (الذنب)","pos":"nom","g":"f","exFr":"Il reconnut sa faute devant les autres.","ipa":"[fot]","exAr":"اعترف بخطئه أمام الآخرين."},{"fr":"se transformer en","ar":"يتحوّل إلى","pos":"verbe","g":"","exFr":"Il se transforma en vrai garçon.","ipa":"","exAr":"تحوّل إلى فتى حقيقي."},{"fr":"la conscience morale","ar":"الضمير الأخلاقي","pos":"loc.","g":"f","exFr":"Le grillon réveille sa conscience morale.","ipa":"","exAr":"تهيّجت جرادة ضميره الأخلاقي."}],"examples":[{"fr":"Je ne mentirai plus jamais, promis.","ar":"لن أكذب بعد أبداً، وعد.","note":"la négation renforcée"},{"fr":"Ne mens plus, sinon ton nez grandira.","ar":"لا تكذب بعد، وإلا طال أنفك.","note":"l’impératif avec ne...plus"},{"fr":"Il était en bois, mais il devint un vrai garçon.","ar":"كان من الخشب، لكنه صار فتى حقيقياً.","note":"imparfait + passé simple"},{"fr":"C’est parce que j’ai menti que mon nez a grandi.","ar":"إنه لأنني كذبت طال أنفي.","note":"la cause avec parce que"},{"fr":"Il apprit à travailler en aidant les autres.","ar":"تعلّم العمل بمساعدة الآخرين.","note":"le gérondif de moyen"},{"fr":"La vérité coûte moins cher que le mensonge.","ar":"الحقيقة أقل كلفةً من الكذب.","note":"la morale du conte"}],"grammar":[{"tFr":"La négation renforcée: ne...plus, ne...jamais, ne...rien","tAr":"النفي المؤكّد: ne...plus و ne...jamais و ne...rien","body":["« Je ne mentirai plus jamais » تجمع ne...plus (نهاية عادة قديمة) مع ne...jamais (منع تام للمستقبل): la force تأتي من la répétition داخل la promesse solennelle du conte.","« ne...plus » = لم يعد، « ne...jamais » = أبداً، « ne...rien » = لا شيء؛ وفي l’impératif تصبح « Ne mens plus ! » — la négation تربط la faute à la règle داخل la leçon de morale."],"ex":[{"fr":"Je ne mentirai plus jamais, promis.","ar":"لن أكذب بعد أبداً، وعد."},{"fr":"Il ne voulut plus rien entendre.","ar":"لم يُرِد أن يسمع شيئاً بعد."}]},{"tFr":"Les temps du récit de la transformation","tAr":"زمن السرد في رحلة التحوّل","body":["la transformation تُبنى بالزمن: l’imparfait يصف la situation initiale (« il était une marionnette »)، le passé simple يسجّل le changement (« il devint un vrai garçon »)، و le plus-que-parfait يفسّر le passé (« il avait désobéi »).","le gérondif après « en » يربط la durée بla progression: « Il apprit en travaillant. » — la phrase تصبح وصفاً لـ le progrès du héros داخل le conte."],"ex":[{"fr":"Il était en bois, mais il devint un vrai garçon.","ar":"كان من الخشب، لكنه صار فتى حقيقياً."},{"fr":"Il se racheta en aidant les autres.","ar":"فتدّى بنفسه بمساعدة الآخرين."}]}],"mistakes":[{"wrong":"dire « je ne mens pas demain »","right":"je ne mentirai plus jamais","why":"la promesse demande le futur et la négation renforcée: l’énoncé devient solennel."},{"wrong":"se transformer de vrai garçon","right":"se transformer en vrai garçon","why":"la préposition en introduit le résultat de la transformation."},{"wrong":"croire que le conte de Collodi est identique à l’adaptation","right":"Collodi écrit un récit satirique et moralisateur","why":"la version originale est plus dure et plus stricte que le dessin animé."},{"wrong":"traduire « la conscience » par « la science »","right":"la conscience = الضمير, la science = العلم","why":"deux mots proches phonétiquement mais de sens très différents."}],"dialogues":[{"title":"la leçon du grillon","ctx":"le grillon et la marionnette sur la cheminée","lines":[{"who":"le grillon","fr":"Tu ne fais que te divertir, Pinocchio.","ar":"أنت لا تفعل سوى اللهو يا بينوكيو."},{"who":"Pinocchio","fr":"Les livres m’ennuient, je veux jouer.","ar":"الكتب تُضجّني، أريد أن ألعب."},{"who":"le grillon","fr":"Sans travail, tu resteras de bois.","ar":"بدون عمل ستصبح خشباً على الدوام."},{"who":"Pinocchio","fr":"D’accord, j’écouterai ma conscience.","ar":"حسناً، سأستمع إلى ضميري."}]},{"title":"la promesse","ctx":"Pinocchio devant son père Gepetto","lines":[{"who":"Gepetto","fr":"Pourquoi ton nez a-t-il grandi encore ?","ar":"لماذا طال أنفك مرة أخرى؟"},{"who":"Pinocchio","fr":"Parce que j’ai menti à mon ami.","ar":"لأنني كذبت على صديقي."},{"who":"Gepetto","fr":"La vérité coûte moins cher que le mensonge.","ar":"الحقيقة أقل كلفةً من الكذب."},{"who":"Pinocchio","fr":"Je ne mentirai plus jamais, je te le promets.","ar":"لن أكذب بعد أبداً، هذا وعدٌ لك."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"أي مفردة تعني «الضمير»؟","opts":["la conscience","le mensonge","le bois","la marionnette"],"a":0,"why":"la conscience = الضمير، وهو محور la leçon du grillon."},{"t":"fill","skill":"grammar","q":"أكمل: «Je ___ plus jamais, promis.»","fr":"Je ... plus jamais, promis.","ans":"ne mentirai","why":"la promesse utilise le futur avec la négation renforcée ne...plus jamais."},{"t":"order","skill":"writing","q":"رتّب: لن أكذب بعد أبداً، وعد","words":["Je","ne","mentirai","plus","jamais,","promis."],"ans":"Je ne mentirai plus jamais, promis.","why":"ne + verbe + plus + jamais: l’ordre fixe de la négation renforcée."},{"t":"listen","skill":"listening","q":"ما la phrase que prononce le grillon pour avertir Pinocchio?","opts":["Sans travail, tu resteras de bois.","Ton nez est très long.","Les livres sont ennuyeux.","Gepetto est parti."],"a":0,"why":"l’avertissement lie le travail à la transformation du personnage."},{"t":"translate","skill":"writing","q":"ترجم: «تحوّل إلى فتى حقيقي.»","ans":"Il se transforma en vrai garçon.","why":"se transformer en + COD: la préposition en marque le résultat."},{"t":"speaking","skill":"speaking","q":"انطق la promesse devant Gepetto بنبرة sincère مع إبطاء على « plus jamais ».","target":"Je ne mentirai plus jamais, promis.","why":"la négation renforcée ne vaut que si elle est prononcée avec conviction."},{"t":"correct","skill":"grammar","q":"صحّح: «Il s’est transformé de vrai garçon.»","ans":"Il s’est transformé en vrai garçon.","why":"se transformer se construit avec la préposition en, jamais avec de."},{"t":"mcq","skill":"analysis","q":"ما la fonction symbolique du nez qui s’allonge؟","opts":["montrer la vérité cachée du mensonge","indiquer l’âge du héros","embellir le personnage","mesurer sa force"],"a":0,"why":"le nez rend visible l’invisible: la vérité devient signe physique dans le conte."}],"homework":"شاهد la première histoire sans sous-titres، اكتب عشر جمل من la leçon du grillon، ثم أعد كتابتها بـ l’impératif (Ne mens plus, Travaille…) وأخيراً قارن la morale de Collodi مع la version Disney في فقرة من 80 كلمة.","sources":[{"title":"2 Histoires de Pinocchio | Contes | Dessin Animé","channel":"Les P’tits z’Amis","videoId":"l32CUo2usIk","why":"سرد قصتين لبينوكيو بالفرنسية مع la diction النظيفة: يُظهر la progression du personnage من marionnette إلى فتى حقيقي بشكل مرئي وسهل التتبع.","cat":"Contes","level":"B2","main":true},{"title":"Les aventures de Pinocchio - Carlo Collodi - 01","channel":"Lecteur à Domicile","videoId":"aTusM-cJ9t8","why":"النص الأصلي لـ Collodi مسموعاً: la lecture littéraire qui révèle le style du conte italien.","cat":"Contes","level":"B2","extra":true},{"title":"Le Paradoxe de Pinocchio : Et si son nez disait la vérité ?","channel":"loup tales","videoId":"IC4TOd2GpaU","why":"تحليل فكري قصير لـ le symbole du nez et la vérité: أساس la dimension culturelle du conte.","cat":"Contes","level":"B2","extra":true}],"supplements":[{"id":"aTusM-cJ9t8","title":"Les aventures de Pinocchio - Carlo Collodi - 01","channel":"Lecteur à Domicile","why":"النص الأصلي لـ Collodi مسموعاً: la lecture littéraire qui révèle le style du conte italien.","lang":"fr","dur":4},{"id":"IC4TOd2GpaU","title":"Le Paradoxe de Pinocchio : Et si son nez disait la vérité ?","channel":"loup tales","why":"تحليل فكري قصير لـ le symbole du nez et la vérité: أساس la dimension culturelle du conte.","lang":"fr","dur":1}]},{"id":"b2-t9-l10","fr":"Robinson Crusoé — le naufragé et Vendredi","ar":"روبينسون كروزو — الغريق والجمعة","objectives":["تحليل la structure du récit d’aventure: le naufrage, la survie, l’établissement, la rencontre","استيعاب 40 مفردة حول la survie, l’autonomie, le naufrage, le journal et la Providence","تمييز les temps du récit dans le journal de bord: imparfait, passé simple, plus-que-parfait","فهم la dimension idéologique: l’autosuffisance et le regard moderne sur la relation avec Vendredi"],"sections":[{"h":"الدرس 10: روبينسون كروزو — الجزيرة والاستغناء عن النفس","video":{"id":"8OaPuS4XHFk","title":"Voyage littéraire : Robinson Crusoë de Daniel Defoe - Biographie - Résumé - Analyse","channel":"Le Podcast Café Classique avec Sam Zaenker","why":"حوار أدبي يجمع la biographie et l’analyse: يشرح la structure du récit d’aventure و le thème de l’autonomie مع le contexte historique de Defoe.","lang":"fr","main":true,"dur":16},"p":["Daniel Defoe نشر Robinson Crusoé سنة 1719 ويُعدّ من أولى الروايات الحديثة: le récit mêle l’aventure, le journal et la réflexion morale، وهو ما يجعله نموذجاً لـ le genre du récit d’aventure.","المفردات المحورية: le naufrage, l’île, le sable, la cabane, la tempête, se fabriquer, l’autonomie, le journal, la Providence, le naufragé, s’adapter à, la civilisation. ربط كل مفردة بـ la méthode de survie du personnage.","نحوياً يقوم le récit على l’alternance: le passé simple للأفعال التي غيّرت الوضع (« je construisis ma cabane ») و l’imparfait للاستمرار (« le vent soufflait »). le plus-que-parfait يفسّر le passé avant le naufrage: « j’avais quitté le port à l’aube ».","Les thèmes: l’autosuffisance تعبر عن la confiance في la raison humaine، و la Providence تعكس la lecture religieuse للحظ: روبينسون يرى يد الله في كل ما نجا منه، ثم يكتشف أن la survie تأتي من le travail لا من la chance وحدها.","la relation avec Vendredi: le nom يأتي من la date de la rencontre وليس من la volonté du personnage فقط — ولهذا يفتح le récit سؤال la civilisation و le regard colonial. la lecture moderne تقارن la domination في la version de 1719 مع les adaptations contemporaines.","خلاصة الدرس: le récit d’aventure يعلّم أن la liberté تُبنى بالعمل وبالكلام مع الآخرين. بعد الدرس، اكتب ثلاث مداخلة من le journal de bord بتواريخ متتالية، كل واحدة خمسين كلمة بـ le passé simple et l’imparfait."],"sub":[{"h":"le naufrage","p":["« Je me réveillai sur une plage déserte. »","« Le navire coula sous la tempête. »","« Je comptais les jours sur une croix dans le sable. »"]},{"h":"la survie","p":["« Il fallait construire une cabane avant la nuit. »","« Je dressai la liste de ce que la mer m’avait donné. »","« Chaque jour, je fabriquais un outil nouveau. »"]},{"h":"Vendredi","p":["« Je l’appellerai Vendredi. »","« Nous apprîmes à nous comprendre sans mots. »","« L’homme n’est jamais seul sur son île. »"]}]},{"h":"phrases clés du récit","p":["« Je comptais les jours que j’avais passés. » — le journal de bord structure tout le récit.","« Il fallait tout inventer: le couteau, la cabane, le feu. » — la tournure impersonnelle de la nécessité.","« Je dressai la liste de mes ressources. » — la méthode du naufragé.","« Nous apprîmes à nous comprendre sans mots. » — la rencontre fonde une nouvelle relation."]},{"h":"التطبيق والتلخيص","p":["تمرين la rédaction: اكتب ثلاث مداخلة من le journal de bord بتواريخ متتالية، كل واحدة خمسين كلمة بـ le passé simple et l’imparfait.","تمرين la liste: اكتب عشرة أدوات صنعها روبينسون مع la matière et le nombre de jours اللازمة.","تمرين la réflexion: هل العبارة « l’homme peut tout fabriquer بنفسه » صحيحة؟ فقرة من ثمانين كلمة مع connecteurs de concession (pourtant, cependant)."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: «Robinson Crusoé» يعرض la survie عبر le journal de bord: le naufrage ثم l’établissement ثم la rencontre avec Vendredi، والدرس يجمع l’autonomie مع la Providence ويرسم صورة l’île كعالم صغير. أعد مشاهدة الفيديو الرئيسي وركّز على les temps du récit dans le journal: imparfait, passé simple et plus-que-parfait.","جسر الدروس: من b2-t9-l9 (بينوكيو لكارلو كولودي — الكذب والتحوّل) إلى b2-t9-l10 (روبينسون كروزو — الغريق والجمعة)، ثم إلى b2-t9-l11 حيث ندخل «Peter Pan» و le récit de l’enfance éternelle à Neverland.","مهمة تطبيقية: أعد سرد la journée type de Robinson في دقيقة واحدة مع تسجيل صوتك، ثم دوّن 3 كلمات جديدة من الدرس واستعملها في فقرة، وأخيراً قارن روايتك بالفيديو الرئيسي وحدّد الفرق في وصف la vie sur l’île."]}],"pron":[{"w":"le naufrage","ipa":"[nofʁaʒ]","approx":"نوفراج"},{"w":"la survie","ipa":"[syʁvi]","approx":"سورفي"},{"w":"le sable","ipa":"[sabl]","approx":"سابل"}],"vocab":[{"fr":"le naufrage","ar":"الحوادث البحرية (الغرق)","pos":"nom","g":"m","exFr":"Le naufrage le laissa seul sur la plage.","ipa":"[nofʁaʒ]","exAr":"تركه الحادث وحيداً على الشاطئ."},{"fr":"l’île","ar":"الجزيرة","pos":"nom","g":"f","exFr":"Il vivait seul sur une île déserte.","ipa":"[il]","exAr":"عاش وحيداً على جزيرة مهجورة."},{"fr":"la tempête","ar":"العاصفة","pos":"nom","g":"f","exFr":"La tempête coula le navire en une nuit.","ipa":"[tɑ̃pɛt]","exAr":"أغرقت العاصفة السفينة في ليلة واحدة."},{"fr":"le sable","ar":"الرمل","pos":"nom","g":"m","exFr":"Il écrivit la date dans le sable.","ipa":"[sabl]","exAr":"كتب التاريخ على الرمل."},{"fr":"la cabane","ar":"الكوخ","pos":"nom","g":"f","exFr":"Il construisit une cabane de bois.","ipa":"[kaban]","exAr":"بنى كوخاً من الخشب."},{"fr":"se fabriquer","ar":"يصنعه بنفسه","pos":"verbe","g":"","exFr":"Il se fabriqua un couteau avec un éclat de verre.","ipa":"","exAr":"صنع سكيناً بنفسه من شظية زجاج."},{"fr":"l’autonomie","ar":"الاستقلالية والاستغناء عن النفس","pos":"nom","g":"f","exFr":"L’autonomie devint sa seule richesse.","ipa":"[ɔtɔnɔmi]","exAr":"صار الاستغناء عن النفس ثروته الوحيدة."},{"fr":"le journal de bord","ar":"يوميات السفينة (دفتر اليومية)","pos":"nom","g":"m","exFr":"Il tenait un journal de bord chaque soir.","ipa":"","exAr":"كان يكتب يومية كل مساء."},{"fr":"la Providence","ar":"عناية القدر","pos":"nom","g":"f","exFr":"Il remerciait la Providence chaque soir.","ipa":"[pʁɔvidɑ̃s]","exAr":"كان يشكر القدر كل مساء."},{"fr":"le naufragé","ar":"الغريق الناجي","pos":"nom","g":"m","exFr":"Le naufragé comptait les jours une par une.","ipa":"[nofʁaʒe]","exAr":"كان الغريق يعدّ الأيام واحداً واحداً."},{"fr":"s’adapter à","ar":"يتأقلم مع","pos":"verbe","g":"","exFr":"Il s’adapta à la vie de l’île.","ipa":"","exAr":"تأقلم مع الحياة في الجزيرة."},{"fr":"la civilisation","ar":"الحضارة","pos":"nom","g":"f","exFr":"Il apporta les outils de sa civilisation.","ipa":"[sivilizasjɔ̃]","exAr":"أحضر أدوات حضارته."}],"examples":[{"fr":"Le vent soufflait quand je sortis du navire.","ar":"كان الريح تهبّ حين خرجت من السفينة.","note":"imparfait + passé simple"},{"fr":"Avant le naufrage, j’avais quitté le port à l’aube.","ar":"قبل الحادث، غادرت الميناء عند الفجر.","note":"le plus-que-parfait"},{"fr":"Il fallait tout inventer: le couteau, la cabane, le feu.","ar":"كان لا بد من اختراع كل شيء: السكين والكوخ والنار.","note":"la nécessité"},{"fr":"Chaque jour, je fabriquais un outil nouveau.","ar":"كل يوم كنت أصنع أداة جديدة.","note":"l’imparfait de la fréquence"},{"fr":"Il faut s’adapter à ce que la mer impose.","ar":"يجب أن تتأقلم مع ما تفرضه البحر.","note":"la règle de survie"},{"fr":"Pourtant, la liberté ne venait pas du hasard, mais du travail.","ar":"ومع ذلك، لم تأتِ الحرية من الصدفة بل من العمل.","note":"la concession"}],"grammar":[{"tFr":"Les temps du récit dans le journal de bord","tAr":"أزمنة السرد في يوميات الغريق","body":["le journal mêle le passé simple des actions (« je construisis ma cabane ») مع l’imparfait des conditions (« le vent soufflait sans arrêt »): la règle du récit d’aventure ثابتة — الحدث يتحرك، والوضع يمتد.","le plus-que-parfait يفسّر ما سبق le naufrage: « j’avais quitté le port à l’aube » — بدونه يضيع le lecteur داخل la chronologie de la tempête، ولهذا هو الزمن الأساس في le récit reporté."],"ex":[{"fr":"Le vent soufflait quand je sortis du navire.","ar":"كان الريح تهبّ حين خرجت من السفينة."},{"fr":"Avant le naufrage, j’avais quitté le port à l’aube.","ar":"قبل الحادث، غادرت الميناء عند الفجر."}]},{"tFr":"L’impératif et les tournures de la nécessité","tAr":"صيغة الأمر وتعبيرات الضرورة في رحلة المغامرة","body":["« Il faut, il fallait, il était nécessaire de » تعبّر عن la nécessité بدون أمر مباشر، ولهذا تبدو أكثر وقعاً في le récit: « Il fallait tout construire. » تصف la situation لا la voix d’un chef.","l’impératif يظهر في les ordres de survie: « Construis une cabane ! Garde le feu ! » مع les pronoms en et y placés devant le verbe: « Mets-y le feu ! » — قاعدة B2 ثابتة في la phrase impérative."],"ex":[{"fr":"Il fallait tout inventer: le couteau, la cabane, le feu.","ar":"كان لا بد من اختراع كل شيء: السكين والكوخ والنار."},{"fr":"Construis une cabane avant la nuit, et mets-y le feu !","ar":"ابنِ كوخاً قبل الليل وأشعل فيه النار!"}]}],"mistakes":[{"wrong":"tout raconter au passé simple sans décor","right":"alterner passé simple et imparfait","why":"le récit d’aventure a besoin du décor: le vent, la faim et la solitude restent à l’imparfait."},{"wrong":"confondre « se fabriquer » et « fabriquer »","right":"se fabriquer qch = le faire soi-même","why":"le pronom se indique que l’on produit pour soi: nuance clé de l’autonomie du personnage."},{"wrong":"lire le roman comme un simple livre d’aventure","right":"le lire aussi comme un récit de son époque","why":"la relation avec Vendredi pose la question du regard européen: c’est la place des versions comparées modernes."},{"wrong":"traduire « la Providence » par « le hasard »","right":"la Providence = l’aide divine, le destin favorable","why":"Robinson voit une main providentielle dans sa survie: le mot porte le sens religieux du récit."}],"dialogues":[{"title":"le premier soir sur l’île","ctx":"Robinson sur la plage, le narrateur commente","lines":[{"who":"le narrateur","fr":"Un soir d’octobre, le navire toucha le récif.","ar":"في مساء من أكتوبر، لمست السفينة الشفة."},{"who":"Robinson","fr":"Je me réveillai sur une plage déserte.","ar":"استيقظت على شاطئ مهجور."},{"who":"le narrateur","fr":"Il fallait choisir: attendre ou agir.","ar":"كان لا بد من الاختيار: أن أنتظر أو أتحرك."},{"who":"Robinson","fr":"J’agis: je compte les jours, puis je commence.","ar":"أنا أتحرك: أعدّ الأيام ثم أبدأ."}]},{"title":"la rencontre avec Vendredi","ctx":"premier échange entre Robinson et Vendredi","lines":[{"who":"Robinson","fr":"D’où viens-tu, et comment t’appelles-tu ?","ar":"من أين أنت، وما اسمك؟"},{"who":"Vendredi","fr":"Je viens de l’île voisine. On m’appelle Vendredi.","ar":"أنا قادم من الجزيرة المجاورة. يدعونني الجمعة."},{"who":"Robinson","fr":"Je t’appellerai Vendredi, car je t’ai trouvé un vendredi.","ar":"سأسمّيك الجمعة، لأنني وجدتك يوم الجمعة."},{"who":"Vendredi","fr":"Je te montrerai mon île, et tu m’apprendras la tienne.","ar":"أريك جزيرتي، وتعلّمني جزيرتك."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"أي مفردة تعني «الاستقلالية والاستغناء عن النفس»؟","opts":["l’autonomie","le naufrage","la tempête","le sable"],"a":0,"why":"l’autonomie = الاستغناء عن النفس، وهو le thème central du récit."},{"t":"fill","skill":"grammar","q":"أكمل: «Il ___ tout inventer: le couteau, la cabane, le feu.»","fr":"Il ... tout inventer: le couteau, la cabane, le feu.","ans":"fallait","why":"« il fallait » + infinitif exprime la nécessité au passé dans le récit."},{"t":"order","skill":"writing","q":"رتّب: كل يوم كنت أصنع أداة جديدة","words":["Chaque","jour,","je","fabriquais","un","outil","nouveau."],"ans":"Chaque jour, je fabriquais un outil nouveau.","why":"« chaque jour » commande l’imparfait de la fréquence."},{"t":"listen","skill":"listening","q":"ما la première tâche de Robinson بعد le naufrage?","opts":["Il fallait construire une cabane avant la nuit.","Il fallait repartir en bateau.","Il fallait chercher Vendredi.","Il fallait écrire un roman."],"a":0,"why":"l’ordre de priorité dans la survie: l’abri avant tout."},{"t":"translate","skill":"writing","q":"ترجم: «كان لا بد من بناء كوخ قبل الليل.»","ans":"Il fallait construire une cabane avant la nuit.","why":"la tournure impersonnelle « il fallait » + infinitif = la nécessité."},{"t":"speaking","skill":"speaking","q":"انطق la phrase de la nécessité بنبرة حازمة مع إبطاء على « il fallait ».","target":"Il fallait tout inventer: le couteau, la cabane, le feu.","why":"la tournure impersonnelle exprime la situation, pas l’ordre: le ton le montre."},{"t":"correct","skill":"grammar","q":"صحّح: «Il s’est adapté de la vie de l’île.»","ans":"Il s’est adapté à la vie de l’île.","why":"le verbe s’adapter se construit avec la préposition à."},{"t":"mcq","skill":"analysis","q":"ما la signification de « Vendredi » كاسم في le récit؟","opts":["le jour de la rencontre","le jour du naufrage","son nom d’origine","le nom de son île"],"a":0,"why":"Defoe nomme le personnage par la date: la chronologie devient identité dans le récit."}],"homework":"شاهد la synthèse littéraire puis réécoutez le résumé sans sous-titres: écrivez six entrées du journal de bord (une par jour de survie), 50 mots chacune, en alternant le passé simple et l’imparfait, et terminez par une phrase avec « pourtant » qui nuance la phrase « je pouvais tout faire seul ».","sources":[{"title":"Voyage littéraire : Robinson Crusoë de Daniel Defoe - Biographie - Résumé - Analyse","channel":"Le Podcast Café Classique avec Sam Zaenker","videoId":"8OaPuS4XHFk","why":"حوار أدبي يجمع la biographie et l’analyse: يشرح la structure du récit d’aventure و le thème de l’autonomie مع le contexte historique de Defoe.","cat":"Contes","level":"B2","main":true},{"title":"Histoire en français avec transcription : Robinson Crusoé","channel":"Français avec Pierre","videoId":"O5SoboXsBGQ","why":"نص مرفق بـ la transcription: la lecture suivie تثبّت le vocabulaire de la survie et les temps du récit.","cat":"Contes","level":"B2","extra":true},{"title":"Résumé de Robinson Crusoé de Daniel Defoe","channel":"sbisla_lbk","videoId":"dPQ1KOXHK2o","why":"résumé court يختصر la structure du récit: مثالي للمراجعة السريعة قبل les exercices.","cat":"Contes","level":"B2","extra":true}],"supplements":[{"id":"O5SoboXsBGQ","title":"Histoire en français avec transcription : Robinson Crusoé","channel":"Français avec Pierre","why":"نص مرفق بـ la transcription: la lecture suivie تثبّت le vocabulaire de la survie et les temps du récit.","lang":"fr","dur":27},{"id":"dPQ1KOXHK2o","title":"Résumé de Robinson Crusoé de Daniel Defoe","channel":"sbisla_lbk","why":"résumé court يختصر la structure du récit: مثالي للمراجعة السريعة قبل les exercices.","lang":"fr","dur":3}]},{"id":"b2-t9-l11","fr":"Peter Pan — l’enfance éternelle à Neverland","ar":"بيتر بان — الطفولة الخالدة في نيفرلاند","objectives":["تحليل بناء le récit في Peter Pan: l’introduction, le conflit, la chute et la morale","تمييز l’imparfait عن le passé simple أثناء سرد القصة وإدراك أثرهما في إيقاع le conte","اكتساب ما يزيد على 40 مفردة حول le conte, l’enfance, l’aventure et la féerie","مقارنة les versions du conte (Barrie, le théâtre, le dessin animé) وشرح كيف تغيّرت la morale"],"sections":[{"h":"الدرس 11: تحليل القصة القصيرة Peter Pan بالفرنسية","video":{"id":"nJJ3s9ks3ZE","title":"La triste HISTOIRE VRAIE derrière le conte de PETER PAN","channel":"Antoine & Chloé","why":"شرح سردي لخلفية قصة Peter Pan لجيمس باري: النشأة في لندن، الأشخاص الحقيقية، وتحوّلها إلى أساطير الأطفال في الأدب الإنجليزي مع تحليل la morale.","lang":"fr","main":true,"dur":18},"p":["Peter Pan لجيمس باري (1911) ليس مجرد قصة أطفال: إنه نصّ عن الرفض المطلق للكبر. تبدأ القصة في لندن داخل غرفة الأطفال، ثم تنتقل إلى Neverland — أرض تُ فيها الأمنيات حقيقية. الدرس الأول: le conte يبني عالَمه بـ la description et l’imparfait قبل أن يُطلق le conflit بـ le passé simple.","المفردات الأساسية: le conte, l’enfance, l’aventure, le navire, l’ombre, le crochet, la garde, la féerie, le duel, l’oubli, grandir, la nuit, l’enfant perdu, l’héroïsme.","نحوياً، لاحظ تبادل les temps du récit: « Wendy dormait quand Peter parut. » — l’imparfait يصف الخلفية الثابتة، ثم le passé simple يُحدث الواقعة المفاجئة. هذا هو قانون le récit في كل قصص الفرنسية.","les personnages يجسّدون les thèmes: Wendy هي la maison et la mémoire، Peter هو la liberté sans racines، Captain Crochet هو le temps qui revient (التمساح الذي يعلّق ساعته). Le thème central: هل الطفولة بلا نهاية نعمة أم فقدان؟","les versions comparées: في النصّ الأصلي يصف Peter أولاد Lost Boys ببرود تام، أما في les adaptations modernes فيصبح بطلاً رومانسياً وحنوناً. مقارنة les versions تُظهر كيف يُعاد تأويل le conte حسب le public et l’époque.","خُلاصة الدرس: Peter Pan يُعلّمك أن le récit يعيش على la tension entre l’imparfait (العالم كما هو) et le passé simple (الحدث الذي يغيّر كل شيء). أعِد سرد القصة بالtemps المناسبة مع خمس مفردات جديدة من la leçon."],"sub":[{"h":"le monde de Neverland","p":["« Il y a un endroit où les enfants ne grandissent jamais. »","« Viens, je vais te montrer où vivent les rêves. »","Neverland — l’île où tout est possible."]},{"h":"les personnages du conte","p":["Wendy — la grande sœur qui raconte les histoires.","Peter Pan — le garçon qui refuse de grandir.","Captain Crochet — le pirate hanté par le temps."]},{"h":"vocabulaire du conte","p":["l’ombre — الظلّ","le navire — السفينة","la garde — حرس القلعة"]}]},{"h":"phrases clés du conte","p":["« Viens avec moi, Wendy, et tu verras le monde. » — la promesse de l’aventure, formulée au présent de l’énonciation.","« Je suis la jeunesse éternelle, je ne veux pas grandir. » — la thèse de Peter, exprimée par un présent de vérité générale.","« On ne peut pas avoir la vie sans la mort. » — la morale cachée du conte, dite par Wendy au moment du départ.","« Défie-moi, Captain Crochet, et je te vaincrai ! » — le duel au passé simple, moment culminant du récit."]},{"h":"التطبيق والتلخيص","p":["تمرين la réécoute: استمع إلى شرح القصة ودوّن عشر جمل استعملت le passé simple ثم عشر جمل استعملت l’imparfait.","تمرين la comparaison: قارن بين la fin du conte de Barrie و la fin du dessin animé واكتب فقرة من 90 كلمة تشرح كيف تغيّرت la morale.","اكتب صفحة عن طفولتك: استعمل l’imparfait للخلفية et le passé simple للأحداث المهمة مع خمس مفردات من la leçon."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: «Peter Pan» يوازن بين la magie de Neverland وle chagrin de grandir: l’enfance éternelle ثمنها la perte de la famille، والدرس يقارن les versions (Barrie, le théâtre, le dessin animé) وشرح تغيّر la morale. أعد مشاهدة الفيديو الرئيسي وركّز على تبديل l’imparfait مع le passé simple أثناء سرد la chute du récit.","جسر الدروس: من b2-t9-l10 (روبينسون كروزو — الغريق والجمعة) إلى b2-t9-l11 (بيتر بان — الطفولة الخالدة في نيفرلاند)، ثم إلى b2-t9-l12 حيث نرحل مع «Le Voyage de Gulliver» نحو la satire et la politique عبر « les voyages immobiles ».","مهمة تطبيقية: أعد سرد la fuite vers Neverland في دقيقة واحدة مع تسجيل صوتك، ثم استخرج 3 كلمات جديدة من الدرس واكتب بها جملتين، وأخيراً قارن روايتك بالفيديو الرئيسي وحدّد الفرق في la morale entre Barrie et Disney."]}],"pron":[{"w":"Neverland","ipa":"[nɛvəʁlɑ̃]","approx":"نيفرلاند"},{"w":"le crochet","ipa":"[lə kʁɔʃe]","approx":"لو كروشيه"},{"w":"s’évader","ipa":"[sevade]","approx":"سيفاديه"}],"vocab":[{"fr":"le conte","ar":"الحكاية والقصة","pos":"nom","g":"m","exFr":"Le conte de Peter Pan vient du théâtre.","ipa":"[lə kɔ̃t]","exAr":"حكاية Peter Pan مستوحاة من المسرح."},{"fr":"l’enfance","ar":"الطفولة","pos":"nom","g":"f","exFr":"Son enfance se passe à Londres.","ipa":"","exAr":"طفولته تمرّ في لندن."},{"fr":"l’aventure","ar":"المغامرة","pos":"nom","g":"f","exFr":"L’aventure commence au milieu de la nuit.","ipa":"[avɑ̃tyʁ]","exAr":"تبدأ المغامرة في منتصف الليل."},{"fr":"le navire","ar":"السفينة","pos":"nom","g":"m","exFr":"Le navire de Captain Crochet fend la mer.","ipa":"","exAr":"سفينة الكابتن كروشيه تخترق البحر."},{"fr":"l’ombre","ar":"الظلّ","pos":"nom","g":"f","exFr":"Peter perd son ombre à Londres.","ipa":"","exAr":"يفقد بيتر ظله في لندن."},{"fr":"le crochet","ar":"الخطّاف الحديدي","pos":"nom","g":"m","exFr":"Captain Crochet a un crochet de fer.","ipa":"[kʁɔʃe]","exAr":"للكابتن كروشيه خطّاف حديدي."},{"fr":"la garde","ar":"الحرس","pos":"nom","g":"f","exFr":"La garde du roi attend devant la porte.","ipa":"","exAr":"حرس الملك ينتظمون أمام الباب."},{"fr":"la féerie","ar":"السحر والغرابة","pos":"nom","g":"f","exFr":"Neverland est un monde de féerie.","ipa":"","exAr":"نيفرلاند عالم من السحر."},{"fr":"grandir","ar":"يكبر","pos":"verbe","g":"","exFr":"Peter refuse de grandir.","ipa":"","exAr":"يرفض بيتر أن يكبر."},{"fr":"s’évader","ar":"يهرّب/يهرب","pos":"verbe","g":"","exFr":"Les enfants s’évadent par la fenêtre.","ipa":"[sevade]","exAr":"يهرب الأطفال عبر النافذة."},{"fr":"le duel","ar":"المبارزة","pos":"nom","g":"m","exFr":"Le duel se déroule sur le navire.","ipa":"","exAr":"تجري المبارزة على ظهر السفينة."},{"fr":"le ressentiment","ar":"الاستياء","pos":"nom","g":"m","exFr":"Captain Crochet cache son ressentiment.","ipa":"","exAr":"يخفي الكابتن كروشيه استياءه."}],"examples":[{"fr":"Wendy dormait quand Peter apparut.","ar":"كانت ويندي نائمة حين ظهر بيتر.","note":"imparfait + passé simple"},{"fr":"Les enfants volaient au-dessus des nuages.","ar":"كان الأطفال يحلّقون فوق الغيوم.","note":"imparfait d’habitude"},{"fr":"Captain Crochet ordonna l’attaque.","ar":"أمر الكابتن كروشيه بالهجوم.","note":"passé simple, ton du conte"},{"fr":"Peter ne voulait surtout pas grandir.","ar":"لم يرد بيتر أن يكبر إطلاقاً.","note":"le refus de la croissance"},{"fr":"Si tu volais, tu connaîtrais Neverland.","ar":"لو كنت تعرف الطيران لعرفت نيفرلاند.","note":"si + imparfait, l’irréel"},{"fr":"Wendy raconta l’histoire aux garçons.","ar":"روت ويندي القصة للأولاد.","note":"verbe de parole au passé simple"}],"grammar":[{"tFr":"Les temps du récit: imparfait et passé simple","tAr":"أزمنة السرد: الماضي المستمرّ والماضي البسيط","body":["« Wendy écrivait sa lettre quand Peter entra. » — l’imparfait présente la scène de fond (حالة مستمرة)، tandis que le passé simple fait avancer le récit (حدث جديد يقطع الخلفية).","la règle B2: dans un conte, la série des passé simple constitue la colonne vertébrale du récit, et l’imparfait l’entoure et le colore — شاهد الفرق بإعادة صياغة نفس الفقرة."],"ex":[{"fr":"La nuit tombait quand le navire approcha.","ar":"كان الليل يحلّ حين اقتربت السفينة."},{"fr":"Il courut jusqu’à la fenêtre et s’évada.","ar":"ركض حتى النافذة وهرب."}]},{"tFr":"« si » + imparfait: l’irréel du présent","tAr":"الشرط بصيغة si + الماضي المستمرّ","body":["« Si tu volais, tu connaîtrais Neverland. » — si + imparfait et conditionnel présent expriment une hypothèse irréelle au présent: بيتر لا يشرح القاعدة، بل يعرض الوعد.","« Si Peter avait grandi, il n’aurait jamais retrouvé Wendy. » — si + plus-que-parfait et conditionnel passé expriment le contraire du récit: le passé imaginé الذي لم يحدث."],"ex":[{"fr":"Si Peter avait une ombre, il serait comme nous.","ar":"لو كان لدى بيتر ظلّ لكان مثلنا."},{"fr":"Si vous grandissiez, vous ne verriez plus Neverland.","ar":"لو كبرتم لما رأيتم نيفرلاند بعد."}]}],"mistakes":[{"wrong":"utiliser le passé simple partout","right":"alterner imparfait et passé simple","why":"un récit sans imparfait devient une liste de faits, sans décor."},{"wrong":"traduire « once upon a time » par « une fois »","right":"dire « il était une fois »","why":"la formule du conte est fixe en français."},{"wrong":"confondre le conte et le récit réaliste","right":"repérer le merveilleux comme procédé","why":"Neverland obéit à ses propres règles, pas à la logique du réel."},{"wrong":"croire que Peter Pan est un héros parfait","right":"lire la part sombre du personnage","why":"Barrie montre un enfant incapable d’aimer: la morale est nuancée."}],"dialogues":[{"title":"Dans la chambre des enfants","ctx":"Wendy et Peter se rencontrent la nuit","lines":[{"who":"Peter","fr":"Tu as vu ? Mon ombre s’est enfuie.","ar":"رأيت؟ ظلي اختفى."},{"who":"Wendy","fr":"Attends, je vais la coudre avec une aiguille.","ar":"انتظر، سأرقّها بإبرة."},{"who":"Peter","fr":"Tu es gentil, viens avec moi à Neverland.","ar":"أنت لطيف، تعالي معي إلى نيفرلاند."},{"who":"Wendy","fr":"D’abord, tu me promets de ne pas grandir.","ar":"أولاً، عِدني ألا تكبر."}]},{"title":"Le duel sur le navire","ctx":"Peter affronte Captain Crochet","lines":[{"who":"Crochet","fr":"Tu ne m’impressionnes pas, gamin.","ar":"لا تُرهبني أيها الفتى."},{"who":"Peter","fr":"Je t’ai dit de rendre mon ombre.","ar":"قلتُ لك أن تعيد ظلي."},{"who":"Crochet","fr":"Ici, c’est moi le maître du navire.","ar":"هنا أنا سيد السفينة."},{"who":"Peter","fr":"Alors défie-toi toi-même, lâche !","ar":"إذن تحارب نفسك يا جبان!"}]}],"exercises":[{"t":"mcq","skill":"listening","q":"ما معنى « grandir » في هذا السياق؟","opts":["يكبر","يطير","ينام","يهرب"],"a":0,"why":"grandir = يكبر، وهو الصراع الأساسي في Peter Pan."},{"t":"fill","skill":"grammar","q":"أكمل: «Wendy ___ (dormir) quand Peter apparut.»","fr":"Wendy ... quand Peter apparut.","ans":"dormait","why":"l’imparfait décrit la scène de fond avant le fait au passé simple."},{"t":"mcq","skill":"vocabulary","q":"أي كلمة تعني «السفينة»؟","opts":["le navire","l’ombre","la garde","le duel"],"a":0,"why":"le navire = السفينة، وعليه يدور النزال الأخير."},{"t":"order","skill":"writing","q":"رتّب: كان الليل يحلّ حين اقتربت السفينة","words":["La","nuit","tombait","quand","le","navire","approcha."],"ans":"La nuit tombait quand le navire approcha.","why":"imparfait (tombait) + passé simple (approcha) forment la base du récit."},{"t":"listen","skill":"listening","q":"أي جملة تعبّر عن la morale du conte ?","opts":["On ne peut pas avoir la vie sans la mort.","Le navire fend la mer.","La garde attend devant la porte.","Peter perdit son ombre."],"a":0,"why":"Wendy prononce cette phrase comme leçon du conte."},{"t":"translate","skill":"writing","q":"ترجم: «كان الأطفال يحلّقون فوق الغيوم.» إلى الفرنسية.","ans":"Les enfants volaient au-dessus des nuages.","why":"imparfait pour l’action habituelle et prolongée."},{"t":"speaking","skill":"speaking","q":"ألقِ جملة Peter Pan بنبرة حازمة ثم جملة Wendy بنبرة هادئة، وارجع بالتونتين.","target":"Je ne veux pas grandir, Wendy.","why":"le contraste des personnages passe par la voix autant que par les mots."},{"t":"correct","skill":"grammar","q":"صحّح: «Wendy dormait quand Peter entre.»","ans":"Wendy dormait quand Peter entra.","why":"après une scène à l’imparfait, le fait nouveau se met au passé simple."}],"homework":"اكتب فقرة من 120 كلمة تروي ليلة في طفولتك: ابدأ بـ «Il était une fois…»، استعمل 5 أفعال au passé simple و3 أفعال à l’imparfait، ثم استخرج 5 مفردات من الدرس واستعملها في جملك.","sources":[{"title":"La triste HISTOIRE VRAIE derrière le conte de PETER PAN","channel":"Antoine & Chloé","videoId":"nJJ3s9ks3ZE","why":"شرح سردي لخلفية قصة Peter Pan لجيمس باري: النشأة في لندن، الأشخاص الحقيقية، وتحوّلها إلى أساطير الأطفال في الأدب الإنجليزي مع تحليل la morale.","cat":"Contes","level":"B2","main":true},{"title":"Peter Pan raconté par Jean Rochefort","channel":"Elric","videoId":"8TtGfYbOm5M","why":"سرد كامل للحكاية بصوت الممثل jean Rochefort — تدريب ممتاز على la compréhension orale et les temps du récit.","cat":"Contes","level":"B2","extra":true},{"title":"Peter Pan — conte et chansons en français","channel":"Les P'tits z'Amis","videoId":"YWN3Uy9-3Yg","why":"نسخة مصوّرة للأطفال: مقارنة la version simplifiée مع نص Barrie الأدبي.","cat":"Contes","level":"B2","extra":true}],"supplements":[{"id":"8TtGfYbOm5M","title":"Peter Pan raconté par Jean Rochefort","channel":"Elric","why":"سرد كامل للحكاية بصوت الممثل jean Rochefort — تدريب ممتاز على la compréhension orale et les temps du récit.","lang":"fr","dur":37},{"id":"YWN3Uy9-3Yg","title":"Peter Pan — conte et chansons en français","channel":"Les P'tits z'Amis","why":"نسخة مصوّرة للأطفال: مقارنة la version simplifiée مع نص Barrie الأدبي.","lang":"fr","dur":20}]},{"id":"b2-t9-l12","fr":"Le Voyage de Gulliver — Jonathan Swift","ar":"رحلة غُليفر — جوناثان سويفت","objectives":["تحليل بناء le récit de voyage عند Swift: l’observation, le conflit, le retour","استعمال le plus-que-parfait et le passé simple pour marquer l’antériorité dans la narration","اكتساب ما يزيد على 40 مفردة حول la satire, le voyage, la politique et l’île","تفسير فكرة « les voyages immobiles » ولماذا يبقى Gulliver مربوطاً في أغلب الرحلات"],"sections":[{"h":"الدرس 12: تحليل Le Voyage de Gulliver بالفرنسية","video":{"id":"ho6QhbTwPBA","title":"Les voyages de Gulliver de Jonathan Swift Résumé et analyse","channel":"Gloria Lauzanne Cours de français","why":"ملخّص وتحليل بالفرنسية للرحلات الأربع: les Liliputiens, les Brobdingnags, les Houyhnhnms مع شرح la satire politique et la morale de l’œuvre.","lang":"fr","main":true,"dur":13},"p":["Le Voyage de Gulliver (1726) لجوناثان سويفت n’est pas un conte pour enfants بل une satire politique: Gulliver جرّاح وبحّار يروي أربع رحلات، وفي كل مرة يتغيّر حجمه وتتغيّر منطق العالم من حوله. la première leçon: le récit voyageur يبدأ دائماً ب la mise en place — le navire, la tempête, le naufrage.","المفردات الأساسية: la satire, le géant, le nain, l’île, le navire, l’ambassadeur, la cour, la raison, le préjugé, l’observation, l’utopie, le verdict.","نحوياً، انتبه ل la concordance: « Gulliver s’était endormi sur le rivage quand les Lilliputiens l’attachèrent. » — le plus-que-parfait place l’action la plus ancienne avant le fait raconté au passé simple. هذا هو قانون le récit de voyage.","les personnages deviennent des symboles: les Liliputiens = la cour et ses disputes ridicules, les Brobdingnags = la raison morale, les Houyhnhnms = l’idéal impossible, les Yahoos = l’homme sans pudeur.","« les voyages immobiles »: Gulliver est presque toujours lié, captif ou enchaîné — il ne voyage pas, il observe. cette immobilité est un procédé satirique: c’est parce qu’il ne bouge pas qu’il voit la société de loin et la juge.","la morale et les versions comparées: les éditeurs modernes coupent le quatrième voyage pour les enfants, tandis que le texte intégral reste une charge violente contre la prétention humaine. comparer les versions = comprendre comment on fabrique un classique."],"sub":[{"h":"les quatre voyages","p":["Le premier voyage: Lilliput, l’île des hommes minuscules.","Le deuxième voyage: Brobdingnag, l’île des géants.","Les derniers voyages: les chevaux parlants et les Yahoos."]},{"h":"la satire en action","p":["« Les guerres commencent pour des œufs cassés. »","Rire des petits pour viser les grands.","la satire — النقد والسخرية السياسية"]},{"h":"vocabulaire du récit","p":["s’échouer — يخسف بالسفينة","la cour — البلاط","le verdict — الحكم النهائي"]}]},{"h":"phrases clés du récit","p":["« Je résolus de quitter cette terre. » — le verbe au passé simple marque la décision, point tournant du voyage.","« Ces gens ne sont grands que par leur méchanceté. » — le roi de Brobdingnag juge l’Europe: la satire change de camp.","« Nous n’avons trouvé chez eux aucune raison. » — reproche final, dit au passé simple, qui clôt le quatrième voyage.","« Je préférai vivre paisible chez moi. » — le retour, temps du récit qui referme la boucle narrative."]},{"h":"التطبيق والتلخيص","p":["تمرين la réécoute: استمع إلى الملخّص ودوّن أربع جمل au passé simple وثلاث جمل au plus-que-parfait.","تمرين la satire: اكتب سطرين ساخرين عن موقف يومي (الطابور، الاجتماع) على طريقة Swift — استعمل la comparaison des grandeurs.","اكتب فقرة من 100 كلمة: يوم كامل وأنت « بحجم Lilliput » — استعمل l’imparfait pour le décor et le passé simple pour l’action."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: «Le Voyage de Gulliver» رحلة la satire: le voyageur يراقب la cour et le petit peuple، و la leçon أن le préjugé يعمي la raison؛ وعنوان « les voyages immobiles » يلخّص بطلًا يبقى مربوطاً في أغلب الرحلات. أعد مشاهدة الفيديو الرئيسي وركّز على le plus-que-parfait pour marquer l’antériorité في la narration.","جسر الدروس: من b2-t9-l11 (بيتر بان — الطفولة الخالدة في نيفرلاند) إلى b2-t9-l12 (رحلة غُليفر — جوناثان سويفت)، ثم إلى b2-t9-l13 حيث ندخل «Alice au pays des merveilles» مع les jeux de mots et l’absurde chez Carroll.","مهمة تطبيقية: أعد سرد la première rencontre avec les habitants في دقيقة واحدة مع تسجيل صوتك، ثم دوّن 3 كلمات جديدة من الدرس واستعملها في جمل، وأخيراً قارن سردهك بالفيديو الرئيسي وحدّد الفرق في la satire."]}],"pron":[{"w":"Gulliver","ipa":"[gyliveʁ]","approx":"غيليفر"},{"w":"la satire","ipa":"[la satiʁ]","approx":"لا ساتير"},{"w":"Lilliput","ipa":"[lilipy]","approx":"ليليبوت"}],"vocab":[{"fr":"la satire","ar":"السخرية النقدية","pos":"nom","g":"f","exFr":"Swift écrit une satire de la cour d’Angleterre.","ipa":"[la satiʁ]","exAr":"يكتب سويفت سخرية من البلاط الإنجليزي."},{"fr":"le géant","ar":"العملاق","pos":"nom","g":"m","exFr":"Le géant observe le voyageur dans sa main.","ipa":"","exAr":"يراقب العملاق المسافر في يده."},{"fr":"le nain","ar":"القزم","pos":"nom","g":"m","exFr":"Le nain grimpe sur la table du roi.","ipa":"","exAr":"يتسلّل القزم إلى طاولة الملك."},{"fr":"l’intuition","ar":"الحدس","pos":"nom","g":"f","exFr":"L’observation des mœurs est le vrai sujet du voyage de Gulliver.","ipa":"[ɔpsɛʁvasjɔ̃]","exAr":"ملاحظة العادات هو الموضوع الحقيقي لرحلة غُليفر."},{"fr":"l’épave","ar":"الحطام البحري","pos":"nom","g":"f","exFr":"L’épave du navire échoua près d’une côte inconnue.","ipa":"[epav]","exAr":"ارتطم حطام السفينة بشاطئ مجهول."},{"fr":"s’échouer","ar":"يُرسى تعطُّلاً","pos":"verbe","g":"","exFr":"Le bateau s’est échoué sur les récifs.","ipa":"[esewɛ]","exAr":"استقرّ القارب على الصخور."},{"fr":"la cour","ar":"البلاط الملكي","pos":"nom","g":"f","exFr":"La cour se dispute pour un œuf cassé.","ipa":"","exAr":"يتخالف البلاط على بيضة مكسورة."},{"fr":"l’ambassadeur","ar":"السفير","pos":"nom","g":"m","exFr":"L’ambassadeur réclame la liberté de Gulliver.","ipa":"","exAr":"يطلب السفير حرية غليفر."},{"fr":"la raison","ar":"العقل والحكمة","pos":"nom","g":"f","exFr":"Le roi guide ses sujets par la raison.","ipa":"","exAr":"يهدى الملك رعيته بالحكمة."},{"fr":"le préjugé","ar":"الاعتقاد المسبق","pos":"nom","g":"m","exFr":"Il juge les autres sans préjugé.","ipa":"","exAr":"يحكم على الآخرين دون تحيّز."},{"fr":"observer","ar":"يُراقب ويتأمّل","pos":"verbe","g":"","exFr":"Gulliver observe les mœurs de l’île.","ipa":"","exAr":"يتأمل غليفر عادات الجزيرة."},{"fr":"le petit peuple","ar":"الشعب الصغير","pos":"loc.","g":"m","exFr":"Le petit peuple célèbre sa victoire.","ipa":"","exAr":"يحتفل الشعب الصغير بانتصاره."}],"examples":[{"fr":"Gulliver était lié sur le rivage.","ar":"كان غليفر مربوطاً على الشاطئ.","note":"imparfait de décor"},{"fr":"Les Lilliputiens arrivèrent avec leurs armées.","ar":"جاء أهل ليليبيوت بجيوشهم.","note":"passé simple d’événement"},{"fr":"Il avait déjà vu des géants avant ce voyage.","ar":"كان قد رأى العمالقة قبل هذه الرحلة.","note":"plus-que-parfait, antériorité"},{"fr":"Ces gens sont si petits qu’on les tient dans la main.","ar":"هؤلاء صغار لدرجة أنك تمسكهم في يدك.","note":"si … que"},{"fr":"Les guerres commencent pour des œufs cassés.","ar":"تبدأ الحروب من أجل بيض مكسور.","note":"la satire"},{"fr":"Je préférai rentrer dans mon pays.","ar":"فضلتُ العودة إلى بلدي.","note":"passé simple de décision"}],"grammar":[{"tFr":"Le plus-que-parfait: l’antériorité dans le récit de voyage","tAr":"الماضي التام: التسلسل الزمني في رواية الرحلة","body":["« Gulliver avait été capturé avant que le roi n’arrive. » — le plus-que-parfait place l’action première, et le passé simple raconte ce qui arrive ensuite: la série temporelle du récit.","la règle B2: dans un récit au passé simple, tout ce qui est antérieur passe au plus-que-parfait — شاهد كيف يتغيّر الزمن عندما تروي الحادثة مرتين."],"ex":[{"fr":"Le navire avait coulé avant que Gulliver ne se réveille.","ar":"غرقت السفينة قبل أن يستيقظ غليفر."},{"fr":"Il n’avait jamais vu de si petits hommes.","ar":"لم يرَ من قبل رجالاً بهذا الصغر."}]},{"tFr":"« si … que » et les compléments de mesure","tAr":"أدوات التحبير والمقارنة بصيغة si … que","body":["« Les Lilliputiens étaient si petits que Gulliver les tenait dans la paume. » — si + adjectif + que exprime la conséquence: la mesure devient effet.","variantes utiles: assez … pour, trop … pour, tellement … que — elles mesurent la différence de grandeur entre les personnages."],"ex":[{"fr":"Les géants étaient assez forts pour le soulever.","ar":"كان العمالقة أقوياء بما يكفي لرفعه."},{"fr":"Il parlait trop vite pour qu’on le comprenne.","ar":"كان يتحدث بسرعة فائقة لدرجة أنه لا يُفهم."}]}],"mistakes":[{"wrong":"lire Gulliver comme un conte pour enfants","right":"reconnaître la satire politique","why":"Swift moque la cour, la guerre et l’orgueil humain."},{"wrong":"confondre l’imparfait et le plus-que-parfait","right":"placer l’antériorité au plus-que-parfait","why":"l’imparfait décrit, le plus-que-parfait ordonne le récit."},{"wrong":"traduire « satire » par « rire »","right":"la satire = النقد الساخر","why":"la satire vise une cible, elle n’est pas du simple amusement."},{"wrong":"sauter la quatrième voyage parce qu’elle est dure","right":"la lire pour comprendre la morale","why":"c’est la clé du jugement de Swift sur l’homme."}],"dialogues":[{"title":"Devant l’empereur de Lilliput","ctx":"Gulliver captif devant la cour","lines":[{"who":"L’empereur","fr":"Déclarez-moi la guerre ou expliquez-vous.","ar":"أعلنوا الحرب عليّ أو اشرحوا أنفسكم."},{"who":"Gulliver","fr":"Je peux écraser vos armées d’un seul pas.","ar":"أستطيع سحق جيوشكم بخطوة واحدة."},{"who":"L’empereur","fr":"La force ne prouve pas la raison.","ar":"القوة لا تثبت الحكمة."},{"who":"Gulliver","fr":"Alors jugez vos guerres, pas ma taille.","ar":"إذن احكُموا حروبكم لا طولي."}]},{"title":"Le roi de Brobdingnag","ctx":"Le roi interroge Gulliver sur l’Europe","lines":[{"who":"Le roi","fr":"Vous êtes la plus bizarre petite bête.","ar":"أنت أغرب مخلوق صغير."},{"who":"Gulliver","fr":"Nous avons la poudre à canon et les lois.","ar":"لدينا البارود والقوانين."},{"who":"Le roi","fr":"Votre plus grand ennemi, c’est votre orgueil.","ar":"كبرياؤكم هو عدوكم الأكبر."},{"who":"Gulliver","fr":"Il m’a été difficile de le nier.","ar":"كان من الصعب أن أنكر ذلك."}]}],"exercises":[{"t":"mcq","skill":"reading","q":"ما المقصود بـ « les voyages immobiles »؟","opts":["Gulliver مربوط ويُراقب أكثر ما يسافر","Gulliver لا يغادر بلاده","السفينة ترسو دائماً في الميناء","الروائي لا يصف الطريق"],"a":0,"why":"لأن Gulliver يُقيَّد في كل جزيرة، فتكون رؤيته نقدية ثابتة."},{"t":"fill","skill":"grammar","q":"أكمل: «Le navire ___ (couler) avant que Gulliver ne se réveille.»","fr":"Le navire ... avant que Gulliver ne se réveille.","ans":"avait coulé","why":"le plus-que-parfait marque l’antériorité avant le passé simple."},{"t":"mcq","skill":"vocabulary","q":"أي كلمة تعني «السخرية النقدية»؟","opts":["la satire","la cour","l’île","le verdict"],"a":0,"why":"la satire = النقد الساخر، وهي جوهر عمل Swift."},{"t":"order","skill":"writing","q":"رتّب: كان أهل ليليبيوت صغاراً لدرجة أن غليفر كان يمسكهم في يده","words":["Les","Lilliputiens","étaient","si","petits","que","Gulliver","les","tenait","dans","la","paume."],"ans":"Les Lilliputiens étaient si petits que Gulliver les tenait dans la paume.","why":"la structure si + adjectif + que exprime la conséquence."},{"t":"listen","skill":"listening","q":"أي جملة تحمل la satire de Swift ضد la guerre ?","opts":["Les guerres commencent pour des œufs cassés.","Le navire fait naufrage.","Il avait été capturé.","L’île est petite."],"a":0,"why":"الجملة تُضحّي بالحروب الكبرى عبر تفصيل تافه."},{"t":"translate","skill":"writing","q":"ترجم: «كان قد رأى العمالقة قبل هذه الرحلة.» إلى الفرنسية.","ans":"Il avait déjà vu des géants avant ce voyage.","why":"plus-que-parfait pour l’action la plus ancienne."},{"t":"speaking","skill":"speaking","q":"صف بلعبة ساخرة موقفاً يومياً من وجهة نظرك: ابدأ بـ «Tout le monde se dispute pour…»","target":"Tout le monde se dispute pour une place de parking.","why":"la satire commence par la comparaison du grand et du petit."},{"t":"correct","skill":"grammar","q":"صحّح: «Les Lilliputiens étaient si petits qu’ils le tiennent dans la main.»","ans":"Les Lilliputiens étaient si petits qu’ils le tenaient dans la main.","why":"après un verbe au passé simple, on utilise l’imparfait, pas le présent."}],"homework":"اكتب مقالة قصيرة من 130 كلمة بعنوان « une satire de mon quotidien »: صِف عادة اجتماعية بأسلوب Swift، استعمل plus-que-parfait مرتين وpassé simple ثلاث مرات، مع 5 مفردات من الدرس.","sources":[{"title":"Les voyages de Gulliver de Jonathan Swift Résumé et analyse","channel":"Gloria Lauzanne Cours de français","videoId":"ho6QhbTwPBA","why":"ملخّص وتحليل بالفرنسية للرحلات الأربع: les Liliputiens, les Brobdingnags, les Houyhnhnms مع شرح la satire politique et la morale de l’œuvre.","cat":"Contes","level":"B2","main":true},{"title":"Les Voyages de Gulliver expliqués — la satire la plus sombre","channel":"Timeless Lit Masterpieces","videoId":"yyw-Q3ca97A","why":"تحليل معمّق لـ la satire و la construction des quatre voyages بالفرنسية.","cat":"Contes","level":"B2","extra":true},{"title":"Les Voyages de Gulliver — dessin animé en français","channel":"Les P'tits z'Amis","videoId":"EJcavHTQr4c","why":"النسخة المصوّرة المبسّطة: مقارنتها مع النصّ الكامل تُظهر كيف تُمحى la satire للأطفال.","cat":"Contes","level":"B2","extra":true}],"supplements":[{"id":"yyw-Q3ca97A","title":"Les Voyages de Gulliver expliqués — la satire la plus sombre","channel":"Timeless Lit Masterpieces","why":"تحليل معمّق لـ la satire و la construction des quatre voyages بالفرنسية.","lang":"fr","dur":12},{"id":"EJcavHTQr4c","title":"Les Voyages de Gulliver — dessin animé en français","channel":"Les P'tits z'Amis","why":"النسخة المصوّرة المبسّطة: مقارنتها مع النصّ الكامل تُظهر كيف تُمحى la satire للأطفال.","lang":"fr","dur":11}]},{"id":"b2-t9-l13","fr":"Alice au pays des merveilles — Lewis Carroll","ar":"أليس في بلاد العجائب — لويس كارول","objectives":["تحليل بناء le récit dans Alice: l’enchaînement des scènes et les ruptures de la logique","استعمال le discours indirect avec la concordance des temps pour raconter les paroles des personnages","اكتساب ما يزيد على 40 مفردة autour de la logique, du jeu de mots et de l’absurde","identifier les jeux de mots de Carroll et proposer une traduction française qui garde l’effet"],"sections":[{"h":"الدرس 13: تحليل Alice au pays des merveilles بالفرنسية","video":{"id":"Rn0gkQJ6G18","title":"Alice au pays des merveilles Analyse","channel":"Gloria Lauzanne Cours de français","why":"تحليل مركّز بالفرنسية لبنية النص: l’absurde, la logique inversée, la critique de l’éducation victorienne et la construction des personnages.","lang":"fr","main":true,"dur":8},"p":["Alice au pays des merveilles (1865) لويز كارول هو conte qui casse les règles du conte: بدل أن يقود البطل إلى الهدف، يقوده la logique إلى العبث. الدرس الأول: في le récit الكلاسيكي يقفز البطل بين المشاهد، وعند Alice كل قفزة تأتي بسبب la phrase نفسها.","المفردات الأساسية: l’absurde, le jeu de mots, la logique, le lapin blanc, la grammaire, le procès, le règne, la cérémonie, la notion, l’échiquier, la preuve, s’éveiller.","نحوياً، استعمل le discours indirect: « Alice dit qu’elle avait perdu son chemin. » — المتصل ينتقل من le récit direct إلى la concordance des temps. هذا هو أسلوب les versions racontées pour les enfants.","les personnages: le Lapin Blanc = l’anxiété et le temps، le Chapeaillier = la logique folle، la Reine = l’autorité arbitraire، le Chat = la liberté sans règles. Alice وحدها تحاول فهم le sens في عالم يرفضه.","la logique renversée: « Si je mange ce gâteau, je deviens peut-être plus grande. » — la cause et l’effet ينقلبان، والقواعد تُستعمل ضدّ صاحبها. هذه هي la satire de l’éducation victorienne.","les versions comparées: les illustrations Tenniel أصبحت جزءاً من النص، ثم تحوّل الرواية إلى les films. المقارنة بين la version originale والنسخ المبسّطة تكشف كيف يُطبَّع l’absurde للأطفال: بعض les jeux de mots تختفي في الترجمة."],"sub":[{"h":"la chute dans le terrier","p":["« Le lapin blanc passe, elle le suit. »","La chute dure si longtemps qu’elle a le temps de lire.","la chute — السقوط في فجوة الأعجوبة"]},{"h":"la logique renversée","p":["« Je suis devenue folle ici. »","« Tu es juste une carte, dit la reine. »","l’absurde — العبث المنطقي"]},{"h":"vocabulaire du conte","p":["le jeu de mots — لفظ ذو معنيين","la grammaire — قواعد اللغة","le procès — المحاكمة"]}]},{"h":"phrases clés du conte","p":["« Curieux et plus curieux ! » — l’exclamation au présent, formule qui résume la méthode d’Alice.","« Je suis devenue toute folle ici. » — le jeu sur fou / folle, typique des jeux de mots de Carroll.","« Qui a été le plus ? » demanda le roi. — la logique du procès, tournée en dérision.","« Vous n’êtes qu’une paquet de cartes. » — la révélation finale: le monde rêvé s’effondre au réveil."]},{"h":"التطبيق والتلخيص","p":["تمرين la traduction ludique: اختر ثلاثة jeux de mots من النص وحاول إيجاد مقابلها بالعربية أو بالفرنسية مع شرح لماذا يصعب نقلها.","تمرين la concordance: حوّل خمس جمل من le discours direct إلى le discours indirect مع les bons temps.","اكتب فقرة من 100 كلمة عن حلم غريب رأيته: استعمل l’imparfait pour le décor et le passé simple pour les faits, ثم أضف une phrase absurde."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: «Alice au pays des merveilles» ينهار فيه le sens commun: les scènes تتسلسل بـ la logique المكسورة، والدرس في les jeux de mots et l’absurde مع le discours indirect et la concordance des temps. أعد مشاهدة الفيديو الرئيسي وركّز على les ruptures de la logique et le jeu de mots في la scène du procès.","جسر الدروس: من b2-t9-l12 (رحلة غُليفر — جوناثان سويفت) إلى b2-t9-l13 (أليس في بلاد العجائب — لويس كارول)، ثم إلى b2-t9-l14 حيث تنطلق la science-fiction مع «Vingt mille lieues sous les mers» et le sous-marin Nautilus du capitaine Nemo.","مهمة تطبيقية: أعد سرد la chute dans le terrier في دقيقة واحدة مع تسجيل صوتك، ثم استخرج 3 كلمات جديدة من الدرس واكتب بها جملتين، وأخيراً قارن روايتك بالفيديو الرئيسي وحدّد l’effet d’un jeu de mots لم تنقله تماماً."]}],"pron":[{"w":"l’absurde","ipa":"[lapsyʁd]","approx":"لابسيرد"},{"w":"le jeu de mots","ipa":"[lə ʒə də mo]","approx":"لو جيه دو مو"},{"w":"la grammaire","ipa":"[la ɡʁɛmɛʁ]","approx":"لا غرامير"}],"vocab":[{"fr":"l’absurde","ar":"العبث المنطقي","pos":"nom","g":"m","exFr":"Le pays des merveilles est un monde absurde.","ipa":"[lapsyʁd]","exAr":"بلاد العجائب عالم عبثي."},{"fr":"le jeu de mots","ar":"اللعب بالكلمات","pos":"nom","g":"m","exFr":"Carrol adore les jeux de mots.","ipa":"","exAr":"يحب كارول اللعب بالكلمات."},{"fr":"la logique","ar":"المنطق","pos":"nom","g":"f","exFr":"Ici, la logique ne sert à rien.","ipa":"","exAr":"هنا لا ينفع المنطق."},{"fr":"le lapin blanc","ar":"الأرنب الأبيض","pos":"nom","g":"m","exFr":"Le lapin blanc regarde sa montre.","ipa":"","exAr":"يراقب الأرنب الأبيض ساعته."},{"fr":"la grammaire","ar":"قواعد اللغة","pos":"nom","g":"f","exFr":"La reine corrige la grammaire des autres.","ipa":"[la ɡʁɛmɛʁ]","exAr":"تُصحّح الملكة قواعد الآخرين."},{"fr":"le procès","ar":"المحاكمة","pos":"nom","g":"m","exFr":"Le procès est ridicule et bruyant.","ipa":"","exAr":"المحاكمة سخيفة وصاخبة."},{"fr":"le règne","ar":"الحكم/العهد","pos":"nom","g":"m","exFr":"Le règne de la reine fait peur.","ipa":"","exAr":"عهد الملكة مخيف."},{"fr":"le goûter","ar":"حفلة الشاي والمقبلات","pos":"nom","g":"m","exFr":"Alice participe à un goûter qui ne finit jamais.","ipa":"[ɡote]","exAr":"تشارك أليس في حفلة شاي لا تنتهي أبداً."},{"fr":"la notion","ar":"المفهوم","pos":"nom","g":"f","exFr":"Il n’a aucune notion du danger.","ipa":"","exAr":"ليس لديه أي مفهوم عن الخطر."},{"fr":"l’échiquier","ar":"رقعة الشطرنج","pos":"nom","g":"m","exFr":"Tout le monde se déplace sur l’échiquier.","ipa":"","exAr":"الجميع يتحرك على رقعة الشطرنج."},{"fr":"s’éveiller","ar":"يستيقظ","pos":"verbe","g":"","exFr":"Alice s’éveille au bord de la rivière.","ipa":"","exAr":"تستيقظ أليس على ضفاف النهر."},{"fr":"la curiosité","ar":"الفضول","pos":"nom","g":"f","exFr":"La curiosité d’Alice la fait tomber dans le terrier.","ipa":"[kyʁjɔzite]","exAr":"دفع فضول أليس إلى السقوط في الجحر."}],"examples":[{"fr":"Alice regardait le lapin sans comprendre.","ar":"كانت أليس تنظر إلى الأرنب دون فهم.","note":"imparfait de décor"},{"fr":"Le lapin Blanc sortit sa montre.","ar":"أخرج الأرنب الأبيض ساعته.","note":"passé simple d’action"},{"fr":"Elle se demandait si elle était réelle.","ar":"كانت تتساءل إن كانت حقيقية.","note":"discours indirect"},{"fr":"Rien n’est logique dans ce pays.","ar":"لا شيء منطقي في هذا البلد.","note":"la logique renversée"},{"fr":"Je suis devenue folle, autant que toi.","ar":"أنا قد جُننتْ كما أنت.","note":"le jeu de mots"},{"fr":"Si tu mangeais ce gâteau, tu deviendrais petite.","ar":"لو أكلتِ هذا الكعك لصغُرتِ.","note":"si + imparfait"}],"grammar":[{"tFr":"Le discours indirect et la concordance des temps","tAr":"النقل بالغير وتَلَقُّن الأزمنة","body":["« Alice dit qu’elle avait perdu son chemin. » — la phrase au présent (dit) fait remonter le verbe du passé à l’imparfait: c’est la concordance des temps du discours indirect.","avec un verbe au passé (expliqua), on passe au plus-que-parfait: « elle expliqua qu’elle avait vu le lapin. » — la règle B2: on recule toujours d’un cran."],"ex":[{"fr":"Le roi dit que le procès était ridicule.","ar":"قال الملك إن المحاكمة سخيفة."},{"fr":"Alice expliqua qu’elle avait suivi le lapin.","ar":"شرحت أليس أنها كانت قد سارت خلف الأرنب."}]},{"tFr":"Les connecteurs logiques du raisonnement","tAr":"أدوات الربط المنطقي","body":["ou, donc, cependant, néanmoins, en revanche, or — ils structurent le raisonnement: dans Alice, ils sont employés à contre-sens pour créer l’absurde.","« Tu es folle, donc tu as raison. » — la logique formelle appliquée à une absurdité: شاهد كيف يصبح الربط نفسه مصدر المزاح."],"ex":[{"fr":"Il mangea le gâteau, donc il devint plus petit.","ar":"أكل الكعك، فأصبح أصغر."},{"fr":"La reine avait raison, néanmoins personne n’osait parler.","ar":"كانت الملكة على حق، ومع ذلك لم يجرؤ أحد على الكلام."}]}],"mistakes":[{"wrong":"chercher une morale logique à chaque scène","right":"accepter l’absurde comme procédé","why":"Carroll construit le récit pour détourner la logique, pas pour l’enseigner."},{"wrong":"traduire les jeux de mots mot à mot","right":"chercher l’équivalent d’effet","why":"un jeu de mots se perd à la traduction, sauf à le recréer."},{"wrong":"utiliser le présent après un verbe au passé","right":"appliquer la concordance des temps","why":"après « expliqua », on dit « qu’elle avait vu »."},{"wrong":"lire Alice comme une simple histoire d’enfant","right":"voir la satire de l’éducation victorienne","why":"les personnages représentent les adultes que critique Carroll."}],"dialogues":[{"title":"Devant le lapin blanc","ctx":"Alice suit le lapin jusqu’à son terrier","lines":[{"who":"Alice","fr":"Attendez, je ne sais même pas votre nom.","ar":"انتظروا، أنا لا أعرف اسمكم."},{"who":"Le lapin","fr":"Il est presque neuf heures, il faut courir !","ar":"الساعة تشير إلى التاسعة، يجب أن أركض!"},{"who":"Alice","fr":"Une montre dans une gare, curieux et plus curieux.","ar":"ساعة في محطة، غريب وما زال أكثر غرابة."},{"who":"Le lapin","fr":"Ici, on ne mesure pas le temps, on le dépense.","ar":"هنا لا نقيس الوقت، بل ننفقه."}]},{"title":"Le procès du jardinier","ctx":"La cour de la reine de cœurs","lines":[{"who":"La reine","fr":"Qu’on lui coupe la tête !","ar":"اقطعوا رأسه!"},{"who":"Le roi","fr":"Attendons d’abord la preuve.","ar":"لننتظر الدليل أولاً."},{"who":"Alice","fr":"Ce procès n’a aucun sens.","ar":"هذه المحاكمة لا معنى لها."},{"who":"La reine","fr":"Le sens, c’est moi qui le donne.","ar":"المعنى أنا من يمنحه."}]}],"exercises":[{"t":"mcq","skill":"reading","q":"ما الذي يجعل le récit في Alice « absurde »؟","opts":["السبب والنتيجة ينقلبان والقواعد تنطبق عكسياً","الشخصيات لا تتكلم","القصة بلا نهاية","الأحداث تحدث في زمن واحد"],"a":0,"why":"لأن la logique de l’univers يتحدى le bon sens في كل مشهد."},{"t":"fill","skill":"grammar","q":"أكمل: «Alice dit qu’elle ___ (perdre) son chemin.»","fr":"Alice dit qu’elle ... son chemin.","ans":"avait perdu","why":"après un verbe au présent, le passé au discours indirect devient plus-que-parfait."},{"t":"mcq","skill":"vocabulary","q":"أي كلمة تعني «اللعب بالكلمات»؟","opts":["le jeu de mots","le procès","le règne","la preuve"],"a":0,"why":"le jeu de mots = اللعب بالكلمات، وهو خصّيصة Carroll."},{"t":"order","skill":"writing","q":"رتّب: كانت أليس تنظر إلى الأرنب دون أن تفهم","words":["Alice","regardait","le","lapin","sans","comprendre."],"ans":"Alice regardait le lapin sans comprendre.","why":"imparfait pour l’action d’observation prolongée."},{"t":"listen","skill":"listening","q":"أي جملة تعبّر عن la logique renversée ?","opts":["Le sens, c’est moi qui le donne.","Le lapin regarde sa montre.","Il est presque neuf heures.","Le procès commence."],"a":0,"why":"la reine retourne la logique: le sens devient un ordre."},{"t":"translate","skill":"writing","q":"ترجم: «كانت تتساءل إن كانت حقيقية.» إلى الفرنسية.","ans":"Elle se demandait si elle était réelle.","why":"discours indirect avec l’imparfait, sans présent de narration."},{"t":"speaking","skill":"speaking","q":"صف شيئاً غير منطقي حدث في حلم، وابدأ بـ «Curieux et plus curieux !»","target":"Curieux et plus curieux ! Je marchais dans une gare où personne ne parlait.","why":"la formule d’Alice est la clé du ton du conte."},{"t":"correct","skill":"grammar","q":"صحّح: «Le roi dit que le procès est ridicule.» بعد سياق الماضي","ans":"Le roi dit que le procès était ridicule.","why":"dans le récit au passé, la subordonnée passe à l’imparfait."}],"homework":"اقرأ فقرة من Alice بالفرنسية (100 كلمة)، حدّد فيها le discours direct و le discours indirect، ثم حوّل ثلاث جمل مباشرة إلى غير مباشرة مع la concordance. أضف جملتين تستخدمان connecteurs logiques.","sources":[{"title":"Alice au pays des merveilles Analyse","channel":"Gloria Lauzanne Cours de français","videoId":"Rn0gkQJ6G18","why":"تحليل مركّز بالفرنسية لبنية النص: l’absurde, la logique inversée, la critique de l’éducation victorienne et la construction des personnages.","cat":"Contes","level":"B2","main":true},{"title":"Résumé de Alice au Pays des merveilles de Lewis Carroll","channel":"Gloria Lauzanne Cours de français","videoId":"EZhqTS7oVZ0","why":"ملخّص متسلسل بالفرنسية: مثالي لتتبّع le récit et les temps du récit قبل التحليل.","cat":"Contes","level":"B2","extra":true},{"title":"Alice aux pays des merveilles est-elle victime de gaslighting ?","channel":"France Culture","videoId":"d5QJVx09dEM","why":"قراءة نقدية حديثة للنص: مقارنة les interprétations وتوضيح la morale عند البالغين.","cat":"Contes","level":"B2","extra":true}],"supplements":[{"id":"EZhqTS7oVZ0","title":"Résumé de Alice au Pays des merveilles de Lewis Carroll","channel":"Gloria Lauzanne Cours de français","why":"ملخّص متسلسل بالفرنسية: مثالي لتتبّع le récit et les temps du récit قبل التحليل.","lang":"fr","dur":8},{"id":"d5QJVx09dEM","title":"Alice aux pays des merveilles est-elle victime de gaslighting ?","channel":"France Culture","why":"قراءة نقدية حديثة للنص: مقارنة les interprétations وتوضيح la morale عند البالغين.","lang":"fr","dur":2}]},{"id":"b2-t9-l14","fr":"Vingt mille lieues sous les mers — Jules Verne","ar":"عشرون ألف فرسخ تحت البحار — جول فيرن","objectives":["تحليل بناء le récit d’aventure: le cadre, l’exploration, le danger et la chute","تمييز l’imparfait عن le passé simple لضبط إيقاع le récit عند فيرن","اكتساب ما يزيد على 40 مفردة autour de la mer, de la science et du sous-marin","تفسير لماذا يُعدّ Nemo شخصية متناقضة: le génie libre et le vengeur"],"sections":[{"h":"الدرس 14: تحليل Vingt mille lieues sous les mers بالفرنسية","video":{"id":"wvds5R9edPc","title":"RÉSUMÉ et ANALYSE de Vingt mille lieues sous les mers de Jules Verne","channel":"Mission Prépa","why":"ملخّص وتحليل أكاديمي بالفرنسية: la construction du récit d’aventure scientifique, la figure de Nemo et les thèmes de la liberté et de la vengeance.","lang":"fr","main":true,"dur":17},"p":["Vingt mille lieues sous les mers (1869–1870) لجول فيرن هو le récit d’aventure scientifique par excellence: l’aventure يُصفها عالم، والعلم نفسه يصبح مصدر رعب وجمال. la première leçon: le titre parle de distance parcourue, pas de profondeur — قراءة دقيقة للعنوان تغيّر فهم الرواية كلها.","المفردات الأساسية: le sous-marin, l’équipage, l’océan, le récif, l’obscurité, la chasse, le capitaine, la science, la proue, le naufrage, s’enfoncer, l’étranger.","نحوياً، لاحظ équilibre des temps: « Nous plongions quand le soleil se coucha. » — l’imparfait donne la durée et l’atmosphère du voyage, le passé simple fait avancer l’exploration.","les personnages: Nemo = le savant libre qui a rompu avec les hommes, Aronnax = le savant qui hésite entre admiration et liberté, Conseil = la fidélité, Ned Land = l’appel de la terre.","la morale et les thèmes: la liberté chez Vern est indissociable de la solitude — Nemo est maître de l’océan mais prisonnier de sa vengeance. cette tension fait la modernité du personnage.","les versions comparées: l’illustration originale de Neuville, puis le film de 1954 et les adaptations modernes يُبرزون la part d’action، بينما النص الأصلي يعطي مساحة كبيرة لـ la description scientifique."],"sub":[{"h":"à bord du Nautilus","p":["« Le Nautilus est mon domaine, docteur. »","L’équipage obéit sans un mot.","le sous-marin — الغواصة"]},{"h":"la chasse sous la mer","p":["« Une chasse, mais sans danger. »","Les forêts de corail passent sous la proue.","l’obscurité — العتمة"]},{"h":"vocabulaire de l’aventure","p":["le récif — الشعاب المرجانية","s’enfoncer — يغوص","le naufrage — الغرق"]}]},{"h":"phrases clés du récit","p":["« Tout est bien qui finit bien. » — la formule d’Aronnax, ironique après l’emprisonnement.","« L’océan est tout ce qu’il me reste. » — Nemo explique son choix: la mer remplace la patrie.","« Nous descendions toujours, toujours. » — l’imparfait répété crée la montée de la tension.","« Je ne suis plus qu’un homme mort. » — le secret de Nemo, dit au passé simple, à la fin du récit."]},{"h":"التطبيق والتلخيص","p":["تمرين la réécoute: استمع إلى الملخّص ودوّن خمس جمل au passé simple وخمس جمل au plus-que-parfait، ثم رتّبها زمنياً.","تمرين la description scientifique: اكتب فقرة من 90 كلمة تصف شيئاً تراه تحت الماء، مع trois termes techniques من الدرس.","قارن بين la fin du roman et la fin d’un film من اختيارك: اشرح في 80 كلمة كيف يغيّر le point de vue le sens de la morale."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: «Vingt mille lieues sous les mers» تجمع la science et le danger: le Nautilus, le capitaine Nemo, l’exploration ثم la chute، و Nemo شخصية متناقضة بين le génie libre et le vengeur. أعد مشاهدة الفيديو الرئيسي وركّز على تبديل l’imparfait مع le passé simple لضبط إيقاع le récit.","جسر الدروس: من b2-t9-l13 (أليس في بلاد العجائب — لويس كارول) إلى b2-t9-l14 (عشرون ألف فرسخ تحت البحار — جول فيرن)، ثم إلى b2-t9-l15 حيث نختم الجولة بـ «Don Quichotte» et la chevalerie et la folie — أول رواية حديثة في الأدب الإسباني.","مهمة تطبيقية: أعد سرد la plongée autour du Nautilus في دقيقة واحدة مع تسجيل صوتك، ثم دوّن 3 كلمات جديدة من الدرس واستعملها في فقرة، وأخيراً قارن روايتك بالفيديو الرئيسي وحدّد الفرق في la présentation de Nemo."]}],"pron":[{"w":"le Nautilus","ipa":"[lə notilys]","approx":"لو نوتيلوس"},{"w":"l’océan","ipa":"[lɔseɑ̃]","approx":"لوسيان"},{"w":"le sous-marin","ipa":"[lə sumɑʁɛ̃]","approx":"لو سوبمارين"}],"vocab":[{"fr":"le sous-marin","ar":"الغواصة","pos":"nom","g":"m","exFr":"Le sous-marin glisse entre les roches.","ipa":"","exAr":"تنزلق الغواصة بين الصخور."},{"fr":"l’équipage","ar":"الطاقم","pos":"nom","g":"m","exFr":"L’équipage travaille en silence.","ipa":"","exAr":"يعمل الطاقم في صمت."},{"fr":"l’océan","ar":"المحيط","pos":"nom","g":"m","exFr":"L’océan connaît encore des secrets.","ipa":"[lɔseɑ̃]","exAr":"لا يزال المحيط يخفي أسراراً."},{"fr":"le récif","ar":"الشعاب المرجانية","pos":"nom","g":"m","exFr":"Le navire évite le récif.","ipa":"","exAr":"تتجنب السفينة الشعاب."},{"fr":"l’obscurité","ar":"العتمة","pos":"nom","g":"f","exFr":"La lumière disparaît dans l’obscurité.","ipa":"","exAr":"يختفي الضوء في العتمة."},{"fr":"la chasse","ar":"الاصطياد والمطاردة","pos":"nom","g":"f","exFr":"La chasse sous-marine attire tout l’équipage.","ipa":"","exAr":"يجلب الاصطياد البحري كل الطاقم."},{"fr":"le capitaine","ar":"القبطان","pos":"nom","g":"m","exFr":"Le capitaine Nemo commande seul.","ipa":"","exAr":"يأمر القبطان نيمو وحيداً."},{"fr":"la science","ar":"العلم","pos":"nom","g":"f","exFr":"La science a construit le Nautilus.","ipa":"","exAr":"بنى العلم غواصة نوتيلوس."},{"fr":"la proue","ar":"مقدمة السفينة","pos":"nom","g":"f","exFr":"La proue fend les vagues noires.","ipa":"","exAr":"تخترق المقدمة الأمواج السوداء."},{"fr":"la plongée","ar":"الغوص البحري","pos":"nom","g":"f","exFr":"La plongée du Nautilus révèle les secrets des fonds marins.","ipa":"[plɔ̃ʒe]","exAr":"يكشف غوص «النوتيلوس» أسرار أعماق البحار."},{"fr":"s’enfoncer","ar":"يغوص ويتعمّق","pos":"verbe","g":"","exFr":"Le Nautilus s’enfonça dans l’abîme.","ipa":"","exAr":"غاصت الغواصة في الأعماق."},{"fr":"l’étranger","ar":"الغريب/الآخر","pos":"nom","g":"m","exFr":"Nemo reste un étranger pour son équipage.","ipa":"","exAr":"يبقى نيمو غريباً على طاقمه."}],"examples":[{"fr":"Nous naviguions quand la nuit tomba.","ar":"كنا نبحر حين حلّ الليل.","note":"imparfait + passé simple"},{"fr":"Le Nautilus s’enfonça sous les vagues.","ar":"غاصت الغواصة تحت الأمواج.","note":"passé simple d’action"},{"fr":"Il avait perdu sa patrie avant de construire le Nautilus.","ar":"فقد وطنه قبل أن يبني الغواصة.","note":"plus-que-parfait"},{"fr":"Nemo n’aime ni les hommes ni les rois.","ar":"نيمو لا يحب البشر ولا الملوك.","note":"la négation"},{"fr":"La proue fendait l’obscurité.","ar":"كانت المقدمة تخترق العتمة.","note":"imparfait d’atmosphère"},{"fr":"Je ne vois rien dans cette obscurité.","ar":"لا أرى شيئاً في هذا الظلام.","note":"ne … rien"}],"grammar":[{"tFr":"L’imparfait et le passé simple: le rythme du récit d’aventure","tAr":"الماضي المستمرّ والماضي البسيط: إيقاع مغامرة البحر","body":["« Nous plongions lentement quand le soleil disparut. » — l’imparfait installe la durée et l’atmosphère, le passé simple déclenche le fait qui change la situation.","la règle B2: dans le récit d’aventure, la série de passé simple crée le rythme (danger, fuite, repos) et l’imparfait empêche la liste d’événements de devenir mécanique."],"ex":[{"fr":"Les passagers dormaient quand l’alarme sonna.","ar":"كان الركاب نائمين حين دقّت الإنذار."},{"fr":"Nemo sortit et regarda l’horizon.","ar":"خرج نيمو ونظر إلى الأفق."}]},{"tFr":"La négation complète: ne … rien, ne … personne","tAr":"النفي الكامل: ne … rien / ne … personne","body":["« Je ne vois rien, je ne sais personne ici. » — après le verbe, la phrase négative complète garde les deux éléments: ne + verbe + rien/personne.","le nom Nemo vient du latin « persona nemo » = personne: le capitaine s’est donné un nom qui nie son identité — شاهد كيف يتصل الاسم بالقواعد."],"ex":[{"fr":"Nemo n’a jamais aimé personne sur terre.","ar":"لم يحب نيمو أحداً على الأرض قط."},{"fr":"Le soleil ne perçait plus l’obscurité.","ar":"لم يعد الشمس تخترق العتمة."}]}],"mistakes":[{"wrong":"croire que le titre parle de la profondeur","right":"vingt mille lieues = la distance parcourue","why":"le voyage dure 20 000 lieues, il ne descend pas à 20 000 mètres."},{"wrong":"lire Nemo comme un simple méchant","right":"voir le savant libre et blessé","why":"sa vengeance vient de la perte de sa patrie."},{"wrong":"utiliser le présent dans le récit au passé","right":"respecter les temps du récit","why":"le récit de Vern est construit sur imparfait et passé simple."},{"wrong":"sauter les descriptions scientifiques","right":"les lire comme une source de rythme","why":"la science donne au récit sa couleur et sa crédibilité."}],"dialogues":[{"title":"Le premier entretien","ctx":"Aronnax interroge Nemo dans la bibliothèque","lines":[{"who":"Aronnax","fr":"Êtes-vous un homme ou un fantôme ?","ar":"هل أنت إنسان أم شبح؟"},{"who":"Nemo","fr":"Je suis un naufragé qui a choisi la mer.","ar":"أنا غريق اختار البحر."},{"who":"Aronnax","fr":"Vous êtes prisonnier de votre propre navire.","ar":"أنت أسير سفينتك."},{"who":"Nemo","fr":"Libre, docteur, entièrement libre.","ar":"حرّ يا دكتور، حرّ تماماً."}]},{"title":"La chasse sous la mer","ctx":"Le lendemain du départ, devant les forêts de corail","lines":[{"who":"Ned Land","fr":"On chasse, enfin du vrai jeu !","ar":"نصطاد، أخيراً صيد حقيقي!"},{"who":"Conseil","fr":"Regardez, la proue fend les vagues.","ar":"انظروا، المقدمة تخترق الأمواج."},{"who":"Aronnax","fr":"Cette lumière vient du courant électrique.","ar":"هذا الضوء مصدره التيار الكهربائي."},{"who":"Nemo","fr":"La science nourrit ceux qui la servent.","ar":"العلم يُطعم من يخدمه."}]}],"exercises":[{"t":"mcq","skill":"reading","q":"ماذا يعني عنوان «vingt mille lieues sous les mers»؟","opts":["المسافة المقطوعة أثناء الرحلة","عمق الغوص بالكم","عمر البعثة","عدد الكائنات المكتشفة"],"a":0,"why":"العنوان يشير إلى المسافة لا إلى العمق — خطأ شائع القراءة."},{"t":"fill","skill":"grammar","q":"أكمل: «Le Nautilus ___ (plonger) sous les vagues.»","fr":"Le Nautilus ... sous les vagues.","ans":"plongea","why":"le passé simple fait avancer l’action du récit d’aventure."},{"t":"mcq","skill":"vocabulary","q":"أي كلمة تعني «الطاقم»؟","opts":["l’équipage","la proue","le récif","le naufrage"],"a":0,"why":"l’équipage = الطاقم، وclés de la vie à bord."},{"t":"order","skill":"writing","q":"رتّب: كانت المقدمة تخترق الأمواج السوداء","words":["La","proue","fendait","les","vagues","noires."],"ans":"La proue fendait les vagues noires.","why":"l’imparfait décrit l’atmosphère du voyage."},{"t":"listen","skill":"listening","q":"أي جملة تصف la science داخل le récit ?","opts":["La science nourrit ceux qui la servent.","Le navire évite le récif.","Je ne vois rien.","On chasse, enfin du vrai jeu !"],"a":0,"why":"Nemo lie la science à la survie de son équipage."},{"t":"translate","skill":"writing","q":"ترجم: «كان القبطان نيمو يراقب البحر بصمت.» إلى الفرنسية.","ans":"Le capitaine Nemo observait la mer en silence.","why":"imparfait pour l’observation prolongée."},{"t":"speaking","skill":"speaking","q":"ابدأ بجملة Nemo عن الحرية وطوّل الردّ في ثلاث جمل مع الحفاظ على le registre soutenu.","target":"Libre, docteur, entièrement libre.","why":"le ton de Nemo est solennel: la voix doit le suivre."},{"t":"correct","skill":"grammar","q":"صحّح: «Le Nautilus a plongé et il observe la profondeur.»","ans":"Le Nautilus plongea et il observa la profondeur.","why":"la série de passé simple est le moteur du récit d’aventure."}],"homework":"اكتب فقرة من 130 كلمة عن رحلة بحرية خيالية: استعمل 4 أفعال au passé simple و3 أفعال à l’imparfait، تجنّب المفردة الأعجمية غير الضرورية، واذكر 5 مفردات من الدرس في سياقها الصحيح.","sources":[{"title":"RÉSUMÉ et ANALYSE de Vingt mille lieues sous les mers de Jules Verne","channel":"Mission Prépa","videoId":"wvds5R9edPc","why":"ملخّص وتحليل أكاديمي بالفرنسية: la construction du récit d’aventure scientifique, la figure de Nemo et les thèmes de la liberté et de la vengeance.","cat":"Contes","level":"B2","main":true},{"title":"Pourquoi Vingt Mille Lieues sous les mers est un chef-d’œuvre intemporel","channel":"Timeless Lit Masterpieces","videoId":"X3JUq4AcAy0","why":"تحليل معمّق لـ la figure de Nemo et la structure du récit d’aventure scientifique.","cat":"Contes","level":"B2","extra":true},{"title":"Résumé complet de « Vingt mille lieues sous les mers »","channel":"TonLivre","videoId":"VnjdT1ntHUg","why":"ملخّص مشروط بطول الرواية: تتبّع le récit كاملاً مع les temps du récit قبل التحليل.","cat":"Contes","level":"B2","extra":true}],"supplements":[{"id":"X3JUq4AcAy0","title":"Pourquoi Vingt Mille Lieues sous les mers est un chef-d’œuvre intemporel","channel":"Timeless Lit Masterpieces","why":"تحليل معمّق لـ la figure de Nemo et la structure du récit d’aventure scientifique.","lang":"fr","dur":18},{"id":"VnjdT1ntHUg","title":"Résumé complet de « Vingt mille lieues sous les mers »","channel":"TonLivre","why":"ملخّص مشروط بطول الرواية: تتبّع le récit كاملاً مع les temps du récit قبل التحليل.","lang":"fr","dur":35}]},{"id":"b2-t9-l15","fr":"Don Quichotte — Miguel de Cervantes","ar":"دون كيخوتي — ميغيل دي ثيربانتس","objectives":["تحليل بناء le récit chez Cervantes: la transformation, l’aventure, la chute et la mort","استعمال les temps du récit (imparfait, passé simple, plus-que-parfait) لسرد حدث من رواية","اكتساب ما يزيد على 40 مفردة autour de la chevalerie, de la folie et de l’honneur","تفسير l’humour espagnol ولماذا يُعدّ Don Quichotte أول رواية حديثة"],"sections":[{"h":"الدرس 15: تحليل Don Quichotte بالفرنسية","video":{"id":"ol60aRNij5Q","title":"« Don Quichotte » de Miguel de Cervantes Résumé et analyse en format court","channel":"L’essence des livres","why":"ملخّص وتحليل مختصر بالفرنسية لبنية الرواية: Alonso Quijano يصبح Don Quichotte، les moulins à vent، la folie chevaleresque et la portée de l’humour espagnol.","lang":"fr","main":true,"dur":9},"p":["Don Quichotte (1605–1615) لميغيل دي ثيربانتس يبدأ بفعل بسيط جداً: رجل قرأ كثيراً في كتب الفروسية حتى جفّ عقله من كثرة القراءة. la première leçon: le récit des origines يُبنى على l’imparfait (l’habitude de la lecture) avant le passé simple (la décision de partir).","المفردات الأساسية: le moulin à vent, la folie, la chevalerie, l’honneur, l’écuyer, l’illusion, le géant, la lance, la franchise, le proverbe, s’équiper, le paysage.","نحوياً، لاحظ la série des temps: « Il lisait quand il décida de partir. Il avait lu tant de romans qu’il en perdit la raison. » — l’imparfait décrit l’habitude، le plus-que-parfait يعلّل، ثم le passé simple يُطلق الحركة.","les personnages forment un duo comique: Don Quichotte voit des géants, Sancho voit des moulins — la folie de l’un et la franchise de l’autre se corrigent réciproquement. c’est la structure même de l’humour espagnol.","la morale: Cervantes ne se moque pas seulement du héros — il moque aussi ceux qui prennent le rêve pour réel. la frontière entre la folie et le courage reste ouverte: مَن المجنون، المفترض أم من يقبل الواقع كما هو؟","les versions comparées: dans la seconde partie (1615)، les personnages يعرفون روايتهم ويسخرون منها — وهذا هو la mise en abyme التي تجعل العمل أول رواية حديثة في تاريخ الأدب الأوروبي."],"sub":[{"h":"la naissance d’un chevalier","p":["« Il perdit la raison à force de lire. »","Il changea son nom en Don Quichotte.","la chevalerie — الفروسية"]},{"h":"les moulins à vent","p":["« Ce sont des géants, Sancho ! »","Sancho: « Ce sont des moulins, maître. »","le moulin à vent — طاحونة الهواء"]},{"h":"vocabulaire de l’aventure","p":["l’écuyer — الرسّان","la lance — الرمح","la franchise — الصراحة"]}]},{"h":"phrases clés du récit","p":["« Il faut que je devienne chevalier errant. » — le désir formulé au présent, programme de tout le récit.","« Prends garde, Sancho, à ces géants. » — l’erreur de perception, point culminant de la scène des moulins.","« La liberté, Sancho, est un des plus beaux présents. » — la morale du personnage, dite avec gravité.","« Je fus autrefois fou, et je suis sage maintenant. » — le retournement final au passé simple."]},{"h":"التطبيق والتلخيص","p":["تمرين la réécoute: استمع إلى الملخّص ودوّن خمس جمل au passé simple وثلاث جمل au plus-que-parfait ثم رتّبها.","تمرين la scène: أعد كتابة مشهد الطواحين في 90 كلمة، مرة من نظرة Quichotte ومرة من نظرة Sancho — لاحظ تغيّر les temps selon le point de vue.","اكتب فقرة عن « هوس » طالبت به: استعمل l’imparfait pour la routine et le passé simple pour la décision، مع خمس مفردات من الدرس."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: «Don Quichotte» تحوّل la folie إلى la sagesse: البطل يرى la chevalerie خلف moulin à vent ويرى العمالقة حيث لا عمالقة، و l’humour espagnol يجعله أول رواية حديثة. أعد مشاهدة الفيديو الرئيسي وركّز على les temps du récit (imparfait, passé simple, plus-que-parfait) في la scène des moulins.","جسر الدروس: من b2-t9-l14 (عشرون ألف فرسخ تحت البحار — جول فيرن) إلى b2-t9-l15 (دون كيخوتي — ميغيل دي ثيربانتس)، ثم إلى b2-t10-l1 حيث تبدأ كتب العالم بالكونت دي مونت كريستو عند Dumas وقصة الانتقام والصبر.","مهمة تطبيقية: أعد سرد la scène des moulins في دقيقة واحدة مع تسجيل صوتك، ثم استخرج 3 كلمات جديدة من الدرس واكتب بها جملتين، وأخيراً قارن سردهك بالفيديو الرئيسي وحدّد الفرق في le ton entre la folie et la satire."]}],"pron":[{"w":"le moulin à vent","ipa":"[lə mulɛ̃ à vɑ̃]","approx":"لو مولان أو فيان"},{"w":"la folie","ipa":"[la fɔli]","approx":"لا فولي"},{"w":"l’honneur","ipa":"[lɔnœʁ]","approx":"لونور"}],"vocab":[{"fr":"le moulin à vent","ar":"طاحونة الهواء","pos":"nom","g":"m","exFr":"Il prit les moulins pour des géants.","ipa":"","exAr":"ظنّ أن طواحين الهواء عمالقة."},{"fr":"la folie","ar":"الجنون","pos":"nom","g":"f","exFr":"Sa folie vient des romans de chevalerie.","ipa":"[la fɔli]","exAr":"جنونه نتج عن كتب الفروسية."},{"fr":"la chevalerie","ar":"الفروسية","pos":"nom","g":"f","exFr":"Il voulait restaurer la chevalerie.","ipa":"","exAr":"أراد أن يُعيد الفروسية إلى زمنها."},{"fr":"l’honneur","ar":"الشرف","pos":"nom","g":"m","exFr":"Il défend l’honneur de sa dame.","ipa":"[lɔnœʁ]","exAr":"يدافع عن شرف سيدته."},{"fr":"l’écuyer","ar":"الرسّان","pos":"nom","g":"m","exFr":"Sancho est l’écuyer de Don Quichotte.","ipa":"","exAr":"سانشو رسان دون كيخوتي."},{"fr":"l’illusion","ar":"الوهم","pos":"nom","g":"f","exFr":"L’illusion gouverne ses actes.","ipa":"","exAr":"يسيطر الوهم على أفعاله."},{"fr":"la jument","ar":"الفرس (البغلة)","pos":"nom","g":"f","exFr":"La jument de Don Quichotte s’appelle Rocinante.","ipa":"[ʒymɑ̃t]","exAr":"فرس دون كيخوتي اسمه روسينانتي."},{"fr":"la lance","ar":"الرمح","pos":"nom","g":"f","exFr":"Sa lance se brisa au premier choc.","ipa":"","exAr":"انكسر رمحه عند أول اصطدام."},{"fr":"la franchise","ar":"الصراحة","pos":"nom","g":"f","exFr":"La franchise de Sancho est comique.","ipa":"","exAr":"صراحة سانشو مضحكة."},{"fr":"le proverbe","ar":"المثل العام","pos":"nom","g":"m","exFr":"Sancho répète un proverbe à chaque obstacle.","ipa":"","exAr":"يكرر سانشو المثل عند كل عقبة."},{"fr":"s’équiper","ar":"يتزوّد ويُعدّ العدة","pos":"verbe","g":"","exFr":"Il s’équipa avec une lance trouée.","ipa":"","exAr":"تزود برمح مثقوب."},{"fr":"le paysage","ar":"المنظر الطبيعي","pos":"nom","g":"m","exFr":"Le paysage de La Manche est aride.","ipa":"","exAr":"منظر لا منتشا جافّ."}],"examples":[{"fr":"Il lisait des romans quand il décida de partir.","ar":"كان يقرأ الروايات حين قرر الرحيل.","note":"imparfait + passé simple"},{"fr":"Il avait lu tant de romans qu’il en perdit la raison.","ar":"قرأ من الروايات حتى فقد عقله.","note":"plus-que-parfait de cause"},{"fr":"Il prit les moulins à vent pour des géants.","ar":"اتّخذ الطواحين الهوائية هائلة العملاقين.","note":"prendre … pour"},{"fr":"Don Quichotte attaqua le moulin avec courage.","ar":"هاجم دون كيخوتي الطاحونة بشجاعة.","note":"passé simple d’action"},{"fr":"Il faut que Sancho croie en son maître.","ar":"يجب أن يصدق سانشو معلّمه.","note":"subjonctif"},{"fr":"Bien que la lance fût brisée, il continua.","ar":"على الرغم من أن رمحه كان مكسوراً، واصل.","note":"bien que + subjonctif"}],"grammar":[{"tFr":"Les temps du récit: imparfait, passé simple, plus-que-parfait","tAr":"أزمنة السرد الثلاثة","body":["« Il lisait, il avait lu trop de romans, et un matin il partit. » — l’imparfait donne l’habitude, le plus-que-parfait explique la cause, le passé simple déclenche l’événement.","la règle B2: ces trois temps forment la chaîne complète du récit — انقل نفس الحكاية بتبديل أحدها ولاحظ كيف يتغيّر المعنى."],"ex":[{"fr":"Sancho croyait à son maître quand le vent tourna.","ar":"كان سانشو يصدق معلّمه حين اتجه الريح."},{"fr":"Il avait déjà perdu la raison avant de sortir.","ar":"كان قد فقد عقله قبل أن يخرج."}]},{"tFr":"Le subjonctif présent: il faut que, bien que, avant que","tAr":"المضارع التام في المضارع البديل","body":["« Il faut que je devienne chevalier. » — après une nécessité (il faut que, vouloir que, douter que), le verbe passe au subjonctif: c’est le désir, pas le fait.","« Bien que la lance fût brisée, il attaqua encore. » — bien que + subjonctif introduit une concession: la logique cède devant l’obstination du héros."],"ex":[{"fr":"Je veux que Sancho soit mon écuyer.","ar":"أريد أن يكون سانشو رسّاني."},{"fr":"Avant que le jour ne tombe, il faut partir.","ar":"قبل أن يحلّ اليوم، يجب أن نرحل."}]}],"mistakes":[{"wrong":"lire Don Quichotte comme une simple farce","right":"voir la frontière folie / courage","why":"Cervantes moque le héros et le monde qui l’entoure à la fois."},{"wrong":"croire que le titre vient de l’espagnol moderne","right":"« Quijote » = la cuisse, l’homme de l’armure","why":"le nom même du héros est un jeu de mots savant."},{"wrong":"utiliser le présent dans un récit au passé","right":"respecter la chaîne des temps","why":"le récit tient sur l’imparfait, le passé simple et le plus-que-parfait."},{"wrong":"dire « il faut que + indicatif »","right":"dire « il faut que + subjonctif »","why":"après une nécessité, le français exige le subjonctif."}],"dialogues":[{"title":"Devant les moulins à vent","ctx":"Don Quichotte et Sancho sur la route de La Manche","lines":[{"who":"Don Quichotte","fr":"Regarde, Sancho, ces géants qui menacent la route.","ar":"انظر يا سانشو، هؤلاء العمالقة يهددون الطريق."},{"who":"Sancho","fr":"Ce sont des moulins à vent, maître.","ar":"إنها طواحين هواء يا معلّم."},{"who":"Don Quichotte","fr":"Tu n’as pas l’imagination d’un chevalier.","ar":"لا تملك خيال الفارس."},{"who":"Sancho","fr":"Et vous, maître, n’avez pas les yeux d’un paysan.","ar":"وأنت يا معلّم لا تملك عيني الفلاح."}]},{"title":"Le départ pour l’aventure","ctx":"La veille de la première sortie","lines":[{"who":"Don Quichotte","fr":"Il faut que je devienne chevalier errant.","ar":"يجب أن أصبح فارساً تائهاً."},{"who":"Sancho","fr":"Vous partez sans argent ni armes.","ar":"ترحل بلا مال ولا سلاح."},{"who":"Don Quichotte","fr":"La franchise vaut mieux que l’or.","ar":"الصراحة خير من الذهب."},{"who":"Sancho","fr":"L’or, lui, nourrit la franchise.","ar":"أما الذهب فيُطعم الصراحة."}]}],"exercises":[{"t":"mcq","skill":"reading","q":"ما الذي رآه Don Quichotte في مواجهته الأولى؟","opts":["طواحين هواء ظنّها عمالقة","جيشاً من الفرسان","قلعة محصّنة","وادياً مخيفاً"],"a":0,"why":"هذه المشهد هو رمز la folie chevaleresque في الرواية."},{"t":"fill","skill":"grammar","q":"أكمل: «Il faut que Sancho ___ (croire) à son maître.»","fr":"Il faut que Sancho ... à son maître.","ans":"croie","why":"après « il faut que », on emploie le subjonctif présent."},{"t":"mcq","skill":"vocabulary","q":"أي كلمة تعني «الرسّان»؟","opts":["l’écuyer","la lance","le proverbe","le paysage"],"a":0,"why":"l’écuyer = الرسّان، وهو لقب Sancho."},{"t":"order","skill":"writing","q":"رتّب: اتخذ الطواحين الهوائية هائلة العملاقين","words":["Il","prit","les","moulins","à","vent","pour","des","géants."],"ans":"Il prit les moulins à vent pour des géants.","why":"la structure prendre X pour Y exprime la méprise."},{"t":"listen","skill":"listening","q":"أي جملة تصف la franchise de Sancho ?","opts":["Ce sont des moulins à vent, maître.","Il faut que je devienne chevalier.","La liberté est un beau présent.","Il lisait des romans."],"a":0,"why":"Sancho corrige son maître sans flatterie: c’est la franchise."},{"t":"translate","skill":"writing","q":"ترجم: «كان يقرأ الروايات حين قرر الرحيل.» إلى الفرنسية.","ans":"Il lisait des romans quand il décida de partir.","why":"imparfait pour l’habitude, passé simple pour la décision."},{"t":"speaking","skill":"speaking","q":"قل جملة «Ce sont des moulins à vent» بنبرة تحذيرية ثم بنبرة استهزاء، واحتفظ بالمعنى.","target":"Ce sont des moulins à vent, maître !","why":"l’humour espagnol vit dans le ton double du dialogue."},{"t":"correct","skill":"grammar","q":"صحّح: «Bien que la lance était brisée, il continua.»","ans":"Bien que la lance fût brisée, il continua.","why":"bien que commande le subjonctif, pas l’imparfait de l’indicatif."}],"homework":"اكتب مشهداً من 140 كلمة: «moment où j’ai pris une chose pour une autre»، استعمل 4 أفعال au passé simple، جملتين au plus-que-parfait، جملة بـ «bien que + subjonctif»، و5 مفردات من الدرس.","sources":[{"title":"« Don Quichotte » de Miguel de Cervantes Résumé et analyse en format court","channel":"L’essence des livres","videoId":"ol60aRNij5Q","why":"ملخّص وتحليل مختصر بالفرنسية لبنية الرواية: Alonso Quijano يصبح Don Quichotte، les moulins à vent، la folie chevaleresque et la portée de l’humour espagnol.","cat":"Contes","level":"B2","main":true},{"title":"MIGUEL DE CERVANTÈS / DON QUICHOTTE / LA P'TITE LIBRAIRIE","channel":"La Grande Librairie - France Télévisions","videoId":"EoPqPazhxSE","why":"مقابلة تلفزيونية فرنسية عن Don Quichotte: la réception contemporaine de l’œuvre et ses traductions.","cat":"Contes","level":"B2","extra":true},{"title":"Pourquoi il faut être fou — Philosophie de Don Quichotte","channel":"Monos","videoId":"olhWWXduxBc","why":"قراءة فلسفية للجنون والحرية: مقارنة la morale عند Cervantes مع la morale عند les philosophes.","cat":"Contes","level":"B2","extra":true}],"supplements":[{"id":"EoPqPazhxSE","title":"MIGUEL DE CERVANTÈS / DON QUICHOTTE / LA P'TITE LIBRAIRIE","channel":"La Grande Librairie - France Télévisions","why":"مقابلة تلفزيونية فرنسية عن Don Quichotte: la réception contemporaine de l’œuvre et ses traductions.","lang":"fr","dur":2},{"id":"olhWWXduxBc","title":"Pourquoi il faut être fou — Philosophie de Don Quichotte","channel":"Monos","why":"قراءة فلسفية للجنون والحرية: مقارنة la morale عند Cervantes مع la morale عند les philosophes.","lang":"fr","dur":22}]}]},{"id":"b2-t10","slug":"livres-du-monde","icon":"quote","color":"#6a1b9a","fr":"Livres du monde","ar":"الكتب العالمية","desc":"20 كتاباً كلاسيكياً من فرنسا والعالم تُقرأ ويُحلَّل بالفرنسية: les romans، le théâtre، la poésie، les classiques traduits — le livre comme professeur.","lessons":[{"id":"b2-t10-l1","fr":"Le Comte de Monte-Cristo — Alexandre Dumas","ar":"الكونت دي مونت كريستو — ألكسندر دوما","objectives":["تحليل la structure du roman en trois temps: Marseille, le Château d’If, la vengeance — وربط كل جزء بطبيعة le récit","تمييز l’imparfait (le décor, l’habitude) عن le passé simple (l’événement décisif) وعن le plus-que-parfait (l’anteriorité) داخل le récit d’aventure","_acquire 12 كلمة أساسية autour de la vengeance, de la trahison, de la patience, de l’évasion et de la providence","تفسير لماذا يُصنَّف Dumas كـ romancier de l’aventure، وكيف يقود le thème de la providence la vengeance d’Edmond Dantès"],"sections":[{"h":"الدرس 1: تحليل «الكونت دي مونت كريستو»: الانتقام، الهروب، والمغامرة","video":{"id":"yWubaFg4e7U","title":"Résumé Le Comte de Monte Cristo d’Alexandre Dumas","channel":"Les Résumés","why":"ملخّص مدرسي متماسك يعرض la structure du roman في ثلاث محطات (Marseille، le Château d’If، l’île de Monte-Cristo) ثم يشرح la vengeance du comte — يمهّد لتحليل le récit d’aventure و les temps littéraires.","lang":"fr","main":true,"dur":10},"p":["«Le Comte de Monte-Cristo» (1844) هو roman-feuilleton من ثلاث محطات: مرسيليا حيث يُسجن Edmond Dantès ظلماً، ثم أربعة عشر عاماً في le Château d’If حيث يلتقي بال abbé Faria، وأخيراً عالم le trésor و le déguisement في le comte de Monte-Cristo. le récit d’aventure يعتمد على la cascade d’événements: كل فصل يفتح باب مغامرة جديدة، وهذا ما يمنح الرواية إيقاعها السريع.","المفردات المحورية في هذا الدرس: la vengeance (الانتقام)، la trahison (الخيانة)، la prison (السجن)، s’évader (يُفلت من السجن)، le château d’If (قلعة إف)، le trésor (الكنز)، la patience (الصبر)، l’espérance (الأمل)، le naufrage (الغرق)، l’identité (الهوية)، le faux ami (الصديق الزائف)، la providence (العناية الإلهية).","نحوياً، Dumas يبني le récit على تناوب واضح: l’imparfait يرسم la situation et l’habitude (« Pendant qu’il était prisonnier, il apprenait les langues »)، le passé simple يُدخل الحدث (« Un jour, il aperçut un sac »)، و le plus-que-parfait يُعلِن الأسبقية (« Quand il revint à la cellule, l’abbé était déjà mort »). هذه السلسلة الثلاثية هي عصب le récit الطويل.","الشخصيات تُبنى على la dualité: Edmond Dantès البحّار البريء يتحوّل إلى le comte de Monte-Cristo البارد الحساب، بينما تبقى Mercédès رمز la fidélité، و Danglars و Fernand و Villefort les trois faux amis الذين يمثلون la trahison الاجتماعية والسياسية والمهنية. l’abbé Faria هو le mentor qui transforme la colère en méthode.","الموضوع المحوري هو la vengeance، لكن Dumas يربطها بـ la providence: البطل يظنّ نفسه أداةً في يد القدر (« Je suis le Providentiel »)، وفي القسم الأخير يكتشف أن الانتقام قد يجرّ ضحايا لا ذنب لهم. لاحظ في المقطع الشهير أن la patience تظهر كـ une arme: « Attendre et espérer ! » شعارٌ يجعل من الصبر استراتيجية لا انفعالاً.","خلاصة الدرس: لفهم le récit عند Dumas، اقرأ بعينين واحدة تتابع l’aventure والأخرى تراقب la construction des personnages. المهمة: أعد كتابة صفحة واحدة تصف فيها هروب Dantès من le Château d’If، مستخدماً أزمنة le récit الثلاثة على الأقل مرتين."],"sub":[{"h":"attendre et espérer","p":["« Attendre et espérer ! »","La patience est l’arme du prisonnier.","Le temps transforme Dantès en Monte-Cristo."]},{"h":"les temps du récit","p":["l’imparfait: « Il était enfermé… »","le passé simple: « Il s’évada. »","le plus-que-parfait: « Il avait appris… »"]},{"h":"le vocabulaire de l’aventure","p":["s’évader — يُفلت من السجن","la vengeance — الانتقام","le trésor — الكنز"]}]},{"h":"les phrases clés du roman","p":["« Attendre et espérer ! » — la devise que l’abbé Faria lègue à Dantès: la patience devient une stratégie, non une résignation.","« Je suis le Providentiel. » — le comte se croit l’instrument de la vengeance divine: la justice humaine a échoué, la sienne corrige l’équilibre.","« Allez, courage, Edmond ! » — l’appel du mentor: l’aventure ne commence pas par la force, mais par l’étude et la maîtrise de soi.","« L’homme n’est que impiété et misère. » — la leçon amère du vieux prisonnier: la méchanceté des hommes explique la rigueur de la vengeance du comte."]},{"h":"التطبيق والتلخيص","p":["تمرين la réécoute: شغّل الجزء المتعلق بـ l’évasion du Château d’If بدون sous-titres، ثم اكتب les quatre étapes de l’évasion في أربع جمل.","تمرين la comparaison: اختر شخصيةً واحدة (Mercédès, Danglars, Faria) واكتب 70 كلمة تشرح دورها في la vengeance du comte.","اكتب paragraphe de 90 mots بالفرنسية تشرح فيه الفرق بين Dantès البحّار و le comte de Monte-Cristo — مع 4 مفردات من la leçon."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: رواية دوما في ثلاث محطات — مرسيليا، le Château d’If، جزيرة Monte-Cristo — يتحوّل فيها Edmond Dantès من بحّارٍ مغدور إلى كونتٍ يخطّط انتقامه بمنهجية. أعد مشاهدة الفيديو الرئيسي وركّز على تسلسل l’évasion من القلعة وعلى تحوّل la claustration الطويلة إلى خطة انتقامٍ منضبطة.","جسر الدروس: من b2-t9-l15 (دون كيخوتي — مغامرةُ فارسٍ تُفضح أوهام الفروسيّة القروسطية) إلى b2-t10-l1 (الكونت دي مونت كريستو — الانتقام والهروب والمغامرة)، ثم إلى b2-t10-l2 حيث «البؤساء» لـ Hugo ينقل الصراع من الانتقام الفردي إلى مسار الضمير والعدالة الاجتماعية.","مهمة تطبيقية: سجّل ملخّص الرواية في دقيقةٍ واحدة بصوتك، استعمل فيها 3 كلمات جديدة (la claustration, le magot, la dérive)، ثم قارن تسلسل l’évasion في الفيديو الرئيسي بسردك: أيّ تفصيلٍ أضافه الفيديو ولم تذكره أنت؟"]}],"pron":[{"w":"se soustraire","ipa":"[səsustʁɛʁ]","approx":"سُسوسترير"},{"w":"la vengeance","ipa":"[vɑ̃sɑ̃s]","approx":"فانسانس"},{"w":"la claustration","ipa":"[klɔstʁasjɔ̃]","approx":"كلوسطراسيون"}],"vocab":[{"fr":"la vengeance","ar":"الانتقام","pos":"nom","g":"f","exFr":"La vengeance dure quatorze ans dans le roman de Dumas.","ipa":"[vɑ̃sɑ̃s]","exAr":"يستمر الانتقام أربعة عشر عاماً في رواية دوما."},{"fr":"la trahison","ar":"الخيانة","pos":"nom","g":"f","exFr":"La trahison de Danglars et de Fernand envoie Dantès en prison.","ipa":"[tʁɛzɔ̃]","exAr":"خيانة دانغار وفرناند تُرسل دانتيس إلى السجن."},{"fr":"la prison","ar":"السجن","pos":"nom","g":"f","exFr":"Il passe quatorze ans dans la prison du Château d’If.","ipa":"[pʁizɔ̃]","exAr":"يقضي أربعة عشر عاماً في سجن قلعة إف."},{"fr":"se soustraire","ar":"يُفلِت من مكان محروس","pos":"verbe","g":"","exFr":"Grâce au corps de l’abbé, il parvient à se soustraire.","exAr":"بفضل جثة القسيس يتمكن من الفرار.","ipa":"[səsustʁɛʁ]"},{"fr":"le Château d’If","ar":"قلعة إف","pos":"nom","g":"m","exFr":"Le Château d’If se dresse au large de Marseille.","ipa":"[ʃato dif]","exAr":"قلعة إف تطل على مرسيليا من البحر."},{"fr":"le magot","ar":"الكنز المخفي","pos":"nom","g":"m","exFr":"Le magot de l’île transforme le prisonnier en comte.","exAr":"الكنز المخفي في الجزيرة يحوّل السجين إلى كونت.","ipa":"[mago]"},{"fr":"la claustration","ar":"الحبس الانفرادي","pos":"nom","g":"f","exFr":"La claustration au Château d’If dure quatorze ans.","exAr":"الحبس الانفرادي في قلعة إف يمتد أربعة عشر عاماً.","ipa":"[klɔstʁasjɔ̃]"},{"fr":"l’espérance","ar":"الأمل","pos":"nom","g":"f","exFr":"L’espérance le maintient vivant pendant des années.","ipa":"[ɛspeʁɑ̃s]","exAr":"الأمل يُبقيه حياً لسنوات."},{"fr":"la dérive","ar":"الانجراف في البحر","pos":"nom","g":"f","exFr":"La dérive du Pharaon ouvre le destin d’Edmond.","exAr":"انجراف سفينة الفرعون يفتتح مصير إدمون.","ipa":"[dʁiv]"},{"fr":"l’identité","ar":"الهوية","pos":"nom","g":"f","exFr":"Il abandonne son identité pour devenir le comte.","ipa":"[idɑ̃tite]","exAr":"يتخلى عن هويته ليصبح الكونت."},{"fr":"le faux ami","ar":"الصديق الزائف","pos":"nom","g":"m","exFr":"Danglars et Fernand sont de faux amis.","ipa":"[fo ami]","exAr":"دانغار وفرناند صديقان زائفان."},{"fr":"la providence","ar":"العناية الإلهية","pos":"nom","g":"f","exFr":"Le comte se croit un instrument de la providence.","ipa":"[pʁɔvidɑ̃s]","exAr":"يظنّ الكونت أنه أداة في يد العناية الإلهية."}],"examples":[{"fr":"Dantès fut arrêté au moment où il célébrait ses fiançailles.","ar":"أُلقي القبض على دانتيس وهو يحتفل بخطوبته.","note":"le passé simple de l’événement"},{"fr":"Pendant qu’il était prisonnier, il apprenait les langues et la géologie.","ar":"أثناء وجوده سجيناً كان يتعلم اللغات والجيولوجيا.","note":"l’imparfait de l’habitude"},{"fr":"Quand il revint à la cellule, l’abbé était déjà mort.","ar":"حين عاد إلى الزنزانة كان القسيس قد مات.","note":"le plus-que-parfait de l’anteriorité"},{"fr":"Attendre et espérer ! telle fut sa devise.","ar":"«انتظر وتأنّ!» هكذا كان شعاره.","note":"la phrase clé du roman"},{"fr":"Le comte découvrit le trésor et devint un homme nouveau.","ar":"اكتشف الكونت الكنز وأصبح إنساناً جديداً.","note":"le passage du héros à la puissance"},{"fr":"Il attendit quatorze ans avant de se venger.","ar":"انتظر أربعة عشر عاماً قبل أن ينتقم.","note":"la patience comme vertu du héros"}],"grammar":[{"tFr":"Les temps du récit : imparfait, passé simple, plus-que-parfait","tAr":"أزمنة السرد: الوصف والحدث والأسبقية","body":["le récit d’aventure chez Dumas suit une règle stable: l’imparfait peint le décor, l’état et l’habitude (« Il habitait une petite maison de Marseille »), le passé simple introduit l’événement qui fait avancer l’histoire (« Le Pharaon entra dans le port »), et le plus-que-parfait situe une action antérieure à un autre passé (« Il avait déjà appris le latin avec Faria »).","concordance des temps: après une circonstancielle de temps au passé simple, l’action la plus ancienne passe au plus-que-parfait — « Quand le navire arriva, Dantès avait déjà vu Faria. » C’est cette architecture temporelle qui rend le récit à la fois clair et mouvementé."],"ex":[{"fr":"Le comte attendit quatorze ans, puis il passa à l’action.","ar":"انتظر الكونت أربعة عشر عاماً ثم انتقل إلى العمل."},{"fr":"Quand il revint à la cellule, l’abbé était déjà mort.","ar":"حين عاد إلى الزنزانة كان القسيس قد مات."}]},{"tFr":"Les circonstancielles de temps : quand, dès que, aussitôt que","tAr":"ظروف الزمان: quand، dès que، aussitôt que","body":["le récit d’aventure s’appuie sur des circonstancielles de temps qui scannent l’action: « quand » marque le moment exact, « dès que » et « aussitôt que » expriment l’immédiateté (« Dès qu’il eut le trésor, il changea de nom »), « une fois que » insiste sur l’achèvement (« Une fois sorti de la grotte, il regarda la mer »).","règle B2: ces propositions se placent souvent en tête de phrase et peuvent provoquer une inversion sujet-verbe dans la principale (« Dès que le comte eut fini, il partit ») — jamais d’oubli du subjonctif après « avant que » (« avant qu’il ne parte »)."],"ex":[{"fr":"Dès que le comte eut découvert le trésor, il changea de nom.","ar":"ما إن اكتشف الكونت الكنز حتى غيّر اسمه."},{"fr":"Avant qu’il ne quitte l’île, il brûla les papiers.","ar":"قبل أن يغادر الجزيرة أحرق الأوراق."}]}],"mistakes":[{"wrong":"raconter toute l’histoire au passé composé","right":"alterner imparfait, passé simple et plus-que-parfait","why":"le décor reste à l’imparfait, l’événement avance au passé simple, l’anteriorité passe au plus-que-parfait."},{"wrong":"confondre « la vengeance » et « la revanche »","right":"la vengeance punit l’ennemi, la revanche gagne un duel ou un match","why":"dans le roman, il s’agit d’une vengeance calculée sur quatorze ans, pas d’une revanche immédiate."},{"wrong":"« Quand il arriva, il a vu Faria mort. »","right":"Quand il arriva, il vit Faria mort (ou : il l’avait déjà vu).","why":"après une circonstancielle au passé simple, on emploie un autre temps du passé, jamais le passé composé."},{"wrong":"traduire « attendre et espérer » par « rester inactif »","right":"attendre et espérer = une stratégie patiente","why":"pour l’abbé Faria, l’attente est un travail: on étudie, on prépare, puis on agit."}],"dialogues":[{"title":"la cellule de l’abbé Faria","ctx":"le vieil abbé donne à Dantès les clés de sa libération future","lines":[{"who":"L’abbé Faria","fr":"Écoute-moi, Edmond : la force seule ne sort jamais de prison.","ar":"اسمعني يا إدمون: القوة وحدها لا تُخرج أحداً من السجن."},{"who":"Edmond Dantès","fr":"Alors comment faire, mon père ?","ar":"فكيف أفعل يا أبت؟"},{"who":"L’abbé Faria","fr":"Attendre et espérer, et pendant ce temps, apprendre.","ar":"انتظر وتأنّ، وفي هذه الأثناء تعلّم."},{"who":"Edmond Dantès","fr":"Vous m’avez appris à penser autrement.","ar":"لقد علّمتني أن أفكر بشكلٍ آخر."}]},{"title":"la vengeance du comte","ctx":"le comte retrouve Mercédès et lui avoue son passé","lines":[{"who":"Le comte de Monte-Cristo","fr":"J’étais Edmond Dantès, et le Château d’If m’a volé ma jeunesse.","ar":"كنت إدمون دانتيس، وقد سرقّتني قلعة إف شبابي."},{"who":"Mercédès","fr":"Je vous ai attendu des années, sans nouvelles.","ar":"انتظرتك سنوات دون أي خبر."},{"who":"Le comte de Monte-Cristo","fr":"Ma vengeance a commencé le jour où j’ai surgi de la mer.","ar":"بدأ انتقامي يوماً نهضتُ من البحر."},{"who":"Mercédès","fr":"La vengeance ne vous rendra pas le bonheur.","ar":"لن يُعيد لك الانتقام السعادة."}]}],"exercises":[{"t":"mcq","skill":"comprehension","q":"ما الشعار الذي يلخّص فلسفة l’abbé Faria ? ","opts":["Attendre et espérer.","Se venger tout de suite.","Dénoncer ses ennemis.","Quitter la France."],"a":0,"why":"« Attendre et espérer ! » هو وصية l’abbé لـ Dantès وشعار الرواية ككل."},{"t":"fill","skill":"grammar","q":"أكمل بالزمن المناسب: «Quand le comte revint, Faria ___ déjà mort.»","fr":"Quand le comte revint, Faria ... déjà mort.","ans":"était mort","why":"بعد circonstancielle au passé simple، تُعبَّر عن الأسبقية بـ le plus-que-parfait."},{"t":"mcq","skill":"vocabulary","q":"ما معنى « s’évader » في هذا السياق ?","opts":["quitter une prison par la fuite","acheter un trésor","se battre en duel","attendre patiemment"],"a":0,"why":"s’évader = s’échapper d’un lieu clos, surtout de la prison."},{"t":"order","skill":"writing","q":"رتّب: الكونت انتظر أربعة عشر عاماً قبل أن ينتقم","words":["Le","comte","attendit","quatorze","ans","avant","de","s’évader."],"ans":"Le comte attendit quatorze ans avant de s’évader.","why":"avant de + infinitif marque la temporalité du récit, avec le passé simple."},{"t":"listen","skill":"listening","q":"أي جملة تُظهر le passé simple de l’événement ?","opts":["Dantès fut arrêté le jour de ses fiançailles.","Dantès se promenait chaque soir sur le port.","Dantès regardait la mer depuis sa cellule.","Dantès parlait souvent de son père."],"a":0,"why":"le passé simple introduce l’événement ponctuel qui déclenche le récit."},{"t":"translate","skill":"writing","q":"ترجم: «الانتقام عند دوما ليس اندفاعاً، بل خطةٌ طويلة.»","ans":"Chez Dumas, la vengeance n’est pas un élan, c’est un long calcul.","why":"la structure « non pas…, c’est… » exprime la nuance et le rythme du propos critique."},{"t":"speaking","skill":"speaking","q":"اشرح بالفرنسية في ثلاث جمل كيف تحوّل Dantès إلى Monte-Cristo.","target":"Edmond Dantès devient le comte de Monte-Cristo parce qu’il a étudié, attendu et organisé sa vengeance pendant quatorze ans.","why":"l’explication mobilise le vocabulaire de la transformation et du temps long."},{"t":"correct","skill":"grammar","q":"صحّح: «Quand il arriva à Paris, il a déjà rencontré ses ennemis.»","ans":"Quand il arriva à Paris, il avait déjà rencontré ses ennemis.","why":"après une circonstancielle au passé simple, l’antériorité s’exprime au plus-que-parfait."}],"homework":"استمع إلى la scène de l’évasion ثلاث مرات بدون sous-titres، اكتب les quatre étapes de l’évasion في أربع جمل بالفرنسية، ثم اشرح في 80 كلمة لماذا «Attendre et espérer !» شعارٌ مناسب لـ le récit d’aventure.","sources":[{"title":"Résumé Le Comte de Monte Cristo d’Alexandre Dumas","channel":"Les Résumés","videoId":"yWubaFg4e7U","why":"ملخّص مدرسي متماسك يعرض la structure du roman في ثلاث محطات (Marseille، le Château d’If، l’île de Monte-Cristo) ثم يشرح la vengeance du comte — يمهّد لتحليل le récit d’aventure و les temps littéraires.","cat":"Livres","level":"B2","main":true},{"title":"Le Comte de Monte-Cristo : 14 ans au Château d’If, l’évasion d’Edmond Dantès","channel":"Dumas Raconté","videoId":"IDQxRv9S310","why":"تخصّص الحلقة كلها لـ l’évasion: تسلسل المشاهد يساعد على إعادة بناء le récit d’aventure وتحليل la patience du héros.","cat":"Livres","level":"B2","extra":true},{"title":"CHÂTEAU D’IF : derrière Monte-Cristo, 400 ans de prison","channel":"Revivre l’Histoire","videoId":"7Rm6d3ngQbA","why":"يقدّم le contexte historique de la prison الفعلية — يربط le cadre du récit بـ la réalité historique de Château d’If في مرسيليا.","cat":"Livres","level":"B2","extra":true}],"supplements":[{"id":"IDQxRv9S310","title":"Le Comte de Monte-Cristo : 14 ans au Château d’If, l’évasion d’Edmond Dantès","channel":"Dumas Raconté","why":"تخصّص الحلقة كلها لـ l’évasion: تسلسل المشاهد يساعد على إعادة بناء le récit d’aventure وتحليل la patience du héros.","lang":"fr","dur":44},{"id":"7Rm6d3ngQbA","title":"CHÂTEAU D’IF : derrière Monte-Cristo, 400 ans de prison","channel":"Revivre l’Histoire","why":"يقدّم le contexte historique de la prison الفعلية — يربط le cadre du récit بـ la réalité historique de Château d’If في مرسيليا.","lang":"fr","dur":11}]},{"id":"b2-t10-l2","fr":"Les Misérables — Victor Hugo","ar":"البؤساء — فيكتور هوغو","objectives":["تتبّع le parcours de Jean Valjean: le vol, la conversion, la fuite, le sacrifice — وربط كل مرحلة بـ le thème de la rédemption","استعمال le discours indirect (que + concordance des temps) et les propositions concessives (bien que + subjonctif) في التحليل الأدبي","_acquire 12 كلمة أساسية autour de la misère, du devoir, de la conscience, de la justice et de la pitié","تفسير لماذا يُصنَّف Hugo كـ écrivain du romantisme social، وكيف يحوّل le roman en un manifeste pour les déshérités"],"sections":[{"h":"الدرس 2: تحليل «البؤساء» لفيكتور هوغو: العدالة، البؤس، والرومانسية الاجتماعية","video":{"id":"AiHyYzxmqMw","title":"Les Misérables de Victor Hugo : un résumé et pourquoi il faut le lire","channel":"Le français c’est clair","why":"شرح واضح لـ la ligne narrative de Jean Valjean من السرقة إلى la rédemption، مع شرح لماذا تُصنَّف الرواية كـ œuvre du romantisme social — يمهّد لتحليل les thèmes و la justice.","lang":"fr","main":true,"dur":19},"p":["«Les Misérables» (1862) رواية بطولية تغطي أكثر من عشرين عاماً من حياة فرنسا: يبدأ الرواية مع Jean Valjean، المُدان على سرقة رغيف خبز، ثم نتابع تحوّله إلى Monsieur Madeleine العمدة الصالح، وأخيراً الأب الذي يُضحي بنفسه من أجل Cosette. le récit عند هوغو ليس خطاً مستقيماً: هو مسار la conscience.","المفردات المحورية: la misère (البؤس)، le vagabond (المتشرد)، le forçat (المُدان بالأشغال الشاقة)، la rédemption (التكفير والخلاص)، la conscience (الضمير)، le devoir (الواجب)، l’injustice (الظلم)، la pitié (الشفقة)، le maire (العمدة)، la barricade (الحاجز الثوري)، l’orpheline (اليتيمة)، le peuple (الشعب).","نحوياً، Hugo يستعمل le discours indirect pour نقل أفكار الشخصيات وحكمته في آن واحد: « Valjean comprit que sa vie devait changer. » لاحظ concordance des temps. كما يستعمل la proposition concessive (bien que + subjonctif) لإبراز التوتر بين la loi et la conscience: « Bien qu’il fût innocent, il fut condamné. »","الشخصيات تتشكّل في مواجهة: Valjean يمثل la pitié et la conscience، Javert يمثل la loi froide sans nuance، Fantine تمثل la misère sociale، و Cosette تمثل la jeunesse التي يستحقها التضحية. Marius و les étudiants de 1832 يضيفون بعداً سياسياً: la barricade ليست مجرد مشهد بل موقف.","الحركة الأدبية: هوغو كـ romantique social يحوّل le roman إلى une tribune. la préface تعلن la mission: ما دام في العالم طفلٌ مُهمَل، فإن الرواية لن تكون بلا فائدة. la leçon: la justice légale لا تكفي، la conscience تُكمِّلها. هذا هو محور la confrontation entre Valjean et Javert.","خلاصة الدرس: اقرأ الرواية عبر ثلاثة خيوط: le récit de la rédemption، la critique sociale، و la tension entre la loi et la miséricorde. المهمة: اكتب فقرة من 90 كلمة بالفرنسية تشرح فيها لماذا كان لقاء l’évêque بـ Valjean نقطة التحول في الرواية."],"sub":[{"h":"la misère et la justice","p":["La misère pousse Valjean au vol.","La loi condamne, la conscience pardonne.","Fantine paie le prix de la pauvreté."]},{"h":"le discours indirect","p":["Valjean comprit que sa vie devait changer.","Il pensa que le devoir l’obligeait à rester.","Le récit rapporte les pensées sans « que » parfois."]},{"h":"le vocabulaire du devoir","p":["la conscience — الضمير","le devoir — الواجب","la rédemption — الخلاص"]}]},{"h":"les phrases clés du roman","p":["« Il entra à Digne comme un homme qui n’avait rien et il en sortit comme un homme qui avait tout. » — le don de l’évêque ouvre la voie de la rédemption.","« Aimer, c’est agir. » — le credo de Valjean: l’amour se prouve par le sacrifice, pas par les paroles.","« Tant qu’il existera, par le droit des gens, une seule créature déshéritée… le livre ne sera pas inutile. » — la préface transforme le roman en manifeste social.","Le devoir de Javert et la conscience de Valjean ne se rencontrent jamais. — la loi positive contre la loi morale: le cœur du conflit du roman."]},{"h":"التطبيق والتلخيص","p":["تمرين la réécoute: شغّل مشهد l’évêque et Valjean بدون sous-titres، ثم اكتب les trois gestes de la miséricorde في ثلاث جمل.","تمرين la comparaison: قارن بين Javert et l’évêque في 70 كلمة: أيّهما يعبّر عن la justice ?","اكتب paragraphe de 90 mots بالفرنسية تشرح فيه كيف يتحوّل le vol du pain إلى une histoire de rédemption — مع 4 مفردات من la leçon."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: يتتبّع هوغو مسار Jean Valjean من سرقة رغيف الخبز إلى التضحية الأخيرة، في روايةٍ تجعل la critique sociale عرضاً لمسار الضمير: لقاء l’évêque هو نقطة التحول، و Javert صورة la loi بلا رحمة. أعد مشاهدة الفيديو الرئيسي وركّز على مشهد الشمعدانين ثم على la confrontation entre la loi et la miséricorde.","جسر الدروس: من b2-t10-l1 (الكونت دي مونت كريستو — انتقامٌ محسوب يستهدف الخائنين) إلى b2-t10-l2 (البؤساء — استسلامُ ضميرٍ يحوّل العدالة القانونية إلى رحمة)، ثم إلى b2-t10-l3 حيث «الغريب» لـ Camus يُسقط الصراع نفسه في صمتٍ عبثيٍّ يرفض أيّ تفسيرٍ نفسي.","مهمة تطبيقية: سجّل ملخّص الرواية في تسجيلٍ صوتيٍّ مدته دقيقة، ووظّف 3 كلمات من مفردات الدرس (منها la droiture و la grâce)، ثم قارن مشهد l’évêque في الفيديو بوصفك: أيّ لحظةٍ غيّرت مسار Valjean فعلاً؟"]}],"pron":[{"w":"la misère","ipa":"[mizɛʁ]","approx":"ميزير"},{"w":"la droiture","ipa":"[dʁɥitʁ]","approx":"درويتور"},{"w":"le devoir","ipa":"[dəvwɑʁ]","approx":"دُفوَر"}],"vocab":[{"fr":"la misère","ar":"البؤس والفقر","pos":"nom","g":"f","exFr":"La misère de Fantine la pousse à vendre ses cheveux.","ipa":"[mizɛʁ]","exAr":"بؤس فانتين يدفعها لبيع شعرها."},{"fr":"le forçat","ar":"المُدان بالأشغال الشاقة","pos":"nom","g":"m","exFr":"Jean Valjean fut condamné comme forçat pour un vol de pain.","ipa":"[fɔʁsa]","exAr":"أُدين جان فالجان كمُدان بأعمال شاقة بسبب سرقة خبز."},{"fr":"la rédemption","ar":"الخلاص والتكفير","pos":"nom","g":"f","exFr":"La rédemption de Valjean commence par la pitié de l’évêque.","ipa":"[redɑ̃psjɔ̃]","exAr":"خلاص فالجان يبدأ بشفقة الأسقف."},{"fr":"la droiture","ar":"الاستقامة","pos":"nom","g":"f","exFr":"La droiture de Valjean résiste à la loi froide.","exAr":"استقامة فالجان تصمد أمام القانون البارد.","ipa":"[dʁɥitʁ]"},{"fr":"le devoir","ar":"الواجب","pos":"nom","g":"m","exFr":"Javert accomplit son devoir jusqu’à la mort.","ipa":"[dəvwɑʁ]","exAr":"يُنجز جافير واجبه حتى الموت."},{"fr":"l’injustice","ar":"الظلم","pos":"nom","g":"f","exFr":"L’injustice du jugement détruit la jeunesse de Valjean.","ipa":"[ɛ̃ʒystis]","exAr":"ظلم الحكم يُدمر شباب فالجان."},{"fr":"la pitié","ar":"الشفقة","pos":"nom","g":"f","exFr":"La pitié de l’évêque change la vie du prisonnier.","ipa":"[pitje]","exAr":"شفقة الأسقف تغيّر حياة السجين."},{"fr":"le maire","ar":"العمدة","pos":"nom","g":"m","exFr":"Il devient le maire de Montreuil-sur-Mer.","ipa":"[mɛʁ]","exAr":"يصبح عمدة مونتريول سور مير."},{"fr":"la barricade","ar":"الحاجز الثوري","pos":"nom","g":"f","exFr":"Les étudiants érigent la barricade en 1832.","ipa":"[bɑʁikad]","exAr":"يرفع الطلاب حاجزهم الثوري عام 1832."},{"fr":"l’orpheline","ar":"اليتيمة","pos":"nom","g":"f","exFr":"Cosette devient une orpheline après la mort de sa mère.","ipa":"[ɔʁfəlin]","exAr":"تصبح كوزيت يتيمة بعد وفاة أمها."},{"fr":"le peuple","ar":"الشعب","pos":"nom","g":"m","exFr":"Hugo donne la parole au peuple dans ses digressions.","ipa":"[pøpl]","exAr":"يمنح هوغو الكلمة للشعب في استطرادات الرواية."},{"fr":"la grâce","ar":"النعمة الإلهية","pos":"nom","g":"f","exFr":"La grâce de l’évêque ouvre la voie de la rédemption.","exAr":"نعمة الأسقف تفتح طريق الخلاص.","ipa":"[ɡʁas]"}],"examples":[{"fr":"Il entra à Digne comme un homme qui n’avait rien et il en sortit comme un homme qui avait tout.","ar":"دخل دين كإنسان ليس لديه شيء وخرج كإنسان لديه كل شيء.","note":"le point de bascule du roman"},{"fr":"Valjean comprit que sa vie devait changer.","ar":"فهم فالجان أن حياته يجب أن تتغير.","note":"le discours indirect"},{"fr":"Bien qu’il fût innocent, il fut condamné à dix-neuf ans de bagne.","ar":"على الرغم من أنه كان بريئاً، حُكم عليه بتسعة عشر عاماً من الأشغال الشاقة.","note":"la proposition concessive"},{"fr":"Javert pensa que le devoir l’obligeait à arrêter Valjean.","ar":"فكّر جافير أن الواجب يُلزمه باعتقال فالجان.","note":"le discours indirect avec concordance"},{"fr":"La misère pousse Fantine à vendre ses cheveux et ses dents.","ar":"يدفع الفقر فانتين إلى بيع شعرها وأسنانها.","note":"la critique sociale de Hugo"},{"fr":"Aimer, c’est agir.","ar":"أن تحبّ يعني أن تتحرّك.","note":"la morale du roman"}],"grammar":[{"tFr":"Le discours indirect : report avec « que » et concordance des temps","tAr":"الكلام المنقول: التبليغ بـ que ومطابقة الأزمنة","body":["Hugo rapporte souvent les pensées de ses personnages par le discours indirect: « Il pensa que le devoir l’obligeait à rester. » la concordance des temps est stricte: le présent de l’énoncé devient imparfait, le passé composé devient plus-que-parfait, et le futur devient conditionnel présent.","règle B2: après un verbe de pensée ou de parole au passé (il comprit, il dit, il pensa), on n’utilise jamais le présent ni le passé composé dans la subordonnée — on remonte d’un cran dans le passé. C’est la clé du style narratif de Hugo."],"ex":[{"fr":"L’évêque dit à Valjean qu’il lui donnait les chandeliers.","ar":"قال الأسقف لفالجان إنه يعطيه الشمعدانين."},{"fr":"Il se dit qu’un jour il serait digne de Cosette.","ar":"قال لنفسه إنه سيصبح يوماً جديراً بكوزيت."}]},{"tFr":"Les propositions concessives : bien que + subjonctif, quoique","tAr":"الجمل الوصفية المعاكسة: bien que مع الفعل التزموي","body":["la pensée de Hugo est bâtie sur la concession: « Bien qu’il fût innocent, il fut condamné. » — la loi va à l’encontre de la justice. On emploie « bien que » + subjonctif (bien qu’il soit, bien qu’il fût) et « quoique » pour nuancer.","règle B2: après « bien que » et « quoique », le subjonctif est obligatoire, jamais l’indicatif. On distingue aussi « bien que » (opposition réelle) de « même si » (opposition hypothétique + indicatif)."],"ex":[{"fr":"Bien qu’il soit innocent, il fut condamné à dix-neuf ans de bagne.","ar":"رغم أنه بريء، حُكم عليه بتسعة عشر عاماً."},{"fr":"Quoique maire, il resta aussi simple qu’un ouvrier.","ar":"بالرغم من منصبه كعمدة، بقي بسيطاً كعامل."}]}],"mistakes":[{"wrong":"dire « il a dit qu’il viendra demain »","right":"il a dit qu’il viendrait demain","why":"le rapport du futur au passé se fait par le conditionnel, jamais par le présent."},{"wrong":"« Bien qu’il est innocent, il a été condamné. »","right":"Bien qu’il soit innocent, il a été condamné.","why":"après « bien que », le subjonctif est obligatoire."},{"wrong":"lire les digressions de Hugo comme des pauses inutiles","right":"y voir le projet social du romantisme","why":"les digressions (sur la guerre, le peuple, la misère) fondent la dimension manifeste du roman."},{"wrong":"réduire le conflit à « Valjean contre la police »","right":"une opposition entre la loi et la conscience","why":"Javert n’est pas un monstre: il est l’image de la loi sans pitié, ce qui rend la chute plus tragique."}],"dialogues":[{"title":"la miséricorde de l’évêque","ctx":"l’évêque reçoit le prisonnier volant et change son destin","lines":[{"who":"L’évêque Bienvenu","fr":"Jean Valjean, mon frère, vous n’êtes plus méchant, vous êtes bon.","ar":"جان فالجان يا أخا، لم تعد شريراً، أنت الآن طيب."},{"who":"Jean Valjean","fr":"Pourquoi m’avez-vous dit que j’étais un homme ?","ar":"لماذا قلتَ إنني إنسان؟"},{"who":"L’évêque Bienvenu","fr":"Parce que la loi et la conscience ne sont pas la même chose.","ar":"لأن القانون والضمير ليسا شيئاً واحداً."},{"who":"Jean Valjean","fr":"Je ferai de ma vie une prière.","ar":"سأجعل حياتي صلاة."}]},{"title":"la confrontation avec Javert","ctx":"l’inspecteur arrête le maire de Montreuil","lines":[{"who":"Javert","fr":"Monsieur le Maire, vous êtes en réalité Jean Valjean, forçat.","ar":"سيدي العمدة، أنت في الحقيقة جان فالجان، مجرم سابق."},{"who":"Jean Valjean","fr":"Je ne nie rien : j’ai porté ce nom autrefois.","ar":"أنكر شيئاً: لقد حملت هذا الاسم قديماً."},{"who":"Javert","fr":"Ma mission est simple : la loi commande, j’obéis.","ar":"مهمتي بسيطة: القانون يأمر وأُطيع."},{"who":"Jean Valjean","fr":"Il y a une autre justice, celle du cœur.","ar":"توجد عدالة أخرى: عدالة القلب."}]}],"exercises":[{"t":"mcq","skill":"comprehension","q":"لماذا سرق Jean Valjean رغيف الخبز؟","opts":["لأنه كان جائعاً ولم يكن لديه ما يُطعم أبناء أخته.","لأنه أراد أن ينتقم من التاجر.","لأنه كان لصاً محترفاً.","لأنه أراد شراء بيت."],"a":0,"why":"السرقة عند هوغو نتيجة la misère، لا الشر: هذا هو أساس la critique sociale."},{"t":"fill","skill":"grammar","q":"أكمل بالفعل التزموي: «Bien qu’il ___ innocent, il fut condamné.»","fr":"Bien qu’il ... innocent, il fut condamné.","ans":"soit","why":"« bien que » تطلب toujours le subjonctif."},{"t":"mcq","skill":"vocabulary","q":"ما معنى « le forçat » ?","opts":["un condamné au bagne","un évêque","un orphelin","un maire"],"a":0,"why":"le forçat = criminel condamné aux travaux forcés — وضع Valjean القانوني في البداية."},{"t":"order","skill":"writing","q":"رتّب: الحبّ يُظهر بالضحيّة لا بالكلمات","words":["L’amour","se","prouve","par","le","sacrifice,","pas","par","les","mots."],"ans":"L’amour se prouve par le sacrifice, pas par les mots.","why":"الجملة تلخّص la morale de Valjean: l’action avant les paroles."},{"t":"listen","skill":"listening","q":"أي جملة تُظهر le discours indirect ?","opts":["Valjean comprit que sa vie devait changer.","Valjean était pauvre.","L’évêque parla à Valjean.","Ils marchèrent dans la nuit."],"a":0,"why":"la subordonnée avec « que » rapporte une pensée sans guillemets."},{"t":"translate","skill":"writing","q":"ترجم: «رغم أنه كان بريئاً، فقد أُدين بالأشغال الشاقة.»","ans":"Bien qu’il fût innocent, il fut condamné aux travaux forcés.","why":"bien que + subjonctif + passé simple: la structure littéraire du roman."},{"t":"speaking","skill":"speaking","q":"اشرح بالفرنسية في ثلاث جمل لماذا يختار Valjean la compassion على la loi de Javert.","target":"Jean Valjean choisit la compassion parce que l’évêque lui a montré que la conscience dépasse la loi froide de Javert.","why":"l’explication mobilise le vocabulaire de la justice et de la conscience."},{"t":"correct","skill":"grammar","q":"صحّح: «Il a dit qu’il viendra le lendemain.»","ans":"Il a dit qu’il viendrait le lendemain.","why":"après un verbe de parole au passé, le futur se rapporte au conditionnel."}],"homework":"استمع إلى la scène de l’évêque ثلاث مرات بدون sous-titres، اكتب les trois gestes de la miséricorde في ثلاث جمل بالفرنسية، ثم اشرح في 80 كلمة لماذا تُسمّى الرواية roman du romantisme social.","sources":[{"title":"Les Misérables de Victor Hugo : un résumé et pourquoi il faut le lire","channel":"Le français c’est clair","videoId":"AiHyYzxmqMw","why":"شرح واضح لـ la ligne narrative de Jean Valjean من السرقة إلى la rédemption، مع شرح لماذا تُصنَّف الرواية كـ œuvre du romantisme social — يمهّد لتحليل les thèmes و la justice.","cat":"Livres","level":"B2","main":true},{"title":"Les Misérables en 10 minutes","channel":"Lumos, la sorcière des Lettres","videoId":"bEnu_8b3Xdc","why":"ملخّص سريع يرسم la ligne narrative الكاملة: la fuite, la rédemption, la barricade — مثالي للمراجعة قبل التعمق.","cat":"Livres","level":"B2","extra":true},{"title":"Agnès Spiquel — Les Misérables : questions sociales, histoire d’une âme","channel":"Nantes Université","videoId":"qyh_I02Vv_w","why":"محاضرة جامعية تحلّل la dimension sociale et spirituelle du roman: la misère، la justice، و la rédemption — تفتح نقاشاً أكاديمياً.","cat":"Livres","level":"B2","extra":true}],"supplements":[{"id":"bEnu_8b3Xdc","title":"Les Misérables en 10 minutes","channel":"Lumos, la sorcière des Lettres","why":"ملخّص سريع يرسم la ligne narrative الكاملة: la fuite, la rédemption, la barricade — مثالي للمراجعة قبل التعمق.","lang":"fr","dur":11},{"id":"qyh_I02Vv_w","title":"Agnès Spiquel — Les Misérables : questions sociales, histoire d’une âme","channel":"Nantes Université","why":"محاضرة جامعية تحلّل la dimension sociale et spirituelle du roman: la misère، la justice، و la rédemption — تفتح نقاشاً أكاديمياً.","lang":"fr","dur":58}]},{"id":"b2-t10-l3","fr":"L’Étranger — Albert Camus","ar":"الغريب — ألبير كامو","objectives":["تتبّع la double structure du roman (la mort de la mère، le procès، l’exécution) وربط كل جزء بـ le thème de l’absurde","تمييز la phrase paratactique (coordination sans subordination) عن la phrase complexe، واستعمال la restriction ne… que في التحليل","_acquire 12 كلمة أساسية autour de l’absurde, de l’indifférence, du procès, du soleil et de l’Algérie française","تفسير لماذا يُصنَّف Camus كـ écrivain de l’absurde، وكيف يتحوّل Meursault إلى le anti-héros de la littérature française"],"sections":[{"h":"الدرس 3: تحليل «الغريب» لألبير كامو: العبث، مورسو، والوجودية","video":{"id":"2uJuSpdNbHE","title":"CAMUS — L’Étranger (résumé-analyse du roman commenté chapitre par chapitre)","channel":"Mediaclasse.fr","why":"تحليل مدرسي مرتّب يشرح la structure du roman في جزئين، ثم يعلّق les passages clés (l’enterrement، la plage، le procès) — يمهّد مباشرة لتحليل l’absurde et le style camusien.","lang":"fr","main":true,"dur":16},"p":["«L’Étranger» (1942) رواية قصيرة ومكثّفة يرويها Meursault بصيغة la première personne، لكن دون أي تحليل نفسي: يصف الأحداث كما يصف الطقس. يبدأ الرواية بالجملة الشهيرة « Aujourd’hui, maman est morte. Ou peut-être hier, je ne sais pas. » — جملةٌ تُعلن فوراً le détachement du narrateur.","المفردات المحورية: l’absurde (العبث)، le procès-verbal (المحضر)، le soleil (الشمس)، l’indifférence (اللامبالاة)، le meurtre (جريمة القتل)، l’enterrement (الجنازة)، la plage (الشاطئ)، l’accusé (المتهم)، le verdict (الحكم)، la mère (الأم)، se conformer (يُناَطَق ويُلائِم)، le sens (المعنى).","نحوياً، le style de Camus يعتمد على la parataxe: جمل قصيرة متتابعة دون روابط (« Il faisait chaud. J’ai marché. J’ai tiré. ») — لا subordinate ولا تفسير. كما يستعمل la restriction ne… que (« Je ne voyais que la mer et le soleil ») لتقييد الرؤية: عالم Meursault ضيق ومباشر.","الشخصية المركزية Meursault هو le anti-héros: لا يُنحت من la passion أو la volonté، بل من l’acceptation. في الجزء الثاني يتحوّل le procès إلى procès de sa personnalité: لا يُحاكم على الجريمة فقط بل على رفضه التماسُ العواطف المطلوبة (البكاء، الندم، الإيمان).","السياق: رواية تُكتب في Algérie française، ولهذا يتسلّط le soleil و la chaleur على الأحداث: الحرارة ليست زينة بل عنصرٌ في le destin. Camus يضع في الرواية فلسفة l’absurde: العالم صامت، والمعنى اختيارٌ بشري. لاحظ أن la tendre indifférence du monde تظهر في اللحظة الأخيرة كـ une libération.","خلاصة الدرس: اقرأ الرواية عبر ثلاثة أسئلة: لماذا لا يبكِ Meursault عند دفن أمه؟ لماذا يقتل على شاطئ البحر؟ ولماذا يرفض l’espérance في الخاتمة؟ المهمة: اكتب فقرة من 90 كلمة بالفرنسية تشرح فيها معنى l’absurde من خلال سلوك Meursault."],"sub":[{"h":"la phrase de Meursault","p":["« Aujourd’hui, maman est morte. »","« Ou peut-être hier, je ne sais pas. »","Le ton neutre ouvre le roman."]},{"h":"l’absurde et le style","p":["La parataxe: « Il faisait chaud. J’ai tiré. »","ne… que — la restriction de la vision","Le silence du monde contre notre besoin de sens."]},{"h":"le vocabulaire de l’absurde","p":["l’absurde — العبث","l’indifférence — اللامبالاة","le procès-verbal — المحضر"]}]},{"h":"les phrases clés du roman","p":["« Aujourd’hui, maman est morte. Ou peut-être hier, je ne sais pas. » — l’ouverture la plus célèbre du XXe siècle: le détachement avant tout jugement.","« J’ai compris que j’avais détruit l’équilibre du jour. » — la conscience tardive du meurtre: le geste reste inexplicable, presque physique.","« Je m’ouvrais pour la première fois à la tendre indifférence du monde. » — la phrase de la libération finale: accepter le silence du monde, c’est cesser de le haïr.","« Elle m’a proposé de l’épouser et j’ai dit oui. » — l’indifférence amoureuse: Meursault accepte les conventions sans y croire."]},{"h":"التطبيق والتلخيص","p":["تمرين la réécoute: شغّل la scène du procès بدون sous-titres، ثم اكتب les trois accusations portées contre Meursault في ثلاث جمل.","تمرين la comparaison: قارن بين la phrase de Meursault et la phrase d’un narrateur classique في 70 كلمة: ما الذي تغيّر في le style ?","اكتب paragraphe de 90 mots بالفرنسية تشرح فيه لماذا يُسمّى Meursault anti-héros — مع 4 مفردات من la leçon."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: يروي Camus جريمة Meursault بلغةٍ جافّة: جنازة الأم، جريمة الشاطئ، ثم المحاكمة التي تحوّلت إلى محاكمةٍ لشخصيته لا لجرمه؛ و le style camusien (la parataxe و la restriction ne… que) جزءٌ من المعنى لا زينةٌ تجميلية. أعد مشاهدة الفيديو الرئيسي وركّز على la scène du procès وعلى الجملة الافتتاحية «Aujourd’hui, maman est morte.»","جسر الدروس: من b2-t10-l2 (البؤساء — البؤسُ يُفضي إلى الضمير والتكفير) إلى b2-t10-l3 (الغريب — العبثُ يُفضي إلى صمتٍ يرفض التكفير)، ثم إلى b2-t10-l4 حيث «مادام بوفاري» لـ Flaubert تُعيد الصراع إلى la réalité: الحلمُ الرومانسي يصطدم بالprovince و l’ennui.","مهمة تطبيقية: لخّص الرواية في تسجيلٍ من دقيقة، اختر 3 كلمات من الدرس (منها l’étrangeté و l’indifférence)، ثم قارن la scène du crime في الفيديو بصفتك: هل يشرح le style صمتَ Meursault أم يرفض التفسير أصلاً؟"]}],"pron":[{"w":"l’étrangeté","ipa":"[etʁɑ̃ʒete]","approx":"إتْرانجْتي"},{"w":"l’indifférence","ipa":"[ɛ̃difeʁɑ̃s]","approx":"انديفرانس"},{"w":"le procès-verbal","ipa":"[pʁɔsɛ vɛʁbal]","approx":"بروسي ڤيربال"}],"vocab":[{"fr":"l’étrangeté","ar":"الغرابة","pos":"nom","g":"f","exFr":"L’étrangeté du monde hante Meursault.","exAr":"غرابة العالم تُطارد مورسو.","ipa":"[etʁɑ̃ʒete]"},{"fr":"l’indifférence","ar":"اللامبالاة","pos":"nom","g":"f","exFr":"L’indifférence de Meursault choque la société.","ipa":"[ɛ̃difeʁɑ̃s]","exAr":"لامبالاة مورسو تُثير استياء المجتمع."},{"fr":"le procès-verbal","ar":"المحضر القضائي","pos":"nom","g":"m","exFr":"Le juge relit le procès-verbal devant la cour.","ipa":"[pʁɔsɛ vɛʁbal]","exAr":"يعيد القاضي قراءة المحضر أمام المحكمة."},{"fr":"le soleil","ar":"الشمس","pos":"nom","g":"m","exFr":"Le soleil de la plage précède le meurtre.","ipa":"[sɔlɛj]","exAr":"شمس الشاطئ تسبق جريمة القتل."},{"fr":"l’enterrement","ar":"الجنازة","pos":"nom","g":"m","exFr":"L’enterrement de sa mère ouvre le roman.","ipa":"[ɑ̃təʁnmɑ̃]","exAr":"جنازة أمه تفتتح الرواية."},{"fr":"la plage","ar":"الشاطئ","pos":"nom","g":"f","exFr":"Ils se retrouvent sur la plage sous le soleil.","ipa":"[plaʒ]","exAr":"يلتقيون على الشاطئ تحت الشمس."},{"fr":"l’accusé","ar":"المتهم","pos":"nom","g":"m","exFr":"L’accusé ne semble pas ému par son procès.","ipa":"[akype]","exAr":"لا يبدو المتهم متأثراً بمحاكمته."},{"fr":"le verdict","ar":"الحكم","pos":"nom","g":"m","exFr":"Le verdict tombe sans appel.","ipa":"[vɛʁdik]","exAr":"يصدر الحكم دون استئناف."},{"fr":"la mère","ar":"الأم","pos":"nom","g":"f","exFr":"La mort de la mère déclenche toute l’histoire.","ipa":"[mɛʁ]","exAr":"وفاة الأم تُطلق كل الأحداث."},{"fr":"se conformer","ar":"يُناَطَق ويُلائِم","pos":"verbe","g":"","exFr":"Meursault se conforme aux rites sociaux sans y croire.","ipa":"[sə kɔ̃fɔʁme]","exAr":"يُناَطَق مورسو الطقوس الاجتماعية دون أن يصدقها."},{"fr":"le sens","ar":"المعنى","pos":"nom","g":"m","exFr":"Le monde refuse de lui donner un sens.","ipa":"[sɑ̃s]","exAr":"يرفض العالم أن يمنحه معنى."},{"fr":"la mer","ar":"البحر","pos":"nom","g":"f","exFr":"La mer reste presque invisible dans la chaleur.","ipa":"[mɛʁ]","exAr":"يظل البحر شبه مرئي في الحرارة."}],"examples":[{"fr":"Aujourd’hui, maman est morte. Ou peut-être hier, je ne sais pas.","ar":"اليوم توفيت أمي. أو ربما أمس، لا أعرف.","note":"la phrase d’ouverture, neutre et détachée"},{"fr":"Il faisait très chaud, j’ai marché vers la source, j’ai tiré mon revolver.","ar":"كانت الشمس لاهبة، فمشيت نحو المنبع، ثم أطلقت الرصاص.","note":"la parataxe camusienne"},{"fr":"Je ne voyais que la mer et le soleil.","ar":"لم أكن أرى سوى البحر والشمس.","note":"la restriction ne… que"},{"fr":"J’ai compris que j’avais détruit l’équilibre du jour.","ar":"فهمت أنني قد دمّرت توازن النهار.","note":"la conscience tardive du geste"},{"fr":"Elle m’a proposé de l’épouser et j’ai dit oui.","ar":"عرضت عليّ الزواج فقلت نعم.","note":"l’indifférence amoureuse"},{"fr":"Je m’ouvrais à la tendre indifférence du monde.","ar":"انفتحتُ على اللامبالاة الحانية للعالم.","note":"la libération finale"}],"grammar":[{"tFr":"La phrase paratactique : coordonner sans subordonner","tAr":"الجملة المتوازية: التعامل دون ربط تابع","body":["le style de Camus repose sur la parataxe: جمل بسيطة مرتّبة بـ « et » أو بلا رابط إطلاقاً (« Il faisait chaud. J’ai marché. J’ai tiré. »). le narrateur يصف ولا يُعلِّل، ولا يستعمل la cause (parce que) ولا la conséquence (si bien que) — هذا الصمت النحوي هو ما يخلق l’effet d’absurde.","règle B2: la parataxe n’est pas une faute: c’est un choix stylistique. في le discours académique، استعملها لتحليل le récit: « Camus coupe la phrase, coupe l’explication: le lecteur reste seul face au geste. »"],"ex":[{"fr":"Il faisait chaud, le soleil m’écrasait, j’ai tiré sans réfléchir.","ar":"كانت الحرارة شديدة، والشمس تضغطني، فطلقت النار دون تفكير."},{"fr":"J’ai attendu, le ciel a changé, la mer s’est retirée.","ar":"انتظرت، وتغيّر الجو، وانسحب البحر."}]},{"tFr":"La restriction ne… que","tAr":"التقييد بـ ne… que","body":["la négation restrictive « ne… que » signifie « seulement » et place la limite de la perception: « Je ne voyais que la mer et le soleil. » le monde de Meursault se réduit à ce qu’il voit, sans interprétation.","règle B2: le « ne » se place avant le verbe conjugué, « que » juste avant l’élément restreint (nom, verbe à l’infinitif, complément). après un verbe à l’infinitif: « Je n’avais envie de rien changer. » — la restriction évite le pléonasme « seulement que »."],"ex":[{"fr":"Je ne voyais que la mer et le soleil.","ar":"لم أكن أرى سوى البحر والشمس."},{"fr":"Je n’avais aucune envie de changer de vie.","ar":"لم تكن لديّ أي رغبة في تغيير حياتي."}]}],"mistakes":[{"wrong":"chercher un sens psychologique à chaque geste de Meursault","right":"accepter le vide : l’absurde naît de ce silence","why":"Camus refuse le décodage sentimental: le personnage décrit, il ne s’explique pas."},{"wrong":"traduire « l’étranger » par « l’ennemi »","right":"l’étranger = celui qui est dehors, étranger aux autres et à lui-même","why":"Meursault n’est pas hostile: il est simplement hors des conventions attendues."},{"wrong":"dire « j’ai seulement vu la mer » dans l’analyse","right":"employer « je ne voyais que la mer »","why":"la restriction ne… que est la structure naturelle du style camusien."},{"wrong":"utiliser « parce que » pour expliquer le meurtre","right":"reconnaître l’absence d’explication: le soleil, la chaleur, le silence","why":"l’absurde refuse la causalité: le geste est un fait, non un mobile rationnel."}],"dialogues":[{"title":"la demande en mariage","ctx":"Marie et Meursault à la plage : une conversation sans passion","lines":[{"who":"Marie","fr":"Veux-tu m’épouser ?","ar":"هل تريد أن تتزوجني؟"},{"who":"Meursault","fr":"Oui, si tu le veux, ça m’est égal.","ar":"نعم، إن أردتِ، عندي الأمر سواء."},{"who":"Marie","fr":"Pourquoi tu ne me dis jamais que tu m’aimes ?","ar":"لماذا لا تقول لي إنك تحبني أبداً؟"},{"who":"Meursault","fr":"Je ne crois pas que cela signifie grand-chose.","ar":"لا أظن أن لهذا معنى كبيراً."}]},{"title":"la leçon de l’aumônier","ctx":"dans la cellule, le prisonnier refuse la consolation religieuse","lines":[{"who":"L’aumônier","fr":"Pourquoi vous refusez-vous à l’espérance ?","ar":"لماذا ترفض الأمل؟"},{"who":"Meursault","fr":"Je n’ai envie de rien changer à ma vie.","ar":"لا أريد تغيير شيء في حياتي."},{"who":"L’aumônier","fr":"Le ciel peut vous tendre les bras.","ar":"قد يفتح لك السماء ذراعيه."},{"who":"Meursault","fr":"Ce qui compte, c’est ce que je vois ici-bas.","ar":"ما يهمّ هو ما أراه في هذه الدنيا."}]}],"exercises":[{"t":"mcq","skill":"comprehension","q":"ماذا يعبّر عنه عنوان «L’Étranger»؟","opts":["أنّ Meursault غريب عن الآخرين وعن نفسه.","أنّ البطل أجنبي.","أنّ القاضي أجنبي.","أنّ الأحداث تقع خارج فرنسا."],"a":0,"why":"le titre désigne la distance de Meursault aux conventions sociales et à sa propre conscience."},{"t":"fill","skill":"grammar","q":"أكمل: «Je ___ (ne voir) que la mer et le soleil.»","fr":"Je ... que la mer et le soleil.","ans":"ne voyais","why":"la restriction ne… que = « seulement »، مع ضمير الغائب في وصف المشهد."},{"t":"mcq","skill":"vocabulary","q":"ما معنى « l’indifférence » في الرواية?","opts":["le manque d’intérêt émotionnel","la colère","la tendresse","la peur"],"a":0,"why":"l’indifférence de Meursault est le cœur de la lecture sociale du roman: لا يُظهر ما تنتظره المجتمع."},{"t":"order","skill":"writing","q":"رتّب: اليوم توفيت أمي، أو ربما أمس لا أعرف","words":["Aujourd’hui,","maman","est","morte.","Ou","peut-être","hier,","je","ne","sais","pas."],"ans":"Aujourd’hui, maman est morte. Ou peut-être hier, je ne sais pas.","why":"la phrase d’ouverture installe le ton neutre et l’absence de commentaire."},{"t":"listen","skill":"listening","q":"أي جملة تُظهر la parataxe (phrases coordonnées sans subordination) ?","opts":["Il faisait chaud, j’ai marché, j’ai tiré.","Il faisait chaud parce que j’avais marché.","Bien qu’il fît chaud, j’ai marché.","Il faisait chaud, mais je n’ai pas tiré."],"a":0,"why":"la parataxe coupe l’explication: le récit avance par faits juxtaposés."},{"t":"translate","skill":"writing","q":"ترجم: «لم أكن أرى سوى الشمس والبحر.»","ans":"Je ne voyais que le soleil et la mer.","why":"ne… que تُترجم إلى « seulement / لا… إلا » وهي علامة le style camusien."},{"t":"speaking","skill":"speaking","q":"اشرح بالفرنسية في ثلاث جمل كيف يخلق le style la sensation de l’absurde.","target":"Le style de Camus crée l’absurde par des phrases courtes, sans cause ni explication, comme si le monde restait silencieux.","why":"l’explication lie le choix stylistique à la philosophie du roman."},{"t":"correct","skill":"grammar","q":"صحّح: «Elle m’a proposé d’épouser et j’ai dit oui.»","ans":"Elle m’a proposé de l’épouser et j’ai dit oui.","why":"« proposer à quelqu’un de + infinitif » exige le COD du verbe à l’infinitif."}],"homework":"استمع إلى la scène du procès ثلاث مرات بدون sous-titres، اكتب les trois accusations contre Meursault في ثلاث جمل بالفرنسية، ثم اشرح في 80 كلمة لماذا تنتهي الرواية بـ la tendre indifférence du monde.","sources":[{"title":"CAMUS — L’Étranger (résumé-analyse du roman commenté chapitre par chapitre)","channel":"Mediaclasse.fr","videoId":"2uJuSpdNbHE","why":"تحليل مدرسي مرتّب يشرح la structure du roman في جزئين، ثم يعلّق les passages clés (l’enterrement، la plage، le procès) — يمهّد مباشرة لتحليل l’absurde et le style camusien.","cat":"Livres","level":"B2","main":true},{"title":"L’étranger de Camus — résumé en 10 minutes","channel":"TéléCrayon","videoId":"Y8G5M7VyJ9I","why":"ملخّص سريع يعيد بناء le récit من l’enterrement إلى le procès — يثبّت la structure قبل التحليل الفلسفي.","cat":"Livres","level":"B2","extra":true},{"title":"Résumé immersif : L’Étranger — Albert Camus","channel":"Le Meilleur Résumé","videoId":"LGLmTBEMeRc","why":"إعادة سرد immersive تُبرز le ton neutre de Meursault et les temps du récit — مثالية la réécoute sans sous-titres.","cat":"Livres","level":"B2","extra":true}],"supplements":[{"id":"Y8G5M7VyJ9I","title":"L’étranger de Camus — résumé en 10 minutes","channel":"TéléCrayon","why":"ملخّص سريع يعيد بناء le récit من l’enterrement إلى le procès — يثبّت la structure قبل التحليل الفلسفي.","lang":"fr","dur":12},{"id":"LGLmTBEMeRc","title":"Résumé immersif : L’Étranger — Albert Camus","channel":"Le Meilleur Résumé","why":"إعادة سرد immersive تُبرز le ton neutre de Meursault et les temps du récit — مثالية la réécoute sans sous-titres.","lang":"fr","dur":23}]},{"id":"b2-t10-l4","fr":"Madame Bovary — Gustave Flaubert","ar":"مادام بوفاري — غوستاف فلوبير","objectives":["تتبّع le parcours d’Emma Bovary: les rêves de roman، l’adultère، les dettes، la fin — وربط كل مرحلة بـ le thème de l’ennui","تمييز le discours indirect libre عن le discours direct et le discours indirect، واستعمال le conditionnel comme temps du rapporté","_acquire 12 كلمة أساسية autour du réalisme, de l’adultère, de la province, de l’ennui et du style","تفسير لماذا يُصنَّف Flaubert كـ père du réalisme، وكيف تنتقد الرواية la province et les illusions du romantisme"],"sections":[{"h":"الدرس 4: تحليل «مادام بوفاري» لغوستاف فلوبير: الواقعية، الخيانة، ونقد الحياة في المقاطعة","video":{"id":"_31zyVWwvuQ","title":"FLAUBERT — Madame Bovary (résumé-analyse du roman commenté chapitre par chapitre)","channel":"Mediaclasse.fr","why":"تحليل مدرسي يشرح la structure du roman et le procès de 1857، ثم يعلّق le style de Flaubert (la phrase de Emma، le discours indirect libre) — يمهّد لدراسة le réalisme et la critique de la province.","lang":"fr","main":true,"dur":18},"p":["«Madame Bovary» (1856) رواية الواقعية الكبرى: تتبع حياة Emma Bovary، ابنة مزرعة صغيرة تتخلى عن أحلامها الرومانسية لتصبح زوجة طبيب في Yonville. la récit يُبنى على la contre-promesse: كل ما تتمنّاه Emma يتحوّل في الواقع إلى شيء أبسط وأفظع: الحب يصبح رتابة، والشغف يصبح ديناً لدى le notaire Lheureux.","المفردات المحورية: le réalisme (الواقعية)، l’adultère (الخيانة الزوجية)، la province (المقاطعة)، l’ennui (الضجر)، l’hypocrisie (النفاق)، la pharmacie (الصيدلية)، le style (الأسلوب)، la banqueroute (الإفلاس)، le notaire (الكاتب القضائي)، l’amant (العشيق)، la campagne (الريف)، le mot juste (الكلمة الدقيقة).","نحوياً، le chef-d’œuvre de Flaubert est le discours indirect libre: la voix du narrateur se confond avec les pensées d’Emma sans « que » ni guillemets (« Et pourquoi pas ? Elle valait bien mieux que ces dames »). ويتولى le conditionnel دور مُحدِّد للفكرة داخل le récit au passé: « Elle pensait qu’un jour elle habiterait Paris. »","الشخصيات تكشف la médiocrité sociale: Charles طبيب بلا طموح، Homais الصيدلي المُتفرّنِق qui représente la parole bourgeoise، le notaire Lheureux qui prépare la ruine، و Emma qui paie le prix de ses lectures. Yonville نفسها personnage: la province فقيرة بالصور، غنية بالكلام.","الحركة الأدبية: le réalisme contre le romantisme. Flaubert décrit la réalité sans embellir (la cuisine، la médecine، les foires) mais avec ironie: le style devient un outil de vérité. la leçon: Emma نموذج la victime de la littérature elle-même — لقد علّمتها القراءة أن تتمنّى حياة لا وجود لها.","خلاصة الدرس: اقرأ الرواية عبر ثلاثة محاور: le style (la phrase juste)، la critique sociale (la province et le notariat)، و la psychologie de l’ennui. المهمة: اكتب فقرة من 90 كلمة بالفرنسية تشرح فيها كيف ينتقد Flaubert l’illusion romantique à travers Emma."],"sub":[{"h":"l’ennui d’Emma","p":["« Elle voulait mourir, mais elle voulait aussi habiter Paris. »","Le rêve romanesque contre la réalité.","L’ennui est le vrai ennemi."]},{"h":"le style de Flaubert","p":["le mot juste — la précision du détail","le discours indirect libre","l’ironie comme outil de vérité"]},{"h":"le vocabulaire du réalisme","p":["la province — المقاطعة","l’adultère — الخيانة الزوجية","le mot juste — الكلمة الدقيقة"]}]},{"h":"les phrases clés du roman","p":["« Elle voulait mourir, mais elle voulait aussi habiter Paris. » — la contradiction d’Emma en une seule phrase: le désir sans limites contre le réel sans issue.","« Nous étions à l’étude, quand le Proviseur entra. » — l’ouverture du roman: un ton neutre, presque scolaire, qui installe le regard réaliste.","Pour Flaubert, le style doit disparaître : on voit à travers lui. — la doctrine du mot juste: le mot exact, ni plus, ni moins.","Le notaire Lheureux vend à Emma sa propre ruine. — la mécanique sociale: la province broie ceux qui veulent s’en échapper."]},{"h":"التطبيق والتلخيص","p":["تمرين la réécoute: شغّل la scène de la fête au château sans sous-titres، ثم اكتب les trois attentes d’Emma قبل la fête et sa déception بعدها.","تمرين la comparaison: قارن entre une phrase de description chez Flaubert et une phrase d’Emma في 70 كلمة: من يتكلم؟","اكتب paragraphe de 90 mots بالفرنسية تشرح فيه كيف ينتقد Flaubert la province عبر les personnages de Charles et Homais — مع 4 مفردات من la leçon."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: تُحلّل الحلقة «مادام بوفاري» كنموذجٍ للواقعية الفلوبيرية: Emma تبحث عن l’idéal romantique داخل la province فتنتهي إلى l’ennui ثم la banqueroute؛ و le style du « mot juste » أداةُ نقدٍ لا وصفٌ فقط. أعد مشاهدة الفيديو الرئيسي وركّز على la scène du bal au Vaubyessard وعلى la chute financière.","جسر الدروس: من b2-t10-l3 (الغريب — صمتُ العبث وجريمةٌ بلا دافع) إلى b2-t10-l4 (مادام بوفاري — واقعيةُ الحلم المُحبَط داخل المقاطعة)، ثم إلى b2-t10-l5 حيث «جيرمينال» لإميل زولا يوسّع الواقعية إلى la mine et la grève: الفردُ يذوب في la souffrance collective.","مهمة تطبيقية: سجّل ملخّصاً مدته دقيقة، استعمل 3 كلمات من الدرس، ثم قارن la chute d’Emma في الفيديو بنقده لـ le style: أين يظهر « le mot juste » في المشاهد المفصلية؟"]}],"pron":[{"w":"le réalisme","ipa":"[ʁealism]","approx":"رياليسم"},{"w":"l’adultère","ipa":"[adultɛʁ]","approx":"أدلتير"},{"w":"le mot juste","ipa":"[lə mo ʒyst]","approx":"ل موجيست"}],"vocab":[{"fr":"le réalisme","ar":"الواقعية","pos":"nom","g":"m","exFr":"Le réalisme décrit le monde sans l’embellir.","ipa":"[ʁealism]","exAr":"الواقعية تصف العالم دون تجميله."},{"fr":"l’adultère","ar":"الخيانة الزوجية","pos":"nom","g":"m","exFr":"L’adultère d’Emma ne lui apporte pas le bonheur promis.","ipa":"[adultɛʁ]","exAr":"خيانة إيما لا تجلب لها السعادة الموعودة."},{"fr":"la province","ar":"المقاطعة","pos":"nom","g":"f","exFr":"Yonville représente la province étouffante.","ipa":"[pʁɔvɛ̃s]","exAr":"يمثّل يونفيل المقاطعة الخانقة."},{"fr":"l’ennui","ar":"الضجر والسأم","pos":"nom","g":"m","exFr":"L’ennui ronge Emma pendant des années.","ipa":"[ɑ̃nwi]","exAr":"يُنخر الضجر إيما لسنوات."},{"fr":"l’hypocrisie","ar":"النفاق","pos":"nom","g":"f","exFr":"L’hypocrisie des bourgeois dirige la ville.","ipa":"[ipɔkʁizi]","exAr":"نفاق الطبقة البرجوازية يُدير المدينة."},{"fr":"la pharmacie","ar":"الصيدلية","pos":"nom","g":"f","exFr":"La pharmacie d’Homais est le centre de Yonville.","ipa":"[faʁmasi]","exAr":"صيدلية أوما هي مركز يونفيل."},{"fr":"le style","ar":"الأسلوب","pos":"nom","g":"m","exFr":"Le style de Flaubert cherche la précision.","ipa":"[stil]","exAr":"أسلوب فلوبير يسعى إلى الدقة."},{"fr":"la banqueroute","ar":"الإفلاس","pos":"nom","g":"f","exFr":"La banqueroute la mène au désespoir.","ipa":"[bɑ̃kuʁut]","exAr":"الإفلاس يقودها إلى اليأس."},{"fr":"le notaire","ar":"الكاتب القضائي","pos":"nom","g":"m","exFr":"Le notaire Lheureux lui vend des créances.","ipa":"[nɔtɛʁ]","exAr":"الكاتب لورو يبيع لها ديوناً."},{"fr":"l’amant","ar":"العشيق","pos":"nom","g":"m","exFr":"Rodolphe devient son premier amant.","ipa":"[amɑ̃]","exAr":"يصبح رودولف عشيقها الأول."},{"fr":"la campagne","ar":"الريف","pos":"nom","g":"f","exFr":"La campagne de Normandie encadre le récit.","ipa":"[kɑ̃paɲ]","exAr":"ريف نورماندي يؤطر الرواية."},{"fr":"le mot juste","ar":"الكلمة الدقيقة","pos":"loc.","g":"","exFr":"Flaubert passait des jours à chercher le mot juste.","ipa":"","exAr":"كان فلوبير يقضي أيامه بحثاً عن الكلمة الدقيقة."}],"examples":[{"fr":"Elle voulait mourir, mais elle voulait aussi habiter Paris.","ar":"أرادت أن تموت، لكنها أرادت أيضاً أن تسكن باريس.","note":"la contradiction d’Emma"},{"fr":"Elle pensait qu’un jour elle habiterait Paris.","ar":"كانت تفكر أن يوماً ما ستسكن باريس.","note":"le conditionnel comme temps du rapporté"},{"fr":"Charles ne comprenait pas pourquoi elle était si triste.","ar":"لم يفهم شارل لماذا كانت حزينة جداً.","note":"le discours indirect simple"},{"fr":"Et pourquoi pas ? Elle valait bien mieux que ces dames.","ar":"ولماذا لا؟ كانت خيراً من هؤلاء السيدات.","note":"le discours indirect libre"},{"fr":"La pharmacie d’Homais régnait sur la place du village.","ar":"كانت صيدلية أوما تسيطر على ساحة القرية.","note":"la description réaliste du cadre"},{"fr":"Le notaire Lheureux vendit à Emma sa propre ruine.","ar":"باع لها الكاتب لورو خرابها هو.","note":"la mécanique sociale de la province"}],"grammar":[{"tFr":"Le discours indirect libre : la voix d’Emma sans « que »","tAr":"الكلام المنقول الحرّ: صوت إيما دون رابط que","body":["Flaubert fusionne le style indirect et le style direct: la phrase du narrateur garde les temps du récit et l’ordre des mots du discours indirect, mais elle perd le « que » et les guillemets, et prend l’interrogation directe (« Et pourquoi pas ? Elle valait bien mieux que ces dames »). C’est la signature du réalisme flaubertien.","reconnaissance B2: si la phrase appartient à la voix du narrateur mais porte l’avis d’Emma, sans « qu’elle », c’est du discours indirect libre. C’est ce procédé qui permet à Flaubert de critiquer sans jamais prendre la parole."],"ex":[{"fr":"Elle se dit qu’un jour tout changerait. La vie allait offrir enfin quelque chose.","ar":"قالت لنفسها إن يوماً كل شيء سيتغيّر. الحياة ستعرض عليها أخيراً شيئاً."},{"fr":"Et pourquoi pas ? Elle valait bien mieux que ces dames.","ar":"ولماذا لا؟ كانت خيراً من هؤلاء السيدات."}]},{"tFr":"Le conditionnel comme temps du rapporté dans le récit","tAr":"الشرطية كزمن للكلام المنقول داخل السرد","body":["dans un récit au passé, le futur de la pensée d’Emma se rapporte au conditionnel présent: « Elle pensait qu’un jour elle habiterait Paris. » et le futur antérieur au conditionnel passé: « Elle aurait voulu partir avant le dîner. » C’est la concordance des temps appliquée à l’imagination du personnage.","règle B2: passé simple / passé composé dans la principale → conditionnel présent dans la subordonnée; imparfait → conditionnel passé. C’est la valeur littéraire du conditionnel: il mesure la distance entre le rêve et le réel."],"ex":[{"fr":"Elle pensait qu’un jour elle habiterait Paris.","ar":"كانت تظن أن يوماً ما ستسكن باريس."},{"fr":"Elle aurait voulu que Charles devînt un homme important.","ar":"كانت تتمنى لو أصبح شارل إنساناً مهماً."}]}],"mistakes":[{"wrong":"lire Emma comme une simple « femme adultère »","right":"une victime de l’illusion romantique","why":"les romans feuilletones lui ont appris à désirer une vie qui n’existe pas: la critique vise la société, pas la femme seule."},{"wrong":"dire « le style de Flaubert est long et ennuyeux »","right":"le style cherche le mot juste et l’ironie","why":"chaque phrase est limée: la précision devient un outil de vérité réaliste."},{"wrong":"confondre discours indirect libre et discours direct","right":"le discours indirect libre garde les temps du récit et perd les guillemets","why":"« Et pourquoi pas ? » appartient à Emma, mais la phrase reste dans la narration."},{"wrong":"utiliser le présent dans une subordonnée rapportée","right":"elle pensait qu’elle partirait le lendemain","why":"après un verbe au passé, le futur se rapporte au conditionnel, jamais au présent."}],"dialogues":[{"title":"le souper chez les Bovary","ctx":"Charles et Emma à Yonville : la conversation sans passion","lines":[{"who":"Charles Bovary","fr":"Tu n’as pas mangé, Emma. Qu’est-ce qui t’ennuie ?","ar":"لم تأكل شيئاً يا إيما. ما الذي يضجرك؟"},{"who":"Emma Bovary","fr":"Rien. La campagne est si monotone.","ar":"لا شيء. الريف مملّ جداً."},{"who":"Charles Bovary","fr":"La vie ici est calme, tu le sais.","ar":"الحياة هنا هادئة، أنت تعلمين."},{"who":"Emma Bovary","fr":"Oui, calme. C’est bien cela.","ar":"نعم، هادئة. هذا هو الشيء بالضبط."}]},{"title":"la dette chez le notaire","ctx":"Lheureux présente à Emma un arrangement financier","lines":[{"who":"Lheureux","fr":"Madame, je peux vous aider, sans formalités.","ar":"سيدتي، يمكنني مساعدتك دون إجراءات."},{"who":"Emma Bovary","fr":"Il me faut de l’argent, tout de suite.","ar":"أحتاج إلى مال حالاً."},{"who":"Lheureux","fr":"On signe un petit billet, et le monde vous sourit.","ar":"نوقّع سند صغير، فيبتسم لك العالم."},{"who":"Emma Bovary","fr":"Je signerai. Charles ne saura rien.","ar":"سوف أوقّع. لن يعرف شارل شيئاً."}]}],"exercises":[{"t":"mcq","skill":"comprehension","q":"ما مصدر تعاسة Emma Bovary الأساسي في الرواية?","opts":["أحلامها الرومانسية المخالفة للواقع.","فقر عائلتها.","عملها في الصيدلية.","سفرها إلى باريس."],"a":0,"why":"le réalisme de Flaubert ينتقد la littérature elle-même: les romans ont rendu Emma incapable d’accepter la province."},{"t":"fill","skill":"grammar","q":"أكمل بالزمن المناسب: «Elle pensait qu’un jour elle ___ Paris.»","fr":"Elle pensait qu’un jour elle ... Paris.","ans":"habiterait","why":"après un verbe au passé، le futur de la pensée se rapporte au conditionnel présent."},{"t":"mcq","skill":"vocabulary","q":"ما معنى « le mot juste »?","opts":["la précision du détail","la phrase longue","l’argot populaire","le discours officiel"],"a":0,"why":"c’est la doctrine de Flaubert: le mot exact, ni plus, ni moins."},{"t":"order","skill":"writing","q":"رتّب: الواقعية تصف العالم دون تجميله","words":["Le","réalisme","décrit","le","monde","sans","l’embellir."],"ans":"Le réalisme décrit le monde sans l’embellir.","why":"la négation « sans + infinitif » exprime le principe du réalisme flaubertien."},{"t":"listen","skill":"listening","q":"أي جملة تُظهر le discours indirect libre?","opts":["Et pourquoi pas ? Elle valait bien mieux que ces dames.","Elle se dit qu’elle valait mieux qu’elles.","Elle valait mieux qu’elles, pensa-t-elle.","Charles dit qu’elle valait mieux."],"a":0,"why":"la phrase garde l’interrogation directe et la voix d’Emma, sans « que » ni guillemets."},{"t":"translate","skill":"writing","q":"ترجم: «كانت تظن أن يوماً ما ستسكن باريس.»","ans":"Elle pensait qu’un jour elle habiterait Paris.","why":"le conditionnel « habiterait » marque le futur dans le discours rapporté."},{"t":"speaking","skill":"speaking","q":"اشرح بالفرنسية في ثلاث جمل لماذا يُصنَّف Flaubert كـ père du réalisme.","target":"Flaubert est le père du réalisme parce qu’il décrit la province, les gestes et les dettes sans embellir le monde.","why":"l’explication mobilise le vocabulaire du réalisme et de la critique sociale."},{"t":"correct","skill":"grammar","q":"صحّح: «Elle voulait qu’un jour elle habiterait Paris.»","ans":"Elle voulait qu’un jour elle habite Paris.","why":"après « vouloir que », le subjonctif est requis: « elle habite » (présent du subjonctif), jamais le conditionnel."}],"homework":"استمع إلى la scène de la fête au château ثلاث مرات بدون sous-titres، اكتب les trois attentes d’Emma في ثلاث جمل بالفرنسية، ثم اشرح في 80 كلمة كيف ينتقد Flaubert la province عبر Charles و Homais.","sources":[{"title":"FLAUBERT — Madame Bovary (résumé-analyse du roman commenté chapitre par chapitre)","channel":"Mediaclasse.fr","videoId":"_31zyVWwvuQ","why":"تحليل مدرسي يشرح la structure du roman et le procès de 1857، ثم يعلّق le style de Flaubert (la phrase de Emma، le discours indirect libre) — يمهّد لدراسة le réalisme et la critique de la province.","cat":"Livres","level":"B2","main":true},{"title":"Flaubert, Madame Bovary (1856) — commentaire composé en français","channel":"Mediaclasse.fr","videoId":"Qdz96WUHuk8","why":"commentaire composé نموذجي: يشرح la thèse du roman، la construction des arguments، و le style — يعلّم منهج التحليل الأدبي بالفرنسية.","cat":"Livres","level":"B2","extra":true},{"title":"Mme Bovary : réception critique ultérieure","channel":"digiSchool Orientation","videoId":"70xVc73Pa0Y","why":"يراجع la réception du roman من الاتهام بالخلل الأخلاقي إلى اعتماده كعمل كلاسيكي — يربط le réalisme بـ l’histoire littéraire.","cat":"Livres","level":"B2","extra":true}],"supplements":[{"id":"Qdz96WUHuk8","title":"Flaubert, Madame Bovary (1856) — commentaire composé en français","channel":"Mediaclasse.fr","why":"commentaire composé نموذجي: يشرح la thèse du roman، la construction des arguments، و le style — يعلّم منهج التحليل الأدبي بالفرنسية.","lang":"fr","dur":23},{"id":"70xVc73Pa0Y","title":"Mme Bovary : réception critique ultérieure","channel":"digiSchool Orientation","why":"يراجع la réception du roman من الاتهام بالخلل الأخلاقي إلى اعتماده كعمل كلاسيكي — يربط le réalisme بـ l’histoire littéraire.","lang":"fr","dur":5}]},{"id":"b2-t10-l5","fr":"Germinal — Émile Zola","ar":"جيرمينال — إميل زولا","objectives":["تتبّع la construction du récit: l’arrivée d’Étienne، la grève، la révolte، la répression — وربط كل مرحلة بـ le thème de la misère","تمييز l’imparfait descriptif عن le passé simple de l’événement، واستعمال les structures de cause et de conséquence (parce que, si bien que) في التحليل","_acquire 12 كلمة أساسية autour de la mine, de la grève, du capital, de la famine et de la révolte","تفسير لماذا يُصنَّف Zola كـ écrivain naturaliste، وكيف يحوّل la mine إلى symbole de la société industrielle"],"sections":[{"h":"الدرس 5: تحليل «جيرمينال» لإميل زولا: الطبيعية، المنجم، وظروف العمال","video":{"id":"I5lbxTgOYdI","title":"Germinal de Zola — résumé complet et analyse du roman","channel":"Rémi El Profesor","why":"تحليل مدرسي يعرض le récit complet من وصول Étienne إلى la fosse إلى la fin، مع شرح le naturalisme و la mine كـ personnage collectif — يمهّد لدراسة les conditions ouvrières et le style zolien.","lang":"fr","main":true,"dur":22},"p":["«Germinal» (1885) هو الرواية الثالثة عشرة من cycle des Rougon-Macquart: تصف la vie dans les mines du Nord de la France. يبدأ le récit بوصول Étienne Lantier إلى la fosse du Voreux، وينتهي بعد la grève و la répression وl’accident: la mine تبتلع رجالاً ثم تُعيد society إلى وضعها. le mouvement du récit يشبه la descente aux enfers.","المفردات المحورية: la mine (المنجم)، le creuset (الحفرة)، la grève (الإضراب)، le capital (رأس المال)، la famine (المجاعة)، l’ouvrier (العامل)، la souffrance (المعاناة)، le chevalet (برج المنجم)، la révolte (التمرد)، le coup de grisou (انفجار غاز الميثان)، le fond (الأعماق)، le patronat (أصحاب العمل).","نحوياً، le récit naturaliste s’appuie sur l’imparfait pour la description longue du décor (« Le Voreux s’ouvrait au milieu des champs ») et sur le passé simple pour les faits qui déclenchent la grève (« Les mineurs descendirent. »). les propositions de cause et de conséquence (parce que, c’est pourquoi, si bien que) structurent l’analyse sociale: la famine produit la révolte.","الشخصيات تمثّل les forces en présence: Étienne يمثل l’idéalisme ouvrier، La Maheude la misère maternelle، Etienne و les autres les grévistes، و le capital المُمثَّل بـ le patronat. la mine نفسها personnage جماعي: تبتلع الأطفال وتعيد التراب إلى ساكنيه.","الحركة الأدبية: le naturalisme: Zola applique une méthode quasi scientifique — la description précise des lieux، des gestes، des corps. la leçon: la grève ليست عصياناً معزولاً بل نتيجة حتمية لـ la famine et au capital. ويبقى النهاية مفتوحة: la révolte تُخمَد، لكن la misère تبقى.","خلاصة الدرس: اقرأ الرواية عبر ثلاثة محاور: le décor de la mine، la dynamique du groupe، et le langage des corps (la faim، la fatigue، la peur). المهمة: اكتب فقرة من 90 كلمة بالفرنسية تشرح فيها كيف يوظّف Zola la mine كرمز للرأسمالية — مع 4 مفردات من la leçon."],"sub":[{"h":"la mine, gueule dévorante","p":["« La mine venait d’avaler des hommes. »","Le Voreux ouvre sa gueule chaque matin.","La mine est un personnage à part entière."]},{"h":"les temps du récit naturaliste","p":["l’imparfait: « Le Voreux s’ouvrait… »","le passé simple: « Les mineurs descendirent. »","la cause et la conséquence: si bien que"]},{"h":"le vocabulaire du travail","p":["la mine — المنجم","la grève — الإضراب","l’ouvrier — العامل"]}]},{"h":"les phrases clés du roman","p":["« La mine venait d’avaler des hommes. » — la phrase qui résume le roman: la machine dévore les corps et la société reste silencieuse.","« Faut du pain ! Faut du pain ! » — le cri de la grève: la famine transforme la colère collective en mouvement.","« Et la mine restait ouverte, comme une gueule de l’enfer qui aurait dévoré la terre. » — la fin du roman: la mine survit à tout, symbole d’un système qui continue.","Zola voulait que le roman finisse par un cri d’espérance. — malgré la répression, le mouvement ouvrier garde une promesse: la révolte n’est pas vaine."]},{"h":"التطبيق والتلخيص","p":["تمرين la réécoute: شغّل la scène de la descente sans sous-titres، ثم اكتب les quatre sensations des ouvriers في أربع جمل.","تمرين la comparaison: قارن بين la mine dans la description de Zola et une usine moderne في 70 كلمة: ما الذي تغيّر؟","اكتب paragraphe de 90 mots بالفرنسية تشرح فيه كيف تتحوّل la famine إلى grève — مع 4 مفردات من la leçon."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: يبني Zola في «جيرمينال» جمهورَ la mine: la grève تنهض من la famine، و le chevalet رمزُ الهشاشة، و le coup de grisou نهايةٌ تقضي على الأمل؛ la souffrance عند Zola ليست وصفاً بل تشريحٌ اجتماعي. أعد مشاهدة الفيديو الرئيسي وركّز على la descente dans la mine وعلى l’affrontement entre Étienne et le patronat.","جسر الدروس: من b2-t10-l4 (مادام بوفاري — الواقعية في حجم الفرد وحلمه) إلى b2-t10-l5 (جيرمينال — الواقعية في حجم la classe ouvrière والمنجم)، ثم إلى b2-t10-l6 حيث «كاندید» لـ Voltaire يقلب المقاربة: بدل تشريح la misère يصنع les Lumières conte philosophique ساخراً من l’optimisme.","مهمة تطبيقية: لخّص الرواية في دقيقةٍ تسجّلها، أضف 3 كلمات من الدرس، ثم قارن la scène de la descente في الفيديو بدراستك: أيّ رمزٍ (le creuset, le fond, la nuit) لم يظهر في الملخّص؟"]}],"pron":[{"w":"la mine","ipa":"[min]","approx":"مين"},{"w":"la grève","ipa":"[ɡʁɛv]","approx":"غريف"},{"w":"l’ouvrier","ipa":"[uvʁije]","approx":"أوفرييه"}],"vocab":[{"fr":"la mine","ar":"المنجم","pos":"nom","g":"f","exFr":"La mine ouvre sa gueule au petit matin.","ipa":"[min]","exAr":"يفتح المنجم فمه في الصباح الباكر."},{"fr":"le creuset","ar":"الفرن والحفرة","pos":"nom","g":"m","exFr":"Le Voreux est un creuset maudit.","ipa":"[kʁøzɛ]","exAr":"الفورن هو حفرة ملعونة."},{"fr":"la grève","ar":"الإضراب","pos":"nom","g":"f","exFr":"La grève éclate faute de pain.","ipa":"[ɡʁɛv]","exAr":"يُعلن الإضراب لعدم وجود خبز."},{"fr":"le capital","ar":"رأس المال","pos":"nom","g":"m","exFr":"Le capital écrase les mineurs.","ipa":"[kapital]","exAr":"يضغط رأس المال على العمال."},{"fr":"la famine","ar":"المجاعة","pos":"nom","g":"f","exFr":"La famine pousse les ouvriers à se révolter.","ipa":"[famin]","exAr":"تدفع المجاعة العمال إلى التمرد."},{"fr":"l’ouvrier","ar":"العامل","pos":"nom","g":"m","exFr":"L’ouvrier descend douze heures par jour.","ipa":"[uvʁije]","exAr":"ينزل العامل اثنتي عشرة ساعة يومياً."},{"fr":"la souffrance","ar":"المعاناة","pos":"nom","g":"f","exFr":"La souffrance des enfants est indicible.","ipa":"[sufʁɑ̃s]","exAr":"معاناة الأطفال لا تُوصف."},{"fr":"le chevalet","ar":"برج المنجم","pos":"nom","g":"m","exFr":"Le chevalet domine la fosse.","ipa":"[ʃəvalɛ]","exAr":"يسيطر البرج على المنجم."},{"fr":"la révolte","ar":"التمرد","pos":"nom","g":"f","exFr":"La révolte naît de la misère.","ipa":"[ʁevɔlt]","exAr":"يولد التمرد من البؤس."},{"fr":"le coup de grisou","ar":"انفجار غاز الميثان","pos":"nom","g":"m","exFr":"Un coup de grisou détruit la mine.","ipa":"[ku də ɡʁizu]","exAr":"انفجار غازي يُدمّر المنجم."},{"fr":"le fond","ar":"الأعماق","pos":"nom","g":"m","exFr":"Au fond de la mine, la nuit est totale.","ipa":"[fɔ̃]","exAr":"في أعماق المنجم يكون الظلام تاماً."},{"fr":"le patronat","ar":"أصحاب العمل","pos":"nom","g":"m","exFr":"Le patronat refuse toute augmentation.","ipa":"[patʁɔna]","exAr":"يرفض أصحاب العمل أي زيادة."}],"examples":[{"fr":"La mine venait d’avaler des hommes.","ar":"كانت المنجم قد ابتلع رجالاً.","note":"le passé récent avec « venir de »"},{"fr":"Les mineurs descendirent au fond avant l’aube.","ar":"نزل العمال إلى الأعماق قبل الفجر.","note":"le passé simple de l’événement"},{"fr":"Le Voreux s’ouvrait au milieu des champs.","ar":"كان فورن يُفتح في وسط الحقول.","note":"l’imparfait descriptif"},{"fr":"Les ouvriers manquaient de pain, si bien que la grève éclata.","ar":"كان العمال يفتقرون إلى الخبز، حتى إن الإضراب اندلع.","note":"la conséquence avec si bien que"},{"fr":"Faut du pain ! Faut du pain !","ar":"نحتاج إلى خبز! نحتاج إلى خبز!","note":"le cri de la grève"},{"fr":"La mine restait ouverte, comme une gueule de l’enfer.","ar":"بقي المنجم مفتوحاً كفم جهنم.","note":"la personnification du décor"}],"grammar":[{"tFr":"Les temps du récit : l’imparfait descriptif et le passé simple","tAr":"أزمنة السرد: الوصف الطويل والحدث","body":["le naturalisme exige une description précise et prolongée: l’imparfait porte le décor, les gestes quotidiens, les états (« Le Voreux s’ouvrait… les femmes parlaient… »), tandis que le passé simple introduce les faits qui font avancer la grève (« Les mineurs descendirent. »). C’est le même principe que dans le récit d’aventure, mais appliqué à un groupe social.","règle B2: dans une description naturaliste, l’imparfait peut tenir plusieurs lignes; le passé simple ne surgit que lorsque le mouvement commence — la grève, l’accident, la répression."],"ex":[{"fr":"Le Voreux s’ouvrait au milieu des champs, et la terre tremblait sous les pas.","ar":"كان فورن يُفتح في وسط الحقول، والتراب يرتجف تحت الأقدام."},{"fr":"Les mineurs descendirent, et la journée commença.","ar":"نزل العمال، وبدأت اليومية."}]},{"tFr":"La cause et la conséquence : parce que, si bien que, de sorte que","tAr":"السبب والنتيجة: parce que، si bien que، de sorte que","body":["Zola lie les faits comme un naturaliste lie les causes: « Les ouvriers manquaient de pain, si bien que la grève éclata. » la structure sociale devient une chaîne de conséquences: la misère produit la faim, la faim produit la grève, la grève produit la répression.","règle B2: « parce que » introduit la cause, « si bien que » et « de sorte que » la conséquence (avec l’indicatif), « pour que » la finalité (avec le subjonctif). ces connecteurs sont indispensables dans l’analyse littéraire."],"ex":[{"fr":"Parce que le patronat refusait d’écouter, la grève s’étendit.","ar":"لأن أصحاب العمل رفضوا الاستماع، انتشر الإضراب."},{"fr":"Il pleuvait si fort que les mineurs ne pouvaient plus sortir.","ar":"كان المطر غزيراً لدرجة أن العمال لم يستطيعوا الخروج."}]}],"mistakes":[{"wrong":"lire la mine comme un simple décor","right":"un personnage collectif qui dévore les hommes","why":"Zola personnifie le Voreux: la mine est une gueule, une force, un système."},{"wrong":"réduire la grève à une colère individuelle","right":"un mouvement né de la famine et du capital","why":"la conséquence sociale précède le geste: la misère explique la révolte."},{"wrong":"utiliser le passé composé pour tout le récit","right":"alterner imparfait descriptif et passé simple","why":"le décor naturaliste reste à l’imparfait, l’événement au passé simple."},{"wrong":"traduire « la mine » par « la fabrique »","right":"la mine = le sous-sol exploité, le fond","why":"la distinction technique est essentielle: la mine descend, la fabrique produit."}],"dialogues":[{"title":"la descente au fond","ctx":"Étienne découvre la mine avec les autres ouvriers","lines":[{"who":"Étienne Lantier","fr":"C’est donc ici qu’on descend ?","ar":"إذن هنا ينزلون؟"},{"who":"La Maheude","fr":"Oui, douze heures par jour, dans le noir.","ar":"نعم، اثنتا عشرة ساعة يومياً في الظلام."},{"who":"Étienne Lantier","fr":"La terre est glacée, on ne voit rien.","ar":"التراب متصلّب، لا نرى شيئاً."},{"who":"La Maheude","fr":"C’est la mine, mon garçon : elle prend tout.","ar":"هذا هو المنجم يا بني: يأخذ كل شيء."}]},{"title":"le cri de la grève","ctx":"les ouvriers rassemblés réclament du pain","lines":[{"who":"Un ouvrier","fr":"Faut du pain ! Faut du pain !","ar":"نحتاج إلى خبز! نحتاج إلى خبز!"},{"who":"Étienne Lantier","fr":"Ce n’est pas la faim seule, c’est la justice.","ar":"ليس الجوع وحده، بل العدالة."},{"who":"La Maheude","fr":"Les enfants meurent, et le patronat refuse.","ar":"الأطفال يموتون، وأصحاب العمل يرفضون."},{"who":"Étienne Lantier","fr":"Alors on descendra plus, et on se battra.","ar":"إذن لن ننزل أكثر، وسنقاتل."}]}],"exercises":[{"t":"mcq","skill":"comprehension","q":"ماذا ترمز إليه la mine في الرواية?","opts":["الرأسمالية الذي يبتلع العمال.","حديقة القرية.","مدرسة العمال.","قصر أصحاب العمل."],"a":0,"why":"Zola personnifie la mine: elle est le symbole du système qui dévore les hommes."},{"t":"fill","skill":"grammar","q":"أكمل بالسبب أو النتيجة: «Les ouvriers manquaient de pain, ___ la grève éclata.»","fr":"Les ouvriers manquaient de pain, ... la grève éclata.","ans":"si bien que","why":"« si bien que » introduit la conséquence, avec l’indicatif."},{"t":"mcq","skill":"vocabulary","q":"ما معنى « la grève »?","opts":["l’arrêt du travail pour réclamer ses droits","une mine nouvelle","un impôt","un repas"],"a":0,"why":"dans le contexte ouvrier، la grève = l’arrêt collectif du travail."},{"t":"order","skill":"writing","q":"رتّب: بقي المنجم مفتوحاً كفم جهنم","words":["La","mine","restait","ouverte,","comme","une","gueule","de","l’enfer."],"ans":"La mine restait ouverte, comme une gueule de l’enfer.","why":"la comparaison « comme » personnifie la mine: c’est la signature du style zolien."},{"t":"listen","skill":"listening","q":"أي جملة تُظهر l’imparfait de l’habitude?","opts":["Les enfants travaillaient au fond de la mine.","Les enfants jouaient sur le carreau.","Les enfants allaient à l’école chaque matin.","Les enfants dormaient au village."],"a":0,"why":"l’imparfait décrit la situation habituelle et tragique du travail des enfants."},{"t":"translate","skill":"writing","q":"ترجم: «كانت الأرض ترتجف تحت أقدام العمال.»","ans":"La terre tremblait sous les pieds des ouvriers.","why":"l’imparfait « tremblait » décrit le décor permanent de la mine."},{"t":"speaking","skill":"speaking","q":"اشرح بالفرنسية في ثلاث جمل كيف تتحوّل la famine إلى grève.","target":"Dans Germinal, la famine pousse les ouvriers à se révolter, si bien que la grève devient un mouvement collectif.","why":"l’explication mobilise le vocabulaire du travail et les connecteurs de conséquence."},{"t":"correct","skill":"grammar","q":"صحّح: «La grève a éclaté, bien que le patronat a refusé d’écouter.»","ans":"La grève a éclaté, bien que le patronat ait refusé d’écouter.","why":"après « bien que », le subjonctif passé est requis: « ait refusé »."}],"homework":"استمع إلى la scène de la descente ثلاث مرات بدون sous-titres، اكتب les quatre sensations des ouvriers في أربع جمل بالفرنسية، ثم اشرح في 80 كلمة كيف يوظّف Zola la mine كرمز للرأسمالية.","sources":[{"title":"Germinal de Zola — résumé complet et analyse du roman","channel":"Rémi El Profesor","videoId":"I5lbxTgOYdI","why":"تحليل مدرسي يعرض le récit complet من وصول Étienne إلى la fosse إلى la fin، مع شرح le naturalisme و la mine كـ personnage collectif — يمهّد لدراسة les conditions ouvrières et le style zolien.","cat":"Livres","level":"B2","main":true},{"title":"Zola — Germinal (résumé du roman, commenté avec des citations)","channel":"Mediaclasse.fr","videoId":"qYLKdUWzO_I","why":"commentaire منظّم مع les citations clés: la mine، la grève، و la fin — يعلّم كيف يُستشهد بالنص في le commentaire littéraire.","cat":"Livres","level":"B2","extra":true},{"title":"Germinal d’Émile Zola — résumé complet du livre","channel":"Résumé Livre Français","videoId":"ez0CQmVbOLs","why":"ملخّص شامل يعيد بناء le récit من البداية إلى النهاية — يثبّت la structure قبل دراسة le naturalisme.","cat":"Livres","level":"B2","extra":true}],"supplements":[{"id":"qYLKdUWzO_I","title":"Zola — Germinal (résumé du roman, commenté avec des citations)","channel":"Mediaclasse.fr","why":"commentaire منظّم مع les citations clés: la mine، la grève، و la fin — يعلّم كيف يُستشهد بالنص في le commentaire littéraire.","lang":"fr","dur":15},{"id":"ez0CQmVbOLs","title":"Germinal d’Émile Zola — résumé complet du livre","channel":"Résumé Livre Français","why":"ملخّص شامل يعيد بناء le récit من البداية إلى النهاية — يثبّت la structure قبل دراسة le naturalisme.","lang":"fr","dur":11}]},{"id":"b2-t10-l6","fr":"Candide — Voltaire","ar":"كاندید — فولتير","objectives":["analyser la structure du conte philosophique: le voyage initiatique, la chute de l’optimisme, la morale finale","_acquire 12 كلمة أساسية حول la philosophie des Lumières, l’optimisme, le mal, le travail, la satire","تمييز le récit à l’imparfait/passé simple عن le présent de vérité والسؤال الخطابي في le style de Voltaire","تفسير لماذا « Il faut cultiver notre jardin » تُختصر بها la pensée des Lumières contre le métaphysique"],"sections":[{"h":"الدرس 6: تحليل «كاندید» — الحكاية الفلسفية في عصر الأنوار","video":{"id":"988K0bxJyx8","title":"VOLTAIRE 📜 Candide (Résumé-analyse du conte philosophique commenté chapitre par chapitre)","channel":"Mediaclasse.fr","why":"تحليل مدرسي منظم لـ le conte: la structure en trente chapitres courts، la chute de Pangloss، puis la conclusion « Il faut cultiver notre jardin » — يمهّد مباشرة لفهم l’ironie voltairienne et les temps du récit.","lang":"fr","main":true,"dur":16},"p":["« Candide » (1759) est un conte philosophique de Voltaire: trente chapitres très courts, un personnage naïf qui voyage d’Europe en Amérique, et une même question répétée: si le monde est créé par un Dieu bon, pourquoi le mal existe-t-il? le récit avance à une cadence fulgurante — chaque chapitre est une catastrophe, une parodie ou une leçon.","Le personnage de Candide est l’élève naïf de Pangloss, le maître qui répète la doctrine de l’optimisme (leibnizien): « Tout est au mieux dans le meilleur des mondes. » La première rupture est la destruction de l’Eldorado, puis surtout le tremblement de terre de Lisbonne (1755): la théorie s’effondre devant l’expérience du mal.","المفردات المحورية في هذا الدرس: le conte philosophique (الحكاية الفلسفية)، l’optimisme (التفاؤل الفلسفي)، le mal (الشر/السيئة)، la raison (العقل)، cultiver (يزرع ويُعنِي)، le jardin (البستان)، la satire (الهجاء)، le philosophe (الفيلسوف)، le hasard (الصدفة)، la Providence (العناية الإلهية)، l’injustice (الظلم)، le travail (العمل).","نحوياً، l’écriture de Voltaire mêle trois registres temporels: l’imparfait peint les situations (« Candide vivait au château… »)، le passé simple enchaîne les événements (« Il partit. »)، et le présent de vérité formule la morale (« Il faut cultiver notre jardin. »). S’y ajoutent le discours direct et la question orale (« Que diable faisait-il dans cette Europe ? ») qui donnent à la voix narratrice son ironie.","le style voltairien est fait de phrases courtes, de verbes concrets et de mots abstraits immédiatement tournés en dérision: l’hyperbole et la litote servent la satire. Voltaire ne réfute jamais directement Pangloss — il le laisse parler, puis il oppose un fait: c’est l’ironie par le récit, procédé central du conte philosophique.","خُلاصة الدرس: la conclusion est une philosophie pratique — « Il faut cultiver notre jardin » signifie: cessez les systèmes, travaillez, soulagez le mal réel. C’est l’esprit des Lumières en une phrase: la raison au service de l’action et de la tolérance, non de la métaphysique."],"sub":[{"h":"l’ironie voltairienne","p":["« Tout est au mieux dans le meilleur des mondes. »","« Si c’est ici le meilleur des mondes, que sont donc les autres ? »","L’ironie naît du contraste entre la doctrine et le malheur."]},{"h":"les temps du récit","p":["l’imparfait: « Candide vivait au château… »","le passé simple: « Il partit. »","le présent de vérité: « Il faut cultiver notre jardin. »"]},{"h":"le vocabulaire des Lumières","p":["le conte philosophique — الحكاية الفلسفية","l’optimisme — التفاؤل","cultiver le jardin — يزرع حقله"]}]},{"h":"les phrases clés du conte","p":["« Tout est au mieux dans le meilleur des mondes. » — la thèse de Pangloss, répétée comme un mantra contre l’évidence du mal.","« Si c’est ici le meilleur des mondes, que sont donc les autres ? » — la réponse ironique de Candide: le doute est né de l’expérience.","« Il faut cultiver notre jardin. » — la morale finale: préférer l’action concrète aux systèmes métaphysiques.","« La raison est le seul critère. » — l’esprit des Lumières condensé: croire à la raison critique plutôt qu’à la tradition."]},{"h":"التطبيق والتلخيص","p":["تمرين la réécoute: شغّل la conclusion du conte sans sous-titres، ثم اكتب la morale de Candide في ثلاث جمل بالفرنسية مع verbs concrets (travailler, aider, semer).","تمرين la comparaison: اختر chapitre sur le mal (Lisbonne, le nègre de Surinam) واشرح في 70 كلمة كيف ي overturn Voltaire la théorie de Pangloss.","اكتب paragraphe de 90 mots بالفرنسية: « Pourquoi le conte philosophique est-il plus efficace que le traité de philosophie ? » مع 4 مفردات من leçon (satire, raison, optimisme, jardin)."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: يشرح الدرس بنية le conte philosophique عند Voltaire: la raillerie و l’hyperbole و la litote تهدم l’optimisme de Leibniz، و le jardin هو motif النهاية: « Il faut cultiver notre jardin ». أعد مشاهدة الفيديو الرئيسي وركّز على la scène du tremblement de terre وعلى dialogue Pangloss et Candide.","جسر الدروس: من b2-t10-l5 (جيرمينال — المعاناةُ الاجتماعية تُروى بجسامة الواقعية) إلى b2-t10-l6 (كاندید — المعاناةُ تُروى بخفّة السخرية الفولتيرية)، ثم إلى b2-t10-l7 حيث «أزهار الشر» لـ Baudelaire يستبدل ضحكَ الأنوار بـ le spleen et la modernité الشعرية.","مهمة تطبيقية: سجّل ملخّصاً من دقيقة، استعمل 3 كلمات من الدرس (مثل la raillerie و la lucidité و l’arbitraire)، ثم قارن إيقاع le conte في الفيديو بتحليلك لـ la satire voltairienne."]}],"pron":[{"w":"l’optimisme","ipa":"[lɔptimism]","approx":"لوپتيميزم"},{"w":"cultiver","ipa":"[kyltive]","approx":"كولتيڤيه"},{"w":"le jardin","ipa":"[lə ʒaʁdɛ̃]","approx":"ل جاردن"}],"vocab":[{"fr":"le conte philosophique","ar":"الحكاية الفلسفية","pos":"nom","g":"m","exFr":"Candide est le conte philosophique le plus célèbre du XVIIIe siècle.","ipa":"[lə kɔ̃t fɪlɔzɔfik]","exAr":"« كاندید » أشهر حكاية فلسفية في القرن الثامن عشر."},{"fr":"l’optimisme","ar":"التفاؤل الفلسفي","pos":"nom","g":"m","exFr":"L’optimisme de Pangloss se brise devant la réalité du mal.","ipa":"[lɔptimism]","exAr":"يتكسر تفاؤل بانغلوس أمام واقع الشر."},{"fr":"le mal","ar":"الشر والمحنة","pos":"nom","g":"m","exFr":"Voltaire demande pourquoi le mal existe dans le meilleur des mondes.","ipa":"[lə mal]","exAr":"يسأل فولتير لماذا يوجد الشر في أفضل العوالم."},{"fr":"la lucidité","ar":"الوضوح الذهني","pos":"nom","g":"f","exFr":"La lucidité des Lumières remplace la tradition.","exAr":"الوضوح الذهني لعصر الأنوار يحلّ محل التقاليد.","ipa":"[lysidite]"},{"fr":"cultiver","ar":"يزرع ويُعنِي بأرضه","pos":"verbe","g":"","exFr":"Il faut cultiver notre jardin, dit Candide à la fin.","ipa":"[kyltive]","exAr":"علينا أن نزرع حقلنا، يقول كاندید في النهاية."},{"fr":"le jardin","ar":"البستان والحقل","pos":"nom","g":"m","exFr":"Le jardin symbolise le travail concret et modeste.","ipa":"[ʒaʁdɛ̃]","exAr":"البستان رمز العمل الملموس المتواضع."},{"fr":"la raillerie","ar":"السخرية","pos":"nom","g":"f","exFr":"La raillerie voltairienne attaque sans nommer.","exAr":"السخرية الفولتيرانية تهاجم دون أن تسمّي.","ipa":"[ʁajʁi]"},{"fr":"le philosophe","ar":"الفيلسوف","pos":"nom","g":"m","exFr":"Pangloss est un philosophe de salon, pas un homme d’expérience.","ipa":"[fɪlɔzɔf]","exAr":"بانغلوس فيلسوف صالون لا رجل تجربة."},{"fr":"le hasard","ar":"الصدفة","pos":"nom","g":"m","exFr":"Le hasard multiplie les rencontres dans le récit de Candide.","ipa":"[azaʁ]","exAr":"الصدفة تضاعف اللقاءات في سرد كاندید."},{"fr":"la destinée","ar":"القدر المحتوم","pos":"nom","g":"f","exFr":"Il faut attendre la destinée plutôt que de se plaindre.","exAr":"ينبغي انتظار القدر المحتوم بدلاً من الشكوى.","ipa":"[dɛstine]"},{"fr":"l’arbitraire","ar":"التعسّف","pos":"nom","g":"m","exFr":"L’arbitraire du procès ouvre les yeux de Candide.","exAr":"تعسّف المحاكمة يفتح عيني كاندید.","ipa":"[aʁbitʁɛʁ]"},{"fr":"le travail","ar":"العمل","pos":"nom","g":"m","exFr":"C’est le travail qui rend le jardin fertile, selon la morale du conte.","ipa":"[tʁavaj]","exAr":"العمل هو ما يجعل البستان مثمراً حسب أخلاق الحكاية."}],"examples":[{"fr":"Tout est au mieux dans le meilleur des mondes.","ar":"كل شيء في أتم ترتيب في أفضل العوالم.","note":"la thèse de Pangloss"},{"fr":"Candide vivait au château en Westphalie.","ar":"كان كاندید يسكن في القلعة بهسيا.","note":"l’imparfait du décor initial"},{"fr":"Il partit, traversa l’Europe et connut la guerre.","ar":"رحل وعبر أوروبا وعرف الحرب.","note":"le passé simple du voyage"},{"fr":"Le tremblement de terre détruisit Lisbonne en 1755.","ar":"دمّر زلزال لشبونة سنة 1755.","note":"le fait historique qui brise l’optimisme"},{"fr":"Si c’est ici le meilleur des mondes, que sont donc les autres ?","ar":"إن كان هذا هو أفضل العوالم، فما بال العوالم الأخرى؟","note":"la question ironique"},{"fr":"Il faut cultiver notre jardin.","ar":"علينا أن نزرع حقلنا.","note":"la morale finale: l’action contre le système"}],"grammar":[{"tFr":"Les temps du récit littéraire: imparfait, passé simple, présent de vérité","tAr":"أزمنة السرد الأدبي: المضارع التام، الماضي البسيط، المضارع الجوهري","body":["le récit du conte alterne trois temps: l’imparfait peint le décor et les habitudes (« Candide vivait au château… »), le passé simple enchaîne les événements (« Il partit. »), et le présent de vérité énonce la morale hors du temps (« Il faut cultiver notre jardin. »).","règle B2: le présent de valeur générale n’appartient pas au récit — il marque la leçon que le conteur tire de l’histoire; savoir l’identifier est essentiel pour analyser la chute d’un conte."],"ex":[{"fr":"Candide était optimiste quand il rencontra le mal pour la première fois.","ar":"كان كاندید متفائلًا حين قابل الشر لأول مرة."},{"fr":"À la fin, il cultive sa terre avec ses compagnons.","ar":"في النهاية يزرع أرضه مع رفاقه."}]},{"tFr":"La concession et l’opposition: malgré, bien que, pourtant, cependant","tAr":"الاستدراك والمعارضة: رغم، على الرغم من أن، مع ذلك، غير ذلك","body":["Voltaire construit son ironie sur la concession: « Malgré les maux, Pangloss répétait… » — le connecteur annonce le contraste entre la doctrine et le fait, et le lecteur perçoit la critique sans qu’elle soit nommée.","règle B2: « bien que » et « encore que » gouvernent le subjonctif (« bien que le mal existe »), tandis que « malgré » se construit avec un nom ou un verbe à l’infinitif — confusion fréquente à l’écrit."],"ex":[{"fr":"Malgré les catastrophes, Pangloss affirmait que tout était pour le mieux.","ar":"رغم الكوارث، كان بانغلوس يؤكد أن كل شيء في أتم ترتيب."},{"fr":"Bien que la raison soit puissante, elle ne supprime pas la souffrance.","ar":"على الرغم من أن العقل قوي، إلا أنه لا يلغي المعاناة."}]}],"mistakes":[{"wrong":"considérer Candide comme un roman d’aventures","right":"reconnaître le conte philosophique","why":"chaque catastrophe sert la démonstration philosophique, l’aventure n’est qu’un prétexte."},{"wrong":"tout raconter au passé simple","right":"alterner imparfait, passé simple et présent de morale","why":"le décor est à l’imparfait, l’événement au passé simple, la leçon au présent."},{"wrong":"traduire « cultiver » par « décorer le jardin »","right":"cultiver = travailler la terre, s’occuper concrètement","why":"la morale oppose le travail concret aux spéculations métaphysiques."},{"wrong":"écrire « bien que le mal existerait »","right":"bien que le mal existe","why":"« bien que » impose le subjonctif, jamais l’indicatif."}],"dialogues":[{"title":"la dispute avec Pangloss","ctx":"Candide met en doute l’optimisme après le tremblement de terre","lines":[{"who":"Candide","fr":"Pangloss, pourquoi le mal existe-t-il si le monde est parfait ?","ar":"بانغلوس، لماذا يوجد الشر إن كان العالم كمالاً؟"},{"who":"Pangloss","fr":"Tout est au mieux : les petites causes produisent les meilleurs effets.","ar":"كل شيء في أتم ترتيب: الأسباب الصغيرة تنتج أفضل النتائج."},{"who":"Candide","fr":"Mais Lisbonne a brûlé, des milliers de gens sont morts.","ar":"لكن لشبونة احترقت وسقط آلاف الناس."},{"who":"Pangloss","fr":"Le meilleur des mondes exige cet équilibre providentiel.","ar":"أفضل العوالم يقتضي هذا التوازن الإلهي."}]},{"title":"la leçon du jardin","ctx":"Candide, Martin et les compagnons cultivent leur terre près de Constantinople","lines":[{"who":"Candide","fr":"Nous devons cultiver notre jardin : le travail est notre devoir.","ar":"علينا أن نزرع حقلنا: العمل واجبنا."},{"who":"Martin","fr":"Sans doute, mais le mal reste, même dans la terre labourée.","ar":"لعلك محق، لكن الشر يبقى حتى في الأرض المزروعة."},{"who":"Candide","fr":"C’est vrai, mais l’oisiveté rend notre esprit malheureux.","ar":"صحيح، لكن الكسل يجعل عالمنا تعيساً."},{"who":"Cacambo","fr":"Chacun a sa tâche : c’est cela, le meilleur des mondes possibles.","ar":"لكل واحد مهمته: هذا هو أفضل العوالم الممكنة."}]}],"exercises":[{"t":"mcq","skill":"listening","q":"ما الجملة التي تُلخّص خاتمة الحكاية الفلسفية؟","opts":["Il faut cultiver notre jardin.","Il faut chercher le meilleur des mondes.","Il faut lire les philosophes.","Il faut attendre la Providence."],"a":0,"why":"« Il faut cultiver notre jardin » est la morale pratique finale du conte."},{"t":"fill","skill":"grammar","q":"أكمل بالزمن المناسب: «Candide ___ au château de son oncle.»","fr":"Candide ... au château de son oncle.","ans":"vivait","why":"l’imparfait peint la situation initiale avant le départ."},{"t":"mcq","skill":"vocabulary","q":"أي كلمة تعني «الحكاية الفلسفية»؟","opts":["le conte philosophique","le roman realiste","la fable animalière","le théâtre classique"],"a":0,"why":"le conte philosophique mêle récit court, voyage et réflexion morale."},{"t":"order","skill":"writing","q":"رتّب: علينا أن نزرع حقلنا قالها كاندید في النهاية","words":["Il","faut","cultiver","notre","jardin","à","la","fin."],"ans":"Il faut cultiver notre jardin à la fin.","why":"« il faut + infinitif » exprime la morale générale du conte."},{"t":"listen","skill":"listening","q":"أي جملة تعبّر عن l’ironie voltairienne؟","opts":["Si c’est ici le meilleur des mondes, que sont donc les autres ?","Candide voyage en Europe.","Pangloss est le maître de Candide.","Le jardin demande du travail."],"a":0,"why":"la question orale oppose l’expérience du mal à la doctrine optimiste."},{"t":"translate","skill":"writing","q":"ترجم: «رغم الكوارث، كان بانغلوس يؤكد أن كل شيء في أتم ترتيب.»","ans":"Malgré les catastrophes, Pangloss affirmait que tout était pour le mieux.","why":"« malgré + nom » introduit la concession, la critique suit sans être nommée."},{"t":"speaking","skill":"speaking","q":"explique en français, en trois phrases, ce que signifie « Il faut cultiver notre jardin » aujourd’hui.","target":"Cultiver notre jardin, c’est agir concrètement au lieu de spéculer sur le sens du monde.","why":"la parole mobilise la morale du conte et le registre abstrait des Lumières."},{"t":"correct","skill":"grammar","q":"صحّح: «Bien que le mal existerait, il faut rester optimiste.»","ans":"Bien que le mal existe, il faut rester optimiste.","why":"« bien que » impose le subjonctif présent, jamais l’indicatif."}],"homework":"استمع إلى la conclusion du conte ثلاث مرات بدون sous-titres، اكتب la morale en deux phrases بالفرنسية، ثم اشرح في 90 mots pourquoi Voltaire préfère le jardin aux systèmes — avec quatre mots du lexique des Lumières.","sources":[{"title":"VOLTAIRE 📜 Candide (Résumé-analyse du conte philosophique commenté chapitre par chapitre)","channel":"Mediaclasse.fr","videoId":"988K0bxJyx8","why":"تحليل مدرسي منظم لـ le conte: la structure en trente chapitres courts، la chute de Pangloss، puis la conclusion « Il faut cultiver notre jardin » — يمهّد مباشرة لفهم l’ironie voltairienne et les temps du récit.","cat":"Livres","level":"B2","main":true},{"title":"Candide, Voltaire : TOUT ce que tu dois savoir !","channel":"Amélie Vioux - Bac de français","videoId":"IXMbQHoNSIw","why":"ملخّص مدرسي مكثّف يشرح le contexte, le personnage et la structure — مثالي لمراجعة سريعة قبل التحليل.","cat":"Livres","level":"B2","extra":true},{"title":"Comprendre CANDIDE et les idées de VOLTAIRE en 5 extraits","channel":"Un Cours de 5 Minutes","videoId":"nI1oBovj_vY","why":"خمسة extraits معلَّقة تشرح l’ironie خطوة بخطوة — تدعم la lecture analytique de la phrase voltairienne.","cat":"Livres","level":"B2","extra":true}],"supplements":[{"id":"IXMbQHoNSIw","title":"Candide, Voltaire : TOUT ce que tu dois savoir !","channel":"Amélie Vioux - Bac de français","why":"ملخّص مدرسي مكثّف يشرح le contexte, le personnage et la structure — مثالي لمراجعة سريعة قبل التحليل.","lang":"fr","dur":15},{"id":"nI1oBovj_vY","title":"Comprendre CANDIDE et les idées de VOLTAIRE en 5 extraits","channel":"Un Cours de 5 Minutes","why":"خمسة extraits معلَّقة تشرح l’ironie خطوة بخطوة — تدعم la lecture analytique de la phrase voltairienne.","lang":"fr","dur":7}]},{"id":"b2-t10-l7","fr":"Les Fleurs du mal — Charles Baudelaire","ar":"أزهار الشر — شارل بودلير","objectives":["analyser la structure du recueil: les six sections, la domination de Spleen et idéal, l’unité du mal transformé en art","_acquire 12 كلمة أساسية حول le spleen, l’idéal, la correspondance, l’alexandrin, la synesthésie, le scandale","expliquer la synesthésie dans « Correspondances » et relier la vision baudelairienne à l’alchimie du poète","reconnaître l’alexandrin, la césure et le commentaire d’un extrait des Fleurs du mal"],"sections":[{"h":"الدرس 7: تحليل «أزهار الشر» — ولادة الشعر الحديث","video":{"id":"S2IueIlVVOg","title":"Les Fleurs du Mal de Baudelaire, analyse en 6 questions pour l’oral ou la dissertation","channel":"La Boîte à Bac","why":"تحليل مدرسي في ست أسئلة: le contexte du Second Empire, la structure du recueil، ثم le spleen et l’alchimie poétique — يمهّد مباشرة لفهم la naissance de la poésie moderne.","lang":"fr","main":true,"dur":20},"p":["« Les Fleurs du mal » (1857) est le recueil fondateur de la poésie moderne française, publié le même année que « Madame Bovary ». Baudelaire y range ses poèmes en six sections, dont la plus vaste, Spleen et idéal, oppose la lassitude existentielle à la quête de la beauté pure — deux pôles d’une même angoisse.","l’alchimie poétique est le cœur du projet: le poète transforme « le beau de la merde », selon l’expression crue des « Épaves », c’est-à-dire il tire la fleur de la pourriture du spleen. La poésie n’est plus un embellissement du monde mais une transmutation de la douleur.","المفردات المحورية في هذا الدرس: le spleen (الكآبة الوجودية)، l’idéal (المثالية الجمالية)، la correspondance (التوافق بين الحواس)، l’alchimie (الخيمياء الشعرية)، l’alexandrin (البيت ذو إحدى عشرة مقطع)، le vers (الشطر الشعري)، la rime (القافية)، le symbole (الرمز)، la synesthésie (اتحاد الحواس)، la modernity (الحداثة)، le poète (الشاعر)، le scandale (الفضيحة الأدبية).","l’alexandrin, vers de douze syllabes coupé en deux par la césure, reste le vers noble de la poésie classique; Baudelaire le conserve mais le fait vibrer de rythmes nouveaux: l’enjambement, l’hyperbole et surtout les correspondances sensorielles (ouïe, vue, odorat se répondent).","le scandale de 1857 est historique: le procureur impérial poursuit le recueil pour « outrage à la morale publique et religieuse »; deux poèmes (« À une dame pieuse » et « Les Bijoux ») sont condamnés. Baudelaire répondra en ajoutant des poèmes et en publiant « Le Spleen de Paris » en prose.","خُلاصة الدرس: « Hypocrite lecteur, — mon semblable, — mon frère ! »: la dernière tirade d’Au Lecteur retourne le miroir contre le lecteur lui-même. La modernité naît là: le poète ne prêche plus du haut d’une chaire, il avoue sa complicité avec le mal et appelle le lecteur à sa place."],"sub":[{"h":"le spleen et l’idéal","p":["« J’ai plus de souvenirs que si j’avais mille ans. »","Le spleen est la lassitude du temps qui passe.","L’idéal est la beauté inatteignable qui attire le poète."]},{"h":"les correspondances","p":["« La Nature est un temple où de vivants piliers… »","La synesthésie: une odeur devient une couleur.","L’alchimie du poète transforme le mal en fleur."]},{"h":"le lexique de la poésie","p":["l’alexandrin — بيت شعري من 12 مقطعاً","la rime — القافية","la synesthésie — اتحاد الحواس"]}]},{"h":"les phrases clés du recueil","p":["« Hypocrite lecteur, — mon semblable, — mon frère ! » — la fin d’Au Lecteur: le lecteur est pris à partie, complice du mal qu’il condamne.","« La Nature est un temple où de vivants piliers… » — Correspondances: la nature devient un lieu sacré où les sens se répondent.","« J’ai plus de souvenirs que si j’avais mille ans. » — Spleen I: le temps chargé d’ennui, thème central du recueil.","« Il faut être toujours ivre… » — Le Spleen de Paris: l’ivresse comme remède contre le spleen, la prose poétique en action."]},{"h":"التطبيق والتلخيص","p":["تمرين la réécoute: شغّل la lecture de « Correspondances » ثم ارسم les quatre correspondances sensorielles في جدول (ouïe, vue, odorat, toucher).","تمرين la comparaison: قارن بين « le spleen » chez Baudelaire و« la mélancolie » في الشعر العربي الحديث، مع 50 كلمة بالفرنسية.","اكتب commentaire de 90 mots sur « Hypocrite lecteur »: من يُخاطب؟ لماذا هذا الاسم؟ وما أثر التكرار في « mon semblable, mon frère »؟"]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: يعرض الدرس ولادة الشعر الحديث في «أزهار الشر»: le spleen et l’idéal قطبان متعاكسان، la strophe و la synesthésie أداتا التجديد، و la modernité موضوع الديوان؛ Baudelaire يجدد la strophe دون أن يهدم la tradition classique. أعد مشاهدة الفيديو الرئيسي وركّز على la lecture d’une strophe وعلى l’effet de la synesthésie.","جسر الدروس: من b2-t10-l6 (كاندید — العقلُ الساخر يضبط العالم) إلى b2-t10-l7 (أزهار الشر — الحدسُ الشعري يفتح العالم من جديد)، ثم إلى b2-t10-l8 حيث «الأب غوريو» لـ Balzac يعود بالرواية إلى la Comédie humaine: الحبُّ الأبوي يُقاس بالمال والوراثة.","مهمة تطبيقية: سجّل قراءةً صوتية لـ une strophe ثم لخّص معناها في دقيقة، أضف 3 كلمات من الدرس (مثل la strophe و le distique)، ثم قارن القراءة في الفيديو بإيقاعك أنت."]}],"pron":[{"w":"le spleen","ipa":"[lə splin]","approx":"ل سبلان"},{"w":"le distique","ipa":"[distik]","approx":"دييستيك"},{"w":"la synesthésie","ipa":"[la sinɛstezi]","approx":"لا سينيستيزي"}],"vocab":[{"fr":"le spleen","ar":"الكآبة الوجودية","pos":"nom","g":"m","exFr":"Le spleen étreint le poète quand le temps semble immobile.","ipa":"[splin]","exAr":"تُخنق الكآبة الشاعر حين يبدو الزمن ساكناً."},{"fr":"l’idéal","ar":"المثالية الجمالية","pos":"nom","g":"m","exFr":"L’idéal est une beauté que le poète poursuit sans jamais l’atteindre.","ipa":"[lideal]","exAr":"المثالية جمال يلاحقه الشاعر دون أن يبلغه."},{"fr":"la correspondance","ar":"التوافق بين الحواس","pos":"nom","g":"f","exFr":"Dans Correspondances, les odeurs, les couleurs et les sons se répondent.","ipa":"[kɔ̃sɛpɑ̃s]","exAr":"في «التوافق» تترابط الروائح والألوان والأصوات."},{"fr":"l’alchimie","ar":"الخيمياء الشعرية","pos":"nom","g":"f","exFr":"L’alchimie du poète transforme les douleurs en fleurs de beauté.","ipa":"[alʃəmi]","exAr":"خيمياء الشاعر تحوّل الآلام إلى أزهار الجمال."},{"fr":"le distique","ar":"البيت الشعري المزدوج","pos":"nom","g":"m","exFr":"Le distique unit deux vers dans le recueil.","exAr":"البيت المزدوج يوحّد سطرين داخل الديوان.","ipa":"[distik]"},{"fr":"le vers","ar":"الشطر الشعري","pos":"nom","g":"m","exFr":"Chaque vers du poème respire à la césure.","ipa":"[lə vɛʁ]","exAr":"كل شطر من الشطر يتنفس عند الوصل."},{"fr":"la prose","ar":"النثر","pos":"nom","g":"f","exFr":"La strophe baudelaireienne cadre la douleur du poète.","exAr":"القطعة الشعرية عند بودلير تؤطّر ألم الشاعر.","ipa":"[stʁɔf]"},{"fr":"le symbole","ar":"الرمز","pos":"nom","g":"m","exFr":"La fleur est le symbole de la beauté fragile et passagère.","ipa":"[sɛ̃bɔl]","exAr":"الزهرة رمز الجمال الهش العابر."},{"fr":"la synesthésie","ar":"اتحاد الحواس الشعرية","pos":"nom","g":"f","exFr":"La synesthésie permet au poète de « voir » une musique.","ipa":"[sinɛstezi]","exAr":"اتحاد الحواس يسمح للشاعر بأن «يرى» الموسيقى."},{"fr":"la modernité","ar":"الحداثة","pos":"nom","g":"f","exFr":"Baudelaire définit le poète comme « peintre de la modernité ».","ipa":"[mɔdɛʁnite]","exAr":"يعرّف بودلير الشاعر بوصفه «رسام الحداثة»."},{"fr":"le poète","ar":"الشاعر","pos":"nom","g":"m","exFr":"Le poète modern est un voyageur entre le spleen et l’idéal.","ipa":"[pɔɛt]","exAr":"الشاعر الحديث مسافر بين الكآبة والمثالية."},{"fr":"le scandale","ar":"الفضيحة الأدبية","pos":"nom","g":"m","exFr":"Le scandale de 1857 fit condamner deux poèmes du recueil.","ipa":"[skɑ̃dal]","exAr":"فضيحة 1857 أدت إلى إدانة شطرين من المجموعة."}],"examples":[{"fr":"Hypocrite lecteur, — mon semblable, — mon frère !","ar":"يا قارئ منافق، نظيري، يا أخا!","note":"la prise à parti du lecteur (Au Lecteur)"},{"fr":"La Nature est un temple où de vivants piliers.","ar":"الطبيعة هي معبد تحيط به أعمدة حية.","note":"la métaphore fondatrice des Correspondances"},{"fr":"J’ai plus de souvenirs que si j’avais mille ans.","ar":"لديّ ذكريات أكثر مما لو كنت عشت ألف سنة.","note":"le spleen et le poids du temps"},{"fr":"Baudelaire sculpte la douleur dans l’alexandrin.","ar":"يُصوغ بودلير الألم في البيت الكلاسيكي.","note":"la forme contre la substance"},{"fr":"Le poète transforme le mal en fleur de beauté.","ar":"يحوّل الشاعر الشر إلى زهرة جمال.","note":"l’alchimie poétique"},{"fr":"La loi de 1857 poursuivit le recueil pour outrage aux mœurs.","ar":"لاحق قانون 1857 المجموعة بسبب إهانة الأخلاق.","note":"le scandale judiciaire et sa postérité"}],"grammar":[{"tFr":"Le subjonctif après les conjonctions de but et de concession","tAr":"الفاعلية الفرعية بعد أدوات الغرض والاستدراك","body":["le commentaire littéraire exige le subjonctif: « Bien que le poète souffre, il crée. », « pour que la beauté survive, il la sculpte. » — les conjonctions bien que, pour que, avant que, afin que le commandent.","règle B2: après « pour que », le sujet du subjonctif est toujours différent du sujet principal (« Baudelaire écrit pour que le lecteur comprenne »); après « bien que », le sujet est souvent le même — piège classique à l’écrit."],"ex":[{"fr":"Bien que le spleen l’étreigne, le poète poursuit l’idéal.","ar":"على الرغم من أن الكآبة تُخنقه، يواصل الشاعر لاحقة المثالية."},{"fr":"Il sculpte ses vers pour que la beauté dure.","ar":"يُصوغ أشطاره لكي يدوم الجمال."}]},{"tFr":"L’expression de la cause et de la conséquence: car, puisque, c’est pourquoi, si bien que","tAr":"التعبير عن السبب والنتيجة","body":["dans un commentaire, la cause se dit avec car, puisque ou grâce à (cause positive); la conséquence avec c’est pourquoi, si bien que, de sorte que. Exemple: « Le temps est immobile, c’est pourquoi le poète sombre dans le spleen. »","règle B2: « si bien que » introduit une conséquence logique et se construit avec l’indicatif; « de sorte que » peut prendre le subjonctif quand la conséquence est voulue. Bien distinguer cause et conséquence est la base de l’argumentation du commentaire."],"ex":[{"fr":"Le poète cherche la beauté, si bien qu’il voyage sans cesse.","ar":"يبحث الشاعر عن الجمال، حتى إنه يسافر دون توقف."},{"fr":"Le recueil fut condamné, c’est pourquoi Baudelaire l’enrichit.","ar":"أُدانت المجموعة، ولهذا أعاد بودلير إثراءها."}]}],"mistakes":[{"wrong":"réduire le spleen à une simple tristesse","right":"le spleen est une lassitude existentielle du temps","why":"le spleen est chargé d’ennui, de mémoire et d’impuissance, pas seulement de tristesse."},{"wrong":"écrire « Baudelaire a inventé la rime »","right":"Baudelaire a renouvelé l’alexandrin classique","why":"la rime et le vers de douze syllabes existaient déjà: l’innovation est dans les correspondances."},{"wrong":"lire les images sans repérer la synesthésie","right":"identifier le croisement des sens dans les correspondances","why":"la synesthésie (ouïe, vue, odorat) est la signature de la modernité baudelairienne."},{"wrong":"dire « Bien que le poète serait triste… »","right":"Bien que le poète soit triste…","why":"après « bien que », le subjonctif s’impose, jamais le conditionnel."}],"dialogues":[{"title":"l’étudiant devant le spleen","ctx":"deux étudiants préparent l’oral sur Baudelaire","lines":[{"who":"Léa","fr":"Quand tu lis « J’ai plus de souvenirs que si j’avais mille ans », que ressens-tu ?","ar":"حين تقرأ «لديّ ذكريات أكثر مما لو كنت عشت ألف سنة»، ماذا تشعر؟"},{"who":"Yanis","fr":"Le poids du temps : le spleen, ce n’est pas juste la tristesse, c’est l’ennui.","ar":"ثِقل الزمن: الكآبة ليست مجرد حزن، بل هي السأم."},{"who":"Léa","fr":"Et la synesthésie dans Correspondances, elle sert quoi ?","ar":"وماذا عن اتحاد الحواس في «التوافق»؟ ما فائدته؟"},{"who":"Yanis","fr":"Elle montre que les sens se répondent : le poète voit la musique, il sent les couleurs.","ar":"يُظهر أن الحواس تترابط: الشاعر يرى الموسيقى ويشتمل الألوان."}]},{"title":"le scandale du procès","ctx":"un professeur rappelle le contexte de la condamnation de 1857","lines":[{"who":"Le professeur","fr":"En 1857, deux poèmes sont condamnés pour outrage aux mœurs.","ar":"سنة 1857 أُدِنَّ شطيران بسبب إهانة الأخلاق."},{"who":"Étudiant","fr":"Pourquoi le titre « Les Fleurs du mal » a-t-il choqué ?","ar":"لماذا صادم عنوان «أزهار الشر»؟"},{"who":"Le professeur","fr":"Il oppose fleur et mal : la beauté naît de ce que la société condamne.","ar":"لأنه يضع الزهرة مقابل الشر: الجمال يولد مما تدنه المجتمع."},{"who":"Étudiant","fr":"C’est donc un acte de provocation poétique et philosophique.","ar":"إذن هو فعل استفزاز شعري وفلسفي."}]}],"exercises":[{"t":"mcq","skill":"listening","q":"ما الجملة التي تعبّر عن l’alchimie poétique ?","opts":["Le poète transforme le mal en fleur de beauté.","Le poète décrit la nature uniquement.","Le poète refuse la rime classique.","Le poète imite les anciens grecs."],"a":0,"why":"l’alchimie, c’est la transmutation du mal en art, thème central du recueil."},{"t":"fill","skill":"grammar","q":"أكمل بالفاعلية الفرعية: «Bien que le spleen ___ le poète, il crée.»","fr":"Bien que le spleen ... le poète, il crée.","ans":"étreigne","why":"« bien que » impose le subjonctif présent: étreigne."},{"t":"mcq","skill":"vocabulary","q":"ما معنى « la synesthésie » في النقد الشعري؟","opts":["اتحاد الحواس الشعرية","القافية المتبادلة","البيت ذو إحدى عشرة مقطع","الفضيحة الأدبية"],"a":0,"why":"la synesthésie croise les sens: une couleur a une odeur, une musique a une forme."},{"t":"order","skill":"writing","q":"رتّب: الطبيعة معبد تحيط به أعمدة حية","words":["La","Nature","est","un","temple","où","de","vivants","piliers."],"ans":"La Nature est un temple où de vivants piliers.","why":"la métaphore fondatrice des Correspondances se lit dans ce vers."},{"t":"listen","skill":"listening","q":"أي جملة تصف le spleen بوصفه حالة وجودية؟","opts":["J’ai plus de souvenirs que si j’avais mille ans.","La Nature est un temple.","Il faut être toujours ivre.","Le poète voyage sans cesse."],"a":0,"why":"le poids de la mémoire et du temps définit le spleen baudelairien."},{"t":"translate","skill":"writing","q":"ترجم: «يُصوغ بودلير الألم داخل البيت الكلاسيكي.»","ans":"Baudelaire sculpte la douleur dans l’alexandrin classique.","why":"« sculpter la douleur » traduit l’image de la souffrance travaillée par la forme."},{"t":"speaking","skill":"speaking","q":"explique en français, en trois phrases, ce qu’est la synesthésie dans « Correspondances ».","target":"Dans Correspondances, les sens se croisent : le poète voit la musique et sent les couleurs.","why":"la parole mobilise le lexique de la poésie et l’explication d’une figure de style."},{"t":"correct","skill":"grammar","q":"صحّح: «Bien que le poète serait mélancolique, il cherche la beauté.»","ans":"Bien que le poète soit mélancolique, il cherche la beauté.","why":"après « bien que », on emploie le subjonctif, jamais le conditionnel."}],"homework":"استمع إلى la lecture de « Correspondances » ثلاث مرات، ارسم جدول les correspondances sensorielles بالفرنسية، ثم اكتب commentaire de 120 mots على « Hypocrite lecteur, — mon semblable, — mon frère ! » مع خمسة مفردات من الدرس.","sources":[{"title":"Les Fleurs du Mal de Baudelaire, analyse en 6 questions pour l’oral ou la dissertation","channel":"La Boîte à Bac","videoId":"S2IueIlVVOg","why":"تحليل مدرسي في ست أسئلة: le contexte du Second Empire, la structure du recueil، ثم le spleen et l’alchimie poétique — يمهّد مباشرة لفهم la naissance de la poésie moderne.","cat":"Livres","level":"B2","main":true},{"title":"BAUDELAIRE 🔎 Les Fleurs du Mal - Correspondances (Commentaire analyse linéaire)","channel":"Mediaclasse.fr","videoId":"nkMLaqjmW-Q","why":"commentaire linéaire متكامل لـ « Correspondances »: la synesthésie و la métaphore — يدعم la lecture analytique.","cat":"Livres","level":"B2","extra":true},{"title":"Spleen et idéal — Résumé et Explication de la section des Fleurs du mal","channel":"Gloria Lauzanne Cours de français","videoId":"xneSRm99sss","why":"شرح la plus grande section du recueil: la structure du spleen مقابل l’idéal — ضروري لفهم la progression du recueil.","cat":"Livres","level":"B2","extra":true}],"supplements":[{"id":"nkMLaqjmW-Q","title":"BAUDELAIRE 🔎 Les Fleurs du Mal - Correspondances (Commentaire analyse linéaire)","channel":"Mediaclasse.fr","why":"commentaire linéaire متكامل لـ « Correspondances »: la synesthésie و la métaphore — يدعم la lecture analytique.","lang":"fr","dur":16},{"id":"xneSRm99sss","title":"Spleen et idéal — Résumé et Explication de la section des Fleurs du mal","channel":"Gloria Lauzanne Cours de français","why":"شرح la plus grande section du recueil: la structure du spleen مقابل l’idéal — ضروري لفهم la progression du recueil.","lang":"fr","dur":8}]},{"id":"b2-t10-l8","fr":"Le Père Goriot — Honoré de Balzac","ar":"الأب غوريو — هونوري دو بالزاك","objectives":["analyser la structure du roman: la pension Vauquer, le triangle père-filles, l’ascension d’Eugène de Rastignac","_acquire 12 كلمة أساسية autour de la famille, le dévouement, l’ambition, le monde social, la mort","identifier le discours indirect libre de Balzac comme signature du narrateur romanesque","décrire le Paris balzacien: la pension, le Faubourg Saint-Germain, l’argent comme moteur social"],"sections":[{"h":"الدرس 8: تحليل «الأب غوريو» — الواقعية والكوميديا الإنسانية","video":{"id":"59bsBUAlWdc","title":"BALZAC 📜 Le Père Goriot (Résumé-analyse du roman illustré et commenté)","channel":"Mediaclasse.fr","why":"تحليل مدرسي شامل: la pension Vauquer، le dévouement de Goriot، ثم la structure de la Comédie humaine — يمهّد مباشرة لفهم le personnage balzacien et le Paris bourgeois.","lang":"fr","main":true,"dur":13},"p":["« Le Père Goriot » (1835) est un roman de la Comédie humaine de Balzac: cent trente personnages, trois thèmes entremêlés — le dévouement du père Goriot qui sacrifie tout à ses deux filles, l’ascension du jeune Eugène de Rastignac dans le Paris corrompu, et la description de la pension Vauquer comme microcosme social.","le Paris balzacien est un personnage à lui seul: la pension Vauquer (rue Neuve-Sainte-Geneviève) concentre la misère et l’avarice; le Faubourg Saint-Germain, avec ses hôtels particuliers, incarne la haute noblesse; entre les deux circule l’argent, seule mesure de la valeur humaine dans ce monde.","المفردات المحورية في هذا الدرس: la Comédie humaine (الكوميديا الإنسانية)، le dévouement (التضحية)، l’ambition (الطموح)، la fortune (الثروة)، l’héritage (الإرث)، le monde (الصالونات)، la pension (السكن الطلابي/الدار)، avarice (البخل)، l’ingratitude (الجحود)، le père (الأب)، la fille (الابنة)، le sacrifice (التضحية).","نحوياً، la signature stylistique de Balzac est le discours indirect libre: le narrateur épouse la pensée d’un personnage tout en gardant la troisième personne (« Rastignac se dit: ceci n’est que le début — il fallait s’enfoncer dans ce monde. »). Il mêle aussi description précise des objets (meubles, tapis, prix) et jugement moral du narrateur.","le personnage de Goriot incarne l’amour paternel poussé jusqu’à l’abnégation: ancien vermicelier enrichi, il vend ses meubles, vend sa rente, va jusqu’à la rue pour ses filles Anatolie et Delphine. le parallèle avec Jésus (l’homme au panier, le calvaire) est explicite: le père devient une figure sacrificielle.","خُلاصة الدرس: le roman est une leçon de realisme balzacien — « l’histoire oubliée des mœurs » selon la formule de l’auteur. la question centrale d’Eugène (« Dois-je me faire homme ou rester honnête ? ») traverse tout le roman: c’est la naissance du héros réaliste, tiraillé entre l’idéal et le monde."],"sub":[{"h":"la pension Vauquer","p":["« La maison est située dans le quartier le plus mal famé de Paris. »","Chaque locataire révèle une couche sociale.","La pension est le microcosme du monde balzacien."]},{"h":"le père dévoué","p":["Goriot vend ses meubles pour payer les dettes de ses filles.","Il va jusqu’à la rue pour voir Delphine au bal.","Sa mort est un calvaire solitaire: « Où sont mes filles ? »"]},{"h":"les temps du roman","p":["l’imparfait: description du décor social","le passé simple: l’action d’Eugène et de Goriot","le discours indirect libre: la pensée du héros"]}]},{"h":"les phrases clés du roman","p":["« Entre pauvres, il faut s’aider. » — la leçon que Vautrin donne à Rastignac, devient le credo du monde parisien.","« La vie est un jeu à deux: il faut être banquier ou joueur. » — l’alternative de Vautrin entre honnêteté et réussite.","« Où sont mes filles ? » — les derniers mots de Goriot, qui meurent avec lui dans la solitude du pensionnat.","« Le monde est tel qu’il est, et non tel que nous le voudrions. » — le constat réaliste qui structure tout le roman."]},{"h":"التطبيق والتلخيص","p":["تمرين la réécoute: شغّل la scène de la mort de Goriot بدون sous-titres، ثم اكتب le récit de la scène في خمس جمل بالفرنسية avec le passé simple.","تمرين la comparaison: اختر locataire واحداً من la pension واكتب 60 كلمة تشرح ما يمثله في le monde social balzacien.","اكتب paragraphe de 90 mots: « Selon Balzac, l’argent gouverne-t-il le cœur familial ? » مع أربع مفردات من الدرس (dévouement, ingratitude, fortune, sacrifice)."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: يقرأ الدرس «الأب غوريو» كـ microcosme de la Comédie humaine: le dévouement de Goriot يصطدم بـ l’avarice و l’ingratitude بناته، و Rastignac يتعلم le monde من فوق سطحه. أعد مشاهدة الفيديو الرئيسي وركّز على la mort de Goriot وعلى la première sortie de Rastignac à Paris.","جسر الدروس: من b2-t10-l7 (أزهار الشر — انطباعُ الشاعر على المدينة الحديثة) إلى b2-t10-l8 (الأب غوريو — تشريحُ المدينة الحديثة عبر la pension Vauquer)، ثم إلى b2-t10-l9 حيث «الأميرة دو كليڤ» تنقلنا إلى la cour: من la précarité الحضرية إلى la pudeur الأرستقراطية و le secret du cœur.","مهمة تطبيقية: سجّل ملخّص الرواية في دقيقة، استعمل 3 كلمات من الدرس (مثل le legs و la précarité و la fresque sociale)، ثم قارن la pension Vauquer في الفيديو بوصف Balzac للثراء: كيف تتقابل الطبقتان في فضاءٍ واحد؟"]}],"pron":[{"w":"le dévouement","ipa":"[lə devwamɑ̃]","approx":"ل دُڤُوامان"},{"w":"le legs","ipa":"[lɛs]","approx":"ليس"},{"w":"l’ambition","ipa":"[lɑ̃bisjɔ̃]","approx":"لامبيسيون"}],"vocab":[{"fr":"la Comédie humaine","ar":"الكوميديا الإنسانية","pos":"nom","g":"f","exFr":"Le Père Goriot est un des romans majeurs de la Comédie humaine.","ipa":"[la kɔmedi ymɛn]","exAr":"« الأب غوريو» من أشهر روايات الكوميديا الإنسانية."},{"fr":"le dévouement","ar":"التضحية والإخلاص","pos":"nom","g":"m","exFr":"Le dévouement de Goriot envers ses filles n’a pas de limite.","ipa":"[devwamɑ̃]","exAr":"تضحية غوريو من أجل بناته لا حدود لها."},{"fr":"l’ambition","ar":"الطموح","pos":"nom","g":"f","exFr":"L’ambition d’Eugène le pousse à gravir les échelons du monde parisien.","ipa":"[lɑ̃bisjɔ̃]","exAr":"طموح أوجين يدفعه لصعود سلالم العالم الباريسي."},{"fr":"la fortune","ar":"الثروة والمال","pos":"nom","g":"f","exFr":"La fortune du père Goriot finit entre les mains de ses belles-filles.","ipa":"[fɔʁtyn]","exAr":"ثروة الأب غوريو تنتهي في أيدي زوجات بناته."},{"fr":"le legs","ar":"الإرث المُخلَّف","pos":"nom","g":"m","exFr":"Les filles se battent pour le legs de leur père mourant.","exAr":"البنات يتنازعن على إرث أبهن المحتضر.","ipa":"[lɛs]"},{"fr":"l’avarice","ar":"البخل","pos":"nom","g":"f","exFr":"L’avarice de la femme Vauquer régit l’ambiance de la pension.","ipa":"[lavaʁis]","exAr":"بخل الزوجة فوكيه يحكم أجواء السكن."},{"fr":"l’ingratitude","ar":"الجحود","pos":"nom","g":"f","exFr":"L’ingratitude des filles brise le cœur de leur père.","ipa":"[lɛ̃ɡʁatityd]","exAr":"جحود البنات يُكسِر قلب أبيهما."},{"fr":"la pension","ar":"دار السكن الطلابي","pos":"nom","g":"f","exFr":"La pension Vauquer est un microcosme du Paris bourgeois.","ipa":"[pɑ̃sjɔ̃]","exAr":"دار فوكيه مجسّم مصغّر لباريس البرجوازية."},{"fr":"le sacrifice","ar":"التضحية","pos":"nom","g":"m","exFr":"Le sacrifice de Goriot est comparé à la passion du Christ.","ipa":"[sakrifis]","exAr":"تضحية غوريو تُشبَّه بصلب المسيح."},{"fr":"le monde","ar":"الصالونات والمجتمع الراقي","pos":"nom","g":"m","exFr":"Rastignac veut entrer dans le monde, c’est-à-dire dans la réussite.","ipa":"[lə mɔ̃d]","exAr":"يريد راستينياك أن يدخل «العالم»، أي دائرة النجاح."},{"fr":"la précarité","ar":"الهشاشة الاجتماعية","pos":"nom","g":"f","exFr":"La précarité de la pension contraste avec le Faubourg Saint-Germain.","exAr":"هشاشة البيت المُأجَّر تتصادم مع حيّ سان جيرمان الراقي.","ipa":"[pʁekaʁite]"},{"fr":"la fresque sociale","ar":"اللوحة الاجتماعية","pos":"nom","g":"f","exFr":"La fresque balzacienne décrit la société avec précision.","exAr":"اللوحة الاجتماعية عند بالزاك تصف المجتمع بدقة.","ipa":"[fʁɛsk sɔsjal]"}],"examples":[{"fr":"Goriot vend ses meubles pour payer les dettes de ses filles.","ar":"يبيع غوريو أثاثه ليدفع ديون بناته.","note":"le dévouement poussé à l’extrême"},{"fr":"La pension Vauquer est située dans le quartier le plus pauvre de Paris.","ar":"تقع دار فوكيه في أفقر أحياء باريس.","note":"le décor social balzacien"},{"fr":"Rastignac se dit qu’il fallait s’enfoncer dans ce monde.","ar":"يقول راستينياك في نفسه إنه عليه أن ينغمس في هذا العالم.","note":"le discours indirect libre"},{"fr":"Anatolie et Delphine n’étaient pas venues à l’enterrement.","ar":"لم تأتِ أناتولي ودلفين إلى الجنازة.","note":"l’ingratitude des filles"},{"fr":"Vautrin apparaît comme le vrai maître du roman.","ar":"يظهر فوتران بوصفه المدير الحقيقي للرواية.","note":"le personnage ambigu"},{"fr":"Le roman nous montre que l’argent gouverne les relations familiales.","ar":"تُظهر الرواية أن المال يحكم العلاقات الأسرية.","note":"la leçon sociale du roman"}],"grammar":[{"tFr":"Le discours indirect libre chez Balzac","tAr":"السرد غير المباشر الحر عند بالزاك","body":["Balzac mêle le narrateur à la pensée du personnage sans verbe introducteur ni guillemets: « Rastignac se dit: ceci n’est que le début. Il fallait s’enfoncer dans ce monde et y trouver des appuis. » — la phrase garde la troisième personne mais adopte le lexique et le ton du héros.","règle B2: pour le reconnaître, cherchez la conjugaison à la troisième personne avec un vocabulaire subjectif (« il fallait », « ceci n’est que… ») et l’absence de subordonnant « que » introducteur — c’est la signature du roman balzacien et une clé majeure du commentaire."],"ex":[{"fr":"Goriot pensait que ses filles l’oublieraient un jour.","ar":"كان غوريو يفكر أن بناته ستنساه يوماً ما."},{"fr":"Ceci n’est que le début, se dit-il.","ar":"هذا مجرد البداية، قال في نفسه."}]},{"tFr":"Le plus-que-parfait et la description du monde social","tAr":"الماضي الأبعد والأبعاد المكانية/الاجتماعية","body":["dans la description balzacienne, l’imparfait et le plus-que-parfait construisent l’arrière-plan social: « La maison appartenait à la veuve Vauquer qui la possédait depuis trente ans. » — les temps renvoient à l’histoire des personnages avant le début du récit.","règle B2: le plus-que-parfait situe un état antérieur à un autre passé déjà raconté; il est indispensable pour analyser l’exposition du roman: avant qu’Eugène n’arrive, la pension avait déjà son histoire, ses prix, ses habitants."],"ex":[{"fr":"La pension avait déjà ses habitudes quand Rastignac y entra.","ar":"كان للسكن عاداته الجاهزة حين دخل راستينياك."},{"fr":"Goriot avait vendu sa fortune avant de mendier pour ses filles.","ar":"كان غوريو قد باع ثروته قبل أن يتسول من أجل بناته."}]}],"mistakes":[{"wrong":"réduire le roman à la seule mort de Goriot","right":"analyser les trois lignes du roman","why":"Goriot, Rastignac et la pension forment une structure triangulaire du Paris balzacien."},{"wrong":"confondre le narrateur omniscient et le discours indirect libre","right":"repérer la troisième personne teintée de la pensée du personnage","why":"le discours indirect libre est la marque de Balzac: le narrateur glisse dans la conscience du héros."},{"wrong":"traduire « le monde » par « l’univers »","right":"dans le roman, « le monde » désigne les salons et la réussite sociale","why":"dans le lexique balzacien, entrer dans le monde, c’est gravir les échelons de la société."},{"wrong":"écrire « il avait vendu avant qu’il ne parte »","right":"il avait vendu avant de partir","why":"« avant de » + infinitif exprime l’antériorité sans subjonctif inutile."}],"dialogues":[{"title":"Eugène et Vautrin au dîner","ctx":"Vautrin propose à Rastignac un marché scabreux","lines":[{"who":"Vautrin","fr":"Le monde est un jeu à deux : il faut être banquier ou joueur.","ar":"العالم لعبة بين اثنين: عليك أن تكون مصرفاً أو لاعباً."},{"who":"Rastignac","fr":"Et si je refusais votre marché, que se passerait-il ?","ar":"وإن رفضت صفقتكم، ماذا سيحدث؟"},{"who":"Vautrin","fr":"Tu resterais honnête, et tu mourrais dans la misère.","ar":"ستبقى صادقاً وتموت في الفقر."},{"who":"Rastignac","fr":"Je n’ai pas encore décidé de vendre mon âme.","ar":"لم أقرر بعد أن أبيع روحي."}]},{"title":"les dernières paroles de Goriot","ctx":"le père mourant appelle ses filles dans la chambre de la pension","lines":[{"who":"Goriot","fr":"Où sont mes filles ? Je les veux près de moi.","ar":"أين بناتي؟ أريدهن بجانبي."},{"who":"Christophe","fr":"Elles n’ont pas répondu au message, monsieur.","ar":"لم تجبا على الرسالة يا سيدي."},{"who":"Goriot","fr":"Elles ne viendront pas ; je le sais depuis longtemps.","ar":"لن تأتيا، أعرف ذلك منذ زمن."},{"who":"Le narrateur","fr":"Il pleurait en silence, au milieu de la nuit parisienne.","ar":"كان يبكي بصمت في وسط الليل الباريسي."}]}],"exercises":[{"t":"mcq","skill":"listening","q":"ما الجملة التي تُلخّّص le dévouement du père؟","opts":["Goriot vend ses meubles pour payer les dettes de ses filles.","Goriot refuse de voir ses filles.","Goriot hérite d’une grande fortune.","Goriot élève seul son fils."],"a":0,"why":"le sacrifice financier est le signe visible de son amour paternel."},{"t":"fill","skill":"grammar","q":"أكمل بالزمن المناسب: «La pension ___ ses habitudes quand Rastignac y entra.»","fr":"La pension ... ses habitudes quand Rastignac y entra.","ans":"avait","why":"le plus-que-parfait situe un état antérieur à l’arrivée du héros."},{"t":"mcq","skill":"vocabulary","q":"ما معنى « l’ingratitude » في هذا السياق؟","opts":["الجحود وعدم الاعتراف بالفضل","الطموح الاجتماعي","البخل والشح","التضحية من أجل الأهل"],"a":0,"why":"l’ingratitude qualifie le comportement des filles envers leur père."},{"t":"order","skill":"writing","q":"رتّب: التضحية غوريو من أجل بناته لا حدود لها","words":["Le","sacrifice","de","Goriot","pour","ses","filles","n’a","pas","de","limite."],"ans":"Le sacrifice de Goriot pour ses filles n’a pas de limite.","why":"la structure du nom composé avec « de » + groupe nominal est centrale ici."},{"t":"listen","skill":"listening","q":"أي جملة تصف la Comédie humaine بوصفها مشروع أدبياً؟","opts":["L’histoire oubliée des mœurs.","Un conte philosophique.","Une comédie classique en cinq actes.","Un recueil de poèmes."],"a":0,"why":"Balzac définit son œuvre comme l’histoire sociale et morale de son époque."},{"t":"translate","skill":"writing","q":"ترجم: «كان غوريو يفكر أن بناته ستنساه يوماً ما.»","ans":"Goriot pensait que ses filles l’oublieraient un jour.","why":"le discours indirect libre rend la pensée intérieure sans marqueur explicite."},{"t":"speaking","skill":"speaking","q":"explique en français, en trois phrases, pourquoi le roman est une leçon de réalisme balzacien.","target":"Le roman décrit la société avec précision et montre que l’argent gouverne les cœurs.","why":"la parole mobilise le lexique du réalisme et l’analyse du roman."},{"t":"correct","skill":"grammar","q":"صحّح: «Il avait vendu avant qu’il ne part.»","ans":"Il avait vendu avant de partir.","why":"« avant de » + infinitif exprime l’antériorité sans subjonctif."}],"homework":"استمع إلى la scène de la mort de Goriot ثلاث مرات، اكتب le récit de la scène في ست جمل بالفرنسية مع le passé simple، ثم اشرح في 90 mots pourquoi « l’argent gouverne les cœurs » dans le roman balzacien.","sources":[{"title":"BALZAC 📜 Le Père Goriot (Résumé-analyse du roman illustré et commenté)","channel":"Mediaclasse.fr","videoId":"59bsBUAlWdc","why":"تحليل مدرسي شامل: la pension Vauquer، le dévouement de Goriot، ثم la structure de la Comédie humaine — يمهّد مباشرة لفهم le personnage balzacien et le Paris bourgeois.","cat":"Livres","level":"B2","main":true},{"title":"Le Père Goriot - Honoré de Balzac | Résumé Complet - Analyse - Littérature - Podcast","channel":"VoixLivre","videoId":"nIUndqIMOYc","why":"ملخّص صوتي كامل يشرح les personnages et la progression du roman — مثالي la réécoute.","cat":"Livres","level":"B2","extra":true},{"title":"Le père Goriot : l’amour jusqu’à l’effacement","channel":"Le Podcast Café Classique avec Sam Zaenker","videoId":"BC-mv2BF2JQ","why":"تركيز على le thème du dévouement et de l’ingratitude — يعمّق la lecture psychologique du personnage.","cat":"Livres","level":"B2","extra":true}],"supplements":[{"id":"nIUndqIMOYc","title":"Le Père Goriot - Honoré de Balzac | Résumé Complet - Analyse - Littérature - Podcast","channel":"VoixLivre","why":"ملخّص صوتي كامل يشرح les personnages et la progression du roman — مثالي la réécoute.","lang":"fr","dur":12},{"id":"BC-mv2BF2JQ","title":"Le père Goriot : l’amour jusqu’à l’effacement","channel":"Le Podcast Café Classique avec Sam Zaenker","why":"تركيز على le thème du dévouement et de l’ingratitude — يعمّق la lecture psychologique du personnage.","lang":"fr","dur":16}]},{"id":"b2-t10-l9","fr":"La Princesse de Clèves — Madame de Lafayette","ar":"الأميرة دو كليڤ — مدام دو لافايت","objectives":["analyser la structure du roman: le mariage sans amour, la rencontre, la passion naissante, la retraite au couvent","_acquire 12 كلمة أساسية autour de la cour, la passion, la vertu, le secret, la confidence, le devoir","identifier l’imparfait du subjonctif et les temps du récit classique dans la prose du XVIIe siècle","expliquer pourquoi « La Princesse de Clèves » est considéré comme le premier roman psychologique"],"sections":[{"h":"الدرس 9: تحليل «الأميرة دو كليڤ» — أول رواية نفسية","video":{"id":"_Q5Sy_f9CoM","title":"La Princesse de Clèves (résumé et analyse)","channel":"Quartier Latin","why":"تحليل مدرسي عميق: le cadre de la cour du Grand Siècle، la psychologie de la princesse، la scène de l’avouement — يمهّد مباشرة لفهم la passion refoulée et le style de Lafayette.","lang":"fr","main":true,"dur":21},"p":["« La Princesse de Clèves » (1678), publié anonymement, est attribué à Madame de Lafayette: un court roman placé à la cour d’Henri II (XVIe siècle mais écrit au XVIIe), où la jeune princesse, mariée par devoir, découvre qu’elle aime le duc de Nemours. le récit est bref, concentré, sans aventure: tout se joue dans le cœur de l’héroïne.","le Grand Siècle, c’est-à-dire la cour de Louis XIV, impose deux exigences: l’honnêteté (la culture de l’esprit, la parole polie, la vérité mesurée) et la mesure des passions. la princesse incarne la tension entre la passion qui naît malgré elle et la vertu qui veut la retenir.","المفردات المحورية في هذا الدرس: la cour (البلاط)، la passion (العاطفة المتهورة)، la vertu (الفضيلة)، le secret (السر)، la confidence (الاعتراف بالسر)، le devoir (الواجب)، la retenue (الكبح والتماسك)، le mariage (الزواج المرتّب)، le couvent (الدير)، la solitude (العزلة)، le regard (النظرة)، l’honnêteté (الصدق المتبوع).","نحوياً، la prose de Lafayette utilise l’imparfait du subjonctif (« il eût été », « qu’il fût ») qui appartient au registre soutenu et littéraire, ainsi que le discours indirect (« Elle crut qu’elle l’aimait. ») qui ménage la psychologie: le narrateur n’affirme pas, il observe. la phrase classique est longue, pondérée, équilibrée.","la psychologie du roman repose sur trois scènes maîtresses: la scène du bal masqué (la princesse et l’inconnu dansent), la confidence de la princesse (elle avoue son amour pour protéger son devoir), et l’éclaircissement final où le prince de Nemours découpe les sentiments de la princesse.","خُلاصة الدرس: la princesse se retire au couvent de Pont-aux-Doux, non par dégoût du monde mais par souci de sa propre intégrité — le choix est celui d’une héroïne qui préfère la vérité intérieure au mensonge social. c’est cette primauté du psychologique sur l’extérieur qui fonde le roman moderne."],"sub":[{"h":"la cour et l’honnêteté","p":["« Ne vous fiez pas aux apparences. »","La cour est un monde de masques et de mesures.","L’honnêteté: une culture de la parole vraie et polie."]},{"h":"la passion refoulée","p":["« Elle sentit qu’elle aimait le prince de Nemours. »","La passion naît sans qu’elle le veuille.","Le devoir impose le silence et la retenue."]},{"h":"les temps du récit classique","p":["l’imparfait du subjonctif: « il eût été »","le discours indirect: « Elle crut que… »","la phrase pondérée du Grand Siècle"]}]},{"h":"les phrases clés du roman","p":["« Ne vous fiez pas aux apparences. » — l’avertissement de Madame de Chartres à sa fille: le monde de la cour est un monde de mensonges mesurés.","« Je vais vous faire une confidence. » — la princesse se confie au prince de Nemours pour préserver sa vertu: le secret devient une arme morale.","« On ne peut répondre de soi. » — le constat que la princesse se fait après sa rencontre au bal: le cœur échappe à la volonté.","« Elle se retira au couvent, où elle passa le reste de sa vie. » — la fin du roman: la solitude comme acte de liberté intérieure."]},{"h":"التطبيق والتلخيص","p":["تمرين la réécoute: شغّل la scène de l’avouement بدون sous-titres، ثم اكتب la progression de l’aveu في خمس جمل بالفرنسية مع le discours indirect.","تمرين la comparaison: قارن بين la retenue de la princesse وla passion libre في الرواية الحديثة، مع 60 كلمة بالفرنسية.","اكتب paragraphe de 90 mots: « Pourquoi le couvent est-il pour la princesse une victoire intérieure ? » مع أربع مفردات من الدرس (vertu, secret, passion, solitude)."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: يشرح الدرس «الأميرة دو كليڤ» كأول رواية نفسية: la pudeur تنتصر على la passion، و la confidence قرارٌ أخلاقي لا انسكابٌ عاطفي، و la contrainte الاجتماعية أثقل من le secret. أعد مشاهدة الفيديو الرئيسي وركّز على la scène de la confidence وعلى le conseil de Madame de Chartres.","جسر الدروس: من b2-t10-l8 (الأب غوريو — le monde الذي يُدمر صاحبه) إلى b2-t10-l9 (الأميرة دو كليڤ — la cour du Grand Siècle و la pudeur التي تُخلّص)، ثم إلى b2-t10-l10 حيث «تارتوف» لـ Molière ينقل الصراع من la psychologie إلى la scène comique: l’imposture تُفضح على الخشبة.","مهمة تطبيقية: سجّل ملخّص الرواية في دقيقة، اختر 3 كلمات من الدرس (مثل la pudeur و la contrainte و la confidence)، ثم قارن la confidence في الفيديو بتحليلك: هل هي حوارٌ أم قرارٌ صامت؟"]}],"pron":[{"w":"la passion","ipa":"[la pasjɔ̃]","approx":"لا باسيون"},{"w":"la pudeur","ipa":"[pudyʁ]","approx":"بودور"},{"w":"la contrainte","ipa":"[kɔ̃tʁɛ̃t]","approx":"كنتْرانت"}],"vocab":[{"fr":"la noblesse","ar":"طبقة النبلاء","pos":"nom","g":"f","exFr":"La noblesse du Grand Siècle est un monde de fêtes et de secrets.","exAr":"نبلاء العصر الذهبي عالمٌ من الأفراح والأسرار.","ipa":"[nɔblɛs]"},{"fr":"la passion","ar":"العاطفة المتهورة","pos":"nom","g":"f","exFr":"La passion de la princesse naît malgré elle, sans qu’elle le veuille.","ipa":"[pasjɔ̃]","exAr":"عاطفة الأميرة تولد رغم عنها دون إرادتها."},{"fr":"la vertu","ar":"الفضيلة","pos":"nom","g":"f","exFr":"La vertu de la princesse résiste à l’attrait du monde.","ipa":"[vɛʁty]","exAr":"فضيلة الأميرة تصمد أمام إغراءات العالم."},{"fr":"le secret","ar":"السر","pos":"nom","g":"m","exFr":"Le secret du cœur est au cœur du récit psychologique.","ipa":"[lə səkʁɛ]","exAr":"سر القلب هو محور السرد النفسي."},{"fr":"la confidence","ar":"الاعتراف بالسر","pos":"nom","g":"f","exFr":"La confidence de la princesse est une décision morale.","ipa":"[kɔ̃fidas]","exAr":"اعتراف الأميرة قرارٌ أخلاقي."},{"fr":"la contrainte","ar":"القيد الأخلاقي","pos":"nom","g":"f","exFr":"La contrainte impose à la princesse le silence et la mesure.","exAr":"القيد الأخلاقي يفرض على الأميرة الصمت والاعتدال.","ipa":"[kɔ̃tʁɛ̃t]"},{"fr":"la pudeur","ar":"الحياء المكتوم","pos":"nom","g":"f","exFr":"La pudeur de l’héroïne est la marque du Grand Siècle.","exAr":"حياء البطلة سمة العصر الذهبي.","ipa":"[pudyʁ]"},{"fr":"le mariage","ar":"الزواج المرتّب","pos":"nom","g":"m","exFr":"Le mariage de la princesse fut arrangé sans amour.","ipa":"[mɛʁjaʒ]","exAr":"زواج الأميرة رُتّب دون حب."},{"fr":"le couvent","ar":"الدير","pos":"nom","g":"m","exFr":"La princesse se retira au couvent de Pont-aux-Doux.","ipa":"[lə kuvɑ̃]","exAr":"انسحبت الأميرة إلى دير بون أو دو."},{"fr":"la solitude","ar":"العزلة","pos":"nom","g":"f","exFr":"La solitude du couvent est une victoire sur le mensonge social.","ipa":"[sɔlityd]","exAr":"عزلة الدير انتصار على الكذب الاجتماعي."},{"fr":"le regard","ar":"النظرة","pos":"nom","g":"m","exFr":"Le regard du prince de Nemours trahit son amour.","ipa":"[lə ʁəɡaʁ]","exAr":"نظرة دوق نيمور تفضح حبه."},{"fr":"l’honnêteté","ar":"الصدق المتبوع","pos":"nom","g":"f","exFr":"L’honnêteté est la vertu suprême du siècle de Louis XIV.","ipa":"[ɔ̃nete]","exAr":"الصدق المتبوع فضيلة العصر الذهبي القصوى."}],"examples":[{"fr":"La princesse fut mariée au duc de Clèves sans l’avoir jamais vu.","ar":"زُوِّجت الأميرة بالدوق دون أن تره قط.","note":"le mariage d’arrangement du XVIIe siècle"},{"fr":"Elle sentit qu’elle aimait le prince de Nemours.","ar":"أدركت أنها تُحب دوق نيمور.","note":"le moment de la prise de conscience"},{"fr":"Ne vous fiez pas aux apparences.","ar":"لا تثق بالمظاهر.","note":"le conseil de Madame de Chartres"},{"fr":"On ne peut répondre de soi.","ar":"لا أحد يضمن نفسه.","note":"la leçon de la princesse"},{"fr":"Elle fit une confidence au prince pour rester fidèle à son devoir.","ar":"قامت باعتراف أمام الدوق لتبقى وفيّة بواجبها.","note":"la scène de l’aveu moral"},{"fr":"Elle se retira au couvent, où elle passa le reste de sa vie.","ar":"انسحبت إلى الدير حيث قضت بقية حياتها.","note":"la fin du roman: la solitude choisie"}],"grammar":[{"tFr":"L’imparfait du subjonctif dans la prose classique","tAr":"المضارع التام في حروف التفضيل الأدبية","body":["Lafayette emploie l’imparfait du subjonctif pour ménager la distance du récit: « Il eût été difficile de répondre. » — le mode appartient au registre soutenu et littéraire, il évoque l’hypothèse et la nuance.","règle B2: la formation régulière vient du présent du subjonctif avec la désinence -t (qu’il fût, qu’il eût, qu’il pût); dans la langue d’aujourd’hui, on lui préfère souvent le conditionnel, mais le roman classique le conserve: savoir le reconnaître est essentiel pour lire Lafayette."],"ex":[{"fr":"Il eût été indécent de montrer trop de joie.","ar":"كان من غير اللائق أن تُبدي فرحاً زائداً."},{"fr":"Elle crut qu’il fût plus sage de se taire.","ar":"ظنت أنه أنسب أن تصمت."}]},{"tFr":"Le discours indirect et l’atténuation psychologique","tAr":"السرد غير المباشر والتباعد النفسي","body":["le narrateur observe plus qu’il n’affirme: « Elle crut qu’elle l’aimait. », « Il lui sembla que… » — les verbes croire, sembler, paraître et sentir permettent de ménager le doute et la nuance, signatures du roman psychologique.","règle B2: après « croire », « sembler », « paraître », la proposition subordonnée s’introduit par « que » et se met souvent à l’imparfait du subjonctif ou à l’indicatif selon le degré de certitude — le choix du mode traduit le degré de confidence du narrateur."],"ex":[{"fr":"Elle crut que sa vertu résisterait à la passion.","ar":"ظنت أن فضيلتها ستصمد أمام العاطفة."},{"fr":"Il sembla au prince qu’elle hésitait encore.","ar":"بدا للدوق أنها مترددة بعد."}]}],"mistakes":[{"wrong":"lire le roman comme une simple histoire d’amour","right":"analyser le combat entre passion et devoir","why":"le roman psychologique place la décision morale au centre du récit, non l’aventure."},{"wrong":"confondre l’imparfait du subjonctif et le conditionnel","right":"reconnaître « il eût été », « qu’il fût »","why":"l’imparfait du subjonctif appartient au registre soutenu du Grand Siècle."},{"wrong":"traduire « la cour » par « la place »","right":"dans le roman, la cour désigne le milieu de la noblesse","why":"le monde de la cour est celui des fêtes, des secrets et de l’esprit mesuré."},{"wrong":"écrire « elle a cru que… » à tout moment","right":"employer le temps adapté: « elle crut que… » dans le récit","why":"le récit classique privilégie les temps du passé composé et du passé simple."}],"dialogues":[{"title":"les conseils de Madame de Chartres","ctx":"une mère met en garde sa fille contre le monde de la cour","lines":[{"who":"Madame de Chartres","fr":"Ne vous fiez pas aux apparences, ma fille : la cour est pleine de mensonges.","ar":"لا تثق بالمظاهر يا ابنتي: البلاط ممتلئ بالأكاذيب."},{"who":"La princesse","fr":"Je ne comprends pas encore ce qu’il y a à craindre.","ar":"لم أفهم بعد ما الذي يجب أن أخافه."},{"who":"Madame de Chartres","fr":"La vertu est difficile à garder quand on est jeune et belle.","ar":"الفضيلة يصعب حفظها حين تكونين صغيرة وجميلة."},{"who":"La princesse","fr":"Je vous promets de rester fidèle à mon devoir.","ar":"أعِدُكِ أن أبقى وفيّة بواجبي."}]},{"title":"l’éclaircissement au jardin","ctx":"le prince de Nemours découvre les sentiments de la princesse","lines":[{"who":"Le prince de Nemours","fr":"Madame, vous avez dit que vous aviez une confidence à me faire.","ar":"يا سيدتي، قلتِ إن لديك اعترافاً تودّين إظهاره لي."},{"who":"La princesse","fr":"Je voulais vous demander de ne plus me voir.","ar":"أردتُ أن أطلب منك ألا تراني بعد اليوم."},{"who":"Le prince de Nemours","fr":"Votre cœur est plus vrai que vos paroles.","ar":"قلبك أصدق من كلماتك."},{"who":"La princesse","fr":"La passion ne dispense pas du devoir.","ar":"العاطفة لا تسقط الواجب."}]}],"exercises":[{"t":"mcq","skill":"listening","q":"ما الجملة التي تُلخّّص la leçon de Madame de Chartres؟","opts":["Ne vous fiez pas aux apparences.","La cour est un lieu de fêtes.","Le mariage est toujours heureux.","La passion est toujours coupable."],"a":0,"why":"c’est la phrase d’ouverture qui annonce tout le conflit du roman."},{"t":"fill","skill":"grammar","q":"أكمل بالزمن المناسب: «Elle sentit qu’elle ___ le prince de Nemours.»","fr":"Elle sentit qu’elle ... le prince de Nemours.","ans":"aimait","why":"après « sentit que », le récit classique emploie l’imparfait de l’indicatif."},{"t":"mcq","skill":"vocabulary","q":"ما معنى « la confidence » في هذا السياق؟","opts":["الاعتراف بسر خفي","الزواج التقليدي","الفضيلة","العزلة في الدير"],"a":0,"why":"la confidence est la scène où la princesse avoue son amour pour rester morale."},{"t":"order","skill":"writing","q":"رتّب: لا أحد يضمن نفسه قالتها الأميرة","words":["On","ne","peut","répondre","de","soi,"],"ans":"On ne peut répondre de soi,","why":"la phrase impersonnelle traduit le constat psychologique de la princesse."},{"t":"listen","skill":"listening","q":"أي جملة تعبّر عن la retenue de la princesse؟","opts":["La passion ne dispense pas du devoir.","La cour est un lieu de fêtes.","Le prince est très beau.","Le couvent est sombre."],"a":0,"why":"la retenue morale oppose la passion au devoir, thème central du roman."},{"t":"translate","skill":"writing","q":"ترجم: «ظنت أن فضيلتها ستصمد أمام العاطفة.»","ans":"Elle crut que sa vertu résisterait à la passion.","why":"le discours indirect rend la pensée intérieure avec « croire que »."},{"t":"speaking","skill":"speaking","q":"explique en français, en trois phrases, pourquoi le couvent est une victoire intérieure.","target":"La princesse choisit le couvent pour rester fidèle à elle-même, non par dégoît du monde.","why":"la parole mobilise le lexique de la décision morale du Grand Siècle."},{"t":"correct","skill":"grammar","q":"صحّح: «Il fût difficile de répondre devant la cour.»","ans":"Il eût été difficile de répondre devant la cour.","why":"l’imparfait du subjonctif se forme avec eût été, non le seul subjonctif présent fût."}],"homework":"استمع إلى la scène de l’avouement ثلاث مرات، اكتب la progression de la confidence في خمس جمل بالفرنسية مع le discours indirect، ثم اشرح في 90 mots pourquoi « la passion ne dispense pas du devoir » مع أربع مفردات من الدرس.","sources":[{"title":"La Princesse de Clèves (résumé et analyse)","channel":"Quartier Latin","videoId":"_Q5Sy_f9CoM","why":"تحليل مدرسي عميق: le cadre de la cour du Grand Siècle، la psychologie de la princesse، la scène de l’avouement — يمهّد مباشرة لفهم la passion refoulée et le style de Lafayette.","cat":"Livres","level":"B2","main":true},{"title":"La princesse de Clèves : résumé et analyse - Bac de français","channel":"Amélie Vioux - Bac de français","videoId":"eBXGmkd3KKM","why":"ملخّص مدرسي مكثّف يشرح la structure et les personnages — مثالي la préparation de l’oral.","cat":"Livres","level":"B2","extra":true},{"title":"Grammaire - Mme de La Fayette, La Princesse de Clèves, les adieux de la princesse","channel":"J’peux pas j’ai français","videoId":"D3bvQRgopiQ","why":"تحليل grammatique لمشهد الوداع: les temps littéraires et le style de Lafayette — يدعم التمييز النحوي.","cat":"Livres","level":"B2","extra":true}],"supplements":[{"id":"eBXGmkd3KKM","title":"La princesse de Clèves : résumé et analyse - Bac de français","channel":"Amélie Vioux - Bac de français","why":"ملخّص مدرسي مكثّف يشرح la structure et les personnages — مثالي la préparation de l’oral.","lang":"fr","dur":8},{"id":"D3bvQRgopiQ","title":"Grammaire - Mme de La Fayette, La Princesse de Clèves, les adieux de la princesse","channel":"J’peux pas j’ai français","why":"تحليل grammatique لمشهد الوداع: les temps littéraires et le style de Lafayette — يدعم التمييز النحوي.","lang":"fr","dur":15}]},{"id":"b2-t10-l10","fr":"Tartuffe — Molière","ar":"تارتوف — موليير","objectives":["analyser la structure de la comédie classique: cinq actes, les unités, l’élargissement du dénouement","_acquire 12 كلمة أساسية autour de l’hypocrisie, la dévotion, la césure, la bienséance, le masque","scander l’alexandrin et identifier la césure, la rime et l’enjambement dans le texte moliéresque","expliquer la scène de la table: le comique de situation et l’utilisation de l’interrogation exclamative"],"sections":[{"h":"الدرس 10: تحليل «تارتوف» — الكوميديا الكلاسيكية والنفاق","video":{"id":"_QaJabZwuHI","title":"MOLIÈRE, Tartuffe 📜 Résumé analyse (l’œuvre complète simplifiée et expliquée)","channel":"Mediaclasse.fr","why":"تحليل مشهد بمشهد: les cinq actes، la scène de la table (« Eh bien, faut-il le voir ? »)، ثم le vers alexandrin et la comédie de mœurs — يمهّد مباشرة لفهم l’art comique de Molière.","lang":"fr","main":true,"dur":18},"p":["« Tartuffe ou l’Imposteur » (1664-1669) est une comédie de Molière en cinq actes et en vers alexandrins: Tartuffe, faux dévot, s’installe dans la maison d’Orgon et finit par tenter de la voler et de séduire Elmire. la pièce fut condamnée par le clergé puis interdite par le roi pendant cinq ans — le scandale confirme la puissance du comique de mœurs.","le théâtre classique impose les règles des trois unités (temps: vingt-quatre heures; lieu: le salon d’Orgon; action: une seule intrigue), la bienséance (ne pas choquer le public) et la vraisemblance (que la fable paraisse naturelle). Molière les respecte tout en multipliant les rebondissements comiques.","المفردات المحورية في هذا الدرس: l’hypocrisie (النفاق)، le dévot (الزاهد المتزمت)، la comédie (الكوميديا)، la bienséance (اللياقة)، la césure (الوقفة في البيت الشعري)، l’alexandrin (البيت ذو إحدى عشرة مقطع)، le masque (القناع)، l’orgueil (الكبرياء)، l’intérêt (المصلحة)، le chantage (الابتزاز)، la loi (القانون)، le remords (الندم).","نحوياً، le vers alexandrin est le vers noble du théâtre classique: douze syllabes coupées en deux par la césure après la sixième syllabe (« Ah! cachons ce sein | que je ne saurais voir. »). la rime embrassée ou croisée soutient la tirade, et l’enjambement (un vers qui se termine au milieu d’une phrase) donne la respiration de la parole comique.","la scène de la table (acte IV, scène 4) est le sommet du comique de situation: Elmire oblige Orgon à se cacher sous la table pour écouter la confession de Tartuffe. les répliques courtes, les questions exclamatives (« Eh bien, faut-il le voir ? Eh bien, faut-il le croire ? ») construisent un rythme haletant qui inverse les rôles de l’aveugle et du voyant.","خُلاصة الدرس: la comédie de mœurs vise la société, pas la nature humaine en général: Molière attaque l’hypocrisie dévote, l’orgueil paternel (Orgon) et l’intérêt de l’argent. la morale de Cléante distingue le faux dévot du vrai croyant — le comique devient alors une critique morale de la cour de Louis XIV."],"sub":[{"h":"l’hypocrisie en scène","p":["Tartuffe joue le dévot pour gouverner la maison.","Orgon est l’aveugle volontaire qui refuse de voir.","La vérité triomphe par le piège d’Elmire."]},{"h":"le vers alexandrin","p":["l’alexandrin: douze syllabes par vers.","la césure après la sixième syllabe.","« Eh bien, faut-il le voir ? | Eh bien, faut-il le croire ? »"]},{"h":"la comédie de mœurs","p":["les trois unités: temps, lieu, action.","la bienséance: ne pas choquer le public.","la satire morale contre l’hypocrisie"]}]},{"h":"les phrases clés de la pièce","p":["« Eh bien, faut-il le voir ? Eh bien, faut-il le croire ? » — Elmire retourne le piège: l’aveugle Orgon voit enfin la vérité.","« Ah! cachons ce sein que je ne saurais voir. » — Orgon, aveuglé, ordonne à sa fille de se cacher: comique de quiproquo et de situation.","« Ne confondez point, je vous prie, avec le céleste feu l’ardente chaleur. » — la leçon de Cléante: la vraie piété n’est pas le zèle officieux.","« L’habit ne fait pas le moine. » — le proverbe de Madame Pernelle résume la critique moliéresque de l’apparence."]},{"h":"التطبيق والتلخيص","p":["تمرين la réécoute: شغّل la scène de la table بدون sous-titres، ثم اكتب le rythme des répliques في خمسة أسطر بالفرنسية مع les questions exclamatives.","تمرين la scansion: اضبط البيت «Eh bien, faut-il le voir ? Eh bien, faut-il le croire ?» بالقسم إلى عشرتين وحدّد la césure.","اكتب paragraphe de 90 mots: « Selon Molière, l’hypocrisie est-elle plus dangereuse que l’orgueil ? » مع أربع مفردات من الدرس (masque, bienséance, alexandrin, satire)."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: يفكّك الدرس «تارتوف» ككوميديا كلاسيكية: l’imposture تنطلق من la bienséance المسرحية، و le décasyllabe و la césure يضبطان الإيقاع، و la chute d’Orgon تكشف la leçon de la pièce. أعد مشاهدة الفيديو الرئيسي وركّز على la scène de la révocation وعلى la chute finale.","جسر الدروس: من b2-t10-l9 (الأميرة دو كليڤ — la confidence et le secret dans la psychologie) إلى b2-t10-l10 (تارتوف — l’imposture تُروى على الخشبة بالضحك)، ثم إلى b2-t10-l11 حيث «سيرانو دي برجراك» لـ Rostand يعيد البناء الشعري للمسرح: la harangue et le panache يحلّان محل la comédie des mœurs.","مهمة تطبيقية: سجّل ملخّص المسرحية في دقيقة، استعمل 3 كلمات من الدرس (مثل l’imposture و le décasyllabe و le masque)، ثم قارن la scène du démasque في الفيديو بإيقاع le décasyllabe: أين تُسمَّع الوقفة؟"]}],"pron":[{"w":"l’imposture","ipa":"[ɛ̃pɔstysʁ]","approx":"انپوستور"},{"w":"la césure","ipa":"[la sezyʁ]","approx":"لا سوزير"},{"w":"le dévot","ipa":"[lə devo]","approx":"ل دُڤو"}],"vocab":[{"fr":"l’imposture","ar":"النفاق والتزيّي","pos":"nom","g":"f","exFr":"L’imposture de Tartuffe se cache derrière le masque.","exAr":"نفاق تارتوف يختفي خلف القناع.","ipa":"[ɛ̃pɔstysʁ]"},{"fr":"le dévot","ar":"الزاهد المتزمت","pos":"nom","g":"m","exFr":"Tartuffe joue le dévot pour gouverner la maison d’Orgon.","ipa":"[lə devo]","exAr":"يلعب تارتوف دور الزاهد ليسيطر على بيت أورغون."},{"fr":"la comédie","ar":"الكوميديا","pos":"nom","g":"f","exFr":"La comédie de Molière corrige les mœurs par le rire.","ipa":"[kɔmedi]","exAr":"كوميديا موليير تُصلح الأخلاق بالضحك."},{"fr":"la bienséance","ar":"اللياقة الاجتماعية","pos":"nom","g":"f","exFr":"La bienséance interdit de montrer certaines scènes sur scène.","ipa":"[bjɛ̃sezɑ̃s]","exAr":"اللياقة تمنع إظهار بعض المشاهد على الخشبة."},{"fr":"la césure","ar":"الوقفة في البيت الشعري","pos":"nom","g":"f","exFr":"La césure coupe l’alexandrin en deux moitiés égales.","ipa":"[sezyʁ]","exAr":"الوقفة تقطع البيت الشعري إلى نصفين متساويين."},{"fr":"le décasyllabe","ar":"السطر ذو عشرة مقاطع","pos":"nom","g":"m","exFr":"Le décasyllabe ponctue certaines répliques comiques.","exAr":"السطر ذو عشرة مقاطع ينقّع بعض الردود الكوميدية.","ipa":"[dekasilab]"},{"fr":"le masque","ar":"القناع","pos":"nom","g":"m","exFr":"Le masque du faux dévot tombe dans la scène de la table.","ipa":"[lə mask]","exAr":"قناع الزاهد المزيف يسقط في مشهد الطاولة."},{"fr":"l’orgueil","ar":"الكبرياء والغرور","pos":"nom","g":"m","exFr":"L’orgueil d’Orgon le rend aveugle devant la vérité.","ipa":"[lɔʁɡœj]","exAr":"كبرياء أورغون يجعله أعمى أمام الحقيقة."},{"fr":"l’intérêt","ar":"المصلحة المادية","pos":"nom","g":"m","exFr":"L’intérêt guide les projets de Tartuffe contre la famille.","ipa":"[lɛtɛʁɛ]","exAr":"المصلحة توجّم خطط تارتوف ضد العائلة."},{"fr":"le chantage","ar":"الابتزاز","pos":"nom","g":"m","exFr":"Le chantage de Tartuffe le transforme en maître de la maison.","ipa":"[lə ʃɑ̃taʒ]","exAr":"ابتزاز تارتوف يحوّله إلى سيد البيت."},{"fr":"la loi","ar":"القانون والشرع","pos":"nom","g":"f","exFr":"La loi du roi finit par protéger la famille contre l’imposteur.","ipa":"[la lwa]","exAr":"قانون الملك يحمي العائلة في النهاية من المحتال."},{"fr":"le remords","ar":"الندم","pos":"nom","g":"m","exFr":"Le remords d’Orgon naît quand il découvre la tromperie.","ipa":"[lə ʁəmɔʁ]","exAr":"ندم أورغون يولد حين يكتشف الخداع."}],"examples":[{"fr":"Eh bien, faut-il le voir ? Eh bien, faut-il le croire ?","ar":"أفكشف له؟ أفصدّق ما يقول؟","note":"l’interrogation exclamative d’Elmire"},{"fr":"Ah! cachons ce sein que je ne saurais voir.","ar":"آه! أخفِي هذا الصدر عني!","note":"le comique de quiproquo et l’aveuglement d’Orgon"},{"fr":"Ne confondez point, je vous prie, avec le céleste feu l’ardente chaleur.","ar":"لا تخلطوا بين النار السماوية والحرارة المفرطة.","note":"la leçon de Cléante sur la vraie piété"},{"fr":"L’habit ne fait pas le moine.","ar":"الرداء لا يصنع الراهب.","note":"le proverbe de Madame Pernelle"},{"fr":"Orgon est aveuglé par l’hypocrisie de Tartuffe.","ar":"أصبح أورغون أعمى بسبب نفاق تارتوف.","note":"le personnage du dupe"},{"fr":"La pièce fut interdite pendant cinq ans avant d’être acceptée.","ar":"مُنعت المسرحية خمس سنوات قبل أن تُقبل.","note":"le scandale historique de 1664"}],"grammar":[{"tFr":"Le vers alexandrin: douze syllabes, césure, rime, enjambement","tAr":"البيت ذو إحدى عشرة مقطع: الوقفة، القافية، والتجاوز","body":["l’alexandrin compte douze syllabes, coupées par une césure après la sixième: « Eh bien, faut-il le voir ? | Eh bien, faut-il le croire ? » — la rime (croisée, embrassée ou plate) soutient la tirade, et l’enjambement fait déborder le sens d’un vers sur l’autre pour imiter le naturel de la parole.","règle B2: pour scander, comptez les voyelles: le e muet devant consonne s’ajoute au compte (« je ne » fait deux syllabes pleines), il disparaît devant voyelle et à la fin du vers. la diérèse (deux syllabes) et la synérèse (une seule) expliquent les apparentes irrégularités du vers théâtral."],"ex":[{"fr":"Que de choses en un mot peuvent m’embarrasser !","ar":"كم من شيء في كلمة واحدة قد يحرجني!","note":"un alexandrin à la césure régulière"},{"fr":"Eh bien, faut-il le voir ? | Eh bien, faut-il le croire ?","ar":"أفكشف له؟ أفصدّق ما يقول؟","note":"la césure après la sixième syllabe"}]},{"tFr":"L’interrogation et l’exclamation dans la comédie","tAr":"الاستفهام والتعجب في الكوميديا","body":["Molière utilise trois formes d’interrogation: l’inversion du sujet (« Faut-il le voir ? »), la question avec « est-ce que », et la négation exclamative « ne…que ». la question exclamative (« Eh bien, faut-il le voir ? Eh bien, faut-il le croire ? ») sert le comique: elle presse l’aveugle de voir la vérité.","règle B2: l’inversion sans sujet (« Faut-il… ? », « Que vois-je ? ») appartient au registre soutenu et théâtral; l’exclamation avec « que » + indicatif ou subjonctif (« Que d’aise ! », « Que voilà de beaux discours ! ») exprime l’ironie: le personnage dit plus qu’il ne croit dire."],"ex":[{"fr":"Eh bien, faut-il le voir ? Eh bien, faut-il le croire ?","ar":"أفكشف له؟ أفصدّق ما يقول؟","note":"l’interrogation pressante d’Elmire"},{"fr":"Que vois-je ? Que d’aise en mon cœur !","ar":"ماذا أرى؟ كم من بهجة في قلبي!","note":"l’exclamation ironique de l’hypocrite"}]}],"mistakes":[{"wrong":"lire Tartuffe comme une attaque de la religion","right":"analyser la comédie de mœurs contre l’hypocrisie","why":"Molière distingue le vrai dévot du faux dévot: la cible est le mensonge, pas la piété."},{"wrong":"confondre la bienséance et la morale","right":"la bienséance est une règle de théâtre, la morale un jugement","why":"la bienséance interdit de choquer le public; la critique morale vise les mœurs de la cour."},{"wrong":"scander l’alexandrin sans repérer la césure","right":"placer la césure après la sixième syllabe","why":"la césure est le rythme de la tirade classique: sans elle, le vers perd son équilibre."},{"wrong":"traduire « le dévot » par « le saint »","right":"le dévot est ici un zélé officieux, souvent hypocrite","why":"le lexique moliéresque oppose l’apparence de piété à la vraie vertu de Cléante."}],"dialogues":[{"title":"le piège d’Elmire","ctx":"Elmire persuade Orgon de se cacher sous la table pour écouter Tartuffe","lines":[{"who":"Elmire","fr":"Eh bien, faut-il le voir ? Eh bien, faut-il le croire ?","ar":"أفكشف له؟ أفصدّق ما يقول؟"},{"who":"Orgon","fr":"Oui, oui, il faut le voir, et voir jusqu’au fond.","ar":"نعم، لا بد أن أرى وأن أرى إلى العمق."},{"who":"Elmire","fr":"Faites-moi donc le plaisir de sortir d’ici.","ar":"افضُل أن تخرج من هنا الآن."},{"who":"Orgon","fr":"Je vais me placer sous la table, et j’écouterai tout.","ar":"سأختبئ تحت الطاولة وأنصت إلى كل شيء."}]},{"title":"la leçon de Cléante","ctx":"Cléante, beau-frère d’Orgon, explique la différence entre le faux et le vrai dévot","lines":[{"who":"Cléante","fr":"Ne confondez point, je vous prie, avec le céleste feu l’ardente chaleur.","ar":"لا تخلطوا بين النار السماوية والحرارة المفرطة."},{"who":"Orgon","fr":"Mais le monde est plein de ces faux dévots.","ar":"لكن العالم مليء بهذا النوع من الكذابين المتزمتين."},{"who":"Cléante","fr":"L’habit ne fait pas le moine, et la vertu se connaît aux œuvres.","ar":"الرداء لا يصنع الراهب، والفضيلة تُعرف بالأفعال."},{"who":"Orgon","fr":"Vous avez raison : j’étais l’aveugle du spectacle.","ar":"أنت محق: كنت الأعمى في هذه المسرحية."}]}],"exercises":[{"t":"mcq","skill":"listening","q":"ما الجملة التي تُلخّّص leçon Cléante عن التدين الصادق؟","opts":["L’habit ne fait pas le moine.","Il faut toujours prier.","Le théâtre est interdit.","La famille doit obéir."],"a":0,"why":"le proverbe oppose l’apparence à la vraie piété, thème central de la pièce."},{"t":"fill","skill":"grammar","q":"أكمل البيت الشعري: «Ah! cachons ce sein que je ne ___!»","fr":"Ah! cachons ce sein que je ne ... !","ans":"saurais","why":"le verbe savoir au conditionnel forme l’alexandrin classique de Molière."},{"t":"mcq","skill":"vocabulary","q":"ما معنى « l’hypocrisie » في المسرحية؟","opts":["التصنع والنفاق خلف قناع التدين","العصيان على القانون","الرغبة في الزواج","السفر إلى الخارج"],"a":0,"why":"l’hypocrisie est le masque que Tartuffe porte pour duper Orgon."},{"t":"order","skill":"writing","q":"رتّب: أفيكشف له أفيصدّقه قالت إلمير","words":["Eh","bien,","faut-il","le","voir ?","Eh","bien,","faut-il","le","croire ?"],"ans":"Eh bien, faut-il le voir ? Eh bien, faut-il le croire ?","why":"l’inversion et la question exclamative construisent le rythme de la scène du piège."},{"t":"listen","skill":"listening","q":"أي جملة تُظهر l’interrogation exclamative dans la pièce؟","opts":["Eh bien, faut-il le voir ?","L’habit ne fait pas le moine.","La loi protège la famille.","Il faut cultiver le jardin."],"a":0,"why":"la question exclamative presse l’aveugle de voir: elle sert le comique de situation."},{"t":"translate","skill":"writing","q":"ترجم: «لا تخلطوا بين النار السماوية والحرارة المفرطة.»","ans":"Ne confondez point, je vous prie, avec le céleste feu l’ardente chaleur.","why":"la phrase de Cléante emploie la négation « ne…point » du registre soutenu."},{"t":"speaking","skill":"speaking","q":"explique en français, en trois phrases, pourquoi Tartuffe est un hypocrite.","target":"Tartuffe joue le dévot pour duper Orgon, puis il tente de séduire Elmire et de voler la maison.","why":"la parole mobilise le lexique du masque et de l’imposture théâtrale."},{"t":"correct","skill":"grammar","q":"صحّح: «Cachons ce sein que je ne saurait voir!»","ans":"Cachez ce sein que je ne saurais voir !","why":"l’impératif de la deuxième personne du pluriel est « cachez », non « cachons »."}],"homework":"استمع إلى la scène de la table ثلاث مرات بدون sous-titres، اضبط البيت «Eh bien, faut-il le voir ? Eh bien, faut-il le croire ?» مع تحديد la césure، ثم اكتب paragraphe de 90 mots: « Pourquoi la comédie de mœurs est-elle une arme morale ? » مع أربع مفردات من الدرس.","sources":[{"title":"MOLIÈRE, Tartuffe 📜 Résumé analyse (l’œuvre complète simplifiée et expliquée)","channel":"Mediaclasse.fr","videoId":"_QaJabZwuHI","why":"تحليل مشهد بمشهد: les cinq actes، la scène de la table (« Eh bien, faut-il le voir ? »)، ثم le vers alexandrin et la comédie de mœurs — يمهّد مباشرة لفهم l’art comique de Molière.","cat":"Livres","level":"B2","main":true},{"title":"Tartuffe de Molière Analyse","channel":"Gloria Lauzanne Cours de français","videoId":"faVICKu3XA0","why":"تحليل شخصيات ومحاور المسرحية: Tartuffe, Orgon, Elmire — يعمّق la lecture dramatique.","cat":"Livres","level":"B2","extra":true},{"title":"Le Tartuffe - Molière : Résumé en 10 minutes scène par scène","channel":"TéléCrayon","videoId":"QRzlIhPumH8","why":"مشهد بمشهد مع le lexique du théâtre — مثالي la réécoute و la préparation de l’oral.","cat":"Livres","level":"B2","extra":true}],"supplements":[{"id":"faVICKu3XA0","title":"Tartuffe de Molière Analyse","channel":"Gloria Lauzanne Cours de français","why":"تحليل شخصيات ومحاور المسرحية: Tartuffe, Orgon, Elmire — يعمّق la lecture dramatique.","lang":"fr","dur":16},{"id":"QRzlIhPumH8","title":"Le Tartuffe - Molière : Résumé en 10 minutes scène par scène","channel":"TéléCrayon","why":"مشهد بمشهد مع le lexique du théâtre — مثالي la réécoute و la préparation de l’oral.","lang":"fr","dur":11}]},{"id":"b2-t10-l11","fr":"Cyrano de Bergerac — Edmond Rostand","ar":"سيرانو دي برجراك — إدموند روسوان","objectives":["تحليل la versification de l’alexandrin (douze syllabes, la césure, les rimes plates) في la tirade du nez et l’envoi","تمييز les temps du récit: l’imparfait du décor et le passé simple de l’événement عند إعادة سرد l’intrigue par quatre actes","_acquire 12 كلمة أساسية حول la tirade, l’alexandrin, le nez, le panache, la dupe, le sacrifice","تفسير la leçon finale « Et mon panache ! »: l’honneur du marginal qui préfère l’esprit aux convenances"],"sections":[{"h":"الدرس 11: تحليل «سيرانو دي برجراك» — المسرحية المنظومة والحب المخلص","video":{"id":"XmSLeAtznNY","title":"Cyrano de Bergerac : Analyse complète pour le bac de français (Edmond Rostand)","channel":"La Littérature Expliquée","why":"تحليل مدرسي شامل لـ la pièce: le drame héroïcomique، les cinq actes، la tirade du nez، la lettre et l’envoi — يمهّد مباشرة لدراسة l’alexandrin et l’amour dévoué de Cyrano.","lang":"fr","main":true,"dur":13},"p":["«Cyrano de Bergerac» (1897) مسرحية كوميدية-بطولية من خمسة فصول ومنضودة في le vers: يستعيد Rostand المسرح الشعري في زمن تسيطر فيه la prose على الخشبة. تدور الأحداث في باريس سنة 1640 أثناء حرب الثلاثين عاماً: Cyrano، نبيل غاسكوني فقير ورئيس فصيلة، مهووس بـ les duels وشاعر عبقري، لكن أنفه الضخم يمنعه من إملاء أمله في حبّ Roxane.","المفردات المحورية: la tirade (خطبة طويلة لشخصية على المسرح)، l’alexandrin (سطر شعري من اثنتي عشرة مقطعاً)، le nez (الأنف كعائق في الحب)، le panache (الهيبة والشجاعة)، la dupe (المخدوع)، le sacrifice، la césure (الوقفة في وسط السطر)، le vers (السطر الشعري)، l’envoi (آخر مقاطع المسرحية)، le duel، l’esprit (الذكاء اللفظي)، la fidélité.","الصراع هنا ذو مستوىين: خارجي — يواجه Cyrano الغاسكونيين وLe Vicomte de Valvert ومئة وخمسين عدواً في الليل — وداخلي — يعتقد أن Roxane لا تستطيع أبداً أن تحبّ رجلاً أنفه قبيح. يصبح Christian، الجميل لكنه عديم الرواية، وسيطاً بينهما: يكتب Cyrano رسائل الحب ويُلقيها Christian — la dupe تتحول إلى تعاون شعري.","يخدم l’alexandrin عند Rostand ثلاثة أغراض: الغرض comique (la tirade du nez بريمة «-as»)، الغرض pathétique (la lettre sous le balcon)، ثم الغرض sublime (l’envoi). la césure تقطع السطر إلى deux hémistiches، والتراكم الريتمي للصوت يمنح كلام Cyrano إيقاع المبارزة اللفظية.","بعد الدرس، أعد الاستماع إلى la tirade du nez بدون sous-titres، ثم استخرج le motif du nez: عائق جسدي، رمز للنفي الاجتماعي، وأخيراً دليل على أن l’esprit ينتصر على القبح — هذا هو جوهر le drame héroïcomique.","خُلاصة الدرس: يموت Cyrano كبطل نفسه: تفهم Roxane أخيراً أن الشعر كان منه، وتشتقّ آخر كلمته — « Et mon panache ! » — حياة كاملة يشترك فيها l’honneur وla poésie وl’amour في معركة واحدة."],"sub":[{"h":"le vers et le cœur","p":["« Trop fier pour laisser voir à quel point je suis malheureux. »","« Les vers, c’est moi ! »","« Et mon panache ! »"]},{"h":"l’alexandrin et la césure","p":["l’alexandrin compte douze syllabes.","La césure coupe le vers en deux hémistiches.","Rostand fait du vers un instrument de comédie et de duel."]},{"h":"le vocabulaire de la tirade","p":["la tirade — une longue réplique d’un personnage","le nez — l’obstacle physique de l’amour","l’envoi — les derniers vers d’une œuvre"]}]},{"h":"les phrases clés de la pièce","p":["« Trop fier pour laisser voir à quel point je suis malheureux. » — Acte I: le masque du fier-à-bras cache le poète blessé par le regard des autres.","« Les vers, c’est moi ! » — Acte III: sous le balcon, l’auteur se révèle; la parole poétique devient aveu d’amour.","« Et mon panache ! » — dernière réplique: le héros emporte avec lui son honneur, son style et sa liberté.","« Il faut, pour être aimé, n’être pas ridicule. » — le tragique du personnage: le nez le transforme aux yeux du monde en figure comique."]},{"h":"التطبيق والتلخيص","p":["تمرين la réécoute: شغّل la tirade du nez sans sous-titres ثم اكتب quatre mots-clés تصف فيها la stratégie de Cyrano (provoquer, rimer, vaincre par l’esprit).","تمرين l’analyse du vers: انسخ deux alexandrins de l’envoi وحدّد la césure dans chacun (deux hémistiches égaux).","اكتب paragraphe de 90 mots بالفرنسية تشرح فيه لماذا « le nez » est un symbole plus qu’un détail physique — مع 4 مفردات من la leçon."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: تعرض المسرحية «سيرانو دي برجراك» مزيجاً كوميدياً وملحمياً: la harangue عن الأنف تفتح الرحى، و le panache شعار البطل، و la loyauté de Roxane تحفظ الحبّ حتى النهاية. أعد مشاهدة الفيديو الرئيسي وركّز على la scène du duel وعلى l’envoi final.","جسر الدروس: من b2-t10-l10 (تارتوف — الكوميديا تفضح l’imposture بالضحك) إلى b2-t10-l11 (سيرانو — la Comédie تذوب في le sublime et l’esprit)، ثم إلى b2-t10-l12 حيث «بيل-أامي» لـ Maupassant ينقل le conflit من الخشبة إلى le journalisme et l’ascension sociale في باريس القرن التاسع عشر.","مهمة تطبيقية: سجّل ملخّص المسرحية في دقيقة، استعمل 3 كلمات من الدرس (مثل la harangue و l’escarmouche و l’abnégation)، ثم قارن la scène de l’envoi في الفيديو بوصفك: ما الذي يجعل نهاية سيرانو « sublime »؟"]}],"pron":[{"w":"l’octosyllabe","ipa":"[ɔktɔsilab]","approx":"أوكتوسيلاب"},{"w":"la coupure","ipa":"[kupyʁ]","approx":"كوپور"},{"w":"le panache","ipa":"[panaʃ]","approx":"باناش"}],"vocab":[{"fr":"la harangue","ar":"الخطبة الطويلة","pos":"nom","g":"f","exFr":"La harangue du nez occupe tout le premier acte.","exAr":"خطبة الأنف تشغل الفعل الأول كاملاً.","ipa":"[aʁɑ̃ɡ]"},{"fr":"l’octosyllabe","ar":"السطر ذو ثمانية مقاطع","pos":"nom","g":"m","exFr":"L’octosyllabe rythme les répliques les plus vives.","exAr":"السطر ذو ثمانية مقاطع ييقظ أسرع الردود.","ipa":"[ɔktɔsilab]"},{"fr":"la coupure","ar":"الوقيفة في وسط السطر","pos":"nom","g":"f","exFr":"La coupure sépare les deux hémistiches du vers.","exAr":"الوقيفة تفصل نصفي السطر الشعري.","ipa":"[kupyʁ]"},{"fr":"la mesure","ar":"المقطع الشعري","pos":"nom","g":"f","exFr":"Chaque réplique de Cyrano respire la mesure.","exAr":"كل ردّ عند سيرانو يتنفّس المقطع الشعري.","ipa":"[məzyʁ]"},{"fr":"le nez","ar":"الأنف","pos":"nom","g":"m","exFr":"Son nez démesuré est le motif de son malheur.","ipa":"[ne]","exAr":"أنفه الضخم هو سبب تعاسته."},{"fr":"le panache","ar":"الهيبة والشجاعة الفاخرة","pos":"nom","g":"m","exFr":"Son panache, c’est son courage de rester lui-même.","ipa":"[panaʃ]","exAr":"هيبته هي شجاعته في البقاء على طبيعته."},{"fr":"l’amour dévoué","ar":"الحب المخلص","pos":"loc.","g":"m","exFr":"Son amour dévoué pour Roxane le pousse à écrire les lettres.","ipa":"","exAr":"حبه المخلص لروكسان يدفعه لكتابة الرسائل."},{"fr":"la dupe","ar":"المخدوع","pos":"nom","g":"f","exFr":"Christian devient la dupe de la poésie de Cyrano.","ipa":"[dy p]","exAr":"يصبح كريستيان مخدوعاً بشعر سيرانو."},{"fr":"l’abnégation","ar":"إنكار الذات","pos":"nom","g":"f","exFr":"L’abnégation de Cyrano reste le geste le plus noble.","exAr":"إنكار ذات سيرانو يبقى أسمى تصرفاته.","ipa":"[abnegasjɔ̃]"},{"fr":"la loyauté","ar":"الوفاء","pos":"nom","g":"f","exFr":"La loyauté de Roxane attend vingt ans.","exAr":"وفاء روكسان ينتظر عشرين عاماً.","ipa":"[lwajote]"},{"fr":"l’escarmouche","ar":"المناوشة","pos":"nom","g":"f","exFr":"L’escarmouche des mots précède le combat à l’épée.","exAr":"المناوشة اللفظية تسبق القتال بالسيف.","ipa":"[ɛskarmuʃ]"},{"fr":"l’esprit","ar":"الذكاء اللفظي","pos":"nom","g":"m","exFr":"Cyrano vainc ses ennemis par l’esprit, pas par l’épée.","ipa":"[ɛspʁi]","exAr":"ينتصر سيرانو على أعدائه بالذكاء لا بالسيف."}],"examples":[{"fr":"Cyrano est trop fier pour montrer son chagrin.","ar":"سيرانو فخور جداً لدرجة أنه لا يُظهر حزنه.","note":"la fierté du personnage"},{"fr":"Rostand écrit la pièce en alexandrins.","ar":"يكتب روسوان المسرحية بسطور من اثنتي عشرة مقطعاً.","note":"la versification"},{"fr":"La césure coupe le vers en deux hémistiches.","ar":"الوقفة تقطع السطر إلى نصفَي شعر.","note":"la structure du vers"},{"fr":"Cyrano écrit les lettres que Christian prononce.","ar":"يكتب سيرانو الرسائل التي يلقيها كريستيان.","note":"la dupe poétique"},{"fr":"La tirade du nez transforme le défaut en comédie.","ar":"خطبة الأنف تحوّل العيب إلى مادة كوميدية.","note":"l’effet comique"},{"fr":"« Et mon panache ! » résume l’honneur du héros.","ar":"عبارة «وهيبتي!» تلخّص شرف البطل.","note":"la leçon finale"}],"grammar":[{"tFr":"Le présent de l’indicatif pour l’action et le passé simple pour le résumé","tAr":"المضارع للفعل الحيّ على الخشبة والماضي البسيط لإعادة السرد","body":["quand on raconte une pièce, on utilise le présent pour l’action scénique: « Cyrano provoque Valvert, il rime, il gagne. »; le passé simple sert au résumé de l’intrigue: « Rostand publia la pièce en 1897, elle eut un succès immédiat. »","règle B2: dans une analyse littéraire, le présent (ou le présent de l’indicatif) domine — c’est le « présent de l’exposition »; on passe au passé simple seulement pour situer l’auteur et la date de création."],"ex":[{"fr":"Cyrano duel contre cent cinquante ennemis et il triomphe par son esprit.","ar":"يبارز سيرانو مئة وخمسين عدواً وينتصر بذكائه."},{"fr":"Rostand fit revivre le théâtre en vers à la fin du XIXe siècle.","ar":"أعاد روسوان إحياء المسرح المنظوم في أواخر القرن التاسع عشر."}]},{"tFr":"La relative avec « dont » pour présenter un personnage","tAr":"الجملة الاسمية الموصولة بـ «dont» لتقديم الشخصية","body":["« dont » remplace le complément introduit par « de »: « Cyrano, dont le nez est démesuré, est un poète de génie. » — la relative ajoute une information caractéristique sans casser le rythme de la phrase.","dans une dissertation littéraire, « dont » est plus élégant que « de qui » ou « duquel » quand on décrit un personnage: « Rostand, dont l’écriture mêle comique et pathétique… »"],"ex":[{"fr":"Cyrano, dont la plume vaut mieux que l’épée, écrit les lettres à Roxane.","ar":"سيرانو، الذي تفوق قلمته سيفه، يكتب الرسائل لروكسان."},{"fr":"Christian, dont le courage est physique, meurt au combat.","ar":"كريستيان، الذي تكمن شجاعته في جسده، يموت في القتال."}]}],"mistakes":[{"wrong":"appeler la tirade du nez « une histoire de nez »","right":"analyser la tirade comme un motif poétique et comique","why":"le nez est le symbole de l’exclusion et l’occasion de vaincre par l’esprit."},{"wrong":"dire que l’alexandrin a dix syllabes","right":"l’alexandrin a douze syllabes coupées par une césure","why":"dix syllabes = le décasyllabe; douze = l’alexandrin de Rostand."},{"wrong":"confondre l’auteur des vers et l’interprète (« Christian écrit les vers »)","right":"Cyrano écrit, Christian prononce","why":"la dupe fait de Christian le déclamateur, pas le poète."},{"wrong":"dire « si tu écrirais des vers, elle t’aimerait »","right":"si tu écrivais des vers, elle t’aimerait","why":"après « si », jamais de conditionnel: on emploie l’imparfait de l’indicatif."}],"dialogues":[{"title":"la tirade du nez","ctx":"Acte I: le Vicomte de Valvert insulte Cyrano devant le public du théâtre de l’Hôtel de Bourgogne.","lines":[{"who":"Le vicomte","fr":"Votre nez est… votre nez est très grand.","ar":"أنفك… أنفك كبير جداً."},{"who":"Cyrano","fr":"Est-ce tout ? Non, jeune homme, c’est trop peu dire : c’est long, c’est large, c’est carré…","ar":"هل هذا كل شيء؟ لا يا الشاب، بل هو أطول من ذلك: طويل، عريض، مربّع…"},{"who":"Le public","fr":"Il rime ! Il gagne le duel des mots !","ar":"يوزن الشعر! وقد فاز بالمبارزة اللفظية!"},{"who":"Cyrano","fr":"Trop fier pour laisser voir à quel point je suis malheureux.","ar":"فخور جداً لأُظهر كم أنا تعيس."}]},{"title":"l’aveu sous le balcon","ctx":"Acte III: Cyrano fait entendre à Roxane les vers qu’il écrit pour Christian.","lines":[{"who":"Roxane","fr":"C’est lui qui parle, mais les vers semblent venir de plus loin.","ar":"هو الذي يتكلم، لكن الشعر يبدو وكأنه يأتي من أبعد."},{"who":"Cyrano","fr":"Les vers, c’est moi ! — dit-il bas pour lui-même.","ar":"الشعر أنا! — يقولها لنفسه بصوت خافت."},{"who":"Christian","fr":"Mon âme est un diamant que ta beauté a poli.","ar":"روحي جوهرة صقلتها جمالكِ."},{"who":"Roxane","fr":"Je n’ai jamais aimé que vous, depuis le jour du duel en vers.","ar":"لم أحب قبلك يوماً، منذ يوم المبارزة بالشعر."}]}],"exercises":[{"t":"mcq","skill":"listening","q":"ما الجملة التي تلخّص شرف سيرانو؟","opts":["Et mon panache !","Je suis très riche.","Le nez n’est rien.","Roxane n’aime personne."],"a":0,"why":"« Et mon panache! » هي الكلمة الأخيرة التي تختصر حياة البطل الشرف."},{"t":"fill","skill":"grammar","q":"أكمل بالفعل المناسب في زمن السرد: «Rostand ___ la pièce en 1897.»","fr":"Rostand ... la pièce en 1897.","ans":"publia","why":"le passé simple situe l’événement littéraire daté."},{"t":"mcq","skill":"vocabulary","q":"ما معنى la tirade في المسرحية؟","opts":["une longue réplique d’un personnage","un court dialogue","une chanson","une scène de danse"],"a":0,"why":"la tirade est une réplique longue, ici la tirade du nez."},{"t":"order","skill":"writing","q":"رتّب: الوقفة تفصل السطر إلى نصفَي شعر","words":["La","césure","coupe","le","vers","en","deux","hémistiches."],"ans":"La césure coupe le vers en deux hémistiches.","why":"c’est … qui / la césure + verbe: structure d’analyse du vers."},{"t":"listen","skill":"listening","q":"أي جملة تصف l’alexandrin؟","opts":["Il compte douze syllabes.","Il rime toujours en e.","Il n’a jamais de césure.","Il est toujours en prose."],"a":0,"why":"l’alexandrin = douze syllabes avec une césure centrale."},{"t":"translate","skill":"writing","q":"ترجم: «يكتب سيرانو الرسائل التي يلقيها كريستيان.»","ans":"Cyrano écrit les lettres que Christian prononce.","why":"le complément d’objet direct avec « que » après le verbe transitif."},{"t":"speaking","skill":"speaking","q":"Explique en trois phrases pourquoi le nez est un symbole dans la pièce.","target":"Le nez est un symbole parce qu’il empêche Cyrano d’être aimé, mais il révèle aussi sa fierté et son esprit.","why":"la réponse mobilise le symbole, le conflit intérieur et la fierté du personnage."},{"t":"correct","skill":"vocabulary","q":"صحّح: « L’alexandrin est un vers de dix syllabes. »","ans":"L’alexandrin est un vers de douze syllabes.","why":"le décasyllabe compte dix syllabes; l’alexandrin en compte douze."}],"homework":"استمع إلى la tirade du nez ثلاث مرات بدون sous-titres، انسخ deux alexandrins وحدّد la césure فيهما، ثم اكتب 90 كلمة بالفرنسية تشرح فيها لماذا « Et mon panache ! » est une leçon d’honneur — مع 4 مفردات من la leçon.","sources":[{"title":"Cyrano de Bergerac : Analyse complète pour le bac de français (Edmond Rostand)","channel":"La Littérature Expliquée","videoId":"XmSLeAtznNY","why":"تحليل مدرسي شامل لـ la pièce: le drame héroïcomique، les cinq actes، la tirade du nez، la lettre et l’envoi — يمهّد مباشرة لدراسة l’alexandrin et l’amour dévoué de Cyrano.","cat":"Livres","level":"B2","main":true},{"title":"La tirade du nez — Cyrano de Bergerac remasterisée","channel":"MovieUpscaler","videoId":"4BY4OgoI9Bk","why":"la tirade du nez بجودة مرئية عالية: الإنصات إلى l’alexandrin وl’effet comique كما يُمثَّل على الخشبة.","cat":"Livres","level":"B2","extra":true},{"title":"Cyrano de Bergerac — la fin de l’envoi","channel":"Moneta","videoId":"jOBnnovICsI","why":"المشهد الأخير de l’envoi حيث ينكشف sacrifice de Cyrano وتنطق الكلمة الأخيرة « Et mon panache ! ».","cat":"Livres","level":"B2","extra":true}],"supplements":[{"id":"4BY4OgoI9Bk","title":"La tirade du nez — Cyrano de Bergerac remasterisée","channel":"MovieUpscaler","why":"la tirade du nez بجودة مرئية عالية: الإنصات إلى l’alexandrin وl’effet comique كما يُمثَّل على الخشبة.","lang":"fr","dur":4},{"id":"jOBnnovICsI","title":"Cyrano de Bergerac — la fin de l’envoi","channel":"Moneta","why":"المشهد الأخير de l’envoi حيث ينكشف sacrifice de Cyrano وتنطق الكلمة الأخيرة « Et mon panache ! ».","lang":"fr","dur":5}]},{"id":"b2-t10-l12","fr":"Bel-Ami — Guy de Maupassant","ar":"بيل-أامي — غي دي موباسان","objectives":["تحليل le naturalisme dans Bel-Ami: déterminisme social, l’argent et le désir comme moteurs de l’intrigue","تمييز les temps du résumé: le passé simple de l’intrigue et l’imparfait du décor mondain في إعادة سرد le roman","_acquire 12 كلمة أساسية autour du journalisme, de l’ascension sociale, de la séduction et de la corruption","expliquer pourquoi Duroy est un anti-héros moderne: la plume comme arme sociale dans le Paris de la IIIe République"],"sections":[{"h":"الدرس 12: تحليل «بيل-أامي» — الصحافة والصعود الاجتماعي في باريس","video":{"id":"emQYhqfLXKk","title":"« Bel-Ami », de Guy de Maupassant (Alchimie d’un roman, épisode n°29)","channel":"JPDepotte","why":"تحليل عميق لـ le roman: Georges Duroy، la plume et l’argent، la mécanique de l’ascension — يمهّد لفهم le naturalisme et le Paris mondain قبل قراءة الفصل الأول.","lang":"fr","main":true,"dur":9},"p":["«Bel-Ami» (1885) رواية الطموح بلا أخلاق: Georges Duroy، ضابط فقير عائد من أفريقيا، يعِيش في باريس بأربعين فرانكاً شهرياً في شقة بشارع l’Odéon. في عام ونصف يصبح محرّراً مؤثراً ثم عضواً في مجلس الشيوخ — بفضل النساء، وبفضل جريدة Le Vingtième Siècle، وخصوصاً بفضل plume التي تدمر السمعات أو تبنيها.","المفردات المحورية: le journalisme (الصحافة)، l’ascension sociale (الصعود الاجتماعي)، le naturalisme (المدرسة الطبيعية الأدبية)، le Paris mondain (باريس الأرستقراطية)، le rédacteur (محرّر)، l’article (المقال)، la séduction، l’argent، la corruption، le scandale، la femme fatale، la morale (الأخلاق).","يُعدّ Maupassant تلميذ Flaubert والشقيق الأدبي للـ naturalisme: الشخصية عندبه ليست حرة، بل محدّدة بيئها. لا يختار Duroy الخير ولا الشر، بل يختار l’ascension — كل امرأة (Claire, Madeleine, Hélène, Suzanne) سلّم صعود اجتماعي، وكل article صفقة.","الرواية في الوقت نفسه تصوير شعاعي للصحافة في نهاية القرن: la plume تساوي ذهباً، والscandale يزيد المبيعات، والمعلومة تصبح سلاحاً اجتماعياً. والعنوان نفسه — « Bel-Ami » — لقب ساخر أطلقته نساء المجتمع على Duroy: الصديق الجميل الذي يُستعمل ثم يصعد.","بعد الدرس، أعد قراءة الفصل الأول (la danse au bal) دون النظر إلى الملخّص، ثم دوّن أربعة إيماءات تكشف فقر Duroy وثلاث وعود ضمنية من Madeleine — فالاعتراف الاجتماعي يبدأ بالانتباه إلى التفاصيل الصغيرة.","خُلاصة الدرس: في نهاية الرواية يكون Duroy قد كسب كل شيء وخسر كل شيء: زوجته Hélène تنتحر بعد الفضيحة، وSuzanne Walter تبكي أمامه، ويبقى القارئ أمام سؤال Maupassant — هل النجاح بلا أخلاق انتصار حقاً؟"],"sub":[{"h":"le journalisme, arme sociale","p":["Duroy apprend à écrire auprès de Madeleine.","La plume détruit les réputations et fait les carrières.","Le scandale fait vendre le journal."]},{"h":"l’ascension sociale en quatre marches","p":["la rue de l’Odéon — le premier logement pauvre.","Claire Forestier puis Madeleine — le monde journalistique.","Hélène et Suzanne Walter — la haute finance et le Sénat."]},{"h":"le vocabulaire du naturalisme","p":["le déterminisme — وراثة البيئة","l’argent — le moteur du roman","l’anti-héros — un héros sans morale"]}]},{"h":"les phrases et leçons de Bel-Ami","p":["Duroy arrive à Paris avec quarante francs: c’est le point de départ d’une ascension calculée, pas d’une aventure sentimentale.","Madeleine Forestier est le véritable génie du couple: elle écrit les articles, Duroy signe — la plume est le vrai capital du roman.","Le surnom « Bel-Ami » moque autant qu’il flatte: le monde mondain donne un nom à celui qu’il utilise.","La fin du roman: Hélène se tue, Suzanne pleure, Duroy demeure — Maupassant refuse le châtiment exemplaire et laisse au lecteur le verdict."]},{"h":"التطبيق والتلخيص","p":["تمرين la lecture ciblée: relis le chapitre I et liste les détails qui peignent la pauvreté de Duroy (vêtement, argent, regard des autres).","تمرين l’analyse: اكتب 60 كلمة تشرح فيها كيف تعمل Madeleine كمحرّرة حقيقية وDuroy كتوقيع فقط.","اكتب paragraphe de 90 mots بالفرنسية تقيّم فيه ascension de Duroy: est-ce une réussite ou une déchéance ? — مع 4 مفردات من la leçon."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: يشرح الدرس «بيل-أامي» كرواية la séduction et le journalisme: Georges Duroy يصعد عبر la corruption الصحافية، و le ragot يبيع الورق، و la probité وحدها تبقى خارج اللعبة. أعد مشاهدة الفيديو الرئيسي وركّز على la scène du premier article وعلى la chute de Forest.","جسر الدروس: من b2-t10-l11 (سيرانو — الشرفُ ينتصر على الحبّ بالكلمة) إلى b2-t10-l12 (بيل-أامي — النجاحُ ينتصر على الشرف بالكلمة المأجورة)، ثم إلى b2-t10-l13 حيث «الأحمر والأسود» لـ Stendhal يجعل la duplicité et l’audace سلاحَ Julien Sorel في زمن la Restauration.","مهمة تطبيقية: سجّل ملخّص الرواية في دقيقة، أضف 3 كلمات من الدرس (مثل la probité و le ragot)، ثم قارن la scène de l’article في الفيديو بنقده لـ le journalisme du XIXe siècle."]}],"pron":[{"w":"l’ascension","ipa":"[asɛksjɔ̃]","approx":"أسيسيون"},{"w":"le journalisme","ipa":"[ʒuʁnalism]","approx":"جورناليسم"},{"w":"naturalisme","ipa":"[natyʁalism]","approx":"ناتوراليسم"}],"vocab":[{"fr":"le journalisme","ar":"الصحافة","pos":"nom","g":"m","exFr":"Le journalisme est pour Duroy un escalier social.","ipa":"[ʒuʁnalism]","exAr":"الصحافة بالنسبة لدورو سلم صعود اجتماعي."},{"fr":"l’article","ar":"المقال الصحفى","pos":"nom","g":"m","exFr":"Un article bien placé peut faire tomber un ministre.","ipa":"[aʁtikl]","exAr":"المقال الجيد يستطيع إسقاط وزير."},{"fr":"le rédacteur","ar":"المحرّر","pos":"nom","g":"m","exFr":"Duroy devient rédacteur du journal.","ipa":"[ʁedaktœʁ]","exAr":"يصبح دورو محرّراً في الجريدة."},{"fr":"l’ascension sociale","ar":"الصعود الاجتماعي","pos":"loc.","g":"f","exFr":"Son ascension sociale dure à peine dix-huit mois.","ipa":"","exAr":"صعوده الاجتماعي لم يستغرق ثمانية عشر شهراً."},{"fr":"le ragot","ar":"الإشاعة الصاخبة","pos":"nom","g":"m","exFr":"Le ragot fait vendre le journal de Duroy.","exAr":"الإشاعة الصاخبة تبيع صحيفة ديروي.","ipa":"[ʁago]"},{"fr":"la séduction","ar":"الفتنة والإغراء","pos":"nom","g":"f","exFr":"Sa séduction est une méthode, pas un sentiment.","ipa":"[seduksjɔ̃]","exAr":"إغراؤه منهج لا شعور."},{"fr":"l’argent","ar":"المال","pos":"nom","g":"m","exFr":"Dans Bel-Ami, l’argent est le vrai héros du roman.","ipa":"[aʁʒɑ̃]","exAr":"في بيل-أامي، المال هو البطل الحقيقي للرواية."},{"fr":"la corruption","ar":"الفساد","pos":"nom","g":"f","exFr":"La corruption politique ouvre les portes du Sénat.","ipa":"[kɔʁypsjɔ̃]","exAr":"الفساد السياسي يفتح أبواب مجلس الشيوخ."},{"fr":"l’anti-héros","ar":"البطل المضاد (بطل بلا أخلاق)","pos":"nom","g":"m","exFr":"Duroy est un anti-héros sans scrupules.","ipa":"[ɑ̃ti eʁo]","exAr":"دورو بطل مضاد بلا ضمير."},{"fr":"le déterminisme","ar":"الحتمية الاجتماعية","pos":"nom","g":"m","exFr":"Le déterminisme social explique l’ambition de Duroy.","ipa":"[deteʁminism]","exAr":"الحتمية الاجتماعية تفسّر طموح دورو."},{"fr":"le Paris mondain","ar":"باريس الأرستقراطية","pos":"loc.","g":"m","exFr":"Le Paris mondain juge tout par l’apparence.","ipa":"","exAr":"باريس الأرستقراطية تحكم على كل شيء بالمظهر."},{"fr":"la probité","ar":"النزاهة","pos":"nom","g":"f","exFr":"Le roman pose la question de la probité dans la réussite.","exAr":"الرواية تطرح سؤال النزاهة في النجاح.","ipa":"[pʁɔbite]"}],"examples":[{"fr":"Duroy signe les articles que Madeleine écrit.","ar":"يوقّع دورو المقالات التي تكتبها مادلين.","note":"la plume comme capital"},{"fr":"Il vivait avec quarante francs par mois à Paris.","ar":"كان يعيش بأربعين فرانكاً شهرياً في باريس.","note":"le point de départ de l’ascension"},{"fr":"Le scandale fait vendre le journal.","ar":"الفضيحة تزيد مبيعات الجريدة.","note":"le naturalisme du journalisme"},{"fr":"Bien qu’il soit pauvre, il fréquente les salons mondains.","ar":"رغم فقره، فإنه يتردد على صالونات باريس الراقية.","note":"la concession"},{"fr":"Il n’a jamais aimé qu’il n’ait d’abord calculé.","ar":"لم يحب قط دون أن يحسب أولاً.","note":"l’anti-héros sans morale"},{"fr":"Le surnom Bel-Ami moque autant qu’il flatte.","ar":"اللقب «بيل-أامي» يسخر كما يُمِدح.","note":"le titre du roman"}],"grammar":[{"tFr":"La concession: « bien que » + subjonctif, « cependant », « pourtant »","tAr":"الاستدراك: «bien que» مع التصريف المضارع للشخص الثاني وما بعده، و«cependant» و«pourtant»","body":["pour analyser un personnage contradictoire, on oppose deux faits: « Bien qu’il soit pauvre, Duroy pénètre dans les salons mondains. » — après « bien que », le subjonctif est obligatoire même à l’indicatif.","« cependant » et « pourtant » marquent l’opposition sans subjonctif: « Duroy est sans scrupules ; pourtant, il reste fidèle à sa mère. » — ces connecteurs sont indispensables dans une dissertation littéraire B2."],"ex":[{"fr":"Bien qu’il soit sans fortune, Duroy ose parler aux femmes du monde.","ar":"رغم أنه بلا مال، يجرؤ دورو على الحديث إلى نساء المجتمع الراقي."},{"fr":"Madeleine écrit seule ; cependant, Duroy signe tout.","ar":"مادلين تكتب وحدها؛ لكن دورو يوقّع كل شيء."}]},{"tFr":"L’expression de la conséquence: « ce qui fait que », « c’est pourquoi », « si bien que »","tAr":"التعبير عن النتيجة باستخدام «ce qui fait que» و«c’est pourquoi» و«si bien que»","body":["dans le roman naturaliste, chaque cause produit un effet social: « Duroy publie un scandale, ce qui fait que ses ennemis se taisent. » — « ce qui fait que » + indicatif relie deux phrases en une chaîne causale.","« c’est pourquoi » place la conséquence en tête de phrase: « L’argent manquait ; c’est pourquoi il accepta les avances d’Hélène. »; « si bien que » marque le degré extrême: « il mentait si bien que tout le monde le croyait. »"],"ex":[{"fr":"Duroy choisit toujours le parti le plus fort, ce qui fait que sa réputation change chaque mois.","ar":"يختار دورو دائماً الجانب الأقوى، ولهذا تتغيّر سمعته كل شهر."},{"fr":"Il savait plaire, si bien que les femmes lui ouvraient les portes du pouvoir.","ar":"كان يعرف كيف يُعجب، حتى إن النساء فتحن له أبواب السلطة."}]}],"mistakes":[{"wrong":"voir Duroy comme un héros romantique","right":"analyser Duroy comme un anti-héros naturaliste","why":"il est déterminé par l’argent et le milieu, pas guidé par un idéal."},{"wrong":"dire « bien que + indicatif : bien qu’il est pauvre »","right":"bien qu’il soit pauvre","why":"« bien que » commande toujours le subjonctif."},{"wrong":"traduire « Bel-Ami » par « le bel ami » comme compliment","right":"le surnom est moqueur: le bel ami sert et monte","why":"le monde mondain baptise celui qu’il instrumente."},{"wrong":"confondre naturalisme et romantisme","right":"le naturalisme décrit le milieu et le déterminisme","why":"Maupassant observe la société comme un clinicien observe un malade."}],"dialogues":[{"title":"un article qui fait une carrière","ctx":"Madeleine apprend à Duroy la mécanique du journal.","lines":[{"who":"Madeleine","fr":"Écris-moi l’article, je le corrigerai : la plume s’apprend.","ar":"اكتب لي المقال، سأصحّحه: فن الكتابة يُتعلَّم."},{"who":"Duroy","fr":"Je signe, mais c’est vous qui écrivez tout.","ar":"أنا أوقّع، لكنكِ أنتِ تكتبين كل شيء."},{"who":"Madeleine","fr":"Dans ce journal, on ne paie pas l’opinion, on paie le scandale.","ar":"في هذه الجريدة لا يُدفع مقابل الرأي، بل مقابل الفضيحة."},{"who":"Duroy","fr":"Alors j’apprendrai à faire du scandale.","ar":"إذن سأتعلّم كيف أصنع الفضائح."}]},{"title":"le monde mondain juge Duroy","ctx":"Un pair de Duroy commente son ascension dans un salon parisien.","lines":[{"who":"Un critique","fr":"Bel-Ami nous a encore devancés au journal ce matin.","ar":"بيل-أامي سبقنا مجدداً في الجريدة هذا الصباح."},{"who":"Un invité","fr":"Il n’a ni famille ni fortune, mais il sait plaire.","ar":"لا عائلة ولا مال لديه، لكنه يعرف كيف يُعجب."},{"who":"La baronne","fr":"Les femmes lui ouvrent les portes que l’argent n’ouvre pas.","ar":"النساء يفتحن له الأبواب التي لا يفتحها المال."},{"who":"Le critique","fr":"C’est un journaliste d’un an qui parle comme s’il avait toujours existé.","ar":"هو صحفي عمره سنة واحدة لكنه يتحدث كأنه موجود منذ الأزل."}]}],"exercises":[{"t":"mcq","skill":"listening","q":"ما الجملة التي تصف نقطة البداية عند Duroy؟","opts":["Il vivait avec quarante francs par mois.","Il était déjà sénateur.","Il possédait un grand journal.","Il habitait un hôtel particulier."],"a":0,"why":"الفقر في شارع أوديون هو نقطة البداية في الصعود الاجتماعي."},{"t":"fill","skill":"grammar","q":"أكمل الاستدراك: «___ qu’il soit pauvre, il fréquente les salons.»","fr":"... qu’il soit pauvre, il fréquente les salons.","ans":"Bien","why":"« bien que » + subjonctif marque la concession."},{"t":"mcq","skill":"vocabulary","q":"ما معنى le naturalisme في السياق الأدبي؟","opts":["une école qui décrit le milieu et le déterminisme","un mouvement poétique du XVIIe siècle","une technique de théâtre comique","un genre fantastique"],"a":0,"why":"المدرسة الطبيعية تصف البيئة والحتمية الاجتماعية كما يفعل موباسان."},{"t":"order","skill":"writing","q":"رتّب: المال هو البطل الحقيقي للرواية","words":["Dans","Bel-Ami,","l’argent","est","le","vrai","héros","du","roman."],"ans":"Dans Bel-Ami, l’argent est le vrai héros du roman.","why":"l’analyse naturaliste place l’argent au centre de l’intrigue."},{"t":"listen","skill":"listening","q":"أي جملة تصف العلاقة بين Madeleine وDuroy؟","opts":["Elle écrit et il signe.","Il écrit et elle signe.","Ils n’écrivent jamais.","Elle refuse de l’aider."],"a":0,"why":"مادلين هي الكاتبة الفعلية ودورو هو الاسم على الورق."},{"t":"translate","skill":"writing","q":"ترجم: «رغم أنه بلا ثروة، فإنه يتردد على صالونات باريس الراقية.»","ans":"Bien qu’il soit sans fortune, il fréquente les salons mondains.","why":"bien que + subjonctif: la concession exige le subjonctif."},{"t":"speaking","skill":"speaking","q":"Explique en trois phrases si Duroy est un vainqueur ou un perdant à la fin du roman.","target":"À la fin du roman, Duroy a gagné le Sénat mais il a perdu toute morale, donc sa victoire est une défaite intérieure.","why":"la réponse mobilise le constat social et le jugement moral du lecteur."},{"t":"correct","skill":"grammar","q":"صحّح: «Bien qu’il est ambitieux, il reste pauvre.»","ans":"Bien qu’il soit ambitieux, il reste pauvre.","why":"après « bien que », on emploie le subjonctif (soit), jamais l’indicatif (est)."}],"homework":"relis le chapitre الأول de « Bel-Ami » ودوّن quatre détails de la pauvreté de Duroy، ثم اكتب 90 كلمة بالفرنسية تشرح فيها كيف تحوّل le journalisme إلى arme d’ascension — مع 4 مفردات من la leçon et un connecteur de concession.","sources":[{"title":"« Bel-Ami », de Guy de Maupassant (Alchimie d’un roman, épisode n°29)","channel":"JPDepotte","videoId":"emQYhqfLXKk","why":"تحليل عميق لـ le roman: Georges Duroy، la plume et l’argent، la mécanique de l’ascension — يمهّد لفهم le naturalisme et le Paris mondain قبل قراءة الفصل الأول.","cat":"Livres","level":"B2","main":true},{"title":"Résumé de Bel-Ami de Guy de Maupassant","channel":"romansmondiaux2","videoId":"NqedCY0-OtI","why":"ملخّص موجز يعيد بناء l’intrigue كاملة قبل التعمق في le naturalisme.","cat":"Livres","level":"B2","extra":true},{"title":"Scandales et Trahisons : La face cachée du journalisme sous Maupassant","channel":"Le Déca Littéraire","videoId":"tI38vsOEi7w","why":"يركّز على le journalisme كأداة للسلطة والفضيحة — جسر بين الرواية والصحافة.","cat":"Livres","level":"B2","extra":true}],"supplements":[{"id":"NqedCY0-OtI","title":"Résumé de Bel-Ami de Guy de Maupassant","channel":"romansmondiaux2","why":"ملخّص موجز يعيد بناء l’intrigue كاملة قبل التعمق في le naturalisme.","lang":"fr","dur":2},{"id":"tI38vsOEi7w","title":"Scandales et Trahisons : La face cachée du journalisme sous Maupassant","channel":"Le Déca Littéraire","why":"يركّز على le journalisme كأداة للسلطة والفضيحة — جسر بين الرواية والصحافة.","lang":"fr","dur":2}]},{"id":"b2-t10-l13","fr":"Le Rouge et le Noir — Stendhal","ar":"الأحمر والأسود — ستندال","objectives":["analyser le style indirect libre chez Stendhal et son rôle dans le roman psychologique","remarquer les temps du récit: le passé simple de l’intrigue et le plus-que-parfait du rappel historique dans la Restauration","_acquire 12 كلمة أساسية autour de l’hypocrisie, de l’ambition, de la soutane, de la médiocrité et du roman psychologique","expliquer pourquoi Julien Sorel est un héros romantique pris dans une société médiocre"],"sections":[{"h":"الدرس 13: تحليل «الأحمر والأسود» — الرواية النفسية وصعود جوليان سوريل","video":{"id":"Xi9pEBsuryQ","title":"Le Rouge et le noir de Stendhal Analyse","channel":"Gloria Lauzanne Cours de français","why":"تحليل مدرسي مركّز لـ le roman psychologique: Julien Sorel, l’hypocrisie sociale et le contexte de la Restauration — يمهّد لفهم le conflit entre l’ambition et l’amour.","lang":"fr","main":true,"dur":9},"p":["«Le Rouge et le Noir» (1830) يحمل العنوان الفرعي « Chronique de 1830 »: يرسم فيه Stendhal فرنسا la Restauration حيث استعادت النبلاء الملكيون السلطة بعد 1815 وأصبح استحقاق الشاب أقل قيمة من نسبه. Julien Sorel، ابن نجار في Verrières، يحتقر العمل اليدوي ويجعل من Napoléon مثاله الأعلى السري — لكنه يختار la soutane السوداء طريقاً للصعود، بينما يظل الأحمر الخاص بالجيش حُلماً محظوراً.","المفردات المحورية: le roman psychologique (الرواية النفسية)، l’hypocrisie (النفاق)، l’ambition (الطموح)، la soutane (الرداء الرسمي للكاهن)، la Restauration (عهد البوربون بعد 1815)، la médiocrité (الرداءة والسطوحية)، l’escalier (الدرج كرمز للصعود)، le procès (المحاكمة)، la province (الريف)، le salon (صالونات باريس)، la fatalité (المصير)، le portrait (صورة نابليون المخفية).","الرواية نفسية لأن l’action intérieure تعلو على كل شيء: كل شخصية تحسب وتقارن وتندم. يقبّل Julien خشب فراشة حيث أخفى صورة Napoléon — الإيماءة تلخّص الصراع كله: حبّ إمبراطورية موتى والضرورة الاجتماعية في التظاهر بالتقوى للنجاح.","l’hypocrisie هي الموضوع الحقيقي: يلعب Julien أمام l’abbé Pérenne، و أمام M. de Rênal، و أمام Mathilde de la Mole. يستخدم Stendhal le style indirect libre ليمزج صوت الراوي بصوت الشخصية — فيسمع القارئ فكر Julien دون أن يأتي « dit-il » ليقطعه.","بعد الدرس، أعد قراءة الفصل الأول في ثانوية Verrières، ثم دوّن عوالم الرواية الثلاثة (la province، السلطة الكنسية، le Paris mondain) واللونين في العنوان: أحمر الطموح العسكري وأسود la soutane — اللون يصبح جدلاً داخلياً.","خُلاصة الدرس: في المحاكمة يرفض Julien la grâce ويفضّل الموت في الثالثة والعشرين من عمره على النفاق الاجتماعي — يحوّل Stendhal جريمة الدرج إلى حكم على مجتمع كامل رداءته سلوكها."],"sub":[{"h":"le roman psychologique","p":["Le titre oppose le rouge de l’armée et le noir de la soutane.","L’action intérieure de Julien domine l’intrigue.","Le style indirect libre épouse la pensée du personnage."]},{"h":"la Restauration et la médiocrité","p":["Après 1815, la noblesse reprend le pouvoir.","La naissance vaut plus que le mérite.","Stendhal signe une « Chronique de 1830 »."]},{"h":"le vocabulaire du conflit","p":["l’hypocrisie — النفاق","l’ambition — الطموح","la médiocrité — الرداءة والسطوحية"]}]},{"h":"les phrases et leçons du roman","p":["« Chronique de 1830 » — le sous-titre annonce une peinture sociale autant qu’une aventure sentimentale: le roman juge son époque.","Julien embrasse le portrait de Napoléon caché sous son matelas — le geste fondateur de son hypocrisie et de son rêve.","À Verrières, la beauté des bois rappelle à Julien la grandeur morte de l’Empire — la nature devient le miroir de son ambition.","Le procès final: Julien refuse de plaire au jury pour sauver sa tête — il choisit la vérité plutôt que le masque."]},{"h":"التطبيق والتلخيص","p":["تمرين la lecture psychologique: relis le passage du portrait de Napoléon et note les trois émotions de Julien (orgueil, regret, colère).","تمرين l’analyse du style: trouve deux phrases de style indirect libre et récris-les en style direct.","اكتب paragraphe de 90 mots بالفرنسية تشرح فيه pourquoi Julien choisit la soutane — مع 4 مفردات من la leçon et un connecteur de cause."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: يتتبّع الدرس صعود Julien Sorel: la duplicité سلاحه، و l’audace بابه، و la condamnation نهايته؛ le roman psychologique عند Stendhal يقرأ la Restauration عبر نفس بطله. أعد مشاهدة الفيديو الرئيسي وركّز على la scène du tribunal وعلى le dernier rêve de Julien.","جسر الدروس: من b2-t10-l12 (بيل-أامي — la réussite sociale بلا ندم) إلى b2-t10-l13 (الأحمر والأسود — l’audace تدفع إلى la condamnation ثم إلى la lucidité أمام الموت)، ثم إلى b2-t10-l14 حيث «العشيق» لـ Duras يستبدل le roman psychologique بـ l’autofiction et la réminiscence.","مهمة تطبيقية: لخّص الرواية في تسجيلٍ من دقيقة، استعمل 3 كلمات من الدرس (مثل la duplicité و l’audace و l’archétype)، ثم قارن la scène du procès في الفيديو بتحليل le conflit entre Julien et la société."]}],"pron":[{"w":"la duplicité","ipa":"[dyplisite]","approx":"دوپليسيتي"},{"w":"la soutane","ipa":"[sutɑn]","approx":"سوطان"},{"w":"la Restauration","ipa":"[ʁɛstɔʁasjɔ̃]","approx":"ريستوراسيون"}],"vocab":[{"fr":"le roman psychologique","ar":"الرواية النفسية","pos":"loc.","g":"m","exFr":"Le Rouge et le Noir est un roman psychologique.","ipa":"","exAr":"الأحمر والأسود رواية نفسية."},{"fr":"la duplicité","ar":"الازدواجية","pos":"nom","g":"f","exFr":"La duplicité de Julien est une arme de survie.","exAr":"ازدواجية جوليان سلاحٌ للنجاة.","ipa":"[dyplisite]"},{"fr":"l’audace","ar":"الجرأة الطموحة","pos":"nom","g":"f","exFr":"L’audace de Julien effraie le salon de la Restauration.","exAr":"جرأة جوليان تُخيف صالونات الاستعادة.","ipa":"[ɔdas]"},{"fr":"la soutane","ar":"الرداء الكاهني","pos":"nom","g":"f","exFr":"La soutane noire est sa route d’ascension.","ipa":"[sutɑn]","exAr":"الرداء الأسود طريق صعوده."},{"fr":"la Restauration","ar":"عهد الاستعادة الملكية بعد 1815","pos":"nom","g":"f","exFr":"La Restauration limite les chances de Julien.","ipa":"[ʁɛstɔʁasjɔ̃]","exAr":"عهد الاستعادة يحدّ من فرص جوليان."},{"fr":"la médiocrité","ar":"الرداءة والسطوحية","pos":"nom","g":"f","exFr":"La médiocrité du monde provincial étouffe Julien.","ipa":"[medjɔkʁite]","exAr":"سطوحية العالم الريفي تخنق جوليان."},{"fr":"l’escalier","ar":"الدرج","pos":"nom","g":"m","exFr":"Le crime de l’escalier change le destin de Julien.","ipa":"[ɛskalje]","exAr":"جريمة الدرج تغيّر مصير جوليان."},{"fr":"la condamnation","ar":"الحكم القضائي","pos":"nom","g":"f","exFr":"La condamnation de Julien clôt le roman psychologique.","exAr":"الحكم على جوليان يختم الرواية النفسية.","ipa":"[kɔ̃damnasjɔ̃]"},{"fr":"l’hypocrite","ar":"المنافق","pos":"adj.","g":"","exFr":"Julien joue l’hypocrite devant le curé.","ipa":"[ipɔkʁit]","exAr":"يلعب جوليان دور المنافق أمام القسيس."},{"fr":"l’archétype","ar":"النموذج الأولي","pos":"nom","g":"m","exFr":"Napoléon est l’archétype secret de Julien.","exAr":"نابليون هو النموذج السري لجوليان.","ipa":"[aʁketip]"},{"fr":"la fatalité","ar":"المصير الذي لا يُقاوم","pos":"nom","g":"f","exFr":"La fatalité entraîne Julien vers le crime.","ipa":"[fatalite]","exAr":"المصير يجرّ جوليان إلى الجريمة."},{"fr":"le salon","ar":"الصالون الأرستقراطي","pos":"nom","g":"m","exFr":"Le salon parisien juge Julien à sa naissance.","ipa":"[salɔ̃]","exAr":"الصالون الباريسي يحكم على جوليان بعدّ والده."}],"examples":[{"fr":"Julien cache le portrait de Napoléon sous son matelas.","ar":"يخفي جوليان صورة نابليون تحت فراشته.","note":"le geste fondateur du rêve"},{"fr":"Il joue la piété pour que le curé le remarque.","ar":"يتظاهر بالتقوى ليلفت نظر القسيس.","note":"l’hypocrisie et la finalité"},{"fr":"Stendhal mêle sa voix à celle de Julien.","ar":"يمزج ستندال صوته بصوت جوليان.","note":"le style indirect libre"},{"fr":"La Restauration préfère la naissance au mérite.","ar":"عهد الاستعادة يفضّل النسب على الاستحقاق.","note":"le contexte historique"},{"fr":"Le titre oppose le rouge de l’armée au noir de la soutane.","ar":"العنوان يضع الأحمر لجيش مقابل الأسود للرداء الكاهني.","note":"le symbole des couleurs"},{"fr":"Au procès, il refuse de plaire au jury.","ar":"في المحاكمة يرفض أن يُعجب هيئة المحلفين.","note":"le refus final de l’hypocrisie"}],"grammar":[{"tFr":"Le style indirect libre: la voix du narrateur et celle du personnage","tAr":"الأسلوب غير المباشر الحرّ: صوت الراوي وصوت الشخصية يمتزجان","body":["le style indirect libre supprime les guillemets et le verbe de parole: « Julien se dit qu’il fallait absolument être le premier. » Le lecteur entend la pensée du personnage dans les mots du narrateur — c’est l’outil du roman psychologique.","repère B2: pas de « il dit que », pas de concordance des temps rigide — le temps de la pensée reste celui du personnage (présent, imparfait, conditionnel selon le registre)."],"ex":[{"fr":"Julien se dit qu’il fallait être aimé de Madame de Rênal avant de partir.","ar":"يقول لنفسه إن لا بد أن يُحبّه السيدة دي رينال قبل أن يرحل."},{"fr":"Mathilde pensait que la grandeur n’était plus possible en 1830.","ar":"كانت ماتيلد ترى أن العظمة لم تعد ممكنة عام 1830."}]},{"tFr":"L’expression de la finalité avec « pour que » + subjonctif","tAr":"التعبير عن الغاية باستخدام «pourque» مع التصريف المضارع للشخص الثاني","body":["« pour que » + subjonctif introduit le but poursuivi par le personnage: « Julien fréquente le séminaire pour que sa réputation de pieux s’affirme. » — le subjonctif est obligatoire, même au passé: « il fit semblant pour que le curé le crût dévot. »","dans une analyse, on oppose le but affiché et le but réel: le but affiché est la piété, le but réel est le pouvoir — la phrase en « pour que » rend cette double stratégie visible."],"ex":[{"fr":"Julien apprend le latin pour que M. de Rênal le prenne comme précepteur.","ar":"يتعلّم جوليان اللاتينية لكي تعيّنه السيدة دي رينال معلّماً لأبنائها."},{"fr":"Il joue l’hypocrite pour que le monde le croie convaincu.","ar":"يلعب دور المنافق لكي يصدّقه العالم."}]}],"mistakes":[{"wrong":"dire que Julien est simplement « méchant »","right":"analyser Julien comme un héros pris dans l’hypocrisie sociale","why":"son masque dévot est une stratégie de survie dans la Restauration."},{"wrong":"confondre le romantisme et le roman psychologique","right":"le roman psychologique analyse la pensée intérieure","why":"Stendhal peint les motivations avant les événements extérieurs."},{"wrong":"dire « pour que + indicatif : pour que le curé le remarque » à l’indicatif forcé","right":"pour que le curé le remarque (subjonctif)","why":"« pour que » commande toujours le subjonctif."},{"wrong":"traduire le titre par « le rouge et le noir » sans symbole","right":"rouge = l’armée, noir = la soutane","why":"le titre résume le conflit intérieur entre deux destins."}],"dialogues":[{"title":"le portrait caché","ctx":"Verrières: Julien embrasse le portrait de Napoléon avant d’entrer au service de la maison de Rênal.","lines":[{"who":"Julien","fr":"Napoléon était pauvre comme moi, et il commanda l’Europe.","ar":"كان نابليون فقيراً مثلي، ثم حكم على أوروبا."},{"who":"Julien","fr":"Moi, je n’ai que la soutane pour monter.","ar":"ليس أمامي إلا الرداء لأصعد."},{"who":"Julien","fr":"Je jouerai le dévot devant tout le monde.","ar":"سأتظاهر بالتقوى أمام الجميع."},{"who":"Julien","fr":"Le portrait restera sous le matelas, le rêve restera sous la soutane.","ar":"ستبقى الصورة تحت الفراش، والحلم تحت الرداء."}]},{"title":"la conversation au salon","ctx":"Paris: chez les La Mole, on discute de Julien devant lui.","lines":[{"who":"Mathilde","fr":"Ce jeune paysan a une fierté que nos gentilshommes ont perdue.","ar":"هذا الشاب الريفي يملك كبراً فقدته نبلاؤنا."},{"who":"Un marquis","fr":"Sa naissance le condamne : la Restauration n’aime pas les nouveaux venus.","ar":"نسبه يدانِه: عهد الاستعادة لا يحب الغرباء."},{"who":"Mathilde","fr":"Il joue l’hypocrite, mais je devine l’homme sous le masque.","ar":"يلعب دور المنافق، لكنني أشفّر الرجل خلف القناع."},{"who":"Le marquis","fr":"Méfiez-vous : l’ambition sans naissance est dangereuse.","ar":"احذري: الطموح بلا نسب خطير."}]}],"exercises":[{"t":"mcq","skill":"listening","q":"ما اللونان في العنوان وما يرمزان إليه؟","opts":["le rouge = l’armée, le noir = la soutane","le rouge = l’amour, le noir = la mort","le rouge = le sang, le noir = la nuit","le rouge = la province, le noir = Paris"],"a":0,"why":"العنوان يلخّص حلم جوليان العسكري وطريقه الكاهني."},{"t":"fill","skill":"grammar","q":"أكمل الغاية: «Il joue le dévot ___ que le curé le remarque.»","fr":"Il joue le dévot ... que le curé le remarque.","ans":"pour","why":"« pour que » + subjonctif marque le but réel du personnage."},{"t":"mcq","skill":"vocabulary","q":"ما معنى la Restauration؟","opts":["le retour des Bourbons après 1815","la chute de Napoléon en 1812","la Révolution de 1789","la fondation du Second Empire"],"a":0,"why":"الاستعادة الملكية هي عودة آل بوربون عام 1815 وهو زمن الرواية."},{"t":"order","skill":"writing","q":"رتّب: جوليان يختفي صورة نابليون تحت فراشته","words":["Julien","cache","le","portrait","de","Napoléon","sous","son","matelas."],"ans":"Julien cache le portrait de Napoléon sous son matelas.","why":"الجملة تلخّص البداية السرّية للحلم في الرواية."},{"t":"listen","skill":"listening","q":"أي جملة تصف l’hypocrisie de Julien؟","opts":["Il joue le dévot devant le curé.","Il déteste le pouvoir.","Il refuse l’amour de Mathilde.","Il travaille chez son père."],"a":0,"why":"التظاهر بالتقوى هو استراتيجية الصعود عند جوليان."},{"t":"translate","skill":"writing","q":"ترجم: «يتعلّم جوليان اللاتينية لكي تعيّنه السيدة دي رينال معلّماً.»","ans":"Julien apprend le latin pour que Madame de Rênal le prenne comme précepteur.","why":"pour que + subjonctif: la finalité exige le subjonctif."},{"t":"speaking","skill":"speaking","q":"Explique en trois phrases pourquoi Julien choisit la soutane plutôt que l’armée.","target":"Julien choisit la soutane parce que la Restauration ferme l’armée aux jeunes sans naissance ; la soutane est donc la seule route d’ascension qui lui reste.","why":"la réponse mobilise le contexte historique et l’ambition du personnage."},{"t":"correct","skill":"grammar","q":"صحّح: «Il fit semblant pour que le curé le croit dévot.»","ans":"Il fit semblant pour que le curé le croie dévot.","why":"le subjonctif du verbe croire est « croie », pas « croit » (indicatif)."}],"homework":"استمع إلى la lecture du premier chapitre، اكتب trois traits du caractère de Julien، ثم اكتب 90 كلمة بالفرنسية تشرح فيها le conflit entre le rouge et le noir في حياة Julien — مع 4 مفردات من la leçon et une phrase avec « pour que ».","sources":[{"title":"Le Rouge et le noir de Stendhal Analyse","channel":"Gloria Lauzanne Cours de français","videoId":"Xi9pEBsuryQ","why":"تحليل مدرسي مركّز لـ le roman psychologique: Julien Sorel, l’hypocrisie sociale et le contexte de la Restauration — يمهّد لفهم le conflit entre l’ambition et l’amour.","cat":"Livres","level":"B2","main":true},{"title":"Le Rouge et le Noir de Stendhal : Mais qui est Julien Sorel ?","channel":"Lydie et le Murmure des Pages","videoId":"rLpp_Vi5VJs","why":"تركيز مباشر على la psychologie de Julien — سؤال le personnage المركزي في الرواية.","cat":"Livres","level":"B2","extra":true},{"title":"« Le Rouge et le Noir », de Stendhal (Alchimie d’un roman, épisode n°35)","channel":"JPDepotte","videoId":"Zdr_GnXH5CY","why":"تحليل عميق للـ alchimie du roman: les couleurs, l’ambition et le contexte de la Restauration.","cat":"Livres","level":"B2","extra":true}],"supplements":[{"id":"rLpp_Vi5VJs","title":"Le Rouge et le Noir de Stendhal : Mais qui est Julien Sorel ?","channel":"Lydie et le Murmure des Pages","why":"تركيز مباشر على la psychologie de Julien — سؤال le personnage المركزي في الرواية.","lang":"fr","dur":1},{"id":"Zdr_GnXH5CY","title":"« Le Rouge et le Noir », de Stendhal (Alchimie d’un roman, épisode n°35)","channel":"JPDepotte","why":"تحليل عميق للـ alchimie du roman: les couleurs, l’ambition et le contexte de la Restauration.","lang":"fr","dur":14}]},{"id":"b2-t10-l14","fr":"L’Amant — Marguerite Duras","ar":"العشيق — مارغريت دوراس","objectives":["définir l’autofiction et distinguer autobiographie, roman et autofiction dans L’Amant de Marguerite Duras","remarquer le style épuré: la phrase nominale, la parataxe et le présent de la mémoire au lieu du passé simple","_acquire 12 كلمة أساسية autour de l’Indochine, de la traversée du Mékong, du silence et de la mémoire","expliquer pourquoi l’ouvrage est une méditation sur le temps plus qu’un simple récit d’amour"],"sections":[{"h":"الدرس 14: تحليل «العشيق» — الأوتوفيكيشن والهند الصينية ونثر الذاكرة","video":{"id":"1kuzkIoUKI4","title":"L’Amant - Marguerite Duras | Résumé Complet - Analyse - Littérature - Podcast","channel":"VoixLivre","why":"تحليل شامل لـ l’autofiction de Duras: l’enfance en Indochine, la traversée du Mékong, l’amant chinois et le style épuré — يمهّد لفهم l’écriture de la mémoire قبل القراءة.","lang":"fr","main":true,"dur":13},"p":["«L’Amant» (غونكور 1984) autofiction: تُعيد الراوية الكبيرة كتابة طفولتها في l’Indochine الفرنسية وعائلتها المزرية، وخصوصاً la traversée du Mékong حيث تلتقي، في الخامسة عشرة، بالشاب الصيني داخل la limousine السوداء. لا يخفي الكتاب التواريخ ولا الأماكن، لكنه يعيد تنظيم la mémoire — فتصبح الحقيقة فيه بناءً شعرياً.","المفردات المحورية: l’autofiction (الأوتوفيكيشن)، l’Indochine (الهند الصينية الفرنسية)، la traversée du Mékong (عبور نهر ميكونغ)، le style épuré (الأسلوب المجرّد)، la mémoire (الذاكرة)، le silence، la mère (الأم المضطربة)، le frère aîné (الأخ الأكبر الطاغية)، le petit frère (الأخ الأصغر)، l’amant (العشيق الصيني)، la limousine (السيارة الفارهة)، l’enfance (الطفولة).","كتابة Duras هي le style épuré: جمل قصيرة، شبه اسمية، متجاورة بلا توابع — « Un jour, j’ai été appelé au directeur du lycée. » الناتج صوت يتذكّر دون أن يزيّن: la mémoire هي التي تعطي الإيقاع، لا قواعد الرواية الكلاسيكية.","عالم الكتاب مادي واجتماعي في آن واحد: حرارة المستعمرة، وفقر الأسرة، وعنصرية العبّار، وعنف الأخ الأكبر. la traversée du Mékong، الفصل المركزي، هي مشهد الانقلاب — الفتاة ذات قبعة الرجل تصعد إلى السيارة السوداء وتُختم la mémoire.","بعد الدرس، أعد قراءة الصفحات العشر الأولى دون البحث عن l’intrigue، ثم ضع تحت الأفعال في المضارع وle passé composé — ستكتشف أن Duras ترفض le passé simple للرواية التقليدية: التذكّر يتحدث في زمن المضارع.","خُلاصة الدرس: في نهاية الكتاب تعود كلمات l’amant — « Il dit qu’il m’aime toujours… » — ويتحول الوداع إلى جملة لا تُغلق أبداً: la mémoire تصبح انتظاراً أبدياً لا تذكّراً منتهياً."],"sub":[{"h":"l’autofiction et la mémoire","p":["L’Amant mélange faits vécus et réécriture.","La narratrice parle d’elle à la troisième personne.","Le livre obtient le Prix Goncourt en 1984."]},{"h":"le style épuré","p":["« Un jour, j’ai été appelé au directeur du lycée. »","Phrases courtes, juxtaposées, sans ornement.","La mémoire parle au présent, pas au passé simple."]},{"h":"le vocabulaire de l’enfance coloniale","p":["la traversée du Mékong — عبور ميكونغ","l’Indochine — الهند الصينية","le silence — الصمت"]}]},{"h":"les phrases de l’œuvre","p":["« Un jour, j’ai été appelé au directeur du lycée. » — l’incipit célèbre: une phrase simple, sans contexte, qui ouvre directement la mémoire.","La traversée du Mékong: la fille au chapeau d’homme observe la rivière pendant cinq jours — la scène centrale de la transformation.","« Il dit qu’il m’aime toujours. » — les mots de l’amant reviennent à la fin comme un rituel de mémoire: la phrase ne se ferme pas.","La narratrice dit « je » puis « elle » — l’ambiguïté du pronom est la signature de l’autofiction: distance et intimité à la fois."]},{"h":"التطبيق والتلخيص","p":["تمرين le style épuré: انسخ trois phrases courtes من l’incipit وحدّد فيها absence de subordonnée.","تمرين la comparaison: اشرح في 60 كلمة الفرق بين autobiographie et autofiction مع مثال من L’Amant.","اكتب paragraphe de 90 mots بالفرنسية تصف فيه une scène de mémoire من حياتك — مع 4 مفردات من la leçon et une phrase nominale."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: يشرح الدرس «العشيق» كـ autofiction: la réminiscence تنظم السرد بدل la chronologie، و la prime enfance coloniale تطبع la sobriété du style، و la matriarche والأخوة يملكون خلفية المشهد. أعد مشاهدة الفيديو الرئيسي وركّز على la traversée du Mékong وعلى la scène de la limousine.","جسر الدروس: من b2-t10-l13 (الأحمر والأسود — النفسُ تُقرأ عبر le contexte التاريخي والطبقي) إلى b2-t10-l14 (العشيق — التاريخُ يُقرأ عبر la réminiscence الشخصية)، ثم إلى b2-t10-l15 حيث «1984» لأورويل ينقل الكتابة من la réminiscence إلى la résistance politique ضد la novlangue.","مهمة تطبيقية: سجّل ملخّص العمل في دقيقة، استعمل 3 كلمات من الدرس (مثل la réminiscence و la sobriété و la prime enfance)، ثم قارن la traversée du Mékong في الفيديو بصفتك: أين تظهر la sobriété في الوصف؟"]}],"pron":[{"w":"l’autofiction","ipa":"[ɔtofiksjɔ̃]","approx":"أوتوفيكيسيون"},{"w":"la traversée","ipa":"[tʁavɛʁse]","approx":"ترافيرسي"},{"w":"le style épuré","ipa":"[stil epyʁe]","approx":"ستيل إبيوري"}],"vocab":[{"fr":"l’autofiction","ar":"الأوتوفيكيشن (رواية ذاتية مُختلقة)","pos":"nom","g":"f","exFr":"L’Amant est une autofiction, pas une autobiographie pure.","ipa":"[ɔtofiksjɔ̃]","exAr":"العشيق أوتوفيكيشن لا سيرة ذاتية خالصة."},{"fr":"l’Indochine","ar":"الهند الصينية الفرنسية","pos":"nom","g":"f","exFr":"L’enfance de Duras se passe en Indochine.","ipa":"[ɛ̃dɔʃin]","exAr":"طفولة دوراس تمرّ في الهند الصينية."},{"fr":"la traversée","ar":"العبور (من مكان إلى مكان)","pos":"nom","g":"f","exFr":"La traversée du Mékong dure cinq jours dans le récit.","ipa":"[tʁavɛʁse]","exAr":"عبور ميكونغ يستغرق خمسة أيام في السرد."},{"fr":"le Mékong","ar":"نهر ميكونغ","pos":"nom","g":"m","exFr":"Le fleuve Mékong sépare l’enfance de la rencontre.","ipa":"[mekɔ̃]","exAr":"نهر ميكونغ يفصل الطفولة عن اللقاء."},{"fr":"le style épuré","ar":"الأسلوب المجرّد والمقتصد","pos":"loc.","g":"m","exFr":"Le style épuré de Duras évite les subordonnées.","ipa":"","exAr":"أسلوب دوراس المجرّد يتجنّب الجمل التبعية."},{"fr":"la réminiscence","ar":"استحضار الماضي","pos":"nom","g":"f","exFr":"La réminiscence organise le récit plus que la chronologie.","exAr":"استحضار الماضي ينظّم السرد أكثر من التسلسل الزمني.","ipa":"[ʁeminisɑ̃s]"},{"fr":"le séducteur","ar":"الرجل المُغوِر","pos":"nom","g":"m","exFr":"Le séducteur chinois offre la voiture et le premier regard.","exAr":"الرجل الصيني المُغوِر يهدي السيارة وأول نظرة.","ipa":"[sedyktœʁ]"},{"fr":"la matriarche","ar":"ربّة العائلة","pos":"nom","g":"f","exFr":"La matriarche élève seule ses enfants dans la colonie.","exAr":"ترعى ربّة العائلة أولادها وحدها في المستعمرة.","ipa":"[matʁjaʁk]"},{"fr":"le frère aîné","ar":"الأخ الأكبر","pos":"nom","g":"m","exFr":"Le frère aîné domine la maison par la violence.","ipa":"[fʁɛʁ ɛne]","exAr":"الأخ الأكبر يسيطر على البيت بالعنف."},{"fr":"la parcimonie","ar":"الاقتصاد في التعبير","pos":"nom","g":"f","exFr":"La sobriété de Duras est une forme de vérité.","exAr":"اقتصاد دوراس في التعبير شكلٌ من أشكال الحقيقة.","ipa":"[sɔbʁijete]"},{"fr":"la limousine","ar":"السيارة الفارهة","pos":"nom","g":"f","exFr":"La limousine noire s’arrête près de la fille.","ipa":"[limuzin]","exAr":"السيارة السوداء تتوقف قرب الفتاة."},{"fr":"la prime enfance","ar":"الطفولة المبكرة","pos":"nom","g":"f","exFr":"La prime enfance coloniale marque toute l’œuvre.","exAr":"الطفولة المبكرة الاستعمارية تطبع العمل كله.","ipa":"[pʁimɑ̃fɑ̃s]"}],"examples":[{"fr":"« Un jour, j’ai été appelé au directeur du lycée. »","ar":"«يوماً ما، استُدعيتُ إلى مدير الثانوية.»","note":"l’incipit épuré"},{"fr":"Elle porte le chapeau d’homme de son amant.","ar":"تحمل قبعة الرجل من عشيقها.","note":"le symbole de la traversée"},{"fr":"La traversée du Mékong dure cinq jours dans le récit.","ar":"عبور ميكونغ يستغرق خمسة أيام في السرد.","note":"la scène centrale"},{"fr":"Duras refuse le passé simple du roman classique.","ar":"ترفض دوراس الماضي البسيط للرواية الكلاسيكية.","note":"le temps de la mémoire"},{"fr":"Le livre mélange les faits et la réécriture.","ar":"يخلط الكتاب بين الوقائع وإعادة الكتابة.","note":"la définition de l’autofiction"},{"fr":"« Il dit qu’il m’aime toujours. »","ar":"«يقول إنه يحبني دائماً.»","note":"le motif de l’attente"}],"grammar":[{"tFr":"Le style épuré: la phrase nominale et la parataxe","tAr":"الأسلوب المجرّد: الجملة الاسمية والتركيب التسلسلي بلا تابع","body":["une phrase nominale n’a pas de verbe conjugué: « Chapeau d’homme, blouse transparente, le regard presque masculin. » — Duras coupe tout développement pour laisser des images nues.","la parataxe juxtapose des propositions sans connecteurs ni subordonnées: l’effet est immédiat, proche de la parole parlée — c’est le secret du style épuré: la mémoire n’explique pas, elle montre."],"ex":[{"fr":"Chapeau d’homme, silencieuse, elle traverse le fleuve.","ar":"بقبعة رجل، صامتة، تعبر النهر."},{"fr":"Il parle, elle écoute, la voiture s’arrête, la nuit tombe.","ar":"يتكلم، تُنصت، تتوقف السيارة، يهبط الليل."}]},{"tFr":"Raconter au présent et au passé composé: la mémoire comme temps du récit","tAr":"السرد في المضارع والماضي التام: الذاكرة بوصفها زمن الحكي","body":["Duras écrit au présent de la mémoire: « Un jour, j’ai été appelé… » le passé composé remplace le passé simple — le souvenir est vécu comme actuel, pas comme histoire clos.","règle B2: dans l’autofiction, on évite le passé simple trop littéraire; le présent et le passé composé donnent l’impression d’une voix qui se souvient en parlant, au moment même de l’écriture."],"ex":[{"fr":"La mère parle de la maison, ses fils se taisent, la nuit tombe sur la colonie.","ar":"تتحدث الأم عن البيت، ويسكت الأبناء، وينزل الليل على المستعمرة."},{"fr":"J’ai pris le ferry, j’ai vu la limousine, j’ai su que ma vie changeait.","ar":"ركبت العبّارة، ورأيت السيارة، وعرفت أن حياتي تتغيّر."}]}],"mistakes":[{"wrong":"considérer L’Amant comme une simple histoire d’amour","right":"lire L’Amant comme une méditation sur la mémoire","why":"l’amour n’est qu’un épisode au cœur d’une réécriture de l’enfance."},{"wrong":"confondre autobiographie et autofiction","right":"l’autofiction mélange le vécu et l’invention","why":"Duras écrit « je » puis « elle »: distance et intimité se superposent."},{"wrong":"utiliser le passé simple dans un résumé du style de Duras","right":"employer le présent et le passé composé","why":"le souvenir parle au présent: « J’ai pris le ferry… »."},{"wrong":"traduire « le style épuré » par « style riche »","right":"le style épuré = sobre, court, sans ornement","why":"la sobriété de la phrase est la signature de Duras."}],"dialogues":[{"title":"la traversée du Mékong","ctx":"Sur le ferry, la fille au chapeau d’homme regarde le fleuve et la limousine noire.","lines":[{"who":"La narratrice","fr":"Je porte le chapeau d’homme, la blouse presque transparente.","ar":"أحمل قبعة الرجل والقميضة شبه الشفافة."},{"who":"La narratrice","fr":"Le fleuve coule pendant cinq jours, je ne dis rien.","ar":"يجري النهر خمسة أيام، ولا أنطق بشيء."},{"who":"L’homme","fr":"Montez dans la voiture, je vous conduis en ville.","ar":"اصعدا إلى السيارة، سأوصلكما إلى المدينة."},{"who":"La narratrice","fr":"Je sais que ma vie va changer ici, sur ce bateau.","ar":"أعلم أن حياتي ستتغيّر هنا، على هذا العبّار."}]},{"title":"les mots de l’amant","ctx":"Plus tard, à Paris, l’amant appelle et répète les mêmes mots.","lines":[{"who":"L’amant","fr":"Je vous aime toujours, je ne peux pas ne pas vous aimer.","ar":"أحبكِ دائماً، ولا أستطيع ألا أحبكِ."},{"who":"La narratrice","fr":"Les mêmes mots, chaque année, reviennent comme un rituel.","ar":"نفس الكلمات، كل عام، تعود كطقس متكرر."},{"who":"La narratrice","fr":"La mémoire ne ferme pas la phrase : elle la recommence.","ar":"الذاكرة لا تُغلق الجملة بل تعيد بدايتها."},{"who":"L’amant","fr":"Je vous attendrai tant que je pourrai.","ar":"سأنتظر ما استطعت."}]}],"exercises":[{"t":"mcq","skill":"listening","q":"ما الجملة التي تفتتح بها الرواية؟","opts":["Un jour, j’ai été appelé au directeur du lycée.","Il était une fois une famille pauvre.","Un jour, j’ai rencontré mon amour.","À Paris, la vie change."],"a":0,"why":"l’incipit célèbre de L’Amant يفتح مباشرةً على الذاكرة دون تمهيد."},{"t":"fill","skill":"grammar","q":"أكمل بالزمن المناسب لأسلوب Duras: «J’___ le ferry et j’ai vu la limousine.»","fr":"J’... le ferry et j’ai vu la limousine.","ans":"ai pris","why":"le passé composé remplace le passé simple dans l’autofiction de Duras."},{"t":"mcq","skill":"vocabulary","q":"ما معنى l’autofiction؟","opts":["un récit qui mêle le vécu et l’invention","un traité de psychologie","un récit de voyage purement documentaire","un roman policier autobiographique"],"a":0,"why":"l’autofiction est un récit à la première personne qui assume son mélange de vérité et de fiction."},{"t":"order","skill":"writing","q":"رتّب: عبور ميكونغ يفصل الطفولة عن اللقاء","words":["La","traversée","du","Mékong","sépare","l’enfance","de","la","rencontre."],"ans":"La traversée du Mékong sépare l’enfance de la rencontre.","why":"la scène du ferry est le pivot du récit de Duras."},{"t":"listen","skill":"listening","q":"أي جملة تصف le style épuré؟","opts":["Les phrases sont courtes et juxtaposées.","Les phrases sont longues et remplies de subordonnées.","Le texte utilise un vocabulaire technique.","Le récit est écrit au passé simple."],"a":0,"why":"le style épuré = phrases courtes, juxtaposées, sans ornement."},{"t":"translate","skill":"writing","q":"ترجم: «تحملتُ قبعة الرجل وقميضة شبه شفافة.»","ans":"Je porte le chapeau d’homme et la blouse presque transparente.","why":"la description physique de la fille au chapeau d’homme est la signature de la traversée."},{"t":"speaking","skill":"speaking","q":"Explique en trois phrases la différence entre autobiographie et autofiction.","target":"L’autobiographie raconte la vie vraie, l’autofiction mélange le vécu et l’invention, et L’Amant en est l’exemple.","why":"la définition mobilise les notions de vérité et de réécriture."},{"t":"correct","skill":"grammar","q":"صحّح: «Duras écrit l’histoire au passé simple.»","ans":"Duras écrit l’histoire au présent et au passé composé.","why":"le style de Duras refuse le passé simple: la mémoire parle au présent."}],"homework":"relis les dix premières pages de L’Amant، احتسب les phrases au présent et au passé composé، ثم اكتب 90 كلمة بالفرنسية تشرح فيها pourquoi le style épuré sert la mémoire — مع 4 مفردات من la leçon et une phrase nominale.","sources":[{"title":"L’Amant - Marguerite Duras | Résumé Complet - Analyse - Littérature - Podcast","channel":"VoixLivre","videoId":"1kuzkIoUKI4","why":"تحليل شامل لـ l’autofiction de Duras: l’enfance en Indochine, la traversée du Mékong, l’amant chinois et le style épuré — يمهّد لفهم l’écriture de la mémoire قبل القراءة.","cat":"Livres","level":"B2","main":true},{"title":"L’amant de Marguerite Duras — Résumé et analyse (format court)","channel":"L’essence des livres","videoId":"c_kd1AEc_i0","why":"ملخّص موجز وواضح لـ l’intrigue et les thèmes — مثالي قبل القراءة المتعمّقة.","cat":"Livres","level":"B2","extra":true},{"title":"De l’Indochine à la Résistance : écrire pour ne pas sombrer","channel":"Blockbuster Littérature","videoId":"7t4tVcRqAiE","why":"يضع l’œuvre dans son contexte التاريخي: l’Indochine coloniale et la vie de Duras — جسر بين الذاكرة والتاريخ.","cat":"Livres","level":"B2","extra":true}],"supplements":[{"id":"c_kd1AEc_i0","title":"L’amant de Marguerite Duras — Résumé et analyse (format court)","channel":"L’essence des livres","why":"ملخّص موجز وواضح لـ l’intrigue et les thèmes — مثالي قبل القراءة المتعمّقة.","lang":"fr","dur":9},{"id":"7t4tVcRqAiE","title":"De l’Indochine à la Résistance : écrire pour ne pas sombrer","channel":"Blockbuster Littérature","why":"يضع l’œuvre dans son contexte التاريخي: l’Indochine coloniale et la vie de Duras — جسر بين الذاكرة والتاريخ.","lang":"fr","dur":24}]},{"id":"b2-t10-l15","fr":"1984 — George Orwell (traduit en français)","ar":"1984 — جورج أورويل (مترجمة إلى الفرنسية)","objectives":["définir la dystopie et distinguer utopie, dystopie et roman d’anticipation dans 1984","analyser le conditionnel et l’imparfait de l’hypothèse: décrire un monde possible pour le juger","_acquire 12 كلمة أساسية autour du totalitarisme, de la surveillance, de la novlangue et de la liberté","expliquer comment la langue elle-même (la novlangue) devient un outil de contrôle dans le roman"],"sections":[{"h":"الدرس 15: تحليل «1984» لأورويل — الديستوبيا والسيطرة الشاملة","video":{"id":"orsWjqI29t4","title":"Résumé et Analyse de 1984 de Georges Orwell","channel":"Rémi El Profesor","why":"تحليل مدرسي لـ la dystopie: Winston, le Parti, la novlangue et le contrôle — يمهّد مباشرة لدراسة le totalitarisme et le vocabulaire de l’oppression.","lang":"fr","main":true,"dur":18},"p":["«1984» (1949) رواية dystopie نشرها George Orwell، صحفي ومكافح فاشي، في زمن صبغه الستالينية والنازية. تتخيل الرواية قوة خارقة — l’Océanie — يحكمها le Parti وزعيمه الشامل Big Brother: يُعاد كتابة التاريخ كل يوم، والفكرة جريمة، والنظام يدوم بالرعب والكذب.","المفردات المحورية: la dystopie (الديستوبيا)، le totalitarisme (الشمولية)، la surveillance (المراقبة)، Big Brother (الأخ الأكبر)، la novlangue (اللغة الجديدة المُبسطة سياسياً)، le Parti (الحزب)، le mensonge d’État (الكذب الرسمي)، le crime de pensée (جريمة الفكرة)، la chambre 101 (غرفة 101)، la liberté (الحرية)، le révisionnisme (تزييف التاريخ)، l’obéience (الطاعة العمياء).","يعمل Winston Smith في le Ministère de la Vérité على إعادة كتابة الصحف القديمة: كل تصحيح يقرّب الماضي من الحاضر — « 2 + 2 = 5 » ليس خطأً بل إعلان قوة: يريد le Parti السيطرة على الواقع لا على السياسة وحدها.","حبّ Winston وJulia فعل سياسي: غرفتهما المستأجرة فوق المحل جزيرة حرية في محيط من السيطرة — لكن السرد يكشف أن الدولة تستطيع الوصول إلى الفكرة الداخلية: فخ O’Brien ليس جسدياً بل نفسيّاً.","بعد الدرس، شاهد شرح la novlangue، ثم اذكر ثلاثة كلمات استبدلتها نوفلانغ (مثل: « libre » تصير « malpense ») — تدمير الكلمات هو تدمير الفكرة.","خُلاصة الدرس: الصفحة الأخيرة رجوع عن كل شيء: Winston، المقهور في la chambre 101، « يحب » أخيراً Big Brother. لا يمنحنا Orwell أي أمل — الرواية تحذير، لا حكاية أخلاقية."],"sub":[{"h":"la dystopie et le contrôle","p":["Big Brother vous surveille.","La liberté, c’est la liberté de dire que deux plus deux font quatre.","Le Parti contrôle la réalité, pas seulement le pouvoir."]},{"h":"la novlangue, arme du régime","p":["La novlangue réduit le vocabulaire pour réduire la pensée.","« Malpense » remplace « libre ».","Le mensonge devient vérité officielle."]},{"h":"le vocabulaire du totalitarisme","p":["le crime de pensée — جريمة الفكرة","la chambre 101 — غرفة 101","le révisionnisme — تزييف التاريخ"]}]},{"h":"les phrases et avertissements du roman","p":["« Big Brother vous surveille. » — l’affiche du régime: la surveillance n’est plus secrète, elle est officielle et permanente.","« 2 + 2 = 5. » — le slogan du Parti: la force du régime n’est pas de tromper, mais d’obliger à croire l’impossible.","« La liberté, c’est la liberté de dire que deux plus deux font quatre. » — la phrase de Winston: la vérité objective est le dernier refuge de la liberté.","« Si vous voulez une image du futur, imaginez une botte écrasant un visage — pour toujours. » — la vision sans espoir d’O’Brien: le pouvoir pour le pouvoir."]},{"h":"التطبيق والتلخيص","p":["تمرين la lecture critique: relis le passage de la novlangue et explique en 60 كلمة كيف تدمّر اللغة الفكرة.","تمرين le journal: اكتب une note de journal de Winston في 90 كلمة بالفرنسية مع استعمال la négation (ne…plus, ne…jamais).","قارن in 70 mots بين le Parti de 1984 et un régime historique — مع 4 مفردات من la leçon et une phrase au conditionnel."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: يعرض الدرس «1984» كديستوبيا مكتملة: la surveillance تُكتب بالشعار، و la novlangue تُقصّر la pensée، و l’indépendance تصبح le crime de pensée؛ la chambre 101 هي نهاية la docilité. أعد مشاهدة الفيديو الرئيسي وركّز على la scène de la chambre 101 وعلى la trahison finale.","جسر الدروس: من b2-t10-l14 (العشيق — la mémoire intime تصمد بأسلوبها المُقتضب) إلى b2-t10-l15 (1984 — la mémoire publique تُمحى ب violence le Parti)، ثم إلى b2-t10-l16 حيث «آنا كارنينا» لـ Tolstoï يعيد la passion individuelle إلى قلب المجتمع الراقي: الحبُّ يُحاكم اجتماعياً قبل أن يُحاكم نفسياً.","مهمة تطبيقية: سجّل ملخّص الرواية في دقيقة، اختر 3 كلمات من الدرس (مثل l’indépendance و la docilité)، ثم قارن شعارات le Parti في الفيديو بتحليلك: كيف تصنع la novlangue من l’indépendance جريمةً نفسية؟"]}],"pron":[{"w":"la dystopie","ipa":"[distɔpi]","approx":"ديستوبي"},{"w":"le totalitarisme","ipa":"[tɔtalitaʁism]","approx":"توتاليتاريسم"},{"w":"la novlangue","ipa":"[nɔvlɑ̃ɡ]","approx":"نوفلانغ"}],"vocab":[{"fr":"la dystopie","ar":"الديستوبيا (مجتمع متخيل مقمِع)","pos":"nom","g":"f","exFr":"1984 est une dystopie totale.","ipa":"[distɔpi]","exAr":"1984 ديسوبيا شاملة."},{"fr":"le totalitarisme","ar":"الشمولية","pos":"nom","g":"m","exFr":"Le totalitarisme de 1984 contrôle la pensée.","ipa":"[tɔtalitaʁism]","exAr":"الشمولية في 1984 تسيطر على الفكرة."},{"fr":"la surveillance","ar":"المراقبة","pos":"nom","g":"f","exFr":"La surveillance du Parti ne dort jamais.","ipa":"[syʁvejɑ̃s]","exAr":"مراقبة الحزب لا تنام أبداً."},{"fr":"Big Brother","ar":"الأخ الأكبر (رمز الحاكم)","pos":"nom","g":"m","exFr":"Big Brother vous surveille, dit l’affiche.","ipa":"[big bʁʌðœʁ]","exAr":"يقول الملصق: الأخ الأكبر يراقبك."},{"fr":"la novlangue","ar":"اللغة الجديدة (لغة الحزب)","pos":"nom","g":"f","exFr":"La novlangue réduit la pensée en réduisant les mots.","ipa":"[nɔvlɑ̃ɡ]","exAr":"اللغة الجديدة تقلّص الفكرة بتقليل الكلمات."},{"fr":"le Parti","ar":"الحزب الحاكم","pos":"nom","g":"m","exFr":"Le Parti réécrit l’histoire chaque jour.","ipa":"[paʁti]","exAr":"يعيد الحزب كتابة التاريخ كل يوم."},{"fr":"le crime de pensée","ar":"جريمة الفكرة","pos":"loc.","g":"m","exFr":"Le crime de pensée est puni par la chambre 101.","ipa":"","exAr":"جريمة الفكرة يعاقب عليها بغرفة 101."},{"fr":"la chambre 101","ar":"غرفة 101 (غرفة التعذيب)","pos":"nom","g":"f","exFr":"La chambre 101 révèle la peur la plus intime.","ipa":"[ʃɑ̃bʁ ɔ̃s]","exAr":"تكشف غرفة 101 أشد الخوف داخلياً."},{"fr":"le révisionnisme","ar":"تزييف التاريخ","pos":"nom","g":"m","exFr":"Le révisionnisme transforme le passé en outil politique.","ipa":"[ʁəvizjɔnism]","exAr":"يحوّل تزييف التاريخ الماضي إلى أداة سياسية."},{"fr":"l’indépendance","ar":"الاستقلالية","pos":"nom","g":"f","exFr":"L’indépendance de la pensée résiste à la novlangue.","exAr":"استقلالية الفكر تصمد أمام النوفلاينغ.","ipa":"[ɛ̃depɑ̃dɑ̃s]"},{"fr":"le mensonge d’État","ar":"الكذب الرسمي","pos":"nom","g":"m","exFr":"Le mensonge d’État devient une vérité.","ipa":"","exAr":"يصبح الكذب الرسمي حقيقة."},{"fr":"la docilité","ar":"الذوبان في الطاعة","pos":"nom","g":"f","exFr":"La docilité sans pensée est l’idéal du Parti.","exAr":"الذوبان في الطاعة دون تفكير هو مثال الحزب.","ipa":"[dɔsilite]"}],"examples":[{"fr":"Winston réécrit les journaux anciens au Ministère de la Vérité.","ar":"يُعيد وينستون كتابة الصحف القديمة في وزارة الحقيقة.","note":"le révisionnisme"},{"fr":"Big Brother vous surveille, dit l’affiche.","ar":"يقول الملصق: الأخ الأكبر يراقبك.","note":"la surveillance officielle"},{"fr":"2 + 2 = 5 est un ordre, pas une erreur.","ar":"اثنان زائد اثنان يساوي خمسة هو أمر لا خطأ.","note":"le contrôle de la réalité"},{"fr":"Si tu pensais contre le Parti, tu étais déjà coupable.","ar":"لو فكرتَ ضد الحزب لكان الذنب قد وقع.","note":"l’hypothèse du crime de pensée"},{"fr":"La novlangue supprime les mots pour supprimer les idées.","ar":"تستبدل نوفلانغ الكلمات لتطوّي الأفكار.","note":"la langue comme contrôle"},{"fr":"Winston finit par aimer Big Brother.","ar":"ينتهي الأمر بأن يحب وينستون الأخ الأكبر.","note":"le reniement final"}],"grammar":[{"tFr":"L’hypothèse avec « si » et le conditionnel: décrire un monde pour le juger","tAr":"الافتراض باستخدام «si» والفعل الشرطي: تصوّر مجتمع لتحكم عليه","body":["la dystopie se construit souvent avec « si » + imparfait et le conditionnel: « Si le Parti contrôlait la mémoire, il contrôlerait le passé. » — le conditionnel montre le monde possible que le roman met en accusation.","règle B2: après « si », jamais de conditionnel — on emploie l’indicatif (présent ou imparfait); la conséquence, elle, peut porter le conditionnel: « Si tu désobéissais, tu serais arrêté. »"],"ex":[{"fr":"Si le Parti contrôlait le passé, il contrôlerait l’avenir.","ar":"لو سيطر الحزب على الماضي لسيطر على المستقبل."},{"fr":"Si tu lisais le journal interdit, tu serais arrêté.","ar":"لو قرأتَ الصحيفة المحظورة لكان الاعتقال حتمياً."}]},{"tFr":"La négation et la restriction: ne…plus, ne…jamais, ne…que","tAr":"النفي والتقييد: «ne…plus» و«ne…jamais» و«ne…que»","body":["la langue du régime est une langue de la privation: « Winston n’a plus de passé », « il n’a jamais vu de vrai livre », « il ne reste que le présent du Parti ». Chaque structure nie une liberté concrète: le temps, la mémoire, la lecture.","attention B2: « ne…que » n’est pas une négation mais une restriction (« il ne reste que deux mots » = seuls deux mots); sa place est avant le verbe — fréquent dans l’analyse du contrôle de la novlangue."],"ex":[{"fr":"Winston n’a plus de mémoire : le Parti lui vole le passé.","ar":"لم يعد لوينستون ذاكرة: الحزب يسرق منه الماضي."},{"fr":"Il ne reste que deux mots pour dire la liberté en novlangue.","ar":"لا يتبقى إلا كلمتان لقول الحرية في نوفلانغ."}]}],"mistakes":[{"wrong":"appeler 1984 un roman de science-fiction","right":"appeler 1984 une dystopie","why":"le roman ne décrit pas la technique mais la structure du pouvoir totalitaire."},{"wrong":"dire « si tu serais arrêté… »","right":"si tu désobéissais, tu serais arrêté","why":"après « si », jamais de conditionnel: on emploie l’imparfait."},{"wrong":"traduire « ne…que » par une simple négation","right":"« ne…que » = « seulement »","why":"dans « il ne reste que deux mots », il s’agit d’une restriction, pas d’un refus."},{"wrong":"croire que la novlangue est une jargon technique","right":"la novlangue est une langue politique appauvrie","why":"elle supprime les mots pour supprimer la possibilité de penser contre le Parti."}],"dialogues":[{"title":"la conversation interdite","ctx":"Winston et Julia se parlent pour la première fois dans la campagne, loin des téléviseurs.","lines":[{"who":"Julia","fr":"Le Parti dit que la liberté n’existe pas.","ar":"يقول الحزب إن الحرية غير موجودة."},{"who":"Winston","fr":"La liberté, c’est de dire que deux plus deux font quatre.","ar":"الحرية هي أن تقول إن اثنين زائد اثنين أربعة."},{"who":"Julia","fr":"Si tu crois cela, ils te chercheront.","ar":"إن صدّقته فسيبحثون عنك."},{"who":"Winston","fr":"Je n’ai plus peur : j’aime encore la vérité.","ar":"لم أعد أخاف: ما زلت أحب الحقيقة."}]},{"title":"la chambre 101","ctx":"O’Brien torture Winston pour briser sa pensée intérieure.","lines":[{"who":"O’Brien","fr":"Nous ne voulons pas tuer ta pensée : nous voulons la changer.","ar":"لا نريد قتل فكرك بل تغييره."},{"who":"Winston","fr":"Deux plus deux font quatre, même ici.","ar":"اثنان زائد اثنان أربعة، حتى هنا."},{"who":"O’Brien","fr":"Si tu le crois, tu auras raison — si le Parti le décide.","ar":"إن صدّقته فستكون على حق — إن قرر الحزب ذلك."},{"who":"Winston","fr":"Non, la réalité reste la même.","ar":"لا، الواقع يبقى كما هو."}]}],"exercises":[{"t":"mcq","skill":"listening","q":"ما الجملة التي تلخّص مفهوم la dystopie؟","opts":["Un monde idéal réalisé.","Un monde imaginé pour nous prévenir du pire.","Un conte moral pour enfants.","Un récit d’aventures scientifiques."],"a":1,"why":"la dystopie décrit un monde pire que le nôtre pour nous avertir: le premier choix décrit l’utopie, pas la dystopie."},{"t":"fill","skill":"grammar","q":"أكمل الشرط: «Si le Parti contrôlait le passé, il ___ le futur.»","fr":"Si le Parti contrôlait le passé, il ... le futur.","ans":"contrôlerait","why":"si + imparfait, la conséquence au conditionnel: la structure classique de l’hypothèse."},{"t":"mcq","skill":"vocabulary","q":"ما معنى la novlangue؟","opts":["une langue politique qui appauvrit le vocabulaire","un journal officiel","un code secret militaire","une ancienne langue classique"],"a":0,"why":"اللغة الجديدة تقلّص الكلمات لتقليل قدرة الفكر على المقاومة."},{"t":"order","skill":"writing","q":"رتّب: اللغة الجديدة تقلّص الفكر بتقليل الكلمات","words":["La","novlangue","réduit","la","pensée","en","réduisant","les","mots."],"ans":"La novlangue réduit la pensée en réduisant les mots.","why":"c’est la thèse centrale d’Orwell sur le langage et le pouvoir."},{"t":"listen","skill":"listening","q":"أي جملة تصف le crime de pensée؟","opts":["Penser contre le Parti est déjà coupable.","Seul le crime puni par la loi est grave.","On peut penser librement chez soi.","La chambre 101 est une salle de classe."],"a":0,"why":"في 1984 الفكرة وحدها جريمة قبل أي فعل."},{"t":"translate","skill":"writing","q":"ترجم: «لو سيطر الحزب على الماضي لسيطر على المستقبل.»","ans":"Si le Parti contrôlait le passé, il contrôlerait l’avenir.","why":"si + imparfait et conditionnel: la phrase exprime une hypothèse générale."},{"t":"speaking","skill":"speaking","q":"Explique en trois phrases pourquoi 1984 est une avertissement et non un conte.","target":"1984 est un avertissement parce qu’il décrit un régime totalitaire qui contrôle la vérité et la langue, donc chaque lecteur doit garder son esprit critique.","why":"la réponse mobilise le totalitarisme, la novlangue et la liberté de penser."},{"t":"correct","skill":"grammar","q":"صحّح: «Si tu serais arrêté, tu aimerais la liberté.»","ans":"Si tu étais arrêté, tu aimerais la liberté.","why":"après « si », on emploie l’imparfait (étais), jamais le conditionnel (serais)."}],"homework":"اكتب une note de journal de Winston في 90 كلمة بالفرنسية: استخدام ne…plus et ne…jamais وune phrase avec « si » + imparfait + conditionnel، مع 4 مفردات من la leçon وتفسير قصير لـ la novlangue.","sources":[{"title":"Résumé et Analyse de 1984 de Georges Orwell","channel":"Rémi El Profesor","videoId":"orsWjqI29t4","why":"تحليل مدرسي لـ la dystopie: Winston, le Parti, la novlangue et le contrôle — يمهّد مباشرة لدراسة le totalitarisme et le vocabulaire de l’oppression.","cat":"Livres","level":"B2","main":true},{"title":"La novlangue de 1984 (G. Orwell)","channel":"Linguisticae","videoId":"4uXXI7yaF1I","why":"شرح معمّق لـ la novlangue: كيف تُدمَّر الفكرة عبر تدمير الكلمات — تكملة مباشرة لدرس le contrôle linguistique.","cat":"Livres","level":"B2","extra":true},{"title":"1984 de George Orwell — Analyse des thèmes","channel":"Gloria Lauzanne Cours de français","videoId":"NcMDOzVJAuQ","why":"تحليل les thèmes: la surveillance, le mensonge et le révisionnisme — دعامة لفهم le totalitarisme.","cat":"Livres","level":"B2","extra":true}],"supplements":[{"id":"4uXXI7yaF1I","title":"La novlangue de 1984 (G. Orwell)","channel":"Linguisticae","why":"شرح معمّق لـ la novlangue: كيف تُدمَّر الفكرة عبر تدمير الكلمات — تكملة مباشرة لدرس le contrôle linguistique.","lang":"fr","dur":45},{"id":"NcMDOzVJAuQ","title":"1984 de George Orwell — Analyse des thèmes","channel":"Gloria Lauzanne Cours de français","why":"تحليل les thèmes: la surveillance, le mensonge et le révisionnisme — دعامة لفهم le totalitarisme.","lang":"fr","dur":18}]},{"id":"b2-t10-l16","fr":"Anna Karénine — Léon Tolstoï (traduit en français)","ar":"آنا كارنينا — ليون تولستوي (ترجم إلى الفرنسية)","objectives":["تمييز l’imparfait (le quotidien mondain) عن le passé simple (la décision qui change un destin) في le récit du roman","_acquire 12 كلمة أساسية حول l’amour, l’adultère, la passion, la société, le deuil social, la traduction","تحليل la construction parallèle de deux couples: Anna–Vronski (la passion) et Levin–Kitty (le mariage)","تفسير لماذا تُقرأ «Anna Karénine» في فرنسا عبر la traduction d’Émile Monsieur ولماذا الترجمة جزء من تاريخ الرواية نفسها"],"sections":[{"h":"الدرس 16: تحليل «آنا كارنينا» — الرواية الروسية والحب والمجتمع وفنّ الترجمة","video":{"id":"LrnEYfd_5ug","title":"Comprendre Anna Karénine (Tolstoï) en moins de 10 minutes (Résumé-analyse)","channel":"Le Mock","why":"عرض مدرسي مكثّف يبني le récit من البداية إلى النهاية: le couple Anna–Vronski مقابل le couple Levin–Kitty، ثم la structure du roman ثم le thème central — يمهّد لتحليل les temps du récit.","lang":"fr","main":true,"dur":5},"p":["«Anna Karénine» (1877) ليست قصة حبّ بسيطة، بل le roman de la société russe au XIXe siècle: تفتح الرواية بجملتها الخالدة « Toutes les familles heureuses se ressemblent ; chaque famille malheureuse l’est à sa façon. » — la famille d’Oblonsky تنهار لأنAnna أحبّت Vronski، لكن Tolstoï يبني على الجرح عالماً كاملاً من les salons, les propriétés campagnardes et les gares.","المفردات المحورية: l’adultère (الزنا/الخيانة الزوجية)، la passion (الشغف)، la société (المجتمع الراقي)، le comte (الكونت)، le deuil social (العزاء المجتمعي)، le remords (الندم)، la jalousie (الغيرة)، traduire (يترجم)، le traducteur (المترجم)، le destin (القدر)، l’épouse (الزوجة)، le train (القطار).","بنية الرواية تقوم على la construction parallèle: مقابل آنا، يظهر Levin الذي يبحث عن معنى la vie dans le travail des champs et le mariage avec Kitty. هذان المساران يكملان بعضهما: آنا تدفع الثمن الاجتماعي لحبّها، وLevin يجد la réponse dans la vie simple — « Il faut vivre selon la lumière. »","نحوياً، لاحظ le rythme des temps littéraires: l’imparfait يرسم la scène mondaine (« Les invités arrivaient… »)، ثم le passé simple يعلّم le virage (« Anna aperçut Vronski à la gare. »)، ثم le plus-que-parfait يربط الأحداث السابقة بقرار لاحق — هذا التناوب هو عصب le récit الطويل.","التاريخ والترجمة جزءان من الدرس: la première traduction française complète للكتاب من توقيع Émile Monsieur (1878) هي التي رسمت صورة آنا للأجيال الفرنسية، وكل ترجمة جديدة تعيد قراءة le style de Tolstoï: la phrase longue، le discours indirect libre، et les dialogues.","بعد الدرس، أعد الاستماع إلى la scène de la gare بدون sous-titres، ثم اكتب les trois étapes de la chute d’Anna (le premier meeting, la nuit à Moscou, la rupture) في ثلاث جمل بالفرنسية — la tâche الأولى هي la reconnaissance de la structure avant le commentaire."],"sub":[{"h":"l’amour face à la société","p":["Anna aime Vronski, mais la société de Saint-Pétersbourg ne pardonne pas.","Le deuil social pèse plus lourd que le remords.","La passion est un crime mondain avant d’être une faute morale."]},{"h":"les temps du roman","p":["l’imparfait: « Les invités arrivaient au bal. »","le passé simple: « Anna aperçut Vronski. »","L’alternance donne le rythme du récit long."]},{"h":"le train, signe du destin","p":["La gare annonce déjà la catastrophe finale.","Le train relie Moscou et Saint-Pétersbourg.","Tolstoï fait du train un motif du destin moderne."]}]},{"h":"les phrases clés d’Anna Karénine","p":["« Toutes les familles heureuses se ressemblent ; chaque famille malheureuse l’est à sa façon. » — la phrase d’ouverture qui annonce le programme de tout le roman.","« Si c’est toi qui me poses la question, c’est que tu sais déjà la réponse. » — la phrase de Karenin à Anna: la souffrance formulée sans cris, la conscience lucide du mensonge.","« Je voudrais mourir. » — la phrase qui marque la chute d’Anna: la passion ne mène plus qu’à soi-même.","« Il faut vivre selon la lumière. » — la réponse de Levin, l’anti-Anna: le sens de la vie se trouve dans le travail et la famille, pas dans la passion mondaine."]},{"h":"التطبيق والتلخيص","p":["تمرين la réécoute: شغّل la scène de la gare بدون sous-titres، ثم حدّد les mots qui reviennent (le train, la fumée, le regard) واكتبها في قائمة.","تمرين la comparaison: قارن في 60 كلمة بين آنا وLevin: أين يبحث كلٌّ منهما عن la vérité — dans la passion ou dans la vie quotidienne؟","اكتب paragraphe de 90 mots بالفرنسية تشرح فيه لماذا le deuil social يقتل آنا أكثر من la loi، مستعملاً 4 مفردات من la leçon et une phrase au passé simple."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: يقرأ الدرس «آنا كارنينا» كرواية la passion et la société: l’élan vers Vronski يفتح باب la suspicion، و le remords يتحول إلى l’amertume، و Levin يشكل المسار المقابل؛ و la traduction الفرنسية تكشف حِرفة le traducteur. أعد مشاهدة الفيديو الرئيسي وركّز على la scène du train وعلى la chute finale d’Anna.","جسر الدروس: من b2-t10-l15 (1984 — الحريةُ تُمحى بواسطة la surveillance et le mensonge d’État) إلى b2-t10-l16 (آنا كارنينا — الحريةُ تُحاكم بواسطة la société et le deuil social)، ثم إلى b2-t10-l17 حيث «اسم الوردة» لـ Eco ينقل la suspicion إلى le cloître: لغزُ المخطوطات يحلّ محل لغز la passion.","مهمة تطبيقية: سجّل ملخّص الرواية في دقيقة، استعمل 3 كلمات من الدرس (مثل l’égarement و l’élan و l’amertume)، ثم قارن la scène du départ de la gare في الفيديو بالcontraste que construit Tolstoï بين Anna et Levin."]}],"pron":[{"w":"l’élan","ipa":"[elɑ̃]","approx":"إلان"},{"w":"l’égarement","ipa":"[egaʁmɑ̃]","approx":"يغارْمان"},{"w":"le désespoir","ipa":"[dezɛspwaʁ]","approx":"دزيسپوار"}],"vocab":[{"fr":"le roman","ar":"الرواية","pos":"nom","g":"m","exFr":"Anna Karénine est un roman de la société russe.","ipa":"[ʁɔmɑ̃]","exAr":"آنا كارنينا رواية عن المجتمع الروسي."},{"fr":"l’élan","ar":"الاندفاع العاطفي","pos":"nom","g":"m","exFr":"L’élan d’Anna pour Vronski défie la société.","exAr":"اندفاع آنا تجاه فيرونسكي يتحدى المجتمع.","ipa":"[elɑ̃]"},{"fr":"l’égarement","ar":"الضلال العاطفي","pos":"nom","g":"m","exFr":"L’égarement d’Anna ouvre le livre de son malheur.","exAr":"ضلال آنا يفتح كتاب مأساتها.","ipa":"[egaʁmɑ̃]"},{"fr":"la société","ar":"المجتمع الراقي","pos":"nom","g":"f","exFr":"La société de Saint-Pétersbourg la condamne sans pitié.","ipa":"[sɔsjete]","exAr":"مجتمع سانت بطرسبرغ يدينها بلا رحمة."},{"fr":"le comte","ar":"الكونت والنبيل","pos":"nom","g":"m","exFr":"Le comte Karenin est un haut fonctionnaire respecté.","ipa":"[lə kɔ̃t]","exAr":"الكونت كارنين موظف رفيع مرموق."},{"fr":"le deuil social","ar":"العزلة المجتمعيّة","pos":"loc.","g":"m","exFr":"Le deuil social ferme à Anna toutes les portes.","ipa":"[dœj sɔsjal]","exAr":"العزلة المجتمعية تغلق أمام آنا كل الأبواب."},{"fr":"l’amertume","ar":"المرارة","pos":"nom","g":"f","exFr":"L’amertume ronge Anna avant le désespoir.","exAr":"المرارة تتآكل بها آنا قبل اليأس.","ipa":"[amɛʁtym]"},{"fr":"la suspicion","ar":"الارتياب","pos":"nom","g":"f","exFr":"La suspicion détruit peu à peu son amour.","exAr":"الارتياب يدمر حبّها شيئاً فشيئاً.","ipa":"[sypisjɔ̃]"},{"fr":"traduire","ar":"يُترجم","pos":"verbe","g":"","exFr":"Émile Monsieur a traduit le roman en français.","ipa":"[tʁadɥiʁ]","exAr":"أميل مونسييه ترجم الرواية إلى الفرنسية."},{"fr":"le traducteur","ar":"المترجم","pos":"nom","g":"m","exFr":"Le traducteur doit rendre la phrase longue de Tolstoï.","ipa":"[tʁadɥiktœʁ]","exAr":"على المترجم أن ينقل الجملة الطويلة عند تولستوي."},{"fr":"le destin","ar":"القدر","pos":"nom","g":"m","exFr":"La gare est dans le roman le signe du destin.","ipa":"[dɛstɛ̃]","exAr":"المحطة في الرواية علامة القدر."},{"fr":"l’épouse","ar":"الزوجة","pos":"nom","g":"f","exFr":"L’épouse de Karenin refuse de le quitter.","ipa":"[epuz]","exAr":"زوجة كارنين ترفض أن تتركه."}],"examples":[{"fr":"Toutes les familles heureuses se ressemblent.","ar":"كل الأسر السعيدة تتشابه.","note":"la phrase d’ouverture du roman"},{"fr":"Anna aperçut Vronski à la gare de Moscou.","ar":"رأت آنا فرونكي في محطة موسكو.","note":"le passé simple de l’événement fondateur"},{"fr":"Les invités arrivaient au bal et riaient.","ar":"كان الضيوف يصلون إلى الحفل ويضحكون.","note":"l’imparfait du décor mondain"},{"fr":"Si c’est toi qui me poses la question, tu sais déjà la réponse.","ar":"إن كنت أنت من يسألني السؤال، فإنك تعرف الجواب سلفاً.","note":"la phrase de Karenin, lucide et blessée"},{"fr":"La passion d’Anna défie les conventions de la société.","ar":"شغف آنا يتحدى عرف المجتمع.","note":"le thème central du roman"},{"fr":"Le traducteur cherche l’équivalent français de la phrase russe.","ar":"يبحث المترجم عن البديل الفرنسي للجملة الروسية.","note":"la traduction comme relecture"}],"grammar":[{"tFr":"Les temps littéraires du roman: imparfait, passé simple, plus-que-parfait","tAr":"أزمنة الرواية: الوصف في المضارع التام والحدث في الماضي البسيط والمصبّر في الماضي التام","body":["dans un roman comme Anna Karénine, l’imparfait peint ce qui dure: les salons, les habitudes, les états d’âme (« Anna regardait la foule… »), tandis que le passé simple signale ce qui fait avancer l’histoire (« Vronski la suivit. ») — le lecteur apprend à lire le récit à travers ce contraste.","le plus-que-parfait ajoute une troisième couche: l’antériorité lointaine (« Elle avait promis de ne plus le revoir, mais elle était revenue ») — dans une histoire de mémoire et de regrets, ce temps devient presque un personnage du récit."],"ex":[{"fr":"Anna regardait la foule quand Vronski s’approcha.","ar":"كانت آنا تراقب الحشد حين اقترب فرونكي."},{"fr":"Elle avait promis de ne plus le revoir, mais elle revint.","ar":"كانت قد وعدت ألّا تراه ثانيةً، لكنها عادت."}]},{"tFr":"Le discours indirect libre: la voix du narrateur et du personnage","tAr":"الحديث غير المباشر الحرّ: صوت الراوي ويتمازج مع صوت الشخصية","body":["Tolstoï maîtrise le discours indirect libre: le narrateur semble rapporter les pensées du personnage sans verbe introducteur — « Que faire ? Mon Dieu, que faire ? » : la voix d’Anna se glisse dans le récit sans guillemets ni « elle dit que ».","pour l’apprenant B2, repérer ce procédé évite deux erreurs: croire qu’il s’agit d’un dialogue direct, ou effacer la distance entre le narrateur et le personnage — le style indirect libre est la signature du grand roman psychologique."],"ex":[{"fr":"Elle pensa : « Il faut que je parte. » → Elle pensa qu’il fallait qu’elle parte.","ar":"قالت في نفسها: « عليّ أن أرحل. » ثم غيّرناها إلى: إن عليّ أن أرحل."},{"fr":"Le narrateur dit : elle n’aurait jamais dû revenir à Saint-Pétersbourg.","ar":"الراوي ينقل أنها ما كان ينبغي أن تعود إلى سانت بطرسبرغ أبداً."}]}],"mistakes":[{"wrong":"lire le roman comme une simple histoire d’amour","right":"lire le roman comme une peinture de la société","why":"la passion d’Anna n’existe que face au deuil social: c’est le conflit qui structure le livre."},{"wrong":"tout mettre au passé simple dans le résumé","right":"alterner imparfait, passé simple et plus-que-parfait","why":"les temps littéraires distinguent le décor, l’événement et l’antériorité."},{"wrong":"traduire « le deuil social » par « tristesse »","right":"le deuil social = l’exclusion du monde mondain","why":"il ne s’agit pas d’une émotion privée, mais d’une condamnation collective."},{"wrong":"dire « Anna regrettait qu’elle serait revenue »","right":"Anna regrettait qu’elle fût revenue.","why":"après une proposition subordonnée exprimant le regret, on emploie le subjonctif imparfait dans la langue soutenue."}],"dialogues":[{"title":"la gare de Moscou","ctx":"Anna rencontre Vronski pour la première fois","lines":[{"who":"Anna","fr":"Je dois rentrer à Saint-Pétersbourg ce soir.","ar":"عليّ أن أعود إلى سانت بطرسبرغ الليلة."},{"who":"Vronski","fr":"Le train part dans une heure ; je vous accompagne au quai.","ar":"يغادر القطار بعد ساعة؛ سأرافقك إلى الرصيف."},{"who":"Anna","fr":"Ce bruit de machine est assourdissant, n’est-ce pas ?","ar":"صوت المحرّك صاخب، أليس كذلك؟"},{"who":"Vronski","fr":"Oui, mais il cache d’autres bruits, ceux du cœur.","ar":"نعم، لكنه يخفي أصواتاً أخرى، أصوات القلب."}]},{"title":"la phrase de Karenin","ctx":"Karenin devine la vérité et interroge Anna","lines":[{"who":"Karenin","fr":"Je n’ai qu’une question à te poser.","ar":"ليس لديّ سوى سؤال واحد أطرحه عليك."},{"who":"Karenin","fr":"Si c’est toi qui me poses la question, tu sais déjà la réponse.","ar":"إن كنت أنت من يسألني، فإنك تعرف الجواب سلفاً."},{"who":"Anna","fr":"Je ne veux pas comprendre ce que tu sous-entends.","ar":"لا أريد أن أفهم ما تلمّح إليه."},{"who":"Karenin","fr":"Alors laisse-moi au moins protéger notre nom.","ar":"دعني إذن أحمِ اسمنا على الأقل."}]}],"exercises":[{"t":"mcq","skill":"listening","q":"ما الجملة التي تلخّص النزاع بين آنا ومجتمعها؟","opts":["La passion d’Anna défie les conventions.","Le train arrive toujours à l’heure.","Karenin écrit des romans.","Levin habite à Moscou."],"a":0,"why":"الصراع في الرواية بين la passion et les conventions de la société."},{"t":"fill","skill":"grammar","q":"أكمل بالزمن المناسب: «Anna ___ la foule quand Vronski s’approcha.»","fr":"Anna ... la foule quand Vronski s’approcha.","ans":"regardait","why":"l’imparfait peint la scène en cours avant l’événement ponctuel au passé simple."},{"t":"mcq","skill":"vocabulary","q":"ما معنى « le deuil social »؟","opts":["l’exclusion du monde mondain","la mort d’un proche","un deuil religieux","le silence d’un salon"],"a":0,"why":"le deuil social désigne la fermeture des portes mondaines après l’adultère."},{"t":"order","skill":"writing","q":"رتّب: كل الأسر السعيدة تتشابه، وكل أسرة غير سعيدة هي كذلك على طريقتها","words":["Toutes","les","familles","heureuses","se","ressemblent;","chaque","famille","malheureuse","l’est","à","sa","façon."],"ans":"Toutes les familles heureuses se ressemblent; chaque famille malheureuse l’est à sa façon.","why":"c’est la phrase d’ouverture: la structure parallèle annonce les deux couples du roman."},{"t":"listen","skill":"listening","q":"أي زمن يستعمل Tolstoï pour le décor mondain؟","opts":["l’imparfait","le futur simple","le conditionnel","le présent de l’impératif"],"a":0,"why":"l’imparfait peint ce qui dure: les salons, les habitudes, les états d’âme."},{"t":"translate","skill":"writing","q":"ترجم: «لو كنتَ أنت من يسألني، فستعرف الجواب سلفاً.»","ans":"Si c’est toi qui me poses la question, tu sais déjà la réponse.","why":"c’est la phrase de Karenin: le style soutenu évite les exclamations."},{"t":"speaking","skill":"speaking","q":"اشرح بالفرنسية في ثلاث جمل لماذا تُعدّ آنا شخصية مأساوية.","target":"Anna est tragique parce que sa passion la sépare de la société et qu’elle perd tout, même elle-même.","why":"l’explication mobilise le lien entre la passion, le deuil social et la chute."},{"t":"correct","skill":"grammar","q":"صحّح: «Anna regrette qu’elle serait revenue à Saint-Pétersbourg.»","ans":"Anna regrette qu’elle fût revenue à Saint-Pétersbourg.","why":"après « regretter que », on emploie le subjonctif (imparfait dans la langue soutenue), jamais le conditionnel."}],"homework":"استمع إلى la scène de la gare ثلاث مرات بدون sous-titres، اكتب les trois étapes de la chute d’Anna في ثلاث جمل بالفرنسية، ثم اختر une phrase du roman وشرحها في ثلاث جمل مع بيان زمنها الأدبي.","sources":[{"title":"Comprendre Anna Karénine (Tolstoï) en moins de 10 minutes (Résumé-analyse)","channel":"Le Mock","videoId":"LrnEYfd_5ug","why":"عرض مدرسي مكثّف يبني le récit من البداية إلى النهاية: le couple Anna–Vronski مقابل le couple Levin–Kitty، ثم la structure du roman ثم le thème central — يمهّد لتحليل les temps du récit.","cat":"Livres","level":"B2","main":true},{"title":"Anna Karénine - Léon Tolstoï | Résumé Complet - Analyse - Littérature - Podcast","channel":"VoixLivre","videoId":"wC_4dQijSKk","why":"podcast يبني le récit كاملاً ثم يعلّق عليه — مثالي لتتبّع la structure parallèle des deux couples.","cat":"Livres","level":"B2","extra":true},{"title":"Redécouvrez les plus grands classiques de la littérature Russe !","channel":"La Grande Librairie - France Télévisions","videoId":"cpX78sxAZJM","why":"يضع الرواية في سياقها: la littérature russe du XIXe siècle، Pouchkine، Dostoïevski، puis la lecture française via la traduction.","cat":"Livres","level":"B2","extra":true}],"supplements":[{"id":"wC_4dQijSKk","title":"Anna Karénine - Léon Tolstoï | Résumé Complet - Analyse - Littérature - Podcast","channel":"VoixLivre","why":"podcast يبني le récit كاملاً ثم يعلّق عليه — مثالي لتتبّع la structure parallèle des deux couples.","lang":"fr","dur":11},{"id":"cpX78sxAZJM","title":"Redécouvrez les plus grands classiques de la littérature Russe !","channel":"La Grande Librairie - France Télévisions","why":"يضع الرواية في سياقها: la littérature russe du XIXe siècle، Pouchkine، Dostoïevski، puis la lecture française via la traduction.","lang":"fr","dur":15}]},{"id":"b2-t10-l17","fr":"Le Nom de la rose — Umberto Eco (traduit en français)","ar":"اسم الوردة — أمبرتو إيكو (ترجم إلى الفرنسية)","objectives":["استعمال le subjonctif بعد les verbes de doute et les expressions comme « il faut que », « bien que », « pour que » في شرح أحداث الرواية","_acquire 12 كلمة أساسية autour de la bibliothèque, le signe, l’indice, l’énigme, le doute, le rire","تحليل بنية le roman policier médiéval: l’enquêteur (frère William), le savant, le texte comme preuve","تفسير العلاقة بين la sémiotique d’Eco و« Le Nom de la rose »: le signe qui trompe، la bibliothèque كـ monde de textes"],"sections":[{"h":"الدرس 17: تحليل «اسم الوردة» — البوليسيّة القروسطيّة والمكتبة وعلم الدلالة","video":{"id":"1ogcMGxeZWg","title":"Le Nom de la Rose d’Umberto Eco Résumé détaillé et analyse","channel":"Gloria Lauzanne Cours de français","why":"درس فرنسي منظّم يشرح le récit البوليسي خطوة بخطوة: les sept meurtres، la bibliothèque labyrinthique، puis la fin du livre et le rire — يمهّد مباشرة لتحليل les signes et l’enquête.","lang":"fr","main":true,"dur":23},"p":["«Le Nom de la rose» (1980) يجمع بين le roman policier et le roman des idées: في دير بندكتي عام 1327 يقع سلسلة من الوفيات، ويلتزم frère William de Baskerville — وهو راهب إنجليزي يشبه هولمز في منطقه — بفكّ الأسرار. لكن الخاتمة ليست في الجريمة، بل في le rire: المكتبة المحرّمة هي القاتل الحقيقي.","المفردات المحورية: la bibliothèque (المكتبة)، le manuscrit (المخطوطة)، l’énigme (اللغز)، le signe (العلامة)، le symbole (الرمز)، l’indice (الأثر/الدليل)، déchiffrer (يفكّ الشفرة)، le Moyen Âge (العصور الوسطى)، l’hérésie (الهرطقة)، le moine (الراهب)، le doute (الشكّ)، le rire (الضحك).","بنية الرواية ثلاثية: المقدمة (Adso يروي)، جسم التحقيق (ويليام يقارن الشهادات والأوراق)، والخاتمة (النار والمكتبة). le récit يقوم على la mémoire: الراوي الشاب يروي بعد عقود، لذلك يمتلئ النص بـ « je me souviens » وle plus-que-parfait.","نحوياً، الدرس يقدّم point 1: le subjonctif بعد التعبيرات عن الضرورة والشكّ — « il faut que le texte soit lu », « bien que les signes trompent ». point 2: les connecteurs logiques du raisonnement — car, donc, or, c’est pourquoi, puisque — وهي أسلوب ويليام التحقيقي.","الفكرة الكبرى عند Eco هي la sémiotique: كل شيء في الدير signe — les images du bestiaire، les mots de Aristote المحرّمة على الطبعة العربية (كتاب Poetica عن الفكاهة)، la faim qui تدفع إلى القتل. القارئ يتعلّم أن le sens يُبنى ولا يُكتشف جاهزاً.","بعد الدرس، أعد الاستماع إلى la scène du dédoublage des suspects بدون sous-titres، ثم اكتب les trois indices de William في ثلاث جمل — la tâche الأولى هي la reconnaissance des connecteurs avant le commentaire."],"sub":[{"h":"l’enquête au Moyen Âge","p":["William compare les témoignages comme un detective moderne.","Chaque indice est d’abord un signe à interpréter.","Le texte remplace la preuve matérielle."]},{"h":"la bibliothèque, labyrinthe de livres","p":["L’Aedificium contient les textes interdits du monde.","La bibliothèque est plus dangereuse que les hommes.","Lire, c’est risquer de se perdre."]},{"h":"le signe et le rire","p":["Le rire interdit ouvre la dernière salle du labyrinthe.","Le sens n’est jamais définitif : il se perd avec les mots.","« Stat rosa pristina nomine… » : nous ne tenons qu’à des noms."]}]},{"h":"les phrases clés du roman","p":["« Stat rosa pristina nomine, nomina nuda tenemus. » — « La rose d’antan ne tient plus qu’à son nom ; nous ne tenons qu’à des noms nus. » la phrase finale qui ferme tout le livre sur la perte du sens.","« La plus belle rose est celle qui ne se fane pas, car elle est un nom. » — l’interprétation de William: la rose du titre est un mot, pas une fleur.","« Il faut que le texte soit lu. » — la leçon du moine Jorge: le savoir a peur du rire, donc il se cache dans la bibliothèque.","« Les signes sont des choses qui trompent. » — la devise implicite de l’enquête: chaque indice peut renvoyer à un autre signe, sans fin."]},{"h":"التطبيق والتلخيص","p":["تمرين la réécoute: شغّل la fin du film ou du résumé — la scène du feu — بدون sous-titres، ثم اكتب les trois raisons de la catastrophe في ثلاث جمل.","تمرين l’analyse des connecteurs: اقتطف من فيديو la réécoute trois connecteurs (car, donc, or) واشرح كيف يبنيون le raisonnement de William.","اكتب paragraphe de 90 mots بالفرنسية تشرح فيه لماذا la bibliothèque تُعدّ في الرواية أكثر من مجرد مكان — مع 4 مفردات من la leçon et un subjonctif."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: يشرح الدرس «اسم الوردة» كـ roman à énigme médiéval: la bibliothèque لabyssine، و le manuscrit المفقود يقود l’enquête، و l’emblème de la rose يختزل النزاع بين le rire et l’hérésie. أعد مشاهدة الفيديو الرئيسي وركّز على la scène de l’incendie وعلى la découverte du manuscrit d’Aristote.","جسر الدروس: من b2-t10-l16 (آنا كارنينا — الحقيقةُ النفسية تُقرأ عبر la société et le paysage russe) إلى b2-t10-l17 (اسم الوردة — الحقيقةُ الدلالية تُقرأ عبر les signes et les manuscrits)، ثم إلى b2-t10-l18 حيث «مئة عام من العزلة» لـ García Márquez يفتح la saga de Macondo: le récit collectif يحلّ محل le récit policier.","مهمة تطبيقية: سجّل ملخّص الرواية في دقيقة، أضف 3 كلمات من الدرس (مثل l’emblème و l’énigme و le manuscrit)، ثم قارن la scène de la bibliothèque في الفيديو بوصفك: كيف يبني Eco le suspense من les signes؟"]}],"pron":[{"w":"la bibliothèque","ipa":"[bjibliɔtɛk]","approx":"بيبليوتيك"},{"w":"l’énigme","ipa":"[eniɲm]","approx":"أنينيم"},{"w":"le doute","ipa":"[dut]","approx":"دوت"}],"vocab":[{"fr":"la bibliothèque","ar":"المكتبة","pos":"nom","g":"f","exFr":"La bibliothèque du monastère est un labyrinthe.","ipa":"[bjibliɔtɛk]","exAr":"مكتبة الدير متاهة."},{"fr":"le manuscrit","ar":"المخطوطة","pos":"nom","g":"m","exFr":"Le manuscrit d’Aristote est caché au fond du labyrinthe.","ipa":"[manyskʁit]","exAr":"مخطوطة أرسطو مخبأة في عمق المتاهة."},{"fr":"l’énigme","ar":"اللغز","pos":"nom","g":"f","exFr":"Chaque mort forme une nouvelle énigme.","ipa":"[eniɲm]","exAr":"كل وفاة تشكّل لغزاً جديداً."},{"fr":"le signe","ar":"العلامة والدلالة","pos":"nom","g":"m","exFr":"Pour Eco, tout texte est un ensemble de signes.","ipa":"[siɲ]","exAr":"عند إيكو، كل نص مجموعة من الدلالات."},{"fr":"l’emblème","ar":"الشعار الدلالي","pos":"nom","g":"m","exFr":"La rose est l’emblème central du livre.","exAr":"الوردة هي الشعار الدلالي المركزي للكتاب.","ipa":"[ɑ̃blɛm]"},{"fr":"l’indice","ar":"الأثر والدليل","pos":"nom","g":"m","exFr":"William relève chaque indice avant de conclure.","ipa":"[ɛ̃dis]","exAr":"ويليام يدوّن كل أثر قبل أن يستنتج."},{"fr":"déchiffrer","ar":"يفكّ الشفرة ويقرأ بصعوبة","pos":"verbe","g":"","exFr":"Le moine déchiffre une écriture presque effacée.","ipa":"[deʃifʁe]","exAr":"الراهب يفكّ شفرة كتابة كادت تُمحى."},{"fr":"le Moyen Âge","ar":"العصور الوسطى","pos":"nom","g":"m","exFr":"Le roman se déroule au Moyen Âge, en 1327.","ipa":"[mwayɛ̃ ɑːʒ]","exAr":"تدور أحداث الرواية في العصور الوسطى عام 1327."},{"fr":"l’hérésie","ar":"الهرطقة","pos":"nom","g":"f","exFr":"L’hérésie paupériste divise l’abbaye.","ipa":"[eʁezi]","exAr":"هرطقة الفقراء تشقّ الدير."},{"fr":"le moine","ar":"الراهب","pos":"nom","g":"m","exFr":"Le moine Jorge refuse que le livre soit lu.","ipa":"[mwan]","exAr":"الراهب خورخي يرفض أن يُقرأ الكتاب."},{"fr":"le doute","ar":"الشكّ","pos":"nom","g":"m","exFr":"Le doute est la méthode de William.","ipa":"[dut]","exAr":"الشكّ هو منهج ويليام."},{"fr":"le rire","ar":"الضحك","pos":"nom","g":"m","exFr":"Le rire mène à la salle interdite de la bibliothèque.","ipa":"[ʁiʁ]","exAr":"الضحك يقود إلى القاعة المحرّمة في المكتبة."}],"examples":[{"fr":"Il faut que le texte soit lu, quoi qu’il arrive.","ar":"لا بدّ أن يُقرأ النصّ مهما حدث.","note":"le subjonctif de la nécessité"},{"fr":"Bien que les signes trompent, William poursuit son enquête.","ar":"رغم أن العلامات تخدع، يواصل ويليام تحقيقه.","note":"le subjonctif après « bien que »"},{"fr":"La bibliothèque est un labyrinthe, donc personne n’en connaît le plan.","ar":"المكتبة متاهة، فلا أحد يعرف تخطيطها.","note":"le connecteur « donc »"},{"fr":"Le moine refuse le rire, car le rire détruit le sens.","ar":"الراهب يرفض الضحك لأن الضحك يدمر المعنى.","note":"l’argumentation avec « car »"},{"fr":"Or, le livre d’Aristote parle justement du rire.","ar":"والكتاب الأرسطي يتحدّث بالضبط عن الضحك.","note":"« or » introduit une donnée nouvelle"},{"fr":"Nous ne tenons qu’à des noms nus.","ar":"لم نبقَ إلا على أسماء عارية.","note":"l’épigramme finale du roman"}],"grammar":[{"tFr":"Le subjonctif après la nécessité, le doute et l’opposition","tAr":"المضارع المنصوب بعد التعبيرات عن الضرورة والشكّ والمعارضة","body":["le roman est construit sur la nécessité et le doute: « il faut que le texte soit lu », « bien que les signes trompent », « pour que l’enquête avance ». après ces expressions, le verbe passe au subjonctif — c’est la marque grammaticale de l’incertitude qui habite tout le livre.","règle B2: les conjonctions adversatives (bien que, encore que) et les finalités (pour que, afin que) exigent le subjonctif; « car », « parce que », « puisque » restent à l’indicatif — le lecteur apprend à choisir selon le sens, pas selon l’habitude."],"ex":[{"fr":"Bien que le moine soit savant, il cache un secret.","ar":"رغم أن الراهب عالِم، فإنه يخفي سراً."},{"fr":"William veut que chaque indice soit vérifié.","ar":"يريد ويليام أن يُتحقق من كل أثر."}]},{"tFr":"Les connecteurs du raisonnement: car, donc, or, c’est pourquoi, puisque","tAr":"أدوات الاستدلال: لأن، إذن، لكن/وأمّا، ولهذا السبب، بما أن","body":["l’enquête de William avance par déduction: il énonce une hypothèse, l’éclaire d’un indice, puis en tire une conséquence — « Le signe est ambigu, donc il faut le confronter au texte. » la progression se lit dans les connecteurs.","attention au sens: « car » justifie, « puisque » rappelle un acquis, « or » introduit une surprise logique (l’équivalent de « yet »), « c’est pourquoi » annonce la conséquence — maîtriser ces mots, c’est maîtriser le commentaire argumenté en français."],"ex":[{"fr":"Le texte est interdit, or il faut le lire pour comprendre.","ar":"النص محرّم، لكن يجب قراءته لفهم الأمر."},{"fr":"L’indice est fausse, c’est pourquoi William recommence.","ar":"الدليل زائف، ولهذا يعيد ويليام البحث."}]}],"mistakes":[{"wrong":"traduire « la bibliothèque » par « library » en pensant au bâtiment","right":"la bibliothèque = l’ensemble des livres et le lieu qui les garde","why":"dans le roman, la bibliothèque est un système de textes, pas seulement un bâtiment."},{"wrong":"dire « il faut que le livre soit lu » sans subjonctif","right":"il faut que le livre soit lu.","why":"après « il faut que », le verbe est toujours au subjonctif."},{"wrong":"confondre le signe et la chose","right":"le signe renvoie à une chose, il ne la remplace pas","why":"la sémiotique d’Eco enseigne que le sens se construit entre les signes."},{"wrong":"croire que le livre est un simple polar historique","right":"le livre est un roman des idées déguisé en enquête","why":"les meurtres naissent d’un texte: c’est le cœur sémiotique du roman."}],"dialogues":[{"title":"l’enquête de frère William","ctx":"William et Adso discutent d’un indice","lines":[{"who":"William","fr":"Ce signe ne peut pas signifier ce qu’on croit.","ar":"هذه العلامة لا يمكن أن تعني ما نظنّه."},{"who":"Adso","fr":"Alors il faut confronter le texte au témoignage.","ar":"إذن يجب مواجهة النصّ بالشهادة."},{"who":"William","fr":"Bien que le moine soit savant, il ment par peur.","ar":"رغم أن الراهب عالِم، فإنه يكذب من الخوف."},{"who":"Adso","fr":"Je doute encore de tout, maître.","ar":"ما زلت أشكّ في كل شيء يا معلّمي."}]},{"title":"la bibliothèque interdite","ctx":"devant l’entrée du labyrinthe de livres","lines":[{"who":"Adso","fr":"Cette salle sent la poussière et le danger.","ar":"هذه القاعة تفوح منها الغبار والخطر."},{"who":"William","fr":"La bibliothèque est plus dangereuse que les hommes.","ar":"المكتبة أخطر من البشر."},{"who":"Adso","fr":"Pourquoi cacher des livres si personne ne les lit ?","ar":"لماذا إخفاء كتب لا يقرأها أحد؟"},{"who":"William","fr":"Parce qu’un texte lu peut changer le monde.","ar":"لأن النص المقروء قد يغيّر العالم."}]}],"exercises":[{"t":"mcq","skill":"listening","q":"ما الذي يجعل المكتبة في الرواية أخطر من الشخصيات؟","opts":["Elle cache des textes interdits.","Elle est toujours fermée.","Elle ne contient que des Bibles.","Elle brûle dès le début."],"a":0,"why":"la bibliothèque est un labyrinthe de textes interdits: le savoir y est un pouvoir et un danger."},{"t":"fill","skill":"grammar","q":"أكمل بالزمن المناسب: «Il faut que chaque indice ___ vérifié.»","fr":"Il faut que chaque indice ... vérifié.","ans":"soit","why":"après « il faut que », on emploie le subjonctif: soit (de être)."},{"t":"mcq","skill":"vocabulary","q":"ما معنى « déchiffrer »؟","opts":["lire avec peine une écriture","traduire une langue","brûler un livre","inventer un code"],"a":0,"why":"déchiffrer = réussir à lire un texte presque illisible ou codé."},{"t":"order","skill":"writing","q":"رتّب: المكتبة متاهة، فلا أحد يعرف تخطيطها","words":["La","bibliothèque","est","un","labyrinthe,","donc","personne","n’en","connaît","le","plan."],"ans":"La bibliothèque est un labyrinthe, donc personne n’en connaît le plan.","why":"« donc » introduit la conséquence de la première proposition."},{"t":"listen","skill":"listening","q":"أي أداة استدلال تُستخدم لإضافة معلومة مفاجئة؟","opts":["or","parce que","puisque","quand"],"a":0,"why":"« or » introduit une donnée nouvelle qui déplace le raisonnement."},{"t":"translate","skill":"writing","q":"ترجم: «رغم أن العلامات تخدع، يواصل ويليام تحقيقه.»","ans":"Bien que les signes trompent, William poursuit son enquête.","why":"« bien que » exige le subjonctif: trompent est ici le subjonctif présent de tromper (identique à l’indicatif au pluriel)."},{"t":"speaking","skill":"speaking","q":"اشرح بالفرنسية في ثلاث جمل لماذا تُعدّ المكتبة مركز الرواية.","target":"La bibliothèque est le cœur du roman parce qu’elle cache les textes interdits et que le sens s’y perd.","why":"l’explication mobilise la structure du lieu et le thème du sens."},{"t":"correct","skill":"grammar","q":"صحّح الجملة: «Bien que le moine est savant, il cache un secret.»","ans":"Bien que le moine soit savant, il cache un secret.","why":"après « bien que », jamais d’indicatif: on emploie le subjonctif soit (de être)."}],"homework":"استمع إلى la scène de l’entrée dans la bibliothèque ثلاث مرات بدون sous-titres، اكتب les trois indices de William في ثلاث جمل بالفرنسية مستعملاً connecteur مختلف في كل جملة (car, donc, or)، ثم اشرح في ثلاث جمل لماذا الوردة في العنوان اسم لا زهرة.","sources":[{"title":"Le Nom de la Rose d’Umberto Eco Résumé détaillé et analyse","channel":"Gloria Lauzanne Cours de français","videoId":"1ogcMGxeZWg","why":"درس فرنسي منظّم يشرح le récit البوليسي خطوة بخطوة: les sept meurtres، la bibliothèque labyrinthique، puis la fin du livre et le rire — يمهّد مباشرة لتحليل les signes et l’enquête.","cat":"Livres","level":"B2","main":true},{"title":"ANALYSE COMPLÈTE DU NOM DE LA ROSE D’UMBERTO ECO : LE LIVRE, LE FILM, LA BD","channel":"Cosmos Littéraire","videoId":"JPC8VkzMWrs","why":"تحليل موسوعي يقارن le livre بالفيلم ويشرح la structure de l’enquête وla fin — مرجعيّة للقراءة العميقة.","cat":"Livres","level":"B2","extra":true},{"title":"Les grands sémiologues : Umberto Eco.","channel":"Callianthus","videoId":"sS2jHp4pNnw","why":"شرح مبسّط لـ la sémiotique عند إيكو: le signe, l’interprétation, la bibliothèque كـ univers de textes.","cat":"Livres","level":"B2","extra":true}],"supplements":[{"id":"JPC8VkzMWrs","title":"ANALYSE COMPLÈTE DU NOM DE LA ROSE D’UMBERTO ECO : LE LIVRE, LE FILM, LA BD","channel":"Cosmos Littéraire","why":"تحليل موسوعي يقارن le livre بالفيلم ويشرح la structure de l’enquête وla fin — مرجعيّة للقراءة العميقة.","lang":"fr","dur":93},{"id":"sS2jHp4pNnw","title":"Les grands sémiologues : Umberto Eco.","channel":"Callianthus","why":"شرح مبسّط لـ la sémiotique عند إيكو: le signe, l’interprétation, la bibliothèque كـ univers de textes.","lang":"fr","dur":8}]},{"id":"b2-t10-l18","fr":"Cent ans de solitude — Gabriel García Márquez (traduit en français)","ar":"مئة عام من العزلة — غابرييل غارسيا ماركيز (ترجم إلى الفرنسية)","objectives":["استعمال le plus-que-parfait et la concordance des temps pour raconter les générations d’une même famille","_acquire 12 كلمة أساسية autour du réalisme magique, de la saga, de Macondo, de la lignée, de la mémoire","تحليل le cycle du temps dans le roman: les prénoms qui reviennent, les événements qui se répètent, la fin qui rejoint le début","تفسير ما يُسمّى « le réalisme magique » ولماذا يُقرأ الكتاب في فرنسا عبر les traductions des années 1960"],"sections":[{"h":"الدرس 18: تحليل «مئة عام من العزلة» — الواقع السحري وماكوندو والسلسلة العائلية","video":{"id":"ka2HJMWfdK8","title":"Cent ans de solitude : le roman qui a inventé un monde","channel":"Le Podcast Café Classique avec Sam Zaenker","why":"تحليل فرنسي يشرح كيف اخترع Márquez عالماً باسم Macondo، ثم يربط الواقعي السحري بالتاريخ الكولومبي — يمهّد مباشرة لدراسة la saga familiale et le cycle du temps.","lang":"fr","main":true,"dur":17},"p":["«Cent ans de solitude» (1967) يعيد بناء تاريخ عائلة Buendía في البلدة الخيالية Macondo: المئة عام تشمل la fondation du village، la découverte de la glace، la guerre civile، l’arrivée de la compagnie bananière، la grande pluie، ثم la disparition. la saga ليست سجلاً عائلياً فحسب، بل رواية أسطورة للكونتين الأمريكيين.","المفردات المحورية: le réalisme magique (الواقع السحري)، la saga (الملحمة العائلية)، Macondo (ماكوندو)، la bananeraie (مزرعة الموز)، le patriarche (الجدّ المؤسّس)، la lignée (السلالة)، engendrer (ينتج نسلاً)، la solitude (العزلة)، la mémoire (الذاكرة)، l’insomnie (الأرق)، le destin (القدر)، la pluie (المطر).","البنية الزمنية قلبُ الرحلة: الرواية تبدأ من «Plus tard, face à la peloton d’exécution… » ثم تعود إلى الوراء. الأسماء تعود (José Arcadio، Aureliano) وتتكرّر الأخطاء، حتى يكتشف العنصر الأخير أن la saga تنتهي حيث كُتب مصيرها في parchemin مشفّر.","نحوياً، point 1: le plus-que-parfait et la concordance des temps في السرد البعيد — « José Arcadio Buendía avait fondé Macondo avant que ses petits-enfants naissent. » point 2: la relative « dont » لربط الأجيال — « les Buendía, dont les prénoms se répètent… » — وهي أداة نحوية حيويّة في وصف النسب.","الواقعي السحري ليس سحرًا ولا واقعًا مجرّدًا: la pluie qui dure quatre ans et onze mois، l’insomnie qui efface les souvenirs، l’ascension physique au ciel — كلها صور تُقال بلغة هادئة بلا تعجّب، وهذه الهدوء هو أسلوب Márquez نفسه.","بعد الدرس، أعد الاستماع إلى la description de Macondo بدون sous-titres، ثم اكتب les quatre âges de la ville (la fondation, l’âge d’or, la bananeraie, la destruction) في أربع جمل — la tâche الأولى هي la reconnaissance de la structure cyclique."],"sub":[{"h":"Macondo, un monde inventé","p":["Macondo est un village qui devient un continent.","Le réalisme magique raconte l’impossible avec un ton calme.","La glace, la pluie et les ailes racontent l’Amérique latine."]},{"h":"la saga des Buendía","p":["Les prénoms reviennent et les destins aussi.","Chaque génération recommence les erreurs de la veille.","La solitude est le vrai héros du roman."]},{"h":"le temps cyclique","p":["Le plus-que-parfait raconte le passé des aïeux.","Le roman commence où il finit : dans le parchemin.","Le temps n’avance pas : il tourne en rond."]}]},{"h":"les phrases clés du roman","p":["« Plus tard, face au peloton d’exécution, le colonel Aureliano Buendía devait se rappeler cet après-midi lointain où son père l’avait emmené découvrir la glace. » — l’ouverture qui plonge le lecteur dans le temps long de la mémoire.","« La solitude est le thème central des Buendía : ils aiment pour mourir seuls. » — la phrase qui nomme le titre lui-même.","« Le parchemin annonçait que la lignée était condamnée à cent ans de solitude. » — le destin écrit à l’avance, thème grec revisité en Amérique.","« Rien à Macondo ne changeait, et pourtant tout changeait. » — la leçon du temps cyclique: la répétition cache la disparition."]},{"h":"التطبيق والتلخيص","p":["تمرين la réécoute: شغّل la scène de la découverte de la glace بدون sous-titres، ثم اكتب les trois réactions des habitants في ثلاث جمل.","تمرين la généalogie: ارسم في ثلاث جمل la lignée des Buendía مستعملاً « dont » لربط الأسماء المتكرّرة.","اكتب paragraphe de 90 mots بالفرنسية تشرح فيه لماذا le réalisme magique يختلف عن la fantasy — مع 4 مفردات من la leçon et un plus-que-parfait."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: يعرض الدرس «مئة عام من العزلة» كـ saga de Macondo: la généalogie des Buendía تعيد إنتاج la solitude، و l’isolement شخصيةٌ حقيقية، و le cycle يُكتب على la parchemin سلفاً. أعد مشاهدة الفيديو الرئيسي وركّز على la pluie de fleurs وعلى la découverte du parchemin.","جسر الدروس: من b2-t10-l17 (اسم الوردة — le doute يقود la quête du sens) إلى b2-t10-l18 (مئة عام من العزلة — la généalogie تُلغي la quête وتُبقي le cycle)، ثم إلى b2-t10-l19 حيث «صحراء التتار» لـ Buzzati يستبدل le cycle par l’attente: le temps لا يعود بل يمرّ و le sort se joue à la frontière.","مهمة تطبيقية: سجّل ملخّص الرواية في دقيقة، استعمل 3 كلمات من الدرس (مثل la généalogie و l’isolement و le cycle)، ثم قارن la structure cyclique dans le vidéo avec ton plan: هل تقع الأسماء نفسها في مواضع مختلفة؟"]}],"pron":[{"w":"l’isolement","ipa":"[izɔlmɑ̃]","approx":"إزولْمان"},{"w":"le réalisme","ipa":"[realism]","approx":"رياليسم"},{"w":"la lignée","ipa":"[linje]","approx":"لينييه"}],"vocab":[{"fr":"le réalisme magique","ar":"الواقع السحري","pos":"nom","g":"m","exFr":"Le réalisme magique raconte l’impossible avec un ton quotidien.","ipa":"[realism maʒik]","exAr":"الواقع السحري يروي المستحيل بلهجة يومية."},{"fr":"la saga","ar":"الملحمة العائلية","pos":"nom","g":"f","exFr":"La saga des Buendía dure cent ans.","ipa":"[saɡa]","exAr":"ملحمة بوديا تمتد مئة عام."},{"fr":"Macondo","ar":"ماكوندو (البلدة الخيالية)","pos":"nom","g":"m","exFr":"Macondo est le village inventé par Márquez.","ipa":"[makɔ̃do]","exAr":"ماكوندو هي البلدة التي اخترعها ماركيز."},{"fr":"la bananeraie","ar":"مزرعة الموز","pos":"nom","g":"f","exFr":"La bananeraie change le destin du village.","ipa":"[bananɛʁɛ]","exAr":"مزرعة الموز تغيّر مصير البلدة."},{"fr":"le patriarche","ar":"الجدّ المؤسّس","pos":"nom","g":"m","exFr":"Le patriarche José Arcadio fonde Macondo.","ipa":"[patʁijaʁk]","exAr":"الجدّ خوسيه أركاديو يؤسّس ماكوندو."},{"fr":"la lignée","ar":"السلالة","pos":"nom","g":"f","exFr":"La lignée des Buendía se répète dans les prénoms.","ipa":"[linje]","exAr":"سلالة بوديا تتكرّر في الأسماء."},{"fr":"engendrer","ar":"ينتج نسلاً","pos":"verbe","g":"","exFr":"Chaque génération engendre la suivante.","ipa":"[ɑ̃ʒɑ̃dʁe]","exAr":"كل جيل ينتج الجيل التالي."},{"fr":"l’isolement","ar":"العزلة الموروثة","pos":"nom","g":"m","exFr":"L’isolement accompagne chaque Buendía.","exAr":"العزلة ترافق كل فردٍ من آل بوينديا.","ipa":"[izɔlmɑ̃]"},{"fr":"la généalogie","ar":"التسلسل الأسري","pos":"nom","g":"f","exFr":"La généalogie du village s’efface avec l’insomnie.","exAr":"التسلسل الأسري للقرية يتلاشى مع الأرق.","ipa":"[ʒenealɔʒi]"},{"fr":"l’insomnie","ar":"الأرق","pos":"nom","g":"f","exFr":"L’insomnie est une épidémie qui efface les souvenirs.","ipa":"[ɛ̃sɔmni]","exAr":"الأرق وباء يمحو الذكريات."},{"fr":"le cycle","ar":"الدورة المصيرية","pos":"nom","g":"m","exFr":"Le cycle des Buendía est écrit dans le parchemin.","exAr":"دورة آل بوينديا مكتوبةٌ على الرقّ.","ipa":"[sikl]"},{"fr":"la pluie","ar":"المطر","pos":"nom","g":"f","exFr":"La pluie tombe presque cinq ans sur Macondo.","ipa":"[plɥi]","exAr":"تمطر ماكوندو قرابة خمس سنوات."}],"examples":[{"fr":"José Arcadio Buendía avait fondé Macondo avant la naissance de ses petits-fils.","ar":"أسّس خوسيه أركاديو بوديا ماكوندو قبل ولادة أحفاده.","note":"le plus-que-parfait de l’antériorité"},{"fr":"La pluie tombait depuis quatre ans et onze mois.","ar":"كان المطر يهطل منذ أربعة أشهر وأحد عشر شهراً.","note":"l’imparfait de la durée longue"},{"fr":"Les Buendía, dont les prénoms se répètent, refont les mêmes erreurs.","ar":"بوديا، الذين تتكرّر أسماؤهم، يعيدون ارتكاب الأخطاء نفسها.","note":"la relative « dont » de la lignée"},{"fr":"Le réalisme magique raconte l’impossible sans s’étonner.","ar":"الواقع السحري يروي المستحيل دون أن يُبدّي دهشة.","note":"la définition du style"},{"fr":"Macondo est d’abord un village, puis une ville, puis un désert.","ar":"ماكوندو أولاً بلدة، ثم مدينة، ثم صحراء.","note":"la progression cyclique"},{"fr":"Le parchemin annonçait la fin de la lignée.","ar":"أعلنت الرقّ نهاية السلالة.","note":"le destin annoncé"}],"grammar":[{"tFr":"Le plus-que-parfait et la concordance des temps dans la saga","tAr":"المصبّر في الماضي التام وتناسق الأزمنة في الملحمة العائلية","body":["raconter plusieurs générations oblige à situer chaque événement par rapport à un autre: « Il avait plu avant que le patriarche ne meure. » le plus-que-parfait marque l’antériorité, et la subordonnée introduite par « avant que » exige le subjonctif — la phrase devient un calendrier de la famille.","règle B2: après « quand » ou « lorsque » dans le récit, on utilise souvent l’imparfait pour l’arrière-plan et le passé simple pour l’événement; après « avant que », toujours le subjonctif — le lecteur apprend à mesurer la distance entre les générations."],"ex":[{"fr":"Le village avait grandi avant que la pluie ne tombe.","ar":"كانت البلدة قد كبرت قبل أن يهطل المطر."},{"fr":"Quand les Buendía naquirent, Macondo était déjà une ville.","ar":"حين وُلد بوديا، كانت ماكوندو قد صارت مدينة."}]},{"tFr":"La relative « dont » pour parler de la lignée","tAr":"الجملة الموصولة dont للإشارة إلى النسب والسلالة","body":["pour décrire une famille, la relative « dont » remplace « de qui » ou « duquel »: « les Buendía, dont les prénoms se répètent, refont les mêmes erreurs. » elle permet de condenser l’information généalogique sans répéter le nom.","attention aux pièges: « dont » ne s’emploie pas pour le lieu (« d’où ») ni pour le temps; il renvoie toujours à une possession ou à une partie — « la maison dont le toit s’effondre » — un outil essentiel du commentaire littéraire."],"ex":[{"fr":"Les Buendía, dont le destin est écrit, ne peuvent s’échapper.","ar":"بوديا، الذين قد كُتب مصيرهم، لا يستطيعون الهروب."},{"fr":"La maison dont la porte est condamnée reste vide.","ar":"البيت الذي أُغلق بابه يبقى خالياً."}]}],"mistakes":[{"wrong":"traduire « réalisme magique » par « magie »","right":"le réalisme magique = un récit calme où l’impossible est quotidien","why":"le style repose sur le ton neutre, pas sur l’émerveillement."},{"wrong":"dire « la pluie avait tombé avant que le patriarche meurt »","right":"la pluie avait tombé avant que le patriarche ne meure.","why":"après « avant que », on emploie le subjonctif avec « ne » explétif."},{"wrong":"confondre Macondo et un vrai village","right":"Macondo est un lieu inventé qui symbolise l’Amérique latine","why":"le village porte l’histoire du continent, pas d’un endroit précis."},{"wrong":"croire que les prénoms se répètent par hasard","right":"la répétition des prénoms est le moteur du temps cyclique","why":"chaque Aureliano recommence l’histoire: c’est la structure du roman."}],"dialogues":[{"title":"la découverte de la glace","ctx":"José Arcadio montre la glace aux habitants de Macondo","lines":[{"who":"José Arcadio","fr":"C’est la grande invention de notre temps.","ar":"هذه هي الاختراع العظيم لزمننا."},{"who":"Un habitant","fr":"Ça brûle ! C’est un feu qui gèle.","ar":"حَرٌّ! إنه نارٌ متجمّدة."},{"who":"José Arcadio","fr":"Non, c’est de la glace : l’avenir de Macondo.","ar":"لا، إنه جليد: مستقبل ماكوندو."},{"who":"Le petit Aureliano","fr":"Je veux en emporter un morceau à ma mère.","ar":"أريد أن آخذ قطعة إلى أمّي."}]},{"title":"le temps qui tourne","ctx":"discussion sur la répétition des générations","lines":[{"who":"Aureliano","fr":"Les prénoms reviennent, et les erreurs aussi.","ar":"الأسماء تعود، والأخطاء كذلك."},{"who":"Úrsula","fr":"Le temps ici n’avance pas : il tourne en rond.","ar":"الزمن هنا لا يتقدّم، بل يدور في مكانه."},{"who":"Aureliano","fr":"Alors la solitude est écrite d’avance.","ar":"إذن العزلة مكتوبة سلفاً."},{"who":"Úrsula","fr":"Seule la mémoire peut encore nous sauver.","ar":"الذاكرة وحدها تستطيع أن تنقذنا بعد."}]}],"exercises":[{"t":"mcq","skill":"listening","q":"ما الذي يميّز الواقعي السحري في الرواية؟","opts":["السرد الهادئ للمستحيل","الأجواء المرعبة","الشرح العلمي","الحكاية الخيالية للأطفال"],"a":0,"why":"الواقع السحري يروي المستحيل بلهجة يومية هادئة: la pluie de quatre ans تُقال بلا دهشة."},{"t":"fill","skill":"grammar","q":"أكمل بالزمن المناسب: «Le village avait grandi avant que la pluie ___ tomber.»","fr":"Le village avait grandi avant que la pluie ... tomber.","ans":"ne tombe","why":"après « avant que », on emploie le subjonctif avec le « ne » explétif: ne tombe."},{"t":"mcq","skill":"vocabulary","q":"ما معنى « la bananeraie »؟","opts":["مزرعة الموز","مصنع الشوكولاتة","محطة القطار","المكتبة البلدية"],"a":0,"why":"la bananeraie = مزرعة الموز، وتمثّل في الرواية قدوم الشركات الأجنبية."},{"t":"order","skill":"writing","q":"رتّب: بوديا، الذين تتكرّر أسماؤهم، يعيدون الأخطاء نفسها","words":["Les","Buendía,","dont","les","prénoms","se","répètent,","refont","les","mêmes","erreurs."],"ans":"Les Buendía, dont les prénoms se répètent, refont les mêmes erreurs.","why":"« dont » relie la famille à ses prénoms: outil clé du commentaire généalogique."},{"t":"listen","skill":"listening","q":"أي زمن يُستخدم للحدث السابق في الرواية؟","opts":["le plus-que-parfait","le futur simple","l’impératif","le conditionnel"],"a":0,"why":"le plus-que-parfait marque l’antériorité dans le temps long de la saga."},{"t":"translate","skill":"writing","q":"ترجم: «الوقت هنا لا يتقدّم، بل يدور في مكانه.»","ans":"Le temps ici n’avance pas : il tourne en rond.","why":"la phrase traduit le temps cyclique du roman: tourner en rond = la répétition."},{"t":"speaking","skill":"speaking","q":"اشرح بالفرنسية في ثلاث جمل لماذا تُعدّ العزلة هي بطل الرواية.","target":"La solitude est le vrai personnage du roman : chaque Buendía aime, puis meurt seul dans sa mémoire.","why":"l’explication relie le titre, les personnages et le thème du cycle."},{"t":"correct","skill":"grammar","q":"صحّح الجملة: «La pluie avait tombé avant que le patriarche meurt.»","ans":"La pluie avait tombé avant que le patriarche ne meure.","why":"après « avant que », jamais d’indicatif: subjonctif imparfait meure avec « ne » explétif."}],"homework":"استمع إلى la scène de la découverte de la glace ثلاث مرات بدون sous-titres، اكتب les quatre âges de Macondo في أربع جمل بالفرنسية مع plus-que-parfait واحد على الأقل، ثم اشرح في ثلاث جمل لماذا la répétition des prénoms مهمة في la saga.","sources":[{"title":"Cent ans de solitude : le roman qui a inventé un monde","channel":"Le Podcast Café Classique avec Sam Zaenker","videoId":"ka2HJMWfdK8","why":"تحليل فرنسي يشرح كيف اخترع Márquez عالماً باسم Macondo، ثم يربط الواقعي السحري بالتاريخ الكولومبي — يمهّد مباشرة لدراسة la saga familiale et le cycle du temps.","cat":"Livres","level":"B2","main":true},{"title":"Cent Ans De Solitude - Gabriel García Márquez | Résumé Complet - Analyse - Littérature - Podcast","channel":"VoixLivre","videoId":"Kd4h2lGicyU","why":"podcast يبني la saga خطوة بخطوة ويشرح la structure cyclique et le destin des Buendía.","cat":"Livres","level":"B2","extra":true},{"title":"Le plus grand roman du XXe siècle ? | ARTE Book Club | ARTE","channel":"ARTE","videoId":"tGHh8L5BFZM","why":"نقاش فرنسي عميق حول la place du roman في الأدب العالمي: le réalisme magique، la réception française، et la traduction.","cat":"Livres","level":"B2","extra":true}],"supplements":[{"id":"Kd4h2lGicyU","title":"Cent Ans De Solitude - Gabriel García Márquez | Résumé Complet - Analyse - Littérature - Podcast","channel":"VoixLivre","why":"podcast يبني la saga خطوة بخطوة ويشرح la structure cyclique et le destin des Buendía.","lang":"fr","dur":12},{"id":"tGHh8L5BFZM","title":"Le plus grand roman du XXe siècle ? | ARTE Book Club | ARTE","channel":"ARTE","why":"نقاش فرنسي عميق حول la place du roman في الأدب العالمي: le réalisme magique، la réception française، et la traduction.","lang":"fr","dur":15}]},{"id":"b2-t10-l19","fr":"Le Désert des Tartares — Dino Buzzati (traduit en français)","ar":"صحراء التتار — دينو بياتي (ترجم إلى الفرنسية)","objectives":["استعمال les verbes de permanence (rester à, continuer de, se mettre à + infinitif) pour décrire l’attente dans le récit","_acquire 12 كلمة أساسية autour de l’attente, de la frontière, de la forteresse, du crépuscule, de la rumeur","analyser la construction du temps dans le roman: l’imparfait de l’attente quotidienne contre le passé simple du départ","expliquer pourquoi le roman est une fable sur la jeunesse qui attend et sur le sens perdu d’une vie"],"sections":[{"h":"الدرس 19: تحليل «صحراء التتار» — الانتظار والحدود والزمن الذي يمرّ","video":{"id":"eMlTE8NQGsY","title":"BUZZATI - LE DÉSERT DES TARTARES","channel":"Kosmos","why":"شرح فرنسي موسع لرواية Buzzati: la forteresse، l’attente de Giovanni، le crépuscule et la rumeur des Tartars — يمهّد مباشرة لتحليل les verbes d’attente et la valeur de l’imparfait.","lang":"fr","main":true,"dur":27},"p":["«Le Désert des Tartares» (1939) يروي حياة Giovanni Drogo من وصوله الشابّ إلى قلعة Bastiani على الحدود، حيث ينتظر غزو التتار الذي لا يأتي أبداً: la rumeur تعود كل عام ثم تُنسى، وتقدّماته تُؤجّل، حتى يشيخ ويفوت القتال. la forteresse ليست مكاناً فحسب بل رمز la vie que l’on attend.","المفردات المحورية: l’attente (الانتظار)، la frontière (الحدود)، la forteresse (القلعة)، le désert (الصحراء)، guetter (يقف كميناً/يرصد)، le crépuscule (الغسق)، la rumeur (الإشاعة)، le capitaine (النقيب)، le destin (القدر)، s’enraciner (يترسّخ)، la jeunesse (الشباب)، s’écouler (يمرّ — عن الزمن).","بنية الرواية بنية الزمن نفسه: les premiers chapitres رائعة la jeunesse et le devoir، ثم l’imparfait de la routine militaire يملأ السنوات، وأخيراً يكتشف Drogo أن la vie قد مضت في الانتظار. Buzzati يكتب بلغة هادئة، قليلة الأحداث، كثيرة الأجواء.","نحوياً، point 1: les verbes d’aspect — « il resta à attendre », « il continua de guetter », « il se mit à vieillir » — تعبّر عن استمرار الفعل بدل حدوثه. point 2: la restriction avec « ne… que » — « Il ne regardait que l’horizon. » — وتُظهر اقتصاد الحياة في جملة واحدة.","سياق الرواية: كتبها Buzzati وهو شابّ في صحيفة كوريري ديلا سيرا الإيطالية، والقصة مستوحاة من la campagne d’Éthiopie et du mythe du veilleur. قراءة فرنسية بارزة للنصّ هي la traduction de Juliette Bertrand (Gallimard)، التي حافظت على la phrase courte et sèche.","بعد الدرس، أعد الاستماع إلى la scène du départ بدون sous-titres، ثم اكتب les trois moments de l’attente (l’arrivée, les années, le regret) في ثلاث جمل — la tâche الأولى هي la reconnaissance du rythme du temps."],"sub":[{"h":"la forteresse et la frontière","p":["La forteresse de Bastiani domine le désert.","Drogo arrive jeune et repart vieux.","La frontière est un lieu où l’on attend."]},{"h":"l’attente sans fin","p":["« Il resta à attendre le jour où les Tartars viendraient. »","L’imparfait raconte les années qui passent.","La rumeur revient, puis s’éteint."]},{"h":"le temps qui s’écoule","p":["« Il ne regardait que l’horizon. »","Le crépuscule est le moment du regret.","La jeunesse se consume dans l’attente."]}]},{"h":"les phrases clés du roman","p":["« Il resta à attendre le jour où les Tartars viendraient. » — la phrase qui résume tout le livre: la vie entière comme verbe d’attente.","« Il ne regardait que l’horizon. » — la restriction « ne… que » enferme Drogo dans un seul regard: la frontière.","« C’est à ce moment qu’il aurait dû fuir, mais il ne le sut que trop tard. » — le regret formulé par le passé simple du temps perdu.","« La grande caravane passait, et lui ne partit pas. » — le motif de la caravane qui s’éloigne: la liberté qu’on laisse filer."]},{"h":"التطبيق والتلخيص","p":["تمرين la réécoute: شغّل la scène du départ أو la lettre بدون sous-titres، ثم اكتب les trois raisons pour lesquelles Drogo reste في ثلاث جمل.","تمرين la transformation: حوّل ثلاث جمل من le résumé إلى la restriction « ne… que » واشرح أثرها في المعنى.","اكتب paragraphe de 90 mots بالفرنسية تشرح فيه pourquoi l’attente peut détruire une vie — مع 4 مفردات من la leçon et un verbe de permanence."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: يشرح الدرس «صحراء التتار» كمعادلة الانتظار: le commandant Ortiz يقدّس la frontière، و l’erg لا يتحرك، و Drogo يشيخ في la forteresse قبل أن يعرف le sort الذي طال انتظاره. أعد مشاهدة الفيديو الرئيسي وركّز على la scène du départ manqué وعلى le crépuscule final.","جسر الدروس: من b2-t10-l18 (مئة عام من العزلة — le cycle يعيد بناء العالم داخل la saga) إلى b2-t10-l19 (صحراء التتار — le temps s’écoule et efface le cycle، فلا يبقى سوى l’attente)، ثم إلى b2-t10-l20 حيث «يوميات آن فرانك» يستبدل انتظار الفرد بكتابة الفرد: la mémoire quotidienne تصير سلاحاً ضد l’effroi و ضد l’oubli.","مهمة تطبيقية: لخّص الرواية في تسجيلٍ من دقيقة، استعمل 3 كلمات من الدرس (مثل l’erg و le commandant و le sort)، ثم قارن la scène du départ manqué في الفيديو بوصفك: أين يظهر أن le temps s’écoule بلا رجعة؟"]}],"pron":[{"w":"l’attente","ipa":"[atɑ̃t]","approx":"أطونط"},{"w":"la frontière","ipa":"[fʁɔ̃tjɛʁ]","approx":"فرونطير"},{"w":"le crépuscule","ipa":"[kʁepyskyl]","approx":"كريبوسكيل"}],"vocab":[{"fr":"l’attente","ar":"الانتظار","pos":"nom","g":"f","exFr":"L’attente remplit toute la vie de Drogo.","ipa":"[atɑ̃t]","exAr":"الانتظار يملأ حياة دروغو كلها."},{"fr":"la frontière","ar":"الحدود","pos":"nom","g":"f","exFr":"La frontière sépare le désert de la ville.","ipa":"[fʁɔ̃tjɛʁ]","exAr":"الحدود تفصل الصحراء عن المدينة."},{"fr":"la forteresse","ar":"القلعة","pos":"nom","g":"f","exFr":"La forteresse de Bastiani regarde le désert.","ipa":"[fɔʁtəʁɛs]","exAr":"قلعة باستياني تطلّ على الصحراء."},{"fr":"l’erg","ar":"بحر الرمال","pos":"nom","g":"m","exFr":"L’erg s’étend au-delà de la forteresse de Bastiani.","exAr":"بحر الرمال يمتدّ وراء قلعة باستياني.","ipa":"[ɛʁɡ]"},{"fr":"guetter","ar":"يرصد ويكمن","pos":"verbe","g":"","exFr":"Drogo guette la poussière de l’horizon.","ipa":"[ʒete]","exAr":"يدرجو يرصد غبار الأفق."},{"fr":"le crépuscule","ar":"الغسق","pos":"nom","g":"m","exFr":"Au crépuscule, le désert devient bleu.","ipa":"[kʁepyskyl]","exAr":"عند الغسق تصبح الصحراء زرقاء."},{"fr":"la rumeur","ar":"الإشاعة","pos":"nom","g":"f","exFr":"La rumeur des Tartars revient chaque année.","ipa":"[ʁymœʁ]","exAr":"إشاعة التتار تعود كل عام."},{"fr":"le commandant","ar":"القائد العسكري","pos":"nom","g":"m","exFr":"Le commandant Ortiz a passé sa vie à la frontière.","exAr":"قائد الدرك أورتيز قضى حياته على الحدود.","ipa":"[kɔmɑ̃dɑ̃]"},{"fr":"le sort","ar":"المآل","pos":"nom","g":"m","exFr":"Le sort de Drogo se joue dans l’attente.","exAr":"مآل دروغو يُحسم في الانتظار.","ipa":"[sɔʁ]"},{"fr":"s’enraciner","ar":"يترسّخ ويكتسب جذوراً","pos":"verbe","g":"","exFr":"Il s’enracine à la forteresse sans le vouloir.","ipa":"[sɑ̃ʁasine]","exAr":"يترسّخ في القلعة دون أن يريدا."},{"fr":"la jeunesse","ar":"الشباب","pos":"nom","g":"f","exFr":"La jeunesse de Drogo s’use dans le silence.","ipa":"[ʒœnɛs]","exAr":"شباب دروغو ينفد في الصمت."},{"fr":"s’écouler","ar":"يمرّ ويتسرب","pos":"verbe","g":"","exFr":"Les années s’écoulent sans bataille.","ipa":"[sekule]","exAr":"تمرّ السنوات دون معركة."}],"examples":[{"fr":"Il resta à attendre le jour où les Tartars viendraient.","ar":"بقي ينتظر اليوم الذي تأتي فيه التتار.","note":"le verbe de permanence « rester à » + infinitif"},{"fr":"Il ne regardait que l’horizon du désert.","ar":"لم يكن ينظر إلا إلى أفق الصحراء.","note":"la restriction « ne… que »"},{"fr":"Il continua de guetter la poussière.","ar":"واصل رصد الغبار.","note":"« continuer de » + infinitif"},{"fr":"L’imparfait raconte les années qui passent à Bastiani.","ar":"المضارع التام يروي السنوات التي تمرّ في باستياني.","note":"la valeur habituelle de l’imparfait"},{"fr":"Le crépuscule tombait sur la forteresse.","ar":"كان الغسق ينزل على القلعة.","note":"l’imparfait du décor"},{"fr":"Il se mit à vieillir sans avoir combattu.","ar":"بدأ يشيخ دون أن يقاتل.","note":"« se mettre à » marque le début du changement"}],"grammar":[{"tFr":"Les verbes de permanence: rester à, continuer de, se mettre à + infinitif","tAr":"أفعال الاستمرارية: بقي/استمر في/بدأ — مع المصدر","body":["Buzzati décrit une vie d’attente avec des verbes d’aspect: « il resta à attendre », « il continua de guetter », « il se mit à vieillir ». ces constructions ne racontent pas un événement, mais une durée — elles donnent au temps sa pesanteur.","règle B2: « rester » et « continuer » se construisent avec « à » ou « de » (continuer à / continuer de), tandis que « se mettre à » marque le début d’un changement; l’infinitif qui suit porte le sens principal, le verbe d’aspect ne fait que le cadrer."],"ex":[{"fr":"Drogo resta à guetter l’horizon pendant des années.","ar":"بقي دروغو يراقب الأفق لسنوات."},{"fr":"Il se mit à comprendre trop tard.","ar":"بدأ يفهم متأخراً جداً."}]},{"tFr":"La restriction avec « ne… que » et les adverbes d’intensité","tAr":"التقييد باستخدام ne… que وأدوات التشديد","body":["la phrase de Buzzati est souvent une prison grammaticale: « Il ne regardait que l’horizon. » — la négation « ne… que » ne nie pas, elle restreint: tout ce qui existe se réduit à un seul objet, exactement comme la vie de Drogo.","attention au piège: « ne… que » n’est pas « ne… pas »; il se place autour du verbe conjugué ou de l’infinitif — « il ne fait que vieillir », « il ne regarde que le désert » — un outil majeur du style sobre du roman."],"ex":[{"fr":"Il ne parlait que de la frontière.","ar":"لم يكن يتحدث إلا عن الحدود."},{"fr":"Elle ne faisait que guetter la rumeur.","ar":"لم تكن تفعل سوى رصد الإشاعة."}]}],"mistakes":[{"wrong":"traduire « attendre » par « attendre un bus » dans le roman","right":"attendre, ici, = vivre en espérant un événement","why":"l’attente de Drogo est existentielle: elle remplace la vie elle-même."},{"wrong":"dire « il ne regardait pas que l’horizon »","right":"il ne regardait que l’horizon.","why":"« ne… que » restreint, il ne nie pas: tout le regard est tourné vers un seul point."},{"wrong":"confondre la forteresse et la prison","right":"la forteresse est un lieu du devoir devenu une illusion","why":"le décor change de sens: bastion, puis tombeau du temps."},{"wrong":"utiliser le passé simple pour les années d’attente","right":"l’imparfait pour la durée, le passé simple pour le virage","why":"le roman repose sur ce contraste: la longueur contre l’événement."}],"dialogues":[{"title":"l’arrivée à la forteresse","ctx":"Drogo rencontre le capitaine Ortiz","lines":[{"who":"Ortiz","fr":"Ici, on attend les Tartars, jeune homme.","ar":"هنا ننتظر التتار يا فتى."},{"who":"Drogo","fr":"Est-ce que la forteresse est souvent attaquée ?","ar":"هل تتعرض القلعة للهجوم كثيراً؟"},{"who":"Ortiz","fr":"On guette la poussière chaque soir au crépuscule.","ar":"نرصد الغبار كل مساء عند الغسق."},{"who":"Drogo","fr":"Alors je resterai jusqu’au jour de la bataille.","ar":"إذن سأبقى حتى يوم المعركة."}]},{"title":"le regret du temps perdu","ctx":"Drogo, malade, quitte enfin la forteresse","lines":[{"who":"Drogo","fr":"Il ne regardait que l’horizon, et l’horizon est resté vide.","ar":"لم يكن ينظر إلا إلى الأفق، وقد بقي الأفق خالياً."},{"who":"Le médecin","fr":"Vous auriez dû partir plus tôt, capitaine.","ar":"كان يجب أن ترحل يا نقيب."},{"who":"Drogo","fr":"Je n’ai vu que le désert et la frontière.","ar":"لم أرَ إلا الصحراء والحدود."},{"who":"Le médecin","fr":"La vie, elle, ne se guette pas : elle passe.","ar":"أما الحياة فلا تُرصد، بل تمرّ."}]}],"exercises":[{"t":"mcq","skill":"listening","q":"ما الذي تمثّله القلعة في الرواية؟","opts":["مكان الانتظار الذي يبتلع الشباب","ثكنة عسكرية عادية","مدينة تجارية","منفى ومعزَل"],"a":0,"why":"la forteresse est le lieu où le temps s’arrête et où la jeunesse s’use."},{"t":"fill","skill":"grammar","q":"أكمل بالبنية المناسبة: «Il ___ à attendre pendant des années.»","fr":"Il ... à attendre pendant des années.","ans":"resta","why":"« rester à » + infinitif exprime la permanence de l’attente."},{"t":"mcq","skill":"vocabulary","q":"ما معنى « le crépuscule »؟","opts":["الغسق ووقت المغرب","الفجر","الظهيرة","منتصف الليل"],"a":0,"why":"le crépuscule = le moment où le jour baisse; dans le roman, il est celui du regret."},{"t":"order","skill":"writing","q":"رتّب: لم يكن ينظر إلا إلى أفق الصحراء","words":["Il","ne","regardait","que","l’horizon","du","désert."],"ans":"Il ne regardait que l’horizon du désert.","why":"la restriction « ne… que » enferme le personnage dans un seul regard."},{"t":"listen","skill":"listening","q":"أي بنية تعبّر عن بدء التغيّر؟","opts":["se mettre à + infinitif","rester à + infinitif","continuer de + infinitif","ne… que"],"a":0,"why":"« se mettre à » marque le début d’un changement, ici le vieillissement."},{"t":"translate","skill":"writing","q":"ترجم: «بقي ينتظر اليوم الذي تأتي فيه التتار.»","ans":"Il resta à attendre le jour où les Tartars viendraient.","why":"« rester à » + infinitif: la permanence avant le passé simple de l’événement."},{"t":"speaking","skill":"speaking","q":"اشرح بالفرنسية في ثلاث جمل لماذا l’attente تُعدّ أكثر خطراً من la guerre.","target":"L’attente est plus dangereuse que la guerre parce qu’elle use la jeunesse sans offrir de bataille.","why":"l’explication relie le thème, le temps et le style sobre du roman."},{"t":"correct","skill":"grammar","q":"صحّح الجملة: «Il ne regardait pas que l’horizon.»","ans":"Il ne regardait que l’horizon.","why":"« ne… que » restreint le regard; « ne… pas » nierait simplement l’action."}],"homework":"استمع إلى la scène du départ أو la lettre ثلاث مرات بدون sous-titres، اكتب les trois moments de l’attente في ثلاث جمل بالفرنسية مع verbe de permanence واحد على الأقل، ثم اشرح في ثلاث جمل لماذا le crépuscule رمز في الرواية.","sources":[{"title":"BUZZATI - LE DÉSERT DES TARTARES","channel":"Kosmos","videoId":"eMlTE8NQGsY","why":"شرح فرنسي موسع لرواية Buzzati: la forteresse، l’attente de Giovanni، le crépuscule et la rumeur des Tartars — يمهّد مباشرة لتحليل les verbes d’attente et la valeur de l’imparfait.","cat":"Livres","level":"B2","main":true},{"title":"Le désert des Tartares, Dino Buzzati","channel":"Roxane Rajar","videoId":"PL6H_BeYfPI","why":"شرح موجز ومنظم للرواية: le décor, la chute de Drogo، ثم le thème du temps — مثالي كمقدّمة قبل التعمق.","cat":"Livres","level":"B2","extra":true},{"title":"DINO BUZZATI / LE DÉSERT DES TARTARES / LA P'TITE LIBRAIRIE","channel":"La Grande Librairie - France Télévisions","videoId":"6heWGTsCqUQ","why":"عرض تلفزيوني فرنسي قصير يقدّم الرواية للقارئ الفرنسي ويبرز la réception du roman en France.","cat":"Livres","level":"B2","extra":true}],"supplements":[{"id":"PL6H_BeYfPI","title":"Le désert des Tartares, Dino Buzzati","channel":"Roxane Rajar","why":"شرح موجز ومنظم للرواية: le décor, la chute de Drogo، ثم le thème du temps — مثالي كمقدّمة قبل التعمق.","lang":"fr","dur":11},{"id":"6heWGTsCqUQ","title":"DINO BUZZATI / LE DÉSERT DES TARTARES / LA P'TITE LIBRAIRIE","channel":"La Grande Librairie - France Télévisions","why":"عرض تلفزيوني فرنسي قصير يقدّم الرواية للقارئ الفرنسي ويبرز la réception du roman en France.","lang":"fr","dur":2}]},{"id":"b2-t10-l20","fr":"Le Journal d’Anne Frank — le récit d’une jeune fille","ar":"يوميات آن فرانك — رواية فتاة مراهقة","objectives":["استعمال le présent de l’écriture intime et le passé composé des événements pour analyser le ton du journal","_acquire 12 كلمة أساسية autour du journal, de la cachette, de l’espoir, de la liberté, de la mémoire, du courage","distinguer l’écriture quotidienne (les petites peurs) de l’écriture réflexive (les grandes idées sur les hommes)","comprendre la dimension mémorielle du texte: pourquoi le journal d’Anne est devenu un document universel de la Shoah"],"sections":[{"h":"الدرس 20: تحليل «يوميات آن فرانك» — الذاكرة والحكاية والأمل وكتابة اليوميات","video":{"id":"tF2_Ao7-jzo","title":"Résumé complet de \"Journal d’Anne Frank\" de Anne Frank","channel":"TonLivre","why":"عرض فرنسي يقدّم la chronologie de la cachette، les personnages de l’Annexe، puis le destin d’Anne بعد التحرير — يمهّد مباشرة لتحليل l’écriture intime et la mémoire.","lang":"fr","main":true,"dur":14},"p":["«Le Journal d’Anne Frank» يوثّق أكثر من سنتين في l’Annexe السرّية بأمستردام (1942–1944): آن، 13 عاماً، تكتب كل يوم باسم « Kitty »، فتصبح الكتابة صديقةً وسجينةً في آن واحد. اليوميات ليست سجلّاً سياسياً، بل récit d’une jeune fille الذي يرى الحرب من داخل غرفة مغلقة.","المفردات المحورية: le journal intime (اليوميات الشخصية)، la cachette (المخبأ)، l’espoir (الأمل)، la liberté (الحرية)، l’écriture (الكتابة)، la mémoire (الذاكرة)، la dénonciation (الإبلاغ/التشهير)، la Shoah (المحرقة)، le courage (الشجاعة)، la jeunesse (الشباب)، raconter (يروي)، la peur (الخوف).","البنية الزمنية للكتاب تُشبه la structure d’un journal: entrée datée، le présent de l’énonciation (« Aujourd’hui, nous avons eu peur »)، ثم le passé composé للأحداث، وأحياناً l’imparfait des habitudes في Annexe (les règles, les disputes, les visites de Miep).","نحوياً، point 1: le présent du journal et ses fonctions (constat, commentaire, adresse à Kitty). point 2: l’hypothèse irréelle avec « si » + imparfait — « Si nous étions libres… » — هي لغة الأمل والحلم في اليوميات: ماضٍ غير حقيقي يعبّر عن رغبة حاضرة.","السياق التاريخي يجب أن يُقال بلغة محترمة: la dénonciation de 1944، اعتقال الأسرة الثمانية المقيمين في المرفق، ووفاة آن في camp de Bergen-Belsen قبل أسابيع قليلة من التحرير، ثم نشر OTTO FRANK لليوميات بعد الحرب بفضل MIEP GIES — وهذا هو le passage du texte privé à la mémoire publique.","بعد الدرس، أعد الاستماع إلى la scène de l’annexe بدون sous-titres، ثم اكتب les trois fonctions de l’écriture chez Anne (se confier, résister, espérer) في ثلاث جمل — la tâche الأولى هي la reconnaissance du ton avant le commentaire."],"sub":[{"h":"l’écriture intime","p":["Anne écrit à « Kitty » comme à une amie.","Le journal transforme la peur en mots.","Écrire, c’est garder une liberté intérieure."]},{"h":"la cachette et la guerre","p":["L’Annexe est un lieu clos, surveillé.","La guerre se joue dans les détails du quotidien.","La dénonciation change le destin des huit personnes."]},{"h":"la mémoire et l’espoir","p":["« Je crois encore que le cœur des gens est bon. »","Le journal devient un document universel.","Écrire, c’est refuser d’être oubliée."]}]},{"h":"les phrases clés du journal","p":["« Je crois encore, malgré tout, que le cœur des gens est bon. » — la phrase la plus célèbre du journal: l’espoir maintenu contre l’évidence de la guerre.","« Je veux vivre à côté de vous, même après ma mort. » — la promesse d’Anne à ses parents, transformée par le livre en présence réelle.","« L’écriture m’est devenue un outil essentiel qui me permet de me vider de mon cœur. » — la fonction thérapeutique de l’écriture intime.","« Une seule odeur de potager suffit à évoquer toute une civilisation. » — la mémoire sensorielle qui résiste à l’enfermement: le monde entier tient dans un parfum."]},{"h":"التطبيق والتلخيص","p":["تمرين la réécoute: شغّل la scène de l’annexe أو le résumé du journal trois fois بدون sous-titres، ثم اكتب les trois émotions qu’Anne nomme في ثلاث جمل.","تمرين le registre: قارن في 60 كلمة بين la phrase quotidienne (« nous avons eu peur ») et la phrase réflexive (« le cœur des gens est bon »).","اكتب paragraphe de 90 mots بالفرنسية تشرح فيه pourquoi l’écriture intime peut être une forme de résistance — مع 4 مفردات من la leçon et un « si » + imparfait."]},{"h":"التطبيق والتلخيص","p":["خلاصة الدرس: يحلّل الدرس «يوميات آن فرانك» كـ récit d’une jeune fille: le journal intime يحول l’annexe إلى فضاءٍ مكتوب، و l’effroi يُروى بلغة يومية، و l’adolescence تصير ذاكرة la Shoah؛ و l’affranchissement الداخلي ينجو من l’enfermement. أعد مشاهدة الفيديو الرئيسي وركّز على la voix d’Anne في la scène d’écriture.","جسر الدروس: من b2-t10-l19 (صحراء التتار — الانتظارُ يمحو le sort ويُشيخ الجوانبَ في la forteresse) إلى b2-t10-l20 (يوميات آن فرانك — l’écriture quotidienne تحفظ la vie وتصمد أمام l’effroi و ضد l’oubli). اكتمل مستوى B2 كاملاً (83 درساً: الطبيعية، الجدل،Nuances، الأكاديمي، المهني، الإعلام،Culture، الاستماع المتقدم + قصص العالم + كتب العالم) — راجع b2-t1-l1 ثم انتقل إلى المستوى المتقدم C1 (c1-t1-l1).","مهمة تطبيقية ختامية: سجّل ملخّص اليوميات في دقيقة واحدة، استعمل 3 كلمات من الدرس (مثل l’annexe و l’effroi و l’affranchissement)، ثم قارن la voix d’Anne في الفيديو بسردك: ما الفرق بين يوميات الفتاة وسجلّ المؤرخ؟ وبعد المراجعة انتقل إلى المستوى C1."]}],"pron":[{"w":"l’empreinte","ipa":"[ɑ̃pʁɛ̃t]","approx":"أنفرانت"},{"w":"l’espoir","ipa":"[ɛspwaʁ]","approx":"إسبوار"},{"w":"le courage","ipa":"[kuʁaʒ]","approx":"كوراج"}],"vocab":[{"fr":"le journal intime","ar":"اليوميات الشخصية","pos":"nom","g":"m","exFr":"Le journal intime raconte la vie de chaque jour.","ipa":"[ʒuʁnal ɛ̃tim]","exAr":"اليوميات الشخصية تروي حياة كل يوم."},{"fr":"l’annexe","ar":"الملحق السري","pos":"nom","g":"f","exFr":"L’annexe de Amsterdam abrite huit personnes.","exAr":"ملحق أمستردام السري يأوي ثمانية أشخاص.","ipa":"[anɛks]"},{"fr":"l’espoir","ar":"الأمل","pos":"nom","g":"m","exFr":"L’espoir aide Anne à écrire chaque soir.","ipa":"[ɛspwaʁ]","exAr":"الأمل يساعد آن على الكتابة كل مساء."},{"fr":"l’affranchissement","ar":"التحرّر الداخلي","pos":"nom","g":"m","exFr":"L’affranchissement intérieur survit à l’enfermement.","exAr":"التحرّر الداخلي ينجو من الاعتقال.","ipa":"[afʁɑ̃ʃismɑ̃]"},{"fr":"l’écriture","ar":"الكتابة","pos":"nom","g":"f","exFr":"L’écriture devient pour Anne un outil essentiel.","ipa":"[ekʁityʁ]","exAr":"تصبح الكتابة لآن أداة أساسية."},{"fr":"l’empreinte","ar":"الأثر المحفوظ","pos":"nom","g":"f","exFr":"L’empreinte du journal traverse les générations.","exAr":"أثر اليوميات يعبر الأجيال.","ipa":"[ɑ̃pʁɛ̃t]"},{"fr":"la dénonciation","ar":"الإبلاغ والتشهير","pos":"nom","g":"f","exFr":"La dénonciation de 1944 livre l’Annexe aux nazis.","ipa":"[denɔ̃sjasjɔ̃]","exAr":"إبلاغ عام 1944 يسلّم المرفق للنازيين."},{"fr":"la Shoah","ar":"المحرقة (الشوا)","pos":"nom","g":"f","exFr":"Le journal est l’un des témoignages de la Shoah.","ipa":"[ʃoa]","exAr":"اليوميات أحد شهادات المحرقة."},{"fr":"le courage","ar":"الشجاعة","pos":"nom","g":"m","exFr":"Le courage d’Anne se lit dans ses pages.","ipa":"[kuʁaʒ]","exAr":"شجاعة آن تُقرأ في صفحاتها."},{"fr":"l’adolescence","ar":"المراهقة","pos":"nom","g":"f","exFr":"L’adolescence d’Anne se joue entre deux murs.","exAr":"مراهقة آن تُعاش بين جدارين.","ipa":"[adɔlɛsɑ̃s]"},{"fr":"consigner","ar":"يدوّن بكتابة","pos":"verbe","g":"","exFr":"Anne consigne chaque jour dans son journal.","exAr":"تدوّن آن كل يومٍ في يومياتها.","ipa":"[kɔ̃siɲe]"},{"fr":"l’effroi","ar":"الرعب","pos":"nom","g":"m","exFr":"L’effroi des pas dans l’escalier revient chaque nuit.","exAr":"رعب خطوات على الدرج يعود كل ليلة.","ipa":"[efʁwa]"}],"examples":[{"fr":"Aujourd’hui, nous avons eu peur, mais j’ai écrit pour ne pas rester seule.","ar":"اليوم خفنا، لكنني كتبت حتى لا أبقى وحيدة.","note":"le présent du journal et le passé composé"},{"fr":"Je crois encore que le cœur des gens est bon.","ar":"ما زلت أؤمن أن قلوب الناس طيبة.","note":"la phrase d’espoir du journal"},{"fr":"Si nous étions libres, nous pourrions courir dans la rue.","ar":"لو كنا أحراراً لكنا نستطيع الجري في الشارع.","note":"l’hypothèse irréelle avec si + imparfait"},{"fr":"L’écriture m’aide à vider mon cœur.","ar":"تساعدني الكتابة على تفريغ قلبي.","note":"la fonction thérapeutique de l’écriture"},{"fr":"La dénonciation a changé le destin de l’Annexe.","ar":"غيّر الإبلاغ مصير المرفق.","note":"le contexte historique du récit"},{"fr":"Une odeur de potager évoque une civilisation entière.","ar":"رائحة حديقة خضار تُستحضر حضارة بأكملها.","note":"la mémoire sensorielle"}],"grammar":[{"tFr":"Le présent de l’écriture intime et le passé composé des événements","tAr":"مضارع الكتابة اليومية ومقابلته بالماضي القريب للأحداث","body":["le journal d’Anne utilise deux temps: le présent pour le commentaire et l’adresse à Kitty (« Je suis contente d’avoir écrit »), et le passé composé pour ce qui s’est produit dans la journée (« Nous avons entendu des pas »). cette alternance donne au texte son rythme de présence.","règle B2: dans un récit intime, le présent n’est pas un oubli du passé — il crée l’illusion de la conversation écrite; le passé composé ancre les faits, et l’imparfait raconte les habitudes de l’Annexe (« Nous nous couchions tard »)."],"ex":[{"fr":"Aujourd’hui, j’ai parlé à Kitty de mes peurs.","ar":"اليوم تحدثت إلى كيتي عن مخاوفي."},{"fr":"Le soir, nous restions longtemps autour de la table.","ar":"في المساء كنا نبقى طويلاً حول الطاولة."}]},{"tFr":"L’hypothèse irréelle avec « si » + imparfait","tAr":"الفرضية غير الواقعية باستخدام si مع المضارع التام","body":["Anne rêve d’une vie normale: « Si nous étions libres… » la proposition introduite par « si » + imparfait exprime un désir contraire au présent; la conséquence se met au conditionnel présent — la phrase devient le langage de l’espoir dans la cachette.","règle B2: après « si », jamais de conditionnel; avec l’imparfait de l’hypothèse, la conséquence est au conditionnel présent (« nous pourrions »), et au conditionnel passé pour une hypothèse ancienne (« nous aurions pu ») — une distinction essentielle pour parler du passé non vécu."],"ex":[{"fr":"Si nous étions libres, nous pourrions revenir à l’école.","ar":"لو كنا أحراراً لاستطعنا العودة إلى المدرسة."},{"fr":"Si j’avais pu sortir, j’aurais couru dans le jardin.","ar":"لو استطعتُ الخروج لكنتُ قد رضت في الحديقة."}]}],"mistakes":[{"wrong":"lire le journal comme un simple témoignage politique","right":"lire le journal comme une écriture intime autant qu’un document","why":"les pages mêlent la peur quotidienne et la réflexion sur les hommes: c’est cette double voix qui le rend universel."},{"wrong":"dire « si nous serions libres… »","right":"si nous étions libres, nous pourrions…","why":"après « si », jamais de conditionnel: l’hypothèse est à l’imparfait, la conséquence au conditionnel."},{"wrong":"traduire « la dénonciation » par « la critique »","right":"la dénonciation = le fait de livrer quelqu’un aux autorités","why":"dans le contexte du journal, il s’agit de la dénonciation de 1944 qui a livré l’Annexe."},{"wrong":"écrire « Anne a écrit le journal au présent » sans nuance","right":"le présent du journal est un choix d’écriture, pas une erreur de temps","why":"le présent crée la conversation avec Kitty et la présence immédiate de la voix."}],"dialogues":[{"title":"l’annexe le soir","ctx":"Anne et sa mère parlent de la journée","lines":[{"who":"Anne","fr":"Aujourd’hui, j’ai eu peur quand j’ai entendu les pas.","ar":"اليوم خفتُ حين سمعت الخطوات."},{"who":"Edith","fr":"Il faut écrire pour ne pas laisser la peur gagner.","ar":"يجب أن تكتبي حتى لا تنتصر المخاوف."},{"who":"Anne","fr":"Si nous étions libres, nous pourrions courir dehors.","ar":"لو كنا أحراراً لكنا نستطيع الجري في الخارج."},{"who":"Edith","fr":"Le journal est ta liberté la plus sûre.","ar":"اليوميات هي حريتك الأكيدة."}]},{"title":"la mémoire après la guerre","ctx":"Otto Frank retrouve le journal et parle à Miep","lines":[{"who":"Otto","fr":"Miep, vous avez sauvé les pages d’Anne.","ar":"ميب، لقد أنقذتِ صفحات آن."},{"who":"Miep","fr":"Je n’ai fait que les garder, monsieur Frank.","ar":"لم أفعل سوى حفظها يا السيد فرانك."},{"who":"Otto","fr":"Le journal rendra sa voix au monde.","ar":"اليوميات ستعيد صوتها إلى العالم."},{"who":"Miep","fr":"Alors sa jeunesse ne sera pas effacée.","ar":"عندها لن يُمحى شبابها."}]}],"exercises":[{"t":"mcq","skill":"listening","q":"ما الوظيفة الأساسية للكتابة عند آن في اليوميات؟","opts":["التخلّص من الخوف والتعبير عن الأمل","توثيق المعارك العسكرية","تعلّم القواعد النحوية","كتابة رسالة رسمية"],"a":0,"why":"الكتابة عند آن دواء ومقاومة: « l’écriture m’est devenue un outil essentiel »."},{"t":"fill","skill":"grammar","q":"أكمل بالزمن المناسب: «Aujourd’hui, nous ___ des pas dans l’escalier.»","fr":"Aujourd’hui, nous ... des pas dans l’escalier.","ans":"avons entendu","why":"le passé composé raconte l’événement de la journée, tandis que le présent commente."},{"t":"mcq","skill":"vocabulary","q":"ما معنى « la dénonciation » في سياق اليوميات؟","opts":["تسليم شخص للسلطات","نقد عمل أدبي","خطبة منبرية","رسالة اعتذار"],"a":0,"why":"la dénonciation désigne le fait de livrer l’Annexe aux nazis en 1944."},{"t":"order","skill":"writing","q":"رتّب: ما زلت أؤمن أن قلوب الناس طيبة","words":["Je","crois","encore","que","le","cœur","des","gens","est","bon."],"ans":"Je crois encore que le cœur des gens est bon.","why":"la phrase d’espoir: « encore » exprime la persistance contre l’évidence."},{"t":"listen","skill":"listening","q":"أي زمن يُستخدم لسرد الأحداث في اليوميات؟","opts":["le passé composé","le futur simple","l’impératif","le subjonctif"],"a":0,"why":"le passé composé fixe les faits de la journée, le présent conserve la voix."},{"t":"translate","skill":"writing","q":"ترجم: «لو كنا أحراراً لاستطعنا العودة إلى المدرسة.»","ans":"Si nous étions libres, nous pourrions revenir à l’école.","why":"si + imparfait pour l’hypothèse irréelle, la conséquence au conditionnel présent."},{"t":"speaking","skill":"speaking","q":"اشرح بالفرنسية في ثلاث جمل لماذا يُعدّ اليوميات وثيقة للذاكرة.","target":"Le journal est un document de mémoire parce qu’il raconte la guerre à hauteur d’enfant et que sa voix nous touche encore.","why":"l’explication relie le point de vue intime et la portée historique du texte."},{"t":"correct","skill":"grammar","q":"صحّح الجملة: «Si nous serions libres, nous pourrions sortir.»","ans":"Si nous étions libres, nous pourrions sortir.","why":"après « si », jamais de conditionnel: on emploie l’imparfait de l’hypothèse."}],"homework":"استمع إلى la scène de l’Annexe ثلاث مرات بدون sous-titres، اكتب les trois fonctions de l’écriture chez Anne في ثلاث جمل بالفرنسية، ثم اشرح في ثلاث جمل لماذا la phrase « le cœur des gens est bon » لا تزال تُقال اليوم.","sources":[{"title":"Résumé complet de \"Journal d’Anne Frank\" de Anne Frank","channel":"TonLivre","videoId":"tF2_Ao7-jzo","why":"عرض فرنسي يقدّم la chronologie de la cachette، les personnages de l’Annexe، puis le destin d’Anne بعد التحرير — يمهّد مباشرة لتحليل l’écriture intime et la mémoire.","cat":"Livres","level":"B2","main":true},{"title":"Anne Frank I Quelle Histoire - TV5 Monde","channel":"Quelle Histoire","videoId":"zLgn2dHzQtk","why":"درس تلفزيوني فرنسي يقدّم la chronologie التاريخية لآن فرانك بلغة واضحة — سياق ضروري قبل تحليل الـ journal.","cat":"Livres","level":"B2","extra":true},{"title":"Livre Audio : Le Journal d’Anne Frank - Analyse & Avis","channel":"Les Bibliophiles","videoId":"npTA_PC5AKI","why":"تحليل أدبي للكتاب: le ton, les thèmes، ولماذا يُقرأ النصّ كـ récit littéraire لا كوثيقة وحدها.","cat":"Livres","level":"B2","extra":true}],"supplements":[{"id":"zLgn2dHzQtk","title":"Anne Frank I Quelle Histoire - TV5 Monde","channel":"Quelle Histoire","why":"درس تلفزيوني فرنسي يقدّم la chronologie التاريخية لآن فرانك بلغة واضحة — سياق ضروري قبل تحليل الـ journal.","lang":"fr","dur":7},{"id":"npTA_PC5AKI","title":"Livre Audio : Le Journal d’Anne Frank - Analyse & Avis","channel":"Les Bibliophiles","why":"تحليل أدبي للكتاب: le ton, les thèmes، ولماذا يُقرأ النصّ كـ récit littéraire لا كوثيقة وحدها.","lang":"fr","dur":5}]}]}]},{"code":"C1","ar":"المتقدم","fr":"Avancé","desc":"الاحتراف اللغوي: الأدب، الصحافة، الأسلوب، والتحليل العميق.","color":"#dc2626","order":6,"tracks":[{"id":"c1-t1","slug":"analyse-de-textes-litteraires","icon":"book","color":"#dc2626","fr":"Analyse de textes littéraires","ar":"تحليل النصوص الأدبية","desc":"la poésie، le roman، le théâtre، la nouvelle، l’essai، la critique — la méthode de lecture analytique.","lessons":[{"id":"c1-t1-l1","fr":"La poésie symboliste","ar":"الشعر الرمزي: بودلير وفيرلين","objectives":["تحليل الصور الشعرية في نص بودلير: la métaphore, la synesthésie, les correspondances","عدّ مقاطع l’alexandrin والوقوف على la césure وla rime","تمييز la musicalité عند فيرلين عن المعنى المباشر في الشعر الواقعي","تحرير lecture analytique من أربع فقرات: الفكرة، الصورة، الإيقاع، الحكم"],"sections":[{"h":"الدرس 1: الصورة والموسيقى في الشعر الرمزي","video":{"id":"A6LdPJHfu1A","title":"Les Fleurs du mal - Baudelaire Résumé","channel":"Gloria Lauzanne Cours de français","why":"عرض مركّز لـ « Les Fleurs du mal »: كيف ينتقل بودلير من الوصف الواقعي إلى la suggestion عبر la synesthésie et les correspondances، وهو المدخل الأمثل لتحليل la poésie symboliste.","lang":"fr","main":true,"dur":4},"p":["« La poésie symboliste » تيار ظهر في ثمانينيات القرن التاسع عشر كردّ فعل على مدرسة le Parnasse: الشاعر الرمزي لا يصف الواقع بوصفه، بل يستحضر حالة نفسية عبر le symbole et la suggestion. القصيدة تُقرأ إذن لا كوصف بل كإيحاء.","مفردات المحور: le symbole, l’image, la métaphore, la synesthésie, la musicalité, le vers, l’alexandrin, la césure, l’allitération, la rime, évoquer, suggérer. هذه الكلمات هي أدوات la lecture analytique وأرقامها.","عند بودلير في « Correspondances » تظهر la synesthésie بوضوح: الروائح والألوان والأصوات تختلط وتتجاوب — « Des parfums, des couleurs et des sons se répondent ». هذا الالتباس الحسي هو قلب la poésie moderne.","عند فيرلين في « Chanson d’automne » تسبق la musicalité المعنى: التكرار والإيقاع المكسور والقافيتان الغنيتان تُنتج شعور la tristesse قبل أن يفهمه القارئ لفظياً. النص إذن يؤثر فينا قبل أن يخبرنا.","من الناحية الإيقاعية: l’alexandrin هو البيت الفرنسي ذو اثنتي عشرة مقطعاً، ينقسم بـ la césure بعد المقطع السادس إلى نصفين متساويين هما l’hémistiche. عدّ المقاطع بصوت مسموع، وستجد أن la césure هي نَفَس البيت.","المنهج في ثلاث قراءات: القراءة الأولى للفكرة العامة، الثانية للصور والحِيَل البلاغية، الثالثة للإيقاع والقافية. ثم اكتب lecture analytique من أربع فقرات: التعريف، التحليل البلاغي، التحليل الإيقاعي، الحكم الشخصي."],"sub":[{"h":"lire le vers à voix haute","p":["Comptez les syllabes du vers avant de chercher le sens.","La césure sépare les deux hémistiches.","Relisez le poème à voix haute pour entendre la rime."]},{"h":"les images et les symboles","p":["Le poète décrit une sensation plutôt qu’une chose.","La métaphore relie deux domaines différents.","La synesthésie mêle le parfum, la couleur et le son."]},{"h":"la méthode de la lecture analytique","p":["Commencez par le thème central du poème.","Expliquez une image, puis son effet sur le lecteur.","Terminez par un jugement personnel argumenté."]}]},{"h":"les réflexes de l’explication de texte","p":["« Le poète suggère plus qu’il ne décrit. » — la définition même du symbolisme.","« Cette image associe deux sensations qui semblent éloignées. » — l’amorce de l’analyse d’une synesthésie.","« Le vers suivant confirme l’impression du premier. » — la transition entre deux strophes.","« On passera ensuite à l’analyse de la césure. » — l’annonce du plan."]},{"h":"التطبيق والتلخيص","p":["تمرين la césure: خذ أربعة أبيات من « Chanson d’automne »، اكتبها في عمود، وضع خطاً فوق la césure، ثم انطق كل نصف مقطعاً منفصلاً.","تمرين l’image: اختر صورة واحدة من « Correspondances » وشرّحها في ثلاث جمل: ما الذي تخلطه؟ وما الذي تستحضره؟ وما أثرها في القارئ؟","تمرين la lecture analytique: اكتب فقرة ختامية من ثلاث جمل تبدأ فيها بـ « En somme » وتربط la forme بالمعنى."]}],"pron":[{"w":"l’alexandrin","ipa":"[lɛ.liks.ɑ̃dʁɛ̃]","approx":"إلَكساندران"},{"w":"la césure","ipa":"[la sy.zyʁ]","approx":"لا سيزور"},{"w":"la musicalité","ipa":"[my.zi.ka.li.te]","approx":"ميزيكاليتِه"}],"vocab":[{"fr":"le vers","ar":"البيت الشعري","pos":"nom","g":"m","exFr":"Ce vers compte douze syllabes.","ipa":"[vɛʁ]","exAr":"هذا البيت يضم اثنتي عشرة مقطعاً."},{"fr":"l’alexandrin","ar":"الألكسندرين","pos":"nom","g":"m","exFr":"L’alexandrin est le grand vers français.","ipa":"[lɛ.liks.ɑ̃dʁɛ̃]","exAr":"الألكسندرين هو البيت الشعري الكبير في الفرنسية."},{"fr":"la césure","ar":"الوقفة الوسطية","pos":"nom","g":"f","exFr":"La césure tombe après six syllabes.","ipa":"[se.zyʁ]","exAr":"الوقفة الوسطية تقع بعد المقطع السادس."},{"fr":"l’hémistiche","ar":"نصف البيت","pos":"nom","g":"m","exFr":"Le premier hémistiche se lit sans pause.","ipa":"[e.mis.tik]","exAr":"يُقرأ النصف الأول دون توقف."},{"fr":"la rime","ar":"القافية","pos":"nom","g":"f","exFr":"Les deux derniers vers riment en -aison.","ipa":"[ʁim]","exAr":"البيتان الأخيران يتقافيان في « -aison »."},{"fr":"l’image","ar":"الصورة الشعرية","pos":"nom","g":"f","exFr":"Cette image rend le sentiment visible.","ipa":"[i.maʒ]","exAr":"هذه الصورة تجعل الشعور مرئياً."},{"fr":"la métaphore","ar":"الاستعارة","pos":"nom","g":"f","exFr":"La métaphore évite le mot propre.","ipa":"[me.ta.fɔʁ]","exAr":"الاستعارة تتجنب الكلمة الحقيقية."},{"fr":"la synesthésie","ar":"التناسس: اتحاد الحواس","pos":"nom","g":"f","exFr":"La synesthésie mêle le son et la couleur.","ipa":"[si.nes.te.zi]","exAr":"التناسس يمزج الصوت باللون."},{"fr":"le symbole","ar":"الرمز","pos":"nom","g":"m","exFr":"Le cygne est un symbole de beauté blessée.","ipa":"[sɔ̃.bɔl]","exAr":"البجعة رمز لجمال مجروح."},{"fr":"la musicalité","ar":"الإيقاع الموسيقي","pos":"nom","g":"f","exFr":"La musicalité du vers domine le sens.","ipa":"[my.zi.ka.li.te]","exAr":"الإيقاع الموسيقي للبيت يسيطر على المعنى."},{"fr":"évoquer","ar":"يُستحِضر","pos":"verbe","g":"","exFr":"Ce poème évoque l’automne et la douleur.","ipa":"[e.vɔ.ke]","exAr":"هذه القصيدة تستحضر الخريف والألم."},{"fr":"suggérer","ar":"يوحي","pos":"verbe","g":"","exFr":"Le poète suggère plus qu’il ne décrit.","ipa":"[sy.ʒe.ʁe]","exAr":"الشاعر يوحي أكثر مما يصف."}],"examples":[{"fr":"Des parfums, des couleurs et des sons se répondent.","ar":"الروائح والألوان والأصوات تتجاوب.","note":"la synesthésie chez Baudelaire"},{"fr":"Le poète suggère plus qu’il ne décrit.","ar":"الشاعر يوحي أكثر مما يصف.","note":"la définition du symbolisme"},{"fr":"L’alexandrin compte douze syllabes.","ar":"يضم الألكسندرين اثنتي عشرة مقطعاً.","note":"la versification"},{"fr":"La césure sépare les deux hémistiches.","ar":"الوقفة الوسطية تفصل نصفَي البيت.","note":"la lecture à voix haute"},{"fr":"Cette image relie deux sensations différentes.","ar":"هذه الصورة تربط حسّين مختلفين.","note":"l’analyse d’une métaphore"},{"fr":"La musicalité du vers précède le sens.","ar":"الإيقاع الموسيقي للبيت يسبق المعنى.","note":"la musicalité chez Verlaine"}],"grammar":[{"tFr":"L’alexandrin : douze syllabes, deux hémistiches","tAr":"الألكسندرين: اثنتا عشرة مقطعاً ونصفان متساويان","body":["Le vers alexandrin compte douze syllabes coupées par une césure après la sixième : « Regardez / et comptez / ces blanches / cathédrales ». On lit d’abord l’hémistiche, on marque une brève pause, puis on enchaîne.","La règle n’est pas mécanique : l’e muet se prononce devant consonne et tombe devant voyelle, ce qui explique qu’un vers semble parfois plus court à l’œil qu’à l’oreille. Comptez à voix haute, jamais sur le papier."],"ex":[{"fr":"Le ciel est noir : un vers doit avoir douze syllabes.","ar":"السماء سوداء: يجب أن يضم البيت اثنتي عشرة مقطعاً."},{"fr":"La césure coupe le vers après six syllabes.","ar":"تقسم الوقفة الوسطية البيت بعد ستة مقاطع."}]},{"tFr":"Les figures de style : métaphore, synesthésie, allitération","tAr":"الصور البلاغية: الاستعارة والتناسس والجناس","body":["La métaphore supprime le mot propre : « le soleil est une fleur » remplace une comparaison explicite. La synesthésie, elle, croise les sens : une couleur a une odeur, un son a une forme.","L’allitération répète une consonne pour créer un effet musical : le [l] et le [s] de « qu’il ne soit qu’une grande voix ». Chaque procédé doit être relié à l’effet produit, jamais énuméré pour lui-même."],"ex":[{"fr":"Des parfums, des couleurs et des sons se répondent.","ar":"الروائح والألوان والأصوات تتجاوب."},{"fr":"Le [s] siffle et donne au vers une couleur triste.","ar":"صوت السين يُصفّر ويمنح البيت لوناً حزيناً."}]}],"mistakes":[{"wrong":"compter les syllabes sur le papier","right":"compter les syllabes à voix haute","why":"l’e muet change selon la position : seule la lecture entendue donne le vrai compte — المقطع يُعدّ بالنطق لا بالعين."},{"wrong":"citer une figure sans la relier à l’effet","right":"nommer la figure, puis expliquer son effet","why":"la lecture analytique demande la preuve, pas la simple étiquette — التحليل يتطلب الدليل لا التسمية فقط."},{"wrong":"confondre le symbole et la métaphore","right":"le symbole s’inscrit dans tout le poème, la métaphore dans un vers","why":"le symbole se déploie d’une strophe à l’autre, la métaphore se limite à un énoncé — الرمز يمتد والاستعارة محصورة."},{"wrong":"dire que la poésie décrit la réalité","right":"dire qu’elle suggère une émotion","why":"le symbolisme remplace la description par la suggestion — الرمزية تستبدل الوصف بالإيحاء."}],"dialogues":[{"title":"Préparer une lecture analytique","ctx":"طالبان يجهّزان شرحاً تحليلياً لقصيدة","lines":[{"who":"Camille","fr":"Commençons par le thème : ce poème parle de la mémoire.","ar":"لنبدأ بالموضوع: هذه القصيدة تتحدث عن الذاكرة."},{"who":"Yanis","fr":"Ensuite, analysons une image : la couleur du soir.","ar":"ثم نحلّل صورة: لون المساء."},{"who":"Camille","fr":"La césure coupe le vers au milieu, n’est-ce pas ?","ar":"الوقفة الوسطية تقسم البيت في المنتصف، أليس كذلك؟"},{"who":"Yanis","fr":"Oui, et la rime riche renforce le rythme.","ar":"نعم، والقافيتان الغنيتان تُقوّيان الإيقاع."}]},{"title":"Expliquer une synesthésie","ctx":"أستاذ وطالبة يناقشان صورة من بودلير","lines":[{"who":"Professeure","fr":"Qu’évoque pour vous cette image de son et de couleur ?","ar":"ما الذي تستحضره لكم هذه الصورة من صوت ولون؟"},{"who":"Inès","fr":"Elle suggère une sensation confuse, presque un rêve.","ar":"إنها توحي بحسّ مبهم، شبه حلم."},{"who":"Professeure","fr":"Très bien : c’est la définition de la suggestion.","ar":"ممتاز: هذا هو تعريف الإيحاء."},{"who":"Inès","fr":"Alors je l’écris dans ma deuxième phrase.","ar":"إذن سأكتبها في جملتي الثانية."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما معنى « la césure » في الشعر الفرنسي؟","opts":["الوقفة الوسطية التي تقسم البيت","قافية الأبيات الأخيرة","الوزن الموسيقي للكلمات","الصورة الشعرية الرئيسية"],"a":0,"why":"la césure = le lieu de la pause au milieu du vers alexandrin."},{"t":"fill","skill":"grammar","q":"أكمل: «L’alexandrin compte douze ___ et une césure.»","fr":"L’alexandrin compte douze ___ et une césure.","ans":"syllabes","why":"l’alexandrin est un vers de douze syllabes — الألكسندرين بيت من اثنتي عشرة مقطعاً."},{"t":"order","skill":"writing","q":"رتّب: يضم البيت الشعري اثنتا عشرة مقطعاً.","words":["Le","vers","contient","douze","syllabes."],"ans":"Le vers contient douze syllabes.","why":"ordre sujet-verbe-complément, la ponctuation reste collée au dernier mot."},{"t":"listen","skill":"listening","q":"ما المقصود بـ « la rime riche »؟","opts":["قافية تتداخل فيها عدة أصوات","قافية من حرف واحد","بيت بلا قافية","وزن حر بلا قاعدة"],"a":0,"why":"la rime riche rapproche plusieurs phonèmes, comme chez Verlaine."},{"t":"translate","skill":"writing","q":"ترجم: «الصورة الشعرية تستحضر شعوراً ولا تصفه.»","ans":"L’image évoque un sentiment au lieu de le décrire.","why":"évoquer = faire apparaître une sensation ; le symbolisme préfère suggérer."},{"t":"speaking","skill":"speaking","q":"حلّل صورة واحدة من « Correspondances » في ثلاث جمل: الصورة ثم الإيقاع ثم الأثر.","target":"image / musicalité / effet","why":"prise de parole structurée selon la grille de la lecture analytique."},{"t":"correct","skill":"grammar","q":"صحّح الجملة: «Le alexandrin compte douze syllabes.»","ans":"L’alexandrin compte douze syllabes.","why":"devant une voyelle, le article élidé prend l’apostrophe : l’alexandrin."},{"t":"writing","skill":"writing","q":"اكتب فقرة فرنسية من أربع جمل تشرح كيف توحي الصورة الأولى في « Correspondances » بالخلط بين الحواس.","target":"synesthésie / suggestion / effet","why":"production écrite académique : thèse, preuve, effet, conclusion."}],"homework":"اقرأ « Chanson d’automne » لفيرلين ثلاث مرات، اكتب عدد المقاطع في كل بيت، ضع خطاً على la césure، ثم حرّر lecture analytique من أربع فقرات (25 سطراً) مستعملاً خمس كلمات من قاموس الدرس.","sources":[{"title":"Les Fleurs du mal - Baudelaire Résumé","channel":"Gloria Lauzanne Cours de français","videoId":"A6LdPJHfu1A","why":"عرض مركّز لـ « Les Fleurs du mal »: كيف ينتقل بودلير من الوصف الواقعي إلى la suggestion عبر la synesthésie et les correspondances، وهو المدخل الأمثل لتحليل la poésie symboliste.","cat":"Littérature","level":"C1","main":true},{"title":"Poésie : le symbolisme - Français - Première - Les Bons Profs","channel":"Les Bons Profs","videoId":"7CEc83tiZbg","why":"درس مكثّف يحدّد ملامح le symbolisme و Contraires من le Parnasse، مع مقارنة تُرسّخ le vocabulaire littéraire.","cat":"Littérature","level":"C1","extra":true},{"title":"RÉUSSIR L'ANALYSE D'UN POÈME : les règles de la versification","channel":"Les rouages du français","videoId":"nnuMZLTJfw4","why":"شرح عملي لـ la versification: عدّ المقاطع، la césure، la rime — التطبيق المباشر لما نتعلمه في هذا الدرس.","cat":"Littérature","level":"C1","extra":true}],"supplements":[{"id":"7CEc83tiZbg","title":"Poésie : le symbolisme - Français - Première - Les Bons Profs","channel":"Les Bons Profs","why":"درس مكثّف يحدّد ملامح le symbolisme و Contraires من le Parnasse، مع مقارنة تُرسّخ le vocabulaire littéraire.","lang":"fr","dur":6},{"id":"nnuMZLTJfw4","title":"RÉUSSIR L'ANALYSE D'UN POÈME : les règles de la versification","channel":"Les rouages du français","why":"شرح عملي لـ la versification: عدّ المقاطع، la césure، la rime — التطبيق المباشر لما نتعلمه في هذا الدرس.","lang":"fr","dur":12}]},{"id":"c1-t1-l2","fr":"Le roman du XXe siècle","ar":"الرواية في القرن العشرين: كامو وكوكليت","objectives":["التمييز بين la focalisation zéro et externe وinterne في نص روائي","تحديد la vitesse et l’ordre du récit: narration, description, analepsé","تحويل الحوار من le discours direct إلى le discours indirect ثم indirect libre","تحليل جملة واحدة للكامو: le choix des verbes et des compléments"],"sections":[{"h":"الدرس 2: التقطيع السردي وصيغة الكلام","video":{"id":"u25-7trnSHM","title":"CAMUS 🔎 L'Étranger - Chapitre 1 (Commentaire analyse linéaire)","channel":"Mediaclasse.fr","why":"تعليق لفظي على مطلع « L’Étranger »: كيف تصنع la focalisation externe et la phrase courte تأثير la neutralité عند كامو، وهو نموذج الدرس في تحليل le récit moderne.","lang":"fr","main":true,"dur":16},"p":["الرواية في القرن العشرين تنقل التركيز من « ماذا حدث » إلى « من يرى ويروي »: la focalisation تصبح إجراءً مركزياً. الرواية الكلاسيكية كانت تستعمل la focalisation zéro (راوي عالم)، أما المحدثة فتختار رؤية محدودة تُغلق معالمة القارئ.","مفردات المحور: la focalisation, le narrateur, la focalisation zéro, la focalisation interne, la focalisation externe, le discours direct, le discours indirect, le style indirect libre, l’ellipse, la phrase courte, rapporter, omettre. هذه الأدوات تحلّل بها أي فقرة سردية.","في « L’Étranger » يروي مورصو بأول شخص لكنه لا يحلّل مشاعره: « Aujourd’hui, maman est morte. » جمل قصيرة، أفعال محسوسة، لا صفة نفسية واحدة. النتيجة: la neutralité تصبح هي نفسها موقفاً.","عند كوكليت في « Sido » la focalisation interne تعود إلى طفولة المروية نفسها: العين ترى الأشياء بحجمها الأول، والرائحة واللون يقودان الجملة. le style فيروزي مقابل le style secّ للكامو.","صيغ الكلام الثلاث: le discours direct ينقل الكلمة حرفياً (نقطتان وشرطية)؛ le discours indirect يدخلها في جملة بفعل قول ويخضعها لزمن الفعل؛ le style indirect libre يحذف أداة الربط ويُبقي ضمير الشخص الثالث مع نبرة البطل نفسه.","للتمرين: خذ جملة واحدة من « L’Étranger »، حدّد فيها الفاعل والزمن، ثم حوّلها إلى indirect وإلى indirect libre، ولاحظ ماذا تغيّر من مسافة الراوي إلى شخصيته."],"sub":[{"h":"identifier le narrateur","p":["Qui parle, à la première ou à la troisième personne ?","Que sait le narrateur de l’intérieur des autres personnages ?","Notez les phrases qu’il omet d’expliquer."]},{"h":"les trois discours","p":["Le discours direct reproduit les paroles exactement.","Le discours indirect les intègre dans une phrase.","Le style indirect libre garde la voix du personnage."]},{"h":"le style de l’auteur","p":["Les phrases courtes créent un effet de distance.","Les verbes d’action remplacent les sentiments.","Relisez l’incipit : toute la méthode s’y trouve."]}]},{"h":"les formules du commentaire de roman","p":["« Le narrateur adopte une focalisation externe : il ne connaît pas les pensées. »","« Ce passage alterne narration et description. »","« L’auteur préfère le discours indirect libre au discours direct. »","« La phrase courte produit un effet de neutralité. »"]},{"h":"التطبيق والتلخيص","p":["تمرين la focalisation: اقرأ فقرة من أي رواية، أجب: هل الراوي يعلم أكثر من الشخصية أم أقل؟ برهن بجملتين.","تمرين la transformation: حوّل ثلاث جملاً من le discours direct إلى le discours indirect مع الحفاظ على الزمن.","تمرين le style: أعد كتابة جملة عادية بأسلوب الكامو: فعل + مفعول، بلا صفة نفسية، لا تتجاوز اثنتي عشرة كلمة."]}],"pron":[{"w":"la focalisation","ipa":"[fɔ.kal.i.za.sjɔ̃]","approx":"فوكاليزاسيون"},{"w":"le narrateur","ipa":"[lə na.ʁa.tœʁ]","approx":"لُ ناراتور"},{"w":"l’ellipse","ipa":"[le.lips]","approx":"إلّيبس"}],"vocab":[{"fr":"la focalisation","ar":"التقطيع السردي (وجهة الرؤية)","pos":"nom","g":"f","exFr":"La focalisation reste interne au personnage.","ipa":"[fɔ.kal.i.za.sjɔ̃]","exAr":"يظل التقطيع السردي داخلياً في الشخصية."},{"fr":"le narrateur","ar":"الراوي","pos":"nom","g":"m","exFr":"Le narrateur ne dit pas tout ce qu’il sait.","ipa":"[na.ʁa.tœʁ]","exAr":"لا يفصح الراوي عن كل ما يعلمه."},{"fr":"la focalisation zéro","ar":"الرؤية الصفرية (العالمة)","pos":"loc.","g":"f","exFr":"La focalisation zéro domine le roman classique.","ipa":"[fɔ.kal.i.za.sjɔ̃ ze.ʁo]","exAr":"تسيطر الرؤية الصفرية على الرواية الكلاسيكية."},{"fr":"la focalisation externe","ar":"الرؤية الخارجية","pos":"loc.","g":"f","exFr":"On voit les actes sans accès aux pensées.","ipa":"[fɛks.tɛʁ.n]","exAr":"نرى الأفعال دون وصول إلى الأفكار."},{"fr":"le discours direct","ar":"الكلام المنقول حرفيًا","pos":"loc.","g":"m","exFr":"Elle a dit : « Je reviens demain. »","ipa":"[diku di.ʁɛkt]","exAr":"قالت: « أعود غداً »."},{"fr":"le discours indirect","ar":"الكلام المنقول بغير مباشرة","pos":"loc.","g":"m","exFr":"Elle a dit qu’elle reviendrait demain.","ipa":"[diku ɛ̃.di.ʁɛkt]","exAr":"قالت إنها ستعود غداً."},{"fr":"le style indirect libre","ar":"الأسلوب غير المباشر الحر","pos":"loc.","g":"m","exFr":"Il faudrait partir, pensa-t-elle.","ipa":"[stil ɛ̃.di.ʁɛkt li.bʁ]","exAr":"يجب أن نرحل، قالت في نفسها."},{"fr":"l’ellipse","ar":"الحذف السردي","pos":"nom","g":"f","exFr":"L’ellipse supprime les détails inutiles.","ipa":"[e.lips]","exAr":"الحذف يلغي التفاصيل غير الضرورية."},{"fr":"la phrase courte","ar":"الجملة القصيرة","pos":"loc.","g":"f","exFr":"La phrase courte marque la distance.","ipa":"[fʁaz kuʁt]","exAr":"الجملة القصيرة تُعلّم المسافة."},{"fr":"l’incipit","ar":"المطلع","pos":"nom","g":"m","exFr":"L’incipit annonce toute l’œuvre.","ipa":"[ɛ̃.si.pit]","exAr":"المطلع يَعِد بالعمل كله."},{"fr":"rapporter","ar":"ينقل الكلام","pos":"verbe","g":"","exFr":"Le narrateur rapporte les paroles sans commentaire.","ipa":"[ʁa.pɔʁ.te]","exAr":"ينقل الراوي الكلام دون تعليق."},{"fr":"omettre","ar":"يحذف أو يُغفل","pos":"verbe","g":"","exFr":"L’auteur omet l’explication psychologique.","ipa":"[o.mɛtʁ]","exAr":"يحذف المؤلف الشرح النفسي."}],"examples":[{"fr":"Aujourd’hui, maman est morte.","ar":"اليوم، ماتت أمي.","note":"la phrase courte de Camus"},{"fr":"Il a dit qu’il reviendrait le soir.","ar":"قال إنه سيعود في المساء.","note":"le discours indirect"},{"fr":"Elle a dit : « Je reviens demain. »","ar":"قالت: « أعود غداً ».","note":"le discours direct"},{"fr":"Il faudrait partir, songea-t-elle.","ar":"يجب أن نرحل، فكّرت في نفسها.","note":"le style indirect libre"},{"fr":"Le narrateur ne connaît pas les pensées des autres.","ar":"لا يعرف الراوي أفكار الآخرين.","note":"la focalisation externe"},{"fr":"La description alterne avec la narration.","ar":"تتبدل الوصفة مع السرد.","note":"la vitesse du récit"}],"grammar":[{"tFr":"La focalisation : zéro, interne, externe","tAr":"التقطيع السردي: الصفرية والداخلية والخارجية","body":["La focalisation zéro donne un narrateur omniscient qui sait tout des personnages : « Il pensait qu’elle avait peur ». La focalisation interne passe par un personnage : le narrateur ne sait que ce que celui-ci voit.","La focalisation externe s’arrête aux actes et aux paroles : « Il entra, ferma la porte, ne dit rien. » Le lecteur doit alors déduire. Choisir une focalisation, c’est choisir ce que le texte refuse de dire."],"ex":[{"fr":"Il pensait qu’elle avait peur, sans qu’elle le dise.","ar":"كان يعتقد أنها خائفة دون أن تقول ذلك."},{"fr":"Il entra, ferma la porte et ne dit rien.","ar":"دخل وأغلق الباب ولم يقل شيئاً."}]},{"tFr":"Du discours direct au style indirect libre","tAr":"من الكلام المنقول حرفيًا إلى الأسلوب غير المباشر الحر","body":["La transformation exige trois réglages : le déplacement des personnes (je → il), le recul du temps (présent → imparfait) et l’ajout d’un verbe de parole : « Elle dit : « J’ai faim » » devient « Elle dit qu’elle avait faim ».","Le style indirect libre supprime ce verbe : « Elle avait faim. Il était tard. » la voix du personnage reste seule en scène. C’est la grande conquête narrative du XXe siècle, utilisée par Colette comme par Camus."],"ex":[{"fr":"Il dit : « Je pars. » → Il dit qu’il part.","ar":"قال: « أنا مسافر » ← قال إنه يسافر."},{"fr":"Il était tard. Il fallait partir.","ar":"كان الوقت متأخراً. يجب أن ننطلق."}]}],"mistakes":[{"wrong":"confondre narrateur et auteur","right":"le narrateur est une fonction du récit, l’auteur est la personne réelle","why":"le narrateur peut mentir, l’auteur, lui, n’entre jamais dans le texte — الراوي وظيفة سردية والمؤلف شخص حقيقي."},{"wrong":"dire focalisation externe quand le récit est à la première personne","right":"distinguer la personne du narrateur et le point de vue","why":"un « je » peut rester aveugle aux pensées des autres : la focalisation est alors externe malgré la première personne — التعدد أولى والرؤية ثانية."},{"wrong":"traduire le discours indirect en gardant le présent","right":"reculer le temps d’un cran","why":"« dit qu’il vient » est fautif : c’est « dit qu’il vient » seulement si le fait est encore vrai — الجزم بزمن واحد."},{"wrong":"analyser le style sans citer de phrase","right":"appuyer chaque jugement sur une citation","why":"la lecture analytique demande la preuve textuelle — التحليل يستشهد بالنص لا بالانطباع."}],"dialogues":[{"title":"Choisir un point de vue","ctx":"صحفيتان تختاران من يروي تقريراً","lines":[{"who":"Sarah","fr":"Si on raconte tout depuis le chef, ce serait la focalisation zéro.","ar":"إن روينا كل شيء من زاوية المدير، فستكون رؤية صفرية."},{"who":"Nour","fr":"Mieux vaut suivre l’ouvrier : la focalisation interne.","ar":"الأفضل أن نتبع العامل: رؤية داخلية."},{"who":"Sarah","fr":"Alors on ne saura pas ce que les autres pensent.","ar":"إذن لن نعرف ما يفكر فيه الآخرون."},{"who":"Nour","fr":"Justement : le lecteur devra deviner, comme dans le roman moderne.","ar":"بالضبط: سيضطر القارئ للتخمين، كما في الرواية الحديثة."}]},{"title":"Travailler le style","ctx":"محرران يراجعان صياغة جملة","lines":[{"who":"Léa","fr":"Ta phrase est trop longue : coupe-la en deux.","ar":"جملتك طويلة جداً: اقسمها إلى جملتين."},{"who":"Marc","fr":"D’accord, et je remplace les sentiments par des actions.","ar":"حسناً، وأستبدل المشاعر بالأفعال."},{"who":"Léa","fr":"Le résultat rappelle le style de Camus.","ar":"النتيجة تُذكِّنا بأسلوب كامو."},{"who":"Marc","fr":"Je garde une seule image, pour la fin.","ar":"أحتفظ بصورة واحدة، في النهاية."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما المقصود بـ « la focalisation externe »؟","opts":["الراوي يرى الأفعال ولا يقرأ الأفكار","الراوي يعرف أفكار الجميع","الرواية تُروى بالضمير المتكلم","الوصف يسبق الأحداث دائماً"],"a":0,"why":"la focalisation externe s’arrête aux actes observables."},{"t":"fill","skill":"grammar","q":"أكمل: «Le narrateur ne connaît pas les pensées des ___ .»","fr":"Le narrateur ne connaît pas les pensées des ___.","ans":"autres","why":"la focalisation externe limite le savoir à ce qui est visible."},{"t":"order","skill":"writing","q":"رتّب: الصيغ الثلاث للكلام في الرواية","words":["Il","a","rapporté","le","discours","indirect."],"ans":"Il a rapporté le discours indirect.","why":"ordre sujet-auxiliaire-verbe-complément, la ponctuation reste au dernier mot."},{"t":"listen","skill":"listening","q":"ما الفرق الأساسي بين discours direct و indirect؟","opts":["الكلام المنقول حرفيًا مقابل إعادة صياغته في جملة","عدد الجمل الطويلة","استعمال الماضي فقط","غياب الضمائر"],"a":0,"why":"le direct garde les paroles telles quelles, le indirect les intègre."},{"t":"translate","skill":"writing","q":"ترجم: «قال إنه سيعود في المساء.»","ans":"Il a dit qu’il reviendrait le soir.","why":"discours indirect : discours direct + verbe de parole + recul du temps."},{"t":"speaking","skill":"speaking","q":"اشرح في ثلاث جمل الفرق بين la focalisation interne و la focalisation externe مع مثال.","target":"focalisation / pensées / actes","why":"production orale structurée autour des notions narratologiques."},{"t":"correct","skill":"grammar","q":"صحّح: «Elle a dit qu’elle vient demain.»","ans":"Elle a dit qu’elle viendrait demain.","why":"après un verbe de parole au passé, le récit recule d’un cran : viendrait."},{"t":"writing","skill":"writing","q":"اكتب فقرة فرنسية من أربع جمل تصف مشهداً عادياً من رواية كوكليت مستعملاً la focalisation interne وثلاث حواس.","target":"focalisation interne / la vue / l’odeur","why":"production écrite : appliquer la leçon au style sensoriel de Colette."}],"homework":"اختر مطلع رواية من القرن العشرين (20 سطراً)، حدّد نوع la focalisation وبرّره، ثم حوّل جملة من le discours direct إلى le style indirect libre واكتب جملتين تشرحان الفرق في المسافة السردية.","sources":[{"title":"CAMUS 🔎 L'Étranger - Chapitre 1 (Commentaire analyse linéaire)","channel":"Mediaclasse.fr","videoId":"u25-7trnSHM","why":"تعليق لفظي على مطلع « L’Étranger »: كيف تصنع la focalisation externe et la phrase courte تأثير la neutralité عند كامو، وهو نموذج الدرس في تحليل le récit moderne.","cat":"Littérature","level":"C1","main":true},{"title":"Le point de vue : omniscient, externe ou interne ? - Français Première - Les Bons Profs","channel":"Les Bons Profs","videoId":"EZmasa4wqhs","why":"شرح مضغوط وواضح لنقطة la focalisation الثلاث مع أمثلة من الرواية، مثالي قبل محاولة أي تمرين سردي.","cat":"Littérature","level":"C1","extra":true},{"title":"Colette | Sido résumé | Bac français","channel":"MAJOR AU BAC FRANÇAIS","videoId":"e3t1PeG-ack","why":"مدخل إلى « Sido » للكوكليت: la focalisation الطفولية والوصف الحسي، النموذج المقابل للكامو في هذا الدرس.","cat":"Littérature","level":"C1","extra":true}],"supplements":[{"id":"EZmasa4wqhs","title":"Le point de vue : omniscient, externe ou interne ? - Français Première - Les Bons Profs","channel":"Les Bons Profs","why":"شرح مضغوط وواضح لنقطة la focalisation الثلاث مع أمثلة من الرواية، مثالي قبل محاولة أي تمرين سردي.","lang":"fr","dur":4},{"id":"e3t1PeG-ack","title":"Colette | Sido résumé | Bac français","channel":"MAJOR AU BAC FRANÇAIS","why":"مدخل إلى « Sido » للكوكليت: la focalisation الطفولية والوصف الحسي، النموذج المقابل للكامو في هذا الدرس.","lang":"fr","dur":5}]},{"id":"c1-t1-l3","fr":"Le théâtre classique","ar":"المسرح الكلاسيكي: موليير وراسين","objectives":["قراءة l’alexandrin المسرحي وتحديد la césure في نص موليير وراسين","التمييز بين la didascalie و la réplique وما يُنطق منها فعلاً على الخشبة","تحديد le registre : comique, satirique, tragique, pathétique في مشهد واحد","تحليل la structure en cinq actes : exposition, nœud, dénouement"],"sections":[{"h":"الدرس 3: الوزن الشعري للمشهد والكلمة المكتوبة للخشبة","video":{"id":"oT0BcE7RkJs","title":"Molière, Le Misanthrope, Acte I scène 1 (scène d'exposition) : analyse linéaire pour l'oral !","channel":"Schola Litterarum","why":"تحليل مشهد الافتتاح في « Le Misanthrope »: كيف يتوزّع le vers et la didascalie على الخشبة، وكيف ينتقل la scène من le registre comique إلى le registre satirique.","lang":"fr","main":true,"dur":14},"p":["المسرح الكلاسيكي في القرن السابع عشر يخضع لـ les trois unités : وحدة الزمان (24 ساعة)، وحدة المكان (فضاء واحد)، وحدة الفعل (حدث واحد). le dénouement ينتهي بالعفو أو الموت، لا بالفوضى.","مفردات المحور: la didascalie, la réplique, le monologue, la tirade, l’aparté, le registre, l’acte, la scène, le dénouement, la versification, représenter, s’indigner. هذه الأدوات تحلّل بها نصاً مسرحياً.","الوزن الشعري: موليير يكتب غالباً في l’alexandrin مع le couplet et la rime plate لإنتاج la réplique النشيطة، بينما راسين يشدّد la césure ويستعمل le transfert de réplique ليصنع la lenteur المحملة بالقدر.","la didascalie هي ما يكتبه المؤلف بين قوسين أو في سطر مستقل ولا يُنطق: « Il entre, il se promène ». إنها التعليمات الحركية والإيقاعية، وهي النص الوحيد الذي لا يصل إلى أذن المتفرج.","الأنماط الخمسة للكلام المسرحي: la réplique (كلام يردّ به شخص على آخر)، le monologue (وحيد يتحدث)، la tirade (كلام طويل بلا مقاطعة)، l’aparté (كلام يسمعه الجمهور لا زميله)، et le dialogue. la didascalie تسبق كلّها في القراءة.","للتمرين: خذ مشهد « Le Misanthrope »، اكتب في الهامش نوع كل كلام (réplique أو tirade أو aparté)، ثم حدّد la césure في ثلاثة أبيات وقارن إيقاعها بمشهد من « Andromaque »."],"sub":[{"h":"la didascalie et la réplique","p":["La didascalie n’est jamais prononcée sur scène.","La réplique appartient au personnage qui parle.","Le monologue se joue sans interlocuteur."]},{"h":"les registres du théâtre","p":["La comédie vise le rire par le défaut.","La tragédie met en jeu le devoir et la passion.","Le registre satirique attaque les mœurs."]},{"h":"le vers et la scène","p":["L’alexandrin donne au dialogue une marche lente.","La césure marque le souffle de l’acteur.","La structure suit cinq actes logiques."]}]},{"h":"les formules de l’analyse théâtrale","p":["« Cette réplique ouvre la scène d’exposition. »","« La didascalie indique un geste que le texte ne dit pas. »","« Le registre bascule du comique au pathétique. »","« L’enjambement du vers souligne l’impatience du personnage. »"]},{"h":"التطبيق والتلخيص","p":["تمرين la didascalie: اقرأ مشهداً مكتوباً واكتب ثلاث didascalies جديدة تُظهر مكان الراكيحين ونبرة كل واحد.","تمرين le registre: ضع في عمودين الجمل التي تُضحك والتي تُبكي في مشهد واحد، ثم سمِّ la bascule de registre.","تمرين le vers: انطق ثلاثة أبيات من راسين محذفاً la césure، ثم أعد النطق مع التوقف، ولاحظ الفرق في التوتر."]}],"pron":[{"w":"la didascalie","ipa":"[di.da.ska.li]","approx":"ديداسكالي"},{"w":"la réplique","ipa":"[ʁe.plik]","approx":"رِبليك"},{"w":"le registre","ipa":"[lə ʁe.ʒistʁ]","approx":"لُ رُجيستر"}],"vocab":[{"fr":"la didascalie","ar":"الإرشاد المسرحي المكتوب","pos":"nom","g":"f","exFr":"La didascalie n’est pas prononcée.","ipa":"[di.da.ska.li]","exAr":"لا يُنطق الإرشاد المسرحي."},{"fr":"la réplique","ar":"العبارة المتبادلة","pos":"nom","g":"f","exFr":"Sa réplique coupe court au débat.","ipa":"[ʁe.plik]","exAr":"عبارة تقضي على الجدال ببساطة."},{"fr":"le monologue","ar":"المناجاة","pos":"nom","g":"m","exFr":"Le monologue révèle le doute du héros.","ipa":"[mɔ.nɔ.lɔɡ]","exAr":"المناجاة تكشف تردّد البطل."},{"fr":"la tirade","ar":"الخطبة الطويلة","pos":"nom","g":"f","exFr":"La tirade dure deux minutes sans interruption.","ipa":"[ti.ʁad]","exAr":"تدوم الخطبة دقيقتين دون مقاطعة."},{"fr":"l’aparté","ar":"الكلام الهامشي","pos":"nom","g":"m","exFr":"Il glisse un aparte pour le public.","ipa":"[a.paʁ.te]","exAr":"يُدرج كلاماً هامشياً موجهاً للجمهور."},{"fr":"le registre","ar":"النمط الأدبي","pos":"nom","g":"m","exFr":"Le registre passe ici du comique au tragique.","ipa":"[ʁe.ʒistʁ]","exAr":"ينتقل النمط هنا من الكوميدي إلى التراجيدي."},{"fr":"l’acte","ar":"المشهد الكبير (الفعيل)","pos":"nom","g":"m","exFr":"La pièce comporte cinq actes.","ipa":"[akt]","exAr":"تتكون المسرحية من خمسة فصول."},{"fr":"le dénouement","ar":"حل العقدة","pos":"nom","g":"m","exFr":"Le dénouement arrive dans le cinquième acte.","ipa":"[de.nu.mɑ̃]","exAr":"يأتي الحل في الفصل الخامس."},{"fr":"l’alexandrin","ar":"الألكسندرين","pos":"nom","g":"m","exFr":"Racine compose en alexandrins sévères.","ipa":"[lɛ.liks.ɑ̃dʁɛ̃]","exAr":"يكتب راسين بأسلوب الألكسندرين الصارم."},{"fr":"la versification","ar":"الوزن وإعراب البيت","pos":"nom","g":"f","exFr":"La versification règle le souffle de l’acteur.","ipa":"[vɛʁ.si.fi.ka.sjɔ̃]","exAr":"يقضي الوزن على نَفَس الممثل."},{"fr":"représenter","ar":"يُمثّل على الخشبة","pos":"verbe","g":"","exFr":"Le comédien représente un homme orgueilleux.","ipa":"[ʁe.pʁe.zɑ̃.te]","exAr":"يمثّل الممثل رجلاً متكبراً."},{"fr":"s’indigner","ar":"يستشيط غضباً","pos":"verbe","g":"","exFr":"Le héros s’indigne de cette injustice.","ipa":"[sɛ̃.di.ɲe]","exAr":"يستشيط البطل غضباً من هذا الظلم."}],"examples":[{"fr":"La didascalie indique : « Il entre, il se promène. »","ar":"يشير الإرشاد: « يدخل، يتنقل ».","note":"ce qui ne se prononce pas"},{"fr":"Chaque réplique prépare la suivante.","ar":"كل عبارة تهيّئ للتي بعدها.","note":"la mécanique du dialogue"},{"fr":"Le registre comique naît du défaut d’Alceste.","ar":"ينتج النمط الكوميدي من نقص أليست.","note":"la comédie de caractères"},{"fr":"L’alexandrin donne au héros une marche solennelle.","ar":"يمنح الألكسندرين البطل مشية مهيبة.","note":"la versification dramatique"},{"fr":"Ce monologue révèle un conflit intérieur.","ar":"تكشف هذه المناجاة صراعاً داخلياً.","note":"le type de réplique"},{"fr":"Le dénouement unit la justice et le pardon.","ar":"يجمع الحل بين العدالة والمغفرة.","note":"la structure en cinq actes"}],"grammar":[{"tFr":"L’alexandrin dramatique : Molière contre Racine","tAr":"الألكسندرين المسرحي: موليير في مقابل راسين","body":["Chez Molière, le vers reste souple : enjambements fréquents, rejets sur la césure, effets de répétition pour imiter la parole vive. Chez Racine, l’hémistiche est fermé, la césure nette, le vers lourd de destin.","Règle de lecture : lisez d’abord le vers comme une phrase, puis coupez à la sixième syllabe. La césure n’est pas une pause décorative : elle mesure la tension du personnage."],"ex":[{"fr":"Je souffre qu’on le dise, et je veux qu’on le dise.","ar":"أَتَحمّل أن يُقال، وأريد أن يُقال."},{"fr":"Ah ! quelle cruauté !","ar":"آه! ما هذا القسوة!"}]},{"tFr":"La didascalie et les types de répliques","tAr":"الإرشاد المسرحي وأنواع العبارات","body":["La didascalie encadre la réplique sans la prononcer : elle donne le geste, le ton, le mouvement. Dans un commentaire, citez-la toujours : elle prouve l’intention du metteur en scène.","Le monologue isole, la tirade argumente, l’aparté crée un double public. Nommer le type de réplique, c’est déjà analyser la distribution du pouvoir dans la scène."],"ex":[{"fr":"Didascalie : « Alceste reste seul, assis près de la table. »","ar":"إرشاد: « يبقى أليست وحيداً قاعداً قرب الطاولة »."},{"fr":"« Je te l’ai dit vingt fois. » — telle est la réplique qui ferme la scène.","ar":"« أخبرتك ذلك عشرين مرة » — هكذا تُغلق العبارة المشهد."}]}],"mistakes":[{"wrong":"lire la didascalie à voix haute","right":"la lire en silence comme une indication","why":"la didascalie n’appartient pas au dialogue : la prononcer brouille la scène — لا يُنطق الإرشاد المسرحي."},{"wrong":"appeler tout « monologue »","right":"distinguer monologue, tirade et aparté","why":"le monologue est seul, la tirade est longue et destinée aux autres personnages — المناجاة لا الخطبة الهامشية."},{"wrong":"confondre registre et ton","right":"le registre est une constante du texte","why":"le ton varie d’une réplique à l’autre, le registre structure tout le passage — النمط أوسع من النبرة."},{"wrong":"composer sans respecter la césure","right":"poser la pause après six syllabes","why":"sans césure, l’alexandrin perd son balancement classique — بلا وقفة يفقد الألكسندرين إيقاعه."}],"dialogues":[{"title":"Préparer une représentation","ctx":"مخرجان يرتّبان مشهداً قبل العرض","lines":[{"who":"Hugo","fr":"Ici la didascalie demande un geste lent.","ar":"هنا يوجب الإرشاد حركة بطيئة."},{"who":"Farah","fr":"Et cette tirade doit garder son alexandrin.","ar":"ويجب أن تحتفظ هذه الخطبة بألكسندرينها."},{"who":"Hugo","fr":"Le registre passe du comique au satirique.","ar":"ينتقل النمط من الكوميدي إلى التهكمي."},{"who":"Farah","fr":"Alors baissons la voix avant le dénouement.","ar":"إذن نخفض الصوت قبل حل العقدة."}]},{"title":"Commenter une scène","ctx":"طالبان يُعدّان شفهياً لمشهد كلاسيكي","lines":[{"who":"Mehdi","fr":"La scène d’exposition présente les personnages.","ar":"يقدّم مشهد الافتتاح الشخصيات."},{"who":"Lou","fr":"Remarque la réplique qui coupe court à l’autre.","ar":"لاحظ العبارة التي تقطع كلام الآخر."},{"who":"Mehdi","fr":"Ce vers est un alexandrin, la césure est nette.","ar":"هذا البيت ألكسندرين والوقفة واضحة."},{"who":"Lou","fr":"Parfait : cite la didascalie dans ton introduction.","ar":"ممتاز: استشهد بالإرشاد في مقدّمتك."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما « la didascalie » في النص المسرحي؟","opts":["التعليمات المكتوبة ولا تُنطق","عبارة الشخصية الأولى","القافية بين حملتين","عنوان الفصل"],"a":0,"why":"la didascalie est l’indication scénique réservée au metteur en scène."},{"t":"fill","skill":"grammar","q":"أكمل: «La pièce comporte cinq ___ .»","fr":"La pièce comporte cinq ___ .","ans":"actes","why":"structure classique en cinq actes selon la règle des trois unités."},{"t":"order","skill":"writing","q":"رتّب: النمط الكوميدي يهدف إلى الضحك","words":["Le","registre","comique","vise","le","rire."],"ans":"Le registre comique vise le rire.","why":"ordre sujet-verbe-complément, la ponctuation reste au dernier mot."},{"t":"listen","skill":"listening","q":"ما الفرق بين la tirade و le monologue؟","opts":["الخطبة طويلة بلا مقاطعة والمناجاة بلا زميل","كلتاهما بلا كلام","المناجاة للجمهور فقط","خطبة قصيرة جداً"],"a":0,"why":"la tirade s’adresse aux personnages ; le monologue isole celui qui parle."},{"t":"translate","skill":"writing","q":"ترجم: «لا يُنطق الإرشاد المسرحي على الخشبة.»","ans":"La didascalie n’est pas prononcée sur scène.","why":"didascalie = indication non parlée ; construction avec la voix passive."},{"t":"speaking","skill":"speaking","q":"صف مشهداً كلاسيكياً في ثلاث جمل: البناء ثم الوزن ثم النمط.","target":"cinq actes / alexandrin / registre","why":"prise de parole structurée sur les trois axes de la leçon."},{"t":"correct","skill":"grammar","q":"صحّح: «Le monologue est une longue réplique adressée à deux amis.»","ans":"La tirade est une longue réplique adressée à deux amis.","why":"la tirade est longue et adressée aux autres ; le monologue est isolé."},{"t":"writing","skill":"writing","q":"اكتب مقطعاً فرنسياً من أربع جمل يقارن بين مشهد من موليير ومشهد من راسين من ناحية الوزن والنمط.","target":"versification / registre / structure","why":"production écrite académique : comparaison argumentée de deux textes."}],"homework":"حلّل مشهداً من « Andromaque » (20 سطراً): انسخ النص، ضع خطاً على la césure في ثلاثة أبيات، سمِّ نوع كل réplique، وحدّد la bascule de registre في فقرة من أربع جمل.","sources":[{"title":"Molière, Le Misanthrope, Acte I scène 1 (scène d'exposition) : analyse linéaire pour l'oral !","channel":"Schola Litterarum","videoId":"oT0BcE7RkJs","why":"تحليل مشهد الافتتاح في « Le Misanthrope »: كيف يتوزّع le vers et la didascalie على الخشبة، وكيف ينتقل la scène من le registre comique إلى le registre satirique.","cat":"Littérature","level":"C1","main":true},{"title":"RACINE 📜 Andromaque (Résumé-analyse de la pièce)","channel":"Mediaclasse.fr","videoId":"f1zvstOtMUg","why":"تحليل منظّم لـ « Andromaque »: la structure en cinq actes et le registre tragique عند راسين، المقابل الأمثل لكوميديا موليير.","cat":"Littérature","level":"C1","extra":true},{"title":"Analyser une Pièce de Théâtre : Les notions à connaître","channel":"Un Cours de 5 Minutes","videoId":"Tj_-NPR9DiQ","why":"جردة كاملة لـ la didascalie, les types de répliques et l’organisation de la pièce — المرجع السريع قبل التمرين.","cat":"Littérature","level":"C1","extra":true}],"supplements":[{"id":"f1zvstOtMUg","title":"RACINE 📜 Andromaque (Résumé-analyse de la pièce)","channel":"Mediaclasse.fr","why":"تحليل منظّم لـ « Andromaque »: la structure en cinq actes et le registre tragique عند راسين، المقابل الأمثل لكوميديا موليير.","lang":"fr","dur":16},{"id":"Tj_-NPR9DiQ","title":"Analyser une Pièce de Théâtre : Les notions à connaître","channel":"Un Cours de 5 Minutes","why":"جردة كاملة لـ la didascalie, les types de répliques et l’organisation de la pièce — المرجع السريع قبل التمرين.","lang":"fr","dur":6}]},{"id":"c1-t1-l4","fr":"La nouvelle réaliste","ar":"القصة القصيرة الواقعية: موباسان","objectives":["تحديد البنية الثلاثية للقصة: exposition, nœud, chute","تفسير la chute : كيف يُعدّ المؤلف القارئ ثم يقلب التوقع","قياس la concision : عدد الكلمات، la phrase courte, l’ellipse","تمييز le réalisme: التفاصيل المحسوسة عن التعليق النفسي"],"sections":[{"h":"الدرس 4: البنية الموجزة والمفارقة في النهاية","video":{"id":"OJm4frGPJQo","title":"Comment écrire une NOUVELLE LITTÉRAIRE | Truc d'auteur","channel":"Trucs d'auteur","why":"شرح عملي لبنية la nouvelle : le scénario en trois temps, la chute et les indices semés en amont — منهج موباسان نفسه في كتابة القصة الواقعية.","lang":"fr","main":true,"dur":5},"p":["la nouvelle اختصار سردي يُقرأ في جلسة واحدة: حدث واحد، عادة قصيرة، ونهاية لا تحتمل التعديل. على عكس le roman، لا تمنح la nouvelle زمناً ولا كثافة أحداث؛ تعتمد على le rythme et la chute.","مفردات المحور: la nouvelle, la chute, l’effet de surprise, la concision, l’ellipse, le détail, l’intrigue, le personnage, le réalisme, condenser, étonner, semer. هذه الكلمات تحلّل بها أي قصة قصيرة.","البنية في ثلاثة أزمنة: l’exposition تعرّف المكان والشخصيات بسرعة، le nœud يشيّد التوقع، وla chute تقلب المعنى في سطرين. المفارقة أن كل ما يبدو تفصيلاً عشوائياً كان درباً نحو النهاية.","الواقعية عند موباسان: تفاصيل محسوسة (رائحة، رقم، حركة) بلا تعليق نفسي. المؤلف لا يقلّد المشاعر بل يصف ما يُرى، فيترك للمتفرج/القارئ مهمة الحكم.","la concision تعني الحذف: l’ellipse تحذف الوصلات، la phrase courte تحذف الصفات، ولا يبقى إلا الفعل. كل كلمة لا تخدم la chute تُستبعد.","للتمرين: اقرأ قصة قصيرة واستخرج ثلاث جملاً كانت علامةً نحو la chute، ثم أعد كتابتها في سطرين مع الحفاظ على la concision دون إضافة كلمة جديدة."],"sub":[{"h":"la structure en trois temps","p":["L’exposition présente le lieu en deux phrases.","Le nœud crée l’attente du lecteur.","La chute retourne le sens en un tour de main."]},{"h":"les indices de la chute","p":["Un détail banal devient soudain significatif.","Le lecteur doit relire après la chute.","Rien n’est laissé au hasard dans le récit."]},{"h":"la concision du récit","p":["Les phrases courtes accélèrent l’action.","L’ellipse saute les étapes inutiles.","Un seul personnage porte tout le récit."]}]},{"h":"les formules de l’analyse d’une nouvelle","p":["« La chute modifie la lecture de tout le récit. »","« Ce détail, anodin au début, prépare la fin. »","« L’auteur supprime tout commentaire psychologique. »","« La concision donne au récit sa tension. »"]},{"h":"التطبيق والتلخيص","p":["تمرين la chute: اقرأ قصة دون قراءة آخر فقرة، اكتب توقعك، ثم قرأها واحسب عدد الكلمات في la chute.","تمرين la concision: خذ فقرة من 60 كلمة واختصرها إلى 30 كلمة مع الحفاظ على l’intrigue.","تمرين les indices: ضع في الهامش ثلاث كلمات من النص تشير سراً إلى النهاية وشرح لماذا كانت ضرورية."]}],"pron":[{"w":"la nouvelle","ipa":"[la nu.vɛl]","approx":"لا نوڤِل"},{"w":"la chute","ipa":"[la ʃyt]","approx":"لا شوت"},{"w":"la concision","ipa":"[la kɔ̃.si.zjɔ̃]","approx":"كونسيزيون"}],"vocab":[{"fr":"la nouvelle","ar":"القصة القصيرة","pos":"nom","g":"f","exFr":"La nouvelle se lit en une seule fois.","ipa":"[nu.vɛl]","exAr":"تُقرأ القصة القصيرة في جلسة واحدة."},{"fr":"la chute","ar":"المفارقة الختامية","pos":"nom","g":"f","exFr":"La chute arrive en deux phrases.","ipa":"[ʃyt]","exAr":"تأتي المفارقة في جملتين."},{"fr":"l’effet de surprise","ar":"أثر المفاجأة","pos":"loc.","g":"m","exFr":"L’effet de surprise repose sur l’ellipse.","ipa":"[e.fɛ də syʁ.pʁiz]","exAr":"يستند أثر المفاجأة إلى الحذف."},{"fr":"la concision","ar":"الإيجاز","pos":"nom","g":"f","exFr":"La concision force le lecteur à relire.","ipa":"[kɔ̃.si.zjɔ̃]","exAr":"يدفع الإيجاز القارئ إلى إعادة القراءة."},{"fr":"l’ellipse","ar":"الحذف","pos":"nom","g":"f","exFr":"L’ellipse supprime les passages inutiles.","ipa":"[e.lips]","exAr":"يحذف الحذف الممرات غير الضرورية."},{"fr":"le détail","ar":"التفصيل","pos":"nom","g":"m","exFr":"Un détail précis ancre le récit dans le réel.","ipa":"[de.taj]","exAr":"تفصيل دقيق يُثبّت السرد في الواقع."},{"fr":"l’intrigue","ar":"العقدة الحكائية","pos":"nom","g":"f","exFr":"L’intrigue tient en une soirée.","ipa":"[ɛ̃.tʁiɡ]","exAr":"تنعقد الحبكة في مساء واحد."},{"fr":"le personnage","ar":"الشخصية","pos":"nom","g":"m","exFr":"Un seul personnage porte le récit.","ipa":"[pɛʁ.sɔnaʒ]","exAr":"شخصية واحدة تحمل السرد."},{"fr":"le réalisme","ar":"الواقعية","pos":"nom","g":"m","exFr":"Le réalisme préfère les faits aux idées.","ipa":"[ʁe.a.lism]","exAr":"تفضّل الواقعية الوقائع على الأفكار."},{"fr":"condenser","ar":"يُكثّف","pos":"verbe","g":"","exFr":"L’auteur condense trois années en une page.","ipa":"[kɔ̃.dɑ̃.se]","exAr":"يُكثّف المؤلف ثلاث سنوات في صفحة."},{"fr":"étonner","ar":"يُدهش","pos":"verbe","g":"","exFr":"La fin doit étonner sans trahir le récit.","ipa":"[e.tɔ.ne]","exAr":"يجب أن تُدهش النهاية دون خيانة السرد."},{"fr":"semer","ar":"يبذر الإشارات","pos":"verbe","g":"","exFr":"Il sème les indices dès la première page.","ipa":"[sə.me]","exAr":"يبذر الإشارات منذ الصفحة الأولى."}],"examples":[{"fr":"La chute retourne le sens du récit.","ar":"قلب المفارقة معنى السرد.","note":"l’effet de surprise"},{"fr":"L’auteur ne commente pas les sentiments.","ar":"لا يعلّق المؤلف على المشاعر.","note":"le réalisme"},{"fr":"Un détail anodin devient décisif.","ar":"تفصيل عادي يصبح حاسماً.","note":"les indices"},{"fr":"La phrase courte accélère le rythme.","ar":"تُسرّع الجملة القصيرة الإيقاع.","note":"la concision"},{"fr":"L’ellipse saute les mois inutiles.","ar":"يتجاوز الحذف الشهور غير الضرورية.","note":"l’économie du récit"},{"fr":"Le personnage agit sans s’expliquer.","ar":"تعمل الشخصية دون أن تشرح نفسها.","note":"le comportement observable"}],"grammar":[{"tFr":"Les temps du récit : passé simple contre imparfait","tAr":"أزمنة السرد: الماضي البسيط في مقابل المضارع المستمر","body":["Le passé simple fait avancer l’action : « Il entra, il s’assit, il regarda. » L’imparfait installe le décor et l’habitude : « La salle était vide, il faisait froid. » Dans la nouvelle, l’alternance des deux temps règle le rythme.","La chute se joue presque toujours au passé simple : c’est le temps de la surprise. L’imparfait prépare, le passé simple frappe."],"ex":[{"fr":"Il entra, s’assit et attendit sans rien dire.","ar":"دخل وجلس وانتظر دون أن يقول شيئاً."},{"fr":"La salle était vide et le vent soufflait.","ar":"كان القاعة خالية والريح تهب."}]},{"tFr":"Les connecteurs de la surprise et la phrase courte","tAr":"أدوات المفاجأة والجملة القصيرة","body":["Les marqueurs de la rupture commandent la chute : soudain, tout à coup, brusquement, alors. Ils doivent rester sobres : un seul marqueur, placé au début de la phrase, suffit à casser l’attente.","La phrase courte achève l’effet : elle ôte le sujet superflu, garde le verbe et laisse le lecteur finir seul. C’est l’art de Maupassant : dire assez pour laisser deviner."],"ex":[{"fr":"Soudain, il reconnut le chapeau sur la table.","ar":"فجأة، عرف القبعة على الطاولة."},{"fr":"Il ne dit rien. Il sortit.","ar":"لم يقل شيئاً. خرج."}]}],"mistakes":[{"wrong":"ajouter des commentaires psychologiques","right":"décrire les faits et les gestes","why":"le réalisme laisse le lecteur conclure — الواقعية تترك للقارئ أن يستنتج."},{"wrong":"écrire une chute sans préparer les indices","right":"semer les indices dès l’exposition","why":"une chute impréparée trahit le lecteur au lieu de l’étonner — المفارقة المعدّة مسبقاً تفاجئ ولا تخدع."},{"wrong":"confondre la nouvelle et le roman","right":"la nouvelle tient en une lecture, le roman exige du temps","why":"l’économie de la nouvelle interdit les sous-intrigues — القصة لا تحتمل فروع الحبكة."},{"wrong":"croire que la concision vide le texte","right":"comprendre que chaque mot devient utile","why":"dans la nouvelle, ce qui est coupé travaille aussi — المحذوف يعمل هو الآخر."}],"dialogues":[{"title":"Préparer une lecture cursive","ctx":"زميلان يتناقشان قبل كتابة تحليل قصة","lines":[{"who":"Amine","fr":"D’abord, repérons la structure en trois temps.","ar":"أولاً، نحدّد البنية في ثلاثة أزمنة."},{"who":"Chloé","fr":"La chute arrive au dernier paragraphe.","ar":"تأتي المفارقة في الفقرة الأخيرة."},{"who":"Amine","fr":"Il faut montrer les indices préparés dès le début.","ar":"يجب أن نُظهر الإشارات المبذولة منذ البداية."},{"who":"Chloé","fr":"Et garder des phrases courtes dans notre analyse.","ar":"ونحافظ على جمل قصيرة في تحليلنا."}]},{"title":"Réécrire pour raccourcir","ctx":"محرران يختصران فقرة سردية","lines":[{"who":"Sofia","fr":"Ta phrase est longue : coupe après l’action.","ar":"جملتك طويلة: قطعها بعد الفعل."},{"who":"Julien","fr":"Je supprime les adjectifs inutiles.","ar":"أحذف الصفات غير الضرورية."},{"who":"Sofia","fr":"Parfait, la concision fait la force du récit.","ar":"ممتاز، الإيجاز هو قوة السرد."},{"who":"Julien","fr":"Je laisse la dernière phrase seule.","ar":"أُبقي الجملة الأخيرة وحيدة."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما وظيفة « la chute » في القصة القصيرة؟","opts":["قلب التوقع في نهايتها","وصف المكان في مطلعها","تقسيمها إلى فصول","شرح شخصية البطل"],"a":0,"why":"la chute renverse le sens et donne sa clé à tout le récit."},{"t":"fill","skill":"grammar","q":"أكمل: «Le passé simple fait ___ l’action.»","fr":"Le passé simple fait ___ l’action.","ans":"avancer","why":"le passé simple est le temps de l’action ponctuelle dans le récit."},{"t":"order","skill":"writing","q":"رتّب: المفارقة تقلب معنى السرد كله","words":["La","chute","retourne","le","sens","du","récit."],"ans":"La chute retourne le sens du récit.","why":"ordre sujet-verbe-complément avec l’article contracté du."},{"t":"listen","skill":"listening","q":"ما المقصود بـ « la concision » في القصة القصيرة؟","opts":["اختصار يُبقي كل كلمة ضرورية","أسلوب مطنب طويل","وصف تفصيلي للمكان","حوار متكرر"],"a":0,"why":"concision = dire le nécessaire en peu de mots."},{"t":"translate","skill":"writing","q":"ترجم: «فجأة، عرف القبعة على الطاولة.»","ans":"Soudain, il reconnut le chapeau sur la table.","why":"marqueur de rupture + passé simple : le temps de la surprise."},{"t":"speaking","skill":"speaking","q":"اشرح في ثلاث جمل كيف تُعدّ مفارقة قصة قصيرة.","target":"indices / chute / effet de surprise","why":"production orale sur la mécanique de la nouvelle."},{"t":"correct","skill":"grammar","q":"صحّح: «La salle était vide, il entra et la salle était encore vide.»","ans":"La salle était vide, il entra et elle resta vide.","why":"éviter la répétition : l’imparfait prépare, le passé simple actionne."},{"t":"writing","skill":"writing","q":"اكتب فقرة فرنسية من أربع جمل تحلّل مفارقة قصة قصيرة قرأتها، مستعملاً le passé simple وموصَلة بين la chute والفقرة السابقة.","target":"indices / soudain / concision","why":"production écrite : analyse d’une chute avec les temps du récit."}],"homework":"اقرأ قصة قصيرة لموباسان (10 إلى 15 سطراً)، اكتب بناءها في ثلاثة أزمنة، ضع دوائر حول كلمتين كانتا إشارةً إلى la chute، ثم أعد كتابة الفقرة الأخيرة في سطرين فقط.","sources":[{"title":"Comment écrire une NOUVELLE LITTÉRAIRE | Truc d'auteur","channel":"Trucs d'auteur","videoId":"OJm4frGPJQo","why":"شرح عملي لبنية la nouvelle : le scénario en trois temps, la chute et les indices semés en amont — منهج موباسان نفسه في كتابة القصة الواقعية.","cat":"Littérature","level":"C1","main":true},{"title":"MAUPASSANT 📜 Bel-Ami (Résumé-analyse du roman commenté chapitre par chapitre)","channel":"Mediaclasse.fr","videoId":"goBK2RvI2TQ","why":"كيف يبني موباسان personnage وl’intrigue فصلاً بفصل: تطبيق مطوّل لمنهج le réalisme على روايته الأشهر.","cat":"Littérature","level":"C1","extra":true},{"title":"MAUPASSANT : Auteur Hors Normes","channel":"Un Cours de 5 Minutes","videoId":"KMkOi8rcKY0","why":"سيرة مركّزة وموقعه في le réalisme وعلاقته بفلوبير: السياق الضروري قبل تحليل أي قصة له.","cat":"Littérature","level":"C1","extra":true}],"supplements":[{"id":"goBK2RvI2TQ","title":"MAUPASSANT 📜 Bel-Ami (Résumé-analyse du roman commenté chapitre par chapitre)","channel":"Mediaclasse.fr","why":"كيف يبني موباسان personnage وl’intrigue فصلاً بفصل: تطبيق مطوّل لمنهج le réalisme على روايته الأشهر.","lang":"fr","dur":24},{"id":"KMkOi8rcKY0","title":"MAUPASSANT : Auteur Hors Normes","channel":"Un Cours de 5 Minutes","why":"سيرة مركّزة وموقعه في le réalisme وعلاقته بفلوبير: السياق الضروري قبل تحليل أي قصة له.","lang":"fr","dur":6}]},{"id":"c1-t1-l5","fr":"L’essai personnel","ar":"المقال التأمّلي الشخصي: مونتيني","objectives":["شرح مفهوم l’essai بوصفه اختباراً لا مقالة جاهزة","استخراج la citation من نص مونتيني وتحديد وظيفتها","تسمية الأدوات: le connecteur, l’exemple, la digression, la nuance","تحرير فقرة تأمّلية بأسلوب شخصي مستعملاً la première personne"],"sections":[{"h":"الدرس 5: الاستشهاد والاستدلال والصوت الشخصي","video":{"id":"xdMvu19rqqs","title":"Présentation des ESSAIS de MONTAIGNE : tout ce qu'il faut savoir !","channel":"Un Cours de 5 Minutes","why":"مدخل سريع إلى « Les Essais »: كيف يتحوّل الكتاب إلى تجربة ذاتية، وكيف تظهر la citation et le raisonnement داخل la première personne.","lang":"fr","main":true,"dur":5},"p":["l’essai من le verbe essayer: محاولة، وليس برهان نهائي. مونتيني يكتب ليختبر نفسه لا ليعلّم غيره، ولذلك تبقى المقالة مفتوحة: تبدأ سؤالاً وتنتهي سؤالاً أوسع — « Que sais-je ? ».","مفردات المحور: l’essai, la citation, le raisonnement, le connecteur, la digression, l’exemple, la subjectivité, la nuance, citer, nuancer, s’interroger, en définitive. هذه الكلمات هي هياكل النص التأمّلي.","الاستشهاد في l’essai ليس زينة: la citation تدخل صوتاً آخر ثم يعلّق عليه صاحب الاقتباس. القاعدة: تُدرج بين guillemets، ويسبقها فعل قول، ثم تأتي ردة فعل الفكرة.","le raisonnement يسير بـ les connecteurs: or يُعلن المفهوم، donc يستنتج، cependant وي au contraire يقيّدان، par ailleurs يُضيف، en définitive يُغلق. حذفها يجعل الفقرة سلسلة انطباعات لا منطق.","le style personnel يصنعه الانقطاع: الالتفاف، الشرح الذاتي، المثل الشخصي، وحتى التوقف عن الجواب. الجملة ليست مستقيمة دائماً؛ تائهاً واردة هي أحياناً أصدق أداة تأمّل.","للتمرين: اختر فكرة واحدة، اكتبها في جملة، ثم أضف « or » وثلاث جملاً تُقيّدها، واختم بـ « en définitive » مع تدرّج لا مع تكرار."],"sub":[{"h":"citer pour penser","p":["Une citation se place entre guillemets.","Le verbe introducteur annonce l’auteur cité.","Après la citation, l’essai réagit et nuance."]},{"h":"raisonner avec les connecteurs","p":["Or annonce l’idée qu’on va examiner.","Cependant introduit une objection mesurée.","En définitive ferme le mouvement."]},{"h":"écrire à la première personne","p":["La subjectivité n’est pas un défaut ici.","Les exemples viennent de la vie quotidienne.","La digression élargit la question."]}]},{"h":"les formules de l’essai personnel","p":["« Que sais-je ? » — la devise de Montaigne et le moteur de l’essai.","« Or, cette opinion mérite qu’on s’y arrête. »","« Cependant, je ne voudrais pas trancher. »","« En définitive, l’essai reste une expérience. »"]},{"h":"التطبيق والتلخيص","p":["تمرين la citation: اقتبس جملة من درس سابق وضعها بين guillemets، ثم اكتب جملة ردة فعل تبدأ بـ « Toutefois ».","تمرين le raisonnement: اكتب فقرة من أربع جمل عن فكرة يومية مستعملاً or، cependant، en définitive.","تمرين le style: أعد كتابة حكم عام بأسلوب شخصي، بادئاً بـ « Je crois que… » ثم مُظهر تردّدك في الجملة الثالثة."]}],"pron":[{"w":"l’essai","ipa":"[le.se]","approx":"ليسّيه"},{"w":"la citation","ipa":"[si.ta.sjɔ̃]","approx":"سيتاسيون"},{"w":"le raisonnement","ipa":"[ʁɛ.zɔ.nə.mɑ̃]","approx":"ريزونومان"}],"vocab":[{"fr":"l’essai","ar":"المقال التأمّلي (المحاولة)","pos":"nom","g":"m","exFr":"L’essai est un exercice de pensée.","ipa":"[le.se]","exAr":"المقال التأمّلي تمرين في التفكير."},{"fr":"la citation","ar":"الاقتباس","pos":"nom","g":"f","exFr":"La citation éclaire le propos.","ipa":"[si.ta.sjɔ̃]","exAr":"يضيء الاقتباس المعنى."},{"fr":"le raisonnement","ar":"الاستدلال","pos":"nom","g":"m","exFr":"Le raisonnement avance par étapes.","ipa":"[ʁɛ.zɔ.nə.mɑ̃]","exAr":"يتحرّك الاستدلال على مراحل."},{"fr":"le connecteur","ar":"أداة الربط المنطقي","pos":"nom","g":"m","exFr":"Un connecteur marque l’objection.","ipa":"[kɔ.nɛk.tœʁ]","exAr":"تُعلّم أداة الربط الاعتراض."},{"fr":"la digression","ar":"الانحراف عن الموضوع","pos":"nom","g":"f","exFr":"La digression élargit la question.","ipa":"[di.ɡʁɛ.sjɔ̃]","exAr":"يُوسّع الانحراف المطروح نطاق التفكير."},{"fr":"l’exemple","ar":"المثل","pos":"nom","g":"m","exFr":"L’exemple vient de la vie quotidienne.","ipa":"[ɛɡ.zɑ̃.pl]","exAr":"يأتي المثل من الحياة اليومية."},{"fr":"la subjectivité","ar":"ذاتية الرأي","pos":"nom","g":"f","exFr":"La subjectivité est assumée.","ipa":"[syb.ʒɛk.ti.vi.te]","exAr":"تُتحمّل الذاتية في هذا النص."},{"fr":"la nuance","ar":"التخصيص والتدريج","pos":"nom","g":"f","exFr":"La nuance évite les jugements trop secs.","ipa":"[nɥɑ̃s]","exAr":"يمنع التدريج الأحكام الجافة."},{"fr":"citer","ar":"يقتبس","pos":"verbe","g":"","exFr":"Il cite Plutarque sans le nommer.","ipa":"[si.te]","exAr":"يقتبس بلوتارك دون أن يسميه."},{"fr":"nuancer","ar":"يُدبّر ويلطّف","pos":"verbe","g":"","exFr":"Il nuance sa conclusion.","ipa":"[nɥɑ̃.se]","exAr":"يلطّف خاتمته."},{"fr":"s’interroger","ar":"يطرح سؤالاً على نفسه","pos":"verbe","g":"","exFr":"L’essai s’interroge plus qu’il n’affirme.","ipa":"[sɛ̃.tɛ.ʁɔ.ʒe]","exAr":"يسأل المقال أكثر مما يُقرّر."},{"fr":"en définitive","ar":"في الخلاصة","pos":"loc.","g":"","exFr":"En définitive, l’essai reste ouvert.","ipa":"[ɑ̃ de.fi.ni.tiv]","exAr":"في الخلاصة، يبقى المقال مفتوحاً."}],"examples":[{"fr":"Que sais-je ?","ar":"ماذا أعلم؟","note":"la devise de Montaigne"},{"fr":"Or, cette opinion mérite qu’on s’y arrête.","ar":"وأما هذه الرأي فتستحق التوقف عنده.","note":"le connecteur d’ouverture"},{"fr":"« Chacun porte en soi la forme entière de la condition humaine. »","ar":"« يحمل كل واحد في ذاته شكل الشرط الإنساني كاملاً ».","note":"la citation intégrée"},{"fr":"Cependant, je ne voudrais pas trancher.","ar":"ومع ذلك، ما كنت أريد أن أُجزم.","note":"la nuance"},{"fr":"Je prends plaisir à me contredire.","ar":"أستمتع بأن أناقض نفسي.","note":"le style personnel"},{"fr":"En définitive, l’essai reste une expérience.","ar":"في الخلاصة، يبقى المقال تجربة.","note":"la clôture"}],"grammar":[{"tFr":"Les connecteurs logiques de l’essai","tAr":"أدوات الربط المنطقي في المقال التأمّلي","body":["La progression de l’essai repose sur une chaîne de connecteurs : or annonce l’idée, donc en tire la conséquence, cependant introduit la réserve, au contraire renverse, par ailleurs ajoute, en définitive referme.","Attention à l’ordre : un connecteur ne se place pas n’importe où. cependant se pose au début d’une phrase autonome ; au contraire relie deux propositions ; or marque la reprise du raisonnement."],"ex":[{"fr":"Or, ce proverbe cache une contradiction.","ar":"وأما هذا المثل فهو يُخفي تناقضاً."},{"fr":"Je le crois vrai ; cependant, je reste prudent.","ar":"أظنه صحيحاً؛ ومع ذلك أبقى متيقظاً."}]},{"tFr":"La citation intégrée à la phrase","tAr":"إدراج الاقتباس داخل الجملة","body":["Une citation s’encadre de guillemets et se rattache à la phrase par un verbe : « écrit Montaigne », « soutient l’auteur ». En français littéraire, on garde le présent du texte cité même si le verbe introducteur est au passé.","La règle d’accord : le verbe introducteur se rapporte au sujet citant (« Montaigne écrit que… »), jamais au contenu. Après la citation, relancez l’idée avec un connecteur pour éviter l’effet de collage."],"ex":[{"fr":"Montaigne écrit : « L’expérience est un méchant maître. »","ar":"يكتب مونتيني: « التجربة معلّم سيّئ »."},{"fr":"Cependant, il refuse d’en tirer une loi générale.","ar":"ومع ذلك، فهو يرفض أن يستخلص منها قاعدة عامة."}]}],"mistakes":[{"wrong":"citez une citation sans la commenter","right":"citez, puis réagissez avec un connecteur","why":"dans l’essai, la citation sert à la pensée de l’auteur, pas à décorer — الاقتباس خادم للفكرة لا زينة."},{"wrong":"employer « donc » après une phrase sans lien","right":"ne garder le connecteur que si la conséquence est réelle","why":"un connecteur mal placé casse le raisonnement — أداة الربط الخاطئة تكسر الاستدلال."},{"wrong":"écrire une conclusion ferme et définitive","right":"conclure avec une nuance ou une ouverture","why":"l’essai reste une tentative : « Que sais-je ? » — المقال محاولة مفتوحة لا حكم نهائي."},{"wrong":"éviter la première personne à l’écrit","right":"assumer la subjectivité quand le sujet l’exige","why":"le style personnel est la matière même de l’essai — الصوت الشخصي هو مادة المقال."}],"dialogues":[{"title":"Intégrer une citation","ctx":"طالبان يُعدّان فقرة تأمّلية","lines":[{"who":"Rania","fr":"Je commence par la citation, entre guillemets.","ar":"أبدأ بالاقتباس، بين علامتَي تنصيص."},{"who":"Paul","fr":"Puis tu ajoute le verbe : écrit Montaigne.","ar":"ثم تضيفين الفعل: يكتب مونتيني."},{"who":"Rania","fr":"Ensuite une objection avec cependant.","ar":"ثم اعتراض باستخدام « ومع ذلك »."},{"who":"Paul","fr":"Et une chute ouverte, sans trancher.","ar":"ونهاية مفتوحة، دون جزم."}]},{"title":"Nuancer un jugement","ctx":"محرران يناقشان صياغة خاتمة","lines":[{"who":"Samir","fr":"Ta phrase est trop catégorique.","ar":"جملتك قاطعة أكثر من اللازم."},{"who":"Emma","fr":"Alors je remplace « certes » par « sans doute ».","ar":"إذن أستبدل « بلا ريب » بـ « من دون شك »."},{"who":"Samir","fr":"La nuance rend l’essai plus crédible.","ar":"يجعل التدريج المقال أكثر مصداقية."},{"who":"Emma","fr":"Je termine par en définitive, sans fermer la porte.","ar":"أختم بـ « في الخلاصة » دون أن أُغلق الباب."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما معنى كلمة « essai » عند مونتيني؟","opts":["محاولة تفكير غير نهائية","دليل علمي مثبت","قصة قصيرة","رسالة رسمية"],"a":0,"why":"essayer = mettre à l’épreuve : l’essai est une tentative."},{"t":"fill","skill":"grammar","q":"أكمل: «___, cette opinion mérite qu’on s’y arrête.»","fr":"___, cette opinion mérite qu’on s’y arrête.","ans":"Or","why":"or est le connecteur d’ouverture du raisonnement."},{"t":"order","skill":"writing","q":"رتّب: يستخدم المقال التأملي أداة الربط المنطقي","words":["L’essai","utilise","des","connecteurs","logiques."],"ans":"L’essai utilise des connecteurs logiques.","why":"ordre sujet-verbe-complément, la ponctuation reste au dernier mot."},{"t":"listen","skill":"listening","q":"ما وظيفة la citation داخل l’essai؟","opts":["إدخال صوت آخر ثم مناقشته","ختام المقال بحكم نهائي","سرد حدث تاريخي","وصف المكان"],"a":0,"why":"la citation ouvre un dialogue entre l’auteur et celui qu’il cite."},{"t":"translate","skill":"writing","q":"ترجم: «ومع ذلك، ما كنت أريد أن أُجزم.»","ans":"Cependant, je ne voudrais pas trancher.","why":"cependant en tête de phrase + la nuance du conditionnel."},{"t":"speaking","skill":"speaking","q":"عبّر عن رأيك في مسألة يومية في ثلاث جمل، مستعملاً or وcependant وen définitive.","target":"or / cependant / en définitive","why":"prise de parole structurée par les connecteurs du raisonnement."},{"t":"correct","skill":"grammar","q":"صحّح: «Montaigne a écrit : “l’expérience est un maître méchant”.»","ans":"Montaigne écrit : « l’expérience est un maître méchant ».","why":"on garde le présent du texte cité et les guillemets français."},{"t":"writing","skill":"writing","q":"اكتب فقرة فرنسية من أربع جمل تجمع بين la citation et le raisonnement في موضوع تختاره أنت.","target":"citation / connecteurs / nuance","why":"production écrite : appliquer la méthode de l’essai personnel."}],"homework":"اقرأ مقطعاً من « Les Essais » لا يتجاوز عشرين سطراً، اقتبس جملتين بين guillemets مع تفسير كل منهما، ثم اكتب فقرة تأمّلية من خمس جملاً مستعملاً ثلاثة connecteurs مختلفة.","sources":[{"title":"Présentation des ESSAIS de MONTAIGNE : tout ce qu'il faut savoir !","channel":"Un Cours de 5 Minutes","videoId":"xdMvu19rqqs","why":"مدخل سريع إلى « Les Essais »: كيف يتحوّل الكتاب إلى تجربة ذاتية، وكيف تظهر la citation et le raisonnement داخل la première personne.","cat":"Littérature","level":"C1","main":true},{"title":"Lecture analytique, Montaigne, les Essais, De l'Amitié (I, 27)","channel":"Le Bac Français","videoId":"G09lm4cXB1M","why":"شرح لفظي لمعيار من « De l’Amitié »: كيف تظهر la citation et le raisonnement داخل la première personne مونتيني.","cat":"Littérature","level":"C1","extra":true},{"title":"Les 20 plus belles citations de Montaigne | 1001 Citations","channel":"Mille et Une Citations","videoId":"UEPJFxgljrs","why":"جردة من أشهر جُمل مونتيني: تدريب مباشر على la citation وعلى لغة التدريج والنبرة الشخصية.","cat":"Littérature","level":"C1","extra":true}],"supplements":[{"id":"G09lm4cXB1M","title":"Lecture analytique, Montaigne, les Essais, De l'Amitié (I, 27)","channel":"Le Bac Français","why":"شرح لفظي لمعيار من « De l’Amitié »: كيف تظهر la citation et le raisonnement داخل la première personne مونتيني.","lang":"fr","dur":11},{"id":"UEPJFxgljrs","title":"Les 20 plus belles citations de Montaigne | 1001 Citations","channel":"Mille et Une Citations","why":"جردة من أشهر جُمل مونتيني: تدريب مباشر على la citation وعلى لغة التدريج والنبرة الشخصية.","lang":"fr","dur":4}]},{"id":"c1-t1-l6","fr":"La critique littéraire contemporaine","ar":"النقد الأدبي المعاصر: الصحافة الأدبية والمجلات الأدبية","objectives":["التمييز بين le compte rendu et l’essai de critique","استخراج la nuance من الجملة النقدية: le modalisateur, le conditionnel","تفسير مفهوم le mythe عند رولان بارط في « Mythologies »","كتابة paragraph critique من أربع جمل: الفكرة، الدليل، التحفظ، الحكم"],"sections":[{"h":"الدرس 6: كيف يكتب الناقد ولا يُجزم","video":{"id":"IlBaSVCpKmw","title":"Littérature : à quoi sert la critique ?","channel":"France Culture","why":"نقاش معمّق حول وظيفة la critique : هل هي حكم أم تفسير؟ وكيف تغيّرت في الصحافة الأدبية وفي les revues، مع أمثلة من le métier de critique.","lang":"fr","main":true,"dur":37},"p":["la critique المعاصرة ليست حكماً نهائياً بل وضعياً: تُقيّم نصاً داخل زمانه وسوقه ومنشوراته. الصحافة الأدبية (le Monde des livres, La NRF, Europe) تجمع بين l’annonce du livre et l’analyse: تقديم ثم تحليل ثم تحفّظ.","مفردات المحور: la critique, le compte rendu, la revue, la presse littéraire, le critique, l’article, le mythe, la sémiologie, le signe, juger, réserver, l’enjeu. هذه المفردات تسمّي أجزاء المقالة النقدية.","رولان بارط في « Mythologies » يقرأ الظواهر اليومية (المصارعة، صورة الإعلان، لحم البقرة المشوي) كـ les signes تُنتج معنى اجتماعياً. la sémiologie تكشف كيف يتحوّل le mythe من رأي إلى طبيعة.","لغة la critique تحذر من الإطلاق: le modalisateur (sans doute, semble, paraître) والشرطية (serait, pourrait) تُبقي الباب مفتوحاً. الافتراء بلا تحفظ يجعل النص إعلاناً لا نقداً.","هيكل le compte rendu: جملة أولى تُعرّف بالعمل، ثم le développement avec une citation, ثم la phrase de réserve، وأخيراً la recommandation: à lire ou à retenir. أما l’essai فيبدأ بسؤال لا بكتاب.","للتمرين: خذ جملة نقدية قاطعة وحوّلها بثلاثة modalisators، ثم اكتب الخاتمة في شرطية واحدة تُبقي الحكم معلّقاً."],"sub":[{"h":"les rubriques de la presse","p":["Le compte rendu présente un livre en deux pages.","La revue publie des essais plus longs.","Le critique annonce, analyse et réserve."]},{"h":"la nuance du jugement","p":["Sans doute, ce roman manque un peu de souffle.","Cette lecture mériterait d’être reprise.","En effet, l’auteur maîtrise son style."]},{"h":"Barthes et le mythe","p":["Un mythe transforme une opinion en évidence.","La sémiologie décrit les signes du quotidien.","Le critique montre le fonctionnement du message."]}]},{"h":"les formules de la critique","p":["« Ce livre mérite d’être lu pour sa langue. »","« L’enjeu de ce roman est moins le sujet que le rythme. »","« Sans doute l’auteur eût-il gagné à resserrer la fin. »","« En effet, la revue confirme cette tendance. »"]},{"h":"التطبيق والتلخيص","p":["تمرين la nuance: حوّل ثلاث جمل نقدية قاطعة إلى جمل مُدلّلة باستعمال sans doute et paraître.","تمرين le compte rendu: اكتب عرضاً من ست جملاً: تمهيد، اقتباس، تحفّظ، توصية.","تمرين la sémiologie: اختر إعلاناً أو صورة شائعة واشرح بثلاث جملاً le mythe الذي تنتجه."]}],"pron":[{"w":"la critique","ipa":"[la kʁi.tik]","approx":"لا كريتيك"},{"w":"le compte rendu","ipa":"[lə kɔ̃t ʁɑ̃.dy]","approx":"لُ كونت رانديو"},{"w":"la sémiologie","ipa":"[se.mjɔ.lɔʒ]","approx":"سيميولوج"}],"vocab":[{"fr":"la critique","ar":"النقد الأدبي","pos":"nom","g":"f","exFr":"La critique éclaire l’œuvre sans la juger hâtivement.","ipa":"[kʁi.tik]","exAr":"ينوّر النقد العمل دون أن يحكم عليه بتعجل."},{"fr":"le compte rendu","ar":"العرض والتحليل لكتاب","pos":"nom","g":"m","exFr":"Le compte rendu tient en deux pages.","ipa":"[kɔ̃t ʁɑ̃.dy]","exAr":"يأتي العرض في صفحتين."},{"fr":"la revue","ar":"المجلة الأدبية","pos":"nom","g":"f","exFr":"La revue publie trois essais par numéro.","ipa":"[ʁə.vy]","exAr":"تنشر المجلة ثلاثة مقالات في كل عدد."},{"fr":"la presse littéraire","ar":"الصحافة الأدبية","pos":"loc.","g":"f","exFr":"La presse littéraire prépare la rentrée.","ipa":"[pʁɛs li.tɛ.ʁɛʁ]","exAr":"تهيّئ الصحافة الأدبية لموسم النشر."},{"fr":"le critique","ar":"الناقد","pos":"nom","g":"m","exFr":"Le critique réserve son jugement.","ipa":"[kʁi.tik]","exAr":"يُبقي الناقد حكمه معلّقاً."},{"fr":"l’article","ar":"المقال","pos":"nom","g":"m","exFr":"L’article s’ouvre sur une question.","ipa":"[aʁ.tikl]","exAr":"يبدأ المقال بسؤال."},{"fr":"le mythe","ar":"القالب الأسطوري","pos":"nom","g":"m","exFr":"Le mythe présente une opinion comme une évidence.","ipa":"[mit]","exAr":"يقدّم القالب الرأي كشيء مسلّم به."},{"fr":"la sémiologie","ar":"علم الدلالة والعلامات","pos":"nom","g":"f","exFr":"La sémiologie analyse les signes du quotidien.","ipa":"[se.mjɔ.lɔʒ]","exAr":"يحلّل علم الدلالة علامات الحياة اليومية."},{"fr":"le signe","ar":"العلامة الدالة","pos":"nom","g":"m","exFr":"Tout signe porte un sens social.","ipa":"[siɲ]","exAr":"تحمل كل علامة معنى اجتماعياً."},{"fr":"juger","ar":"يحكم","pos":"verbe","g":"","exFr":"Il juge sans connaître le livre.","ipa":"[ʒy.ʒe]","exAr":"يحكم دون أن يعرف الكتاب."},{"fr":"réserver","ar":"يُبقي تحفّظاً","pos":"verbe","g":"","exFr":"Elle réserve son avis pour la fin.","ipa":"[ʁe.zɛʁ.ve]","exAr":"تُبقي رأيها إلى النهاية."},{"fr":"l’enjeu","ar":"المستوى المطروح","pos":"nom","g":"m","exFr":"L’enjeu de ce roman est le rythme.","ipa":"[ɑ̃.ʒø]","exAr":"مستوى هذه الرواية هو الإيقاع."}],"examples":[{"fr":"Sans doute ce roman manque-t-il de souffle.","ar":"من دون شك تنقص هذه الرواية نَفَساً.","note":"le modalisateur"},{"fr":"Le mythe transforme une opinion en évidence.","ar":"يحوّل القالب الرأي إلى شيء مسلّم به.","note":"Barthes, Mythologies"},{"fr":"Le compte rendu annonce, analyse, puis réserve.","ar":"يُعلن العرض ثم يحلّل ثم يُبقي تحفّظه.","note":"la structure de l’article"},{"fr":"Cette lecture mériterait d’être reprise.","ar":"تستحق هذه القراءة إعادة النظر فيها.","note":"le conditionnel de réserve"},{"fr":"En effet, l’auteur maîtrise son style.","ar":"في الواقع، يتقن المؤلف أسلوبه.","note":"le connecteur d’appui"},{"fr":"L’enjeu n’est pas le sujet mais le rythme.","ar":"المستوى المطروح ليس الموضوع بل الإيقاع.","note":"la thèse critique"}],"grammar":[{"tFr":"Les modalisateurs de la nuance","tAr":"أدوات التلطيف والتحفّظ في اللغة النقدية","body":["La critique refuse l’absolu : sans doute, semble, paraître, on dirait, il est probable que déplacent le jugement du fait vers l’impression. « Ce livre est faible » devient « ce livre semble faible à l’usage ».","Le conditionnel joue le même rôle dans la conclusion : « cette fin eût gagné à être resserrée ». L’effet n’est pas d’hésiter, mais de rendre la discussion possible."],"ex":[{"fr":"Cette fin semble précipitée.","ar":"تبدو هذه النهاية متعجلة."},{"fr":"Sans doute eût-il mieux valu resserrer le dernier chapitre.","ar":"من دون شك كان من الأفضل تلخيص الفصل الأخير."}]},{"tFr":"Le conditionnel de réserve et la recommandation","tAr":"الشرطية الاحتياطية والتوصية في العرض النقدي","body":["Deux formules ferment le compte rendu : la recommandation au présent (« Ce livre mérite d’être lu ») et la réserve au conditionnel (« On pourrait souhaiter une suite »). La première engage, la seconde laisse le lecteur juger.","Attention à l’accord du participe dans la tournure + être : « d’être reprise », et au subjonctif après souhaiter que. La correction grammaticale est la première condition de la crédibilité critique."],"ex":[{"fr":"Ce recueil mérite d’être lu cet été.","ar":"يستحق هذا الكتاب القراءة هذا الصيف."},{"fr":"On souhaiterait que la préface soit plus claire.","ar":"كنا نتمنى لو كانت المقدمة أوضح."}]}],"mistakes":[{"wrong":"écrire « ce livre est mauvais » sans preuve","right":"appuyer le jugement sur une citation","why":"la critique se prouve : sans preuve, ce n’est plus un critique mais une opinion — النقد يُبرهن ولا يُجزم بغير دليل."},{"wrong":"confondre la revue et le journal quotidien","right":"la revue publie des essais longs, le quotidien des comptes rendus courts","why":"le format détermine la profondeur de l’analyse — المجلة تُطيل واليومية تختصر."},{"wrong":"croire que Barthes dénonce les mythes","right":"Barthes décrit comment le mythe fonctionne","why":"il analyse le message, il ne juge pas le contenu — يحلّل بارط آلية الرمز لا محتواه."},{"wrong":"employer le conditionnel partout","right":"réserver le conditionnel à la conclusion","why":"la nuance généralisée affaiblit la thèse — التلطيف المطلق يُضعف الحجة."}],"dialogues":[{"title":"Préparer une revue de presse","ctx":"ناقدان يُرتّبان خلاصة صحافية أدبية","lines":[{"who":"Antoine","fr":"Commençons par la rubrique du Monde des livres.","ar":"نبدأ بقسم « العالم للكتب » في الصحافة الأدبية."},{"who":"Yasmine","fr":"Je résume les trois parutions de la semaine.","ar":"ألخّص الإصدارات الثلاثة لهذا الأسبوع."},{"who":"Antoine","fr":"Ajoute une citation pour appuyer le jugement.","ar":"أضف اقتباساً يدعم الحكم."},{"who":"Yasmine","fr":"Et on garde une phrase de réserve en conclusion.","ar":"ونُبقي جملة تحفظ في الخاتمة."}]},{"title":"Débattre d’un livre","ctx":"برنامج إذاعي حول رواية حديثة","lines":[{"who":"Camille","fr":"Le style paraît remarquable, sans doute.","ar":"يبدو الأسلوب رائعاً، من دون شك."},{"who":"Nabil","fr":"Cependant, l’intrigue reste prévisible.","ar":"ومع ذلك، تبقى العقدة متوقعة."},{"who":"Camille","fr":"L’enjeu est ailleurs : le rythme des phrases.","ar":"المستوى المطروح مكان آخر: إيقاع الجمل."},{"who":"Nabil","fr":"Alors recommandons-le pour la langue.","ar":"إذن نوصي به من أجل اللغة."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما الفرق بين le compte rendu و la revue؟","opts":["العرض قصير في الصحافة اليومية والمجلة تنشر مقالات طويلة","كلتاهما مقال قصير","المجلة تنشر الشعر فقط","العرض للمراجع لا للكتب"],"a":0,"why":"le format quotidien impose la concision, la revue autorise l’essai."},{"t":"fill","skill":"grammar","q":"أكمل: «___ doute, ce roman manque de souffle.»","fr":"___ doute, ce roman manque de souffle.","ans":"Sans","why":"sans doute est le modalisateur de réserve le plus courant."},{"t":"order","skill":"writing","q":"رتّب: يُعلن الناقد ثم يحلّل ثم يبقي تحفظه","words":["Le","critique","annonce","analyse","puis","réserve."],"ans":"Le critique annonce analyse puis réserve.","why":"succession logique des trois temps du compte rendu."},{"t":"listen","skill":"listening","q":"ما الذي يفعله le mythe حسب رولان بارط؟","opts":["يحوّل رأياً اجتماعياً إلى شيء مسلّم به","يخترع قصة قديمة","يصحح خطأ لغوياً","يعلن تاريخ الكتاب"],"a":0,"why":"le mythe naturalise une opinion : il la fait passer pour une évidence."},{"t":"translate","skill":"writing","q":"ترجم: «تستحق هذه القراءة إعادة النظر فيها.»","ans":"Cette lecture mériterait d’être reprise.","why":"conditionnel de réserve + construction avec être au infinitif."},{"t":"speaking","skill":"speaking","q":"قدّم عرضاً شفهياً من ثلاث جملاً لكتاب قرأتها: تمهيد، حجة، تحفّظ.","target":"annonce / argument / réserve","why":"prise de parole structurée selon le plan du compte rendu."},{"t":"correct","skill":"grammar","q":"صحّح: «Ce livre mérite d’être lu, et ce style a été salutaire.»","ans":"Ce livre mérite d’être lu, et ce style aurait été salutaire.","why":"dans la critique, la conclusion se dit au conditionnel de réserve et non au passé composé."},{"t":"writing","skill":"writing","q":"اكتب فقرة نقدية فرنسية من أربع جمل: ابدأ بـ « Sans doute »، اذكر حجة واحدة، واختم بـ « En effet ».","target":"modalisateur / argument / connecteur","why":"production écrite : nuance et cohérence de l’essai critique."}],"homework":"اقرأ عرضاً نقدياً من صحافة أدبية (صفحة واحدة)، انسخ ثلاث جملاً تحمل la nuance وفسّر أداة التلطيف في كل منها، ثم اكتب فقرة نقدية من خمس جملاً عن كتاب أعجبك مستعملاً conditionnel في الخاتمة.","sources":[{"title":"Littérature : à quoi sert la critique ?","channel":"France Culture","videoId":"IlBaSVCpKmw","why":"نقاش معمّق حول وظيفة la critique : هل هي حكم أم تفسير؟ وكيف تغيّرت في الصحافة الأدبية وفي les revues، مع أمثلة من le métier de critique.","cat":"Littérature","level":"C1","main":true},{"title":"Roland Barthes : Mythologies","channel":"Cultures et Savoirs","videoId":"i1TNnag4lL0","why":"شرح مبسّط لـ « Mythologies »: كيف يقرأ بارط الظواهر اليومية كـ les signes، وهو المرجع النظري للدرس.","cat":"Littérature","level":"C1","extra":true},{"title":"Le métier de critique littéraire : rencontre avec Raphaëlle Leyris, du Monde des Livres","channel":"Bibliothèque Buffon","videoId":"5_v14z1SYG0","why":"شهادة مباشرة من ناقدة صحيفة: كيف يُكتب le compte rendu داخل redaction، وما حدود la nuance والتحفّظ.","cat":"Littérature","level":"C1","extra":true}],"supplements":[{"id":"i1TNnag4lL0","title":"Roland Barthes : Mythologies","channel":"Cultures et Savoirs","why":"شرح مبسّط لـ « Mythologies »: كيف يقرأ بارط الظواهر اليومية كـ les signes، وهو المرجع النظري للدرس.","lang":"fr","dur":7},{"id":"5_v14z1SYG0","title":"Le métier de critique littéraire : rencontre avec Raphaëlle Leyris, du Monde des Livres","channel":"Bibliothèque Buffon","why":"شهادة مباشرة من ناقدة صحيفة: كيف يُكتب le compte rendu داخل redaction، وما حدود la nuance والتحفّظ.","lang":"fr","dur":54}]}]},{"id":"c1-t2","slug":"les-expressions-idiomatiques","icon":"quote","color":"#dc2626","fr":"Les expressions idiomatiques","ar":"التعبيرات الاصطلاحية","desc":"le corps، les animaux، l’argent، les verbes figés، les proverbes، l’ironie — la carte lexicale C1.","lessons":[{"id":"c1-t2-l1","fr":"Expressions avec le corps","ar":"التعبيرات الاصطلاحية المرتبطة بأعضاء الجسد","objectives":["تمييز المعنى الحرفية والمعنى الاصطلاحي في تعبيرات الجسد مثل « avoir la tête dans les nuages »","ضبط le registre de كل تعبير: ما هو familier وما هو courant وما هو soutenu","استعمال عشر تعبيرات جسدية بدقّة في سياقات مكتوبة ومنطوقة","تفسير الجذر المجازي لكل تعبير: لماذا تعني « les pieds sur terre » التوازن؟"],"sections":[{"h":"الدرس 1: كيف يتكلّم الجسد باللغة الفرنسية","video":{"id":"eub2oNe_7yA","title":"10 expressions françaises avec des parties du corps","channel":"Français avec Pierre","why":"شرح واضح لعشر تعبيرات فرنسية شائعة تستعمل أعضاء الجسد: تظهر فيها كيف ينتقل المعنى من le sens propre إلى le sens figuré، مع أمثلة على le registre courant.","lang":"fr","main":true,"dur":10},"p":["اللغة الفرنسية تستعمل الجسد كخريطة مجازية: la tête تعني le raisonnement، le cœur تعني les émotions، la main تعني l’aide ou le travail، et les pieds تعني le départ ou la stabilité. فهم هذه الخريطة يجعل التعبير الاصطلاحي قابلاً للتوقع بدل الحفظ الأعمى.","« Avoir la tête dans les nuages » تعني التفکّر أو التشرّد الذهني: la tête تُصوَّر في les nuages بعيداً عن la réalité terrestre. عكسها « avoir les pieds sur terre » وهو وصف إيجابي لشخص عملي واقعي.","« Donner un coup de main » عبارة courant تعني المساعدة دون تكلّف: la main هنا رمز le travailleur. أما « se faire un sang d’encre » فـ registre familier تعني القلق الشديد، وصورتها دموية: le sang qui se coagule من الخوف.","« Avoir le cœur sur la main » تعني الكرم والانفتاح العاطفي، و« poser les pieds sur table » تعني الاسترخاء المفرط وهو registre familier. لاحظ أن la table هنا ليست la table de travail بل la table de repos.","« Tomber dans les pommes » (familier) تعني الإغماء أو فقدان الوعي، و« en avoir plein le dos » تعني التعب من الظروف. كلاهما ينقل معنى الحالة الجسدية إلى le vécu psychologique.","للاستحواذ على هذه التعبيرات: اكتب كل تعبير في جملة من حياتك، ثم حوّلها إلى la négation ثم إلى la question. الاستعمال المتكرر في سياقات مختلفة هو ما يثبّت la nuance de registre."],"sub":[{"h":"la tête et le cœur","p":["Il a la tête dans les nuages pendant le cours.","Elle a le cœur sur la main : elle aide toujours.","Il faut rester les pieds sur terre."]},{"h":"les mains et le dos","p":["Peux-tu me donner un coup de main ?","J’en ai plein le dos de cette situation.","Il travaille de toutes ses mains."]},{"h":"le registre au quotidien","p":["Se faire un sang d’encre, c’est très familier.","Donner un coup de main se dit partout.","Attention au sens figuré !"]}]},{"h":"les expressions à retenir","p":["« Avoir la tête dans les nuages… » — le rêveur distrait.","« Donner un coup de main… » — l’aide simple et spontanée.","« Se faire un sang d’encre… » — la peur intense (familier).","« Avoir les pieds sur terre… » — le réalisme."]},{"h":"التطبيق والتلخيص","p":["تمرين le registre: ضع كل تعبير من هذه الدرس في جملة واحدة، وحدّد هل هو courant أم familier، ثم اشرح السبب.","تمرين la transformation: حوّل ثلاث تعبيرات جسدية من le registre familier إلى le registre soutenu مستعملاً les périphrases.","تمرين la métonymie: اختر تعبيراً واحداً وارسم جسداً يمثّله حرفياً، ثم اكتب جملة تشرح معناه الاصطلاحي."]}],"pron":[{"w":"la tête","ipa":"[la tɛt]","approx":"لا تيت"},{"w":"le cœur","ipa":"[lə kœʁ]","approx":"لو كور"},{"w":"la main","ipa":"[la mɛ̃]","approx":"لا مان"}],"vocab":[{"fr":"avoir la tête dans les nuages","ar":"يَحلُم ويَنشغل بخياله","pos":"loc. verb.","g":"","exFr":"Pendant le conseil, il avait la tête dans les nuages.","ipa":"[a.vwaʁ la tɛt dɑ̃ le nɥaʒ]","exAr":"أثناء الاجتماع كان يَحلُم ويشتّت ذهنه."},{"fr":"donner un coup de main","ar":"يُقدِّم مساعدة صغيرة","pos":"loc. verb.","g":"","exFr":"Tu peux me donner un coup de main pour déménager ?","ipa":"[dɔ.ne œ̃ ku də mɛ̃]","exAr":"هل يمكنك أن تساعدني في النقل؟"},{"fr":"avoir les pieds sur terre","ar":"يكون واقعياً متوازناً","pos":"loc. verb.","g":"","exFr":"Malgré son succès, elle a les pieds sur terre.","ipa":"[a.vwaʁ le pje syʁ tɛʁ]","exAr":"رغم نجاحها تبقى متوازنة واقعية."},{"fr":"se faire un sang d’encre","ar":"يَقلقُ قلقاً شديداً","pos":"loc. verb.","g":"","exFr":"Je me suis fait un sang d’encre en attendant son résultat.","ipa":"[sə fɛʁ œ̃ sɑ̃ dɑ̃kʁ]","exAr":"قلقتُ قلقاً شديداً وأنا أنتظر نتيجته."},{"fr":"avoir le cœur sur la main","ar":"يكون كريماً متحمساً","pos":"loc. verb.","g":"","exFr":"C’est une femme généreuse, elle a le cœur sur la main.","ipa":"[a.vwaʁ lə kœʁ syʁ la mɛ̃]","exAr":"إنها امرأة كريمة، قلبها على يدها."},{"fr":"poser les pieds sur table","ar":"يستريح بلا اكتراث","pos":"loc. verb.","g":"","exFr":"Après la fête, il a posé les pieds sur table.","ipa":"[po.ze le pje syʁ tabl]","exAr":"بعد الحفل استراح دون اهتمام."},{"fr":"tomber dans les pommes","ar":"يفقد وعيه (يُغمى عليه)","pos":"loc. verb.","g":"","exFr":"Elle est tombée dans les pommes à cause de la chaleur.","ipa":"[tɔ̃.be dɑ̃ le pɔm]","exAr":"فقدت وعيها بسبب الحرارة."},{"fr":"en avoir plein le dos","ar":"يكون متعباً من شيء ما","pos":"loc. verb.","g":"","exFr":"J’en ai plein le dos de ces réunions.","ipa":"[ɑ̃ a.vwaʁ plɛ̃ lə do]","exAr":"سئمتُ من هذه الاجتماعات حتى عظامي."},{"fr":"avoir un coup de foudre","ar":"ينهال حباً من أول نظرة","pos":"loc. verb.","g":"","exFr":"Ils ont eu un coup de foudre au premier regard.","ipa":"[a.vwaʁ œ̃ ku də fudʁ]","exAr":"وقع حبّهما من النظرة الأولى."},{"fr":"les pieds qui me démangent","ar":"الرغبة الملحة في السفر أو التحرك","pos":"loc. nom.","g":"f","exFr":"Les pieds me démangent : il faut voyager.","ipa":"[le pje ki də.mɑ̃ʒ]","exAr":"قدماي تلزقانني: يجب أن أسافر."},{"fr":"prendre ses jambes à son cou","ar":"يهرب مسرعاً","pos":"loc. verb.","g":"","exFr":"Quand il a vu le chien, il a pris ses jambes à son cou.","ipa":"[pʁɑ̃dʁ se ʒɑ̃b a sɔ̃ ku]","exAr":"حين رأى الكلب أخذ رجليه على عنقه."},{"fr":"se creuser la tête","ar":"يُفكّر كثيراً ويجتهد ذهنياً","pos":"loc. verb.","g":"","exFr":"Je me creuse la tête pour trouver la solution.","ipa":"[sə kʁø.ze la tɛt]","exAr":"أُفكّر كثيراً لأجد الحل."}],"examples":[{"fr":"Il a la tête dans les nuages : il n’écoute pas.","ar":"عقله في السحاب: لا يُصغي.","note":"le sens figuré de la tête"},{"fr":"Peux-tu me donner un coup de main ?","ar":"هل يمكنك أن تساعدني قليلاً؟","note":"registre courant, amical"},{"fr":"Elle a le cœur sur la main.","ar":"قلبها على يدها: كريمة ومتحمسة.","note":"la générosité"},{"fr":"Restez les pieds sur terre, messieurs !","ar":"ابقوا واقعيين يا سادة!","note":"le réalisme"},{"fr":"Il s’est fait un sang d’encre en attendant.","ar":"قلق قلقاً شديداً وهو ينتظر.","note":"registre familier"},{"fr":"Elle a enfin trouvé son coup de foudre.","ar":"وجدت أخيراً حبّ حياتها من أول نظرة.","note":"la rencontre amoureuse"}],"grammar":[{"tFr":"La figuration : du corps au sens abstrait","tAr":"التجسيد: من الجسد إلى المعنى المجرد","body":["في التعبير الاصطلاحي تحدث la transposition sémantique: جزء من الجسد يُستعمل ليدلّ على une capacité ou une émotion. « La tête » تصبح رمزاً للـ raisonnement، و« le cœur » رمزاً للـ sentiment.","هذه la métaphore est figée: لا يمكن تغيير أعضائها دون فقدان التعبير. نقول « se faire un sang d’encre » ولا نقول « se faire un sang bleu » — la figuration est conventionnelle."],"ex":[{"fr":"Il ne réfléchit pas : il a la tête ailleurs.","ar":"لا يفكر: ذهنه في مكان آخر."},{"fr":"C’est un homme au grand cœur.","ar":"إنسان واسع القلب."}]},{"tFr":"Le registre dans les expressions du corps","tAr":"السجل اللغوي في تعبيرات الجسد","body":["كل تعبير جسدي يحتل موقعاً محدداً على سلّم le registre. « Donner un coup de main » و« avoir les pieds sur terre » courant. أما « se faire un sang d’encre » و« tomber dans les pommes » فـ familier.","la langue soutenue تميل إلى la périphrase بدلاً من la figuration: au lieu de « il a la tête dans les nuages » نقول « il est distrait » ou « sa pensée est ailleurs »."],"ex":[{"fr":"Je me suis fait un sang d’encre ! (familier)","ar":"قلقتُ جداً! (عامي)"},{"fr":"Je m’en suis inquiété vivement. (soutenu)","ar":"قلقتُ قلقاً بالغًا. (فصحى)"}]}],"mistakes":[{"wrong":"changer les mots de l’expression","right":"garder la forme figée","why":"« se faire un sang d’ardoise » n’existe pas : la figuration est conventionnelle — التعبير الاصطلاحي لا يقبل التبديل."},{"wrong":"employer « se faire un sang d’encre » à l’écrit formel","right":"employer une périphrase soutenue","why":"le registre familier est inadapté au contexte formel — السجل العامي لا يصلح للفصحى."},{"wrong":"prendre « la tête dans les nuages » au sens propre","right":"reconnaître le sens figuré","why":"la tête n’est pas vraiment dans le nuage : c’est la distraction — المعنى مجازي لا حرفية."},{"wrong":"dire « lui donner un coup de la main »","right":"dire « lui donner un coup de main »","why":"la forme figée est « coup de main » sans article — التعبير ثابت ولا يقبل أداة."}],"dialogues":[{"title":"Le partage du travail","ctx":"زميلان في مكتب يتبادلان المساعدة","lines":[{"who":"Julie","fr":"Tu as l’air fatigué. Je peux te donner un coup de main ?","ar":"يبدوان متعباً. هل أساعدك قليلاً؟"},{"who":"Marc","fr":"Merci ! J’en ai plein le dos de ce dossier.","ar":"شكراً! أنا متعب من هذا الملف."},{"who":"Julie","fr":"Ne t’en fais pas, on va le finir ensemble.","ar":"لا تقلق، سنهيه معاً."},{"who":"Marc","fr":"Tu as vraiment le cœur sur la main.","ar":"قلبك على يدك حقاً: أنت كريمة."}]},{"title":"La tête ailleurs","ctx":"أب ابنة يحلمان معاً","lines":[{"who":"Léa","fr":"Papa, tu m’écoutes ? Tu as la tête dans les nuages.","ar":"بابا، هل تُصغيني؟ ذهنك في السحاب."},{"who":"Paul","fr":"Pardon, je pensais aux vacances. J’ai hâte de partir.","ar":"سامحيني، كنتُ أفكر في العطلة. أتطلع للسفر."},{"who":"Léa","fr":"Maman dit qu’il faut rester les pieds sur terre.","ar":"ماما تقول إن علينا أن نبقى واقعيين."},{"who":"Paul","fr":"Un peu de rêve fait du bien, ma chérie.","ar":"قليل من الحلم نافع يا عزيزتي."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما معنى « avoir la tête dans les nuages »؟","opts":["يَحلُم وذهنه مشتت","يكون سميناً جداً","يعمل بجد","يخلو من التفكير تماماً"],"a":0,"why":"la tête dans les nuages = la pensée est ailleurs, le rêve éveillé."},{"t":"fill","skill":"grammar","q":"أكمل: «Peux-tu me ___ un coup de main ?»","fr":"Peux-tu me ___ un coup de main ?","ans":"donner","why":"la forme figée est « donner un coup de main »."},{"t":"order","skill":"writing","q":"رتّب: هو يَحلُم دائماً","words":["Il","a","la","tête","dans","les","nuages."],"ans":"Il a la tête dans les nuages.","why":"sujet + avoir + la tête + complément circonstanciel."},{"t":"listen","skill":"listening","q":"ما المقصود بـ « se faire un sang d’encre »؟","opts":["يَقلقُ كثيراً","يكون شجاعاً","ينزف فعلاً","يكتب بخط جم"],"a":0,"why":"la peur intense : le sang se coagule de terreur — la figuration du sang."},{"t":"translate","skill":"writing","q":"ترجم: «هو متوازن واقعي رغم نجاحه.»","ans":"Il a les pieds sur terre malgré son succès.","why":"les pieds sur terre = le réalisme, la stabilité."},{"t":"speaking","skill":"speaking","q":"صف شخصاً تعرفه مستعملاً ثلاث تعبيرات من هذا الدرس.","target":"tête dans les nuages / pieds sur terre / cœur sur la main","why":"إنتاج لغوي يدمج les expressions du corps في وصف شخصية."},{"t":"correct","skill":"grammar","q":"صحّح: «Il m’a donné un coup de la main.»","ans":"Il m’a donné un coup de main.","why":"la forme figée n’accepte pas d’article entre « de » et « main »."},{"t":"mcq","skill":"reading","q":"أي تعبير هو registre familier؟","opts":["tomber dans les pommes","donner un coup de main","avoir les pieds sur terre","avoir un coup de foudre"],"a":0,"why":"tomber dans les pommes est familier ; les autres sont courants."}],"homework":"اكتب فقرة من سبع جمل تصف فيها يومك مستعملاً خمسة تعبيرات من هذا الدرس، وحدّد بعد كل تعبير هل هو courant أم familier.","sources":[{"title":"10 expressions françaises avec des parties du corps","channel":"Français avec Pierre","videoId":"eub2oNe_7yA","why":"شرح واضح لعشر تعبيرات فرنسية شائعة تستعمل أعضاء الجسد: تظهر فيها كيف ينتقل المعنى من le sens propre إلى le sens figuré، مع أمثلة على le registre courant.","cat":"Lexique","level":"C1","main":true},{"title":"12 phrases sur le corps | Français A1","channel":"Français - Arabe","videoId":"LEqvOCuTUDo","why":"مقارنة بين le sens propre des parties du corps et leur emploi dans les phrases quotidiennes — نقطة انطلاق للمقارنة مع le sens figuré.","cat":"Lexique","level":"C1","extra":true},{"title":"Ces expressions françaises avec les parties du corps","channel":"FrenchSchool TV","videoId":"eCLL-Ggddbk","why":"مراجعة سريعة للتعبيرات الجسدية الأكثر شيوعاً: تعزّز la mémorisation par la répétition guidée.","cat":"Lexique","level":"C1","extra":true}],"supplements":[{"id":"LEqvOCuTUDo","title":"12 phrases sur le corps | Français A1","channel":"Français - Arabe","why":"مقارنة بين le sens propre des parties du corps et leur emploi dans les phrases quotidiennes — نقطة انطلاق للمقارنة مع le sens figuré.","lang":"fr","dur":8},{"id":"eCLL-Ggddbk","title":"Ces expressions françaises avec les parties du corps","channel":"FrenchSchool TV","why":"مراجعة سريعة للتعبيرات الجسدية الأكثر شيوعاً: تعزّز la mémorisation par la répétition guidée.","lang":"fr","dur":3}]},{"id":"c1-t2-l2","fr":"Expressions avec les animaux","ar":"التعبيرات الاصطلاحية المرتبطة بالحيوانات","objectives":["فهم le bestiaire francophone: لماذا يرمز le chat إلى la malchance وle chameau إلى la patience؟","تمييز les expressions animalières courantes مثل « poser un lapin » و« ménager la chèvre et le chou »","تفادي la traduction littérale من العربية لأن le symbole animal قد يختلف بين الثقافتين","استعمال خمس تعبيرات حيوانية بدقّة في سياق محادثة طبيعية"],"sections":[{"h":"الدرس 2: الحيوان في الذاكرة الجماعية للغة الفرنسية","video":{"id":"xA8iB-tITd8","title":"7 French Idiomatic Expressions About Animals","channel":"Learn Fun French","why":"سبع تعبيرات حيوانية شائعة مع شرح بسيط لمعناها: تُظهر كيف يحفر le bestiaire francophone صورته في la langue quotidienne، من le chat إلى le chameau.","lang":"fr","main":true,"dur":9},"p":["الحيوانات في اللغة الفرنسية ليست مجرد ذكريات رعوية بل رموز ثابتة: le chat يرتبط أحياناً بالحظ السيّئ، le chameau بالصبر، والoiseau بالحرية أو بالحمق حسب السياق. التعبير الاصطلاحي يثبّت هذا الرمز ويجعله قابلاً للاستعمال الفوري.","« Avoir un chat dans la gorge » تعني وجود صعوبة في الكلام أو انحباس الصوت بسبب la grippe أو la gêne. الصورة: chat يتحرّك في la gorge ويمنع la voix من الخروج بوضوح.","« Poser un lapin » تعني عدم الحضور إلى موعد دون إنذار أو تجاهل شخصاً. أصلها من le jeu de paumier: من يخسر يدفع lapin comme amende ويتغيّب.","« Ménager la chèvre et le chou » تعني إرضاء الطرفين معاً: la chèvre (التي تأكل le chou) وle chou (الذي سيبقى). وهي la conciliation difficile.","« Avoir le cafard » (familier) تعني الحزن أو الكآبة، و« raconter des salades » تعني الكذب والتلفيق، و« être un vrai chameau » تعني الصبر الطويل. كلها صور animalières ثابتة.","خلاصة المنهج: لا تحفظ التعبير معناه العربي فحسب، بل احفظ la scène التي يرسمها le animal. المشهد هو الذي يثبّت la nuance ويمنع la confusion مع les expressions corporelles."],"sub":[{"h":"le chat et le lapin","p":["J’ai un chat dans la gorge, je ne peux pas parler.","Il m’a posé un lapin hier soir.","Le chat n’est pas là : j’ai de la chance."]},{"h":"la chèvre et le chou","p":["Il ménage la chèvre et le chou.","Tu ne peux pas tout avoir, choisis !","La conciliation est difficile."]},{"h":"le cafard et le chameau","p":["J’ai le cafard depuis lundi.","Il est patient comme un chameau.","Il raconte encore des salades."]}]},{"h":"le bestiaire en quatre expressions","p":["« Avoir un chat dans la gorge… » — la voix qui manque.","« Poser un lapin à quelqu’un… » — le rendez-vous manqué.","« Ménager la chèvre et le chou… » — plaire à tout le monde.","« Avoir le cafard… » — la mélancolie (familier)."]},{"h":"التطبيق والتلخيص","p":["تمرين le bestiaire: اربط كل حيوان بمعناه الاصطلاحي، ثم اشرح لماذا اختار الناطقون بالفرنسية هذا الحيوان تحديداً.","تمرين le calque: قارن « poser un lapin » بالتعبير العربي المكافئ، وحدّد أوجه الاختلاف في la scène animalière.","تمرين la production: اكتب حواراً قصيراً بين صديقين يتركان الموعد، مستعملاً « poser un lapin » و« ménager la chèvre et le chou »."]}],"pron":[{"w":"un chat","ipa":"[œ̃ ʃa]","approx":"أُون شا"},{"w":"un lapin","ipa":"[œ̃ lapɛ̃]","approx":"أُون لابان"},{"w":"la chèvre","ipa":"[la ʃɛvʁ]","approx":"لا شيفْر"}],"vocab":[{"fr":"avoir un chat dans la gorge","ar":"يَعاني صعوبة في الكلام","pos":"loc. verb.","g":"","exFr":"Ce matin, j’ai un chat dans la gorge : je suis enroué.","ipa":"[a.vwaʁ œ̃ ʃa dɑ̃ la ɡɔʁʒ]","exAr":"هذا الصباح أجد صعوبة في الكلام: صوتي أجش."},{"fr":"poser un lapin","ar":"لا يحضر موعداً ويتجاهل أحداً","pos":"loc. verb.","g":"","exFr":"Elle m’a posé un lapin devant le café.","ipa":"[po.ze œ̃ lapɛ̃]","exAr":"تركتني وحدي أمام المقهى دون أن تأتي."},{"fr":"ménager la chèvre et le chou","ar":"يُرضي الطرفين معاً","pos":"loc. verb.","g":"","exFr":"Dans ce conflit, il essaie de ménager la chèvre et le chou.","ipa":"[me.na.ʒe la ʃɛvʁ e lə ʃu]","exAr":"في هذا النزاع يحاول أن يرضي الطرفين."},{"fr":"avoir le cafard","ar":"يكون حزيناً مكتئباً","pos":"loc. verb.","g":"","exFr":"Quand il pleut, j’ai le cafard.","ipa":"[a.vwaʁ lə ka.fɑʁ]","exAr":"حين تمطر أشعر بالحزن والكآبة."},{"fr":"raconter des salades","ar":"يكذب ويلفّق القصص","pos":"loc. verb.","g":"","exFr":"Il raconte des salades, ne le crois pas.","ipa":"[ʁa.kɔ̃.te de sa.lad]","exAr":"يكذب ولا تصدّقه."},{"fr":"être un chameau","ar":"يكون صبوراً جداً","pos":"loc. verb.","g":"","exFr":"Avec ses enfants, elle est un vrai chameau.","ipa":"[ɛ.tʁə œ̃ ʃa.mo]","exAr":"مع أطفالها هي صبورة جداً."},{"fr":"donner sa pâture au chien","ar":"يُعطي جهده لغير أهله","pos":"loc. verb.","g":"","exFr":"Tu travailles trop pour les autres : c’est donner sa pâture au chien.","ipa":"[dɔ.ne sa pɑ.tyʁ o ʃjɛ̃]","exAr":"تعمل كثيراً لغيرك: هذا إهدار للجهد."},{"fr":"quand les poules auront des dents","ar":"عندما تلدّ الدجاجة أسناناً (مستحيل)","pos":"loc.","g":"","exFr":"Il réussira quand les poules auront des dents !","ipa":"[kɑ̃ le pul o.ʁɔ̃ de dɑ̃]","exAr":"سينجح حينما تلدّ الدجاجة أسناناً — أي مستحيل."},{"fr":"avoir d’autres chats à fouetter","ar":"يكون مشغولاً بأمور أهم","pos":"loc. verb.","g":"","exFr":"Laisse-moi tranquille, j’ai d’autres chats à fouetter.","ipa":"[a.vwaʁ dot ʃa a fwɛ.te]","exAr":"دعني وشأني، لديّ أمور أهم من هذا."},{"fr":"être comme deux gouttes d’eau","ar":"يكونان متشابهين جداً","pos":"loc. verb.","g":"","exFr":"Les deux sœurs sont comme deux gouttes d’eau.","ipa":"[ɛ.tʁə kɔm dø ɡut dɔ]","exAr":"الأختان متطابقتان تماماً."},{"fr":"mener la danse","ar":"يتصدّر المشهد ويقود الرأي","pos":"loc. verb.","g":"","exFr":"Dans ce projet, c’est elle qui mène la danse.","ipa":"[mə.ne la dɑ̃s]","exAr":"في هذا المشروع هي من تقود الرأي."},{"fr":"donner des fourmis à quelqu’un","ar":"يُثير الشك عند شخص","pos":"loc. verb.","g":"","exFr":"Son attitude me donne des fourmis.","ipa":"[dɔ.ne de fuʁ.mi]","exAr":"سلوكه يُثير الشك عندي."}],"examples":[{"fr":"J’ai un chat dans la gorge, je ne parle pas fort.","ar":"أجد صعوبة في الكلام، لن أرفع صوتي.","note":"la voix qui manque"},{"fr":"Il a posé un lapin à toute l’équipe.","ar":"تجاهل الفريق كله ولم يأتِ.","note":"le rendez-vous manqué"},{"fr":"Il ménage la chèvre et le chou.","ar":"يُرضي الطرفين معاً.","note":"la conciliation"},{"fr":"J’ai le cafard depuis son départ.","ar":"أنا حزين منذ رحيله.","note":"registre familier"},{"fr":"Il raconte des salades pour se justifier.","ar":"يلفّق أعذاراً كاذبة لتبرير تصرفه.","note":"le mensonge"},{"fr":"On parlera quand les poules auront des dents.","ar":"سنتحدث حين تلدّ الدجاجة أسناناً — أي مستحيل.","note":"l’impossibilité"}],"grammar":[{"tFr":"La figuration animale : la métaphore stabilisée","tAr":"التجسيد الحيواني: الاستعارة المُثبّتة","body":["كل تعبير حيواني يعتمد على une caractéristique de l’animal: la chèvre qui mange le chou، le lapin qui fuit، le chat qui griffe. la particularité تتحول إلى une propriété humaine figée.","la figuration est figée: لا يمكن استبدال le chat بـ le chien في « avoir un chat dans la gorge » دون أن يفقد التعبير معناه. le choix animal est conventionnel et mémoriel."],"ex":[{"fr":"Il a posé un lapin à sa copine.","ar":"ترك حبيبته دون موعد."},{"fr":"Elle a le cafard depuis dimanche.","ar":"هي حزينة منذ الأحد."}]},{"tFr":"Le calque interculturel et la traduction des animaux","tAr":"القرض الثقافي والترجمة بين الرموز الحيوانية","body":["الرمز الحيواني قد يختلف من ثقافة إلى أخرى. « Avoir le cafard » لا تكافئها بالضرورة « عندي القُحف » بالمعنى نفسه؛ الترجمة الأقرب هي la mélancolie لأن la figuration قد لا تتطابق.","la stratégie du traducteur: تجنب la traduction littérale وابحث عن l’équivalent de sens ou عن la paraphrase. « Poser un lapin » تُترجم وظيفياً بـ « يتجاهل الموعد » أو « يترك أحداً وحده »."],"ex":[{"fr":"Il a posé un lapin. → Il n’est pas venu au rendez-vous.","ar":"لم يأتِ إلى الموعد."},{"fr":"J’ai le cafard. → Je suis mélancolique.","ar":"أنا مكتئب."}]}],"mistakes":[{"wrong":"traduire « chat dans la gorge » حرفياً","right":"استعمل la paraphrase : la voix est enrouée","why":"la figuration animale ne survit pas toujours à la traduction — الرمز الحيواني قد لا ينقل بنفس الصورة."},{"wrong":"« poser un lapin » au sens de ربط الأرنب","right":"إهمال الموعد","why":"la convention : le lapin est l’amende du jeu de paumier — الأرنب هنا رمز للإهمال لا للحيوان."},{"wrong":"مزاوجة le chat مع la malchance في كل تعبير","right":"حفظ كل تعبير على حدة","why":"« avoir un chat dans la gorge » ليس عن الحظ بل عن la voix — كل تعبير له سياقه الخاص."},{"wrong":"استعمال « raconter des salades » في le registre soutenu","right":"استعمل « débiter des contes » ou « exagérer »","why":"le registre familier est inadapté à l’écrit formel — السجل العامي لا يصلح للفصحى."}],"dialogues":[{"title":"Le rendez-vous manqué","ctx":"صديقان يتحدثان عن تجاهل موعد","lines":[{"who":"Hugo","fr":"Tu étais où hier ? Tu m’as posé un lapin.","ar":"أين كنتَ أمس؟ تركتَني وحدك."},{"who":"Nina","fr":"Pardon, j’ai un chat dans la gorge et je n’ai pas pu venir.","ar":"سامحيني، صوتي أجش ولم أستطع المجيء."},{"who":"Hugo","fr":"Ça va maintenant ? Tu as l’air fatiguée.","ar":"هل أنتِ بخير الآن؟ تبدوان متعبة."},{"who":"Nina","fr":"Oui, merci. Je t’offre un café pour me faire pardonner.","ar":"نعم، شكراً. سأدفع لك قهوة لِأستر ما بدر مني."}]},{"title":"Le conflit de voisinage","ctx":"جاران يبحثان عن حلّ للنزاع","lines":[{"who":"Karim","fr":"Le voisin se plaint encore du bruit.","ar":"الجار يشتكي مجدداً من الضجيج."},{"who":"Élodie","fr":"Il faut ménager la chèvre et le chou : le bruit et le voisin.","ar":"عليك أن ترضي الطرفين: الضجيج والجار."},{"who":"Karim","fr":"D’accord, je propose des horaires calmes.","ar":"حسناً، أقترح أوقاتاً هادئة."},{"who":"Élodie","fr":"Bonne idée. Il arrêtera de raconter des salades au syndic.","ar":"فكرة جيدة. سيتوقف عن إزعاج الإدارة."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما معنى « poser un lapin »؟","opts":["يتجاهل موعداً","يُقدّم هدية","يربط أرنبة","يُخيف أحداً"],"a":0,"why":"poser un lapin = manquer au rendez-vous sans prévenir."},{"t":"fill","skill":"grammar","q":"أكمل: «Il ___ la chèvre et le chou dans ce projet.»","fr":"Il ___ la chèvre et le chou dans ce projet.","ans":"ménage","why":"la forme figée : ménager la chèvre et le chou = concilier les intérêts."},{"t":"order","skill":"writing","q":"رتّب: أنا مكتئب منذ الأحد","words":["J’ai","le","cafard","depuis","dimanche."],"ans":"J’ai le cafard depuis dimanche.","why":"avoir le cafard + le complément de temps."},{"t":"listen","skill":"listening","q":"ما سبب la difficulté de la parole في « avoir un chat dans la gorge »؟","opts":["القلق أو المرض يمنعان الصوت","الصمت المتعمّد","ضجيج المكان","الخوف من الحيوانات"],"a":0,"why":"chat dans la gorge = la gorge irritée ou la voix bloquée par l’émotion ou la maladie."},{"t":"translate","skill":"writing","q":"ترجم: «تجاهل الموعد ولم يُخبر أحداً.»","ans":"Il a posé un lapin sans prévenir personne.","why":"poser un lapin = manquer au rendez-vous."},{"t":"speaking","skill":"speaking","q":"اشرح لمتحدث بالعربية الفرق بين الرمز الحيواني في الفرنسية والعربية مع مثال.","target":"chat / chèvre / lapin","why":"الوعي الثقافي la différence des symboles entre les deux langues."},{"t":"correct","skill":"grammar","q":"صحّح: «Il m’a raconté des choux.»","ans":"Il m’a raconté des salades.","why":"la forme figée est « raconter des salades » : le chou n’en fait pas partie."},{"t":"mcq","skill":"reading","q":"أي تعبير يدلّ على الصبر الطويل؟","opts":["être un chameau","avoir le cafard","poser un lapin","raconter des salades"],"a":0,"why":"le chameau est le symbole de la patience dans le bestiaire francophone."}],"homework":"اكتب ست جمل عن حيواناتك المفضّلة بالفرنسية، واربط كل حيوان بتعبير اصطلاحي واحد من هذا الدرس، مع تفسير قصير للاختيار.","sources":[{"title":"7 French Idiomatic Expressions About Animals","channel":"Learn Fun French","videoId":"xA8iB-tITd8","why":"سبع تعبيرات حيوانية شائعة مع شرح بسيط لمعناها: تُظهر كيف يحفر le bestiaire francophone صورته في la langue quotidienne، من le chat إلى le chameau.","cat":"Lexique","level":"C1","main":true},{"title":"5 expressions avec des animaux","channel":"French with Alicia","videoId":"aUIPTmDyU_s","why":"خمس تعبيرات حيوانية بشرح سريع: مراجعة مركّزة تُثبّت la mémoire à long terme.","cat":"Lexique","level":"C1","extra":true},{"title":"Expressions avec des animaux : complète-les si tu peux","channel":"Français Authentique","videoId":"qeNWdjXrWrI","why":"تمرين تفاعلي لإكمال التعبيرات الحيوانية: يختبر la productionactive بدلاً من la reconnaissance passive.","cat":"Lexique","level":"C1","extra":true}],"supplements":[{"id":"aUIPTmDyU_s","title":"5 expressions avec des animaux","channel":"French with Alicia","why":"خمس تعبيرات حيوانية بشرح سريع: مراجعة مركّزة تُثبّت la mémoire à long terme.","lang":"fr","dur":5},{"id":"qeNWdjXrWrI","title":"Expressions avec des animaux : complète-les si tu peux","channel":"Français Authentique","why":"تمرين تفاعلي لإكمال التعبيرات الحيوانية: يختبر la productionactive بدلاً من la reconnaissance passive.","lang":"fr","dur":7}]},{"id":"c1-t2-l3","fr":"L’argent et le travail","ar":"التعبيرات الاصطلاحية عن المال والعمل","objectives":["فهم la terminologie du bureau et du marché: « être sur la sellette » و« coûter les yeux de la tête »","التمييز بين le jargon professionnel et le registre courant في التعبيرات المالية","استعمال عشر تعبيرات مالية ومهنية في محاكاة situation de travail","تفسير la valeur symbolique de l’argent في الذاكرة الجماعية الفرنسية عبر التعبيرات"],"sections":[{"h":"الدرس 3: لغة المكتب والمال في الفرنسية المتقدمة","video":{"id":"zPhr1rH1_Mc","title":"Expressions idiomatiques sur le travail et l’argent","channel":"French Idioms","why":"تعبيرات اصطلاحية تجمع بين le domaine du travail وle domaine de l’argent: تُظهر كيف تتقاطع الحقول الدلالية في la langue des affaires et de la vie courante.","lang":"fr","main":true,"dur":8},"p":["la langue du travail الفرنسية غنية بالتعبيرات الاصطلاحية التي تنتمي إلى les registres مختلفة: « être sur la sellette » soutenu-technique، و« coûter les yeux de la tête » courant. التمييز بينهما ضروري لترك انطباع الـ locuteur natif.","« Coûter les yeux de la tête » تعني أن الشيء غالٍ جداً: la valeur تُقاس بـ les organes les plus précieux. التعبير يعبّر عن le choc du prix plutôt que عن la simple constatation.","« Être sur la sellette » تعني أن الشخص موضع شكّ أو انتقاد شديد، وهو أصل من la sellette (الكرسي الصغير الذي يجلس عليه المُدعى في المحكمة أو la confession). la position devient la métaphore de l’angoisse.","« Mettre de l’eau dans son vin » تعني التنازل أو التهدئة من المطالب: le vin الصلب يُخفَّف بالماء. أما « serrer la ceinture » فتعني التقشف والتدبير في وقت الشدّة.","« Avoir le capital confiance » ou « faire des pieds et des mains » — la première est le jargon de la finance، والثانية la figure de l’effort désespéré. la différence entre les deux تعتمد على le contexte professionnel.","تمرين نهائي: اقرأ إعلان توظيف أو نص اقتصادي فرنسي، وحدّد كل تعبير اصطلاحي، وصنّفه في le registre المناسب، ثم اشرح كيف يُغيّر la nuance في le message المهني."],"sub":[{"h":"le prix et la valeur","p":["Ce appartement coûte les yeux de la tête.","Le prix a flambé cette année.","Il faut serrer la ceinture."]},{"h":"le bureau et la pression","p":["Il est sur la sellette après l’échec.","Le patron n’est pas du bord.","Il met de l’eau dans son vin."]},{"h":"la confiance et l’effort","p":["Il a le capital confiance.","Il fait des pieds et des mains pour convaincre.","L’ambiance au bureau est bonne."]}]},{"h":"le lexique du bureau","p":["« Être sur la sellette… » — le collaborateur sous pression.","« Coûter les yeux de la tête… » — le prix exorbitant.","« Mettre de l’eau dans son vin… » — la concession.","« Serrer la ceinture… » — le budget serré."]},{"h":"التطبيق والتلخيص","p":["تمرين la simulation: تخيّل أنك في entretien d’embauche، واستعمل ثلاث تعبيرات مالية أو مهنية لوصف وضعك.","تمرين le registre: أعد كتابة فقرة عن la vie de bureau مستعملاً le jargon المهني ثم أعد كتابتها بالregistre courant.","تمرين la négociation: اكتب حواراً قصيراً بين زبون وَبائع يتفاوضان على السعر مستعملاً « coûter les yeux de la tête » و« serrer la ceinture »."]}],"pron":[{"w":"la sellette","ipa":"[la sɛlɛt]","approx":"لا سيليت"},{"w":"la ceinture","ipa":"[la sɛ̃tyʁ]","approx":"لا سانتيور"},{"w":"le capital","ipa":"[lə ka.pi.tal]","approx":"لو كابيتال"}],"vocab":[{"fr":"coûter les yeux de la tête","ar":"يَكلّف غالياً جداً","pos":"loc. verb.","g":"","exFr":"Cette maison coûte les yeux de la tête à Paris.","ipa":"[ku.te le zjø də la tɛt]","exAr":"هذا البيت يَكلّف غالياً جداً في باريس."},{"fr":"être sur la sellette","ar":"يكون موضع شكّ أو انتقاد","pos":"loc. verb.","g":"","exFr":"Après le scandale, le directeur est sur la sellette.","ipa":"[ɛ.tʁə syʁ la sɛlɛt]","exAr":"بعد الفضيحة أصبح المدير موضع شك."},{"fr":"mettre de l’eau dans son vin","ar":"يتنازل عن مطالبه","pos":"loc. verb.","g":"","exFr":"Dans la négociation, il a mis de l’eau dans son vin.","ipa":"[mɛtʁ də lo dɑ̃ sɔ̃ vɛ̃]","exAr":"في التفاوض تنازل عن بعض مطالبه."},{"fr":"serrer la ceinture","ar":"يقشف ويُدير ميزانيته","pos":"loc. verb.","g":"","exFr":"Avec la crise, il faut serrer la ceinture.","ipa":"[sɛ.ʁe la sɛ̃tyʁ]","exAr":"مع الأزمة يجب أن نُدير المصاريف بحذرة."},{"fr":"avoir le capital confiance","ar":"يتمتع بثقة راسخة","pos":"loc. verb.","g":"","exFr":"Le candidat a le capital confiance du jury.","ipa":"[a.vwaʁ lə ka.pi.tal kɔ̃.fjɑ̃s]","exAr":"المرشّح يحظى بثقة اللجنة الراسخة."},{"fr":"faire des pieds et des mains","ar":"يبذل قصارى جهده","pos":"loc. verb.","g":"","exFr":"Elle a fait des pieds et des mains pour obtenir ce poste.","ipa":"[fɛʁ de pje e de mɛ̃]","exAr":"بذلت قصارى جهدها لتحصل على هذا المنصب."},{"fr":"avoir bon contact avec la hiérarchie","ar":"يتمتع بعلاقات جيدة مع الإدارة","pos":"loc. verb.","g":"","exFr":"Il a bon contact avec la hiérarchie : cela aide.","ipa":"[a.vwaʁ bɔ̃ kɔ̃.takt]","exAr":"علاقاته بالإدارة جيدة وهذا يُعينه."},{"fr":"être en poste","ar":"يشغل منصباً","pos":"loc. verb.","g":"","exFr":"Elle est en poste depuis trois ans.","ipa":"[ɛ.tʁə ɑ̃ pɔst]","exAr":"تشغل المنصب منذ ثلاث سنوات."},{"fr":"prendre ses clics et ses claquements","ar":"يجمع أغراضه ويغادر (يُقال عن المغادرين)","pos":"loc. verb.","g":"","exFr":"Après le licenciement, il a pris ses clics et ses claquements.","ipa":"[pʁɑ̃dʁ se kli e se kla.kə.mɑ̃]","exAr":"بعد الفصل جمع أغراضه وغادر."},{"fr":"le budget est serré","ar":"الميزانية ضيقة","pos":"loc.","g":"","exFr":"Ce mois-ci, le budget est serré.","ipa":"[lə by.dʒɛ ɛ sɛ.ʁe]","exAr":"هذا الشهر الميزانية ضيقة."},{"fr":"coûter la peau des fesses","ar":"يكون باهظ الثمن (familier)","pos":"loc. verb.","g":"","exFr":"Le restaurant coûte la peau des fesses.","ipa":"[ku.te la po de fɛs]","exAr":"المطعم ثمنه باهظ جداً."},{"fr":"toucher son salaire","ar":"يتسلّم راتبه","pos":"loc. verb.","g":"","exFr":"Il touche son salaire à la fin du mois.","ipa":"[tu.ʃe sɔ̃ sa.lɛʁ]","exAr":"يتسلّم راتبه في نهاية الشهر."}],"examples":[{"fr":"Le loyer coûte les yeux de la tête.","ar":"الإيجار غالٍ جداً.","note":"le prix exorbitant"},{"fr":"Le chef est sur la sellette.","ar":"الرئيس موضع شك وانتقاد.","note":"la pression hiérarchique"},{"fr":"Il met de l’eau dans son vin.","ar":"يتنازل عن بعض مطالبه.","note":"la concession"},{"fr":"Il faut serrer la ceinture.","ar":"يجب تقشف المصاريف.","note":"le budget en crise"},{"fr":"Elle a fait des pieds et des mains pour convaincre.","ar":"بذلت قصارى جهدها للإقناع.","note":"l’effort"},{"fr":"Il a le capital confiance du jury.","ar":"يحظى بثقة اللجنة.","note":"le jargon professionnel"}],"grammar":[{"tFr":"Le jargon professionnel et ses limites","tAr":"الجيش اللغوي المهني وحدوده","body":["la langue du travail تمتزج فيها les anglicismes مع les expressions traditionnelles: « le capital confiance » مستعار من le jargon financier، أما « être sur la sellette » فجذرها قديم وقانوني.","la stratégie de l’usage: في le contexte formel استعمل le jargon، وفي le contexte mixte استعمل le registre courant. la surcharge du jargon قد تُضعف le message."],"ex":[{"fr":"Le candidat a le capital confiance du jury.","ar":"يحظى المرشّح بثقة اللجنة."},{"fr":"Le manager est sur la sellette.","ar":"المدير تحت الضغط."}]},{"tFr":"La transposition de l’argent : la valeur et le corps","tAr":"نقل معنى المال: القيمة والجسد","body":["la langue de l’argent تستعمل le corps لتصوير la dépense: « coûter les yeux de la tête » تجعل la valeur جزءاً من le corps نفسه. la figuration تربط le sacrifice بـ la dépense.","la conséquence stylistique: la violence de l’image تعطي قوة أو شدّة أكبر من la simple constatation. « très cher » neutral؛ « coûter les yeux de la tête » expressif."],"ex":[{"fr":"La voiture coûte les yeux de la tête.","ar":"السيارة ثمنها باهظ."},{"fr":"Il a payé très cher cette erreur.","ar":"أداء ثمناً باهظاً لهذه الخطأ."}]}],"mistakes":[{"wrong":"استعمال « être sur la sellette » بمعنى la selle","right":"la position sous pression","why":"la sellette est le siège du prévenu : la pression, pas l’objet — المعنى مجازي عن الوضع الصعب."},{"wrong":"خلط le jargon avec le registre familier","right":"التمييز بينهما حسب le contexte","why":"« la peau des fesses » familier جداً ولا يصلح لـ le contexte professionnel — السجل العامي يُتجنّب في العمل."},{"wrong":"« serrer la ceinture » بمعنى ربط الحزام","right":"التقشف والاقتصاد","why":"la figuration métaphorique : la ceinture = le budget — هنا المجاز لا الحقيقة."},{"wrong":"« faire des pieds et des mains » بمعنى الرقص","right":"بذل الجهد","why":"la figure de l’effort désespéré pour convaincre — الصورة عن الاجتهاد لا الحركة البدنية."}],"dialogues":[{"title":"L’entretien d’embauche","ctx":"مقابلة عمل بين مرشحة ومدير توظيف","lines":[{"who":"Claire","fr":"Je suis en poste depuis cinq ans, mais je cherche plus de responsabilités.","ar":"أشغل المنصب منذ خمس سنوات، لكنني أبحث عن مسؤوليات أكبر."},{"who":"M. Blanc","fr":"Vous avez le capital confiance que nous cherchons.","ar":"لديكِ الثقة التي نبحث عنها."},{"who":"Claire","fr":"Merci. Je fais des pieds et des mains pour réussir.","ar":"شكراً. أبذل قصارى جهدي للنجاح."},{"who":"M. Blanc","fr":"Bien. Nous vous recontactons la semaine prochaine.","ar":"ممتاز. سنتواصل معكِ الأسبوع القادم."}]},{"title":"La vie au bureau","ctx":"زميلان يتحدثان عن الضغط المهني","lines":[{"who":"Sophie","fr":"Le chef est sur la sellette après l’échec du projet.","ar":"المدير تحت الضغط بعد فشل المشروع."},{"who":"Antoine","fr":"Oui, mais il met de l’eau dans son vin maintenant.","ar":"نعم، لكنه يتنازل الآن عن بعض مطالبه."},{"who":"Sophie","fr":"Il faut serrer la ceinture en attendant.","ar":"علينا أن نُدير المصاريف في هذه الأثناء."},{"who":"Antoine","fr":"L’ambiance au bureau reste bonne, heureusement.","ar":"لحسن الحظ بقيت الأجواء جيدة."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما معنى « être sur la sellette »؟","opts":["يكون تحت ضغط وانتقاد","يركب دراجة","يجلس ليستريح","يعمل في المزرعة"],"a":0,"why":"la sellette est le siège du prévenu : la pression professionnelle."},{"t":"fill","skill":"grammar","q":"أكمل: «Ce quartier coûte les ___ de la tête.»","fr":"Ce quartier coûte les ___ de la tête.","ans":"yeux","why":"la forme figée : coûter les yeux de la tête."},{"t":"order","skill":"writing","q":"رتّب: أنا أقشف مصاريفي هذا الشهر","words":["Je","serre","la","ceinture","ce","mois-ci."],"ans":"Je serre la ceinture ce mois-ci.","why":"sujet + la forme figée + le complément de temps."},{"t":"listen","skill":"listening","q":"لماذا يُستعمل le corps في « coûter les yeux de la tête »؟","opts":["لتصوير شدّة الغلاء","لأن العمل يُتعب العينين","لأن المال يُقاس بالعين","لأن العين رمز الثقة"],"a":0,"why":"la figuration lie la dépense à un sacrifice corporel : la valeur devient douloureuse."},{"t":"translate","skill":"writing","q":"ترجم: «الإيجار غالٍ جداً في هذا الحي.»","ans":"Le loyer coûte les yeux de la tête dans ce quartier.","why":"la périphrase expressive pour la dépense excessive."},{"t":"speaking","skill":"speaking","q":"صف وضعك المالي أو المهني مستعملاً ثلاث تعبيرات من هذا الدرس.","target":"serrer la ceinture / sur la sellette / capital confiance","why":"إنتاج لغوي في le registre du travail."},{"t":"correct","skill":"grammar","q":"صحّح: «Il met de l’eau dans son café.»","ans":"Il met de l’eau dans son vin.","why":"la forme figée : le vin est le terrain de la concession, pas le café."},{"t":"mcq","skill":"reading","q":"أي تعبير هو le plus familier؟","opts":["coûter la peau des fesses","être sur la sellette","avoir le capital confiance","être en poste"],"a":0,"why":"la peau des fesses est le plus familier parmi les quatre."}],"homework":"اكتب فقرة من ست جمل تصف فيها وضعك المهني أو الدراسي مستعملاً أربعة تعبيرات من هذا الدرس، مع تحديد le registre لكل تعبير.","sources":[{"title":"Expressions idiomatiques sur le travail et l’argent","channel":"French Idioms","videoId":"zPhr1rH1_Mc","why":"تعبيرات اصطلاحية تجمع بين le domaine du travail وle domaine de l’argent: تُظهر كيف تتقاطع الحقول الدلالية في la langue des affaires et de la vie courante.","cat":"Lexique","level":"C1","main":true},{"title":"Voler dans les plumes de quelqu’un : sens et exemples","channel":"Français avec Native","videoId":"T4YOF-jBLvM","why":"تعبير مالي-مهني آخر يربط la dispute بـ l’image du vol : توسيع la carte du lexique de l’affrontement.","cat":"Lexique","level":"C1","extra":true},{"title":"Ne pas avoir inventé les boutons à quatre trous : que veut dire ?","channel":"Expressions Françaises","videoId":"bcThhezyB88","why":"تعبير عن la simplicité ou l’ingéniosité في le domaine artisanal : يُظهر كيف ينتقل le registre du travail إلى la vie quotidienne.","cat":"Lexique","level":"C1","extra":true}],"supplements":[{"id":"T4YOF-jBLvM","title":"Voler dans les plumes de quelqu’un : sens et exemples","channel":"Français avec Native","why":"تعبير مالي-مهني آخر يربط la dispute بـ l’image du vol : توسيع la carte du lexique de l’affrontement.","lang":"fr","dur":6},{"id":"bcThhezyB88","title":"Ne pas avoir inventé les boutons à quatre trous : que veut dire ?","channel":"Expressions Françaises","why":"تعبير عن la simplicité ou l’ingéniosité في le domaine artisanal : يُظهر كيف ينتقل le registre du travail إلى la vie quotidienne.","lang":"fr","dur":5}]},{"id":"c1-t2-l4","fr":"Les verbes pronominaux figés","ar":"الأفعال الانعكاسية الثابتة في الفرنسية","objectives":["التمييز بين le pronominal réfléchi وle pronominal figé مثل « se faire une joie »","إدراك la figuration: كيف يفقد le pronom son معناه الانعكاسي ويصبح جزءاً من le sens global","استعمال عشرة أفعال انعكاسية ثابتة بدقّة في la conversation quotidienne","تحليل la translation: كيف تنتقل la valeur de « se faire une joie » من la joie الفعلية إلى l’anticipation positive"],"sections":[{"h":"الدرس 4: الأفعال الانعكاسية التي فقدت انعكاسها","video":{"id":"gS9YXIf15Ko","title":"Maîtrisez Les VERBES PRONOMINAUX Facilement","channel":"Learn French with Ana","why":"شرح منهجي للأفعال الانعكاسية: يُميّز بين le verbe pronominal véritable (الانعكاسي الحقيقي) وle verbe pronominal figé الذي فقد معناه الانعكاسي وصار تعبيراً اصطلاحياً.","lang":"fr","main":true,"dur":12},"p":["الأفعال الانعكاسية في الفرنسية تنقسم إلى ثلاث فئات: le pronominal réfléchi الحقيقي (« se laver »: الفاعل يغسل نفسه)، وle pronominal réciproque (« se parler »: الفاعلان يتبادلان الكلام)، وle pronominal figé أو de sens figé الذي فقد معناه الانعكاسي (« se faire une joie »: لا معنى لـ la joie الانعكاسية هنا).","« Se faire une joie de quelque chose » تعني أن الشخص يتطلّع بشوق إلى حدث: la structure sémantique تدمج le verbe faire مع le nom joie، والـ pronom يُقرأ بوصفه un indice d’intériorité وليس un réfléchi.","« S’en vouloir » تعني اللوم الذاتي: la voix عكسية لكن المعنى la culpabilité. « S’en vouloir de quelque chose » تأخذ la préposition de + l’infinitif ou le nom.","« Se piquer au jeu » تعني أن الشخص يأخذ الأمر على محمل الجد ويندفع في la compétition: la figuration من le geste du joueur qui « se pique » ويدخل la mêlée. la translation: من l’action physique à l’engagement psychologique.","« Se faire un sang d’encre » و« se creuser la tête » من la même famille : la figuration corporelle. أما « se mettre en fournaise » فـ registre familier et imagé pour dire que quelqu’un est en colère.","لاستعمال هذة الأفعال: لا تبحث عن le sens de chaque composant على حدة، بل احفظ le bloc entier مع sa valeur. la mémoire lexicale هنا أفضل من le calcul grammatical."],"sub":[{"h":"se faire une joie","p":["Je me ferai une joie de venir.","Elle se fait une joie de te voir.","On se fait une joie de partager le repas."]},{"h":"s’en vouloir et se piquer","p":["Je m’en veux d’avoir menti.","Il s’est piqué au jeu et a tout donné.","Elle s’en veut de son silence."]},{"h":"la figuration","p":["Se creuser la tête, c’est réfléchir fort.","Se faire un sang d’encre, c’est paniquer.","Attention au sens figuré !"]}]},{"h":"les pronominaux figés à retenir","p":["« Se faire une joie de… » — l’anticipation joyeuse.","« S’en vouloir de… » — le reproche intérieur.","« Se piquer au jeu… » — l’engagement dans la compétition.","« Se creuser la tête… » — l’effort intellectuel."]},{"h":"التطبيق والتلخيص","p":["تمرين la classification: ضع كل فعل انعكاسي من هذه الدرس في la bonne catégorie: réfléchi, réciproque, ou figé.","تمرين la paraphrase: أعد صياغة كل تعبير figé بـ une phrase explicite مع تجنب le pronom.","تمرين la conversation: سجّل حواراً قصيراً بين صديقين يتحدثان عن la compétition et les émotions، مستعملاً ثلاثة أفعال انعكاسية figés."]}],"pron":[{"w":"se faire une joie","ipa":"[sə fɛʁ œ̃ ʒwa]","approx":"سُ فير أُون جوا"},{"w":"s’en vouloir","ipa":"[sɑ̃ vu.lwaʁ]","approx":"سان فُلوار"},{"w":"se piquer au jeu","ipa":"[sə pi.ke o ʒø]","approx":"سُ بيكي أو جوي"}],"vocab":[{"fr":"se faire une joie de","ar":"يتطلّع بشوق إلى","pos":"loc. verb.","g":"","exFr":"Je me ferai une joie de participer.","ipa":"[sə fɛʁ œ̃ ʒwa də]","exAr":"أتطلع بشوق للمشاركة."},{"fr":"s’en vouloir de","ar":"يلوم نفسه على","pos":"loc. verb.","g":"","exFr":"Je m’en veux d’avoir oublié ton anniversaire.","ipa":"[sɑ̃ vu.lwaʁ də]","exAr":"ألوم نفسي على نسيان عيد ميلادك."},{"fr":"se piquer au jeu","ar":"يندفع في المنافسة ويأخذ الأمر على جدّ","pos":"loc. verb.","g":"","exFr":"Il s’est piqué au jeu et a couru pendant une heure.","ipa":"[sə pi.ke o ʒø]","exAr":"اندفع في اللعبة وركض ساعة كاملة."},{"fr":"se creuser la tête","ar":"يُفكّر كثيراً ويجتهد ذهنياً","pos":"loc. verb.","g":"","exFr":"Je me creuse la tête pour trouver la solution.","ipa":"[sə kʁø.ze la tɛt]","exAr":"أُفكّر كثيراً لأجد الحل."},{"fr":"se faire un sang d’encre","ar":"يَقلقُ قلقاً شديداً","pos":"loc. verb.","g":"","exFr":"Elle se fait un sang d’encre quand son fils ne rentre pas.","ipa":"[sə fɛʁ œ̃ sɑ̃ dɑ̃kʁ]","exAr":"تقلق كثيراً حين لا يعود ابنها."},{"fr":"se mettre en fournaise","ar":"يغلي غضباً","pos":"loc. verb.","g":"","exFr":"Quand on le critique, il se met en fournaise.","ipa":"[sə mɛtʁ ɑ̃ fuʁnɛz]","exAr":"حين يُنتقد يغلي غضباً."},{"fr":"se laisser aller","ar":"يسمح لنفسه بالاندفاع","pos":"loc. verb.","g":"","exFr":"Il s’est laissé aller aux larmes.","ipa":"[sə le.se a.le]","exAr":"سمح لنفسه بأن يذوب في الدموع."},{"fr":"se rapprocher de","ar":"يقترب من","pos":"loc. verb.","g":"","exFr":"Les deux amis se rapprochent chaque jour.","ipa":"[sə ʁa.pʁɔ.ʃe də]","exAr":"الصديقان يقتربان كل يوم."},{"fr":"se vouloir","ar":"يريد أن يكون (مع تأكيد)","pos":"loc. verb.","g":"","exFr":"Elle se veut positive malgré l’échec.","ipa":"[sə vu.lwaʁ]","exAr":"تريد أن تكون إيجابية رغم الفشل."},{"fr":"se faire du souci","ar":"يقلق على","pos":"loc. verb.","g":"","exFr":"Elle se fait du souci pour sa sœur.","ipa":"[sə fɛʁ dy susi]","exAr":"قلق على أختها."},{"fr":"se permettre de","ar":"يسمح لنفسه بـ (أحياناً بتعالي)","pos":"loc. verb.","g":"","exFr":"Il se permet de critiquer tout le monde.","ipa":"[sə pɛʁ.mɛtʁ də]","exAr":"يسمح لنفسه بأن ينتقد الجميع."},{"fr":"s’en prendre à","ar":"يَندفع إلى ويُعادي","pos":"loc. verb.","g":"","exFr":"Il s’en prend à ses collègues sans raison.","ipa":"[sɑ̃ pʁɑ̃dʁ a]","exAr":"يندفع ضد زملائه بلا سبب."}],"examples":[{"fr":"Je me ferai une joie de t’aider.","ar":"سأكون سعيداً بمساعدتك.","note":"l’anticipation"},{"fr":"Il s’en veut d’avoir parlé trop fort.","ar":"يلوم نفسه على أنه تحدث بصوت عالٍ.","note":"le reproche intérieur"},{"fr":"Elle s’est piquée au jeu et a tout donné.","ar":"اندفعت في المنافسة وبذلت كل جهدها.","note":"l’engagement"},{"fr":"Je me creuse la tête depuis une heure.","ar":"أُفكّر منذ ساعة.","note":"l’effort intellectuel"},{"fr":"Elle se fait un sang d’encre en attendant les résultats.","ar":"تقلق كثيراً وتنتظر النتائج.","note":"la peur"},{"fr":"Il s’est mis en fournaise quand il a lu la lettre.","ar":"غلا غضباً حين قرأ الرسالة.","note":"la colère (familier)"}],"grammar":[{"tFr":"Le pronominal figé : la perte de la réflexivité","tAr":"الانعكاسي الثابت: فقدان الصفة الانعكاسية","body":["في le verbe pronominal figé يفقد le pronom معناه الانعكاسي: « se faire une joie » لا يعني أن le sujet fait la joie لنفسه بالمعنى الحرفي، بل que le sujet anticipe avec plaisir. le pronom devient un simple marqueur lexical.","la conséquence syntaxique: على الرغم من la perte de la réflexivité، يبقى la grammaire du pronom intact: le participe s’accorde selon les règles. « Elle s’est faite une joie » avec l’accord facultatif selon la doctrine."],"ex":[{"fr":"Il s’en veut d’avoir menti.","ar":"يلوم نفسه على الكذب."},{"fr":"Elle se fait une joie de venir.","ar":"تتطلع بشوق للمجيء."}]},{"tFr":"La translation : de l’action à la valeur psychologique","tAr":"النقل الدلالي: من الفعل إلى القيمة النفسية","body":["la translation في le verbe figé تنتقل من le geste observable إلى la disposition intérieure: « se piquer au jeu » من le geste de l’aiguille إلى l’engagement psychologique dans la compétition.","la conséquence didactique: عند الشرح لا تشرح le verbe composant par composant، بل اشرح la valeur globale. la compréhension passe par la situation d’emploi."],"ex":[{"fr":"Il s’est piqué au jeu : il ne veut plus perdre.","ar":"اندفع في المنافسة ولا يريد أن يخسر الآن."},{"fr":"Je m’en veux de mon silence.","ar":"ألوم نفسي على صمتي."}]}],"mistakes":[{"wrong":"expliquer « se faire une joie » par le pronom réfléchi","right":"retenir la valeur globale","why":"le pronom n’est plus réfléchi ici : c’est une figuration — المعنى الكلّي لا يُحسب من مفرداته."},{"wrong":"« je m’en veux à moi » (double emphasis)","right":"« je m’en veux »","why":"le pronom en est déjà inclus dans le verbe pronominal — تكرار الضمير زائد."},{"wrong":"oublier la préposition après « s’en vouloir »","right":"« s’en vouloir de + infinitif/nom »","why":"la construction exige la préposition de : « je m’en veux d’avoir menti »."},{"wrong":"confondre « se piquer » (réfléchi physique) et « se piquer au jeu »","right":"distinguer le sens propre du sens figé","why":"« se piquer le doigt » est réfléchi physique ; « se piquer au jeu » est la figuration — سياق مختلف تماماً."}],"dialogues":[{"title":"La compétition amicale","ctx":"صديقان يتحدّثان عن مباراة رياضية","lines":[{"who":"Léo","fr":"Tu t’es piqué au jeu, tu courais comme un fou !","ar":"اندفعتَ في اللعبة وكنتَ تجري كالمجنون!"},{"who":"Mira","fr":"Oui, je me suis fait une joie de gagner.","ar":"نعم، كنتُ أتطلع بشوق للفوز."},{"who":"Léo","fr":"Moi, je m’en veux d’avoir raté ce but.","ar":"أما أنا فألوم نفسي على إضاعة هذا الهدف."},{"who":"Mira","fr":"Ne t’en veux pas, la prochaine fois !","ar":"لا تلُم نفسك، في المرة القادمة!"}]},{"title":"L’effort intellectuel","ctx":"زميلان يبحثان عن حلّ لمشكلة","lines":[{"who":"Sarah","fr":"Je me creuse la tête depuis une heure.","ar":"أُفكّر منذ ساعة."},{"who":"Yanis","fr":"Moi aussi, je m’en veux de ne pas avoir compris.","ar":"وأنا أيضاً ألوم نفسي على عدم الفهم."},{"who":"Sarah","fr":"On se fait une joie de trouver, tiens !","ar":"لسنا متحمسين للحل، أليس كذلك!"},{"who":"Yanis","fr":"D’accord, on se met au travail sérieusement.","ar":"حسناً، لنبدأ العمل بجدية."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما معنى « se faire une joie »؟","opts":["يتمتّع بشوق وحماس","يصنع لعبة","يبكي فرحاً","يرفض المشاركة"],"a":0,"why":"la valeur globale : l’anticipation joyeuse de quelque chose."},{"t":"fill","skill":"grammar","q":"أكمل: «Je ___ en veux d’avoir oublié.»","fr":"Je ___ en veux d’avoir oublié.","ans":"m’","why":"le pronom en fait partie du verbe figé : s’en vouloir."},{"t":"order","skill":"writing","q":"رتّب: أنا أندفع في المنافسة","words":["Je","me","pique","au","jeu."],"ans":"Je me pique au jeu.","why":"le verbe pronominal figé + la préposition."},{"t":"listen","skill":"listening","q":"ماذا يعني « se piquer au jeu »؟","opts":["يندفع في المنافسة","يُصيبه الألم","يتحدى الأطباء","يلتقط الإبرة"],"a":0,"why":"la figuration : l’engagement dans la compétition, pas le geste physique."},{"t":"translate","skill":"writing","q":"ترجم: «ألوم نفسي على الكذب.»","ans":"Je m’en veux d’avoir menti.","why":"s’en vouloir de + infinitif = le reproche intérieur."},{"t":"speaking","skill":"speaking","q":"صف موقفاً تمنيت فيه تصرفاً أفضل، مستعملاً « s’en vouloir » و« se faire une joie ».","target":"s’en vouloir / se faire une joie","why":"الإنتاج اللغوي la valeur psychologique des pronominaux figés."},{"t":"correct","skill":"grammar","q":"صحّح: «Je me veux en veux de l’avoir oublié.»","ans":"Je m’en veux de l’avoir oublié.","why":"pas de double pronom : en est déjà dans le verbe."},{"t":"mcq","skill":"reading","q":"أي فعل انعكاسي هو réfléchi حقيقي (لا figé)؟","opts":["se laver","se faire une joie","s’en vouloir","se piquer au jeu"],"a":0,"why":"se laver = se laver soi-même : la réflexivité est réelle."}],"homework":"اكتب فقرة من ست جمل عن موقف جعلك تندفع في منافسة، مستعملاً « se piquer au jeu » و« s’en vouloir » و« se faire une joie »، ثم أعد صياغة كل تعبير بـ une paraphrase sans pronom.","sources":[{"title":"Maîtrisez Les VERBES PRONOMINAUX Facilement","channel":"Learn French with Ana","videoId":"gS9YXIf15Ko","why":"شرح منهجي للأفعال الانعكاسية: يُميّز بين le verbe pronominal véritable (الانعكاسي الحقيقي) وle verbe pronominal figé الذي فقد معناه الانعكاسي وصار تعبيراً اصطلاحياً.","cat":"Lexique","level":"C1","main":true},{"title":"L’accord du participe passé des verbes pronominaux","channel":"Français Conjugaison","videoId":"Xp0hnKZCr3I","why":"قاعدة نحوية لازمة لاستعمال le pronominal figé في l’écrit : l’accord du participe مع le pronom.","cat":"Lexique","level":"C1","extra":true},{"title":"Jouer gros jeu : définition, sens et exemples","channel":"Expressions Françaises","videoId":"dV_KSZIRZyk","why":"تعبير اصطلاحي آخر عن la compétition يُكمل la carte sémantique de « se piquer au jeu » في le domaine du jeu et du risque.","cat":"Lexique","level":"C1","extra":true}],"supplements":[{"id":"Xp0hnKZCr3I","title":"L’accord du participe passé des verbes pronominaux","channel":"Français Conjugaison","why":"قاعدة نحوية لازمة لاستعمال le pronominal figé في l’écrit : l’accord du participe مع le pronom.","lang":"fr","dur":10},{"id":"dV_KSZIRZyk","title":"Jouer gros jeu : définition, sens et exemples","channel":"Expressions Françaises","why":"تعبير اصطلاحي آخر عن la compétition يُكمل la carte sémantique de « se piquer au jeu » في le domaine du jeu et du risque.","lang":"fr","dur":6}]},{"id":"c1-t2-l5","fr":"Proverbes et adages","ar":"الأمثال والحكم الفرنسية","objectives":["التمييز بين le proverbe (حكمة شعبية) وl’adage (حكم سامي) وl’axiome","ربط كل مثل بـ le contexte d’emploi المناسب: la conversation، la lettre، ou le discours","استعمال خمسة أمثال فرنسية بدقّة في la production écrite et orale","تفسير l’origine التاريخية أو الثقافية لمجموعة من الأمثال الفرنسية"],"sections":[{"h":"الدرس 5: من المثل الشعبي إلى الحكم السامي","video":{"id":"iEc4qrSnty0","title":"Dix proverbes français","channel":"Proverbes Français","why":"عشرة أمثال فرنسية شائعة بصوت واضح: يُقدّم le proverbe في سياقه وتُشرح قيمته la sagesse collective، نقطة انطلاق مثالية لفهم le registre soutenu.","lang":"fr","main":true,"dur":9},"p":["le proverbe صيغة قصيرة موروثة شفوياً تحمل la sagesse collective du peuple. le proverbe جملة تركيبية مكتملة، وغالباً ما تأتي في le présent de l’indicatif أو l’impératif.","l’adage مختلف: هو حكم ذو أصل littéraire أو philosophique، يُنسب إلى un auteur ou une tradition savante. « Errare humanum est » (بالإنجليزية) و« À cœur vaillant, rien d’impossible » أمثلة على le registre élevé.","la fonction du proverbe في la conversation: le locuteur يستدعي la maxime pour appuyer son opinion دون أن يُشرحها — le proverbe يختصر le raisonnement. « Qui trop embrasse mal étreint » تُقال في la discussion حول l’excès d’ambition.","« Mieux vaut tard que jamais » و« L’habit ne fait pas le moine » من أكثر الأمثال شيوعاً: la première عن la ponctualité alternative، والثانية عن la valeur derrière les apparences.","la nuance culturelle: الأمثال الفرنسية تعكس la géographie et l’histoire: « Après la pluie, le beau temps » (la saison)، et « Paris ne s’est pas fait en un jour » (la patience urbaine).","للاستعمال السليم: احفظ le proverbe entier مع sa ponctuation et sa conjonction، ثم ادرس la phrase où il s’intègre. le proverbe يُستعمل في le discours argumentatif pour la conclure."],"sub":[{"h":"les proverbes de la sagesse","p":["Mieux vaut tard que jamais.","Paris ne s’est pas fait en un jour.","L’habit ne fait pas le moine."]},{"h":"les proverbes de l’action","p":["Qui trop embrasse mal étreint.","Après la pluie, le beau temps.","Il ne faut pas remettre à demain."]},{"h":"le registre soutenu","p":["L’adage est plus formel que le proverbe.","Il cite souvent la maxime.","Le proverbe conclut le discours."]}]},{"h":"les maximes à retenir","p":["« Mieux vaut tard que jamais… » — la consolation et l’action.","« Qui trop embrasse mal étreint… » — l’excès nuit.","« L’habit ne fait pas le moine… » — les apparences trompent.","« Paris ne s’est pas fait en un jour… » — la patience."]},{"h":"التطبيق والتلخيص","p":["تمرين la correspondance: اربط كل مثل فرنسي بمثل عربي مكافئ، ثم اشرح أوجه التشابه والاختلاف في l’image employée.","تمرين la citation: اكتب فقرة حجاجية من خمس جمل، واختمها بـ proverbe واحد يلخّص رأيك.","تمرين la transformation: حوّل مثل parabolique واحد إلى le registre courant في la conversation quotidienne."]}],"pron":[{"w":"le proverbe","ipa":"[lə pʁɔ.vɛʁb]","approx":"لو بروفيرب"},{"w":"l’adage","ipa":"[la.daʒ]","approx":"لاداج"},{"w":"la sagesse","ipa":"[la sa.ʒɛs]","approx":"لا ساجيس"}],"vocab":[{"fr":"mieux vaut tard que jamais","ar":"خير أن نتأخر عن أن لا نفعل","pos":"proverbe","g":"","exFr":"Il commence enfin son projet : mieux vaut tard que jamais.","ipa":"[mjø vo taʁ kə ʒa.me]","exAr":"بدأ مشروعه أخيراً: خير التأخر من عدم الفعل."},{"fr":"l’habit ne fait pas le moine","ar":"الظاهر لا يدلّ على المضمون","pos":"proverbe","g":"","exFr":"Il a l’air riche, mais l’habit ne fait pas le moine.","ipa":"[la.bi nə fɛ pa lə mwan]","exAr":"يبدو ثرياً، لكن الظاهر لا يدلّ على الباطن."},{"fr":"qui trop embrasse mal étreint","ar":"من أراد أكثر فأخذ أقل","pos":"proverbe","g":"","exFr":"Il lance trois projets à la fois : qui trop embrasse mal étreint.","ipa":"[ki tʁɔ̃.ɑ̃.bʁɑs mal e.tʁɛ̃]","exAr":"يطلق ثلاث مشاريع دفعة واحدة: من أراد أكثر فأخذ أقل."},{"fr":"après la pluie, le beau temps","ar":"بعد العسر يسر","pos":"proverbe","g":"","exFr":"Les choses s’améliorent : après la pluie, le beau temps.","ipa":"[a.pʁe la plɥi lə bo tɑ̃]","exAr":"تتحسن الأمور: بعد الكرب فرج."},{"fr":"paris ne s’est pas fait en un jour","ar":"لا يُبنى شيء عظيم في يوم","pos":"proverbe","g":"","exFr":"La perfection demande du temps : Paris ne s’est pas fait en un jour.","ipa":"[pa.ʁi nə sɛ pa fɛ ɑ̃ œ̃ ʒuʁ]","exAr":"الكمال يحتاج وقتاً: لا يُبنى العظيم في يوم."},{"fr":"il ne faut pas remettre à demain ce qu’on peut faire aujourd’hui","ar":"لا يؤجّل المرء ما يستطيع إنجازه اليوم","pos":"proverbe","g":"","exFr":"Fais tes devoirs : il ne faut pas remettre à demain.","ipa":"[il nə fo pa ʁə.mɛtʁ a də.mɑ̃]","exAr":"أنجز واجباتك: لا تؤجّل ما تستطيع اليوم."},{"fr":"à cœur vaillant, rien d’impossible","ar":"للقلب الشجاع لا شيء مستحيل","pos":"adage","g":"","exFr":"Il continue malgré tout : à cœur vaillant, rien d’impossible.","ipa":"[a kœʁ va.jɑ̃ ʁjɛ̃ dɛ̃.pɔ.si.bl]","exAr":"يواصل رغم كل شيء: للقلب الجريء لا شيء مستحيل."},{"fr":"errare humanum est","ar":"الخطأ من طبيعة البشر","pos":"adage","g":"","exFr":"Ne t’inquiète pas, errare humanum est.","ipa":"[ɛ.ʁa.ʁə y.ma.num ɛst]","exAr":"لا تقلق، فالخطأ من طبيعة البشر."},{"fr":"la pudeur est sœur de la vertu","ar":"الحياء أخت الفضيلة","pos":"adage","g":"","exFr":"Elle évite de parler d’elle : la pudeur est sœur de la vertu.","ipa":"[la py.dœʁ ɛ sœʁ də la vɛʁ.ty]","exAr":"تجنّب الحديث عن نفسها: فالحياء أخت الفضيلة."},{"fr":"un rien est souvent un tout","ar":"القليل قد يكون كل شيء","pos":"adage","g":"","exFr":"Un détail a tout changé : un rien est souvent un tout.","ipa":"[œ̃ ʁjɛ̃ ɛ su.vẽ œ̃ tu]","exAr":"تفصيل غيّر كل شيء: قد يكون القليل كل شيء."},{"fr":"à badiner on apprend à parler","ar":"بالمرح والمزاح يتعلّم الإنسان الكلام","pos":"proverbe","g":"","exFr":"Les enfants rient en classant les mots : à badiner on apprend à parler.","ipa":"[a ba.di.ne ɑ̃.na.pʁɑ̃ a pa.le]","exAr":"يضحك الأطفال وهم يرتّبون الكلمات: بالمزاح يتعلّم الإنسان الكلام."},{"fr":"le temps est un grand maître","ar":"الزمان أستاذ عظيم","pos":"proverbe","g":"","exFr":"Patiente : le temps est un grand maître.","ipa":"[lə tɑ̃ ɛ œ̃ ɡʁɑ̃ mɛtʁ]","exAr":"اصبر: الزمان معلّم عظيم."}],"examples":[{"fr":"Mieux vaut tard que jamais.","ar":"خير التأخر من عدم الفعل.","note":"la consolation"},{"fr":"L’habit ne fait pas le moine.","ar":"الظاهر لا يدلّ على المضمون.","note":"l’apparence"},{"fr":"Qui trop embrasse mal étreint.","ar":"من أراد أكثر فأخذ أقل.","note":"l’excès"},{"fr":"Après la pluie, le beau temps.","ar":"بعد الكرب فرج.","note":"l’espérance"},{"fr":"Paris ne s’est pas fait en un jour.","ar":"لا يُبنى العظيم في يوم واحد.","note":"la patience"},{"fr":"À cœur vaillant, rien d’impossible.","ar":"للقلب الشجاع لا شيء مستحيل.","note":"l’adage soutenu"}],"grammar":[{"tFr":"La syntaxe du proverbe : le présent et la subordonnée","tAr":"تركيب المثل: المضارع والجملة الفرعية","body":["le proverbe يستعمل la conjugaison au présent de l’indicatif pour la vérité générale: « Qui trop embrasse mal étreint » يعبّر عن un principe intemporel. le présent هنا la valeur gnologique.","la structure fréquente: une subordonnée relative (qui, ce que) + une principale, ou une coordination (mieux… que). la concision est la règle : pas d’article inutile, pas d’adverbe de façon."],"ex":[{"fr":"Qui trop embrasse mal étreint.","ar":"من أراد أكثر فأخذ أقل."},{"fr":"Mieux vaut tard que jamais.","ar":"خير التأخر من عدم الفعل."}]},{"tFr":"Proverbe, adage, axiome : la hiérarchie des genres","tAr":"المثل والحكمة والأصل: تدرّج الأنواع","body":["la hiérarchie: le proverbe du peuple (oral, imagé)، l’adage de la tradition savante (écrit, parfois latin)، l’axiome de la démonstration rationnelle (sans image). la différence se joue sur le registre et l’origine.","la conséquence stylistique: dans le discours soutenu, on cite l’adage pour la conclusion؛ dans la conversation, le proverbe pour l’adhésion. choisir le bon genre, c’est choisir le bon public."],"ex":[{"fr":"Proverbe : Après la pluie, le beau temps.","ar":"مثل شعبي: بعد الكرب فرج."},{"fr":"Adage : À cœur vaillant, rien d’impossible.","ar":"حكمة أدبية: للقلب الشجاع لا شيء مستحيل."}]}],"mistakes":[{"wrong":"changer les mots du proverbe","right":"respecter la forme traditionnelle","why":"le proverbe est figé : toute variation le rend méconnaissable — المثل لا يقبل التعديل."},{"wrong":"employer l’adage dans la conversation familière","right":"choisir le registre adapté","why":"l’adage est réservé au registre soutenu : « à cœur vaillant » paraîtrait pédant — الحكم السامي لا يُقال عرضاً."},{"wrong":"confondre le proverbe et la citation","right":"le proverbe est anonyme, la citation est signée","why":"la maxime de La Rochefoucauld n’est pas un proverbe : elle a un auteur — المثل جماعي والاقتباس فردي."},{"wrong":"traduire le proverbe mot à mot","right":"chercher l’équivalent culturel","why":"le sens culturel prime sur les mots : l’équivalent arabe est plus naturel — المعنى الثقافي أهم من الحرفية."}],"dialogues":[{"title":"Le conseil d’un ami","ctx":"صديقان، أحدهما محبّط من التأخّر في مشروع","lines":[{"who":"Fatima","fr":"Je n’ai pas encore fini mon mémoire.","ar":"لم أُكمل رسالتي بعد."},{"who":"Bruno","fr":"Ne t’inquiète pas : mieux vaut tard que jamais.","ar":"لا تقلقي: خير التأخر من عدم الفعل."},{"who":"Fatima","fr":"Tu as raison. Paris ne s’est pas fait en un jour.","ar":"معك حق. لا يُبنى العظيم في يوم."},{"who":"Bruno","fr":"Exactement. Après la pluie, le beau temps !","ar":"بالضبط. بعد الكرب فرج!"}]},{"title":"La discussion sur les apparences","ctx":"نقاش حول الانطباع الأول","lines":[{"who":"Hélène","fr":"Il a l’air sérieux, mais je doute.","ar":"يبدو جاداً لكنني أشك."},{"who":"Sami","fr":"N’oublie pas : l’habit ne fait pas le moine.","ar":"لا تنسي: الظاهر لا يدلّ على المضمون."},{"who":"Hélène","fr":"Et toi, tu juges trop vite ?","ar":"وأنت، هل تحكم بسرعة؟"},{"who":"Sami","fr":"À badiner, on apprend à parler. Prenons le temps.","ar":"بالمزاح نتعلّم الكلام. لنأخذ وقتنا."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما معنى « l’habit ne fait pas le moine »؟","opts":["الظاهر لا يدلّ على المضمون","الثوب جديد دائماً","الراهب لا يلبس ملابس","الملابس تُصنع يدوياً"],"a":0,"why":"le moine et l’habit : l’apparence ne révèle pas la vraie nature."},{"t":"fill","skill":"grammar","q":"أكمل المثل: «Mieux vaut ___ que jamais.»","fr":"Mieux vaut ___ que jamais.","ans":"tard","why":"la forme traditionnelle : mieux vaut tard que jamais."},{"t":"order","skill":"writing","q":"رتّب المثل: باريس لم تُبنَ في يوم واحد","words":["Paris","ne","s’est","pas","fait","en","un","jour."],"ans":"Paris ne s’est pas fait en un jour.","why":"la négation avec « ne … pas » + le passé composé avec être (verbe pronominal)."},{"t":"listen","skill":"listening","q":"أي نوع من الأنواع هو « à cœur vaillant, rien d’impossible »؟","opts":["l’adage","le proverbe","la devinette","la comptine"],"a":0,"why":"l’adage a un origine littéraire et un registre soutenu, contrairement au proverbe populaire."},{"t":"translate","skill":"writing","q":"ترجم: «خير التأخر من عدم الفعل.»","ans":"Mieux vaut tard que jamais.","why":"la structure comparative : mieux + adjectif + que."},{"t":"speaking","skill":"speaking","q":"اختم نصيحة لصديق مستعملاً مثلين فرنسيين مناسبين للسياق.","target":"mieux vaut tard / après la pluie le beau temps","why":"la fonction conclusive du proverbe dans le discours."},{"t":"correct","skill":"grammar","q":"صحّح: «Qui trop écoute mal comprend.»","ans":"Qui trop embrasse mal étreint.","why":"la forme traditionnelle du proverbe est fixée par l’usage."},{"t":"mcq","skill":"reading","q":"أي عبارة تنتمي إلى le registre soutenu؟","opts":["À cœur vaillant, rien d’impossible.","Je suis crevé.","Il coûte les yeux de la tête.","Il a posé un lapin."],"a":0,"why":"l’adage est le seul parmi les quatre à appartenir au registre soutenu."}],"homework":"اكتب فقرة حجاجية من سبع جمل حول قضية تهمّك، واختمها بـ ثلاثة أمثال فرنسية، بعد كل مثل اكتب تفسيراً قصيراً بـ le registre courant.","sources":[{"title":"Dix proverbes français","channel":"Proverbes Français","videoId":"iEc4qrSnty0","why":"عشرة أمثال فرنسية شائعة بصوت واضح: يُقدّم le proverbe في سياقه وتُشرح قيمته la sagesse collective، نقطة انطلاق مثالية لفهم le registre soutenu.","cat":"Lexique","level":"C1","main":true},{"title":"Dix proverbes français [Partie II]","channel":"Proverbes Français","videoId":"6hPfQYbswQ4","why":"عشرة أمثال إضافية تُوسّع la collection: تدريب على la variation des structures proverbiales.","cat":"Lexique","level":"C1","extra":true},{"title":"Proverbes et dictons : sauras-tu les compléter ?","channel":"Quiz Français","videoId":"OirGF52aJNo","why":"اختبار تفاعلي يختبر la mémoire active للأمثال والتعابير: يُحوّل la reconnaissance إلى la production.","cat":"Lexique","level":"C1","extra":true}],"supplements":[{"id":"6hPfQYbswQ4","title":"Dix proverbes français [Partie II]","channel":"Proverbes Français","why":"عشرة أمثال إضافية تُوسّع la collection: تدريب على la variation des structures proverbiales.","lang":"fr","dur":9},{"id":"OirGF52aJNo","title":"Proverbes et dictons : sauras-tu les compléter ?","channel":"Quiz Français","why":"اختبار تفاعلي يختبر la mémoire active للأمثال والتعابير: يُحوّل la reconnaissance إلى la production.","lang":"fr","dur":7}]},{"id":"c1-t2-l6","fr":"Ironie et décalage","ar":"الطبَع والسخرية في الفرنسية","objectives":["التعرّف على la tonalité ironique: كيف ينقل le ton وla ponctuation المعنى المعكوس","التمييز بين l’ironie verbale وla provocation directe في le registre familier","استعمال le second degré بذكاء دون إساءة الفهم في la conversation","تحليل les procédés de l’humour verbal français: l’antiphrase، la litote، et l’exagération"],"sections":[{"h":"الدرس 6: كيف يتكلّم الفرنسيون بلغة معكوسة","video":{"id":"HoTDz3fiQ3k","title":"Maîtriser l’Ironie et l’Humour en Français","channel":"Karambolage – ARTE","why":"شرح بصري لـ le second degré في الفرنسية: كيف ينتقل le discours من le sens littéral إلى le sens opposé، ولماذا la subtilité la marque de l’humour verbal français.","lang":"fr","main":true,"dur":7},"p":["الطبَع (ironie) في الفرنسية أداة أساسية في le registre soutenu والـ humour: le locuteur يقول عكس ما يقصده، والمستمع يُفكّر la phrase المعكوسة. la clé: le ton، la contexte، et parfois la ponctuation.","l’antiphrase هي la figure centrale: « Quelle bonne surprise ! » بعد خبر سيّئ تُقال بـ le ton plat. la contradiction entre le mot et le ton تخلق le sens ironique.","« Le second degré » (registre courant) يعني la lecture au second niveau من la phrase: « Merci bien ! » بعد جملة محرجة تعني le refus. la différence avec le premier degré هي la distance intellectuelle.","la litote وl’euphémisme من la même famille du décalage mais aux effets opposés: la litote dit moins pour signifier plus (« Ce n’est pas mal ! » بمعنى très bien)، tandis que l’ironie dit le contraire.","الحذر الثقافي: la provocation verbale في le registre familier (« T’es bon ! » بمعنى tu es nul) قد تُسيء الفهم بين les non-natifs. la nuance entre l’ironie amicale et l’humour cinglant dépend du lien social.","لاستعمال le second degré: ابدأ بالـ ton واللهجة la plus claire، ثم اترك la pause لِـ le décalage. la maîtrise de l’ironie تأتي مع la maîtrise de la situation discursive."],"sub":[{"h":"l’antiphrase","p":["Quelle bonne surprise, après tout ce retard !","Il est vraiment « intelligent » ce coup-là.","Bravo, tu as réussi à tout gâcher."]},{"h":"le second degré","p":["Merci bien, je m’en passerai.","Ah oui, c’est « super » comme idée.","Tu es bien aimable, tiens !"]},{"h":"le ton et la ponctuation","p":["Le ton plat révèle l’ironie.","Les guillemets soulignent le décalage.","Attention au contexte !"]}]},{"h":"les outils de l’ironie","p":["« Quelle bonne surprise… » — l’antiphrase après un contretemps.","« Merci bien… » — le refus poli et ironique.","« Tu es bien aimable… » — la litote ironique.","« C’est super… » (le ton plat) — le second degré."]},{"h":"التطبيق والتلخيص","p":["تمرين la tonalité: اقرأ ثلاث جمل ironica بصوت واحد، ثم عدّل le ton والأداء la plus claire لتجعل le sens مختلفاً.","تمرين la réécriture: أعد كتابة le compliment suivant بـ le second degré ثم بـ le premier degré، وشرح الفرق.","تمرين l’analyse: اختر مشهداً من فيلم أو سلسلة فرنسية، وحدّد كل le moment d’ironie: le contexte، le ton، et le sens visé."]}],"pron":[{"w":"l’ironie","ipa":"[li.ʁɔ.ni]","approx":"ليروني"},{"w":"le second degré","ipa":"[lə sə.kɔ̃ de.ɡʁe]","approx":"لو سيكون دِيغرِيه"},{"w":"l’antiphrase","ipa":"[lɑ̃.ti.fʁaz]","approx":"لانتيفراز"}],"vocab":[{"fr":"l’ironie","ar":"الطبَع والسخرية (قول عكس المقصود)","pos":"nom","g":"f","exFr":"Son commentaire était plein d’ironie.","ipa":"[li.ʁɔ.ni]","exAr":"كان تعليقه مفعماً بالطبَع."},{"fr":"le second degré","ar":"المعنى الثاني (غير الحرفي)","pos":"loc.","g":"m","exFr":"Il a pris la phrase au second degré.","ipa":"[lə sə.kɔ̃ de.ɡʁe]","exAr":"أجاب الجملة بمعنى غير حرفي."},{"fr":"l’antiphrase","ar":"الطبَع بالقول المنافي للمعنى","pos":"nom","g":"f","exFr":"« Quelle bonne surprise ! » après le retard : c’est une antiphrase.","ipa":"[lɑ̃.ti.fʁaz]","exAr":"«ما أجمل المفاجأة!» بعد التأخير: إنها سخرية."},{"fr":"la litote","ar":"التخفيف الذي يدلّ على المبالغة","pos":"nom","g":"f","exFr":"Ce n’est pas mal ! → c’est excellent.","ipa":"[la.li.tɔt]","exAr":"ليست سيئة! أي ممتازة."},{"fr":"la tonalité ironique","ar":"النبرة الساخرة","pos":"loc.","g":"f","exFr":"Sa tonalité ironique a mis tout le monde mal à l’aise.","ipa":"[la tɔ.na.li.te i.ʁɔ.nik]","exAr":"نبرته الساخرة جعلت الجميع يشعرون بالحرج."},{"fr":"prendre au premier degré","ar":"يأخذ الكلام بمعناه الحرفي","pos":"loc. verb.","g":"","exFr":"Il a tout pris au premier degré, il n’a rien compris.","ipa":"[pʁɑ̃dʁ o pʁə.mjɛ̃ de.ɡʁe]","exAr":"أخذ كل شيء بالمعنى الحرفي ولم يفهم شيئاً."},{"fr":"être sarcastique","ar":"يكون ساخراً لاذعاً","pos":"verbe","g":"","exFr":"Il est souvent sarcastique en réunion.","ipa":"[ɛ.tʁə saʁ.kas.tik]","exAr":"يكون غالباً لاذعاً في الاجتماعات."},{"fr":"se moquer de","ar":"يسخر من","pos":"loc. verb.","g":"","exFr":"Il se moque de tout le monde, sans méchanceté.","ipa":"[sə mɔ.ke də]","exAr":"يسخر من الجميع دون خبث."},{"fr":"l’esprit","ar":"الذكاء الساخر","pos":"nom","g":"m","exFr":"Il a beaucoup d’esprit en société.","ipa":"[lɛs.pʁi]","exAr":"يتمتع بذكاء ساخر في المجالس."},{"fr":"la chute","ar":"النهاية المضيئة للكوميديا","pos":"nom","g":"f","exFr":"La chute de la blague était imprévisible.","ipa":"[la ʃyt]","exAr":"نهاية النكتة كانت غير متوقعة."},{"fr":"le décalage","ar":"الفارق بين المتوقع والموجود","pos":"nom","g":"m","exFr":"Le décalage entre le discours et les actes est frappant.","ipa":"[lə de.ka.laʒ]","exAr":"الفارق بين الخطاب والأفعال مثير للانتباه."},{"fr":"faire de l’ironie","ar":"يتمسّك بالطبَع والتعني","pos":"loc. verb.","g":"","exFr":"Arrête de faire de l’ironie, parle clairement.","ipa":"[fɛʁ də li.ʁɔ.ni]","exAr":"كفَّ عن السخرية، تحدّث بوضوح."}],"examples":[{"fr":"Quelle bonne surprise après trois heures d’attente !","ar":"يا لها من مفاجأة سارة بعد ثلاث ساعات انتظار!","note":"l’antiphrase"},{"fr":"Merci bien, je m’en passerai.","ar":"شكراً جزيلاً، سأستغني عن ذلك.","note":"le refus poli"},{"fr":"Ce n’est pas mal du tout !","ar":"ليست سيئة إطلاقاً! أي ممتازة.","note":"la litote"},{"fr":"Il a tout pris au premier degré.","ar":"أخذ كل شيء بالمعنى الحرفي.","note":"l’incompréhension"},{"fr":"Avec son ton plat, elle a dit « super ».","ar":"بنبرتها المتبلدة قالت «رائع».","note":"le ton révèle le sens"},{"fr":"Il a beaucoup d’esprit en société.","ar":"يتمتع بذكاء ساخر في المجالس.","note":"l’humour social"}],"grammar":[{"tFr":"La tonalité ironique : le ton face à la lettre","tAr":"النبرة الساخرة: النبرة مقابل المعنى الحرفي","body":["في le discours ironique تُبنى la contradiction بين deux plans: le plan du contenu (la lettre) et le plan de la parole (la voix, le ton). la tonalité تُلغي la lettre أو تقلبها.","la conséquence écrite: على الورق تأتي la ponctuation وles guillemets لتعوّض le ton: « Il est vraiment « intelligent » » avec les guillemets prête le décalage."],"ex":[{"fr":"Quelle bonne surprise ! (après une mauvaise nouvelle)","ar":"يا لها من مفاجأة سارة! (بعد خبر سيّئ)"},{"fr":"Merci bien ! (pour refuser)","ar":"شكراً جزيلاً! (لرفض العرض)"}]},{"tFr":"Ironie, litote, euphémisme : les frontières du décalage","tAr":"الطبَع والتخفيف: حدود التباعد الدلالي","body":["la frontière: l’ironie dit le contraire (anti-phrastique)، la litote dit moins pour signifier plus (« c’est pas mal » = excellent)، l’euphémisme atténue la violence (« il est parti » = il est mort). تقارب la stratégie du décalage لكن تختلف la direction.","le repérage didactique: اسأل دائماً « هل قصد le locuteur le contraire de ce qu’il dit؟ » إن نعم → ironie؛ إن قال أقل مما يقصده → litote؛ إن خفّف → euphémisme."],"ex":[{"fr":"Il est très aimable ! (ironie, si l’on l’a blessé)","ar":"إنه لطيف جداً! (سخرية إذا كان قد جرحنا)"},{"fr":"Il n’est pas mal ! (litote, c’est un compliment)","ar":"ليس سيئاً! (تخفيف يدلّ على المدح)"}]}],"mistakes":[{"wrong":"ترجمة le second degré إلى le degré premier","right":"التعرّف على la contradiction entre le mot et le ton","why":"la perte de l’ironie en traduction altère le message — تجاهل الطبَع يُغيّر معنى الرسالة."},{"wrong":"استعمال la provocation verbale في le contexte formel","right":"la retenue في le registre soutenu","why":"l’ironie cinglante est réservée aux liens proches — السخرية اللاذعة خاصة بالعلاقات القريبة."},{"wrong":"إضافة le ton agressif إلى l’ironie amicale","right":"la nuance du lien social","why":"même les mots, le ton change tout : l’amical n’est pas l’hostile — النبرة هي الفيصل."},{"wrong":"confondre la litote et l’euphémisme","right":"la litote dit moins, l’euphémisme adoucit","why":"la litote renforce (moins = plus), l’euphémisme atténue — الأول يقوّي والثاني يُخفّف."}],"dialogues":[{"title":"Le rendez-vous retardé","ctx":"صديقان، أحدهما تأخّر نصف ساعة","lines":[{"who":"Chloé","fr":"Tu es enfin là ! Quelle ponctualité.","ar":"وصلتَ أخيراً! يا لها من حِرْص على المواعيد."},{"who":"Nassim","fr":"Pardon, il y avait des travaux sur la route.","ar":"سامحيني، كانت هناك أشغال في الطريق."},{"who":"Chloé","fr":"Merci bien, je m’en passerai de tes excuses.","ar":"شكراً جزيلاً، سأستغني عن أعذارك."},{"who":"Nassim","fr":"Bon, je vois que tu es de bonne humeur !","ar":"حسناً، أرى أنك في مزاج جيد!"}]},{"title":"La réunion d’équipe","ctx":"اجتماع مهني بعد قرار مثير للجدل","lines":[{"who":"Isabelle","fr":"La décision est « géniale », on n’avait jamais vu ça.","ar":"القرار «عبقري»، لم نشهد مثله من قبل."},{"who":"Rachid","fr":"Tu parles au second degré, j’espère ?","ar":"أتتحدث بالمعنى غير الحرفي، أأمل؟"},{"who":"Isabelle","fr":"Évidemment. Mais franchement, je préfère le premier degré : la clarté.","ar":"بالطبع. لكن صراحةً، أفضل المعنى الحرفي: الوضوح."},{"who":"Rachid","fr":"D’accord, alors dis-moi clairement ce que tu penses.","ar":"حسناً، إذن قولي بوضوح ما تعتقدينه."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما معنى « le second degré »؟","opts":["المعنى غير الحرفي من العبارة","الدرجة الثانية من التعليم","الخطوة التالية","القياس الثاني"],"a":0,"why":"le second degré = la lecture indirecte de la phrase, l’interprétation non littérale."},{"t":"fill","skill":"grammar","q":"أكمل: «Après trois heures d’attente, quelle ___ surprise !»","fr":"Après trois heures d’attente, quelle ___ surprise !","ans":"bonne","why":"la contradiction crée l’ironie : le lexique positif contredit la situation."},{"t":"order","skill":"writing","q":"رتّب: أنا أفضّل المعنى الحرفي","words":["Je","préfère","le","premier","degré."],"ans":"Je préfère le premier degré.","why":"sujet + verbe + complément : l’ordre canonique français."},{"t":"listen","skill":"listening","q":"ما الذي يكشف la tonalité ironique في « Quelle bonne surprise »؟","opts":["le contexte et le ton","la longueur de la phrase","le choix du présent","la négation"],"a":0,"why":"sans le ton et la situation, la phrase serait prise au premier degré."},{"t":"translate","skill":"writing","q":"ترجم بطبَع: «شكراً جزيلاً، سأستغني عن ذلك.»","ans":"Merci bien, je m’en passerai.","why":"la formule de refus poli à la tonalité ironique."},{"t":"speaking","skill":"speaking","q":"ارفض دعوة بطريقة ironica دون أن تبدو فظاً، مستعملاً le second degré.","target":"Merci bien / je m’en passerai / au second degré","why":"l’ironie comme stratégie de politesse dans le refus."},{"t":"correct","skill":"grammar","q":"صحّح: «Il a parlé au premier degré alors qu’il voulait rire.»","ans":"Il a parlé au second degré puisqu’il voulait rire.","why":"l’humour exige le second degré, le sens non littéral."},{"t":"mcq","skill":"reading","q":"أي عبارة تعني la litote à l’effet positif؟","opts":["Ce n’est pas mal !","Merci bien !","Quelle surprise !","Tu es bien aimable… (ton plat)"],"a":0,"why":"la litote dit moins pour signifier plus : « pas mal » = excellent."}],"homework":"سجّل مقطع صوتي من دقيقة ترفض فيه عرضاً بطريقة ironica مستعملاً le second degré، ثم اكتب النص وحدّد فيه le ton et la ponctuation المناسبين.","sources":[{"title":"Maîtriser l’Ironie et l’Humour en Français","channel":"Karambolage – ARTE","videoId":"HoTDz3fiQ3k","why":"شرح بصري لـ le second degré في الفرنسية: كيف ينتقل le discours من le sens littéral إلى le sens opposé، ولماذا la subtilité la marque de l’humour verbal français.","cat":"Lexique","level":"C1","main":true},{"title":"L’ironie, l’art français de taquiner avec subtilité","channel":"Français Authentique","videoId":"8NOBwiy0XI4","why":"la dimension culturelle de l’ironie في les relations quotidiennes: كيف تصبح le taquiner la marque de la confiance.","cat":"Lexique","level":"C1","extra":true},{"title":"L’ironie : quand les mots disent le contraire","channel":"Le Français Facile","videoId":"wixy69DP8xc","why":"شرح لـ la figure de l’antiphrase من le point de vue rhetorique: يُرسّخ la base stylistique للطبَع اللفظي.","cat":"Lexique","level":"C1","extra":true}],"supplements":[{"id":"8NOBwiy0XI4","title":"L’ironie, l’art français de taquiner avec subtilité","channel":"Français Authentique","why":"la dimension culturelle de l’ironie في les relations quotidiennes: كيف تصبح le taquiner la marque de la confiance.","lang":"fr","dur":8},{"id":"wixy69DP8xc","title":"L’ironie : quand les mots disent le contraire","channel":"Le Français Facile","why":"شرح لـ la figure de l’antiphrase من le point de vue rhetorique: يُرسّخ la base stylistique للطبَع اللفظي.","lang":"fr","dur":6}]}]},{"id":"c1-t3","slug":"le-style-formel-et-soutenu","icon":"edit","color":"#dc2626","fr":"Le style formel et soutenu","ar":"الأسلوب الرسمي والرفيع","desc":"la lettre، le discours académique، la réécriture، la politesse، la syntaxe، le résumé exécutif.","lessons":[{"id":"c1-t3-l1","fr":"L’art de la lettre formelle","ar":"فنّ الرسالة الرسمية","objectives":["بناء رسالة إدارية كاملة: l’en-tête, l’objet, le corps, la formule d’appel et la formule de politesse","توظيف عشر صيغة إدارية جاهزة في سياقها الصحيح بدلاً من الترجمة الحرفية","ضبط la tonalité: le vouvoiement, l’impersonnel وla voix passive مع تجنّب la première personne المُفردة","التمييز بين le courrier administratif وle courrier commercial وle courrier privé في البنية واللغة"],"sections":[{"h":"الدرس 1: كيف تُكتب رسالة إدارية فرنسية تُقرأ حتى النهاية","video":{"id":"ClR45qfouKg","title":"10 Expressions pour une Lettre Administrative en français ✉","channel":"Parlez-vous FRENCH : Cours de français","why":"عشر صيغ إدارية جاهزة — « Il est rappelé que », « Nous vous prions de », « Veuillez trouver ci-joint » — تشرح كيف تُبنى le ton الرسمية داخل le courrier administratif دون أن تبدو الجملة مُترجمة.","lang":"fr","main":true,"dur":7},"p":["la lettre administrative فرنسيّة رسالة تُرسل إلى إدارة (mairie, préfecture, université, caisse d’assurance) أو من إدارة. خصوصيتها: يقرأها موظّف في دقائق، ولذلك تُختبر le style قبل la demande: رسالة تبدأ بـ « Je veux » تُفتح بـ la note défavorable قبل أن تُقرأ.","البنية المرجعية ثابتة ومنزلة: اسم وعنوان المرسِل أعلى اليسار، ثم اسم المرسَل إليه، ثم le lieu et la date، ثم la référence (N/R : …) وl’objet في سطر مستقل، ثم la formule d’appel، ثم عرض الوقائع، ثم la demande نفسها، ثم la formule de politesse، ثم la signature. هذا التسلسل هو la signature visuelle de l’administration.","المعجم الإداري لا يُخترع بل يُستعمل كما هو: « Il est rappelé que… » (يُذكَر أنّ)، « Nous vous informons que… » (نُعلمكم أنّ)، « Veuillez trouver ci-joint… » (تجدون مرفقاً)، « Dans l’attente de votre retour, … » (وفي انتظار ردّكم). كل صيغة تحمل la nuance: « Il est rappelé que » تذكّر بواجب قائم، و« Nous vous prions de » تأمر بلباقة.","la tonalité تقوم على ثلاثة قواعد: le vouvoiement المطلق حتى مع من تعرفه، la structure impersonnelle (« Il convient de… », « Il est possible de… ») التي تُخفي la subjectivité، وla voix passive أو la voix active مع sujet collectif (« le service examine… ») التي تُبقي la distance المؤسساتية. التفاصيل الصغيرة — le point-virgule, la majuscule à « Veuillez » — تُقرأ كدليل la rigueur.","منهجية العمل في ثلاث خطوات: أولاً اكتب la phrase de la demande وحدها على ورقة — إن لم تُفهم فعلاً، فالرسالة كلها ستُقرأ مرتين. ثانياً اكتب عرض الوقائع في ثلاث جمل: le contexte, le fait, la conséquence. ثالثاً اختر la formule de politesse المناسبة لدرجة la hiérarchie: « Je vous prie d’agréer, Madame la Directrice, l’expression de mes salutations distinguées. »","أكثر أخطاء المتعلّمين تكراراً: الترجمة الحرفية (« Je vous demande de me donner » بدل « Je vous saurais gré de bien vouloir »)، واختصار la formule de politesse إلى « Merci, Cordialement » في سياق إداري، واستعمال le tutoiement مع la fonction. التمرين الختامي: خذ رسالة يومية قصيرة وأعِد كتابتها ببنية إدارية كاملة، ثم قارن la longueur des phrases قبل التصحيح وبعده."],"sub":[{"h":"la structure de la lettre","p":["L’en-tête indique l’expéditeur et le destinataire.","L’objet de la demande figure sur une ligne distincte.","La formule d’appel ouvre le corps du texte."]},{"h":"les formules administratives","p":["Il est rappelé que le dossier est incomplet.","Nous vous prions de bien vouloir nous transmettre les pièces.","Veuillez trouver ci-joint le formulaire complété."]},{"h":"le ton juste","p":["La demande s’exprime au conditionnel de politesse.","L’impersonnel protège la distance institutionnelle.","La formule de politesse s’adapte à la hiérarchie."]}]},{"h":"les formules de la lettre administrative","p":["« Il est rappelé que… » — le rappel à une obligation déjà connue des deux parties.","« Nous vous serions reconnaissants de bien vouloir… » — la demande formelle, la plus courtoise.","« Je vous prie d’agréer, Madame la Directrice, l’expression de mes salutations distinguées. » — la clôture hiérarchique complète.","« Pourriez-vous m’indiquer si… ? » — la question administrative, polie sans être familière."]},{"h":"التطبيق والتلخيص","p":["تمرين la structure: انسخ بنية le courrier administratif من الذاكرة — المرسِل، المرسَل إليه، التاريخ، المرجع، الموضوع، الصيغة، ثم تحقّق من رسالتك الأخيرة إن كانت تحمل هذه العناصر كلها.","تمرين la demande: حوّل طلباً مباشراً (« Donnez-moi mon relevé ») إلى صيغة إدارية كاملة في ثلاث جمل مستعملة « Je vous saurais gré de » و« Dans l’attente de… ».","تمرين la tonalité: اقرأ رسالتك بصوت عالٍ وأشطب كل كلمة تُعبّر عن la subjectivité (« très », « vraiment », « je suis sûr ») واستبدلها بصيغة impersonnelle."]}],"pron":[{"w":"la formule de politesse","ipa":"[la fɔʁmyl də pɔ.li.tɛs]","approx":"لا فورميل دُ بوليسيس"},{"w":"le destinataire","ipa":"[lə dɛs.ti.na.tɛʁ]","approx":"لُ دَستيناتير"},{"w":"l’expéditeur","ipa":"[lɛk.spe.di.tœʁ]","approx":"لانكسبيديتير"}],"vocab":[{"fr":"le courrier administratif","ar":"المراسلة الإدارية","pos":"nom","g":"m","exFr":"Le courrier administratif suit une structure fixe.","ipa":"[ku.ʁɛ a.dmɪ.ni.stʁa.tif]","exAr":"المراسلة الإدارية تتبع بنية ثابتة."},{"fr":"l’objet","ar":"موضوع الرسالة (سطر المُوضوع)","pos":"nom","g":"m","exFr":"L’objet doit tenir en une ligne.","ipa":"[lɔ.ʒɛ]","exAr":"يجب أن يختصر الموضوع في سطر واحد."},{"fr":"la formule d’appel","ar":"صيغة المخاطبة الافتتاحية","pos":"nom","g":"f","exFr":"La formule d’appel s’adapte au destinataire.","ipa":"[la fɔʁmyl da.pɛl]","exAr":"صيغة المخاطبة تتكيّف مع المرسَل إليه."},{"fr":"le destinataire","ar":"المرسَل إليه","pos":"nom","g":"m","exFr":"Le destinataire est une institution, pas une personne.","ipa":"[dɛs.ti.na.tɛʁ]","exAr":"المرسَل إليه مؤسسة لا فرد."},{"fr":"l’expéditeur","ar":"المُرسِل","pos":"nom","g":"m","exFr":"L’expéditeur indique ses coordonnées.","ipa":"[ɛk.spe.di.tœʁ]","exAr":"يُذكر المُرسِل بيانات الاتصال الخاصة به."},{"fr":"la référence","ar":"الرقم المرجعي","pos":"nom","g":"f","exFr":"La référence figure en haut à droite.","ipa":"[ʁe.fʁɑ̃s]","exAr":"يظهر الرقم المرجعي أعلى اليمين."},{"fr":"ci-joint","ar":"المرفق (مُلحق)","pos":"loc.","g":"m","exFr":"Vous trouverez ci-joint le formulaire.","ipa":"[si.ʒwɛ̃]","exAr":"تجدون مرفقاً الاستمارة."},{"fr":"solliciter","ar":"يَطلب رسمياً / يَلتمس","pos":"verbe","g":"","exFr":"Je vous sollicite afin d’obtenir un délai.","ipa":"[sɔ.li.si.te]","exAr":"أطلب منكم من أجل الحصول على مهلة."},{"fr":"rappeler (il est rappelé que)","ar":"يُذكِّر (يُذكَر أنّ)","pos":"verbe","g":"","exFr":"Il est rappelé que les délais sont fermes.","ipa":"[ʁa.pə.le]","exAr":"يُذكَر أنّ الآجال نهائية."},{"fr":"en l’espèce","ar":"في هذا الخصوص / في المقام الحالي","pos":"loc.","g":"","exFr":"En l’espèce, la pièce manque à l’instruction.","ipa":"[ɑ̃ lɛs.pɛs]","exAr":"في هذا الخصوص تنقص الوثيقة من الدراسة."},{"fr":"sous réserve de","ar":"تحتفظاً بـ / مشروطاً بـ","pos":"loc.","g":"","exFr":"Nous acceptons sous réserve de pièces complémentaires.","ipa":"[su ʁɛzɛʁv də]","exAr":"نقبل مع الاحتفاظ بوثائق إضافية."},{"fr":"bien vouloir","ar":"تَكرَّم بـ (صيغة رسمية)","pos":"loc.","g":"","exFr":"Je vous prie de bien vouloir examiner ma demande.","ipa":"[bjɛ̃ vu.lwaʁ]","exAr":"أرجو تكرّمكم بفحص طلبي."}],"examples":[{"fr":"Il est rappelé que le dossier est incomplet.","ar":"يُذكَر أنّ الملف غير مكتمل.","note":"le rappel impersonnel"},{"fr":"Nous vous prions de bien vouloir transmettre les pièces.","ar":"نُرجو تكرّمكم بإرسال الوثائق.","note":"la demande formelle"},{"fr":"Je vous saurais gré de m’indiquer la marche à suivre.","ar":"سأكون ممتنّاً لو دلّتموني على الإجراء الواجب اتباعه.","note":"la politesse opérationnelle"},{"fr":"Cette demande a été enregistrée sous la référence 2024-1187.","ar":"سُجِّل هذا الطلب بالرقم المرجعي 2024-1187.","note":"la voix passive administrative"},{"fr":"Dans l’attente de votre retour, je vous prie d’agréer, Madame, l’expression de mes salutations distinguées.","ar":"وفي انتظار ردّكم، تفضّلوا بقبول، يا سيدتي، فائق عبارات التقدير المُخلصة.","note":"la clôture hiérarchique"},{"fr":"Il convient de joindre un justificatif de domicile.","ar":"يجب إرفاق إثبات محل الإقامة.","note":"la tournure impersonnelle"}],"grammar":[{"tFr":"Les tournures impersonnelles de l’administration","tAr":"الصيغ غير الشخصية في الكتابة الإدارية","body":["L’administration parle en son nom, jamais au nom d’un individu : « Il est rappelé que », « Il convient de », « Il est possible d’obtenir », « La demande a été enregistrée ». Le sujet grammatical devient la procédure elle-même, ce qui retire à l’écrivain toute responsabilité personnelle et donne à la phrase son autorité.","Ces tournures se combinent avec la voix passive pour effacer l’agent : « les pièces ont été transmises » au lieu de « nous avons transmis les pièces ». Pour garder la clarté, alternez : deux phrases impersonnelles puis une phrase active à sujet collectif (« le service examinera votre dossier ») — la variété évite la lourdeur."],"ex":[{"fr":"Il convient de faire parvenir les documents avant le 15 mai.","ar":"يجب إرسال الوثائق قبل 15 ماي."},{"fr":"Votre dossier a été transmis au service compétent.","ar":"حُوِّل ملفكم إلى المصلحة المختصة."}]},{"tFr":"La demande au conditionnel de politesse","tAr":"الطلب بصيغة شرطية المُهذَّبة","body":["En français formel, l’impératif et le présent de la certitude cèdent la place au conditionnel : « Je souhaiterais », « Je pourrais », « Serait-il possible de… », « Nous serions reconnaissants de… ». Le conditionnel ne marque pas l’incertitude ici, il marque le respect : on présente la demande comme une éventualité que l’autre reste libre d’accepter.","Attention à la hiérarchie des registres : « Donne-moi » (familier), « Donnez-moi » (direct), « Pourriez-vous me faire parvenir » (courant), « Nous vous saurions gré de bien vouloir nous faire parvenir » (soutenu administratif). Plus le destinataire est élevé, plus la demande s’éloigne de l’ordre."],"ex":[{"fr":"Je souhaiterais obtenir une copie de mon relevé de notes.","ar":"أتمنّى الحصول على نسخة من كشف النقاط."},{"fr":"Serait-il possible de reporter l’échéance au 30 juin ?","ar":"هل من الممكن تأجيل الأجل إلى 30 يونيو؟"}]}],"mistakes":[{"wrong":"traduire « أريد أن » par « Je veux que » dans une lettre officielle","right":"employer « Je souhaiterais » ou « Je me permets de demander »","why":"« Je veux » exprime l’ordre : elle casse le ton institutionnel — « Je veux » تُصدر أمراً وتكسر الطابع المؤسساتي."},{"wrong":"« Merci, Cordialement » en fin de courrier administratif","right":"« Je vous prie d’agréer, Madame, l’expression de mes salutations distinguées »","why":"la clôture doit correspondre au degré de formalité de l’objet — الخاتمة يجب أن توازي درجة رسمية الموضوع."},{"wrong":"commencer par « Je vous écris parce que j’ai un problème »","right":"annoncer l’objet : « J’ai l’honneur de solliciter… » ou « Par la présente, je demande… »","why":"le lecteur administratif cherche l’objet avant le récit — القارئ الإداري يبحث عن الموضوع قبل السرد."},{"wrong":"mélanger tutoiement et vouvoiement dans la même lettre","right":"vouvoiement constant, y compris dans la formule de politesse","why":"la fluctuation se lit comme un manque de maîtrise du registre — التذبذب يُقرأ كعدم إتقان للسجل."}],"dialogues":[{"title":"Déposer une demande à la mairie","ctx":"مودِع يستفسر من موظفة البلدية عن نقص في ملفه","lines":[{"who":"Hélène","fr":"Bonjour Madame, je dépose une demande de permis de construire.","ar":"صباح الخير يا سيدتي، أنزل طلباً لرخصة بناء."},{"who":"l’agent","fr":"Je vous remercie. Il manque le justificatif de propriété.","ar":"أشكركِ. ينقص إثبات الملكية."},{"who":"Hélène","fr":"Je vous prie de bien vouloir m’indiquer la marche à suivre.","ar":"أرجو تكرّمكِ بتدبيري على الإجراء الواجب اتباعه."},{"who":"l’agent","fr":"Présentez-le avant le 15 mai, sous réserve de pièces complémentaires.","ar":"قدّميه قبل 15 ماي، مع الاحتفاظ بوثائق إضافية."}]},{"title":"Relire un courrier avant l’envoi","ctx":"زميلان يراجعان رسالة إدارية قبل الإرسال","lines":[{"who":"Sofiane","fr":"Ta lettre commence par « Je veux mon relevé ».","ar":"رسالتك تبدأ بـ « أريد كشفي »."},{"who":"Claire","fr":"Tu as raison, je passe à « Je souhaiterais obtenir… ».","ar":"معك حق، سأنتقل إلى « أتمنّى الحصول على… »."},{"who":"Sofiane","fr":"Et la référence figure-t-elle après l’objet ?","ar":"وهل الرقم المرجعي يلي سطر الموضوع؟"},{"who":"Claire","fr":"Oui, et j’allonge la formule de politesse finale.","ar":"نعم، وسأُطيل صيغة التحية الختامية."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما المقصود بـ « l’objet » في رسالة إدارية؟","opts":["سطر المُوضوع المختصر أعلى الرسالة","تاريخ الإرسال","اسم الموظّف الموقِّع","المرفقات المرحّلة"],"a":0,"why":"l’objet est la ligne qui résume la demande : elle se lit avant le corps du texte."},{"t":"fill","skill":"grammar","q":"أكمل الصيغة الرسمية: «___ trouverez ci-joint le formulaire.»","fr":"___ trouverez ci-joint le formulaire.","ans":"Vous","why":"la formule administrative s’adresse toujours au destinataire avec « vous »."},{"t":"order","skill":"writing","q":"رتّب: أرجو تكرّمكم بإرسال الوثائق قبل نهاية الشهر","words":["Nous","vous","prions","de","bien","vouloir","transmettre","les","pièces."],"ans":"Nous vous prions de bien vouloir transmettre les pièces.","why":"construction fixe : prions de + bien vouloir + infinitif."},{"t":"listen","skill":"listening","q":"ما المقصود بـ « Il est rappelé que »؟","opts":["يُذكَر أنّ (تذكير بواجب قائم)","نَعِدكم بأنّ","نحن نَنكر أنّ","يُرسَل إلى"],"a":0,"why":"rappeler = التذكير بالمعنى الإداري: إعادة التنبيه إلى قاعدة أو واجب معروف."},{"t":"translate","skill":"writing","q":"ترجم: «أتمنّى الحصول على نسخة من كشف النقاط.»","ans":"Je souhaiterais obtenir une copie de mon relevé de notes.","why":"le conditionnel « souhaiterais » remplace « je veux » dans le registre administratif."},{"t":"speaking","skill":"speaking","q":"اطلب من إدارة جامعية تمديد أجل التسجيل في ثلاث جمل رسمية.","target":"Je souhaiterais / Il convient de / Dans l’attente de","why":"إنتاج لغوي في le registre soutenu : demande + justification + clôture."},{"t":"correct","skill":"grammar","q":"صحّح الجملة: «Donne-moi votre relevé, merci.» (رسالة إدارية)","ans":"Je vous prie de bien vouloir me faire parvenir mon relevé.","why":"l’impératif familier cède la place à la demande au conditionnel de politesse."},{"t":"writing","skill":"writing","q":"اكتب فقرة من أربع جمل تطلب فيها إعادة بطاقة مفقودة، مستعملاً l’objet وla formule d’appel وla formule de politesse.","target":"l’objet / formule d’appel / je souhaiterais / salutations distinguées","why":"بناء الرسالة من الصفر هو المِهمّة الحاسمة في le courrier administratif."}],"homework":"خُذ رسالة تقرير أو طلب أرسلتها سابقاً، أعِد كتابتها ببنية إدارية كاملة (en-tête, objet, corps, formule de politesse) في 120 كلمة، وعلّل اختيارك لكل صيغة في هامش قصير.","sources":[{"title":"10 Expressions pour une Lettre Administrative en français ✉","channel":"Parlez-vous FRENCH : Cours de français","videoId":"ClR45qfouKg","why":"عشر صيغ إدارية جاهزة — « Il est rappelé que », « Nous vous prions de », « Veuillez trouver ci-joint » — تشرح كيف تُبنى le ton الرسمية داخل le courrier administratif دون أن تبدو الجملة مُترجمة.","cat":"Style","level":"C1","main":true},{"title":"DELF B2 - Production écrite - Comment écrire une lettre formelle ?","channel":"Aliança Francesa Brasil","videoId":"4X1RpWqm5ZI","why":"شرح البنية الكاملة للرسالة الرسمية خطوة بخطوة: l’en-tête, l’objet, le paragraphe de la demande — مكمل مباشر لهذا الدرس.","cat":"Style","level":"C1","extra":true},{"title":"La forme de la lettre formelle #delf #dalf #delfb1","channel":"français avec Marine","videoId":"QHmT3OJq7tM","why":"مراجعة سريعة للشكل الخارجي وle corps de lettre: أين يوضع التاريخ، وكيف تُوزَّع الفقرات بصرياً.","cat":"Style","level":"C1","extra":true}],"supplements":[{"id":"4X1RpWqm5ZI","title":"DELF B2 - Production écrite - Comment écrire une lettre formelle ?","channel":"Aliança Francesa Brasil","why":"شرح البنية الكاملة للرسالة الرسمية خطوة بخطوة: l’en-tête, l’objet, le paragraphe de la demande — مكمل مباشر لهذا الدرس.","lang":"fr","dur":4},{"id":"QHmT3OJq7tM","title":"La forme de la lettre formelle #delf #dalf #delfb1","channel":"français avec Marine","why":"مراجعة سريعة للشكل الخارجي وle corps de lettre: أين يوضع التاريخ، وكيف تُوزَّع الفقرات بصرياً.","lang":"fr","dur":1}]},{"id":"c1-t3-l2","fr":"Le discours académique","ar":"الخطاب الأكاديمي","objectives":["بناء مقدّمة أكاديمية في أربع خطوات: l’accroche, le contexte, la problématique, l’annonce du plan","صياغة problématique مُحكمة: سؤال مغلق الصياغة مفتوح الجواب","الانتقال بين الأفكار بـ les transitions signées وتفادي « et puis » و« ensuite » المُفردة","توظيف la ponctuation oratoire: le point-virgule, les deux-points et les tirets لضبط إيقاع الجملة"],"sections":[{"h":"الدرس 1: كيف تفتح بحثاً بـ la problématique لا بتعريف عام","video":{"id":"dRK60qH5ons","title":"Comment rédiger une intro parfaite en dissertation ? 💯 🔥","channel":"Les Sherpas - Étudiants","why":"تفكيك مُفصَّل لمقدّمة الديسكور: l’accroche ثم le contexte ثم la problématique ثم l’annonce du plan، مع أمثلة مكتوبة على الشاشة تُظهر كيف يتحوّل العنوان العام إلى سؤال أكاديمي مُحكم.","lang":"fr","main":true,"dur":19},"p":["الخطاب الأكاديمي ليس لهجة مختلفة عن الفرنسية اليومية، بل له la syntaxe propre: كل جملة تؤدي وظيفة محدّدة في le raisonnement. la dissertation الفرنسية والcommentaire composé يشتركان في القاعدة نفسها: المقدّمة ليست مقدّمة للكتابة بل مقدّمة للتفكير، ولذلك يُختبر فيها le niveau C1 أكثر من أي موضع آخر.","المقدّمة المثلى أربع خطوات: l’accroche (اقتباس أو مبدأ عام)، le contexte (إطار الموضوع)، la problématique (السؤال الذي يُوجّه البحث)، ثم l’annonce du plan (ثلاث نقاط في جملة واحدة). الخطأ الشائع أن يبدأ الطالب بالتعريف القاموسي — « Le travail est… » — فيفقد le lecteur قبل أن يصل إلى السؤال.","la problématique هي محور الدرس: صيغة مثل « En quoi… ? », « Dans quelle mesure… ? », « Comment expliquer que… ? » تُحوّل الموضوع إلى توتر. قاعدة الاختبار: إن أمكن الإجابة بنعم أو لا، فالسؤال أضعف من أن يُبنى عليه بحث؛ والسؤال الجيّد يفرض la démonstration لا la réponse.","الانتقال (la transition) جملة واحدة تؤدي ثلاث وظائف: تُعيد نتيجة الفقرة السابقة، تكشف حدّها، ثم تفتح الفقرة التالية. لذلك تبدأ عادة بـ « Toutefois », « En revanche », « Par ailleurs », « Si cela ne fait aucun doute que…, il n’en demeure pas moins que… ». تجنّب « Et après… » و« De plus » المُستعملة خمس مرات في نفس الفقرة.","la ponctuation oratoire ليست علامة نحوية بل آلة إيقاع: le point-virgule يصل جملتين مترابطتين من دون أن تُفصلان، les deux-points يُعلن ما بعده (« une seule conclusion : agir »)، et les tirets يُدخلان حاشية داخل الجملة كالمؤسسة نفسها. الفصل بـ le point يُقطع la pensée، والفاصلة الواحدة تُنتج جملة متوترة تُقرأ بصوت مرتفع.","منهجية التمرين: خُذ فقرة من مقال علمي واعيد كتابتها ثلاث مرات — الأولى بـ le présent simple، الثانية مع le passé composé وأفعال القول، الثالثة مع la ponctuation أوسع. ثم اقرأ النص بصوت عالٍ: إن لم تتغيّر le rythme، فالتعديل لم يمسّ le style. أخيراً، لخّص كل فقرة في connecteur واحد فقط."],"sub":[{"h":"l’accroche et la problématique","p":["Tout d’abord, il convient de préciser le cadre de la question.","En quoi la forme reflète-t-elle le fond ?","Ce choix ouvre donc une interrogation de méthode."]},{"h":"les transitions de l’argumentation","p":["Toutefois, cette lecture ne rend pas compte de tout.","En revanche, le second exemple infirme la règle.","Par ailleurs, une autre piste mérite d’être examinée."]},{"h":"la ponctuation oratoire","p":["Le point-virgule relie deux idées sans les séparer.","Les deux-points annoncent la conséquence.","Les tirets isolent l’incident de la phrase principale."]}]},{"h":"les connecteurs de la dissertation","p":["« En quoi cette distinction éclaire-t-elle le débat ? » — la problématique typique.","« Toutefois, cette analyse se heurte à une limite. » — la transition qui ouvre une objection.","« Il convient dès lors de revenir à la définition initiale. » — la reprise méthodologique.","« Autrement dit, la méthode conditionne le résultat. » — la reformulation qui conclut."]},{"h":"التطبيق والتلخيص","p":["تمرين l’introduction: اكتب مقدّمة من أربع جمل لموضوع تختاره — الجملة الرابعة يجب أن تكون problématique سؤالية لا تعريفية.","تمرين la transition: خُذ فقرتين متتاليتين من مقال واكتب بينهما جملة انتقال واحدة تؤدي ثلاث وظائف: نتيجة، حدّ، فتح.","تمرين la ponctuation: أعد كتابة جملة طويلة من 30 كلمة باستعمال point-virgule وdeux-points معاً، ثم اقرأها بصوت عالٍ وراقب le rythme."]}],"pron":[{"w":"la problématique","ipa":"[la pʁɔ.ble.ma.tik]","approx":"لا بروبلوماتيك"},{"w":"l’annonce du plan","ipa":"[lɑ̃.nɔs dy plɑ̃]","approx":"لانُّونس دُ بلان"},{"w":"le point-virgule","ipa":"[lə pwɛ̃.viʁ.kyl]","approx":"لُ بوان-فيركول"}],"vocab":[{"fr":"la problématique","ar":"الإشكالية (السؤال المحوري)","pos":"nom","g":"f","exFr":"La problématique gouverne tout le commentaire.","ipa":"[pʁɔ.ble.ma.tik]","exAr":"الإشكالية تُحكم التعليق كلّه."},{"fr":"l’accroche","ar":"الافتتاحية الجاذبة","pos":"nom","g":"f","exFr":"Une accroche cite un auteur ou un fait.","ipa":"[a.kʁɔʃ]","exAr":"الافتتاحية تقتبس كاتباً أو واقعة."},{"fr":"l’annonce du plan","ar":"إعلان الخطة","pos":"nom","g":"f","exFr":"L’annonce du plan énumère trois parties.","ipa":"[lɑ̃.nɔs dy plɑ̃]","exAr":"إعلان الخطة يعدّد ثلاثة أجزاء."},{"fr":"la transition","ar":"العبارة الرابطة (الانتقال)","pos":"nom","g":"f","exFr":"La transition relie la thèse à l’antithèse.","ipa":"[tʁɑ̃.zi.sjɔ̃]","exAr":"العبارة الرابطة تصل الأطروحة بالمضادّة."},{"fr":"le point-virgule","ar":"الفاصلة المنقوطة","pos":"nom","g":"m","exFr":"Le point-virgule sépare sans rompre.","ipa":"[pwɛ̃.viʁ.kyl]","exAr":"الفواصل المنقوطة تفصل دون قطع."},{"fr":"le fil conducteur","ar":"الخيط المنهجي","pos":"nom","g":"m","exFr":"Un fil conducteur traverse les trois parties.","ipa":"[fil kɔ̃.dyk.tœʁ]","exAr":"خيط منهجي يسري عبر الأجزاء الثلاثة."},{"fr":"énoncer","ar":"يُصاغ ويُبرز","pos":"verbe","g":"","exFr":"Énoncez la question avant de la traiter.","ipa":"[e.nɔ̃.se]","exAr":"اصُغ السؤال قبل معالجته."},{"fr":"nuancer","ar":"يُلِين ويُنقِّح","pos":"verbe","g":"","exFr":"Il faut nuancer cette affirmation trop nette.","ipa":"[ny.ɑ̃.se]","exAr":"يجب تليين هذا التأكيد الصارخ."},{"fr":"soutenir une thèse","ar":"يدعم أطروحة","pos":"loc.","g":"f","exFr":"Il soutient sa thèse par trois exemples.","ipa":"[sut.niʁ ən tɛz]","exAr":"يدعم أطروحته بثلاثة أمثلة."},{"fr":"toutefois","ar":"ومع ذلك","pos":"adv","g":"","exFr":"Toutefois, l’exception demeure.","ipa":"[tu.tə.fwa]","exAr":"ومع ذلك يبقى الاستثناء."},{"fr":"dès lors","ar":"من إذن / ومنه","pos":"loc.","g":"","exFr":"Dès lors, la conclusion s’impose.","ipa":"[dɛ lɔʁ]","exAr":"ومنه يترتّب الاستنتاج."},{"fr":"en définitive","ar":"في نهاية المطاف","pos":"loc.","g":"","exFr":"En définitive, la méthode l’emporte.","ipa":"[ɑ̃ de.fi.ni.tif]","exAr":"في نهاية المطاف تنتصر المنهجية."}],"examples":[{"fr":"En quoi la distinction de Durkheim éclaire-t-elle le débat ?","ar":"أيّ خدمة يقدم تمييز دوركيم للنقاش؟","note":"la problématique en « en quoi »"},{"fr":"Toutefois, cette lecture ne rend pas compte du cas particulier.","ar":"غير أنّ هذه القراءة لا تفسّر الحالة الخاصة.","note":"la transition d’objection"},{"fr":"Il convient dès lors de revenir à la définition.","ar":"ومنه يجب العودة إلى التعريف.","note":"la reprise méthodologique"},{"fr":"Le point-virgule relie deux propositions d’une même portée.","ar":"الفواصل المنقوطة تصل بيتين لهما من الوظيفة الواحدة.","note":"la ponctuation de la pensée"},{"fr":"Autrement dit, la méthode conditionne le résultat.","ar":"بعبارة أخرى، المنهجية هي شرط النتيجة.","note":"la reformulation conclusive"},{"fr":"Trois questions se posent : le cadre, la méthode, l’enjeu.","ar":"تطرح ثلاثة أسئلة: الإطار، المنهجية، الأثر.","note":"les deux-points annonciateurs"}],"grammar":[{"tFr":"La construction de la problématique : en quoi, dans quelle mesure, comment expliquer que","tAr":"بناء الإشكالية بصيغ السؤال الأكاديمي","body":["La problématique n’est pas un résumé du sujet, c’est une tension : elle oppose deux logiques et demande une démonstration. Les formules consacrées sont « En quoi… ? » (relation de causalité), « Dans quelle mesure… ? » (degré), « Comment expliquer que… ? » (paradoxe), « Jusqu’où… ? » (limite). Chacune engage un plan différent : en quoi = thèse/antithèse, comment expliquer que = hypothèses.","La question doit être nommée, non posée en style interrogatif direct : « On s’interroge sur les conditions de… » ou « Reste à savoir si… ». Évitez les questions fermées (« Le travail est-il utile ? ») : elles se répondent par oui ou non et tuent la recherche. Test final : pouvez-vous imaginer deux réponses contradictoires possibles ? Sinon, reformulez."],"ex":[{"fr":"En quoi la forme administrative façonne-t-elle la demande ?","ar":"أيّ تشكيل تمارسه الصيغة الإدارية على الطلب؟"},{"fr":"Comment expliquer que cette règle ait survécu à ses critiques ?","ar":"كيف نفسّر بقاء هذه القاعدة على الرغم من نقدِها؟"}]},{"tFr":"La ponctuation oratoire : point-virgule, deux-points, tirets","tAr":"الترقيم الخطابي: الفاصلة المنقوطة، النقطتان، الشرطتان","body":["Le point-virgule unit deux propositions indépendantes qui se présupposent : « La méthode est exigeante ; elle paie » — il dit : les deux vont ensemble. Les deux-points annoncent et résument : « une seule chose compte : la précision ». Les tirets isolent une incise qui commente sans interrompre : « la thèse — enfin assumée — tient en une phrase ».","Le rythme de la dissertation française alterne : phrase longue (développement), phrase courte (conclusion de paragraphe), point-virgule (liaison). Trop de points produit un effet télégraphique ; aucun produit une prose lourde. Règle pratique : une phrase sur trois se termine par un point-virgule ou une virgule détachée, jamais trois de suite."],"ex":[{"fr":"Le sujet est connu ; la méthode l’est moins.","ar":"الموضوع معلوم؛ أما المنهجية فأقلّ وضوحاً."},{"fr":"Trois conditions s’imposent : la clarté, la concision, la preuve.","ar":"تفرض ثلاثة شروط: الوضوح، الاختصار، البرهان."}]}],"mistakes":[{"wrong":"ouvrir la dissertation par « Depuis la nuit des temps… »","right":"ouvrir par un fait, une citation ou une définition précise","why":"l’accroche vide se repère immédiatement et décrédibilise l’introduction — الافتتاح الفارغ يُكتشف فوراً ويُفقد المقدمة مصداقيتها."},{"wrong":"poser la problématique comme une question fermée","right":"poser une question qui exige une démonstration en deux temps","why":"« oui ou non » n’appelle aucune analyse — السؤال المغلق لا يستدعي تحليل."},{"wrong":"utiliser « et puis » ou « ensuite » à chaque paragraphe","right":"alterner toutefois, en revanche, par ailleurs, dès lors","why":"la variété des connecteurs est le signe visible de la structuration — تنويع الروابط دليلٌ مرئي على التنظيم."},{"wrong":"écrire trois phrases sans aucune ponctuation interne","right":"marquer le rythme par le point-virgule et les deux-points","why":"la ponctuation porte le sens autant que les mots — الترقيم يحمل المعنى بقدر الكلمات."}],"dialogues":[{"title":"Formuler une problématique","ctx":"أستاذ يوجّه طالبة قبل كتابة مقدّمة التعليق","lines":[{"who":"Professeur","fr":"Quelle est ta question, en une seule phrase ?","ar":"ما سؤالك في جملة واحدة؟"},{"who":"Inès","fr":"Je demande si le narrateur est fiable.","ar":"أسأل إن كان الراوي موثوقاً."},{"who":"Professeur","fr":"Trop fermé : rédigera « Dans quelle mesure… ».","ar":"مُغلق أكثر من اللازم: صُغيه بصيغة « إلى أي حدّ… »."},{"who":"Inès","fr":"D’accord : dans quelle mesure la voix cache-t-elle ?","ar":"حسناً: إلى أي حدّ يخفي الصوتُ نفسَه؟"}]},{"title":"Soigner une transition","ctx":"زميلان يراجعان مسودة انتقال بين فقرتين","lines":[{"who":"Antoine","fr":"Ta transition commence par « Et après on voit que ».","ar":"عبارة رابطتك تبدأ بـ « وبعدها نرى أنّ »."},{"who":"Leïla","fr":"Je la remplace par « Toutefois, cette lecture a une limite ».","ar":"سأستبدلها بـ « غير أنّ لهذه القراءة حدّاً »."},{"who":"Antoine","fr":"Elle résume bien, mais ouvre-t-elle la suite ?","ar":"تُلخّص جيداً، لكن هل تفتح ما بعدها؟"},{"who":"Leïla","fr":"Oui : « ce qui conduit à examiner le cas contraire ».","ar":"نعم: « وهو ما يقود إلى فحص الحالة المعاكسة »."}]}],"exercises":[{"t":"mcq","skill":"writing","q":"أي عبارة تصلح لـ la problématique؟","opts":["En quoi la méthode conditionne-t-elle le résultat ?","Le travail est très important.","Je vais parler du travail.","Voici mon plan en trois parties."],"a":0,"why":"seule la question « en quoi » exige une démonstration : les autres constatent ou annoncent."},{"t":"fill","skill":"grammar","q":"أكمل الانتقال: «___, cette analyse se heurte à une limite.»","fr":"___, cette analyse se heurte à une limite.","ans":"Toutefois","why":"toutefois marque la concession et prépare l’objection dans le registre soutenu."},{"t":"order","skill":"writing","q":"رتّب: تطرح ثلاثة أسئلة: الإطار، المنهجية، الحدّ","words":["Trois","questions","se","posent",":","le","cadre,","la","méthode,","l’enjeu."],"ans":"Trois questions se posent : le cadre, la méthode, l’enjeu.","why":"les deux-points précèdent l’énumération, la virgule sépare les termes."},{"t":"listen","skill":"listening","q":"ما وظيفة le point-virgule في « La méthode est exigeante ; elle paie »؟","opts":["يربط جملتين مترابطتين دون فصل","ينهي الجملة نهائياً","يُعلن عن سرد أسماء","يفصل حاشية عن الجملة"],"a":0,"why":"le point-virgule lie deux propositions qui se présupposent l’une l’autre."},{"t":"translate","skill":"writing","q":"ترجم: «غير أنّ هذه القراءة لا تفسّر الحالة الخاصة.»","ans":"Toutefois, cette lecture ne rend pas compte du cas particulier.","why":"toutefois + rendre compte de = la concession formelle typique du commentaire."},{"t":"speaking","skill":"speaking","q":"صُغ problématique لسؤال «التكنولوجيا تُغيّر التعليم» في جملة واحدة أكاديمية.","target":"En quoi / Dans quelle mesure / comment expliquer que","why":"تحويل موضوع عام إلى توتر بحثي هو مهارة la problématique."},{"t":"correct","skill":"grammar","q":"صحّح: «Et puis, on voit que la thèse est vraie, donc c’est prouvé.»","ans":"Toutefois, la thèse se trouve confirmée : la démonstration est donc recevable.","why":"« et puis / donc c’est prouvé » relève du registre oral ; l’écrit académique exige connecteur + justification."},{"t":"writing","skill":"writing","q":"اكتب مقدّمة من أربع جمل (accroche, contexte, problématique, annonce du plan) لموضوع تختاره.","target":"accroche / contexte / problématique / annonce du plan","why":"la structure en quatre temps est la grille d’évaluation de toute introduction universitaire."}],"homework":"اكتب مقدّمة كاملة من 100 كلمة لتعليق مُركَّب على نص أدبي، مع وضع علامات le point-virgule وles deux-points في مواضع مقصودة، ثم شاركها مع زميل واطلب منه تلوين la problématique بلون مختلف.","sources":[{"title":"Comment rédiger une intro parfaite en dissertation ? 💯 🔥","channel":"Les Sherpas - Étudiants","videoId":"dRK60qH5ons","why":"تفكيك مُفصَّل لمقدّمة الديسكور: l’accroche ثم le contexte ثم la problématique ثم l’annonce du plan، مع أمثلة مكتوبة على الشاشة تُظهر كيف يتحوّل العنوان العام إلى سؤال أكاديمي مُحكم.","cat":"Style","level":"C1","main":true},{"title":"[BAC] Commentaire de Texte (1/3) : l’INTRODUCTION","channel":"Un Cours de 5 Minutes","videoId":"c_NnRtx7xIE","why":"شرح مُركَّز لخطوات مقدّمة التعليق المُركَّب: l’amorce, la présentation, la problématique — يكمّل ما عرضه الدرس الرئيسي.","cat":"Style","level":"C1","extra":true},{"title":"Trouver une bonne problématique et un plan détaillé de commentaire composé","channel":"La Boîte à Bac","videoId":"N_nDZrOX9wI","why":"تدريب مُعمَّق على صياغة la problématique وبناء le plan détaillé: أين يسقط الطالب ولماذا ينجح الآخر.","cat":"Style","level":"C1","extra":true}],"supplements":[{"id":"c_NnRtx7xIE","title":"[BAC] Commentaire de Texte (1/3) : l’INTRODUCTION","channel":"Un Cours de 5 Minutes","why":"شرح مُركَّز لخطوات مقدّمة التعليق المُركَّب: l’amorce, la présentation, la problématique — يكمّل ما عرضه الدرس الرئيسي.","lang":"fr","dur":6},{"id":"N_nDZrOX9wI","title":"Trouver une bonne problématique et un plan détaillé de commentaire composé","channel":"La Boîte à Bac","why":"تدريب مُعمَّق على صياغة la problématique وبناء le plan détaillé: أين يسقط الطالب ولماذا ينجح الآخر.","lang":"fr","dur":13}]},{"id":"c1-t3-l3","fr":"La réécriture soutenue","ar":"إعادة الصياغة الفصيحة","objectives":["رصد علامات le registre familier: l’élision, les mots d’appui, l’argot, les interjections","التحويل المعجمي: استبدال les mots familiers بمرادفات soutenue دون تغيير المعنى","التحويل الصياغي: la nominalisation, la subordonnée, l’impersonnel وحذف les mots d’appui","إنتاج ثلاث نسخ من نص واحد: familier, courant, soutenu مع إدراك le destinataire في كل نسخة"],"sections":[{"h":"الدرس 1: كيف تحوّل جملة عامية إلى جملة فصيحة في ثلاث خطوات","video":{"id":"jyzPOxnApH0","title":"Parler un bon français - LE LANGAGE SOUTENU ! (4 astuces)","channel":"Le français by Alex","why":"أربع حِيَل عملية لرفع اللغة إلى le registre soutenu: تبديل les mots courants، تجنب les anglicismes، توسيع la phrase، وضبط le ton — تُعرض بمقارنة مباشرة بين نسخة عامية ونسخة فصيحة من الجملة نفسها.","lang":"fr","main":true,"dur":12},"p":["la réécriture ليست ترجمة ولا تجميل: هي نقل نص من مستوى إلى آخر بحسب le destinataire. القاعدة الحاكمة أن le registre يُنتَقى لا يُكتسب مرة واحدة: نفس الفكرة تُقال لصديق بـ « Je suis crevé »، ولزميل بـ « Je suis très fatigué »، ولمدير بـ « Je me vois contraint de reporter ».","الخطوة الأولى معجمية: استبدل le vocabulaire familier بمرادف معياري — boulot → travail, se barrer → partir, nul → médiocre, super → excellent, cher → onéreux, vachement → considérablement. لاحظ أنّ le registre soutenu لا يزيد الكثافة بل يزيد la précision: « cher » عمومي، و« onéreux » يُستعمل في le contexte financier.","الخطوة الثانية صياغية: احذف les mots d’appui والصفات اللفظية (« genre », « quand même », « franchement », « hein ») وأعد بناء الجملة بـ la structure complète: « J’sais pas, ça marche pas » → « Je ne sais pas si la procédure fonctionne ». ثم استعمل l’élision المُمنوعة كتابةً: le, la, les devant voyelle تُكتب كاملة في le registre soutenu.","الخطوة الثالثة نحوية تحويلية: la nominalisation تختصر الجملة وتُكسبها la densité académique — « Le gouvernement a décidé de réformer… » → « La réforme gouvernementale vise… ». وtournures مثل « Il convient de », « Il est permis de », « force est de constater » تُثبّت la distance المطلوبة.","الحذف قاعدة رابعة: le registre soutenu لا يحذف le sens بل يحذف le bruit: les répétitions (« C’est ça que je dis »)، les pléonasmes (« monter en haut »)، les tics (« tu vois ce que je veux dire »). اقرأ النص بصوت عالٍ؛ كل كلمة لا تُغيّر le sens إن حُذفت، فحذفها واجب.","منهجية la triple réécriture: اكتب الجملة كما تقولها شفوياً (familier)، ثم احذف le bruit فتصبح courant، ثم أعِد بناءها بالnominalisation والimpersonnel فتصبح soutenu. علّل كل تحويل في هامش واحد — إن لم تستطع التعليل، فالتحويل عشوائي. التمرين الختامي: خُذ فقرة من رسالة إلكترونية عامية وأعِد كتابتها لِـ la direction."],"sub":[{"h":"les mots à remplacer","p":["« Boulot » devient « travail » à l’écrit.","« Vachement bon » devient « remarquablement bon ».","Le vocabulaire précis remplace l’intensité familière."]},{"h":"reconstruire la phrase","p":["« J’sais pas » s’écrit « je ne sais pas ».","Les mots d’appui disparaissent du texte soutenu.","La subordonnée donne à la phrase sa profondeur."]},{"h":"nominaliser pour condenser","p":["« Le gouvernement a décidé de réformer » → « la réforme a été décidée ».","L’impersonnel retire le locuteur de la scène.","La densité augmente, la longueur diminue."]}]},{"h":"les bascules de registre","p":["« Je suis crevé. » → « Je me vois contraint de reporter. » — du familier au soutenu professionnel.","« C’est nul. » → « Cette solution ne présente aucun intérêt. » — le jugement devient analyse.","« Il faut qu’on s’arrange. » → « Il convient de trouver un arrangement. » — l’impersonnel prend la place de « on ».","« J’ai pas le temps. » → « Je ne suis pas en mesure de m’y consacrer. » — la négation devient tournure protocolaire."]},{"h":"التطبيق والتلخيص","p":["تمرين la triple version: اختر جملة قلتها اليوم شفوياً واكتبها ثلاث نسخ — familier, courant, soutenu — وعلّل كل استبدال في كلمة واحدة.","تمرين le repérage: أشرِ إلى كل mots d’appui وtic de langage في فقرة من إيميل أو رسالة واتساب ثم احذفها واقرأ النص ثانية.","تمرين la nominalisation: حوّل ثلاث جمل فعلية (« Le directeur a approuvé… ») إلى جمل nominalisée في 10 كلمات لكل واحدة."]}],"pron":[{"w":"la nominalisation","ipa":"[la nɔ.mi.na.li.za.sjɔ̃]","approx":"لا نوميناليساسيون"},{"w":"le registre soutenu","ipa":"[lə ʁə.ʒistʁ su.tə.ny]","approx":"لُ روجيستْر سوتيني"},{"w":"le mot d’appui","ipa":"[lə mo da.pɥi]","approx":"لُ مودابيّ"}],"vocab":[{"fr":"le registre soutenu","ar":"السجلّ الفصيح (المرتفع)","pos":"nom","g":"m","exFr":"Ce courrier relève du registre soutenu.","ipa":"[ʁə.ʒistʁ su.tə.ny]","exAr":"هذه الرسالة من السجلّ الفصيح."},{"fr":"le registre familier","ar":"السجلّ العامي (المُتدنى)","pos":"nom","g":"m","exFr":"Le registre familier convient à l’oral entre amis.","ipa":"[ʁə.ʒistʁ fa.mi.lje]","exAr":"السجلّ العامي يصلح للشفهي بين الأصدقاء."},{"fr":"le mot d’appui","ar":"كلمة الارتكاز (الكلمة الحشوية)","pos":"nom","g":"m","exFr":"Supprimez les mots d’appui comme « genre ».","ipa":"[mo da.pɥi]","exAr":"احذفوا كلمات الارتكاز مثل « genre »."},{"fr":"l’élision","ar":"حذف الحرف (القصر الكتابي)","pos":"nom","g":"f","exFr":"L’élision « j’sais pas » est proscrite à l’écrit.","ipa":"[e.li.zjɔ̃]","exAr":"قصر « j’sais pas » ممنوع كتابةً."},{"fr":"la nominalisation","ar":"التاسيم (تحويل الفعل إلى اسم)","pos":"nom","g":"f","exFr":"La nominalisation condense la proposition.","ipa":"[nɔ.mi.na.li.za.sjɔ̃]","exAr":"التاسيم يُكثِّف الجملة."},{"fr":"la reformulation","ar":"إعادة الصياغة","pos":"nom","g":"f","exFr":"La reformulation évite la répétition.","ipa":"[ʁe.fɔʁ.my.la.sjɔ̃]","exAr":"إعادة الصياغة تمنع التكرار."},{"fr":"atténuer","ar":"يُليِّن ويُخفِّف","pos":"verbe","g":"","exFr":"Il faut atténuer le ton de cette critique.","ipa":"[a.te.ny.e]","exAr":"يجب تليين نبرة هذا النقد."},{"fr":"relever le niveau","ar":"يرفع المستوى اللغوي","pos":"loc.","g":"","exFr":"Un verbe précis relève le niveau du texte.","ipa":"[ʁə.ləvə lə nɥivo]","exAr":"الفعل الدقيق يرفع مستوى النص."},{"fr":"privilégier","ar":"يُفضِّل ويَعتمد","pos":"verbe","g":"","exFr":"Je privilégie une tournure impersonnelle.","ipa":"[pʁi.vi.le.ʒje]","exAr":"أُفضّل الصيغة غير الشخصية."},{"fr":"proscrire","ar":"يمنع ويُحظر","pos":"verbe","g":"","exFr":"L’écrit formel proscrit l’argot.","ipa":"[pʁɔs.kʁiʁ]","exAr":"الكتابة الرسمية تُحظر العامية."},{"fr":"la tournure","ar":"الصيغة (التركيب اللفظي)","pos":"nom","g":"f","exFr":"Cette tournure reste polie sans être lourde.","ipa":"[tuʁ.nyʁ]","exAr":"هذه الصيغة تبقى مُهذّبة دون ثِقَل."},{"fr":"contraindre (se voir contraint de)","ar":"يُضطرّ إلى (صيغة رسمية)","pos":"verbe","g":"","exFr":"Je me vois contraint de décliner votre offre.","ipa":"[kɔ̃.tʁɛ̃dʁ]","exAr":"أُضطرّ إلى رفض عرضكم."}],"examples":[{"fr":"Je suis crevé → je me vois contraint de reporter.","ar":"أنا منهك ← أُضطرّ إلى التأجيل.","note":"familier → soutenu professionnel"},{"fr":"C’est nul → cette solution ne présente aucun intérêt.","ar":"هذا فاشل ← هذا الحل لا يقدّم أيّ قيمة.","note":"le jugement devient analyse"},{"fr":"J’ai pas le temps → je ne suis pas en mesure de…","ar":"ليس لديّ وقت ← لا أتسنّى لي…","note":"tournure protocolaire"},{"fr":"Le directeur a approuvé le projet → l’approbation du projet a été prononcée.","ar":"وافق المدير على المشروع ← أُعلن الموافقة على المشروع.","note":"la nominalisation + la voix passive"},{"fr":"On s’arrange demain → il convient de trouver un arrangement.","ar":"نتفاهم غداً ← يجب إيجاد تسوية.","note":"« on » cède la place à l’impersonnel"},{"fr":"Le rapport est super complet → le rapport est exhaustif.","ar":"التقرير ممتاز وكامل ← التقرير شامل.","note":"l’intensité familière cède à la précision"}],"grammar":[{"tFr":"La nominalisation : le marqueur le plus sûr du registre soutenu","tAr":"التاسيم: الدليل الأوضح على السجلّ الفصيح","body":["Passer du verbe au nom change la perspective de la phrase : « Le gouvernement décide de réformer » (quelqu’un agit) devient « La réforme gouvernementale a été décidée » (le fait compte). La nominalisation supprime le sujet agent, autorise la voix passive, et fait gagner de 20 à 30 % de mots pour la même information — c’est le moteur de la densité académique.","On la construit à partir du verbe ou de l’adjectif : décider → la décision, examiner → l’examen, capable → la capacité, stable → la stabilité. Attention au style creux : trois noms de suite sans verbe produisent une phrase morte. Règle : alterner une phrase nominalisée et une phrase à sujet clair."],"ex":[{"fr":"L’examen du dossier a révélé une anomalie.","ar":"كشف فحص الملف عن خلل."},{"fr":"La stabilité des prix garantit la prévisibilité.","ar":"ثبات الأسعار يضمن إمكانية التنبّؤ."}]},{"tFr":"La suppression des mots d’appui et la négation soutenue","tAr":"حذف كلمات الارتكاز والنفيّ الفصيح","body":["Le registre familier surcharge la phrase d’appuis : « bah », « genre », « quand même », « tu vois ». Le soutenu les écarte et recourt à la négation complète et aux adverbes de mesure : ne… pas, ne… plus, ne… guère, ne… point (soutenu marqué, fréquent dans le protocole). « Je ne pense guère que ce soit possible » dit exactement « je ne crois pas » avec plus de distance.","La deuxième suppression concerne les répétitions d’information : « monter en haut », « redescendre à nouveau ». Enfin, le tutoiement fait place au vouvoiement, et l’interjection disparaît : « Ah bon ! » devient « Je prends bonne note. » Le critère pratique : le texte doit pouvoir être lu devant un supérieur sans aucune note de bas de page."],"ex":[{"fr":"Je ne saurais vous donner une réponse avant lundi.","ar":"لا أستطيع إعطاؤكم جواباً قبل الاثنين."},{"fr":"Cette hypothèse ne convient guère au contexte.","ar":"هذا الافتراض لا يلائم السياق إلّا محدوداً."}]}],"mistakes":[{"wrong":"mêler lexique soutenu et syntaxe familière : « On doit partir, je me vois contraint de partir »","right":"tenir le même registre du début à la fin de la phrase","why":"le registre se juge à la cohérence, pas à un mot isolé — السجلّ يُحكم بالتّساقط لا بكلمة مفردة."},{"wrong":"traduire le superlatif familier « vachement » par « vachement » avec des guillemets","right":"employer « considérablement », « particulièrement »","why":"le soutenu remplace l’intensité par la mesure — الفصيح يستبدل التشدّد بالقياس."},{"wrong":"croire que plus la phrase est longue, plus elle est soutenue","right":"condenser par la nominalisation et supprimer le bruit","why":"la densité prime sur la longueur : trois noms justes valent mieux qu’une périphrase — الكثافة تسبق الطول."},{"wrong":"« Je ne pense pas que ce ne soit pas possible »","right":"« Je ne pense guère que ce soit possible »","why":"le double négatif confond la pensée : le soutenu n’accumule pas les négations — تراكم النفي يُربك المعنى."}],"dialogues":[{"title":"Réécrire un message pour la direction","ctx":"موظّف يعرض على زميلته إعادة صياغة رسالة قصيرة","lines":[{"who":"Yasmine","fr":"Mon message dit : « Je peux pas venir, je suis crevé ».","ar":"رسالتي تقول: « لا أستطيع المجيء، أنا منهك »."},{"who":"Rémi","fr":"Pour la direction : « Je me vois contraint de reporter ma venue ».","ar":"بالنسبة للإدارة: « أُضطرّ إلى تأجيل قدومي »."},{"who":"Yasmine","fr":"Et pour l’objet du mail ?","ar":"وماذا عن موضوع الرسالة؟"},{"who":"Rémi","fr":"« Report de la réunion du jeudi » : nominalise l’objet.","ar":"« تأجيل اجتماع الخميس »: اجعلي الموضوع مُاسَماً."}]},{"title":"Corriger un mélange de registres","ctx":"مُصحِّح لغوي يعلّق على مسودة تقرير","lines":[{"who":"Mme Ferrand","fr":"« Le projet est génial et ça marche super bien ».","ar":"« المشروع رائع ويعمل بشكل ممتاز جداً »."},{"who":"Karim","fr":"Je remplace par « le projet donne des résultats satisfaisants ».","ar":"أستبدلها بـ « يحقّق المشروع نتائج مُرضية »."},{"who":"Mme Ferrand","fr":"Attention à ne pas alourdir la phrase.","ar":"انتبه ألا تُثقِل الجملة."},{"who":"Karim","fr":"D’accord, je condense par une nominalisation.","ar":"حسناً، سأكثّف باستعمال التاسيم."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"أي كلمة تُناسب le registre soutenu بدل « cher »؟","opts":["onéreux","boréal","bruyant","horsain"],"a":0,"why":"onéreux désigne précisément ce qui coûte cher dans le langage administratif."},{"t":"fill","skill":"grammar","q":"أكمل النفيّ الفصيح: «Je ne ___ guère que ce soit possible.»","fr":"Je ne ___ guère que ce soit possible.","ans":"pense","why":"ne… guère est une négation soutenue qui exprime la restriction avec distance."},{"t":"order","skill":"writing","q":"رتّب: يجب إيجاد تسوية قبل نهاية الأسبوع","words":["Il","convient","de","trouver","un","arrangement","avant","la","fin","de","semaine."],"ans":"Il convient de trouver un arrangement avant la fin de semaine.","why":"structure impersonnelle soutenue : il convient de + infinitif."},{"t":"listen","skill":"listening","q":"ما المقصود بـ « les mots d’appui »؟","opts":["كلمات حشو لا تضيف معنى","أفعال مُساعِدة","كلمات الربط","أسماء العائلة"],"a":0,"why":"mots d’appui = éléments comme « genre », « bah » qui soutiennent le flux sans sens."},{"t":"translate","skill":"writing","q":"ترجم: «لا أستطيع إعطاؤكم جواباً قبل الاثنين.»","ans":"Je ne saurais vous donner une réponse avant lundi.","why":"« ne saurais » = tournure soutenue de « ne pas pouvoir »."},{"t":"speaking","skill":"speaking","q":"أعِد صياغة « Je suis crevé, on s’arrange demain » لِـ la direction في جملتين.","target":"je me vois contraint de / il convient de","why":"التحول من le registre familier إلى le soutenu أمام le destinataire الرسمي."},{"t":"correct","skill":"grammar","q":"صحّح الخلط: «Le directeur a décidé que ça marche pas.»","ans":"Le directeur a constaté que la procédure ne fonctionne pas.","why":"le lexique soutenu exige aussi une syntaxe complète et une négation écrite en entier."},{"t":"writing","skill":"writing","q":"أعِد كتابة هذه الفقرة العامية بـ le registre soutenu (خمس جمل): « Le boulot est nul, on gagne pas assez, et franchement je casse. »","target":"travail / rémunération insuffisante / je me vois contraint","why":"la réécriture intégrale entraîne le lexique, la syntaxe et le ton à la fois."}],"homework":"خُذ خمس جمل قلتها أمس شفوياً واكتبها ثلاث نسخ لكل واحدة (familier, courant, soutenu)، ثم اجمع النسخ الفصيحة في فقرة متماسكة من ثمانية أسطر لِـ la direction.","sources":[{"title":"Parler un bon français - LE LANGAGE SOUTENU ! (4 astuces)","channel":"Le français by Alex","videoId":"jyzPOxnApH0","why":"أربع حِيَل عملية لرفع اللغة إلى le registre soutenu: تبديل les mots courants، تجنب les anglicismes، توسيع la phrase، وضبط le ton — تُعرض بمقارنة مباشرة بين نسخة عامية ونسخة فصيحة من الجملة نفسها.","cat":"Style","level":"C1","main":true},{"title":"Exemples de registre de langage en français (familier, courant et soutenu)","channel":"aprende francés con Profjerome","videoId":"UmfyK8Qf_vs","why":"مقارنة مباشرة بأمثلة على les trois registres: كيف تتغيّر نفس الفكرة بين المستويات الثلاثة.","cat":"Style","level":"C1","extra":true},{"title":"6 MOTS SOUTENUS À UTILISER TOUS LES JOURS (avec définitions et exemples clairs)","channel":"La Verve et la Plume","videoId":"5kCTum1Oxuw","why":"ستّ كلمات فصيحة بديلاً عن الكلمات اليومية المتكرّرة — التحويل المعجمي الذي يبني le vocabulaire de la réécriture.","cat":"Style","level":"C1","extra":true}],"supplements":[{"id":"UmfyK8Qf_vs","title":"Exemples de registre de langage en français (familier, courant et soutenu)","channel":"aprende francés con Profjerome","why":"مقارنة مباشرة بأمثلة على les trois registres: كيف تتغيّر نفس الفكرة بين المستويات الثلاثة.","lang":"fr","dur":1},{"id":"5kCTum1Oxuw","title":"6 MOTS SOUTENUS À UTILISER TOUS LES JOURS (avec définitions et exemples clairs)","channel":"La Verve et la Plume","why":"ستّ كلمات فصيحة بديلاً عن الكلمات اليومية المتكرّرة — التحويل المعجمي الذي يبني le vocabulaire de la réécriture.","lang":"fr","dur":3}]},{"id":"c1-t3-l4","fr":"Politesse et formules institutionnelles","ar":"المُهذَّبيات وصيغ المؤسّسات","objectives":["اختيار la formule d’appel بحسب le titre والوظيفة: « Monsieur le Directeur », « Madame la Secrétaire générale »","حفظ سلّم les formules de politesse من الأقصر إلى الأطول بحسب la hiérarchie","تطبيق les conventions الكتابية: l’objet, les formules de rappel, la date, la signature الكاملة","تجنّب أخطاء le savoir-être écrit: le tutoiement, الغموض في la demande, والمخاطبة بلا سياق"],"sections":[{"h":"الدرس 1: كيف تختار la formule المناسبة لمستوى المسؤول الذي تكتب إليه","video":{"id":"UpqzASmDgw0","title":"les formules d’appel et formules de politesse","channel":"Saleh kiwi","why":"عرض مُرتَّب لـ les formules d’appel (Madame, Monsieur, Mesdames et Messieurs) وles formules de politesse المرتبطة بها، مع شرح لمن يُوجَّه كل صيغة في le contexte institutionnel.","lang":"fr","main":true,"dur":5},"p":["la politesse في الكتابة الفرنسية المؤسساتية ليست تُطِقاً بل معلومة: la formule d’appel تُخبر القارئ أنّك تعرف موقعه في la hiérarchie، وla formule de politesse تُخبره أنّك تعرف قواعد la relation. رسالة تبدأ بـ « Salut » وتنتهي بـ « Cordialement » تُقرأ كخطأٍ في le jugement قبل أن تُقرأ كخطأ في la langue.","سلّم les formules d’appel واضح: « Madame la Directrice » (المرأة في منصب)، « Monsieur le Maire » (الرجل في منصب)، « Mesdames, Messieurs » (الإدارة دون وجه معيّن)، « Madame, Monsieur » (الصيغة الآمنة عند الشكّ). وقبل le titre يأتي le prénom courteous: « Madame la Directrice » لا « Directrice »، و« Monsieur le Professeur » لا « Professeur ».","سلّم les formules de politesse ثلاث درجات: la formule courte (« Cordialement ») للمراسلة اليومية بين زملاء؛ la formule standard (« Veuillez agréer, Monsieur, mes salutations distinguées ») للإدارة والعملاء؛ la formule protocolaire (« Je vous prie d’agréer, Madame la Ministre, l’expression de ma considération distinguée ») للمراتب العليا. الخطأ الأشيع هو la formule طويلة مع le destinataire المُتواضع.","les conventions ثابتة: l’objet في سطر مستقل ومختصر، la référence عند الحاجة، la formule d’appel بعد سطر فارغ، le corps مقسّم إلى فقرات، la formule de politesse مفصولة بموقف واحد عن le corps، ثم la signature كاملة الاسم والوظيفة. في le mail الحديث يُستبدل l’objet بـ « Objet : » صريح ولا يُحذف أبداً.","le savoir-être écrit هو la couche التي لا تظهر في la grammaire: هل ذكرت le contexte الذي يجعل الرسالة مفهومة؟ هل طلبت بشكل يترك للطرف الآخر la possibilité de refuser؟ هل حافظت على la même personne (« je » الموحّد) طوال النص؟ الرسالة الجيّدة تُقرأ وتُفهم من الجملة الأولى دون سؤال مُكمِّل.","تمرين الاختبار الآخير: اطبع رسالتك، اقرأ أول جملة وآخر جملة فقط، ثم اسأل: هل le lecteur يعرفني؟ هل يعرف ماذا أريد؟ هل يعرف بماذا يُجيب؟ إن كانت إحدى الثلاثة « لا »، فالرسالة ناقصة مهما كانت الصيغ فصيحة. le savoir-être هنا أن تضع نفسك مكان القارئ قبل أن ترسل."],"sub":[{"h":"choisir la formule d’appel","p":["Madame la Directrice, Monsieur le Maire : le titre suit le prénom.","Mesdames, Messieurs vaut pour l’institution sans nom.","À défaut de titre, « Madame, Monsieur » reste sans risque."]},{"h":"graduer la formule de politesse","p":["« Cordialement » convient aux échanges entre collaborateurs.","« Veuillez agréer… mes salutations distinguées » ouvre la distance.","La formule protocolaire s’adresse au sommet de la hiérarchie."]},{"h":"les conventions de l’écrit","p":["L’objet tient en une ligne.","La signature reproduit le nom complet et la fonction.","Le vouvoiement ne varie jamais dans le même message."]}]},{"h":"les formules d’appel et de politesse","p":["« Madame la Directrice, » — le titre complet, jamais le seul nom de fonction.","« Je me permets de vous écrire au sujet de… » — l’ouverture qui justifie la prise de contact.","« Je vous saurais gré de bien vouloir… » — la demande graduée, polie sans fausse familiarité.","« Dans l’attente de votre retour, je vous prie d’agréer, Monsieur, l’expression de mes salutations distinguées. » — la clôture standard."]},{"h":"التطبيق والتلخيص","p":["تمرين le choix: اكتب ثلاثة عناوين لثلاثة مراسَلين (directeur, service, ministre) واختر لكل واحد la formule d’appel المناسبة مع التعليل في هامش.","تمرين la gradation: خُذ جملة واحدة (« Envoyez-moi le rapport ») واكتبها بثلاث صيغ: cordialement, distinguées, protocolaire.","تمرين le savoir-être: راجع إيميل أرسلته وتحقّق من ثلاث نقاط: le contexte المذكور، la possibilité de refuser المتروكة، والتوقيع الكامل."]}],"pron":[{"w":"la formule d’appel","ipa":"[la fɔʁmyl da.pɛl]","approx":"لا فورميل دابيل"},{"w":"les salutations distinguées","ipa":"[le sa.ly.ta.sjɔ̃ dis.ti.ɡe]","approx":"لي سالوتاسيون ديسْتيني"},{"w":"le protocole","ipa":"[lə pʁɔ.tɔ.kɔl]","approx":"لُ بروتوكول"}],"vocab":[{"fr":"la formule d’appel","ar":"صيغة المخاطبة الافتتاحية","pos":"nom","g":"f","exFr":"La formule d’appel précède le corps du texte.","ipa":"[fɔʁmyl da.pɛl]","exAr":"صيغة المخاطبة تسبق متن الرسالة."},{"fr":"la formule de politesse","ar":"صيغة التَّحِيّة الختامية","pos":"nom","g":"f","exFr":"La formule de politesse varie selon la hiérarchie.","ipa":"[fɔʁmyl də pɔ.li.tɛs]","exAr":"صيغة التحية تتغيّر بحسب الهرمية."},{"fr":"le titre","ar":"اللقب الوظيفي","pos":"nom","g":"m","exFr":"Le titre s’écrit après le prénom de politesse.","ipa":"[tityʁ]","exAr":"يُكتب اللقب الوظيفي بعد اسم التأدب."},{"fr":"le protocole","ar":"مراسم (البروتوكول)","pos":"nom","g":"m","exFr":"Le protocole impose la formule la plus longue.","ipa":"[pʁɔ.tɔ.kɔl]","exAr":"يفرض المراسم أطول صيغة."},{"fr":"accuser réception","ar":"يُبلِّغ باستلام (تأكيد الاستلام)","pos":"loc.","g":"f","exFr":"Je vous accuse réception de votre courrier.","ipa":"[a.ky.ze ʁəsɛpsjɔ̃]","exAr":"أُبلِّغكم باستلام مراسلتكم."},{"fr":"faire part de","ar":"يُشعِر بـ / يُبلِّغ عن","pos":"loc.","g":"","exFr":"Je vous fais part de ma décision.","ipa":"[fɛʁ paʁ də]","exAr":"أُبلِّغكم بقراري."},{"fr":"se permettre de","ar":"يتجرّأ على (صيغة تواضُع)","pos":"loc.","g":"","exFr":"Je me permets de solliciter votre aide.","ipa":"[sə pɛʁ.mɛʁt də]","exAr":"أتجرّأ على التماس مساعدتكم."},{"fr":"demeurer","ar":"يبقى","pos":"verbe","g":"","exFr":"Je demeure à votre disposition.","ipa":"[də.mø.ʁe]","exAr":"أبقى في خدمتكم."},{"fr":"le correspondant","ar":"المراسَل / الجهة المُقابلة","pos":"nom","g":"m","exFr":"Votre correspondant reste le même service.","ipa":"[kɔ.ʁɛs.pɔ̃.dɑ̃]","exAr":"يبقى مراسلكم المصلحة نفسها."},{"fr":"la hiérarchie","ar":"الهرمية (التسلسل الوظيفي)","pos":"nom","g":"f","exFr":"La hiérarchie détermine la longueur de la formule.","ipa":"[je.ʁaʁʃi]","exAr":"تحدد الهرمية طول الصيغة."},{"fr":"préciser","ar":"يُحدِّد ويُفصِّل","pos":"verbe","g":"","exFr":"Veuillez préciser l’objet de votre demande.","ipa":"[pʁe.si.ze]","exAr":"يُرجى تدقيق موضوع طلبكم."},{"fr":"le cas échéant","ar":"عند الاقتضاء","pos":"loc.","g":"","exFr":"Transmettez les pièces, le cas échéant.","ipa":"[lə ka ze.ʃeɑ̃]","exAr":"أرسِلوا الوثائق عند الاقتضاء."}],"examples":[{"fr":"Madame la Directrice, je me permets de vous écrire.","ar":"يا سيدتي المديرة، أتجرّأ على مراسلتكِ.","note":"la formule d’appel complète"},{"fr":"Mesdames, Messieurs, votre demande a été enregistrée.","ar":"سيّداتي وسيّدتي، سُجِّل طلبكم.","note":"l’appel institutionnel sans nom"},{"fr":"Je vous accuse réception du document.","ar":"أُبلِّغكم باستلام الوثيقة.","note":"la formule de rappel administrative"},{"fr":"Je vous prie d’agréer, Monsieur, l’expression de mes salutations distinguées.","ar":"تفضّلوا بقبول، يا سيدي، فائق عبارات التقدير المُخلصة.","note":"la clôture standard"},{"fr":"Cordialement, — entre collaborateurs d’un même service.","ar":"مع التحية، — بين زملاء المصلحة الواحدة.","note":"la formule courte"},{"fr":"Je demeure à votre disposition pour tout complément d’information.","ar":"أبقى في خدمتكم لأيّ معلومة إضافية.","note":"la formule de disponibilité"}],"grammar":[{"tFr":"La place et l’accord des titres dans la formule d’appel","tAr":"موضع الألقاب وتوافقها في صيغة المخاطبة","body":["Le titre de fonction suit le prénom de politesse et s’accorde : « Madame la Directrice », « Monsieur le Maire », « Madame la Secrétaire générale ». Le prénom de politesse (Madame / Monsieur) est toujours présent devant un titre porté par une personne ; sans titre, on écrit « Madame, Monsieur » ou « Mesdames, Messieurs » pour l’institution.","Deux pièges : l’article (on ne supprime pas « le » devant « Maire ») et l’accord (le titre féminin prend le féminin : « Madame la Ministre »). Dans la formule finale, le destinataire reparaît après la virgule : « …, Madame la Directrice, l’expression de… » — l’omission de ce second appel passe pour une maladresse de protocole."],"ex":[{"fr":"Madame la Directrice, je vous prie d’agréer…","ar":"يا سيدتي المديرة، أرجو قبول…"},{"fr":"Mesdames, Messieurs, veuillez trouver ci-joint…","ar":"سيّداتي وسيّدتي، يُرجى الاطلاع على المرفق…"}]},{"tFr":"Les trois degrés de la formule de politesse","tAr":"الثلاث درجات لصيغة التحية الختامية","body":["Degré 1, la formule courte : « Cordialement », « Bien à vous ». Elle suppose une relation installée et un destinataire de même niveau : l’usage contraire (« Cordialement » devant un recteur) se lit comme un manque d’égards.","Degré 2, la formule standard : « Je vous prie d’agréer, Madame, l’expression de mes salutations distinguées ». C’est la formule sûre de l’administration et de l’entreprise : elle convient à presque tous les cas et s’allonge au besoin (« distinguées » → « les plus distinguées » pour la marque du respect). Degré 3, le protocole : « la considération respectueuse », « l’assurance de ma considération très distinguée » — réservé aux hautes fonctions."],"ex":[{"fr":"Cordialement, après trois échanges dans la même semaine.","ar":"مع التحية، بعد ثلاث مراسلات في الأسبوع نفسه."},{"fr":"Je vous prie d’agréer, Monsieur le Maire, l’expression de mon dévouement respectueux.","ar":"تفضّلوا بقبول، يا سيدي العمدة، فائق عبارات التقدير المُخلص."}]}],"mistakes":[{"wrong":"« Salut, tu peux m’envoyer le dossier ? » à un supérieur","right":"« Bonjour Monsieur le Directeur, je vous saurais gré de bien vouloir… »","why":"le tutoiement saute une étape de la hiérarchie : il se justifie seulement si l’autre l’a proposé — التخاطب بالـ tu يتجاوز تسلسل الهرمية."},{"wrong":"écrire « Directrice, » sans « Madame la »","right":"écrire « Madame la Directrice, »","why":"le prénom de politesse et l’article obligent : le titre nu est une faute de protocole — اللقب وحده خلل في البروتوكول."},{"wrong":"terminer un mail à l’administration par « Merci »","right":"terminer par « Veuillez agréer… salutations distinguées »","why":"« Merci » reste une oralité de remerciement, non une formule de clôture — « Merci » شكرٌ شفهي لا خاتمة رسمية."},{"wrong":"faire varier tu / vous dans le même message","right":"tenir le vouvoiement d’un bout à l’autre","why":"la variation se lit comme un oubli, donc comme un manque de soin — التذبذب يُقرأ كإهمال."}],"dialogues":[{"title":"Choisir la bonne formule","ctx":"موظفان يقرران صيغة التحية في رسالة إلى رئيس بلدية","lines":[{"who":"Nadia","fr":"Je termine par « Cordialement » ?","ar":"أختم بـ « مع التحية »؟"},{"who":"Thomas","fr":"Non : « Je vous prie d’agréer, Monsieur le Maire, … ».","ar":"لا: « تفضّلوا بقبول، يا سيدي العمدة… »."},{"who":"Nadia","fr":"Et l’appel en tête du message ?","ar":"وماذا عن المخاطبة في أول الرسالة؟"},{"who":"Thomas","fr":"« Monsieur le Maire, » avec l’article, jamais le titre nu.","ar":"« يا سيدي العمدة، » مع أداة التعريف، لا اللقب وحده أبداً."}]},{"title":"Répondre à un usager","ctx":"موظفة استقبال تكتب جواباً رسمياً لطلب مستفيد","lines":[{"who":"Farida","fr":"L’usager réclame un délai supplémentaire.","ar":"يطلب المستفيد مهلة إضافية."},{"who":"Louis","fr":"Nous répondons « votre demande a été prise en compte ».","ar":"نجيب: « استُلم طلبكم وأُخذ بعين الاعتبار »."},{"who":"Farida","fr":"Il faut une formule d’appel adaptée à une personne physique.","ar":"نحتاج صيغة مخاطبة تلائم شخصاً طبيعياً."},{"who":"Louis","fr":"« Madame, Monsieur, » puis la clôture standard.","ar":"« سيدتي وسيدي، » ثم الخاتمة القياسية."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما الصيغة الصحيحة لرجل يشغل منصب العمدة؟","opts":["Monsieur le Maire","Monsieur Maire","Le Maire","Monsieur de Maire"],"a":0,"why":"le prénom de politesse + l’article + le titre : la triple règle du protocole."},{"t":"fill","skill":"grammar","q":"أكمل: «___ la Directrice, je vous prie d’agréer…»","fr":"___ la Directrice, je vous prie d’agréer…","ans":"Madame","why":"le titre féminin de fonction exige toujours « Madame » devant lui."},{"t":"order","skill":"writing","q":"رتّب: أرجو قبول، يا سيدي، فائق عبارات التقدير المُخلصة","words":["Je","vous","prie","d’agréer,","Monsieur,","l’expression","de","mes","salutations","distinguées."],"ans":"Je vous prie d’agréer, Monsieur, l’expression de mes salutations distinguées.","why":"le destinataire reparaît entre deux virgules dans la formule protocolaire."},{"t":"listen","skill":"listening","q":"ما « accuser réception »؟","opts":["يُبلِّغ باستلام الوثيقة","يطلب نسخة إضافية","يعترض على المحتوى","يؤجّل الجواب"],"a":0,"why":"accuser réception = annoncer officiellement que le courrier a été reçu."},{"t":"translate","skill":"writing","q":"ترجم: «أبقى في خدمتكم لأيّ معلومة إضافية.»","ans":"Je demeure à votre disposition pour tout complément d’information.","why":"« demeure à votre disposition » = la formule de disponibilité soutenue."},{"t":"speaking","skill":"speaking","q":"اشرح شفويًا الفرق بين « Cordialement » و« Salutations distinguées » ومَن يُوجَّه كلٌّ منهما.","target":"cordialement / salutations distinguées / hiérarchie","why":"le savoir-être écrit يبدأ من إدراك la gradation."},{"t":"correct","skill":"grammar","q":"صحّح: «Cher Directeur, je t’écris pour mon dossier.»","ans":"Monsieur le Directeur, je vous écris au sujet de mon dossier.","why":"le titre s’écrit avec prénom de politesse et article, et le vouvoiement remplace le tutoiement."},{"t":"writing","skill":"writing","q":"اكتب إيميلَ من ثماني جمل إلى رئيس قسم جامعي لطلب تمديد أجل، باستعمال la formule d’appel وla formule de politesse الكاملتين.","target":"Madame la / Je me permets de / Je vous saurais gré / salutations distinguées","why":"l’email institutionnel réunit la structure, la politesse et le ton dans un seul exercice."}],"homework":"اكتب رسالتين متساويتين في الطلب (تمديد أجل) — الأولى إلى زميل والثانية إلى رئيس قسم — وعلّل في هامش كل اختلاف في la formule d’appel وla formule de politesse والتوقيع.","sources":[{"title":"les formules d’appel et formules de politesse","channel":"Saleh kiwi","videoId":"UpqzASmDgw0","why":"عرض مُرتَّب لـ les formules d’appel (Madame, Monsieur, Mesdames et Messieurs) وles formules de politesse المرتبطة بها، مع شرح لمن يُوجَّه كل صيغة في le contexte institutionnel.","cat":"Style","level":"C1","main":true},{"title":"12 Expressions françaises pour communiquer au travail","channel":"Parlez-vous FRENCH : Cours de français","videoId":"YDJ7BmqtA3w","why":"اثنتا عشرة صيغة جاهزة للتواصل المهني: كيف تُطلب وتُرفض وتُؤجّل بلباقة داخل le cadre المؤسساتي.","cat":"Style","level":"C1","extra":true},{"title":"Email en FRANÇAIS - 30 formules pour prendre congé","channel":"French School TV","videoId":"B1Bo_p7c7wc","why":"ثلاثون صيغة لختم الرسالة والوداع الرسمي: خيارات كثيرة تساعدك على تدرّج la formule de politesse حسب le destinataire.","cat":"Style","level":"C1","extra":true}],"supplements":[{"id":"YDJ7BmqtA3w","title":"12 Expressions françaises pour communiquer au travail","channel":"Parlez-vous FRENCH : Cours de français","why":"اثنتا عشرة صيغة جاهزة للتواصل المهني: كيف تُطلب وتُرفض وتُؤجّل بلباقة داخل le cadre المؤسساتي.","lang":"fr","dur":9},{"id":"B1Bo_p7c7wc","title":"Email en FRANÇAIS - 30 formules pour prendre congé","channel":"French School TV","why":"ثلاثون صيغة لختم الرسالة والوداع الرسمي: خيارات كثيرة تساعدك على تدرّج la formule de politesse حسب le destinataire.","lang":"fr","dur":5}]},{"id":"c1-t3-l5","fr":"Syntaxe littéraire et emphase","ar":"الصياغة الأدبية والتوكيد البلاغي","objectives":["استعمال la périphrase للاستبدال الوصفي وتجنّب المباشرة المبتذلة","توظيف l’inversion وla mise en relief: « C’est… que », « Ce que… c’est… », « Quant à… »","بناء l’accumulation et la gradation لإنتاج la crescendo في la phrase argumentative","ضبط l’emphase: متى يزيد التوكيد الإقناع ومتى يتحوّل إلى المبالغة المُضحِكة"],"sections":[{"h":"الدرس 1: كيف تُزيح الجملة عن نمطها لتُبرز ما تريد","video":{"id":"U0Vm82ocdPo","title":"🎓 Les figures de style en français – Le cours complet + PDF à télécharger","channel":"Parlez-vous FRENCH : Cours de français","why":"دورة شاملة لـ les figures de style — la comparaison, la métaphore, la personnification, l’allégorie وغيرها — بأمثلة مكتوبة وتدرّج من البسيط إلى المركّب: خلفية لازمة قبل الانتقال إلى la syntaxe التوكيدية.","lang":"fr","main":true,"dur":25},"p":["la syntaxe الأدبية ليست قواعد جديدة بل قواعد معروفة مُستعملة في مواضع غير معتادة: le verbe avant le sujet، la expansion isolée par virgules، la subordonnée في le début. الفهرسة الفرنسية هرمية — الكلمة الأولى تُفتح لها la lecture والأخيرة تحمل la chute — ولذلك كل تغيير في le rang تغيير في le sens.","la périphrase هي استبدال الاسم بوصف يفرض التوقّف: « le médecin » ← « l’homme en blanc »، « Paris » ← « la capitale de la France »، « mourir » ← « quitter ce monde ». قاعدة la nécessité: لا تُستعمل la périphrase إلا إذا أضافت معنى (la nuance, l’euphémisme, l’ironie)؛ وإلا صارت pleonasme فاضحاً في le commentaire.","l’inversion تُقدّم le complément وتُؤجّل le sujet: « Vint le temps des récoltes », « Rarement on a vu un tel exemple ». في le registre littéraire تمنح la phrase la solennité؛ وفي l’interrogation القياسية (« Où vas-tu ? ») هي la grammaire لا la figure. المبدأ: inversion واحدة في السطر تكفي لإعادة le rythme.","la mise en relief هي أقوى أداة تركيبية في هذا الدرس: « C’est la méthode qui décide du résultat » (la phrase clivée)، « Ce que je conteste, c’est la généralisation » (la topicalisation)، « Quant à l’objection, elle reste valable » (le détachement en tête). la formule clivée تعزل la notion الظاهرة وتجعلها لا تُخطئ.","l’accumulation والgradation تبنيان la crescendo: « Il fallut du courage, de la patience, et surtout de la constance » — العناصر تتصاعد في le poids لا في le nombre فقط. la ponctuation تُحدث la coupe: la virgule تُفصل les termes, le point-virgule يفصل les groupes, et la chute تأتي بـ le groupe isolé avant le verbe.","l’effet rhétorique له قانون la parcimonie: أداة توكيد واحدة لكل فقرة. ثلاث mises en relief في فقرة واحدة تُنتج l’emphase المُبالغة التي تجعل le lecteur يُقلِّل من la thèse. تدريب الاختبار: اكتب نفس الجملة أربع مرات — عادية، بتوسّط وصفي، بجملة مُقسَمة، بتراكم — ثم اقرأها بصوت عالٍ واختر واحدة فقط."],"sub":[{"h":"la périphrase","p":["Le poète nomme la mer « l’abîme aux mille voix ».","La périphrase ajoute une nuance au nom simple.","Employée sans nécessité, elle alourdit la phrase."]},{"h":"inversion et mise en relief","p":["Rarement on a vu un tel exemple.","C’est la méthode qui décide du résultat.","Ce que je conteste, c’est la généralisation."]},{"h":"accumulation et rythme","p":["Il fallut du courage, de la patience, de la constance.","Les trois termes montent en puissance.","La virgule détache et la virgule accélère."]}]},{"h":"les figures de la mise en relief","p":["« C’est la méthode qui décide du résultat. » — la phrase clivée isole la notion mise en cause.","« Ce que je conteste, c’est la généralisation. » — le détachement du thème avant le commentaire.","« Quant à l’objection, elle reste valable. » — la topicalisation qui ouvre un contre-argument.","« Rarement on a vu un tel exemple. » — l’inversion d’emphase placée en tête de phrase."]},{"h":"التطبيق والتلخيص","p":["تمرين la périphrase: استبدل خمسة أسماء شائعة في نص قصير بـ les périphrases المناسبة، ثم احذف نصفها وراقب أين يزداد le texte قوة.","تمرين le clivage: حوّل ثلاث جمل عادية (« La méthode décide du résultat ») إلى la phrase clivée، ثم اكتب كل واحدة مرة ثانية بـ « Ce que… c’est… ».","تمرين l’accumulation: اكتب جملة واحدة بثلاث مصطلحات متراكمة تصاعدياً، وحدّد la ponctuation المستعملة في كل موضع."]}],"pron":[{"w":"la périphrase","ipa":"[la pe.ʁi.fʁaz]","approx":"لا بيريفريز"},{"w":"la mise en relief","ipa":"[la miz ɑ̃ ʁə.ljɛf]","approx":"لا ميز أن ريليف"},{"w":"l’accumulation","ipa":"[laky.my.la.sjɔ̃]","approx":"لاكيومولاسيون"}],"vocab":[{"fr":"la périphrase","ar":"التوسّط الوصفي (الإيراد)","pos":"nom","g":"f","exFr":"La périphrase remplace le nom par une image.","ipa":"[pe.ʁi.fʁaz]","exAr":"التوسّط الوصفي يُغني عن الاسم بصورة."},{"fr":"la mise en relief","ar":"التوكيد التركيبي (الإبراز)","pos":"nom","g":"f","exFr":"La mise en relief isole l’élément nouveau.","ipa":"[miz ɑ̃ ʁə.ljɛf]","exAr":"التوكيد التركيبي يعزل العنصر الجديد."},{"fr":"l’inversion","ar":"تقديم وتأخير (انقلاب الترتيب)","pos":"nom","g":"f","exFr":"L’inversion place le verbe avant le sujet.","ipa":"[ɛ̃.vɛʁ.zjɔ̃]","exAr":"الانقلاب يقدّم الفعل على الفاعل."},{"fr":"l’accumulation","ar":"التراكم البلاغي","pos":"nom","g":"f","exFr":"L’accumulation empile trois termes proches.","ipa":"[aky.my.la.sjɔ̃]","exAr":"التراكم البلاغي يُكدّس ثلاثة مصطلحات متقاربة."},{"fr":"la gradation","ar":"التصاعد (التدرّج)","pos":"nom","g":"f","exFr":"La gradation monte du faible au fort.","ipa":"[ɡʁa.da.sjɔ̃]","exAr":"التصاعد يرتقي من الضعيف إلى القوي."},{"fr":"le détachement","ar":"الاستغناء (الجملة المفصولة)","pos":"nom","g":"m","exFr":"Le détachement s’écrit entre virgules.","ipa":"[də.taʃ.mɑ̃]","exAr":"الاستغناء يُكتب بين فواصل."},{"fr":"la formule clivée","ar":"الجملة المُقسَمة (c’est… qui/que)","pos":"nom","g":"f","exFr":"La formule clivée met la cause en évidence.","ipa":"[fɔʁmy klive]","exAr":"الجملة المُقسَمة تُبرز السبب."},{"fr":"épicer","ar":"يُطيِّب ويُنكِّه الأسلوب","pos":"verbe","g":"","exFr":"Une image bien choisie épice la phrase.","ipa":"[e.pi.se]","exAr":"صورة محصورة تُطيّب الجملة."},{"fr":"appuyer (s’appuyer sur)","ar":"يَستند إلى / يُؤكِّد على","pos":"verbe","g":"","exFr":"L’auteur s’appuie sur trois exemples.","ipa":"[a.pɥi.je]","exAr":"يستند الكاتب إلى ثلاثة أمثلة."},{"fr":"isoler","ar":"يعزل ويُميِّز","pos":"verbe","g":"","exFr":"La virgule isole l’incident de la phrase.","ipa":"[i.zɔ.le]","exAr":"الفاصلة تعزل الحاشية عن الجملة."},{"fr":"le rythme","ar":"الإيقاع","pos":"nom","g":"m","exFr":"Le rythme varie avec la longueur des phrases.","ipa":"[ʁitm]","exAr":"يتغيّر الإيقاع بتباين طول الجمل."},{"fr":"la chute","ar":"الخاتمة المفاجئة (السقوط الإيقاعي)","pos":"nom","g":"f","exFr":"La chute arrive sur le dernier groupe.","ipa":"[ʃyt]","exAr":"تأتي الخاتمة على المقطع الأخير."}],"examples":[{"fr":"Rarement on a vu un tel exemple.","ar":"نادرًا ما رُئي مثل هذا المثال.","note":"l’inversion d’emphase en tête"},{"fr":"C’est la méthode qui décide du résultat.","ar":"المنهجية هي التي تقرّر النتيجة.","note":"la phrase clivée"},{"fr":"Ce que je conteste, c’est la généralisation.","ar":"ما أنكره هو التعميم.","note":"la topicalisation"},{"fr":"Il fallut du courage, de la patience, et surtout de la constance.","ar":"اتّجهت الحاجة إلى شجاعة وصبر، وأخيراً إلى مُثابرة.","note":"l’accumulation graduelle"},{"fr":"Quant à l’objection, elle reste valable.","ar":"أمّا الاعتراض فيبقى صالحاً.","note":"le détachement du thème"},{"fr":"L’homme en blanc posa le diagnostic.","ar":"وضع الرجل الأبيض التشخيص.","note":"la périphrase au service de l’euphémisme"}],"grammar":[{"tFr":"La mise en relief : c’est… que / qui, ce que… c’est, quant à","tAr":"التوكيد التركيبي: الجملة المُقسَمة والفصل التمهيدي","body":["La phrase clivée « C’est X qui/que… » extrait l’élément porteur : « C’est la méthode qui décide » (pas le hasard). « Que » remplace le COD, « qui » le sujet : « C’est le rapport que j’ai relu », « C’est elle qui a tranché ». Elle sert à corriger une méprise, à répondre avant même la question, à frapper la fin de paragraphe.","« Ce que X, c’est Y » inverse l’ordre de traitement : on expose d’abord le thème (« Ce que je conteste, »), puis le commentaire (« c’est la généralisation »). « Quant à… » fait de même en ouvrant un contre-argument. Les deux constructions exigent la virgule après le thème, et le couple « ce que… c’est » doit rester apparié : « Ce que je conteste, c’est… » jamais « Ce que je conteste, c’est que… que… »."],"ex":[{"fr":"C’est la clarté qui fait la valeur de ce texte.","ar":"الوضوح هو ما يمنح هذا النص قيمته."},{"fr":"Ce que je refuse, c’est la simplification abusive.","ar":"ما أرفضه هو التبسيط المُفرِط."}]},{"tFr":"L’accumulation, le détachement et la ponctuation de l’emphase","tAr":"التراكم والاستغناء وترقيم التوكيد","body":["L’accumulation réunit trois termes du même ordre ; la gradation les ordonne par force croissante : « utile, nécessaire, indispensable ». Elle se lit à voix haute : si les trois groupes ne gagnent pas en poids, il s’agit d’une simple énumération. La chute se prépare par les virgules : « Il vint, il vit, il vainquit ».","Le détachement isole une expansion entre virgules — épithète, complément circonstanciel, incise — et lui donne du relief par la seule position : « En pleine crise, la méthode tient. » Trop de virgules fragmentent la lecture ; la règle de la parcimonie vaut ici comme ailleurs : une expansion détachée par phrase, deux au maximum, jamais trois."],"ex":[{"fr":"Le rapport est clair, précis, et surtout actionable.","ar":"التقرير واضح ودقيق، وأهمّ من كل ذلك قابل للتنفيذ."},{"fr":"La direction, malgré les réserves, a validé le plan.","ar":"أيّدت الإدارة الخطة رغم التحفظات."}]}],"mistakes":[{"wrong":"accumuler trois mises en relief dans la même phrase","right":"une seule emphase par phrase, deux par paragraphe","why":"la multiplicité des reliefs annule le relief : le lecteur cesse d’écouter — تكاثف التوكيدات يُلغي التوكيد."},{"wrong":"employer la périphrase sans nuance nouvelle","right":"n’employer la périphrase que pour l’euphémisme, l’ironie ou la précision","why":"la périphrase vide se lit comme un remplissage — التوسّط بلا معنى جديد يُقرأ حشواً."},{"wrong":"« Ce que je pense, c’est que le problème est grave. »","right":"« Ce que je pense, c’est la gravité du problème. »","why":"le couple ce que… c’est s’achève en commentaire nominal, non en subordonnée lourde — الزوج ce que… c’est ينتهي بتعليق مُاسَم."},{"wrong":"inverser l’ordre de tous les mots pour paraître littéraire","right":"une inversion en tête de phrase, puis l’ordre usuel","why":"l’inversion généralisée produit une prose pénible à lire — الانقلاب المُفرِط يُنتج نثراً مُرهقاً."}],"dialogues":[{"title":"Choisir un effet, pas trois","ctx":"أستاذة تراجع فقرة تحريرية لطالب","lines":[{"who":"Professeure","fr":"Ta phrase accumule deux clivages et une périphrase.","ar":"جملتك ركّبت جملتين مُقسَمتين وتوسطاً وصفياً."},{"who":"Sami","fr":"Je voulais appuyer l’idée.","ar":"أردتُ توكيد الفكرة."},{"who":"Professeure","fr":"Garde le clivage, supprime les deux autres effets.","ar":"احتفظ بالجملة المُقسَمة واحذف الأثرين الآخرين."},{"who":"Sami","fr":"D’accord : une emphase par paragraphe.","ar":"حسناً: توكيد واحد لكل فقرة."}]},{"title":"Lire la phrase à voix haute","ctx":"ورشة كتابة يختبر فيها المشاركون إيقاع جملاتهم","lines":[{"who":"Claire","fr":"Relis ta phrase : la virgule coupe trop.","ar":"أعد قراءة جملتك: الفاصلة تقطع أكثر من اللازم."},{"who":"Yanis","fr":"Je supprime deux virgules et j’isole la chute.","ar":"سأحذف فاصلتين وأعزل الخاتمة."},{"who":"Claire","fr":"Maintenant l’accumulation monte correctement.","ar":"الآن يتصاعد التراكم كما ينبغي."},{"who":"Yanis","fr":"Et l’inversion reste en tête, seule.","ar":"وتبقى الانقلاب وحده في البداية."}]}],"exercises":[{"t":"mcq","skill":"analysis","q":"أيّ جملة تستعمل la périphrase بدل المباشرة؟","opts":["L’homme en blanc posa le diagnostic.","Le médecin posa le diagnostic.","Il posa le diagnostic hier.","Le diagnostic a été posé."],"a":0,"why":"« l’homme en blanc » remplace le nom par une description : c’est la périphrase."},{"t":"fill","skill":"grammar","q":"أكمل la phrase clivée: «___ la méthode qui décide du résultat.»","fr":"___ la méthode qui décide du résultat.","ans":"C’est","why":"la formule clivée s’ouvre toujours par « c’est » + élément mis en relief + « qui/que »."},{"t":"order","skill":"writing","q":"رتّب: نادراً ما رُئي مثل هذا المثال","words":["Rarement","on","a","vu","un","tel","exemple."],"ans":"Rarement on a vu un tel exemple.","why":"l’inversion d’emphase place l’adverbe en tête, puis l’ordre redevient normal."},{"t":"listen","skill":"listening","q":"ما وظيفة « Quant à… » في فقرة؟","opts":["تفتح عنصراً جديداً أو تُدخل اعتراضاً","تُنهي رسالة رسمية","تُعرب عن التفاؤل","تُعلن عن تاريخ"],"a":0,"why":"« Quant à… » détache le thème et prépare un commentaire ou un contre-argument."},{"t":"translate","skill":"writing","q":"ترجم: «ما أنكره هو التعميم.»","ans":"Ce que je conteste, c’est la généralisation.","why":"« ce que… c’est » = la topicalisation qui détache le thème avant le commentaire."},{"t":"speaking","skill":"speaking","q":"أعِد صياغة « Le résultat dépend de la méthode » بجملتين: clivée ثم بـ « Quant à… ».","target":"C’est la méthode… / Quant au résultat…","why":"إنتاج la mise en relief بطرقتين مختلفتين على المعنى نفسه."},{"t":"correct","skill":"grammar","q":"صحّح: «Ce que je conteste, c’est que la généralisation.»","ans":"Ce que je conteste, c’est la généralisation.","why":"le couple ce que… c’est s’achève par un commentaire nominal, non par une subordonnée incomplete."},{"t":"writing","skill":"writing","q":"اكتب فقرة من خمس جمل تدافع فيها عن رأي، مستعملاً périphrase واحدة، clivage واحداً، وaccumulation واحدة.","target":"périphrase / C’est… qui / accumulation","why":"الأثر البلاغي يُدرَّب بالتوزيع لا بالتكرار: أداة واحدة لكل فكرة."}],"homework":"خُذ فقرة كتبتها في درس سابق واكتبها ثلاث نسخ: الأولى عادية، الثانية بـ la phrase clivée والتوسّط الوصفي، الثالثة بـ l’accumulation. ثم اختر الأثر الأنسب ولخّل سبب اختيارك في ثلاثة أسطر.","sources":[{"title":"🎓 Les figures de style en français – Le cours complet + PDF à télécharger","channel":"Parlez-vous FRENCH : Cours de français","videoId":"U0Vm82ocdPo","why":"دورة شاملة لـ les figures de style — la comparaison, la métaphore, la personnification, l’allégorie وغيرها — بأمثلة مكتوبة وتدرّج من البسيط إلى المركّب: خلفية لازمة قبل الانتقال إلى la syntaxe التوكيدية.","cat":"Style","level":"C1","main":true},{"title":"Syntaxe : comment construire une longue phrase correcte","channel":"Cours de français et déclics littéraires","videoId":"UAMSfvH5F4A","why":"كيف تُبني جملة طويلة من دون أن تنكسر: les subordonnées, l’ordre des compléments وle rythme — الأساس النحوي لكل مؤثرات هذا الدرس.","cat":"Style","level":"C1","extra":true},{"title":"La mise en relief","channel":"Prof Youssef","videoId":"OIlHpEJ_4is","why":"شرح مُركَّز لـ la mise en relief: le clivage et la topicalisation بأمثلة قصيرة مباشرة تُثبّت القاعدة.","cat":"Style","level":"C1","extra":true}],"supplements":[{"id":"UAMSfvH5F4A","title":"Syntaxe : comment construire une longue phrase correcte","channel":"Cours de français et déclics littéraires","why":"كيف تُبني جملة طويلة من دون أن تنكسر: les subordonnées, l’ordre des compléments وle rythme — الأساس النحوي لكل مؤثرات هذا الدرس.","lang":"fr","dur":32},{"id":"OIlHpEJ_4is","title":"La mise en relief","channel":"Prof Youssef","why":"شرح مُركَّز لـ la mise en relief: le clivage et la topicalisation بأمثلة قصيرة مباشرة تُثبّت القاعدة.","lang":"fr","dur":1}]},{"id":"c1-t3-l6","fr":"Le résumé exécutif professionnel","ar":"الخلاصة التنفيذية المهنية","objectives":["ترتيب المعلومة بـ la pyramide inversée: la recommandation أولاً ثم les preuves","إجراء la reformulation لا le recopiage: تغيير le contenant مع الاحتفاظ بالمعلومة","رفع la densité بـ la nominalisation وحذف les verbes creux وles redites","صياغة le résumé exécutif: la décision, les chiffres clés, les limites في صفحة واحدة"],"sections":[{"h":"الدرس 1: كيف تختصر تقريراً من عشرين صفحة في صفحة تُقرأ وحدها","video":{"id":"kglANS4flVk","title":"Réussir son RÉSUMÉ / CONTRACTION DE TEXTE - Prépa Scientifique","channel":"Prépa Up","why":"منهجية الاقتباس والتلخيص خطوة بخطوة: كيف تُلتقط les idées principales، وكيف تحافظ على la proportion entre les parties، ثم كيف تكتب نصاً متماسكاً بدل قطع مُفكّكة — أساس le résumé المهني.","lang":"fr","main":true,"dur":7},"p":["le résumé exécutif صفحة واحدة تُقرأ قبل التقرير وأحياناً بدلّه. le destinataire هو مدير لا قارئ: يبحث عن la décision المطلوبة، والرقم الذي يُحدّدها، والخطر الذي يُغيّرها. ولذلك تبدأ le résumé بما يُسمّى la recommandation، لا بـ le contexte الذي يكتبه المؤلف لأنه اعتاد عليه.","la pyramide inversée هي قاعدة البناء: أولاً la conclusion والتوصية، ثانياً les arguments في ترتيب la force المتناقصة، ثالثاً les preuves والأرقام، أخيراً les limites وla méthode. le lecteur الذي يقرأ الجملة الأولى فقط يجب أن يعرف القرار؛ والذي يقرأ الفقرة الأولى فقط يجب أن يعرف le pourquoi.","la reformulation هي المهارة الحاسمة: لا تنسخ الجمل المصدرية بل تُغيّر le point de vue — من le discours direct إلى le discours indirect (« le rapport indique que… »)، وتُجمّع ثلاثة أمثلة في قاعدة واحدة، وتستبدل les détails بـ la catégorie. القاعدة: إن استطعت لصق الجملة الأصلية دون علامة اقتباس، فأنت تُنسخ لا تُلخّص.","la densité تأتي من ثلاثة: la nominalisation (« le retard des livraisons » بدل « les livraisons ont retardé »)، الاحتفاظ بالرقم بدل الوصف (« 18 % » لا « نسبة معتبرة »)، وحذف les verbes creux (« avoir lieu », « effectuer », « constituer une avancée »). الجملة الجيّدة هنا من 15 إلى 20 كلمة: أطول منها تُخفِّي la décision.","la hiérarchie تظهر بصرياً: le titre يحمل la décision لا le sujet (« Recommencer la phase pilote » لا « Rapport sur la phase pilote »)، كل فقرة تبدأ بـ la phrase d’orientation، et les chiffres تُوضع في la position المُبرِزة (بداية الجملة أو نهايتها). la ponctuation تُدير la lecture: الفاصلة تُحصِّن والأقواس تُبعِّد la limite.","منهجية الاختبار في أربع خطوات: اقرأ المصدر واكتب ثلاث جمل — سياق، نتيجة، توصية. ضَع الميزان: 250 كلمة لا أكثر ولا أقل. ثم اقرأ الصفحة وحدك دون المصدر واسأل: هل أستطيع اتخاذ قرار بناءً عليها؟ إن توقّفت عند كلمة، ابحث عن le synonyme في le texte مصدر لا في قاموسك — المصطلح الدقيق أهم من الكلمة اللامعة."],"sub":[{"h":"la pyramide inversée","p":["La recommandation ouvre le résumé.","Les arguments suivent par ordre de force.","Les preuves chiffrées viennent en appui."]},{"h":"reformuler sans copier","p":["Le rapport indique que les livraisons ont pris du retard.","Trois exemples se ramènent à une seule règle.","On passe du discours direct au style indirect."]},{"h":"condenser pour décider","p":["La nominalisation gagne des mots.","Le chiffre remplace l’adjectif d’approximation.","Une phrase de quinze à vingt mots reste lisible."]}]},{"h":"les formules du résumé exécutif","p":["« Il est recommandé de… » — la recommandation qui ouvre la page.","« D’après le rapport, les livraisons ont augmenté de 18 %. » — l’attribution et le chiffre clé.","« Force est de constater que… » — le constat qui prépare la limite.","« Cette analyse reste incomplète faute de données sur… » — la limite assumée en fin de page."]},{"h":"التطبيق والتلخيص","p":["تمرين la pyramide: خُذ خلاصة كتبتها وقلّب ترتيبها — اجعل la recommandation أول جملة، ثم راجع هل صارت أقوى.","تمرين la reformulation: خُذ ثلاث جمل من تقرير وحوّلها إلى le discours indirect مع « d’après » أو « selon »، ثم اجمعها في جملة واحدة.","تمرين la densité: احذف من فقرة من 100 كلمة كل le verbe creux وla répétition، ثم قِس la longueur الجديدة: يجب أن تقلّ بنصف دون فقدان معنى."]}],"pron":[{"w":"la synthèse","ipa":"[la sɛ̃.tɛz]","approx":"لا سينتيز"},{"w":"la recommandation","ipa":"[la ʁə.kɔ.mɑ̃.da.sjɔ̃]","approx":"لا روكومانداسيون"},{"w":"le chiffre clé","ipa":"[lə ʃifʁ kle]","approx":"لُ شيفر كلِيه"}],"vocab":[{"fr":"la synthèse","ar":"التوليف / الخلاصة","pos":"nom","g":"f","exFr":"La synthèse restitue l’essentiel d’un dossier.","ipa":"[sɛ̃.tɛz]","exAr":"التوليف يستعيد جوهر الملف."},{"fr":"la reformulation","ar":"إعادة الصياغة","pos":"nom","g":"f","exFr":"La reformulation évite le plagiat.","ipa":"[ʁe.fɔʁ.my.la.sjɔ̃]","exAr":"إعادة الصياغة تمنع الانتحال."},{"fr":"la pyramide inversée","ar":"الهرم المقلوب (ترتيب المعلومة)","pos":"nom","g":"f","exFr":"La pyramide inversée place la conclusion en tête.","ipa":"[pi.ʁamid ɛ̃.vɛʁ.se]","exAr":"الهرم المقلوب يضع الاستنتاج في البداية."},{"fr":"la recommandation","ar":"التوصية","pos":"nom","g":"f","exFr":"La recommandation tient en une phrase.","ipa":"[ʁə.kɔ.mɑ̃.da.sjɔ̃]","exAr":"تحتضن التوصية في جملة واحدة."},{"fr":"la densité","ar":"الكثافة المعلومية","pos":"nom","g":"f","exFr":"La densité prime sur la longueur.","ipa":"[dɑ̃.si.te]","exAr":"الكثافة تتقدم على الطول."},{"fr":"le chiffre clé","ar":"الرقم المفتاحي","pos":"nom","g":"m","exFr":"Le chiffre clé ferme la première phrase.","ipa":"[ʃifʁ kle]","exAr":"يختتم الرقم المفتاحي الجملة الأولى."},{"fr":"la hiérarchie de l’information","ar":"تراتبية المعلومة","pos":"nom","g":"f","exFr":"La hiérarchie de l’information guide le lecteur.","ipa":"[je.ʁaʁʃi də lɛ̃.fɔʁ.ma.sjɔ̃]","exAr":"تراتبية المعلومة تُرشد القارئ."},{"fr":"restituer","ar":"يستعيد ويُعيد إنتاج","pos":"verbe","g":"","exFr":"Le résumé restitue les résultats sans commentaire.","ipa":"[ʁəs.ti.tɥe]","exAr":"يستعيد الملخّص النتائج دون تعليق."},{"fr":"condenser","ar":"يُكثِّف","pos":"verbe","g":"","exFr":"Il faut condenser trois pages en un paragraphe.","ipa":"[kɔ̃.dɑ̃.se]","exAr":"يجب تكثيف ثلاث صفحات في فقرة."},{"fr":"soutenir (une hypothèse)","ar":"يدعم (فرضية)","pos":"verbe","g":"","exFr":"Deux chiffres soutiennent cette hypothèse.","ipa":"[sut.niʁ]","exAr":"يدعم رقمان هذه الفرضية."},{"fr":"la limite","ar":"الحدّ / التحفظ","pos":"nom","g":"f","exFr":"La limite est annoncée en fin de synthèse.","ipa":"[li.mit]","exAr":"يُعلن الحدّ في نهاية التوليف."},{"fr":"en définitive","ar":"في الحصيلة","pos":"loc.","g":"","exFr":"En définitive, la mesure se justifie.","ipa":"[ɑ̃ de.fi.ni.tif]","exAr":"في الحصيلة تبرَّر المُكمَّلة."}],"examples":[{"fr":"Il est recommandé de relancer les fournisseurs dès la semaine prochaine.","ar":"يُوصى بمتابعة المورّدين اعتباراً من الأسبوع القادم.","note":"la recommandation en tête"},{"fr":"D’après le rapport, les livraisons ont augmenté de 18 %.","ar":"حسب التقرير، ارتفعت التوريدات بنسبة 18 بالمائة.","note":"l’attribution + le chiffre"},{"fr":"Le retard des livraisons pèse sur la marge.","ar":"تأخّر التوريدات يضغط على الهامش.","note":"la nominalisation dense"},{"fr":"Force est de constater que le dispositif reste coûteux.","ar":"لا بدّ من الإقرار بأنّ الآلية باهظة التكلفة.","note":"la formule de rigueur"},{"fr":"Cette analyse reste incomplète faute de données régionales.","ar":"يظلّ هذا التحليل غير مكتمل لغياب بيانات جهوية.","note":"la limite assumée"},{"fr":"Trois cas observés se ramènent à une même cause.","ar":"الحالات الثلاث المُلاحَظة ترجع إلى سبب واحد.","note":"la généralisation par réduction"}],"grammar":[{"tFr":"Reformuler sans plagier : le discours indirect et l’attribution","tAr":"إعادة الصياغة دون نسخ: الكلام غير المباشر والإسناد","body":["La synthèse doit attribuer sans copier : « d’après le rapport », « selon l’étude », « les auteurs estiment que… ». Le verbe déclaratif (indiquer, estimer, souligner) porte l’information, et la subordonnée conjonctive « que » reprend le contenu à distance : le lecteur sait que l’idée n’est pas celle de l’auteur du résumé.","Deux transformations gèrent la longueur : l’impersonnalisant (« les livraisons ont augmenté » → « une hausse des livraisons est constatée ») et la réduction (trois exemples → « plusieurs cas »). Attention à la concordance : après un verbe au passé (a indiqué), le subjonctif ou l’imparfait apparaissent selon le sens — « le rapport a indiqué que le délai était dépassé »."],"ex":[{"fr":"D’après l’étude, la marge a diminué au troisième trimestre.","ar":"حسب الدراسة، انخفض الهامش في الثلاثي الثالث."},{"fr":"Les auteurs estiment que le dispositif devrait être revu.","ar":"يرى المؤلفون أنه يُتعيّن مراجعة الآلية."}]},{"tFr":"La phrase dense : nominalisation, locutions prépositives, chiffre","tAr":"الجملة الكثيفة: التاسيم، حروف الجر المركّبة، الرقم","body":["La phrase de synthèse perd ses verbes faibles : « effectuer une étude » devient « l’étude de… », « avoir lieu » disparaît au profit d’un nom de temps (« à la suite du plan de 2024 »). Les locutions prépositives (à la suite de, en raison de, au terme de, faute de) remplacent les subordonnées causales et font gagner des mots.","Le chiffre est le levier final : il remplace l’adjectif d’approximation (« une augmentation significative » → « + 18 % ») et se place en tête ou en fin de phrase pour être retenu. Test de densité : compter les mots par idée ; au-delà de cinq mots par idée, la phrase est creuse et doit être scindée ou nominalisée."],"ex":[{"fr":"En raison du retard, la marge recule de deux points.","ar":"بسبب التأخّر، ينخفض الهامش بنقطتين."},{"fr":"Au terme de l’analyse, deux scénarios restent ouverts.","ar":"في خلاصة التحليل، يبقى سيناريوهان مفتوحين."}]}],"mistakes":[{"wrong":"recopier les phrases du rapport dans le résumé","right":"reformuler et attribuer : « d’après… », « selon… »","why":"la copie s’apparente au plagiat et gonfle la page — النسخ يقترب من الانتحال ويزيد الصفحة حجماً."},{"wrong":"commencer par le contexte historique du dossier","right":"commencer par la recommandation","why":"le décideur cherche la décision, pas le récit — صانع القرار يبحث عن القرار لا عن السرد."},{"wrong":"écrire « une augmentation importante »","right":"écrire « + 18 % »","why":"l’adjectif d’approximation ne se mesure pas ; le chiffre se décide — الصفة التقريبية لا تُقاس، الرقم يُبنى عليه قرار."},{"wrong":"occuper deux pages pour un résumé","right":"tenir 250 mots : une page lue en une minute","why":"la contrainte de longueur force la hiérarchie — قيد الطول هو ما يفرض التراتبية."}],"dialogues":[{"title":"Réduire à une page","ctx":"مديرة تطلب من مُحلِّل اختصار تقرير طويل قبل اجتماع","lines":[{"who":"Hélène","fr":"Le rapport compte vingt-deux pages : réduisez à une.","ar":"التقرير اثنان وعشرون صفحة: اختصره إلى صفحة."},{"who":"Mehdi","fr":"Par quoi j’ouvre : le contexte ou la mesure ?","ar":"بماذا أبدأ: السياق أم الإجراء؟"},{"who":"Hélène","fr":"Par la recommandation : dites ce que vous proposez.","ar":"بالتوصية: قلّ ما تقترحه."},{"who":"Mehdi","fr":"D’accord, puis les chiffres clés et les limites.","ar":"حسناً، ثم الأرقام المفتاحية والحدود."}]},{"title":"Vérifier la reformulation","ctx":"مراجعة مشتركة لصياغة خلاصة قبل الإرسال","lines":[{"who":"Sarah","fr":"Cette phrase est recopiée telle quelle du rapport.","ar":"هذه الجملة منسوخة حرفياً من التقرير."},{"who":"Karim","fr":"Je la passe au style indirect avec « d’après ».","ar":"سأحوّلها إلى الكلام غير المباشر بـ « حسب »."},{"who":"Sarah","fr":"Et le chiffre : il doit fermer la phrase.","ar":"والرقم: يجب أن يختم الجملة."},{"who":"Karim","fr":"C’est noté : « la marge recule, à 18 % selon… ».","ar":"تمّ: « ينخفض الهامش إلى 18 بالمائة حسب… »."}]}],"exercises":[{"t":"mcq","skill":"writing","q":"ما أول عنصر في le résumé exécutif؟","opts":["la recommandation","le contexte historique","la bibliographie","la méthode détaillée"],"a":0,"why":"la pyramide inversée place la décision en tête pour le lecteur pressé."},{"t":"fill","skill":"grammar","q":"أكمل الصيغة: «___ le rapport, les livraisons ont augmenté de 18 %.»","fr":"___ le rapport, les livraisons ont augmenté de 18 %.","ans":"D’après","why":"« d’après » + nom = l’attribution obligatoire de l’information."},{"t":"order","skill":"writing","q":"رتّب: في خلاصة التحليل يبقى سيناريوهان مفتوحان","words":["Au","terme","de","l’analyse,","deux","scénarios","restent","ouverts."],"ans":"Au terme de l’analyse, deux scénarios restent ouverts.","why":"locution prépositive en tête + verbe + complément : l’ordre classique de la phrase dense."},{"t":"listen","skill":"listening","q":"ما « la recommandation » في صفحة تنفيذية؟","opts":["القرار المقترح على المسؤول","وصف المنهج","قائمة المراجع","شكر المُساهمين"],"a":0,"why":"la recommandation est l’action proposée : elle ouvre le résumé."},{"t":"translate","skill":"writing","q":"ترجم: «يُوصى بمتابعة المورّدين اعتباراً من الأسبوع القادم.»","ans":"Il est recommandé de relancer les fournisseurs dès la semaine prochaine.","why":"« il est recommandé de » + infinitif = la formule impersonnelle de la synthèse professionnelle."},{"t":"speaking","skill":"speaking","q":"لخّص شفويًا تقريراً قرأتَه في ثلاث جمل: سياق، نتيجة، توصية.","target":"D’après / les chiffres montrent / il est recommandé de","why":"la structure en trois temps هي نواة le résumé exécutif."},{"t":"correct","skill":"grammar","q":"صحّح النسخ الحرفي: « Le rapport dit : « les résultats sont bons » »","ans":"D’après le rapport, les résultats sont favorables.","why":"la citation directe passe en discours indirect avec attribution."},{"t":"writing","skill":"writing","q":"اكتب le résumé exécutif من 150 كلمة لتقرير عن تأخر مشروع: la recommandation، les chiffres clés، la limite.","target":"il est recommandé de / d’après / faute de","why":"la mise en page décisionnelle réunit recommandation, preuve et limite."}],"homework":"خُذ تقريراً أو مقالاً من 500 كلمة واكتب خلاصة تنفيذية من 150 كلمة بـ la pyramide inversée، ثم اكتب في هامش واحد le synonyme الذي اخترتَه لكل مصطلح نقلتَه عن المصدر.","sources":[{"title":"Réussir son RÉSUMÉ / CONTRACTION DE TEXTE - Prépa Scientifique","channel":"Prépa Up","videoId":"kglANS4flVk","why":"منهجية الاقتباس والتلخيص خطوة بخطوة: كيف تُلتقط les idées principales، وكيف تحافظ على la proportion entre les parties، ثم كيف تكتب نصاً متماسكاً بدل قطع مُفكّكة — أساس le résumé المهني.","cat":"Style","level":"C1","main":true},{"title":"La méthode facile de la contraction de texte suivie d’un essai","channel":"Réussis tes cours de français","videoId":"_uvyJsoKhJc","why":"تطبيق كامل على la contraction: قراءة، تقسيم les idées، ضبط la proportion — تدريب مُتدرّج على la densité المطلوبة هنا.","cat":"Style","level":"C1","extra":true},{"title":"Note de synthèse concours (1/4) : Comprendre et analyser le sujet efficacement !","channel":"Territoriale Academie","videoId":"0dIlS7SGMRI","why":"تحليل le sujet قبل التلخيص: كيف تكتشف la hiérarchie de l’information في النص المصدر قبل أن تُعيد بناءها.","cat":"Style","level":"C1","extra":true}],"supplements":[{"id":"_uvyJsoKhJc","title":"La méthode facile de la contraction de texte suivie d’un essai","channel":"Réussis tes cours de français","why":"تطبيق كامل على la contraction: قراءة، تقسيم les idées، ضبط la proportion — تدريب مُتدرّج على la densité المطلوبة هنا.","lang":"fr","dur":16},{"id":"0dIlS7SGMRI","title":"Note de synthèse concours (1/4) : Comprendre et analyser le sujet efficacement !","channel":"Territoriale Academie","why":"تحليل le sujet قبل التلخيص: كيف تكتشف la hiérarchie de l’information في النص المصدر قبل أن تُعيد بناءها.","lang":"fr","dur":5}]}]},{"id":"c1-t4","slug":"la-presse-et-l-editorial","icon":"list","color":"#dc2626","fr":"La presse et l’éditorial","ar":"الصحافة والمقال الافتتاحي","desc":"l’éditorial، le compte rendu، le portrait، l’enquête، la chronique، la revue de presse.","lessons":[{"id":"c1-t4-l1","fr":"L’éditorial","ar":"الافتتاحية الصحفية: البنية والتموضع والنبرة","objectives":["تحليل بنية الافتتاحية: l’accroche, la thèse, les arguments ثم la chute","استخراج le vocabulaire d’opinion والتمييز بين le constat et le jugement","استنتاج la tonalité — ironique, véhémente, caustique — من le rythme et le lexique","تحرير éditorial قصير من 120 كلمة حول موضوع محايد مع احترام la déontologie"],"sections":[{"h":"الدرس 1: كيف تُقرأ الافتتاحية — البناء والأطروحة الضمنية","video":{"id":"sjIb6i5jVco","title":"Un éditorial, c’est quoi?","channel":"Ecole Virtuelle au CSAP","why":"تعريف دقيق ومقتضب لl’éditorial كنوع صحفي مستقل: موقعه في الجريدة، صاحبه، ووظيفته في التعبير عن la ligne éditoriale قبل الانتقال إلى تحليل البنية.","lang":"fr","main":true,"dur":2},"p":["l’éditorial مقال موقّع يعبّر عن الموقف الرسمي للجريدة، يكتبه رئيس التحرير أو كاتب عمود ثابت؛ فهو لا ينقل الأخبار بل يفسّرها ويحكمها. موقعه الصفحة الأولى أو صفحة la rubrique Opinion، وطوله بين 400 و800 كلمة، وسيرته تظهر تحت عنوان la une مباشرة.","البناء الكلاسيكي رباعي: l’accroche — جملة صادمة أو سؤال مفتوح — ثم la thèse التي تُصاغ أحياناً في جملة واحدة، ثم les arguments مرتّبة من الأقوى إلى الأضعف، وأخيراً la chute الجملة التي تبقى في ذاكرة القارئ. النشاط الأساسي: ابحث عن la thèse implicite، فهي كثيراً ما تُستنتج من الصفات والأمثلة ولا تُعلن صراحة.","المفردات المحركة لl’éditorial: estimer, juger à propos, il convient de, à notre sens, force est de constater, on peut légitimement se demander. هذه العبارات تُخرج النص من la sphère des faits إلى la sphère du jugement؛ أما le constat فيستعمل le présent de l’information والأرقام والتواريخ.","la tonalité ليست زينة بل هي le positionnement نفسه: l’ironie تظهر في le rythme court وla ponctuation vive، وle ton véhémente في le champ lexical de la lutte وتكرار les virgules، وla causticité في les comparaisons acérées. اقرأ الفقرة الأولى بصوتٍ عالٍ: النبرة التي تسمعها هي la tonalité.","la déontologie تضع حداً واضحاً: يُفصل le fait عن l’opinion، ولا يُنشر ادعاء بلا source مسمّاة، ولا يُستعمل le règlement de comptes. الافتتاحية الصحفية تنتقد الفعل لا صاحبه: « la mesure est incohérente » بدلاً من « l’auteur est incompétent ». النقد المنهجي يُبقي مصداقيته.","تمرين القراءة: بعد كل افتتاحية اكتب جملتين فقط — الجملة الأولى تُصوغ la thèse، والثانية تذكر الدليل الذي استعمله الكاتب. إن لم تجد دليلاً مباشراً، فأنت بين يدي le plaidoyer أو la tribune، وليست la thèse الصحفية المدعومة."],"sub":[{"h":"la thèse et sa preuve","p":["L’éditorial défend une thèse, pas un fait.","Chaque argument doit servir cette thèse.","La chute rappelle la position du journal."]},{"h":"repérer la tonalité","p":["L’ironie se reconnaît au rythme court.","La tonalité révèle le positionnement.","Le ton véhément n’appartient pas au compte rendu."]},{"h":"le fait et l’opinion","p":["Le fait se vérifie, l’opinion se discute.","Séparez le constat du jugement.","Citez toujours la source de l’information."]}]},{"h":"les formules de l’éditorial","p":["« Il convient de le dire sans détour… » — l’entrée en matière directe.","« À notre sens, cette réforme… » — l’assomption de la thèse.","« Force est de constater que… » — le constat qui masque le jugement.","« Reste à savoir si… » — la chute ouverte qui invite à réfléchir."]},{"h":"التطبيق والتلخيص","p":["تمرين la thèse: اقرأ افتتاحية من جريدة فرنسية واكتب جملتين — la thèse في الأولى، والدليل في الثانية.","تمرين la tonalité: صِغ نفس الموقف مرتين، مرة بـl’ironie ومرة بلغة محايدة، ثم حدّد ما تغيّر في le lexique et le rythme.","تمرين la déontologie: أعِد صياغة فقرة تنتقد شخصاً بحيث تنتقل من le règlement de comptes إلى la critique de l’acte."]}],"pron":[{"w":"l’éditorial","ipa":"[le di.tɔ.ʁjal]","approx":"لْ إيديتوريال"},{"w":"la thèse","ipa":"[la tɛs]","approx":"لا تيس"},{"w":"la tonalité","ipa":"[la tɔ.na.li.te]","approx":"لا توناليتي"}],"vocab":[{"fr":"l’éditorial","ar":"الافتتاحية الصحفية","pos":"nom","g":"f","exFr":"L’éditorial paraît en première page.","ipa":"[le di.tɔ.ʁjal]","exAr":"تُنشر الافتتاحية في الصفحة الأولى."},{"fr":"la thèse","ar":"الأطروحة أو الموقف المدافع عنه","pos":"nom","g":"f","exFr":"Sa thèse est claire dès la première phrase.","ipa":"[la tɛs]","exAr":"أطروحته واضحة منذ الجملة الأولى."},{"fr":"la tonalité","ar":"النبرة والطابع العام","pos":"nom","g":"f","exFr":"La tonalité de l’article est ironique.","ipa":"[la tɔ.na.li.te]","exAr":"نبرة المقال ساخرة."},{"fr":"le jugement","ar":"الحكم أو التقدير","pos":"nom","g":"m","exFr":"Le jugement se distingue du constat.","ipa":"[lə ʒyʒ.mɑ̃]","exAr":"يختلف الحكم عن التقرير المحايد."},{"fr":"estimer","ar":"يرى أو يُقدّر (فعل رأي)","pos":"verbe","g":"","exFr":"La rédaction estime que la mesure est prématurée.","ipa":"[ɛs.ti.me]","exAr":"ترى هيئة التحرير أن الإجراء سابق لأوانه."},{"fr":"il convient de","ar":"يلزم أو من المناسب","pos":"loc.","g":"","exFr":"Il convient de préciser la source.","ipa":"[il kɔ̃.vjɛ̃ də]","exAr":"يلزم تدوين المصدر بوضوح."},{"fr":"en revanche","ar":"في المقابل","pos":"loc.","g":"","exFr":"En revanche, le rapport ne cite aucun témoin.","ipa":"[ɑ̃ ʁə.ʋɑ̃ʃ]","exAr":"في المقابل، لا يوثّق التقرير أي شاهد."},{"fr":"la chute","ar":"الجملة الختامية المفعولة","pos":"nom","g":"f","exFr":"La chute reste gravée dans la mémoire.","ipa":"[la ʃyt]","exAr":"تبقى الجملة الختامية راسخة في الذاكرة."},{"fr":"l’ironie","ar":"السخرية","pos":"nom","g":"f","exFr":"L’ironie affaiblit l’argument quand elle dérape.","ipa":"[li.ʁɔ.ni]","exAr":"تُضعف السخرية الحجة حين تتجاوز الحد."},{"fr":"nuancer","ar":"يُبرز الفروق ويلطّف الحكم","pos":"verbe","g":"","exFr":"Il faut nuancer une généralisation hâtive.","ipa":"[ny.ɑ̃.se]","exAr":"يلزم تلطيف التعميل المتسرع."},{"fr":"le plaidoyer","ar":"المساندة الحماسية أو الدفاع المتحمس","pos":"nom","g":"m","exFr":"Ce texte est un plaidoyer, pas une analyse.","ipa":"[lə plɛ.dwa.je]","exAr":"هذا النص مساندة حماسية لا تحليل."},{"fr":"la déontologie","ar":"الأخلاقيات المهنية","pos":"nom","g":"f","exFr":"La déontologie interdit l’attaque personnelle.","ipa":"[de.ɔ̃.tɔ.lɔ.ʒi]","exAr":"تُحرّم الأخلاقيات المهنية الاعتداء الشخصي."}],"examples":[{"fr":"L’éditorial défend une thèse, pas un fait.","ar":"الافتتاحية تدافع عن أطروحة لا عن واقعة.","note":"la définition du genre"},{"fr":"Il convient de le dire sans détour.","ar":"يلزم قوله دون ملابسة.","note":"l’entrée en matière"},{"fr":"À notre sens, cette réforme mérite un débat public.","ar":"في رأينا تستحق هذه الإصلاحية جدلاً عاماً.","note":"l’assomption de la thèse"},{"fr":"Force est de constater que les chiffres ne tiennent pas.","ar":"لا بدّ من التسليم بأن الأرقام لا تصمد.","note":"le constat qui masque le jugement"},{"fr":"La mesure est incohérente, mais son auteur reste respecté.","ar":"الإجراء متناقض، لكن صاحبه يبقى محترماً.","note":"la déontologie"},{"fr":"Reste à savoir si le débat aura lieu.","ar":"يبقى معرفة إن كان الجدال سيقع.","note":"la chute ouverte"}],"grammar":[{"tFr":"Le subjonctif après les verbes de jugement","tAr":"الشرطى بعد أفعال الرأي والحكم","body":["Après juger bon que, souhaiter que, refuser que, le subjonctif présente la position de l’auteur et non un fait vérifiable : « La rédaction juge bon que la mesure soit revue. » Le mode signale qu’on se situe dans la lecture personnelle.","Le subjonctif accompagne aussi il faut que, bien que, pour que, et il tempère le ton dogmatique de l’éditorial. À l’inverse, l’indicatif affirme le fait : « Les chiffres montrent que la hausse continue. »"],"ex":[{"fr":"Il faut que la source soit vérifiée avant publication.","ar":"يجب أن يُتحقق من المصدر قبل النشر."},{"fr":"Bien que le rapport soit complet, il reste à convaincre.","ar":"رغم أن التقرير مكتمل، فإنه يبقى عليه أن يقنع."}]},{"tFr":"La modalisation : adverbes, verbes de pensée et conditionnel","tAr":"التوسيط اللغوي: الظروف وأفعال الرأي والمضارع الشرطي","body":["Les adverbes de jugement (légitimement, manifestement, vraisemblablement) et les verbes de pensée (considérer, estimer, penser) dosent l’affirmation : « On peut légitimement se demander si… » affirme davantage qu’un doute et reste plus prudent qu’une accusation.","Le conditionnel d’atténuation (serait, pourrait, devrait) présente l’information sans l’assumer : « Cette décision fragiliserait les usagers. » Il marque la distance entre le fait établi et l’hypothèse, et constitue l’outil central du langage prudentiel de la presse."],"ex":[{"fr":"Cette réforme pourrait produire l’effet inverse.","ar":"قد يُحدث هذا الإصلاح العكس."},{"fr":"Le journaliste considère que le débat n’est pas clos.","ar":"يرى الصحفي أن الجدال لم ينتهِ بعد."}]}],"mistakes":[{"wrong":"l’éditorial raconte les événements de la veille","right":"l’éditorial interprète des faits déjà rapportés","why":"le compte rendu informe, l’éditorial juge — التقرير يُبلغ والافتتاحية تحكم."},{"wrong":"« À mon avis, le ministre est incompétent »","right":"« La mesure prise par le ministre est incohérente »","why":"la déontologie interdit l’attaque personnelle : on critique l’acte, pas la personne — الأخلاقيات تُحرّم الانتقاد الشخصي."},{"wrong":"« Il montre que la réforme échouera »","right":"« Il laisse entendre que la réforme échouera »","why":"le verbe de pensée nuance et évite l’affirmation non prouvée — فعل الرأي يُلطّف الأطروحة غير المثبتة."},{"wrong":"employer le registre familier pour convaincre","right":"employer un registre soutenu et précis","why":"la hauteur du style fonde la crédibilité de l’éditorial — ارتفاع السبْق يمنح الافتتاحية مصداقيتها."}],"dialogues":[{"title":"L’angle du jour","ctx":"كاتب ومحرّران يختاران موضوع الافتتاحية","lines":[{"who":"Camille","fr":"Nous devons choisir un angle pour l’éditorial de demain.","ar":"علينا اختيار زاوية لافتتاحية الغد."},{"who":"Thomas","fr":"Je propose la réforme des retraites, thèse implicite à l’appui.","ar":"أقترح إصلاح التقاعد، مع أطروحة ضمنية مسنودة."},{"who":"Camille","fr":"D’accord, mais il faut séparer le fait du jugement.","ar":"موافق، لكن يجب فصل الواقعة عن الحكم."},{"who":"Thomas","fr":"Je terminerai par une chute ouverte.","ar":"سأنهي بمقطع ختامي مفتوح."}]},{"title":"La tonalité","ctx":"نقاش حول نبرة المقال قبل النشر","lines":[{"who":"Sarah","fr":"Ton texte est trop véhément pour notre ligne.","ar":"نصك فاحش الجدة أكثر من خطنا التحريري."},{"who":"Karim","fr":"Je peux l’adoucir avec le conditionnel d’atténuation.","ar":"أستطيع تلطيفه بالمضارع الشرطي للتنبيه."},{"who":"Sarah","fr":"Remplace « cela prouve » par « cela fragiliserait ».","ar":"استبدل «يُثبت» بـ«قد يُضعف»."},{"who":"Karim","fr":"La thèse reste, sans agresser personne.","ar":"تبقى الأطروحة دون اعتداء على أحد."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما وظيفة la thèse في l’éditorial؟","opts":["الموقف الذي يدافع عنه الكاتب بالحجج","عنوان الصفحة الأولى","قائمة المصادر الموقعة","الملخص اليومي للأخبار"],"a":0,"why":"la thèse = la position que le texte défend au moyen des arguments."},{"t":"fill","skill":"grammar","q":"أكمل بالفعل الشرطي المناسب: «Il faut que la source ___ vérifiée.»","fr":"Il faut que la source ___ vérifiée.","ans":"soit","why":"après il faut que, le subjonctif exprime la nécessité, pas un fait constaté."},{"t":"order","skill":"writing","q":"رتّب: الافتتاحية تدافع عن أطروحة لا عن واقعة","words":["L’éditorial","défend","une","thèse,","pas","un","fait."],"ans":"L’éditorial défend une thèse, pas un fait.","why":"ordre sujet-verbe-complément, la virgule reste sur le dernier groupe."},{"t":"listen","skill":"listening","q":"ما المقصود بـ « la chute » في الافتتاحية؟","opts":["الجملة الختامية المفعولة","العنوان الرئيسي","قائمة المصادر","الصورة المصاحبة"],"a":0,"why":"la chute est la dernière phrase, conçue pour rester en mémoire."},{"t":"translate","skill":"writing","q":"ترجم: «لا بدّ من التسليم بأن الأرقام لا تصمد.»","ans":"Force est de constater que les chiffres ne tiennent pas.","why":"formule figée : force est de constater que + le subjonctif après que."},{"t":"speaking","skill":"speaking","q":"عرّف l’éditorial في جملتين، ثم بيّن الفرق بينه وبين le compte rendu.","target":"thèse / tonalité / fait et opinion","why":"إنتاج لغوي يجمع التعريف والمقارنة في le registre soutenu."},{"t":"correct","skill":"grammar","q":"صحّح الجملة: «L’éditorial raconte ce qui s’est passé hier.»","ans":"L’éditorial interprète ce qui s’est passé hier.","why":"l’éditorial interprète et juge ; le compte rendu seul raconte les faits."},{"t":"mcq","skill":"reading","q":"أي عبارة تُعتبر مخالفة la déontologie داخل افتتاحية؟","opts":["« L’auteur du texte est incompétent. »","« La mesure produira l’effet inverse. »","« Selon le rapport officiel… »","« Il reste à vérifier ce chiffre. »"],"a":0,"why":"l’attaque personnelle sort du champ de la critique de l’acte."}],"homework":"اقرأ افتتاحية كاملة من جريدة فرنسية واكتب في 120 كلمة: la thèse، ودليلين مستعملين، وla tonalité، ثم أعد صياغة la chute بطريقتك مع الحفاظ على موقف الكاتب.","sources":[{"title":"Un éditorial, c’est quoi?","channel":"Ecole Virtuelle au CSAP","videoId":"sjIb6i5jVco","why":"تعريف دقيق ومقتضب لl’éditorial كنوع صحفي مستقل: موقعه في الجريدة، صاحبه، ووظيفته في التعبير عن la ligne éditoriale قبل الانتقال إلى تحليل البنية.","cat":"Presse","level":"C1","main":true},{"title":"Cours de journalisme - Trois principes de base de la rédaction d’article de presse","channel":"Mister Colombo","videoId":"h2aheNZXoXA","why":"المبادئ الثلاثة لكتابة المقال الصحفي: كيف تُبنى la thèse والدليل والأسلوب قبل الانتقال إلى الافتتاحية.","cat":"Presse","level":"C1","extra":true},{"title":"TUTOS KAROO — Comprendre l’angle journalistique","channel":"Karoo","videoId":"71UGdhED-9c","why":"لماذا يختار الكاتب l’angle واحداً؟ تمرين على استخراج le point de vue من خبر واحد مقروء بثلاث زوايا.","cat":"Presse","level":"C1","extra":true}],"supplements":[{"id":"h2aheNZXoXA","title":"Cours de journalisme - Trois principes de base de la rédaction d’article de presse","channel":"Mister Colombo","why":"المبادئ الثلاثة لكتابة المقال الصحفي: كيف تُبنى la thèse والدليل والأسلوب قبل الانتقال إلى الافتتاحية.","lang":"fr","dur":18},{"id":"71UGdhED-9c","title":"TUTOS KAROO — Comprendre l’angle journalistique","channel":"Karoo","why":"لماذا يختار الكاتب l’angle واحداً؟ تمرين على استخراج le point de vue من خبر واحد مقروء بثلاث زوايا.","lang":"fr","dur":3}]},{"id":"c1-t4-l2","fr":"Le compte rendu","ar":"الخبر التقريري: الوقائع والمصادر وتهيئة الصفحة","objectives":["تحديد la structure de l’article: le titre، le chapô، les intertitres ثم le corps","تمييز la source directe عن la source anonyme واستعمال les verbes d’attribution","التمييز بين le récit factuel وle commentaire داخل le compte rendu","تحرير compte rendu من 150 كلمة لحدث محلي باحترام la mise en page الصحفية"],"sections":[{"h":"الدرس 2: كيف يُبنى الخبر — la structure pyramidale et les sources","video":{"id":"kdV3CIUvKKY","title":"Mon métier : journaliste en presse quotidienne","channel":"AJP Association des journalistes professionnels","why":"شهادة مهنية عن يومية le journaliste de presse écrite: كيف يُجمع le fait، وكيف يُتحقق من la source، وكيف يُصفّي الخبر قبل la mise en page.","lang":"fr","main":true,"dur":7},"p":["le compte rendu هو النوع الصحفي الأكثر انتشاراً: سرد محايد لحدث وقع، بلا رأي وبلا حكم. بنيته pyramidale: أقوى معلومة في الجملة الأولى، ثم التفاصيل تتناقص هرمياً حتى لا يفقد القارئ الفكرة الأساسية عند قراءة السطر الأول فقط.","عناصر البناء الأربعة: le titre المؤلف من أقل من اثنتي عشرة كلمة، وle chapô الفقرة التي تجيب عن qui ? que ? où ? quand ? pourquoi ?، وles intertitres التي تُقطّع النص إلى وحدات، ثم le corps المفصّل. le chapô وحده يكفي لفهم الخبر في ثلاثين ثانية.","المصادر هي عمود الخبر: la source officielle (communiqué, déclaration)، وla source de première main (témoin، مسؤول حضر الاجتماع)، وla source anonyme التي لا يُفصح عن اسمها. القاعدة: كل رقم يحتاج مصدراً، وكل ادعاء يحتاج فعلاً مُنسوباً إلى صاحبه.","أفعال الإسناد تُبقي المسافة المهنية: selon, a indiqué, a précisé, a affirmé, a rapporté. الاستعمال الدقيق يُميّز ما تحقّق مما رُوي: « Le préfet a indiqué… » تعني أن الجريدة نقلت دون تأكيد من طرفها.","التمييز بين le fait وle commentaire يظهر في le lexique: الصفات الانفعالية (terrible, scandaleux) مكانها الأرقام والتواريخ، والتعليق يُدفع إلى la citation أو la tribune. la mise en page نفسها تساعد: le corps neutral، وl’encadré للتفاصيل، وla citation المميزة بالخط.","تمرين التحقق: قبل كتابة أي جملة اسأل: من قال؟ متى قال؟ وهل نستطيع إثبات ما يقول بوثيقة ثانية؟ إن كان الجواب « لا »، احذف الجملة أو استعمل le conditionnel d’atténuation مع تحديد درجة التأكيد."],"sub":[{"h":"la structure pyramidale","p":["Le fait principal vient toujours en premier.","Le chapô répond aux cinq questions.","Les intertitres découpent le corps du texte."]},{"h":"les sources et l’attribution","p":["Chaque chiffre doit avoir une source.","Selon la préfecture, deux routes sont coupées.","Le témoin rapporte des faits, pas des avis."]},{"h":"le fait et le commentaire","p":["Le corps du compte rendu reste neutre.","L’émotion se glisse dans la citation.","Le bilan remplace l’adjectif."]}]},{"h":"les formules du compte rendu","p":["« Selon les premiers éléments… » — la prudence au début de l’enquête.","« Le bilan fait état de… » — la présentation chiffrée des faits.","« Notre confrère précise que… » — le relais d’une autre rédaction.","« Pour l’heure, aucun responsable n’a souhaité réagir. » — l’absence de source, assumée."]},{"h":"التطبيق والتلخيص","p":["تمرين le chapô: اكتب خمس جمل تجيب عن les cinq W لحدث وقع هذا الأسبوع، ثم احذف كل ما لا يخدم الجملة الأولى.","تمرين l’attribution: حوّل ثلاث جمل يومية إلى le registre d’attribution — « Selon… », « a précisé… », « il ressort de… ».","تمرين la mise en page: قسّم خبراً من 120 كلمة إلى titre + chapô + intertitres، وحدّد les sources بخطّ تحتي."]}],"pron":[{"w":"le compte rendu","ipa":"[lə kɔ̃t ʁɑ̃dy]","approx":"لُ كونط رانديو"},{"w":"le chapô","ipa":"[lə ʃa.po]","approx":"لُ شابو"},{"w":"la source","ipa":"[la sɔʁs]","approx":"لا سورس"}],"vocab":[{"fr":"le compte rendu","ar":"الخبر التقريري","pos":"nom","g":"m","exFr":"Le compte rendu paraît dans l’édition du matin.","ipa":"[lə kɔ̃t ʁɑ̃dy]","exAr":"يُنشر الخبر التقريري في نسخة الصباح."},{"fr":"le chapô","ar":"الفقرة المُلخِّصة قبل المتن","pos":"nom","g":"m","exFr":"Le chapô résume les cinq W.","ipa":"[lə ʃa.po]","exAr":"تُلخّص فقرة chapô الأسئلة الخمسة."},{"fr":"l’intertitre","ar":"العنوان الفرعي","pos":"nom","g":"m","exFr":"Les intertitres facilitent la lecture.","ipa":"[lɛ̃.tɛʁ.titʁ]","exAr":"تُيسّر العناوين الفرعية القراءة."},{"fr":"la mise en page","ar":"تهيئة الصفحة","pos":"loc.","g":"f","exFr":"La mise en page est l’affaire de la rédaction.","ipa":"[la miz ɑ̃ paʒ]","exAr":"تهيئة الصفحة من مهام هيئة التحرير."},{"fr":"la source","ar":"المصدر","pos":"nom","g":"f","exFr":"Cette information vient de deux sources.","ipa":"[la sɔʁs]","exAr":"تأتي هذه المعلومة من مصدرين."},{"fr":"selon","ar":"وفقًا لـ أو بحسب","pos":"prép.","g":"","exFr":"Selon les premiers éléments, personne n’est blessé.","ipa":"[sə.lɔ̃]","exAr":"وفق المصادر الأولية، لا أحد أُصيب."},{"fr":"recueillir","ar":"يجمع (شهادات وأقوالاً)","pos":"verbe","g":"","exFr":"Le journaliste a recueilli trois témoignages.","ipa":"[ʁə.kœ.jiʁ]","exAr":"جمع الصحفي ثلاث شهادات."},{"fr":"le témoignage","ar":"الشهادة الشخصية","pos":"nom","g":"m","exFr":"Le témoignage confirme le bilan.","ipa":"[lə te.mwa.ɲaʒ]","exAr":"تؤكّد الشهادة الحصيلة."},{"fr":"le bilan","ar":"الحصيلة أو الجرد","pos":"nom","g":"m","exFr":"Le bilan fait état de sept blessés.","ipa":"[lə bi.lɑ̃]","exAr":"تشير الحصيلة إلى سبعة جرحى."},{"fr":"établir","ar":"يُحرّر أو يُثبت","pos":"verbe","g":"","exFr":"La rédaction établit la chronologie des faits.","ipa":"[e.ta.liʁ]","exAr":"تُحرّر هيئة التحرير التسلسل الزمني للوقائع."},{"fr":"la dépêche","ar":"الخبر المصغّر المرسل","pos":"nom","g":"f","exFr":"La dépêche arrive avant le reportage.","ipa":"[la de.pɛʃ]","exAr":"يصل الخبر المصغّر قبل التقرير المصور."},{"fr":"le reporter","ar":"المراسل الميداني","pos":"nom","g":"m","exFr":"Le reporter se rend sur les lieux.","ipa":"[lə ʁə.pɔʁ.te]","exAr":"يتوجّه المراسل إلى عين المكان."}],"examples":[{"fr":"Le bilan fait état de sept blessés.","ar":"تشير الحصيلة إلى سبعة جرحى.","note":"la présentation chiffrée"},{"fr":"Selon la préfecture, deux routes restent coupées.","ar":"وفق الولاية، تبقى طريقان مقطوعتين.","note":"l’attribution prudente"},{"fr":"Le conseil municipal siège ce soir.","ar":"يعقد مجلس المدينة جلسته هذا المساء.","note":"le présent de l’information"},{"fr":"La séance a duré trois heures ; le vote avait été reporté la veille.","ar":"دامت الجلسة ثلاث ساعات؛ وكان التصويت قد أجّل منذ اليوم السابق.","note":"la chaîne des temps"},{"fr":"Le maire a déclaré que la situation reste sous contrôle.","ar":"أعلن العمدة أن الوضع يبقى تحت السيطرة.","note":"la citation rapportée"},{"fr":"Pour l’heure, aucun responsable n’a souhaité réagir.","ar":"في الوقت الحاضر، لم يرغب أي مسؤول في التعليق.","note":"l’absence de source, assumée"}],"grammar":[{"tFr":"Les verbes d’attribution et la citation rapportée","tAr":"أفعال الإسناد والنقل المُقتبس","body":["Selon, a indiqué, a précisé, a affirmé et a rapporté remplacent le « je pense » du journaliste : le fait reste porté par sa source, et le lecteur sait qui parle. « Le préfet a indiqué que les routes sont fermées » n’engage que le préfet.","La citation directe (« … », a-t-il déclaré) exige un verbe de parole au présent ; la citation indirecte s’aligne sur les temps du récit et peut se passer de verbe d’accompagnement après un simple « selon »."],"ex":[{"fr":"Le préfet a indiqué que les routes restent fermées.","ar":"أوضح الوالي أن الطرق تبقى مغلقة."},{"fr":"« La situation est sous contrôle », a précisé la mairie.","ar":"«الوضع تحت السيطرة»، حددت البلدية."}]},{"tFr":"Les temps du compte rendu : présent, passé composé, plus-que-parfait","tAr":"زمنيات السرد التقريري","body":["Le présent situe le fait au moment de la lecture (« Le conseil municipal siège ce soir »), le passé composé achève l’action récente (« La séance a duré trois heures ») et le plus-que-parfait repousse l’antériorité (« Le vote avait été reporté la veille »).","Cette chaîne temporelle évite les datations lourdes : on ne répète pas « hier » ni « à dix-huit heures » à chaque phrase, on classe les faits dans le temps. Les connecteurs — puis, ensuite, en effet, par ailleurs — marquent les articulations sans polluer le récit."],"ex":[{"fr":"La séance a duré trois heures, le vote avait été reporté la veille.","ar":"دامت الجلسة ثلاث ساعات، وكان التصويت قد أجّل منذ اليوم السابق."},{"fr":"Les travaux ont commencé mardi ; ils avaient été ajournés en mai.","ar":"بدأ العمل يوم الثلاثاء؛ وكان قد أجّل في ماي."}]}],"mistakes":[{"wrong":"écrire « c’est terrible » dans un compte rendu","right":"écrire « le bilan fait état de sept blessés »","why":"le chiffre remplace l’adjectif émotionnel — الرقم يحل محل الصفة الانفعالية."},{"wrong":"citer une source anonyme sans la situer","right":"préciser « un responsable de la préfecture »","why":"l’anonymat doit rester traçable pour le lecteur — إخفاء الاسم مع تحديد الصفة."},{"wrong":"mélanger le témoignage et le bilan officiel","right":"attribuer chaque information à sa source","why":"le lecteur distingue ce qui est établi de ce qui est rapporté — يُميّز القارئ بين المُثبَت والمُروى."},{"wrong":"omettre le chapô","right":"résumer les cinq W dans le chapô","why":"le chapô permet de comprendre le reportage en trente secondes — الفقرة المُلخِّصة تكفي لثلاثين ثانية."}],"dialogues":[{"title":"Avant la mise en page","ctx":"صحفيّان يراجعان خبراً قبل الطباعة","lines":[{"who":"Léa","fr":"Le chapô doit répondre aux cinq W.","ar":"يجب أن يجيب فقرة chapô عن الأسئلة الخمسة."},{"who":"Marc","fr":"Je place le bilan chiffré en tête.","ar":"أضع الحصيلة الرقمية في الصدارة."},{"who":"Léa","fr":"Il manque une source pour ce chiffre.","ar":"ينقص هذا الرقم مصده."},{"who":"Marc","fr":"Je vérifie auprès de la préfecture avant de publier.","ar":"أتحقق لدى الولاية قبل النشر."}]},{"title":"La mise en page","ctx":"محرّران يُقسّمان النص إلى عناوين فرعية","lines":[{"who":"Nadia","fr":"Les intertitres découpent le texte en trois temps.","ar":"تقسّم العناوين الفرعية النص إلى ثلاث مراحل."},{"who":"Hugo","fr":"L’encadré viendra après le second paragraphe.","ar":"يأتي الإطار الفاصل بعد الفقرة الثانية."},{"who":"Nadia","fr":"Garde un registre neutre jusqu’à la fin.","ar":"حافظ على لغة محايدة حتى النهاية."},{"who":"Hugo","fr":"D’accord, aucun commentaire dans le corps.","ar":"حسناً، لا تعليق في متن الخبر."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما المقصود بـ « le chapô » في المقال الصحفي؟","opts":["فقرة مختصرة تُلخّص الخبر قبل المتن","العنوان الفرعي","قائمة المصادر","صورة الخبر"],"a":0,"why":"le chapô est le résumé en tête de l’article qui répond aux cinq W."},{"t":"fill","skill":"grammar","q":"أكمل بالفعل المناسب: «Le préfet a ___ que les routes restent fermées.»","fr":"Le préfet a ___ que les routes restent fermées.","ans":"indiqué","why":"les verbes d’attribution au passé composé attribuent le fait à sa source."},{"t":"order","skill":"writing","q":"رتّب: الحصيلة تشير إلى سبعة جرحى","words":["Le","bilan","fait","état","de","sept","blessés."],"ans":"Le bilan fait état de sept blessés.","why":"la locution faire état de + le nom, ordre sujet-verbe-complément."},{"t":"listen","skill":"listening","q":"ما وظيفة « la dépêche » في الجريدة؟","opts":["خبر مصغّر يصل من المراسل","عنوان رئيسي ملوّن","صورة توضيحية","مقال رأي طويل"],"a":0,"why":"la dépêche est le message bref envoyé du terrain à la rédaction."},{"t":"translate","skill":"writing","q":"ترجم: «أفاد شاهد بأن الحريق اندلع نحو التاسعة.»","ans":"Un témoin a rapporté que l’incendie a éclaté vers neuf heures.","why":"rapporter que + le passé composé : le fait est rapporté, non affirmé par le journal."},{"t":"speaking","skill":"speaking","q":"صِف خبراً محلياً في ثلاث جمل مستعملين le chapô وla source وle bilan.","target":"chapô / source / bilan","why":"production orale structurée dans le registre factuel."},{"t":"correct","skill":"grammar","q":"صحّح: «Le maire a dit que c’est une catastrophe à annoncer.»","ans":"Le maire a déclaré que la situation était critique.","why":"le verbe de parole soutenu et l’accord des temps dans la citation indirecte."},{"t":"mcq","skill":"reading","q":"أي عنصر يسبق متن le compte rendu عادةً؟","opts":["le chapô","le bilan annexe","la tribune","la signature de l’éditorialiste"],"a":0,"why":"le chapô ouvre l’article avant le corps du texte."}],"homework":"اكتب compte rendu من 150 كلمة عن حدث دراسي: titre من عشر كلمات، ثم chapô يجيب عن les cinq W، ثم ثلاثة intertitres، ومصدران مسندان بـ« selon » أو « a précisé »، وحدّد بخطّ تحتي كل معلومة لم تتحقق منها بعد.","sources":[{"title":"Mon métier : journaliste en presse quotidienne","channel":"AJP Association des journalistes professionnels","videoId":"kdV3CIUvKKY","why":"شهادة مهنية عن يومية le journaliste de presse écrite: كيف يُجمع le fait، وكيف يُتحقق من la source، وكيف يُصفّي الخبر قبل la mise en page.","cat":"Presse","level":"C1","main":true},{"title":"26. Evaluer la fiabilité d’une source d’information","channel":"Louvain moocXperience","videoId":"pEr1OkjyeWo","why":"معايير تقييم la source: السمعة، والتوثيق، والتاريخ، وتحيّز الناقل — تطبيق مباشر على la vérification داخل le compte rendu.","cat":"Presse","level":"C1","extra":true},{"title":"TUTOS KAROO — Comment écrire un chapô ?","channel":"Karoo","videoId":"8ehvencoH9I","why":"تدريب مُركّز على la règle des cinq W في الفقرة الأولى: كيف تختصر الخبر دون أن تفقد le fil.","cat":"Presse","level":"C1","extra":true}],"supplements":[{"id":"pEr1OkjyeWo","title":"26. Evaluer la fiabilité d’une source d’information","channel":"Louvain moocXperience","why":"معايير تقييم la source: السمعة، والتوثيق، والتاريخ، وتحيّز الناقل — تطبيق مباشر على la vérification داخل le compte rendu.","lang":"fr","dur":9},{"id":"8ehvencoH9I","title":"TUTOS KAROO — Comment écrire un chapô ?","channel":"Karoo","why":"تدريب مُركّز على la règle des cinq W في الفقرة الأولى: كيف تختصر الخبر دون أن تفقد le fil.","lang":"fr","dur":4}]},{"id":"c1-t4-l3","fr":"Le portrait journalistique","ar":"الرسم التحريري: الزاوية السردية والحمالات والأسلوب الأدبي","objectives":["التمييز بين la focale interne وla focale externe وأثر كل منهما على la neutralité","استعمال l’anecdote وle détail révélateur لبناء la caractérisation دون صفات مُعلنة","تحليل le style littéraire داخل le portrait: les images, le rythme, la citation","تحرير portrait من 200 كلمة لشخصية محلية مع الحفاظ على la déontologie"],"sections":[{"h":"الدرس 3: كيف يُرسم شخص في الصحافة — la focale et l’anecdote","video":{"id":"Fm5z_8jHcHg","title":"Ecrire un portrait.","channel":"Le français avec Amal","why":"عرض عملي لكتابة le portrait: اختيار le détail caractéristique، وترتيب les anecdotes، والانتقال بين la description et la citation.","lang":"fr","main":true,"dur":6},"p":["le portrait الصحفي ليس سيرة ذاتية: إنه اختيار قليل من الوقائع ليقول الكثير عن شخص. الكاتب يشتغل بالـ« التفصيل الدال » — geste صغير، عبارة تُقال مرتين، غياب مُفاجئ — بدل أن يكدّس الصفات. القاعدة: واحد من الاحتمالات المُعبّرة خير من عشرة أعلام.","la focale تُحدّد مسافة النص: la focale externe تصف من خارج الشخصية — « elle traverse la salle » — وتُبقي la neutralité؛ أما la focale interne فتدخل إلى ما يُدركه البطل، وتقترب من le récit littéraire. في الصحافة تُستعمل la focale externe كأساس، وla focale interne حين يُدعم ذلك بـcitation أو récit موثّق.","la structure temporelle في le portrait تجمع بين l’imparfait de trait — العادات والصفات المستمرة — وle passé composé de l’anecdote — الحدث الذي يكشف الشخصية في لحظة واحدة: « Il arrivait toujours en retard… jusqu’au jour où… ».","الأسلوب الأدبي داخل le portrait مقبول حين يخدم le fait: les comparaisons (« une voix de scierie »)، et le rythme des phrases courtes، et la ponctuation vivante. لكن la métaphore لا تحل محل la vérification، ولا يُستعمل le style romanesque لتهيئة قراءة غير موثّقة.","la déontologie تخص le portrait تحديداً: les faits biographiques تبقى قابلة للتحقق، ولا يُنسب إلى الشخصية قولٌ لم يُسجَّل، ويُذكر مصدر les anecdotes. la contre-épreuve — أن يقرأ الشخصية نصّها قبل النشر — أفضل ضمانة مهنية.","تمرين بناء: اختر شخصاً تعرفه، واكتب ثلاث جمل فقط: الجملة الأولى la description المكانية، والثانية l’anecdote القصيرة، والثالثة la citation المباشرة. إن لم تستطع الثالثة، فالمشكل في la préparation de l’entretien لا في الكتابة."],"sub":[{"h":"la focale et la distance","p":["La focale externe garde la neutralité.","La focale interne s’appuie sur des citations.","Le lecteur doit savoir d’où l’on regarde."]},{"h":"l’anecdote et le détail","p":["Un détail vaut mieux qu’un adjectif.","L’anecdote révèle le caractère en une scène.","Ce détail en dit long sur lui."]},{"h":"le style dans la presse","p":["Les images restent au service du fait.","Les phrases courtes rythment le portrait.","Aucun style ne remplace la source."]}]},{"h":"les formules du portrait","p":["« Il n’a jamais su dire non… » — le trait de caractère fondateur.","« Selon ses proches… » — le portrait construit par témoignages.","« Ce détail en dit long. » — la valeur argumentative du détail.","« On le reconnaît à sa façon de… » — l’habitude qui incarne la personne."]},{"h":"التطبيق والتلخيص","p":["تمرين la focale: أعد كتابة نفس المشهد مرتين — مرة من le point de vue externe ومرة من le point de vue interne — ثم حدّد ما تغيّر في le ton.","تمرين le détail: اجمع خمسة تفاصيل عن شخص تعرفه، واختار واحداً فقط يحمل la caractérisation كلها مع تجربة نطقية.","تمرين l’entretien: اكتب أربعة أسئلة مفتوحة تحصل من خلالها على anecdote واحدة قابلة للتوثيق."]}],"pron":[{"w":"le portrait","ipa":"[lə pɔʁ.tʁɛ]","approx":"لُ پورتري"},{"w":"l’anecdote","ipa":"[la.nɛk.dɔt]","approx":"لانْيكْدوط"},{"w":"la focale","ipa":"[la fɔ.kal]","approx":"لا فوكال"}],"vocab":[{"fr":"le portrait","ar":"الرسم التحريري للشخصية","pos":"nom","g":"m","exFr":"Le portrait paraît dans la rubrique société.","ipa":"[lə pɔʁ.tʁɛ]","exAr":"يُنشر الرسم التحريري في ملحق المجتمع."},{"fr":"l’anecdote","ar":"الحادثة الصغيرة المعبّرة","pos":"nom","g":"f","exFr":"Une anecdote éclaire mieux qu’un long développement.","ipa":"[la.nɛk.dɔt]","exAr":"تلقّح حادثة صغيرة أكثر من بسط طويل."},{"fr":"le détail révélateur","ar":"التفصيل الدال","pos":"loc.","g":"m","exFr":"Le détail révélateur tient en une seule phrase.","ipa":"[lə de.tɛj ʁe.ve.la.tœʁ]","exAr":"يكفي التفصيل الدال جملة واحدة."},{"fr":"la focale","ar":"الزاوية السردية","pos":"nom","g":"f","exFr":"La focale externe respecte la distance.","ipa":"[la fɔ.kal]","exAr":"تحترم الزاوية السردية الخارجية المسافة."},{"fr":"brosser","ar":"يرسم بخطوط عامة","pos":"verbe","g":"","exFr":"Il brossait le portrait de son quartier.","ipa":"[bʁɔ.se]","exAr":"كان يرسم صورة حيّه."},{"fr":"esquisser","ar":"يُلمّح أو يبدأ بالرسم","pos":"verbe","g":"","exFr":"L’article esquisse le portrait du nouveau directeur.","ipa":"[ɛs.ki.se]","exAr":"يلمّح المقال برسم المدير الجديد."},{"fr":"le trait","ar":"الصفة البارزة","pos":"nom","g":"m","exFr":"Deux traits suffisent à le faire reconnaître.","ipa":"[lə tʁɛ]","exAr":"تكفي صفتان لتمييزه."},{"fr":"se démarquer","ar":"يتميّز عن غيره","pos":"verbe","g":"","exFr":"Elle se démarque par sa manière d’écouter.","ipa":"[sə de.maʁ.ke]","exAr":"تتميّز بأسلوبها في الإصغاء."},{"fr":"frappant","ar":"لافت للنظر","pos":"adj.","g":"","exFr":"Le plus frappant est son silence.","ipa":"[fʁa.pɑ̃]","exAr":"الأكثر لفتاً هو صمته."},{"fr":"rapporter","ar":"ينقل أو يروي","pos":"verbe","g":"","exFr":"Le journaliste rapporte les propos sans les commenter.","ipa":"[ʁa.pɔʁ.te]","exAr":"ينقل الصحفي الأقوال دون تعليق."},{"fr":"l’entretien","ar":"المقابلة","pos":"nom","g":"m","exFr":"L’entretien a duré deux heures.","ipa":"[lɑ̃.tʁə.mjɛ̃]","exAr":"دامت المقابلة ساعتين."},{"fr":"la contre-épreuve","ar":"المراجعة من طرف المُصوَّر نفسه","pos":"nom","g":"f","exFr":"La contre-épreuve est une garantie déontologique.","ipa":"[la kɔ̃tʁe.pʁœv]","exAr":"المراجعة الضمانة المهنية المنهجية."}],"examples":[{"fr":"Il arrivait toujours en retard, jusqu’au jour où le train a été supprimé.","ar":"كان يصل دائماً متأخراً، حتى في اليوم الذي أُلغي فيه القطار.","note":"l’imparfait de trait et le passé composé d’anecdote"},{"fr":"Ce détail en dit long sur lui.","ar":"هذا التفصيل يقول عنه الكثير.","note":"la valeur argumentative du détail"},{"fr":"Selon ses proches, il relisait ses textes trois fois.","ar":"حسب مقربيه، كان يعيد قراءة نصوصه ثلاث مرات.","note":"le portrait par témoignage"},{"fr":"La focale externe garde la neutralité du récit.","ar":"الزاوية السردية الخارجية تحافظ على محايدة السرد.","note":"le point de vue"},{"fr":"Une voix de scierie, disait-on de lui.","ar":"«صوت منشار»، هكذا كانوا يقولون عنه.","note":"l’image au service du fait"},{"fr":"Il n’a jamais su dire non.","ar":"لم يعرف يوماً أن يقول لا.","note":"le trait de caractère"}],"grammar":[{"tFr":"Le discours rapporté au cœur du portrait","tAr":"النقل المُقتبس في الرسم التحريري","body":["La citation directe (« … », dit-il) donne la parole au personnage et crée le rythme ; la citation indirecte (« il affirme que… ») intègre le propos au récit ; le style indirect libre mélange les deux, sans guillemets ni verbe annonciateur — fréquent dans la presse narrative, mais il exige que le propos soit vérifié.","Les verbes de parole (ajouter, lâcher, marteler, préciser) portent une nuance : l’un dose, l’autre dramatise. Choisir « marteler » plutôt que « préciser » est déjà une interprétation — donc un engagement qui doit rester mesuré."],"ex":[{"fr":"« Je n’ai jamais demandé de faveur », a-t-il déclaré.","ar":"«لم أطلب يوماً امتيازاً»، كما صرّح."},{"fr":"Il affirme que les portes restaient ouvertes toute la nuit.","ar":"يؤكد أن الأبواب بقيت مفتوحة طوال الليل."}]},{"tFr":"L’imparfait de trait et le passé composé d’anecdote","tAr":"المضارع غير التام للصفات والماضي المركّب للحادثة","body":["L’imparfait peint ce qui dure : les habitudes, le décor, le caractère (« il ouvrait toujours la première page »). Le passé composé clôt l’habitude par un événement daté qui révèle la personne (« jusqu’au jour où il a tout quitté »).","Dans la presse écrite, le passé composé remplace le passé simple des récits littéraires : il garde l’actualité de l’événement. L’alternance des deux temps produit l’effet de portrait : la ligne générale d’un côté, la scène qui la confirme de l’autre."],"ex":[{"fr":"Elle relisait ses notes ; ce matin-là, elle les a jetées.","ar":"كانت تعيد قراءة ملاحظاتها؛ وفي ذلك الصباح ألقت بها."},{"fr":"Il vérifiait chaque chiffre, il a refusé de publier sans source.","ar":"كان يتحقق من كل رقم؛ فرفض النشر دون مصدر."}]}],"mistakes":[{"wrong":"accumuler les qualificatifs","right":"choisir un détail révélateur","why":"un fait vaut mieux qu’un adjectif — الوقائع خير من الصفات."},{"wrong":"confondre la focale interne et la focale externe","right":"partir de la focale externe, puis appuyer l’interne sur une citation","why":"la focale interne non fondée transforme le portrait en fiction — الزاوية الداخلية غير المدعومة تحوّل النص إلى خيال."},{"wrong":"inventer des détails pour séduire","right":"ne garder que les détails vérifiés","why":"tout élément biographique relève de la déontologie — كل تفصيل سيرة يخضع للأخلاقيات المهنية."},{"wrong":"donner la parole au seul héros","right":"croiser les témoignages","why":"le portrait à plusieurs voix est plus juste et plus riche — الرسم متعدد الأصوات أدق وأغنى."}],"dialogues":[{"title":"Le détail fondateur","ctx":"صحفيّان يختاران التفصيل الذي سيبني الرسم","lines":[{"who":"Inès","fr":"Ce détail en dit long sur elle.","ar":"هذا التفصيل يقول عنها الكثير."},{"who":"Paul","fr":"Tu préfères l’anecdote du train ou sa façon d’écouter ?","ar":"أتفضّلين حادثة القطار أو طريقة إصغائها؟"},{"who":"Inès","fr":"La seconde, elle est vérifiable.","ar":"الثانية، لأنها قابلة للتحقق."},{"who":"Paul","fr":"Alors on ouvre dessus, sans adjectif.","ar":"إذن نبدأ بها، دون صفة."}]},{"title":"La focale","ctx":"نقاش حول مسافة الكاتب من شخصية المقال","lines":[{"who":"Sami","fr":"On reste à l’extérieur des faits.","ar":"نبقى خارج الوقائع."},{"who":"Lina","fr":"Oui, mais sa pensée peut venir par une citation.","ar":"نعم، لكن فكرته قد تأتي في اقتباس."},{"who":"Sami","fr":"Jamais de focalisation interne sans source.","ar":"لا زاوية داخلية أبداً دون مصدر."},{"who":"Lina","fr":"La contre-épreuve confirmera les propos.","ar":"ستؤكّد المراجعة الأقوال."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما « le détail révélateur » في le portrait؟","opts":["تفصيل صغير يحمل طاقة شخصية كاملة","قائمة من الصفات","عنوان المقال","الصورة المصاحبة"],"a":0,"why":"le détail révélateur condense la caractérisation en un fait concret."},{"t":"fill","skill":"grammar","q":"أكمل بالزمن المناسب: «Il ___ toujours en retard, ce jour-là il a pris l’avion.»","fr":"Il ___ toujours en retard, ce jour-là il a pris l’avion.","ans":"arrivait","why":"l’imparfait peint l’habitude, le passé composé la scène qui la rompt."},{"t":"order","skill":"writing","q":"رتّب: الحادثة الصغيرة تُوضّح الشخصية أكثر من الصفات","words":["L’anecdote","éclaire","le","caractère","mieux","que","les","qualificatifs."],"ans":"L’anecdote éclaire le caractère mieux que les qualificatifs.","why":"comparaison avec que, ordre sujet-verbe-complément."},{"t":"listen","skill":"listening","q":"ما الفرق بين la focale externe وla focale interne؟","opts":["الأولى تصف من خارج الشخصية والثانية تقترب من إدراكها","الأولى للشعر والثانية للخبر","الأولى في الراديو والثانية في التلفاز","لا فرق بينهما"],"a":0,"why":"la focale détermine la distance entre le narrateur et le personnage."},{"t":"translate","skill":"writing","q":"ترجم: «حسب مقربيه، كان يعيد قراءة نصوصه ثلاث مرات.»","ans":"Selon ses proches, il relisait ses textes trois fois.","why":"selon + la source, l’imparfait pour l’habitude."},{"t":"speaking","skill":"speaking","q":"صِف شخصاً تعرفه في ثلاث جمل: la description، ثم l’anecdote، ثم la citation.","target":"focale / anecdote / citation","why":"production guidée des trois pièces du portrait."},{"t":"correct","skill":"grammar","q":"صحّح: «La focale interne permet d’inventer ce qu’il pensait.»","ans":"La focale interne s’appuie sur des propos vérifiés.","why":"la pensée du personnage ne se suppose pas, elle s’attribue à une source."},{"t":"mcq","skill":"reading","q":"أي جملة تُعتبر مخالفة la déontologie في le portrait؟","opts":["« Il devait se sentir coupable. »","« Selon sa collègue, il relisait tout. »","« Il arrivait en retard chaque lundi. »","« Ce détail en dit long. »"],"a":0,"why":"l’état intérieur attribué sans source reste une supposition invérifiable."}],"homework":"اكتب portrait من 200 كلمة عن شخصية محلية: افتتاحية بـla focale externe، وl’anecdote واحدة موثّقة، وثلاث كلمات مقتبسة مع تحديد المتحدّث، ثم اكتب في سطر: أي تفصيل لم تتحقق منه بعد ولماذا.","sources":[{"title":"Ecrire un portrait.","channel":"Le français avec Amal","videoId":"Fm5z_8jHcHg","why":"عرض عملي لكتابة le portrait: اختيار le détail caractéristique، وترتيب les anecdotes، والانتقال بين la description et la citation.","cat":"Presse","level":"C1","main":true},{"title":"4. Le portrait ‑ Une notion littéraire en 2 minutes","channel":"Mme T.","videoId":"zznEMXeXR28","why":"جذور la notion littéraire du portrait: كيف انتقلت من les arts إلى la presse écrite، وكيف تغيّر le pacte de lecture.","cat":"Presse","level":"C1","extra":true},{"title":"NAILA, le portrait journalistique serait-il un art ?","channel":"CFImedias","videoId":"ASxg9RiotLY","why":"سؤال منهجي: إلى أي حد يصبح le portrait إبداعاً دون أن يفقد la véracité؟ نموذج لمناقشة la frontière entre art et information.","cat":"Presse","level":"C1","extra":true}],"supplements":[{"id":"zznEMXeXR28","title":"4. Le portrait ‑ Une notion littéraire en 2 minutes","channel":"Mme T.","why":"جذور la notion littéraire du portrait: كيف انتقلت من les arts إلى la presse écrite، وكيف تغيّر le pacte de lecture.","lang":"fr","dur":3},{"id":"ASxg9RiotLY","title":"NAILA, le portrait journalistique serait-il un art ?","channel":"CFImedias","why":"سؤال منهجي: إلى أي حد يصبح le portrait إبداعاً دون أن يفقد la véracité؟ نموذج لمناقشة la frontière entre art et information.","lang":"fr","dur":2}]},{"id":"c1-t4-l4","fr":"L’enquête","ar":"التحقيق الصحفي: المنهج وحماية المصادر واللغة المحترسة","objectives":["وصف la méthode de l’enquête: le problème، les hypothèses، les sources، les documents","استعمال le langage prudentiel — selon, d’après, serait, pourrait — دون إضعاف الخبر","التمييز بين l’anonymat de la source وla vérification المطلوبة منه","تحرير فقرة تحقيق من 150 كلمة تتضمن مصدرين ووثيقتين وحق الرد"],"sections":[{"h":"الدرس 4: كيف يُبنى تحقيق صحفي — la méthode et le langage prudentiel","video":{"id":"tavhYxieStE","title":"Enquêter : Méthodologie - Avec Fabrice Arfi de Mediapart","channel":"GIJN en Français","why":"جلسة منهجية مع enquêteur محترف: كيف تُبنى les pistes، وكيف تُحمى la source anonyme، وكيف تُتقاطع les documents قبل le publication.","lang":"fr","main":true,"dur":85},"p":["le commencement du travail هو la formulation du problème: سؤال محدّد قابل للإثبات، لا اتهام عام. ثم les hypothèses المكتوبة واحداً تلو الآخر، ثم la cartographie des sources: من يملك الوثيقة؟ من يملك الخبرة؟ ومن يمكنه أن يُكذّب ولماذا؟","القاعدة الأولى في le recoupement: كل معلومة جوهرية تحتاج مصدرين مستقلين — لا اثنين ينقلان عن واحد. la source المستقلة تعني أن لا يعتمد الثاني على الأول؛ وإلا فنحن أمام مصدر واحد بصوتين.","l’anonymat حقّ مهني مشروط: يُمنح حماية الوثائق والتسجيلات، ولا يُكشف لا الاسم ولا الوصف الذي يُعرِّفه. لكن إخفاء الاسم لا يُلغي la vérification: يبقى على le journaliste أن يُثبت صفة المصدر وموثوقيته داخلياً قبل le publication.","la vérification تسير على ثلاث درجات: la preuve documentaire (وثيقة أصلية أو نسخة مُصادق عليها)، ثم la confirmation humaine (شخص حضر)، ثم la contre-épreuve (أن يُواجه الطرف المطروح بالدليل ويُتاح له الرد). النشر قبل la contre-épreuve يفتح الباب أمام la diffamation.","le langage prudentiel يحفظ المسافة بين ما ثبت وما لم يثبت: selon مصدر مُسمّى أو موصوف، وd’après غالباً وثيقة أو تحقيق سابق، وle conditionnel (serait, pourrait) يُبقي الاحتمال قائماً. « Selon nos informations » تعني « لدينا ما يكفي للنشر » ولا تعني أن الخبر ثبت بيقين.","la mise en demeure جزء من la méthode لا ملحق لها: كتابة رسمية تُطلب فيها الإجابة في أجل محدّد، ثم نشر الرد أو الإحالة إليه في العدد نفسه. الصمت في هذا السياق خيار تحريري يجب أن يكون معلَّلاً لا صامتاً."],"sub":[{"h":"la méthode","p":["On part d’un problème, pas d’une rumeur.","Deux sources indépendantes au minimum.","Chaque piste se termine par une preuve."]},{"h":"la source protégée","p":["L’anonymat ne dispense pas de vérifier.","On décrit la source sans la nommer.","La contre-épreuve est obligatoire."]},{"h":"le langage prudentiel","p":["Selon nos informations, deux personnes ont été entendues.","D’après les pièces, le marché serait attribué.","Le conditionnel protège contre la diffamation."]}]},{"h":"les formules de l’enquête","p":["« Selon nos informations… » — le signal d’une enquête aboutie.","« D’après des documents consultés par notre rédaction… » — la preuve documentaire.","« Cette source, que nous ne pouvons pas nommer… » — l’anonymat assumé.","« Nous avons mis en demeure… » — le droit de réponse exercé."]},{"h":"التطبيق والتلخيص","p":["تمرين le recoupement: اقرأ خبراً عنقاصت فيه معلومة جوهرية، وحدّد المصدر الثاني الذي يحتاجه قبل النشر.","تمرين le langage prudentiel: أعد صياغة ثلاثة ادعاءات مستعملين selon ثم d’après ثم le conditionnel، ولاحظ درجة التأكيد.","تمرين la mise en demeure: اكتب كتابة رسمية قصيرة من أربع جمل تطلب فيها جواباً في أجل محدّد."]}],"pron":[{"w":"l’enquête","ipa":"[lɑ̃.kɛt]","approx":"لانكيت"},{"w":"recouper","ipa":"[ʁə.ku.pe]","approx":"ركوبي"},{"w":"l’anonymat","ipa":"[la.nɔ.ni.ma]","approx":"لانونيما"}],"vocab":[{"fr":"l’enquête","ar":"التحقيق الصحفي","pos":"nom","g":"f","exFr":"L’enquête a duré huit mois.","ipa":"[lɑ̃.kɛt]","exAr":"دام التحقيق ثمانية أشهر."},{"fr":"la piste","ar":"الأثر المتتبَّع","pos":"nom","g":"f","exFr":"Cette piste mène à un registre public.","ipa":"[la pist]","exAr":"يقود هذا الأثر إلى سجل عام."},{"fr":"recouper","ar":"يُتقاطع المعلومات ويراجعها","pos":"verbe","g":"","exFr":"Il faut recouper les deux témoignages.","ipa":"[ʁə.ku.pe]","exAr":"يلزم مراجعة الشهادتين وتقاطعهما."},{"fr":"l’anonymat","ar":"إخفاء هوية المصدر","pos":"nom","g":"m","exFr":"L’anonymat de la source est garanti.","ipa":"[la.nɔ.ni.ma]","exAr":"يُكفَّل إخفاء هوية المصدر."},{"fr":"d’après","ar":"بحسب أو وفقاً لـ","pos":"prép.","g":"","exFr":"D’après les pièces, le marché avait été attribué.","ipa":"[da.paʁ]","exAr":"بحسب الوثائق، كان الصفقة قد مُنحت."},{"fr":"mettre en demeure","ar":"يُطالِب رسمياً","pos":"loc. v.","g":"","exFr":"La rédaction a mis le ministère en demeure.","ipa":"[mɛtʁ ɑ̃ də.mœʁ]","exAr":"طالبت هيئة التحرير الوزارة رسمياً."},{"fr":"le document","ar":"الوثيقة","pos":"nom","g":"m","exFr":"Le document établit la date exacte.","ipa":"[lə dɔ.ky.mɑ̃]","exAr":"تثبّت الوثيقة التاريخ الدقيق."},{"fr":"corroborer","ar":"يؤكّد بمصدر مستقل","pos":"verbe","g":"","exFr":"Un second registre corrobore ce récit.","ipa":"[kɔ.ʁɔ.be.re]","exAr":"يؤكّد سجل ثانٍ هذا الرواية."},{"fr":"le démenti","ar":"النفي الرسمي","pos":"nom","g":"m","exFr":"Le communiqué est un démenti formel.","ipa":"[lə de.mɑ̃.ti]","exAr":"البيان نفي رسمي."},{"fr":"présumé","ar":"مُفترض أو يُحتمل","pos":"adj.","g":"","exFr":"Il reste présumé innocent jusqu’à la preuve.","ipa":"[pʁe.zy.me]","exAr":"يبقى مفترض براءة حتى إثبات العكس."},{"fr":"le lanceur d’alerte","ar":"المُبلِّغ عن المخالفات","pos":"nom","g":"m","exFr":"Le lanceur d’alerte a transmis les fichiers.","ipa":"[lə lɑ̃sœʁ dalɛʁt]","exAr":"أحال المُبلِّغ الملفات."},{"fr":"le droit de réponse","ar":"حق الرد","pos":"loc.","g":"m","exFr":"Le droit de réponse paraît dans le même numéro.","ipa":"[lə dʁwa də ʁɛ.pɔns]","exAr":"يظهر حق الرد في العدد نفسه."}],"examples":[{"fr":"Selon nos informations, deux personnes ont été entendues.","ar":"وفق معلوماتنا، أُجريت مقابلة مع شخصين.","note":"l’attribution prudente"},{"fr":"D’après des documents consultés par notre rédaction, le marché avait été attribué.","ar":"بحسب وثائق اطّلع عليها محرّرونا، كان الصفقة قد مُنحت.","note":"la preuve documentaire"},{"fr":"Il faut recouper au moins deux sources indépendantes.","ar":"يلزم مراجعة مصدرين مستقلين على الأقل.","note":"la règle du recoupement"},{"fr":"L’anonymat ne dispense pas de vérifier.","ar":"إخفاء الهوية لا يُعفي من التحقق.","note":"la déontologie de la source"},{"fr":"Cette piste se termine par une preuve, sinon on la laisse.","ar":"ينتهي هذا الأثر بدليل وإلا تُرك.","note":"la méthode"},{"fr":"Nous avons mis le ministère en demeure de répondre.","ar":"طالبنا الوزارة رسمياً بالجواب.","note":"le droit de réponse"}],"grammar":[{"tFr":"Le langage prudentiel : selon, d’après, le conditionnel","tAr":"لغة الاحتياط التحريري: selon وd’après والمضارع الشرطي","body":["Selon introduce la source, nommée ou décrite (« selon la préfecture », « selon une personne présente ») ; d’après renvoie plus souvent à un document ou à une enquête antérieure. Les deux annoncent que le journal rapporte sans garantir.","Le conditionnel (serait, pourrait, aurait) présente l’information comme vraisemblable tant que la preuve n’est pas publique : « le marché aurait été attribué sans appel d’offres ». Il ne diminue pas le sérieux de l’enquête : il marque exactement le degré d’avancement de la preuve."],"ex":[{"fr":"Selon la préfecture, trois routes restent fermées.","ar":"وفق الولاية، تبقى ثلاث طرق مغلقة."},{"fr":"L’attribution du marché aurait été décidée en comité restreint.","ar":"من المحتمل أن منح الصفقة قد تقرر في لجنة مصغّرة."}]},{"tFr":"La syntaxe de l’incertain : subjonctif, nominalisation, passif sans agent","tAr":"صياغة غير اليقين: الشرطى وتحويل الأفعال إلى اسم والمبني للمجهول","body":["Après il est possible que, il reste à établir que, bien que, le subjonctif signale que l’information n’est pas établie : « il reste à établir que les fonds aient été utilisés ». La tournure négative (sans que, ne… pas) refuse l’affirmation tout en conservant le contenu.","La nominalisation et la voix passive permettent d’écrire densement sans accuser : « une attribution sans appel d’offres a été constatée » au lieu d’un nom propre accusé. Le fait passe avant l’actionnaire — c’est la syntaxe de la prudence journalistique."],"ex":[{"fr":"Il reste à établir que les fonds aient été utilisés à bon escient.","ar":"يبقى إثبات أن الأموال قد استُعملت في وجهها الصحيح."},{"fr":"Des écarts de gestion ont été relevés dans deux services.","ar":"رُصدت خروقات تدبيرية في مصلحتين."}]}],"mistakes":[{"wrong":"publier une source anonyme sans recoupement","right":"recouper au moins deux sources indépendantes","why":"l’anonymat n’exonère jamais de la vérification — إخفاء الهوية لا يُعفي من التحقق."},{"wrong":"« Selon notre source, il est coupable »","right":"« Selon deux personnes proches du dossier… »","why":"la source doit être caractérisée, sinon le lecteur ne peut pas juger — يجب وصف المصدر لا إخفاؤه كلّياً."},{"wrong":"confondre le soupçon et la preuve","right":"employer le conditionnel tant que la preuve n’est pas publique","why":"le langage prudentiel protège contre la diffamation — اللغة المحترسة تحمي من التشهير."},{"wrong":"omettre la mise en demeure","right":"mettre en demeure et publier la réponse","why":"la déontologie garantit l’équilibre des droits — المنهجية تضمن توازن الحقوق."}],"dialogues":[{"title":"La source protégée","ctx":"محرّر ورئيس تحرير يُنظّمان حماية مصدر","lines":[{"who":"Farid","fr":"Notre source ne peut pas apparaître.","ar":"لا يمكن لمصدرنا أن يظهر."},{"who":"Élodie","fr":"Alors on la décrit sans la nommer.","ar":"إذن نصفها دون تسميتها."},{"who":"Farid","fr":"Il faut recouper avec un document.","ar":"يلزم مطابقتها بوثيقة."},{"who":"Élodie","fr":"Je prépare la mise en demeure pour demain.","ar":"أُعدّ المطالبة الرسمية لغد."}]},{"title":"Le conditionnel","ctx":"نقاش حول صياغة فقرة قبل النشر","lines":[{"who":"Yasmine","fr":"Tant qu’on n’a pas le document, on reste au conditionnel.","ar":"ما لم نصل إلى الوثيقة، نبقى في المضارع الشرطي."},{"who":"Bruno","fr":"D’après les pièces, le marché a été attribué.","ar":"بحسب الوثائق، مُنحت الصفقة."},{"who":"Yasmine","fr":"Non : « aurait été attribué ».","ar":"لا: «كان يُحتمل منحها»."},{"who":"Bruno","fr":"D’accord, la preuve n’est pas encore publique.","ar":"حسناً، الدليل لم يصبح علنياً بعد."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما وظيفة « d’après » داخل le langage prudentiel؟","opts":["الرجوع إلى وثيقة أو تحقيق سابق","النفي القاطع","التعقيب على الرد","فتح عنوان الخبر"],"a":0,"why":"d’après renvoie à un support documentaire ou à une enquête antérieure."},{"t":"fill","skill":"grammar","q":"أكمل بأداة الإسناد المناسبة: «___ nos informations, deux personnes ont été entendues.»","fr":"___ nos informations, deux personnes ont été entendues.","ans":"Selon","why":"selon introduce la source de l’information rapportée."},{"t":"order","skill":"writing","q":"رتّب: التحقيق يُتقاطع معلوماته من مصدرين مستقلين","words":["L’enquête","recoupe","deux","sources","indépendantes."],"ans":"L’enquête recoupe deux sources indépendantes.","why":"ordre sujet-verbe-complément, l’adjectif se place après le nom."},{"t":"listen","skill":"listening","q":"ما « le droit de réponse » في المنهجية الصحفية؟","opts":["حق نشر ردّ المُشتكى عليه في العدد نفسه","حقّ الصحفي في التعرّض","حقّ القارئ في الاشتراك","حقّ هيئة التحرير في الإحالة"],"a":0,"why":"le droit de réponse équilibre les droits de la personne citée."},{"t":"translate","skill":"writing","q":"ترجم: «بحسب وثائق اطّلع عليها محرّرونا، كان الصفقة قد مُنحت دون منافسة.»","ans":"D’après des documents consultés par notre rédaction, le marché avait été attribué sans appel d’offres.","why":"d’après + le plus-que-parfait pour l’antériorité de la preuve."},{"t":"speaking","skill":"speaking","q":"اشرح في ثلاث جمل الفرق بين selon وd’après، مع مثال لكل واحد.","target":"selon / d’après / conditionnel","why":"production orale sur les outils de l’attribution prudente."},{"t":"correct","skill":"grammar","q":"صحّح: «Le journal affirme que le directeur est coupable.»","ans":"Le journal rapporte que le directeur serait mis en cause.","why":"le soupçon ne s’affirme pas : verbe d’attribution et conditionnel."},{"t":"mcq","skill":"reading","q":"أي عبارة تحترم la présomption d’innocence داخل تحقيق؟","opts":["« Le directeur serait mis en cause. »","« Le directeur a volé les fonds. »","« Le directeur est le responsable. »","« Le directeur ment depuis deux ans. »"],"a":0,"why":"seule la formulation au conditionnel reste compatible avec la preuve à établir."}],"homework":"اختر خبراً فيه تحقيق طويل، واكتب فقرة من 150 كلمة تتضمن: la piste الأولى، ومصدرين مستقلين، ووثيقة واحدة، وجملة واحدة باللغة المحترسة (selon أو d’après أو le conditionnel)، ثم مطلباً بحق الرد.","sources":[{"title":"Enquêter : Méthodologie - Avec Fabrice Arfi de Mediapart","channel":"GIJN en Français","videoId":"tavhYxieStE","why":"جلسة منهجية مع enquêteur محترف: كيف تُبنى les pistes، وكيف تُحمى la source anonyme، وكيف تُتقاطع les documents قبل le publication.","cat":"Presse","level":"C1","main":true},{"title":"Vérifier une information à l’heure des fake news (initiation à l’utilisation des OSINT)","channel":"ESJ Lille","videoId":"Bjzv6qCT_WE","why":"ورشة تطبيقية على أدوات la vérification: البحث العكسي، وفحص الوسائط، وتتبّع أصل الوثيقة قبل le publication.","cat":"Presse","level":"C1","extra":true},{"title":"Vérifier l’info : le fact-checking - Samuel Etienne / Aude WTFake - La Collab' de l’info","channel":"Lumni","videoId":"dkVst4YiHPU","why":"تمرين مختصر على la méthode du fact-checking: كيف يُتحقّق من ادعاء منشور على le réseau دون أن يُعيد نشره.","cat":"Presse","level":"C1","extra":true}],"supplements":[{"id":"Bjzv6qCT_WE","title":"Vérifier une information à l’heure des fake news (initiation à l’utilisation des OSINT)","channel":"ESJ Lille","why":"ورشة تطبيقية على أدوات la vérification: البحث العكسي، وفحص الوسائط، وتتبّع أصل الوثيقة قبل le publication.","lang":"fr","dur":44},{"id":"dkVst4YiHPU","title":"Vérifier l’info : le fact-checking - Samuel Etienne / Aude WTFake - La Collab' de l’info","channel":"Lumni","why":"تمرين مختصر على la méthode du fact-checking: كيف يُتحقّق من ادعاء منشور على le réseau دون أن يُعيد نشره.","lang":"fr","dur":5}]},{"id":"c1-t4-l5","fr":"La chronique d’opinion","ar":"المقال الرأي: الحرية النبرية والتموّه والمرجعية الثقافية","objectives":["التمييز بين la chronique وl’éditorial في le ton et la signature","استعمال les connecteurs de concession — certes… mais, bien que, toutefois — لبناء la nuance","ضبط la digression بحيث تعود إلى le fil principal قبل la chute","استخدام la référence culturell مع تفسيرها داخل النص دون إثقاله"],"sections":[{"h":"الدرس 5: كيف يكتب الصحفي باسمه — le ton personnel et la digression","video":{"id":"bU7MH3vb5tQ","title":"La rédaction d’un article d’opinion","channel":"AMECQ","why":"عرض على le genre opinion: كيف يُبنى المقال من la thèse الشخصية، وكيف يُضبط le ton بين الحرية والمَهْنة قبل le publication.","lang":"fr","main":true,"dur":7},"p":["la chronique مقال قصير موقّع يكتب فيه الصحفي باسمه: الحرية فيه حقيقية — le ton، والصورة، والتموّه — لكنها محكومة بـla signature. الفرق الجوهري مع l’éditorial: الافتتاحية تعبّر عن la ligne du journal، والمقال يعبّر عن le regard d’un auteur.","العنصر المُميِّز للنوع هو la liberté tonale: يُسمح باللحن الشخصي، وبالوصف اليومي، وبالتعجب المتزن. لكن la liberté ليست التزاماً بالأداء: حين تتحول la pointe إلى invective، يفقد النص مصداقيته قبل أن يُمنع من النشر.","la digression هي أداة النوع: التطرق إلى قصة جانبية أو مرجع ثقافي، ثم la promesse المهمة — العودة إلى le fil. القاعدة العملية: كل تموّه يجب أن يدفع النص قدماً، فإن لم يُحدِّث المعنى فهو تطرّف بلا فائدة لا يُقبل في مساحة محدودة.","la référence culturelle تعمل حين تُشرح داخل النص: « comme disait X… » تكفي إذا كان X مألوفاً، وإلا فاشرحه في سطر واحد. المرجع ليس زينة، بل طريقة لاختصار حجّة: يستدعي جسماً كاملاً من الثقافة بدل تفصيله.","البنية النموذجية: la scène اليومية، ثم le commentaire، ثم la digression القصيرة، ثم la chute التي تُعيد توجيه النص نحو سؤاله الأول. la chute في la chronique ليست إعلاناً بل بصمة: جملة يُقال إن كتبها فلان لا غيره.","la déontologie تبقى حاضرة: la liberté du ton لا تعني حرية الإهانة، والمعلومة الشخصية تبقى خاضعة للتحقق، والحق في الرد مضمون. la chronique تناقش le propos cité، لا صاحبه."],"sub":[{"h":"le ton personnel","p":["La chronique assume le « je ».","L’éditorial, lui, porte la voix du journal.","La signature engage l’auteur."]},{"h":"la digression utile","p":["On s’écarte du fil pour mieux y revenir.","La référence culturelle doit s’expliquer.","Toute digression sert la chute."]},{"h":"la nuance et la concession","p":["Certes la mesure est populaire, mais elle coûte cher.","Bien que le débat soit clos, la question reste ouverte.","Le ton reste libre, l’agression non."]}]},{"h":"les formules de la chronique","p":["« Tout est parti d’un détail… » — l’accroche intime.","« On me reprochera de généraliser… » — l’anticipation de l’objection.","« Comme disait X… » — la référence culturelle assumée.","« Voilà pourquoi je n’y crois plus. » — la chute personnelle."]},{"h":"التطبيق والتلخيص","p":["تمرين la digression: اكتب فقرة تخرج فيها عن الموضوع ثلاثة أسطر ثم تعود بجملة تحتوي la nuance.","تمرين la référence: اختر مرجع ثقافياً واحداً وشرّحه في سطر واحد داخل نص من 150 كلمة.","تمرين le ton: أعد كتابة جملة إخبارية ثلاث مرات — مرة neutral، ومرة بـl’ironie، ومرة بـla pointe — ثم حدّد أثر كل صيغة."]}],"pron":[{"w":"la chronique","ipa":"[la kʁɔ.nik]","approx":"لا كرونيك"},{"w":"la digression","ipa":"[la di.ɡʁɛ.sjɔ̃]","approx":"لا ديغريسيون"},{"w":"le ton personnel","ipa":"[lə tɔ̃ pɛʁ.sɔ.nɛl]","approx":"لُ تون بيرسونيل"}],"vocab":[{"fr":"la chronique","ar":"المقال الرأي القصير","pos":"nom","g":"f","exFr":"Sa chronique paraît chaque mardi.","ipa":"[la kʁɔ.nik]","exAr":"يُنشر مقاله كل ثلاثاء."},{"fr":"la digression","ar":"التموّه أو التطرق العرضي","pos":"nom","g":"f","exFr":"La digression dure trois lignes, pas plus.","ipa":"[la di.ɡʁɛ.sjɔ̃]","exAr":"يدوم التموّه ثلاثة أسطر لا أكثر."},{"fr":"le ton personnel","ar":"النبرة الشخصية","pos":"loc.","g":"m","exFr":"Le ton personnel distingue la chronique.","ipa":"[lə tɔ̃ pɛʁ.sɔ.nɛl]","exAr":"يميّز النبرة الشخصية المقال الرأي."},{"fr":"le trait d’esprit","ar":"الظرف أو البديهة","pos":"nom","g":"m","exFr":"Un trait d’esprit relève la fin du texte.","ipa":"[lə tʁɛ dɛs.pɛ̃]","exAr":"ترفع البديهة نهاية النص."},{"fr":"la référence","ar":"المرجع الثقافي","pos":"nom","g":"f","exFr":"La référence s’explique en une ligne.","ipa":"[la ʁe.fʁɑ̃s]","exAr":"يُشرح المرجع في سطر واحد."},{"fr":"assumer","ar":"يتحمّل أو يتبنى","pos":"verbe","g":"","exFr":"Il assume pleinement ce point de vue.","ipa":"[a.sy.me]","exAr":"يتبنى هذا الرأي تاماً."},{"fr":"convenir de","ar":"يُقرّ أو يعترف بـ","pos":"verbe","g":"","exFr":"Elle convient de son erreur en fin de texte.","ipa":"[kɔ̃.vi.ni də]","exAr":"تُقرّ بخطئها في آخر النص."},{"fr":"le propos","ar":"الخطاب أو ما يُقال","pos":"nom","g":"m","exFr":"Le propos reste clair malgré la digression.","ipa":"[lə pʁə.po]","exAr":"يبقى الخطاب واضحاً رغم التموّه."},{"fr":"filer la métaphore","ar":"يُكمل التشبيه حتى النهاية","pos":"loc. v.","g":"","exFr":"Il file la métaphore jusqu’à la chute.","ipa":"[fi.le la me.ta.fɔʁ]","exAr":"يكمل التشبيه حتى المقطع الختامي."},{"fr":"divaguer","ar":"يتوسّع بلا ضابط","pos":"verbe","g":"","exFr":"La chronique divague si le fil se perd.","ipa":"[di.va.ɡe]","exAr":"يتهرّب المقال إن ضاع الخيط العام."},{"fr":"la nuance","ar":"التمييز الدقيق","pos":"nom","g":"f","exFr":"Une nuance évite la caricature.","ipa":"[la nɥɑ̃s]","exAr":"يمنع التمييز الدقيق التهويل."},{"fr":"l’avis tranché","ar":"الرأي القاطع","pos":"loc.","g":"m","exFr":"Il donne son avis tranché sans se cacher.","ipa":"[lə vi tʁɑ̃.ʃe]","exAr":"يُعلن رأيه القاطع دون إخفاء."}],"examples":[{"fr":"Tout est parti d’un détail de rue.","ar":"بدأ كل شيء من تفصيل في الشارع.","note":"l’accroche intime"},{"fr":"Certes la mesure est populaire, mais elle coûte cher.","ar":"نعم، الإجراء شعبي، لكنه مكلف.","note":"la concession"},{"fr":"Bien que le débat soit clos, la question reste ouverte.","ar":"رغم انتهاء الجدال، تبقى القضية مفتوحة.","note":"bien que + le subjonctif"},{"fr":"Comme disait Bernanos, la mémoire est un combat.","ar":"كما قال برنانوس، الذاكرة معركة.","note":"la référence citée"},{"fr":"On me reprochera de généraliser : tant mieux.","ar":"سيُؤخذ عليّ التعميل: وهو ما أريده.","note":"l’anticipation de l’objection"},{"fr":"Tout commence par un détail. Rien de plus.","ar":"يبدأ كل شيء بتفصيل. لا أكثر.","note":"le rythme de la chute"}],"grammar":[{"tFr":"La concession et la nuance : certes… mais, bien que, toutefois","tAr":"التنازل والتلطيف في بناء الرأي","body":["La concession admet une part de vérité adverse avant de reprendre : « Certes la ville grandit, mais elle perd ses trottoirs. » Elle rend le propos crédible et prépare la chute sans agressivité.","Bien que + le subjonctif (« bien que le débat soit clos ») et encore que + l’indicatif marquent la concession ; toutefois, cependant et néanmoins relancent sans répéter « mais ». Dans la chronique, cette architecture remplace la dureté de l’affirmation nue."],"ex":[{"fr":"Bien que le débat soit clos, la question reste ouverte.","ar":"رغم انتهاء الجدال، تبقى القضية مفتوحة."},{"fr":"Certes la mesure est populaire, mais elle coûte cher.","ar":"نعم، الإجراء شعبي، لكنه مكلف."}]},{"tFr":"Le rythme de la chronique : phrase longue, phrase courte, ponctuation","tAr":"إيقاع المقال الرأي: الجملة الطويلة والقصيرة وعلامات الترقيم","body":["La chronique alterne la phrase longue d’analyse et la phrase courte de chute : « C’est ainsi que tout commence. Rien de plus. » Le rythme souligne là où la preuve manque — d’où l’obligation de revenir au fait avant la fin.","La ponctuation — deux-points, tirets, point d’exclamation — orchestre la voix. Employée avec mesure, elle signale l’oralité du propos ; multipliée, elle fait basculer le texte dans l’invective et ruine la crédibilité du chroniqueur."],"ex":[{"fr":"Tout commence par un détail. Rien de plus.","ar":"يبدأ كل شيء بتفصيل. لا أكثر."},{"fr":"La mesure est populaire — elle reste coûteuse.","ar":"الإجراء شعبي — ويبقى مكلفاً."}]}],"mistakes":[{"wrong":"confondre la chronique et l’éditorial","right":"la chronique assume un ton personnel, l’éditorial porte la ligne du journal","why":"la signature n’est pas l’institution — التوقيع ليس المؤسسة."},{"wrong":"accumuler les références sans les expliquer","right":"choisir une seule référence et la rendre accessible","why":"la référence culturelle doit servir le propos, pas l’effacer — المرجع يخدم الخطاب لا يطمسه."},{"wrong":"une digression sans retour","right":"revenir au fil principal avant la chute","why":"la digression se juge à son retour — يُقاس التموّه بعودته إلى الموضوع."},{"wrong":"attaquer la personne citée","right":"discuter les propos cités","why":"la liberté du ton n’est pas la liberté de l’injure — حرية النبرة ليست حرية الإهانة."}],"dialogues":[{"title":"Le fil de la chronique","ctx":"كاتبان يراجعان مقالاً قبل الإرسال","lines":[{"who":"Anaïs","fr":"Je pars d’un détail de rue, comme toujours.","ar":"أبدأ من تفصيل في الشارع، كالعادة."},{"who":"Mehdi","fr":"Et tu reviens au propos avant la fin ?","ar":"وهل تعودين إلى الخطاب قبل النهاية؟"},{"who":"Anaïs","fr":"Oui, la digression tient en trois lignes.","ar":"نعم، التموّه في ثلاثة أسطر."},{"who":"Mehdi","fr":"Parfait, garde la chute personnelle.","ar":"ممتاز، احتفظي بالختام الشخصي."}]},{"title":"La référence","ctx":"نقاش حول مرجع ثقافي داخل المقال","lines":[{"who":"Claire","fr":"Tu cites Proust, mais est-ce accessible ?","ar":"تستشهدين ببروست، لكن هل هو مفهوماً؟"},{"who":"Antoine","fr":"J’ajoute une ligne pour l’expliquer.","ar":"سأضيف سطراً لتفسيره."},{"who":"Claire","fr":"Sinon la référence devient un décor.","ar":"وإلا صار المرجع زينة."},{"who":"Antoine","fr":"D’accord, une seule référence, bien placée.","ar":"حسناً، مرجع واحد في مكانه."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما الفرق الجوهري بين la chronique وl’éditorial؟","opts":["الأولى نبرة شخصية موقّعة والثانية خطّ الجريدة","الأولى للراديو والثانية للمطبوع","الأولى تنقل الأخبار والثانية تعلّق عليها","لا فرق بينهما"],"a":0,"why":"la chronique porte le regard de l’auteur, l’éditorial la ligne du journal."},{"t":"fill","skill":"grammar","q":"أكمل مع الشرطى: «Bien que le débat ___, la question reste ouverte.»","fr":"Bien que le débat ___, la question reste ouverte.","ans":"soit","why":"bien que commande le subjonctif dans la concession."},{"t":"order","skill":"writing","q":"رتّب: النبرة الشخصية تُميّز المقال الرأي","words":["Le","ton","personnel","distingue","la","chronique."],"ans":"Le ton personnel distingue la chronique.","why":"ordre sujet-verbe-complément, l’adjectif épouse le nom."},{"t":"listen","skill":"listening","q":"ما « la digression » داخل la chronique؟","opts":["تموّه قصير يعود بعده النص إلى خطّه","عنوان فرعي","نقاش بين صحفيين","خاتمة طويلة"],"a":0,"why":"la digression s’écarte du fil, mais elle doit y revenir."},{"t":"translate","skill":"writing","q":"ترجم: «نعم، الإجراء شعبي، لكنه مكلف.»","ans":"Certes la mesure est populaire, mais elle coûte cher.","why":"certes… mais structure la concession sans agressivité."},{"t":"speaking","skill":"speaking","q":"اكتب واقرأ فقرة من أربع جمل تبدأ بـ« Tout est parti d’un détail… » وتنتهي بـchute personnelle.","target":"digression / référence / chute","why":"production orale de la structure de la chronique."},{"t":"correct","skill":"grammar","q":"صحّح: «Bien que le débat est clos, la question reste.»","ans":"Bien que le débat soit clos, la question reste ouverte.","why":"bien que + le subjonctif, jamais l’indicatif."},{"t":"mcq","skill":"reading","q":"أي جملة تُعتبر تجاوزاً لحرية la chronique?","opts":["« Celui qui signe ce texte est incompétent. »","« La mesure reste coûteuse. »","« Comme disait X, tout change. »","« Certes, mais… »"],"a":0,"why":"l’attaque personnelle sort du champ de la critique des propos."}],"homework":"اكتب la chronique من 180 كلمة: افتتاحية من تفصيل يومي، وla digression واحدة تعود منها إلى le fil، ومرجعاً ثقافياً مشروحاً في سطر، ثم la chute شخصية — واكتب على الهامش لماذا اخترت le ton الذي اخترته.","sources":[{"title":"La rédaction d’un article d’opinion","channel":"AMECQ","videoId":"bU7MH3vb5tQ","why":"عرض على le genre opinion: كيف يُبنى المقال من la thèse الشخصية، وكيف يُضبط le ton بين الحرية والمَهْنة قبل le publication.","cat":"Presse","level":"C1","main":true},{"title":"40 manières d’exprimer l’opinion en français | Niveau B1 - B2 - C1","channel":"French School TV","videoId":"cAxru9ZGWA0","why":"مخزون واسع من تعبيرات la nuance والرفض والموافقة — يُغني le ton الشخصي داخل la chronique دون تكرار.","cat":"Presse","level":"C1","extra":true},{"title":"Exprimer l’opinion, l’accord, le désaccord en français | Niveau B1 B2","channel":"French School TV","videoId":"hshkh8yAs2A","why":"تدريب على la concession et le désaccord cordial: كيف يُعبّر الصحفي عن خلافه من دون أن يُغلق الحوار.","cat":"Presse","level":"C1","extra":true}],"supplements":[{"id":"cAxru9ZGWA0","title":"40 manières d’exprimer l’opinion en français | Niveau B1 - B2 - C1","channel":"French School TV","why":"مخزون واسع من تعبيرات la nuance والرفض والموافقة — يُغني le ton الشخصي داخل la chronique دون تكرار.","lang":"fr","dur":23},{"id":"hshkh8yAs2A","title":"Exprimer l’opinion, l’accord, le désaccord en français | Niveau B1 B2","channel":"French School TV","why":"تدريب على la concession et le désaccord cordial: كيف يُعبّر الصحفي عن خلافه من دون أن يُغلق الحوار.","lang":"fr","dur":7}]},{"id":"c1-t4-l6","fr":"La revue de presse","ar":"جولة الصحف: التلخيص الإخباري وإعادة الصياغة ومقارنة الخطوط التحريرية","objectives":["تلخيص les unes de ثلاث صحف في فقرة واحدة دون نسخ العناوين","إعادة صياغة le titre الصحفي بـla paraphrase مع الإسناد إلى journaliste","المقارنة بين les lignes éditoriales على حدث واحد بالاعتماد على le choix et l’angle","استعمال les connecteurs de contraste — en revanche, à l’inverse — في تقديم la synthèse"],"sections":[{"h":"الدرس 6: كيف تُقرأ عشرين صحيفة في عشر دقائق — la synthèse et le contraste","video":{"id":"LN-BTCNNynI","title":"Méthode - Revue de presse","channel":"hg guerente","why":"عرض مُقتضب على la méthode de la revue: اختيار les unes، وترتيب les titres، ثم الانتقال بين journals بـconnecteurs واضحة.","lang":"fr","main":true,"dur":3},"p":["la revue de presse خلاصة صباحية تقرأ فيها عدة صحف وتُخرج منها خيطاً واحداً. وظيفتها ليست سرد العناوين بل le tri: أي خبر يحتل la une، وأي زاوية اختار كل journal، وأين تتعارض les lectures.","الخطوة الأولى la sélection: اختر ثلاث صحف بخطوط تحريرية مختلفة، واقرأ les titres وles chapôts فقط — لا المتن. العناوين تكشف le choix: من ذُكر في العنوان؟ وما الفعل المستعمل؟ وهل الأرقام قبل الأسماء؟","la reformulation قاعدة لا استثناء: لا يُنسخ le titre حرفاً بحرف، بل يُعاد بناؤه في جملة واحدة مع الإسناد — « Le quotidien consacre sa une à… »، « Selon… »، « Pour X, il s’agit de… ». هكذا تبقى la propriété الفكرية للجريدة وتحصل أنت على le message.","la comparaison تشتغل على ثلاثة محاور: le choix de la une (الخبر نفسه)، وl’angle (الزاوية)، وle registre (لغة التعليق). حين يتفق جريدتان على le fait ويختلفان على l’interprétation، فالمقارنة ناجحة: الفصل بين le constat et la lecture.","les connecteurs تحمل la synthèse: en substance, pour l’essentiel تُجمّع؛ en revanche, à l’inverse, toutefois تُفارِق؛ encore que تُدخِل استثناءً واحداً. بدون هذه الإشارات تصبح la revue قائمة عناوين لا تحليل.","الخلاصة العملية: افتح الصحف في نافذة واحدة، واكتب ثلاث جمل — الجملة الأولى le point d’accord، والثانية la divergence، والثالثة la question qui reste. إن لم تستطع الثالثة، فالمقارنة لم تُكتمل بعد."],"sub":[{"h":"choisir les unes","p":["On lit les titres avant les articles.","Trois journaux, trois lignes éditoriales.","Le choix de la une révèle la priorité."]},{"h":"reformuler sans plagier","p":["Le quotidien consacre sa une à la réforme.","Selon le journal, le bilan reste mitigé.","On cite, on ne recopie pas."]},{"h":"comparer les lignes","p":["Les deux titres s’accordent sur le fait.","En revanche, l’angle diffère.","En substance, une seule question revient."]}]},{"h":"les formules de la revue de presse","p":["« On ouvre avec… » — l’annonce du premier titre.","« Le quotidien X consacre sa une à… » — l’attribution du journal.","« En substance, les éditoriaux s’accordent sur… » — la synthèse.","« En revanche, Y conteste ce chiffre. » — le contraste des lignes."]},{"h":"التطبيق والتلخيص","p":["تمرين la sélection: افتح ثلاث صحف فرنسية واقرأ les titres فقط، ثم اكتب خمسة أسطر تحدد فيها les priorités الثلاث.","تمرين la reformulation: حوّل ثلاثة عناوين متتالية إلى جمل واحدة مع الإسناد بـ« selon » أو « consacre sa une à ».","تمرين la comparaison: قارن صفين على الحدث نفسه واكتب جملتين — واحدة تجمع وأخرى تُفرّق — ثم حدّد le critère (le choix, l’angle, le registre)."]}],"pron":[{"w":"la revue de presse","ipa":"[la rə.vy də pʁɛs]","approx":"لا روفي دي بريس"},{"w":"la une","ipa":"[la yn]","approx":"لا يون"},{"w":"reformuler","ipa":"[ʁə.fɔʁ.my.le]","approx":"ريفورمولي"}],"vocab":[{"fr":"la revue de presse","ar":"جولة الصحف","pos":"nom","g":"f","exFr":"La revue de presse débute à sept heures.","ipa":"[la rə.vy də pʁɛs]","exAr":"تبدأ جولة الصحف في السابعة."},{"fr":"la une","ar":"الصفحة الأولى","pos":"nom","g":"f","exFr":"Trois journaux partagent la même une.","ipa":"[la yn]","exAr":"تتشارك ثلاث جرائد الصفحة الأولى."},{"fr":"reformuler","ar":"يعيد الصياغة","pos":"verbe","g":"","exFr":"Il reformule le titre en une phrase.","ipa":"[ʁə.fɔʁ.my.le]","exAr":"يعيد صياغة العنوان في جملة."},{"fr":"la ligne éditoriale","ar":"الخط التحريري","pos":"nom","g":"f","exFr":"La ligne éditoriale guide le choix des sujets.","ipa":"[la liɲ e.di.tɔ.ʁjal]","exAr":"يوجّه الخط التحريري اختيار المواضيع."},{"fr":"en substance","ar":"في الجوهر أو باختصار","pos":"loc.","g":"","exFr":"En substance, les deux titres s’accordent.","ipa":"[ɑ̃ sʏb.stɑ̃s]","exAr":"في الجوهر، العنوانان متفقان."},{"fr":"à l’inverse","ar":"على العكس","pos":"loc.","g":"","exFr":"À l’inverse, un autre journal conteste.","ipa":"[a lɛ̃.vɛʁs]","exAr":"على العكس، جريدة أخرى تُنازع."},{"fr":"s’accorder sur","ar":"يتفق بشأن","pos":"loc. v.","g":"","exFr":"Les rédactions s’accordent sur les chiffres.","ipa":"[sa.kɔʁ.de syʁ]","exAr":"تتفق هئيات التحرير على الأرقام."},{"fr":"le titre","ar":"العنوان","pos":"nom","g":"m","exFr":"Le titre tient en huit mots.","ipa":"[lə ti.tʁ]","exAr":"يختصر العنوان في ثماني كلمات."},{"fr":"reprendre","ar":"يتناول من جديد أو ينقل","pos":"verbe","g":"","exFr":"Le journal reprend l’enquête du jour.","ipa":"[ʁə.pʁɑ̃dʁ]","exAr":"تتناول الجريدة تحقيق اليوم من جديد."},{"fr":"la synthèse","ar":"التلخيص المركّب","pos":"nom","g":"f","exFr":"La synthèse tient en trois phrases.","ipa":"[la sɛ̃.tɛz]","exAr":"يختصر التلخيص المركّب في ثلاث جمل."},{"fr":"contester","ar":"يُنازع أو يُتحدى","pos":"verbe","g":"","exFr":"Le parti conteste le bilan officiel.","ipa":"[kɔ̃.te-ste]","exAr":"يُنازع الحزب الحصيلة الرسمية."},{"fr":"l’écho","ar":"الصدى أو التداخل بين الصحف","pos":"nom","g":"m","exFr":"Les unes se répondent en écho.","ipa":"[le.ko]","exAr":"تتردّد صفحات الأولى تبادلاً."}],"examples":[{"fr":"On ouvre avec la une du Figaro.","ar":"نبدأ بصفحة لي فيغارو الأولى.","note":"l’annonce du titre"},{"fr":"Le quotidien consacre sa une à la réforme.","ar":"تكرّس الجريدة صفحتها الأولى للإصلاح.","note":"l’attribution"},{"fr":"En substance, les éditoriaux s’accordent sur le bilan.","ar":"في الجوهر، تتفق الافتتاحيات على الحصيلة.","note":"la synthèse"},{"fr":"En revanche, un autre titre conteste ce chiffre.","ar":"على العكس، عنوان آخر يُنازع هذا الرقم.","note":"le contraste"},{"fr":"Selon le journal, le bilan reste mitigé.","ar":"حسب الجريدة، تبقى الحصيلة متوسطة.","note":"la reformulation attribuée"},{"fr":"Les deux titres s’accordent sur le fait, pas sur l’interprétation.","ar":"يتفق العنوانان على الواقعة لا على التأويل.","note":"le fait et la lecture"}],"grammar":[{"tFr":"Le discours indirect dans la reformulation","tAr":"النقل غير المباشر في إعادة الصياغة","body":["Reformuler revient à passer du discours direct au discours indirect : « Le journal écrit : “La réforme échoue” » devient « Le journal écrit que la réforme échoue ». Les temps se décalent d’un cran, les déictiques changent (ce, ici, aujourd’hui), mais le sens reste.","L’attribution se place avant la proposition : selon, d’après, pour le quotidien, souligne la source. On évite ainsi le plagiat : on cite la propriété intellectuelle du journal tout en produisant sa propre phrase — la condition de toute revue de presse honnête."],"ex":[{"fr":"Le journal écrit que la réforme échoue.","ar":"تكتب الجريدة أن الإصلاح يفشل."},{"fr":"Selon le quotidien, le bilan reste mitigé.","ar":"حسب الجريدة، تبقى الحصيلة متوسطة."}]},{"tFr":"Les connecteurs de synthèse et de contraste","tAr":"أدوات التلخيص والتضاد في جولة الصحف","body":["En substance et pour l’essentiel rassemblent : ils annoncent que l’on quitte les titres pour la conclusion. En revanche, à l’inverse, toutefois marquent la divergence entre deux lignes éditoriales ; encore que fait entrer un seul bémol sans casser l’ensemble.","Ces connecteurs créent la architecture de la revue : un paragraphe d’accord, un paragraphe de désaccord, une ouverture. Le choix de l’outil conditionne la nuance — « en revanche » oppose plus fort que « toutefois », qui suggère une réserve."],"ex":[{"fr":"En substance, les rédactions s’accordent sur les faits.","ar":"في الجوهر، تتفق هئيات التحرير على الوقائع."},{"fr":"À l’inverse, un autre titre met l’accent sur le coût.","ar":"على العكس، عنوان آخر يُركّز على الكلفة."}]}],"mistakes":[{"wrong":"recopier le titre du journal","right":"reformuler en une phrase avec attribution","why":"la revue reformule, elle ne plagie pas — جولة الصحف تعيد الصياغة لا تنسخ."},{"wrong":"confondre le fait et la ligne éditoriale","right":"attribuer l’opinion au journal cité","why":"le lecteur doit savoir qui pense quoi — يجب أن يعرف القارئ من يفكر بماذا."},{"wrong":"comparer sans critère","right":"comparer le choix de la une, l’angle, puis le registre","why":"la comparaison sans critère reste une impression — المقارنة بلا معيار تبقى انطباعاً."},{"wrong":"enchaîner les titres sans lien","right":"annoncer les transitions par les connecteurs","why":"sans connecteurs, la revue devient une liste — دون أدوات ربط تصبح الجولة قائمة."}],"dialogues":[{"title":"L’ouverture de la revue","ctx":"مذيعان يفتتحان جولة الصحف الصباحية","lines":[{"who":"Julie","fr":"On ouvre avec la une du Figaro.","ar":"نبدأ بصفحة لي فيغارو الأولى."},{"who":"Marc","fr":"Le quotidien consacre sa une à la réforme.","ar":"تكرّس الجريدة صفحتها الأولى للإصلاح."},{"who":"Julie","fr":"En substance, les éditoriaux s’accordent.","ar":"في الجوهر، تتفق الافتتاحيات."},{"who":"Marc","fr":"En revanche, un autre titre conteste le chiffre.","ar":"على العكس، عنوان آخر يُنازع الرقم."}]},{"title":"La reformulation","ctx":"محرّران يُعيدان صياغة عناوين قبل البث","lines":[{"who":"Sonia","fr":"Tu reprends le texte mot à mot ?","ar":"هل تنقل النص حرفاً بحرف؟"},{"who":"Théo","fr":"Non, je reformule en une phrase.","ar":"لا، أعيد الصياغة في جملة واحدة."},{"who":"Sonia","fr":"Il faut citer le journal quand même.","ar":"يجب ذكر الجريدة على أي حال."},{"who":"Théo","fr":"D’accord : « selon le quotidien… ».","ar":"حسناً: «حسب الجريدة…»."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما وظيفة « la revue de presse »؟","opts":["تلخيص عناوين صحف متعددة ومقارنتها","نسخ مقال كامل","إعلان مدفوع","مقابلة مصورة"],"a":0,"why":"la revue synthétise et compare, elle ne reproduit pas les articles."},{"t":"fill","skill":"grammar","q":"أكمل بأداة التلخيص: «___, les éditoriaux s’accordent sur le bilan.»","fr":"___, les éditoriaux s’accordent sur le bilan.","ans":"En substance","why":"en substance annonce la conclusion après les titres."},{"t":"order","skill":"writing","q":"رتّب: الجريدة تكرّس صفحتها الأولى للإصلاح","words":["Le","quotidien","consacre","sa","une","à","la","réforme."],"ans":"Le quotidien consacre sa une à la réforme.","why":"consacrer quelque chose à quelque chose, ordre sujet-verbe-complément."},{"t":"listen","skill":"listening","q":"ما « la ligne éditoriale » في المقارنة؟","opts":["الخط الذي يوجّه اختيار المواضيع والزوايا","خط الكتابة اليدوية","قائمة المشتركين","موعد الصدور"],"a":0,"why":"la ligne éditoriale fixe la façon dont le journal choisit et interprète."},{"t":"translate","skill":"writing","q":"ترجم: «على العكس، عنوان آخر يُنازع هذا الرقم.»","ans":"En revanche, un autre titre conteste ce chiffre.","why":"en revanche marque le contraste entre deux lignes."},{"t":"speaking","skill":"speaking","q":"قدّم جولة صحف من ثلاث جمل: نقطة الاتفاق، ثم نقطة الخلاف، ثم السؤال المفتوح.","target":"en substance / en revanche / la question","why":"production orale structurée par les connecteurs de synthèse."},{"t":"correct","skill":"grammar","q":"صحّح: «Je reprends le titre : “La réforme échoue”.»","ans":"Je reformule : le journal écrit que la réforme échoue.","why":"la reformulation attribuée évite le plagiat du titre."},{"t":"mcq","skill":"reading","q":"أي مقارنة تُعدّ صحيحة بين صفين على الحدث نفسه؟","opts":["اليومان يذكران الحدث نفسه بزاويتين مختلفتين","الأول ينقل خبراً والثاني إعلاناً","أحدهما عن رياضة والآخر عن طقس","أحدهما اقتباس والآخر دعوة"],"a":0,"why":"la comparaison n’a de sens que sur un fait commun et des lectures différentes."}],"homework":"اقرأ les unes من ثلاث صحف فرنسية مختلفة، ثم اكتب فقرة من 150 كلمة: جملة تبدأ بـ« En substance »، وجملة تبدأ بـ« En revanche »، وجملة ختامية تسأل سؤالاً مفتوحاً — مع إعادة صياغة كل عنوان ونسبته إلى جريدته.","sources":[{"title":"Méthode - Revue de presse","channel":"hg guerente","videoId":"LN-BTCNNynI","why":"عرض مُقتضب على la méthode de la revue: اختيار les unes، وترتيب les titres، ثم الانتقال بين journals بـconnecteurs واضحة.","cat":"Presse","level":"C1","main":true},{"title":"La ligne éditoriale d’un journal-Presse écrite","channel":"Bi-Hamidi","videoId":"D4988R_JcJo","why":"توضيح la ligne éditoriale كمعيار للمقارنة: كيف يوجّه الموقف العام اختيار les sujets وl’angle.","cat":"Presse","level":"C1","extra":true},{"title":"Déchiffrer la Une des journaux","channel":"Mon Prof IA","videoId":"llseA5_EKWU","why":"تدريب على قراءة la une كنصّ واحد: le choix، et la hiérarchie، et les mots-clés قبل الدخول في le corps.","cat":"Presse","level":"C1","extra":true}],"supplements":[{"id":"D4988R_JcJo","title":"La ligne éditoriale d’un journal-Presse écrite","channel":"Bi-Hamidi","why":"توضيح la ligne éditoriale كمعيار للمقارنة: كيف يوجّه الموقف العام اختيار les sujets وl’angle.","lang":"fr","dur":4},{"id":"llseA5_EKWU","title":"Déchiffrer la Une des journaux","channel":"Mon Prof IA","why":"تدريب على قراءة la une كنصّ واحد: le choix، et la hiérarchie، et les mots-clés قبل الدخول في le corps.","lang":"fr","dur":7}]}]},{"id":"c1-t5","slug":"argumentation-rhetorique","icon":"target","color":"#e11d48","fr":"Argumentation & rhétorique","ar":"الحجاج والبلاغة","desc":"les sophismes، la concession، les figures de style، le débat، la prise de parole، la thèse complexe.","lessons":[{"id":"c1-t5-l1","fr":"Sophismes et biais cognitifs","ar":"الحجّات المغلوطة والتحيّزات المعرفية","objectives":["التعرّف على ثلاث حجّات مغلوطة أساسية: l’homme de paille, la fausse dichotomie, le biais de confirmation","تمييز la thèse المُثبَتة من la contre-thèse في نقاش فرنسي سريع","تسمية الخطأ الديموغوجي بتسمية صحيحة بالفرنسية عند الردّ","صياغة رفض مُنقَّح لا يُسقط النقاش: la réfutation au lieu de l’agression"],"sections":[{"h":"الدرس 1: كيف تكشف التحجّة المغلوطة وتسمّيها باسمها","video":{"id":"3brE46isq5A","title":"TOUS les raisonnements fallacieux en 10 minutes","channel":"Chat Sceptique","why":"عرض مُجمَّع لأهم les raisonnements fallacieux في عشر دقائق: كيف تتشكّل la fausse dichotomie وl’amalgame وla pétition de principe، وكيف تُفرَّق بين حجّة صحيحة وحجّة مغلوطة في لحظة.","lang":"fr","main":true,"dur":10},"p":["الحجّة المغلوطة بالفرنسية le sophisme: جملة تبدو منطقية لكنّها تنطوي على عيب في la structure du raisonnement. الخطأ الأول ل المتعلّم أنه يردّ على الفكرة مباشرة؛ والصحيح أن يُسمّي الخطأ أولاً: « Ce n’est pas un argument, c’est un sophisme. » — التسمية وحدها تُفكّ التحجّة.","l’homme de paille: أن تُقوِّل خصمه موقفاً أضعف مما قاله ثم تُسقطه. عبارات الكشف: « Tu déformes ma pensée », « Ce n’est pas ce que j’ai dit ». لاحظ أنّ الردّ يبدأ بـ le rectificatif لا بle reproche، وهذا فارق مهم في le registre soutenu.","la fausse dichotomie: تقديم خيارين فقط على أنهما الاحتمالان الوحيدان: « Soit on supprime les voitures, soit on accepte la pollution. » الحجّة الصحيحة تُعيد بناء l’éventail: « Il existe un troisième terme : limiter la circulation. »","le biais de confirmation: ميل العقل إلى البحث عمّا يُؤكّد رأيه وتجاهل ما يُناقِضه. في le débat، يظهر كـ l’échantillon complaisant: الاستشهاد بأمثلة مختارة فقط. التصحيح يأتي بـ le contre-exemple الوحيد الصريح لا بالهجوم.","منهجية la détection: اقرأ الجملة ثلاث مرات — الأولى لمعرفة la thèse، والثانية لتحديد le lien logique بين الأجزاء، والثالثة للسؤال: هل يتحمل la conclusion ما قبلها فعلاً؟ إذا لم يظهر le lien، فالحجّة مغلوطة مهما كان لفظها فصيحاً.","بعد la détection comes la nomination: احفظ ثلاث تسميات دقيقة — « c’est une pétition de principe » (أنت تفترض ما عليك إثباته)، « c’est un amalgame » (تربط أمرين مختلفين)، « c’est un faux dilemme » (تتجاهل الحلول الوسيطة). التسمية الدقيقة ترفع النقاش من la dispute إلى l’analyse."],"sub":[{"h":"détecter la faille logique","p":["L’argument repose sur un lien logique fragile.","La conclusion ne découle pas des prémisses.","On demande : quelle est la prémisse cachée ?"]},{"h":"nommer le sophisme","p":["Ce n’est pas un argument, c’est un homme de paille.","Vous présentez un faux dilemme.","C’est une pétition de principe : vous supposez ce que vous devez prouver."]},{"h":"déjouer le biais de confirmation","p":["Vous ne citez que les exemples qui vous arrange.","Cherchez le contre-exemple, même gênant.","Un raisonnement honnête accorde la nuance."]}]},{"h":"nommer pour réfuter","p":["« Ce n’est pas un argument, c’est un sophisme. » — la rectification frontale mais polie.","« Vous déformez ma pensée : je n’ai jamais dit que… » — la réfutation de l’homme de paille.","« La question est plus nuancée : il existe un troisième terme. » — la réponse à la fausse dichotomie.","« Si l’on va au bout de votre raisonnement, on aboutit à une impasse. » — la réduction à l’absurde, elle-même discutable."]},{"h":"التطبيق والتلخيص","p":["تمرين le repérage: اقرأ افتتاحية تحريرية قصيرة وحدّد le type de sophisme المستعمل فيها — ضع الكلمة الفرنسية الدقيقة تحت الجملة.","تمرين la contre-preuve: اختر رأياً تؤيّده وابحث عن contre-exemple واحد صريح يُناقِضه، ثم اكتبه في جملة تبدأ بـ « Certes… ».","تمرين la reformulation: حوّل جملة اتهامية (« Vous ne pensez qu’à… ») إلى جملة تحليلية بأسلوب مُثقَّف: « Votre raisonnement sélectionne les exemples qui… »."]}],"pron":[{"w":"le sophisme","ipa":"[lə sɔ.fism]","approx":"لُ صوفيسْم"},{"w":"le biais","ipa":"[lə bjɛ]","approx":"لُ بييه"},{"w":"la réfutation","ipa":"[la ɛ̃.fy.ta.sjɔ̃]","approx":"لا ريفوتاسيون"}],"vocab":[{"fr":"le sophisme","ar":"الحجّة المغلوطة","pos":"nom","g":"m","exFr":"Ce raisonnement n’est qu’un sophisme.","ipa":"[sɔ.fism]","exAr":"هذا الاستدلال مجرّد حجّة مغلوطة."},{"fr":"l’homme de paille","ar":"رجل القشّ (تقويل الخصم)","pos":"loc.","g":"m","exFr":"Réfuter un homme de paille, c’est gagner un faux débat.","ipa":"[ɔm də paj]","exAr":"إلقاء رجل القشّ يعني ربح نقاش وهمي."},{"fr":"la fausse dichotomie","ar":"المفارقة الزائفة (الاختيار المزدوج المُضلِّل)","pos":"nom","g":"f","exFr":"Cette phrase impose une fausse dichotomie.","ipa":"[fos di.kɔ.tɔ.mi]","exAr":"هذه العبارة تفرض اختياراً مزدوجاً مُضلِّلاً."},{"fr":"le biais de confirmation","ar":"التحيّز التأكيدي","pos":"nom","g":"m","exFr":"Le biais de confirmation fausse le jugement.","ipa":"[bjɛ də kɔ̃.fiʁ.ma.sjɔ̃]","exAr":"التحيّز التأكيدي يُشوِّه الحكم."},{"fr":"la pétition de principe","ar":"الاستدلال الدائري (طلب المُثبَت)","pos":"nom","g":"f","exFr":"Ce texte commence par une pétition de principe.","ipa":"[pe.ti.sjɔ̃ də pʁɛ̃.sip]","exAr":"يبدأ هذا النص باستدلال دائري."},{"fr":"l’amalgame","ar":"الخلط والدمغ غير المشروع","pos":"nom","g":"m","exFr":"Il fait un amalgame entre deux phénomènes distincts.","ipa":"[a.mal.game]","exAr":"يخلط بين ظاهرتين مختلفتين."},{"fr":"le raisonnement fallacieux","ar":"الاستدلال المُضلِّل","pos":"nom","g":"m","exFr":"Ce raisonnement fallacieux séduit par sa forme.","ipa":"[ʁɛ.zɔ.nə.mɑ̃ fa.la.sjø]","exAr":"هذا الاستدلال المُضلِّل يُغري بشكله."},{"fr":"le contre-exemple","ar":"المثال المُناقِض","pos":"nom","g":"m","exFr":"Un seul contre-exemple suffit à l’ébranler.","ipa":"[kɔ̃tʁ.ɛɡ.zɑ̃.pl]","exAr":"مثال مُناقِض واحد يكفي لهزّه."},{"fr":"nuancer","ar":"يُنقِّح ويُشرِّط","pos":"verbe","g":"","exFr":"Il faut nuancer cette affirmation trop tranchée.","ipa":"[ny.ɑ̃.se]","exAr":"يجب تليين هذا التأكيد الحادّ."},{"fr":"dénoncer","ar":"يُفصح عن وتُبَيّن","pos":"verbe","g":"","exFr":"Elle a dénoncé la faille de l’argument.","ipa":"[de.nɔ̃.se]","exAr":"فصحت عن العيب في الحجّة."},{"fr":"le faux dilemme","ar":"المعضلة الزائفة","pos":"nom","g":"m","exFr":"Présenter deux solutions comme les seules, c’est un faux dilemme.","ipa":"[fo di.lɛm]","exAr":"عرض حلّين بوصفهما الوحيدَين معضلة زائفة."},{"fr":"le lien logique","ar":"الرابط المنطقي","pos":"nom","g":"m","exFr":"Sans lien logique, la conclusion s’effondre.","ipa":"[ljɛ̃ lɔ.ʒik]","exAr":"بدون رابط منطقي ينهار الاستنتاج."}],"examples":[{"fr":"Ce n’est pas un argument, c’est un sophisme.","ar":"هذه ليست حجّة بل حجّة مغلوطة.","note":"la rectification frontale"},{"fr":"Vous déformez ma pensée : je n’ai jamais dit cela.","ar":"أنت تُشوِّه فكرتي؛ لم أقل ذلك قط.","note":"réfuter l’homme de paille"},{"fr":"Il existe un troisième terme entre les deux.","ar":"يوجد ثالث بين الخيارين.","note":"répondre à la fausse dichotomie"},{"fr":"Votre exemple est choisi à l’avance.","ar":"مثلك مُنتقى سلفاً.","note":"le biais de confirmation"},{"fr":"Bien que votre thèse soit séduisante, elle reste fragile.","ar":"مع أنّ ثبتك جذّابة، فإنّها ما تزال هشّة.","note":"la concession avant la réfutation"},{"fr":"Un seul contre-exemple suffit à infirmer cette loi.","ar":"مثال مُناقِض واحد يكفي لنفي هذه القاعدة.","note":"la logique du contre-exemple"}],"grammar":[{"tFr":"Nier puis réorienter : « Il ne s’agit pas de …, il s’agit de … »","tAr":"الإنكار ثم إعادة التوجيه: ليس المسألة في... بل المسألة في...","body":["Cette structure à deux temps est l’arme la plus propre de la réfutation : on retire d’abord le terrain à l’adversaire, puis on replace le débat sur le bon plan. « Il ne s’agit pas de supprimer les transports, il s’agit de les rendre sobres. »","La première proposition se construit avec la négation simple (ne … pas), la seconde reprend le même verbe ou le verbe rectifier. On peut varier : « Ce n’est pas une question de …, c’est une question de … ». Le pronom « en » remplace souvent le complément supprimé : « Il ne s’agit pas d’y renoncer. »"],"ex":[{"fr":"Il ne s’agit pas de nier les chiffres, il s’agit de les interpréter.","ar":"لا تكمن المسألة في إنكار الأرقام بل في تفسيرها."},{"fr":"Ce n’est pas une question de volonté, c’est une question de méthode.","ar":"ليست المسألة إرارة بل منهجية."}]},{"tFr":"Le subjonctif de l’incertitude : bien que, il est douteux que, encore que","tAr":"المضارع التامّ في تعبيرات الشكّ والاحتمال","body":["Toute thèse affaiblie passe par le subjonctif : « bien que le raisonnement semble solide, il repose sur une prémisse non vérifiée. » Les tournures impersonnelles (il est douteux que, il est peu probable que, sans que) exigent elles aussi le subjonctif.","À l’écrit comme à l’oral, ce recours marque la honnêteté intellectuelle : on n’attaque pas l’adversaire, on attaque le degré de certitude de son propos. Comparez « votre preuve est fausse » (accusation) et « il est douteux que votre preuve suffise » (analyse)."],"ex":[{"fr":"Bien que la statistique soit récente, elle ne prouve rien.","ar":"مع أنّ الإحصائية حديثة، فإنّها لا تُثبت شيئاً."},{"fr":"Il est peu probable que cet exemple soit représentatif.","ar":"من غير المرجَّح أن يكون هذا المثال ممثِّلاً."}]}],"mistakes":[{"wrong":"répondre à l’attaque personnelle par une autre attaque","right":"nommer le sophisme avant de répondre","why":"la nomination coupe court à la escalade : « c’est un homme de paille » — تسمية الخطأ تمنع تصاعد الخصومة."},{"wrong":"croire qu’un raisonnement faux est forcément mal formulé","right":"séparer la forme correcte du fond invalide","why":"les sophismes les plus efficaces sont élégamment formulés — أكثر الحجّات المغلوطة صياغةً أنيقة."},{"wrong":"chercher uniquement les preuves qui confirment son avis","right":"chercher activement le contre-exemple","why":"le biais de confirmation est le piège du débatteur — التحيّز التأكيدي فخّ المُحاور."},{"wrong":"« Soit vous êtes d’accord, soit vous refusez. »","right":"« Il y a peut-être une troisième voie. »","why":"la fausse dichotomie ferme le débat au lieu de l’ouvrir — الاختيار المزدوج المُضلِّل يُغلق النقاش."}],"dialogues":[{"title":"Repérer l’homme de paille","ctx":"نقاش بين طالبين في نادٍ للجدال حول قاعدة جديدة في الجامعة","lines":[{"who":"Élise","fr":"Tu soutiens donc qu’il faille supprimer tous les examens.","ar":"إذن أنت تؤيّد إلغاء كل الامتحانات."},{"who":"Mehdi","fr":"Non : tu déformes ma pensée, je n’ai jamais dit cela.","ar":"لا؛ أنت تُشوِّه فكرتي، لم أقل ذلك قط."},{"who":"Élise","fr":"D’accord, reformule ta thèse en une phrase.","ar":"حسناً، صُغ ثبتك في جملة واحدة."},{"who":"Mehdi","fr":"Je dis seulement que l’évaluation doit être continue.","ar":"أقول فقط إنّ التقويم يجب أن يكون مستمراً."}]},{"title":"Sortir du faux dilemme","ctx":"محاضِر وطالبة يناقشان نتيجة استبيان في درس التحليل النقدي","lines":[{"who":"Professeure","fr":"Vous présentez deux solutions comme les seules possibles.","ar":"أنتِ تعرضين حلَّين وكأنهما الوحيدان الممكنان."},{"who":"Nora","fr":"Je pensais avoir couvert le sujet.","ar":"ظننتُ أنّي غطّيت الموضوع."},{"who":"Professeure","fr":"C’est un faux dilemme : il existe des mesures intermédiaires.","ar":"هذه معضلة زائفة؛ توجد إجراءات وسيطة."},{"who":"Nora","fr":"Je vais donc ajouter un troisième terme.","ar":"سأضيف إذن خياراً ثالثاً."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما المقصود بـ « l’homme de paille » في نقاش فرنسي؟","opts":["تقويل الخصم موقفاً أضعف ثم إسقاطه","الاستشهاد بخبرة شخصية","الاعتراف بجدّة objection المعاكسة","اختصار الحجّة في جملة"],"a":0,"why":"l’homme de paille = déformer la thèse adverse pour la rendre plus facile à réfuter."},{"t":"fill","skill":"grammar","q":"أكمل: «Ce n’est pas un argument, c’est un ___ .»","fr":"Ce n’est pas un argument, c’est un ___.","ans":"sophisme","why":"التركيب النفي ثم الإثبات يُستعمل لتصحيح التسمية قبل الردّ."},{"t":"order","skill":"writing","q":"رتّب: توجد خيار ثالث بين الاثنين","words":["Il","existe","un","troisième","terme."],"ans":"Il existe un troisième terme.","why":"ordre impersonnel : sujet (il) + verbe (existe) + complément."},{"t":"listen","skill":"listening","q":"ما التسمية الدقيقة لعبارة « either you agree or you refuse »؟","opts":["la fausse dichotomie","la concession","la gradation","l’accumulation"],"a":0,"why":"fausse dichotomie = présenter deux alternatives comme les seules possibles."},{"t":"translate","skill":"writing","q":"ترجم: «أنت تُشوِّه فكرتي؛ لم أقل ذلك قط.»","ans":"Tu déformes ma pensée : je n’ai jamais dit cela.","why":"le présent (déformes) + le passé composé négatif (n’ai jamais dit)."},{"t":"speaking","skill":"speaking","q":"ادعُ صاحب مقال انتهى إلى نتيجة متطرّفة، واردها بتسمية الخطأ ثم بتصحيحه.","target":"sophisme / fausse dichotomie / troisième terme","why":"إنتاج لغوي مُنقَّح: تسمية أولاً ثم إعادة بناء."},{"t":"correct","skill":"grammar","q":"صحّح الجملة: «Bien que l’exemple soit récent, mais il ne prouve rien.»","ans":"Bien que l’exemple soit récent, il ne prouve rien.","why":"« bien que » introduce le subjonctif et n’admet pas « mais » après la virgule."},{"t":"writing","skill":"writing","q":"اكتب ثلاثة أسطر تكشف فيهما bias de confirmation في استشارة زملائك.","target":"biais de confirmation / contre-exemple / échantillon","why":"الكتابة النقدية تُدرِّب على التعرّف على الاختيار التأكيدي للمعلومات."}],"homework":"اقرأ افتتاحية من 120 كلمة، حدّد فيها نوع الحجّة المغلوطة، اكتب سطرين بالفرنسية تكشف فيهما الخطأ وتقترحان صياغة بديلة مستعملة le subjonctif.","sources":[{"title":"TOUS les raisonnements fallacieux en 10 minutes","channel":"Chat Sceptique","videoId":"3brE46isq5A","why":"عرض مُجمَّع لأهم les raisonnements fallacieux في عشر دقائق: كيف تتشكّل la fausse dichotomie وl’amalgame وla pétition de principe، وكيف تُفرَّق بين حجّة صحيحة وحجّة مغلوطة في لحظة.","cat":"Rhétorique","level":"C1","main":true},{"title":"#6 Le sophisme de l’homme de paille","channel":"L’esprit critique","videoId":"zNfSQfsBPgY","why":"تحليل مُعمَّق لحجة واحدة: كيف يُبنى الرجل القشّ في النقاش وكيف يُفكّ بسطر واحد.","cat":"Rhétorique","level":"C1","extra":true},{"title":"Sophisme ou biais cognitif ?","channel":"SAMY","videoId":"R_8ybDZZMyA","why":"الفرق الدقيق بين sophisme (خطأ في الاستدلال) وbiais (خطأ في العادة الذهنية) — أساس الدرس.","cat":"Rhétorique","level":"C1","extra":true}],"supplements":[{"id":"zNfSQfsBPgY","title":"#6 Le sophisme de l’homme de paille","channel":"L’esprit critique","why":"تحليل مُعمَّق لحجة واحدة: كيف يُبنى الرجل القشّ في النقاش وكيف يُفكّ بسطر واحد.","lang":"fr","dur":8},{"id":"R_8ybDZZMyA","title":"Sophisme ou biais cognitif ?","channel":"SAMY","why":"الفرق الدقيق بين sophisme (خطأ في الاستدلال) وbiais (خطأ في العادة الذهنية) — أساس الدرس.","lang":"fr","dur":9}]},{"id":"c1-t5-l2","fr":"Concession et réfutation","ar":"التنازل والدحض","objectives":["التعرّف على les articulateurs avancés: certes… mais, en dépit de, il n’en demeure pas moins","التمييز بين la concession (قبول جزئي) وla réfutation (ردّ كامل) في نص مكتوب","ترتيب le mouvement logique: thèse → objection → concession → rectification","إنتاج فقرة مُنقَّحة من ثلاث جمل تُظهر la force de l’adversaire قبل تفنيدها"],"sections":[{"h":"الدرس 2: كيف تُنازل قبل أن تُدحض دون أن تفقد المبادرة","video":{"id":"GC8uisYOehk","title":"Concession, réfutation. Stratégie argumentative.","channel":"@françaislangue","why":"شرح مباشر للفرق بين la concession وla réfutation مع نماذج من le débat d’idées: متى تُنازل، ومتى تردّ، وكيف يتحوّل la connecteur من جسر إلى سلاح.","lang":"fr","main":true,"dur":7},"p":["la concession مناورة خطابية: تُقدّم قوة حجّة الخصم كما هي، ثم لا تُسقطها بالقوة بل بـ le déplacement du terrain. عبارتها النموذجية: « Certes, votre chiffre est exact, mais il ne mesure pas le phénomène. »","la réfutation تعمل من الداخل: تُثبت أنّ le lien entre la prémisse et la conclusion مقطوع. Elle ne dit pas « vous avez tort »، بل « votre conclusion ne découle pas de votre prémisse ». هذا الفرق بين le désaveu et l’analyse هو جوهر le registre soutenu.","المجموعة الأولى: certes… mais / sans doute… toutefois / il est vrai que… néanmoins. كلٌّ منها يفتح باباً ثم يُغلقه: la structure est toujours concessive + adversative. القاعدة: لا تجمع بين « certes » و« mais » في جملتين مستقلتين، فاللفظتان تحملان وظيفة واحدة.","المجموعة الثانية: en dépite de / malgré / pour tout ce qui (préposition + nom) — تعبير عن la contrainte: « En dépit des critiques, l’auteur maintient sa thèse. » لاحظ que « en dépit de » تسبق الاسم أو الضمير فقط، لا الفعل.","المجموعة الثالثة: il n’en demeure pas moins que / cela dit / quoi qu’il en soit — وظيفتها la relance: الاعتراف بما سبق ثم إعادة فتح la question على مستوى أعلى. هذه العبارات هي التي تمنح le discours sa respiration، وهي المطلوبة في le compte rendu وla dissertation.","منهجية la pratique: اكتب الجملة الأقوى للخصم أولاً كما قالها هو — la règle de la charité — ثم افرض عليها la réfutation. النصّ الذي يُضعف حجّة الخصم قبل الردّ يبدو أقوى من النصّ الذي يتجاوزها؛ فالمُقابِل يرى أنّه سُمع، فيصبح la terrain de la persuasion مُهيّأً."],"sub":[{"h":"concéder sans céder","p":["Certes, votre chiffre est exact.","Il est vrai que l’expérience est limitée.","Sans doute avez-vous raison sur ce point précis."]},{"h":"réfuter à partir de la prémisse","p":["Votre conclusion ne découle pas de votre prémisse.","Le raisonnement saute une étape décisive.","L’objection porte sur la méthode, pas sur le fond."]},{"h":"relancer après la concession","p":["Il n’en demeure pas moins que la question reste ouverte.","En dépit de ces réserves, l’essentiel tient.","Cela dit, le débat mérite d’être poursuivi."]}]},{"h":"les articulateurs de la nuance","p":["« Certes… mais… » — la concession brève, la plus courante à l’oral.","« Il est vrai que… néanmoins… » — la concession solennelle, propre à l’écrit.","« En dépit de… » — la contrainte assumée (préposition + nom).","« Il n’en demeure pas moins que… » — la relance qui rouvre le débat."]},{"h":"التطبيق والتلخيص","p":["تمرين la chaîne: حوّل جملة اعتراضية بسيطة إلى سلسلة من ثلاث جمل — la concession ثم la rectification ثم la conclusion.","تمرين la correction: ابحث في نص من le BAC عن مواضع يُمكن استبدال « mais » فيها بـ « toutefois » أو « néanmoins » ولاحظ تغيّر le registre.","تمرين l’oral: سجّل دقيقة واحدة تُنازل فيها في حجة ثم تُدحضها مستعملًا certes… mais وil n’en demeure pas moins."]}],"pron":[{"w":"la concession","ipa":"[la kɔ̃.sɛ.sjɔ̃]","approx":"لا كونسيسيون"},{"w":"certes","ipa":"[sɛʁt]","approx":"سيرت"},{"w":"néanmoins","ipa":"[ne.ɑ̃.mwɛ̃]","approx":"نيانمواان"}],"vocab":[{"fr":"concéder","ar":"يُنازل ويعترف بجزء من","pos":"verbe","g":"","exFr":"L’auteur concède un point à ses adversaires.","ipa":"[kɔ̃.se.de]","exAr":"يعترف المؤلف بنقطة لخصومه."},{"fr":"la concession","ar":"التنازل الخطابي","pos":"nom","g":"f","exFr":"La concession précède toujours la réfutation.","ipa":"[kɔ̃.sɛ.sjɔ̃]","exAr":"يسبق التنازل الخطابي الدحض دائماً."},{"fr":"la réfutation","ar":"الدحض","pos":"nom","g":"f","exFr":"Sa réfutation repose sur une seule prémisse.","ipa":"[ʁɛ.fy.ta.sjɔ̃]","exAr":"يستند دحضه إلى مقدّمة واحدة."},{"fr":"certes","ar":"بالتأكيد / صحيح أنّ","pos":"adv","g":"","exFr":"Certes, l’idée est séduisante.","ipa":"[sɛʁt]","exAr":"صحيح أنّ الفكرة جذّابة."},{"fr":"en dépit de","ar":"رغم / على الرغم من","pos":"loc.","g":"","exFr":"En dépit des obstacles, il poursuit.","ipa":"[ɑ̃ de.pi də]","exAr":"رغم العقبات، يواصل."},{"fr":"il n’en demeure pas moins que","ar":"ومع ذلك يبقى أنّ","pos":"loc.","g":"","exFr":"Il n’en demeure pas moins que le problème subsiste.","ipa":"[il nɑ̃ də.møʁ pa mɛ̃ ke]","exAr":"ومع ذلك يبقى أنّ المشكلة قائمة."},{"fr":"néanmoins","ar":"مع ذلك / رغم ذلك","pos":"adv","g":"","exFr":"Les réserves sont faibles ; néanmoins, elles comptent.","ipa":"[ne.ɑ̃.mwɛ̃]","exAr":"ملاحظات ضعيفة؛ ومع ذلك فهي تُحتسب."},{"fr":"toutefois","ar":"غير أنّ / لكن","pos":"adv","g":"","exFr":"La méthode est simple, toutefois efficace.","ipa":"[tu.te.fwa]","exAr":"المنهج بسيط، لكنّه فعّال."},{"fr":"le contre-argument","ar":"الحجّة المُناقِضة","pos":"nom","g":"m","exFr":"Il anticipe le contre-argument dans son introduction.","ipa":"[kɔ̃tʁ.aʁ.ɡy.mɑ̃]","exAr":"يتوقّع الحجّة المُناقِضة في مقدّمته."},{"fr":"nuire à","ar":"يضرّ بـ","pos":"verbe","g":"","exFr":"Ce détail nuit à la crédibilité de l’ensemble.","ipa":"[nɥiʁ a]","exAr":"هذه التفصيلة تُضعف مصداقية الكلّ."},{"fr":"maintenir sa thèse","ar":"يُبقي على ثبته","pos":"loc.","g":"","exFr":"Malgré tout, elle maintient sa thèse.","ipa":"[mɛ̃.tniʁ sa tɛz]","exAr":"رغم كل شيء، يُبقي على ثبته."},{"fr":"la réserve","ar":"التحفّظ","pos":"nom","g":"f","exFr":"J’exprime une réserve sur la méthode.","ipa":"[ʁə.zɛʁv]","exAr":"أُبدي تحفّظي على المنهج."}],"examples":[{"fr":"Certes, votre chiffre est exact, mais il ne mesure pas le phénomène.","ar":"صحيح أنّ رقمك دقيق، لكنّه لا يقيس الظاهرة.","note":"concession + réfutation"},{"fr":"Il est vrai que l’étude est récente ; néanmoins, ses résultats sont concluants.","ar":"صحيح أنّ الدراسة حديثة؛ غير أنّ نتائجها قاطعة.","note":"registre soutenu"},{"fr":"En dépit des critiques, l’auteur maintient sa thèse.","ar":"رغم الانتقادات، يُبقي المؤلف على ثبته.","note":"en dépit de + nom"},{"fr":"Votre conclusion ne découle pas de votre prémisse.","ar":"استنتاجك لا ينبع من مقدّمتك.","note":"la réfutation logique"},{"fr":"Il n’en demeure pas moins que la question reste ouverte.","ar":"ومع ذلك يبقى السؤال مفتوحاً.","note":"la relance"},{"fr":"Sans doute avez-vous raison sur ce point, mais pas sur l’ensemble.","ar":"لعلّك مصيب في هذه النقطة، لكن ليس في المنهاج كلّه.","note":"la restriction"}],"grammar":[{"tFr":"La structure concessive : bien que + subjonctif, alors que, pour + infinitif","tAr":"بنية التنازل: bien que مع المضارع التامّ، وalors que، وpour مع المصدر","body":["La concession se construit à trois niveaux de langue : oral (certes… mais), écrit (il est vrai que… toutefois), soutenu (bien que + subjonctif). « Bien que la preuve soit incomplète, elle oriente le débat. » Le verbe reste au subjonctif même au passé : « bien que nous ayons vérifié ».","Attention aux pièges : « alors que » peut marquer l’opposition pure (« alors que lui refuse, elle accepte ») et non la concession ; « pour » + infinitif exprime l’intention ou le malgré : « il a persisté pour réfuter l’objection ». Ne remplacez jamais « bien que » par « même si » dans un registre soutenu."],"ex":[{"fr":"Bien que l’objection soit fondée, elle ne change pas la conclusion.","ar":"مع أنّ الاعتراض مُستنَد، فإنّه لا يغيّر الاستنتاج."},{"fr":"Il a reformulé son propos afin que la thèse soit plus claire.","ar":"أعاد صياغة كلامه لكي تكون الثبة أوضح."}]},{"tFr":"La progression thèse – objection – réponse (schéma en trois temps)","tAr":"التدرّج ثلاثي: ثبة — اعتراض — ردّ","body":["Le modèle classique impose de faire vivre l’adversaire dans votre texte : annoncez la thèse, introduisez l’objection avec « on pourrait objecter que… » (subjonctif), répondez avec « cependant » ou « toutefois ». L’objection ne se résume jamais : elle se formule dans sa version la plus forte — c’est la règle de la charité argumentative.","La réponse se construit en deux temps : d’abord le rectificatif (« ce n’est pas exactement cela »), puis la relance (« ce qui importe, c’est… »). Ce rythme donne au lecteur l’impression d’un débat intérieur maîtrisé, gage de crédibilité."],"ex":[{"fr":"On pourrait objecter que l’étude porte sur un échantillon faible ; toutefois, la tendance se confirme.","ar":"يمكن الاعتراض بأنّ الدراسة امتُثّت عيّنة ضعيفة؛ غير أنّ الاتجاه يتأكد."},{"fr":"Ce n’est pas le chiffre qui fait débat, c’est son interprétation.","ar":"ليس الرقم هو محلّ الجدل بل تفسيره."}]}],"mistakes":[{"wrong":"empiler les concessions sans réfuter","right":"concéder un point, puis viser le point décisif","why":"la concession sans suite affaiblit la thèse — التنازل بلا متابعة يُضعف الثبة."},{"wrong":"« Certes… mais » deux fois dans la même phrase","right":"une seule opposition bien placée","why":"la répétition vide la concessive de sa valeur — تكرار الأداة يُفرغها من مضمونها."},{"wrong":"employer « en dépit de » devant un verbe","right":"« en dépit de » + nom (ou pronom)","why":"la préposition régit un nom : « malgré les retards » — تُتبع الاسم لا الفعل."},{"wrong":"réfuter avec « vous avez tort »","right":"réfuter avec « votre conclusion ne tient pas »","why":"on réfute une proposition, jamais une personne — نُدحض المقولة لا صاحبها."}],"dialogues":[{"title":"Certes… mais","ctx":"طالبة تناقش تقرير زميلها أمام أستاذ التحرير","lines":[{"who":"Sarah","fr":"Certes, ton introduction est accrocheuse.","ar":"صحيح أنّ مقدّمتك جذّابة."},{"who":"Antoine","fr":"Mais tu vas ajouter un « mais » ?","ar":"لكن هل ستضيف « لكن » بعد ذلك؟"},{"who":"Sarah","fr":"Mais elle annonce mal la problématique.","ar":"لكنّها لا تُعلن la problématique بشكل صحيح."},{"who":"Antoine","fr":"Je vais donc reformuler la question centrale.","ar":"سأعيد إذن صياغة السؤال المحوري."}]},{"title":"La relance du débat","ctx":"محاضِر وطالب يُغلقان نقاشاً في درس منهجية","lines":[{"who":"Professeur","fr":"En dépit de vos réserves, la méthode reste valable.","ar":"رغم تحفّظاتكم، يبقى المنهج صالحاً."},{"who":"Lina","fr":"Il n’en demeure pas moins qu’elle est longue.","ar":"ومع ذلك يبقى أنها طويلة."},{"who":"Professeur","fr":"Alors résumez la critique en une phrase.","ar":"إذن لخّص الانتقاد في جملة."},{"who":"Lina","fr":"Elle exige trop de temps pour peu de gain.","ar":"تستهلك وقتاً كثيراً مقابل ربح قليل."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"أي عبارة تفتح تنازلاً ثم تُغلقه في النهاية؟","opts":["Certes… mais…","Par exemple","Autrement dit","C’est-à-dire"],"a":0,"why":"« certes… mais » est la paire concessive-adversative la plus courante."},{"t":"fill","skill":"grammar","q":"أكمل: «En ___ des critiques, l’auteur maintient sa thèse.»","fr":"En ___ des critiques, l’auteur maintient sa thèse.","ans":"dépit","why":"« en dépit de » + nom : locution prépositive fixe."},{"t":"order","skill":"writing","q":"رتّب: يبقى السؤال مفتوحاً رغم كل شيء","words":["La","question","reste","ouverte","malgré","tout."],"ans":"La question reste ouverte malgré tout.","why":"adverbe de phrase final : « malgré tout » clôt la proposition."},{"t":"listen","skill":"listening","q":"أي عبارة تعادل « il n’en demeure pas moins que » من حيث الوظيفة؟","opts":["néanmoins","par conséquent","par exemple","à savoir"],"a":0,"why":"les deux marquent la relance après une concession."},{"t":"translate","skill":"writing","q":"ترجم: «صحيح أنّ الدراسة حديثة، غير أنّ نتائجها قاطعة.»","ans":"Il est vrai que l’étude est récente ; néanmoins, ses résultats sont concluants.","why":"concession écrite (il est vrai que) + relance (néanmoins)."},{"t":"speaking","skill":"speaking","q":"اشرح بالفرنسية الفرق بين la concession وla réfutation في دقيقة واحدة.","target":"concéder / réfuter / prémisse","why":"التلخيص المفاهيمي ب le registre soutenu."},{"t":"correct","skill":"grammar","q":"صحّح: «Bien que l’objection est fondée, elle ne change rien.»","ans":"Bien que l’objection soit fondée, elle ne change rien.","why":"« bien que » exige le subjonctif : soit."},{"t":"writing","skill":"writing","q":"اكتب أربعة أسطر تُنازل فيها في اعتراض ثم تردها بـ « toutefois ».","target":"certes / toutefois / néanmoins","why":"بناء فقرة منهجية من ثلاث خطوات: thèse, objection, réponse."}],"homework":"اقرأ فقرة من leçon سابقة، استخرج كل جملة فيها concession، وأعد كتابتها في ثلاث نسخ: نسخة شفوية (certes… mais)، نسخة مكتوبة (il est vrai que… toutefois)، نسخة رفيعة (bien que + subjonctif).","sources":[{"title":"Concession, réfutation. Stratégie argumentative.","channel":"@françaislangue","videoId":"GC8uisYOehk","why":"شرح مباشر للفرق بين la concession وla réfutation مع نماذج من le débat d’idées: متى تُنازل، ومتى تردّ، وكيف يتحوّل la connecteur من جسر إلى سلاح.","cat":"Rhétorique","level":"C1","main":true},{"title":"la concession","channel":"Samira Prof","videoId":"0Y_fHoscSlk","why":"شرح متدرّج لتوظيف la concession في le baccalauréat مع نماذج جاهزة للحفظ.","cat":"Rhétorique","level":"C1","extra":true},{"title":"Les connecteurs d’opposition et de concession en français","channel":"Le French Club","videoId":"pbN0-QDlUj8","why":"الجرد المنهجي لـ les connecteurs d’opposition et de concession التي تربط جمل التنازل بالردّ دون تكرار « mais ».","cat":"Rhétorique","level":"C1","extra":true}],"supplements":[{"id":"0Y_fHoscSlk","title":"la concession","channel":"Samira Prof","why":"شرح متدرّج لتوظيف la concession في le baccalauréat مع نماذج جاهزة للحفظ.","lang":"fr","dur":6},{"id":"pbN0-QDlUj8","title":"Les connecteurs d’opposition et de concession en français","channel":"Le French Club","why":"الجرد المنهجي لـ les connecteurs d’opposition et de concession التي تربط جمل التنازل بالردّ دون تكرار « mais ».","lang":"fr","dur":8}]},{"id":"c1-t5-l3","fr":"Les figures de style argumentatives","ar":"صور الخطاب الحجاجية","objectives":["التمييز بين les figures de style décoratives وles figures de service (الحجاجية)","تحديد l’anaphore وla gradation وl’antithèse وl’énumération في نصّ خطابي","تحليل le rythme: لماذا يُقنع التكرار والصعود أكثر من الجملة المفردة؟","استعمال صورتين على الأقل في فقرة إقناعية من 80 كلمة بـ le registre soutenu"],"sections":[{"h":"الدرس 3: كيف تمنح les figures de style حجّتك قوة إقناعية","video":{"id":"dlanKCos_ag","title":"Les Figures de style ( 3 ) : L’Hyperbole / L’énumération / L’anaphore / La Gradation / La Répétition","channel":"Français Utile","why":"شرح مُباشر للصور الخمس التي تُستعمل في le discours argumentatif: l’anaphore وla gradation وl’énumération مع أمثلة مكتوبة تُظهر كيف تتحوّل الصورة من زينة إلى le mécanisme de persuasion.","lang":"fr","main":true,"dur":10},"p":["le point de départ: la figure n’est pas un ornement. إنها le raccourci الذي يجعل الفكرة محسوسة: la gradation تُحسِّس le degré، والantithèse تُحسِّس le choc، وl’anaphore تُحسِّس la répétition de la volonté. في le discours argumentatif، كلّ صورة تؤدّي وظيفة إقناعية محدّدة.","l’anaphore: تكرار نفس البادئة في بداية جمل متتالية. « Ni le temps, ni la peur, ni l’habitude… » أثرها نفسي: المتكرّر يبدو بديهياً، والمتغيّر يبدو هو المُستخلَص. في le débat، تستعملها لحصر المدخلات: « Que ce soit par la loi, par la négociation, par la pression… le résultat est le même. »","la gradation (ou climax): ترتيب العناصر تصاعدياً أو تنازلياً في la longueur ou la force: « Il a gagné le match, le championnat, la légende. » الصعود يقود بالسامع نحو le sommet الذي هو le point décisif، ولهذا هي أداة la persuasion الأولى في la péroraison.","l’antithèse: مواجهة مصطلحين متعاكسين في بنية موازية: « Ce n’est pas la vitesse qui décide, c’est la direction. » الموازاة الشكلية تجعل الخلاف يبدو منهجياً لا عاطفياً، وهي لذلك مفضّاة في le style soutenu.","l’énumération (ou accumulation): سلسلة عناصر مترابطة بـ les virgules أو les coordination، تنتهي غالباً بعنصر واحد أثقل (la mise en relief par la place finale). « Moins de bruit, moins de voitures, moins d’émissions : voilà la seule solution. » العنصر الأخير يحمل la conclusion المقنعة.","l’usage responsable: لا تُكثر من الصور في le compte rendu أو l’analyse، فالصورة تُضعف la précision عند التوثيق. القاعدة العملية: صورة واحدة لكل proposition قوية، تحملها le connecteur المناسب — وإلا صارت النصّ de la déclamation لا de l’argumentation."],"sub":[{"h":"l’anaphore : la puissance de la répétition","p":["Ni le temps, ni la peur, ni l’habitude.","La répétition crée une cadence.","Ce qui se répète paraît évident."]},{"h":"la gradation : monter vers l’essentiel","p":["Il a gagné le match, le championnat, la légende.","Chaque étape dépasse la précédente.","Le dernier terme porte la conclusion."]},{"h":"l’antithèse et l’énumération","p":["Ce n’est pas la vitesse, c’est la direction.","Moins de bruit, moins de voitures, moins d’émissions.","Les oppositions structurent la réflexion."]}]},{"h":"les figures au service de la thèse","p":["« Ni optimisme de circonstance, ni fatalisme… » — l’anaphore de refus.","« D’abord, ensuite, enfin… » — la gradation procédurale.","« Ce n’est pas l’échec qui compte, c’est le bilan. » — l’antithèse conclusive.","« Une règle, une exception, une limite : voilà le sujet. » — l’énumération à portée de thèse."]},{"h":"التطبيق والتلخيص","p":["تمرين le repérage: ضع تحت كلّ صورة في نصّ خطابي اسمها الدقيق — anaphore أم gradation أم antithèse أم accumulation.","تمرين la transformation: حوّل جملة حسابية (« La situation est grave ») إلى gradation من ثلاث درجات متصاعدة.","تمرين la composition: اكتب ثمانية أسطر تُقنع فيها قرّاء جريدة بفكرة واحدة مستعملًا anaphore في البداية وantithèse في الخاتمة."]}],"pron":[{"w":"l’anaphore","ipa":"[la.na.fɔʁ]","approx":"لانافور"},{"w":"la gradation","ipa":"[la ɡʁa.da.sjɔ̃]","approx":"لا غراداسيون"},{"w":"l’antithèse","ipa":"[lɑ̃.ti.tɛz]","approx":"لانتيتيز"}],"vocab":[{"fr":"l’anaphore","ar":"التكرار الابتدائي","pos":"nom","g":"f","exFr":"L’anaphore rythme le discours.","ipa":"[a.na.fɔʁ]","exAr":"التكرار الابتدائي يُوزن الخطاب."},{"fr":"la gradation","ar":"التدرّج (الصعود أو الهبوط)","pos":"nom","g":"f","exFr":"La gradation mène l’auditeur vers le sommet.","ipa":"[ɡʁa.da.sjɔ̃]","exAr":"التدرّج يقود المستمع نحو القمة."},{"fr":"l’antithèse","ar":"المقابلة والمعارضة","pos":"nom","g":"f","exFr":"L’antithèse oppose deux idées en parallèle.","ipa":"[ɑ̃.ti.tɛz]","exAr":"المقابلة تضع فكرتين متقابلتين في بنية موازية."},{"fr":"l’énumération","ar":"العَدّ والتعداد","pos":"nom","g":"f","exFr":"Son énumération se termine sur l’idée décisive.","ipa":"[e.ny.me.ʁa.sjɔ̃]","exAr":"ينتهي عدّه بلفكرة الحاسمة."},{"fr":"l’hyperbole","ar":"المبالغة","pos":"nom","g":"f","exFr":"Une hyperbole ne prouve rien, elle frappe.","ipa":"[i.pɛʁ.bɔ.l]","exAr":"المبالغة لا تُثبت بل تُصيب."},{"fr":"la répétition","ar":"التكرار","pos":"nom","g":"f","exFr":"La répétition ancre la formule dans la mémoire.","ipa":"[ʁe.pe.ti.sjɔ̃]","exAr":"التكرار يُثبّت العبارة في الذاكرة."},{"fr":"le rythme","ar":"الإيقاع","pos":"nom","g":"m","exFr":"Un rythme court convainc mieux qu’une longue phrase.","ipa":"[ʁitm]","exAr":"الإيقاع القصير يُقنع أكثر من الجملة الطويلة."},{"fr":"le parallélisme","ar":"المساواة الشكلية","pos":"nom","g":"m","exFr":"Le parallélisme structure l’antithèse.","ipa":"[pa.ʁa.le.lism]","exAr":"المساواة الشكلية تبني المقابلة."},{"fr":"persuader","ar":"يقنع","pos":"verbe","g":"","exFr":"Il cherche à persuader, non à impressionner.","ipa":"[pɛʁ.sya.de]","exAr":"يسعى إلى الإقناع لا إلى الإبهار."},{"fr":"frapper l’auditoire","ar":"يُصيب جمهور المستمعين","pos":"loc.","g":"","exFr":"La formule finale frappe l’auditoire.","ipa":"[fʁa.ke lo.ditwaʁ]","exAr":"العبارة الختامية تصيب الجمهور."},{"fr":"la péroraison","ar":"الخاتمة الخطابية","pos":"nom","g":"f","exFr":"La péroraison rassemble tous les arguments.","ipa":"[pe.ʁɔ.ʁɛ.zɔ̃]","exAr":"الخاتمة الخطابية تجمع كل الحجج."},{"fr":"la mise en relief","ar":"الإبراز بوضعه في مكان بارز","pos":"nom","g":"f","exFr":"La place finale produit un effet de mise en relief.","ipa":"[miz ɑ̃ ʁə.ljɛf]","exAr":"الموضع الأخير يُحدث أثر إبراز."}],"examples":[{"fr":"Ni le temps, ni la peur, ni l’habitude ne l’ont arrêté.","ar":"لا الزمن ولا الخوف ولا العادة أوقفاه.","note":"l’anaphore de la négation"},{"fr":"Il a gagné le match, le championnat, la légende.","ar":"فاز بالمباراة، ثم بالبطولة، ثم بالخلود.","note":"la gradation ascendante"},{"fr":"Ce n’est pas la vitesse qui décide, c’est la direction.","ar":"ليس السرعة هي التي تُقرّر بل الاتجاه.","note":"l’antithèse"},{"fr":"Moins de bruit, moins de voitures, moins d’émissions : voilà la solution.","ar":"أقلّ ضجيجاً، أقلّ سيارات، أقلّ انبعاثات: ها هو الحل.","note":"l’énumération à portée de conclusion"},{"fr":"La parole a convaincu, la preuve a persuadé.","ar":"الكلام أقنع، والبرهان يُقنع نهائياً.","note":"le parallélisme"},{"fr":"Une idée répétée cent fois devient une évidence.","ar":"الفكرة المتكرّرة مئة مرة تصبح بديهية.","note":"l’effet psychologique de la répétition"}],"grammar":[{"tFr":"L’inversion sujet-verbe et la structure binaire de l’antithèse","tAr":"قلب الفاعل والفعل والبنية الثنائية للمقابلة","body":["L’antithèse s’appuie sur une construction symétrique : « Ce n’est pas X qui…, c’est Y. » La structure utilisant « c’est… que » (la cleft sentence) met en relief le second terme : « Ce n’est pas le hasard, c’est la méthode. » L’inversion sujet-verbe (« Décide-t-il ? ») appartient au même registre soutenu.","Le parallélisme exige des propositions de même longueur et même nature grammaticale : deux infinitifs, deux subordonnées, deux groupes nominaux. Toute rupture de parallélisme fait chuter l’effet : « Il a gagné le match, le championnat, et puis il s’est entraîné » (la troisième n’appartient plus à la série)."],"ex":[{"fr":"Ce n’est pas l’échec qui compte, c’est le bilan.","ar":"ليس الفشل هو الذي يُحتسب بل الحصيلة."},{"fr":"Vaincra-t-il par l’effet ou par la cause ?","ar":"هل ينتصر بالنتيجة أم بالسبب؟"}]},{"tFr":"Les liaisons et l’accumulation : virgule, ni… ni, ni plus… que","tAr":"العطف والتراكم: الفاصلة، وni… ni، وni plus… que","body":["La césure de l’énumération repose sur la virgule : chaque segment doit être grammaticalement homogène (trois GN, trois infinitifs, trois propositions). La série fermée se ferme par « et » + terme le plus fort, ou par les deux-points pour introduire la conséquence.","La négation accumulatrice « ni… ni… ni » prolonge l’anaphore : elle range les éléments dans un même bloc refusé. « Ni réforme, ni révolution, ni statu quo » — le rythme ternaire, très fréquent en rhétorique française, donne l’impression d’un champ exhaustif."],"ex":[{"fr":"Ni réforme, ni révolution, ni statu quo : il faut une troisième voie.","ar":"لا إصلاح ولا ثورة ولا تجميد للوضع: يجب أن يكون هناك طريق ثالث."},{"fr":"Il a parlé de la méthode, des exemples, des limites ; puis il a conclu.","ar":"تحدّث عن المنهج ثم عن الأمثلة ثم عن الحدود، ثم ختم."}]}],"mistakes":[{"wrong":"accumuler les figures dans un compte rendu","right":"réserver les figures à la thèse et à la conclusion","why":"la précision documentaire exige la neutralité — التوثيق يقتضي الحياد قبل الجمال."},{"wrong":"confondre anaphore et répétition","right":"anaphore = répétition en tête de phrase","why":"la position initiale crée l’effet rythmique — موقع التكرار هو الذي يصنع الأثر."},{"wrong":"mélanger deux plans dans une gradation","right":"une seule échelle : durée, intensité ou ampleur","why":"la gradation doit rester mesurable — التدرّج يجب أن يبقى قابلاً للقياس."},{"wrong":"traduire une figure par son nom arabe sans exemple","right":"donner la figure, la phrase et son effet","why":"le nom seul n’apprend rien à l’auditeur — الاسم وحده لا يُعلِّم، المثال يُعلِّم."}],"dialogues":[{"title":"Repérer une anaphore","ctx":"أستاذاة تُراجع مشروع خطاب طالبتها","lines":[{"who":"Madame Roux","fr":"Ton introduction répète la même image trois fois.","ar":"مقدّمتك تكرّر الصورة نفسها ثلاث مرّات."},{"who":"Inès","fr":"C’était volontaire : c’est une anaphore.","ar":"كان ذلك عمداً: إنّه تكرار ابتدائي."},{"who":"Madame Roux","fr":"Alors assume-la jusqu’au bout, avec un rythme égal.","ar":"إذن اجعله واضحاً حتى النهاية بإيقاع متساوٍ."},{"who":"Inès","fr":"Je vais réécrire la troisième phrase.","ar":"سأعيد كتابة الجملة الثالثة."}]},{"title":"Choisir la bonne figure","ctx":"زميلان يُعدّان عرضاً تقديميًا لمشروع جمعية","lines":[{"who":"Hugo","fr":"Il faut monter vers l’idée forte.","ar":"يجب أن نصعد نحو الفكرة القوية."},{"who":"Camille","fr":"Alors utilisons une gradation, pas une simple liste.","ar":"إذن استعملْنا تدرّجاً لا قائمة مجرّدة."},{"who":"Hugo","fr":"Et en finale, une antithèse pour marquer les esprits.","ar":"وفي الختام مقابلاً تُركّز الأفكار."},{"who":"Camille","fr":"Parfait : trois preuves, puis la chute.","ar":"ممتاز: ثلاث حجج ثم لحظة الهبوط."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"أي صورة تُرتّب عناصرها تصاعدياً نحو ذروة؟","opts":["la gradation","l’anaphore","l’ironie","la métaphore"],"a":0,"why":"gradation = degré croissant de force ou d’ampleur."},{"t":"fill","skill":"vocabulary","q":"أكمل: «Le ___ oppose deux idées en parallèle.»","fr":"Le ___ oppose deux idées en parallèle.","ans":"parallélisme","why":"la structure symétrique est la condition de l’antithèse."},{"t":"order","skill":"writing","q":"رتّب: الصعود يقود المستمع نحو القمة","words":["La","gradation","conduit","l’auditeur","au","sommet."],"ans":"La gradation conduit l’auditeur au sommet.","why":"sujet + verbe + COD + complément circonstanciel."},{"t":"listen","skill":"listening","q":"ما الصورة في: «Ni le temps, ni la peur, ni l’habitude»؟","opts":["l’anaphore","l’oxymore","l’euphémisme","la métonymie"],"a":0,"why":"la répétition de « ni » en tête crée l’anaphore."},{"t":"translate","skill":"writing","q":"ترجم: «ليس السرعة هي التي تُقرّر بل الاتجاه.»","ans":"Ce n’est pas la vitesse qui décide, c’est la direction.","why":"structure cleft « ce n’est pas X qui…, c’est Y »."},{"t":"speaking","skill":"speaking","q":"اذكر ثلاث جمل متتالية على نمط anaphore تُدافع فيها عن فكرة تعليمية واحدة.","target":"ni… ni… ni / pourtant / enfin","why":"إنتاج شفوي مُؤقَّت يُدرِّب على le rythme."},{"t":"correct","skill":"grammar","q":"صحّح: «Il a gagné le match, le championnat, et puis il s’est levé.»","ans":"Il a gagné le match, le championnat, le titre mondial.","why":"les éléments d’une série doivent rester homogènes (même catégorie grammaticale)."},{"t":"writing","skill":"writing","q":"اكتب خمسة أسطر تُقنع فيها زميلك بفكرة واحدة مستعملًا anaphore ثم antithèse.","target":"anaphore / antithèse / énumération","why":"الفقرة الإقناعية القصيرة تجمع الصورة بالوظيفة الحجاجية."}],"homework":"اختر مقولة خطابية قصيرة بالفرنسية، حلّل فيها صورتين على الأقل: حدّد اسم كل صورة، وبيّن الوظيفة الإقناعية التي تؤدّيها في الجملة.","sources":[{"title":"Les Figures de style ( 3 ) : L’Hyperbole / L’énumération / L’anaphore / La Gradation / La Répétition","channel":"Français Utile","videoId":"dlanKCos_ag","why":"شرح مُباشر للصور الخمس التي تُستعمل في le discours argumentatif: l’anaphore وla gradation وl’énumération مع أمثلة مكتوبة تُظهر كيف تتحوّل الصورة من زينة إلى le mécanisme de persuasion.","cat":"Rhétorique","level":"C1","main":true},{"title":"Figures de style : Qu’est-ce qu’une antithèse et un oxymore ?","channel":"digiSchool Collège","videoId":"snIbKYScrQI","why":"شرح دقيق للمقابلة وما يُقاربها من الصور، مع أمثلة قصيرة سهلة الحفظ.","cat":"Rhétorique","level":"C1","extra":true},{"title":"Les FIGURES DE STYLE que vous devez ABSOLUMENT connaître en français !","channel":"Parlez-vous FRENCH : Cours de français","videoId":"ouqFPohzUqE","why":"جرد شامل للصور الأساسية مع تصنيفها حسب le niveau de langue والاستعمال.","cat":"Rhétorique","level":"C1","extra":true}],"supplements":[{"id":"snIbKYScrQI","title":"Figures de style : Qu’est-ce qu’une antithèse et un oxymore ?","channel":"digiSchool Collège","why":"شرح دقيق للمقابلة وما يُقاربها من الصور، مع أمثلة قصيرة سهلة الحفظ.","lang":"fr","dur":5},{"id":"ouqFPohzUqE","title":"Les FIGURES DE STYLE que vous devez ABSOLUMENT connaître en français !","channel":"Parlez-vous FRENCH : Cours de français","why":"جرد شامل للصور الأساسية مع تصنيفها حسب le niveau de langue والاستعمال.","lang":"fr","dur":11}]},{"id":"c1-t5-l4","fr":"Le débat télévisé","ar":"النقاش التلفزيوني","objectives":["إدراك les règles du tour de parole في le plateau: la prise, la cession, la coupe","استعمال les formules de coupe المهذّبة: « Pardonnez-moi », « Je vous reprends »","تمييز la relance الناجحة عن la relance التدخّلية","إجراء نقاش مدّته ثلاث دقائق يُحافظ فيه على la structure et le rythme"],"sections":[{"h":"الدرس 4: كيف تُدير كلامك في le débat: la coupe, la relance, le tour de parole","video":{"id":"rtN59UCjJQg","title":"COURS 1: Techniques pour animer un débat : formules clés pour les animateurs !","channel":"français avec mme habiba","why":"دورة تمهيدية عن le métier d’animateur: les formules pour ouvrir le débat، la coupe المهذّبة، وla relance التي تُعيد التوازن بين les intervenants دون تدخل فاضح.","lang":"fr","main":true,"dur":14},"p":["le débat التلفزيوني بنية مؤسسية: la régie تُعطي le micro لمن يملك la parole، ومن يتكلّم خارج son tour يُقطع عنه صوتاً. لذلك تأتي la stratégie قبل le contenu: من يُتقن la prise de parole يكسب la première minute، وهي التي تُحدّد l’image عند المشاهد.","la prise de parole: ثلاث مراحل — le signalement (رفع اليد أو كلمة « si je peux… »)، la demande (« Je voudrais revenir sur ce point »)، والتسليم (« Je m’arrête là »). المُتقِن يَعِد بالتوقيت: « En trente secondes… » فالمُحدِّث يمنح نفسه la limite ويمنع la coupe.","la coupe: أداة غير مألوفة في العربية: إسكات مهذّب أثناء الكلام. الصيغ: « Pardonnez-moi de vous interrompre », « Permettez-moi une précision », « Je vous reprends sur un point ». القاعدة: تُقاطع المعلومة لا الشخص، ويُقترن كلّ تدخّل بـ le rectificatif.","la relance: سؤال قصير يُعيد لليسار la parole بعد أن يختنق كلامه. « Vous pensez donc que… ? » (تلميح للمُستمع) أو « Qu’est-ce qui vous fait dire cela ? » (طلب la preuve). la relance الجيدة تُقدِّم le choix: « S’agit-il d’un problème de coût ou de méthode ? »","le contrôle du tour: la règle الذهبية — la restitution: تُلخّص ما قاله الآخر ثم تردّ. « Si je vous comprends bien, vous dites que… » هذا لا يُكسبك الموافقة فقط بل la crédibilité، لأنّ المشاهد يرى أنّك سمعت فعلاً.","le tempo: ثلاث دقائق نقاش = une idée + une preuve + une relance. من يتجاوز la limite يفقد l’audience ويفتح la porte لـ la coupe. احفظ العدّاد لا المُخطَّط: la pensée الواحدة المكتملة أنفع من ثلاث ناقصة."],"sub":[{"h":"prendre la parole","p":["Je voudrais revenir sur ce point précis.","Permettez-moi une précision en trente secondes.","Si je peux me permettre, la donnée est autre."]},{"h":"couper et reprendre","p":["Pardonnez-moi de vous interrompre, mais le chiffre est faussé.","Je vous reprends sur un point de méthode.","On va laisser notre invité terminer."]},{"h":"relancer sans interrompre","p":["Vous pensez donc que la méthode suffit ?","Qu’est-ce qui vous fait dire cela ?","Deux solutions : le coût ou la méthode ?"]}]},{"h":"les formules du plateau","p":["« Si je comprends bien, vous soutenez que… » — la restitution qui ouvre la relance.","« Pardonnez-moi de vous couper, mais… » — la coupe justifiée.","« Je vous donne la parole puis je reprends. » — la cession du tour.","« Reprenons : deux points, la méthode et le coût. » — le cadrage du débat."]},{"h":"التطبيق والتلخيص","p":["تمرين la coupe: سجّل نفسك وأنت تُقاطع جملة تجريبية ثلاث مرات بصيغ مختلفة وقارن نبرة صوتك.","تمرين la relance: شاهد لقطة نقاش بلا صوت واكتب لكلّ تدخّل relance مناسبة لا تتجاوز سطراً واحداً.","تمرين le chrono: أجرِ نقاشاً من ثلاث دقائق مع زميل، والتزم بجملة واحدة لكلّ دور la première minute."]}],"pron":[{"w":"la relance","ipa":"[la ʁə.lɑ̃s]","approx":"لا ريلانس"},{"w":"la coupe","ipa":"[la kup]","approx":"لا كوب"},{"w":"le tour de parole","ipa":"[lə tuʁ də paʁɔl]","approx":"لُ تور دُ بارول"}],"vocab":[{"fr":"prendre la parole","ar":"يتناول الكلمة","pos":"loc.","g":"","exFr":"Il prend la parole sans être invité.","ipa":"[pʁɑ̃dʁ la paʁɔl]","exAr":"يتناول الكلمة دون أن يُدعى."},{"fr":"céder la parole","ar":"يُسليم الكلمة","pos":"loc.","g":"","exFr":"L’animatrice cède la parole à l’invité.","ipa":"[se.de la paʁɔl]","exAr":"تُسلّم المذيعة الكلمة للضيف."},{"fr":"la coupe","ar":"القاطع المُهذَّب (الإسكات)","pos":"nom","g":"f","exFr":"Une coupe polie évite le conflit.","ipa":"[kup]","exAr":"القاطع المهذّب يمنع النزاع."},{"fr":"interrompre","ar":"يقطع الكلام","pos":"verbe","g":"","exFr":"Il n’a cessé de l’interrompre.","ipa":"[ɛ̃.tə.ʁɔ̃pʁ]","exAr":"لم يكفّ عن مقاطعته."},{"fr":"la relance","ar":"إعادة توجيه الحوار","pos":"nom","g":"f","exFr":"Sa relance a fait avancer le débat.","ipa":"[ʁə.lɑ̃s]","exAr":"أعادت صياغته الحوار فأحرز تقدّماً."},{"fr":"le tour de parole","ar":"حقّ الكلمة (دورة التحدّث)","pos":"nom","g":"m","exFr":"Chacun respecte son tour de parole.","ipa":"[tuʁ də paʁɔl]","exAr":"كلٌّ يحترم حقّه في الكلام."},{"fr":"reformuler","ar":"يُعيد الصياغة","pos":"verbe","g":"","exFr":"Reformulez votre idée en une phrase.","ipa":"[ʁə.fɔʁ.my.le]","exAr":"أعد صياغة فكرتك في جملة."},{"fr":"relancer un intervenant","ar":"يُعيد الكلمة للمتحدّث","pos":"loc.","g":"","exFr":"L’animateur relance l’intervenant.","ipa":"[ʁə.lɑ̃.sɛ̃nɛ̃tɛʁ.vɲɑ̃]","exAr":"يعيد المذيع الكلمة للمتحدّث."},{"fr":"rétablir le débat","ar":"يعيد ترتيب النقاش","pos":"loc.","g":"","exFr":"Il faut rétablir le débat sur le fond.","ipa":"[ʁe.ta.bliʁ lə de.ba]","exAr":"يجب إعادة النقاش إلى الجوهر."},{"fr":"le tempo","ar":"إيقاع التحدّث","pos":"nom","g":"m","exFr":"Gardez un tempo régulier.","ipa":"[tɑ̃.po]","exAr":"حافظ على إيقاع ثابت."},{"fr":"la restitution","ar":"استرجاع مضمون كلام الآخر","pos":"nom","g":"f","exFr":"La restitution montre qu’on a écouté.","ipa":"[ʁɛs.ti.ty.sjɔ̃]","exAr":"الاسترجاع يُثبت أنّك أصغيت."},{"fr":"rester dans les temps","ar":"يلتزم بالوقت المحدَّد","pos":"loc.","g":"","exFr":"Si tu restes dans les temps, tu gardes la parole.","ipa":"[ʁɛstʁ de zɑ̃]","exAr":"إن التزمت بالوقت بقيت صاحب الكلمة."}],"examples":[{"fr":"Pardonnez-moi de vous interrompre, mais le chiffre est faussé.","ar":"عذرًا على المقاطعة، لكنّ الرقم مُزوَّر.","note":"la coupe justifiée"},{"fr":"Je vous reprends sur un point de méthode.","ar":"أعود إليك في نقطة المنهج.","note":"la coupe frontale mais polie"},{"fr":"Si je vous comprends bien, vous doutez de l’échantillon.","ar":"إن فهمتُك جيداً، فأنت تشكّ في العيّنة.","note":"la restitution"},{"fr":"Qu’est-ce qui vous fait dire cela ?","ar":"ما الذي يجعلك تقول ذلك؟","note":"la relance de la preuve"},{"fr":"Je vous donne la parole, puis je reprends.","ar":"أُسلّم لك الكلمة ثم أستعيدها.","note":"le contrôle du tour"},{"fr":"Revenons au cœur du sujet : la méthode.","ar":"لنعد إلى قلب الموضوع: المنهج.","note":"le cadrage"}],"grammar":[{"tFr":"Les formules de politesse à l’impératif : permettez-moi, reformulez, laissez-moi","tAr":"صيغ الأمر المهذّبة: permettez-moi، وreformulez، وlaissez-moi","body":["À l’oral du débat, l’impératif poli remplace le conditionnel : « Permettez-moi une précision » équivaut à « Je me permets une précision » mais gagne en dynamisme. Les verbes laisser, permettre, laisser-moi réclament l’infinitif introduit par « de » : « Laissez-moi terminer. » (sans « de »).","La tournure négative adoucit encore : « Ne vous méprenez pas, je ne contredis que le chiffre. » Ou, plus soutenue : « Je ne saurais partager cette conclusion. » La négation du verbe de parole (« je ne prétends pas que… » + subjonctif) ouvre la porte à la nuance."],"ex":[{"fr":"Permettez-moi une précision, puis je cède la parole.","ar":"اسمح لي بتوضيح ثم أُسلّم الكلمة."},{"fr":"Laissez-moi terminer, je vous donnerai la parole ensuite.","ar":"دعني أُكمل ثم أُسلّم لك الكلمة بعد ذلك."}]},{"tFr":"L’interrogation indirecte dans la relance : ce que, si, quelle est la portée de…","tAr":"السؤال غير المباشر في إعادة التوجيه","body":["La relance évite l’interrogation directe agressive (« Vous prouvez quoi ? ») au profit de l’interrogation indirecte : « Je me demande ce qui fonde votre affirmation. » Le verbe introducteur (se demander, demander à quelqu’un de, s’interroger sur) commande l’ordre des mots : sujet + verbe, sans inversion.","Les questions fermées orientent (« S’agit-il d’un problème de coût ? ») et servent à faire choisir ; les questions ouvertes (« Qu’est-ce qui vous fait dire cela ? ») font produire la preuve. Un bon débiteur alterne les deux, jamais plus d’une par intervention."],"ex":[{"fr":"Je me demande ce qui justifie cette conclusion.","ar":"أتساءل ما الذي يُسوّغ هذا الاستنتاج."},{"fr":"Dites-nous quelle est la portée de votre chiffre.","ar":"أخبرنا ما مدى مدى وصول رقمك."}]}],"mistakes":[{"wrong":"couper la personne plutôt que l’information","right":"couper avec une formule et un rectificatif","why":"la coupe nue devient une agression — القاطع العاري يتحوّل إلى عدوان."},{"wrong":"accumuler les interventions sans restituer","right":"reformuler ce que dit l’autre avant de répondre","why":"la restitution prouve l’écoute — استرجاع الكلام يُثبت الإصغاء."},{"wrong":"relancer toujours avec la même question fermée","right":"varier relance fermée et relance ouverte","why":"une seule sorte de relance bloque le dialogue — نوع واحد من إعادة التوجيه يُعطّل الحوار."},{"wrong":"parler plus longtemps que son tour","right":"annoncer sa durée : « en trente secondes »","why":"l’annonce crée une limite acceptée — الإعلان عن المدّة يضع حداً مقبولاً."}],"dialogues":[{"title":"Ouvrir le débat","ctx":"مذيعان يستقبلان ضيفين في استوديو نقاش قصير","lines":[{"who":"Julie","fr":"Bienvenue. Chacun aura deux minutes pour sa thèse.","ar":"أهلاً بكم. سيحصل كلٌّ على دقيقتين لعرض ثبته."},{"who":"Marc","fr":"Si je comprends bien, la question est la méthode.","ar":"إن فهمتُك، فالسؤال يتعلّق بالمنهج."},{"who":"Julie","fr":"Exactement. Prenez la parole, puis je vous relance.","ar":"بالضبط. تناول الكلمة ثم أُعيد إليك الحوار."},{"who":"Marc","fr":"Très bien, je commence en trente secondes.","ar":"حسناً، أبدأ خلال ثلاثين ثانية."}]},{"title":"Couper et recentrer","ctx":"نقاش بين ضيفين والمذيع يُعيد التوازن","lines":[{"who":"Nadia","fr":"Pardonnez-moi de vous interrompre, ce chiffre est obsolète.","ar":"عذرًا على المقاطعة، هذا الرقم قديم."},{"who":"Thomas","fr":"Vous prétendez donc que rien ne vaut ?","ar":"إذن تدّعي أنّ لا شيء يُحتسب؟"},{"who":"Nadia","fr":"Non : je dis seulement qu’il faut une autre mesure.","ar":"لا؛ أقول فقط إنّه يجب إجراء قياس آخر."},{"who":"Animateur","fr":"Revenons au cœur du sujet, la méthode.","ar":"لنعد إلى قلب الموضوع: المنهج."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما المقصود بـ « la relance » في le débat؟","opts":["سؤال قصير يُعيد الكلمة لآخر","قاطع يُسكت المتحدّث","تكرار لعبارة المذيع","فاصل إعلاني"],"a":0,"why":"relancer = relancer la parole, donc relancer l’échange."},{"t":"fill","skill":"grammar","q":"أكمل: «___ de vous interrompre, mais le chiffre est faux.»","fr":"___ de vous interrompre, mais le chiffre est faux.","ans":"Pardonnez-moi","why":"la coupe polie commence par une excuse à l’impératif."},{"t":"order","skill":"writing","q":"رتّب: كلٌّ يحترم حقّه في الكلام","words":["Chacun","respecte","son","tour","de","parole."],"ans":"Chacun respecte son tour de parole.","why":"sujet indéfini + verbe + COD avec article possessif."},{"t":"listen","skill":"listening","q":"أي عبارة تُستعمل لإعادة توازن النقاش؟","opts":["Revenons au cœur du sujet.","Bon appétit.","À bientôt.","Je t’embrasse."],"a":0,"why":"la formule de cadrage ramène les intervenants au thème."},{"t":"translate","skill":"writing","q":"ترجم: «إن فهمتُك جيداً، فأنت تشكّ في العيّنة.»","ans":"Si je vous comprends bien, vous doutez de l’échantillon.","why":"la restitution précède toujours la relance."},{"t":"speaking","skill":"speaking","q":"ابدأ نقاشاً مع زميل واسمح لنفسك بمقاطعة واحدة مهذّبة خلال الدقيقة الأولى.","target":"Pardonnez-moi / permettez-moi / je vous reprends","why":"تدريب عملي على la coupe في سياق حقيقي."},{"t":"correct","skill":"grammar","q":"صحّح: «Laissez-moi de terminer, puis je cède la parole.»","ans":"Laissez-moi terminer, puis je cède la parole.","why":"« laisser + pronom » se construit avec l’infinitif sans préposition."},{"t":"writing","skill":"writing","q":"اكتب أربعة أسطر لسيناريو نقاش فيه: استلام للكلمة ثم قاطعة واحدة ثم إعادة صياغة ثم تسليم.","target":"prendre / couper / reformuler / céder","why":"بناء مُخطَّط تحدّث مكتوب يُحاكي le rythme du plateau."}],"homework":"شاهد لقطة نقاش من ثلاث دقائق بلا صوت، واكتب لكلّ تدخّل: من يملك la parole، وما نوع التدخّل (prise, coupe, relance, restitution)، ثم اقترح جملة فرنسية واحدة لكلّ منها.","sources":[{"title":"COURS 1: Techniques pour animer un débat : formules clés pour les animateurs !","channel":"français avec mme habiba","videoId":"rtN59UCjJQg","why":"دورة تمهيدية عن le métier d’animateur: les formules pour ouvrir le débat، la coupe المهذّبة، وla relance التي تُعيد التوازن بين les intervenants دون تدخل فاضح.","cat":"Rhétorique","level":"C1","main":true},{"title":"Débattre - Tutoriel vidéo pour maîtriser l’oral","channel":"Editions Bordas","videoId":"c4n3g2r_NAo","why":"دليل مُبسّط ومرئي لقواعد le débat: la prise de parole، la citation، et la réfutation في le contexte scolaire.","cat":"Rhétorique","level":"C1","extra":true},{"title":"Comment débattre en français | phrases essentielles | structure et astuces pour gagner chaque débat","channel":"Parlons Français Facile","videoId":"Gsr74RI_syI","why":"مخزون جاهز من les phrases essentielles وla structure التي تُستعمل في le tour de parole.","cat":"Rhétorique","level":"C1","extra":true}],"supplements":[{"id":"c4n3g2r_NAo","title":"Débattre - Tutoriel vidéo pour maîtriser l’oral","channel":"Editions Bordas","why":"دليل مُبسّط ومرئي لقواعد le débat: la prise de parole، la citation، et la réfutation في le contexte scolaire.","lang":"fr","dur":7},{"id":"Gsr74RI_syI","title":"Comment débattre en français | phrases essentielles | structure et astuces pour gagner chaque débat","channel":"Parlons Français Facile","why":"مخزون جاهز من les phrases essentielles وla structure التي تُستعمل في le tour de parole.","lang":"fr","dur":10}]},{"id":"c1-t5-l5","fr":"La prise de parole en public","ar":"التحرّي أمام الجمهور","objectives":["بناء خُطَّط من ثلاث نقاط: l’amorce, le développement, la péroraison","استعمال les connecteurs d’annonce et de bilan: d’une part, en premier lieu, pour conclure","توزيع le temps: 10 % mise en place, 80 % développement, 10 % conclusion","الانتقال من le registre courant إلى le registre soutenu في نصّ مكتوب"],"sections":[{"h":"الدرس 5: كيف تبني خطاباً مقنعاً: le plan, les connecteurs, le temps, le registre","video":{"id":"kRm5DvNoSrM","title":"Comment devenir un conférencier professionnel hors pair ? - Michel Poulaert","channel":"Cyril Chambard","why":"حوار مُعمَّق مع خبير في la prise de parole: كيف يُبنى le plan، وكيف يُوزَّع le temps بين les parties، وكيف يتحوّل le langage quotidien إلى le registre soutenu دون جمود.","lang":"fr","main":true,"dur":13},"p":["le plan هو ما يميّز la conférence عن la digression: ثلاث نقاط، لا أكثر، كلٌّ منها بجملة مفتاحية يمكن استرجاعها. la formule الذهبية: « Je vais défendre trois points : d’abord…, ensuite…, enfin… » — التلقين يمنح الجمهور la boussole منذ الثانية الأولى.","les connecteurs d’annonce وles connecteurs de bilan يُحييان le plan الشفوي: « D’une part… d’autre part » للموازنة، « Pour ce qui est de… » للانتقال، « En somme, » للخاتمة. القاعدة: connecteur واحد لكل انتقال؛ تكرار « et puis » يُشعر بـ l’improvisation.","gestion du temps: la conférence de dix دقائق = una minute d’amorce، ثم ثمان دقائق لازمة موزّعة على النقاط، ثم دقيقة للخاتمة. اضبط le chronomètre على le paragraphe لا على la phrase، وإلا تكتشف النقص في آخر لحظة.","la prise de parole الناجحة تبدأ بـ la présence قبل les mots: le regard en mouvement (ثلاث جماهير في القاعة)، la respiration basse، et le silence قبل la première phrase. الصمت المقصود لا يُقرأ كارتباك بل كـ la maîtrise.","registre soutenu: استبدل la verbale الشائعة بـ les synonymes الأدق: « beaucoup » → « considérablement », « on dit que » → « il est communément admis que », « je pense » → « il m’est permis d’estimer ». لكن le danger هو le mélange: لا تخلط le soutenu avec le familier في الخطابة نفسها.","la péroraison تُعيد la phrase d’ouverture بصيغة جديدة: le rappel de la thèse ثم la perspective (« Ce débat prépare… ») ثم l’appel (« Il reste à… »). النهاية الجيدة تترك la question مفتوحة لا la sentence مغلقة — وهذا ما يميّز le discours C1 عن le discours scolaire."],"sub":[{"h":"annoncer son plan","p":["Je vais défendre trois points.","D’une part, la méthode ; d’autre part, le coût.","En somme, la question est de priorité."]},{"h":"gérer le temps","p":["Je reprends du temps : deux minutes restent.","Passons au deuxième point.","Je conclus en une minute."]},{"h":"tenir le registre soutenu","p":["Il est communément admis que…","Les données considérables confirment la tendance.","Il m’est permis d’estimer que…"]}]},{"h":"les articulations du discours","p":["« Je vais défendre trois points… » — l’annonce du plan.","« Pour ce qui est du coût, la discussion est autre. » — la transition.","« En somme, il s’agit moins de refuser que de réorganiser. » — le bilan.","« Il me reste à soulever une dernière question. » — l’ouverture avant la chute."]},{"h":"التطبيق والتلخيص","p":["تمرين le plan: اكتب مخطط خُطَّة من ثلاث نقاط لعرض مدّته عشر دقائق، وحدّد زمن كلّ نقطة بالثواني.","تمرين la montée en registre: حوّل خمس جمل يومية إلى le registre soutenu ثم اقرأها بصوت عالٍ لتسمع الفرق.","تمرين la minute d’or: سجّل تقديمًا مدّته ستين ثانية يتضمّن amorce وplan وune seule idée قوية."]}],"pron":[{"w":"la prise de parole","ipa":"[la pʁiz də paʁɔl]","approx":"لا بريز دُ بارول"},{"w":"la péroraison","ipa":"[la pe.ʁɔ.ʁɛ.zɔ̃]","approx":"لا بيروريزون"},{"w":"le connecteur","ipa":"[lə kɔ̃.nɛk.tœʁ]","approx":"لُ كوننكتور"}],"vocab":[{"fr":"le plan","ar":"مُخطَّط الخطاب","pos":"nom","g":"m","exFr":"Annoncez votre plan dès la première minute.","ipa":"[plɑ̃]","exAr":"أعلن مُخطَّطك في الدقيقة الأولى."},{"fr":"l’amorce","ar":"المقدّمة الجاذبة","pos":"nom","g":"f","exFr":"L’amorce doit capter l’attention en trente secondes.","ipa":"[a.mɔʁs]","exAr":"على المقدّمة أن تجذب الانتباه في ثلاثين ثانية."},{"fr":"la péroraison","ar":"الخاتمة الخطابية","pos":"nom","g":"f","exFr":"La péroraison rappelle la thèse.","ipa":"[pe.ʁɔ.ʁɛ.zɔ̃]","exAr":"تُذكّر الخاتمة بالثبة."},{"fr":"le connecteur","ar":"أداة الربط","pos":"nom","g":"m","exFr":"Un connecteur fluide évite les sauts.","ipa":"[kɔ̃.nɛk.tœʁ]","exAr":"أداة ربط سلسة تمنع القفزات."},{"fr":"d’une part… d’autre part","ar":"من جانب… ومن جانب آخر","pos":"loc.","g":"","exFr":"D’une part la méthode, d’autre part le budget.","ipa":"[dyn paʁ dotʁ paʁ]","exAr":"من جانب المنهج ومن جانب آخر الميزانية."},{"fr":"pour conclure","ar":"للخاتمة","pos":"loc.","g":"","exFr":"Pour conclure, la solution reste ouverte.","ipa":"[puʁ kɔ̃.klyʁ]","exAr":"للخاتمة، يبقى الحلّ مفتوحاً."},{"fr":"le registre soutenu","ar":"السجلّ الفصيح الرفيع","pos":"nom","g":"m","exFr":"Ce texte relève du registre soutenu.","ipa":"[ʁə.ʒistʁ su.te.ny]","exAr":"هذا النصّ ينتمي إلى السجلّ الفصيح."},{"fr":"considérablement","ar":"بشكل ملحوظ","pos":"adv","g":"","exFr":"Le nombre a considérablement augmenté.","ipa":"[kɔ̃.si.de.ʁa.blə.mɑ̃]","exAr":"ازداد العدد بشكل ملحوظ."},{"fr":"il est communément admis que","ar":"من المقبول عموماً أنّ","pos":"loc.","g":"","exFr":"Il est communément admis que la méthode fonctionne.","ipa":"[il e kɔ.mynə.mɑ̃ ad.mi ke]","exAr":"من المقبول عموماً أنّ المنهج ينجح."},{"fr":"soutenir une idée","ar":"يدافع عن فكرة","pos":"loc.","g":"","exFr":"Il soutient cette idée depuis dix ans.","ipa":"[sutniʁ yn idɛ]","exAr":"يدافع عن هذه الفكرة منذ عشر سنوات."},{"fr":"le public","ar":"الجمهور","pos":"nom","g":"m","exFr":"Regardez le public, pas vos notes.","ipa":"[py.blik]","exAr":"انظر إلى الجمهور لا إلى ملاحظاتك."},{"fr":"l’élocution","ar":"بلاغة النطق ووضوحه","pos":"nom","g":"f","exFr":"Son élocution claire impressionne.","ipa":"[e.lɔ.ky.sjɔ̃]","exAr":"إلقاؤه الواضح يُثير الإعجاب."}],"examples":[{"fr":"Je vais défendre trois points : la méthode, le coût, le délai.","ar":"سأدافع عن ثلاث نقاط: المنهج، الكلفة، الآجال.","note":"l’annonce du plan"},{"fr":"D’une part la théorie, d’autre part la pratique.","ar":"من جانب النظرية ومن جانب آخر الممارسة.","note":"la balance argumentative"},{"fr":"En somme, il s’agit moins de refuser que de réorganiser.","ar":"خلاصةً، المسألة أقلّ في الرفض وأكثر في إعادة التنظيم.","note":"le bilan"},{"fr":"Il est communément admis que la lecture forme l’esprit.","ar":"من المقبول عموماً أنّ القراءة تُصقل العقل.","note":"le registre soutenu"},{"fr":"Les résultats considérables confirment la tendance.","ar":"النتائج الملحوظة تؤكد الاتجاه.","note":"la montée en registre"},{"fr":"Il me reste à soulever une dernière question.","ar":"يُبقيني أن أطرح سؤالاً أخيراً.","note":"l’amorce de la chute"}],"grammar":[{"tFr":"La prospectivation et l’annonce : « je vais + infinitif », « il s’agit de », le futur simple","tAr":"أدوات الإعلان عن الخطاب: je vais + المصدر، وs’agir de، والمضارع البسيط للمستقبل","body":["Le discours oral annonce ce qui va venir : « Je vais défendre… », « Je vais d’abord rappeler… ». Le présent suivi de « je vais » vaut futur immédiat et reste plus vivant que le futur simple, réservé à l’écrit soutenu : « Cette analyse montrera que… »","Les formules impersonnelles cadrent le sujet : « Il s’agit de », « Il convient de », « Il importe de ». Elles remplacent avantageusement « on doit » (trop faible) et marquent la solennité sans affectation. Chacune se construit avec l’infinitif, jamais avec le subjonctif."],"ex":[{"fr":"Je vais d’abord rappeler la méthode, puis j’examinerai les limites.","ar":"سأذكّر أولاً بالمنهج ثم سأفحص الحدود."},{"fr":"Il convient de distinguer le fond de la forme.","ar":"يُلزمنا التمييز بين الجوهر والصورة."}]},{"tFr":"La périphrase et la nominalisation : monter en registre","tAr":"التعبير اللفيف والاسمية: الارتقاء في السجلّ","body":["Le passage au registre soutenu s’opère par deux opérations : la périphrase (« le lieu où l’on se réunit » pour « la salle ») et la nominalisation (« il augmente beaucoup » → « l’augmentation considérable »). La nominalisation condense la phrase et donne au discours son rythme d’écrit.","Attention à la surcharge : plus de trois noms abstraits d’affilée fatiguent l’auditoire. La règle d’or mêle registres : une phrase nominale dense suivie d’une phrase simple. C’est ce contraste qui fait entendre la différence entre la langue parlée et la langue d’exposition."],"ex":[{"fr":"L’augmentation considérable des coûts a modifié le projet.","ar":"الزيادة الملحوظة في الكلفات عدّلت المشروع."},{"fr":"Il convient d’examiner les limites de cette approche.","ar":"يُلزمنا فحص حدود هذا المقاربة."}]}],"mistakes":[{"wrong":"lire son texte ligne à ligne","right":"annoncer le plan et lever les yeux","why":"la lecture linéaire tue le lien avec le public — القراءة المتتالية تقتل الصلة بالجمهور."},{"wrong":"accumuler les connecteurs de transition","right":"un connecteur net par passage","why":"le signal doit être unique pour être perçu — الإشارة يجب أن تكون فريدة لتُلتقط."},{"wrong":"mélanger le soutenu et le familier","right":"tenir un registre constant","why":"le mélange affaiblit la crédibilité — الخلط يُضعف المصداقية."},{"wrong":"réserver toute la préparation aux mots","right":"chronométrer l’amorce, le développement, la chute","why":"le temps mal réparti se voit à l’écoute — الوقت الموزَّع سيئاً يُكشف عند الإنصات."}],"dialogues":[{"title":"Préparer une conférence","ctx":"طالبة تعدّ عرضاً أمام مُرشِّدها الأكاديمي","lines":[{"who":"Yasmine","fr":"J’ai prévu trois points en dix minutes.","ar":"لديّ ثلاث نقاط في عشر دقائق."},{"who":"Monsieur Blanc","fr":"Annoncez-le dès la première minute.","ar":"أعلنه في الدقيقة الأولى."},{"who":"Yasmine","fr":"Et pour la fin, je reprends la question initiale.","ar":"أما للختام فأُعيد السؤال الأوّل."},{"who":"Monsieur Blanc","fr":"Parfait : une péroraison ouverte, pas un résumé.","ar":"ممتاز: خاتمة مفتوحة لا ملخّص."}]},{"title":"Monter en registre","ctx":"مُحاضِر يُصحّح نصّ عرض تقديمي","lines":[{"who":"Professeure","fr":"Ici, remplacez « beaucoup » par « considérablement ».","ar":"هنا استبدلوا « beaucoup » بـ « considérablement »."},{"who":"Samuel","fr":"Et « on dit que » devient « il est admis que » ?","ar":"وهل يصبح « on dit que » إلى « il est admis que »؟"},{"who":"Professeure","fr":"Exactement : le soutenu évite le pronom « on ».","ar":"بالضبط: السجلّ الرفيع يتجنّب الضمير « on »."},{"who":"Samuel","fr":"Je réécris donc l’introduction entière.","ar":"سأعيد إذن كتابة المقدّمة كلّها."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"أي تعبير يُستعمل لإعلان le plan في بداية خطاب؟","opts":["Je vais défendre trois points.","Il pleut beaucoup.","À demain.","Je vous embrasse."],"a":0,"why":"l’annonce du plan oriente l’auditoire dès la première minute."},{"t":"fill","skill":"grammar","q":"أكمل: «___ conclure, la question reste ouverte.»","fr":"___ conclure, la question reste ouverte.","ans":"Pour","why":"« pour + infinitif » introduit la finalité ou la transition finale."},{"t":"order","skill":"writing","q":"رتّب: أوّلاً المنهج ثم الكلفة","words":["D’abord","la","méthode,","ensuite","le","coût."],"ans":"D’abord la méthode, ensuite le coût.","why":"la structure d’annonce : marqueur temporel + sujet + marqueur de suite."},{"t":"listen","skill":"listening","q":"ما عبارة الانتقال المناسبة لعرض نقطة ثانية؟","opts":["Passons au deuxième point.","Bonne nuit.","À votre santé.","Je pars demain."],"a":0,"why":"la transition annonce le passage d’une partie à l’autre."},{"t":"translate","skill":"writing","q":"ترجم: «من المقبول عموماً أنّ القراءة تُصقل العقل.»","ans":"Il est communément admis que la lecture forme l’esprit.","why":"« il est admis que » تُغني عن « on dit que » في le registre soutenu."},{"t":"speaking","skill":"speaking","q":"قدّم في ستين ثانية خُطَّة من ثلاث نقاط لمشروع تخرّجك مستعملًا les connecteurs.","target":"d’abord / ensuite / pour conclure","why":"la prise de parole chronométrée تُدرِّب على la gestion du temps."},{"t":"correct","skill":"grammar","q":"صحّح: «On peut dire que beaucoup de gens sont d’accord.»","ans":"Il est communément admis qu’un grand nombre de personnes sont d’accord.","why":"le registre soutenu évite « on » et remplace « beaucoup »."},{"t":"writing","skill":"writing","q":"اكتب خمسة أسطر تُعلن فيها خُطَّة عرض ثم تنقل إلى نقطتك الأولى.","target":"je vais / d’une part / pour ce qui est de","why":"الكتابة الخطابية تُثبِّت les connecteurs d’annonce."}],"homework":"حضّر خُطَّة من ثلاث نقاط لعرض من خمس دقائق، اكتب مقدّمتك وخاتمتك في نصّ مكتوب بـ le registre soutenu، ثم تدرّب على القراءة بتوقيت مضبوط.","sources":[{"title":"Comment devenir un conférencier professionnel hors pair ? - Michel Poulaert","channel":"Cyril Chambard","videoId":"kRm5DvNoSrM","why":"حوار مُعمَّق مع خبير في la prise de parole: كيف يُبنى le plan، وكيف يُوزَّع le temps بين les parties، وكيف يتحوّل le langage quotidien إلى le registre soutenu دون جمود.","cat":"Rhétorique","level":"C1","main":true},{"title":"Parler un bon français - LE LANGAGE SOUTENU ! (4 astuces)","channel":"Le français by Alex","videoId":"jyzPOxnApH0","why":"أربع طرق عملية للانتقال إلى le langage soutenu: المفردات، النحو، واللباقة دون جمود.","cat":"Rhétorique","level":"C1","extra":true},{"title":"S’entraîner à mieux parler : 5 habitudes quotidiennes pour être plus éloquent, clair et confiant","channel":"Laetitia Valstar (Français)","videoId":"yDzKRFn0Oko","why":"خمس عادات يومية لبناء la présence et la clarté قبل le discours نفسه.","cat":"Rhétorique","level":"C1","extra":true}],"supplements":[{"id":"jyzPOxnApH0","title":"Parler un bon français - LE LANGAGE SOUTENU ! (4 astuces)","channel":"Le français by Alex","why":"أربع طرق عملية للانتقال إلى le langage soutenu: المفردات، النحو، واللباقة دون جمود.","lang":"fr","dur":8},{"id":"yDzKRFn0Oko","title":"S’entraîner à mieux parler : 5 habitudes quotidiennes pour être plus éloquent, clair et confiant","channel":"Laetitia Valstar (Français)","why":"خمس عادات يومية لبناء la présence et la clarté قبل le discours نفسه.","lang":"fr","dur":9}]},{"id":"c1-t5-l6","fr":"Structurer une thèse complexe","ar":"بناء ثبة مركّبة","objectives":["صياغة ثبة مُنقَّحة لا أحادية: « non pas que… mais plutôt » et « dans une certaine mesure »","بناء hypothèse binaire et hypothèse de travail في نصّ تحليلي","ادماج la contre-argumentation داخل la démonstration دون إسقاطها","ختم نصّ بـ la conclusion ouverte تفتح la réflexion بدل أن تُغلقها"],"sections":[{"h":"الدرس 6: كيف تبني ثبة لا تنطوي على التبسيط: la nuance, les hypothèses, la contre-argumentation","video":{"id":"9pNwFwK_dHM","title":"La thèse expliquée simplement | Texte argumentatif facile pour le BAC","channel":"Mon coach de français","why":"شرح عملي لبنية le texte argumentatif: أين توضع la thèse، كيف تُبنى la démonstration، ولماذا تكون la conclusion ouverte أفضل من la sentence مغلقة في le niveau C1.","lang":"fr","main":true,"dur":8},"p":["la thèse المركّبة تبدأ بالرفض البسيط: « non pas que la thèse adverse soit fausse, mais plutôt que… ». هذا البناء يُبقي la concession حيّة داخل la thèse نفسها، وهو علامة le niveau C1: النصّ يُفكّك بدل أن يُكرّر.","la nuance المنهجية ليست تردد: « dans une certaine mesure », « à condition que » + subjonctif, « pour autant » تعكس la précision. القاعدة: كلّ تكييف يُقترن بـ la condition أو le domaine : « certes sur le plan technique, mais pas sur le plan moral » — من دونها تتحوّل la nuance إلى évasion.","les hypothèses: l’hypothèse de travail (« admettons que… ») تفتح la démonstration، وl’hypothèse alternative (« à supposer que… ») تختبر la thèse. Dans la dissertation française، la méthode des hypothèses تُحلّ la problématique: تُعطي la question شقّين ثم تُرجّح أحدهما بالأدلة.","la contre-argumentation تأتي في la position la plus forte: بعد la première partie لا قبلها. الصيغ: « On pourrait objecter que… » ثم la réponse « C’est vrai en apparence, mais… ». لاحظ la progression: objecter (infinitif) → répondre (rectificatif) → relancer (conclusion partielle).","la conclusion ouverte: تُعيد la question على مستوى جديد: « Reste à savoir si… », « Cette analyse ouvre la voie à… ». الممنوع هو la récapitulation المجرّدة والحكم النهائي الذي يُغلق le sujet. la conclusion ouverte لا تُلغي la thèse بل تُظهر أنّها جزء من la question الأكبر.","الخلاصة العملية: لاحب بناء نصّ من ثلاث طبقات — la thèse المُعلَنة، la thèse المُنقَّحة داخلها (avec la concession)، la perspective المفتوحة في آخر سطرين. هذا الثلاثي هو ما يميّز l’argumentation C1 عن l’argumentation scolaire المُسطَّحة."],"sub":[{"h":"nuancer la thèse","p":["Non pas que l’autre ait tort, mais plutôt que…","Dans une certaine mesure, l’objection tient.","Cette thèse vaut pour le court terme."]},{"h":"travailler par hypothèses","p":["Admettons que la mesure soit efficace.","À supposer que le coût reste faible, que se passe-t-il ?","L’hypothèse alternative fait apparaître la faille."]},{"h":"ouvrir la conclusion","p":["On pourrait objecter que… ; c’est vrai en apparence.","Reste à savoir si le modèle est transférable.","Cette analyse ouvre la voie à une recherche future."]}]},{"h":"les tournures de la thèse complexe","p":["« Non pas que… mais plutôt que… » — la rectification de la thèse.","« Dans une certaine mesure, oui ; toutefois… » — la nuance conditionnelle.","« Admettons que… ; dès lors que… » — l’hypothèse de travail.","« Reste à savoir si… » — la conclusion ouverte."]},{"h":"التطبيق والتلخيص","p":["تمرين la nuance: خمس جمل حادّة، أعد كتابة كلٍّ منها بناءً « non pas que… mais plutôt » أو « pour autant ».","تمرين les hypothèses: ضع مشكلة واحدة واكتب لها hypothesis de travail ثم hypothesis alternative ثم الحكم بـ la preuve.","تمرين la contre-argumentation: اكتب فقرة فيها مقدّمة ثم اعتراض ثم ردّ ثم conclusion partielle — أربعة أسطر بالضبط."]}],"pron":[{"w":"la thèse","ipa":"[la tɛz]","approx":"لا تيز"},{"w":"l’hypothèse","ipa":"[li.nɔ.tɛz]","approx":"ليبوتيز"},{"w":"la nuance","ipa":"[la ny.ɑ̃s]","approx":"لا نويانس"}],"vocab":[{"fr":"la thèse","ar":"الثبة الأساسية","pos":"nom","g":"f","exFr":"Sa thèse tient en une phrase.","ipa":"[tɛz]","exAr":"ثبته تتضمّن جملة واحدة."},{"fr":"la nuance","ar":"التليين والتمييز الدقيق","pos":"nom","g":"f","exFr":"La nuance distingue l’analyse du slogan.","ipa":"[ny.ɑ̃s]","exAr":"التليين يُميّز التحليل عن الشعار."},{"fr":"l’hypothèse","ar":"الفرضية","pos":"nom","g":"f","exFr":"Cette hypothèse reste à vérifier.","ipa":"[i.pɔ.tɛz]","exAr":"تبقى هذه الفرضية قابلة للفحص."},{"fr":"la contre-argumentation","ar":"الحجّة المُناقِضة الداخلية","pos":"nom","g":"f","exFr":"La contre-argumentation renforce la démonstration.","ipa":"[kɔ̃tʁ.aʁ.ɡy.mɑ̃.ta.sjɔ̃]","exAr":"الحجّة المُناقِضة تقوّي البرهان."},{"fr":"le contre-exemple","ar":"المثال المُناقِض","pos":"nom","g":"m","exFr":"Un contre-exemple oblige à préciser la thèse.","ipa":"[kɔ̃tʁ.ɛɡ.zɑ̃.pl]","exAr":"مثال مُناقِض يُلزمنا بتوثيق الثبة."},{"fr":"nuancer","ar":"يُنقِّح ويشترط","pos":"verbe","g":"","exFr":"Il faut nuancer cette affirmation.","ipa":"[ny.ɑ̃.se]","exAr":"يجب تليين هذا التأكيد."},{"fr":"supposer","ar":"يفترض","pos":"verbe","g":"","exFr":"Supposons que le coût augmente.","ipa":"[su.po.ze]","exAr":"لنقل إنّ الكلفة ارتفعت."},{"fr":"admettre que","ar":"يُسلّم بـ","pos":"loc.","g":"","exFr":"Admettons que l’objection soit juste.","ipa":"[ad.mɛtʁ ke]","exAr":"لنقل إنّ الاعتراض صحيح."},{"fr":"pour autant","ar":"مع ذلك / وقَسماً على ذلك","pos":"loc.","g":"","exFr":"Le chiffre baisse ; pour autant, le problème demeure.","ipa":"[puʁ o.tɑ̃]","exAr":"انخفض الرقم؛ ومع ذلك بقيت المشكلة."},{"fr":"à condition que","ar":"بشرط أنّ","pos":"loc.","g":"","exFr":"Cette thèse tient à condition que la méthode soit appliquée.","ipa":"[a kɔ̃.di.sjɔ̃ ke]","exAr":"تثبت هذه الفكرة بشرط تطبيق المنهج."},{"fr":"la démonstration","ar":"البرهان والتوجيه","pos":"nom","g":"f","exFr":"Sa démonstration avance en trois temps.","ipa":"[de.mɔ̃.stʁa.sjɔ̃]","exAr":"يتقدّم برهانه في ثلاث مراحل."},{"fr":"ouvrir la réflexion","ar":"يفتح أفق التفكير","pos":"loc.","g":"","exFr":"La conclusion ouvre la réflexion.","ipa":"[uvʁiʁ la ʁɛ.flek.sjɔ̃]","exAr":"تفتح الخاتمة أفق التفكير."}],"examples":[{"fr":"Non pas que l’autre ait tort, mais plutôt que son cadre est limité.","ar":"ليس لأنّ الطرف الآخر مُخطئ، بل لأنّ إطاره محدود.","note":"la rectification"},{"fr":"Dans une certaine mesure, l’objection tient.","ar":"إلى حدٍّ ما، يصمد الاعتراض.","note":"la nuance limitée"},{"fr":"Admettons que la mesure soit efficace ; reste son coût.","ar":"لنقل إنّ الإجراء فعّال؛ يبقى كلفته.","note":"l’hypothèse de travail"},{"fr":"On pourrait objecter que le modèle n’est pas transposable.","ar":"يمكن الاعتراض بأنّ النموذج غير قابل للنقل.","note":"la contre-argumentation"},{"fr":"C’est vrai en apparence, mais pas sur le fond.","ar":"صحيح في الظاهر لا في الباطن.","note":"le rectificatif"},{"fr":"Reste à savoir si cette logique vaut à long terme.","ar":"يبقى أن نعرف ما إن كانت هذه المنطقية تصلح على المدى الطويل.","note":"la conclusion ouverte"}],"grammar":[{"tFr":"La subordination de but et de condition : afin que, pour que, à condition que, à supposer que","tAr":"الجمل الشرطية وجمل الغاية: afin que، وpour que، وà condition que، وà supposer que","body":["La thèse complexe se construit avec des subordonnées qui exposent ses limites : « afin que » et « pour que » expriment la finalité + subjonctif (« je nuance afin que le lecteur décide »), « à condition que » impose une condition + subjonctif, « à supposer que » teste une hypothèse + subjonctif.","Le registre soutenu préfère ces formes à « si » simple : « Si la mesure fonctionne » devient « à supposer que la mesure fonctionne », ce qui signale l’hypothèse et non la certitude. La nuance négative vient avec « sans que » + subjonctif : « la thèse progresse sans que l’on décide. »"],"ex":[{"fr":"Cette conclusion vaut à condition que l’on vérifie les données.","ar":"يصمد هذا الاستنتاج بشرط التحقق من البيانات."},{"fr":"Il nuance afin que le débat puisse se poursuivre.","ar":"يُنقِّح لكي يستطيع النقاش الاستمرار."}]},{"tFr":"La tournure restrictive et le registre de la concession interne : « non pas que… mais », « pour autant »","tAr":"بنية التقييد والتنازل الداخلي","body":["« Non pas que » + subjonctif nie la cause alléguée, puis « mais » rétablit : « Non pas que je nie le chiffre, mais son interprétation est partielle. » Elle évite l’accusation directe et place la discussion sur l’interprétation.","« Pour autant » marque la conséquence née de la concession : elle ouvre une phrase qui maintient la thèse malgré l’aveu précédent. « L’étude est limitée ; pour autant, elle ouvre une piste. » De même, « certes… cependant… » structure la contre-argumentation en deux temps."],"ex":[{"fr":"Non pas que la méthode soit fausse, mais son champ est étroit.","ar":"ليس لأنّ المنهج خاطئ، بل لأنّ نطاقه ضيّق."},{"fr":"L’expérience est longue ; pour autant, elle reste précieuse.","ar":"التجربة طويلة؛ غير أنّها تبقى ثمينة."}]}],"mistakes":[{"wrong":"confondre nuance et renoncement","right":"nuancer = préciser, renoncer = abandonner","why":"la nuance limite la thèse sans la supprimer — التليين يُقيّد الثبة ولا يُلغيها."},{"wrong":"placer la contre-argumentation en premier","right":"la placer après la première partie développée","why":"la force de l’objection se mesure à ce qu’elle attaque — قوّة الاعتراض تُقاس بما يُناقِضه."},{"wrong":"terminer par « voilà mon avis, fin »","right":"terminer par « reste à savoir si… »","why":"la conclusion ouverte montre l’enjeu supérieur — الخاتمة المفتوحة تُظهر المستوى الأعلى من السؤال."},{"wrong":"accumuler les conditions sans hypothèse","right":"faire d’une hypothèse le cadre du raisonnement","why":"l’hypothèse donne à la démonstration sa direction — الفرضية تمنح البرهان اتجاهه."}],"dialogues":[{"title":"Nuancer une thèse","ctx":"مناقشة بين طالبتين حول مشروع تخرّج","lines":[{"who":"Leïla","fr":"Ta thèse dit que la technologie suffit.","ar":"ثبتك تقول إنّ التقنية كافية."},{"who":"Mina","fr":"Non pas qu’elle suffise, mais qu’elle ouvre la voie.","ar":"ليس لأنّها كافية بل لأنّها تمهّد الطريق."},{"who":"Leïla","fr":"Alors précise : à condition que l’usage soit encadré ?","ar":"إذن وثّقي: بشرط أن يكون الاستخدام مؤطَّراً؟"},{"who":"Mina","fr":"Exactement : c’est là toute la nuance.","ar":"بالضبط: هناك يكمن كلّ التليين."}]},{"title":"Ouvrir la conclusion","ctx":"أستاذ يُراجع خاتمة مقالة تحليلية","lines":[{"who":"Madame Faure","fr":"Votre dernière phrase jette l’affaire.","ar":"جملتك الأخيرة تُغلق القضية."},{"who":"Bastien","fr":"Je croyais devoir conclure net.","ar":"ظننتُ عليّ أن أختم بوضوح."},{"who":"Madame Faure","fr":"Conclure, oui ; fermer, non.","ar":"أن تُختم، نعم؛ أن تُغلق، لا."},{"who":"Bastien","fr":"Je propose : reste à savoir si le modèle tient.","ar":"أقترح: يبقى أن نعرف إن كان النموذج صامداً."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"أي عبارة تفتح conclusion ouverte بدل أن تُغلقها؟","opts":["Reste à savoir si…","Donc tout est résolu.","Merci de votre attention.","Voilà la fin."],"a":0,"why":"« reste à savoir si » maintient la question ouverte au lecteur."},{"t":"fill","skill":"grammar","q":"أكمل: «Cette thèse tient ___ que la méthode soit appliquée.»","fr":"Cette thèse tient ___ que la méthode soit appliquée.","ans":"à condition","why":"la condition exige la locution « à condition que » + subjonctif."},{"t":"order","skill":"writing","q":"رتّب: يبقى أن نعرف إن كانت الفرضية صحيحة","words":["Reste","à","savoir","si","l’hypothèse","tient."],"ans":"Reste à savoir si l’hypothèse tient.","why":"structure impersonnelle de la conclusion ouverte."},{"t":"listen","skill":"listening","q":"ما الصيغة الأنسب لتقديم اعتراض داخلي؟","opts":["On pourrait objecter que…","Bonne journée.","À demain.","C’est délicieux."],"a":0,"why":"« objecter que » introduit la contre-argumentation poliment."},{"t":"translate","skill":"writing","q":"ترجم: «ليس لأنّ المنهج خاطئ، بل لأنّ نطاقه ضيّق.»","ans":"Non pas que la méthode soit fausse, mais son champ est étroit.","why":"« non pas que » + subjonctif puis « mais » + indicatif."},{"t":"speaking","skill":"speaking","q":"دافع عن رأي مُعقَّد في ثلاث جمل: thèse، ثم concession، ثم conclusion ouverte.","target":"dans une mesure / pour autant / reste à savoir","why":"إنتاج شفوي يجمع les trois couches de la thèse complexe."},{"t":"correct","skill":"grammar","q":"صحّح: «À condition que la mesure sera efficace, nous persistons.»","ans":"À condition que la mesure soit efficace, nous persistons.","why":"après « à condition que », le subjonctif s’impose : soit."},{"t":"writing","skill":"writing","q":"اكتب أربعة أسطر تُقدّم فيها فرضية ثم تختبرها ثم تُختم بـ « reste à savoir si… ».","target":"hypothèse / contre-exemple / conclusion ouverte","why":"الفقرة المركّبة تُدرِّب على la démonstration من ثلاث طبقات."}],"homework":"اكتب مقالة من 250 كلمة حول قضية محايدة، والتزم بالبنية الآتية: ثبة مُعلَنة، اعتراض واحد مُقاوَم بـ « c’est vrai… mais »، فرضية واحدة، ثم خاتمة تبدأ بـ « Reste à savoir si… ».","sources":[{"title":"La thèse expliquée simplement | Texte argumentatif facile pour le BAC","channel":"Mon coach de français","videoId":"9pNwFwK_dHM","why":"شرح عملي لبنية le texte argumentatif: أين توضع la thèse، كيف تُبنى la démonstration، ولماذا تكون la conclusion ouverte أفضل من la sentence مغلقة في le niveau C1.","cat":"Rhétorique","level":"C1","main":true},{"title":"Le texte argumentatif : la thèse | Français | Alloprof","channel":"Alloprof","videoId":"fo5pQFn18Ig","why":"عرض منهجي لبنية le texte argumentatif: la thèse، les arguments، la preuve — أساس الدرس قبل la nuance.","cat":"Rhétorique","level":"C1","extra":true},{"title":"Comment avoir 20/20 à la DISSERTATION de PHILOSOPHIE : la Méthode Ultime","channel":"Les Sherpas - Étudiants","videoId":"QdifHVKMWho","why":"كيف تُبنى la problématique وتُدار les hypothèses في la dissertation الفرنسية خطوة بخطوة.","cat":"Rhétorique","level":"C1","extra":true}],"supplements":[{"id":"fo5pQFn18Ig","title":"Le texte argumentatif : la thèse | Français | Alloprof","channel":"Alloprof","why":"عرض منهجي لبنية le texte argumentatif: la thèse، les arguments، la preuve — أساس الدرس قبل la nuance.","lang":"fr","dur":6},{"id":"QdifHVKMWho","title":"Comment avoir 20/20 à la DISSERTATION de PHILOSOPHIE : la Méthode Ultime","channel":"Les Sherpas - Étudiants","why":"كيف تُبنى la problématique وتُدار les hypothèses في la dissertation الفرنسية خطوة بخطوة.","lang":"fr","dur":12}]}]},{"id":"c1-t6","slug":"civilisation-pensee-francaise","icon":"grad","color":"#0f766e","fr":"Civilisation & pensée française","ar":"الحضارة والفكر الفرنسي","desc":"les Lumières، la laïcité، les institutions، l’Europe، le patrimoine، les débats contemporains.","lessons":[{"id":"c1-t6-l1","fr":"Les Lumières","ar":"التنوير: فولتير وروسو وديدرو — العقل والحرية والمواطنة","objectives":["فهم المشروع الفكري لـ Les Lumières: la raison, la critique, le progrès","استخراج مفردات فلسفية: l’encyclopédie, la censure, le despotisme, le contrat social","التمييز بين le style argumentatif الفلسفي ولغة la narration","تحليل اقتباساً من فولتير أو روسو وتحديد sa thèse وses arguments"],"sections":[{"h":"الدرس 1: كيف وُلد مشروع Les Lumières في القرن الثامن عشر","video":{"id":"gnG2sqDLq6g","title":"Les philosophes des lumières","channel":"Amélie Vioux - Bac de français","why":"عرض منظم لأهم philosophes des Lumières — Voltaire, Rousseau, Diderot — مع شرح leur projet: استخدام la raison pour critiquer l’arbitraire et défendre la liberté de pensée.","lang":"fr","main":true,"dur":11},"p":["Les Lumières حركة فكرية وثقافية نشأت في أوروبا في القرن الثامن عشر، وبلغت ذروتها في فرنسا. مؤسسوها — فولتير وروسو وديدرو ومونتسكيو — كانوا يؤمنون بأن la raison، أي العقل الناقد، قادرة على تحرير الإنسان من la superstition ومن l’arbitraire du pouvoir.","المشروع الأساسي هو l’Encyclopédie: موسوعة ضخمة أشرف عليها ديدرو ودارلا معلّم، جمع فيها حوالي مئة وسبعين كاتباً معارفهم ومعلوماتهم التقنية والعلمية والفلسفية. le but: نشر المعرفة entre toutes les classes de la société وليس بين النخبة فقط.","فولتير دافع عن la liberté de conscience وla liberté d’expression مستعملاً l’ironie وla satire: في Candide ينتقد l’intolérance والظلم عبر récit imaginaire. روسو، في Du contrat social، يضع مبدأ la souveraineté du peuple: la légitimité politique تقوم على le consentement mutuel des citoyens.","نحوياً، يعتمد le discours philosophique sur les moyens de la persuasion: l’argumentation avec les connecteurs (car, or, donc, cependant), وle subjonctif للتعبير عن le doute أو la nécessité (« il faut que la raison triomphe »)، وla forme passive لإعطاء le caractère universel aux idées.","الخطأ الشائع أن نختزل Les Lumières في «العقل وحده»: الفلاسفة لم يُنكروا la foi فحسب، بل طالبوا بـ la tolérance وفصل la autorité spirituelle عن la puissance politique — وهو ما مهّد لاحقاً لفكرة la laïcité في القانون الفرنسي.","بعد الدرس، اقرأ فقرة من Candide أو من le Contrat social، حدد la thèse في جملة واحدة، ثم استخرج ثلاث كلمات فلسفية وابحث عن جذورها اللاتينية. هذه الطريقة تُطوّر la lecture cursive في المستوى C1."],"sub":[{"h":"le siècle de la raison","p":["La raison doit éclairer les esprits.","Les philosophes critiquent l’arbitraire.","L’encyclopédie diffuse le savoir."]},{"h":"Voltaire, Rousseau, Diderot","p":["Voltaire défend la liberté de conscience.","Rousseau théorise la souveraineté du peuple.","Diderot dirige l’Encyclopédie."]},{"h":"un héritage politique","p":["La critique prépare les réformes.","La tolérance devient une valeur.","Les idées traversent le XVIIIe siècle."]}]},{"h":"les formules de l’argumentation philosophique","p":["« Il convient de distinguer… » — l’ouverture d’une analyse nuancée.","« Selon Voltaire, la tolérance… » — l’attribution d’une idée à un auteur.","« Ce qui frappe, c’est que… » — l’introduction d’un constat.","« D’où la nécessité de… » — la conclusion logique d’un raisonnement."]},{"h":"التطبيق والتلخيص","p":["تمرين la thèse: اقرأ اقتباساً قصيراً من فولتير، اكتب la thèse في جملة واحدة ثم استخرج deux arguments.","تمرين la reformulation: حوّل جملة من le registre courant إلى le registre philosophique: « C’est injuste » → « Cette situation heurte le principe d’égalité ».","تمرين le débat: أعد صياغة جدل بين Voltaire (la liberté) وRousseau (la souveraineté) في أربع جمل، مع استعمال les connecteurs car, or, donc."]}],"pron":[{"w":"la raison","ipa":"[la ʁɛ.zɔ̃]","approx":"لا ريزون"},{"w":"l’encyclopédie","ipa":"[lɑ̃.si.klɔ.pe.di]","approx":"لانسيكلوبيدي"},{"w":"le despotisme","ipa":"[lə dɛs.pɔ.tism]","approx":"لُ دسبوتيسْم"}],"vocab":[{"fr":"la raison","ar":"العقل","pos":"nom","g":"f","exFr":"La raison guide le jugement.","ipa":"[la ʁɛ.zɔ̃]","exAr":"يقود العقل الحكم."},{"fr":"les Lumières","ar":"التنوير (الحركة الفلسفية)","pos":"nom","g":"f","exFr":"Les Lumières valorisent la critique.","ipa":"[le ly.mjɛʁ]","exAr":"يُثمن التنوير القدرة على النقد."},{"fr":"l’encyclopédie","ar":"الموسوعة","pos":"nom","g":"f","exFr":"Diderot dirige l’Encyclopédie.","ipa":"[lɑ̃.si.klɔ.pe.di]","exAr":"يشرف ديدرو على الموسوعة."},{"fr":"la censure","ar":"الرقابة على النشر","pos":"nom","g":"f","exFr":"La censure interdit certains textes.","ipa":"[la sɑ̃.sɥʁ]","exAr":"تمنع الرقابة نصوصاً معينة."},{"fr":"le despotisme","ar":"الاستبداد","pos":"nom","g":"m","exFr":"Les philosophes critiquent le despotisme.","ipa":"[lə dɛs.pɔ.tism]","exAr":"ينتقد الفلاسفة الاستبداد."},{"fr":"la tolérance","ar":"التسامح","pos":"nom","g":"f","exFr":"Voltaire prône la tolérance.","ipa":"[la tɔ.le.ʁɑ̃s]","exAr":"يدعو فولتير إلى التسامح."},{"fr":"le contrat social","ar":"العقد الاجتماعي","pos":"loc.","g":"m","exFr":"Rousseau fonde la politique sur le contrat social.","ipa":"[lə kɔ̃.tʁa sɔ.sjal]","exAr":"يؤسس روسو السياسة على العقد الاجتماعي."},{"fr":"la souveraineté","ar":"السيادة","pos":"nom","g":"f","exFr":"La souveraineté réside dans le peuple.","ipa":"[la su.veʁ.nə.te]","exAr":"تقيم السيادة في الشعب."},{"fr":"la liberté de conscience","ar":"حرية الضمير","pos":"loc.","g":"f","exFr":"La liberté de conscience est un droit.","ipa":"[la li.beʁ.te də kɔ̃.sjɑ̃s]","exAr":"حرية الضمير حق."},{"fr":"l’intolérance","ar":"التعصب","pos":"nom","g":"f","exFr":"L’intolérance divise la société.","ipa":"[lɛ̃.tɔ.le.ʁɑ̃s]","exAr":"يفصل التعصب المجتمع."},{"fr":"critiquer","ar":"ينتقد","pos":"verbe","g":"","exFr":"Les philosophes critiquent l’arbitraire.","ipa":"[kʁi.ti.ke]","exAr":"ينتقد الفلاسفة التحكم."},{"fr":"diffuser","ar":"ينشر","pos":"verbe","g":"","exFr":"L’encyclopédie diffuse le savoir.","ipa":"[di.fɥe]","exAr":"تنشر الموسوعة المعرفة."}],"examples":[{"fr":"La raison doit éclairer les esprits.","ar":"يجب أن ينير العقل الأذهان.","note":"le présent de vérité générale"},{"fr":"Selon Voltaire, la tolérance est une vertu civile.","ar":"حسب فولتير، التسامح فضيلة مدنية.","note":"l’attribution d’une idée"},{"fr":"Il faut que la raison triomphe de la superstition.","ar":"يجب أن ينتصر العقل على الخرافة.","note":"le subjonctif de nécessité"},{"fr":"L’Encyclopédie a été censurée plusieurs fois.","ar":"رُقّبت الموسوعة عدة مرات.","note":"la voix passive"},{"fr":"D’où la nécessité de distinguer liberté et licence.","ar":"من هنا تبرز ضرورة التمييز بين الحرية والانحلال.","note":"la conclusion logique"},{"fr":"Le philosophe affirme que le pouvoir légitime vient du peuple.","ar":"يؤكد الفيلسوف أن السلطة المشروعة تنبع من الشعب.","note":"la thèse de Rousseau"}],"grammar":[{"tFr":"Le subjonctif dans le discours philosophique","tAr":"الموصوف في الخطاب الفلسفي","body":["Le subjonctif exprime la nécessité, le doute ou le projet : « Il faut que la raison éclaire la société », « bien que la censure soit fragile ». Dans l’argumentation, il marque que la vérité n’est pas seulement constatée, mais visée.","On le trouve après les verbes de volonté (vouloir que, souhaiter que) et les locutions concessives (bien que, encore que). Le registre philosophique l’associe aux mots abstraits : progrès, bonheur, vertu."],"ex":[{"fr":"Il faut que chaque citoyen soit informé.","ar":"يجب أن يكون كل مواطن على علم."},{"fr":"Bien que la censure soit ancienne, les idées circulent.","ar":"على أن الرقابة قديمة، تتناقل الأفكار."}]},{"tFr":"L’argumentation : connecteurs et modalisation","tAr":"الإقناع: أدوات الربط والتمييز","body":["Les connecteurs logiques structurent la démonstration : car (la cause), or (la concession), donc (la conséquence), cependant (l’opposition). Ils remplacent le simple « et » par une progression argumentée.","La modalisation nuance l’énoncé : « il semble que », « sans doute que », « à mon sens ». En C1, elle évite l’affirmation brutale et installe un ton mesuré, propre au débat d’idées."],"ex":[{"fr":"La critique est utile, car elle prépare le progrès.","ar":"النقد مفيد، لأنه يهيئ التقدم."},{"fr":"Or, la liberté sans droit n’est qu’une licence.","ar":"غير أن الحرية بلا حق ليست سوى انحلال."}]}],"mistakes":[{"wrong":"dire « les Lumières ont écrit »","right":"dire « les philosophes des Lumières ont écrit »","why":"Les Lumières désignent le mouvement, pas les personnes — التنوير حركة وليس أشخاصاً."},{"wrong":"confondre raison et rationalisme absolu","right":"nuancer : la raison critique, elle ne nie pas tout","why":"les philosophes distinguent raison et croyance — العقل النقدي لا يُلغي كل شيء."},{"wrong":"traduire contrat social par « society contract »","right":"employer la locution française consacrée « le contrat social »","why":"c’est un concept de Rousseau avec son histoire propre — مصطلح له تاريخه الخاص."},{"wrong":"employer le registre familier pour citer un philosophe","right":"employer un ton soutenu et précis","why":"le discours philosophique exige la mesure et l’abstraction — الخطاب الفلسفي يقتضي الوقفة التجريدية."}],"dialogues":[{"title":"Séance de discussion sur Voltaire","ctx":"طالبان يناقشان في الدرس تراث Les Lumières","lines":[{"who":"Claire","fr":"D’après toi, quel est l’héritage principal des Lumières ?","ar":"حسب رأيك، ما أهم إرث للتنوير؟"},{"who":"Mehdi","fr":"La tolérance, car Voltaire défendait la liberté de conscience.","ar":"التسامح، لأن فولتير كان يدافع عن حرية الضمير."},{"who":"Claire","fr":"Or, Rousseau insiste sur la souveraineté du peuple.","ar":"غير أن روسو يؤكد على سيادة الشعب."},{"who":"Mehdi","fr":"Donc leurs idées se complètent plus qu’elles ne s’opposent.","ar":"إذن أفكارهما تتكامل أكثر مما تتعارض."}]},{"title":"L’Encyclopédie au salon","ctx":"مثقفان يتحدثان عن مشروع الديرو ودارلا في القرن الثامن عشر","lines":[{"who":"Antoine","fr":"L’Encyclopédie rassemble les savoirs de l’époque.","ar":"تجمع الموسوعة معارف عصرها."},{"who":"Louise","fr":"Oui, et elle a été censurée pour ses articles philosophiques.","ar":"نعم، وقد رُقّبت بسبب مقالاتها الفلسفية."},{"who":"Antoine","fr":"Malgré cela, les volumes circulaient clandestinement.","ar":"رغم ذلك، كانت الأجزاء تتداول سراً."},{"who":"Louise","fr":"C’est le triomphe lent de la raison sur l’arbitraire.","ar":"هو انتصار بطيء للعقل على التحكم."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما معنى « l’encyclopédie » في سياق Les Lumières؟","opts":["موسوعة نشر المعرفة","جريدة يومية","رسالة خاصة","مراسلة رسمية"],"a":0,"why":"l’Encyclopédie de Diderot est le projet de diffusion du savoir."},{"t":"fill","skill":"grammar","q":"أكمل بالموصوف: «Il faut que la raison ___ la société.»","fr":"Il faut que la raison ___ la société.","ans":"éclaire","why":"après « il faut que », on emploie le subjonctif : éclaire."},{"t":"order","skill":"writing","q":"رتّب: العقل يجب أن ينير الأذهان","words":["La","raison","doit","éclairer","les","esprits."],"ans":"La raison doit éclairer les esprits.","why":"ordre sujet-verbe- infinitif-complément, le point final sur le dernier mot."},{"t":"listen","skill":"listening","q":"ما المقصود بـ « la souveraineté du peuple » في نص روسو؟","opts":["أن السلطة تنبع من الشعب","أن الملك يملك كل الصلاحيات","أن الجيش يحكم الدولة","أن الكنيسة تشرّع القوانين"],"a":0,"why":"Rousseau fonde la légitimité sur le consentement des citoyens."},{"t":"translate","skill":"writing","q":"ترجم: «التسامح فضيلة مدنية عند فولتير.»","ans":"La tolérance est une vertu civile chez Voltaire.","why":"registre soutenu + « chez Voltaire » pour l’attribution."},{"t":"speaking","skill":"speaking","q":"اشرح في ثلاث جمل فكرة « le contrat social » مستعملاً les mots raison, souveraineté, citoyen.","target":"contrat social / souveraineté / citoyen","why":"production orale en registre abstrait et soutenu."},{"t":"correct","skill":"grammar","q":"صحّح: «Il faut que la censure disparaît.»","ans":"Il faut que la censure disparaisse.","why":"le subjonctif du verbe disparaître : disparaisse."},{"t":"mcq","skill":"reading","q":"أي جملة تلخص موقف فولتير بدقّة؟","opts":["Il défend la liberté de conscience contre l’intolérance.","Il rejette toute forme de politique.","Il prône le pouvoir militaire.","Il ignore la religion."],"a":0,"why":"Voltaire combat l’intolérance tout en restant croyant : position nuancée."}],"homework":"اقرأ صفحة واحدة من Candide بالفرنسية، اكتب ملخّصاً من ثلاث جمل، ثم استخرج ثلاث كلمات فلسفية (par ex. la raison, le préjugé, la vertu) مع مثال من النص لكل كلمة.","sources":[{"title":"Les philosophes des lumières","channel":"Amélie Vioux - Bac de français","videoId":"gnG2sqDLq6g","why":"عرض منظم لأهم philosophes des Lumières — Voltaire, Rousseau, Diderot — مع شرح leur projet: استخدام la raison pour critiquer l’arbitraire et défendre la liberté de pensée.","cat":"Civilisation","level":"C1","main":true},{"title":"Jean-Jacques Rousseau et les Lumières","channel":"Cliolix","videoId":"6CZh8TSjndI","why":"عرض مبسّط لفكر روسو داخل Les Lumières: le contrat social et la critique de l’inégalité — تدريب على la compréhension d’un exposé historique.","cat":"Civilisation","level":"C1","extra":true},{"title":"Rousseau et Voltaire au Panthéon : une rivalité éternelle !","channel":"Français avec Madame","videoId":"YpEL0meR5bE","why":"مقارنة بين الفيلسوفين عبر le lieu de mémoire (le Panthéon): تدريب على la comparaison et le registre culturel.","cat":"Civilisation","level":"C1","extra":true}],"supplements":[{"id":"6CZh8TSjndI","title":"Jean-Jacques Rousseau et les Lumières","channel":"Cliolix","why":"عرض مبسّط لفكر روسو داخل Les Lumières: le contrat social et la critique de l’inégalité — تدريب على la compréhension d’un exposé historique.","lang":"fr","dur":8},{"id":"YpEL0meR5bE","title":"Rousseau et Voltaire au Panthéon : une rivalité éternelle !","channel":"Français avec Madame","why":"مقارنة بين الفيلسوفين عبر le lieu de mémoire (le Panthéon): تدريب على la comparaison et le registre culturel.","lang":"fr","dur":10}]},{"id":"c1-t6-l2","fr":"La laïcité et le débat public","ar":"العلمانية والنقاش العام: التاريخ والقوانين ومفردات الجدل","objectives":["فهم المبدأ الدستوري لـ la laïcité و تاريخ تشكّله مع loi du 9 décembre 1905","استخراج مفردات النقاش: le principe, la neutralité, le culte, l’espace public, la jurisprudence","التمييز بين la laïcité et le secularism Anglo-Saxon في الحديث","صياغة شرح موضوعي لمبدأ civic بأربع جمل بلغة محايدة"],"sections":[{"h":"الدرس 2: كيف تُشرح la laïcité كمبدأ دستوري وكموضوع للنقاش","video":{"id":"zFB6WdSZTco","title":"La laïcité, c’est quoi ? Retour au texte de 1905 avec Patrick Weil","channel":"France Culture","why":"قراءة معمّقة لنص loi de 1905 مع Patrick Weil: التاريخ الفقدي لل princípio، مصادره، وتطبيقاته على l’école et l’espace public — نموذج لـ le débat d’idées بأسلوب أكاديمي.","lang":"fr","main":true,"dur":38},"p":["la laïcité مبدأ تنظّم العلاقة بين الدولة والديانات في فرنسا. القانون المرجعي هو loi du 9 décembre 1905 concernant la séparation des Églises et de l’État: الدولة لا تعترف بأي ديانة ولا تموّلها، وتضمن la liberté de conscience لكل شخص.","جذور المبدأ أقدم من 1905: نصوص القرن التاسع عشر (loi de 1880 et 1882) فصلت l’éducation عن l’autorité ecclésiastique، ثم جاء قانون 1905 ليؤسس la neutralité de l’État.Exceptions تاريخية تبقى في alsace-moselle وoutre-mer.","في الفضاء العمومي، تُطبَّق la laïcité عبر la neutralité des services publics: الموظفون ملتزمون بالحياد، والمؤسسة لا تُميّز بين المواطنين على أساس انتمائهم. هذا الملف هو موضوع le débat public المستمر، خاصة في l’école.","نحوياً، يعتمد le discours civique على le passif et la nominalisation لتجنب ذكر الفاعل: « la neutralité est garantie » بدل « l’État garantit ». ويستعمل les formules d’atténuation (« il convient de », « sans préjuger de ») لتوحيد le ton.","الخلط الشائع أن يُترجَم la laïcité إلى « irreligiosity »: المبدأ لا يُلغي la croyance، بل ينظّم l’espace commun. وتمييز آخر ضروري: la neutralité تتعلق بالمؤسسات، لا تفرض على les citoyens dans leur vie privée.","بعد الدرس، اقرأ مادة صحفية عن la laïcité، حدد لغة le journaliste: هل يستعمل la description أم l’argumentation؟ ثم اكتب فقرة محايدة من أربع جمل تشرح المبدأ لغير francophone."],"sub":[{"h":"un principe historique","p":["La loi de 1905 sépare les Églises de l’État.","La liberté de conscience est garantie.","La neutralité s’impose aux services publics."]},{"h":"laïcité et espace public","p":["L’école républicaine applique la neutralité.","Le débat porte sur les limites du principe.","La jurisprudence précise les cas concrets."]},{"h":"expliquer sans confondre","p":["La laïcité ne supprime pas la croyance.","Elle organise la vie commune.","Elle se distingue du secularism anglo-saxon."]}]},{"h":"les formules du discours civique","p":["« La loi de 1905 pose le principe de… » — l’annonce d’un fondement juridique.","« Selon la jurisprudence, il convient de… » — l’appel à l’interprétation des juges.","« Sans remettre en cause le principe, on peut observer que… » — la concession mesurée.","« Ce débat invite à distinguer… » — l’invitation à la nuance conceptuelle."]},{"h":"التطبيق والتلخيص","p":["تمرين la distinction: اكتب أربع جمل تميّز بين la laïcité et l’athéisme مستعملين la définition negative (« ce n’est pas… »).","تمرين le résumé: لخّص نص loi de 1905 في ثلاث جمل باستعمال la nominalisation (« la séparation », « la garantie »).","تمرين le dialogue civil: صُغ سؤالاً محايداً عن la laïcité à l’école ثم أجب عنه بـ « d’une part… d’autre part… »."]}],"pron":[{"w":"la laïcité","ipa":"[la la.i.si.te]","approx":"لا لايسِتي"},{"w":"la neutralité","ipa":"[la nøy.tʁa.li.te]","approx":"لا نويترياليتي"},{"w":"le culte","ipa":"[lə kylt]","approx":"لُ كولت"}],"vocab":[{"fr":"la laïcité","ar":"العلمانية","pos":"nom","g":"f","exFr":"La laïcité est un principe constitutionnel.","ipa":"[la la.i.si.te]","exAr":"العلمانية مبدأ دستوري."},{"fr":"la neutralité","ar":"الحياد","pos":"nom","g":"f","exFr":"La neutralité s’impose aux agents publics.","ipa":"[la nøy.tʁa.li.te]","exAr":"يفرض الحياد على الموظفين العموميين."},{"fr":"le culte","ar":"الطقوس الدينية","pos":"nom","g":"m","exFr":"La loi encadre l’exercice des cultes.","ipa":"[lə kylt]","exAr":"تنظّم القانون ممارسة الطقوس."},{"fr":"la séparation","ar":"الفصل","pos":"nom","g":"f","exFr":"La loi de 1905 organise la séparation.","ipa":"[la se.paʁ.sjɔ̃]","exAr":"تنظّم قانون 1905 الفصل."},{"fr":"l’espace public","ar":"الفضاء العمومي","pos":"loc.","g":"m","exFr":"La neutralité vaut dans l’espace public.","ipa":"[lɛs.paːs pʏblik]","exAr":"يسري الحياد في الفضاء العمومي."},{"fr":"la liberté de conscience","ar":"حرية الضمير","pos":"loc.","g":"f","exFr":"La liberté de conscience est garantie.","ipa":"[la li.beʁ.te də kɔ̃.sjɑ̃s]","exAr":"حرية الضمير مضمونة."},{"fr":"le débat public","ar":"النقاش العام","pos":"loc.","g":"m","exFr":"Le débat public porte sur les limites.","ipa":"[lə de.ba pʏblik]","exAr":"يركّز النقاش العام على الحدود."},{"fr":"la jurisprudence","ar":"الاجتهاد القضائي","pos":"nom","g":"f","exFr":"La jurisprudence précise la règle.","ipa":"[ʒyʁis.pʁy.dɑ̃s]","exAr":"يُوضّح الاجتهاد القضائي القاعدة."},{"fr":"le service public","ar":"الخدمة العمومية","pos":"loc.","g":"m","exFr":"Le service public doit rester neutre.","ipa":"[lə sɛʁ.viːs pʏblik]","exAr":"يجب أن تبقى الخدمة العمومية محايدة."},{"fr":"garantir","ar":"يضمن","pos":"verbe","g":"","exFr":"La loi garantit la liberté de conscience.","ipa":"[ga.ʁɑ̃.tiʁ]","exAr":"يضمن القانون حرية الضمير."},{"fr":"encadrer","ar":"يُنظّم قانوناً","pos":"verbe","g":"","exFr":"La loi encadre l’exercice des cultes.","ipa":"[ɑ̃.ka.dʁe]","exAr":"ينظّم القانون ممارسة الطقوس."},{"fr":"s’appliquer","ar":"يُطبَّق","pos":"verbe","g":"","exFr":"Le principe s’applique à tous.","ipa":"[sa.pli.ke]","exAr":"يُطبَّق المبدأ على الجميع."}],"examples":[{"fr":"La loi de 1905 sépare les Églises de l’État.","ar":"يفصل قانون 1905 الكنائس عن الدولة.","note":"le fait historique"},{"fr":"La neutralité est garantie dans les services publics.","ar":"يُضمن الحياد في الخدمات العمومية.","note":"la voix passive civique"},{"fr":"Selon la jurisprudence, il convient de distinguer espace public et vie privée.","ar":"حسب الاجتهاد القضائي، ينبغي التمييز بين الفضاء العمومي والحياة الخاصة.","note":"l’appel au droit"},{"fr":"Sans remettre en cause le principe, le débat continue.","ar":"دون المساس بالمبدأ، يستمر النقاش.","note":"la concession"},{"fr":"La loi n’interdit pas le signe religieux en soi.","ar":"لا يمنع القانون العلامة الدينية بحد ذاتها.","note":"la précision juridique"},{"fr":"L’école républicaine applique la neutralité pédagogique.","ar":"تطبّق المدرسة الجمهورية الحياد التربوي.","note":"le présent de vérité institutionnelle"}],"grammar":[{"tFr":"Le passif et la nominalisation dans le discours civique","tAr":"المبني للمجهول والاسم المصدر في الخطاب المدني","body":["Le passif met l’accent sur la règle, non sur l’agent : « la neutralité est exigée » au lieu de « l’État exige la neutralité ». Cela donne à l’énoncé un ton objectif et impersonnel.","La nominalisation condense l’action : « la garantie de la liberté », « l’application du principe ». Elle est fréquente dans les textes juridiques et les commentaires institutionnels."],"ex":[{"fr":"La séparation des Églises et de l’État est organisée par la loi.","ar":"ينظّم القانون فصل الكنائس عن الدولة."},{"fr":"L’application du principe suscite des débats.","ar":"يثير تطبيق المبدأ نقاشات."}]},{"tFr":"Les connecteurs de concession et d’opposition","tAr":"أدوات الاعتراض والمعارضة في النقاش","body":["Pour débattre avec nuance : bien que, sans doute, certes, néanmoins, en revanche, toutefois. Ils permettent de reconnaître un point adverse avant d’affirmer sa position.","Formule type : « Certes, le principe suscite des questions, néanmoins il reste un fondement. » Cette structure est attendue en C1 dans les commentaires de civilisation."],"ex":[{"fr":"Bien que le débat soit ancien, le principe reste stable.","ar":"وإن كان النقاش قديماً، يبقى المبدأ ثابتاً."},{"fr":"Le signe n’est pas interdit en soi ; en revanche, la neutralité vaut pour les agents.","ar":"ليست العلامة ممنوعة بحد ذاتها؛ غير أن الحياد يلزم الموظفين."}]}],"mistakes":[{"wrong":"confondre laïcité et athéisme","right":"expliquer : la laïcité organise, elle n’impose pas la non-croyance","why":"le principe concerne l’État, pas les convictions personnelles — المبدأ يخص الدولة لا الاعتقاد."},{"wrong":"traduire laïcité par « secularism » sans précision","right":"préciser : « la laïcité à la française »","why":"les modèles anglo-saxons diffèrent sur le rapport aux religions — النماذج تختلف."},{"wrong":"employer un ton militant","right":"employer une langue descriptive et mesurée","why":"le cours de civilisation explique, il ne prend pas position — الشرح لا يُتبني موقفاً."},{"wrong":"dire « la loi interdit la religion »","right":"dire « la loi encadre le rapport entre l’État et les religions »","why":"la liberté de conscience est garantie — حرية الضمير مضمونة قانوناً."}],"dialogues":[{"title":"Un échange sur la neutralité","ctx":"زملاء يتناقشون حول تطبيق الحياد في الخدمة العمومية","lines":[{"who":"Julie","fr":"Selon toi, que signifie la neutralité au travail ?","ar":"حسب رأيك، ماذا يعني الحياد في العمل؟"},{"who":"Samir","fr":"Elle signifie que le service ne discrimine pas les usagers.","ar":"يعني ألا تُميّز الخدمة بين المستفيدين."},{"who":"Julie","fr":"Néanmoins, le débat continue sur les limites.","ar":"ومع ذلك، يستمر النقاش حول الحدود."},{"who":"Samir","fr":"Oui, la jurisprudence précise les cas concrets.","ar":"نعم، الاجتهاد القضائي يوضّح الحالات المحددة."}]},{"title":"Expliquer 1905","ctx":"معلّم يشرح لتلميذ أجنبي أصل قانون 1905","lines":[{"who":"Mme Roux","fr":"La loi de 1905 sépare les Églises de l’État.","ar":"يفصل قانون 1905 الكنائس عن الدولة."},{"who":"Youssef","fr":"Est-ce qu’elle interdit les religions ?","ar":"هل تمنع الأديان؟"},{"who":"Mme Roux","fr":"Non, elle garantit la liberté de conscience.","ar":"كلا، بل تضمن حرية الضمير."},{"who":"Youssef","fr":"Donc la laïcité encadre la vie commune.","ar":"إذن تنظّم العلمانية الحياة المشتركة."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما معنى « la neutralité » في السياق المدني؟","opts":["الحياد وعدم التمييز","الحياد العسكري","الحياد الجغرافي","الحياد التجاري"],"a":0,"why":"la neutralité des services publics = absence de discrimination d’État."},{"t":"fill","skill":"grammar","q":"أكمل بالمبني للمجهول: «La liberté de conscience ___ par la loi.»","fr":"La liberté de conscience ___ par la loi.","ans":"est garantie","why":"la voix passive : être + participe passé, accord avec le sujet féminin."},{"t":"order","skill":"writing","q":"رتّب: تضمن قانون 1905 حرية الضمير","words":["La","loi","de","1905","garantit","la","liberté","de","conscience."],"ans":"La loi de 1905 garantit la liberté de conscience.","why":"ordre sujet-verbe-complément, le point sur le dernier mot."},{"t":"listen","skill":"listening","q":"ماذا يفعل قانون 1905 بحسب النص؟","opts":["يفصل الكنائس عن الدولة","يمنع ممارسة أي عقيدة","يؤسس جيشاً مدنياً","يغيّر النظام التعليمي كلياً"],"a":0,"why":"la séparation des Églises et de l’État est le cœur du texte."},{"t":"translate","skill":"writing","q":"ترجم: «الحياد يُطبَّق على الموظفين العموميين.»","ans":"La neutralité s’applique aux agents publics.","why":"verbe pronominal s’appliquer + à + pluriel."},{"t":"speaking","skill":"speaking","q":"اشرح في ثلاث جمل الفرق بين la laïcité et l’athéisme دون تبني موقف.","target":"laïcité / athéisme / liberté de conscience","why":"définition contrastée en registre neutre."},{"t":"correct","skill":"grammar","q":"صحّح: «La loi garantissent la liberté de conscience.»","ans":"La loi garantit la liberté de conscience.","why":"le sujet « la loi » est singulier : garantit."},{"t":"mcq","skill":"reading","q":"أي عبارة تميّز la laïcité بدقة؟","opts":["Elle organise le rapport entre l’État et les religions.","Elle interdit toute croyance.","Elle confie le pouvoir aux clercs.","Elle ne concerne que l’école."],"a":0,"why":"le principe concerne l’institution, pas les convictions."}],"homework":"اكتب فقرة محايدة من خمس جمل تشرح مبدأ la laïcité لصديق غير francophone، مستعملاً trois mots du cours (neutralité, séparation, liberté de conscience) et un connecteur de concession.","sources":[{"title":"La laïcité, c’est quoi ? Retour au texte de 1905 avec Patrick Weil","channel":"France Culture","videoId":"zFB6WdSZTco","why":"قراءة معمّقة لنص loi de 1905 مع Patrick Weil: التاريخ الفقدي لل princípio، مصادره، وتطبيقاته على l’école et l’espace public — نموذج لـ le débat d’idées بأسلوب أكاديمي.","cat":"Civilisation","level":"C1","main":true},{"title":"La Laïcité en 3 minutes","channel":"COEXISTER FRANCE","videoId":"fx50d_aqaUo","why":"ملخّص سريع ومحايد لمفهوم la laïcité: تدريب على la synthèse et le vocabulaire civique الأساسي.","cat":"Civilisation","level":"C1","extra":true},{"title":"La laïcité à l’École","channel":"Frédéric ANTOINE","videoId":"5joLUCZDZk0","why":"تطبيق المبدأ في l’école républicaine: نص تعليمي لتدريب على la compréhension de la règle et ses limites.","cat":"Civilisation","level":"C1","extra":true}],"supplements":[{"id":"fx50d_aqaUo","title":"La Laïcité en 3 minutes","channel":"COEXISTER FRANCE","why":"ملخّص سريع ومحايد لمفهوم la laïcité: تدريب على la synthèse et le vocabulaire civique الأساسي.","lang":"fr","dur":4},{"id":"5joLUCZDZk0","title":"La laïcité à l’École","channel":"Frédéric ANTOINE","why":"تطبيق المبدأ في l’école républicaine: نص تعليمي لتدريب على la compréhension de la règle et ses limites.","lang":"fr","dur":9}]},{"id":"c1-t6-l3","fr":"Les institutions françaises","ar":"المؤسسات الفرنسية: الجمهورية الخامسة والفصل بين السلطات واللامركزية","objectives":["وصف la Ve République وتاريخ دستور 1958 ودور la pratique constitutionnelle","تمييز les trois pouvoirs: exécutif, législatif, judiciaire وأصحابها","استخراج مفردات المؤسسات: le décret, la loi, le vote, le bicaméralisme, la décentralisation","تحليل duale président/ Premier ministre في la cohabitation بأسلوب موضوعي"],"sections":[{"h":"الدرس 3: كيف تنظّم la Constitution de 1958 السلط في la Ve République","video":{"id":"WOWHIF2ZjIk","title":"Les institutions de la Vème république | Le droit animé","channel":"Lextenso","why":"شرح مُصوَّر ومُحرَّك لدستور la Ve République: le président, le gouvernement, le Parlement et le Conseil constitutionnel — ترتيب بصري واضح للفصل بين les pouvoirs.","lang":"fr","main":true,"dur":10},"p":["la Ve République تأسست بالدستور الصادر في 4 أكتوبر 1958، وهو يُقسم السلط: le pouvoir exécutif بيد رئيس الجمهورية ورئيس الحكومة، le pouvoir législatif بيد البرلمان (l’Assemblée nationale et le Sénat)، le pouvoir judiciaire مستقل بموجب le Conseil supérieur de la magistrature.","رئيس الجمهورية ينتخب بالاقتراع المباشر، ويترأس الدولة، وله صلاحيات رئيسية مثل la nomination du Premier ministre et la dissolution de l’Assemblée nationale. رئيس الحكومة يقود le gouvernement ويتولى la politique générale.","البرلمان يشتغل بنظام bicaméral: l’Assemblée nationale (577 نائباً) et le Sénat (348 عضواً). le processus legislatif: le projet de loi يُقدَّم، يُناقش في les deux chambres، ثم يصادق عليه ويتولى le Conseil constitutionnel سلطة le contrôle de constitutionnalité.","اللامركزية (la décentralisation) تعني نقل صلاحيات إلى les collectivités territoriales: régions, départements, communes. هذه الجماعات لها شخصية اعتبارية وميزانيات خاصة، خلافاً للـ la déconcentration التي توزّع الإدارة المركزية فقط.","نحوياً، يُستعمل في شرح المؤسسات la voix passive et les périphrases institutionnelles (« il est prévu que », « la loi dispose que ») لتجنب l’anthropomorphisme. وla concordance des temps تبقى ضرورية في le discours hypothétique (« si le président dissolvait… »).","بعد الدرس، ارسم مخططاً بسيطاً لـ les trois pouvoirs، ثم اشرح فارقاً واحداً بين le régime présidentiel et le régime semi-présidentiel في جملتين. هذا التمرين يثبّت la terminologie politique في المستوى C1."],"sub":[{"h":"la Constitution de 1958","p":["La Ve République partage les pouvoirs.","Le président est élu au suffrage direct.","Le gouvernement conduit la politique générale."]},{"h":"le Parlement et la loi","p":["L’Assemblée nationale et le Sénat votent.","Le contrôle de constitutionnalité protège la loi.","Le débat parlementaire est public."]},{"h":"la décentralisation","p":["Les collectivités ont des compétences propres.","Régions et communes gèrent leurs budgets.","L’État garde la tutelle générale."]}]},{"h":"les formules institutionnelles","p":["« La Constitution prévoit que… » — l’énoncé d’une règle.","« Le projet de loi sera examiné par… » — la description d’une procédure.","« Conformément à l’article… » — la référence au texte.","« La pratique a montré que… » — l’appel à la coutume constitutionnelle."]},{"h":"التطبيق والتلخيص","p":["تمرين la carte mentale: ارسم les trois pouvoirs مع أصحابها، ثم اكتب جملة واحدة لكل سلطة.","تمرين le procès-verbal: حوّل وصفاً شفهياً لجلسة à l’écrit باستعمال « il a été décidé que ».","تمرين la comparaison: قارن بين le président et le Premier ministre في جدول من ثلاث أسطر (élection, rôle, responsabilité)."]}],"pron":[{"w":"le pouvoir exécutif","ipa":"[lə pu.vwaʁ ɛɡ.zɛ.kytif]","approx":"لُ بوفوار إكسيكتيف"},{"w":"l’Assemblée nationale","ipa":"[las.blə na.sjɔ.nal]","approx":"لاسامبل ناسيونال"},{"w":"le Sénat","ipa":"[lə se.na]","approx":"لُ سينا"}],"vocab":[{"fr":"la Constitution","ar":"الدستور","pos":"nom","g":"f","exFr":"La Constitution de 1958 organise les pouvoirs.","ipa":"[la kɔ̃.sti.ty.sjɔ̃]","exAr":"ينظّم دستور 1958 السلطات."},{"fr":"le pouvoir exécutif","ar":"السلطة التنفيذية","pos":"loc.","g":"m","exFr":"Le pouvoir exécutif appartient au président.","ipa":"[lə pu.vwaʁ ɛɡ.zɛ.kytif]","exAr":"تعود السلطة التنفيذية للرئيس."},{"fr":"le pouvoir législatif","ar":"السلطة التشريعية","pos":"loc.","g":"m","exFr":"Le Parlement détient le pouvoir législatif.","ipa":"[lə pu.vwaʁ le.ʒis.la.tif]","exAr":"يمتلك البرلمان السلطة التشريعية."},{"fr":"le pouvoir judiciaire","ar":"السلطة القضائية","pos":"loc.","g":"m","exFr":"Le pouvoir judiciaire est indépendant.","ipa":"[lə pu.vwaʁ ʒy.di.sjɛʁ]","exAr":"السلطة القضائية مستقلة."},{"fr":"le Premier ministre","ar":"رئيس الحكومة","pos":"loc.","g":"m","exFr":"Le Premier ministre est nommé par le président.","ipa":"[lə pʁə.mjɛ mi.nistʁ]","exAr":"يُعيَّن رئيس الحكومة من طرف الرئيس."},{"fr":"le Parlement","ar":"البرلمان","pos":"nom","g":"m","exFr":"Le Parlement vote les lois.","ipa":"[lə paʁ.lə.mɑ̃]","exAr":"يُصوّت البرلمان على القوانين."},{"fr":"la loi","ar":"القانون","pos":"nom","g":"f","exFr":"La loi est votée par les deux chambres.","ipa":"[la lwa]","exAr":"يُصوّت على القانون في الغرفتين."},{"fr":"la décentralisation","ar":"اللامركزية","pos":"nom","g":"f","exFr":"La décentralisation transfère des compétences.","ipa":"[la dɛ.sɑ̃.tʁa.li.za.sjɔ̃]","exAr":"تنتقل الاختصاصات بفعل اللامركزية."},{"fr":"la collectivité territoriale","ar":"الجماعة الإقليمية","pos":"loc.","g":"f","exFr":"Chaque collectivité gère son budget.","ipa":"[la kɔ.lɛk.ti.vi.te tɛ.ʁi.to.ʁjal]","exAr":"تدير كل جماعة ميزانيتها."},{"fr":"la dissolution","ar":"الحل","pos":"nom","g":"f","exFr":"Le président peut provoquer la dissolution.","ipa":"[la dɔ.ly.sjɔ̃]","exAr":"يمكن للرئيس إحداث الحل."},{"fr":"la cohabitation","ar":"التعايش السياسي (رئيس وحكومة من معسكرين)","pos":"nom","g":"f","exFr":"La cohabitation modifie l’équilibre des pouvoirs.","ipa":"[la kɔ.a.bi.ta.sjɔ̃]","exAr":"يُعدّل التعايش السياسي توازن السلطات."},{"fr":"le suffrage universel","ar":"الاقتراع العام","pos":"loc.","g":"m","exFr":"Le président est élu au suffrage universel.","ipa":"[lə sy.fʁaʒ y.ni.vɛʁ.sɛl]","exAr":"يُنتخب الرئيس بالاقتراع العام."}],"examples":[{"fr":"La Constitution de 1958 partage les pouvoirs.","ar":"يقسم دستور 1958 السلطات.","note":"la règle fondamentale"},{"fr":"Le président est élu au suffrage universel direct.","ar":"يُنتخب الرئيس بالاقتراع العام المباشر.","note":"la voix passive institutionnelle"},{"fr":"Le projet de loi sera examiné par les deux chambres.","ar":"سيُدرس مشروع القانون في الغرفتين.","note":"le futur de procédure"},{"fr":"Conformément à la Constitution, le Parlement vote la loi.","ar":"طبقاً للدستور، يُصوّت البرلمان على القانون.","note":"la référence juridique"},{"fr":"Si le président dissolvait l’Assemblée, des élections suivraient.","ar":"لو حلّ الرئيس الجمعية، لتبعتها انتخابات.","note":"la concordance hypothétique"},{"fr":"Les collectivités territoriales gèrent leurs compétences.","ar":"تدير الجماعات الإقليمية اختصاصاتها.","note":"la décentralisation"}],"grammar":[{"tFr":"La concordance des temps dans le discours hypothétique","tAr":"حروف وتحديد الزمن في الخطاب الشرطي","body":["Pour exprimer l’hypothèse irréelle ou peu probable : si + imparfait, conditionnel présent. « Si le président dissolvait l’Assemblée, des élections auraient lieu. » Cette structure est centrale pour discuter des institutions.","La valeur générale s’exprime par le présent : « la Constitution prévoit que… ». On distingue ainsi la règle (présent) de l’application hypothétique (conditionnel)."],"ex":[{"fr":"Si le gouvernement tombait, le Premier ministre démissionnerait.","ar":"لو سقطت الحكومة، لاستقال رئيسها."},{"fr":"La Constitution prévoit que le Parlement contrôle l’action gouvernementale.","ar":"يضع الدستور نصاً على أن البرلمان يراقب عمل الحكومة."}]},{"tFr":"La voix passive et les périphrases institutionnelles","tAr":"المبني للمجهول والتعابير المؤسساتية","body":["Les institutions se décrivent sans agent : « il a été décidé que », « la loi dispose que », « il est prévu que ». Ces tournures donnent un ton impersonnel et formel.","La voix passive souligne l’action plus que l’auteur : « le projet a été adopté » — utile quand l’acteur importe moins que la procédure."],"ex":[{"fr":"Il a été décidé que le débat aurait lieu mercredi.","ar":"تُقرر أن يُعقد النقاش الأربعاء."},{"fr":"La loi a été adoptée par les deux chambres.","ar":"تبنّت الغرفتان القانون."}]}],"mistakes":[{"wrong":"confondre déconcentration et décentralisation","right":"préciser : décentralisation = compétences transférées aux collectivités","why":"la déconcentration reste dans la hiérarchie d’État — التقاليد الإدارية تختلف."},{"wrong":"appeler le président « chef du gouvernement »","right":"distinguer chef de l’État et Premier ministre","why":"sous la Ve République, le gouvernement est dirigé par le Premier ministre — رئيس الحكومة شخص آخر."},{"wrong":"dire « le Sénat fait les lois » seul","right":"dire « les deux chambres votent la loi »","why":"le bicaméralisme exige l’accord des deux assemblées — النظام ثنائي الغرفتين."},{"wrong":"utiliser un ton partisan pour juger les institutions","right":"décrire les règles et la pratique sans jugement","why":"un cours de civilisation reste descriptif — الشررح وصفي لا حكمي."}],"dialogues":[{"title":"Présenter les institutions","ctx":"طالبة تشرح نظام الحكم لزميلها غير الناطق بالفرنسية","lines":[{"who":"Emma","fr":"Sous la Ve République, le président nomme le Premier ministre.","ar":"في الجمهورية الخامسة يُعيّن الرئيس رئيس الحكومة."},{"who":"Luca","fr":"Et qui vote les lois ?","ar":"ومَن يُصوّت على القوانين؟"},{"who":"Emma","fr":"Le Parlement, composé de l’Assemblée nationale et du Sénat.","ar":"البرلمان، المكوّن من الجمعية الوطنية والشيوخ."},{"who":"Luca","fr":"Donc les pouvoirs sont séparés.","ar":"إذن السلطات مفصولة."}]},{"title":"Une question sur la décentralisation","ctx":"مواطن يسأل موظفاً جماعياً عن اختصاصات الجماعة","lines":[{"who":"Nadia","fr":"Quelles compétences gère notre commune ?","ar":"ما الاختصاصات التي تديرها جماعتنا؟"},{"who":"Pierre","fr":"Elle gère l’état civil, les écoles et les routes locales.","ar":"تدير الحالة المدنية والمدارس والطرق المحلية."},{"who":"Nadia","fr":"Et la région, elle, s’occupe de quoi ?","ar":"وماذا عن المنطقة؟"},{"who":"Pierre","fr":"La région coordonne les transports et la formation.","ar":"تنسّق النقل والتكوين."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"من يملك « le pouvoir législatif » في الجمهورية الخامسة؟","opts":["البرلمان (الجمعية والشيوخ)","رئيس الجمهورية وحده","المحكمة الدستورية","الحكومة الإدارية"],"a":0,"why":"le Parlement vote la loi : c’est le pouvoir législatif."},{"t":"fill","skill":"grammar","q":"أكمل بالمستقبل الإجرائي: «Le projet ___ par les deux chambres.»","fr":"Le projet ___ par les deux chambres.","ans":"sera examiné","why":"le futur simple décrit la procédure à venir + participe passé."},{"t":"order","skill":"writing","q":"رتّب: البرلمان يصوّت على القوانين","words":["Le","Parlement","vote","les","lois."],"ans":"Le Parlement vote les lois.","why":"ordre sujet-verbe-complément avec le point final."},{"t":"listen","skill":"listening","q":"كيف يُنتخب رئيس الجمهورية الفرنسي؟","opts":["بالاقتراع العام المباشر","من طرف البرلمان وحده","من طرف الحكومة","بالقرعة"],"a":0,"why":"le président est élu au suffrage universel direct depuis 1962."},{"t":"translate","skill":"writing","q":"ترجم: «الجمعتان تُصوّتان على القانون.»","ans":"Les deux chambres votent la loi.","why":"sujet pluriel + verbe au présent + complément d’objet direct."},{"t":"speaking","skill":"speaking","q":"اشرح في ثلاث جمل الفرق بين la décentralisation et la déconcentration.","target":"décentralisation / collectivités / compétences","why":"comparaison conceptuelle en registre institutionnel."},{"t":"correct","skill":"grammar","q":"صحّح: «Si le président dissout l’Assemblée, les élections auraient lieu.»","ans":"Si le président dissolvait l’Assemblée, les élections auraient lieu.","why":"hypothèse irréelle : si + imparfait, et non présent."},{"t":"mcq","skill":"reading","q":"ما وظيفة « le Conseil constitutionnel »؟","opts":["مراقبة دستورية القوانين","قيادة الحكومة","إدارة الميزانية المحلية","انتخاب النواب"],"a":0,"why":"il exerce le contrôle de constitutionnalité des lois."}],"homework":"اشرح في فقرة من خمس جمل مسار مشروع قانون من تقديمه إلى تصويت الغرفتين، مستعملاً les mots : projet, chambres, vote, contrôle, Constitution.","sources":[{"title":"Les institutions de la Vème république | Le droit animé","channel":"Lextenso","videoId":"WOWHIF2ZjIk","why":"شرح مُصوَّر ومُحرَّك لدستور la Ve République: le président, le gouvernement, le Parlement et le Conseil constitutionnel — ترتيب بصري واضح للفصل بين les pouvoirs.","cat":"Civilisation","level":"C1","main":true},{"title":"Le système politique français","channel":"How it works France","videoId":"NtIepJvHvJw","why":"عرض شامل للنظام السياسي: ترتيب بصري لـ les institutions لتدريب على la repérage d’informations.","cat":"Civilisation","level":"C1","extra":true},{"title":"C’est quoi la 5ème république ? - 1 jour, 1 question","channel":"1 jour, 1 question","videoId":"IGAOnHbULZQ","why":"شرح مُبسّط لدستور 1958: تدريب على la synthèse et le résumé d’un texte institutionnel.","cat":"Civilisation","level":"C1","extra":true}],"supplements":[{"id":"NtIepJvHvJw","title":"Le système politique français","channel":"How it works France","why":"عرض شامل للنظام السياسي: ترتيب بصري لـ les institutions لتدريب على la repérage d’informations.","lang":"fr","dur":9},{"id":"IGAOnHbULZQ","title":"C’est quoi la 5ème république ? - 1 jour, 1 question","channel":"1 jour, 1 question","why":"شرح مُبسّط لدستور 1958: تدريب على la synthèse et le résumé d’un texte institutionnel.","lang":"fr","dur":5}]},{"id":"c1-t6-l4","fr":"La France et l’Europe","ar":"فرنسا وأوروبا: بناء الاتحاد والبرامج والهويات المتداخلة","objectives":["ترتيب les étapes clés: la CECA (1951), le traité de Rome (1957), l’Acte unique, Maastricht (1992)","استخراج مفردات البناء الأوروبي: l’élargissement, l’approfondissement, la libre circulation, l’euro","تمييز les compétences de l’Union et celles des États membres","وصف الهويات المتداخلة (identités croisées) بأسلوب متوازن: européenne, nationale, régionale"],"sections":[{"h":"الدرس 4: كيف بُنيت l’Union européenne وكيف تتقاطع مع l’identité française","video":{"id":"UtVgqgi0bGE","title":"La construction européenne (Histoire 3e)","channel":"Éditions Lelivrescolaire.fr","why":"عرض تاريخي مرتّب لـ les étapes de la construction européenne: de la CECA إلى l’Union européenne، مع les traités et les élargissements — أساس متين لمفردات l’institution européenne.","lang":"fr","main":true,"dur":11},"p":["البناء الأوروبي بدأ كمشروع للسلام بعد 1945. مؤسسة État de droit coalisée: la Communauté européenne du charbon et de l’acier (CECA) في 1951 جمعت ست دول، ثم الـ traité de Rome في 1957 أسس la Communauté économique européenne avec principe du marché commun.","التوسّع (l’élargissement) تكرر عدة مرات: من ست دول إلى تسعة في السبعينيات، ثم موجات شرقية بعد 1904 — اليوم twenty-seven États membres. ومع التوسّع جاء l’approfondissement: la libre circulation des personnes, la monnaie unique (l’euro) منذ 1999، والسياسة الخارجية المشتركة.","الهوية الأوروبية ليست بديلاً عن الهوية الوطنية: القادة يتحدثون عن « identités croisées » — الشخص يمكن أن يُعرّف نفسه بأنه français، européen، et citoyen de sa région في آن واحد. la France شاركت في كل معاهدات البناء وكانت ضمن الدول المؤسِّسة.","نحوياً، يُستعمل في هذا الموضوع la langue de l’institution: le conditionnel pour exprimer la capacité (« l’Union pourrait… »)، et la structure passive pour les traités (« le traité a été signé à… »). النسبة تُهم: « il convient de souligner que… » لتفادي la surabstraction.","النقاش المعاصر يمسّ l’équilibre entre les États et les institutions: مبدأ la subsidiarité ينصّ على أن القرار يُتخذ عند أقرب مستوى إلى المواطن. وبرامج مثل Erasmus نقلت l’expérience européenne من le discours aux parcours individuels.","بعد الدرس، ضع على المحور الزمني خمس تواريخ، ثم اكتب فقرة من أربع جمل تشرح فيها لماذا تُعدّ la France من الدول المؤسِّسة وما بقي من الدور اليوم."],"sub":[{"h":"les étapes de la construction","p":["La CECA réunit six pays en 1951.","Le traité de Rome fonde le marché commun.","Maastricht crée l’Union européenne."]},{"h":"élargissement et approfondissement","p":["L’Union passe à vingt-sept États.","La libre circulation des personnes s’étend.","L’euro devient la monnaie commune."]},{"h":"identités croisées","p":["Être français et européen n’exclut personne.","La subsidiarité fixe les niveaux de décision.","Erasmus relie les parcours individuels."]}]},{"h":"les formules du récit européen","p":["« Le traité de… a été signé en… » — le repère chronologique.","« Cette étape a permis de… » — la conséquence historique.","« Il convient de distinguer élargissement et approfondissement… » — la distinction conceptuelle.","« Aujourd’hui, l’enjeu est de… » — l’ouverture vers le débat contemporain."]},{"h":"التطبيق والتلخيص","p":["تمرين la frise: ضع خمس محطات (1951, 1957, 1986, 1992, 2002) مع جملة قصيرة لكل واحدة.","تمرين la compétence: أنشئ جدولاً من عمودين: « compétences de l’Union » و« compétences des États » بثلاثة أمثلة.","تمرين l’identité: اكتب أربع جمل تصف هويتك كـ « croisée » بين ثلاث مستويات (locale, nationale, continentale)."]}],"pron":[{"w":"la construction européenne","ipa":"[la kɔ̃s.tʁak.sjɔ̃ y.ʁɔ.pɛn]","approx":"لا كونستراكسيون أوروبين"},{"w":"l’élargissement","ipa":"[le.laʁ.ʒis.mɑ̃]","approx":"ليلارجيسمان"},{"w":"la libre circulation","ipa":"[la li.bʁə siʁ.ky.la.sjɔ̃]","approx":"لا ليبر سيركولاسيون"}],"vocab":[{"fr":"la construction européenne","ar":"البناء الأوروبي","pos":"loc.","g":"f","exFr":"La construction européenne s’est faite par étapes.","ipa":"[la kɔ̃s.tʁak.sjɔ̃ y.ʁɔ.pɛn]","exAr":"تمّ البناء الأوروبي على مراحل."},{"fr":"l’élargissement","ar":"التوسّع","pos":"nom","g":"m","exFr":"L’élargissement accueille de nouveaux États.","ipa":"[le.laʁ.ʒis.mɑ̃]","exAr":"يستقبل التوسّع دولاً جديدة."},{"fr":"l’approfondissement","ar":"التعميق","pos":"nom","g":"m","exFr":"L’approfondissement renforce les politiques communes.","ipa":"[a.pʁɔ.fɔ̃.dis.mɑ̃]","exAr":"يُقوّي التعميق السياسات المشتركة."},{"fr":"la libre circulation","ar":"حرية التنقل","pos":"loc.","g":"f","exFr":"La libre circulation des personnes est un acquis.","ipa":"[la li.bʁə siʁ.ky.la.sjɔ̃]","exAr":"حرية التنقّل مكسب."},{"fr":"le traité","ar":"المعاهدة","pos":"nom","g":"m","exFr":"Le traité de Rome est fondateur.","ipa":"[lə tʁe.te]","exAr":"معاهدة روما مؤسِّسة."},{"fr":"la monnaie unique","ar":"العملة الموحّدة","pos":"loc.","g":"f","exFr":"La monnaie unique est l’euro.","ipa":"[la mɔ.nɛ y.nik]","exAr":"العملة الموحّدة هي اليورو."},{"fr":"la subsidiarité","ar":"مبدأ التكميلية (الأقرب للقرار)","pos":"nom","g":"f","exFr":"La subsidiarité fixe le bon niveau de décision.","ipa":"[subs.idi.a.ʁi.te]","exAr":"يحدّد مبدأ التكميلية مستوى القرار الأمثل."},{"fr":"les compétences","ar":"الاختصاصات","pos":"nom","g":"f","exFr":"Chaque institution a ses compétences.","ipa":"[le kɔ̃.pɛ.tɑ̃s]","exAr":"لكل مؤسسة اختصاصاتها."},{"fr":"l’identité croisée","ar":"الهوية المتداخلة","pos":"loc.","g":"f","exFr":"L’identité croisée relie plusieurs niveaux.","ipa":"[li.den.ti.te kʁwa.ze]","exAr":"ترتبط الهوية المتداخلة بمستويات متعددة."},{"fr":"la citoyenneté européenne","ar":"المواطنة الأوروبية","pos":"loc.","g":"f","exFr":"La citoyenneté européenne complète la nationalité.","ipa":"[la si.twa.jɑ̃.te y.ʁɔ.pɛn]","exAr":"تكمل المواطنة الأوروبية الجنسية الوطنية."},{"fr":"ratifier","ar":"يصادق على","pos":"verbe","g":"","exFr":"Le Parlement doit ratifier le traité.","ipa":"[ʁa.ti.fe]","exAr":"يجب أن يصادق البرلمان على المعاهدة."},{"fr":"renforcer","ar":"يُقوّي","pos":"verbe","g":"","exFr":"Les États veulent renforcer la coopération.","ipa":"[ʁɑ̃.fɔʁ.se]","exAr":"تريد الدول تقوية التعاون."}],"examples":[{"fr":"Le traité de Rome a été signé en 1957.","ar":"وُقّعت معاهدة روما سنة 1957.","note":"la voix passive chronologique"},{"fr":"La CECA a réuni six pays fondateurs.","ar":"جمعت المخطط الأوروبي للفحم والصلب ست دول مؤسِّسة.","note":"le repère historique"},{"fr":"Il convient de distinguer élargissement et approfondissement.","ar":"يجب التمييز بين التوسّع والتعميق.","note":"la distinction conceptuelle"},{"fr":"L’Union pourrait mieux coordonner sa politique énergétique.","ar":"يمكن للاتحاد أن ينسّق سيسته الطاقية بشكل أفضل.","note":"le conditionnel de capacité"},{"fr":"La subsidiarité évite de tout centraliser.","ar":"يمنع مبدأ التكميلية مركزية كل شيء.","note":"la notion institutionnelle"},{"fr":"Erasmus a relié des milliers de parcours étudiants.","ar":"ربط إراسموس آلاف المسارات الدراسية.","note":"l’expérience concrète"}],"grammar":[{"tFr":"Le conditionnel dans le langage des institutions","tAr":"المستقبل الشرطي في لغة المؤسسات","body":["Le conditionnel exprime la capacité, la suggestion ou la mesure prudente : « l’Union pourrait agir », « il faudrait revoir les règles ». Il évite le ton catégorique dans un dossier partagé.","On l’associe aux périphrases : « il est possible que », « cela permettrait de ». C’est la tonalité typique du commentaire européen."],"ex":[{"fr":"Les États pourraient coordonner leurs budgets.","ar":"يمكن للدول أن تنسّق ميزانياتها."},{"fr":"Il faudrait clarifier les compétences.","ar":"من الضروري توضيح الاختصاصات."}]},{"tFr":"Le discours rapporté et la précision des dates","tAr":"النقل ودقة التواريخ","body":["Pour le récit historique : le passé composé et le plus-que-parfait situent les étapes : « l’Union avait déjà élargi… ». La passivation met en valeur l’événement : « le traité a été signé ».","La précision oblige aux compléments circonstanciels : en 1957, à Rome, entre six États. En C1, on attend cette exactitude factuelle."],"ex":[{"fr":"L’Union avait déjà élargi son marché avant 2004.","ar":"كان الاتحاد قد وسّع سوقه قبل 2004."},{"fr":"Le traité de Maastricht a été signé en 1992.","ar":"وُقّعت معاهدة ماسترخت سنة 1992."}]}],"mistakes":[{"wrong":"confondre Europe et Union européenne","right":"préciser : l’Europe est un continent, l’Union est une organisation","why":"tous les pays européens ne sont pas membres — ليست كل دول أوروبا عضواً."},{"wrong":"dire « l’Europe décide de tout »","right":"distinguer les compétences partagées et exclusives","why":"la subsidiarité réserve beaucoup de dossiers aux États — مبدأ التكميلية يحفظ الكثير للدول."},{"wrong":"confondre élargissement et approfondissement","right":"élargissement = nouveaux membres, approfondissement = nouvelles politiques","why":"deux axes distincts du même processus — محوران مختلفان لعملية واحدة."},{"wrong":"employer un ton militant sur l’adhésion","right":"présenter les étapes et les arguments sans conclure","why":"la neutralité pédagogique s’impose — الحياد التعليمي مطلوب."}],"dialogues":[{"title":"Une frise chronologique","ctx":"معلّمان يراجعان محطات البناء الأوروبي قبل الدرس","lines":[{"who":"Hélès","fr":"Commençons par la CECA en 1951.","ar":"لنبدأ بالمخطط الأوروبي سنة 1951."},{"who":"Bruno","fr":"Puis le traité de Rome en 1957 fonde le marché commun.","ar":"ثم أسست معاهدة روما السوق المشتركة سنة 1957."},{"who":"Hélès","fr":"Enfin, Maastricht crée l’Union européenne en 1992.","ar":"أخيراً أنشأ معاهدة ماسترخت الاتحاد سنة 1992."},{"who":"Bruno","fr":"Donc l’élargissement et l’approfondissement se croisent.","ar":"إذن يتقاطع التوسّع مع التعميق."}]},{"title":"Identités croisées","ctx":"طالبة وطالب يتحدثان عن كونهما أوروبيين وفرنسيين في آن واحد","lines":[{"who":"Chloé","fr":"Je me sens française et européenne.","ar":"أشعر بأنني فرنسية وأوروبية في آن واحد."},{"who":"Ahmed","fr":"C’est une identité croisée, pas contradictoire.","ar":"إنها هوية متداخلة لا متناقضة."},{"who":"Chloé","fr":"La citoyenneté européenne complète la nationalité.","ar":"تكمل المواطنة الأوروبية الجنسية الوطنية."},{"who":"Ahmed","fr":"Erasmus en est la preuve concrète.","ar":"إراسموس دليل ملموس على ذلك."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما المقصود بـ « l’élargissement » في سياق الاتحاد؟","opts":["انضمام دول جديدة","توسيع الميزانية","زيادة عدد النواب","توسيع اللغة الرسمية"],"a":0,"why":"élargissement = adhésion de nouveaux États membres."},{"t":"fill","skill":"grammar","q":"أكمل: «Le traité de Rome a ___ en 1957.»","fr":"Le traité de Rome a ___ en 1957.","ans":"été signé","why":"la voix passive au passé composé : avoir + été + participe."},{"t":"order","skill":"writing","q":"رتّب: أسست معاهدة روما السوق المشتركة","words":["Le","traité","de","Rome","fonde","le","marché","commun."],"ans":"Le traité de Rome fonde le marché commun.","why":"ordre sujet-verbe-complément, point sur le dernier mot."},{"t":"listen","skill":"listening","q":"ماذا تفعل la libre circulation؟","opts":["تسمح بتنقّل الأشخاص داخل الاتحاد","تمنع الهجرة نهائياً","تنظم التجارة فقط بالبر","تحدّد عدد السياح"],"a":0,"why":"la libre circulation des personnes est un acquis de l’Union."},{"t":"translate","skill":"writing","q":"ترجم: «معاهدة ماسترخت وُقّعت سنة 1992.»","ans":"Le traité de Maastricht a été signé en 1992.","why":"passif + repère temporel avec « en » pour l’année."},{"t":"speaking","skill":"speaking","q":"اشرح في ثلاث جمل فكرة « identités croisées » مع مثال شخصي.","target":"identité croisée / européenne / nationale","why":"production orale sur l’abstraction identitaire."},{"t":"correct","skill":"grammar","q":"صحّح: «L’Union élargit ses membres depuis 2004.»","ans":"L’Union a élargi son périmètre depuis 2004.","why":"on élargit un territoire ou un périmètre, non des membres — et « depuis » commande le passé composé."},{"t":"mcq","skill":"reading","q":"أي جملة تصف la subsidiarité بدقة؟","opts":["La décision se prend au niveau le plus proche du citoyen.","Toutes les décisions se prennent à Bruxelles.","Les États n’ont plus de compétences.","Le Parlement seul légifère."],"a":0,"why":"la subsidiarité fixe le niveau approprié de décision."}],"homework":"اكتب فقرة من خمس جمل عن محطة تاريخية واحدة في البناء الأوروبي (1951 / 1957 / 1992)، مع ثلاث تواريخ وواحدة من les mots : élargissement, approfondissement, traité.","sources":[{"title":"La construction européenne (Histoire 3e)","channel":"Éditions Lelivrescolaire.fr","videoId":"UtVgqgi0bGE","why":"عرض تاريخي مرتّب لـ les étapes de la construction européenne: de la CECA إلى l’Union européenne، مع les traités et les élargissements — أساس متين لمفردات l’institution européenne.","cat":"Civilisation","level":"C1","main":true},{"title":"Comprendre l’Union européenne","channel":"Anticonstitutionnellement","videoId":"mN6UYwQUQNQ","why":"شرح معمّق لمؤسسات l’Union et ses compétences: تدريب على la lecture d’un exposé institutionnel.","cat":"Civilisation","level":"C1","extra":true},{"title":"Les étapes importantes de la construction de l’Union Européenne en 3 min","channel":"El khader","videoId":"IxzQR5RLaxM","why":"ملخّص سريع لـ la chronologie européenne: تدريب على la mémorisation des dates clés.","cat":"Civilisation","level":"C1","extra":true}],"supplements":[{"id":"mN6UYwQUQNQ","title":"Comprendre l’Union européenne","channel":"Anticonstitutionnellement","why":"شرح معمّق لمؤسسات l’Union et ses compétences: تدريب على la lecture d’un exposé institutionnel.","lang":"fr","dur":13},{"id":"IxzQR5RLaxM","title":"Les étapes importantes de la construction de l’Union Européenne en 3 min","channel":"El khader","why":"ملخّص سريع لـ la chronologie européenne: تدريب على la mémorisation des dates clés.","lang":"fr","dur":4}]},{"id":"c1-t6-l5","fr":"Patrimoine et classements","ar":"التراث والتصنيفات: المعالم التاريخية وليونسكو والسياحة والحفظ","objectives":["تمييز la notion de patrimoine: matériel et immatériel، الوطني والعالمي","استخراج مفردات التصنيف: le classement, l’inscription, la restauration, la mise en valeur","فهم دور la Direction du patrimoine et l’UNESCO في le classement des sites","تحليل العلاقة بين le tourisme et la conservation في جملتين محايدتين"],"sections":[{"h":"الدرس 5: كيف تُصنَّف الممتلكات الثقافية وتُحفظ عبر الزمن","video":{"id":"7tnDcj3FAgI","title":"Révision chapitre : Le Patrimoine Français","channel":"Tourisme et Territoire","why":"مراجعة منظّمة لـ le patrimoine français: la notion de patrimoine، les monuments historiques، et les enjeux de conservation — نقطة انطلاق متوازنة للدرس.","lang":"fr","main":true,"dur":12},"p":["le patrimoine المصطلح المركزي: كل ما اعتُبر إرثاً يستحق la préservation — مبانٍ، فنون، لكنات، تقاليد. في فرنسا، la notion تطورت من la protection des monuments historiques في القرن التاسع عشر إلى تعريف أوسع يشمل le patrimoine immatériel.","الأداة الفرنسية الأقدم هي le classement et l’inscription au titre des monuments historiques منذ 1840، بموجب لجنة تُقدّر le critère d’intérêt. اليوم يدير la Direction du patrimoine ملفات le financement et la restauration.","على الصعيد العالمي، ترشّح فرنسا مواقعها إلى la Liste du patrimoine mondial de l’UNESCO. la France تحتل مكانةً بارزة في هذه القائمة: قِطاعات مثل le Mont-Saint-Michel، et Versailles تجذب ملايين الزوار سنوياً.","السياحة تُدرّ دخلاً وتخلق ضغطاً على المواقع: la fréquentation élevée تسرّع la détérioration. la stratégie الحالية تعتمد على la gestion des flux، et la numérisation pour réduire l’impact et améliorer la compréhension du site.","نحوياً، يُستعمل في نصوص التراث l’attributif et les compléments de qualité (« un édifice classé », « un site inscrit »)، مع la voix passive لأن الفاعل غالباً la commission أو l’institution. et les connecteurs d’opposition (toutefois, néanmoins) للتعبير عن la tension entre accès et protection.","بعد الدرس، اختر موقعاً واحداً من la liste française، اكتب أربع جمل: الموقع، تصنيفه، تحدٍّ واحد للحفظ، وحلٍّ مقترح. هذا التمرين يربط le vocabulaire par le raisonnement."],"sub":[{"h":"une notion élargie","p":["Le patrimoine est matériel et immatériel.","Les monuments historiques sont protégés depuis 1840.","Le classement encadre la restauration."]},{"h":"l’UNESCO et les sites","p":["La France propose des sites à l’UNESCO.","L’inscription valorise et oblige.","Le tourisme fréquente les grands sites."]},{"h":"conserver et transmettre","p":["La fréquentation use les édifices.","La gestion des flux limite l’impact.","La numérisation éclaire le visiteur."]}]},{"h":"les formules de la conservation","p":["« Ce site est classé au titre des monuments historiques… » — l’annonce du statut.","« L’inscription à la liste de l’UNESCO implique… » — la conséquence juridique.","« Toutefois, la fréquentation posait un problème… » — le constat des tensions.","« La mise en valeur consiste à… » — la définition d’une stratégie."]},{"h":"التطبيق والتلخيص","p":["تمرين la fiche de site: اكتب بطاقة من أربع جملاً لموقع قريب: الاسم، النوع، التصنيف، التحدي.","تمرين le commentaire: علّق على جملة « le tourisme menace le site » بـ « d’un côté… de l’autre… ».","تمرين la conférence: استعد شرحاً شفهياً من دقيقة واحدة حول la conservation مستعملًا le passif."]}],"pron":[{"w":"le patrimoine","ipa":"[lə pa.tʁi.mwaʁ]","approx":"لُ باتريموار"},{"w":"le classement","ipa":"[lə kla.sə.mɑ̃]","approx":"لُ كلاسمان"},{"w":"la restauration","ipa":"[la ʁɛs.tɔ.ʁa.sjɔ̃]","approx":"لا ريستوراسيون"}],"vocab":[{"fr":"le patrimoine","ar":"التراث","pos":"nom","g":"m","exFr":"Le patrimoine rassemble les édifices et les traditions.","ipa":"[lə pa.tʁi.mwaʁ]","exAr":"يجمع التراث المباني والتقاليد."},{"fr":"le monument historique","ar":"المعلم التاريخي","pos":"loc.","g":"m","exFr":"Le monument historique bénéficie d’une protection.","ipa":"[lə mɔ.ny.mɑ̃ is.tɔ.ʁik]","exAr":"يستفيد المعلم التاريخي من الحماية."},{"fr":"le classement","ar":"التصنيف (قانوني)","pos":"nom","g":"m","exFr":"Le classement interdit de modifier la façade.","ipa":"[lə kla.sə.mɑ̃]","exAr":"يمنع التصنيف تغيير الواجهة."},{"fr":"l’inscription","ar":"القيد والإدراج","pos":"nom","g":"f","exFr":"L’inscription à la liste UNESCO valorise le site.","ipa":"[lɛ̃.sʁip.sjɔ̃]","exAr":"يضفي قيد القائمة قيمة على الموقع."},{"fr":"la restauration","ar":"الترميم","pos":"nom","g":"f","exFr":"La restauration demande des savoir-faire.","ipa":"[la ʁɛs.tɔ.ʁa.sjɔ̃]","exAr":"يتطلب الترميم مهارات متخصصة."},{"fr":"la mise en valeur","ar":"التعريف والإبراز","pos":"loc.","g":"f","exFr":"La mise en valeur met en lumière l’histoire du lieu.","ipa":"[la mi.zɑ̃ valœʁ]","exAr":"يُبرز الإبراز تاريخ المكان."},{"fr":"la fréquentation","ar":"التدفق السياحي","pos":"nom","g":"f","exFr":"La fréquentation a doublé en dix ans.","ipa":"[la fʁe.kɑ̃.ta.sjɔ̃]","exAr":"تضاعف التدفق خلال عشر سنوات."},{"fr":"le site","ar":"الموقع","pos":"nom","g":"m","exFr":"Le site est inscrit sur la liste mondiale.","ipa":"[lə sit]","exAr":"الموقع مدرج في القائمة العالمية."},{"fr":"la conservation","ar":"الحفظ والصون","pos":"nom","g":"f","exFr":"La conservation passe par la régulation des flux.","ipa":"[la kɔ̃.sɛʁ.va.sjɔ̃]","exAr":"يمرّ الحفظ بتنظيم التدفقات."},{"fr":"le savoir-faire","ar":"المعرفة التقنية المتراكمة","pos":"loc.","g":"m","exFr":"La restauration transmet des savoir-faire rares.","ipa":"[lə sa.vwaʁ fɛʁ]","exAr":"ينقل الترميم مهارات نادرة."},{"fr":"préservation","ar":"الصون","pos":"nom","g":"f","exFr":"La préservation du site exige des moyens.","ipa":"[pʁe.zɛʁ.va.sjɔ̃]","exAr":"يتطلب صون الموقع وسائل."},{"fr":"classer","ar":"يُصنِّف","pos":"verbe","g":"","exFr":"L’État a classé l’édifice.","ipa":"[kla.se]","exAr":"صنّفت الدولة المبنى."}],"examples":[{"fr":"Ce monument est classé depuis 1840.","ar":"يُصنَّف هذا المعلم منذ 1840.","note":"le statut juridique"},{"fr":"Le site a été inscrit sur la liste de l’UNESCO.","ar":"أُدرج الموقع في قائمة اليونسكو.","note":"la voix passive administrative"},{"fr":"Toutefois, la fréquentation use les sols.","ar":"غير أن التدفق السياحي يُستهلك الأرضيات.","note":"la concession"},{"fr":"La conservation exige des moyens et des savoir-faire.","ar":"يتطلب الحفظ وسائل ومهارات.","note":"la relation de moyens"},{"fr":"La mise en valeur consiste à raconter le lieu.","ar":"يقوم الإبراز على سرد حكاية المكان.","note":"la définition"},{"fr":"Le classement interdit de modifier la façade.","ar":"يمنع التصنيف تعديل الواجهة.","note":"l’interdiction réglementaire"}],"grammar":[{"tFr":"Le passif administratif et les compléments d’agent","tAr":"المبني للمجهول الإداري وحروف التعليل","body":["Dans les textes du patrimoine, le passif est fréquent car l’acteur est une institution : « l’édifice a été classé », « le site a été restauré ». Le complément d’agent est souvent omis ou introduit par par : « par la commission ».","On y associe la nominalisation : « l’inscription du site », « la restauration du bâtiment ». Cela donne un ton technique attendu en C1."],"ex":[{"fr":"La cathédrale a été restaurée par l’État.","ar":"رمّمت الدولة الكاتدرائية."},{"fr":"L’inscription du site a été votée par le comité.","ar":"صوّتت اللجنة على إدراج الموقع."}]},{"tFr":"Exprimer la concession et l’objectif","tAr":"التعبير عن الاعتراض والغاية","body":["La concession : bien que, pourtant, toutefois, néanmoins — pour reconnaître une tension : « Bien que le tourisme rapporte, il use le site. »","L’objectif : afin de, pour, dans le but de — pour la stratégie : « afin de limiter la fréquentation ». Ces deux ressources structurent tout commentaire de conservation."],"ex":[{"fr":"Bien que le site soit fragile, il reste ouvert.","ar":"وإن كان الموقع هشاً، ظلّ مفتوحاً."},{"fr":"Les billets sont limités afin de réguler les flux.","ar":"تُحدَّد التذاكر لتنظيم التدفقات."}]}],"mistakes":[{"wrong":"confondre classement et inscription","right":"classement = protection nationale, inscription = liste internationale UNESCO","why":"les deux régimes ont des portées différentes — النظامان مختلفان بالنطاق."},{"wrong":"traduire patrimoine par « heritage » sans contexte","right":"employer « patrimoine » et préciser : matériel ou immatériel","why":"en français le terme est plus large — المصطلح الفرنسي أوسع."},{"wrong":"présenter le tourisme comme uniquement négatif","right":"nuancer : financement vs pression sur le site","why":"la conservation gère un arbitrage — الحفظ إشكالية موازنة."},{"wrong":"omettre la précision de la date ou du statut","right":"ajouter : « classé en… », « inscrit en… »","why":"la factuelle exige l’exactitude — الدقة واجبة في الموضوع التراثي."}],"dialogues":[{"title":"Visite guidée d’un monument","ctx":"مرشدة سياحية تشرح لزوار تصنيف معلم تاريخي","lines":[{"who":"Claire","fr":"Ce château est classé monument historique depuis 1913.","ar":"يُصنَّف هذا القصر معلماً تاريخياً منذ 1913."},{"who":"Hugo","fr":"Que implique ce classement ?","ar":"ماذا يعني هذا التصنيف؟"},{"who":"Claire","fr":"Il encadre la restauration et l’usage du bâtiment.","ar":"ينظّم ترميم المبنى واستعماله."},{"who":"Hugo","fr":"Donc la conservation passe par la régulation.","ar":"إذن يقوم الحفظ على التنظيم."}]},{"title":"Un débat sur le tourisme","ctx":"موظفان تراثيان يناقشان ضغط الزوار على موقع مصنَّف","lines":[{"who":"Léa","fr":"La fréquentation a doublé sur ce site.","ar":"تضاعف التدفق السياحي على هذا الموقع."},{"who":"Samir","fr":"Néanmoins, elle finance la maintenance.","ar":"غير أنها تموّل الصيانة."},{"who":"Léa","fr":"Afin de limiter l’usure, on numérise la visite.","ar":"لتقليل الاستهلاك، جرى رقمية الزيارة."},{"who":"Samir","fr":"La mise en valeur explique mieux l’histoire.","ar":"يُوضح الإبراز التاريخ بشكل أفضل."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما الفرق بين « classement » و« inscription »؟","opts":["الأول حماية وطنية والثاني قيد في قائمة اليونسكو","كلاهما إعلان تجاري","الأول للأفراد والثاني للشركات","لا فرق إطلاقاً"],"a":0,"why":"deux régimes de protection, national et international."},{"t":"fill","skill":"grammar","q":"أكمل بالمبني للمجهول: «Le site ___ sur la liste de l’UNESCO.»","fr":"Le site ___ sur la liste de l’UNESCO.","ans":"a été inscrit","why":"passif au passé composé : a été + participe passé."},{"t":"order","skill":"writing","q":"رتّب: يطلب الحفظ وسائل ومهارات","words":["La","conservation","exige","des","moyens","et","des","savoir-faire."],"ans":"La conservation exige des moyens et des savoir-faire.","why":"ordre sujet-verbe-complément, le point sur le dernier mot."},{"t":"listen","skill":"listening","q":"ما الذي يُسبّبه التدفق السياحي العالي حسب النص؟","opts":["استهلاك وتأكل المباني","زيادة عدد الموظفين","انخفاض التذاكر","إغلاق المتاحف"],"a":0,"why":"la fréquentation élevée use les édifices."},{"t":"translate","skill":"writing","q":"ترجم: «صُنّف هذا المعلم التاريخي سنة 1913.»","ans":"Ce monument a été classé en 1913.","why":"passif + « en » pour l’année de classement."},{"t":"speaking","skill":"speaking","q":"قدّم في ثلاث جمل حلّاً لمشكلة الزوار في موقع تراثي.","target":"fréquentation / régulation / mise en valeur","why":"argumentation pratique en registre soutenu."},{"t":"correct","skill":"grammar","q":"صحّح: «Le site a inscrit sur la liste.»","ans":"Le site a été inscrit sur la liste.","why":"la voix passive exige l’auxiliaire être."},{"t":"mcq","skill":"reading","q":"ما الهدف من « la mise en valeur »؟","opts":["إبراز قيمة الموقع وشرح تاريخه","زيادة أسعار التذاكر","هدم المباني القديمة","منع دخول الزوار"],"a":0,"why":"la mise en valeur rend lisible et accessible l’histoire du lieu."}],"homework":"اختر موقعاً مصنَّفاً في بلدك، اكتب بطاقة من خمس جملاً: الاسم، النوع، التحدي، وحلّان مقترحان، مع كلمتي conservation et mise en valeur.","sources":[{"title":"Révision chapitre : Le Patrimoine Français","channel":"Tourisme et Territoire","videoId":"7tnDcj3FAgI","why":"مراجعة منظّمة لـ le patrimoine français: la notion de patrimoine، les monuments historiques، et les enjeux de conservation — نقطة انطلاق متوازنة للدرس.","cat":"Civilisation","level":"C1","main":true},{"title":"L’inscription au Patrimoine mondial de l’Unesco, une « course au label » pour les villes","channel":"FRANCE 24","videoId":"3n6J4RyCKW0","why":"تحليل صحفي لـ la dynamique des classements UNESCO: تدريب على la compréhension d’un reportage et le registre d’analyse.","cat":"Civilisation","level":"C1","extra":true},{"title":"Alexandre Gady : le patrimoine français","channel":"France Culture","videoId":"nBWToYbxeW8","why":"حوار أكاديمي عن la notion de patrimoine en France: تدريب على la compréhension d’un entretien intellectuel.","cat":"Civilisation","level":"C1","extra":true}],"supplements":[{"id":"3n6J4RyCKW0","title":"L’inscription au Patrimoine mondial de l’Unesco, une « course au label » pour les villes","channel":"FRANCE 24","why":"تحليل صحفي لـ la dynamique des classements UNESCO: تدريب على la compréhension d’un reportage et le registre d’analyse.","lang":"fr","dur":7},{"id":"nBWToYbxeW8","title":"Alexandre Gady : le patrimoine français","channel":"France Culture","why":"حوار أكاديمي عن la notion de patrimoine en France: تدريب على la compréhension d’un entretien intellectuel.","lang":"fr","dur":42}]},{"id":"c1-t6-l6","fr":"Débats de société contemporains","ar":"نقاشات المجتمع المعاصر: الثقافة والعمل والرقمي — مفردات الجدل المتمدّن","objectives":["استخراج مفردات النقاش المعاصر: l’inégalité, le télétravail, la platformisation, le numérique","تمييز le registre du débat civilisé عن le langage partisan أو l’agression verbale","صياغة رأي بـ la nuance: « d’une part… d’autre part », « il serait raisonnable de… »","تحليل نصاً قصيراً حول le travail أو la culture وتحديد ses arguments"],"sections":[{"h":"الدرس 6: كيف تُناقش المسائل الاجتماعية بلغة متمدنة ومحايدة","video":{"id":"igpK2wFZPHI","title":"Comment est structurée la société française ? (1/2) | Terminale SES (Bac 2027)","channel":"BrefSES","why":"تحليل منهجي لبنية la société française: les classes, les inégalités et les transformations du travail — أساس موضوعي للإحساس بـ le vocabulaire du débat social.","lang":"fr","main":true,"dur":10},"p":["النقاشات المعاصرة في فرنسا تدور حول ثلاث مجالات: la culture (الهوية والتنوّع)، le travail (التنظيم والرواتب والذكاء الاصطناعي)، et le numérique (الخصوصية والمنصات). la qualité du débat phụهة إلى le langage المستعمل.","المفردة الأساسية للنقاش المتمدن هي la nuance: التعبير عن الرأي دون إقصاء الرأي المقابل. صيغ مثل « je vois le problème autrement » أو « il faut tenir compte de… » تفتح الحوار، بينما les formules catégoriques تغلقه.","في مجال le travail، يتصدّر النقاشات le télétravail وla relation salariale et l’automatisation. في la culture: la politique culturelle et le soutien aux créateurs et la place des industries créatives في l’économie.","الرقمي يطرح مسائل la protection des données, la désinformation, et l’accès aux services publics en ligne. le vocabulaire الدقيق هنا ضروري: distinguer entre plateforme, algorithme, donnée personnelle, espace public numérique.","نحوياً، يُستعمل la modalisation بقوة: le conditionnel (« cela pourrait… »)، et les locutions temporelles et concessives (« aujourd’hui », « certes »). la négation organisée (« non pas que… mais… ») تسمح بتصحيح التبسيط.","بعد الدرس، اختر قضية واحدة، اكتب فقرة رأي من خمس جملاً تبدأ بـ « D’une part… d’autre part… » وتنتهي بـ « il serait raisonnable de… ». هذا النموذج يُستخدم في le B2 terminal et le C1."],"sub":[{"h":"le travail en débat","p":["Le télétravail transforme les horaires.","Les inégalités restent mesurables.","L’automatisation change les métiers."]},{"h":"culture et numérique","p":["La politique culturelle soutient la création.","Les plateformes organisent la visibilité.","La désinformation fragilise le débat."]},{"h":"débattre avec nuance","p":["La nuance ouvre la discussion.","Les faits précèdent l’opinion.","On distingue mesure et slogan."]}]},{"h":"les formules du débat civilisé","p":["« D’une part… d’autre part… » — la présentation équilibrée des points.","« Je comprends ce point, toutefois… » — la concession suivie d’un désaccord mesuré.","« Il serait raisonnable de… » — la proposition prudente.","« Il faut tenir compte des données… » — l’appel aux faits."]},{"h":"التطبيق والتلخيص","p":["تمرين la nuance: حوّل جملة مطلقة « Le télétravail détruit les liens » إلى صيغة متوازنة avec « certes… néanmoins… ».","تمرين le dialogue: اكتب أربع جملاً بين شخصين يختلفان حول la désinformation، مع استعمال la concession.","تمرين la synthèse: لخّص نصاً صحفياً في ثلاث جمل: les faits, les arguments, et une ouverture."]}],"pron":[{"w":"le débat","ipa":"[lə de.ba]","approx":"لُ ديبا"},{"w":"la nuance","ipa":"[la nɥɑ̃s]","approx":"لا نيوانس"},{"w":"le télétravail","ipa":"[lə te.le.tʁa.vaj]","approx":"لُ تيلي تراڤاي"}],"vocab":[{"fr":"le débat","ar":"النقاش","pos":"nom","g":"m","exFr":"Le débat public exige des arguments.","ipa":"[lə de.ba]","exAr":"يتطلب النقاش العام حججاً."},{"fr":"la nuance","ar":"التدرّج والحذر","pos":"nom","g":"f","exFr":"La nuance évite les excès.","ipa":"[la nɥɑ̃s]","exAr":"يتجنّب التدرّج الغلو."},{"fr":"l’inégalité","ar":"التفاوت","pos":"nom","g":"f","exFr":"Les données mesurent l’inégalité.","ipa":"[li.ne.ga.li.te]","exAr":"تقيس البيانات التفاوت."},{"fr":"le télétravail","ar":"العمل عن بُعد","pos":"loc.","g":"m","exFr":"Le télétravail modifie les horaires.","ipa":"[lə te.le.tʁa.vaj]","exAr":"يُعدّل العمل عن بُعد المواعيد."},{"fr":"l’automatisation","ar":"الأتمتة","pos":"nom","g":"f","exFr":"L’automatisation change certains métiers.","ipa":"[ɔ.tɔ.ma.ta.za.sjɔ̃]","exAr":"تغيّر الأتمتة بعض المهن."},{"fr":"la désinformation","ar":"التضليل","pos":"nom","g":"f","exFr":"La désinformation circule vite.","ipa":"[de.zɛ̃.fɔʁ.ma.sjɔ̃]","exAr":"يتداول التضليل بسرعة."},{"fr":"la donnée personnelle","ar":"المعطى الشخصية","pos":"loc.","g":"f","exFr":"La donnée personnelle est protégée.","ipa":"[la dɔ.ne pɛʁ.sɔ.nɛl]","exAr":"تُحمى المعطى الشخصية."},{"fr":"la plateforme","ar":"المنصّة الرقمية","pos":"nom","g":"f","exFr":"La plateforme organise la visibilité.","ipa":"[la plat.fɔʁm]","exAr":"تنظّم المنصّة الظهور."},{"fr":"le dialogue","ar":"الحوار","pos":"nom","g":"m","exFr":"Le dialogue remplace l’affrontement.","ipa":"[lə da.lɔɡ]","exAr":"يحلّ الحوار محل الصدام."},{"fr":"nuancer","ar":"يُدرّج","pos":"verbe","g":"","exFr":"Il faut nuancer cette affirmation.","ipa":"[nɥɑ̃.se]","exAr":"يجب تدريج هذه التأكيدة."},{"fr":"pondérer","ar":"يزن بإنصاف","pos":"verbe","g":"","exFr":"Les faits pondèrent les opinions.","ipa":"[pɔ̃.de.ʁe]","exAr":"توزن الآراء بالوقائع."},{"fr":"un avis éclairé","ar":"رأي مستنير","pos":"loc.","g":"m","exFr":"Les données permettent un avis éclairé.","ipa":"[œ̃ na.vi e.klɛ.ʁe]","exAr":"تتيح البيانات رأياً مستنيراً."}],"examples":[{"fr":"D’une part, le télétravail libère du temps ; d’autre part, il isole.","ar":"من جهة، يحرّر العمل عن بُعد الوقت؛ ومن جهة أخرى، يُعزل الأفراد.","note":"l’équilibre des points"},{"fr":"Certes, les chiffres sont inégaux, néanmoins la tendance se réduit.","ar":"والرقم وإن كان متفاوتاً، فإن الاتجاه يتقلّص.","note":"la concession"},{"fr":"Il serait raisonnable de réguler les plateformes.","ar":"من المعقول تنظيم المنصّات.","note":"la proposition prudente"},{"fr":"Il faut tenir compte des données avant de conclure.","ar":"يلزم استحضار البيانات قبل الخلاصة.","note":"l’appel aux faits"},{"fr":"Non pas que la technologie soit neutre, mais son usage varie.","ar":"ليس لأن التقنية محايدة، وإنما لأن استعمالها يتباين.","note":"la négation organisée"},{"fr":"Le débat gagne en qualité quand les faits précèdent l’opinion.","ar":"يتحسّن النقاش حين تسبق الوقائع الرأي.","note":"la thèse mesurée"}],"grammar":[{"tFr":"La modalisation : conditionnel et atténuation","tAr":"التمييز والتلطيف في عرض الرأي","body":["Le conditionnel adoucit la thèse : « cela pourrait améliorer… » au lieu de « cela améliorera… ». Il signale une hypothèse argumentée, pas un dogme.","Les atténuateurs complètent : peut-être, sans doute, il semble que. En C1, leur usage distingue un locuteur qui raisonne d’un locuteur qui affirme."],"ex":[{"fr":"Cette mesure pourrait réduire les inégalités.","ar":"قد تقلّل هذه الإجراءات التفاوت."},{"fr":"Il semble que le débat se soit apaisé.","ar":"يبدو أن النقاش قد هدأ."}]},{"tFr":"La concession et la négation organisée","tAr":"الاعتاظ والنفي المنظّم","body":["Structure classique : « Certes P, néanmoins Q » ou « Non pas que P, mais Q ». Elle permet de reconnaître un argument adverse sans céder sa thèse.","C’est la signature du débat civilisé : elle remplace le « oui, mais… » familier par une syntaxe claire et respectueuse."],"ex":[{"fr":"Certes, la croissance crée des emplois ; néanmoins, elle crée des inégalités.","ar":"والنمية تخلق وظائف؛ غير أنها تخلق تفاوتاً."},{"fr":"Non pas que je refuse le progrès, mais je veux l’encadrer.","ar":"ليس لأني أرفض التقدم، بل لأني أريد تنظيمه."}]}],"mistakes":[{"wrong":"affirmer sans nuance : « c’est comme ça »","right":"nuancer : « il semble que », « d’une part… »","why":"le débat civilisé exige la mesure — النقاش المتمدن يقتضي التدرّج."},{"wrong":"confondre opinion et fait","right":"séparer : « les données montrent… », « je pense que… »","why":"la crédibilité vient de cette distinction — التمييز يكسب المصداقية."},{"wrong":"employer des termes vagues : « machin, truc »","right":"employer un vocabulaire précis : plateforme, donnée, algorithme","why":"la précision évite le malentendu — الدقة تمنع سوء الفهم."},{"wrong":"attaquer la personne","right":"critiquer l’argument","why":"la politesse du débat sépare l’idée de l’interlocuteur — اللياقة تفصل الفكرة عن المتكلّم."}],"dialogues":[{"title":"Un débat sur le télétravail","ctx":"زميلان يناقشان تدشين العمل عن بُعد في الشركة","lines":[{"who":"Marion","fr":"Certes, le télétravail libère du temps de trajet.","ar":"والعمل عن بُعد يحرّر وقت التنقّل."},{"who":"Yanis","fr":"Néanmoins, il peut fragiliser les liens d’équipe.","ar":"غير أنه قد يُضعف روابط الفريق."},{"who":"Marion","fr":"Il serait raisonnable de le limiter à deux jours.","ar":"من المعقول تحديده إلى يومين."},{"who":"Yanis","fr":"D’accord, à condition de mesurer les effets.","ar":"موافق، بشرط قياس الآثار."}]},{"title":"La désinformation en ligne","ctx":"معلّم وطالبة يتحدثان عن جودة المعلومات الرقمية","lines":[{"who":"Sonia","fr":"La désinformation circule plus vite que la vérification.","ar":"يتداول التضليل أسرع من التحقق."},{"who":"M. Bertin","fr":"D’où la nécessité d’un avis éclairé.","ar":"من هنا ضرورة الرأي المستنير."},{"who":"Sonia","fr":"Il faut comparer les sources avant de partager.","ar":"يجب مقارنة المصادر قبل المشاركة."},{"who":"M. Bertin","fr":"Vous pondérez ainsi votre jugement.","ar":"هكذا تزنون حكمكم بإنصاف."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما المقصود بـ « la nuance » في النقاش؟","opts":["التدرّج وتجنّب الأحكام المطلقة","سرعة الرد","الإجماع الكامل","المقاطعة المهذبة"],"a":0,"why":"la nuance balance l’énoncé sans nier la thèse adverse."},{"t":"fill","skill":"grammar","q":"أكمل: «Certes les chiffres sont élevés, ___ la tendance baisse.»","fr":"Certes les chiffres sont élevés, ___ la tendance baisse.","ans":"néanmoins","why":"la concession est suivie d’un connecteur d’opposition : néanmoins."},{"t":"order","skill":"writing","q":"رتّب: يجب مراسلة البيانات قبل الخلاصة","words":["Il","faut","tenir","compte","des","données","avant","de","conclure."],"ans":"Il faut tenir compte des données avant de conclure.","why":"locution « tenir compte de » + infinitif, point final."},{"t":"listen","skill":"listening","q":"ما الذي يجعل النقاش أكثر جودة بحسب النص؟","opts":["أن تسبق الوقائع الرأي","أن يطول الوقت","أن يتحدث شخص واحد","أن تُلغى الآراء"],"a":0,"why":"les faits précèdent l’opinion : règle du débat raisonné."},{"t":"translate","skill":"writing","q":"ترجم: «قد تقلّل هذه الإجراءات التفاوت.»","ans":"Cette mesure pourrait réduire les inégalités.","why":"le conditionnel de prudence + nom abstrait inégalités."},{"t":"speaking","skill":"speaking","q":"عبّر عن رأي متوازن حول la désinformation في ثلاث جمل باستعمال la concession.","target":"certes / néanmoins / avis éclairé","why":"production orale avec structure de concession."},{"t":"correct","skill":"grammar","q":"صحّح: «Il semble que ce soit vrai, mais je confirme que c’est faux.»","ans":"Il semble que ce soit vrai ; en revanche, les données montrent que c’est faux.","why":"remplacer l’affirmation brute par une opposition argumentée et sourcée."},{"t":"mcq","skill":"reading","q":"أي عبارة تمثّل le débat civilisé؟","opts":["Je comprends votre point, toutefois voici un contre-exemple.","Votre idée est absurde.","Tout le monde est d’accord.","Chacun pense ce qu’il veut."],"a":0,"why":"la concession + contre-argument : forme respectueuse et constructive."}],"homework":"اكتب فقرة رأي من ست جملاً حول موضوع واحد (la culture, le travail, ou le numérique)، مستعملاً: certes, néanmoins, il serait raisonnable de…، مع فصل الوقائع عن الرأي.","sources":[{"title":"Comment est structurée la société française ? (1/2) | Terminale SES (Bac 2027)","channel":"BrefSES","videoId":"igpK2wFZPHI","why":"تحليل منهجي لبنية la société française: les classes, les inégalités et les transformations du travail — أساس موضوعي للإحساس بـ le vocabulaire du débat social.","cat":"Civilisation","level":"C1","main":true},{"title":"SES : La société française actuelle","channel":"Bac Up","videoId":"GswIFaP_kXM","why":"عرض منهجي لبنية المجتمع الفرنسي: مفردات l’inégalité et les catégories sociales لتمهيد le débat.","cat":"Civilisation","level":"C1","extra":true},{"title":"Vit-on dans une société de la fatigue ?","channel":"Open Education Reviews","videoId":"nFUdv6j_teg","why":"نقاش حول le travail et l’épuisement: تدريب على la compréhension d’une controverse et la repérage des arguments.","cat":"Civilisation","level":"C1","extra":true}],"supplements":[{"id":"GswIFaP_kXM","title":"SES : La société française actuelle","channel":"Bac Up","why":"عرض منهجي لبنية المجتمع الفرنسي: مفردات l’inégalité et les catégories sociales لتمهيد le débat.","lang":"fr","dur":9},{"id":"nFUdv6j_teg","title":"Vit-on dans une société de la fatigue ?","channel":"Open Education Reviews","why":"نقاش حول le travail et l’épuisement: تدريب على la compréhension d’une controverse et la repérage des arguments.","lang":"fr","dur":14}]}]},{"id":"c1-t7","slug":"communication-interculturelle","icon":"globe","color":"#7c3aed","fr":"Communication interculturelle","ar":"التواصل عبر الثقافات","desc":"traduire l’humour، les faux-amis، les emprunts، le transcodage، la négociation، la médiation.","lessons":[{"id":"c1-t7-l1","fr":"Traduire l’humour","ar":"ترجمة الفكاهة: من الجناس إلى المعنى","objectives":["تفسير سبب صعوبة ترجمة الفكاهة مقارنة بالنَّثر العادي: ثلاث طبقات دلالية في نص واحد","التمييز بين le décalage, l’ironie, le sarcasme وأسباب الخلط بينها في السياق الفرنسي","تطبيق أربع استراتيجيات ترجمة: l’équivalent culturel, la compensation, l’amplification, la note du traducteur","إعادة صياغة طرفة فرنسية للجمهور العربي مع الحفاظ على le moment comique"],"sections":[{"h":"الدرس 1: كيف تُترجم الطرفة من الفرنسية إلى العربية دون أن تفقد روحها","video":{"id":"rcrFTZYCyqI","title":"Traduire l’humour : mission (im)possible ?","channel":"LMDM : Les Maîtres des Mots","why":"ندوة متخصصة عن ترجمة الفكاهة: كيف ينتقل اللفظ الطريف من الفرنسية إلى العربية، وأين يكمن le décalage الذي يصنع الضحك، وماذا يفعل le traducteur حين يفشل le jeu de mots في الانتقال.","lang":"fr","main":true,"dur":12},"p":["الفكاهة هي أصعب ما يقع على المترجم، لأن الطرفة الواحدة تلعب في آنٍ واحد على ثلاث طبقات: المعنى الحرفي، والمرجع الثقافي، والنبرة الساخرة. النص العادي ينقل معلومة، أما la blague فتنقل معلومة + موقف + رد فعل متوقع، فإن اختل أحدها اختل الضحك كله.","مصدر الأول: le décalage — أي الفجوة بين ما يتوقعه المستمع وما يصله فعلاً. الطرفة تبني توقعاً صامتاً ثم تكسره: « Ce n’est pas elle qui est en retard, c’est le monde qui est trop tôt ». الترجمة الحرفية تنقل الجملة لكنها تُبقي الكسر في مكانه الخطأ.","مصدر الثاني: الفروق الدقيقة بين la plaisanterie, l’ironie, le sarcasme et la persifflage. l’ironie تنفي المعنى بلهجة محايدة (« Quelle bonne idée… »)، وle sarcasme يضرب بقصد، وle 2nd degré يعني أن الكلمة لا تعني ما تقوله حرفياً. المستمع العربي يخطئ بينها إذا لم يسمع le ton.","مصدر الثالث: faux amis culturels — مراجع يُفترض أنها مشتركة ولا شيء أكثر: les régions, l’école, les vacances, le petit ami. طرفة عن le bac أو عن la bise تنجح داخل فرنسا وتبرد خارجها، لأن le référent غير موجود في ذاكرة الجمهور العربي.","أربع استراتيجيات تنقذ الموقف: الأول la compensation: خسارة الجناس هنا وتعويضه بجناس هناك؛ الثاني l’équivalent culturel: استبدال المرجع بمرجع محلي؛ الثالث l’amplification ou l’atténuation: تقوية النكتة أو تلطيفها حسب ثقافة الجمهور؛ الرابع la note du traducteur حين يعجز كل شيء عن النقل.","القاعدة العملية: اترجم الأثر لا الجملة. اسأل نفسك سؤالاً واحداً بعد كل جملة: « هل سيضحك قارئي العربي في اللحظة نفسها التي ضحك فيها القارئ الفرنسي؟ ». إن كان الجواب لا، أعد بناء la chute بدل ترجمتها."],"sub":[{"h":"le décalage comique","p":["Une blague repose sur l’écart entre ce que l’on attend et ce que l’on entend.","Le traducteur doit d’abord repérer où se situe le déclic.","Si le déclic ne tombe pas au même endroit, le rire ne vient pas."]},{"h":"ironie, sarcasme, 2nd degré","p":["L’ironie dit le contraire sans changer son ton.","Le sarcasme, lui, frappe délibérément et se fait entendre.","On dit souvent qu’il prend tout au second degré."]},{"h":"traduire ou trahir ?","p":["Le jeu de mots se perd souvent entre deux langues.","On peut alors compenser par un autre effet de langage.","L’effet compte davantage que le mot à mot."]}]},{"h":"les formules du 2nd degré","p":["« Tu as bien fait de ne pas venir… » — la phrase qui dit le contraire de ce qu’elle signifie.","« C’est l’humour français, tu comprends. » — l’explication de texte devant un public étranger.","« Au sens propre, c’est une blague ; au sens figuré, c’est une critique. »","« Elle a dit ça, mais elle ne le pensait pas comme ça. » — le commentaire sur l’intonation."]},{"h":"التطبيق والتلخيص","p":["تمرين l’écoute: استمع إلى مقطع قصير وحدّد le ton: ساخر أم جاد أم مرحّ؟ ثم اكتب جملتين تشرحان لماذا.","تمرين la compensation: اختر جناساً فرنسياً لا يُترجم، واختر جناساً عربياً بديلًا يصنع نفس الأثر الصوتي.","تمرين la chute: أعد كتابة طرفة فرنسية عن la rentrée لجمهور مصري أو مغربي مع تغيير le référent فقط."]}],"pron":[{"w":"l’humour","ipa":"[ly.muʁ]","approx":"لِيمور"},{"w":"le décalage","ipa":"[lə de.kɑ.laʒ]","approx":"لُ دُكالاج"},{"w":"l’ironie","ipa":"[i.ʁɔ.ni]","approx":"إيروني"}],"vocab":[{"fr":"le décalage","ar":"الفجوة المضحكة بين التوقع والواقع","pos":"nom","g":"m","exFr":"Le décalage entre la situation et les mots crée le rire.","ipa":"[de.kɑ.laʒ]","exAr":"الفجوة بين الموقف والكلمات هي مصدر الضحك."},{"fr":"l’ironie","ar":"السخرية بإنكار المعنى","pos":"nom","g":"f","exFr":"Son ironie a mis tout le monde mal à l’aise.","ipa":"[i.ʁɔ.ni]","exAr":"سخريته جعلت الجميع يشعرون بالحرج."},{"fr":"le sarcasme","ar":"التهكم القاصد","pos":"nom","g":"m","exFr":"Le sarcasme de la chronique était cinglant.","ipa":"[saʁ.kasm]","exAr":"كان تهكم المقالة لاذعاً."},{"fr":"la litote","ar":"اللِّتَوْة: الإثارة بنفي الضد","pos":"nom","g":"f","exFr":"Dire « ce n’est pas mal » pour dire « c’est très bien » est une litote.","ipa":"[litɔt]","exAr":"قول «ليست سيئة» بمعنى «ممتازة» لِتَوْة."},{"fr":"l’euphémisme","ar":"التلطيف اللفظي","pos":"nom","g":"m","exFr":"« Il est parti » est un euphémisme pour « il a été licencié ».","ipa":"[ø.fe.mism]","exAr":"«رحل» تلطيف بدل «طُرد»."},{"fr":"le second degré","ar":"المعنى غير الحرفي","pos":"loc.","g":"m","exFr":"Il a tout pris au second degré.","ipa":"[lə sə.kɔ̃ də.ɡʁɛ]","exAr":"أخذ كل شيء بالمعنى غير الحرفي."},{"fr":"la chute","ar":"الخاتمة المفاجئة للطرفة","pos":"nom","g":"f","exFr":"La chute de la blague arrive toujours à la fin.","ipa":"[ʃyt]","exAr":"خاتمة الطرفة تأتي دائماً في النهاية."},{"fr":"le sens littéral","ar":"المعنى الحرفي","pos":"nom","g":"m","exFr":"Le sens littéral ne suffit pas ici.","ipa":"[lə sɑ̃ li.te.ʁal]","exAr":"المعنى الحرفي لا يكفي هنا."},{"fr":"le sens figuré","ar":"المعنى المجازي","pos":"nom","g":"m","exFr":"Dans cette phrase, tout est pris au sens figuré.","ipa":"[lə sɑ̃ fi.ɡy.ʁe]","exAr":"في هذه الجملة كل شيء مأخوذ بالمعنى المجازي."},{"fr":"l’équivalent culturel","ar":"المكافئ الثقافي","pos":"nom","g":"m","exFr":"Cherchez un équivalent culturel avant de traduire.","ipa":"[e.ki.va.lɑ̃ kyl.ty.ʁɛl]","exAr":"ابحث عن مكافئ ثقافي قبل الترجمة."},{"fr":"la note du traducteur","ar":"حاشية المترجم","pos":"nom","g":"f","exFr":"Une note du traducteur explique ce jeu de mots.","ipa":"[la nɔt dy tʁa.dyk.tœʁ]","exAr":"حاشية المترجم تشرح هذا الجناس."},{"fr":"l’auto-dérision","ar":"التهكم بالنفس","pos":"nom","g":"f","exFr":"Son humour repose surtout sur l’auto-dérision.","ipa":"[o.to de.ʁi.zjɔ̃]","exAr":"فكاهته تقوم أساساً على التهكم بالنفس."}],"examples":[{"fr":"C’est le public qui rit, pas l’auteur.","ar":"الجمهور هو الذي يضحك، لا المؤلف.","note":"la phrase clivée"},{"fr":"On ne traduit pas une blague, on la rejoue.","ar":"الطرفة لا تُترجم، بل تُعيد إنتاجها.","note":"la traduction de l’humour"},{"fr":"Ce n’est pas une insulte, c’est de l’ironie.","ar":"ليست إهانة، بل سخرية.","note":"ce n’est pas… c’est…"},{"fr":"Elle a dit ça du ton de la plaisanterie.","ar":"قالتها بنبرة المزاح.","note":"le ton"},{"fr":"Le jeu de mots ne passe pas en arabe.","ar":"الجناس لا ينتقل إلى العربية.","note":"la limite de la traduction"},{"fr":"Ici, le second degré est de rigueur.","ar":"هنا لا بد من المعنى غير الحرفي.","note":"la règle d’usage"}],"grammar":[{"tFr":"La phrase clivée : c’est… qui / ce n’est pas… mais","tAr":"الجملة المقسّمة: c’est… qui و ce n’est pas… mais","body":["La phrase clivée isole l’information nouvelle : « C’est l’arabe qui traduit, ce n’est pas le français qui rigole ». Dans une blague, elle déplace le poids de la phrase et prépare l’auditeur à la chute.","On l’associe à la dislocation : « L’humour, c’est fragile ». Le rythme crée une suspension : l’auditeur anticipe, puis est déçu — et c’est précisément ce décalage qui fait rire."],"ex":[{"fr":"C’est la fin surprenante qui fait rire.","ar":"النهاية المفاجئة هي التي تُضحك."},{"fr":"Ce n’est pas le traducteur qui manque de mots, c’est la langue.","ar":"ليس المترجم من يعجز عن الكلمات، بل اللغة."}]},{"tFr":"Le conditionnel de l’ironie et la négation restrictive","tAr":"الشرطية في السخرية والنفي التحديد","body":["Le conditionnel sert à dire sans affirmer : « Il aurait pu prévenir… » signifie qu’il n’a pas prévenu. Le locuteur garde les mains propres tout en faisant entendre sa critique.","La négation restrictive ne… que mesure la portée : « Ce n’est qu’une blague » atténue, « Ce n’est rien qu’une blague » (familier) renforce. L’amplitude de l’atténuation décide de l’effet comique ou blessant."],"ex":[{"fr":"Tu aurais pu me le dire plus tôt.","ar":"كان بإمكانك إخباري سابقاً."},{"fr":"Ce n’est qu’une plaisanterie.","ar":"إنها مزحة فحسب."}]}],"mistakes":[{"wrong":"traduire la blague mot à mot","right":"traduire l’effet de la blague","why":"le mot à mot sauve le sens mais tue le rire — الترجمة الحرفية تنقذ المعنى وتقتل الفكاهة."},{"wrong":"confondre ironie et sarcasme en arabe","right":"repérer le ton avant de choisir le mot","why":"l’ironie est froide, le sarcasme est tranchant — السخرية باردة والتهكم لاذع."},{"wrong":"garder le référent français inconnu","right":"remplacer le référent par un équivalent local","why":"sans référent commun, il n’y a pas de déclic comique — بلا مرجع مشترك لا توجد لحظة ضحك."},{"wrong":"traduire le second degré au premier","right":"marquer le second degré par l’intonation ou la formule","why":"une phrase neutre perd tout son venin — الجملة المحايدة تفقد سَمّها كله."}],"dialogues":[{"title":"Atelier de traduction","ctx":"مترجمان يناقشان طرفة في نص أدبي","lines":[{"who":"Léa","fr":"Ici, la chute dépend d’un jeu de mots sur « rire ».","ar":"هنا تعتمد الخاتمة على جنس حول كلمة rire."},{"who":"Mehdi","fr":"En arabe, ce jeu de mots ne passe pas du tout.","ar":"في العربية لا ينجح هذا الجناس إطلاقاً."},{"who":"Léa","fr":"Alors cherchons un équivalent culturel.","ar":"إذن لنبحث عن مكافئ ثقافي."},{"who":"Mehdi","fr":"D’accord, mais gardons l’effet comique.","ar":"حسناً، لكن مع الحفاظ على الأثر المضحك."}]},{"title":"Expliquer une blague","ctx":"شخص يشرح لصديقه لماذا كان النص ساخراً","lines":[{"who":"Sarah","fr":"Tu as compris pourquoi c’était drôle ?","ar":"هل فهمت سبب كونه مضحكاً؟"},{"who":"Karim","fr":"Je croyais qu’il critiquait son collègue.","ar":"ظننت أنه ينتقد زميله."},{"who":"Sarah","fr":"Il parlait au second degré, tout simplement.","ar":"كان يتكلم بالمعنى غير الحرفي ببساطة."},{"who":"Karim","fr":"Ah, le ton change tout alors.","ar":"آه، النبرة تغيّر كل شيء إذن."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما المقصود بـ « le décalage » في الطرفة؟","opts":["الفجوة بين التوقع والواقع","الخطأ في النطق","الترجمة الحرفية","الوقفة الوسطى"],"a":0,"why":"le décalage = l’écart entre ce que l’on attend et ce que l’on entend."},{"t":"fill","skill":"grammar","q":"أكمل: «___ public qui rit, pas l’auteur.»","fr":"___ public qui rit, pas l’auteur.","ans":"C’est","why":"la phrase clivée isole l’élément porteur de l’information."},{"t":"order","skill":"writing","q":"رتّب: الفكاهة تقوم على الفجوة.","words":["L’humour","repose","sur","le","décalage."],"ans":"L’humour repose sur le décalage.","why":"ordre sujet-verbe-complément circonstanciel."},{"t":"listen","skill":"listening","q":"في النص، ماذا نعني بقول « il parle au second degré »؟","opts":["يقول العكس مما يقصده","يرتقي بدرجة خطابه","يتكلم بلغة رسمية","يكرر كلماته"],"a":0,"why":"le second degré = le contraire de ce qui est dit littéralement."},{"t":"translate","skill":"writing","q":"ترجم: «الطرفة لا تُترجم بل تُعاد صياغتها.»","ans":"Une blague ne se traduit pas, elle se rejoue.","why":"la voix passive avec « se » + l’infinitif de processus."},{"t":"speaking","skill":"speaking","q":"اشرح بلغة فرنسية لماذا يصعب ترجمة الفكاهة إلى العربية.","target":"décalage / sens figuré / référent culturel","why":"إنتاج لغوي مركّب يربط ثلاث مفاهيم في حجة واحدة."},{"t":"correct","skill":"grammar","q":"صحّح: «Ce n’est pas lui qui a raison, mais c’est moi.» استخدم الصيغة المقسّمة الصحيحة","ans":"Ce n’est pas lui qui a raison, c’est moi.","why":"après « ce n’est pas… » on reprend avec « c’est… » sans « mais »."},{"t":"mcq","skill":"reading","q":"أي استراتيجية تُستعمل حين يعجز الجناس عن الانتقال؟","opts":["la note du traducteur","la traduction littérale","la suppression du passage","la répétition mot à mot"],"a":0,"why":"la note du traducteur explique ce que la langue ne peut pas dire."}],"homework":"اختر طرفة فرنسية قصيرة عن la vie quotidienne، اترجمها إلى العربية باستعمال l’équivalent culturel، ثم اكتب ثلاث جمل تشرح: ما الذي فقدته، وما الذي عوّضته، ولماذا سيضحك القارئ العربي في نفس اللحظة.","sources":[{"title":"Traduire l’humour : mission (im)possible ?","channel":"LMDM : Les Maîtres des Mots","videoId":"rcrFTZYCyqI","why":"ندوة متخصصة عن ترجمة الفكاهة: كيف ينتقل اللفظ الطريف من الفرنسية إلى العربية، وأين يكمن le décalage الذي يصنع الضحك، وماذا يفعل le traducteur حين يفشل le jeu de mots في الانتقال.","cat":"Interculturel","level":"C1","main":true},{"title":"parler au 2nd degré ou l’art de maîtriser l’humour français - Karambolage - ARTE","channel":"Karambolage en français - ARTE","videoId":"F9IOU0lB8j8","why":"شرح مصوَّر دقيق للفرق بين le premier et le second degré: كيف تُبنى السخرية الفرنسية بالكلمات وبالنبرة معاً.","cat":"Interculturel","level":"C1","extra":true},{"title":"Humour et traduction – Journée mondiale de la traduction 2022 en Île-de-France","channel":"SFT - Société française des traducteurs","videoId":"bwa-YERdt5M","why":"محاضرة مهنية من جمعية المترجمين: قراءات مباشرة في مشكلات ترجمة الفكاهة وما تقدمه la compensation من حلول.","cat":"Interculturel","level":"C1","extra":true}],"supplements":[{"id":"F9IOU0lB8j8","title":"parler au 2nd degré ou l’art de maîtriser l’humour français - Karambolage - ARTE","channel":"Karambolage en français - ARTE","why":"شرح مصوَّر دقيق للفرق بين le premier et le second degré: كيف تُبنى السخرية الفرنسية بالكلمات وبالنبرة معاً.","lang":"fr","dur":7},{"id":"bwa-YERdt5M","title":"Humour et traduction – Journée mondiale de la traduction 2022 en Île-de-France","channel":"SFT - Société française des traducteurs","why":"محاضرة مهنية من جمعية المترجمين: قراءات مباشرة في مشكلات ترجمة الفكاهة وما تقدمه la compensation من حلول.","lang":"fr","dur":11}]},{"id":"c1-t7-l2","fr":"Faux-amis et calques avancés","ar":"الأصدقاء الكاذبون والاقتباسات البنوية المتقدمة","objectives":["التمييز بين le faux-ami lexical وle calque de structure وكيفية اكتشاف كل منهما","تتبّع أصل la construction calquée في الجملة الفرنسية وإعادة بنائها بالقواعد الصحيحة","تفادي le calque syntaxique عند الترجمة من العربية: ترتيب الكلمات، حروف الجر، التحديد","توظيف la traduction littérale بشكل واعٍ متى كانت ضرورية ومتى كانت خطأ"],"sections":[{"h":"الدرس 2: كيف تُفسد الترجمة الحرفية بنية الجملة دون أن نشعر","video":{"id":"6h3K-kbTX3c","title":"Les Procédés de traduction : 2 - Le calque","channel":"كاوا محمد","why":"درس منهجي في le calque: كيف ينتقل بناء لغوي كامل من لغة إلى أخرى، ومتى يصبح le calque مقبولاً في الفرنسية ومتى يصبح anglicisme أو arabisme مُخلّاً بالأسلوب.","lang":"fr","main":true,"dur":9},"p":["le calque هو ترجمة بناء لغوي لا كلمة: ننقل تركيب اللغة الأصلية كما هو إلى اللغة المستهدفة. هو أخطر من faux-ami لأن الألفاظ كلها صحيحة في القاموس، والخطأ يكمن في البنية، وهو خطأ لا يكشفه المرشّح الإملائي بل يكشفه نظر المُحرِّر المتمرس.","يأخذ calques صورتين: calque lexical مثل « faire une conférence » بدل « donner une conférence »، وcalque de structure مثل « Je suis d’accord avec toi de partir » بدل « Je suis d’accord pour partir ». الصورة الثانية أصعب لأنها تبدو سليمة من النظرة الأولى.","faux-amis ليست أخطاء ترجمة بقدر ما هي فخاخ دلالية: « actuellement » تعني الآن لا في الواقع، و« librairie » ليست مكتبة قراءة، و« assister à » تعني حضر لا ساعد. الفخ يكمن في أول معنى يخطر بالبال.","تكتشف البنية الخاطئة بثلاثة أسئلة: ما حرف الجر الذي يحكم هذا الفعل في فرنسا؟ ما ترتيب الفاعل والمفعول به في الجملة العربية المقابلة؟ هل فعلتُ ترجمة الكلمة أم نقلتُ البنية؟ السؤال الثالث وحده يوقف نصف الأخطاء.","traduction littérale ليست عيباً في ذاتها: المستندات القانونية والعلمية تحبها لأنها تحافظ على الضبط. المشكلة تبدأ حين تُستعمل في le registre courant، حيث يبحث القارئ عن جملة طبيعية لا عن نسخة طبق الأصل من العربية.","التمرين اليومي: خذ جملة عربية، اكتب ترجمتها الحرفية إلى الفرنسية، ثم أعد كتابتها كأنك كتبتها من الصفر بلغتك الأم. الفرق بين النصّين هو خريطة أخطائك الشخصية."],"sub":[{"h":"ce qu’est un calque","p":["Un calque reproduit la structure d’une autre langue.","Les mots sont justes, mais l’ordre ne l’est pas.","Le lecteur sent que la phrase sonne étrange."]},{"h":"les faux-amis","p":["Actuellement signifie « maintenant » et non « actually ».","Une librairie vend des livres, elle n’en prête pas.","On assiste à une conférence, on n’assiste pas le conférencier."]},{"h":"la traduction littérale","p":["Le mot à mot est utile pour les textes juridiques.","Dans la conversation, il produit des phrases impossibles.","Il faut choisir selon le registre du texte."]}]},{"h":"les pièges du mot à mot","p":["« Ce n’est pas français. » — le jugement du lecteur face à un calque.","« On dirait une traduction. » — la phrase respecte la grammaire mais pas l’usage.","« Quelle préposition gouverne ce verbe ? » — la question qui sauve la phrase.","« Ici, la littérale fonctionne : le contrat est formel. »"]},{"h":"التطبيق والتلخيص","p":["تمرين le double écrivain: اكتب جملتك أولاً بالترجمة الحرفية، ثم أعد كتابتها بلا النظر إلى الأصل، وقارن النصين.","تمرين le dictionnaire: ابحث عن خمسة أفعال فرنسية وسجّل حرف الجر الذي يحكمها، ثم استعملها في جمل من إنشائك.","تمرين la détection: راجع نصاً كتبته سابقاً وابحث عن آثار le calque de structure خاصة في حروف الجر وترتيب الجملة."]}],"pron":[{"w":"le calque","ipa":"[lə kalk]","approx":"لُ كالك"},{"w":"le faux-ami","ipa":"[lə fo.z‿a.mi]","approx":"لُ فوزامي"},{"w":"la traduction littérale","ipa":"[la tʁa.dyksjɔ̃ li.te.ʁal]","approx":"لا ترادوكسيون ليتيرال"}],"vocab":[{"fr":"le calque","ar":"الاقتباس البنوي من لغة أخرى","pos":"nom","g":"m","exFr":"« Je suis en accord » est un calque.","ipa":"[kalk]","exAr":"عبارة «Je suis en accord» اقتباس بنوي."},{"fr":"le faux-ami","ar":"الكلمة المضلِّلة بين لغتين","pos":"nom","g":"m","exFr":"« Actuellement » est un faux-ami classique.","ipa":"[fo.z‿a.mi]","exAr":"كلمة actuellement صديق كاذب كلاسيكي."},{"fr":"la traduction littérale","ar":"الترجمة الحرفية","pos":"nom","g":"f","exFr":"La traduction littérale convient au contrat.","ipa":"[tʁa.dyksjɔ̃ li.te.ʁal]","exAr":"الترجمة الحرفية تناسب العقد."},{"fr":"l’anglicisme","ar":"التعبير المنقول من الإنجليزية","pos":"nom","g":"m","exFr":"« Have a nice day » est un anglicisme intraduisible.","ipa":"[ɑ̃.gli.sism]","exAr":"عبارة have a nice day تعبير مُقتبس لا يُترجم حرفياً."},{"fr":"l’emprunt","ar":"الاقتراض اللغوي","pos":"nom","g":"m","exFr":"Le mot « weekend » est un emprunt.","ipa":"[ɑ̃.pʁœ̃]","exAr":"كلمة week-end اقتراض لغوي."},{"fr":"le calque de structure","ar":"الاقتباس البنوي الصريح","pos":"nom","g":"m","exFr":"Le calque de structure passe inaperçu.","ipa":"[kalk də stʁyk.tyʁ]","exAr":"الاقتباس البنوي يمر دون انتباه."},{"fr":"l’équivalent","ar":"المكافئ اللغوي","pos":"nom","g":"m","exFr":"Cherchez l’équivalent, pas le mot.","ipa":"[e.ki.va.lɑ̃]","exAr":"ابحث عن المكافئ لا عن الكلمة."},{"fr":"l’acception","ar":"الدلالة الفرعية للكلمة","pos":"nom","g":"f","exFr":"Ce mot a plusieurs acceptions.","ipa":"[ak.sɛp.sjɔ̃]","exAr":"هذه الكلمة لها عدة دلالات."},{"fr":"la périphrase","ar":"العبارة الموصوفة بدل الكلمة المجردة","pos":"nom","g":"f","exFr":"La périphrase allonge la phrase.","ipa":"[pe.ʁi.fʁaz]","exAr":"العبارة الموصوفة تطيل الجملة."},{"fr":"l’emploi fautif","ar":"الاستعمال الخاطئ","pos":"nom","g":"m","exFr":"Cet emploi fautif trahit une traduction.","ipa":"[ɑ̃.plwa fo.tif]","exAr":"هذا الاستعمال الخاطئ يفضح الترجمة."},{"fr":"la correspondance trompeuse","ar":"التطابق المُضلِّل بين لغتين","pos":"nom","g":"f","exFr":"La correspondance entre les deux langues est trompeuse.","ipa":"[kɔ.ʁɛs.pɔ̃.dɑ̃s tʁɔ̃.pøz]","exAr":"التطابق بين اللغتين مُضلِّل."},{"fr":"le mot à mot","ar":"الترجمة كلمة بكلمة","pos":"loc.","g":"m","exFr":"Le mot à mot ruine le style.","ipa":"[lə mo a mo]","exAr":"الترجمة كلمة بكلمة تُفسد الأسلوب."}],"examples":[{"fr":"Il a assisté à la conférence.","ar":"حضر المؤتمر.","note":"assister à ≠ assister quelqu’un"},{"fr":"Son bureau est au rez-de-chaussée.","ar":"مكتبه في الطابق الأرضي.","note":"au et non dans"},{"fr":"Nous avons discuté du projet.","ar":"ناقشنا المشروع.","note":"discuter de + nom"},{"fr":"Je suis d’accord pour partir.","ar":"أوافق على الرحيل.","note":"d’accord pour + infinitif"},{"fr":"Actuellement, il travaille à Lyon.","ar":"حالياً يعمل في ليون.","note":"actuellement = maintenant"},{"fr":"Il faut que tu sois prêt.","ar":"يجب أن تكون جاهزاً.","note":"le subjonctif après il faut que"}],"grammar":[{"tFr":"Le régime des verbes : la préposition obligatoire","tAr":"حروف الجر المُلزمة بعد الأفعال","body":["Chaque verbe français réclame sa préposition : penser à, rêver de, rire de, participer à, assister à, discuter de. L’arabe utilise souvent une préposition unique (في / لـ) devant tout complément : le transfert produit alors « je participe dans le projet » au lieu de « je participe au projet ».","La bonne méthode : apprendre le verbe avec sa préposition comme un seul bloc, et le répéter à voix haute. C’est le seul moyen d’éviter que la langue maternelle ne dicte le choix de la préposition."],"ex":[{"fr":"Je participe au projet depuis mars.","ar":"أشارك في المشروع منذ مارس."},{"fr":"Elle rêve de voyager seule.","ar":"تحلم بالسفر وحدها."}]},{"tFr":"L’ordre des mots : COD antéposé et thématisation","tAr":"ترتيب الجملة: تقديم المفعول به وتمييز الموضوع","body":["Le français place normalement le COD après le verbe : « J’ai lu le rapport ». L’arabe admet « قرأتُ التقرير » mais aussi la topicalisation « التقرير، قرأتُه » ; le calque de cette topicalisation donne « Le rapport, je l’ai lu » en dehors de tout contexte, ce qui sonne lourd en français courant.","La thématisation reste possible, mais elle doit avoir une fonction : opposer, reprendre, corriger. Sans fonction, elle relève du calque et doit être supprimée lors de la révision."],"ex":[{"fr":"J’ai lu le rapport hier soir.","ar":"قرأتُ التقرير مساء أمس."},{"fr":"Le rapport, je l’ai relu deux fois avant de trancher.","ar":"أما التقرير فقد أعدت قراءته مرتين قبل أن أقرر."}]}],"mistakes":[{"wrong":"Il a assisté le conférencier.","right":"Il a assisté à la conférence.","why":"assister à = حضور، assister quelqu’un = مساعدته — faux-ami classique."},{"wrong":"Son bureau est dans le rez-de-chaussée.","right":"Son bureau est au rez-de-chaussée.","why":"on est AU rez-de-chaussée — la préposition se calque sur « au » et non sur « dans »."},{"wrong":"Nous avons discuté le problème.","right":"Nous avons discuté du problème.","why":"discuter exige « de » en français, contrairement à l’anglais discuss something — le régime du verbe."},{"wrong":"Il faut que tu as fini avant midi.","right":"Il faut que tu aies fini avant midi.","why":"il faut que commande le subjonctif — le calque de l’indicatif est le piège le plus fréquent."}],"dialogues":[{"title":"Relecture d’un texte traduit","ctx":"محرِّر ومحرِّرة يراجعان ترجمة مشتركة","lines":[{"who":"Camille","fr":"Cette phrase ressemble à une traduction.","ar":"هذه الجملة تشبه الترجمة الحرفية."},{"who":"Karim","fr":"Où est le calque, exactement ?","ar":"أين يكمن الاقتباس بالضبط؟"},{"who":"Camille","fr":"La préposition : on dit participer au projet.","ar":"حرف الجر: الصحيح هو participer au projet."},{"who":"Karim","fr":"Bien vu, je corrige la phrase entière.","ar":"ملاحظة دقيقة، سأصحح الجملة كلها."}]},{"title":"Quand l’anglicisme s’invite","ctx":"اجتماع فريق يعمل بالإنجليزية والفرنسية","lines":[{"who":"Thomas","fr":"On doit discuter le budget aujourd’hui.","ar":"يجب أن نناقش الميزانية اليوم."},{"who":"Sarah","fr":"Discuter du budget, s’il te plaît.","ar":"ناقش الميزانية، من فضلك."},{"who":"Thomas","fr":"Merci, j’ai pris l’habitude de l’anglais.","ar":"شكراً، لقد اعتدت على الإنجليزية."},{"who":"Sarah","fr":"Aucun problème, c’est justement le piège.","ar":"لا مشكلة، هذا بالضبط الفخ."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما المقصود بـ « le calque »؟","opts":["نقل بناء لغوي من لغة إلى أخرى","كلمة مستوردة من الإنجليزية","خطأ إملائي شائع","ترجمة المعنى المجرد"],"a":0,"why":"le calque reproduit la structure, pas seulement le mot."},{"t":"fill","skill":"grammar","q":"أكمل حرف الجر: «Nous avons discuté ___ le problème.»","fr":"Nous avons discuté ___ le problème.","ans":"du","why":"discuter de + nom : le verbe impose sa préposition."},{"t":"order","skill":"writing","q":"رتّب: يجب البحث عن مكافئ.","words":["Il","faut","chercher","un","équivalent."],"ans":"Il faut chercher un équivalent.","why":"ordre : sujet, verbe, COD (infinitif) puis complément."},{"t":"listen","skill":"listening","q":"ما الخطأ في « Il a assisté le conférencier »؟","opts":["assisté exige « à »","الفاعل مرفوع","الزمن خطأ","لا يوجد خطأ"],"a":0,"why":"assister à une conférence = حضرها؛ assister quelqu’un = ساعده (معنى آخر)."},{"t":"translate","skill":"writing","q":"ترجم: «حالياً أعمل على مشروع جديد.»","ans":"Actuellement, je travaille sur un nouveau projet.","why":"actuellement = maintenant؛ travailler sur un projet."},{"t":"speaking","skill":"speaking","q":"اشرح بلغة فرنسية الفرق بين le calque وle faux-ami مع مثال لكل واحد.","target":"calque / faux-ami / structure","why":"إنتاج لغوي يقارن بين مفهومين مترابطين."},{"t":"correct","skill":"grammar","q":"صحّح: «Je suis en accord avec toi de partir.»","ans":"Je suis d’accord avec toi pour partir.","why":"être d’accord avec quelqu’un pour faire quelque chose."},{"t":"mcq","skill":"reading","q":"أي جملة خالية من le calque؟","opts":["Il participe au projet.","Il participe dans le projet.","Il participe avec le projet.","Il participe pour le projet."],"a":0,"why":"participer à quelque chose : seule la préposition « à » est correcte."}],"homework":"راجع آخر نص كتبته بالفرنسية وابحث عن ثلاثة آثار لـ le calque أو le faux-ami، ثم أعد كتابة الجمل المتأثرة، واكتب بجانب كل واحدة قاعدة حرف الجر أو الترتيب التي انتقصتها.","sources":[{"title":"Les Procédés de traduction : 2 - Le calque","channel":"كاوا محمد","videoId":"6h3K-kbTX3c","why":"درس منهجي في le calque: كيف ينتقل بناء لغوي كامل من لغة إلى أخرى، ومتى يصبح le calque مقبولاً في الفرنسية ومتى يصبح anglicisme أو arabisme مُخلّاً بالأسلوب.","cat":"Interculturel","level":"C1","main":true},{"title":"30 FAUX AMIS ANGLAIS INCONTOURNABLES (+EXERCICE)","channel":"Apprendre l'anglais avec les Tutos de Huito","videoId":"e5aVB0YXOcs","why":"قائمة مركّزة مع تمارين: تدريب سريع على اكتشاف faux-amis قبل أن تتسرّب إلى النص الفرنسي.","cat":"Interculturel","level":"C1","extra":true},{"title":"Les Procédés de traduction : 3 - La traduction littérale","channel":"كاوا محمد","videoId":"y-pDozTGQkw","why":"الجزء التالي من السلسلة نفسها: متى تُقبل la traduction littérale ومتى تُرفض، بتمارين تطبيقية.","cat":"Interculturel","level":"C1","extra":true}],"supplements":[{"id":"e5aVB0YXOcs","title":"30 FAUX AMIS ANGLAIS INCONTOURNABLES (+EXERCICE)","channel":"Apprendre l'anglais avec les Tutos de Huito","why":"قائمة مركّزة مع تمارين: تدريب سريع على اكتشاف faux-amis قبل أن تتسرّب إلى النص الفرنسي.","lang":"fr","dur":14},{"id":"y-pDozTGQkw","title":"Les Procédés de traduction : 3 - La traduction littérale","channel":"كاوا محمد","why":"الجزء التالي من السلسلة نفسها: متى تُقبل la traduction littérale ومتى تُرفض، بتمارين تطبيقية.","lang":"fr","dur":8}]},{"id":"c1-t7-l3","fr":"Emprunts et hybrides lexicaux","ar":"الاقتراضات والكلمات المختلطة: حدود الفرنسية","objectives":["تمييز l’emprunt المقبول من le calque sémantique المُخلّ في الكتابة المهنية","تحليل le verlan وl’argot urbain كنظام لغوي له قواعده لا كخراب لغة","تسمية la frontière بين le registre soutenu et le registre familier في المواقف الرسمية","تكوين كلمات جديدة بالسوابق واللواحق بدل الاقتراض المباشر من الإنجليزية"],"sections":[{"h":"الدرس 3: أين تنتهي الفرنسية وتبدأ الكلمات المستوردة","video":{"id":"Ks9mseWiUnc","title":"Comment éviter les anglicismes ? - La Chronique linguiste de Laélia Veron","channel":"France Inter","why":"نقاش إذاعي مع خبيرة لغوية: لماذا تتسرّب الاقتراضات الإنجليزية إلى الفرنسية، وما البديل الفعلي لكل anglicism في le français courant.","lang":"fr","main":true,"dur":6},"p":["الفرنسية ليست لغة مغلقة: منذ ألف سنة وهي تستعير، من l’alcool العربي إلى le weekend الإنجليزي. الفرق أن الاقتراض القديم صار « فرنسياً » بحكم الاستعمال، بينما الاقتراض الجديد يبقى أجنبياً لعقود قبل أن يقرّه le dictionnaire.","le calque sémantique هو أخطر أنواع الاقتراض: نأخذ بنية إنجليزية ونملأها بالحروف الفرنسية، فنكتب « un leader » و« un feedback » و« un meeting ». المعنى ينفع، لكن la banque de mots الفرنسية تمتلك بدائل: un dirigeant, un retour, une réunion.","على الجهة الأخرى يقف le franco-arabe: حروف عربية داخل جملة فرنسية (« wesh, yallah, habibi ») تنتشر في les cités وتبقى مفهومة لجيل كامل. هذه ليست فرنسية سليمة ولا عربية سليمة، بل كيان لغوي جديد يسمّيه les sociologues le parler bilingue des quartiers.","le verlan يقلب الكلمات: femme ← meuf، fou ← ouf، arabe ← beur. القاعدة بسيطة ومنتظمة، وباتت بعض نواتجه يُستعملها حتى الناطقون بالأصل، ومنها دخلت كلمة beurette إلى الفرنسية العامية.","l’argot urbain خليط دائم: عربية + فرنسية + إشارة يدوية وكلمات قصيرة. خطؤه الحقيقي ليس في القاموس بل في le registre: استعماله في رسالة عمل يجعلها تبدو غير مهنية، بينما استعماله بين الأصدقاء طبيعي تماماً.","القاعدة الحدودية: اسأل عن le destinataire. إن كان النص لعميل أو لجنة، استعمل le registre neutre؛ إن كان لزميل تعرفه منذ سنوات، le registre familier مقبول. اللغة لا تُقيَّم في الفراغ، بل تُقيَّم في سياقها."],"sub":[{"h":"les mots qui entrent","p":["La langue française emprunte depuis toujours aux autres langues.","Un anglicisme se distingue par sa construction.","La banque de mots propose souvent un équivalent."]},{"h":"le verlan et l’argot","p":["Le verlan inverse les syllabes des mots.","On dit une meuf pour dire une femme.","Ces mots appartiennent à un registre très familier."]},{"h":"où s’arrête la frontière","p":["Le registre dépend toujours du destinataire.","Un mail de travail reste sur un niveau neutre.","Entre amis, la langue se relâche sans problème."]}]},{"h":"les frontières du registre","p":["« En français, on dirait plutôt… » — la correction élégante d’un anglicisme.","« C’est du verlan, ça ne se dit pas en réunion. » — le rappel du registre.","« Le mot est entré dans le dictionnaire. » — la légitimation d’un emprunt.","« Tu parles, toi, comme dans le quartier ? » — la question sur l’identité linguistique."]},{"h":"التطبيق والتلخيص","p":["تمرين la banque de mots: اكتب خمسة anglicismes تقرأها في رسائلك، ثم ابحث في le dictionnaire عن بديل فرنسي لكل واحد.","تمرين le classement: رتّب عشرين تعبيراً من le registre soutenu إلى le registre familier، ثم ضع كل واحد في موقف يناسبه.","تمرين le créateur: كوّن ثلاث كلمات جديدة من préfixes وsuffixes فرنسية لتعبر عن وظيفة حديثة بدل الاقتراض من الإنجليزية."]}],"pron":[{"w":"le verlan","ipa":"[lə vɛʁ.lɑ̃]","approx":"لُ فيرلان"},{"w":"l’argot","ipa":"[aʁ.go]","approx":"ارغو"},{"w":"l’anglicisme","ipa":"[ɑ̃.gli.sism]","approx":"انغليسيسم"}],"vocab":[{"fr":"le verlan","ar":"قلب ترتيب الحروف في العامية الفرنسية","pos":"nom","g":"m","exFr":"Le verlan transforme « femme » en « meuf ».","ipa":"[vɛʁ.lɑ̃]","exAr":"الفرلان يحوّل كلمة femme إلى meuf."},{"fr":"l’argot","ar":"العامية الفرنسية","pos":"nom","g":"m","exFr":"L’argot ne convient pas à la lettre officielle.","ipa":"[aʁ.go]","exAr":"العامية لا تناسب الرسالة الرسمية."},{"fr":"le franco-arabe","ar":"الاختلاط بين الفرنسية والعربية","pos":"nom","g":"m","exFr":"Le franco-arabe se parle dans les quartiers.","ipa":"[fʁɑ̃.ko a.ʁab]","exAr":"الاختلاط الفرنسي العربي يُتكلَّم في الأحياء."},{"fr":"l’hybride","ar":"الكلمة المختلطة بين لغتين","pos":"nom","g":"m","exFr":"Ce mot est un hybride d’anglais et de français.","ipa":"[i.bʁid]","exAr":"هذه الكلمة مختلطة من الإنجليزية والفرنسية."},{"fr":"le mot-valise","ar":"الكلمة المركّبة من كلمتين","pos":"nom","g":"m","exFr":"« Brunisseur » est un mot-valise.","ipa":"[lə mo.va.liz]","exAr":"كلمة brunisseur مثال على الكلمة المركّبة."},{"fr":"le registre familier","ar":"المستوى العامي المألوف","pos":"loc.","g":"m","exFr":"Ce terme relève du registre familier.","ipa":"[lə ʁə.ʒistʁ fa.lli.je]","exAr":"هذا المصطلح من المستوى العامي."},{"fr":"le faux-anglicisme","ar":"تعبير يُظن إنجليزياً وليس كذلك","pos":"nom","g":"m","exFr":"« Footing » est un faux-anglicisme français.","ipa":"[fo.zɑ̃.gli.sism]","exAr":"كلمة footing تعبير فرنسي يُظن إنجليزياً."},{"fr":"la formation de mots","ar":"تكوين الكلمات","pos":"nom","g":"f","exFr":"La formation de mots évite les emprunts.","ipa":"[fɔʁ.ma.sjɔ̃ də mo]","exAr":"تكوين الكلمات يغني عن الاقتراض."},{"fr":"le niveau de langue","ar":"درجة اللغة","pos":"nom","g":"m","exFr":"Adaptez le niveau de langue à votre lecteur.","ipa":"[lə nɪ.vo də lɑ̃ɡ]","exAr":"اضبط درجة اللغة بحسب قارئك."},{"fr":"l’évolution lexicale","ar":"التطور المعجمي","pos":"nom","g":"f","exFr":"L’évolution lexicale est naturelle.","ipa":"[e.vɔ.ly.sjɔ̃ lek.si.kal]","exAr":"التطور المعجمي أمر طبيعي."},{"fr":"le néologisme","ar":"الكلمة المستحدثة","pos":"nom","g":"m","exFr":"Ce néologisme n’a pas encore été validé.","ipa":"[ne.ɔ.lɔ.ʒism]","exAr":"هذه الكلمة المستحدثة لم تُعتمد بعد."},{"fr":"l’usage courant","ar":"الاستعمال الشائع","pos":"nom","g":"m","exFr":"Le mot est passé dans l’usage courant.","ipa":"[y.zaʒ ku.ʁɑ̃]","exAr":"دخلت الكلمة في الاستعمال الشائع."}],"examples":[{"fr":"On dit une réunion, pas un meeting.","ar":"نقول une réunion لا un meeting.","note":"l’anglicisme évité"},{"fr":"Le mot « abricot » vient de l’arabe.","ar":"كلمة abricot من العربية.","note":"un emprunt ancien"},{"fr":"Elle parle un français très soutenu.","ar":"تتكلم فرنسية رفيعة جداً.","note":"le registre soutenu"},{"fr":"Ce vocabulaire est réservé à l’argot.","ar":"هذا المعجم محجوز للعامية.","note":"la limite du registre"},{"fr":"Le verlan a produit de nouveaux mots.","ar":"أنتج الفرلان كلمات جديدة.","note":"la création populaire"},{"fr":"Il vaut mieux créer un mot que l’emprunter.","ar":"من الأفضل تكوين كلمة من اقتراضها.","note":"la politique lexicale"}],"grammar":[{"tFr":"La préfixation et la suffixation : créer des mots français","tAr":"السوادف واللواحق: تكوين الكلمات الفرنسية","body":["Le français dispose d’un système productif : préfixes (dé-, re-, sur-, anti-) et suffixes (-eur, -able, -isme, -ation). « Un leader » peut devenir « un dirigeant », « to schedule » devient « planifier » : la dérivation offre une issue sans emprunter le mot étranger.","Cette formation n’est pas arbitraire : elle suit le sens du radical et le registre visé. -age et -erie glissent vers le familier, -tion et -ité restent neutres. Choisir un suffixe, c’est déjà choisir un niveau de langue."],"ex":[{"fr":"Le planificateur remplace le scheduler.","ar":"كلمة planificateur تحل محل scheduler."},{"fr":"Cette solution est durable et recyclable.","ar":"هذا الحل مستدام وقابل لإعادة التدوير."}]},{"tFr":"La négation familière et les traits de l’argot urbain","tAr":"النفي العامي وسمات اللهجات الحضرية","body":["En registre familier, le « ne » disparaît : « J’ai pas le temps », « Il veut pas venir ». La règle négative reste pourtant complète à l’écrit : ne… jamais, ne… personne, ne… rien. La chute du « ne » est le marqueur le plus fiable du registre parlé.","L’argot ajoute des procédés : le verlan (louche → chelou), les mots arabes intégrés (yallah, wesh), les particules finales (quoi, hein). Aucun n’est « incorrect » en soi : leur faute est d’apparaître hors de leur contexte social."],"ex":[{"fr":"Je n’ai pas le temps. / J’ai pas le temps.","ar":"ليس لديّ وقت. (الأولى محايدة والثانية عامية)"},{"fr":"Il est chelou, ce type.","ar":"هذا الشخص مريب بطريقة مثيرة."}]}],"mistakes":[{"wrong":"un deadline","right":"une échéance","why":"l’anglicisme de calendrier se remplace par un mot français déjà existant — الإنجليزية تغني عنها الفرنسية."},{"wrong":"Le but de ce meeting est de…","right":"L’objectif de cette réunion est de…","why":"meeting = réunion ; « but » ici est un calque de purpose — قلب المعنى مكشوف."},{"wrong":"Wesh, je te rappelle après, quoi.","right":"Je vous rappellerai plus tard.","why":"le registre de la lettre professionnelle exige le vouvoiement et le niveau neutre — سياق العمل يرفض العامية."},{"wrong":"utiliser un emprunt récent sans le vérifier","right":"vérifier le mot dans un dictionnaire récent","why":"un mot peut être familier, récent ou inconnu du lecteur — الاختبار هو le destinataire لا النيّة."}],"dialogues":[{"title":"Le mot qui n’existe pas","ctx":"مكتب يبحث عن بدائل للكلمات الإنجليزية","lines":[{"who":"Léa","fr":"On peut envoyer un feedback au client ?","ar":"هل يمكننا إرسال feedback للعميل؟"},{"who":"Mehdi","fr":"Mieux vaut dire « un retour ».","ar":"الأفضل أن نقول un retour."},{"who":"Léa","fr":"D’accord, et pour le deadline ?","ar":"حسناً، وماذا عن deadline؟"},{"who":"Mehdi","fr":"L’échéance, tout simplement.","ar":"échéance، ببساطة."}]},{"title":"Deux voix dans la rue","ctx":"صديقان يتحدثان في شارع باريس","lines":[{"who":"Sami","fr":"Wesh, tu viens ou pas ?","ar":"وِش، هل أنت قادم أم لا؟"},{"who":"Yanis","fr":"J’ai pas encore le temps, quoi.","ar":"ليس لديّ وقت بعد."},{"who":"Sami","fr":"Tu parles comme dans le quartier.","ar":"تتكلم كما في الحي."},{"who":"Yanis","fr":"C’est ma façon de parler, rien de plus.","ar":"هذه طريقتي في الكلام، لا أكثر."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما بديل « un meeting » في الفرنسية القياسية؟","opts":["une réunion","un rendez-vous","un deadline","un feedback"],"a":0,"why":"réunion هو الاصطلاح المعتمد، وmeeting تعبير مُقتبس."},{"t":"fill","skill":"grammar","q":"أكمل بالصيغة المحايدة: «Je ___ pas le temps en réunion.»","fr":"Je ___ pas le temps en réunion.","ans":"n’ai","why":"à l’écrit, la négation garde le « ne » complet."},{"t":"order","skill":"writing","q":"رتّب: دخلت الكلمة في الاستعمال الشائع.","words":["Le","mot","est","passé","dans","l’usage."],"ans":"Le mot est passé dans l’usage.","why":"ordre : sujet, verbe, COD, complément introduit par « dans »."},{"t":"listen","skill":"listening","q":"ما معنى « meuf » في le verlan؟","opts":["une femme","un fou","une mère","une amie"],"a":0,"why":"verlan inverse « femme » → meuf."},{"t":"translate","skill":"writing","q":"ترجم: «هذا المصطلح مناسب للسجل الرسمي.»","ans":"Ce terme convient au registre officiel.","why":"convenir à + le registre : verbe à préposition imposée."},{"t":"speaking","skill":"speaking","q":"اشرح بلغة فرنسية الفرق بين l’emprunt المقبول وle calque sémantique.","target":"emprunt / calque / registre","why":"مقارنة مفاهيمية بمستوى C1."},{"t":"correct","skill":"grammar","q":"صحّح: «Il veut pas venir au meeting.»","ans":"Il ne veut pas venir à la réunion.","why":"la négation complète à l’écrit + le mot français « réunion »."},{"t":"mcq","skill":"reading","q":"أي عبارة تناسب رسالة عمل رسمية؟","opts":["Je vous prie de m’indiquer l’échéance.","Wesh, envoie le deadline.","Je te rappelle après, quoi.","Le feedback est top."],"a":0,"why":"le registre neutre + les mots français : la frontière du contexte professionnel."}],"homework":"اجمع خلال أسبوع خمسة anglicismes وردتك في رسائل أو إعلانات فرنسية، وسجّل لكل واحد بديلاً فرنسياً من مصدر رسمي، ثم اكتب فقرة من ست جمل تشرح الفرق بين le registre neutre وle registre familier بمثال من واقعك.","sources":[{"title":"Comment éviter les anglicismes ? - La Chronique linguiste de Laélia Veron","channel":"France Inter","videoId":"Ks9mseWiUnc","why":"نقاش إذاعي مع خبيرة لغوية: لماذا تتسرّب الاقتراضات الإنجليزية إلى الفرنسية، وما البديل الفعلي لكل anglicism في le français courant.","cat":"Interculturel","level":"C1","main":true},{"title":"Les anglicismes pullulent dans la langue française","channel":"ECRAN LIBRE .TV","videoId":"2RqaaPklgZg","why":"تقرير صحفي عن انتشار الاقتراضات الإنجليزية في الفرنسية: كيف يتحوّل anglicism إلى كلمة شائعة تستخدمها الصحافة الفرنسية.","cat":"Interculturel","level":"C1","extra":true},{"title":"Le français standard vs le français argotique : Des exemples pour explorer les nuances linguistiques","channel":"Frenchwithbiba","videoId":"mxgzUCFceFY","why":"مقارنة عملية بين الفرنسية القياسية والعامية: أمثلة صوتية على le registre وكيف يتغيّر المعنى بتغيّر المستوى.","cat":"Interculturel","level":"C1","extra":true}],"supplements":[{"id":"2RqaaPklgZg","title":"Les anglicismes pullulent dans la langue française","channel":"ECRAN LIBRE .TV","why":"تقرير صحفي عن انتشار الاقتراضات الإنجليزية في الفرنسية: كيف يتحوّل anglicism إلى كلمة شائعة تستخدمها الصحافة الفرنسية.","lang":"fr","dur":6},{"id":"mxgzUCFceFY","title":"Le français standard vs le français argotique : Des exemples pour explorer les nuances linguistiques","channel":"Frenchwithbiba","why":"مقارنة عملية بين الفرنسية القياسية والعامية: أمثلة صوتية على le registre وكيف يتغيّر المعنى بتغيّر المستوى.","lang":"fr","dur":10}]},{"id":"c1-t7-l4","fr":"Transcodage et adaptation culturelle","ar":"النقل المباشر والتكييف الثقافي: تغيير الثقافة دون تغيير المعنى","objectives":["التمييز بين le transcodage الحرفي وl’adaptation culturelle متى تختفي النيّة وتبقى النتيجة","تصنيف les procédés: transposition, compensation, amplification, atténuation, explicitation","تبرير اختيار procédé واحد على آخر بحسب la fonction du texte وبحسب le destinataire","ترجمة slogan أو نص قصير مع تغيير le référent الثقافي دون تغيير le message"],"sections":[{"h":"الدرس 4: كيف تُغيّر الثقافة وتُبقي المعنى كما هو","video":{"id":"7VCBd1s6GEE","title":"Initiation à la traduction S3: les procédés stylistiques de la traduction","channel":"Learn French","why":"درس جامعي في les procédés stylistiques: la transposition, l’adaptation, l’amplification — الخريطة الكاملة لما يمكن فعله بالجملة أثناء النقل بين ثقافتين.","lang":"fr","main":true,"dur":22},"p":["la traductologie تدرس كيف ينتقل النص بين لغتين ثم بين ثقافتين. الانتقال الأول (la langue) مشكلة رمزية، والثاني (la culture) مشكلة قيم وإشارات: ما يُفترض مفهوماً هنا قد يكون مجهولاً تماماً هناك.","le transcodage هو النقل المباشر: نمشي خلف جملة المصدر سطراً بسطر. مفيد في le texte technique والقانوني، وفيه تحفظ la forme. قواعده واضحة ونهايته المتوقعة: جملة صحيحة ربما ثقيلة.","l’adaptation تغيّر le référent لا le sens: نص عن la bise يصبح نصاً عن salut officiel، ووصفة عن le fromage تصبح وصفة عن طبق محلي. le message يبقى (التحية، الطبخ) وتنتقل la culture بدل أن تنهار.","بينهما هرم من les procédés: la transposition تغيّر التصنيف دون المضمون (اسم ← فعل)، وl’amplification تزيد ما بين السطور، وl’atténuation تُضعف الفكرة لتناسب le ton، وla compensation تعوّض خسارة هنا بما يكسبه هناك.","السؤال الحاكم واحد: ما la fonction du texte؟ النص الإعلاني يريد التأثير، والنص القانوني يريد الدقة، والنص الأدبي يريد le style. إن غيّرت la fonction، فستحتاج إلى إعادة كتابة لا إلى ترجمة.","لا تبدأ بالترجمة قبل أن تكتب في سطر واحد le but du texte: أن يُفهم؟ أن يُقنع؟ أن يُضحك؟ أن يُوثّق؟ الجواب يحدّد le procédé قبل أن تفتح le dictionnaire."],"sub":[{"h":"transcodage ou adaptation ?","p":["Le transcodage suit la structure du texte source.","L’adaptation change le référent et garde le message.","Le choix dépend de la fonction du texte."]},{"h":"les procédés intermédiaires","p":["La transposition change la catégorie grammaticale.","L’amplification développe ce qui reste sous-entendu.","La compensation rend ici ce que l’on perd ailleurs."]},{"h":"garder le sens, changer la forme","p":["Un slogan ne se traduit pas, il se rejoue.","Le lecteur doit retrouver le même effet.","La culture change, l’intention demeure."]}]},{"h":"justifier son choix de procédé","p":["« J’ai opté pour la compensation car… » — le commentaire du traducteur.","« Le référent culturel ne passe pas, je le remplace. »","« Ici, la littérale suffit : le texte est formel. »","« J’ai légèrement amplifié pour respecter le ton. »"]},{"h":"التطبيق والتلخيص","p":["تمرين la grille: خذ نصاً قصيراً وحدّد لكل جملة le procédé المستعمل: transcodage, transposition, adaptation.","تمرين le slogan: أعد كتابة slogan فرنسي لسوق عربي مع الحفاظ على le message وla fonction.","تمرين la justification: اكتب فقرة من أربع جمل تبرّر فيها اختيارك لثلاثة procédés مختلفة في ترجمة واحدة."]}],"pron":[{"w":"le transcodage","ipa":"[lə tʁɑ̃s.kɔ.daʒ]","approx":"تراكوداج"},{"w":"l’adaptation","ipa":"[a.dap.ta.sjɔ̃]","approx":"أدافتاسيون"},{"w":"la compensation","ipa":"[la kɔ̃.pɑ̃.sa.sjɔ̃]","approx":"لا كومبانساسيون"}],"vocab":[{"fr":"le transcodage","ar":"النقل المباشر من لغة إلى أخرى","pos":"nom","g":"m","exFr":"Le transcodage convient aux textes juridiques.","ipa":"[tʁɑ̃s.kɔ.daʒ]","exAr":"النقل المباشر يناسب النصوص القانونية."},{"fr":"l’adaptation culturelle","ar":"التكييف الثقافي","pos":"nom","g":"f","exFr":"L’adaptation culturelle change le référent.","ipa":"[a.dap.ta.sjɔ̃ kyl.ty.ʁɛl]","exAr":"التكييف الثقافي يغيّر المرجع لا المعنى."},{"fr":"la transposition","ar":"التحويل بين تصنيفات الكلام","pos":"nom","g":"f","exFr":"La transposition transforme un nom en verbe.","ipa":"[tʁɑ̃s.pɔ.zi.sjɔ̃]","exAr":"التحويل ينقل الاسم إلى فعل."},{"fr":"la compensation","ar":"التعويض عن خسارة في مكان آخر","pos":"nom","g":"f","exFr":"La compensation sauve l’effet du texte.","ipa":"[kɔ̃.pɑ̃.sa.sjɔ̃]","exAr":"التعويض ينقذ أثر النص."},{"fr":"l’amplification","ar":"التوسّع في المعنى المضمَر","pos":"nom","g":"f","exFr":"L’amplification explicite l’implicite.","ipa":"[ɑ̃.pli.fi.kɑ̃.sjɔ̃]","exAr":"التوسّع يُبدي ما تضمَّنه النص."},{"fr":"l’atténuation","ar":"التخفيف في حدّة المعنى","pos":"nom","g":"f","exFr":"L’atténuation évite de heurter le lecteur.","ipa":"[a.te.nɥa.sjɔ̃]","exAr":"التخفيف يمنع إزعاج القارئ."},{"fr":"l’explicitation","ar":"التوضيح الصريح لما هو ضمني","pos":"nom","g":"f","exFr":"L’explicitation alourdit parfois la phrase.","ipa":"[ɛks.pli.si.ta.sjɔ̃]","exAr":"التوضيح الصريح يثقل الجملة أحياناً."},{"fr":"la paraphrase","ar":"الصياغة البديلة","pos":"nom","g":"f","exFr":"La paraphrase remplace ce qui est intraduisible.","ipa":"[pa.ʁa.fʁaz]","exAr":"الصياغة البديلة تحل محل ما لا يُترجم."},{"fr":"l’équivalence dynamique","ar":"التطابق الديناميكي مع القارئ","pos":"nom","g":"f","exFr":"L’équivalence dynamique vise l’effet sur le lecteur.","ipa":"[e.ki.va.lɑ̃s di.na.mik]","exAr":"التطابق الديناميكي يستهدف أثر النص في القارئ."},{"fr":"la fidélité au texte","ar":"الولاء لنص المصدر","pos":"nom","g":"f","exFr":"La fidélité au texte limite l’adaptation.","ipa":"[fi.de.li.te o tɛkst]","exAr":"الولاء للنص يحدّ من التكييف."},{"fr":"l’écart","ar":"المسافة بين الأصل والنقل","pos":"nom","g":"m","exFr":"L’écart entre les deux phrases reste faible.","ipa":"[e.kɑʁ]","exAr":"المسافة بين الجملتين تبقى صغيرة."},{"fr":"l’objectif communicatif","ar":"الغاية التواصلية من النص","pos":"nom","g":"m","exFr":"L’objectif communicatif guide le procédé choisi.","ipa":"[ɔb.ʒe.tif kɔ.my.ni.catif]","exAr":"الغاية التواصلية توجّه الاختيار."}],"examples":[{"fr":"Il a opté pour la compensation.","ar":"اختار التعويض.","note":"le choix de procédé"},{"fr":"Le référent change, le message reste.","ar":"المرجع يتغير والرسالة تبقى.","note":"le principe de l’adaptation"},{"fr":"La phrase a été légèrement amplifiée.","ar":"وُسّعت الجملة قليلاً لتبدي ما تضمّنَته.","note":"l’amplification"},{"fr":"Le traducteur a atténué la critique.","ar":"خفّف المترجم حدّة الانتقاد.","note":"l’atténuation"},{"fr":"Ici, le transcodage suffit.","ar":"يكفي هنا النقل المباشر.","note":"la limite du procédé"},{"fr":"La culture change, l’intention demeure.","ar":"تتغير الثقافة وتبقى النيّة.","note":"la règle d’or"}],"grammar":[{"tFr":"La voix et le sujet : changer la perspective sans changer le fait","tAr":"المبني للمجهول ومسند المبتدأ: تغيير المنظور دون تغيير الوقائع","body":["Le français préfère le sujet actif concret ; l’arabe recourt volontiers à la voix passive et au sujet impersonnel : « Il a été décidé que… » ↔ « قد تُقرر أن… ». En traduisant, on choisit qui « voit » l’action : le texte reste le même, le point de vue bascule.","Le choix a une valeur rhétorique : le passif efface l’acteur (utile quand on ignore qui a agi), l’actif l’assume (utile quand on veut rendre des comptes). Changer la voix, c’est donc changer la responsabilité affichée du texte."],"ex":[{"fr":"La décision a été prise hier soir.","ar":"اتُّخذ القرار مساء أمس."},{"fr":"Le comité a pris la décision hier soir.","ar":"اتخذ المكتب القرار مساء أمس."}]},{"tFr":"Le discours indirect et la concordance des temps","tAr":"الكلام المنقول وتطابق الأزمنة","body":["Adapter un propos rapporté exige de respecter la concordance : « Il a dit qu’il viendrait » (conditionnel après un récit au passé), et non « qu’il vient » quand on rapporte une promesse. L’arabe, lui, garde souvent l’indicatif, ce qui pousse au calque.","Le temps du discours indirect porte aussi le point de vue : le conditionnel français marque la distance, l’indicatif marque l’affirmation. Traduire un propos, c’est décider s’il est présenté comme un fait ou comme une parole rapportée."],"ex":[{"fr":"Elle a promis qu’elle nous appellerait.","ar":"وعدت أنها ستتصل بنا."},{"fr":"Il a affirmé que le rapport était prêt.","ar":"أكّد أن التقرير جاهز."}]}],"mistakes":[{"wrong":"changer le sens pour respecter la culture","right":"changer la forme pour sauver le sens","why":"l’adaptation porte sur le référent, jamais sur le message — التكييف يمسك المرجع لا المعنى."},{"wrong":"garder une métaphore incompréhensible","right":"remplacer l’image ou l’expliciter","why":"une image étrangère produit un silence chez le lecteur — الصورة الغريبة تصنع صمتاً عند القارئ."},{"wrong":"appliquer un procédé unique à tout le texte","right":"choisir le procédé en fonction de chaque segment","why":"un texte mêle narration, argument et description — النص يجمع أنواعاً مختلفة فيحتاج قرارات مختلفة."},{"wrong":"ajouter une note du traducteur partout","right":"réserver la note aux cas intraduisibles","why":"trop de notes interrompent la lecture et trahissent un déséquilibre — الحواشي الكثيرة تقطع القراءة."}],"dialogues":[{"title":"Choisir un procédé","ctx":"ورشة ترجمة بين مشرف وترجمان","lines":[{"who":"Paul","fr":"Pourquoi as-tu gardé la métaphore française ?","ar":"لماذا أبقيتَ الاستعارة الفرنسية؟"},{"who":"Nadia","fr":"Je pouvais la compenser ailleurs.","ar":"كان بإمكاني تعويضها في موضع آخر."},{"who":"Paul","fr":"Alors explique ton choix en note.","ar":"إذن واشرح اختيارك في حاشية."},{"who":"Nadia","fr":"D’accord, mais une seule note.","ar":"حسناً، لكن حاشية واحدة فقط."}]},{"title":"Adapter un slogan","ctx":"فريق تسويق يهيّئ حملة لسوق جديد","lines":[{"who":"Claire","fr":"Le slogan initial évoque Noël.","ar":"الشعار الأصلي يستحضر عيد الميلاد."},{"who":"Youssef","fr":"Ce référent ne parle pas à notre public.","ar":"هذا المرجع لا يخاطب جمهورنا."},{"who":"Claire","fr":"On garde l’intention, on change l’image.","ar":"نحتفظ بالنيّة ونغيّر الصورة."},{"who":"Youssef","fr":"Voilà l’adaptation culturelle.","ar":"هذا هو التكييف الثقافي."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما المقصود بـ « le transcodage »؟","opts":["النقل المباشر حرفياً من لغة إلى أخرى","تغيير المرجع الثقافي","إضافة حاشية","اختزال الجملة"],"a":0,"why":"transcodage = suivi de la structure source, procédé le plus littéral."},{"t":"fill","skill":"grammar","q":"أكمل: «La décision ___ prise hier soir.»","fr":"La décision ___ prise hier soir.","ans":"a été","why":"la voix passive : auxiliaire être + participe passé."},{"t":"order","skill":"writing","q":"رتّب: المرجع يتغير والرسالة تبقى","words":["Le","référent","change,","le","message","reste."],"ans":"Le référent change, le message reste.","why":"deux propositions juxtaposées, la virgule reste en fin de premier groupe."},{"t":"listen","skill":"listening","q":"متى يكون le transcodage هو الخيار الصحيح؟","opts":["في النصوص القانونية والفنية","في النكتة","في الشعارات","في الرسائل اليومية"],"a":0,"why":"le texte formel cherche la précision, pas l’effet."},{"t":"translate","skill":"writing","q":"ترجم: «تُغيّر الثقافة وتبقى النيّة كما هي.»","ans":"La culture change, l’intention demeure.","why":"deux propositions coordonnées + le présent de vérité."},{"t":"speaking","skill":"speaking","q":"برّر اختيارك بين le transcodage وl’adaptation لنص إعلاني.","target":"fonction / référent / effet","why":"حجّة ترجمية متخصصة بثلاثة مصطلحات."},{"t":"correct","skill":"grammar","q":"صحّح: «Il a dit que il viendra demain.»","ans":"Il a dit qu’il viendrait demain.","why":"élision de « il » + concordance : conditionnel après un récit au passé."},{"t":"mcq","skill":"reading","q":"أي جملة تصف l’adaptation culturelle بدقة؟","opts":["Elle change le référent et garde le message.","Elle supprime l’implicite.","Elle suit la syntaxe source.","Elle ajoute une note à chaque phrase."],"a":0,"why":"l’adaptation porte sur la culture représentée, pas sur le sens transmis."}],"homework":"ترجم slogan فرنسي أو عربي إلى اللغة الأخرى مع إعادة بنائه لجمهور آخر: اكتب الأصل، ثم النقل الحرفي، ثم النسخة المكيَّفة، ثم فقرة من أربع جمل تبرّر فيها كل قرار اتخذته.","sources":[{"title":"Initiation à la traduction S3: les procédés stylistiques de la traduction","channel":"Learn French","videoId":"7VCBd1s6GEE","why":"درس جامعي في les procédés stylistiques: la transposition, l’adaptation, l’amplification — الخريطة الكاملة لما يمكن فعله بالجملة أثناء النقل بين ثقافتين.","cat":"Interculturel","level":"C1","main":true},{"title":"Les Procédés de traduction : 4 - LA TRANSPOSITION ou RECATÉGORISATION","channel":"كاوا محمد","videoId":"caQVhDkwbEk","why":"شرح مركز la transposition: كيف يغيّر المترجم تصنيف الكلمة دون أن يتغير معناها، مع أمثلة على la récategorisation.","cat":"Interculturel","level":"C1","extra":true},{"title":"Traduction VS. Adaptation (VOST)","channel":"TBK","videoId":"vEQYQFu0JP8","why":"مقارنة سريعة بين الترجمة والأداء في الترجمة السمعية: أين ينتهي le calque ومتى يبدأ l’adaptation الثقافية.","cat":"Interculturel","level":"C1","extra":true}],"supplements":[{"id":"caQVhDkwbEk","title":"Les Procédés de traduction : 4 - LA TRANSPOSITION ou RECATÉGORISATION","channel":"كاوا محمد","why":"شرح مركز la transposition: كيف يغيّر المترجم تصنيف الكلمة دون أن يتغير معناها، مع أمثلة على la récategorisation.","lang":"fr","dur":10},{"id":"vEQYQFu0JP8","title":"Traduction VS. Adaptation (VOST)","channel":"TBK","why":"مقارنة سريعة بين الترجمة والأداء في الترجمة السمعية: أين ينتهي le calque ومتى يبدأ l’adaptation الثقافية.","lang":"fr","dur":5}]},{"id":"c1-t7-l5","fr":"La négociation interculturelle","ar":"التفاوض بين الثقافات: سوء الفهم واللباقة المختلفة","objectives":["تشخيص malentendu ناتجاً عن la politesse: le tutoiement, le vouvoiement, le ton direct","استعمال le conditionnel والصياغات غير المباشرة لطرح المطالب دون إهانة الطرف الآخر","بناء خطة négociation في ثلاث مراحل: établir la relation, examiner, conclure","التعامل مع le silence et le refus indirect كرسائل تفاوضية لا كعجز عن الرد"],"sections":[{"h":"الدرس 5: كيف تتفاوض بلغة أجنبية دون أن تخسر سوء الفهم","video":{"id":"dw44Lj9-VOg","title":"L’interculturel et la négociation","channel":"CCI Auvergne-Rhône-Alpes","why":"تكوين مهني من غرفة التجارة: كيف تُقرأ les codes culturels أثناء le rendez-vous d’affaires، وكيف تُدار la politesse différenciée بين فرنسيين وشركاء من ثقافات أخرى.","lang":"fr","main":true,"dur":11},"p":["la négociation تبدأ قبل كلمة واحدة: تُقرأ في la poignée de main، وفي la place assise، وفي السؤال الأول. الطرف الفرنسي قد يبدأ بالعمل مباشرة، والطرف الآخر قد يتوقع la petite conversation أولاً؛ حين تتعارض التوقعات يظهر le malentendu قبل أن يبدأ الخلاف.","la politesse différentielle مسألة تشكيل لا مسألة نية: « Tu veux signer ? » صديق، و« Souhaitez-vous signer ? » شريك. استعمال tu في أول لقاء قد يبدو دفئاً ل francophone وقد يبدو مهيناً لثقافة تضع la hiérarchie في الصدارة.","الرفض طبقة ثانية من سوء الفهم: الصراحة الفرنسية تقول « Non, c’est impossible » والمقابل قد يفهمها إهانة بدل رأي تقني. المطلوب هو la reformulation: « Ce serait difficile dans ces conditions, voyons ce qui serait possible. »","le silence الثالث: في بعض الثقافات le silence يعني التفكير ولا يعني الرفض، بينما يملأه francophone بجُمل إضافية فيفقد نصّه التوازن. الأفضل: عُدّ le silence جزءاً من الخطاب وعدّله.","خطة l’approche en trois temps: أولاً la relation — le café, le temps accordé، ثم l’examen — الأرقام والبدائل، ثم la conclusion — ما يُكتب وما يبقى معلّقاً. المفاوضة المختصرة تفشل غالباً لأنها حذفت الطور الأول.","قاعدة le contexte: حضِّر ثلاثة أسئلة قبل اللقاء: كيف يُبدؤون النقاش؟ كيف يُعبّرون عن الرفض؟ كيف يُختتم الاتفاق؟ الإجابة مسبقاً عن هذه الثلاثة تختصر أسبوعاً من la relance."],"sub":[{"h":"le premier rendez-vous","p":["On commence souvent par le relationnel avant l’affaire.","Le vouvoiement s’impose lors de la première rencontre.","Le ton direct peut être perçu comme de la brusquerie."]},{"h":"les malentendus","p":["Un silence ne signifie pas toujours un refus.","Le non français reste poli, mais il reste ferme.","La hiérarchie se lit dans le choix des interlocuteurs."]},{"h":"stratégies et compromis","p":["Il vaut mieux reformuler que de couper la discussion.","Le conditionnel adoucit la demande sans l’affaiblir.","On conclut en distinguant ce qui est acquis et ce qui reste ouvert."]}]},{"h":"les formules de la négociation","p":["« Pourriez-vous nous indiquer votre marge ? » — la demande indirecte.","« Ce serait difficile dans ces conditions. » — le refus reformulé.","« Si nous ajournions ce point ? » — la suspension utile.","« Pour résumer, nous convenons de trois points. » — la conclusion orale."]},{"h":"التطبيق والتلخيص","p":["تمرين le rôle: لعب موقف بيع بين طرف فرنسي وطرف من ثقافة أخرى، مع تسجيل le vouvoiement et le conditionnel في كل جملة.","تمرين la reformulation: حوّل أربع عبارات صريحة (« Non », « C’est faux ») إلى صيغ محترمة تحفظ الرأي.","تمرين le débriefing: اكتب ملخصاً من خمس جمل لاجتماع وقعت فيه malentendu، وحدّد فيه le moment الدقيق للفشل."]}],"pron":[{"w":"la négociation","ipa":"[la ne.ɡo.sja.sjɔ̃]","approx":"لا نيجوسياسيون"},{"w":"le malentendu","ipa":"[lə ma.lɑ̃.tɑ̃.dy]","approx":"لُ مالونتانديو"},{"w":"le compromis","ipa":"[lə kɔ̃.pʁɔ.mi]","approx":"لُ كومبرومي"}],"vocab":[{"fr":"la négociation","ar":"التفاوض","pos":"nom","g":"f","exFr":"La négociation a duré trois heures.","ipa":"[ne.ɡo.sja.sjɔ̃]","exAr":"استمر التفاوض ثلاث ساعات."},{"fr":"le malentendu","ar":"سوء الفهم","pos":"nom","g":"m","exFr":"Un malentendu est né au premier échange.","ipa":"[ma.lɑ̃.tɑ̃.dy]","exAr":"نشأ سوء فهم عند أول تبادل."},{"fr":"le tutoiement","ar":"مخاطبة الألفة (tu)","pos":"nom","g":"m","exFr":"Le tutoiement vient après plusieurs rencontres.","ipa":"[ty.twa.mɑ̃]","exAr":"مخاطبة الألفة تأتي بعد عدة لقاءات."},{"fr":"le vouvoiement","ar":"مخاطبة الرسمية (vous)","pos":"nom","g":"m","exFr":"Gardez le vouvoiement avec le client.","ipa":"[vu.vwa.mɑ̃]","exAr":"حافظ على المخاطبة الرسمية مع العميل."},{"fr":"l’implicite","ar":"المضمَّن غير المنطوق","pos":"nom","g":"m","exFr":"Beaucoup se joue dans l’implicite.","ipa":"[ɛ̃.pli.sit]","exAr":"كثير مما يُفرَض ضمناً دون تصريح."},{"fr":"le compromis","ar":"التسوية المتبادلة","pos":"nom","g":"m","exFr":"Les deux parties ont accepté un compromis.","ipa":"[kɔ̃.pʁɔ.mi]","exAr":"قبل الطرفان تسوية متبادلة."},{"fr":"la hiérarchie","ar":"السلطة والتدرّج الوظيفي","pos":"nom","g":"f","exFr":"La hiérarchie détermine qui parle.","ipa":"[ja.ʁaʁ.ʃi]","exAr":"السلطة تحدد من يتكلم."},{"fr":"le consensus","ar":"الإجماع","pos":"nom","g":"m","exFr":"Ils cherchent un consensus.","ipa":"[kɔ̃.sɛn.sy]","exAr":"يبحثان عن الإجماع."},{"fr":"la réserve","ar":"التحفظ المهذّب","pos":"nom","g":"f","exFr":"Il a exprimé une réserve polie.","ipa":"[ʁɛ.zɛʁv]","exAr":"عبّر عن تحفظ مهذّب."},{"fr":"l’approche directe","ar":"الأسلوب المباشر في الطرح","pos":"nom","g":"f","exFr":"Son approche directe a surpris ses partenaires.","ipa":"[a.pʁɔʃ di.ʁɛkt]","exAr":"أسلوبه المباشر فاجأ شركاءه."},{"fr":"le protocole","ar":"آداب اللقاء الرسمية","pos":"nom","g":"m","exFr":"Le protocole impose de s’asseoir selon le rang.","ipa":"[pʁɔ.tɔ.kɔl]","exAr":"آداب اللقاء تفرض الجلوس حسب الرتبة."},{"fr":"la marge de manœuvre","ar":"هامش الحركة في التفاوض","pos":"nom","g":"f","exFr":"Nous avons encore une marge de manœuvre.","ipa":"[la maʁʒ də ma.nœvʁ]","exAr":"ما زال لدينا هامش حركة."}],"examples":[{"fr":"Pourriez-vous nous indiquer votre délai ?","ar":"هل يمكنكم إعلامنا بمُهلتكم؟","note":"la demande avec le conditionnel"},{"fr":"Ce serait difficile dans ces conditions.","ar":"سيصعب ذلك في هذه الظروف.","note":"le refus reformulé"},{"fr":"Permettez-moi de rappeler notre offre.","ar":"اسمحوا لي بتذكيركم بعرضنا.","note":"la reprise du fil"},{"fr":"Nous convenons de trois points.","ar":"اتفقنا على ثلاث نقاط.","note":"la conclusion"},{"fr":"Je vous prie de m’excuser de cette insistance.","ar":"أرجو المعذرة على هذه الإلحاح.","note":"l’excuse mesurée"},{"fr":"Laissons ce point ouvert pour la prochaine séance.","ar":"لنُبقي هذه النقطة مفتوحة للجلسة القادمة.","note":"la suspension"}],"grammar":[{"tFr":"Le conditionnel de politesse et les demandes indirectes","tAr":"الشرطية في اللباقة والطلبات غير المباشرة","body":["Le conditionnel présente la demande comme une hypothèse : « Je voudrais… », « Pourriez-vous… », « Il serait possible de… ». La demande reste ferme, mais elle laisse au destinataire la place de répondre sans perdre la face.","Le glissement de présent à conditionnel change la relation : « Je veux » affirme un droit, « Je voudrais » expose un souhait. Dans une négociation interculturelle, cette nuance décide souvent de la suite des échanges."],"ex":[{"fr":"Pourriez-vous prolonger le délai d’une semaine ?","ar":"هل يمكنكم تمديد المُهلة أسبوعاً؟"},{"fr":"Nous aimerions revoir ce point ensemble.","ar":"نودّ مراجعة هذه النقطة معاً."}]},{"tFr":"Le subjonctif dans la demande et la concession","tAr":"المضارع المنصب (الحال) في الطلب والاعتراف المُخفَّف","body":["Après « il faut que », « je veux que », « bien que », le français exige le subjonctif : « Il faut que nous hésitions » exprime la prudence, « Bien que les délais soient courts » concède avant de conclure. Le mode signale que l’on parle d’une position, pas d’un fait.","En négociation, la concession introduite par « bien que » ou « certes… mais » affaiblit l’adversaire tout en gardant la courtoisie : on reconnaît la force de son argument avant de le contourner."],"ex":[{"fr":"Il faut que nous réfléchissions avant de répondre.","ar":"يجب أن نفكر قبل أن نجيب."},{"fr":"Bien que le prix soit élevé, la qualité reste supérieure.","ar":"رغم ارتفاع السعر، تبقى الجودة أفضل."}]}],"mistakes":[{"wrong":"Tu veux signer aujourd’hui ?","right":"Souhaitez-vous signer aujourd’hui ?","why":"au premier rendez-vous, le vouvoiement s’impose — في أول لقاء تفرض المخاطبة الرسمية."},{"wrong":"Non, c’est impossible.","right":"Ce serait difficile, voyons ce qui est possible.","why":"le non frontal coupe la négociation — الرفض المباشر يقطع الحوار."},{"wrong":"Comme vous le savez, notre offre est la meilleure.","right":"Permettez-moi de rappeler brièvement notre offre.","why":"le présupposé « comme vous savez » peut paraître condescendant — التصريح بما لا يعرفه الطرف الآخر يُسيء إليه."},{"wrong":"interpréter le silence comme un refus","right":"traiter le silence comme un temps de réflexion","why":"le silence a des valeurs différentes selon les cultures — الصمت قيم متباينة بحسب الثقافة."}],"dialogues":[{"title":"Premier rendez-vous commercial","ctx":"لقاء أول بين شركة فرنسية وشريك أجنبي","lines":[{"who":"Antoine","fr":"Bonjour, merci d’être venus. Asseyez-vous.","ar":"مرحباً، شكراً لحضوركم. تفضلوا بالجلوس."},{"who":"Rania","fr":"Merci. Pour commencer, pourriez-vous nous présenter votre délai ?","ar":"شكراً. للبداية، هل يمكنكم إخبارنا بمُهلتكم؟"},{"who":"Antoine","fr":"Le délai est de six semaines, sous réserve du volume.","ar":"المُهلة ست أسابيع، مشروطةً بالحجم."},{"who":"Rania","fr":"Nous reviendrons vers vous avec nos réserves.","ar":"سنعود إليكم بتحفظاتنا."}]},{"title":"Un silence mal compris","ctx":"مترجمتان تشرحان فشل اجتماع سابق","lines":[{"who":"Claire","fr":"Après ma proposition, ils ont gardé le silence.","ar":"بعد عرضي، صمتوا."},{"who":"Mona","fr":"Chez eux, le silence signifie la réflexion.","ar":"عندهم يعني الصمت التفكير."},{"who":"Claire","fr":"J’ai cru à un refus et j’ai relancé trop vite.","ar":"ظننتُ رفضاً وأعدت الطرح بسرعة."},{"who":"Mona","fr":"La prochaine fois, comptez trois secondes.","ar":"في المرة القادمة اعدّ ثلاث ثوانٍ."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما المقصود بـ « le malentendu » في هذا السياق؟","opts":["سوء فهم ناتج عن فرق ثقافي","خلاف تجاري حاد","خطأ في الترجمة الحرفية","تأخير في الجدول"],"a":0,"why":"le malentendu précède le conflit : il vient de codes différents."},{"t":"fill","skill":"grammar","q":"أكمل بصيغة اللباقة: «___-vous nous indiquer votre délai ?»","fr":"___-vous nous indiquer votre délai ?","ans":"Pourriez","why":"le conditionnel de politesse : Pourriez-vous + infinitif."},{"t":"order","skill":"writing","q":"رتّب: يصعب ذلك في هذه الظروف","words":["Ce","serait","difficile","dans","ces","conditions."],"ans":"Ce serait difficile dans ces conditions.","why":"sujet + conditionnel + complément de manière + lieu."},{"t":"listen","skill":"listening","q":"ماذا يقصد المفاوض بـ « le silence » هنا؟","opts":["وقت للتفكير","رفض صريح","انزعاج من السعر","انتهاء الاجتماع"],"a":0,"why":"le silence vaut réflexion dans plusieurs cultures, pas refus automatique."},{"t":"translate","skill":"writing","q":"ترجم: «هل يمكنكم تمديد المُهلة أسبوعاً؟»","ans":"Pourriez-vous prolonger le délai d’une semaine ?","why":"la demande indirecte avec le conditionnel + prolonger un délai."},{"t":"speaking","skill":"speaking","q":"قدّم اعتراضاً مهذّباً على سعر عرض فرنسي في ثلاث جمل.","target":"bien que / réserve / proposition","why":"la concession en trois temps : reconnaître, nuancer, proposer."},{"t":"correct","skill":"grammar","q":"صحّح: «Je veux que tu m’envoies le contrat.» في سياق عمل رسمي","ans":"Je souhaiterais que vous m’envoyiez le contrat.","why":"le conditionnel + le vouvoiement + le subjonctif après « souhaiter que »."},{"t":"mcq","skill":"reading","q":"أي عبارة تفتح l’examen بعد le relationnel؟","opts":["Pourrais-tu nous présenter vos conditions ?","On est copains, arrange-toi.","C’est non.","Tu signes ou pas ?"],"a":0,"why":"la demande structurée marque le passage à la phase d’examen."}],"homework":"حضِّر مذكرة تفاوض من صفحة واحدة لاجتماع حقيقي أو مُتخيَّل: اكتب le protocole (من يبدأ، من يتكلم)، وثلاث جمل بصيغة conditionnel، وجملتين لرفض محتمل بصيغة reformulation، وقائمة بـ la marge de manœuvre المسموح التنازل عنها.","sources":[{"title":"L’interculturel et la négociation","channel":"CCI Auvergne-Rhône-Alpes","videoId":"dw44Lj9-VOg","why":"تكوين مهني من غرفة التجارة: كيف تُقرأ les codes culturels أثناء le rendez-vous d’affaires، وكيف تُدار la politesse différenciée بين فرنسيين وشركاء من ثقافات أخرى.","cat":"Interculturel","level":"C1","main":true},{"title":"Négociation interculturelle : comment la méthode 2024 change la donne","channel":"Maître Lacour","videoId":"12f1c8dNYx4","why":"مقاربة حديثة للتفاوض بين الثقافات: كيف تُعاد قراءة les rapports de force حين يختلف le style de négociation.","cat":"Interculturel","level":"C1","extra":true},{"title":"Prenez en compte les aspects linguistiques et interculturels pour réussir vos réunions","channel":"International Coaching Solutions Français","videoId":"JKfQUYqAK8Q","why":"كيف تُدار la réunion بعين لغوية: les tour de parole، la clarté، et les pièges d’interprétation بين مشاركين من خلفيات مختلفة.","cat":"Interculturel","level":"C1","extra":true}],"supplements":[{"id":"12f1c8dNYx4","title":"Négociation interculturelle : comment la méthode 2024 change la donne","channel":"Maître Lacour","why":"مقاربة حديثة للتفاوض بين الثقافات: كيف تُعاد قراءة les rapports de force حين يختلف le style de négociation.","lang":"fr","dur":9},{"id":"JKfQUYqAK8Q","title":"Prenez en compte les aspects linguistiques et interculturels pour réussir vos réunions","channel":"International Coaching Solutions Français","why":"كيف تُدار la réunion بعين لغوية: les tour de parole، la clarté، et les pièges d’interprétation بين مشاركين من خلفيات مختلفة.","lang":"fr","dur":14}]},{"id":"c1-t7-l6","fr":"Médiation linguistique professionnelle","ar":"الوساطة اللغوية في السياق المهني","objectives":["تحديد la différence entre traduire, reformuler et expliciter في موقف عمل حقيقي","تطبيق l’écoute active عبر la reformulation en écho واستعمال la reformulation interrogative","إنتاج résumé من ثلاث جمل يحفظ le fil conducteur لاجتماع طويل","كتابة compte rendu ثنائي اللغة يُظهر ما اتفق عليه وما بقي مفتوحاً"],"sections":[{"h":"الدرس 6: كيف تُوضّح وتُلخّص وتُعيد الصياغة حين تتعطّل التواصل","video":{"id":"IiSlw5j6TxY","title":"La médiation interculturelle, qu’est-ce que c’est ?","channel":"Le Monde De L’autre","why":"تعريف دقيق للوساطة: الفرق بين le traducteur الذي ينقل الكلمة وla médiateure الذي يُعيد بناء التواصل بين طرفين لا يفهمان بعضهما.","lang":"fr","main":true,"dur":8},"p":["la médiation linguistique ليست ترجمة: المترجم ينقل النص بين لغتين، أما الوسيط فيعمل حين تكون اللغتان موجودتين والمعنى غائباً. هو يأخذ ما قيل ويصوغه بطريقة يستطيع الطرف الثاني فهمه فعلاً، ثم يتحقق من أن الفهم حدث.","أول أداة: la reformulation. أعد قائلَ ما سمعتَ بكلماتك، ثم اطلب التصحيح: « Si je résume, vous préférez reporter la décision ? ». إن صحّحك الطرف الآخر، فقدتَ دقيقة وكسبتَ معلومة دقيقة.","الثانية: l’explicitation. كثير من سوء الفهم ينشأ من le implicite: عبارة مثل « on verra » تعني رفضاً مؤجّلاً. الوسيط يجعل ما بطن ظاهراً دون أن ينسبه للطرف الآخر، فيقول: « Concrètement, il faut une réponse avant vendredi. »","الثالثة: le résumé. في نهاية اجتماع طويل، ثلاثة أسطر تغني عن صفحات: ماذا قرّرنا، ماذا سنفعل، متى نعود. la synthèse تُكتب بالبنية نفسها مهما اختلفت اللغات.","لا تنسَ la confirmation: بعد كل reformulation اسأل « Est-ce que je résume bien ? ». الوسيط الذي يُكمل جملته قبل أن يتحقق يصبح مصدراً جديداً لسوء الفهم.","المهنة تُقاس بنتيجة واحدة: هل أعاد الطرفان الحوار بعد أن توقّفا؟ إن كان الجواب نعم، فقد نجحت la médiation وإن لم يُنطق فيها بكلمة واحدة عن الترجمة."],"sub":[{"h":"reformuler pour vérifier","p":["Si je résume, vous préférez reporter la décision.","Vous dites donc que le délai reste le problème.","Est-ce que je résume bien votre position ?"]},{"h":"rendre explicite","p":["Concrètement, il nous faut une réponse avant vendredi.","Autrement dit, le point reste ouvert pour l’instant.","Ce que vous proposez, c’est d’ajourner le vote."]},{"h":"résumer et conclure","p":["Trois décisions, deux responsables, une date.","Le compte rendu distingue l’acquis de l’ouvert.","Nous nous retrouvons jeudi pour la synthèse."]}]},{"h":"les tournures de la médiation","p":["« Si je résume bien… » — la reformulation qui attend la correction.","« Autrement dit, il s’agit de… » — le relais vers la clarté.","« Pour être plus précis… » — l’explicitation discrète.","« Nous avons convenu de trois points. » — la clôture du tour de table."]},{"h":"التطبيق والتلخيص","p":["تمرين l’écho: استمع إلى دقيقتين من podcast وأعد صياغة الفكرة الرئيسية في جملة واحدة ثم اطلب تصحيحاً متخيَّلاً.","تمرين la synthèse: لخّص اجتماعاً أو مقالاً في ثلاث جمل: قرار، فعل، موعد — بلا تفاصيل إضافية.","تمرين le compte rendu: اكتب ملخصاً من ست جمل يقسم ما اتفق عليه الفريق وما بقي مفتوحاً، في جدول من عمودين."]}],"pron":[{"w":"la médiation","ipa":"[la me.dja.sjɔ̃]","approx":"لا ميدياسيون"},{"w":"reformuler","ipa":"[ʁə.fɔʁ.my.le]","approx":"ريفورميليه"},{"w":"le résumé","ipa":"[lə ʁe.zy.me]","approx":"لُ ريزوميه"}],"vocab":[{"fr":"la médiation linguistique","ar":"الوساطة اللغوية","pos":"nom","g":"f","exFr":"La médiation a évité un malentendu.","ipa":"[me.dja.sjɔ̃ lɛ̃.ɡwis.tik]","exAr":"الوساطة تجنبت سوء فهم."},{"fr":"la reformulation","ar":"إعادة صياغة ما قيل","pos":"nom","g":"f","exFr":"Sa reformulation a rassuré l’interlocuteur.","ipa":"[ʁə.fɔʁ.my.la.sjɔ̃]","exAr":"إعادة صياغته طمأنت الطرف الآخر."},{"fr":"reformuler","ar":"يعيد صياغة الفكرة","pos":"verbe","g":"","exFr":"Reformulez votre idée autrement.","ipa":"[ʁə.fɔʁ.my.le]","exAr":"أعد صياغة فكرتك بطريقة أخرى."},{"fr":"expliciter","ar":"يُبدي ما كان ضمنياً","pos":"verbe","g":"","exFr":"Explicitez le point avant de conclure.","ipa":"[ɛks.pli.si.te]","exAr":"اجعل النقطة صريحة قبل أن تختتم."},{"fr":"le résumé","ar":"الخلاصة","pos":"nom","g":"m","exFr":"Faites un résumé en trois phrases.","ipa":"[ʁe.zy.me]","exAr":"أعد خلاصة في ثلاث جمل."},{"fr":"la synthèse","ar":"التلخيص المنهجي","pos":"nom","g":"f","exFr":"La synthèse reprend les décisions.","ipa":"[sɛ̃.tɛz]","exAr":"التلخيص يعيد استعراض القرارات."},{"fr":"l’écoute active","ar":"الإنصات الفاعل","pos":"loc.","g":"f","exFr":"L’écoute active demande des reformulations.","ipa":"[ɛ.kut ak.tif]","exAr":"الإنصات الفاعل يتطلب إعادة صياغة."},{"fr":"le compte rendu","ar":"محضر الاجتماع","pos":"nom","g":"m","exFr":"Le compte rendu part ce soir.","ipa":"[lə kɔ̃t ʁɑ̃.dy]","exAr":"يُرسل محضر الاجتماع مساءً."},{"fr":"le fil conducteur","ar":"الخيط الموجّه للأفكار","pos":"nom","g":"m","exFr":"Gardez le fil conducteur du débat.","ipa":"[lə fil kɔ̃.dʏk.tœʁ]","exAr":"احتفظ بالخيط الموجّه للنقاش."},{"fr":"la clarification","ar":"توضيح الجلِي","pos":"nom","g":"f","exFr":"Une clarification s’impose avant de voter.","ipa":"[kla.ʁi.fi.kɑ̃.sjɔ̃]","exAr":"لا بد من توضيح جلي قبل التصويت."},{"fr":"résumer","ar":"يلخّص","pos":"verbe","g":"","exFr":"Résumez les faits en deux minutes.","ipa":"[ʁe.zy.me]","exAr":"لخّص الوقائع في دقيقتين."},{"fr":"le point de repère","ar":"نقطة الاسترشاد","pos":"nom","g":"m","exFr":"Ce chiffre sert de point de repère.","ipa":"[lə pwɛ̃ də ʁə.pɛʁ]","exAr":"هذا الرقم يُستخدم كنقطة استرشاد."}],"examples":[{"fr":"Si je résume, vous préférez reporter la décision.","ar":"إن أردتُ ألخّص، تفضّلون تأجيل القرار.","note":"la reformulation de synthèse"},{"fr":"Autrement dit, le délai reste le seul obstacle.","ar":"أي أن المُهلة تبقى العائق الوحيد.","note":"le relais vers la clarté"},{"fr":"Concrètement, il faut une réponse avant vendredi.","ar":"عملياً، نحتاج جواباً قبل الجمعة.","note":"l’explicitation"},{"fr":"Nous avons convenu de trois points.","ar":"اتفقنا على ثلاث نقاط.","note":"la clôture"},{"fr":"Le compte rendu distingue l’acquis de l’ouvert.","ar":"يُفرّق المحضر بين المُنجَز والمفتوح.","note":"la structure du compte rendu"},{"fr":"Est-ce que je résume bien votre position ?","ar":"هل ألخّص موقفك بدقة؟","note":"la confirmation"}],"grammar":[{"tFr":"Les relatives de clarification : ce que, ce qui, celui qui","tAr":"الجمل الموصولة للتوضيح: ce que و ce qui و celui qui","body":["La médiation a besoin de nominaliser l’idée pour la manipuler : « Ce que vous dites, c’est… », « Ce qui bloque, c’est… », « Celui qui décide est… ». La relative transforme une phrase entière en un objet dont on peut parler.","Ces formes servent aussi de filet de sécurité : elles permettent de reprendre le fil sans accuser personne. « Ce que je comprends, c’est… » affirme moins que « Vous dites que… » et laisse la porte ouverte à la correction."],"ex":[{"fr":"Ce que vous proposez, c’est d’ajourner le vote.","ar":"ما تقترحه هو تأجيل التصويت."},{"fr":"Ce qui bloque, c’est le manque d’informations.","ar":"ما يعرقل الأمر هو نقص المعلومات."}]},{"tFr":"Les opérateurs de reformulation","tAr":"أدوات إعادة الصياغة","body":["La langue dispose de connecteurs spécialisés : en d’autres termes, autrement dit, ce qui veut dire que, pour faire court, plus simplement. Ils annoncent au lecteur que la même idée va revenir sous une autre forme — c’est la promesse de clarté.","Le bon usage distingue deux fonctions : « autrement dit » réécrit la même phrase, « ce qui veut dire que » tire une conséquence. Les confondre produit une fausse reformulation qui éloigne au lieu de rapprocher."],"ex":[{"fr":"Le délai est court, autrement dit il faudra prioriser.","ar":"المُهلة قصيرة، أي أنه يجب ترتيب الأولويات."},{"fr":"Nous n’avons pas de réponse, ce qui veut dire que tout reste ouvert.","ar":"ليس لدينا جواب، مما يعني أن كل شيء ما يزال مفتوحاً."}]}],"mistakes":[{"wrong":"résumer en supprimant les idées directrices","right":"résumer en gardant le fil conducteur","why":"un résumé sans idées directrices est une liste — الخلاصة بلا خيط موجّه هي قائمة لا خلاصة."},{"wrong":"reformuler avec les mêmes mots","right":"changer de structure et de vocabulaire","why":"si les mots restent, le malentendu reste — إن بقيت الكلمات بقي سوء الفهم."},{"wrong":"expliquer en ajoutant de nouvelles informations","right":"expliquer ce qui était sous-entendu","why":"l’explicitation développe, elle n’invente pas — التوضيح يُطوّر ولا يخترع."},{"wrong":"parler à la place de l’interlocuteur","right":"reformuler puis demander confirmation","why":"le médiateur vérifie, il ne substitue pas — الوسيط يتحقق ولا يحلّ محل أحد."}],"dialogues":[{"title":"Clarifier un point en réunion","ctx":"وساطة بعد عرض فني غامض","lines":[{"who":"Inès","fr":"Si je résume, vous préférez reporter la décision.","ar":"إن ألخّص، تفضّلون تأجيل القرار."},{"who":"Marc","fr":"Pas exactement : nous voulons plus d’informations.","ar":"ليس بالضبط: نريد معلومات أكثر."},{"who":"Inès","fr":"Autrement dit, la réponse dépend du rapport.","ar":"أي أن الجواب يعتمد على التقرير."},{"who":"Marc","fr":"Voilà, et il arrive lundi.","ar":"هكذا بالضبط، ويصل يوم الاثنين."}]},{"title":"Le compte rendu du soir","ctx":"موظّفان يُعدّان ملخص اجتماع بلغتين","lines":[{"who":"Sofia","fr":"Trois décisions, deux responsables, une date.","ar":"ثلاث قرارات، مسؤولان، تاريخ واحد."},{"who":"Hugo","fr":"Il faut séparer l’acquis de l’ouvert.","ar":"يجب الفصل بين المُنجَز والمفتوح."},{"who":"Sofia","fr":"D’accord, je reformule en deux colonnes.","ar":"حسناً، سأعيد الصياغة في عمودين."},{"who":"Hugo","fr":"Parfait, envoie-le avant vingt heures.","ar":"ممتاز، أرسله قبل الثامنة مساءً."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما الفرق الأساسي بين la traduction وla médiation؟","opts":["الترجمة تنقل النص والوساطة تُعيد بناء الفهم","الترجمة أسرع من الوساطة","الوساطة تعمل بلغة واحدة فقط","لا فرق بينهما"],"a":0,"why":"la médiation intervient quand les langues sont connues mais le sens reste bloqué."},{"t":"fill","skill":"grammar","q":"أكمل: «___ je résume, vous préférez reporter ?»","fr":"___ je résume, vous préférez reporter ?","ans":"Si","why":"Si je résume : formule d’ouverture de la reformulation."},{"t":"order","skill":"writing","q":"رتّب: ثلاث قرارات ومسؤولان وتاريخ واحد","words":["Trois","décisions,","deux","responsables,","une","date."],"ans":"Trois décisions, deux responsables, une date.","why":"la série nominale : les virgules séparent les groupes, le point ferme la dernière phrase."},{"t":"listen","skill":"listening","q":"ما وظيفة « Autrement dit » في الخطاب؟","opts":["إعادة صياغة الفكرة نفسها","تقديم اعتراض","تغيير الموضوع","ختام الاجتماع"],"a":0,"why":"autrement dit réécrit la phrase précédente avec d’autres mots."},{"t":"translate","skill":"writing","q":"ترجم: «هل ألخّص موقفك بدقة؟»","ans":"Est-ce que je résume bien votre position ?","why":"la confirmation obligatoire après chaque reformulation."},{"t":"speaking","skill":"speaking","q":"أعد صياغة جملة غامضة من زميل ثم اطلب التصحيح في جملتين.","target":"Si je résume / Est-ce que je résume bien","why":"l’écoute active en deux temps : reformuler, vérifier."},{"t":"correct","skill":"grammar","q":"صحّح: «Autrement dit, ce qui veut dire que le vote est ajourné.»","ans":"Autrement dit, le vote est ajourné.","why":"les deux opérateurs sont redondants : l’un reformule, l’autre conclut."},{"t":"mcq","skill":"reading","q":"أي جملة تُصلح خاتمة compte rendu؟","opts":["Nous avons convenu de trois points et de la date du jeudi.","C’était une réunion plutôt longue.","Beaucoup de gens ont parlé.","À bientôt, peut-être."],"a":0,"why":"le compte rendu clôture par les acquis et la prochaine échéance."}],"homework":"اختر اجتماعاً أو نقاشاً حضرتَه، واكتب compte rendu من ثمان أسطر مقسوماً إلى عمودين: « Ce qui est acquis » و« Ce qui reste ouvert »، ثم أسقط اسطر أخرى بصيغة « Si je résume… » تصلح لعرضه شفوياً في دقيقتين.","sources":[{"title":"La médiation interculturelle, qu’est-ce que c’est ?","channel":"Le Monde De L’autre","videoId":"IiSlw5j6TxY","why":"تعريف دقيق للوساطة: الفرق بين le traducteur الذي ينقل الكلمة وla médiateure الذي يُعيد بناء التواصل بين طرفين لا يفهمان بعضهما.","cat":"Interculturel","level":"C1","main":true},{"title":"Sortez la langue de votre poche : création d’activités de médiation linguistique intra/interlangue","channel":"France Éducation international","videoId":"2hxg93xsLa0","why":"من مؤسسة تربوية رسمية: كيف تُبنى أنشطة la médiation داخل الفصل وخارجه، بأمثلة تصلح للاجتماعات والورش.","cat":"Interculturel","level":"C1","extra":true},{"title":"6 Conseils pour faire un Résumé en Français 📋🙂","channel":"Français avec Pierre","videoId":"218PkXa6Cz4","why":"ستة قواعد عملية لـ le résumé: اختيار les idées clés وترتيبها وصياغتها في جمل قصيرة قبل كتابة le compte rendu.","cat":"Interculturel","level":"C1","extra":true}],"supplements":[{"id":"2hxg93xsLa0","title":"Sortez la langue de votre poche : création d’activités de médiation linguistique intra/interlangue","channel":"France Éducation international","why":"من مؤسسة تربوية رسمية: كيف تُبنى أنشطة la médiation داخل الفصل وخارجه، بأمثلة تصلح للاجتماعات والورش.","lang":"fr","dur":15},{"id":"218PkXa6Cz4","title":"6 Conseils pour faire un Résumé en Français 📋🙂","channel":"Français avec Pierre","why":"ستة قواعد عملية لـ le résumé: اختيار les idées clés وترتيبها وصياغتها في جمل قصيرة قبل كتابة le compte rendu.","lang":"fr","dur":10}]}]},{"id":"c1-t8","slug":"sciences-tech-societe","icon":"zap","color":"#0369a1","fr":"Sciences, tech & société","ar":"العلوم والتقنية والمجتمع","desc":"la vulgarisation، l’économie، le numérique، la santé، l’environnement، l’espace.","lessons":[{"id":"c1-t8-l1","fr":"La vulgarisation scientifique","ar":"تبسيط العلوم: كيف نشرح المعقد لغير المتخصصين","objectives":["شرح concept علمي معقد في ثلاث جمل: تشبيه، تعريف قصير، جملة تروي","التمييز بين le registre scientifique وle registre vulgarisé داخل النص نفسه","استعمال أدوات التروي: peut-être, il est possible que, selon les études, suggérer","تحليل نص تبسيط فرنسي واستخراج le jargon الذي تُرك دون شرح"],"sections":[{"h":"الدرس 1: كيف تشرح المعلومة العلمية المعقدة ببساطة","video":{"id":"e9iciw8oE6E","title":"5 astuces de vulgarisation | Sciences & Médias #15","channel":"Avec Des Sci - Sci+","why":"خمس قواعد عملية لتوضيح العلم للجمهور: كيف تختار l’analogie، وكيف تُعرّف المفهوم قبل استعماله، وكيف تُخفّف اللغة بـ « peut-être » و« selon les études » بدل اليقين المطلق.","lang":"fr","main":true,"dur":8},"p":["« La vulgarisation » عملية نقل المعلومة من le cercle des specialists إلى le grand public، والهدف ليس تبسيطاً مجانباً للصواب بل جعل le sens قابلاً للفهم: la règle est d’expliquer sans trahir.","الأداة الأولى l’analogie وla métaphore: التشبيه يربط concept غير مألوف بشيء مألوف، مثل « l’ADN est comme une bibliothèque d’instructions ». التشبيه يوضّح ولا يُلغي la définition العلمية أبداً.","الأداة الثانية la définition القصيرة: قبل أي term technique ضع معنى في جملة واحدة، مثل « la photosynthèse, c’est-à-dire la façon dont la plante fabrique sa matière à partir de la lumière ». حرفياً: « c’est-à-dire » هو حلقة الوصل بين le savant وle lecteur.","الأداة الثالثة la pondération: le discours العلمي لا يدّعي اليقين دائماً، بل يقول « les résultats suggèrent que… », « il est probable que… », « selon une étude publiée en 2024… ». التروي هنا ليس ضعفاً بل le signe d’une méthode.","على العكس، le jargon غير المشروح يغلق النص: عبارات مثل « une réaction en chaîne » أو « un seuil critique » بدون تعريف تُفقد le non-spécialiste معنى الفقرة كلها. قاعدة التحرير: كل term جديد إما أن يُعرَّف، أو يُشبَّه، أو يُحذف.","للتمرين: اختر conceptاً من مجلة علمية، واشرحه في ثلاث جمل، ثم قارن le registre de l’article الأصلي مع le registre de نصك: أين الدقة؟ أين البساطة؟ وأين la nuance؟"],"sub":[{"h":"définition et analogie","p":["Commençons par une image simple : le cerveau est comme un réseau de routes.","La photosynthèse, c’est-à-dire la fabrication de sucre à partir de la lumière.","Un concept doit être défini avant d’être utilisé."]},{"h":"le jargon à éviter","p":["Évitez le jargon que votre lecteur ne connaît pas.","Un terme technique non expliqué bloque la lecture.","Préférez un mot quotidien quand il existe."]},{"h":"nuancer pour être juste","p":["Les études suggèrent un lien, sans le prouver.","Il est probable que cet effet varie selon les personnes.","Peut-être que de nouveaux travaux modifieront cette conclusion."]}]},{"h":"les formules de la prudence","p":["« Il est possible que… » — introduire une hypothèse sans l’affirmer.","« Selon les études réalisées à ce jour… » — nommer la source et la limite.","« C’est-à-dire… » — reformuler un terme technique en langue courante.","« Autrement dit… » — répéter l’idée autrement pour la rendre accessible."]},{"h":"التطبيق والتلخيص","p":["تمرين l’analogie: اشرح concept « l’inflation » أو « le virus » بتشبيه من حياتك اليومية في جملة، ثم اكتب التعريف العلمي القصير في جملة ثانية.","تمرين la pondération: حوّل ثلاث جمل مطلقة إلى le langage prudent: « Cela prouve que… »، « Les scientifiques savent que… »، « Le traitement guérit… ».","تمرين la lecture critique: اقرأ فقرة من Le Monde أو Futura-Sciences، حدد كل term تقني، واكتب بجانبه هل هو مُعرَّف أم مُبسَّط أم متروك دون شرح."]}],"pron":[{"w":"la vulgarisation","ipa":"[ly.lɡa.ʁa.sjɔ̃]","approx":"فولغاريزاسيون"},{"w":"le concept","ipa":"[lə kɔ̃.sɛpt]","approx":"لو كونسيط"},{"w":"la pondération","ipa":"[lɑ̃.pɔ.te.sjɔ̃]","approx":"لانونتاريسيون"}],"vocab":[{"fr":"la vulgarisation","ar":"تبسيط المعرفة للعامة","pos":"nom","g":"f","exFr":"La vulgarisation rend la science accessible.","ipa":"[ly.lɡa.ʁa.sjɔ̃]","exAr":"تبسيط المعرفة يجعل العلم مفهوماً."},{"fr":"le concept","ar":"المفهوم","pos":"nom","g":"m","exFr":"Ce concept est difficile à expliquer.","ipa":"[lə kɔ̃.sɛpt]","exAr":"هذا المفهوم صعب الشرح."},{"fr":"l’analogie","ar":"التشبيه المقارن","pos":"nom","g":"f","exFr":"L’analogie aide à comprendre l’invisible.","ipa":"[a.na.lɔ.ʒi]","exAr":"التشبيه المقارن يساعد على فهم المجهول."},{"fr":"la métaphore","ar":"الاستعارة","pos":"nom","g":"f","exFr":"La métaphore évite la définition longue.","ipa":"[me.ta.fɔʁ]","exAr":"الاستعارة تغني عن التعريف الطويل."},{"fr":"le jargon","ar":"المصطلحات الخاصة بالمختصين","pos":"nom","g":"m","exFr":"Ce paragraphe est rempli de jargon.","ipa":"[ʒaʁ.ɡɔ̃]","exAr":"هذه الفقرة ممتلئة بالمصطلحات التقنية."},{"fr":"le terme technique","ar":"المصطلح التقني","pos":"loc.","g":"m","exFr":"Chaque terme technique doit être précisé.","ipa":"[tɛʁm tɛk.nik]","exAr":"يجب توضيح كل مصطلح تقني."},{"fr":"le grand public","ar":"الجمهور الواسع","pos":"loc.","g":"m","exFr":"Ce document s’adresse au grand public.","ipa":"[ɡʁɑ̃ py.blik]","exAr":"هذا المستند موجّه إلى الجمهور الواسع."},{"fr":"pondérer","ar":"يوازن الكلام ويتريث فيه","pos":"verbe","g":"","exFr":"Il faut pondérer cette affirmation.","ipa":"[pɔ̃.de.te]","exAr":"يجب التريث في هذا التأكيد."},{"fr":"peut-être","ar":"ربما، قد يكون","pos":"adv","g":"","exFr":"Ce lien est peut-être plus faible.","ipa":"[pə.tɛt]","exAr":"ربما يكون هذا الارتباط أضعف."},{"fr":"il est possible que","ar":"من المحتمل أن","pos":"loc.","g":"","exFr":"Il est possible que l’effet varie.","ipa":"[il e pɔ.si.blə kə]","exAr":"من المحتمل أن يختلف الأثر."},{"fr":"simplifier","ar":"يبسّط","pos":"verbe","g":"","exFr":"Il faut simplifier sans trahir.","ipa":"[sɛ̃.pli.fe]","exAr":"يجب أن تُبسّط دون تحريف."},{"fr":"accessible","ar":"سهل الفهم، متاح","pos":"adj","g":"m/f","exFr":"Cette explication est accessible.","ipa":"[ak.sɛ.sib.bl]","exAr":"هذا الشرح سهل الفهم."}],"examples":[{"fr":"La photosynthèse, c’est-à-dire la fabrication du sucre à partir de la lumière.","ar":"البناء الضوئي، أي صنع السكر من الضوء.","note":"la définition par reformulation"},{"fr":"Le cerveau est comme un réseau de routes.","ar":"الدماغ يشبه شبكة من الطرق.","note":"l’analogie"},{"fr":"Les résultats suggèrent que l’effet est faible.","ar":"تقيّح النتائج أن الأثر ضعيف.","note":"la pondération"},{"fr":"Il est probable que de nouveaux travaux confirment ce lien.","ar":"من المرجح أن تؤكد أبحاث جديدة هذا الارتباط.","note":"le conditionnel de probabilité"},{"fr":"Autrement dit, la plante transforme la lumière en matière.","ar":"عبارة أخرى، النبتة تحوّل الضوء إلى مادة.","note":"la reformulation"},{"fr":"Peut-être que cette hypothèse sera réfutée.","ar":"ربما يُدحض هذا الافتراض.","note":"l’adverbe de doute"}],"grammar":[{"tFr":"Le conditionnel et les adverbes de prudence","tAr":"المضارع الشرطي وأدوات التروي في الخطاب العلمي","body":["Le conditionnel présente une hypothèse non vérifiée : « ces résultats pourraient indiquer une tendance ». Il remplace l’indicatif dès que la certitude n’est pas absolue.","On l’associe aux locutions de modalité : peut-être, probablement, il est possible que + subjonctif, selon les études. Plus la source est précise, plus le propos est crédible."],"ex":[{"fr":"Ces résultats pourraient indiquer une tendance.","ar":"قد تشير هذه النتائج إلى اتجاه."},{"fr":"Il est possible que l’expérience échoue.","ar":"من المحتمل أن تفشل التجربة."}]},{"tFr":"Les structures de définition et de réformulation","tAr":"بنيات التعريف وإعادة الصياغة","body":["Définir, c’est encadrer le terme : « la photosynthèse, c’est-à-dire… », « autrement dit… », « en d’autres termes… ». Ces connecteurs annoncent au lecteur qu’une explication arrive.","La comparaison apporte le concret : « comme », « tel », « à la manière de ». Elle précède souvent la définition formelle, mais ne la remplace jamais entièrement."],"ex":[{"fr":"Le jargon, c’est-à-dire le langage réservé aux spécialistes, décourage le lecteur.","ar":"المصطلحات، أي لغة المختصين، تُنفّر القارئ."},{"fr":"L’ADN agit comme une bibliothèque d’instructions.","ar":"يتعامل الحمض النووي كما لو كان مكتبة من التعليمات."}]}],"mistakes":[{"wrong":"Cela prouve que le traitement fonctionne.","right":"Les données suggèrent que le traitement pourrait fonctionner.","why":"une étude unique n’établit pas la preuve — الدراسة الواحدة لا تثبت اليقين بل تقترح احتمالاً."},{"wrong":"expliquer un concept avec dix termes techniques","right":"définir le concept avant de l’employer","why":"sans définition, le lecteur perd le fil — دون تعريف يفقد القارئ سياق الفقرة."},{"wrong":"croire que l’analogie remplace la définition","right":"faire précéder la définition d’une analogie","why":"le comparable éclaire, mais ne définit pas — التشبيه يوضّح ولا يُعرّف."},{"wrong":"les scientifiques savent que…","right":"les travaux réalisés à ce jour indiquent que…","why":"la science avance par résultats accumulés, non par dogme — العلم يتقدم بالنتائج لا بالعقيدة."}],"dialogues":[{"title":"Expliquer un concept difficile","ctx":"باحثة تشرح مفهوماً تقنياً لصديق غير متخصص","lines":[{"who":"Léa","fr":"Je vais te l’expliquer simplement : l’IA, c’est comme un assistant qui apprend sur des exemples.","ar":"سأشرحه لك ببساطة: الذكاء الاصطناعي كمساعد يتعلم من الأمثلة."},{"who":"Mehdi","fr":"Donc il ne comprend pas vraiment ?","ar":"إذن لا يفهم حقاً؟"},{"who":"Léa","fr":"Il est probable qu’il reproduise des schémas, sans comprendre au sens humain.","ar":"من المرجح أنه يكرر أنماطاً دون فهم بالمعنى البشري."},{"who":"Mehdi","fr":"D’accord, ça c’est plus clair.","ar":"حسناً، هذا أوضح الآن."}]},{"title":"La réponse prudente","ctx":"مذيع يسأل خبيراً في الاستوديو","lines":[{"who":"Hugo","fr":"Ce produit guérit-il vraiment la maladie ?","ar":"هل يشفى هذا المنتج فعلاً من المرض؟"},{"who":"Nadia","fr":"Les premières études suggèrent un effet, mais rien n’est encore prouvé.","ar":"تقيّح الدراسات الأولى أثراً، لكن لم يثبت شيء بعد."},{"who":"Hugo","fr":"Donc on devrait dire « peut-être » ?","ar":"إذن يجب أن نقول « ربما »؟"},{"who":"Nadia","fr":"Ou mieux : « selon les études disponibles à ce jour ».","ar":"والأفضل: « وفقاً للدراسات المتاحة حتى الآن »."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما معنى « la vulgarisation scientifique »؟","opts":["تبسيط العلوم لغير المتخصصين","نشر الأبحاث في مجلات محكّمة","تمويل المختبرات","ترجمة المصطلحات حرفياً"],"a":0,"why":"vulgariser = rendre la science accessible au grand public دون تشويه المعنى."},{"t":"fill","skill":"grammar","q":"أكمل: «Il est possible que ces résultats ___ (indiquer) une tendance.»","fr":"Il est possible que ces résultats ___ une tendance.","ans":"indiquent","why":"le subjonctif est obligatoire après « il est possible que »."},{"t":"order","skill":"writing","q":"رتّب: التبسيط يجعل العلم مفهوماً للجميع","words":["La","vulgarisation","rend","la","science","accessible."],"ans":"La vulgarisation rend la science accessible.","why":"ordre sujet — verbe — COD."},{"t":"listen","skill":"listening","q":"ماذا تُعلن عبارة « c’est-à-dire » في نص تبسيط؟","opts":["إعادة صياغة التعريف ببساطة","الانتقال إلى موضوع جديد","نفي ما قيل قبلها","طلب رأي المستمع"],"a":0,"why":"c’est-à-dire annonce une reformulation du terme précédent."},{"t":"translate","skill":"writing","q":"ترجم: «قد تشير هذه النتائج إلى اتجاه جديد.»","ans":"Ces résultats pourraient indiquer une nouvelle tendance.","why":"le conditionnel de prudence avec « pourraient »."},{"t":"speaking","skill":"speaking","q":"اشرح في ثلاث جمل concept « l’hérédité » مستعمداً التشبيه والتعريف والتروي.","target":"comme / c’est-à-dire / il est possible que","why":"إنتاج لغوي يجمع الأدوات الثلاث لشرح المعقّد."},{"t":"correct","skill":"grammar","q":"صحّح: «Ces études prouvent que le médicament guérit.»","ans":"Ces études suggèrent que le médicament pourrait guérir.","why":"une étude ne prouve pas définitivement : le conditionnel rend le propos juste."},{"t":"mcq","skill":"reading","q":"أي جملة تبسط مع الإبقاء على الدقة العلمية؟","opts":["Le cerveau est un ordinateur biologique parfait.","Le cerveau fonctionne parfois comme un ordinateur, mais il reste biologique.","Le cerveau ne peut pas être comparé à rien.","Le cerveau est identique à un ordinateur."],"a":1,"why":"la comparaison est limitée par « parfois » et « mais » : c’est une analogie, pas une identité."}],"homework":"شاهد الفيديو الرئيسي بدون ترجمة، اكتب خمسة مصطلحات علمية مع تعريفها في جملة واحدة، ثم اشرح conceptاً من اختيارك في ثلاث جمل: تشبيه، تعريف، تروي.","sources":[{"title":"5 astuces de vulgarisation | Sciences & Médias #15","channel":"Avec Des Sci - Sci+","videoId":"e9iciw8oE6E","why":"خمس قواعد عملية لتوضيح العلم للجمهور: كيف تختار l’analogie، وكيف تُعرّف المفهوم قبل استعماله، وكيف تُخفّف اللغة بـ « peut-être » و« selon les études » بدل اليقين المطلق.","cat":"Sciences","level":"C1","main":true},{"title":"Communication publique et communication scientifique : introduction","channel":"Master Conseil éditorial de Sorbonne Université","videoId":"FHzObkG8qTc","why":"إطار أكاديمي واضح يفرق بين le discours scientifique وle discours public، وهو ما يحكم اختيار le registre عند التبسيط.","cat":"Sciences","level":"C1","extra":true},{"title":"#Parolepublique #LaSérie – Épisode 9 : Communiquer pour et sur la science","channel":"Communication-publique","videoId":"RFxhQ0r1SRg","why":"دراسة حالة فرنسية عن التواصل المؤسسي حول العلم: كيف تُصاغ الرسائل بـ la nuance دون فقدان la crédibilité.","cat":"Sciences","level":"C1","extra":true}],"supplements":[{"id":"FHzObkG8qTc","title":"Communication publique et communication scientifique : introduction","channel":"Master Conseil éditorial de Sorbonne Université","why":"إطار أكاديمي واضح يفرق بين le discours scientifique وle discours public، وهو ما يحكم اختيار le registre عند التبسيط.","lang":"fr","dur":8},{"id":"RFxhQ0r1SRg","title":"#Parolepublique #LaSérie – Épisode 9 : Communiquer pour et sur la science","channel":"Communication-publique","why":"دراسة حالة فرنسية عن التواصل المؤسسي حول العلم: كيف تُصاغ الرسائل بـ la nuance دون فقدان la crédibilité.","lang":"fr","dur":5}]},{"id":"c1-t8-l2","fr":"L’économie dans les médias","ar":"الاقتصاد في وسائل الإعلام: الأرقام والنمو والتضخّم بلغة مُتحفّظة","objectives":["استخراج les indicateurs clés: le PIB, le taux de croissance, l’inflation, le chômage, la dette","فهم le langage prudentiel: « selon les chiffres publiés… », « en glissement annuel… », « autour de… »","التمييز بين le chiffre brut وle pourcentage وla base de calcul قبل أي مقارنة","إعادة صياغة عنوان اقتصادي مبالغ فيه في le ton neutre d’un bulletin économique"],"sections":[{"h":"الدرس 2: كيف تقرأ الخبر الاقتصادي دون أن تُخدَع بالأرقام","video":{"id":"-8i8oIIZeWc","title":"Vocabulaire Économique Avancé : Comment Parler d’Économie en Français (Niveau C1)","channel":"Français Facile","why":"حصّة مفردات متقدمة بمستوى C1: كيف تُستعمل les indicateurs économiques في الحديث، وكيف تنتقل من le langage quotidien إلى le registre prudentiel عند ذكر les chiffres.","lang":"fr","main":true,"dur":27},"p":["« L’économie dans les médias » ليست سرداً محايداً للأرقام: كل خبر اقتصادي يجمع بين un chiffre، مثل « +2,1 % »، وune interprétation، مثل « la reprise est confirmée ». القراءة النقدية تبدأ بالفصل بين الرقم والرأي.","الأرقام الثلاثة المتكررة: le taux de croissance du PIB يقيس تغير حجم الاقتصاد، وl’inflation تقيس ارتفاع الأسعار غالباً عبر l’indice des prix à la consommation، وle chômage يُقرأ كنسبة من la population active.","قاعدة la base: « +3 % en un an » ليس شيئاً واحداً مع « +3 % en un trimestre ». le glissement annuel وle taux trimestriel لا يُقارنان مباشرة، وإلا تحوّل الخبر إلى إشارة مضلّلة.","le langage prudentiel يحكم الاقتصاد: « autour de 3 % », « proche de 2 % », « s’établit à 0,3 % », « selon l’Insee ». الاعتماد على la source هو ما يمنح الرقم مصداقية وليس حجم العدد نفسه.","l’inflation غالباً تُنقل بكلمات مرعبة، بينما le pouvoir d’achat يُقاس مقابل les revenus لا مقابل سعر منتج واحد. الفرق الدقيق: la désinflation تعني أن الأسعار تصعد بوتيرة أهدأ، لا أنها تنخفض.","للتمرين: اقرأ خبراً اقتصادياً يومياً، اكتب ثلاثة أرقام مع la période et la source لكل واحد، ثم أعد صياغته في جملتين: ماذا قال الرقم فعلاً؟ وماذا أضافه العنوان؟"],"sub":[{"h":"l’indicateur clé","p":["Le taux de croissance s’établit à 0,3 % ce trimestre.","L’inflation recule à 2,1 % sur un an.","Ces chiffres sont publiés par l’Insee."]},{"h":"le chiffre et son contexte","p":["Attention, ce pourcentage porte sur un an.","Autour de 3 % : l’estimation reste provisoire.","La base de calcul change le sens du chiffre."]},{"h":"décrypter un titre","p":["Le titre annonce une chute, les chiffres montrent un ralentissement.","Une variation de dixième de point n’est pas une tendance.","Comparez avec les trimestres précédents."]}]},{"h":"les formules des chiffres","p":["« Selon l’Insee, … » — attribuer le chiffre à sa source.","« Le taux s’établit à 0,3 % … » — annoncer une donnée avec précision.","« Autour de 3 % … » — arrondir sans exagérer.","« En glissement annuel … » — préciser la base de comparaison."]},{"h":"التطبيق والتلخيص","p":["تمرين la lecture: اقرأ نشرة الاقتصاد واستخرج ثلاثة أرقام، وحدّد لكل واحد la base de comparaison: سنوية أم ربع سنوية.","تمرين la reformulation: حوّل عنواناً مبالغًا مثل « L’économie explose ! » إلى جملة اقتصادية: « Le taux de croissance accélère légèrement. »","تمرين la prudence: استبدل العبارات المطلقة « toujours », « jamais », « prouve » بعبارات le journal économique: « souvent », « à ce jour », « suggère »."]}],"pron":[{"w":"le taux","ipa":"[lə to]","approx":"لو تو"},{"w":"l’inflation","ipa":"[lɛ̃.fla.sjɔ̃]","approx":"لانفلاسيون"},{"w":"le PIB","ipa":"[lə pɛ.i.be]","approx":"لو بي إيه بي"}],"vocab":[{"fr":"le taux de croissance","ar":"معدل النمو","pos":"loc.","g":"m","exFr":"Le taux de croissance dépasse les prévisions.","ipa":"[to də kʁwa.sjɔ̃]","exAr":"معدل النمو يتجاوز التوقعات."},{"fr":"l’inflation","ar":"التضخّم","pos":"nom","g":"f","exFr":"L’inflation ralentit depuis mars.","ipa":"[lɛ̃.fla.sjɔ̃]","exAr":"يتراجع التضخّم منذ آذار."},{"fr":"le PIB","ar":"الناتج المحلي الإجمالي","pos":"sigle","g":"m","exFr":"Le PIB a augmenté de 1,2 %.","ipa":"[pɛ.i.be]","exAr":"ارتفع الناتج المحلي الإجمالي بنسبة 1,2 %."},{"fr":"le pouvoir d’achat","ar":"القدرة الشرائية","pos":"loc.","g":"m","exFr":"Le pouvoir d’achat stagne.","ipa":"[pɔ.vwaʁ da.ʃa]","exAr":"تتجمد القدرة الشرائية."},{"fr":"le chômage","ar":"البطالة","pos":"nom","g":"m","exFr":"Le chômage recule légèrement.","ipa":"[ʃɔ.maʒ]","exAr":"تنخفض البطالة قليلاً."},{"fr":"la désinflation","ar":"تباطؤ التضخّم","pos":"nom","g":"f","exFr":"La désinflation signifie que les prix montent moins vite.","ipa":"[de.zɛ̃.fla.sjɔ̃]","exAr":"تباطؤ التضخّم يعني صعود الأسعار بوتيرة أهدأ."},{"fr":"la récession","ar":"الركود الاقتصادي","pos":"nom","g":"f","exFr":"La récession menace plusieurs secteurs.","ipa":"[re.sɛ.sjɔ̃]","exAr":"يهدد الركود عدة قطاعات."},{"fr":"la source","ar":"المصدر","pos":"nom","g":"f","exFr":"Citez toujours la source du chiffre.","ipa":"[suʁs]","exAr":"اذكر دائماً مصدر الرقم."},{"fr":"l’estimation","ar":"التقدير","pos":"nom","g":"f","exFr":"L’estimation reste provisoire.","ipa":"[es.ti.ma.sjɔ̃]","exAr":"يبقى التقدير مبدئياً."},{"fr":"un pourcentage","ar":"نسبة مئوية","pos":"nom","g":"m","exFr":"Le pourcentage est arrondi au dixième.","ipa":"[puʁ.sɑ̃.taʒ]","exAr":"النسبة مقرَّبة إلى العشر."},{"fr":"s’établir à","ar":"يبلغ أو يستقر عند","pos":"loc.","g":"v","exFr":"Le taux s’établit à 0,3 %.","ipa":"[se.ta.bliʁ a]","exAr":"يبلغ المعدل 0,3 %."},{"fr":"les prévisions","ar":"التوقعات","pos":"nom","g":"f","exFr":"Les prévisions ont été révisées.","ipa":"[le pʁe.vi.zjɔ̃]","exAr":"أُعيد النظر في التوقعات."}],"examples":[{"fr":"Selon l’Insee, l’inflation s’établit à 2,1 % sur un an.","ar":"وفقًا للـ Insee، بلغ التضخّم 2,1 % على مدى سنة.","note":"l’attribution de la source"},{"fr":"Le taux de croissance a progressé de 0,3 % au troisième trimestre.","ar":"ارتفع معدل النمو 0,3 % في الربع الثالث.","note":"la base temporelle"},{"fr":"Autour de 150 000 emplois ont été créés.","ar":"خلق نحو 150 000 منصب شغل.","note":"l’arrondi prudent"},{"fr":"La croissance ralentit, ce qui inquiète les économistes.","ar":"يتراجع النمو مما يثير قلق الاقتصاديين.","note":"le connecteur logique"},{"fr":"Les économistes rappellent que ce chiffre reste provisoire.","ar":"يذكّر الاقتصاديون بأن هذا الرقم يبقى مبدئياً.","note":"la prudence du commentaire"},{"fr":"En glissement annuel, les prix ont augmenté de 2,1 %.","ar":"على أساس سنوي، ارتفعت الأسعار بنسبة 2,1 %.","note":"la base de calcul"}],"grammar":[{"tFr":"Le conditionnel et les adverbes dans le reportage économique","tAr":"المضارع الشرطي والظروف في التقرير الاقتصادي","body":["Le conditionnel se réserve aux prévisions : « la croissance devrait atteindre 1,2 % ». Dès qu’il s’agit de données publiées, on revient à l’indicatif : « le PIB a augmenté de 1,2 % ».","Les adverbes mesurent la confiance : environ, autour de, légèrement, nettement. « Nettement » signale un mouvement marqué, « légèrement » un mouvement faible : le choix du mot vaut un commentaire."],"ex":[{"fr":"La croissance devrait atteindre 1,2 % en 2026.","ar":"من المتوقع أن تبلغ النمو 1,2 % في 2026."},{"fr":"Les prix ont légèrement baissé en avril.","ar":"انخفضت الأسعار قليلاً في نيسان."}]},{"tFr":"La nominalisation et la voix passive dans la langue économique","tAr":"الاسم الفعلي والمبني للمجهول في اللغة الاقتصادية","body":["La langue économique préfère les noms : « la création d’emplois » au lieu de « les entreprises créent des emplois ». Le style devient concis, mais l’acteur disparaît de la phrase.","La voix passive efface la responsabilité : « des mesures ont été prises ». Pour rendre l’acteur visible, ajoutez le complément : « des mesures ont été prises par le gouvernement »."],"ex":[{"fr":"La création d’emplois a ralenti ce trimestre.","ar":"تباطأ خلق مناصب الشغل هذا الربع."},{"fr":"Des mesures ont été prises par la Banque centrale.","ar":"اتُّخذت إجراءات من قبل البنك المركزي."}]}],"mistakes":[{"wrong":"confondre désinflation et baisse des prix","right":"désinflation = les prix montent moins vite","why":"la désinflation est un ralentissement du rythme, pas une inversion — التضخّم المتراجع تباطؤ في الوتيرة لا انخفاض في الأسعار."},{"wrong":"comparer un taux trimestriel à un taux annuel","right":"comparer des chiffres de même base","why":"sans base commune, la comparaison n’a aucun sens — من دون أساس موحّد لا معنى للمقارنة."},{"wrong":"Cela prouve la reprise.","right":"Ces chiffres suggèrent un début de reprise.","why":"un chiffre unique ne conclut pas à lui seul — الرقم وحده لا يستنتج."},{"wrong":"lire le pourcentage sans regarder la période","right":"préciser la période : sur un an, sur un trimestre","why":"la période change la valeur entière du chiffre — الفترة تغيّر القيمة كاملة للرقم."}],"dialogues":[{"title":"Le bulletin économique","ctx":"مذيعان يحلّلان نشرة الاقتصاد في الاستوديو","lines":[{"who":"Camille","fr":"Selon l’Insee, l’inflation s’établit à 2,1 % sur un an.","ar":"وفقًا لـ Insee، بلغ التضخّم 2,1 % على مدى سنة."},{"who":"Thomas","fr":"C’est en glissement annuel, n’est-ce pas ?","ar":"هذا على أساس سنوي، أليس كذلك؟"},{"who":"Camille","fr":"Oui, et autour de 2 % le mois précédent.","ar":"نعم، وكان نحو 2 % في الشهر السابق."},{"who":"Thomas","fr":"Donc on parle d’un ralentissement, pas d’une baisse.","ar":"إذن نتحدث عن تباطؤ لا عن انخفاض."}]},{"title":"Titre à sensation","ctx":"صحفيان يعدّلان عنواناً اقتصادياً قبل النشر","lines":[{"who":"Sarah","fr":"Le titre annonce une explosion de la dette.","ar":"العنوان يعلن انفجاراً في الدين."},{"who":"Karim","fr":"Or la dette passe de 110 à 112 % du PIB : c’est une hausse lente.","ar":"بينما ينتقل الدين من 110 إلى 112 % من الناتج: إنه ارتفاع بطيء."},{"who":"Sarah","fr":"Alors on écrit « la dette progresse modestement ».","ar":"إذن نكتب « يتقدم الدين بمقدار متواضع »."},{"who":"Karim","fr":"Exact, et on cite la source du chiffre.","ar":"بالضبط، ونذكر مصدر الرقم."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما معنى « le pouvoir d’achat »؟","opts":["القدرة الشرائية","معدل البطالة","الناتج المحلي الإجمالي","سعر الفائدة"],"a":0,"why":"pouvoir d’achat = ce que le revenu permet d’acheter بعد احتساب التضخّم."},{"t":"fill","skill":"grammar","q":"أكمل: «Selon l’Insee, l’inflation ___ à 2,1 %.»","fr":"Selon l’Insee, l’inflation ___ à 2,1 %.","ans":"s’établit","why":"le présent de l’information avec la locution « s’établir à »."},{"t":"order","skill":"writing","q":"رتّب: معدل النمو يبلغ 0,3 % في هذا الربع","words":["Le","taux","de","croissance","atteint","0,3 %","ce","trimestre."],"ans":"Le taux de croissance atteint 0,3 % ce trimestre.","why":"ordre sujet — verbe — COD — complément temporel."},{"t":"listen","skill":"listening","q":"ماذا تعني « en glissement annuel »؟","opts":["مقارنة مع نفس الفترة قبل سنة","مقارنة مع الشهر الماضي فقط","مقارنة مع le budget prévisionnel","مقارنة مع une autre devise"],"a":0,"why":"le glissement annuel compare la période au même mois de l’année précédente."},{"t":"translate","skill":"writing","q":"ترجم: «يتراجع التضخّم إلى 2,1 % على أساس سنوي.»","ans":"L’inflation recule à 2,1 % en glissement annuel.","why":"« en glissement annuel » تقابل « على أساس سنوي » مع nom féminin singulier."},{"t":"speaking","skill":"speaking","q":"قدّم مقطعاً إخبارياً اقتصادياً من ثلاث جمل مستعملاً « selon », « s’établit à », « devrait ».","target":"selon / s’établit à / devrait","why":"مزج الخبر المُعلن بـ le conditionnel de prévision في le registre économique."},{"t":"correct","skill":"grammar","q":"صحّح: «La désinflation signifie que les prix baissent.»","ans":"La désinflation signifie que les prix augmentent moins vite.","why":"la désinflation est un ralentissement de la hausse, pas une diminution des prix."},{"t":"mcq","skill":"reading","q":"أي عنوان أكثر دقة في نشرة اقتصادية؟","opts":["Les prix explosent en avril.","Les prix progressent légèrement en avril, selon l’Insee.","L’économie va mal.","Personne n’a de travail."],"a":1,"why":"il indique la tendance, la mesure et la source, ce qui rend le titre défendable."}],"homework":"اقرأ خبراً اقتصادياً من Les Échos أو France Inter، استخرج ثلاثة أرقام مع la période et la source لكل واحد، ثم أعد صياغة العنوان في جملتين بلهجة مُتحفّظة.","sources":[{"title":"Vocabulaire Économique Avancé : Comment Parler d’Économie en Français (Niveau C1)","channel":"Français Facile","videoId":"-8i8oIIZeWc","why":"حصّة مفردات متقدمة بمستوى C1: كيف تُستعمل les indicateurs économiques في الحديث، وكيف تنتقل من le langage quotidien إلى le registre prudentiel عند ذكر les chiffres.","cat":"Sciences","level":"C1","main":true},{"title":"Les différents types d’inflation - Explique-moi l’économie - Numéro 39","channel":"Explique-moi l’économie","videoId":"DisdftsvXqo","why":"تفصيل la notion d’inflation: inflation par la demande, par les coûts, importée — كيف يُستعمل le vocabulaire المُتحفّظ لوصف أسباب ارتفاع الأسعار.","cat":"Sciences","level":"C1","extra":true},{"title":"Tout comprendre au taux de croissance du PIB","channel":"Monsieur SES","videoId":"V2i9VJW8PUw","why":"كيف يُحسب taux de croissance فعلاً، ولماذا la base de calcul تغيّر معنى الرقم في le reportage.","cat":"Sciences","level":"C1","extra":true}],"supplements":[{"id":"DisdftsvXqo","title":"Les différents types d’inflation - Explique-moi l’économie - Numéro 39","channel":"Explique-moi l’économie","why":"تفصيل la notion d’inflation: inflation par la demande, par les coûts, importée — كيف يُستعمل le vocabulaire المُتحفّظ لوصف أسباب ارتفاع الأسعار.","lang":"fr","dur":18},{"id":"V2i9VJW8PUw","title":"Tout comprendre au taux de croissance du PIB","channel":"Monsieur SES","why":"كيف يُحسب taux de croissance فعلاً، ولماذا la base de calcul تغيّر معنى الرقم في le reportage.","lang":"fr","dur":13}]},{"id":"c1-t8-l3","fr":"Numérique et IA","ar":"الرقمي والذكاء الاصطناعي: قضايا أخلاقية ومفردات تقنية","objectives":["استعمال le vocabulaire technique C1: l’algorithme, le modèle, le biais, la donnée, l’entraînement","تحليل les axes du débat éthique: la vie privée, la transparence, la responsabilité, l’emploi","التمييز بين le discours prometteur وle discours critique انطلاقاً من les mêmes faits","صياغة موقف مُتحفّظ بـ le conditionnel et les locutions d’atténuation"],"sections":[{"h":"الدرس 3: الذكاء الاصطناعي بين الوعد والمخاطر","video":{"id":"Y4w_ltH_JFw","title":"Enjeux et éthique de l’IA - Formation découverte","channel":"CNRS - Formation FIDLE","why":"تكوين مؤسسي عن les enjeux éthiques de l’IA: la vie privée، la transparence، la responsabilité — كيف يُبنى le débat في le registre scientifique الفرنسي دون le sensationalisme.","lang":"fr","main":true,"dur":16},"p":["« Le numérique » يشير إلى l’ensemble des activités qui dépendent du traitement des données، أما « l’intelligence artificielle » فmachines وبرامج تتعلّم من البيانات لتُنتج قراراً أو توقّعاً: un système qui apprend à partir d’exemples.","les mots de base: l’algorithme est l’ensemble des règles suivies par la machine، وle modèle est le programme appris à partir de millions d’exemples، وla donnée هي المادة الخام، وl’entraînement هو مرحلة التعلّم نفسها.","le biais: quand les données de départ reflètent des déséquilibres، les systèmes les reproduisent. مثال: نموذج توظيف دُرّب على قرارات سابقة متحيّزة أعاد إنتاج التحيّز نفسه. القاعدة: un modèle reproduit ce qu’on lui apprend.","les enjeux éthiques: la vie privée (quelles données ?), la transparence (pourquoi cette décision ?), la responsabilité (qui répond ?), et la place du travail humain. le débat لا ينقسم بين technophiles et technophobes، بل يدور حول le niveau de contrôle.","le registre du débat: من الجملة المؤكدة « le modèle atteint des performances remarquables » إلى الجملة المقيّدة « ces performances restent limitées à des tâches précises ». la nuance ليست تردداً بل وصفاً دقيقاً لقدرة النظام.","للتمرين: اختر خبراً عن l’IA، وافصل بين le fait et la promesse، ثم اكتب فقرة من أربع جمل بـ le ton neutre تشرح le risque دون le catastrophisme."],"sub":[{"h":"les mots de la technique","p":["Un algorithme est une suite de règles précises.","Le modèle a été entraîné sur des millions de données.","Un biais dans les données produit une décision biaisée."]},{"h":"les enjeux éthiques","p":["Qui est responsable quand la machine se trompe ?","Les données personnelles doivent être protégées.","La décision doit pouvoir être expliquée."]},{"h":"prendre position avec nuance","p":["Cette technologie progresse vite, mais elle reste limitée.","Il est possible que les usages changent dans les années à venir.","Le débat porte sur le niveau de contrôle humain."]}]},{"h":"les formules du débat","p":["« Il reste à déterminer si… » — ouvrir la question sans la trancher.","« D’un côté… de l’autre… » — présenter les deux positions.","« Cette technologie pourrait… à condition que… » — lier la promesse à sa condition.","« Le débat porte sur… » — recentrer la question."]},{"h":"التطبيق والتلخيص","p":["تمرين le débat: اكتب فقرة من أربع جمل تعرض حولين حول استعمال l’IA في la prévention des accidents، بـ « d’un côté » و« de l’autre ».","تمرين le vocabulaire: صنّف عشرة مصطلحات من الدرس إلى ثلاث فئات: تقنية، أخلاقية، اقتصادية.","تمرين la nuance: حوّل الجملة المطلقة « L’IA va remplacer les médecins. » إلى جملة مُتحفّظة بـ le conditionnel مع ذكر la condition."]}],"pron":[{"w":"l’algorithme","ipa":"[la.lɡɔ.ʁitm]","approx":"الغوريطم"},{"w":"le biais","ipa":"[lə bjɛ]","approx":"لو بي"},{"w":"le modèle","ipa":"[lə mɔ.dɛl]","approx":"لو موديل"}],"vocab":[{"fr":"l’algorithme","ar":"الخوارزمية","pos":"nom","g":"m","exFr":"L’algorithme classe les résultats.","ipa":"[la.lɡɔ.ʁitm]","exAr":"رتّبت الخوارزمية النتائج."},{"fr":"le modèle","ar":"النموذج","pos":"nom","g":"m","exFr":"Le modèle a été entraîné sur des milliers de textes.","ipa":"[lə mɔ.dɛl]","exAr":"دُرّب النموذج على آلاف النصوص."},{"fr":"la donnée","ar":"المعطى أو البيانات","pos":"nom","g":"f","exFr":"La donnée personnelle est protégée.","ipa":"[dɔ.ne]","exAr":"المعطى الشخصي محمي."},{"fr":"l’entraînement","ar":"التدريب","pos":"nom","g":"m","exFr":"L’entraînement demande beaucoup de calcul.","ipa":"[ɑ̃.tʁɛn.mɑ̃]","exAr":"التدريب يتطلب حساباً كثيراً."},{"fr":"le biais","ar":"التحيّز","pos":"nom","g":"m","exFr":"Ce modèle contient un biais.","ipa":"[lə bjɛ]","exAr":"يحتوي هذا النموذج على تحيّز."},{"fr":"la transparence","ar":"الشفافية","pos":"nom","g":"f","exFr":"La transparence du système reste faible.","ipa":"[tʁɑ̃.spɑ.ʁɑ̃s]","exAr":"تبقى شفافية النظام ضعيفة."},{"fr":"la vie privée","ar":"الخصوصية","pos":"loc.","g":"f","exFr":"La vie privée est en jeu.","ipa":"[vi pʁi.ve]","exAr":"الخصوصية على المحك."},{"fr":"la responsabilité","ar":"المسؤولية","pos":"nom","g":"f","exFr":"La responsabilité du fabricant est engagée.","ipa":"[ʁɛ̃.spo.sa.bi.li.te]","exAr":"تتحمّل مسؤولية الصانع."},{"fr":"prédire","ar":"يتنبأ","pos":"verbe","g":"","exFr":"Le système prédit le trafic.","ipa":"[pʁe.diʁ]","exAr":"يتنبأ النظام بحركة السير."},{"fr":"automatiser","ar":"يؤتمت المهمة","pos":"verbe","g":"","exFr":"Cette tâche peut être automatisée.","ipa":"[ɔ.tɔ.ma.ti.ze]","exAr":"يمكن أتمتة هذه المهمة."},{"fr":"un usage","ar":"الاستخدام","pos":"nom","g":"m","exFr":"Les usages évoluent rapidement.","ipa":"[y.zaʒ]","exAr":"تطورت الاستخدامات بسرعة."},{"fr":"encadrer","ar":"ينظّم ويحدّ","pos":"verbe","g":"","exFr":"Il faut encadrer ces pratiques.","ipa":"[ɑ̃.ka.dʁe]","exAr":"يجب تنظيم هذه الممارسات."}],"examples":[{"fr":"L’algorithme classe les demandes par priorité.","ar":"ترتّب الخوارزمية الطلبات حسب الأولوية.","note":"le vocabulaire technique"},{"fr":"Ce modèle a été entraîné sur des données publiques.","ar":"دُرّب هذا النموذج على بيانات منشورة.","note":"le passif composé"},{"fr":"Un biais dans les données produit une décision biaisée.","ar":"تحيّز في البيانات ينتج قراراً متحيّزاً.","note":"la chaîne causale"},{"fr":"Il reste à déterminer si ce système est fiable.","ar":"يتعيّن بعد تحديد ما إذا كان هذا النظام موثوقاً.","note":"la tournure impersonnelle"},{"fr":"D’un côté, l’IA accélère le diagnostic ; de l’autre, elle multiplie les risques d’erreur.","ar":"من جهة، يسرّع الذكاء الاصطناعي التشخيص؛ ومن جهة أخرى يضاعف مخاطر الخطأ.","note":"la confrontation"},{"fr":"Le débat porte sur le niveau de contrôle humain.","ar":"يدور النقاش حول مستوى الرقابة البشرية.","note":"la reformulation de la question"}],"grammar":[{"tFr":"Le conditionnel de mise à distance et les tournures impersonnelles","tAr":"المضارع الشرطي عن بُعد والصيغ غير الشخصية","body":["Face à une technologie dont les effets ne sont pas mesurés, on emploie « il est possible que » + subjonctif, « pourrait » + infinitif, « il reste à déterminer si… ». Ces tournures séparent le fait de l’interprétation.","Le futur simple affirme une tendance : « les modèles seront plus grands ». Le choix temporel indique la confiance : le présent constate, le conditionnel suppose, le futur prévoit."],"ex":[{"fr":"Il est possible que ces modèles améliorent le diagnostic.","ar":"من المحتمل أن تحسّن هذه النماذج التشخيص."},{"fr":"Le prochain modèle sera entraîné sur davantage de données.","ar":"سيُدرَّب النموذج القادم على بيانات أكثر."}]},{"tFr":"La nominalisation technique et la voix passive","tAr":"الاسم التقني والمبني للمجهول في الخطاب الرقمي","body":["Le discours technique préfère les noms d’action : « l’apprentissage automatique » au lieu de « la machine apprend ». Le style devient concis et impersonnel, propre aux articles techniques.","La voix passive masque l’acteur : « des données ont été collectées ». En contexte éthique, on le rend explicite : « des données ont été collectées par l’application » — c’est là que se joue la responsabilité."],"ex":[{"fr":"L’apprentissage automatique repose sur de grandes quantités de données.","ar":"يعتمد التعلّم الآلي على كميات كبيرة من البيانات."},{"fr":"Des données ont été collectées par l’application sans consentement.","ar":"جُمعت بيانات من التطبيق دون موافقة."}]}],"mistakes":[{"wrong":"l’IA comprend comme un humain","right":"l’IA traite des données et produit des résultats","why":"comprendre suppose une conscience, un modèle traite et prédit — الفهم يقتضي وعياً بينما النموذج يعالج ويتوقّع."},{"wrong":"ce résultat prouve que l’algorithme est neutre","right":"ce résultat suggère que l’algorithme performe sur cette tâche","why":"un test unique ne couvre pas tous les cas — الاختبار الواحد لا يغطي كل الحالات."},{"wrong":"confondre donnée personnelle et donnée publique","right":"préciser la nature et la source des données","why":"la protection dépend du statut de la donnée — الحماية تعتمد على طبيعة المعطى."},{"wrong":"un outil libre de tout biais","right":"un outil dont les biais doivent être mesurés","why":"aucun système formé sur des données humaines n’en est exempt — لا نظام مُدرَّب على بيانات بشرية خالٍ من التحيّز."}],"dialogues":[{"title":"Débat en rédaction","ctx":"فريق تحرير يناقش مقالاً عن الذكاء الاصطناعي","lines":[{"who":"Nora","fr":"L’article dit que l’IA remplacera des milliers d’emplois.","ar":"يقول المقال إن الذكاء الاصطناعي سيحل محل آلاف الوظائف."},{"who":"Yanis","fr":"Attention, c’est une prévision, pas un chiffre publié.","ar":"انتبه، هذا توقّع لا رقم منشور."},{"who":"Nora","fr":"Alors je note : « pourrait affecter certains emplois ».","ar":"إذن أكتب: « قد يؤثر على بعض الوظائف »."},{"who":"Yanis","fr":"Et on cite l’étude qui est à l’origine du chiffre.","ar":"ونذكر الدراسة التي أتى بها الرقم."}]},{"title":"Une question de contrôle","ctx":"مواطن يسأل مهندسة عن قرار آلي","lines":[{"who":"Amine","fr":"La banque a refusé mon dossier automatiquement.","ar":"رفض البنك ملفي آلياً."},{"who":"Claire","fr":"Vous pouvez demander l’explication de la décision.","ar":"يمكنك طلب تفسير القرار."},{"who":"Amine","fr":"Donc quelqu’un peut contester ?","ar":"إذن يمكن للشخص الاعتراض؟"},{"who":"Claire","fr":"Oui, c’est le principe d’un contrôle humain.","ar":"نعم، هذا مبدأ الرقابة البشرية."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما معنى « le biais » في نموذج ذكاء اصطناعي؟","opts":["تحيّز منهجي في البيانات أو النتائج","سرعة المعالجة","سعر الاشتراك","خيار في القائمة"],"a":0,"why":"biais = distorsion systématique due aux données ou à la conception du système."},{"t":"fill","skill":"grammar","q":"أكمل: «Il est possible que ce modèle ___ (reproduire) des biais.»","fr":"Il est possible que ce modèle ___ des biais.","ans":"reproduise","why":"le subjonctif est obligatoire après « il est possible que »."},{"t":"order","skill":"writing","q":"رتّب: دُرّب النموذج على بيانات منشورة","words":["Le","modèle","a","été","entraîné","sur","des","données","publiques."],"ans":"Le modèle a été entraîné sur des données publiques.","why":"le passif composé: être + participe passé + agent introduit par « par »."},{"t":"listen","skill":"listening","q":"ماذا يعني « le contrôle humain » في سياق l’IA؟","opts":["قدرة شخص على مراجعة قرار الآلة","إيقاف الخادم كلياً","حذف كل البيانات","منع أي استخدام"],"a":0,"why":"le contrôle humain = la possibilité d’examiner une décision automatisée."},{"t":"translate","skill":"writing","q":"ترجم: «من المحتمل أن تغيّر هذه التقنيات طريقة عملنا.»","ans":"Il est possible que ces techniques changent notre façon de travailler.","why":"« il est possible que » يُتبع بالفعل في le subjonctif."},{"t":"speaking","skill":"speaking","q":"عبّر عن رأيك في استخدام l’IA في التوظيف في ثلاث جمل بـ le conditionnel.","target":"pourrait / il est possible que / cependant","why":"إنتاج موقف مُتحفّظ مع الحفاظ على le registre soutenu."},{"t":"correct","skill":"grammar","q":"صحّح: «L’IA comprend parfaitement le français.»","ans":"L’IA traite le texte et produit des réponses en français.","why":"comprendre implique une conscience : un modèle traite et prédit."},{"t":"mcq","skill":"reading","q":"أي صياغة أدق لنتيجة دراسة عن الذكاء الاصطناعي؟","opts":["L’IA détecte le cancer mieux que les médecins.","L’IA a détecté certains cancers avec une précision comparable dans cette étude.","Les médecins seront remplacés.","L’IA ne se trompe jamais."],"a":1,"why":"elle limite la conclusion au contexte de l’étude, ce qui rend le propos défendable."}],"homework":"اختر مقالاً عن l’IA من Le Monde أو Usine Nouvelle، استخرج خمسة مصطلحات تقنية مع تعريفها، ثم اكتب فقرة من خمس جمل تعرض le débat بـ la nuance.","sources":[{"title":"Enjeux et éthique de l’IA - Formation découverte","channel":"CNRS - Formation FIDLE","videoId":"Y4w_ltH_JFw","why":"تكوين مؤسسي عن les enjeux éthiques de l’IA: la vie privée، la transparence، la responsabilité — كيف يُبنى le débat في le registre scientifique الفرنسي دون le sensationalisme.","cat":"Sciences","level":"C1","main":true},{"title":"Objectif IA : Identifiez les enjeux éthiques de l’intelligence artificielle","channel":"institutmontaigne","videoId":"vDMv78mkc4o","why":"عرض مركّز لأربعة أطراف أخلاقية: le biais, la vie privée, la transparence, la responsabilité — تلخيص مثالي للمناقشة.","cat":"Sciences","level":"C1","extra":true},{"title":"Pourquoi l’intelligence artificielle a besoin d’éthique","channel":"Le Monde","videoId":"tf4-_4IbXPs","why":"تحليل صحفي قصير: كيف يُصاغ le débat الأخلاقي في le registre médiatique الفرنسي مع le vocabulaire الدقيق.","cat":"Sciences","level":"C1","extra":true}],"supplements":[{"id":"vDMv78mkc4o","title":"Objectif IA : Identifiez les enjeux éthiques de l’intelligence artificielle","channel":"institutmontaigne","why":"عرض مركّز لأربعة أطراف أخلاقية: le biais, la vie privée, la transparence, la responsabilité — تلخيص مثالي للمناقشة.","lang":"fr","dur":3},{"id":"tf4-_4IbXPs","title":"Pourquoi l’intelligence artificielle a besoin d’éthique","channel":"Le Monde","why":"تحليل صحفي قصير: كيف يُصاغ le débat الأخلاقي في le registre médiatique الفرنسي مع le vocabulaire الدقيق.","lang":"fr","dur":6}]},{"id":"c1-t8-l4","fr":"Santé publique","ar":"الصحة العامة: الوقاية والتجارب السريرية ولغة التحذّر الطبي","objectives":["التمييز بين les trois niveaux de prévention مع أمثلة واقعية","قراءة نتيجة دراسة سريرية: l’essai randomisé, le groupe témoin, l’effet mesuré","التفريق بين la corrélation وla causalité في le discours médical","استعمال le langage de la prudence: « n’a pas montré », « n’exclut pas », « il est recommandé de »"],"sections":[{"h":"الدرس 4: كيف يقول الطبيب ما لم يُثبته بعد","video":{"id":"GF_IRJhvOLk","title":"#TSTSS - Cours  -Les principes de prévention en santé publique","channel":"Sandrine DINNAT DURUPT","why":"عرض مدرسي لـ les niveaux de prévention: primaire, secondaire, tertiaire مع le vocabulaire الدقيق الذي يستعمله le discours de santé publique في فرنسا.","lang":"fr","main":true,"dur":7},"p":["« La santé publique » تتعامل مع السكان لا مع المريض المنفرد: le chiffre, le risque, la population. لذلك يتغيّر le discours: لا يُقال « vous serez malade » بل « le risque augmente de… ».","les trois niveaux de prévention: la prévention primaire تمنع قبل الوقوع مثل le vaccin وl’hygiène، وla prévention secondaire تكتشف مبكراً مثل le dépistage، وla prévention tertiaire تقلّل les séquelles مثل la rééducation.","l’essai clinique randomisé: يُوزَّع المرضى عشوائياً بين le groupe traité وle groupe témoin. le vocabulaire: la randomisation, le placebo, l’essai en double aveugle, les effets indésirables.","la corrélation لا تعني السببية: « les personnes qui dorment peu présentent plus de risques » ليست دليلاً على أن قلة النوم تسبّب المرض. la règle: لغة الارتباط لا تُستعمل يوماً كلغة للسببية.","la prétérition الدقيقة هي أساس la déontologie: « n’a pas montré d’effet » ليست « a prouvé l’absence d’effet »، و« n’exclut pas un risque faible » تُبقي الفرضية مفتوحة. الفرق بين الجملتين فرق بين العلم وجهل الدراسة.","للتمرين: اقرأ نشرة صحية وحدّد: ما الادعاء؟ ما حجم العينة؟ ما المصدر؟ ثم أعد صياغة الادعاء بـ le conditionnel médical في جملتين."],"sub":[{"h":"les niveaux de prévention","p":["La prévention primaire vise à éviter la maladie.","Le dépistage permet de détecter tôt.","La rééducation réduit les séquelles."]},{"h":"ce que dit une étude","p":["L’essai randomisé compare deux groupes.","Le groupe témoin reçoit le placebo.","L’effet mesuré reste modeste."]},{"h":"dire sans affirmer","p":["Cette étude n’a pas montré d’effet significatif.","Ces données n’excluent pas un risque faible.","Les résultats suggèrent une amélioration."]}]},{"h":"les formules du discours médical prudent","p":["« Cette étude n’a pas montré que… » — informer sans conclure.","« N’exclut pas… » — garder l’hypothèse ouverte.","« Les données actuelles suggèrent que… » — s’appuyer sur l’état des recherches.","« Il est recommandé de… » — formuler un conseil sans ordre."]},{"h":"التطبيق والتلخيص","p":["تمرين la prévention: اشرح بالفرنسية الفرق بين la prévention primaire وla prévention secondaire في ثلاث جمل.","تمرين la corrélation: حوّل جملة سببية غير مثبتة « Le manque de sommeil cause le diabète. » إلى جملة ارتباطية دقيقة.","تمرين le conseil: اكتب ثلاث توصيات صحية بـ « il est recommandé de… » بدلاً من « vous devez… »، ثم علّل le choix."]}],"pron":[{"w":"l’essai clinique","ipa":"[le sɛ.si kli.nik]","approx":"لو سيسي كلينيك"},{"w":"la prévention","ipa":"[la pʁe.vɑ̃sjɔ̃]","approx":"لا بريڤاسيون"},{"w":"le placebo","ipa":"[lə pla.sɛ.bo]","approx":"لو بلاسيبو"}],"vocab":[{"fr":"la prévention","ar":"الوقاية","pos":"nom","g":"f","exFr":"La prévention commence par l’hygiène.","ipa":"[pʁe.vɑ̃sjɔ̃]","exAr":"تبدأ الوقاية بالنظافة."},{"fr":"le dépistage","ar":"الفحص المبكر","pos":"nom","g":"m","exFr":"Le dépistage est proposé dès cinquante ans.","ipa":"[de.pis.taʒ]","exAr":"يُقترح الفحص المبكر ابتداءً من خمسين سنة."},{"fr":"l’essai clinique","ar":"التجربة السريرية","pos":"loc.","g":"m","exFr":"Les essais cliniques ont débuté en janvier.","ipa":"[le sɛ.si kli.nik]","exAr":"بدأت التجارب السريرية في كانون الثاني."},{"fr":"le groupe témoin","ar":"مجموعة الضبط","pos":"loc.","g":"m","exFr":"Le groupe témoin n’a reçu qu’un placebo.","ipa":"[ɡʁup te.mwɛ̃]","exAr":"لم يتلقَّ مجموعة الضبط سوى دواء وهمي."},{"fr":"le placebo","ar":"الدواء الوهمي","pos":"nom","g":"m","exFr":"Le placebo permet de mesurer l’effet réel.","ipa":"[lə pla.sɛ.bo]","exAr":"يتيح الدواء الوهمي قياس الأثر الحقيقي."},{"fr":"la randomisation","ar":"التوزيع العشوائي","pos":"nom","g":"f","exFr":"La randomisation évite les biais.","ipa":"[ʁɑ̃.dɔ.ma.liza.sjɔ̃]","exAr":"يتجنّب التوزيع العشوائي التحيّزات."},{"fr":"un risque","ar":"الخطر","pos":"nom","g":"m","exFr":"Le risque augmente avec l’âge.","ipa":"[ʁisk]","exAr":"يزداد الخطر مع التقدّم بالعمر."},{"fr":"un effet indésirable","ar":"أثر غير مرغوب","pos":"loc.","g":"m","exFr":"Les effets indésirables sont rares ici.","ipa":"[e.fɛ ɛ̃.de.zi.ʁabl]","exAr":"تندر الآثار غير المرغوبة هنا."},{"fr":"une recommandation","ar":"التوصية","pos":"nom","g":"f","exFr":"La recommandation s’adresse à tous.","ipa":"[ʁə.kɔ.mɑ̃.da.sjɔ̃]","exAr":"تُوجَّه التوصية إلى الجميع."},{"fr":"n’a pas montré","ar":"لم يُظهر","pos":"loc.","g":"v","exFr":"L’étude n’a pas montré d’effet.","ipa":"[na pa mɔ̃.tʁe]","exAr":"لم تُظهر الدراسة أثراً."},{"fr":"la corrélation","ar":"الارتباط الإحصائي","pos":"nom","g":"f","exFr":"La corrélation n’implique pas la causalité.","ipa":"[kɔ.ʁe.la.sjɔ̃]","exAr":"لا يعني الارتباط الإحصائي السببية."},{"fr":"la causalité","ar":"العلاقة السببية","pos":"nom","g":"f","exFr":"Établir la causalité demande plusieurs études.","ipa":"[kɔ.zal.li.te]","exAr":"تستلزم إثبات العلاقة السببية عدة دراسات."}],"examples":[{"fr":"La prévention primaire vise à éviter l’apparition de la maladie.","ar":"تهدف الوقاية الأولية إلى منع ظهور المرض.","note":"les niveaux de prévention"},{"fr":"Les essais cliniques ont été menés sur 2 000 patients.","ar":"أُجريت التجارب السريرية على 2 000 مريض.","note":"la voix passive et l’échantillon"},{"fr":"Cette étude n’a pas montré d’effet significatif.","ar":"لم تُظهر هذه الدراسة أثراً ذا دلالة إحصائية.","note":"dire sans affirmer"},{"fr":"La corrélation n’implique pas la causalité.","ar":"لا يعني الارتباط السببية.","note":"la distinction méthodologique"},{"fr":"Il est recommandé de faire vérifier sa tension.","ar":"يُنصح بفحص ضغط الدم.","note":"l’injonction indirecte"},{"fr":"Le risque augmente de 20 % chez les fumeurs.","ar":"يزداد الخطر بنسبة 20 % عند المدخنين.","note":"la quantification du risque"}],"grammar":[{"tFr":"La négation du passé composé et la prétérition médicale","tAr":"النفي في المضارع التام وفن الإفلات في الخطاب الطبي","body":["Le discours médical distingue trois degrés : « n’a pas montré d’effet » (l’étude n’a rien détecté), « n’a pas prouvé l’absence d’effet » (on ne peut rien conclure), « a prouvé l’absence d’effet » (conclusion négative établie). Le troisième degré exige plusieurs études convergentes.","Les tournures négatives évitent l’affirmation : « il n’existe pas de preuve que… », « rien ne permet d’affirmer que… ». Elles laissent l’hypothèse ouverte sans trancher."],"ex":[{"fr":"L’étude n’a pas montré d’effet sur la fatigue.","ar":"لم تُظهر الدراسة أثراً على الإرهاق."},{"fr":"Rien ne permet d’affirmer que ce traitement est supérieur.","ar":"لا شيء يسمح بالتأكيد أن هذا العلاج أفضل."}]},{"tFr":"L’impératif de conseil et ses atténuations","tAr":"أمر النصح وطرق تلطيفه","body":["On évite l’impératif direct au profit de la voix impersonnelle : « il est recommandé de… », « il convient de… », « il serait préférable de… ». Le conseil reste ferme, mais respecte l’autonomie du patient.","La gradation des verbes exprime la force du message : on propose, on suggère, on recommande, on déconseille. Le choix du verbe vaut déjà un jugement."],"ex":[{"fr":"Il est recommandé de réduire la consommation de sel.","ar":"يُنصح بتقليل استهلاك الملح."},{"fr":"Il serait préférable d’attendre un nouvel avis médical.","ar":"يُفضَّل انتظار رأي طبي جديد."}]}],"mistakes":[{"wrong":"Cette étude prouve que le médicament est efficace.","right":"Cette étude suggère un effet à confirmer.","why":"une étude isolée ne suffit pas à établir une preuve — الدراسة المعزولة لا تكفي لإثبات اليقين."},{"wrong":"L’obésité cause le diabète.","right":"L’obésité est associée à un risque accru de diabète.","why":"l’association statistique n’établit pas le lien de causalité — الارتباط الإحصائي لا يثبت علاقة السببية."},{"wrong":"confondre prévention primaire et dépistage","right":"le dépistage est la prévention secondaire","why":"le primaire prévient l’apparition, le secondaire détecte tôt — الأولي تمنع الظهور والثاني يكتشف مبكراً."},{"wrong":"Il faut arrêter le traitement immédiatement.","right":"Il est recommandé de demander l’avis de son médecin.","why":"le discours médical public ne donne pas d’ordre direct — الخطاب الطبي العام لا يصدر أوامر مباشرة."}],"dialogues":[{"title":"Consultation après une étude","ctx":"طبيبة تشرح نتيجة دراسة لمرضاها","lines":[{"who":"Dr Martins","fr":"Une nouvelle étude montre un effet sur la fatigue.","ar":"تُظهر دراسة جديدة أثراً على الإرهاق."},{"who":"Patiente","fr":"Alors le traitement marche ?","ar":"إذن هل ينجح العلاج؟"},{"who":"Dr Martins","fr":"Les données suggèrent un effet modeste, à confirmer.","ar":"تقيّح البيانات أثراً متواضعاً يحتاج إلى تأكيد."},{"who":"Patiente","fr":"Je poursuis donc en attendant ?","ar":"أتابع إذن في الانتظار؟"}]},{"title":"Le dépistage","ctx":"ممرضة تشرح برنامج فحص لمرضة","lines":[{"who":"Salomé","fr":"Le dépistage est proposé à partir de cinquante ans.","ar":"يُقترح الفحص المبكر ابتداءً من خمسين سنة."},{"who":"Youssef","fr":"Et si le résultat est faux ?","ar":"وإذا كانت النتيجة خاطئة؟"},{"who":"Salomé","fr":"Un test positif n’équivaut pas au diagnostic.","ar":"الاختبار الإيجابي لا يعادل التشخيص."},{"who":"Youssef","fr":"Donc il faut un second examen.","ar":"إذن يلزم فحص ثانٍ."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما المقصود بـ « le dépistage »؟","opts":["الكشف المبكر عن المرض قبل ظهور الأعراض","علاج المرض بمراحله المتقدمة","إجراء عملية جراحية","نشر توعية صحية"],"a":0,"why":"le dépistage est la prévention secondaire: détecter tôt, avant les symptômes."},{"t":"fill","skill":"grammar","q":"أكمل: «Il est recommandé de ___ (faire) vérifier sa tension.»","fr":"Il est recommandé de ___ vérifier sa tension.","ans":"faire","why":"après « il est recommandé de », on garde le verbe à l’infinitif."},{"t":"order","skill":"writing","q":"رتّب: لم تُظهر الدراسة أثراً ذا دلالة","words":["Cette","étude","n’a","pas","montré","d’effet","significatif."],"ans":"Cette étude n’a pas montré d’effet significatif.","why":"la négation « ne … pas » encadre l’auxiliaire et le participe."},{"t":"listen","skill":"listening","q":"ما وظيفة « le groupe témoin » في التجربة السريرية؟","opts":["أنه لم يتلقَّ العلاج الفعلي ويُقارن به","أنه تلقى جرعة مضاعفة","أنه يضمّ المتطوعين فقط","أنه يُختار حسب عمر المرضى"],"a":0,"why":"le groupe témoin reçoit le placebo ou les soins usuels et sert de référence."},{"t":"translate","skill":"writing","q":"ترجم: «لم تُظهر الدراسة أثراً على التعب.»","ans":"L’étude n’a pas montré d’effet sur la fatigue.","why":"la négation au passé composé: « n’a pas montré »."},{"t":"speaking","skill":"speaking","q":"اشرح لصديق الفرق بين la prévention primaire وla prévention secondaire في ثلاث جمل.","target":"primaire / secondaire / dépistage","why":"استعمال le vocabulaire de la santé publique في سياق شفوي."},{"t":"correct","skill":"grammar","q":"صحّح: «Cette étude prouve que le médicament guérit.»","ans":"Cette étude suggère que le médicament pourrait aider.","why":"une étude isolée suggère, elle ne prouve pas."},{"t":"mcq","skill":"reading","q":"أي عبارة تقدّم نصاً صحياً بدقة؟","opts":["Le manque de sommeil cause le diabète.","Le manque de sommeil est associé à un risque accru de diabète.","Dormir peu rend diabétique.","Personne ne doit dormir moins de six heures."],"a":1,"why":"« est associé à » exprime la corrélation sans prétendre à la causalité."}],"homework":"اقرأ تقريراً من Santé publique France بالفرنسية، اكتب خمس جمل: ثلاث تصف ما وُجد فعلاً، واثنتان تقيّدان حدود الدراسة بـ le conditionnel.","sources":[{"title":"#TSTSS - Cours  -Les principes de prévention en santé publique","channel":"Sandrine DINNAT DURUPT","videoId":"GF_IRJhvOLk","why":"عرض مدرسي لـ les niveaux de prévention: primaire, secondaire, tertiaire مع le vocabulaire الدقيق الذي يستعمله le discours de santé publique في فرنسا.","cat":"Sciences","level":"C1","main":true},{"title":"Qu’est-ce qu’un essai clinique ? Place au lexique !","channel":"Filière de santé FAI²R","videoId":"4AmV7hgN22g","why":"le lexique الكامل للتجربة السريرية: la randomisation, le groupe témoin, le double aveugle — أساس فهم le discours des études.","cat":"Sciences","level":"C1","extra":true},{"title":"Tout comprendre aux corrélations et à la causalité","channel":"Monsieur SES","videoId":"SCWk-_wh-VY","why":"التمييز المنهجي بين الارتباط والسببية، وهو الخطأ الأشهر في le reportage de santé.","cat":"Sciences","level":"C1","extra":true}],"supplements":[{"id":"4AmV7hgN22g","title":"Qu’est-ce qu’un essai clinique ? Place au lexique !","channel":"Filière de santé FAI²R","why":"le lexique الكامل للتجربة السريرية: la randomisation, le groupe témoin, le double aveugle — أساس فهم le discours des études.","lang":"fr","dur":14},{"id":"SCWk-_wh-VY","title":"Tout comprendre aux corrélations et à la causalité","channel":"Monsieur SES","why":"التمييز المنهجي بين الارتباط والسببية، وهو الخطأ الأشهر في le reportage de santé.","lang":"fr","dur":12}]},{"id":"c1-t8-l5","fr":"Environnement et climat","ar":"البيئة والمناخ: البيانات والسيناريوهات وخطاب الاستعجال مع التحفظ","objectives":["قراءة le scénario المناخي: l’hypothèse d’émissions, l’horizon temporel, la trajectoire","فهم le discours de l’urgence إلى جانب le discours de la nuance: « selon les modèles », « en l’absence de mesures »","التمييز بين le constat (données passées) وla projection (résultats de modèles)","استعمال le vocabulaire: le réchauffement, les émissions, l’atténuation, l’adaptation, la trajectoire"],"sections":[{"h":"الدرس 5: كيف تُقرأ بيانات المناخ وسيناريوهات المستقبل","video":{"id":"3ATgMqjPoO0","title":"Les scénarios climatiques","channel":"UVED","why":"شرح أكاديمي لـ les scénarios climatiques: كيف يُبنى le scénario من hypothèse إلى trajectoire، ولماذا la projection ليست une prévision.","lang":"fr","main":true,"dur":10},"p":["بيانات المناخ ليست توقّعاً: les mesures passées — la température, le niveau de la mer — هي le constat، وles projections sont les résultats des modèles. la règle: فصل الماضي عن المستقبل في كل جملة.","les scénarios ترقيم دولي عند le GIEC، من مسار منخفض الانبعاثات إلى مسار مرتفع، وكل واحد يفترض مساراً مختلفاً للاختيارات البشرية. التعبير الدقيق: « sous un scénario d’émissions élevées… ».","la modélisation: النماذج تحسب أثر الغازات على الحرارة، وهي لا تتنبأ بالطقس في يوم معيّن بل تعطي اتجاهات على عقود. الفرق: la prévision météorologique قصيرة المدى، la projection climatique طويلة المدى.","le discours de l’urgence يقول: « il reste peu de temps », « un point de bascule approche ». هذه لغة la mobilisation، وهي مشروطة بالرجوع إلى la mesure وإلا تحوّلت إلى l’alarmisme.","le discours de la nuance يقول: « selon les modèles utilisés », « avec une marge d’incertitude de… », « en l’absence de nouvelles mesures ». الاعتراف بعدم اليقين يزيد la crédibilité ولا يُضعف la précision.","للتمرين: اقرأ تقريراً من le GIEC أو من Le Monde، واكتب ثلاث جمل: واحدة للبيان المقيس، واحدة للسيناريو، وواحدة للقيد المنهجي، ثم راجع le ton كلمة كلمة."],"sub":[{"h":"le constat et la projection","p":["Les mesures confirment un réchauffement.","Les projections dépendent des scénarios d’émissions.","Un modèle donne une tendance, pas une date."]},{"h":"les scénarios du GIEC","p":["Sous un scénario d’émissions faibles, la hausse reste limitée.","Sous un scénario élevé, elle dépasse deux degrés.","Chaque scénario suppose des choix humains."]},{"h":"urgence et nuance","p":["Il est urgent d’agir, selon les données disponibles.","Les modèles comportent une marge d’incertitude.","En l’absence de mesures, la tendance se poursuit."]}]},{"h":"les formules de la projection","p":["« Sous un scénario d’émissions élevées… » — situer l’hypothèse de départ.","« D’ici 2050… » — fixer un horizon temporel.","« Selon les modèles utilisés… » — citer la méthode.","« En l’absence de mesures… » — indiquer la condition de la projection."]},{"h":"التطبيق والتلخيص","p":["تمرين la projection: اكتب جملة تصف ما وقع في الماضي، وجملة تصف ما قد يقع في 2050 مع le conditionnel.","تمرين le ton: قارن عنواناً صحفياً « La planète brûle ! » مع عنوان أكاديمي « Le réchauffement progresse selon les mesures. »: ما الفرق في le registre؟","تمرين le vocabulaire: استعمل « atténuation » و« adaptation » في جملتين توضيحيتين تشرحان الفرق بينهما."]}],"pron":[{"w":"le scénario","ipa":"[lə se.na.ʁjo]","approx":"لو سيناريو"},{"w":"l’horizon","ipa":"[lɔ.ʁizɔ̃]","approx":"لوريزون"},{"w":"le réchauffement","ipa":"[lə ʁe.ʃɔ.fmɑ̃]","approx":"لو ريشوفون"}],"vocab":[{"fr":"le scénario","ar":"السيناريو أو المسار المفترض","pos":"nom","g":"m","exFr":"C’est le scénario le plus pessimiste.","ipa":"[lə se.na.ʁjo]","exAr":"هذا السيناريو الأكثر تشاؤماً."},{"fr":"une projection","ar":"الإسقاط أو التنبؤ الممتد","pos":"nom","g":"f","exFr":"Une projection à l’horizon 2100.","ipa":"[pʁɔ.ʒɛk.sjɔ̃]","exAr":"إسقاط حتى أفق 2100."},{"fr":"les émissions","ar":"الانبعاثات","pos":"nom","g":"f","exFr":"Les émissions de gaz à effet de serre diminuent.","ipa":"[e.mjɔ̃]","exAr":"تنخفض انبعاثات الغازات الدفيئة."},{"fr":"le réchauffement","ar":"الاحتباس الحراري","pos":"nom","g":"m","exFr":"Le réchauffement se poursuit.","ipa":"[ʁe.ʃɔ.fmɑ̃]","exAr":"يستمر الاحتباس الحراري."},{"fr":"l’incertitude","ar":"عدم اليقين","pos":"nom","g":"f","exFr":"Les modèles comportent une marge d’incertitude.","ipa":"[ɛ̃.sɛʁ.tityd]","exAr":"تحمل النماذج هامشاً من عدم اليقين."},{"fr":"l’atténuation","ar":"خفض الانبعاثات","pos":"nom","g":"f","exFr":"L’atténuation vise à réduire les émissions.","ipa":"[a.tɛ.nua.sjɔ̃]","exAr":"يهدف التخفيف إلى تقليل الانبعاثات."},{"fr":"l’adaptation","ar":"التكيّف","pos":"nom","g":"f","exFr":"L’adaptation protège les populations.","ipa":"[a.dap.ta.sjɔ̃]","exAr":"يحمي التكيّف السكان."},{"fr":"la trajectoire","ar":"المسار","pos":"nom","g":"f","exFr":"Une trajectoire compatible avec 1,5 °C.","ipa":"[tʁa.ʒɛk.twaʁ]","exAr":"مسار متوافق مع 1,5 درجة."},{"fr":"un point de bascule","ar":"نقطة تحوّل","pos":"loc.","g":"m","exFr":"Nous approchons d’un point de bascule.","ipa":"[pwɛ̃ də baskyl]","exAr":"نقترب من نقطة تحوّل."},{"fr":"mesurer","ar":"يقيس","pos":"verbe","g":"","exFr":"La température est mesurée depuis 1850.","ipa":"[mə.sy.ʁe]","exAr":"تُقاس الحرارة منذ 1850."},{"fr":"selon les modèles","ar":"وفقًا للنماذج","pos":"loc.","g":"","exFr":"Selon les modèles, la hausse atteindra 3 °C.","ipa":"[sə.lɔ̃ le mɔ.dɛl]","exAr":"وفقًا للنماذج سيبلغ الارتفاع 3 درجات."},{"fr":"en l’absence de mesures","ar":"في غياب الإجراءات","pos":"loc.","g":"","exFr":"En l’absence de mesures, la tendance se poursuit.","ipa":"[ɑ̃ lapsɑ̃s də məzyʁ]","exAr":"في غياب الإجراءات يستمر الاتجاه."}],"examples":[{"fr":"Sous un scénario d’émissions élevées, le réchauffement dépasse 3 °C.","ar":"ضمن سيناريو انبعاثات مرتفعة، يتجاوز الاحتباس 3 درجات.","note":"l’hypothèse de départ"},{"fr":"Les mesures confirment une hausse de 1,1 °C.","ar":"تؤكد القياسات ارتفاعاً قدره 1,1 درجة.","note":"le constat mesuré"},{"fr":"D’ici 2050, la hausse pourrait atteindre 2 °C.","ar":"بحلول 2050، قد يبلغ الارتفاع درجتين.","note":"le conditionnel de projection"},{"fr":"Les modèles comportent une marge d’incertitude.","ar":"تحمل النماذج هامشاً من عدم اليقين.","note":"la prudence méthodologique"},{"fr":"En l’absence de mesures, la tendance se poursuit.","ar":"في غياب الإجراءات يستمر الاتجاه.","note":"la condition"},{"fr":"Il est urgent d’agir, sans céder à l’alarmisme.","ar":"من الضروري التحرك دون الاستسلام لخطاب الفزع.","note":"l’équilibre du ton"}],"grammar":[{"tFr":"Le conditionnel de projection et le présent de constat","tAr":"المضارع الشرطي للإسقاط والمضارع للاقتباس","body":["Deux temps se partagent le discours climatique : le présent pour le constat mesuré (« la température augmente ») et le conditionnel pour la projection (« la température pourrait augmenter de 2 °C »). Mélanger les deux transforme une hypothèse en fait.","Les compléments temporels ancrent le propos : depuis 1850, ces dernières décennies, d’ici 2050, à l’horizon 2100. Sans horizon, le chiffre perd son sens."],"ex":[{"fr":"La température augmente depuis le début du XXe siècle.","ar":"ترتفع الحرارة منذ مطلع القرن العشرين."},{"fr":"À l’horizon 2100, la hausse pourrait atteindre 3 °C.","ar":"عند أفق 2100، قد يبلغ الارتفاع 3 درجات."}]},{"tFr":"La voix passive et les compléments de condition","tAr":"المبني للمجهول وظروف الشرط في تقارير المناخ","body":["La voix passive rend l’action impersonnelle : « les mesures ont été reportées ». Le responsable disparaît, ce qui convient à un rapport mais pas à un débat politique.","La condition se marque par « en l’absence de », « si », « sous réserve que » + subjonctif. Toute projection est conditionnée : « sous réserve que les émissions diminuent »."],"ex":[{"fr":"Les objectifs ont été reportés à 2035.","ar":"أُجّلت الأهداف إلى 2035."},{"fr":"La projection tient, sous réserve que les émissions diminuent.","ar":"ينعقد الإسقاط شريطة انخفاض الانبعاثات."}]}],"mistakes":[{"wrong":"confondre prévision météo et projection climatique","right":"la météo prédit des jours, le climat décrit des décennies","why":"les échelles de temps diffèrent totalement — مقاييس الزمن مختلفة كلياً."},{"wrong":"Les modèles se trompent, donc ils sont inutiles.","right":"Les modèles fournissent une tendance avec une marge d’incertitude.","why":"un modèle n’est pas une prédiction datée — النموذج ليس توقّعاً مؤرّخاً."},{"wrong":"2 °C d’ici 2100 est certain.","right":"2 °C d’ici 2100 dépend du scénario retenu.","why":"la projection est conditionnée par les émissions futures — الإسقاط مشروط بالانبعاثات المستقبلية."},{"wrong":"écrire « la planète brûle » dans un rapport","right":"écrire « le réchauffement progresse selon les données disponibles »","why":"le rapport exige le registre neutre, le titre de presse admet l’emphase — التقرير يفرض الحياد بينما يقبل عنوان الصحافة المبالغة."}],"dialogues":[{"title":"Après la conférence","ctx":"صحفيان يحلّلان خرجة مؤتمر المناخ","lines":[{"who":"Camille","fr":"Le rapport annonce une hausse de 1,5 °C.","ar":"يعلن التقرير عن ارتفاع بقدر 1,5 درجة."},{"who":"Thomas","fr":"C’est un constat, pas une prévision.","ar":"هذه واقعة مقيسة لا توقّع."},{"who":"Camille","fr":"Et la projection dépend du scénario choisi.","ar":"والإسقاط يعتمد على السيناريو المختار."},{"who":"Thomas","fr":"Donc on cite toujours le scénario avec le chiffre.","ar":"إذن نذكر السيناريو دائماً مع الرقم."}]},{"title":"Le ton d’un article","ctx":"محرران يراجعان مقالاً علمياً قبل النشر","lines":[{"who":"Sarah","fr":"Le titre parle d’une catastrophe imminente.","ar":"يتناول العنوان كارثة وشيكة."},{"who":"Karim","fr":"Les données parlent d’une accélération mesurée.","ar":"تتحدث البيانات عن تسارع مقيس."},{"who":"Sarah","fr":"Alors je propose : « Le réchauffement accélère selon les mesures. »","ar":"أقترح إذن: « يتسارع الاحتباس الحراري وفقاً للقياسات »."},{"who":"Karim","fr":"Parfait, et on ajoute l’horizon 2050.","ar":"ممتاز، ونضيف أفق 2050."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما الفرق بين « la prévision météorologique » و« la projection climatique »؟","opts":["الأولى لبضعة أيام والثانية لعقود","الأولى عن الحرارة والثانية عن الأمطار","لا فرق بينهما","الأولى للأفراد والثانية للشركات"],"a":0,"why":"les échelles temporelles diffèrent : jours contre décennies."},{"t":"fill","skill":"grammar","q":"أكمل: «Sous un scénario d’émissions élevées, le réchauffement ___ (dépasser) 3 °C.»","fr":"Sous un scénario d’émissions élevées, le réchauffement ___ 3 °C.","ans":"dépasserait","why":"le conditionnel exprime l’hypothèse propre au scénario."},{"t":"order","skill":"writing","q":"رتّب: الإسقاط يعتمد على السيناريو المعتمد","words":["La","projection","dépend","du","scénario","retenu."],"ans":"La projection dépend du scénario retenu.","why":"ordre sujet — verbe — complément introduit par « de »."},{"t":"listen","skill":"listening","q":"ماذا تعني « en l’absence de mesures »؟","opts":["في غياب الإجراءات","عند تنفيذ الإجراءات","بعد نشر التقرير","قبل بدء القياسات"],"a":0,"why":"« en l’absence de » signifie « quand il n’y a pas »."},{"t":"translate","skill":"writing","q":"ترجم: «بحلول 2050 قد يبلغ الارتفاع درجتين.»","ans":"D’ici 2050, la hausse pourrait atteindre 2 °C.","why":"« d’ici 2050 » + le conditionnel de projection."},{"t":"speaking","skill":"speaking","q":"قدّم في ثلاث جمل: معلومة مقيسة، وسيناريو، وقيد منهجي.","target":"mesure / scénario / incertitude","why":"الحفاظ على le registre scientifique أثناء العرض الشفوي."},{"t":"correct","skill":"grammar","q":"صحّح: «Les modèles prédisent la température du 12 mai 2050.»","ans":"Les modèles projettent une tendance à l’horizon 2050.","why":"les modèles donnent des tendances, pas des prévisions datées jour par jour."},{"t":"mcq","skill":"reading","q":"أي صياغة تجمع بين la précision et la prudence؟","opts":["Il fera 42 °C en 2050.","Le climat devient impossible à prévoir.","Sous un scénario d’émissions élevées, la hausse pourrait atteindre 3 °C.","La Terre est en danger, c’est prouvé."],"a":2,"why":"elle donne le scénario, la grandeur mesurée et le conditionnel."}],"homework":"اقرأ فصلاً من تقرير le GIEC بالفرنسية، واكتب أربع جمل: معلومتان مقيستان، وسيناريو، وقيد منهجي، مع le conditionnel حيثما يلزم.","sources":[{"title":"Les scénarios climatiques","channel":"UVED","videoId":"3ATgMqjPoO0","why":"شرح أكاديمي لـ les scénarios climatiques: كيف يُبنى le scénario من hypothèse إلى trajectoire، ولماذا la projection ليست une prévision.","cat":"Sciences","level":"C1","main":true},{"title":"Modélisation : le climat en équations","channel":"Les coulisses du climat - Le Blob","videoId":"p5JR8fsEzR4","why":"كيف تتحول les équations إلى نموذج مناخي: la méthode وراء la projection، وle vocabulaire التقني لـ l’incertitude.","cat":"Sciences","level":"C1","extra":true},{"title":"Simulations climatiques : prévisions et incertitudes","channel":"Ocean University Initiative","videoId":"ad8Xt6dImw8","why":"محاضرة عن la simulation et ses limites: pourquoi les modèles comportent une marge d’incertitude وكيف تُقرأ في le discours public.","cat":"Sciences","level":"C1","extra":true}],"supplements":[{"id":"p5JR8fsEzR4","title":"Modélisation : le climat en équations","channel":"Les coulisses du climat - Le Blob","why":"كيف تتحول les équations إلى نموذج مناخي: la méthode وراء la projection، وle vocabulaire التقني لـ l’incertitude.","lang":"fr","dur":7},{"id":"ad8Xt6dImw8","title":"Simulations climatiques : prévisions et incertitudes","channel":"Ocean University Initiative","why":"محاضرة عن la simulation et ses limites: pourquoi les modèles comportent une marge d’incertitude وكيف تُقرأ في le discours public.","lang":"fr","dur":22}]},{"id":"c1-t8-l6","fr":"Espace et innovation","ar":"الفضاء والابتكار: البرامج الفضائية والتعاون الدولي والفرنسية في العلم","objectives":["استعمال le vocabulaire spatial: le lanceur, l’orbite, le satellite, la mission, la charge utile","قراءة le discours de coopération: les partenaires, les engagements, les calendriers","التمييز بين le récit historique وle récit prospectif في le reportage spatial","وصف le rôle du français dans la science: la terminologie, la traduction, la formation"],"sections":[{"h":"الدرس 6: كيف يُروى البرنامج الفضائي بالفرنسية","video":{"id":"moXFJbNnleM","title":"Philippe Baptiste et Thomas Pesquet : les défis de la coopération spatiale internationale","channel":"Ministère Enseignement supérieur et Recherche","why":"حوار رسمي بين وزير ورائد فضاء عن les défis de la coopération spatiale: le vocabulaire diplomatique والعلمي معاً، وكيف يُصاغ le discours institutionnel الفرنسي حول l’espace.","lang":"fr","main":true,"dur":9},"p":["« L’espace » في le média الفرنسي موضوع يجمع la science et la diplomatie: le programme national (le CNES), le programme européen (l’ESA), et les partenariats internationaux. le vocabulaire المؤسسي: « coopération », « partenariat », « engagements mutuels ».","les acteurs: le CNES est l’agence française، وl’ESA وكالة أوروبية تجمع أعضاءها، وles nouveaux opérateurs privés — les startups spatiales — يغيّرون le modèle: هذا هو le New Space.","le jargon de la mission: le lanceur يضع la charge utile على l’orbite، le satellite يراقب، le module يستقبل l’équipage، وle pas de tir هو منصة الإطلاق، وla fenêtre de lancement هو le créneau الزمني المسموح.","المقاربة الزمنية في le récit spatial: le passé (« Apollo a permis… »)، le présent (« la mission se poursuit »)، le futur (« d’ici 2030… »). le conditionnel يدخل مبكراً حين لا يزال le programme غير مموّل.","le français dans la science: la terminologie، les publications، et les formations. le défi: كيف يبقى le français لغة de la recherche بينما l’anglais يسيطر على les revues.","للتمرين: اختر خبراً عن مهمة فرنسية أو أوروبية، واكتب فقرة من أربع جمل: la mission، le partenaire، le calendrier، وla condition de financement."],"sub":[{"h":"les acteurs de la coopération","p":["Le CNES travaille avec l’ESA et ses partenaires.","La coopération repose sur des engagements financés.","Chaque agence conserve ses responsabilités."]},{"h":"le vocabulaire d’une mission","p":["Le lanceur place le satellite sur son orbite.","La fenêtre de lancement est un créneau horaire.","La charge utile regroupe les instruments."]},{"h":"annoncer un programme","p":["Le programme devrait être financé l’an prochain.","Les premiers résultats sont attendus en 2030.","Les budgets restent à confirmer."]}]},{"h":"les formules de la coopération","p":["« Dans le cadre de… » — préciser le cadre institutionnel.","« Un accord prévoit que… » — annoncer l’engagement.","« Les travaux se poursuivent d’ici 2030. » — fixer le calendrier.","« Sous réserve d’un financement… » — rappeler la condition."]},{"h":"التطبيق والتلخيص","p":["تمرين la chronologie: اكتب أربع جمل عن مهمة فرنسية: الماضي (ما أُنجز)، الحاضر (ما يجري)، المستقبل (ما هو مخطط)، والقيد (الميزانية).","تمرين la terminologie: اشرح بالفرنسية الفرق بين « le lanceur » و« la fusée » وبين « le satellite » و« la sonde » في جملتين لكل زوج.","تمرين la nuance: حوّل جملة « La mission partira en 2028. » إلى le registre prudent: « La mission pourrait partir en 2028, sous réserve du financement. »"]}],"pron":[{"w":"le lanceur","ipa":"[lə lɑ̃sœʁ]","approx":"لو لانسر"},{"w":"le satellite","ipa":"[lə sa.tɛ.lit]","approx":"لو ساتيليت"},{"w":"la coopération","ipa":"[la kɔɔ.pe.ʁa.sjɔ̃]","approx":"لا كووبيراسيون"}],"vocab":[{"fr":"le lanceur","ar":"المركبة الحاملة","pos":"nom","g":"m","exFr":"Le lanceur a décollé à minuit.","ipa":"[lə lɑ̃sœʁ]","exAr":"انطلقت المركبة الحاملة عند منتصف الليل."},{"fr":"la fusée","ar":"الصاروخ","pos":"nom","g":"f","exFr":"La fusée emporte le satellite.","ipa":"[la fy.ze]","exAr":"يحمل الصاروخ القمر الاصطناعي."},{"fr":"l’orbite","ar":"المدار","pos":"nom","g":"f","exFr":"Le satellite est placé sur son orbite.","ipa":"[lɔʁ.bit]","exAr":"يُوضع القمر الاصطناعي على مداره."},{"fr":"le satellite","ar":"القمر الاصطناعي","pos":"nom","g":"m","exFr":"Le satellite observe les océans.","ipa":"[lə sa.tɛ.lit]","exAr":"يراقب القمر الاصطناعي المحيطات."},{"fr":"la mission","ar":"المهمة","pos":"nom","g":"f","exFr":"La mission dure six mois.","ipa":"[la mi.sjɔ̃]","exAr":"تدوم المهمة ستة أشهر."},{"fr":"le module","ar":"الوحدة","pos":"nom","g":"m","exFr":"Le module accueille l’équipage.","ipa":"[lə mɔ.dyj]","exAr":"تستقبل الوحدة الطاقم."},{"fr":"la charge utile","ar":"الحمولة المفيدة","pos":"loc.","g":"f","exFr":"La charge utile regroupe les instruments.","ipa":"[la ʃaʁʒ y.til]","exAr":"تضمّ الحمولة المفيدة الأجهزة."},{"fr":"le pas de tir","ar":"منصة الإطلاق","pos":"loc.","g":"m","exFr":"Le pas de tir est prêt.","ipa":"[lə pa də ti]","exAr":"منصة الإطلاق جاهزة."},{"fr":"la fenêtre de lancement","ar":"نافذة الإطلاق","pos":"loc.","g":"f","exFr":"La fenêtre de lancement ouvre à six heures.","ipa":"[la fə.nɛtʁ də lɑ̃smɑ̃]","exAr":"تفتح نافذة الإطلاق في السادسة."},{"fr":"coopérer","ar":"يتعاون","pos":"verbe","g":"","exFr":"Les agences coopèrent depuis 1975.","ipa":"[kɔɔ.pe.ʁe]","exAr":"تتعاون الوكالات منذ 1975."},{"fr":"un partenariat","ar":"شراكة","pos":"nom","g":"m","exFr":"Le partenariat prévoit trois vols.","ipa":"[œ̃ paʁtə.naʁja]","exAr":"تنص الشراكة على ثلاث رحلات."},{"fr":"financer","ar":"يموّل","pos":"verbe","g":"","exFr":"Le programme doit être financé.","ipa":"[fi.nɑ̃.se]","exAr":"يجب تمويل البرنامج."}],"examples":[{"fr":"Le lanceur a décollé de la base de Kourou.","ar":"انطلقت المركبة الحاملة من قاعدة كورو.","note":"le récit d’une mission"},{"fr":"Les deux agences coopèrent depuis 1975.","ar":"تتعاون الوكالتان منذ 1975.","note":"le présent de fait"},{"fr":"La fenêtre de lancement s’ouvre à six heures.","ar":"تفتح نافذة الإطلاق في السادسة.","note":"la métaphore spatiale"},{"fr":"Dans le cadre du partenariat, deux vols sont prévus.","ar":"ضمن إطار الشراكة، تُخطط لرحلتين.","note":"le registre institutionnel"},{"fr":"La mission pourrait être financée l’an prochain.","ar":"قد تموَّل المهمة في العام المقبل.","note":"le conditionnel de programmation"},{"fr":"Sous réserve d’un financement, le lancement aura lieu en 2030.","ar":"مشروطاً بالتمويل، سيجري الإطلاق في 2030.","note":"la condition financière"}],"grammar":[{"tFr":"Le conditionnel de programmation et le futur simple","tAr":"المضارع الشرطي للبرمجة والمستقبل البسيط","body":["Dans le discours spatial, le futur simple annonce un fait planifié et financé : « le lanceur décollera en 2028 ». Le conditionnel signale une programmation non encore acquise : « le lancement pourrait avoir lieu en 2028 ».","La nuance tient au statut du projet : tant que le budget n’est pas voté, le conditionnel est obligatoire. Il protège l’annonce contre la déception."],"ex":[{"fr":"Le lanceur décollera en 2028.","ar":"ستنطلق المركبة الحاملة في 2028."},{"fr":"Le lancement pourrait avoir lieu en 2028.","ar":"قد يجري الإطلاق في 2028."}]},{"tFr":"Les compléments de moyen et de coopération","tAr":"ظروف الوسيلة وأدوات التعاون","body":["Le français de l’espace précise le moyen : « par le biais de », « au moyen de », « grâce à », « en coopération avec ». Chaque tournure situe le degré d’implication des partenaires.","Les prépositions construisent la phrase : « en partenariat avec l’ESA », « dans le cadre du programme », « sous l’égide de ». La simple conjonction « avec » appauvrit le style institutionnel."],"ex":[{"fr":"L’instrument a été conçu en coopération avec l’ESA.","ar":"صُمّم الجهاز بالتعاون مع الوكالة الأوروبية."},{"fr":"Le vol se déroulera sous l’égide de l’agence.","ar":"ستجري الرحلة تحت إشراف الوكالة."}]}],"mistakes":[{"wrong":"confondre « le lanceur » et « le satellite »","right":"le lanceur transporte, le satellite observe","why":"le lanceur est le véhicule, le satellite est la charge — المركبة تحمل بينما القمر يراقب."},{"wrong":"Le programme partira en 2028.","right":"Le programme devrait partir en 2028, sous réserve du budget.","why":"sans budget voté, le conditionnel est obligatoire — دون ميزانية معتمدة يصبح الشرطي إلزامياً."},{"wrong":"l’ESA a lancé la fusée française","right":"la mission a été lancée avec le soutien de l’ESA","why":"les agences n’agissent pas seules : la coopération est collective — الوكالات لا تتحرك وحدها فالتعاون جماعي."},{"wrong":"employer des anglicismes : « launch », « tracking »","right":"employer la terminologie française : « lancement », « suivi »","why":"la terminologie spatiale française existe et s’impose dans le discours institutionnel — المصطلح الفضائي الفرنسي موجود ويلزم في الخطاب المؤسسي."}],"dialogues":[{"title":"Avant le lancement","ctx":"صحفيتان يستعدّان لتغطية إطلاق صاروخ","lines":[{"who":"Inès","fr":"Le lanceur attend la fenêtre de lancement à six heures.","ar":"تنتظر المركبة الحاملة نافذة الإطلاق في السادسة."},{"who":"Bastien","fr":"Et si le vent change ?","ar":"وإذا تغيّرت الرياح؟"},{"who":"Inès","fr":"La fenêtre glissera de quelques minutes.","ar":"ستنزاح النافذة بضع دقائق."},{"who":"Bastien","fr":"Donc le compte à rebours reste conditionnel.","ar":"إذن يبقى العد التنازلي مشروطاً."}]},{"title":"Le partenariat","ctx":"مديرتان تناقشان شراكة بين وكالتين فضائيتين","lines":[{"who":"Mina","fr":"Dans le cadre du partenariat, deux vols sont prévus.","ar":"ضمن إطار الشراكة، تُخطط لرحلتين."},{"who":"Élodie","fr":"Sous réserve d’un financement, bien sûr.","ar":"مشروطة بالتمويل، بالطبع."},{"who":"Mina","fr":"Les travaux se poursuivent d’ici 2030.","ar":"تستمر الأعمال حتى 2030."},{"who":"Élodie","fr":"Alors on cite l’accord, pas l’annonce.","ar":"إذن نذكر الاتفاق لا الإعلان."}]}],"exercises":[{"t":"mcq","skill":"vocabulary","q":"ما معنى « la fenêtre de lancement »؟","opts":["نافذة زمنية مسموح بها للإطلاق","نافذة داخل مركبة الفضاء","شاشة المراقبة","محطة الاتصال الأرضية"],"a":0,"why":"fenêtre = créneau temporel permis par les conditions techniques et scientifiques."},{"t":"fill","skill":"grammar","q":"أكمل: «La mission ___ (financer) l’an prochain, sous réserve du budget.»","fr":"La mission ___ l’an prochain, sous réserve du budget.","ans":"pourrait être financée","why":"le conditionnel passif avec la condition introduite par « sous réserve de »."},{"t":"order","skill":"writing","q":"رتّب: تتعاون الوكالتان منذ 1975","words":["Les","deux","agences","coopèrent","depuis","1975."],"ans":"Les deux agences coopèrent depuis 1975.","why":"ordre sujet — verbe — complément de temps."},{"t":"listen","skill":"listening","q":"ماذا تعني « sous réserve d’un financement »؟","opts":["مشروطاً بتوفر التمويل","بتمويل كامل","دون أي تمويل","بتمويل من جهة خاصة فقط"],"a":0,"why":"« sous réserve de » = « à condition que, sous la condition de »."},{"t":"translate","skill":"writing","q":"ترجم: «قد يجري الإطلاق في 2030 مشروطاً بالتمويل.»","ans":"Le lancement pourrait avoir lieu en 2030, sous réserve d’un financement.","why":"le conditionnel de programmation + la condition « sous réserve de »."},{"t":"speaking","skill":"speaking","q":"قدّم في ثلاث جمل مهمة فرنسية فضائية: ما أُنجز، وما يجري، وما هو مخطط.","target":"a été / se poursuit / pourrait","why":"التمييز بين le passé achevé et le futur programmé."},{"t":"correct","skill":"grammar","q":"صحّح: «Le programme partira en 2028.»","ans":"Le programme devrait partir en 2028, sous réserve du budget.","why":"sans budget voté, on emploie le conditionnel de programmation."},{"t":"mcq","skill":"reading","q":"أي جملة أدق عن le rôle du français dans la science؟","opts":["Le français a disparu de la recherche.","Le français reste utilisé dans les institutions et les formations, tandis que l’anglais domine les revues.","Tous les articles scientifiques sont en français.","L’anglais est obligatoire dans toute l’Europe."],"a":1,"why":"elle distingue les deux domaines au lieu de généraliser à partir d’un seul fait."}],"homework":"ابحث عن خبر بالفرنسية عن مهمة أوروبية (l’ESA) أو فرنسية (le CNES)، واكتب فقرة من أربع جمل: la mission، le partenaire، le calendrier، et la condition de financement.","sources":[{"title":"Philippe Baptiste et Thomas Pesquet : les défis de la coopération spatiale internationale","channel":"Ministère Enseignement supérieur et Recherche","videoId":"moXFJbNnleM","why":"حوار رسمي بين وزير ورائد فضاء عن les défis de la coopération spatiale: le vocabulaire diplomatique والعلمي معاً، وكيف يُصاغ le discours institutionnel الفرنسي حول l’espace.","cat":"Sciences","level":"C1","main":true},{"title":"New Space : les nouveaux acteurs du spatial","channel":"CNES","videoId":"jRefxlWAUpw","why":"présentation لـ le modèle du New Space وكيف تغيّر le discours sur l’innovation: les startups، la compétition، les coopérations.","cat":"Sciences","level":"C1","extra":true},{"title":"Une journée au coeur de l’agence spatiale Française","channel":"Spacefox","videoId":"ZQn8HwoHVkg","why":"reportage داخل le CNES: le jargon du quotidien — le pas de tir، la salle de contrôle، le suivi de mission — في le contexte الفرنسي.","cat":"Sciences","level":"C1","extra":true}],"supplements":[{"id":"jRefxlWAUpw","title":"New Space : les nouveaux acteurs du spatial","channel":"CNES","why":"présentation لـ le modèle du New Space وكيف تغيّر le discours sur l’innovation: les startups، la compétition، les coopérations.","lang":"fr","dur":5},{"id":"ZQn8HwoHVkg","title":"Une journée au coeur de l’agence spatiale Française","channel":"Spacefox","why":"reportage داخل le CNES: le jargon du quotidien — le pas de tir، la salle de contrôle، le suivi de mission — في le contexte الفرنسي.","lang":"fr","dur":31}]}]}]}]};
